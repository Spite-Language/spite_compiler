union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(model)
var assignments: HighIntermediaryRepresentation.Assignments? = null
var taken: HighIntermediaryRepresentation.Ownership.TakenParameters? = null
var uses = HighIntermediaryRepresentation.Ownership.Uses()
var library = Validators.LibraryFile()
var gets = HighIntermediaryRepresentation.ListGets(model)
var candidates = Dictionary<String, String>()
var refused = List<String>()
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var live = List<String>()
var waiting = List<String>()
var no_function = Model.FunctionModel("", "")
var no_body = HighIntermediaryRepresentation.Statements.Block()
var current = HighIntermediaryRepresentation.HighFunction(no_function, no_body)
var assigned_here = List<String>()
var depth = 0

# ../../OPTIMIZATIONS.md#an-object-only-its-holder-holds-lives-inside-it
func optimized(starting_high: HighIntermediaryRepresentation.HighProgram) {
    fallback starting_high.will_be_lowered()
    high = starting_high
    model = starting_high.model
    assignments = starting_high.assignments
    taken = starting_high.taken_parameters
    gets = HighIntermediaryRepresentation.ListGets(starting_high.model)
    crash starting_high.layout
    var embedded = found(starting_high.layout)
    starting_high.layout.embed(embedded)
    if not embedded.is_empty() {
        starting_high.embedding_live = live
    }
}

func found(layout: HighIntermediaryRepresentation.Layout): Dictionary<String, String> {
    var none_found = Dictionary<String, String>()
    if high.prompt or layout.has_back_references() {
        return none_found
    }
    model.order.each(note_the_candidates_of)
    if candidates.is_empty() {
        return none_found
    }
    high.built_functions.each(note_a_body)
    find_the_live_functions()
    var index = 0
    while index < live.count() {
        var key = live[index]
        var function = bodies[key]
        crash function
        study_a_function(function)
        index = index + 1
    }
    var kept = Dictionary<String, String>()
    var keys = candidates.keys()
    index = 0
    while index < keys.count() {
        var key = keys[index]
        var held = candidates[key]
        crash held
        if not refused.contains(key) and layout.has_slot_named(key) {
            kept[key] = held
        }
        index = index + 1
    }
    return kept
}

func note_the_candidates_of(holder: Model.ClassModel) {
    fallback is_an_ordinary_holder(holder)
    var index = 0
    while index < holder.declared_attributes.count() {
        var attribute = holder.declared_attributes[index]
        var held = attribute.attribute_type
        if held.kind == 'object' and not held.is_nullable and is_a_plain_class(held.name, holder.key) {
            candidates["{holder.key}.{attribute.name}"] = held.name
        }
        index = index + 1
    }
}

func is_an_ordinary_holder(holder: Model.ClassModel): Boolean {
    fallback not holder.is_singleton and not holder.key.starts_with("Spite.") and holder.bound_types.is_empty()
    fallback not library.holds(holder.file.path)
    fallback not high.entry or high.entry.owner != holder.key
    return not fills_a_shape(holder.key)
}

func fills_a_shape(class_key: String): Boolean {
    var shapes = model.shape_fillers.values()
    var index = 0
    while index < shapes.count() {
        var fillers = shapes[index]
        if names_the_class(fillers, class_key) {
            return true
        }
        index = index + 1
    }
    return false
}

func names_the_class(fillers: List<Model.Type>, class_key: String): Boolean {
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if filler.name == class_key {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_plain_class(class_key: String, holder_key: String): Boolean {
    fallback class_key != holder_key and not class_key.starts_with("Spite.") and not fills_a_shape(class_key)
    var held = model.class_named(class_key)
    fallback held and not held.is_singleton and not held.function_named("drop") and held.bound_types.is_empty()
    fallback not library.holds(held.file.path)
    fallback not held.declared_attributes.is_empty()
    return held.declared_attributes.all(is_a_plain_number)
}

func is_a_plain_number(attribute: Model.AttributeModel): Boolean {
    var of_type = attribute.attribute_type
    return of_type.kind == 'scalar' and not of_type.is_nullable
}

func note_a_body(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    bodies[key] = function
    if is_a_root(function.function) {
        add_live(key)
    }
}

func is_a_root(function: Model.FunctionModel): Boolean {
    fallback not function.is_a_member_template and not function.is_a_walk_copy and not function.is_a_fused_step
    fallback not function.name.starts_with("_fused_") and function.fused_filters.is_empty()
    return function.bound_member.is_empty()
}

func add_live(key: String) {
    if bodies.contains(key) and not live.contains(key) {
        live.append(key)
        waiting.append(key)
    }
}

func find_the_live_functions() {
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        var function = bodies[key]
        crash function
        reference_a_block(function.body)
    }
}

func reference_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(reference_a_statement)
}

func reference_a_statement(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Attribute: reference_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: reference_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: reference_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.If: reference_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: reference_a_while(statement)
        HighIntermediaryRepresentation.Statements.Stop: reference_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: reference_a_block(statement)
        _: reference_value(statement.value)
    }
}

func reference_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    reference_both(written.object, written.value)
}

func reference_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    reference_both(written.object, written.value)
}

func reference_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    reference_both(branch.condition, branch.decided_condition)
    reference_a_block(branch.then_branch)
    reference_a_block(branch.else_branch)
}

func reference_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    reference_value(loop.condition)
    reference_a_block(loop.body)
}

func reference_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(reference_present)
    reference_value(stop.then)
}

func reference_both(
    left: Value?,
    right: Value?,
) {
    reference_value(left)
    reference_value(right)
}

func reference_present(value: Value) {
    reference_value(value)
}

func reference_value(value: Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: reference_value(value.object)
        HighIntermediaryRepresentation.Values.Call: reference_a_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: reference_a_making(value)
        HighIntermediaryRepresentation.Values.MachineOperation: reference_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: reference_value(value.negated)
        HighIntermediaryRepresentation.Values.ForeignCall: reference_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Test: reference_a_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: reference_a_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: reference_value(value.converted)
        HighIntermediaryRepresentation.Values.Function.Value: reference_a_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: reference_a_value_call(value)
        HighIntermediaryRepresentation.Values.NumberRoom: reference_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.ShapeCall: reference_a_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: reference_value(value.number)
        HighIntermediaryRepresentation.Values.EnumFromText: reference_value(value.text)
        HighIntermediaryRepresentation.Values.Class.OfValue: reference_a_class_of(value)
        HighIntermediaryRepresentation.Values.Class.Object: refuse_the_class(value.described)
        _: return
    }
}

func reference_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var key = call.function.key()
    add_live(key)
    reference_value(call.receiver)
    call.arguments.each(reference_present)
}

func reference_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    if made.constructor {
        var key = made.constructor.key()
        add_live(key)
    }
    made.arguments.each(reference_present)
}

func reference_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    reference_value(call.library)
    call.arguments.each(reference_present)
}

func reference_a_class_test(test: HighIntermediaryRepresentation.Values.Class.Test) {
    reference_value(test.tested)
}

func reference_a_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest) {
    reference_value(test.tested)
}

func reference_a_function_value(taken_value: HighIntermediaryRepresentation.Values.Function.Value) {
    var key = taken_value.function.key()
    add_live(key)
    reference_value(taken_value.receiver)
}

func reference_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    reference_value(call.called)
    call.arguments.each(reference_present)
}

func reference_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    var name = call.member.name
    var keys = bodies.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if key.ends_with(".{name}") {
            add_live(key)
        }
        index = index + 1
    }
    reference_value(call.receiver)
    call.arguments.each(reference_present)
}

func reference_a_class_of(made: HighIntermediaryRepresentation.Values.Class.OfValue) {
    made.candidates.each(refuse_the_class)
    reference_value(made.described)
}

func refuse_the_class(class_key: String) {
    var keys = candidates.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if key.starts_with("{class_key}.") {
            refused.append(key)
        }
        index = index + 1
    }
}

func study_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    current = function
    crash assignments
    assigned_here = assignments.names_assigned_in(function.body)
    depth = 0
    study_a_block(function.body)
}

func study_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    depth = depth + 1
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        study_a_statement(statement, block.statements, index)
        index = index + 1
    }
    depth = depth - 1
}

func study_a_statement(
    statement: Statement,
    statements: List<Statement>,
    at: Integer,
) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: study_a_declare(statement, statements, at)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: study_an_attribute_write(statement, statements)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: study_a_shape_write(statement, statements)
        HighIntermediaryRepresentation.Statements.Evaluate: study_an_evaluation(statement, statements)
        HighIntermediaryRepresentation.Statements.If: study_an_if(statement, statements)
        HighIntermediaryRepresentation.Statements.While: study_a_while(statement, statements)
        HighIntermediaryRepresentation.Statements.Stop: study_a_stop(statement, statements)
        HighIntermediaryRepresentation.Statements.Block: study_a_block(statement)
        _: study_value(statement.value, "", statements)
    }
}

func study_a_declare(
    declare: HighIntermediaryRepresentation.Statements.Declare,
    statements: List<Statement>,
    at: Integer,
) {
    var given = declare.value
    if given.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var key = key_of(given.attribute)
        if candidates.contains(key) {
            study_a_named_part(declare, given, key, statements, at)
            return
        }
    }
    study_value(given, "", statements)
}

func study_a_named_part(
    declare: HighIntermediaryRepresentation.Statements.Declare,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    key: String,
    statements: List<Statement>,
    at: Integer,
) {
    study_value(read.object, "", statements)
    var held = candidates[key]
    crash held
    var name = declare.name
    if assigned_here.contains(name) or declare.hides != "" {
        refused.append(key)
        return
    }
    var watched = List<String>()
    watched.append(key)
    if not gather(read.object, watched) {
        refused.append(key)
        return
    }
    var after = at + 1
    crash assignments
    if not assignments.leaves_alone(statements, after, watched) {
        refused.append(key)
        return
    }
    var index = after
    while index < statements.count() {
        var statement = statements[index]
        if not uses_only_parts(statement, name, held) {
            refused.append(key)
        }
        index = index + 1
    }
}

func gather(value: Value?, watched: List<String>): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.LocalRead: return not assigned_here.contains(value.name)
        HighIntermediaryRepresentation.Values.Conversion: return gather_a_conversion(value, watched)
        HighIntermediaryRepresentation.Values.AttributeRead: return gather_an_attribute(value, watched)
        HighIntermediaryRepresentation.Values.Call: return gather_a_slot(value, watched)
        _: return false
    }
}

func gather_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion, watched: List<String>): Boolean {
    fallback conversion.kind == 'proven'
    return gather(conversion.converted, watched)
}

func gather_an_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead, watched: List<String>): Boolean {
    var key = key_of(read.attribute)
    watched.append(key)
    return gather(read.object, watched)
}

func gather_a_slot(call: HighIntermediaryRepresentation.Values.Call, watched: List<String>): Boolean {
    var is_a_read = call.function.name == "_read_value" and not call.function.is_synthetic
    fallback is_a_read or gets.is_a_plain_get(call)
    watched.append("[]{call.function.owner}")
    watched.append("[+]{call.function.owner}")
    watched.append("{call.function.owner}._length")
    return gather(call.receiver, watched)
}

func uses_only_parts(
    statement: Statement,
    name: String,
    held: String,
): Boolean {
    var all = uses.in_statement(statement, name)
    if all == 0 {
        return true
    }
    fallback all < uses.many
    var as_parts = parts_in_statement(statement, name, held)
    return as_parts == all
}

func parts_in_statement(
    statement: Statement,
    name: String,
    held: String,
): Integer {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return parts_in_a_write(statement, name, held)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return parts_in_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.If: return parts_in_an_if(statement, name, held)
        HighIntermediaryRepresentation.Statements.While: return parts_in_a_while(statement, name, held)
        HighIntermediaryRepresentation.Statements.Block: return parts_in_statements(statement.statements, name, held)
        HighIntermediaryRepresentation.Statements.Stop: return parts_in_a_stop(statement)
        _: return parts_in(statement.value, name, held)
    }
}

func parts_in_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape): Integer {
    return uses.many + written.line
}

func parts_in_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop): Integer {
    return uses.many + stop.line
}

func parts_in_a_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    name: String,
    held: String,
): Integer {
    var in_the_value = parts_in(written.value, name, held)
    var on_the_object = parts_in_object(written.object, written.attribute.owner, name, held)
    return in_the_value + on_the_object
}

func parts_in_an_if(branch: HighIntermediaryRepresentation.Statements.If, name: String, held: String): Integer {
    var counted = parts_in(branch.condition, name, held)
    counted = counted + parts_in(branch.decided_condition, name, held)
    counted = counted + parts_in_statements(branch.then_branch.statements, name, held)
    counted = counted + parts_in_a_block(branch.else_branch, name, held)
    return counted
}

func parts_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?, name: String, held: String): Integer {
    fallback block
    return parts_in_statements(block.statements, name, held)
}

func parts_in_a_while(loop: HighIntermediaryRepresentation.Statements.While, name: String, held: String): Integer {
    var in_the_condition = parts_in(loop.condition, name, held)
    var in_the_body = parts_in_statements(loop.body.statements, name, held)
    return in_the_condition + in_the_body
}

func parts_in_statements(
    statements: List<Statement>,
    name: String,
    held: String,
): Integer {
    var counted = 0
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        counted = counted + parts_in_statement(statement, name, held)
        index = index + 1
    }
    return counted
}

func parts_in_object(
    object: Value?,
    part_owner: String,
    name: String,
    held: String,
): Integer {
    if part_owner == held and uses.is_the_local(object, name) {
        return 1
    }
    return parts_in(object, name, held)
}

func parts_in(value: Value?, name: String, held: String): Integer {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: return parts_in_object(value.object, value.attribute.owner, name, held)
        HighIntermediaryRepresentation.Values.Call: return parts_in_a_call(value, name, held)
        HighIntermediaryRepresentation.Values.MakeObject: return parts_in_values(value.arguments, name, held)
        HighIntermediaryRepresentation.Values.MachineOperation: return parts_in_both(value.left, value.right, name, held)
        HighIntermediaryRepresentation.Values.Negation: return parts_in(value.negated, name, held)
        HighIntermediaryRepresentation.Values.Conversion: return parts_in(value.converted, name, held)
        _: return 0
    }
}

func parts_in_both(
    left: Value?,
    right: Value?,
    name: String,
    held: String,
): Integer {
    var on_the_left = parts_in(left, name, held)
    var on_the_right = parts_in(right, name, held)
    return on_the_left + on_the_right
}

func parts_in_a_call(call: HighIntermediaryRepresentation.Values.Call, name: String, held: String): Integer {
    var part_owner = ""
    if keeps_nothing_of_this(call.function) {
        part_owner = call.function.owner
    }
    var on_the_receiver = parts_in_object(call.receiver, part_owner, name, held)
    var in_the_arguments = parts_in_values(call.arguments, name, held)
    return on_the_receiver + in_the_arguments
}

func parts_in_values(values: List<Value>, name: String, held: String): Integer {
    var counted = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        counted = counted + parts_in(value, name, held)
        index = index + 1
    }
    return counted
}

func study_an_attribute_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    statements: List<Statement>,
) {
    study_value(written.object, written.attribute.owner, statements)
    var key = key_of(written.attribute)
    if candidates.contains(key) {
        study_a_kept_write(written, key, statements)
        return
    }
    study_value(written.value, "", statements)
}

func study_a_kept_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    key: String,
    statements: List<Statement>,
) {
    var held = candidates[key]
    crash held
    var function = current.function
    var on_this = written.object.class == HighIntermediaryRepresentation.Values.ThisRead
    var at_the_top = depth == 1 and function.owner == written.attribute.owner
    if not on_this or not at_the_top {
        refused.append(key)
        study_value(written.value, "", statements)
        return
    }
    var given = written.value
    if function.name == "_attribute_defaults" and is_a_making_of(given, held) {
        study_value(given, "", statements)
        return
    }
    if function.is_constructor and given.class == HighIntermediaryRepresentation.Values.LocalRead {
        study_a_handed_part(given.name, key, held)
        return
    }
    refused.append(key)
    study_value(given, "", statements)
}

func is_a_making_of(value: Value?, held: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return value.value_type.name == held
    }
    return false
}

func study_a_handed_part(name: String, key: String, held: String) {
    crash taken
    var function = current.function
    var index = 0
    var position = -1
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            position = index
        }
        index = index + 1
    }
    var constructor_key = function.key()
    var read_once = uses.in_block(current.body, name) == 1
    if position < 0 or not read_once or not taken.is_taken(constructor_key, position) {
        refused.append(key)
        return
    }
    if not every_call_hands_a_new_one(constructor_key, position, held) {
        refused.append(key)
    }
}

func every_call_hands_a_new_one(constructor_key: String, position: Integer, held: String): Boolean {
    var finding = HandedParts(constructor_key, position, held)
    var index = 0
    while index < live.count() {
        var key = live[index]
        var function = bodies[key]
        crash function
        fallback finding.hands_only_new_ones(function.body)
        index = index + 1
    }
    return true
}

func study_a_shape_write(
    written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape,
    statements: List<Statement>,
) {
    study_value(written.object, "", statements)
    study_value(written.value, "", statements)
}

func study_an_evaluation(
    evaluated: HighIntermediaryRepresentation.Statements.Evaluate,
    statements: List<Statement>,
) {
    study_value(evaluated.value, "", statements)
    study_value(evaluated.waited, "", statements)
}

func study_an_if(
    branch: HighIntermediaryRepresentation.Statements.If,
    statements: List<Statement>,
) {
    study_value(branch.condition, "", statements)
    study_value(branch.decided_condition, "", statements)
    study_a_block(branch.then_branch)
    study_a_block(branch.else_branch)
}

func study_a_while(
    loop: HighIntermediaryRepresentation.Statements.While,
    statements: List<Statement>,
) {
    study_value(loop.condition, "", statements)
    study_a_block(loop.body)
}

func study_a_stop(
    stop: HighIntermediaryRepresentation.Statements.Stop,
    statements: List<Statement>,
) {
    var index = 0
    while index < stop.shown.count() {
        var shown = stop.shown[index]
        study_value(shown, "", statements)
        index = index + 1
    }
    study_value(stop.then, "", statements)
}

func study_value(
    value: Value?,
    part_owner: String,
    statements: List<Statement>,
) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: study_a_read(value, part_owner, statements)
        HighIntermediaryRepresentation.Values.Call: study_a_call(value, statements)
        HighIntermediaryRepresentation.Values.MakeObject: study_values(value.arguments, statements)
        HighIntermediaryRepresentation.Values.MachineOperation: study_both(value.left, value.right, statements)
        HighIntermediaryRepresentation.Values.Negation: study_value(value.negated, "", statements)
        HighIntermediaryRepresentation.Values.ForeignCall: study_a_foreign_call(value, statements)
        HighIntermediaryRepresentation.Values.Class.Test: study_a_class_test(value, statements)
        HighIntermediaryRepresentation.Values.PresenceTest: study_a_presence_test(value, statements)
        HighIntermediaryRepresentation.Values.Conversion: study_value(value.converted, "", statements)
        HighIntermediaryRepresentation.Values.Function.Value: study_value(value.receiver, "", statements)
        HighIntermediaryRepresentation.Values.Function.ValueCall: study_a_value_call(value, statements)
        HighIntermediaryRepresentation.Values.NumberRoom: study_both(value.made, value.number, statements)
        HighIntermediaryRepresentation.Values.ShapeCall: study_a_shape_call(value, statements)
        HighIntermediaryRepresentation.Values.EnumText: study_value(value.number, "", statements)
        HighIntermediaryRepresentation.Values.EnumFromText: study_value(value.text, "", statements)
        HighIntermediaryRepresentation.Values.Class.OfValue: study_value(value.described, "", statements)
        _: return
    }
}

func study_a_read(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    part_owner: String,
    statements: List<Statement>,
) {
    var key = key_of(read.attribute)
    var held = candidates[key]
    if held and held != part_owner {
        refused.append(key)
    }
    study_value(read.object, read.attribute.owner, statements)
}

func study_a_call(
    call: HighIntermediaryRepresentation.Values.Call,
    statements: List<Statement>,
) {
    var part_owner = ""
    if keeps_nothing_of_this(call.function) {
        part_owner = call.function.owner
    }
    study_value(call.receiver, part_owner, statements)
    study_values(call.arguments, statements)
}

func keeps_nothing_of_this(function: Model.FunctionModel): Boolean {
    var key = function.key()
    var body = bodies[key]
    fallback body and candidates_hold(function.owner)
    var looking = PartsOfThis(function.owner)
    return looking.uses_only_parts(body.body)
}

func candidates_hold(class_key: String): Boolean {
    var held = candidates.values()
    return held.contains(class_key)
}

func study_values(
    values: List<Value>,
    statements: List<Statement>,
) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        study_value(value, "", statements)
        index = index + 1
    }
}

func study_both(
    left: Value?,
    right: Value?,
    statements: List<Statement>,
) {
    study_value(left, "", statements)
    study_value(right, "", statements)
}

func study_a_foreign_call(
    call: HighIntermediaryRepresentation.Values.ForeignCall,
    statements: List<Statement>,
) {
    study_value(call.library, "", statements)
    study_values(call.arguments, statements)
}

func study_a_class_test(
    test: HighIntermediaryRepresentation.Values.Class.Test,
    statements: List<Statement>,
) {
    study_value(test.tested, "", statements)
}

func study_a_presence_test(
    test: HighIntermediaryRepresentation.Values.PresenceTest,
    statements: List<Statement>,
) {
    study_value(test.tested, "", statements)
}

func study_a_value_call(
    call: HighIntermediaryRepresentation.Values.Function.ValueCall,
    statements: List<Statement>,
) {
    study_value(call.called, "", statements)
    study_values(call.arguments, statements)
}

func study_a_shape_call(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    statements: List<Statement>,
) {
    study_value(call.receiver, "", statements)
    study_values(call.arguments, statements)
}

func key_of(attribute: Model.AttributeModel): String {
    return "{attribute.owner}.{attribute.name}"
}

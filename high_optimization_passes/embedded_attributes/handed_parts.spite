var uses = HighIntermediaryRepresentation.Ownership.Uses()
var refused = false
var constructor_key: String
var position: Integer
var held: String

func HandedParts(starting_key: String, starting_position: Integer, starting_held: String) {
    constructor_key = starting_key
    position = starting_position
    held = starting_held
}

# ../../OPTIMIZATIONS.md#an-object-only-its-holder-holds-lives-inside-it
func hands_only_new_ones(body: HighIntermediaryRepresentation.Statements.Block): Boolean {
    refused = false
    look_in_a_block(body)
    return not refused
}

func look_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        look_in_a_statement(statement, block.statements)
        index = index + 1
    }
}

func look_in_a_statement(statement: SpiteCompiler.Statement, statements: List<SpiteCompiler.Statement>) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Attribute: look_in_a_write(statement, statements)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: look_in_a_shape_write(statement, statements)
        HighIntermediaryRepresentation.Statements.Evaluate: look_in_both(statement.value, statement.waited, statements)
        HighIntermediaryRepresentation.Statements.If: look_in_an_if(statement, statements)
        HighIntermediaryRepresentation.Statements.While: look_in_a_while(statement, statements)
        HighIntermediaryRepresentation.Statements.Stop: look_in_a_stop(statement, statements)
        HighIntermediaryRepresentation.Statements.Block: look_in_a_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: look_in(statement.value, statements)
        HighIntermediaryRepresentation.Statements.Assign.Assign: look_in(statement.value, statements)
        HighIntermediaryRepresentation.Statements.Return: look_in(statement.value, statements)
    }
}

func look_in_a_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in_both(written.object, written.value, statements)
}

func look_in_a_shape_write(
    written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in_both(written.object, written.value, statements)
}

func look_in_an_if(branch: HighIntermediaryRepresentation.Statements.If, statements: List<SpiteCompiler.Statement>) {
    look_in_both(branch.condition, branch.decided_condition, statements)
    look_in_a_block(branch.then_branch)
    look_in_a_block(branch.else_branch)
}

func look_in_a_while(loop: HighIntermediaryRepresentation.Statements.While, statements: List<SpiteCompiler.Statement>) {
    look_in(loop.condition, statements)
    look_in_a_block(loop.body)
}

func look_in_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop, statements: List<SpiteCompiler.Statement>) {
    look_in_values(stop.shown, statements)
    look_in(stop.then, statements)
}

func look_in_both(left: SpiteCompiler.Value?, right: SpiteCompiler.Value?, statements: List<SpiteCompiler.Statement>) {
    look_in(left, statements)
    look_in(right, statements)
}

func look_in_values(values: List<SpiteCompiler.Value>, statements: List<SpiteCompiler.Statement>) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        look_in(value, statements)
        index = index + 1
    }
}

func look_in(value: SpiteCompiler.Value?, statements: List<SpiteCompiler.Statement>) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: look_in(value.object, statements)
        HighIntermediaryRepresentation.Values.Call: look_in_a_call(value, statements)
        HighIntermediaryRepresentation.Values.MakeObject: look_in_a_making(value, statements)
        HighIntermediaryRepresentation.Values.MachineOperation: look_in_both(value.left, value.right, statements)
        HighIntermediaryRepresentation.Values.Negation: look_in(value.negated, statements)
        HighIntermediaryRepresentation.Values.ForeignCall: look_in_a_foreign_call(value, statements)
        HighIntermediaryRepresentation.Values.Class.Membership: look_in_a_class_test(value, statements)
        HighIntermediaryRepresentation.Values.PresenceTest: look_in_a_presence_test(value, statements)
        HighIntermediaryRepresentation.Values.Conversion: look_in(value.converted, statements)
        HighIntermediaryRepresentation.Values.Function.Value: look_in(value.receiver, statements)
        HighIntermediaryRepresentation.Values.Function.ValueCall: look_in_a_value_call(value, statements)
        HighIntermediaryRepresentation.Values.NumberRoom: look_in_both(value.made, value.number, statements)
        HighIntermediaryRepresentation.Values.ShapeCall: look_in_a_shape_call(value, statements)
        HighIntermediaryRepresentation.Values.EnumText: look_in(value.number, statements)
        HighIntermediaryRepresentation.Values.EnumFromText: look_in(value.text, statements)
        HighIntermediaryRepresentation.Values.Class.OfValue: look_in(value.described, statements)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func look_in_a_call(call: HighIntermediaryRepresentation.Values.Call, statements: List<SpiteCompiler.Statement>) {
    look_in(call.receiver, statements)
    look_in_values(call.arguments, statements)
}

func look_in_a_foreign_call(
    call: HighIntermediaryRepresentation.Values.ForeignCall,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in(call.library, statements)
    look_in_values(call.arguments, statements)
}

func look_in_a_class_test(
    test: HighIntermediaryRepresentation.Values.Class.Membership,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in(test.tested, statements)
}

func look_in_a_presence_test(
    test: HighIntermediaryRepresentation.Values.PresenceTest,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in(test.tested, statements)
}

func look_in_a_value_call(
    call: HighIntermediaryRepresentation.Values.Function.ValueCall,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in(call.called, statements)
    look_in_values(call.arguments, statements)
}

func look_in_a_shape_call(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in(call.receiver, statements)
    look_in_values(call.arguments, statements)
}

func look_in_a_making(
    made: HighIntermediaryRepresentation.Values.MakeObject,
    statements: List<SpiteCompiler.Statement>,
) {
    look_in_values(made.arguments, statements)
    fallback made.constructor
    var key = made.constructor.key()
    fallback key == constructor_key
    var given = made.arguments[position]
    if not is_new(given, statements) {
        refused = true
    }
}

func is_new(value: SpiteCompiler.Value?, statements: List<SpiteCompiler.Statement>): Boolean {
    if is_a_making(value) {
        return true
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return is_a_new_local(value.name, statements)
    }
    return false
}

func is_a_new_local(name: String, statements: List<SpiteCompiler.Statement>): Boolean {
    var declared = false
    var reads = 0
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if is_the_making_of(statement, name) {
            declared = true
        } else {
            reads = reads + uses.in_statement(statement, name)
        }
        index = index + 1
    }
    return declared and reads == 1
}

func is_the_making_of(statement: SpiteCompiler.Statement, name: String): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        return statement.name == name and statement.hides == "" and is_a_making(statement.value)
    }
    return false
}

func is_a_making(value: SpiteCompiler.Value?): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return value.value_type.name == held
    }
    return false
}

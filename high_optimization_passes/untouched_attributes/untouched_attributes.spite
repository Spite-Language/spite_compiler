union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var no_functions = List<HighIntermediaryRepresentation.HighFunction>()
var no_exclusions = List<String>()
var facts = HighIntermediaryRepresentation.Building.Facts(no_program, no_functions, no_exclusions)
var written = List<String>()
var read_keys = List<String>()
var spoiled = List<String>()
var looped = List<String>()
var unplain = List<String>()
var through_shapes = List<String>()
var shared = List<String>()
var receiving_calls = List<HighIntermediaryRepresentation.Values.Call>()
var receiving_keys = List<String>()
var held_locals = Dictionary<String, String>()
var declared_names = List<String>()
var loop_depth = 0
var in_defaults = false
var defaults = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var span_locals = List<String>()
var quiet_depth = 0
var library = Validators.LibraryFile()
var drops_known = false
var program_drops = false
var pure_owners = ["List", "Dictionary", "String", "Buffer"]
var protected_names = ["_buffer", "_length", "item_count", "handle", "address", "context", "_function", "_cell"]
var plain_conversions: List<HighIntermediaryRepresentation.Values.Conversion.Kind> = [
    'present'
    'nullable'
    'into_union'
    'widen'
    'into_shape'
    'to_decimal'
]
var scalars = Model.Scalars()

# ../../OPTIMIZATIONS.md#untouched-attributes-have-no-slot
# ../../OPTIMIZATIONS.md#attributes-nothing-writes-are-rebuilt-where-read
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    program = high
    var built = program.built_functions.copy()
    built.each(read_a_function)
    facts = HighIntermediaryRepresentation.Building.Facts(context.program, built, no_exclusions)
    judge_the_receivers()
    if is_interactive() {
        var text_class = context.program.class_named("String")
        crash text_class
        shrink_a_class(text_class)
        return
    }
    program.packs_layouts = true
    context.program.order.each(shrink_a_class)
    program.shared_members = shared
}

func is_interactive(): Boolean {
    var flags = context.build_flags
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func read_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    if function.function.name == "_attribute_defaults" {
        defaults[function.function.owner] = function
    }
    in_defaults = function.function.name == "_attribute_defaults"
    held_locals = Dictionary<String, String>()
    declared_names = List<String>()
    loop_depth = 0
    read_a_block(function.body)
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_declaration(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_an_assignment(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.Return: look(statement.value)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
    }
}

func read_an_evaluation(statement: HighIntermediaryRepresentation.Statements.Evaluate) {
    look(statement.value)
    look(statement.waited)
}

func read_a_stop(statement: HighIntermediaryRepresentation.Statements.Stop) {
    statement.shown.each(look_present)
    look(statement.then)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    look(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    loop_depth = loop_depth + 1
    look(loop.condition)
    read_a_block(loop.body)
    loop_depth = loop_depth - 1
}

func read_a_declaration(name: String, value: Value?) {
    if declared_names.contains(name) {
        spoil_the_local(name)
    }
    declared_names.append(name)
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        hold_in_a_local(name, value)
        return
    }
    look(value)
}

func hold_in_a_local(name: String, read: HighIntermediaryRepresentation.Values.AttributeRead) {
    var key = key_of(read.attribute)
    note_a_read(key, read)
    held_locals[name] = key
}

func read_an_assignment(name: String, value: Value?) {
    spoil_the_local(name)
    look(value)
}

func spoil_the_local(name: String) {
    var key = held_locals[name]
    fallback key
    add(spoiled, key)
}

func read_an_attribute_write(statement: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var is_a_default = is_its_default(statement)
    if not is_a_default {
        var key = key_of(statement.attribute)
        add(written, key)
    }
    look(statement.object)
    look(statement.value)
}

func is_its_default(statement: HighIntermediaryRepresentation.Statements.Assign.Attribute): Boolean {
    var object = statement.object
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        return in_defaults
    }
    return false
}

func read_a_shape_write(statement: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    note_the_fillers(statement.shape.key, statement.member, true)
    look(statement.object)
    look(statement.value)
}

func note_the_fillers(shape_key: String, member: String, is_a_write: Boolean) {
    var fillers = context.program.fillers_of(shape_key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        note_a_filler(filler, member, is_a_write)
        index = index + 1
    }
    add(shared, "{shape_key}|{member}")
}

func note_a_filler(filler: Model.Type, member: String, is_a_write: Boolean) {
    var model = context.program.class_named(filler.name)
    fallback model
    var attribute = model.attribute_named(member)
    fallback attribute
    var key = key_of(attribute)
    add(through_shapes, key)
    add(read_keys, key)
    if is_a_write {
        add(written, key)
    }
}

func look_present(value: Value) {
    look(value)
}

func look_both(
    first: Value?,
    second: Value?,
) {
    look(first)
    look(second)
}

func look(value: Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Call: look_a_call(value)
        HighIntermediaryRepresentation.Values.AttributeRead: look_an_attribute(value)
        HighIntermediaryRepresentation.Values.LocalRead: spoil_the_local(value.name)
        HighIntermediaryRepresentation.Values.Conversion: look(value.converted)
        HighIntermediaryRepresentation.Values.Class.OfValue: look(value.described)
        HighIntermediaryRepresentation.Values.Class.Membership: look(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: look(value.text)
        HighIntermediaryRepresentation.Values.EnumText: look(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: look_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Function.Value: look(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: look_a_value_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: look_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(look_present)
        HighIntermediaryRepresentation.Values.Negation: look(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: look_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: look(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: look_a_shape_call(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func look_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    look(call.library)
    call.arguments.each(look_present)
    call.arguments.each(write_a_passed_struct)
}

func write_a_passed_struct(argument: Value) {
    fallback argument.value_type.kind == 'shape'
    var shape = context.program.shape_keyed(argument.value_type.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            note_the_fillers(shape.key, member.name, true)
        }
        index = index + 1
    }
}

func look_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    look(call.called)
    call.arguments.each(look_present)
}

func look_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    var reads_an_attribute = call.member.is_an_attribute or call.arguments.is_empty()
    if reads_an_attribute {
        note_the_shape_read(call.shape.key, call.member.name)
    }
    look(call.receiver)
    call.arguments.each(look_present)
}

func note_the_shape_read(shape_key: String, member: String) {
    var fillers = context.program.fillers_of(shape_key)
    var every_filler_holds_it = true
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if not holds_the_attribute(filler, member) {
            every_filler_holds_it = false
        }
        note_a_filler(filler, member, false)
        index = index + 1
    }
    if every_filler_holds_it {
        add(shared, "{shape_key}|{member}")
    }
}

func holds_the_attribute(filler: Model.Type, member: String): Boolean {
    var model = context.program.class_named(filler.name)
    fallback model
    if model.attribute_named(member) {
        return true
    }
    return false
}

func look_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var receiver = call.receiver
    if receiver.class == HighIntermediaryRepresentation.Values.AttributeRead {
        receive_a_read(call, receiver)
    } else if receiver.class == HighIntermediaryRepresentation.Values.LocalRead {
        receive_a_local(call, receiver)
    } else {
        look(receiver)
    }
    call.arguments.each(look_present)
}

func receive_a_read(
    call: HighIntermediaryRepresentation.Values.Call,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
) {
    var key = key_of(read.attribute)
    note_a_read(key, read)
    receiving_calls.append(call)
    receiving_keys.append(key)
}

func receive_a_local(
    call: HighIntermediaryRepresentation.Values.Call,
    local: HighIntermediaryRepresentation.Values.LocalRead,
) {
    var key = held_locals[local.name]
    fallback key
    receiving_calls.append(call)
    receiving_keys.append(key)
}

func note_a_read(key: String, read: HighIntermediaryRepresentation.Values.AttributeRead) {
    add(read_keys, key)
    if loop_depth > 0 {
        add(looped, key)
    }
    var object = read.object
    var is_plain = object.class == HighIntermediaryRepresentation.Values.ThisRead
    if object.class == HighIntermediaryRepresentation.Values.LocalRead {
        is_plain = true
        spoil_the_local(object.name)
    }
    if not is_plain {
        add(unplain, key)
        look(object)
    }
}

func look_an_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    var key = key_of(read.attribute)
    note_a_read(key, read)
    add(spoiled, key)
}

func judge_the_receivers() {
    var asked = List<String>()
    var index = 0
    while index < receiving_calls.count() {
        var call = receiving_calls[index]
        var key = call.function.key()
        var is_built = facts.bodies.contains(key)
        if is_built and not asked.contains(key) {
            asked.append(key)
        }
        index = index + 1
    }
    if not asked.is_empty() {
        facts.study(asked)
    }
    var judged = 0
    while judged < receiving_calls.count() {
        var receiving = receiving_calls[judged]
        var receiving_key = receiving_keys[judged]
        crash receiving_key
        if not leaves_its_receiver(receiving) {
            add(spoiled, receiving_key)
        }
        judged = judged + 1
    }
}

func leaves_its_receiver(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var function = call.function
    var key = function.key()
    fallback facts.bodies.contains(key)
    fallback not facts.writes(function, "this")
    if not function.answer {
        return true
    }
    if facts.is_immutable(function.answer) {
        return true
    }
    return not facts.returned.contains("{key}|this")
}

func shrink_a_class(model: Model.ClassModel) {
    var is_fixed = keeps_its_declared_layout(model)
    var found = defaults[model.key]
    fallback found
    var spans = spans_of(model, found.body)
    fallback spans.count() == model.declared_attributes.count()
    var kept = List<Statement>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var span = spans[index]
        crash span
        var leaves = false
        if is_fixed {
            leaves = leaves_out_a_named_number(attribute, span)
        } else {
            leaves = leaves_out(model, attribute, span)
        }
        if not leaves {
            refuse_a_text_in_every_text(model, attribute, span)
            keep_the_span(kept, span)
        }
        index = index + 1
    }
    found.body.statements = kept
}

# ../../../spite_spec/specs/values_and_types.md#named-numbers
func leaves_out_a_named_number(attribute: Model.AttributeModel, span: List<Statement>): Boolean {
    var key = key_of(attribute)
    fallback attribute.name.starts_with("_") and not protected_names.contains(attribute.name)
    fallback not written.contains(key) and not read_keys.contains(key)
    fallback is_pure(span)
    program.absent_attributes.append(key)
    return true
}

func refuse_a_text_in_every_text(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    span: List<Statement>,
) {
    fallback model.key == "String" and not protected_names.contains(attribute.name)
    fallback span.any(makes_a_text)
    crash attribute.declaration
    var failure = Validators.Failure()
    failure.stop_at(
        model.file.path,
        attribute.declaration.line,
        "String",
        "the attribute '{attribute.name}' of String would be made with every text, and its default makes texts, so making a text would never end: never write it, and make its default only of literals, so the compiler rebuilds it where it is read",
    )
}

func makes_a_text(statement: Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return holds_a_text(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return holds_a_text(statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: return holds_a_text(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return holds_a_text(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return true
        HighIntermediaryRepresentation.Statements.If: return true
        HighIntermediaryRepresentation.Statements.While: return true
        HighIntermediaryRepresentation.Statements.Return: return true
        HighIntermediaryRepresentation.Statements.Stop: return true
        HighIntermediaryRepresentation.Statements.Block: return true
    }
}

func holds_a_text(value: Value?): Boolean {
    fallback value
    if is_a_text(value.value_type) {
        return true
    }
    switch value {
        HighIntermediaryRepresentation.Values.Call: return a_call_holds_a_text(value)
        HighIntermediaryRepresentation.Values.MakeObject: return value.arguments.any(an_argument_holds_a_text)
        HighIntermediaryRepresentation.Values.Conversion: return holds_a_text(value.converted)
        HighIntermediaryRepresentation.Values.LocalRead: return false
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return true
        HighIntermediaryRepresentation.Values.MachineOperation: return true
        HighIntermediaryRepresentation.Values.Negation: return true
        HighIntermediaryRepresentation.Values.ForeignCall: return true
        HighIntermediaryRepresentation.Values.Class.Membership: return true
        HighIntermediaryRepresentation.Values.PresenceTest: return true
        HighIntermediaryRepresentation.Values.Function.Value: return true
        HighIntermediaryRepresentation.Values.Function.ValueCall: return true
        HighIntermediaryRepresentation.Values.NumberRoom: return true
        HighIntermediaryRepresentation.Values.ShapeCall: return true
        HighIntermediaryRepresentation.Values.EnumText: return true
        HighIntermediaryRepresentation.Values.EnumFromText: return true
        HighIntermediaryRepresentation.Values.Class.Object: return true
        HighIntermediaryRepresentation.Values.Class.OfValue: return true
        HighIntermediaryRepresentation.Values.Function.Fact: return true
    }
}

func a_call_holds_a_text(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if holds_a_text(call.receiver) {
        return true
    }
    return call.arguments.any(an_argument_holds_a_text)
}

func an_argument_holds_a_text(value: Value): Boolean {
    return holds_a_text(value)
}

func keep_the_span(
    kept: List<Statement>,
    span: List<Statement>,
) {
    var index = 0
    while index < span.count() {
        var statement = span[index]
        kept.append(statement)
        index = index + 1
    }
}

func keeps_its_declared_layout(model: Model.ClassModel): Boolean {
    var key = model.key
    var is_fixed = key == "Buffer" or key == "ForeignCallback" or key.starts_with("Spite.")
    return is_fixed or scalars.is_a_scalar(key)
}

func spans_of(
    model: Model.ClassModel,
    body: HighIntermediaryRepresentation.Statements.Block,
): List<List<Statement>> {
    var spans = List<List<Statement>>()
    var unmatched = List<List<Statement>>()
    var span = List<Statement>()
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        span.append(statement)
        var closed = closed_attribute(model, statement)
        if closed != "" {
            var position = spans.count()
            if not is_the_next(model, position, closed) {
                return unmatched
            }
            spans.append(span)
            span = List<Statement>()
        }
        index = index + 1
    }
    if not span.is_empty() {
        return unmatched
    }
    return spans
}

func is_the_next(model: Model.ClassModel, position: Integer, closed: String): Boolean {
    var wanted = model.declared_attributes[position]
    fallback wanted
    return wanted.name == closed
}

func closed_attribute(model: Model.ClassModel, statement: Statement): String {
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        var object = statement.object
        var is_its_own = object.class == HighIntermediaryRepresentation.Values.ThisRead
        if is_its_own and statement.attribute.owner == model.key {
            return statement.attribute.name
        }
    }
    return ""
}

func leaves_out(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    span: List<Statement>,
): Boolean {
    var key = key_of(attribute)
    var may_go = not protected_names.contains(attribute.name) and not written.contains(key)
    fallback may_go and is_pure(span)
    if not read_keys.contains(key) {
        program.absent_attributes.append(key)
        return true
    }
    var is_unchanging_value = is_unchanging(attribute.attribute_type)
    if model.key == "String" and not is_unchanging_value {
        rebuild(model, attribute, span)
        return true
    }
    fallback not through_shapes.contains(key) and not unplain.contains(key)
    var is_held_by_one = model.is_singleton or model.key == context.program.entry
    if not is_held_by_one and holds_a_quiet_singleton(span) {
        rebuild(model, attribute, span)
        return true
    }
    if is_unchanging_value {
        stand_in(model, attribute, span)
        return true
    }
    var is_one_object = model.is_singleton or model.key == context.program.entry
    var may_change = spoiled.contains(key) and not is_a_text(attribute.attribute_type)
    fallback not may_change and not looped.contains(key) and not is_one_object
    rebuild(model, attribute, span)
    return true
}

func is_a_text(of_type: Model.Type): Boolean {
    return of_type.kind == 'object' and of_type.name == "String"
}

func is_unchanging(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration'
}

func stand_in(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    span: List<Statement>,
) {
    var key = key_of(attribute)
    var only = span.first()
    crash only
    var value = assigned_value(only)
    var is_constant = span.count() == 1 and is_a_constant(value)
    if is_constant {
        crash value
        program.absent_attributes.append(key)
        program.folded_attributes[key] = value
        return
    }
    rebuild(model, attribute, span)
}

func assigned_value(
    statement: Statement,
): Value? {
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        return statement.value
    }
    return null
}

func is_a_constant(value: Value?): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.NullConstant: return true
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.LocalRead: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Conversion: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func rebuild(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    span: List<Statement>,
) {
    var key = key_of(attribute)
    var made = Model.FunctionModel("_rebuilt_{attribute.name}", model.key)
    made.is_synthetic = true
    made.answer = attribute.attribute_type
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var last_index = span.count() - 1
    var index = 0
    while index < last_index {
        var statement = span[index]
        body.statements.append(statement)
        index = index + 1
    }
    var last = span.last()
    crash last
    var value = assigned_value(last)
    crash value
    var answered = HighIntermediaryRepresentation.Statements.Return(value)
    body.statements.append(answered)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    program.built_functions.append(function)
    program.absent_attributes.append(key)
    program.rebuilt_attributes[key] = made
}

func is_pure(span: List<Statement>): Boolean {
    span_locals = List<String>()
    var last_index = span.count() - 1
    var index = 0
    while index < span.count() {
        var statement = span[index]
        fallback is_a_pure_statement(statement, index == last_index)
        index = index + 1
    }
    return true
}

func is_a_pure_statement(
    statement: Statement,
    is_the_last: Boolean,
): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return is_a_pure_naming(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: return is_pure_value(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return is_the_assignment(statement, is_the_last)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return false
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return false
        HighIntermediaryRepresentation.Statements.If: return false
        HighIntermediaryRepresentation.Statements.While: return false
        HighIntermediaryRepresentation.Statements.Return: return false
        HighIntermediaryRepresentation.Statements.Stop: return false
        HighIntermediaryRepresentation.Statements.Block: return false
    }
}

func is_a_pure_naming(name: String, value: Value?): Boolean {
    fallback is_pure_value(value)
    span_locals.append(name)
    return true
}

func is_the_assignment(
    statement: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    is_the_last: Boolean,
): Boolean {
    var object = statement.object
    var is_its_own = object.class == HighIntermediaryRepresentation.Values.ThisRead
    return is_the_last and is_its_own and is_pure_value(statement.value)
}

func is_pure_value(value: Value?): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.NullConstant: return true
        HighIntermediaryRepresentation.Values.LocalRead: return span_locals.contains(value.name)
        HighIntermediaryRepresentation.Values.Negation: return is_pure_value(value.negated)
        HighIntermediaryRepresentation.Values.Conversion: return is_a_pure_conversion(value)
        HighIntermediaryRepresentation.Values.MakeObject: return is_a_pure_making(value)
        HighIntermediaryRepresentation.Values.Call: return is_a_pure_call(value)
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func the_program_drops(): Boolean {
    if drops_known {
        return program_drops
    }
    drops_known = true
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        var declared = function.function
        if declared.name == "drop" and is_the_programs(declared.owner) {
            program_drops = true
        }
        index = index + 1
    }
    return program_drops
}

func is_the_programs(owner: String): Boolean {
    var model = context.program.class_named(owner)
    if not model {
        return true
    }
    return not library.holds(model.file.path)
}

func holds_a_quiet_singleton(span: List<Statement>): Boolean {
    fallback span.count() == 1
    var only = span.first()
    crash only
    var value = assigned_value(only)
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return is_a_quiet_singleton(value)
    }
    return false
}

func is_a_quiet_singleton(made: HighIntermediaryRepresentation.Values.MakeObject): Boolean {
    fallback made.arguments.is_empty() and made.value_type.kind == 'object' and quiet_depth <= 3
    fallback not the_program_drops()
    var model = context.program.class_named(made.value_type.name)
    fallback model
    fallback model.is_singleton
    fallback not model.function_named("drop")
    var outer_locals = span_locals
    quiet_depth = quiet_depth + 1
    var quiet = makes_only_its_own(model.key, "_attribute_defaults")
    if quiet and made.constructor {
        quiet = makes_only_its_own(model.key, made.constructor.name)
    }
    quiet_depth = quiet_depth - 1
    span_locals = outer_locals
    if quiet and not program.quiet_singletons.contains(model.key) {
        program.quiet_singletons.append(model.key)
    }
    return quiet
}

func makes_only_its_own(owner: String, name: String): Boolean {
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        var declared = function.function
        if declared.owner == owner and declared.name == name {
            fallback declared.parameters.is_empty()
            return function.body.statements.all(is_a_quiet_statement)
        }
        index = index + 1
    }
    return name == "_attribute_defaults"
}

func is_a_quiet_statement(statement: Statement): Boolean {
    span_locals = List<String>()
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        var object = statement.object
        var is_its_own = object.class == HighIntermediaryRepresentation.Values.ThisRead
        return is_its_own and is_pure_value(statement.value)
    }
    return false
}

func is_a_pure_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    fallback plain_conversions.contains(conversion.kind)
    return is_pure_value(conversion.converted)
}

func is_a_pure_making(made: HighIntermediaryRepresentation.Values.MakeObject): Boolean {
    if is_a_quiet_singleton(made) {
        return true
    }
    fallback is_a_pure_owner(made.value_type.name)
    fallback not made.constructor or is_a_pure_owner(made.constructor.owner)
    return made.arguments.all(is_a_pure_argument)
}

func is_a_pure_call(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback is_a_pure_owner(call.function.owner)
    fallback is_pure_value(call.receiver)
    return call.arguments.all(is_a_pure_argument)
}

func is_a_pure_argument(value: Value): Boolean {
    return is_pure_value(value)
}

func is_a_pure_owner(owner: String): Boolean {
    var simple = owner
    var opening = owner.index_of("<")
    if opening and opening > 0 {
        var sliced_simple = owner.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    var bound = simple.index_of("_of_")
    if bound and bound > 0 {
        var sliced_simple = simple.slice(0, bound)
        crash sliced_simple
        simple = sliced_simple
    }
    return pure_owners.contains(simple)
}

func key_of(attribute: Model.AttributeModel): String {
    return "{attribute.owner}.{attribute.name}"
}

func add(listed: List<String>, key: String) {
    if not listed.contains(key) {
        listed.append(key)
    }
}

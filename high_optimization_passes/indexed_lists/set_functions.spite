# ../../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(program)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file, false)
var dictionary = Model.ClassModel("", "", no_file, false)
var no_type = Model.Type('nothing', "")
var index_attribute = Model.AttributeModel("", "", no_type, null, false)
var searched_attribute = Model.AttributeModel("", "", no_type, null, false)
var item = Model.Type('nothing', "")
var index_type = Model.Type('nothing', "")
var integer = Model.Type('scalar', "Integer")
var boolean = Model.Type('scalar', "Boolean")
var index_name = "_index$set"
var searched_name = "_searched$set"
var smallest_indexed_count = 16
var searches_paid_for = 16
var list_names = ["count", "get_at", "append", "contains", "index_of"]
var dictionary_names = ["contains", "get_at", "set_at"]
var writing_names = ["append"]
var placing_names = ["set_at"]
var able_owners = List<String>()
var unable_owners = List<String>()

func SetFunctions(
    starting_program: HighIntermediaryRepresentation.HighProgram,
    starting_building: HighOptimizationPasses.FunctionBuilding,
) {
    program = starting_program
    building = starting_building
}

# ../../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index
func can_index(function: Model.FunctionModel): Boolean {
    if able_owners.contains(function.owner) {
        return true
    }
    fallback not unable_owners.contains(function.owner)
    if finds_what_it_needs(function) {
        able_owners.append(function.owner)
        return true
    }
    unable_owners.append(function.owner)
    return false
}

func finds_what_it_needs(function: Model.FunctionModel): Boolean {
    crash program.context
    var list_owner = program.context.program.class_named(function.owner)
    var places = program.context.program.class_named("List_of_Integer")
    fallback list_owner and places and function.parameters.count() == 1
    fallback has_built(list_owner, list_names) and has_built(places, list_names)
    var parameter = function.parameters[0]
    var keyed = List<Model.Type>()
    keyed.append(parameter.parameter_type)
    var whole = program.context.scalar_type("Integer")
    keyed.append(whole)
    var keyed_type = program.context.resolver.monomorphiser.instance_named("Dictionary", keyed)
    var keyed_owner = program.context.program.class_named(keyed_type.name)
    fallback keyed_owner and has_built(keyed_owner, dictionary_names)
    var built_already = is_each_built(list_owner, writing_names) and is_each_built(places, writing_names)
    if built_already and is_each_built(keyed_owner, placing_names) {
        return true
    }
    var written = List<String>()
    written.append(list_owner.key)
    written.append(places.key)
    written.append(keyed_owner.key)
    written.append("Buffer")
    return leaves_alone(written)
}

func leaves_alone(class_keys: List<String>): Boolean {
    var keys = program.numbers_nothing_writes.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var parts = key.split(".")
        var owner_key = parts.first()
        crash owner_key
        fallback not class_keys.contains(owner_key)
        index = index + 1
    }
    return true
}

func has_built(model: Model.ClassModel, names: List<String>): Boolean {
    var index = 0
    while index < names.count() {
        var name = names[index]
        fallback can_build("{model.key}.{name}")
        index = index + 1
    }
    return true
}

func is_each_built(model: Model.ClassModel, names: List<String>): Boolean {
    var index = 0
    while index < names.count() {
        var name = names[index]
        fallback is_built("{model.key}.{name}")
        index = index + 1
    }
    return true
}

func can_build(key: String): Boolean {
    crash program.context
    if not program.context.queued.contains(key) {
        return true
    }
    return is_built(key)
}

func is_built(key: String): Boolean {
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        if function.function.key() == key {
            return true
        }
        index = index + 1
    }
    return false
}

func hashed_function_of(function: Model.FunctionModel): Model.FunctionModel {
    crash program.context
    context = program.context
    integer = context.scalar_type("Integer")
    boolean = context.scalar_type("Boolean")
    var list_owner = context.program.class_named(function.owner)
    crash list_owner
    owner = list_owner
    var parameter = function.parameters[0]
    crash parameter
    item = parameter.parameter_type
    give_an_index()
    var name = "{function.name}$set"
    var known = owner.function_named(name)
    if known {
        return known
    }
    if function.name == "append" {
        return made_append(name)
    }
    if function.name == "index_of" {
        var searching = list_function("index_of")
        var finding = dictionary_function("get_at")
        return made_search(name, searching, finding)
    }
    crash function.name == "contains"
    var containing = list_function("contains")
    var holding = dictionary_function("contains")
    return made_search(name, containing, holding)
}

func give_an_index() {
    var keyed = List<Model.Type>()
    keyed.append(item)
    keyed.append(integer)
    var keyed_type = context.resolver.monomorphiser.instance_named("Dictionary", keyed)
    var found = context.program.class_named(keyed_type.name)
    crash found
    dictionary = found
    index_type = found.type_of_an_instance()
    building.need_defaults(dictionary.key)
    var known = owner.attribute_named(index_name)
    var known_searches = owner.attribute_named(searched_name)
    if known and known_searches {
        index_attribute = known
        searched_attribute = known_searches
        return
    }
    var held_type = keyed_type.nullable()
    index_attribute = Model.AttributeModel(index_name, owner.key, held_type, null, false)
    owner.declared_attributes.append(index_attribute)
    searched_attribute = Model.AttributeModel(searched_name, owner.key, integer, null, false)
    owner.declared_attributes.append(searched_attribute)
    start_with_no_index()
}

func start_with_no_index() {
    var key = "{owner.key}._attribute_defaults"
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        if function.function.key() == key {
            var own = this_value()
            var nothing = HighIntermediaryRepresentation.Values.NullConstant(index_attribute.attribute_type)
            var starting = HighIntermediaryRepresentation.Statements.Assign.Attribute(own, index_attribute, nothing, 0)
            function.body.statements.append(starting)
            var searched_own = this_value()
            var zero = number(0)
            var counting = HighIntermediaryRepresentation.Statements.Assign.Attribute(
                searched_own,
                searched_attribute,
                zero,
                0,
            )
            function.body.statements.append(counting)
        }
        index = index + 1
    }
}

func list_function(name: String): Model.FunctionModel {
    var found = owner.function_named(name)
    crash found
    building.need(found)
    return found
}

func dictionary_function(name: String): Model.FunctionModel {
    var found = dictionary.function_named(name)
    crash found
    building.need(found)
    return found
}

func made_search(name: String, plain: Model.FunctionModel, hashed: Model.FunctionModel): Model.FunctionModel {
    var paying = made_paid(plain)
    var made = function_named(name, plain.answer)
    placed_like(made, plain)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var unindexed = HighIntermediaryRepresentation.Statements.Block(0)
    var unpaid = HighIntermediaryRepresentation.Statements.Block(0)
    var plain_answer_item = given_item()
    var plain_answer = call_on_the_list(plain, plain_answer_item)
    var answered_plainly = HighIntermediaryRepresentation.Statements.Return(plain_answer, 0)
    unpaid.statements.append(answered_plainly)
    var paid = call_on_the_list(paying, null)
    var not_paid = HighIntermediaryRepresentation.Values.Negation(paid)
    var searching_plainly = HighIntermediaryRepresentation.Statements.If(not_paid, unpaid, null, 0, "")
    unindexed.statements.append(searching_plainly)
    var missing = no_index_yet()
    var plainly = HighIntermediaryRepresentation.Statements.If(missing, unindexed, null, 0, "")
    body.statements.append(plainly)
    var arguments = List<SpiteCompiler.Value>()
    var sought = given_item()
    arguments.append(sought)
    var index = present_index()
    var hashed_answer = HighIntermediaryRepresentation.Values.Call(hashed, index, arguments, "", "")
    var answered = HighIntermediaryRepresentation.Statements.Return(hashed_answer, 0)
    body.statements.append(answered)
    add(made, body)
    return made
}

# ../../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index
func placed_like(made: Model.FunctionModel, plain: Model.FunctionModel) {
    fallback plain.declaration
    made.placed_at_line = plain.declaration.line
}

func made_paid(plain: Model.FunctionModel): Model.FunctionModel {
    var name = "_index_paid_for$set"
    var known = owner.function_named(name)
    if known {
        return known
    }
    var counting = list_function("count")
    var building_it = made_built()
    var made = function_named(name, boolean)
    made.parameters = List<Model.ParameterModel>()
    placed_like(made, plain)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var counted = call_on_the_list(counting, null)
    var naming = HighIntermediaryRepresentation.Statements.Declare("counted", integer, counted, 0, "")
    body.statements.append(naming)
    var small_count = HighIntermediaryRepresentation.Values.LocalRead(integer, "counted")
    var smallest = number(smallest_indexed_count)
    var is_small = operation('less', small_count, smallest, boolean)
    answer_no_when(body, is_small)
    var searched_before = searched_read()
    var added_count = HighIntermediaryRepresentation.Values.LocalRead(integer, "counted")
    var searched_now = operation('add', searched_before, added_count, integer)
    var searched_own = this_value()
    var noting = HighIntermediaryRepresentation.Statements.Assign.Attribute(
        searched_own,
        searched_attribute,
        searched_now,
        0,
    )
    body.statements.append(noting)
    var searched_total = searched_read()
    var paid_for = number(searches_paid_for)
    var searches = operation('divide', searched_total, paid_for, integer)
    var held_count = HighIntermediaryRepresentation.Values.LocalRead(integer, "counted")
    var is_unpaid = operation('less', searches, held_count, boolean)
    answer_no_when(body, is_unpaid)
    var built = call_on_the_list(building_it, null)
    var building_the_index = HighIntermediaryRepresentation.Statements.Evaluate(built, 0)
    body.statements.append(building_the_index)
    var yes = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1, false)
    var paying = HighIntermediaryRepresentation.Statements.Return(yes, 0)
    body.statements.append(paying)
    add(made, body)
    return made
}

func made_built(): Model.FunctionModel {
    var name = "_index_built$set"
    var known = owner.function_named(name)
    if known {
        return known
    }
    var counting = list_function("count")
    var reading = list_function("get_at")
    var holding = dictionary_function("contains")
    var placing = dictionary_function("set_at")
    var made = function_named(name, null)
    made.parameters = List<Model.ParameterModel>()
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    index_what_is_held(body, counting, reading, holding, placing)
    add(made, body)
    return made
}

func answer_no_when(body: HighIntermediaryRepresentation.Statements.Block, condition: SpiteCompiler.Value) {
    var refusing = HighIntermediaryRepresentation.Statements.Block(0)
    var no = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 0, false)
    var refused = HighIntermediaryRepresentation.Statements.Return(no, 0)
    refusing.statements.append(refused)
    var choosing = HighIntermediaryRepresentation.Statements.If(condition, refusing, null, 0, "")
    body.statements.append(choosing)
}

func searched_read(): HighIntermediaryRepresentation.Values.AttributeRead {
    var own = this_value()
    return HighIntermediaryRepresentation.Values.AttributeRead(own, searched_attribute)
}

func made_append(name: String): Model.FunctionModel {
    var appending = list_function("append")
    var counting = list_function("count")
    var holding = dictionary_function("contains")
    var placing = dictionary_function("set_at")
    var made = function_named(name, null)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var unindexed = HighIntermediaryRepresentation.Statements.Block(0)
    var plain_item = given_item()
    var plainly_appended = call_on_the_list(appending, plain_item)
    var appending_plainly = HighIntermediaryRepresentation.Statements.Evaluate(plainly_appended, 0)
    unindexed.statements.append(appending_plainly)
    var leaving = HighIntermediaryRepresentation.Statements.Return(null, 0)
    unindexed.statements.append(leaving)
    var missing = no_index_yet()
    var plainly = HighIntermediaryRepresentation.Statements.If(missing, unindexed, null, 0, "")
    body.statements.append(plainly)
    var index = present_index()
    var naming = HighIntermediaryRepresentation.Statements.Declare("index", index_type, index, 0, "")
    body.statements.append(naming)
    var place = call_on_the_list(counting, null)
    place_once(body, "index", "value", place, holding, placing)
    var appended_item = given_item()
    var appended = call_on_the_list(appending, appended_item)
    var appending_it = HighIntermediaryRepresentation.Statements.Evaluate(appended, 0)
    body.statements.append(appending_it)
    add(made, body)
    return made
}

func index_what_is_held(
    block: HighIntermediaryRepresentation.Statements.Block,
    counting: Model.FunctionModel,
    reading: Model.FunctionModel,
    holding: Model.FunctionModel,
    placing: Model.FunctionModel,
) {
    var no_values = List<SpiteCompiler.Value>()
    var making = HighIntermediaryRepresentation.Values.MakeObject(index_type, null, no_values, "", false)
    var made = HighIntermediaryRepresentation.Statements.Declare("made", index_type, making, 0, "")
    block.statements.append(made)
    var first = number(0)
    var starting = HighIntermediaryRepresentation.Statements.Declare("position", integer, first, 0, "")
    block.statements.append(starting)
    var walking = HighIntermediaryRepresentation.Statements.Block(0)
    var position = HighIntermediaryRepresentation.Values.LocalRead(integer, "position")
    var read = call_on_the_list(reading, position)
    var held = HighIntermediaryRepresentation.Values.Conversion(item, 'proven', read, "")
    var naming = HighIntermediaryRepresentation.Statements.Declare("held", item, held, 0, "")
    walking.statements.append(naming)
    var place = HighIntermediaryRepresentation.Values.LocalRead(integer, "position")
    place_once(walking, "made", "held", place, holding, placing)
    var current = HighIntermediaryRepresentation.Values.LocalRead(integer, "position")
    var one = number(1)
    var next = operation('add', current, one, integer)
    var stepped = HighIntermediaryRepresentation.Statements.Assign.Assign("position", next, 0)
    walking.statements.append(stepped)
    var reached = HighIntermediaryRepresentation.Values.LocalRead(integer, "position")
    var counted = call_on_the_list(counting, null)
    var more = operation('less', reached, counted, boolean)
    var loop = HighIntermediaryRepresentation.Statements.While(more, walking, 0)
    block.statements.append(loop)
    var own = this_value()
    var made_index = HighIntermediaryRepresentation.Values.LocalRead(index_type, "made")
    var kept = HighIntermediaryRepresentation.Values.Conversion(
        index_attribute.attribute_type,
        'nullable',
        made_index,
        "",
    )
    var keeping = HighIntermediaryRepresentation.Statements.Assign.Attribute(own, index_attribute, kept, 0)
    block.statements.append(keeping)
}

func place_once(
    block: HighIntermediaryRepresentation.Statements.Block,
    index_name: String,
    key_name: String,
    place: SpiteCompiler.Value,
    holding: Model.FunctionModel,
    placing: Model.FunctionModel,
) {
    var asked = List<SpiteCompiler.Value>()
    var key = HighIntermediaryRepresentation.Values.LocalRead(item, key_name)
    asked.append(key)
    var index = HighIntermediaryRepresentation.Values.LocalRead(index_type, index_name)
    var held = HighIntermediaryRepresentation.Values.Call(holding, index, asked, "", "")
    var missing = HighIntermediaryRepresentation.Values.Negation(held)
    var placed = HighIntermediaryRepresentation.Statements.Block(0)
    var placed_key = HighIntermediaryRepresentation.Values.LocalRead(item, key_name)
    var placed_index = HighIntermediaryRepresentation.Values.LocalRead(index_type, index_name)
    var given = List<SpiteCompiler.Value>()
    given.append(placed_key)
    given.append(place)
    var setting = HighIntermediaryRepresentation.Values.Call(placing, placed_index, given, "", "")
    var set_it = HighIntermediaryRepresentation.Statements.Evaluate(setting, 0)
    placed.statements.append(set_it)
    var choosing = HighIntermediaryRepresentation.Statements.If(missing, placed, null, 0, "")
    block.statements.append(choosing)
}

func call_on_the_list(
    function: Model.FunctionModel,
    given: SpiteCompiler.Value?,
): HighIntermediaryRepresentation.Values.Call {
    var arguments = List<SpiteCompiler.Value>()
    if given {
        arguments.append(given)
    }
    var own = this_value()
    return HighIntermediaryRepresentation.Values.Call(function, own, arguments, "", "")
}

func no_index_yet(): HighIntermediaryRepresentation.Values.Negation {
    var read = index_read()
    var held = HighIntermediaryRepresentation.Values.PresenceTest(read)
    return HighIntermediaryRepresentation.Values.Negation(held)
}

func index_read(): HighIntermediaryRepresentation.Values.AttributeRead {
    var own = this_value()
    return HighIntermediaryRepresentation.Values.AttributeRead(own, index_attribute)
}

func present_index(): HighIntermediaryRepresentation.Values.Conversion {
    var read = index_read()
    return HighIntermediaryRepresentation.Values.Conversion(index_type, 'present', read, "")
}

func given_item(): HighIntermediaryRepresentation.Values.LocalRead {
    return HighIntermediaryRepresentation.Values.LocalRead(item, "value")
}

func function_named(name: String, answer: Model.Type?): Model.FunctionModel {
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        owner.key,
        answer,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    var parameter = Model.ParameterModel("value", item, false)
    made.parameters.append(parameter)
    owner.declared_functions.append(made)
    return made
}

func add(made: Model.FunctionModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    program.built_functions.append(function)
}

func operation(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: SpiteCompiler.Value,
    right: SpiteCompiler.Value,
    answer: Model.Type,
): HighIntermediaryRepresentation.Values.MachineOperation {
    return HighIntermediaryRepresentation.Values.MachineOperation(answer, operator, left, right, null)
}

func number(written: Integer): HighIntermediaryRepresentation.Values.WholeNumber {
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, written, false)
}

func this_value(): HighIntermediaryRepresentation.Values.ThisRead {
    var own_type = owner.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.ThisRead(own_type)
}

# ../../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index

var no_program = Model.ProgramModel()
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(no_high)
var indexing = HighOptimizationPasses.IndexedLists.SetFunctions(no_high, building)
var integer = Model.Type('scalar', "Integer")
var found_count = 0

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    program = high
    building = HighOptimizationPasses.FunctionBuilding(high)
    indexing = HighOptimizationPasses.IndexedLists.SetFunctions(high, building)
    integer = high.context.scalar_type("Integer")
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var built = high.built_functions.copy()
    var index = 0
    while index < built.count() {
        var function = built[index]
        search_in_block(function.body)
        rewriting.rewrite_block(function.body)
        index = index + 1
    }
    building.build_the_needed()
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Call and value.is_on_a_set and indexing.can_index(value.function) {
        var hashed = indexing.hashed_function_of(value.function)
        value.function = hashed
    }
    return value
}

func search_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if index > 0 and is_a_set_search(statement) and can_index_the_search(block, index) {
            var start = block.statements[index - 1]
            crash start
            var search = HighIntermediaryRepresentation.SearchLoop(start, statement)
            crash search.matches()
            block.statements[index] = searched(search, statement.line)
        } else {
            search_inside(statement)
        }
        if makes_a_list(statement) {
            fill_plainly(block, index)
        }
        index = index + 1
    }
}

func makes_a_list(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    return statement.value.class == HighIntermediaryRepresentation.Values.MakeObject
}

# ../../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index
func fill_plainly(block: HighIntermediaryRepresentation.Statements.Block, made_at: Integer) {
    var made = block.statements[made_at]
    fallback made.class == HighIntermediaryRepresentation.Statements.Declare
    var index = made_at + 1
    while index < block.statements.count() {
        var statement = block.statements[index]
        fallback statement.class == HighIntermediaryRepresentation.Statements.Evaluate
        fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
        fallback statement.value.is_on_a_set and statement.value.function.name == "append"
        fallback reads_the_name(statement.value.receiver, made.name)
        fallback statement.value.arguments.all(is_a_constant)
        statement.value.is_on_a_set = false
        index = index + 1
    }
}

func reads_the_name(value: SpiteCompiler.Value?, name: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name == name
    }
    return false
}

func is_a_constant(value: SpiteCompiler.Value): Boolean {
    var is_text = value.class == HighIntermediaryRepresentation.Values.TextConstant
    return is_text or value.class == HighIntermediaryRepresentation.Values.WholeNumber
}

func can_index_the_search(block: HighIntermediaryRepresentation.Statements.Block, index: Integer): Boolean {
    var start = block.statements[index - 1]
    var loop = block.statements[index]
    crash start
    crash loop
    var search = HighIntermediaryRepresentation.SearchLoop(start, loop)
    crash search.matches()
    crash search.list
    crash program.context
    var owner = program.context.program.class_named(search.list.value_type.name)
    crash owner
    var searching = owner.function_named("index_of")
    crash searching
    return indexing.can_index(searching)
}

func is_a_set_search(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.While
    return statement.searches_a_set
}

func search_inside(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: search_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: search_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: search_in_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func search_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    search_in_block(branch.then_branch)
    search_in_block(branch.else_branch)
}

# ../../OPTIMIZATIONS.md#a-search-loop-over-such-a-list-is-one-lookup
func searched(
    search: HighIntermediaryRepresentation.SearchLoop,
    line: Integer,
): HighIntermediaryRepresentation.Statements.Block {
    crash search.list
    crash search.sought
    var searching = list_function(search.list, "index_of")
    var hashed = indexing.hashed_function_of(searching)
    var counting = list_function(search.list, "count")
    found_count = found_count + 1
    var found_name = "{search.counter}$found{found_count}"
    var found_type = integer.nullable()
    var replaced = HighIntermediaryRepresentation.Statements.Block(line)
    var arguments = List<SpiteCompiler.Value>()
    var sought_name = read_again(search.sought)
    crash sought_name
    arguments.append(sought_name)
    var searched_list = read_again(search.list)
    crash searched_list
    var finding = HighIntermediaryRepresentation.Values.Call(hashed, searched_list, arguments, "", "")
    var naming = HighIntermediaryRepresentation.Statements.Declare(found_name, found_type, finding, line, "")
    replaced.statements.append(naming)
    var found = HighIntermediaryRepresentation.Values.LocalRead(found_type, found_name)
    var is_found = HighIntermediaryRepresentation.Values.PresenceTest(found)
    var held = HighIntermediaryRepresentation.Values.LocalRead(found_type, found_name)
    var place = HighIntermediaryRepresentation.Values.Conversion(integer, 'present', held, "")
    var answering = HighIntermediaryRepresentation.Statements.Return(place, line)
    var answered = HighIntermediaryRepresentation.Statements.Block(line)
    answered.statements.append(answering)
    var choosing = HighIntermediaryRepresentation.Statements.If(is_found, answered, null, line, "")
    replaced.statements.append(choosing)
    var counted_list = read_again(search.list)
    crash counted_list
    var no_values = List<SpiteCompiler.Value>()
    var counted = HighIntermediaryRepresentation.Values.Call(counting, counted_list, no_values, "", "")
    var passed = HighIntermediaryRepresentation.Statements.Assign.Assign(search.counter, counted, line)
    replaced.statements.append(passed)
    return replaced
}

func list_function(list: SpiteCompiler.Value, name: String): Model.FunctionModel {
    crash program.context
    var owner = program.context.program.class_named(list.value_type.name)
    crash owner
    var found = owner.function_named(name)
    crash found
    building.need(found)
    return found
}

func read_again(value: SpiteCompiler.Value): SpiteCompiler.Value? {
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        crash value.object
        var own = HighIntermediaryRepresentation.Values.ThisRead(value.object.value_type)
        return HighIntermediaryRepresentation.Values.AttributeRead(own, value.attribute)
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, value.name)
    }
    return null
}

# ../../OPTIMIZATIONS.md#a-loop-over-a-lists-positions-whose-passes-write-only-what-they-alone-reach-runs-in-bands

func is_the_same(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?): Boolean {
    fallback first and second
    if first.class == HighIntermediaryRepresentation.Values.ThisRead {
        return second.class == HighIntermediaryRepresentation.Values.ThisRead
    }
    if first.class == HighIntermediaryRepresentation.Values.LocalRead {
        fallback second.class == HighIntermediaryRepresentation.Values.LocalRead
        return first.name == second.name
    }
    fallback first.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback second.class == HighIntermediaryRepresentation.Values.AttributeRead
    var first_attribute = first.attribute
    var second_attribute = second.attribute
    fallback first_attribute.owner == second_attribute.owner and first_attribute.name == second_attribute.name
    return is_the_same(first.object, second.object)
}

func is_stable(place: SpiteCompiler.Value?): Boolean {
    fallback place
    if place.class == HighIntermediaryRepresentation.Values.ThisRead {
        return true
    }
    if place.class == HighIntermediaryRepresentation.Values.LocalRead {
        return true
    }
    fallback place.class == HighIntermediaryRepresentation.Values.AttributeRead
    return is_stable(place.object)
}

func base_name(place: SpiteCompiler.Value?): String {
    fallback place
    if place.class == HighIntermediaryRepresentation.Values.LocalRead {
        return place.name
    }
    fallback place.class == HighIntermediaryRepresentation.Values.AttributeRead
    return base_name(place.object)
}

# ../../OPTIMIZATIONS.md#a-loop-over-a-lists-positions-whose-passes-write-only-what-they-alone-reach-runs-in-bands

var band: String
var start: String
var end: String
var split: String
var held: String

func BandNames(stem: String) {
    band = stem.copy()
    start = "{stem}$start"
    end = "{stem}$end"
    split = "{stem}$band_split"
    held = "{stem}$held_alone"
}

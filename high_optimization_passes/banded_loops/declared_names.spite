# ../../PROOFS.md#passes-that-write-only-what-they-alone-reach

var names = List<String>()
var assigned = List<String>()
var answers = false

func read_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: names.append(statement.name)
        HighIntermediaryRepresentation.Statements.Assign.Assign: assigned.append(statement.name)
        HighIntermediaryRepresentation.Statements.If: read_branches(statement)
        HighIntermediaryRepresentation.Statements.While: read_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: read_block(statement)
        HighIntermediaryRepresentation.Statements.Return: answers = true
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func read_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    read_block(branch.then_branch)
    read_block(branch.else_branch)
}

func assigned_times(name: String): Integer {
    var times = 0
    var index = 0
    while index < assigned.count() {
        var assigned_name = assigned[index]
        if assigned_name == name {
            times = times + 1
        }
        index = index + 1
    }
    return times
}

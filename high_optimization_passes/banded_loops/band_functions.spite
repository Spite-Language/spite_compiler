# ../../OPTIMIZATIONS.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var values = HighIntermediaryRepresentation.Building.Values(context)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file, false)
var integer = Model.Type('scalar', "Integer")
var boolean = Model.Type('scalar', "Boolean")
var _chunks_per_band = 8

func BandFunctions(
    starting_program: HighIntermediaryRepresentation.HighProgram,
    starting_values: HighIntermediaryRepresentation.Building.Values,
) {
    program = starting_program
    crash starting_program.context
    context = starting_program.context
    values = starting_values
    integer = context.scalar_type("Integer")
    boolean = context.scalar_type("Boolean")
}

func bands_of(list_owner: Model.ClassModel, range: Model.FunctionModel): Model.FunctionModel {
    owner = list_owner
    var name = "{range.name}$bands"
    var known = owner.function_named(name)
    if known {
        return known
    }
    var split = made_split(range)
    var held = made_held_once()
    return made_bands(name, split, held)
}

func made_bands(name: String, split: Model.FunctionModel, held: Model.FunctionModel): Model.FunctionModel {
    var made = function_named(name, null)
    parameter(made, "least")
    parameter(made, "times")
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var counted = count_call()
    declare(body, "length", counted)
    var processors = intrinsic("_processor_count", integer)
    var no_values = List<SpiteCompiler.Value>()
    var own = this_value()
    var processor_count = HighIntermediaryRepresentation.Values.Call(processors, own, no_values, "", "")
    declare(body, "bands", processor_count)
    var most_bands = number(64)
    lower_to(body, "bands", most_bands)
    var length = read("length")
    lower_to(body, "bands", length)
    var counted_length = read("length")
    var least = read("least")
    var too_few = operation('less', counted_length, least, boolean)
    one_band_when(body, too_few)
    var band_count = read("bands")
    var two = number(2)
    var several = operation('greater_or_equal', band_count, two, boolean)
    var checked = HighIntermediaryRepresentation.Statements.Block(0)
    var asked = this_value()
    var held_once = HighIntermediaryRepresentation.Values.Call(held, asked, no_values, "", "")
    var shared = HighIntermediaryRepresentation.Values.Negation(held_once)
    one_band_when(checked, shared)
    var checking = HighIntermediaryRepresentation.Statements.If(several, checked, null, 0, "")
    body.statements.append(checking)
    var claim_length = read("length")
    chunk_size(body, claim_length)
    var room = intrinsic("_claim_room", integer)
    var no_room_values = List<SpiteCompiler.Value>()
    var room_owner = this_value()
    var claimed_room = HighIntermediaryRepresentation.Values.Call(room, room_owner, no_room_values, "", "")
    declare(body, "claims", claimed_room)
    var from = number(0)
    var to = read("length")
    var bands = read("bands")
    var whole_split = split_call(split, from, to, bands)
    var splitting_all = HighIntermediaryRepresentation.Statements.Evaluate(whole_split, 0)
    body.statements.append(splitting_all)
    add(made, body)
    return made
}

func made_split(range: Model.FunctionModel): Model.FunctionModel {
    var made = function_named("{range.name}$split", integer)
    parameter(made, "start")
    parameter(made, "end")
    parameter(made, "bands")
    parameter(made, "times")
    parameter(made, "claims")
    parameter(made, "per")
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var alone = HighIntermediaryRepresentation.Statements.Block(0)
    var in_order = HighIntermediaryRepresentation.Statements.Block(0)
    var whole_start = read("start")
    var whole_end = read("end")
    run_in_order(in_order, range, whole_start, whole_end, "round")
    var walked_end = read("end")
    var walked_start = read("start")
    var walked = operation('subtract', walked_end, walked_start, integer)
    var answered = HighIntermediaryRepresentation.Statements.Return(walked, 0)
    in_order.statements.append(answered)
    var asked_per = read("per")
    var one_per = number(1)
    var unclaimed = operation('less', asked_per, one_per, boolean)
    var ordering = HighIntermediaryRepresentation.Statements.If(unclaimed, in_order, null, 0, "")
    alone.statements.append(ordering)
    claim_the_chunks(alone, range)
    var claimed_end = read("end")
    var claimed_start_read = read("start")
    var claimed_span = operation('subtract', claimed_end, claimed_start_read, integer)
    var claimed_answer = HighIntermediaryRepresentation.Statements.Return(claimed_span, 0)
    alone.statements.append(claimed_answer)
    var asked_bands = read("bands")
    var two = number(2)
    var one = operation('less', asked_bands, two, boolean)
    var leaving = HighIntermediaryRepresentation.Statements.If(one, alone, null, 0, "")
    body.statements.append(leaving)
    var halved_bands = read("bands")
    var halving = number(2)
    var half = operation('divide', halved_bands, halving, integer)
    declare(body, "half", half)
    var all_bands = read("bands")
    var given_half = read("half")
    var upper_bands = operation('subtract', all_bands, given_half, integer)
    var upper_start = read("start")
    var upper_end = read("end")
    var upper = split_call(made, upper_start, upper_end, upper_bands)
    var handle_type = context.resolver.monomorphiser.handle_of("Parallel", integer)
    values.need_the_scheduler(handle_type)
    var started = HighIntermediaryRepresentation.Values.Conversion(handle_type, 'into_handle', upper, "")
    declare(body, "running", started)
    var lower_start = read("start")
    var lower_end = read("end")
    var lower_bands = read("half")
    var lower = split_call(made, lower_start, lower_end, lower_bands)
    declare(body, "first", lower)
    var running = HighIntermediaryRepresentation.Values.LocalRead(handle_type, "running")
    var joined = HighIntermediaryRepresentation.Values.Conversion(integer, 'join', running, "")
    declare(body, "second", joined)
    var first = read("first")
    var second = read("second")
    var both = operation('add', first, second, integer)
    var total = HighIntermediaryRepresentation.Statements.Return(both, 0)
    body.statements.append(total)
    add(made, body)
    return made
}

func split_call(
    split: Model.FunctionModel,
    start: SpiteCompiler.Value,
    end: SpiteCompiler.Value,
    bands: SpiteCompiler.Value,
): HighIntermediaryRepresentation.Values.Call {
    var times = read("times")
    var claims = read("claims")
    var per = read("per")
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(start)
    arguments.append(end)
    arguments.append(bands)
    arguments.append(times)
    arguments.append(claims)
    arguments.append(per)
    var own = this_value()
    return HighIntermediaryRepresentation.Values.Call(split, own, arguments, "", "")
}

# ../../OPTIMIZATIONS.md#a-band-that-finishes-early-takes-the-next-chunk
func chunk_size(block: HighIntermediaryRepresentation.Statements.Block, span: SpiteCompiler.Value) {
    var unsized = number(0)
    declare(block, "per", unsized)
    var sizing = HighIntermediaryRepresentation.Statements.Block(0)
    var chunked_bands = read("bands")
    var per_band = number(_chunks_per_band)
    var chunks = operation('multiply', chunked_bands, per_band, integer)
    var size = operation('divide', span, chunks, integer)
    var sized = HighIntermediaryRepresentation.Statements.Assign.Assign("per", size, 0)
    sizing.statements.append(sized)
    var one = number(1)
    raise_to(sizing, "per", one)
    var several_bands = read("bands")
    var two = number(2)
    var several = operation('greater_or_equal', several_bands, two, boolean)
    var choosing = HighIntermediaryRepresentation.Statements.If(several, sizing, null, 0, "")
    block.statements.append(choosing)
}

func raise_to(block: HighIntermediaryRepresentation.Statements.Block, name: String, least: SpiteCompiler.Value) {
    var current = read(name)
    var below = operation('less', current, least, boolean)
    var raising = HighIntermediaryRepresentation.Statements.Block(0)
    var raised = HighIntermediaryRepresentation.Statements.Assign.Assign(name, least, 0)
    raising.statements.append(raised)
    var floored = HighIntermediaryRepresentation.Statements.If(below, raising, null, 0, "")
    block.statements.append(floored)
}

# ../../OPTIMIZATIONS.md#a-band-that-finishes-early-takes-the-next-chunk
func claim_the_chunks(block: HighIntermediaryRepresentation.Statements.Block, range: Model.FunctionModel) {
    var first = claimed_start()
    declare(block, "chunk", first)
    var taking = HighIntermediaryRepresentation.Statements.Block(0)
    var chunk_start = read("chunk")
    var chunk_length = read("per")
    var chunk_end = operation('add', chunk_start, chunk_length, integer)
    declare(taking, "chunk_end", chunk_end)
    var whole_end = read("end")
    lower_to(taking, "chunk_end", whole_end)
    var from = read("chunk")
    var to = read("chunk_end")
    run_in_order(taking, range, from, to, "chunk_round")
    var next = claimed_start()
    var stepped = HighIntermediaryRepresentation.Statements.Assign.Assign("chunk", next, 0)
    taking.statements.append(stepped)
    var reached = read("chunk")
    var end = read("end")
    var more = operation('less', reached, end, boolean)
    var loop = HighIntermediaryRepresentation.Statements.While(more, taking, 0)
    block.statements.append(loop)
}

func claimed_start(): SpiteCompiler.Value {
    var claiming = intrinsic("_claim_next", integer)
    var asked = List<SpiteCompiler.Value>()
    var claims = read("claims")
    asked.append(claims)
    var own = this_value()
    var claimed = HighIntermediaryRepresentation.Values.Call(claiming, own, asked, "", "")
    var one = number(1)
    var taken = operation('subtract', claimed, one, integer)
    var per = read("per")
    var offset = operation('multiply', taken, per, integer)
    var start = read("start")
    return operation('add', start, offset, integer)
}

func run_in_order(
    block: HighIntermediaryRepresentation.Statements.Block,
    range: Model.FunctionModel,
    start: SpiteCompiler.Value,
    end: SpiteCompiler.Value,
    round_name: String,
) {
    var no_rounds = number(0)
    declare(block, round_name, no_rounds)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(start)
    arguments.append(end)
    var own = this_value()
    var ran = HighIntermediaryRepresentation.Values.Call(range, own, arguments, "", "")
    var running = HighIntermediaryRepresentation.Statements.Evaluate(ran, 0)
    var repeating = HighIntermediaryRepresentation.Statements.Block(0)
    repeating.statements.append(running)
    step(repeating, round_name)
    var round = read(round_name)
    var times = read("times")
    var more = operation('less', round, times, boolean)
    var loop = HighIntermediaryRepresentation.Statements.While(more, repeating, 0)
    block.statements.append(loop)
}

func made_held_once(): Model.FunctionModel {
    var name = "_items_held_once$bands"
    var known = owner.function_named(name)
    if known {
        return known
    }
    var made = function_named(name, boolean)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var first = number(0)
    declare(body, "index", first)
    var counted = count_call()
    declare(body, "length", counted)
    var asking = intrinsic("_item_held_once", boolean)
    var asked = List<SpiteCompiler.Value>()
    var index = read("index")
    asked.append(index)
    var own = this_value()
    var held = HighIntermediaryRepresentation.Values.Call(asking, own, asked, "", "")
    var shared = HighIntermediaryRepresentation.Values.Negation(held)
    var refusing = HighIntermediaryRepresentation.Statements.Block(0)
    var no = boolean_value(false)
    var refused = HighIntermediaryRepresentation.Statements.Return(no, 0)
    refusing.statements.append(refused)
    var checking = HighIntermediaryRepresentation.Statements.If(shared, refusing, null, 0, "")
    var passing = HighIntermediaryRepresentation.Statements.Block(0)
    passing.statements.append(checking)
    step(passing, "index")
    var reached = read("index")
    var length = read("length")
    var more = operation('less', reached, length, boolean)
    var loop = HighIntermediaryRepresentation.Statements.While(more, passing, 0)
    body.statements.append(loop)
    var yes = boolean_value(true)
    var all_held = HighIntermediaryRepresentation.Statements.Return(yes, 0)
    body.statements.append(all_held)
    add(made, body)
    return made
}

func count_call(): HighIntermediaryRepresentation.Values.Call {
    var counting = owner.function_named("count")
    crash counting
    context.need(counting)
    var no_values = List<SpiteCompiler.Value>()
    var own = this_value()
    return HighIntermediaryRepresentation.Values.Call(counting, own, no_values, "", "")
}

func intrinsic(name: String, answer: Model.Type): Model.FunctionModel {
    var known = owner.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, owner.key, answer, null, null, null, null, null, false, false, false, false)
    owner.declared_functions.append(made)
    return made
}

func function_named(name: String, answer: Model.Type?): Model.FunctionModel {
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        owner.key,
        answer,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    owner.declared_functions.append(made)
    return made
}

func parameter(function: Model.FunctionModel, name: String) {
    var made = Model.ParameterModel(name, integer, false)
    function.parameters.append(made)
}

func add(made: Model.FunctionModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    program.built_functions.append(function)
}

func declare(block: HighIntermediaryRepresentation.Statements.Block, name: String, value: SpiteCompiler.Value) {
    var made = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value, 0, "")
    block.statements.append(made)
}

func lower_to(block: HighIntermediaryRepresentation.Statements.Block, name: String, most: SpiteCompiler.Value) {
    var current = read(name)
    var above = operation('greater', current, most, boolean)
    var lowering = HighIntermediaryRepresentation.Statements.Block(0)
    var lowered = HighIntermediaryRepresentation.Statements.Assign.Assign(name, most, 0)
    lowering.statements.append(lowered)
    var capped = HighIntermediaryRepresentation.Statements.If(above, lowering, null, 0, "")
    block.statements.append(capped)
}

func one_band_when(block: HighIntermediaryRepresentation.Statements.Block, condition: SpiteCompiler.Value) {
    var alone = HighIntermediaryRepresentation.Statements.Block(0)
    var single = number(1)
    var one = HighIntermediaryRepresentation.Statements.Assign.Assign("bands", single, 0)
    alone.statements.append(one)
    var choosing = HighIntermediaryRepresentation.Statements.If(condition, alone, null, 0, "")
    block.statements.append(choosing)
}

func step(block: HighIntermediaryRepresentation.Statements.Block, name: String) {
    var current = read(name)
    var single = number(1)
    var next = operation('add', current, single, integer)
    var stepped = HighIntermediaryRepresentation.Statements.Assign.Assign(name, next, 0)
    block.statements.append(stepped)
}

func operation(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: SpiteCompiler.Value,
    right: SpiteCompiler.Value,
    answer: Model.Type,
): HighIntermediaryRepresentation.Values.MachineOperation {
    return HighIntermediaryRepresentation.Values.MachineOperation(answer, operator, left, right, null)
}

func read(name: String): HighIntermediaryRepresentation.Values.LocalRead {
    return HighIntermediaryRepresentation.Values.LocalRead(integer, name)
}

func number(written: Integer): HighIntermediaryRepresentation.Values.WholeNumber {
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, written, false)
}

func boolean_value(written: Boolean): HighIntermediaryRepresentation.Values.WholeNumber {
    var number_of_it = 0
    if written {
        number_of_it = 1
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number_of_it, false)
}

func this_value(): HighIntermediaryRepresentation.Values.ThisRead {
    var own_type = owner.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.ThisRead(own_type)
}

# ../../OPTIMIZATIONS.md#a-loop-over-a-lists-positions-whose-passes-write-only-what-they-alone-reach-runs-in-bands

var names = List<String>()
var types = List<Model.Type>()

func read_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_value(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_value(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: read_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.If: read_a_branch(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_loop(statement)
        HighIntermediaryRepresentation.Statements.Return: read_value(statement.value)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_block(statement)
    }
}

func read_a_branch(branch: HighIntermediaryRepresentation.Statements.If) {
    read_both(branch.condition, branch.decided_condition)
    read_block(branch.then_branch)
    read_block(branch.else_branch)
}

func read_a_loop(loop: HighIntermediaryRepresentation.Statements.While) {
    read_value(loop.condition)
    read_block(loop.body)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(read_present)
    read_value(stop.then)
}

func read_present(value: SpiteCompiler.Value) {
    read_value(value)
}

func read_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    read_value(first)
    read_value(second)
}

func read_value(value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: note(value.name, value.value_type)
        HighIntermediaryRepresentation.Values.AttributeRead: read_value(value.object)
        HighIntermediaryRepresentation.Values.Call: read_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(read_present)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: read_value(value.negated)
        HighIntermediaryRepresentation.Values.ForeignCall: read_a_call(value.library, value.arguments)
        HighIntermediaryRepresentation.Values.Class.Membership: read_value(value.tested)
        HighIntermediaryRepresentation.Values.PresenceTest: read_value(value.tested)
        HighIntermediaryRepresentation.Values.Conversion: read_value(value.converted)
        HighIntermediaryRepresentation.Values.Function.Value: read_value(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: read_a_call(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.ShapeCall: read_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.EnumText: read_value(value.number)
        HighIntermediaryRepresentation.Values.EnumFromText: read_value(value.text)
        HighIntermediaryRepresentation.Values.Class.OfValue: read_value(value.described)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func read_a_call(receiver: SpiteCompiler.Value?, arguments: List<SpiteCompiler.Value>) {
    read_value(receiver)
    arguments.each(read_present)
}

func note(name: String, read_type: Model.Type) {
    fallback not names.contains(name)
    names.append(name)
    types.append(read_type)
}

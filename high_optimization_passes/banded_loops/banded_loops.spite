union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands
# ../../OPTIMIZATIONS.md#a-counted-loop-of-one-banded-pass-runs-its-count-inside-each-band
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var values = HighIntermediaryRepresentation.Building.Values(context)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(no_high)
var library = Validators.LibraryFile()
var program = HighIntermediaryRepresentation.HighProgram(no_program)

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    program = high
    context = high.context
    values = HighIntermediaryRepresentation.Building.Values(context)
    building = HighOptimizationPasses.FunctionBuilding(high)
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var built = high.built_functions.copy()
    var index = 0
    while index < built.count() {
        var function = built[index]
        if enters(function) {
            repeat_in_block(function.body)
            rewriting.rewrite_block(function.body)
        }
        index = index + 1
    }
    building.build_the_needed()
}

func enters(function: HighIntermediaryRepresentation.HighFunction): Boolean {
    var owner = context.program.class_named(function.function.owner)
    fallback owner
    context.current_class = owner
    context.current_function = function.function
    var path = context.path()
    return not library.holds(path)
}

func rewritten(value: Value): Value {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        band(value)
    }
    return value
}

func band(call: HighIntermediaryRepresentation.Values.Call) {
    fallback call.arguments.is_empty()
    var least = least_count_of(call)
    fallback least > 0
    var bands = bands_of(call)
    fallback bands
    var integer = context.scalar_type("Integer")
    var once = HighIntermediaryRepresentation.Values.WholeNumber(integer, 1)
    banded(call, bands, least, once)
}

func banded(
    call: HighIntermediaryRepresentation.Values.Call,
    bands: Model.FunctionModel,
    least: Integer,
    times: Value,
) {
    building.replaced(call.function)
    var integer = context.scalar_type("Integer")
    var least_number = HighIntermediaryRepresentation.Values.WholeNumber(integer, least)
    var arguments = List<Value>()
    arguments.append(least_number)
    arguments.append(times)
    call.function = bands
    call.arguments = arguments
}

func least_count_of(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var name = call.function.name
    if not name.starts_with("each_") or call.function.bound_member.is_empty() {
        return -1
    }
    var owner = context.program.class_named(call.function.owner)
    if not owner {
        return -1
    }
    var weights = HighOptimizationPasses.BandedLoops.PassWeights()
    return weights.least_count_for(context, owner, name)
}

func bands_of(call: HighIntermediaryRepresentation.Values.Call): Model.FunctionModel? {
    var owner = context.program.class_named(call.function.owner)
    fallback owner
    var name = call.function.name
    var name_length = name.length()
    var member_name = name.slice(5, name_length)
    crash member_name
    var range = values.member_template_of(owner, "_each_range_{member_name}")
    fallback range
    building.need(range)
    var functions = HighOptimizationPasses.BandedLoops.BandFunctions(program, values)
    return functions.bands_of(owner, range)
}

func repeat_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var repeated = repeated_loop(statement)
        if repeated {
            block.statements[index] = repeated
        } else {
            repeat_inside(statement)
        }
        index = index + 1
    }
}

func repeat_inside(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: repeat_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: repeat_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: repeat_in_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func repeat_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    repeat_in_block(branch.then_branch)
    repeat_in_block(branch.else_branch)
}

func repeated_loop(
    statement: Statement,
): Statement? {
    if statement.class == HighIntermediaryRepresentation.Statements.While {
        return repeated_while(statement)
    }
    return null
}

func repeated_while(
    loop: HighIntermediaryRepresentation.Statements.While,
): Statement? {
    var condition = loop.condition
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return repeated_under(loop, condition)
    }
    return null
}

func repeated_under(
    loop: HighIntermediaryRepresentation.Statements.While,
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
): Statement? {
    fallback condition.operator == 'less' and loop.body.statements.count() == 2
    var bound = condition.right
    if bound.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return repeated_to(loop, condition, bound)
    }
    return null
}

func repeated_to(
    loop: HighIntermediaryRepresentation.Statements.While,
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    bound: HighIntermediaryRepresentation.Values.WholeNumber,
): Statement? {
    var counter = counter_of(condition.left)
    fallback not counter.is_empty()
    var passing = loop.body.statements[0]
    var stepping = loop.body.statements[1]
    crash passing and stepping
    fallback steps_by_one(stepping, counter)
    var call = called_alone(passing, counter)
    fallback call
    fallback least_count_of(call) > 0
    var bands = bands_of(call)
    fallback bands
    return repeated_through(loop, condition, call, bands, bound)
}

func repeated_through(
    loop: HighIntermediaryRepresentation.Statements.While,
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    call: HighIntermediaryRepresentation.Values.Call,
    bands: Model.FunctionModel,
    bound: HighIntermediaryRepresentation.Values.WholeNumber,
): Statement {
    var least = least_count_of(call)
    var integer = context.scalar_type("Integer")
    var bound_number = HighIntermediaryRepresentation.Values.WholeNumber(integer, bound.number)
    crash condition.left
    var counted = counter_copy(condition.left)
    var times = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'subtract', bound_number, counted)
    times.shown = "{condition.shown_right} - {condition.shown_left}"
    times.shown_left = condition.shown_right
    times.shown_right = condition.shown_left
    banded(call, bands, least, times)
    var running = HighIntermediaryRepresentation.Statements.Evaluate(call)
    running.line = loop.line
    var finishing = loop.body.statements[1]
    crash finishing
    finish_at(finishing, bound.number)
    var then_block = HighIntermediaryRepresentation.Statements.Block()
    then_block.line = loop.line
    then_block.statements.append(running)
    then_block.statements.append(finishing)
    var once = HighIntermediaryRepresentation.Statements.If(condition, then_block, null)
    once.line = loop.line
    return once
}

func counter_of(value: Value?): String {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead and counts_whole_numbers(value.value_type) {
        return "local {value.name}"
    }
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead and counts_whole_numbers(value.value_type) {
        return own_attribute_of(value)
    }
    return ""
}

func own_attribute_of(read: HighIntermediaryRepresentation.Values.AttributeRead): String {
    var object = read.object
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        return "attribute {read.attribute.owner}.{read.attribute.name}"
    }
    return ""
}

func counter_copy(read: Value): Value {
    switch read {
        HighIntermediaryRepresentation.Values.LocalRead: return local_copy(read)
        HighIntermediaryRepresentation.Values.AttributeRead: return attribute_copy(read)
        HighIntermediaryRepresentation.Values.WholeNumber: return read
        HighIntermediaryRepresentation.Values.DecimalNumber: return read
        HighIntermediaryRepresentation.Values.TextConstant: return read
        HighIntermediaryRepresentation.Values.NullConstant: return read
        HighIntermediaryRepresentation.Values.ThisRead: return read
        HighIntermediaryRepresentation.Values.Call: return read
        HighIntermediaryRepresentation.Values.MakeObject: return read
        HighIntermediaryRepresentation.Values.MachineOperation: return read
        HighIntermediaryRepresentation.Values.Negation: return read
        HighIntermediaryRepresentation.Values.ForeignCall: return read
        HighIntermediaryRepresentation.Values.Class.Membership: return read
        HighIntermediaryRepresentation.Values.PresenceTest: return read
        HighIntermediaryRepresentation.Values.Conversion: return read
        HighIntermediaryRepresentation.Values.Function.Value: return read
        HighIntermediaryRepresentation.Values.Function.ValueCall: return read
        HighIntermediaryRepresentation.Values.NumberRoom: return read
        HighIntermediaryRepresentation.Values.ShapeCall: return read
        HighIntermediaryRepresentation.Values.EnumText: return read
        HighIntermediaryRepresentation.Values.EnumFromText: return read
        HighIntermediaryRepresentation.Values.Class.Object: return read
        HighIntermediaryRepresentation.Values.Class.OfValue: return read
        HighIntermediaryRepresentation.Values.Function.Fact: return read
    }
}

func local_copy(read: HighIntermediaryRepresentation.Values.LocalRead): Value {
    return HighIntermediaryRepresentation.Values.LocalRead(read.value_type, read.name)
}

func attribute_copy(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
): Value {
    var own = this_copy(read)
    return HighIntermediaryRepresentation.Values.AttributeRead(own, read.attribute)
}

func this_copy(read: HighIntermediaryRepresentation.Values.AttributeRead): Value {
    crash read.object
    return HighIntermediaryRepresentation.Values.ThisRead(read.object.value_type)
}

func finish_at(stepping: Statement, number: Long) {
    switch stepping {
        HighIntermediaryRepresentation.Statements.Assign.Assign: finish_a_local(stepping, number)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: finish_an_attribute(stepping, number)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.If: return
        HighIntermediaryRepresentation.Statements.While: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
        HighIntermediaryRepresentation.Statements.Block: return
    }
}

func finish_a_local(stepping: HighIntermediaryRepresentation.Statements.Assign.Assign, number: Long) {
    var integer = context.scalar_type("Integer")
    stepping.value = HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func finish_an_attribute(stepping: HighIntermediaryRepresentation.Statements.Assign.Attribute, number: Long) {
    var integer = context.scalar_type("Integer")
    stepping.value = HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func counts_whole_numbers(counter_type: Model.Type): Boolean {
    return counter_type.kind == 'scalar' and counter_type.name == "Integer" and not counter_type.is_nullable
}

func steps_by_one(statement: Statement, counter: String): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Assign: return steps_a_local(statement, counter)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return steps_an_attribute(statement, counter)
        HighIntermediaryRepresentation.Statements.Declare: return false
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return false
        HighIntermediaryRepresentation.Statements.Evaluate: return false
        HighIntermediaryRepresentation.Statements.If: return false
        HighIntermediaryRepresentation.Statements.While: return false
        HighIntermediaryRepresentation.Statements.Return: return false
        HighIntermediaryRepresentation.Statements.Stop: return false
        HighIntermediaryRepresentation.Statements.Block: return false
    }
}

func steps_a_local(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign, counter: String): Boolean {
    var written = "local {assigned.name}"
    return written == counter and adds_one_to(assigned.value, counter)
}

func steps_an_attribute(
    assigned: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    counter: String,
): Boolean {
    var object = assigned.object
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        var written = "attribute {assigned.attribute.owner}.{assigned.attribute.name}"
        return written == counter and adds_one_to(assigned.value, counter)
    }
    return false
}

func adds_one_to(value: Value?, counter: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation and value.operator == 'add' {
        var added_to = counter_of(value.left)
        return added_to == counter and is_one(value.right)
    }
    return false
}

func is_one(step: Value?): Boolean {
    if step.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return step.number == 1
    }
    return false
}

func called_alone(
    statement: Statement,
    counter: String,
): HighIntermediaryRepresentation.Values.Call? {
    if statement.class == HighIntermediaryRepresentation.Statements.Evaluate and not statement.waited {
        return plain_call(statement.value, counter)
    }
    return null
}

func plain_call(
    value: Value?,
    counter: String,
): HighIntermediaryRepresentation.Values.Call? {
    if value.class == HighIntermediaryRepresentation.Values.Call and value.arguments.is_empty() {
        var named = names_the_list(value.receiver, counter)
        if named {
            return value
        }
    }
    return null
}

func names_the_list(receiver: Value?, counter: String): Boolean {
    var named = counter_of(receiver)
    fallback named != counter
    if receiver.class == HighIntermediaryRepresentation.Values.LocalRead {
        return true
    }
    if receiver.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var object = receiver.object
        return object.class == HighIntermediaryRepresentation.Values.ThisRead
    }
    return false
}

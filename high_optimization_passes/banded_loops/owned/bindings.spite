# ../../../PROOFS.md#passes-that-write-only-what-they-alone-reach

var names = List<String>()
var bound_functions = List<Model.FunctionModel>()
var origins = List<Integer>()

func bind(name: String, function: Model.FunctionModel, origin: Integer) {
    names.append(name)
    bound_functions.append(function)
    origins.append(origin)
}

func function_of(name: String): Model.FunctionModel? {
    var place = names.index_of(name)
    fallback place
    return bound_functions[place]
}

func origin_of(name: String): Integer {
    var place = names.index_of(name)
    fallback place
    var origin = origins[place]
    crash origin
    return origin
}

func shown(): String {
    var written = ""
    var index = 0
    while index < names.count() {
        var name = names[index]
        var function = bound_functions[index]
        var origin = origins[index]
        crash function
        crash origin
        var key = function.key()
        written = "{written}{name}={key}@{origin};"
        index = index + 1
    }
    return written
}

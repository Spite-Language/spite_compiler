# ../../../PROOFS.md#passes-that-write-only-what-they-alone-reach

var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var stored = Dictionary<String, Integer>()
var walked_classes = List<String>()
var fresh_classes = List<String>()
var held_types = List<Model.Type>()
var held_keys = List<String>()
var walked_edges = List<String>()
var answers = Dictionary<String, Integer>()
var studying = List<String>()
var element_class = ""
var gave_up = false
var refusal = ""
var fallback_taken_in = ""
var studying_names = List<String>()
var studying_the_programs = List<String>()
var library = Mapping.LibraryFile()
var stored_changed = false
var studied = 0
var fresh = 1
var item = 2
var shared = 4
var owned = 8
var most_studied = 4000
var most_rounds = 16
var most_local_rounds = 8
var built_by_key: Dictionary<String, HighIntermediaryRepresentation.HighFunction>

func Writes(
    starting_high: HighIntermediaryRepresentation.HighProgram,
    starting_built: Dictionary<String, HighIntermediaryRepresentation.HighFunction>,
) {
    high = starting_high
    built_by_key = starting_built
}

func proves(element_key: String, pass: Model.FunctionModel): Boolean {
    element_class = element_key
    var round = 0
    stored_changed = true
    while stored_changed and not gave_up and round < most_rounds {
        stored_changed = false
        answers = Dictionary<String, Integer>()
        studied = 0
        var no_arguments = List<Integer>()
        var no_bindings = HighOptimizationPasses.BandedLoops.Owned.Bindings()
        var answered = study(pass, item, no_arguments, no_bindings)
        fallback is_known(answered)
        round = round + 1
        fallback fallback_taken_in.is_empty()
    }
    if stored_changed {
        give_up("what its passes store did not settle in {most_rounds} rounds")
    }
    return not gave_up and fallback_taken_in.is_empty()
}

func proves_a_loop(
    item_key: String,
    body: HighIntermediaryRepresentation.Statements.Block,
    item_name: String,
    index_name: String,
    slot: SpiteCompiler.Value,
): Boolean {
    element_class = item_key
    var declared = HighOptimizationPasses.BandedLoops.DeclaredNames()
    declared.read_block(body)
    var round = 0
    stored_changed = true
    while stored_changed and not gave_up and round < most_rounds {
        stored_changed = false
        answers = Dictionary<String, Integer>()
        walked_classes = List<String>()
        fresh_classes = List<String>()
        held_types = List<Model.Type>()
        held_keys = List<String>()
        walked_edges = List<String>()
        studied = 0
        var current = HighOptimizationPasses.BandedLoops.Owned.Study(shared)
        current.is_a_loop_body = true
        current.declared_names = declared.names
        current.index_name = index_name
        current.slot = slot
        current.locals[index_name] = 0
        current.locals[item_name] = owned
        var local_round = 0
        current.changed = true
        while current.changed and not gave_up and local_round < most_local_rounds {
            current.changed = false
            read_block(current, body)
            local_round = local_round + 1
        }
        if current.changed {
            give_up("the origins of its names did not settle in {most_local_rounds} rounds")
        }
        round = round + 1
        fallback fallback_taken_in.is_empty()
    }
    if stored_changed {
        give_up("what its passes store did not settle in {most_rounds} rounds")
    }
    return not gave_up and fallback_taken_in.is_empty()
}

func give_up(reason: String) {
    if not gave_up {
        var place = studied_place()
        refusal = "{reason}{place}"
    }
    gave_up = true
}

func studied_place(): String {
    var last = studying_names.last()
    fallback last
    var programs = studying_the_programs.last()
    if programs and programs != last {
        return " (in `{last}`, reached from `{programs}`)"
    }
    return " (in `{last}`)"
}

func shown_name(function: Model.FunctionModel): String {
    var parts = function.owner.split(".")
    var owner = parts.last()
    crash owner
    return "{owner}.{function.name}"
}

func is_the_programs_own(function: Model.FunctionModel): Boolean {
    var owner = high.model.class_named(function.owner)
    fallback owner
    return not library.holds(owner.file.path)
}

func take_a_fallback() {
    fallback fallback_taken_in.is_empty()
    fallback_taken_in = "the loop's body"
    var last = studying_names.last()
    fallback last
    fallback_taken_in = "`{last}`"
}

func why_refused(): String {
    if gave_up {
        return refusal
    }
    fallback not fallback_taken_in.is_empty()
    return "{fallback_taken_in} takes a `fallback`, which writes the fallback ring under its lock"
}

func has(origin: Integer, bit: Integer): Boolean {
    return origin / bit % 2 == 1
}

func joined(first: Integer, second: Integer): Integer {
    var total = 0
    var bit = fresh
    while bit <= owned {
        if has(first, bit) or has(second, bit) {
            total = total + bit
        }
        bit = bit * 2
    }
    return total
}

func is_plain(of_type: Model.Type?): Boolean {
    fallback of_type
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'nothing'
}

func may_hold_an_element(of_type: Model.Type): Boolean {
    if of_type.kind == 'object' {
        return of_type.name == element_class
    }
    if of_type.kind == 'union' or of_type.kind == 'shape' or of_type.kind == 'function' {
        return true
    }
    return of_type.members.any(may_hold_an_element)
}

func checked(origin: Integer, of_type: Model.Type?): Integer {
    fallback not is_plain(of_type)
    crash of_type
    if has(origin, shared) and may_hold_an_element(of_type) {
        give_up("it reads a `{of_type.name}` it does not own, which could be another pass's element")
    }
    note_the_type(origin, of_type)
    return origin
}

# ../../../PROOFS.md#no-other-thread-counts-a-class
func note_the_type(origin: Integer, of_type: Model.Type) {
    if origin == fresh {
        if of_type.kind == 'object' {
            add_once(fresh_classes, of_type.name)
        }
        return
    }
    fallback origin != 0
    hold(of_type)
}

func hold(of_type: Model.Type) {
    var key = "{of_type.kind}:{of_type.name}"
    fallback not held_keys.contains(key)
    held_keys.append(key)
    held_types.append(of_type)
}

func context_key(
    function: Model.FunctionModel,
    this_origin: Integer,
    argument_origins: List<Integer>,
    bindings: HighOptimizationPasses.BandedLoops.Owned.Bindings,
): String {
    var key = function.key()
    var shown = "{key}|{this_origin}"
    var index = 0
    while index < argument_origins.count() {
        var origin = argument_origins[index]
        shown = "{shown},{origin}"
        index = index + 1
    }
    var bound = bindings.shown()
    return "{shown}|{bound}"
}

func study(
    function: Model.FunctionModel,
    this_origin: Integer,
    argument_origins: List<Integer>,
    bindings: HighOptimizationPasses.BandedLoops.Owned.Bindings,
): Integer {
    var key = context_key(function, this_origin, argument_origins, bindings)
    if answers.contains(key) {
        var known = answers[key]
        crash known
        return known
    }
    if studying.contains(key) {
        return shared
    }
    if gave_up or studied >= most_studied {
        give_up("it reaches more than {most_studied} functions")
        return shared
    }
    var function_key = function.key()
    var built = built_by_key[function_key]
    if not built {
        var missing = shown_name(function)
        give_up("it calls `{missing}`, which has no built body")
        return shared
    }
    studied = studied + 1
    var current = HighOptimizationPasses.BandedLoops.Owned.Study(this_origin)
    current.bindings = bindings
    var index = 0
    while index < function.parameters.count() and index < argument_origins.count() {
        var parameter = function.parameters[index]
        var origin = argument_origins[index]
        current.locals[parameter.name] = origin
        index = index + 1
    }
    studying.append(key)
    var studied_name = shown_name(function)
    studying_names.append(studied_name)
    var is_the_programs = is_the_programs_own(function)
    if is_the_programs {
        studying_the_programs.append(studied_name)
    }
    var round = 0
    current.changed = true
    while current.changed and not gave_up and round < most_local_rounds {
        current.changed = false
        read_block(current, built.body)
        round = round + 1
    }
    if current.changed {
        give_up("the origins of its names did not settle in {most_local_rounds} rounds")
    }
    crash studying_names.remove_last()
    if is_the_programs {
        crash studying_the_programs.remove_last()
    }
    crash studying.remove_last()
    answers[key] = current.answer
    return current.answer
}

func supplied(
    function: Model.FunctionModel,
    receiver: SpiteCompiler.Value?,
    this_origin: Integer,
    argument_origins: List<Integer>,
): Integer {
    var name = function.name
    var items_key = "{function.owner}.$items"
    if name == "_read_value" {
        var held = 0
        if has(this_origin, fresh) {
            held = stored_at(items_key)
        }
        if has(this_origin, owned) {
            var reached = stored_at(items_key)
            var owned_items = joined(reached, owned)
            held = joined(held, owned_items)
        }
        if has(this_origin, item) or has(this_origin, shared) {
            held = joined(held, shared)
        }
        return checked(held, function.answer)
    }
    var asks = name == "_item_size" or name == "_item_held_once" or name == "_is_held_once" or name == "_key_bits"
    var only_reads = name.starts_with("_read") or asks
    fallback not only_reads
    var writes = name.starts_with("_write") or name.starts_with("_forget") or name.starts_with("_reserve") or name.starts_with("_resize") or name == "_copy_bytes"
    if not writes {
        give_up("it calls `{name}`, which the compiler supplies and the proof does not know")
        return shared
    }
    write_through(this_origin, receiver, function.owner)
    if name == "_write_value" {
        var value_origin = argument_origins.last()
        crash value_origin
        store(items_key, value_origin)
    }
    return 0
}

func stored_at(key: String): Integer {
    fallback stored.contains(key)
    var known = stored[key]
    crash known
    return known
}

func store(key: String, origin: Integer) {
    var before = stored_at(key)
    var after = joined(before, origin)
    if after != before {
        stored[key] = after
        stored_changed = true
    }
}

func write_through(origin: Integer, target: SpiteCompiler.Value?, class_key: String) {
    if has(origin, owned) or has(origin, item) {
        var written_type = Model.Type('object', class_key)
        hold(written_type)
    }
    if has(origin, shared) {
        var shown_class = shown_class_of(class_key)
        give_up("it writes into a `{shown_class}` it does not own")
    }
    fallback has(origin, owned)
    var edge = edge_of(target)
    if edge.is_empty() {
        add_once(walked_classes, class_key)
        return
    }
    add_once(walked_edges, edge)
}

func shown_class_of(class_key: String): String {
    var model = high.model.class_named(class_key)
    if not model {
        return class_key
    }
    return model.shown
}

func edge_of(target: SpiteCompiler.Value?): String {
    fallback target
    if target.class == HighIntermediaryRepresentation.Values.Conversion {
        return edge_of(target.converted)
    }
    fallback target.class == HighIntermediaryRepresentation.Values.AttributeRead
    var attribute = target.attribute
    return "{attribute.owner}.{attribute.name}"
}

func add_once(names: List<String>, name: String) {
    if not names.contains(name) {
        names.append(name)
    }
}

func note_a_local(current: HighOptimizationPasses.BandedLoops.Owned.Study, name: String, origin: Integer) {
    var before = current.noted_origin_of(name)
    var after = joined(before, origin)
    var is_new = not current.locals.contains(name)
    if after != before or is_new {
        current.locals[name] = after
        current.changed = true
    }
}

func ends_the_program(block: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var last = block.statements.last()
    if last and last.class == HighIntermediaryRepresentation.Statements.Stop {
        return not last.then
    }
    return false
}

func read_block(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    block: HighIntermediaryRepresentation.Statements.Block?,
) {
    fallback block
    fallback not ends_the_program(block)
    var index = 0
    while index < block.statements.count() and not gave_up {
        var statement = block.statements[index]
        read_statement(current, statement)
        index = index + 1
    }
}

func read_statement(current: HighOptimizationPasses.BandedLoops.Owned.Study, statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_declaration(current, statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_a_local_write(current, statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_an_attribute_write(current, statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: give_up("it writes through a shape")
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(current, statement)
        HighIntermediaryRepresentation.Statements.If: read_a_branch(current, statement)
        HighIntermediaryRepresentation.Statements.While: read_a_loop(current, statement)
        HighIntermediaryRepresentation.Statements.Return: read_an_answer(current, statement)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(current, statement)
        HighIntermediaryRepresentation.Statements.Block: read_block(current, statement)
    }
}

func read_a_declaration(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    declared: HighIntermediaryRepresentation.Statements.Declare,
) {
    var origin = origin_of(current, declared.value)
    note_a_local(current, declared.name, origin)
}

func read_a_local_write(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    assigned: HighIntermediaryRepresentation.Statements.Assign.Assign,
) {
    var origin = origin_of(current, assigned.value)
    if current.is_a_loop_body and not current.declared_names.contains(assigned.name) {
        give_up("it assigns `{assigned.name}`, declared outside the loop")
    }
    note_a_local(current, assigned.name, origin)
}

func read_an_attribute_write(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
) {
    var object_origin = origin_of(current, written.object)
    var value_origin = origin_of(current, written.value)
    var attribute = written.attribute
    write_through(object_origin, written.object, attribute.owner)
    if has(object_origin, fresh) or has(object_origin, owned) {
        store("{attribute.owner}.{attribute.name}", value_origin)
    }
}

func read_an_evaluation(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    evaluated: HighIntermediaryRepresentation.Statements.Evaluate,
) {
    if evaluated.waited {
        give_up("it waits")
    }
    var value = evaluated.value
    if current.is_a_loop_body and value.class == HighIntermediaryRepresentation.Values.Call and is_the_slot_write(current, value) {
        var slot_value = value.arguments.last()
        fallback reads(current, slot_value)
        return
    }
    fallback reads(current, value)
}

func is_the_slot_write(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    call: HighIntermediaryRepresentation.Values.Call,
): Boolean {
    fallback call.function.name == "set_at" and call.arguments.count() == 2
    var places = HighOptimizationPasses.BandedLoops.Places()
    fallback places.is_the_same(call.receiver, current.slot)
    var position = call.arguments.first()
    fallback position and position.class == HighIntermediaryRepresentation.Values.LocalRead
    return position.name == current.index_name
}

func read_a_branch(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    branch: HighIntermediaryRepresentation.Statements.If,
) {
    fallback reads(current, branch.condition) and reads(current, branch.decided_condition)
    read_block(current, branch.then_branch)
    read_block(current, branch.else_branch)
}

func read_a_loop(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    loop: HighIntermediaryRepresentation.Statements.While,
) {
    fallback reads(current, loop.condition)
    read_block(current, loop.body)
}

func read_an_answer(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    returned: HighIntermediaryRepresentation.Statements.Return,
) {
    var origin = origin_of(current, returned.value)
    if current.is_a_loop_body {
        give_up("it returns from inside the loop")
    }
    current.answer = joined(current.answer, origin)
}

func read_a_stop(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    stop: HighIntermediaryRepresentation.Statements.Stop,
) {
    var index = 0
    while index < stop.shown.count() {
        var shown = stop.shown[index]
        fallback reads(current, shown)
        index = index + 1
    }
    fallback reads(current, stop.then)
}

func origin_of(current: HighOptimizationPasses.BandedLoops.Owned.Study, value: SpiteCompiler.Value?): Integer {
    fallback value
    var origin = origin_of_a_value(current, value)
    return checked(origin, value.value_type)
}

func origin_of_a_value(current: HighOptimizationPasses.BandedLoops.Owned.Study, value: SpiteCompiler.Value): Integer {
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return 0
        HighIntermediaryRepresentation.Values.DecimalNumber: return 0
        HighIntermediaryRepresentation.Values.NullConstant: return 0
        HighIntermediaryRepresentation.Values.Function.Fact: return 0
        HighIntermediaryRepresentation.Values.TextConstant: return shared
        HighIntermediaryRepresentation.Values.Class.Object: return shared
        HighIntermediaryRepresentation.Values.LocalRead: return current.origin_of(value.name)
        HighIntermediaryRepresentation.Values.ThisRead: return current.this_origin
        HighIntermediaryRepresentation.Values.AttributeRead: return origin_of_an_attribute(current, value)
        HighIntermediaryRepresentation.Values.Call: return origin_of_a_call(current, value)
        HighIntermediaryRepresentation.Values.MakeObject: return origin_of_a_making(current, value)
        HighIntermediaryRepresentation.Values.MachineOperation: return origin_of_both(current, value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: return origin_of_both(current, value.negated, null)
        HighIntermediaryRepresentation.Values.Class.Membership: return origin_of_both(current, value.tested, null)
        HighIntermediaryRepresentation.Values.PresenceTest: return origin_of_both(current, value.tested, null)
        HighIntermediaryRepresentation.Values.EnumFromText: return origin_of_both(current, value.text, null)
        HighIntermediaryRepresentation.Values.EnumText: return origin_of_a_text(current, value.number)
        HighIntermediaryRepresentation.Values.Class.OfValue: return origin_of_a_text(current, value.described)
        HighIntermediaryRepresentation.Values.Conversion: return origin_of_a_conversion(current, value)
        HighIntermediaryRepresentation.Values.ForeignCall: return given_up_origin("it makes a foreign call")
        HighIntermediaryRepresentation.Values.Function.Value: return origin_of_both(current, value.receiver, null)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return origin_of_a_value_call(current, value)
        HighIntermediaryRepresentation.Values.ShapeCall: return given_up_origin("it calls through a shape")
        HighIntermediaryRepresentation.Values.NumberRoom: return origin_of_a_room(current, value)
    }
}

func origin_of_a_room(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    room: HighIntermediaryRepresentation.Values.NumberRoom,
): Integer {
    fallback reads(current, room.made) and reads(current, room.number)
    return fresh
}

func reads(current: HighOptimizationPasses.BandedLoops.Owned.Study, value: SpiteCompiler.Value?): Boolean {
    var origin = origin_of(current, value)
    return is_known(origin)
}

func is_known(origin: Integer): Boolean {
    return not gave_up and origin < owned * 2
}

func given_up_origin(reason: String): Integer {
    give_up(reason)
    return shared
}

func origin_of_both(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    first: SpiteCompiler.Value?,
    second: SpiteCompiler.Value?,
): Integer {
    fallback reads(current, first) and reads(current, second)
    return 0
}

func origin_of_a_text(current: HighOptimizationPasses.BandedLoops.Owned.Study, read: SpiteCompiler.Value?): Integer {
    fallback reads(current, read)
    return shared
}

func origin_of_an_attribute(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
): Integer {
    var object_origin = origin_of(current, read.object)
    var origin = 0
    var attribute = read.attribute
    var held = stored_at("{attribute.owner}.{attribute.name}")
    if has(object_origin, fresh) {
        origin = joined(origin, held)
    }
    if has(object_origin, owned) {
        var reached = joined(held, owned)
        origin = joined(origin, reached)
    }
    if has(object_origin, item) or has(object_origin, shared) {
        origin = joined(origin, shared)
    }
    return origin
}

func origin_of_a_conversion(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    conversion: HighIntermediaryRepresentation.Values.Conversion,
): Integer {
    var kind = conversion.kind
    if kind == 'join' or kind == 'into_handle' or kind == 'address' or kind == 'into_shape' {
        give_up("it holds a `{kind}` conversion")
        return shared
    }
    return origin_of(current, conversion.converted)
}

func origin_of_a_call(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    call: HighIntermediaryRepresentation.Values.Call,
): Integer {
    if is_the_fallback_ring(call.receiver) {
        take_a_fallback()
        return 0
    }
    var receiver_origin = origin_of(current, call.receiver)
    var argument_origins = origins_of(current, call.arguments)
    var function_key = call.function.key()
    var is_built = built_by_key.contains(function_key)
    fallback not is_plain_receiver(call.receiver) or is_built
    if not is_built {
        return supplied(call.function, call.receiver, receiver_origin, argument_origins)
    }
    var bindings = bindings_of(current, call.function, call.arguments)
    return study(call.function, receiver_origin, argument_origins, bindings)
}

func bindings_of(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    function: Model.FunctionModel,
    arguments: List<SpiteCompiler.Value>,
): HighOptimizationPasses.BandedLoops.Owned.Bindings {
    var bindings = HighOptimizationPasses.BandedLoops.Owned.Bindings()
    var index = 0
    while index < arguments.count() and index < function.parameters.count() {
        var argument = arguments[index]
        var parameter = function.parameters[index]
        bind_an_argument(current, bindings, parameter.name, argument)
        index = index + 1
    }
    return bindings
}

func bind_an_argument(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    bindings: HighOptimizationPasses.BandedLoops.Owned.Bindings,
    name: String,
    argument: SpiteCompiler.Value,
) {
    if argument.class == HighIntermediaryRepresentation.Values.Function.Value {
        var receiver_origin = origin_of(current, argument.receiver)
        bindings.bind(name, argument.function, receiver_origin)
        return
    }
    fallback argument.class == HighIntermediaryRepresentation.Values.LocalRead
    var bound = current.bindings.function_of(argument.name)
    fallback bound
    var bound_origin = current.bindings.origin_of(argument.name)
    bindings.bind(name, bound, bound_origin)
}

func is_the_fallback_ring(receiver: SpiteCompiler.Value?): Boolean {
    fallback receiver and receiver.class == HighIntermediaryRepresentation.Values.MakeObject
    return receiver.value_type.name == "Spite.Asserts"
}

func origin_of_a_value_call(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    call: HighIntermediaryRepresentation.Values.Function.ValueCall,
): Integer {
    if call.called and call.called.class == HighIntermediaryRepresentation.Values.LocalRead {
        return origin_of_a_bound_call(current, call, call.called.name)
    }
    return given_up_origin("it calls a function value it cannot name")
}

func origin_of_a_bound_call(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    call: HighIntermediaryRepresentation.Values.Function.ValueCall,
    name: String,
): Integer {
    var bound = current.bindings.function_of(name)
    if not bound {
        return given_up_origin("it calls a function value it cannot name")
    }
    var receiver_origin = current.bindings.origin_of(name)
    var argument_origins = origins_of(current, call.arguments)
    var bindings = bindings_of(current, bound, call.arguments)
    return study(bound, receiver_origin, argument_origins, bindings)
}

func is_plain_receiver(receiver: SpiteCompiler.Value?): Boolean {
    fallback receiver
    return is_plain(receiver.value_type)
}

func origins_of(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    values: List<SpiteCompiler.Value>,
): List<Integer> {
    var origins = List<Integer>()
    var index = 0
    while index < values.count() {
        var value = values[index]
        var origin = origin_of(current, value)
        origins.append(origin)
        index = index + 1
    }
    return origins
}

func origin_of_a_making(
    current: HighOptimizationPasses.BandedLoops.Owned.Study,
    made: HighIntermediaryRepresentation.Values.MakeObject,
): Integer {
    var argument_origins = origins_of(current, made.arguments)
    var class_key = made.value_type.name
    var model = high.model.class_named(class_key)
    if not model or not made.foreign_place.is_empty() {
        give_up("it makes a `{class_key}` it cannot follow")
        return shared
    }
    if model.is_singleton {
        give_up("it reaches the singleton `{model.shown}`")
        return shared
    }
    if not made.skips_the_defaults {
        var defaults_key = "{class_key}._attribute_defaults"
        var defaults = built_by_key[defaults_key]
        if defaults {
            var no_arguments = List<Integer>()
            var no_bindings = HighOptimizationPasses.BandedLoops.Owned.Bindings()
            var defaulted = study(defaults.function, fresh, no_arguments, no_bindings)
            fallback is_known(defaulted)
        }
    }
    if made.constructor {
        var made_bindings = HighOptimizationPasses.BandedLoops.Owned.Bindings()
        var constructed = study(made.constructor, fresh, argument_origins, made_bindings)
        fallback is_known(constructed)
    }
    return fresh
}

func add_the_reached(reached: List<String>) {
    var keys = answers.keys()
    var index = 0
    while index < keys.count() {
        var context = keys[index]
        var parts = context.split("|")
        var key = parts.first()
        crash key
        if not reached.contains(key) {
            reached.append(key)
        }
        index = index + 1
    }
}

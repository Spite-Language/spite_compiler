var program: HighIntermediaryRepresentation.HighProgram? = null

# ../../OPTIMIZATIONS.md#a-singleton-that-holds-nothing-is-a-static-object
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    fallback not is_inspected(high.context.build_flags)
    program = high
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        if holds_nothing(model) {
            high.static_singletons.append(model.key)
        }
        index = index + 1
    }
}

func is_inspected(flags: Dictionary<String, String>): Boolean {
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func holds_nothing(model: Model.ClassModel): Boolean {
    fallback model.is_singleton and model.declared_attributes.is_empty()
    fallback not model.function_named("drop") and not model.key.starts_with("Spite.")
    crash program
    fallback not program.entry or program.entry.owner != model.key
    crash program.layout
    var is_bare = program.layout.made_size_of(model.key) == program.layout.header_size
    fallback not program.layout.is_back_held(model.key) and is_bare
    return makes_nothing(model.key)
}

func makes_nothing(class_key: String): Boolean {
    crash program
    var index = 0
    while index < program.built_functions.count() {
        var built = program.built_functions[index]
        var declared = built.function
        var makes = declared.is_constructor or declared.name == "_attribute_defaults"
        var does_something = not declared.parameters.is_empty() or not built.body.statements.is_empty()
        fallback declared.owner != class_key or not makes or not does_something
        index = index + 1
    }
    return true
}

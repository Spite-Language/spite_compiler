# ../../OPTIMIZATIONS.md#a-literal-that-converts-is-its-answer

var offered = List<Model.FunctionModel>()
var offered_keys = Dictionary<String, Boolean>()
var built_by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    fallback not high.context.literal_sites.is_empty()
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        rewriting.rewrite_block(built.body)
        var key = built.function.key()
        built_by_key[key] = built
        index = index + 1
    }
    index = 0
    while index < offered.count() {
        var function = offered[index]
        high.replaced_functions.append(function)
        offer_what_it_reached(function)
        index = index + 1
    }
}

func offer(function: Model.FunctionModel) {
    var key = function.key()
    fallback not offered_keys.contains(key)
    offered_keys[key] = true
    offered.append(function)
}

func offer_what_it_reached(function: Model.FunctionModel) {
    var key = function.key()
    var built = built_by_key[key]
    fallback built
    var references = HighOptimizationPasses.References()
    var keys = references.of(built)
    var index = 0
    while index < keys.count() {
        var reached_key = keys[index]
        var reached = built_by_key[reached_key]
        if reached {
            offer(reached.function)
        }
        index = index + 1
    }
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Call and value.literal_answer {
        offer(value.function)
        return value.literal_answer
    }
    return value
}

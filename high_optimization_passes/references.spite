# ../OPTIMIZATIONS.md#a-function-only-a-replaced-call-reached-is-not-compiled

var keys = List<String>()

func of(function: HighIntermediaryRepresentation.HighFunction): List<String> {
    keys = List<String>()
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(function.body)
    return keys
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    note_what_it_reaches(value)
    return value
}

func note_what_it_reaches(value: SpiteCompiler.Value) {
    switch value {
        HighIntermediaryRepresentation.Values.Call: note_a_function(value.function)
        HighIntermediaryRepresentation.Values.MakeObject: note_a_constructor(value.constructor)
        HighIntermediaryRepresentation.Values.ShapeCall: note_a_shape_call(value)
        HighIntermediaryRepresentation.Values.Function.Value: note_a_function(value.function)
        HighIntermediaryRepresentation.Values.Function.Fact: value.asked_functions.each(note_a_function)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.AttributeRead: return
        HighIntermediaryRepresentation.Values.MachineOperation: return
        HighIntermediaryRepresentation.Values.Negation: return
        HighIntermediaryRepresentation.Values.ForeignCall: return
        HighIntermediaryRepresentation.Values.Class.Membership: return
        HighIntermediaryRepresentation.Values.PresenceTest: return
        HighIntermediaryRepresentation.Values.Conversion: return
        HighIntermediaryRepresentation.Values.Function.ValueCall: return
        HighIntermediaryRepresentation.Values.NumberRoom: return
        HighIntermediaryRepresentation.Values.EnumText: return
        HighIntermediaryRepresentation.Values.EnumFromText: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Class.OfValue: return
    }
}

func note_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    var key = "shape {call.member.name}"
    note_a_key(key)
}

func note_a_constructor(constructor: Model.FunctionModel?) {
    fallback constructor
    note_a_function(constructor)
}

func note_a_function(function: Model.FunctionModel) {
    var key = function.key()
    note_a_key(key)
}

func note_a_key(key: String) {
    fallback not keys.contains(key)
    keys.append(key)
}

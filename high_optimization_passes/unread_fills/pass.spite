# ../../OPTIMIZATIONS.md#a-class-object-nothing-reads-is-never-filled

var fills = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var reached = Dictionary<String, Boolean>()
var waiting = List<String>()

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    fills = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
    reached = Dictionary<String, Boolean>()
    waiting = List<String>()
    high.context.fills.each(note_a_fill)
    fallback not fills.is_empty()
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        if not fills.contains(key) {
            rewriting.rewrite_block(built.body)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var reached_key = waiting.remove_first()
        crash reached_key
        var fill = fills[reached_key]
        crash fill
        rewriting.rewrite_block(fill.body)
    }
    var unread = fills.values()
    var unread_index = 0
    while unread_index < unread.count() {
        var fill = unread[unread_index]
        var fill_key = fill.function.key()
        if not reached.contains(fill_key) {
            high.replaced_functions.append(fill.function)
        }
        unread_index = unread_index + 1
    }
}

func note_a_fill(fill: HighIntermediaryRepresentation.HighFunction) {
    fallback fill.function.name.starts_with("_fill_")
    var key = fill.function.key()
    fills[key] = fill
}

# ../../PROOFS.md#a-class-object-is-filled-only-where-it-is-read
func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Class.Object {
        reach(value.reflection_kind, value.described)
    } else if value.class == HighIntermediaryRepresentation.Values.Class.OfValue {
        var index = 0
        while index < value.candidates.count() {
            var candidate = value.candidates[index]
            reach(value.value_type.name, candidate)
            index = index + 1
        }
    }
    return value
}

func reach(kind: String, described: String) {
    var key = "{kind}._fill_{described}"
    fallback not reached.contains(key)
    reached[key] = true
    fallback fills.contains(key)
    waiting.append(key)
}

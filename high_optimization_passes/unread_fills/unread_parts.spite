# ../../PROOFS.md#a-fill-makes-nothing-but-its-objects

var reads = Dictionary<String, Integer>()
var filled_into = Dictionary<String, Integer>()

# ../../OPTIMIZATIONS.md#a-class-object-nothing-reads-is-never-filled
func leave_out_of(fill: HighIntermediaryRepresentation.HighFunction) {
    var left_out = true
    while left_out {
        left_out = leave_out_once(fill.body)
    }
}

func leave_out_once(body: HighIntermediaryRepresentation.Statements.Block): Boolean {
    reads = Dictionary<String, Integer>()
    filled_into = Dictionary<String, Integer>()
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(body)
    body.statements.each(note_a_filling)
    var kept = List<SpiteCompiler.Statement>()
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if not is_an_unread_part(statement) {
            kept.append(statement)
        }
        index = index + 1
    }
    var changed = kept.count() != body.statements.count()
    body.statements = kept
    return changed
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        var counted = reads[value.name]
        if counted {
            reads[value.name] = counted + 1
        } else {
            reads[value.name] = 1
        }
    }
    return value
}

func note_a_filling(statement: SpiteCompiler.Statement) {
    var filled = filled_local_of(statement)
    fallback not filled.is_empty()
    var counted = filled_into[filled]
    if counted {
        filled_into[filled] = counted + 1
    } else {
        filled_into[filled] = 1
    }
}

func filled_local_of(statement: SpiteCompiler.Statement): String {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Evaluate
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
    var name = statement.value.function.name
    fallback name == "append" or name == "set_at"
    fallback statement.value.receiver and statement.value.receiver.class == HighIntermediaryRepresentation.Values.LocalRead
    return statement.value.receiver.name
}

func is_an_unread_part(statement: SpiteCompiler.Statement): Boolean {
    var filled = filled_local_of(statement)
    if not filled.is_empty() {
        return is_unread(filled)
    }
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.MakeObject
    return is_unread(statement.name)
}

func is_unread(name: String): Boolean {
    var read = 0
    var counted_reads = reads[name]
    if counted_reads {
        read = counted_reads
    }
    var filled = 0
    var counted_fillings = filled_into[name]
    if counted_fillings {
        filled = counted_fillings
    }
    return read == filled
}

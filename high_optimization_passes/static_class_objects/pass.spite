# ../../OPTIMIZATIONS.md#a-class-object-is-static-data

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    var exit_reach = HighOptimizationPasses.ClassObjectReads.ExitReach()
    var at_exit = exit_reach.of(high)
    var seen_at_exit = Dictionary<String, Boolean>()
    if not at_exit.is_empty() {
        seen_at_exit = exit_reach.objects_seen_at_exit(high)
    }
    fallback not exit_reach.asks_a_class
    var replaced = Dictionary<String, Boolean>()
    var replaced_index = 0
    while replaced_index < high.replaced_functions.count() {
        var function = high.replaced_functions[replaced_index]
        var replaced_key = function.key()
        replaced[replaced_key] = true
        replaced_index = replaced_index + 1
    }
    var index = 0
    while index < high.context.fills.count() {
        var fill = high.context.fills[index]
        var known = high.context.filled[index]
        crash known
        var is_a_class_object = fill.function.name.starts_with("_fill_")
        var fill_key = fill.function.key()
        var is_kept = not replaced.contains(fill_key)
        if is_a_class_object and is_kept and not seen_at_exit.contains(known) {
            high.static_class_objects.append(known)
        }
        index = index + 1
    }
}

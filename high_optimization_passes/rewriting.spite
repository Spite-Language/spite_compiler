union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../ARCHITECTURE.md#a-high-pass-that-rewrites-and-builds-functions
type Rule {
    rewritten(Value): Value
}

var rule: Rule? = null
var line = 0

func Rewriting(starting_rule: Rule) {
    rule = starting_rule
}

func rewrite_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(rewrite_statement)
}

func rewrite_statement(statement: Statement) {
    note_the_line(statement)
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: rewrite_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: rewrite_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: rewrite_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: rewrite_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: rewrite_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: rewrite_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: rewrite_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: rewrite_a_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: rewrite_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: rewrite_block(statement)
    }
}

func note_the_line(statement: Statement) {
    if statement.line > 0 {
        line = statement.line
    }
}

func rewrite_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    declared.value = rewritten_or_none(declared.value)
}

func rewrite_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    assigned.value = rewritten_or_none(assigned.value)
}

func rewrite_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    written.object = rewritten_or_none(written.object)
    written.value = rewritten_or_none(written.value)
}

func rewrite_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    written.object = rewritten_or_none(written.object)
    written.value = rewritten_or_none(written.value)
}

func rewrite_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    evaluated.value = rewritten_or_none(evaluated.value)
    evaluated.waited = rewritten_or_none(evaluated.waited)
}

func rewrite_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    branch.condition = rewritten_or_none(branch.condition)
    branch.decided_condition = rewritten_or_none(branch.decided_condition)
    rewrite_block(branch.then_branch)
    rewrite_block(branch.else_branch)
}

func rewrite_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    loop.condition = rewritten_or_none(loop.condition)
    rewrite_block(loop.body)
}

func rewrite_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    returned.value = rewritten_or_none(returned.value)
}

func rewrite_a_stop(stopped: HighIntermediaryRepresentation.Statements.Stop) {
    rewrite_the_list(stopped.shown)
    stopped.then = rewritten_or_none(stopped.then)
}

func rewritten_or_none(
    value: Value?,
): Value? {
    if value {
        return rewritten_value(value)
    }
    return null
}

func rewritten_value(value: Value): Value {
    crash rule
    var replaced = rule.rewritten(value)
    rewrite_the_parts(replaced)
    return replaced
}

func rewrite_the_list(values: List<Value>) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        var replaced = rewritten_value(value)
        values[index] = replaced
        index = index + 1
    }
}

func rewrite_the_parts(value: Value) {
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: rewrite_an_attribute_read(value)
        HighIntermediaryRepresentation.Values.Call: rewrite_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: rewrite_a_conversion(value)
        HighIntermediaryRepresentation.Values.EnumFromText: rewrite_an_enum_from_text(value)
        HighIntermediaryRepresentation.Values.EnumText: rewrite_an_enum_text(value)
        HighIntermediaryRepresentation.Values.ForeignCall: rewrite_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: rewrite_an_operation(value)
        HighIntermediaryRepresentation.Values.MakeObject: rewrite_the_list(value.arguments)
        HighIntermediaryRepresentation.Values.Negation: rewrite_a_negation(value)
        HighIntermediaryRepresentation.Values.NumberRoom: rewrite_a_number_room(value)
        HighIntermediaryRepresentation.Values.PresenceTest: rewrite_a_presence_test(value)
        HighIntermediaryRepresentation.Values.ShapeCall: rewrite_a_shape_call(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: rewrite_a_class_of_value(value)
        HighIntermediaryRepresentation.Values.Class.Membership: rewrite_a_class_test(value)
        HighIntermediaryRepresentation.Values.Function.Value: rewrite_a_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: rewrite_a_function_value_call(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func rewrite_an_attribute_read(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    read.object = rewritten_or_none(read.object)
}

func rewrite_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    call.receiver = rewritten_or_none(call.receiver)
    rewrite_the_list(call.arguments)
}

func rewrite_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    conversion.converted = rewritten_or_none(conversion.converted)
}

func rewrite_an_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText) {
    read.text = rewritten_or_none(read.text)
}

func rewrite_an_enum_text(read: HighIntermediaryRepresentation.Values.EnumText) {
    read.number = rewritten_or_none(read.number)
}

func rewrite_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    call.library = rewritten_or_none(call.library)
    rewrite_the_list(call.arguments)
}

func rewrite_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    operation.left = rewritten_or_none(operation.left)
    operation.right = rewritten_or_none(operation.right)
}

func rewrite_a_negation(negation: HighIntermediaryRepresentation.Values.Negation) {
    negation.negated = rewritten_or_none(negation.negated)
}

func rewrite_a_number_room(room: HighIntermediaryRepresentation.Values.NumberRoom) {
    room.made = rewritten_or_none(room.made)
    room.number = rewritten_or_none(room.number)
}

func rewrite_a_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest) {
    test.tested = rewritten_or_none(test.tested)
}

func rewrite_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    call.receiver = rewritten_or_none(call.receiver)
    rewrite_the_list(call.arguments)
}

func rewrite_a_class_of_value(read: HighIntermediaryRepresentation.Values.Class.OfValue) {
    read.described = rewritten_or_none(read.described)
}

func rewrite_a_class_test(test: HighIntermediaryRepresentation.Values.Class.Membership) {
    test.tested = rewritten_or_none(test.tested)
}

func rewrite_a_function_value(read: HighIntermediaryRepresentation.Values.Function.Value) {
    read.receiver = rewritten_or_none(read.receiver)
}

func rewrite_a_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    call.called = rewritten_or_none(call.called)
    rewrite_the_list(call.arguments)
}

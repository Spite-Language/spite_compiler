# ../OPTIMIZATIONS.md
type HighOptimizationPass {
    optimized(HighIntermediaryRepresentation.HighProgram)
}

var passes = List<HighOptimizationPass>()
var running = false

func HighOptimizationPasses() {
    var setup_list_calls = HighOptimizationPasses.SetupListCalls.SetupListCalls()
    register(setup_list_calls)
    var fused_chains = HighOptimizationPasses.FusedChains.FusedChains()
    register(fused_chains)
    var banded_loops = HighOptimizationPasses.BandedLoops.BandedLoops()
    register(banded_loops)
    var folded_dictionaries = HighOptimizationPasses.FoldedDictionaries.FoldedDictionaries()
    register(folded_dictionaries)
    var unreached_functions = HighOptimizationPasses.UnreachedFunctions.UnreachedFunctions()
    register(unreached_functions)
    var untouched_attributes = HighOptimizationPasses.UntouchedAttributes.UntouchedAttributes()
    register(untouched_attributes)
    var layouts_by_use = HighOptimizationPasses.LayoutsByUse.LayoutsByUse()
    register(layouts_by_use)
    var static_singletons = HighOptimizationPasses.StaticSingletons.StaticSingletons()
    register(static_singletons)
    var call_assignments = HighOptimizationPasses.CallAssignments.CallAssignments()
    register(call_assignments)
    var singleton_locks = HighOptimizationPasses.SingletonLocks.SingletonLocks()
    register(singleton_locks)
    var lone_atomic_attributes = Proofs.LoneAtomicAttributes.LoneAtomicAttributes()
    var proving_lone_atomics = HighOptimizationPasses.Proving(lone_atomic_attributes)
    register(proving_lone_atomics)
    var no_thread_counts = Proofs.NoThreadCounts.NoThreadCounts()
    var proving_no_thread_counts = HighOptimizationPasses.Proving(no_thread_counts)
    register(proving_no_thread_counts)
    var copies_nothing_changes = Proofs.CopiesNothingChanges.CopiesNothingChanges()
    var proving_copies = HighOptimizationPasses.Proving(copies_nothing_changes)
    register(proving_copies)
    var shared_copies = HighOptimizationPasses.SharedCopies.SharedCopies()
    register(shared_copies)
    var replaced_defaults = HighOptimizationPasses.ReplacedDefaults.ReplacedDefaults()
    register(replaced_defaults)
    var taken_parameters = HighOptimizationPasses.TakenParameters.TakenParameters()
    register(taken_parameters)
    var embedded_attributes = HighOptimizationPasses.EmbeddedAttributes.EmbeddedAttributes()
    register(embedded_attributes)
    var inline_items = HighOptimizationPasses.InlineItems.InlineItems()
    register(inline_items)
    var lent_attributes = HighOptimizationPasses.LentAttributes.LentAttributes()
    register(lent_attributes)
    var steady_singleton_attributes = Proofs.SteadySingletonAttributes.SteadySingletonAttributes()
    var proving_steady_attributes = HighOptimizationPasses.Proving(steady_singleton_attributes)
    register(proving_steady_attributes)
}

func register(pass: HighOptimizationPass) {
    crash not running
    passes.append(pass)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < passes.count() {
        var pass = passes[index]
        pass.optimized(high)
        index = index + 1
    }
    return high
}

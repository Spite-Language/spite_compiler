# ../OPTIMIZATIONS.md

type HighOptimizationPass {
    optimized: Spite.Function<HighIntermediaryRepresentation.HighProgram, Nothing>
}

var passes = List<HighOptimizationPass>()
var running = false

func HighOptimizationPasses() {
    var copied_runs = HighOptimizationPasses.CopiedRuns.Pass()
    register(copied_runs)
    var answered_facts = HighOptimizationPasses.AnsweredFacts.Pass()
    register(answered_facts)
    var literal_answers = HighOptimizationPasses.LiteralAnswers.Pass()
    register(literal_answers)
    var setup_list_calls = HighOptimizationPasses.SetupListCalls.Pass()
    register(setup_list_calls)
    var fused_chains = HighOptimizationPasses.FusedChains.Pass()
    register(fused_chains)
    var banded_loops = HighOptimizationPasses.BandedLoops.Pass()
    register(banded_loops)
    var independent_work = Proofs.IndependentWork.Proof()
    var proving_independent_work = HighOptimizationPasses.Proving(independent_work)
    register(proving_independent_work)
    var overlapped_work = HighOptimizationPasses.OverlappedWork.Pass()
    register(overlapped_work)
    var folded_dictionaries = HighOptimizationPasses.FoldedDictionaries.Pass()
    register(folded_dictionaries)
    var unread_fields = HighOptimizationPasses.UnreadFields.Pass()
    register(unread_fields)
    var unreached_functions = HighOptimizationPasses.UnreachedFunctions.Pass()
    register(unreached_functions)
    var untouched_attributes = HighOptimizationPasses.UntouchedAttributes.Pass()
    register(untouched_attributes)
    var layouts_by_use = HighOptimizationPasses.LayoutsByUse.Pass()
    register(layouts_by_use)
    var split_classes = HighOptimizationPasses.SplitClasses.Pass()
    register(split_classes)
    var static_singletons = HighOptimizationPasses.StaticSingletons.Pass()
    register(static_singletons)
    var call_assignments = HighOptimizationPasses.CallAssignments.Pass()
    register(call_assignments)
    var singleton_locks = HighOptimizationPasses.SingletonLocks.Pass()
    register(singleton_locks)
    var lone_atomic_attributes = Proofs.LoneAtomicAttributes.Proof()
    var proving_lone_atomics = HighOptimizationPasses.Proving(lone_atomic_attributes)
    register(proving_lone_atomics)
    var no_thread_counts = Proofs.NoThreadCounts.Proof()
    var proving_no_thread_counts = HighOptimizationPasses.Proving(no_thread_counts)
    register(proving_no_thread_counts)
    var copies_nothing_changes = Proofs.CopiesNothingChanges.Proof()
    var proving_copies = HighOptimizationPasses.Proving(copies_nothing_changes)
    register(proving_copies)
    var shared_copies = HighOptimizationPasses.SharedCopies.Pass()
    register(shared_copies)
    var replaced_defaults = HighOptimizationPasses.ReplacedDefaults.Pass()
    register(replaced_defaults)
    var trimmed_buffers = HighOptimizationPasses.TrimmedBuffers.Pass()
    register(trimmed_buffers)
    var taken_parameters = HighOptimizationPasses.TakenParameters.Pass()
    register(taken_parameters)
    var embedded_attributes = HighOptimizationPasses.EmbeddedAttributes.Pass()
    register(embedded_attributes)
    var inline_items = HighOptimizationPasses.InlineItems.Pass()
    register(inline_items)
    var lent_attributes = HighOptimizationPasses.LentAttributes.Pass()
    register(lent_attributes)
    var reload_reaches_moved_objects = Proofs.ReloadReachesMovedObjects.Proof()
    var proving_moved_objects = HighOptimizationPasses.Proving(reload_reaches_moved_objects)
    register(proving_moved_objects)
    var steady_singleton_attributes = Proofs.SteadySingletonAttributes.Proof()
    var proving_steady_attributes = HighOptimizationPasses.Proving(steady_singleton_attributes)
    register(proving_steady_attributes)
}

func register(pass: HighOptimizationPass) {
    crash not running
    passes.append(pass)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < passes.count() {
        var pass = passes[index]
        pass.optimized(high)
        index = index + 1
    }
    return high
}

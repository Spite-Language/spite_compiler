# ../OPTIMIZATIONS.md

type HighOptimizationPass {
    optimized: Spite.Function<HighIntermediaryRepresentation.HighProgram, Nothing>
}

var passes = List<HighOptimizationPass>()
var running = false

func HighOptimizationPasses() {
    var unsubscribed_observers = UnsubscribedObservers.Pass()
    register(unsubscribed_observers)
    var children_stay_with_their_owner = Proofs.ChildrenStayWithTheirOwner.Proof()
    var proving_children = Proving(children_stay_with_their_owner)
    register(proving_children)
    var copied_runs = CopiedRuns.Pass()
    register(copied_runs)
    var answered_facts = AnsweredFacts.Pass()
    register(answered_facts)
    var literal_answers = LiteralAnswers.Pass()
    register(literal_answers)
    var walked_lists = WalkedLists.Pass()
    register(walked_lists)
    var setup_list_calls = SetupListCalls.Pass()
    register(setup_list_calls)
    var fused_chains = FusedChains.Pass()
    register(fused_chains)
    var banded_loops = BandedLoops.Pass()
    register(banded_loops)
    var independent_work = Proofs.IndependentWork.Proof()
    var proving_independent_work = Proving(independent_work)
    register(proving_independent_work)
    var overlapped_work = OverlappedWork.Pass()
    register(overlapped_work)
    var folded_dictionaries = FoldedDictionaries.Pass()
    register(folded_dictionaries)
    var steady_class_objects = Proofs.SteadyClassObjects.Proof()
    var proving_steady_class_objects = Proving(steady_class_objects)
    register(proving_steady_class_objects)
    var class_object_reads = ClassObjectReads.Pass()
    register(class_object_reads)
    var unread_fields = UnreadFields.Pass()
    register(unread_fields)
    var unread_fills = UnreadFills.Pass()
    register(unread_fills)
    var static_class_objects = StaticClassObjects.Pass()
    register(static_class_objects)
    var unreached_functions = UnreachedFunctions.Pass()
    register(unreached_functions)
    var constant_texts = ConstantTexts.Pass()
    register(constant_texts)
    var set_lists = Proofs.SetLists.Proof()
    var proving_set_lists = Proving(set_lists)
    register(proving_set_lists)
    var indexed_lists = IndexedLists.Pass()
    register(indexed_lists)
    var observers_made_by_the_passes = UnsubscribedObservers.Pass()
    register(observers_made_by_the_passes)
    var untouched_attributes = UntouchedAttributes.Pass()
    register(untouched_attributes)
    var layouts_by_use = LayoutsByUse.Pass()
    register(layouts_by_use)
    var split_classes = SplitClasses.Pass()
    register(split_classes)
    var static_singletons = StaticSingletons.Pass()
    register(static_singletons)
    var call_assignments = CallAssignments.Pass()
    register(call_assignments)
    var singleton_locks = SingletonLocks.Pass()
    register(singleton_locks)
    var lone_atomic_attributes = Proofs.LoneAtomicAttributes.Proof()
    var proving_lone_atomics = Proving(lone_atomic_attributes)
    register(proving_lone_atomics)
    var no_thread_counts = Proofs.NoThreadCounts.Proof()
    var proving_no_thread_counts = Proving(no_thread_counts)
    register(proving_no_thread_counts)
    var copies_nothing_changes = Proofs.CopiesNothingChanges.Proof()
    var proving_copies = Proving(copies_nothing_changes)
    register(proving_copies)
    var shared_copies = SharedCopies.Pass()
    register(shared_copies)
    var replaced_defaults = ReplacedDefaults.Pass()
    register(replaced_defaults)
    var trimmed_buffers = TrimmedBuffers.Pass()
    register(trimmed_buffers)
    var taken_parameters = TakenParameters.Pass()
    register(taken_parameters)
    var embedded_attributes = EmbeddedAttributes.Pass()
    register(embedded_attributes)
    var inline_items = InlineItems.Pass()
    register(inline_items)
    var lent_attributes = LentAttributes.Pass()
    register(lent_attributes)
    var reload_reaches_moved_objects = Proofs.ReloadReachesMovedObjects.Proof()
    var proving_moved_objects = Proving(reload_reaches_moved_objects)
    register(proving_moved_objects)
    var steady_singleton_attributes = Proofs.SteadySingletonAttributes.Proof()
    var proving_steady_attributes = Proving(steady_singleton_attributes)
    register(proving_steady_attributes)
    var alone_counts = Proofs.AloneCounts.Proof()
    var proving_alone_counts = Proving(alone_counts)
    register(proving_alone_counts)
}

func register(pass: HighOptimizationPass) {
    crash not running
    passes.append(pass)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < passes.count() {
        var pass = passes[index]
        pass.optimized(high)
        index = index + 1
    }
    return high
}

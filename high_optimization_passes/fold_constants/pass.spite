var empty_classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var program = HighIntermediaryRepresentation.Programs.HighProgram(empty_classes, "")
var statements = List<HighIntermediaryRepresentation.Statements.Statement>()
var arguments = List<HighIntermediaryRepresentation.Values.Value>()
var folded_values = 0
var classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var held = List<HighIntermediaryRepresentation.Functions.HighFunction>()

func Pass(starting_program: HighIntermediaryRepresentation.Programs.HighProgram) {
    program = starting_program
}

func transformed(): HighIntermediaryRepresentation.Programs.HighProgram {
    classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
    program.classes.each(read_class)
    return HighIntermediaryRepresentation.Programs.HighProgram(classes, program.entry)
}

func read_class(own: HighIntermediaryRepresentation.Classes.HighClass) {
    held = List<HighIntermediaryRepresentation.Functions.HighFunction>()
    own.held_functions.each(read_function)
    var rebuilt = HighIntermediaryRepresentation.Classes.HighClass(
        own.name,
        held,
        own.held_attributes,
        own.block_size,
        own.room_size,
    )
    classes.append(rebuilt)
}

func read_function(own: HighIntermediaryRepresentation.Functions.HighFunction) {
    if own.body {
        var statements = fold_block(own.body)
        var rewritten = HighIntermediaryRepresentation.Functions.HighFunction(
            own.name,
            own.parameters,
            own.parameter_types,
            own.result_type,
            statements,
        )
        held.append(rewritten)
    } else {
        held.append(own)
    }
}

func fold_block(
    block: HighIntermediaryRepresentation.Statements.Block,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    block.statements.each(fold_statement)
    var built = HighIntermediaryRepresentation.Statements.Block(statements)
    statements = outer
    return built
}

func fold_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: fold_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: fold_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: fold_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.If: fold_if(statement)
        HighIntermediaryRepresentation.Statements.While: fold_while(statement)
        HighIntermediaryRepresentation.Statements.Call: fold_call(statement)
        HighIntermediaryRepresentation.Statements.ForeignCall: fold_foreign_call(statement)
        HighIntermediaryRepresentation.Statements.BufferWrite: fold_buffer_write(statement)
        HighIntermediaryRepresentation.Statements.Return: fold_return(statement)
    }
}

func fold_declare(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    if declaration.value {
        var folded = fold_value(declaration.value)
        var rebuilt = HighIntermediaryRepresentation.Statements.Declare(declaration.name, folded)
        statements.append(rebuilt)
    } else {
        statements.append(declaration)
    }
}

func fold_assign(assignment: HighIntermediaryRepresentation.Statements.Assign) {
    if assignment.value {
        var folded = fold_value(assignment.value)
        var rebuilt = HighIntermediaryRepresentation.Statements.Assign(assignment.name, folded)
        statements.append(rebuilt)
    } else {
        statements.append(assignment)
    }
}

func fold_assign_attribute(assignment: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    if assignment.object and assignment.value {
        var object = fold_value(assignment.object)
        var folded = fold_value(assignment.value)
        var rebuilt = HighIntermediaryRepresentation.Statements.AssignAttribute(
            object,
            assignment.class_name,
            assignment.name,
            folded,
        )
        statements.append(rebuilt)
    } else {
        statements.append(assignment)
    }
}

func fold_if(branch: HighIntermediaryRepresentation.Statements.If) {
    if branch.condition and branch.then_branch {
        var test = fold_value(branch.condition)
        var then_block = fold_block(branch.then_branch)
        var else_block = fold_the_else_branch(branch)
        var rebuilt = HighIntermediaryRepresentation.Statements.If(test, then_block, else_block)
        statements.append(rebuilt)
    } else {
        statements.append(branch)
    }
}

func fold_the_else_branch(
    branch: HighIntermediaryRepresentation.Statements.If,
): HighIntermediaryRepresentation.Statements.Block? {
    if branch.else_branch {
        var else_branch = branch.else_branch
        return fold_block(else_branch)
    } else {
        return null
    }
}

func fold_while(loop: HighIntermediaryRepresentation.Statements.While) {
    if loop.condition and loop.body {
        var test = fold_value(loop.condition)
        var rest = fold_block(loop.body)
        var rebuilt = HighIntermediaryRepresentation.Statements.While(test, rest)
        statements.append(rebuilt)
    } else {
        statements.append(loop)
    }
}

func fold_call(call: HighIntermediaryRepresentation.Statements.Call) {
    var given = fold_arguments(call.arguments)
    var rebuilt = HighIntermediaryRepresentation.Statements.Call(call.callee, call.owner, given)
    statements.append(rebuilt)
}

func fold_foreign_call(statement: HighIntermediaryRepresentation.Statements.ForeignCall) {
    if statement.call {
        var folded = fold_value(statement.call)
        var rebuilt = HighIntermediaryRepresentation.Statements.ForeignCall(folded)
        statements.append(rebuilt)
    } else {
        statements.append(statement)
    }
}

func fold_buffer_write(statement: HighIntermediaryRepresentation.Statements.BufferWrite) {
    if statement.object and statement.offset and statement.value {
        var object = fold_value(statement.object)
        var at = fold_value(statement.offset)
        var folded = fold_value(statement.value)
        var rebuilt = HighIntermediaryRepresentation.Statements.BufferWrite(object, at, folded)
        statements.append(rebuilt)
    } else {
        statements.append(statement)
    }
}

func fold_arguments(
    wanted: List<HighIntermediaryRepresentation.Values.Value>,
): List<HighIntermediaryRepresentation.Values.Value> {
    var outer = arguments
    arguments = List<HighIntermediaryRepresentation.Values.Value>()
    wanted.each(fold_argument)
    var built = arguments
    arguments = outer
    return built
}

func fold_argument(argument: HighIntermediaryRepresentation.Values.Value) {
    var folded = fold_value(argument)
    arguments.append(folded)
}

func fold_return(statement: HighIntermediaryRepresentation.Statements.Return) {
    if statement.value {
        var folded = fold_value(statement.value)
        var rebuilt = HighIntermediaryRepresentation.Statements.Return(folded)
        statements.append(rebuilt)
    } else {
        statements.append(statement)
    }
}

func fold_value(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    if value == HighIntermediaryRepresentation.Values.Operation {
        return fold_operation(value)
    }
    if value == HighIntermediaryRepresentation.Values.Answer {
        return fold_called(value)
    }
    if value == HighIntermediaryRepresentation.Values.Attribute {
        return fold_read_attribute(value)
    }
    if value == HighIntermediaryRepresentation.Values.ForeignCall {
        return fold_made_foreign_call(value)
    }
    if value == HighIntermediaryRepresentation.Values.BufferRead {
        return fold_read_of_a_byte(value)
    }
    if value == HighIntermediaryRepresentation.Values.StorageAddress {
        return fold_the_address_of_a_value(value)
    } else {
        return value
    }
}

func fold_read_of_a_byte(
    read: HighIntermediaryRepresentation.Values.BufferRead,
): HighIntermediaryRepresentation.Values.Value {
    if read.object and read.offset {
        var object = fold_value(read.object)
        var at = fold_value(read.offset)
        return HighIntermediaryRepresentation.Values.BufferRead(object, at)
    } else {
        return read
    }
}

func fold_the_address_of_a_value(
    address: HighIntermediaryRepresentation.Values.StorageAddress,
): HighIntermediaryRepresentation.Values.Value {
    if address.value {
        var folded = fold_value(address.value)
        return HighIntermediaryRepresentation.Values.StorageAddress(folded)
    } else {
        return address
    }
}

func fold_made_foreign_call(
    foreign: HighIntermediaryRepresentation.Values.ForeignCall,
): HighIntermediaryRepresentation.Values.Value {
    if foreign.receiver {
        var receiver = fold_value(foreign.receiver)
        var given = fold_arguments(foreign.arguments)
        return HighIntermediaryRepresentation.Values.ForeignCall(foreign.name, receiver, given)
    } else {
        return foreign
    }
}

func fold_read_attribute(
    attribute: HighIntermediaryRepresentation.Values.Attribute,
): HighIntermediaryRepresentation.Values.Value {
    if attribute.object {
        var object = fold_value(attribute.object)
        return HighIntermediaryRepresentation.Values.Attribute(object, attribute.class_name, attribute.name)
    } else {
        return attribute
    }
}

func fold_called(answer: HighIntermediaryRepresentation.Values.Answer): HighIntermediaryRepresentation.Values.Value {
    var given = fold_arguments(answer.arguments)
    return HighIntermediaryRepresentation.Values.Answer(answer.callee, answer.owner, given)
}

func fold_operation(
    operation: HighIntermediaryRepresentation.Values.Operation,
): HighIntermediaryRepresentation.Values.Value {
    var left = fold_side(operation.left)
    var right = fold_side(operation.right)
    return fold_pair(operation, left, right)
}

func fold_side(value: HighIntermediaryRepresentation.Values.Value?): HighIntermediaryRepresentation.Values.Value {
    if value {
        return fold_value(value)
    } else {
        return HighIntermediaryRepresentation.Values.Name("")
    }
}

func fold_pair(
    operation: HighIntermediaryRepresentation.Values.Operation,
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if left == HighIntermediaryRepresentation.Values.WholeNumber {
        return fold_pair_right(operation, left, right)
    } else {
        return HighIntermediaryRepresentation.Values.Operation(left, operation.operator, right)
    }
}

func fold_pair_right(
    operation: HighIntermediaryRepresentation.Values.Operation,
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if left == HighIntermediaryRepresentation.Values.WholeNumber {
        return fold_both(operation, left, right)
    } else {
        return HighIntermediaryRepresentation.Values.Operation(left, operation.operator, right)
    }
}

func fold_both(
    operation: HighIntermediaryRepresentation.Values.Operation,
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if right == HighIntermediaryRepresentation.Values.WholeNumber {
        return fold_answer(operation, left, right)
    } else {
        return HighIntermediaryRepresentation.Values.Operation(left, operation.operator, right)
    }
}

func fold_answer(
    operation: HighIntermediaryRepresentation.Values.Operation,
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: HighIntermediaryRepresentation.Values.WholeNumber,
): HighIntermediaryRepresentation.Values.Value {
    var folded = compute(operation.operator, left, right)
    if folded {
        folded_values = folded_values + 1
        return folded
    } else {
        return HighIntermediaryRepresentation.Values.Operation(left, operation.operator, right)
    }
}

func compute(
    operator: String,
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: HighIntermediaryRepresentation.Values.WholeNumber,
): HighIntermediaryRepresentation.Values.WholeNumber? {
    var second = right.value()
    var foldable = can_fold(operator, second)
    if foldable {
        var first = left.value()
        var answer = arithmetic(operator, first, second)
        var written = answer.to_string()
        return HighIntermediaryRepresentation.Values.WholeNumber(written)
    } else {
        return null
    }
}

func can_fold(operator: String, second: Long): Boolean {
    if second == 0 and divides(operator) {
        return false
    } else {
        return true
    }
}

func arithmetic(operator: String, first: Long, second: Long): Long {
    switch operator {
        "+": return first + second
        "-": return first - second
        "*": return first * second
        "/": return first / second
        "%": return first % second
        _: return 0
    }
}

func divides(operator: String): Boolean {
    if operator == "/" {
        return true
    }
    return operator == "%"
}

func folded_count(): Integer {
    return folded_values
}

# ../../OPTIMIZATIONS.md#thread-safety-for-singletons-the-cheapest-safe-form
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    var waits = HighIntermediaryRepresentation.Waits(high)
    crash high.assignments
    if waits.locks_any() {
        waits.find_the_shared_loops(high, high.assignments)
    }
    high.waits = waits
}

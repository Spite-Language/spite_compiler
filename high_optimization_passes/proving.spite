# ../ARCHITECTURE.md#a-stages-passes

type Proof {
    check(HighIntermediaryRepresentation.HighProgram)
}

var proof: Proof? = null

func Proving(starting_proof: Proof) {
    proof = starting_proof
}

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    crash proof
    proof.check(high)
}

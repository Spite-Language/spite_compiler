# ../../OPTIMIZATIONS.md#a-walk-over-a-list-its-setup-filled-calls-each-item-directly

var no_model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_model)
var built_keys = List<String>()
var used_names = List<String>()

func optimized(starting: HighIntermediaryRepresentation.HighProgram) {
    high = starting
    fallback not high.setup_list_walks.is_empty()
    high.built_functions.each(note_a_built_function)
    high.setup_list_walks.each(unroll)
}

func note_a_built_function(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    built_keys.append(key)
    note_the_names(function.body)
    function.function.parameters.each(note_a_parameter)
}

func note_a_parameter(parameter: Model.ParameterModel) {
    used_names.append(parameter.name)
}

func note_the_names(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(note_a_name)
}

func note_a_name(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: used_names.append(statement.name)
        HighIntermediaryRepresentation.Statements.If: note_both_branches(statement)
        HighIntermediaryRepresentation.Statements.While: note_the_names(statement.body)
        HighIntermediaryRepresentation.Statements.Block: note_the_names(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func note_both_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    note_the_names(branch.then_branch)
    note_the_names(branch.else_branch)
}

func unroll(walk: HighIntermediaryRepresentation.SetupListWalk) {
    var loop = walk.block.statements[walk.position]
    crash loop
    fallback loop.class == HighIntermediaryRepresentation.Statements.While
    var taking = loop.body.statements[0]
    var calling = loop.body.statements[1]
    var stepping = loop.body.statements[2]
    crash taking and calling and stepping
    fallback taking.class == HighIntermediaryRepresentation.Statements.Declare
    fallback calling.class == HighIntermediaryRepresentation.Statements.Evaluate
    fallback stepping.class == HighIntermediaryRepresentation.Statements.Assign.Assign
    var unrolled = HighIntermediaryRepresentation.Statements.Block()
    unrolled.line = loop.line
    var index = 0
    while index < walk.made.count() {
        var made = walk.made[index]
        var copied = copy_of(walk, taking, calling, stepping, made)
        fallback not copied.is_empty()
        copied.each(unrolled.statements.append)
        index = index + 1
    }
    walk.block.statements[walk.position] = unrolled
}

func copy_of(
    walk: HighIntermediaryRepresentation.SetupListWalk,
    taking: HighIntermediaryRepresentation.Statements.Declare,
    calling: HighIntermediaryRepresentation.Statements.Evaluate,
    stepping: HighIntermediaryRepresentation.Statements.Assign.Assign,
    made: Model.Type,
): List<SpiteCompiler.Statement> {
    var copied = List<SpiteCompiler.Statement>()
    var direct = direct_function(made, calling.value)
    fallback direct
    var name = fresh_name(walk.item_name)
    var item = item_of(taking, made, name)
    copied.append(item)
    var call = direct_call(direct, made, name, calling.value)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call, calling.line)
    copied.append(evaluated)
    var stepped = step_of(stepping)
    copied.append(stepped)
    return copied
}

func step_of(
    stepping: HighIntermediaryRepresentation.Statements.Assign.Assign,
): HighIntermediaryRepresentation.Statements.Assign.Assign {
    var added = step_value_of(stepping.value)
    return HighIntermediaryRepresentation.Statements.Assign.Assign(stepping.name, added, stepping.line)
}

func step_value_of(step: SpiteCompiler.Value?): SpiteCompiler.Value {
    crash step.class == HighIntermediaryRepresentation.Values.MachineOperation
    var read = local_copy_of(step.left)
    var one = number_copy_of(step.right)
    var added = step.copy()
    added.left = read
    added.right = one
    added.is_a_written_negative = false
    added.written_negative = ""
    return added
}

func local_copy_of(value: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.LocalRead {
    crash value.class == HighIntermediaryRepresentation.Values.LocalRead
    return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, value.name)
}

func number_copy_of(value: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.WholeNumber {
    crash value.class == HighIntermediaryRepresentation.Values.WholeNumber
    return HighIntermediaryRepresentation.Values.WholeNumber(value.value_type, value.number)
}

func direct_function(made: Model.Type, called: SpiteCompiler.Value?): Model.FunctionModel? {
    fallback called.class == HighIntermediaryRepresentation.Values.ShapeCall
    var model = high.model.class_named(made.name)
    fallback model
    var function = model.function_named(called.member.name)
    fallback function
    var key = function.key()
    var fits = built_keys.contains(key) and fits_the_member(function, called.member)
    fallback fits
    return function
}

func fits_the_member(function: Model.FunctionModel, member: Model.FunctionModel): Boolean {
    fallback function.parameters.count() == member.parameters.count()
    var fits = true
    var index = 0
    while index < function.parameters.count() {
        var own = function.parameters[index]
        var asked = member.parameters[index]
        crash own and asked
        if not own.parameter_type.is_the_same_as(asked.parameter_type) {
            fits = false
        }
        index = index + 1
    }
    var own_answer = answer_of(function)
    var asked_answer = answer_of(member)
    return fits and own_answer.is_the_same_as(asked_answer)
}

func answer_of(function: Model.FunctionModel): Model.Type {
    if function.answer {
        return function.answer
    }
    return Model.Type('nothing', "")
}

func fresh_name(name: String): String {
    var count = 1
    var fresh = "{name}_{count}"
    while used_names.contains(fresh) {
        count = count + 1
        fresh = "{name}_{count}"
    }
    used_names.append(fresh)
    return fresh
}

func item_of(
    taking: HighIntermediaryRepresentation.Statements.Declare,
    made: Model.Type,
    name: String,
): HighIntermediaryRepresentation.Statements.Declare {
    var as_class = class_item_of(taking.value, made)
    return HighIntermediaryRepresentation.Statements.Declare(name, made, as_class, taking.line, "")
}

func class_item_of(taken: SpiteCompiler.Value?, made: Model.Type): SpiteCompiler.Value {
    crash taken.class == HighIntermediaryRepresentation.Values.Conversion
    var item = item_read_of(taken.converted)
    var present = HighIntermediaryRepresentation.Values.Conversion(taken.value_type, 'proven', item)
    return HighIntermediaryRepresentation.Values.Conversion(made, 'proven', present)
}

func item_read_of(read: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.Call {
    crash read.class == HighIntermediaryRepresentation.Values.Call
    var list = list_read_of(read.receiver)
    var at = read.arguments[0]
    crash at
    var position = local_copy_of(at)
    var positions = List<SpiteCompiler.Value>()
    positions.append(position)
    var item = HighIntermediaryRepresentation.Values.Call(read.function, list, positions)
    item.value_type = read.value_type
    return item
}

func list_read_of(listed: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.AttributeRead {
    crash listed.class == HighIntermediaryRepresentation.Values.AttributeRead
    var own = this_copy_of(listed.object)
    return HighIntermediaryRepresentation.Values.AttributeRead(own, listed.attribute)
}

func this_copy_of(holder: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.ThisRead {
    crash holder
    return HighIntermediaryRepresentation.Values.ThisRead(holder.value_type)
}

func direct_call(
    function: Model.FunctionModel,
    made: Model.Type,
    name: String,
    called: SpiteCompiler.Value?,
): HighIntermediaryRepresentation.Values.Call {
    crash called.class == HighIntermediaryRepresentation.Values.ShapeCall
    var receiver = HighIntermediaryRepresentation.Values.LocalRead(made, name)
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < called.arguments.count() {
        var argument = called.arguments[index]
        var read = local_copy_of(argument)
        arguments.append(read)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(function, receiver, arguments)
}

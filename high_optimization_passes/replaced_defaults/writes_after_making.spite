var makings = List<HighIntermediaryRepresentation.Values.MakeObject>()
var written_after = List<List<String>>()
var names_read = List<String>()

# ../../OPTIMIZATIONS.md#a-default-replaced-right-after-its-making-is-never-made
func WritesAfterMaking(high: HighIntermediaryRepresentation.HighProgram) {
    high.built_functions.each(note_a_function)
}

func note_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    note_the_makings_in(function.body)
}

func note_the_makings_in(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        note_the_makings_inside(statement)
        if statement.class == HighIntermediaryRepresentation.Statements.Declare {
            note_a_making(statement, block, index)
        }
        index = index + 1
    }
}

func note_the_makings_inside(statement: SpiteCompiler.Statement) {
    if statement.class == HighIntermediaryRepresentation.Statements.If {
        note_the_makings_in(statement.then_branch)
        note_the_makings_in(statement.else_branch)
    } else if statement.class == HighIntermediaryRepresentation.Statements.While {
        note_the_makings_in(statement.body)
    } else if statement.class == HighIntermediaryRepresentation.Statements.Block {
        note_the_makings_in(statement)
    }
}

func note_a_making(
    declared: HighIntermediaryRepresentation.Statements.Declare,
    block: HighIntermediaryRepresentation.Statements.Block,
    at: Integer,
) {
    var made = declared.value
    fallback made.class == HighIntermediaryRepresentation.Values.MakeObject
    fallback not made.skips_the_defaults and made.foreign_place.is_empty()
    var written = List<String>()
    var index = at + 1
    var unread = true
    while unread and index < block.statements.count() {
        var statement = block.statements[index]
        unread = leaves_the_object_unread(statement, declared.name, written)
        index = index + 1
    }
    fallback not written.is_empty()
    makings.append(made)
    written_after.append(written)
}

func leaves_the_object_unread(statement: SpiteCompiler.Statement, name: String, written: List<String>): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute and is_the_local(statement.object, name) {
        fallback not reads_the_local(statement, name)
        note_a_write(written, statement.attribute.name)
        return true
    }
    fallback runs_straight_on(statement) and not names_the_local(statement, name)
    return not reads_the_local(statement, name)
}

func note_a_write(written: List<String>, attribute_name: String) {
    if not written.contains(attribute_name) {
        written.append(attribute_name)
    }
}

func is_the_local(object: SpiteCompiler.Value?, name: String): Boolean {
    fallback object.class == HighIntermediaryRepresentation.Values.LocalRead
    return object.name == name
}

func runs_straight_on(statement: SpiteCompiler.Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return true
        HighIntermediaryRepresentation.Statements.Evaluate: return true
        HighIntermediaryRepresentation.Statements.Assign.Assign: return true
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return true
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return true
        HighIntermediaryRepresentation.Statements.If: return false
        HighIntermediaryRepresentation.Statements.While: return false
        HighIntermediaryRepresentation.Statements.Return: return false
        HighIntermediaryRepresentation.Statements.Stop: return false
        HighIntermediaryRepresentation.Statements.Block: return false
    }
}

func names_the_local(statement: SpiteCompiler.Statement, name: String): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        return statement.name == name
    }
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign {
        return statement.name == name
    }
    return false
}

func reads_the_local(statement: SpiteCompiler.Statement, name: String): Boolean {
    names_read = List<String>()
    var reading = HighOptimizationPasses.Rewriting(this)
    if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute and is_the_local(statement.object, name) {
        statement.value = reading.rewritten_or_none(statement.value)
    } else {
        reading.rewrite_statement(statement)
    }
    return names_read.contains(name)
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        names_read.append(value.name)
    }
    return value
}

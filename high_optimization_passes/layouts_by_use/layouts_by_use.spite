union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var library = Validators.LibraryFile()

# ../../OPTIMIZATIONS.md#layouts-by-use-the-design
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    var layout = HighIntermediaryRepresentation.Layout(high.model)
    layout.lay_out_by_use(high)
    layout.plain_text_room = plain_text_room(high)
    high.layout = layout
}

# ../../OPTIMIZATIONS.md#short-text-lives-inside-its-string
func plain_text_room(high: HighIntermediaryRepresentation.HighProgram): Integer {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == "String._attribute_defaults" {
            return room_of_the_defaults(function)
        }
        index = index + 1
    }
    return -1
}

func room_of_the_defaults(function: HighIntermediaryRepresentation.HighFunction): Integer {
    var statements = function.body.statements
    if statements.count() != 2 {
        return -1
    }
    var room = -1
    var length_is_zero = false
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
            var name = statement.attribute.name
            if name == "_buffer" {
                room = buffer_room_of(statement.value)
            }
            if name == "_length" {
                length_is_zero = is_zero(statement.value)
            }
        }
        index = index + 1
    }
    if not length_is_zero {
        return -1
    }
    return room
}

func buffer_room_of(value: Value?): Integer {
    if not value {
        return -1
    }
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return room_made(value)
    }
    return -1
}

func room_made(made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    if made.value_type.name != "Buffer" or made.arguments.count() != 1 or not made.constructor {
        return -1
    }
    var constructor = made.constructor
    if constructor.key() != "Buffer.Buffer" or not constructor.declaration {
        return -1
    }
    var written = constructor.declaration.path.replace("\\", "/")
    if not library.holds(written) or not written.ends_with("/common/buffer.spite") {
        return -1
    }
    var size = made.arguments[0]
    return whole_number_of(size)
}

func whole_number_of(value: Value): Integer {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return small_number(value.number)
    }
    return -1
}

func small_number(number: Long): Integer {
    if number < 0 or number > 1000000 {
        return -1
    }
    return number
}

func is_zero(value: Value?): Boolean {
    fallback value
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number == 0
    }
    return false
}

var empty_classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var program = HighIntermediaryRepresentation.Programs.HighProgram(empty_classes, "")
var by_qualified = Dictionary<String, HighIntermediaryRepresentation.Functions.HighFunction>()
var qualified_by_name = Dictionary<String, List<String>>()
var reachable = List<String>()
var waiting = List<String>()
var kept = List<HighIntermediaryRepresentation.Functions.HighFunction>()
var classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var current_class = ""
var dropped_functions = 0
var dropped_classes = 0

func Pass(starting_program: HighIntermediaryRepresentation.Programs.HighProgram) {
    program = starting_program
}

func transformed(): HighIntermediaryRepresentation.Programs.HighProgram {
    by_qualified = Dictionary<String, HighIntermediaryRepresentation.Functions.HighFunction>()
    qualified_by_name = Dictionary<String, List<String>>()
    reachable = List<String>()
    waiting = List<String>()
    dropped_functions = 0
    dropped_classes = 0
    program.classes.each(index_class)
    start_from_the_entry()
    mark_what_reaches()
    classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
    program.classes.each(read_class)
    return HighIntermediaryRepresentation.Programs.HighProgram(classes, program.entry)
}

func index_class(own: HighIntermediaryRepresentation.Classes.HighClass) {
    current_class = own.name
    own.held_functions.each(index_function)
}

func index_function(own: HighIntermediaryRepresentation.Functions.HighFunction) {
    var qualified = "{current_class}.{own.name}"
    by_qualified[qualified] = own
    var other_names = qualified_by_name[own.name]
    if other_names {
        other_names.append(qualified)
    } else {
        var made = List<String>()
        made.append(qualified)
        qualified_by_name[own.name] = made
    }
}

func start_from_the_entry() {
    var entry_class = program.class_named(program.entry)
    if entry_class {
        mark_the_constructor(entry_class)
    } else {
        return
    }
}

func mark_the_constructor(entry_class: HighIntermediaryRepresentation.Classes.HighClass) {
    var constructor = entry_class.function_named(program.entry)
    if constructor {
        mark("{program.entry}.{program.entry}")
    } else {
        return
    }
}

func mark(qualified: String) {
    if reachable.contains(qualified) {
        return
    } else {
        reachable.append(qualified)
        waiting.append(qualified)
    }
}

func mark_what_reaches() {
    while not waiting.is_empty() {
        var qualified = waiting.first()
        if qualified {
            waiting.remove_first()
            mark_one(qualified)
        } else {
            return
        }
    }
}

func mark_one(qualified: String) {
    var function = by_qualified[qualified]
    if function {
        read_the_body_of(function)
    } else {
        return
    }
}

func read_the_body_of(function: HighIntermediaryRepresentation.Functions.HighFunction) {
    if function.body {
        read_body(function.body)
    } else {
        return
    }
}

func read_class(own: HighIntermediaryRepresentation.Classes.HighClass) {
    var outer = kept
    kept = List<HighIntermediaryRepresentation.Functions.HighFunction>()
    current_class = own.name
    own.held_functions.each(keep_function)
    var written = kept
    kept = outer
    if written.count() > 0 or own.held_attributes.count() > 0 or own.name == program.entry {
        var rebuilt = HighIntermediaryRepresentation.Classes.HighClass(
            own.name,
            written,
            own.held_attributes,
            own.block_size,
        )
        classes.append(rebuilt)
    } else {
        dropped_classes = dropped_classes + 1
    }
}

func keep_function(own: HighIntermediaryRepresentation.Functions.HighFunction) {
    var qualified = "{current_class}.{own.name}"
    if reachable.contains(qualified) {
        kept.append(own)
    } else {
        dropped_functions = dropped_functions + 1
    }
}

func read_body(block: HighIntermediaryRepresentation.Statements.Block) {
    block.statements.each(read_statement)
}

func read_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: read_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: read_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.If: read_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_while(statement)
        HighIntermediaryRepresentation.Statements.Call: read_call(statement)
        HighIntermediaryRepresentation.Statements.ForeignCall: read_foreign_call(statement)
        HighIntermediaryRepresentation.Statements.Return: read_return(statement)
    }
}

func read_declare(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    if declaration.value {
        read_value(declaration.value)
    } else {
        return
    }
}

func read_assign(assignment: HighIntermediaryRepresentation.Statements.Assign) {
    if assignment.value {
        read_value(assignment.value)
    } else {
        return
    }
}

func read_assign_attribute(assignment: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    if assignment.object {
        read_value(assignment.object)
    } else {
        return
    }
    if assignment.value {
        read_value(assignment.value)
    } else {
        return
    }
}

func read_if(branch: HighIntermediaryRepresentation.Statements.If) {
    if branch.condition {
        read_value(branch.condition)
    } else {
        return
    }
    if branch.then_branch {
        read_body(branch.then_branch)
    } else {
        return
    }
    if branch.else_branch {
        read_body(branch.else_branch)
    } else {
        return
    }
}

func read_while(loop: HighIntermediaryRepresentation.Statements.While) {
    if loop.condition {
        read_value(loop.condition)
    } else {
        return
    }
    if loop.body {
        read_body(loop.body)
    } else {
        return
    }
}

func read_call(call: HighIntermediaryRepresentation.Statements.Call) {
    mark_the_callee(call.owner, call.callee)
    call.arguments.each(read_value)
}

func read_foreign_call(statement: HighIntermediaryRepresentation.Statements.ForeignCall) {
    if statement.call {
        read_value(statement.call)
    } else {
        return
    }
}

func read_return(statement: HighIntermediaryRepresentation.Statements.Return) {
    if statement.value {
        read_value(statement.value)
    } else {
        return
    }
}

func read_value(value: HighIntermediaryRepresentation.Values.Value) {
    if value == HighIntermediaryRepresentation.Values.Operation {
        read_operation(value)
    } else if value == HighIntermediaryRepresentation.Values.Attribute {
        read_attribute(value)
    } else if value == HighIntermediaryRepresentation.Values.ForeignCall {
        read_made_foreign_call(value)
    } else {
        read_answer(value)
    }
}

func read_made_foreign_call(foreign: HighIntermediaryRepresentation.Values.ForeignCall) {
    if foreign.receiver {
        read_value(foreign.receiver)
    } else {
        return
    }
    foreign.arguments.each(read_value)
}

func read_attribute(attribute: HighIntermediaryRepresentation.Values.Attribute) {
    if attribute.object {
        read_value(attribute.object)
    } else {
        return
    }
}

func read_operation(operation: HighIntermediaryRepresentation.Values.Operation) {
    if operation.left {
        read_value(operation.left)
    } else {
        return
    }
    if operation.right {
        read_value(operation.right)
    } else {
        return
    }
}

func read_answer(value: HighIntermediaryRepresentation.Values.Value) {
    if value == HighIntermediaryRepresentation.Values.Answer {
        var answer = value
        mark_the_callee(answer.owner, answer.callee)
        answer.arguments.each(read_value)
    } else {
        return
    }
}

func mark_the_callee(owner: String, name: String) {
    if owner.is_empty() {
        mark_every_function_of(name)
    } else {
        mark_the_owned_callee(owner, name)
    }
}

func mark_the_owned_callee(owner: String, name: String) {
    var qualified = "{owner}.{name}"
    if by_qualified[qualified] {
        mark(qualified)
    } else {
        mark_every_function_of(name)
    }
}

func mark_every_function_of(name: String) {
    var other_names = qualified_by_name[name]
    if other_names {
        other_names.each(mark)
    } else {
        return
    }
}

func dropped_function_count(): Integer {
    return dropped_functions
}

func dropped_class_count(): Integer {
    return dropped_classes
}

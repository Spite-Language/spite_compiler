# ../ARCHITECTURE.md#a-high-pass-that-rewrites-and-builds-functions
var no_model = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_model)
var is_asked = false
var first_replaced = ""
var keys_built = List<String>()

func FunctionBuilding(high: HighIntermediaryRepresentation.HighProgram) {
    program = high
}

func need(function: Model.FunctionModel) {
    crash program.context
    program.context.need(function)
    is_asked = true
}

func replaced(function: Model.FunctionModel) {
    program.replaced_functions.append(function)
    if first_replaced.is_empty() {
        first_replaced = function.key()
    }
}

func build_the_needed() {
    assert is_asked
    crash program.context
    var resolver = program.context.resolver
    var builder = HighIntermediaryRepresentation.Builder(program.model, resolver)
    builder.continue_from(program)
    var built = builder.build_the_needed()
    place_beside_the_replaced(built)
    var ranges = Proofs.Ranges.Ranges()
    var index = 0
    while index < built.count() {
        var function = built[index]
        if function.is_from_the_source {
            ranges.prove(function.function, function.body, program.model)
        }
        index = index + 1
    }
}

# ../ARCHITECTURE.md#a-high-pass-that-rewrites-and-builds-functions
func place_beside_the_replaced(built: List<HighIntermediaryRepresentation.HighFunction>) {
    var place = position_of_the_replaced()
    assert place >= 0
    keys_built = List<String>()
    built.each(note_a_key)
    var placed = List<HighIntermediaryRepresentation.HighFunction>()
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        var key = function.function.key()
        if not keys_built.contains(key) {
            placed.append(function)
        }
        if index == place {
            built.each(placed.append)
        }
        index = index + 1
    }
    program.built_functions = placed
}

func note_a_key(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    keys_built.append(key)
}

func position_of_the_replaced(): Integer {
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        var key = function.function.key()
        if key == first_replaced {
            return index
        }
        index = index + 1
    }
    return -1
}

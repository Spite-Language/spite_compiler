# ../../OPTIMIZATIONS.md#a-check-of-a-narrowing-the-ranges-prove-is-not-made

var fitted = List<String>()
var unfitted = List<String>()

func names_in(built: HighIntermediaryRepresentation.HighFunction): List<String> {
    fitted = List<String>()
    unfitted = List<String>()
    read_the_block(built.body)
    var parameters = built.function.parameters
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        unfitted.append(parameter.name)
        index = index + 1
    }
    var names = List<String>()
    var name_index = 0
    while name_index < fitted.count() {
        var name = fitted[name_index]
        if not unfitted.contains(name) {
            names.append(name)
        }
        name_index = name_index + 1
    }
    return names
}

func read_the_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: note_a_value(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: note_a_value(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.If: read_the_branches(statement)
        HighIntermediaryRepresentation.Statements.While: read_the_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: read_the_block(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func read_the_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        read_the_block(current.then_branch)
        link = current.else_if()
        if not link {
            read_the_block(current.else_branch)
        }
    }
}

func note_a_value(name: String, value: SpiteCompiler.Value?) {
    if is_a_fitted_narrowing(value) {
        fitted.append(name)
    } else {
        unfitted.append(name)
    }
}

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func is_a_fitted_narrowing(value: SpiteCompiler.Value?): Boolean {
    fallback value.class == HighIntermediaryRepresentation.Values.Conversion
    fallback value.kind == 'nullable'
    var narrowed = value.converted
    fallback narrowed.class == HighIntermediaryRepresentation.Values.Conversion
    var may_not_fit = narrowed.kind == 'narrow' or narrowed.kind == 'to_whole' or narrowed.kind == 'narrow_decimal'
    return may_not_fit and narrowed.is_proven_to_fit
}

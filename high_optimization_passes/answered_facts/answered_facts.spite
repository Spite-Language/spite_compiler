union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var dropped_branches = List<HighIntermediaryRepresentation.Statements.Block>()

# ../../OPTIMIZATIONS.md#a-late-answer-keeps-only-its-taken-branch
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        keep_the_taken_branches(built.body)
        index = index + 1
    }
    var dropped_index = 0
    while dropped_index < dropped_branches.count() {
        var branch = dropped_branches[dropped_index]
        offer_what_it_called(high, branch)
        dropped_index = dropped_index + 1
    }
}

func offer_what_it_called(
    high: HighIntermediaryRepresentation.HighProgram,
    branch: HighIntermediaryRepresentation.Statements.Block,
) {
    var no_function = Model.FunctionModel("", "")
    var wrapped = HighIntermediaryRepresentation.HighFunction(no_function, branch)
    var references = HighOptimizationPasses.UnreachedFunctions.References()
    var keys = references.of(wrapped)
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        if keys.contains(key) {
            high.replaced_functions.append(built.function)
        }
        index = index + 1
    }
}

func keep_the_taken_branches(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var replaced = kept(block.statements[index])
        block.statements[index] = replaced
        index = index + 1
    }
}

func kept(statement: Statement): Statement {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: return kept_if(statement)
        HighIntermediaryRepresentation.Statements.While: return kept_while(statement)
        HighIntermediaryRepresentation.Statements.Block: return kept_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return statement
        HighIntermediaryRepresentation.Statements.Assign.Assign: return statement
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return statement
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return statement
        HighIntermediaryRepresentation.Statements.Evaluate: return statement
        HighIntermediaryRepresentation.Statements.Return: return statement
        HighIntermediaryRepresentation.Statements.Stop: return statement
    }
}

func kept_block(block: HighIntermediaryRepresentation.Statements.Block): Statement {
    keep_the_taken_branches(block)
    return block
}

func kept_while(loop: HighIntermediaryRepresentation.Statements.While): Statement {
    keep_the_taken_branches(loop.body)
    return loop
}

func kept_if(made: HighIntermediaryRepresentation.Statements.If): Statement {
    keep_the_taken_branches(made.then_branch)
    keep_the_taken_branches(made.else_branch)
    var answer = answer_of(made.condition)
    if answer == 1 {
        note_a_dropped(made.else_branch)
        return made.then_branch
    }
    if answer == 0 {
        dropped_branches.append(made.then_branch)
        return taken_else(made)
    }
    return made
}

func note_a_dropped(branch: HighIntermediaryRepresentation.Statements.Block?) {
    fallback branch
    dropped_branches.append(branch)
}

func taken_else(made: HighIntermediaryRepresentation.Statements.If): Statement {
    if made.else_branch {
        return made.else_branch
    }
    var nothing = HighIntermediaryRepresentation.Statements.Block()
    nothing.line = made.line
    return nothing
}

func answer_of(condition: Value?): Integer {
    if not condition {
        return -1
    }
    if condition.class == HighIntermediaryRepresentation.Values.Negation {
        var inner = answer_of(condition.negated)
        if inner < 0 {
            return inner
        }
        return 1 - inner
    }
    if condition.class == HighIntermediaryRepresentation.Values.Function.Fact and condition.is_answered {
        if condition.answer {
            return 1
        }
        return 0
    }
    return -1
}

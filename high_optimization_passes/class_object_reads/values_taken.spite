# ../../PROOFS.md#what-a-class-object-holds-is-known-while-compiling

var keys = List<String>()
var calls_a_value = false

func of(built: HighIntermediaryRepresentation.HighFunction): List<String> {
    keys = List<String>()
    calls_a_value = false
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(built.body)
    return keys
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        var key = value.function.key()
        keys.append(key)
    }
    if value.class == HighIntermediaryRepresentation.Values.Function.ValueCall {
        calls_a_value = true
    }
    return value
}

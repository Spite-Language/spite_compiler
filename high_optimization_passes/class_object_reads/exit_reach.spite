# ../../PROOFS.md#what-a-class-object-holds-is-known-while-compiling

var by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var by_name = Dictionary<String, List<String>>()
var taken_as_values = List<String>()
var reached = Dictionary<String, Boolean>()
var waiting = List<String>()
var calls_a_value = false

# ../../PROOFS.md#what-a-class-object-holds-is-known-while-compiling
func of(high: HighIntermediaryRepresentation.HighProgram): Dictionary<String, Boolean> {
    high.built_functions.each(note_a_function)
    high.built_functions.each(note_the_values_taken)
    high.built_functions.each(start_from_a_drop)
    while not waiting.is_empty() {
        var key = waiting.remove_first()
        crash key
        follow(key)
    }
    return reached
}

func note_a_function(built: HighIntermediaryRepresentation.HighFunction) {
    var key = built.function.key()
    by_key[key] = built
    var named = by_name[built.function.name]
    if named {
        named.append(key)
    } else {
        var first = List<String>()
        first.append(key)
        by_name[built.function.name] = first
    }
}

func note_the_values_taken(built: HighIntermediaryRepresentation.HighFunction) {
    var taking = HighOptimizationPasses.ClassObjectReads.ValuesTaken()
    var keys = taking.of(built)
    keys.each(note_a_value_taken)
}

func note_a_value_taken(key: String) {
    if not taken_as_values.contains(key) {
        taken_as_values.append(key)
    }
}

func start_from_a_drop(built: HighIntermediaryRepresentation.HighFunction) {
    if built.function.name == "drop" {
        var key = built.function.key()
        reach(key)
    }
}

func reach(key: String) {
    fallback not reached.contains(key)
    reached[key] = true
    waiting.append(key)
}

func follow(key: String) {
    var built = by_key[key]
    fallback built
    var references = HighOptimizationPasses.References()
    var keys = references.of(built)
    keys.each(reach_a_reference)
    var taking = HighOptimizationPasses.ClassObjectReads.ValuesTaken()
    var taken = taking.of(built)
    taken.each(note_a_value_taken)
    if taking.calls_a_value and not calls_a_value {
        calls_a_value = true
        taken_as_values.each(reach)
    }
}

func reach_a_reference(key: String) {
    var shape_prefix = "shape "
    if key.starts_with(shape_prefix) {
        var prefix_length = shape_prefix.length()
        var key_length = key.length()
        var name = key.slice(prefix_length, key_length)
        crash name
        var named = by_name[name]
        if named {
            named.each(reach)
        }
        return
    }
    reach(key)
}

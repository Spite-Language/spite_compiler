# ../../OPTIMIZATIONS.md#a-text-literal-is-made-once-in-the-programs-data

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var flags = high.context.build_flags
    if is_inspected(flags) {
        note_an_inspected_build(high)
        return
    }
    var is_built = high.will_be_lowered()
    fallback is_built or flags.contains("optimization_report")
    var written = WrittenTexts(high)
    var holds = written.study()
    fallback holds
    if is_built {
        var searches = SplitSearches(high, written)
        searches.rewrite()
        var joins = ComparedJoins(high)
        joins.rewrite()
    }
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        rewriting.rewrite_block(function.body)
        index = index + 1
    }
}

func is_inspected(flags: Dictionary<String, String>): Boolean {
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func note_an_inspected_build(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.entry
    fallback high.entry.declaration
    high.fresh_literal_paths.append(high.entry.declaration.path)
    high.fresh_literal_lines.append(high.entry.declaration.line)
    high.fresh_literal_texts.append(
        "every text literal is made on each evaluation: a `--development`, `--repl` or `--hot-reload` build may run code written later, which may write any text",
    )
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        value.lives_in_data = not value.stays_fresh
    }
    return value
}

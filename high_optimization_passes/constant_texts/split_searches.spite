# ../../OPTIMIZATIONS.md#a-text-split-only-to-search-it-is-scanned-in-place

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var written = WrittenTexts(program)
var uses = HighIntermediaryRepresentation.Ownership.Uses()
var library = Mapping.LibraryFile()
var no_function = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var no_body = HighIntermediaryRepresentation.Statements.Block(0)
var walked = HighIntermediaryRepresentation.HighFunction(no_function, no_body)
var searching: Model.FunctionModel? = null
var pieces_name = ""
var source: SpiteCompiler.Value? = null
var separator: SpiteCompiler.Value? = null
var searches_counted = 0
var is_counting = false

func SplitSearches(high: HighIntermediaryRepresentation.HighProgram, starting_written: WrittenTexts) {
    program = high
    written = starting_written
    crash high.context
    context = high.context
}

func rewrite() {
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var built = program.built_functions.copy()
    var index = 0
    while index < built.count() {
        var function = built[index]
        walked = function
        rewrite_the_kept_splits(function.body)
        rewriting.rewrite_block(function.body)
        index = index + 1
    }
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Call and is_a_search(value) {
        return search_of(value)
    }
    return value
}

func search_of(call: HighIntermediaryRepresentation.Values.Call): SpiteCompiler.Value {
    crash call.receiver
    var names_the_pieces = not pieces_name.is_empty() and uses.is_the_local(call.receiver, pieces_name)
    if is_counting {
        if names_the_pieces {
            searches_counted = searches_counted + 1
        }
        return call
    }
    if names_the_pieces {
        crash source
        crash separator
        var kept_source = same_value(source)
        var kept_separator = same_value(separator)
        return searched(call, kept_source, kept_separator)
    }
    if call.receiver.class == HighIntermediaryRepresentation.Values.Call and is_a_split(call.receiver) {
        var split_separator = call.receiver.arguments[0]
        crash call.receiver.receiver
        crash split_separator
        return searched(call, call.receiver.receiver, split_separator)
    }
    return call
}

func is_the_librarys(function: Model.FunctionModel, owner_namespace: String, name: String): Boolean {
    fallback function.name == name and function.declaration
    var owner = context.program.class_named(function.owner)
    fallback owner and owner.file.namespace == owner_namespace
    return library.holds(function.declaration.path) and library.holds(owner.file.path)
}

func is_a_split(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.receiver and call.arguments.count() == 1
    return is_the_librarys(call.function, "String", "split")
}

func is_a_search(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.receiver and call.arguments.count() == 1
    var element = call.function.owner
    fallback element == "List<String>"
    return is_the_librarys(call.function, "List", "contains")
}

func searched(
    call: HighIntermediaryRepresentation.Values.Call,
    text: SpiteCompiler.Value,
    separator_value: SpiteCompiler.Value,
): SpiteCompiler.Value {
    var piece = call.arguments[0]
    crash piece
    crash call.receiver
    var splitting = split_of(call.receiver)
    var holding = holds_piece_of(splitting, call.function)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(separator_value)
    arguments.append(piece)
    return HighIntermediaryRepresentation.Values.Call(holding, text, arguments, "", "")
}

func split_of(receiver: SpiteCompiler.Value): Model.FunctionModel {
    if receiver.class == HighIntermediaryRepresentation.Values.Call {
        return receiver.function
    }
    var text_model = context.program.class_named("String")
    crash text_model
    var split = text_model.function_named("split")
    crash split
    return split
}

func rewrite_the_kept_splits(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        rewrite_the_inner_splits(statement)
        if statement.class == HighIntermediaryRepresentation.Statements.Declare and is_a_kept_split(block.statements, index, statement) {
            drop_the_split(block, index, statement)
        }
        index = index + 1
    }
}

func rewrite_the_inner_splits(statement: SpiteCompiler.Statement) {
    if statement.class == HighIntermediaryRepresentation.Statements.If {
        rewrite_the_kept_splits(statement.then_branch)
        rewrite_the_kept_splits(statement.else_branch)
    }
    if statement.class == HighIntermediaryRepresentation.Statements.While {
        rewrite_the_kept_splits(statement.body)
    }
    if statement.class == HighIntermediaryRepresentation.Statements.Block {
        rewrite_the_kept_splits(statement)
    }
}

func is_a_kept_split(
    statements: List<SpiteCompiler.Statement>,
    at: Integer,
    declared: HighIntermediaryRepresentation.Statements.Declare,
): Boolean {
    fallback declared.value and declared.value.class == HighIntermediaryRepresentation.Values.Call
    fallback is_a_split(declared.value)
    var separator_value = declared.value.arguments[0]
    crash declared.value.receiver
    crash separator_value
    fallback stays_the_same(declared.value.receiver) and stays_the_same(separator_value)
    source = declared.value.receiver
    separator = separator_value
    var reads = uses.in_statements_from(statements, at + 1, declared.name)
    fallback reads > 0
    pieces_name = declared.name
    is_counting = true
    searches_counted = 0
    var counting = HighOptimizationPasses.Rewriting(this)
    var index = at + 1
    while index < statements.count() {
        var statement = statements[index]
        counting.rewrite_statement(statement)
        index = index + 1
    }
    is_counting = false
    pieces_name = ""
    return searches_counted == reads
}

func same_value(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, value.name)
    }
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return HighIntermediaryRepresentation.Values.TextConstant(value.text, value.value_type, value.is_written)
    }
    if value.class == HighIntermediaryRepresentation.Values.ThisRead {
        return HighIntermediaryRepresentation.Values.ThisRead(value.value_type)
    }
    return value
}

func stays_the_same(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return true
    }
    if value.class == HighIntermediaryRepresentation.Values.ThisRead {
        return not written.writes_in(walked, "this")
    }
    fallback value.class == HighIntermediaryRepresentation.Values.LocalRead
    var assigned = List<String>()
    gather_the_assigned(walked.body, assigned)
    fallback not assigned.contains(value.name)
    return not written.writes_in(walked, value.name)
}

func gather_the_assigned(block: HighIntermediaryRepresentation.Statements.Block?, assigned: List<String>) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign {
            assigned.append(statement.name)
        }
        if statement.class == HighIntermediaryRepresentation.Statements.If {
            gather_the_assigned(statement.then_branch, assigned)
            gather_the_assigned(statement.else_branch, assigned)
        }
        if statement.class == HighIntermediaryRepresentation.Statements.While {
            gather_the_assigned(statement.body, assigned)
        }
        if statement.class == HighIntermediaryRepresentation.Statements.Block {
            gather_the_assigned(statement, assigned)
        }
        index = index + 1
    }
}

func drop_the_split(
    block: HighIntermediaryRepresentation.Statements.Block,
    at: Integer,
    declared: HighIntermediaryRepresentation.Statements.Declare,
) {
    pieces_name = declared.name
    var rewriting = HighOptimizationPasses.Rewriting(this)
    var kept = List<SpiteCompiler.Statement>()
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if index > at {
            rewriting.rewrite_statement(statement)
        }
        if index != at {
            kept.append(statement)
        }
        index = index + 1
    }
    block.statements = kept
    pieces_name = ""
    source = null
    separator = null
}

func holds_piece_of(splitting: Model.FunctionModel, containing: Model.FunctionModel): Model.FunctionModel {
    if searching {
        return searching
    }
    var text_model = context.program.class_named("String")
    crash text_model
    var text_type = text_model.type_of_an_instance()
    var boolean = context.boolean()
    var made = Model.FunctionModel(
        "_holds_piece",
        text_model.key,
        boolean,
        null,
        null,
        null,
        null,
        null,
        true,
        false,
        false,
        false,
    )
    var separator_parameter = Model.ParameterModel("separator", text_type, false)
    made.parameters.append(separator_parameter)
    var piece_parameter = Model.ParameterModel("piece", text_type, false)
    made.parameters.append(piece_parameter)
    text_model.declared_functions.append(made)
    var forms = ScanForms(context, text_model)
    var body = forms.holds_piece_body(splitting, containing)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    program.built_functions.append(function)
    searching = made
    return made
}

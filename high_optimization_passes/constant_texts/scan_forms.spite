# ../../OPTIMIZATIONS.md#a-text-split-only-to-search-it-is-scanned-in-place

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var text_model = Model.ClassModel("", "", no_file, false)
var text_type = Model.Type('object', "String")
var integer = Model.Type('scalar', "Integer")
var boolean = Model.Type('scalar', "Boolean")

func ScanForms(
    starting_context: HighIntermediaryRepresentation.Building.Context,
    starting_text_model: Model.ClassModel,
) {
    context = starting_context
    text_model = starting_text_model
    text_type = starting_text_model.type_of_an_instance()
    integer = starting_context.scalar_type("Integer")
    boolean = starting_context.boolean()
}

func next_separator(start: SpiteCompiler.Value): SpiteCompiler.Value {
    var arguments = List<SpiteCompiler.Value>()
    var separator = local("separator", text_type)
    arguments.append(separator)
    arguments.append(start)
    var receiver = own()
    return call("_found_at", receiver, arguments)
}

func holds_piece_body(
    splitting: Model.FunctionModel,
    containing: Model.FunctionModel,
): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var empty_case = empty_separator_case(splitting, containing)
    body.statements.append(empty_case)
    var zero = number(0)
    var start_declared = HighIntermediaryRepresentation.Statements.Declare("start", integer, zero, 0, "")
    body.statements.append(start_declared)
    var first_zero = number(0)
    var first_found = next_separator(first_zero)
    var found_declared = HighIntermediaryRepresentation.Statements.Declare("found", integer, first_found, 0, "")
    body.statements.append(found_declared)
    var scanning = scan_loop()
    body.statements.append(scanning)
    var last_start = local("start", integer)
    var last_case = last_piece_case(last_start)
    body.statements.append(last_case)
    var no = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 0, false)
    var answered_no = HighIntermediaryRepresentation.Statements.Return(no, 0)
    body.statements.append(answered_no)
    return body
}

func number(value: Long): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, value, false)
}

func local(name: String, local_type: Model.Type): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.LocalRead(local_type, name)
}

func operation(
    answer: Model.Type,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: SpiteCompiler.Value,
    right: SpiteCompiler.Value,
): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.MachineOperation(answer, operator, left, right, null)
}

func length_of(text: SpiteCompiler.Value): SpiteCompiler.Value {
    var length = text_model.attribute_named("_length")
    crash length
    return HighIntermediaryRepresentation.Values.AttributeRead(text, length)
}

func own(): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.ThisRead(text_type)
}

func call(name: String, receiver: SpiteCompiler.Value, arguments: List<SpiteCompiler.Value>): SpiteCompiler.Value {
    var function = text_model.function_named(name)
    crash function
    return HighIntermediaryRepresentation.Values.Call(function, receiver, arguments, "", "")
}

func matches_at(start: SpiteCompiler.Value): SpiteCompiler.Value {
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(start)
    var piece = local("piece", text_type)
    arguments.append(piece)
    var receiver = own()
    return call("_matches_at", receiver, arguments)
}

func piece_fits(end: SpiteCompiler.Value, start: SpiteCompiler.Value): SpiteCompiler.Value {
    var piece = local("piece", text_type)
    var piece_length = length_of(piece)
    var between = operation(integer, 'subtract', end, start)
    return operation(boolean, 'equal', between, piece_length)
}

func empty_separator_case(splitting: Model.FunctionModel, containing: Model.FunctionModel): SpiteCompiler.Statement {
    var separator = local("separator", text_type)
    var separator_length = length_of(separator)
    var zero = number(0)
    var is_empty = operation(boolean, 'equal', separator_length, zero)
    var split_arguments = List<SpiteCompiler.Value>()
    var split_separator = local("separator", text_type)
    split_arguments.append(split_separator)
    var receiver = own()
    var pieces = HighIntermediaryRepresentation.Values.Call(splitting, receiver, split_arguments, "", "")
    var searched_arguments = List<SpiteCompiler.Value>()
    var piece = local("piece", text_type)
    searched_arguments.append(piece)
    var searched = HighIntermediaryRepresentation.Values.Call(containing, pieces, searched_arguments, "", "")
    var answered = HighIntermediaryRepresentation.Statements.Return(searched, 0)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_empty, then_branch, null, 0, "")
}

func scan_loop(): SpiteCompiler.Statement {
    var found = local("found", integer)
    var zero = number(0)
    var more = operation(boolean, 'greater_or_equal', found, zero)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var piece_end = local("found", integer)
    var piece_start = local("start", integer)
    var fits = piece_fits(piece_end, piece_start)
    var matched_start = local("start", integer)
    var matched = matches_at(matched_start)
    var yes = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1, false)
    var answered_yes = HighIntermediaryRepresentation.Statements.Return(yes, 0)
    var on_a_match = HighIntermediaryRepresentation.Statements.Block(0)
    on_a_match.statements.append(answered_yes)
    var matching = HighIntermediaryRepresentation.Statements.If(matched, on_a_match, null, 0, "")
    var on_a_fit = HighIntermediaryRepresentation.Statements.Block(0)
    on_a_fit.statements.append(matching)
    var fitting = HighIntermediaryRepresentation.Statements.If(fits, on_a_fit, null, 0, "")
    body.statements.append(fitting)
    var separator = local("separator", text_type)
    var separator_length = length_of(separator)
    var found_before = local("found", integer)
    var next_start = operation(integer, 'add', found_before, separator_length)
    var moved = HighIntermediaryRepresentation.Statements.Assign.Assign("start", next_start, 0)
    body.statements.append(moved)
    var from = local("start", integer)
    var next_found = next_separator(from)
    var looked = HighIntermediaryRepresentation.Statements.Assign.Assign("found", next_found, 0)
    body.statements.append(looked)
    return HighIntermediaryRepresentation.Statements.While(more, body, 0)
}

func last_piece_case(start: SpiteCompiler.Value): SpiteCompiler.Statement {
    var receiver = own()
    var end = length_of(receiver)
    var fits = piece_fits(end, start)
    var matched_start = local("start", integer)
    var matched = matches_at(matched_start)
    var answered = HighIntermediaryRepresentation.Statements.Return(matched, 0)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(fits, then_branch, null, 0, "")
}

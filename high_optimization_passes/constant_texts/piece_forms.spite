# ../../OPTIMIZATIONS.md#an-interpolation-only-compared-is-compared-in-place

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var text_model = Model.ClassModel("", "", no_file, false)
var forms = ScanForms(context, text_model)
var text_type = Model.Type('object', "String")
var integer = Model.Type('scalar', "Integer")
var long_type = Model.Type('scalar', "Long")
var boolean = Model.Type('scalar', "Boolean")
var whole_kind = "w"
var _minus_code = 45
var _zero_code = 48
var _ten = 10

func PieceForms(high: HighIntermediaryRepresentation.HighProgram, starting_text_model: Model.ClassModel) {
    program = high
    crash high.context
    context = high.context
    text_model = starting_text_model
    forms = ScanForms(high.context, starting_text_model)
    text_type = starting_text_model.type_of_an_instance()
    integer = high.context.scalar_type("Integer")
    long_type = high.context.scalar_type("Long")
    boolean = high.context.boolean()
}

func compared_of(operation: String, shape: String): Model.FunctionModel {
    var name = "_{operation}_pieces_{shape}"
    var known = text_model.function_named(name)
    if known {
        return known
    }
    var ending = end_of(shape)
    var made = made_function(name, boolean)
    if operation == "holds" {
        add_parameter(made, "separator", text_type)
    }
    add_the_pieces(made, shape)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    if operation == "equals" {
        body = equals_body(ending, shape)
    }
    if operation == "starts_with" {
        body = starts_with_body(ending, shape)
    }
    if operation == "contains" {
        body = contains_body(ending, shape)
    }
    if operation == "holds" {
        body = holds_body(ending, shape)
    }
    built(made, body)
    return made
}

func made_function(name: String, answer: Model.Type): Model.FunctionModel {
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        text_model.key,
        answer,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    text_model.declared_functions.append(made)
    return made
}

func add_parameter(function: Model.FunctionModel, name: String, parameter_type: Model.Type) {
    var parameter = Model.ParameterModel(name, parameter_type, false)
    function.parameters.append(parameter)
}

func add_the_pieces(function: Model.FunctionModel, shape: String) {
    var index = 0
    while index < shape.length() {
        var name = piece_name(index)
        var piece_type = piece_type_of(shape, index)
        add_parameter(function, name, piece_type)
        index = index + 1
    }
}

func built(function: Model.FunctionModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var high_function = HighIntermediaryRepresentation.HighFunction(function, body)
    program.built_functions.append(high_function)
}

func piece_name(index: Integer): String {
    return "piece_{index}"
}

func piece_type_of(shape: String, index: Integer): Model.Type {
    var kind = shape.slice(index, index + 1)
    if kind == whole_kind {
        return long_type
    }
    return text_type
}

func end_at(ending: Model.FunctionModel, shape: String, start: SpiteCompiler.Value): SpiteCompiler.Value {
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(start)
    var index = 0
    while index < shape.length() {
        var name = piece_name(index)
        var piece_type = piece_type_of(shape, index)
        var piece = forms.local(name, piece_type)
        arguments.append(piece)
        index = index + 1
    }
    var receiver = forms.own()
    return HighIntermediaryRepresentation.Values.Call(ending, receiver, arguments, "", "")
}

func answered(value: SpiteCompiler.Value): SpiteCompiler.Statement {
    return HighIntermediaryRepresentation.Statements.Return(value, 0)
}

func answered_number(number: Long): SpiteCompiler.Statement {
    var value = forms.number(number)
    return answered(value)
}

func answered_truth(truth: Long): SpiteCompiler.Statement {
    var value = HighIntermediaryRepresentation.Values.WholeNumber(boolean, truth, false)
    return answered(value)
}

func answering_if(condition: SpiteCompiler.Value, statement: SpiteCompiler.Statement): SpiteCompiler.Statement {
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(statement)
    return HighIntermediaryRepresentation.Statements.If(condition, then_branch, null, 0, "")
}

func declared(name: String, declared_type: Model.Type, value: SpiteCompiler.Value): SpiteCompiler.Statement {
    return HighIntermediaryRepresentation.Statements.Declare(name, declared_type, value, 0, "")
}

func assigned(name: String, value: SpiteCompiler.Value): SpiteCompiler.Statement {
    return HighIntermediaryRepresentation.Statements.Assign.Assign(name, value, 0)
}

func own_length(): SpiteCompiler.Value {
    var receiver = forms.own()
    return forms.length_of(receiver)
}

func equals_body(ending: Model.FunctionModel, shape: String): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var zero = forms.number(0)
    var end = end_at(ending, shape, zero)
    var length = own_length()
    var same = forms.operation(boolean, 'equal', end, length)
    var answer = answered(same)
    body.statements.append(answer)
    return body
}

func starts_with_body(ending: Model.FunctionModel, shape: String): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var zero = forms.number(0)
    var end = end_at(ending, shape, zero)
    var least_end = forms.number(0)
    var matched = forms.operation(boolean, 'greater_or_equal', end, least_end)
    var answer = answered(matched)
    body.statements.append(answer)
    return body
}

func contains_body(ending: Model.FunctionModel, shape: String): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var zero = forms.number(0)
    var start_declared = declared("start", integer, zero)
    body.statements.append(start_declared)
    var start = forms.local("start", integer)
    var length = own_length()
    var more = forms.operation(boolean, 'less_or_equal', start, length)
    var loop_body = HighIntermediaryRepresentation.Statements.Block(0)
    var from = forms.local("start", integer)
    var end = end_at(ending, shape, from)
    var least_end = forms.number(0)
    var matched = forms.operation(boolean, 'greater_or_equal', end, least_end)
    var yes = answered_truth(1)
    var matching = answering_if(matched, yes)
    loop_body.statements.append(matching)
    var moved = next_start()
    loop_body.statements.append(moved)
    var scanning = HighIntermediaryRepresentation.Statements.While(more, loop_body, 0)
    body.statements.append(scanning)
    var no = answered_truth(0)
    body.statements.append(no)
    return body
}

func next_start(): SpiteCompiler.Statement {
    var start = forms.local("start", integer)
    var one = forms.number(1)
    var after = forms.operation(integer, 'add', start, one)
    return assigned("start", after)
}

func holds_body(ending: Model.FunctionModel, shape: String): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var characters = characters_case(ending, shape)
    body.statements.append(characters)
    var zero = forms.number(0)
    var start_declared = declared("start", integer, zero)
    body.statements.append(start_declared)
    var first_zero = forms.number(0)
    var first_found = forms.next_separator(first_zero)
    var found_declared = declared("found", integer, first_found)
    body.statements.append(found_declared)
    var found = forms.local("found", integer)
    var least_end = forms.number(0)
    var more = forms.operation(boolean, 'greater_or_equal', found, least_end)
    var loop_body = HighIntermediaryRepresentation.Statements.Block(0)
    var piece_start = forms.local("start", integer)
    var end = end_at(ending, shape, piece_start)
    var piece_end = forms.local("found", integer)
    var fits = forms.operation(boolean, 'equal', end, piece_end)
    var yes = answered_truth(1)
    var fitting = answering_if(fits, yes)
    loop_body.statements.append(fitting)
    var separator = forms.local("separator", text_type)
    var separator_length = forms.length_of(separator)
    var found_before = forms.local("found", integer)
    var next = forms.operation(integer, 'add', found_before, separator_length)
    var moved = assigned("start", next)
    loop_body.statements.append(moved)
    var from = forms.local("start", integer)
    var next_found = forms.next_separator(from)
    var looked = assigned("found", next_found)
    loop_body.statements.append(looked)
    var scanning = HighIntermediaryRepresentation.Statements.While(more, loop_body, 0)
    body.statements.append(scanning)
    var last_start = forms.local("start", integer)
    var last_end = end_at(ending, shape, last_start)
    var length = own_length()
    var last_fits = forms.operation(boolean, 'equal', last_end, length)
    var last = answered(last_fits)
    body.statements.append(last)
    return body
}

func characters_case(ending: Model.FunctionModel, shape: String): SpiteCompiler.Statement {
    var separator = forms.local("separator", text_type)
    var separator_length = forms.length_of(separator)
    var zero = forms.number(0)
    var is_empty = forms.operation(boolean, 'equal', separator_length, zero)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var first = forms.number(0)
    var start_declared = declared("start", integer, first)
    then_branch.statements.append(start_declared)
    var start = forms.local("start", integer)
    var length = own_length()
    var more = forms.operation(boolean, 'less', start, length)
    var loop_body = HighIntermediaryRepresentation.Statements.Block(0)
    var from = forms.local("start", integer)
    var end = end_at(ending, shape, from)
    var one_start = forms.local("start", integer)
    var one = forms.number(1)
    var character_end = forms.operation(integer, 'add', one_start, one)
    var is_one_character = forms.operation(boolean, 'equal', end, character_end)
    var yes = answered_truth(1)
    var matching = answering_if(is_one_character, yes)
    loop_body.statements.append(matching)
    var moved = next_start()
    loop_body.statements.append(moved)
    var scanning = HighIntermediaryRepresentation.Statements.While(more, loop_body, 0)
    then_branch.statements.append(scanning)
    var no = answered_truth(0)
    then_branch.statements.append(no)
    return HighIntermediaryRepresentation.Statements.If(is_empty, then_branch, null, 0, "")
}

func end_of(shape: String): Model.FunctionModel {
    var name = "_pieces_end_at_{shape}"
    var known = text_model.function_named(name)
    if known {
        return known
    }
    var made = made_function(name, integer)
    add_parameter(made, "start", integer)
    add_the_pieces(made, shape)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var start = forms.local("start", integer)
    var at_declared = declared("at", integer, start)
    body.statements.append(at_declared)
    var index = 0
    while index < shape.length() {
        var kind = shape.slice(index, index + 1)
        if kind == whole_kind {
            add_a_whole_piece(body, index)
        } else {
            add_a_text_piece(body, index)
        }
        index = index + 1
    }
    var at = forms.local("at", integer)
    var answer = answered(at)
    body.statements.append(answer)
    built(made, body)
    return made
}

func add_a_text_piece(body: HighIntermediaryRepresentation.Statements.Block, index: Integer) {
    var name = piece_name(index)
    var at = forms.local("at", integer)
    var piece = forms.local(name, text_type)
    var piece_length = forms.length_of(piece)
    var piece_end = forms.operation(integer, 'add', at, piece_length)
    var length = own_length()
    var too_long = forms.operation(boolean, 'greater', piece_end, length)
    var missed = answered_number(-1)
    var fitting = answering_if(too_long, missed)
    body.statements.append(fitting)
    var arguments = List<SpiteCompiler.Value>()
    var from = forms.local("at", integer)
    arguments.append(from)
    var compared = forms.local(name, text_type)
    arguments.append(compared)
    var receiver = forms.own()
    var matched = forms.call("_matches_at", receiver, arguments)
    var no = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 0, false)
    var differs = forms.operation(boolean, 'equal', matched, no)
    var differed = answered_number(-1)
    var matching = answering_if(differs, differed)
    body.statements.append(matching)
    var after_at = forms.local("at", integer)
    var after_piece = forms.local(name, text_type)
    var after_length = forms.length_of(after_piece)
    var after = forms.operation(integer, 'add', after_at, after_length)
    var moved = assigned("at", after)
    body.statements.append(moved)
}

func add_a_whole_piece(body: HighIntermediaryRepresentation.Statements.Block, index: Integer) {
    var ending = whole_end()
    var arguments = List<SpiteCompiler.Value>()
    var from = forms.local("at", integer)
    arguments.append(from)
    var name = piece_name(index)
    var piece = forms.local(name, long_type)
    arguments.append(piece)
    var receiver = forms.own()
    var end = HighIntermediaryRepresentation.Values.Call(ending, receiver, arguments, "", "")
    var moved = assigned("at", end)
    body.statements.append(moved)
    var at = forms.local("at", integer)
    var zero = forms.number(0)
    var missed = forms.operation(boolean, 'less', at, zero)
    var answer = answered_number(-1)
    var testing = answering_if(missed, answer)
    body.statements.append(testing)
}

func long_number(number: Long): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.WholeNumber(long_type, number, false)
}

func code_at(position: SpiteCompiler.Value): SpiteCompiler.Value {
    var room = text_model.attribute_named("_buffer")
    crash room
    var receiver = forms.own()
    var buffer = HighIntermediaryRepresentation.Values.AttributeRead(receiver, room)
    var buffer_model = context.class_of(room.attribute_type)
    var reading = buffer_model.function_named("_read_byte_at")
    crash reading
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(position)
    var read = HighIntermediaryRepresentation.Values.Call(reading, buffer, arguments, "", "")
    return HighIntermediaryRepresentation.Values.Conversion(long_type, 'widen', read, "")
}

# ../../OPTIMIZATIONS.md#a-number-joined-into-text-is-written-in-place
func whole_end(): Model.FunctionModel {
    var name = "_whole_ends_at"
    var known = text_model.function_named(name)
    if known {
        return known
    }
    var made = made_function(name, integer)
    add_parameter(made, "start", integer)
    add_parameter(made, "value", long_type)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var one = forms.number(1)
    var digits_declared = declared("digits", integer, one)
    body.statements.append(digits_declared)
    var value = forms.local("value", long_type)
    var ten = long_number(_ten)
    var first_left = forms.operation(long_type, 'divide', value, ten)
    var left_declared = declared("left", long_type, first_left)
    body.statements.append(left_declared)
    var counting = digit_count_loop()
    body.statements.append(counting)
    var start = forms.local("start", integer)
    var at_declared = declared("at", integer, start)
    body.statements.append(at_declared)
    var sign = sign_case()
    body.statements.append(sign)
    var at = forms.local("at", integer)
    var digits = forms.local("digits", integer)
    var end_value = forms.operation(integer, 'add', at, digits)
    var end_declared = declared("end", integer, end_value)
    body.statements.append(end_declared)
    var end = forms.local("end", integer)
    var length = own_length()
    var too_long = forms.operation(boolean, 'greater', end, length)
    var missed = answered_number(-1)
    var fitting = answering_if(too_long, missed)
    body.statements.append(fitting)
    var last = forms.local("end", integer)
    var first_one = forms.number(1)
    var last_position = forms.operation(integer, 'subtract', last, first_one)
    var position_declared = declared("position", integer, last_position)
    body.statements.append(position_declared)
    var whole = forms.local("value", long_type)
    var restarted = assigned("left", whole)
    body.statements.append(restarted)
    var no_remainder = long_number(0)
    var remainder_declared = declared("remainder", long_type, no_remainder)
    body.statements.append(remainder_declared)
    var comparing = digit_compare_loop()
    body.statements.append(comparing)
    var answer_end = forms.local("end", integer)
    var answer = answered(answer_end)
    body.statements.append(answer)
    built(made, body)
    return made
}

func digit_count_loop(): SpiteCompiler.Statement {
    var left = forms.local("left", long_type)
    var zero = long_number(0)
    var more = forms.operation(boolean, 'not_equal', left, zero)
    var loop_body = HighIntermediaryRepresentation.Statements.Block(0)
    var digits = forms.local("digits", integer)
    var one = forms.number(1)
    var counted = forms.operation(integer, 'add', digits, one)
    var counting = assigned("digits", counted)
    loop_body.statements.append(counting)
    var shrunk = shrunk_left()
    loop_body.statements.append(shrunk)
    return HighIntermediaryRepresentation.Statements.While(more, loop_body, 0)
}

func shrunk_left(): SpiteCompiler.Statement {
    var left = forms.local("left", long_type)
    var ten = long_number(_ten)
    var divided = forms.operation(long_type, 'divide', left, ten)
    return assigned("left", divided)
}

func sign_case(): SpiteCompiler.Statement {
    var value = forms.local("value", long_type)
    var zero = long_number(0)
    var is_negative = forms.operation(boolean, 'less', value, zero)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var at = forms.local("at", integer)
    var length = own_length()
    var past = forms.operation(boolean, 'greater_or_equal', at, length)
    var missed = answered_number(-1)
    var fitting = answering_if(past, missed)
    then_branch.statements.append(fitting)
    var sign_at = forms.local("at", integer)
    var code = code_at(sign_at)
    var minus = long_number(_minus_code)
    var no_sign = forms.operation(boolean, 'not_equal', code, minus)
    var differed = answered_number(-1)
    var signing = answering_if(no_sign, differed)
    then_branch.statements.append(signing)
    var before = forms.local("at", integer)
    var one = forms.number(1)
    var after = forms.operation(integer, 'add', before, one)
    var moved = assigned("at", after)
    then_branch.statements.append(moved)
    return HighIntermediaryRepresentation.Statements.If(is_negative, then_branch, null, 0, "")
}

func digit_compare_loop(): SpiteCompiler.Statement {
    var position = forms.local("position", integer)
    var at = forms.local("at", integer)
    var more = forms.operation(boolean, 'greater_or_equal', position, at)
    var loop_body = HighIntermediaryRepresentation.Statements.Block(0)
    var left = forms.local("left", long_type)
    var ten = long_number(_ten)
    var remainder = forms.operation(long_type, 'remainder', left, ten)
    var taken = assigned("remainder", remainder)
    loop_body.statements.append(taken)
    var negative = negative_remainder_case()
    loop_body.statements.append(negative)
    var code_position = forms.local("position", integer)
    var code = code_at(code_position)
    var digit = forms.local("remainder", long_type)
    var zero_code = long_number(_zero_code)
    var wanted = forms.operation(long_type, 'add', digit, zero_code)
    var differs = forms.operation(boolean, 'not_equal', code, wanted)
    var differed = answered_number(-1)
    var comparing = answering_if(differs, differed)
    loop_body.statements.append(comparing)
    var shrunk = shrunk_left()
    loop_body.statements.append(shrunk)
    var before = forms.local("position", integer)
    var one = forms.number(1)
    var after = forms.operation(integer, 'subtract', before, one)
    var moved = assigned("position", after)
    loop_body.statements.append(moved)
    return HighIntermediaryRepresentation.Statements.While(more, loop_body, 0)
}

func negative_remainder_case(): SpiteCompiler.Statement {
    var remainder = forms.local("remainder", long_type)
    var zero = long_number(0)
    var is_negative = forms.operation(boolean, 'less', remainder, zero)
    var least_end = long_number(0)
    var negated_remainder = forms.local("remainder", long_type)
    var turned = forms.operation(long_type, 'subtract', least_end, negated_remainder)
    var made_positive = assigned("remainder", turned)
    return answering_if(is_negative, made_positive)
}

union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

# ../../OPTIMIZATIONS.md#independent-calls-in-a-row-run-at-once
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var values = HighIntermediaryRepresentation.Building.Values(context)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(no_high)
var weights = HighOptimizationPasses.OverlappedWork.WorkWeights(no_high)
var uses = HighIntermediaryRepresentation.Ownership.Uses()
var least_weight = 1000000

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    context = high.context
    values = HighIntermediaryRepresentation.Building.Values(context)
    building = HighOptimizationPasses.FunctionBuilding(high)
    weights = HighOptimizationPasses.OverlappedWork.WorkWeights(high)
    var built = high.built_functions.copy()
    var index = 0
    while index < built.count() {
        var function = built[index]
        overlap_in_block(function.body)
        index = index + 1
    }
    building.build_the_needed()
}

func overlap_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        overlap_inside(statement)
        index = index + 1
    }
    var start = 0
    while start < block.statements.count() {
        var length = run_length_at(block, start)
        if length >= 2 and pays(block, start, length) {
            overlapped(block, start, length)
        }
        if length < 1 {
            length = 1
        }
        start = start + length
    }
}

func overlap_inside(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: overlap_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: overlap_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: overlap_in_block(statement)
        _: return
    }
}

func overlap_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    overlap_in_block(branch.then_branch)
    overlap_in_block(branch.else_branch)
}

func run_length_at(block: HighIntermediaryRepresentation.Statements.Block, start: Integer): Integer {
    var first = block.statements[start]
    fallback starts_a_run(first)
    var length = 1
    while start + length < block.statements.count() {
        var next = block.statements[start + length]
        if not joins_the_run(next) {
            return length
        }
        length = length + 1
    }
    return length
}

func starts_a_run(statement: Statement?): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        return statement.is_quiet_work
    }
    return false
}

func joins_the_run(statement: Statement?): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        return statement.is_quiet_work and statement.stands_apart_from_the_run_before
    }
    return false
}

func pays(block: HighIntermediaryRepresentation.Statements.Block, start: Integer, length: Integer): Boolean {
    var index = start
    while index < start + length {
        var call = work_at(block, index)
        crash call
        fallback weights.weight_of_call(call) >= least_weight
        index = index + 1
    }
    return true
}

func work_at(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
): HighIntermediaryRepresentation.Values.Call? {
    var statement = block.statements[index]
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        var value = statement.value
        if value.class == HighIntermediaryRepresentation.Values.Call {
            return value
        }
    }
    return null
}

func overlapped(block: HighIntermediaryRepresentation.Statements.Block, start: Integer, length: Integer) {
    var last = start + length - 1
    var index = start
    while index < last {
        var statement = block.statements[index]
        var work = work_at(block, index)
        if statement.class == HighIntermediaryRepresentation.Statements.Declare and work {
            start_on_the_pool(block, index, last, statement, work)
        }
        index = index + 1
    }
}

func start_on_the_pool(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
    last: Integer,
    declared: HighIntermediaryRepresentation.Statements.Declare,
    work: HighIntermediaryRepresentation.Values.Call,
) {
    var answer = work.value_type
    var handle_type = context.resolver.handle_of("Parallel", answer)
    values.need_the_scheduler(handle_type)
    building.need(work.function)
    building.replaced(work.function)
    var running_name = "{declared.name}$running"
    var started = HighIntermediaryRepresentation.Values.Conversion(handle_type, 'into_handle', work)
    var starting = HighIntermediaryRepresentation.Statements.Declare(running_name, handle_type, started)
    starting.line = declared.line
    block.statements[index] = starting
    var running = HighIntermediaryRepresentation.Values.LocalRead(handle_type, running_name)
    var joined = HighIntermediaryRepresentation.Values.Conversion(answer, 'join', running)
    var joining = HighIntermediaryRepresentation.Statements.Declare(declared.name, declared.declared_type, joined)
    joining.line = declared.line
    var place = last + 1
    if not declared.quiet_work_may_halt {
        place = join_place(block, last, declared.name)
    }
    if place < block.statements.count() {
        block.statements.insert(place, joining)
    } else {
        block.statements.append(joining)
    }
}

func join_place(block: HighIntermediaryRepresentation.Statements.Block, last: Integer, name: String): Integer {
    var index = last + 1
    while index < block.statements.count() {
        var statement = block.statements[index]
        if uses.in_statement(statement, name) > 0 or may_leave(statement) {
            return index
        }
        index = index + 1
    }
    return index
}

func may_leave(statement: Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Return: return true
        HighIntermediaryRepresentation.Statements.Stop: return true
        HighIntermediaryRepresentation.Statements.If: return may_leave_a_branch(statement)
        HighIntermediaryRepresentation.Statements.While: return may_leave_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: return may_leave_a_block(statement)
        _: return false
    }
}

func may_leave_a_branch(branch: HighIntermediaryRepresentation.Statements.If): Boolean {
    return may_leave_a_block(branch.then_branch) or may_leave_a_block(branch.else_branch)
}

func may_leave_a_block(block: HighIntermediaryRepresentation.Statements.Block?): Boolean {
    fallback block
    return block.statements.any(may_leave)
}

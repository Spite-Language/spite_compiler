# ../../OPTIMIZATIONS.md#independent-calls-in-a-row-run-at-once

var built_by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var weights = Dictionary<String, Integer>()
var studying = List<String>()
var heaviest = 100000000
var unknown_bound = 8
var largest_bound = 1000000
var numbers_nothing_writes: Dictionary<String, SpiteCompiler.Value>

func WorkWeights(high: HighIntermediaryRepresentation.HighProgram) {
    numbers_nothing_writes = high.numbers_nothing_writes
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        built_by_key[key] = built
        index = index + 1
    }
}

func weight_of_call(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var key = call.function.key()
    var body_weight = weight_of_function(key)
    var arguments_weight = weight_of_values(call.arguments)
    return capped(body_weight + arguments_weight)
}

func weight_of_function(key: String): Integer {
    var known = weights[key]
    if known {
        return known
    }
    var built = built_by_key[key]
    fallback built and not studying.contains(key)
    studying.append(key)
    var weight = weight_of_block(built.body)
    crash studying.remove_last()
    weights[key] = weight
    return weight
}

func weight_of_block(block: HighIntermediaryRepresentation.Statements.Block?): Integer {
    fallback block
    var total = 0
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var weight = weight_of_statement(statement)
        total = capped(total + weight)
        index = index + 1
    }
    return total
}

func weight_of_statement(statement: SpiteCompiler.Statement): Integer {
    switch statement {
        HighIntermediaryRepresentation.Statements.While: return weight_of_a_loop(statement)
        HighIntermediaryRepresentation.Statements.If: return weight_of_an_if(statement)
        HighIntermediaryRepresentation.Statements.Block: return weight_of_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Assign: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Return: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return 1
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return 1
        HighIntermediaryRepresentation.Statements.Stop: return 1
    }
}

func weight_of_a_line(value: SpiteCompiler.Value?): Integer {
    var inside = weight_of_value(value)
    return capped(1 + inside)
}

func weight_of_a_loop(loop: HighIntermediaryRepresentation.Statements.While): Integer {
    var body = weight_of_block(loop.body)
    var tested = weight_of_value(loop.condition)
    var bound = bound_of(loop.condition)
    var each_pass = capped(body + tested + 1)
    var passes: Long = each_pass
    passes = passes * bound
    if passes > heaviest {
        return heaviest
    }
    var fitted: Integer? = passes
    crash fitted
    return fitted
}

func bound_of(condition: SpiteCompiler.Value?): Integer {
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        var is_counted = condition.operator == 'less' or condition.operator == 'less_or_equal'
        var right = condition.right
        if is_counted and right.class == HighIntermediaryRepresentation.Values.WholeNumber {
            return literal_bound(right.number)
        }
        if is_counted and right.class == HighIntermediaryRepresentation.Values.AttributeRead {
            return attribute_bound(right)
        }
    }
    return unknown_bound
}

# ../../OPTIMIZATIONS.md#independent-calls-in-a-row-run-at-once
func attribute_bound(read: HighIntermediaryRepresentation.Values.AttributeRead): Integer {
    var key = "{read.attribute.owner}.{read.attribute.name}"
    var number = numbers_nothing_writes[key]
    if number and number.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return literal_bound(number.number)
    }
    return unknown_bound
}

func literal_bound(written: Long): Integer {
    if written < 1 {
        return 1
    }
    if written > largest_bound {
        return largest_bound
    }
    var fitted: Integer? = written
    crash fitted
    return fitted
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func weight_of_an_if(branch: HighIntermediaryRepresentation.Statements.If): Integer {
    var links = List<HighIntermediaryRepresentation.Statements.If>()
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    var last = branch
    while link {
        links.append(link)
        last = link
        link = link.else_if()
    }
    var weight = weight_of_block(last.else_branch)
    while not links.is_empty() {
        var current = links.remove_last()
        crash current
        var tested = weight_of_value(current.condition)
        var then_weight = weight_of_block(current.then_branch)
        var heavier = then_weight
        if weight > heavier {
            heavier = weight
        }
        weight = capped(1 + tested + heavier)
    }
    return weight
}

func weight_of_values(values: List<SpiteCompiler.Value>): Integer {
    var total = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        var weight = weight_of_value(value)
        total = capped(total + weight)
        index = index + 1
    }
    return total
}

func weight_of_value(value: SpiteCompiler.Value?): Integer {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Call: return weight_of_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return weight_of_value_in_a_chain(value)
        HighIntermediaryRepresentation.Values.Negation: return weight_of_value(value.negated)
        HighIntermediaryRepresentation.Values.Conversion: return weight_of_value(value.converted)
        HighIntermediaryRepresentation.Values.WholeNumber: return 0
        HighIntermediaryRepresentation.Values.DecimalNumber: return 0
        HighIntermediaryRepresentation.Values.TextConstant: return 0
        HighIntermediaryRepresentation.Values.NullConstant: return 0
        HighIntermediaryRepresentation.Values.LocalRead: return 0
        HighIntermediaryRepresentation.Values.ThisRead: return 0
        HighIntermediaryRepresentation.Values.AttributeRead: return 0
        HighIntermediaryRepresentation.Values.MakeObject: return 0
        HighIntermediaryRepresentation.Values.ForeignCall: return 0
        HighIntermediaryRepresentation.Values.Class.Membership: return 0
        HighIntermediaryRepresentation.Values.PresenceTest: return 0
        HighIntermediaryRepresentation.Values.Function.Value: return 0
        HighIntermediaryRepresentation.Values.Function.ValueCall: return 0
        HighIntermediaryRepresentation.Values.NumberRoom: return 0
        HighIntermediaryRepresentation.Values.ShapeCall: return 0
        HighIntermediaryRepresentation.Values.EnumText: return 0
        HighIntermediaryRepresentation.Values.EnumFromText: return 0
        HighIntermediaryRepresentation.Values.Class.Object: return 0
        HighIntermediaryRepresentation.Values.Class.OfValue: return 0
        HighIntermediaryRepresentation.Values.Function.Fact: return 0
    }
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func weight_of_value_in_a_chain(operation: HighIntermediaryRepresentation.Values.MachineOperation): Integer {
    var links = [operation]
    var lowest = operation
    var next = weight_of_value_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = weight_of_value_left_link_of(lowest)
    }
    var total = weight_of_value(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        var on_the_right = weight_of_value(link.right)
        total = capped(total + on_the_right)
        index = index - 1
    }
    return total
}

func weight_of_value_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    return left
}

func capped(weight: Integer): Integer {
    if weight > heaviest or weight < 0 {
        return heaviest
    }
    return weight
}

union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#independent-calls-in-a-row-run-at-once
var built_by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var weights = Dictionary<String, Integer>()
var studying = List<String>()
var heaviest = 100000000
var unknown_bound = 8
var largest_bound = 1000000

func WorkWeights(high: HighIntermediaryRepresentation.HighProgram) {
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        built_by_key[key] = built
        index = index + 1
    }
}

func weight_of_call(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var key = call.function.key()
    var body_weight = weight_of_function(key)
    var arguments_weight = weight_of_values(call.arguments)
    return capped(body_weight + arguments_weight)
}

func weight_of_function(key: String): Integer {
    var known = weights[key]
    if known {
        return known
    }
    var built = built_by_key[key]
    fallback built and not studying.contains(key)
    studying.append(key)
    var weight = weight_of_block(built.body)
    crash studying.remove_last()
    weights[key] = weight
    return weight
}

func weight_of_block(block: HighIntermediaryRepresentation.Statements.Block?): Integer {
    fallback block
    var total = 0
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var weight = weight_of_statement(statement)
        total = capped(total + weight)
        index = index + 1
    }
    return total
}

func weight_of_statement(statement: Statement): Integer {
    switch statement {
        HighIntermediaryRepresentation.Statements.While: return weight_of_a_loop(statement)
        HighIntermediaryRepresentation.Statements.If: return weight_of_an_if(statement)
        HighIntermediaryRepresentation.Statements.Block: return weight_of_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: return weight_of_a_line(statement.value)
        HighIntermediaryRepresentation.Statements.Return: return weight_of_a_line(statement.value)
        _: return 1
    }
}

func weight_of_a_line(value: Value?): Integer {
    var inside = weight_of_value(value)
    return capped(1 + inside)
}

func weight_of_a_loop(loop: HighIntermediaryRepresentation.Statements.While): Integer {
    var body = weight_of_block(loop.body)
    var tested = weight_of_value(loop.condition)
    var bound = bound_of(loop.condition)
    var each_pass = capped(body + tested + 1)
    var passes: Long = each_pass
    passes = passes * bound
    if passes > heaviest {
        return heaviest
    }
    return passes
}

func bound_of(condition: Value?): Integer {
    if condition == HighIntermediaryRepresentation.Values.MachineOperation {
        var is_counted = condition.operator == 'less' or condition.operator == 'less_or_equal'
        var right = condition.right
        if is_counted and right == HighIntermediaryRepresentation.Values.WholeNumber {
            return literal_bound(right.number)
        }
    }
    return unknown_bound
}

func literal_bound(written: Long): Integer {
    if written < 1 {
        return 1
    }
    if written > largest_bound {
        return largest_bound
    }
    return written
}

func weight_of_an_if(branch: HighIntermediaryRepresentation.Statements.If): Integer {
    var tested = weight_of_value(branch.condition)
    var then_weight = weight_of_block(branch.then_branch)
    var else_weight = weight_of_block(branch.else_branch)
    var heavier = then_weight
    if else_weight > heavier {
        heavier = else_weight
    }
    return capped(1 + tested + heavier)
}

func weight_of_values(values: List<Value>): Integer {
    var total = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        var weight = weight_of_value(value)
        total = capped(total + weight)
        index = index + 1
    }
    return total
}

func weight_of_value(value: Value?): Integer {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Call: return weight_of_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return weight_of_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: return weight_of_value(value.negated)
        HighIntermediaryRepresentation.Values.Conversion: return weight_of_value(value.converted)
        _: return 0
    }
}

func weight_of_both(
    left: Value?,
    right: Value?,
): Integer {
    var left_weight = weight_of_value(left)
    var right_weight = weight_of_value(right)
    return capped(left_weight + right_weight)
}

func capped(weight: Integer): Integer {
    if weight > heaviest or weight < 0 {
        return heaviest
    }
    return weight
}

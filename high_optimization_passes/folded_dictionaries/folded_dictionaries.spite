union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#a-dictionary-written-out-and-only-read-by-literal-keys-is-folded
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(no_high)
var no_function = Model.FunctionModel("", "")
var no_body = HighIntermediaryRepresentation.Statements.Block()
var current = HighIntermediaryRepresentation.HighFunction(no_function, no_body)
var written = HighIntermediaryRepresentation.LiteralDictionary("", "", "")
var found_block: HighIntermediaryRepresentation.Statements.Block? = null
var found_index = -1

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered() and not high.literal_dictionaries.is_empty()
    crash high.context
    context = high.context
    program = high
    fallback not is_interactive()
    building = HighOptimizationPasses.FunctionBuilding(high)
    high.literal_dictionaries.each(fold)
}

func is_interactive(): Boolean {
    var flags = context.build_flags
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func fold(dictionary: HighIntermediaryRepresentation.LiteralDictionary) {
    fallback dictionary.missed == 0
    written = dictionary
    var function = function_keyed(dictionary.function_key)
    fallback function
    current = function
    found_block = null
    found_index = -1
    find_in_block(function.body)
    fallback found_block
    fold_at(found_block, found_index)
}

func function_keyed(key: String): HighIntermediaryRepresentation.HighFunction? {
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        if function.function.key() == key {
            return function
        }
        index = index + 1
    }
    return null
}

func find_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if declares_the_made(statement) {
            found_block = block
            found_index = index
        }
        find_inside(statement)
        index = index + 1
    }
}

func declares_the_made(statement: Statement): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Declare {
        return statement.name == written.made_name
    }
    return false
}

func find_inside(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: find_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: find_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: find_in_block(statement)
        _: return
    }
}

func find_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    find_in_block(branch.then_branch)
    find_in_block(branch.else_branch)
}

func fold_at(block: HighIntermediaryRepresentation.Statements.Block, index: Integer) {
    var removed = written.keys.count() + 2
    var kept = List<Statement>()
    var position = 0
    while position < block.statements.count() {
        var statement = block.statements[position]
        var is_removed = position >= index and position < index + removed
        if not is_removed {
            kept.append(statement)
        }
        position = position + 1
    }
    block.statements = kept
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(current.body)
    decide_in_block(current.body)
    building.replaced(written.setter)
    fallback written.constructor
    building.replaced(written.constructor)
}

func rewritten(value: Value): Value {
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'proven' {
        return proven_read(value)
    }
    if is_a_folded_read(value) {
        return entry_read(value)
    }
    return value
}

func proven_read(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
): Value {
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call and is_a_folded_read(read) {
        building.replaced(read.function)
        var position = asked_position(read)
        return entry_at(position)
    }
    return conversion
}

func entry_read(value: Value): Value {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        building.replaced(value.function)
        var position = asked_position(value)
        var entry = entry_at(position)
        return HighIntermediaryRepresentation.Values.Conversion(value.value_type, 'nullable', entry)
    }
    return value
}

func entry_at(position: Integer): Value {
    var entry = written.entries[position]
    crash entry
    switch entry {
        HighIntermediaryRepresentation.Values.WholeNumber: return number_copy(entry)
        HighIntermediaryRepresentation.Values.DecimalNumber: return decimal_copy(entry)
        HighIntermediaryRepresentation.Values.TextConstant: return text_copy(entry)
        _: return entry
    }
}

func number_copy(
    number: HighIntermediaryRepresentation.Values.WholeNumber,
): Value {
    return HighIntermediaryRepresentation.Values.WholeNumber(number.value_type, number.number)
}

func decimal_copy(
    decimal: HighIntermediaryRepresentation.Values.DecimalNumber,
): Value {
    return HighIntermediaryRepresentation.Values.DecimalNumber(decimal.value_type, decimal.written)
}

func text_copy(text: HighIntermediaryRepresentation.Values.TextConstant): Value {
    var copied = HighIntermediaryRepresentation.Values.TextConstant(text.text)
    copied.value_type = text.value_type
    return copied
}

# ../../OPTIMIZATIONS.md#a-dictionary-written-out-and-only-read-by-literal-keys-is-folded
func decide_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var decided = decided_statement(statement)
        if decided {
            block.statements[index] = decided
        }
        var kept = block.statements[index]
        decide_inside(kept)
        index = index + 1
    }
}

func decide_inside(statement: Statement?) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: decide_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: decide_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: decide_in_block(statement)
        _: return
    }
}

func decide_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    decide_in_block(branch.then_branch)
    decide_in_block(branch.else_branch)
}

func decided_statement(
    statement: Statement,
): Statement? {
    if statement.class == HighIntermediaryRepresentation.Statements.If {
        return decided_branch(statement)
    }
    return null
}

func decided_branch(
    branch: HighIntermediaryRepresentation.Statements.If,
): Statement? {
    var condition = branch.condition
    if is_a_present_entry(condition) {
        return branch.then_branch
    }
    if condition.class == HighIntermediaryRepresentation.Values.Negation and is_a_present_entry(condition.negated) {
        return taken_otherwise(branch)
    }
    return null
}

func taken_otherwise(
    branch: HighIntermediaryRepresentation.Statements.If,
): Statement {
    if branch.else_branch {
        return branch.else_branch
    }
    var nothing = HighIntermediaryRepresentation.Statements.Block()
    nothing.line = branch.line
    return nothing
}

func is_a_present_entry(value: Value?): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.PresenceTest {
        return is_a_lifted_entry(value.tested)
    }
    return false
}

func is_a_lifted_entry(value: Value?): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'nullable' {
        crash value.converted
        return is_an_entry(value.converted)
    }
    return false
}

func is_a_folded_read(value: Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Call and value.function.name == "get_at" {
        return reads_by_a_key(value)
    }
    return false
}

func reads_by_a_key(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var receiver = call.receiver
    var is_the_dictionary = receiver.class == HighIntermediaryRepresentation.Values.LocalRead
    is_the_dictionary = is_the_dictionary and is_named(receiver, written.dictionary_name)
    fallback is_the_dictionary and call.function.owner == written.dictionary_key and call.arguments.count() == 1
    return call.value_type.is_nullable
}

func is_named(value: Value?, name: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name == name
    }
    return false
}

func asked_position(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var asked = call.arguments[0]
    crash asked
    return position_of(asked)
}

func position_of(key: Value): Integer {
    var index = 0
    while index < written.keys.count() {
        var known = written.keys[index]
        if is_the_same_key(known, key) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_the_same_key(
    known: Value,
    asked: Value,
): Boolean {
    if known.class == HighIntermediaryRepresentation.Values.TextConstant {
        return is_the_same_text(known, asked)
    }
    if known.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return is_the_same_number(known, asked)
    }
    return false
}

func is_the_same_text(
    known: HighIntermediaryRepresentation.Values.TextConstant,
    asked: Value,
): Boolean {
    if asked.class == HighIntermediaryRepresentation.Values.TextConstant {
        return known.text == asked.text
    }
    return false
}

func is_the_same_number(
    known: HighIntermediaryRepresentation.Values.WholeNumber,
    asked: Value,
): Boolean {
    if asked.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return known.number == asked.number
    }
    return false
}

func is_an_entry(value: Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        _: return false
    }
}

# ../../OPTIMIZATIONS.md#a-chain-of-filter_-steps-runs-as-one-loop

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var values = HighIntermediaryRepresentation.Building.Values(context)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var building = HighOptimizationPasses.FunctionBuilding(no_high)
var library = Mapping.LibraryFile()
var chained_program = HighIntermediaryRepresentation.HighProgram(no_program)
var walking: HighOptimizationPasses.Rewriting? = null
var walked_function: Model.FunctionModel? = null
var kept_chains = List<String>()
var proving = Proofs.ChainsLeaveTheirList.Proof(no_high)
var chain_steps = List<String>()
var chain_functions = List<Model.FunctionModel>()
var chain_first: SpiteCompiler.Value? = null
var after_a_map = ["count_member", "any_member", "all_member", "sum_member", "each_member", "map_members"]

var fused_templates = [
    "filter_member"
    "count_member"
    "any_member"
    "all_member"
    "sum_member"
    "each_member"
    "map_members"
    "find_by_member"
]

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    context = high.context
    values = HighIntermediaryRepresentation.Building.Values(context)
    building = HighOptimizationPasses.FunctionBuilding(high)
    chained_program = high
    proving = Proofs.ChainsLeaveTheirList.Proof(high)
    var rewriting = HighOptimizationPasses.Rewriting(this)
    walking = rewriting
    var built = high.built_functions.copy()
    var index = 0
    while index < built.count() {
        var function = built[index]
        walked_function = function.function
        rewriting.rewrite_block(function.body)
        index = index + 1
    }
    building.build_the_needed()
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        fuse(value)
    }
    return value
}

func fuse(call: HighIntermediaryRepresentation.Values.Call) {
    var fused = fused_step(call)
    fallback fused
    var first = first_list_of()
    chain_functions.each(building.replaced)
    building.replaced(call.function)
    call.function = fused
    call.receiver = first
    building.need(fused)
}

func fused_step(call: HighIntermediaryRepresentation.Values.Call): Model.FunctionModel? {
    var owner = context.program.class_named(call.function.owner)
    fallback owner and call.receiver
    var is_a_list = owner.file.namespace == "List" or owner.file.namespace == "Vector"
    fallback is_a_list and library.holds(owner.file.path)
    chain_steps = List<String>()
    chain_functions = List<Model.FunctionModel>()
    chain_first = null
    var receiver: SpiteCompiler.Value = call.receiver
    fallback follows_a_chain(receiver)
    var filters = chain_steps
    var first = first_list_of()
    var first_class = values.present_class_of(first)
    fallback first_class.file.namespace == owner.file.namespace and library.holds(first_class.file.path)
    var steps = chain_functions.copy()
    steps.append(call.function)
    if not proving.leaves(steps, first_class.key) {
        note_a_chain_kept(first_class)
        return null
    }
    return fused_function(first_class, filters, call.function)
}

# ../../OPTIMIZATIONS.md#a-chain-of-filter_-steps-runs-as-one-loop
func note_a_chain_kept(first_class: Model.ClassModel) {
    crash walking
    crash walked_function
    fallback walked_function.declaration
    var member = proving.changing_member
    var path = walked_function.declaration.path
    var kept_text = "a chain over a `{first_class.shown}` runs step by step: '{member}' may change the list the chain walks, so each step works on its own copy"
    var kept_key = "{path}:{walking.line}:{kept_text}"
    fallback not kept_chains.contains(kept_key)
    kept_chains.append(kept_key)
    chained_program.unfused_chain_paths.append(path)
    chained_program.unfused_chain_lines.append(walking.line)
    chained_program.unfused_chain_texts.append(kept_text)
}

func first_list_of(): SpiteCompiler.Value {
    crash chain_first
    return chain_first
}

func follows_a_chain(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        var kind = step_kind(value.function)
        var is_a_step = value.arguments.is_empty() and not kind.is_empty()
        if is_a_step and value.receiver {
            var inner: SpiteCompiler.Value = value.receiver
            var steps = List<String>()
            if value.function.fused {
                value.function.fused.filters.each(steps.append)
                chain_first = inner
            } else {
                steps = steps_before(inner)
            }
            var step = member_step(value.function, kind)
            steps.append(step)
            chain_steps = steps
            chain_functions.append(value.function)
            return true
        }
    }
    return false
}

func steps_before(inner: SpiteCompiler.Value): List<String> {
    if follows_a_chain(inner) {
        return chain_steps
    }
    chain_first = inner
    return List<String>()
}

func step_kind(function: Model.FunctionModel): String {
    var binding = function.binding_or_empty()
    fallback function.declaration and not binding.member.is_empty()
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if declaration.name == "filter_member" {
        return "filter"
    }
    if declaration.name == "map_members" {
        return "map"
    }
    return ""
}

func member_step(function: Model.FunctionModel, kind: String): String {
    var binding = function.binding_or_empty()
    var step = binding.member
    if binding.member_is_a_function {
        step = "{binding.member}()"
    }
    if kind == "map" {
        return "={step}"
    }
    return step
}

func maps_in(filters: List<String>): Boolean {
    var index = 0
    while index < filters.count() {
        var filter = filters[index]
        if filter.starts_with("=") {
            return true
        }
        index = index + 1
    }
    return false
}

func fused_function(owner: Model.ClassModel, filters: List<String>, last: Model.FunctionModel): Model.FunctionModel? {
    fallback last.declaration and last.binding
    var last_binding: Model.TemplateBinding = last.binding
    fallback not last_binding.member.is_empty() and last_binding.member_type
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = last.declaration
    fallback fused_templates.contains(declaration.name)
    var maps = maps_in(filters)
    fallback not maps or after_a_map.contains(declaration.name)
    var steps = filters.join("_")
    var unmapped_steps = steps.replace("=", "to_")
    var plain_steps = unmapped_steps.replace("()", "")
    var fused_name = "_fused_{plain_steps}_then_{last.name}"
    var known = owner.function_named(fused_name)
    if known {
        return known
    }
    var body = fused_body(declaration, filters)
    fallback body
    var written = AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration(
        declaration.name,
        declaration.parameters,
        declaration.result,
        body,
    )
    written.line = declaration.line
    written.path = declaration.path
    var bound = Model.TemplateBinding(
        last_binding.template_index,
        last_binding.member,
        last_binding.member_type,
        last_binding.member_is_a_function,
        last_binding.member_index,
        last_binding.shape,
        last_binding.chained_function,
        null,
        last_binding.compared,
    )
    var fused: Model.FusedStep? = null
    if declaration.name == "filter_member" or declaration.name == "map_members" {
        fused = Model.FusedStep(filters)
    }
    var made = context.resolver.reading.specialized(written, owner.key, bound, null, fused, fused_name, owner)
    owner.declared_functions.append(made)
    return made
}

func fused_body(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    filters: List<String>,
): AbstractSyntaxTree.Shapes.Statements.Block? {
    fallback declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    var statements = List<SpiteCompiler.WrittenStatement>()
    var fused_one = false
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        var fused = fused_loop(statement, filters)
        if fused and not fused_one {
            statements.append(fused)
            fused_one = true
        } else {
            statements.append(statement)
        }
        index = index + 1
    }
    fallback fused_one
    var made = AbstractSyntaxTree.Shapes.Statements.Block(statements)
    made.line = body.line
    made.end_line = body.end_line
    return made
}

func fused_loop(statement: SpiteCompiler.WrittenStatement?, filters: List<String>): SpiteCompiler.WrittenStatement? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        return filtered_loop(statement, filters)
    }
    return null
}

func filtered_loop(
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    filters: List<String>,
): SpiteCompiler.WrittenStatement? {
    fallback loop.body and loop.condition
    var loop_body: AbstractSyntaxTree.Shapes.Statements.Block = loop.body
    var count = loop_body.statements.count()
    fallback count >= 3
    var reading = loop_body.statements[0]
    var stepping = loop_body.statements[count - 1]
    crash reading
    crash stepping
    fallback reads_the_item(reading)
    var middle = List<SpiteCompiler.WrittenStatement>()
    var index = 1
    while index < count - 1 {
        var inner = loop_body.statements[index]
        crash inner
        middle.append(inner)
        index = index + 1
    }
    var steps = List<SpiteCompiler.WrittenStatement>()
    var first_reading = renamed_reading(reading, filters)
    steps.append(first_reading)
    var guarded = guarded_by(middle, filters, loop.line)
    guarded.each(steps.append)
    steps.append(stepping)
    var stepped = AbstractSyntaxTree.Shapes.Statements.Block(steps)
    stepped.line = loop_body.line
    stepped.end_line = loop_body.end_line
    var made = AbstractSyntaxTree.Shapes.Statements.WhileStatement(loop.condition, stepped)
    made.line = loop.line
    return made
}

func renamed_reading(reading: SpiteCompiler.WrittenStatement, filters: List<String>): SpiteCompiler.WrittenStatement {
    if reading.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return renamed_variable(reading, filters)
    }
    return reading
}

func renamed_variable(
    reading: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    filters: List<String>,
): SpiteCompiler.WrittenStatement {
    if not maps_in(filters) {
        return reading
    }
    crash reading.value
    var name = item_name(0, filters)
    var renamed = AbstractSyntaxTree.Shapes.Statements.VariableStatement(name, reading.declared_type, reading.value)
    renamed.line = reading.line
    return renamed
}

func item_name(step: Integer, filters: List<String>): String {
    var maps_before = 0
    var index = 0
    while index < filters.count() {
        var filter = filters[index]
        if filter.starts_with("=") and index >= step {
            return "fused_item_{maps_before}"
        }
        if filter.starts_with("=") {
            maps_before = maps_before + 1
        }
        index = index + 1
    }
    return "item"
}

func reads_the_item(statement: SpiteCompiler.WrittenStatement): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == "item"
    }
    return false
}

func guarded_by(
    middle: List<SpiteCompiler.WrittenStatement>,
    filters: List<String>,
    line: Integer,
): List<SpiteCompiler.WrittenStatement> {
    var inside = middle
    var index = filters.count() - 1
    while index >= 0 {
        var filter = filters[index]
        crash filter
        var reading = item_name(index, filters)
        if filter.starts_with("=") {
            inside = mapped_into(filter, index, filters, inside, line)
        } else {
            inside = filtered_into(filter, reading, inside, line)
        }
        index = index - 1
    }
    return inside
}

func mapped_into(
    filter: String,
    index: Integer,
    filters: List<String>,
    inside: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
): List<SpiteCompiler.WrittenStatement> {
    var reading = item_name(index, filters)
    var mapped = item_name(index + 1, filters)
    var length = filter.length()
    var member = filter.slice(1, length)
    crash member
    var value = member_read(member, reading)
    var named = AbstractSyntaxTree.Shapes.Statements.VariableStatement(mapped, null, value)
    named.line = line
    var with_named = List<SpiteCompiler.WrittenStatement>()
    with_named.append(named)
    inside.each(with_named.append)
    return with_named
}

func filtered_into(
    filter: String,
    reading: String,
    inside: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
): List<SpiteCompiler.WrittenStatement> {
    var block = AbstractSyntaxTree.Shapes.Statements.Block(inside)
    block.line = line
    var condition = member_read(filter, reading)
    var made = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, block, null)
    made.line = line
    var wrapping = List<SpiteCompiler.WrittenStatement>()
    wrapping.append(made)
    return wrapping
}

func member_read(filter: String, reading: String): SpiteCompiler.Expression {
    var item = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(reading)
    if filter.ends_with("()") {
        var length = filter.length()
        var name = filter.slice(0, length - 2)
        crash name
        var callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(item, name)
        var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var no_arguments = List<SpiteCompiler.Expression>()
        return AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, no_generics, no_arguments)
    }
    return AbstractSyntaxTree.Shapes.Expressions.MemberExpression(item, filter)
}

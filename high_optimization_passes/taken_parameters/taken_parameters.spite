# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    var not_taking = keys_that_take_nothing(high)
    var taking = HighIntermediaryRepresentation.Ownership.TakenParameters(high.model, not_taking)
    taking.study(high)
    high.taken_parameters = taking
}

func keys_that_take_nothing(high: HighIntermediaryRepresentation.HighProgram): List<String> {
    var found = List<String>()
    crash high.waits
    crash high.assignments
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var key = function.function.key()
        var not_ordinary = not high.is_an_ordinary_class(function.function.owner)
        var waiting = high.waits.is_resumable(key) or high.waits.blocks(key)
        if not_ordinary or waiting or high.assignments.taken_as_values.contains(key) {
            found.append(key)
        }
        index = index + 1
    }
    return found
}

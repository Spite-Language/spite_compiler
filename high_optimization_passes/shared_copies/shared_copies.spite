union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

# ../../OPTIMIZATIONS.md#a-deep-copy-nothing-changes-is-the-original
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        share_in_a_block(built.body)
        index = index + 1
    }
}

func share_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(share_in_a_statement)
}

func share_in_a_statement(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: share_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.If: share_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: share_in_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: share_in_a_block(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func share_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    share_in_a_block(branch.then_branch)
    share_in_a_block(branch.else_branch)
}

func share_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    fallback declared.shares_the_original
    declared.shares_the_original = false
    var called = declared.value
    fallback called.class == HighIntermediaryRepresentation.Values.Call
    fallback called.receiver
    declared.value = called.receiver
}

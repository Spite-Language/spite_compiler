# ../../OPTIMIZATIONS.md#a-function-only-a-replaced-call-reached-is-not-compiled
var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var reached = List<List<String>>()
var counts = Dictionary<String, Integer>()
var positions = Dictionary<String, Integer>()
var dropped = List<Boolean>()
var waiting = List<String>()
var noted = List<String>()
var protected_names = ["drop", "_read_value", "_settled", "_attribute_defaults", "to_string", "to_debug"]

func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered() and not high.replaced_functions.is_empty()
    crash high.context
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    program = high
    note_the_references()
    high.replaced_functions.each(wait_for)
    while not waiting.is_empty() {
        var key = waiting.remove_first()
        crash key
        drop_when_unreached(key)
    }
    var kept = List<HighIntermediaryRepresentation.HighFunction>()
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        if dropped[index] != true {
            kept.append(function)
        }
        index = index + 1
    }
    program.built_functions = kept
}

func note_the_references() {
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        var key = function.function.key()
        positions[key] = index
        var references = HighOptimizationPasses.UnreachedFunctions.References()
        var keys = references.of(function)
        reached.append(keys)
        keys.each(count_a_reference)
        dropped.append(false)
        index = index + 1
    }
}

func count_a_reference(key: String) {
    var count = counts[key]
    if count {
        counts[key] = count + 1
    } else {
        counts[key] = 1
    }
}

func wait_for(function: Model.FunctionModel) {
    var key = function.key()
    fallback not noted.contains(key)
    noted.append(key)
    waiting.append(key)
}

func drop_when_unreached(key: String) {
    var position = positions[key]
    fallback position
    var function = program.built_functions[position]
    crash function
    fallback is_droppable(function.function) and not is_reached(key, position)
    dropped[position] = true
    var keys = reached[position]
    crash keys
    keys.each(forget_a_reference)
    var index = 0
    while index < keys.count() {
        var called_key = keys[index]
        wait_for_a_callee(called_key, function.function)
        index = index + 1
    }
}

func is_reached(key: String, position: Integer): Boolean {
    var count = counts[key]
    fallback count
    var own = reached[position]
    crash own
    if own.contains(key) {
        return count > 1
    }
    return count > 0
}

func forget_a_reference(key: String) {
    var count = counts[key]
    crash count
    counts[key] = count - 1
}

func wait_for_a_callee(key: String, caller: Model.FunctionModel) {
    var position = positions[key]
    fallback position
    var function = program.built_functions[position]
    crash function
    var callee = function.function
    var is_a_template_copy = not callee.bound_member.is_empty()
    if is_a_template_copy or callee.owner == caller.owner {
        wait_for(callee)
    }
}

func is_droppable(function: Model.FunctionModel): Boolean {
    fallback not function.is_constructor and not protected_names.contains(function.name)
    var shape_key = "shape {function.name}"
    var shape_calls = counts[shape_key]
    fallback not shape_calls or shape_calls <= 0
    return not is_an_entry(function)
}

func is_an_entry(function: Model.FunctionModel): Boolean {
    var key = function.key()
    if program.entry and program.entry.key() == key {
        return true
    }
    if program.prompt and program.prompt.key() == key {
        return true
    }
    if program.prompt_listen and program.prompt_listen.key() == key {
        return true
    }
    if program.prompt_check_point and program.prompt_check_point.key() == key {
        return true
    }
    if program.prompt_serve and program.prompt_serve.key() == key {
        return true
    }
    if program.reload_start and program.reload_start.key() == key {
        return true
    }
    if program.reload_check_point and program.reload_check_point.key() == key {
        return true
    }
    return false
}

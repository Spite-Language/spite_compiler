# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told

var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var quiet = HighIntermediaryRepresentation.QuietValues(program)
var told_functions = ["notify", "unsubscribe"]
var copying_functions = ["copy", "deep_copy"]
var plain_conversions: List<HighIntermediaryRepresentation.Values.Conversion.Kind> = [
    'present'
    'nullable'
    'into_union'
    'widen'
    'into_shape'
    'to_decimal'
]
var read_counts = Dictionary<String, Integer>()
var names_left_unread = List<String>()
var collects_names = false
var left_out = 0

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func optimized(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    var subscribers = HeldSubscribers(high)
    subscribers.hold_the_owners_back()
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(high.context.build_flags)
    leave_out_of(high.built_functions, high)
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func leave_out_of(
    functions: List<HighIntermediaryRepresentation.HighFunction>,
    high: HighIntermediaryRepresentation.HighProgram,
) {
    program = high
    high.unsubscribed_observers = high.observers_nothing_subscribes_to()
    high.model.left_out_classes.each(high.unsubscribed_observers.append)
    fallback not high.unsubscribed_observers.is_empty()
    quiet = HighIntermediaryRepresentation.QuietValues(high)
    functions.each(leave_out_of_a_function)
    var classes = ObserverClasses(high)
    classes.leave_out_the_unread()
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func kept_functions(
    functions: List<HighIntermediaryRepresentation.HighFunction>,
): List<HighIntermediaryRepresentation.HighFunction> {
    var kept = List<HighIntermediaryRepresentation.HighFunction>()
    var index = 0
    while index < functions.count() {
        var built = functions[index]
        if not program.model.left_out_classes.contains(built.function.owner) {
            kept.append(built)
        }
        index = index + 1
    }
    return kept
}

func leave_out_of_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    left_out = 0
    names_left_unread = List<String>()
    leave_out_of_a_block(function.body)
    fallback left_out > 0
    var unread = true
    while unread {
        read_counts = Dictionary<String, Integer>()
        count_the_reads(function.body)
        unread = leave_out_unread_declarations(function.body)
    }
}

func leave_out_of_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var kept = List<SpiteCompiler.Statement>()
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if is_a_told_change(statement) or is_a_copied_observer(statement) {
            left_out = left_out + 1
            note_what_it_read(statement)
        } else {
            leave_out_inside(statement)
            kept.append(statement)
        }
        index = index + 1
    }
    block.statements = kept
}

func leave_out_inside(statement: SpiteCompiler.Statement) {
    if statement.class == HighIntermediaryRepresentation.Statements.Block {
        leave_out_of_a_block(statement)
    } else if statement.class == HighIntermediaryRepresentation.Statements.While {
        leave_out_of_a_block(statement.body)
    } else if statement.class == HighIntermediaryRepresentation.Statements.If {
        leave_out_of_an_if(statement)
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func leave_out_of_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        leave_out_of_a_block(current.then_branch)
        link = current.else_if()
        if not link {
            leave_out_of_a_block(current.else_branch)
        }
    }
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func is_a_told_change(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Evaluate
    fallback not statement.waited
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
    fallback told_functions.contains(statement.value.function.name)
    fallback program.unsubscribed_observers.contains(statement.value.function.owner)
    fallback is_none_or_effect_free(statement.value.receiver)
    return are_effect_free(statement.value.arguments)
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func is_a_copied_observer(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
    fallback copying_functions.contains(statement.value.function.name)
    fallback program.unsubscribed_observers.contains(statement.value.function.owner)
    fallback is_none_or_effect_free(statement.object) and is_none_or_effect_free(statement.value.receiver)
    return are_effect_free(statement.value.arguments)
}

func note_what_it_read(statement: SpiteCompiler.Statement) {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    body.statements.append(statement)
    collects_names = true
    var collecting = HighOptimizationPasses.Rewriting(this)
    collecting.rewrite_block(body)
    collects_names = false
}

func are_effect_free(values: List<SpiteCompiler.Value>): Boolean {
    return values.all(is_effect_free)
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func is_none_or_effect_free(value: SpiteCompiler.Value?): Boolean {
    if not value {
        return true
    }
    return is_effect_free(value)
}

# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func is_effect_free(value: SpiteCompiler.Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.NullConstant: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_none_or_effect_free(value.object)
        HighIntermediaryRepresentation.Values.Conversion: return is_a_plain_conversion(value)
        HighIntermediaryRepresentation.Values.MakeObject: return is_a_quiet_making(value)
        HighIntermediaryRepresentation.Values.Call: return is_an_item_read(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func is_a_plain_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    fallback plain_conversions.contains(conversion.kind)
    return is_none_or_effect_free(conversion.converted)
}

func is_a_quiet_making(made: HighIntermediaryRepresentation.Values.MakeObject): Boolean {
    fallback are_effect_free(made.arguments)
    if program.model.left_out_classes.contains(made.value_type.name) {
        return true
    }
    var no_bound = Dictionary<String, Long>()
    return quiet.is_quiet(made, no_bound)
}

func is_an_item_read(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.function.name == "_read_value" and not call.function.has_a_body()
    fallback is_none_or_effect_free(call.receiver)
    return are_effect_free(call.arguments)
}

func count_the_reads(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(block)
    count_the_assignments(block)
}

func count_the_assignments(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign {
            count_a_read(statement.name)
        } else if statement.class == HighIntermediaryRepresentation.Statements.Block {
            count_the_assignments(statement)
        } else if statement.class == HighIntermediaryRepresentation.Statements.While {
            count_the_assignments(statement.body)
        } else if statement.class == HighIntermediaryRepresentation.Statements.If {
            count_the_assignments_of_an_if(statement)
        }
        index = index + 1
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func count_the_assignments_of_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        count_the_assignments(current.then_branch)
        link = current.else_if()
        if not link {
            count_the_assignments(current.else_branch)
        }
    }
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead and collects_names {
        names_left_unread.append(value.name)
    } else if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        count_a_read(value.name)
    }
    return value
}

func count_a_read(name: String) {
    var count = read_counts[name]
    if count {
        read_counts[name] = count + 1
    } else {
        read_counts[name] = 1
    }
}

func leave_out_unread_declarations(block: HighIntermediaryRepresentation.Statements.Block?): Boolean {
    fallback block
    var changed = false
    var kept = List<SpiteCompiler.Statement>()
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if is_an_unread_declaration(statement) {
            changed = true
            note_what_it_read(statement)
        } else {
            if leave_out_unread_inside(statement) {
                changed = true
            }
            kept.append(statement)
        }
        index = index + 1
    }
    block.statements = kept
    return changed
}

func leave_out_unread_inside(statement: SpiteCompiler.Statement): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Block {
        return leave_out_unread_declarations(statement)
    }
    if statement.class == HighIntermediaryRepresentation.Statements.While {
        return leave_out_unread_declarations(statement.body)
    }
    if statement.class == HighIntermediaryRepresentation.Statements.If {
        return leave_out_unread_of_an_if(statement)
    }
    return false
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func leave_out_unread_of_an_if(branch: HighIntermediaryRepresentation.Statements.If): Boolean {
    var changed = false
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        if leave_out_unread_declarations(current.then_branch) {
            changed = true
        }
        link = current.else_if()
        if not link and leave_out_unread_declarations(current.else_branch) {
            changed = true
        }
    }
    return changed
}

func is_an_unread_declaration(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    fallback names_left_unread.contains(statement.name) and not read_counts.contains(statement.name)
    return is_none_or_effect_free(statement.value)
}

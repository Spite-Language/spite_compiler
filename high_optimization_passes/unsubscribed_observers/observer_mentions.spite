# ../../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told

var no_program = Model.ProgramModel()
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var classes = ObserverClasses(no_high)

func ObserverMentions(starting_classes: ObserverClasses) {
    classes = starting_classes
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    classes.note_a_type(value.value_type)
    if value.class == HighIntermediaryRepresentation.Values.Call {
        var owner = Model.Type('object', value.function.owner)
        classes.note_a_type(owner)
    }
    return value
}

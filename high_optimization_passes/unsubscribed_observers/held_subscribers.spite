# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back

var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var library = Mapping.LibraryFile()
var handing_keys = List<String>()
var handing_positions = List<Integer>()
var current: HighIntermediaryRepresentation.HighFunction? = null
var is_marking = false
var found_more = false

func HeldSubscribers(high: HighIntermediaryRepresentation.HighProgram) {
    program = high
}

# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func hold_the_owners_back() {
    program.built_functions.each(note_an_observer_entry)
    fallback not handing_keys.is_empty()
    found_more = true
    while found_more {
        found_more = false
        program.built_functions.each(note_the_handing)
    }
    is_marking = true
    program.built_functions.each(note_the_handing)
}

func note_an_observer_entry(built: HighIntermediaryRepresentation.HighFunction) {
    var name = built.function.name
    fallback name == "subscribe" or name == "unsubscribe"
    var owner = program.model.class_named(built.function.owner)
    fallback owner and owner.shown.starts_with("Observer<") and library.holds(owner.file.path)
    var key = built.function.key()
    note_a_handing(key, 0)
}

func note_a_handing(key: String, position: Integer) {
    fallback not hands_on(key, position)
    handing_keys.append(key)
    handing_positions.append(position)
    found_more = true
}

func hands_on(key: String, position: Integer): Boolean {
    var index = 0
    while index < handing_keys.count() {
        if handing_keys[index] == key and handing_positions[index] == position {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_handing(built: HighIntermediaryRepresentation.HighFunction) {
    current = built
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(built.body)
}

func rewritten(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        note_a_call(value)
    }
    return value
}

func note_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var key = call.function.key()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if hands_on(key, index) {
            note_a_handed_argument(argument)
        }
        index = index + 1
    }
}

func note_a_handed_argument(argument: SpiteCompiler.Value) {
    if is_marking {
        hold_back(argument)
        return
    }
    fallback argument.class == HighIntermediaryRepresentation.Values.LocalRead
    crash current
    var parameters = current.function.parameters
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        if parameter.name == argument.name {
            var key = current.function.key()
            note_a_handing(key, index)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func hold_back(argument: SpiteCompiler.Value) {
    if argument.class == HighIntermediaryRepresentation.Values.Conversion {
        fallback argument.converted
        hold_back(argument.converted)
        return
    }
    fallback argument.class == HighIntermediaryRepresentation.Values.Function.Value
    fallback not argument.function.answer and argument.receiver
    var receiver_type = argument.receiver.value_type
    fallback receiver_type.kind == 'object' and receiver_type.name != "String"
    var owner = program.model.class_named(receiver_type.name)
    fallback owner and not owner.is_singleton and owner.key != program.model.entry
    argument.holds_its_receiver_back = true
    argument.holds_its_owner_for_the_call = true
    argument.skips_a_freed_owner = true
    fallback not program.model.owners_held_by_observers.contains(owner.key)
    program.model.owners_held_by_observers.append(owner.key)
}

var path = ""
var line = 0
var class_shown = ""
var known_function_name = ""
var walks = List<AbstractSyntaxTree.Walk.Walk>()

func Place(
    starting_path: String,
    starting_line: Integer,
    starting_class_shown: String,
    starting_function_name: String,
    starting_walks: List<AbstractSyntaxTree.Walk.Walk>,
) {
    path = starting_path
    line = starting_line
    class_shown = starting_class_shown
    known_function_name = starting_function_name
    walks = starting_walks
}

# ../../spite_documentation/compiler.md#how-many-errors-are-listed
func function_name(): String {
    if not known_function_name.is_empty() {
        return known_function_name
    }
    var named = ""
    var index = 0
    while index < walks.count() {
        var walk = walks[index]
        if walk.file.path == path {
            named = function_declared_last_before(walk)
        }
        index = index + 1
    }
    return named
}

func function_declared_last_before(walk: AbstractSyntaxTree.Walk.Walk): String {
    var named = ""
    var nearest = 0
    var index = 0
    while index < walk.function_declarations.count() {
        var declaration = walk.function_declarations[index]
        if declaration.line <= line and declaration.line > nearest {
            nearest = declaration.line
            named = declaration.name
        }
        index = index + 1
    }
    return named
}

func class_name(): String {
    var opening = class_shown.index_of("<")
    if opening {
        var sliced = class_shown.slice(0, opening)
        crash sliced
        return sliced
    }
    return class_shown
}

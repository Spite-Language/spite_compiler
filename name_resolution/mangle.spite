var inner = List<String>()

func of(class_name: String, arguments: List<ResolvedType>): String {
    if arguments.count() == 0 {
        return class_name
    }
    inner = List<String>()
    arguments.each(inner_name)
    var joined = inner.join("_of_")
    return "{class_name}_of_{joined}"
}

func name_of(argument: ResolvedType): String {
    if argument.is_a_parameter() {
        return "hole"
    }
    if argument.is_a_member() {
        return "member"
    }
    var name = argument.path.join("_")
    if argument.arguments.count() > 0 {
        inner = List<String>()
        argument.arguments.each(inner_name)
        var joined = inner.join("_of_")
        name = "{name}_of_{joined}"
    }
    if argument.is_nullable {
        name = "{name}_maybe"
    }
    return name
}

func inner_name(argument: ResolvedType) {
    var name = name_of(argument)
    inner.append(name)
}

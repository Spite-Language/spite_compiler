var state = ResolutionState()
var types = Types(state)
var monomorphiser = Instances(state)

func Owners(starting_state: ResolutionState) {
    state = starting_state
    types = Types(starting_state)
    monomorphiser = Instances(starting_state)
}

func range_of_a_template(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return types.range_of(parameter.declared_type)
}

func indexes_by(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String): Boolean {
    var written = indexed.index
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

func template_owner_of(template: Model.FunctionModel, model: Model.ClassModel): Model.Type? {
    if template.inferred_owner {
        return template.inferred_owner
    }
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var range = types.range_of(parameter.declared_type)
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var outer = state.context
    state.context = model
    state.line = declaration.line
    var found: Model.Type? = null
    if range == "Spite.AttributeDeclaration" {
        found = attribute_owner(template, declaration, parameter.name, walk)
    }
    if range == "Spite.FunctionDeclaration" {
        found = function_owner(declaration, parameter.name, walk)
    }
    state.context = outer
    monomorphiser.fill_the_waiting()
    template.inferred_owner = found
    return found
}

func attribute_owner(
    template: Model.FunctionModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var classes = List<Model.Type>()
    note_the_attribute_uses(declaration, name, walk, classes, true)
    note_the_attribute_uses(declaration, name, walk, classes, false)
    if classes.is_empty() {
        return owner_without_a_read(declaration, name, walk)
    }
    var owner = classes[0]
    template.narrowed_names = common_attributes(declaration, name, classes)
    return owner
}

func owner_without_a_read(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var passed = attribute_owner_passed_on(name, walk)
    if passed {
        return passed
    }
    var is_passed_on = state.passing_depth > 0
    fallback not is_passed_on
    var value = name_of_a_class_parameter(declaration, name)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_an_attribute_owner(
        passed,
        is_passed_on,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
        value,
    )
    return null
}

func attribute_owner_passed_on(name: String, walk: AbstractSyntaxTree.Walk.Walk): Model.Type? {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var owner = attribute_owner_in_a_call(expression, name)
            if owner {
                return owner
            }
        }
        index = index + 1
    }
    return null
}

func attribute_owner_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = state.context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and state.passing_depth < 8
        return attribute_owner_in_a_helper(helper, place)
    }
    return null
}

func attribute_owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback types.range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var standing_in = Model.FunctionModel(helper.name, helper.owner)
    state.passing_depth = state.passing_depth + 1
    var found = attribute_owner(standing_in, declaration, parameter.name, walk)
    state.passing_depth = state.passing_depth - 1
    return found
}

func name_of_a_class_parameter(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
): String {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.name != name and parameter.declared_type {
            var given = types.type_of(parameter.declared_type)
            if given.kind == 'object' or given.kind == 'shape' {
                return parameter.name
            }
        }
        index = index + 1
    }
    return "value"
}

func note_the_attribute_uses(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
    on_parameters: Boolean,
) {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression and reads_a_parameter(expression, declaration) == on_parameters {
            note_an_attribute_use(expression, declaration, name, walk, classes)
        }
        index = index + 1
    }
}

func reads_a_parameter(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    var listed = indexed.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var target = listed.target
        if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            var names = declaration.parameters.map_names()
            return names.contains(target.name)
        }
    }
    return false
}

func note_an_attribute_use(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
) {
    fallback indexes_by(indexed, name)
    var listed = indexed.target
    var used: Model.Type? = null
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback listed.name == "attributes"
        used = Model.Type('object', state.context.key)
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name == "attributes"
        used = class_of_a_use(listed.target, declaration, name, walk)
    }
    crash used
    var index = 0
    while index < classes.count() {
        var known = classes[index]
        fallback not known.is_the_same_as(used)
        index = index + 1
    }
    classes.append(used)
}

func class_of_a_use(
    target: SpiteCompiler.Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type {
    var known = class_of_a_value(target, declaration, walk, 0)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_known_value(
        known,
        target,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
    )
    crash known
    return known
}

func class_of_a_value(
    target: SpiteCompiler.Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    fallback depth < 8
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_name(target.name, declaration, walk, depth)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return class_of_a_call(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return class_of_an_element(target, declaration, walk, depth)
    }
    return null
}

func class_of_a_name(
    name: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name == name and parameter.declared_type {
            return types.type_of(parameter.declared_type)
        }
        parameter_index = parameter_index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return class_of_a_local(statement, declaration, walk, depth)
        }
        statement_index = statement_index + 1
    }
    var attribute = state.context.attribute_named(name)
    if attribute {
        return attribute.attribute_type.present()
    }
    return null
}

func class_of_a_local(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    if statement.declared_type {
        return present_type_of(statement.declared_type)
    }
    return class_of_a_value(statement.value, declaration, walk, depth + 1)
}

func present_type_of(written: SpiteCompiler.Type): Model.Type {
    var found = types.type_of(written)
    return found.present()
}

func class_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_called_name(callee)
    }
    return null
}

func class_of_a_called_name(callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): Model.Type? {
    var function = state.context.function_named(callee.name)
    if function {
        return answer_of_a_function(function)
    }
    var first = callee.name.slice(0, 1)
    crash first
    fallback first != first.lower_case()
    var path = List<String>()
    path.append(callee.name)
    return types.type_of_a_path(path, callee.generic_arguments)
}

func answer_of_a_function(function: Model.FunctionModel): Model.Type? {
    if function.answer {
        return function.answer.present()
    }
    return null
}

func class_of_an_element(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var listed = class_of_a_value(indexed.target, declaration, walk, depth + 1)
    fallback listed and listed.kind == 'object'
    var model = state.program.class_named(listed.name)
    fallback model
    var element = model.bound_types["$element_type"]
    if element {
        return element.present()
    }
    var held = model.bound_types["$value_type"]
    if held {
        return held.present()
    }
    return null
}

func common_attributes(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    classes: List<Model.Type>,
): List<String> {
    var common = List<String>()
    if classes.count() < 2 {
        return common
    }
    var owner = classes[0]
    var owner_names = attribute_names_of(owner)
    var index = 0
    while index < owner_names.count() {
        var attribute = owner_names[index]
        if every_class_has(classes, attribute) {
            common.append(attribute)
        }
        index = index + 1
    }
    var second = classes[1]
    var first_shown = types.shown_type(owner)
    var second_shown = types.shown_type(second)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_common_attribute(
        common,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
        first_shown,
        second_shown,
    )
    return common
}

func every_class_has(classes: List<Model.Type>, attribute: String): Boolean {
    var index = 1
    while index < classes.count() {
        var other = classes[index]
        var names = attribute_names_of(other)
        fallback names.contains(attribute)
        index = index + 1
    }
    return true
}

func attribute_names_of(of_type: Model.Type): List<String> {
    if of_type.kind == 'shape' {
        return shape_attribute_names(of_type)
    }
    var model = state.program.class_named(of_type.name)
    fallback model
    return model.declared_attributes.map_names()
}

func shape_attribute_names(of_type: Model.Type): List<String> {
    var shape = state.program.shape_keyed(of_type.name)
    fallback shape
    return shape.members.filter_is_an_attribute().map_names()
}

func function_owner(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var owner: Model.Type? = null
    var index = 0
    while not owner and index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            owner = owner_of_a_pattern_use(expression, declaration, name, walk)
        }
        index = index + 1
    }
    var is_passed_on = state.passing_depth > 0
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_function_owner(
        owner,
        is_passed_on,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
    )
    return owner
}

func owner_of_a_pattern_use(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var called = owner_of_a_pattern_call(call, declaration, name, walk)
    if called {
        return called
    }
    var written = owner_of_a_written_pattern(call, name)
    if written {
        return written
    }
    return owner_passed_on(call, name)
}

func owner_of_a_written_pattern(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var pattern = written_pattern_of(call, name)
        fallback not pattern.is_empty()
        var path = class_path_named(callee.target)
        fallback not path.is_empty()
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var walked = types.type_of_a_path(path, no_arguments)
        return Model.Type('parameters', "{walked.name}|{pattern}")
    }
    return null
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): String {
    var hole = "<{name}>"
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = text_of_a_literal(argument)
            if text.contains(hole) {
                return text.replace(hole, name)
            }
        }
        index = index + 1
    }
    return ""
}

func text_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var pieces = literal.pieces.map_texts()
    return pieces.join("")
}

func class_path_named(target: SpiteCompiler.Expression?): List<String> {
    var path = List<String>()
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var initial = target.name.slice(0, 1)
        crash initial
        if target.name.starts_with("$") or initial != initial.lower_case() {
            path.append(target.name)
        }
    }
    return path
}

func owner_passed_on(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = state.context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and state.passing_depth < 8
        return owner_in_a_helper(helper, place)
    }
    return null
}

func owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback types.range_of(parameter.declared_type) == "Spite.FunctionDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    state.passing_depth = state.passing_depth + 1
    var found = function_owner(declaration, parameter.name, walk)
    state.passing_depth = state.passing_depth - 1
    return found
}

func place_of_the_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Integer {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and argument.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func owner_of_a_pattern_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var words = callee.name.split("_")
        if words.contains(name) {
            var walked = class_of_a_use(callee.target, declaration, name, walk)
            return Model.Type('parameters', "{walked.name}|{callee.name}")
        }
    }
    return null
}

func function_of_parameters(owner: Model.Type): Model.FunctionModel? {
    var parts = owner.name.split("|")
    var class_key = parts[0]
    var function_name = parts[1]
    crash class_key
    crash function_name
    var walked_class = state.program.class_named(class_key)
    fallback walked_class
    return walked_class.function_named(function_name)
}

var state = ResolutionState()

func SameMembers(starting_state: ResolutionState) {
    state = starting_state
}

# ../../spite_spec/specs/values_and_types.md#unions-in-full
func same_member_type(given: Model.Type): Model.Type {
    if given.kind != 'union' and given.kind != 'shape' {
        return given
    }
    var members = written_members_of(given)
    if members.is_empty() {
        return given
    }
    var index = 0
    while index < state.first_types.count() {
        var first = state.first_types[index]
        var first_members = state.first_type_members[index]
        crash first_members
        if first.kind == given.kind and has_the_same_members(members, first_members) {
            var copy = first.present()
            copy.written_name = given.name
            if given.is_nullable {
                return copy.nullable()
            }
            return copy
        }
        index = index + 1
    }
    var present = given.present()
    state.first_types.append(present)
    state.first_type_members.append(members)
    return given
}

func has_the_same_members(members: List<String>, others: List<String>): Boolean {
    fallback members.count() == others.count()
    var index = 0
    while index < members.count() {
        var member = members[index]
        fallback others.contains(member)
        index = index + 1
    }
    return true
}

func written_members_of(declared: Model.Type): List<String> {
    var members = List<String>()
    var parts = declared.name.split(".")
    var simple = parts.remove_last()
    crash simple
    var owner_key = parts.join(".")
    var owner = state.program.class_named(owner_key)
    if not owner {
        return members
    }
    var index = 0
    while index < owner.file.declarations.count() {
        var declaration = owner.file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration and declaration.name == simple {
            add_the_written_members(members, declaration, owner)
        }
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration and declaration.name == simple {
            add_the_written_signatures(members, declaration)
        }
        index = index + 1
    }
    return members
}

func add_the_written_members(
    members: List<String>,
    declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration,
    owner: Model.ClassModel,
) {
    var index = 0
    while index < declaration.member_names.count() {
        var written = declaration.member_names[index]
        var found = state.symbols.find(written, owner.file.namespace)
        if found {
            members.append(found.namespace)
        } else {
            members.append(written)
        }
        index = index + 1
    }
}

func add_the_written_signatures(
    members: List<String>,
    declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration,
) {
    var index = 0
    while index < declaration.members.count() {
        var member = declaration.members[index]
        var written = List<String>()
        var parameter_index = 0
        while parameter_index < member.parameters.count() {
            var parameter = member.parameters[parameter_index]
            var parameter_text = written_type_text(parameter.declared_type)
            written.append(parameter_text)
            parameter_index = parameter_index + 1
        }
        var joined = written.join(", ")
        var answer = written_type_text(member.result)
        var signature = "{member.name}({joined}): {answer}"
        if member.is_an_attribute {
            signature = "{member.name}: {answer}"
        }
        members.append(signature)
        index = index + 1
    }
}

func written_type_text(written: SpiteCompiler.Type?): String {
    fallback written
    var printer = Printers.Spite.TypePrinter(written)
    return printer.text()
}

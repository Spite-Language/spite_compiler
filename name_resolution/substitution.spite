var pairs = Dictionary<String, ResolvedType>()
var arguments = List<ResolvedType>()

func bind(name: String, shape: ResolvedType) {
    pairs[name] = shape
}

func lookup(name: String): ResolvedType? {
    return pairs[name]
}

func is_empty(): Boolean {
    return pairs.count() == 0
}

func count(): Integer {
    return pairs.count()
}

func apply(shape: ResolvedType): ResolvedType {
    if shape.is_a_parameter() {
        return apply_parameter(shape)
    }
    if shape.is_a_member() {
        return shape
    }
    return apply_arguments(shape)
}

func apply_parameter(shape: ResolvedType): ResolvedType {
    var name = shape.path.join(".")
    var bound = pairs[name]
    if bound {
        return bound
    } else {
        return shape
    }
}

func apply_arguments(shape: ResolvedType): ResolvedType {
    var outer = arguments
    arguments = List<ResolvedType>()
    shape.arguments.each(apply_argument)
    var built = arguments
    arguments = outer
    return shape.with(shape.path, built, shape.is_nullable)
}

func apply_argument(argument: ResolvedType) {
    var applied = apply(argument)
    arguments.append(applied)
}

var no_folders = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(no_folders)
var folder = ""
var flags = Dictionary<String, String>()
var written_flags = List<String>()
var bare_flags = List<String>()
var resolver = Resolver(symbols)

func NameResolution(
    starting_symbols: Symbols.SymbolTable,
    starting_folder: String,
    starting_flags: Dictionary<String, String>,
    starting_written: List<String>,
    starting_bare: List<String>,
) {
    symbols = starting_symbols
    folder = starting_folder
    flags = starting_flags
    written_flags = starting_written
    bare_flags = starting_bare
}

func run(): Model.ProgramModel {
    resolver = Resolver(symbols)
    var entry = symbols.class_file_for(symbols.entry_path)
    crash entry
    var model = resolver.resolve(entry)
    var circles = Validators.NameResolution.SingletonCircle.Validator()
    circles.check(model)
    var build = resolver.class_model_named("Build")
    var environment = model.class_named("Environment")
    var known = Validators.CommandLine.KnownFlag.Validator()
    known.check(flags, written_flags, bare_flags, build, environment)
    var settings_rules = Validators.NameResolution.Settings.Validator()
    settings_rules.check(folder, build, environment)
    return model
}

var state = ResolutionState()
var types = Types(state)
var owners = Owners(state)
var monomorphiser = Instances(state)
var typing = Inference()

func Reading(starting_state: ResolutionState) {
    state = starting_state
    types = Types(starting_state)
    owners = Owners(starting_state)
    monomorphiser = Instances(starting_state)
}

func fill(model: Model.ClassModel) {
    var outer = state.context
    state.context = model
    model.file.declarations.each(read_enum_or_union)
    model.file.declarations.each(read_declaration)
    state.context = outer
}

func read_enum_or_union(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: state.context.is_singleton = true
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return
    }
}

func read_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    var made = Model.EnumModel("{state.context.key}.{declaration.name}", declaration.name)
    var counted: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        if value.number {
            counted = typing.whole_number_of(value.number)
        }
        made.values.append(value.name)
        made.numbers.append(counted)
        counted = counted + 1
        index = index + 1
    }
    state.context.enums.append(made)
}

func read_union_name(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var members = List<Model.Type>()
    var made = Model.UnionModel("{state.context.key}.{declaration.name}", declaration.name, members)
    state.context.unions.append(made)
}

func read_shape_name(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var made = Model.ShapeModel("{state.context.key}.{declaration.name}", declaration.name)
    state.context.shapes.append(made)
    state.program.shapes[made.key] = made
}

func read_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
    }
}

func read_union_members(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    state.line = declaration.line
    var made = state.context.union_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        var path = member.split(".")
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member_type = types.type_of_a_path(path, no_arguments)
        made.members.append(member_type)
        index = index + 1
    }
}

func read_shape_members(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    state.line = declaration.line
    var made = state.context.shape_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.members.count() {
        state.line = declaration.line + index + 1
        var member = declaration.members[index]
        var function = Model.FunctionModel(member.name, made.key)
        function.is_an_attribute = member.is_an_attribute
        state.read_parameters = List<Model.ParameterModel>()
        member.parameters.each(read_parameter)
        function.parameters = state.read_parameters
        if member.result {
            function.answer = types.type_of(member.result)
        }
        read_a_function_member(function)
        made.members.append(function)
        index = index + 1
    }
}

func read_a_function_member(member: Model.FunctionModel) {
    member.is_a_function_member = not member.is_an_attribute
    fallback member.answer and member.is_an_attribute
    var held: Model.Type = member.answer
    fallback held.kind == 'function' and not held.is_nullable
    var signature = held.signature_or_empty()
    var index = 0
    while index < signature.parameters.count() {
        var taken = signature.parameters[index]
        var parameter = Model.ParameterModel("", taken, false)
        member.parameters.append(parameter)
        index = index + 1
    }
    member.answer = signature.answer
    member.is_an_attribute = false
    member.is_a_function_member = true
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    state.line = declaration.line
    var attribute_type = attribute_type_of(declaration)
    var made = Model.AttributeModel(declaration.name, state.context.key, attribute_type, declaration, false)
    state.context.declared_attributes.append(made)
    note_the_room(declaration, attribute_type)
}

func attribute_type_of(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Model.Type {
    if declaration.declared_type {
        return types.type_of(declaration.declared_type)
    }
    var written = typing.written_type_of(declaration.value)
    if written and types.names_a_preset(written) {
        return types.type_of_a_preset(written)
    }
    if written {
        return types.type_of(written)
    }
    var known = typing.literal_type_of(declaration.value)
    var attribute_types = Validators.NameResolution.AttributeType.Validator()
    attribute_types.check(known, state.context.file.path, state.line, state.context.key, declaration.name)
    return types.type_of_a_name(known)
}

func note_the_room(
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    attribute_type: Model.Type,
) {
    fallback attribute_type.name == "Buffer"
    fallback state.context.room_size == 0
    state.context.room_size = typing.room_size_of(declaration.value)
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    state.line = declaration.line
    state.read_function_name = declaration.name
    state.read_function_path = declaration.path
    var key = declaration.declared_key()
    var made = Model.FunctionModel(key, state.context.key)
    made.declaration = declaration
    var simple_name = monomorphiser.simple_name_of(state.context.file)
    var is_constructor = declaration.is_a_constructor_of(simple_name)
    var is_a_conversion = declaration.is_a_conversion()
    var is_a_preset = declaration.is_a_preset_of(simple_name)
    declaration.parameters.each(check_an_old_range)
    var template_index = template_index_of(declaration)
    if template_index >= 0 {
        var collecting = Validators.NameResolution.CollectingTemplate.Validator()
        collecting.check(state.context.shown, declaration, template_index)
        made.declared = Model.DeclaredFunction(is_constructor, is_a_conversion, is_a_preset, -1)
        made.is_a_member_template = true
        made.template_index = template_index
        mark_the_attribute_reads(declaration, template_index)
        state.context.declared_functions.append(made)
        return
    }
    state.read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = state.read_parameters
    var hand_copies = Validators.NameResolution.HandCopy.Validator()
    hand_copies.check(state.context.file, simple_name, declaration)
    var reflected_answer_index = reflected_answer_index_of(declaration)
    made.declared = Model.DeclaredFunction(is_constructor, is_a_conversion, is_a_preset, reflected_answer_index)
    if declaration.result and reflected_answer_index < 0 {
        made.answer = types.type_of(declaration.result)
    }
    state.context.declared_functions.append(made)
}

func reflected_answer_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var result = declaration.result
    if result.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        return reflection_parameter_named(declaration, result.path)
    }
    return -1
}

func reflection_parameter_named(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    path: List<String>,
): Integer {
    var named = path[0]
    if not named or path.count() < 2 {
        return -1
    }
    var reflections = [
        "Spite.Argument"
        "Spite.Attribute"
        "Spite.AttributeDeclaration"
        "Spite.Class"
        "Spite.FunctionDeclaration"
    ]
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var range = types.range_of(parameter.declared_type)
        if parameter.name == named and reflections.contains(range) {
            return index
        }
        index = index + 1
    }
    return -1
}

func check_an_old_range(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var written = parameter.declared_type
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        check_a_written_range(parameter.name, written)
    }
}

func check_a_written_range(name: String, written: AbstractSyntaxTree.Shapes.Types.NamedType) {
    fallback not written.arguments.is_empty()
    var path = written.path.join(".")
    var argument = written.arguments[0]
    var owner = generic_argument_text(argument)
    var symbol_advice = advice_for_a_written_symbol(name, path, owner)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_range(
        name,
        path,
        owner,
        symbol_advice,
        state.read_function_path,
        state.line,
        state.context.shown,
        state.read_function_name,
    )
}

func advice_for_a_written_symbol(name: String, path: String, owner: String): String {
    fallback path == "Symbol"
    return advice_for_a_symbol(name, owner)
}

func generic_argument_text(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument): String {
    var written = argument.type_reference
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        return written.path.join(".")
    }
    return argument.text
}

func advice_for_a_symbol(name: String, owner: String): String {
    var parts = owner.split(".")
    var last_part = parts.last()
    crash last_part
    var initial = last_part.slice(0, 1)
    crash initial
    var names_a_function = parts.count() == 2 and initial == initial.lower_case()
    if names_a_function {
        return advice_for_a_function(name, parts)
    }
    var attribute_advice = "write '{name}: Spite.AttributeDeclaration' and read the attribute as 'value[{name}]' on a value of '{owner}'"
    if owner.starts_with("$") {
        return attribute_advice
    }
    var folder = state.symbols.namespace_folder(owner)
    var named_class = state.symbols.find(owner, state.context.file.namespace)
    if folder and not named_class {
        return "walk the classes of '{owner}' as ordinary code, '{owner}.classes.each({state.read_function_name})', with '{name}: Spite.Class'"
    }
    var declared = types.declared_type_in(parts, state.context)
    if declared and declared.kind == 'enumeration' {
        return "walk the values of '{owner}' as ordinary code, '{owner}.values.each({state.read_function_name})', with '{name}: {owner}'"
    }
    return attribute_advice
}

func advice_for_a_function(name: String, parts: List<String>): String {
    var class_part = parts[0]
    var function_part = parts[1]
    crash class_part
    crash function_part
    var words = function_part.split("_")
    if words.contains(name) {
        return "write '{name}: Spite.FunctionDeclaration' and call the function as 'value.{function_part}(...)' on a value of '{class_part}'"
    }
    var plural = replaced_name_word(state.read_function_name, name, "{name}s")
    return "write '{name}: Spite.Argument' and spread its plural into the call, as in 'value.{function_part}({plural}())'"
}

func replaced_name_word(text: String, word: String, replacement: String): String {
    var words = text.split("_")
    var renamed = List<String>()
    var index = 0
    while index < words.count() {
        var each_word = words[index]
        if each_word == word {
            renamed.append(replacement)
        } else {
            renamed.append(each_word)
        }
        index = index + 1
    }
    return renamed.join("_")
}

func template_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var words = declaration.name.split("_")
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and types.is_a_declaration_type(parameter.declared_type) {
            return index
        }
        index = index + 1
    }
    return -1
}

func mark_the_attribute_reads(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    template_index: Integer,
) {
    var parameter = declaration.parameters[template_index]
    crash parameter
    fallback types.range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
            mark_an_attribute_read(expression, parameter.name)
        }
        index = index + 1
    }
}

func mark_an_attribute_read(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String) {
    fallback owners.indexes_by(indexed, name)
    var target = indexed.target
    crash target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback target.name != "attributes"
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback target.name != "attributes"
        fallback not names_a_key_map(target.name)
    }
    var listed = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, "attributes")
    indexed.target = listed
}

func names_a_key_map(name: String): Boolean {
    var attribute = state.context.attribute_named(name)
    fallback attribute
    var model = state.program.class_named(attribute.attribute_type.name)
    fallback model
    var key_type = model.bound_types["$key_type"]
    fallback key_type
    return key_type.name == "Spite.AttributeDeclaration"
}

func specialized(
    template: Model.FunctionModel,
    called_name: String,
    member: String,
    member_type: Model.Type,
    is_a_function: Boolean,
    model: Model.ClassModel,
): Model.FunctionModel {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var made = Model.FunctionModel(called_name, template.owner)
    made.declaration = declaration
    made.bound_member = member
    made.bound_member_type = member_type
    made.bound_member_is_a_function = is_a_function
    made.template_index = template.template_index
    var outer_name = state.bound_member_name
    var outer_type = state.bound_member_type
    var outer_is_a_class = state.bound_member_is_a_class
    var outer = state.context
    state.context = model
    state.line = declaration.line
    bind_member(declaration, template.template_index, member_type)
    made.bound_parameter = state.bound_member_name
    state.read_parameters = List<Model.ParameterModel>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if index != template.template_index {
            read_parameter(parameter)
        }
        index = index + 1
    }
    made.parameters = state.read_parameters
    if declaration.result {
        made.answer = types.type_of(declaration.result)
    }
    state.bound_member_name = outer_name
    state.bound_member_type = outer_type
    state.bound_member_is_a_class = outer_is_a_class
    state.context = outer
    monomorphiser.fill_the_waiting()
    return made
}

# ../../spite_documentation/reflection.md#spitefunctiondeclaration
func read_as_a_walker(template: Model.FunctionModel, made: Model.FunctionModel, model: Model.ClassModel) {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var outer = state.context
    state.context = model
    state.line = declaration.line
    state.read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = state.read_parameters
    if declaration.result {
        made.answer = types.type_of(declaration.result)
    }
    state.context = outer
    monomorphiser.fill_the_waiting()
}

func bind_member(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    parameter_index: Integer,
    member_type: Model.Type,
) {
    var parameter = declaration.parameters[parameter_index]
    crash parameter
    state.bound_member_name = parameter.name
    state.bound_member_type = member_type
    state.bound_member_is_a_class = types.range_of(parameter.declared_type) == "Spite.Class"
}

func unbind_member() {
    state.bound_member_name = ""
    state.bound_member_type = null
    state.bound_member_is_a_class = false
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    crash parameter.declared_type
    var collecting = state.read_parameters
    var parameter_type = types.type_of(parameter.declared_type)
    state.read_parameters = collecting
    var made = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
    state.read_parameters.append(made)
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

func whole_number_of(expression: Expression?): Long {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        var read: Long? = expression.text
        crash read
        return read
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        var zero: Long = 0
        var positive = whole_number_of(expression.operand)
        return zero - positive
    }
    crash
    return 0
}

func written_type_of(
    expression: Expression?,
): Type? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return constructed_type_of(expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return list_type_of(expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        return dictionary_type_of(expression)
    }
    return null
}

func dictionary_type_of(
    dictionary: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
): Type? {
    var first = dictionary.pairs[0]
    fallback first
    if first.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        return dictionary_type_from(first)
    }
    return null
}

func dictionary_type_from(
    first: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
): Type? {
    var key = literal_type_of(first.key)
    var value = literal_type_of(first.value)
    fallback not key.is_empty() and not value.is_empty()
    var key_argument = plain_argument(key)
    var value_argument = plain_argument(value)
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    arguments.append(key_argument)
    arguments.append(value_argument)
    var dictionary_path = List<String>()
    dictionary_path.append("Dictionary")
    return AbstractSyntaxTree.Shapes.Types.NamedType(dictionary_path, arguments)
}

func plain_argument(name: String): AbstractSyntaxTree.Shapes.Types.GenericArgument {
    var path = List<String>()
    path.append(name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var named = AbstractSyntaxTree.Shapes.Types.NamedType(path, no_arguments)
    var argument = AbstractSyntaxTree.Shapes.Types.GenericArgument(true, name)
    argument.of_type(named)
    return argument
}

func constructed_type_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Type? {
    var path = class_path_of(call.callee)
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and callee.name.starts_with("$") {
        path.append(callee.name)
    }
    fallback not path.is_empty()
    return AbstractSyntaxTree.Shapes.Types.NamedType(path, call.generic_arguments)
}

func class_path_of(expression: Expression?): List<String> {
    var path = List<String>()
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if expression.is_a_class_name {
            path.append(expression.name)
        }
        return path
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return class_path_of_a_member(expression)
    }
    return path
}

func class_path_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): List<String> {
    var path = class_path_of(member.target)
    if member.is_a_class_name and not path.is_empty() {
        path.append(member.name)
        return path
    }
    return List<String>()
}

func list_type_of(list: AbstractSyntaxTree.Shapes.Expressions.ListLiteral): Type? {
    var first = list.entries[0]
    fallback first
    var argument = element_argument_of(first)
    fallback argument
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    arguments.append(argument)
    var list_path = List<String>()
    list_path.append("List")
    return AbstractSyntaxTree.Shapes.Types.NamedType(list_path, arguments)
}

func element_argument_of(
    first: Expression,
): AbstractSyntaxTree.Shapes.Types.GenericArgument? {
    if first.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return constructed_argument_of(first)
    }
    var element = literal_type_of(first)
    fallback not element.is_empty()
    return plain_argument(element)
}

func constructed_argument_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): AbstractSyntaxTree.Shapes.Types.GenericArgument? {
    var path = class_path_of(call.callee)
    if path.is_empty() {
        var asked = literal_type_of(call)
        fallback not asked.is_empty()
        return plain_argument(asked)
    }
    var constructed = AbstractSyntaxTree.Shapes.Types.NamedType(path, call.generic_arguments)
    var shown = path.join(".")
    var made = AbstractSyntaxTree.Shapes.Types.GenericArgument(true, shown)
    made.of_type(constructed)
    return made
}

func literal_type_of(expression: Expression?): String {
    fallback expression
    return literal_type_of_a_present(expression)
}

func literal_type_of_a_present(expression: Expression): String {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return type_of_a_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return "String"
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return literal_type_of(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return question_type_of(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return class_flag_type_of(expression)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return ""
    }
}

func class_flag_type_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var target = member.target
    var names_a_codegen_value = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_a_codegen_value = target.name.starts_with("$")
    }
    var flags = ["is_singleton", "is_optional", "is_enum", "is_stateful", "is_fixed_size", "is_list", "is_dictionary", "is_number"]
    if names_a_codegen_value and flags.contains(member.name) {
        return "Boolean"
    }
    return ""
}

func question_type_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    var asked = ""
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        asked = callee.name
    }
    if asked == "argument_count" {
        return "Integer"
    }
    var answers_yes_or_no = asked == "has_function" or asked == "function_waits" or asked == "function_writes_parameter"
    if answers_yes_or_no {
        return "Boolean"
    }
    return ""
}

func type_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    switch literal.kind {
        'integer_literal': return "Integer"
        'decimal_literal': return "Float"
        'keyword_true': return "Boolean"
        'keyword_false': return "Boolean"
        'end_of_file': return ""
        'name': return ""
        'class_name': return ""
        'generic_name': return ""
        'text_literal': return ""
        'symbol_literal': return ""
        'open_brace': return ""
        'close_brace': return ""
        'open_parenthesis': return ""
        'close_parenthesis': return ""
        'open_bracket': return ""
        'close_bracket': return ""
        'comma': return ""
        'dot': return ""
        'dots': return ""
        'colon': return ""
        'question': return ""
        'equals': return ""
        'plus': return ""
        'minus': return ""
        'star': return ""
        'slash': return ""
        'percent': return ""
        'equal_equal': return ""
        'not_equal': return ""
        'less': return ""
        'greater': return ""
        'less_or_equal': return ""
        'greater_or_equal': return ""
        'and': return ""
        'or': return ""
        'not': return ""
        'keyword_function': return ""
        'keyword_variable': return ""
        'keyword_enum': return ""
        'keyword_union': return ""
        'keyword_type': return ""
        'keyword_return': return ""
        'keyword_if': return ""
        'keyword_else': return ""
        'keyword_while': return ""
        'keyword_switch': return ""
        'keyword_fallback': return ""
        'keyword_crash': return ""
        'keyword_load': return ""
        'keyword_this': return ""
        'keyword_null': return ""
        'keyword_generic': return ""
        'keyword_singleton': return ""
    }
}

func room_size_of(expression: Expression?): Integer {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var size = expression.arguments.first()
        if size {
            return whole_number_of(size)
        }
    }
    return 0
}

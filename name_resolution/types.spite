var no_arguments = List<ResolvedType>()
var given = List<ResolvedType>()

func parameter(name: String): ResolvedType {
    var path = List<String>()
    path.append(name)
    return ResolvedType(path, no_arguments, false, "parameter")
}

func value(text: String): ResolvedType {
    var path = List<String>()
    path.append(text)
    return ResolvedType(path, no_arguments, false, "value")
}

func named(starting_path: List<String>, starting_arguments: List<ResolvedType>): ResolvedType {
    return ResolvedType(starting_path, starting_arguments, false, "named")
}

func member(owner: String, member_name: String, owning: ResolvedType?): ResolvedType {
    var path = List<String>()
    path.append(owner)
    path.append(member_name)
    var written = ResolvedType(path, no_arguments, false, "member")
    written.owner_type = owning
    return written
}

func convert(shape: AbstractSyntaxTree.Shapes.Types.Type): ResolvedType {
    var named_shape = shape
    var segments = named_shape.path
    var outer = given
    given = List<ResolvedType>()
    named_shape.arguments.each(convert_argument)
    var mine = given
    given = outer
    return convert_path(segments, mine)
}

func convert_path(segments: List<String>, mine: List<ResolvedType>): ResolvedType {
    if segments.count() == 1 {
        return convert_one(segments, mine)
    } else {
        return convert_member(segments)
    }
}

func convert_one(segments: List<String>, mine: List<ResolvedType>): ResolvedType {
    var first = segments[0]
    crash first
    if first.starts_with("$") {
        return parameter(first)
    } else {
        return named(segments, mine)
    }
}

func convert_member(segments: List<String>): ResolvedType {
    var owner = segments[0]
    crash owner
    var member_name = segments[1]
    crash member_name
    return member(owner, member_name, null)
}

func convert_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.is_type {
        convert_type_argument(argument)
    } else {
        var written = value(argument.text)
        given.append(written)
    }
}

func convert_type_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.type_reference {
        var written = convert(argument.type_reference)
        given.append(written)
    } else {
        var written = value("")
        given.append(written)
    }
}

func written_of(shape: AbstractSyntaxTree.Shapes.Types.Type, substitution: Substitution): String {
    var written = convert(shape)
    var applied = substitution.apply(written)
    return applied.written()
}

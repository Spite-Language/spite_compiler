union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var empty_map = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(empty_map)
var program = Model.ProgramModel()
var waiting = List<Model.ClassModel>()
var scalars = Model.Scalars()
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Model.ClassModel("", "", empty_file)
var line = 0
var resolved_arguments = List<Model.Type>()
var read_parameters = List<Model.ParameterModel>()
var typing = Inference()
var bound_member_name = ""
var bound_member_type: Model.Type? = null
var bound_member_is_a_class = false
var read_function_name = ""
var building_function_name = ""
var typing_function_name = ""
var read_function_path = ""
var passing_depth = 0
var first_types = List<Model.Type>()
var first_type_members = List<List<String>>()

func Resolver(starting_symbols: Symbols.SymbolTable) {
    symbols = starting_symbols
}

func resolve(entry: Mapping.ClassFile): Model.ProgramModel {
    program.entry = entry.namespace
    var paths = symbols.read_paths()
    paths.each(add_a_plain_class)
    fill_the_waiting()
    return program
}

func fill_the_waiting() {
    while not waiting.is_empty() {
        var next = waiting.remove_first()
        crash next
        fill(next)
    }
}

func type_in(written: Type, model: Model.ClassModel, at_line: Integer): Model.Type {
    var outer = context
    context = model
    line = at_line
    typing_function_name = building_function_name
    var found = type_of(written)
    typing_function_name = ""
    context = outer
    fill_the_waiting()
    return found
}

func class_type_in(
    path: List<String>,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    model: Model.ClassModel,
    at_line: Integer,
): Model.Type {
    var outer = context
    context = model
    line = at_line
    typing_function_name = building_function_name
    var found = type_of_a_path(path, arguments)
    typing_function_name = ""
    context = outer
    fill_the_waiting()
    return found
}

func add_a_plain_class(path: String) {
    var class_file = symbols.class_file_for(path)
    var file = symbols.file_for(path)
    crash class_file
    crash file
    fallback not is_a_template(file)
    fallback not program.has(class_file.namespace)
    var model = Model.ClassModel(class_file.namespace, class_file.namespace, file)
    program.add(model)
    waiting.append(model)
}

func is_a_template(file: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    var names = generic_names_of(file)
    return not names.is_empty()
}

func generic_names_of(file: AbstractSyntaxTree.Shapes.SourceFile): List<String> {
    var found = List<String>()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
            found.append(declaration.name)
        }
        index = index + 1
    }
    return found
}

func fill(model: Model.ClassModel) {
    var outer = context
    context = model
    model.file.declarations.each(read_enum_or_union)
    model.file.declarations.each(read_declaration)
    context = outer
}

func read_enum_or_union(declaration: Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: context.is_singleton = true
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_name(declaration)
        _: return
    }
}

func read_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    var made = Model.EnumModel("{context.key}.{declaration.name}", declaration.name)
    var counted: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        if value.number {
            counted = typing.whole_number_of(value.number)
        }
        made.values.append(value.name)
        made.numbers.append(counted)
        counted = counted + 1
        index = index + 1
    }
    context.enums.append(made)
}

func read_union_name(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var made = Model.UnionModel("{context.key}.{declaration.name}", declaration.name)
    context.unions.append(made)
}

func read_shape_name(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var made = Model.ShapeModel("{context.key}.{declaration.name}", declaration.name)
    context.shapes.append(made)
    program.shapes[made.key] = made
}

func read_declaration(declaration: Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
        _: return
    }
}

func read_union_members(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    line = declaration.line
    var made = context.union_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        var path = member.split(".")
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member_type = type_of_a_path(path, no_arguments)
        made.members.append(member_type)
        index = index + 1
    }
}

func read_shape_members(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    line = declaration.line
    var made = context.shape_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.members.count() {
        line = declaration.line + index + 1
        var member = declaration.members[index]
        var function = Model.FunctionModel(member.name, made.key)
        function.is_an_attribute = member.is_an_attribute
        read_parameters = List<Model.ParameterModel>()
        member.parameters.each(read_parameter)
        function.parameters = read_parameters
        if member.result {
            function.answer = type_of(member.result)
        }
        made.members.append(function)
        index = index + 1
    }
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    line = declaration.line
    var attribute_type = attribute_type_of(declaration)
    var made = Model.AttributeModel(declaration.name, context.key, attribute_type)
    made.declaration = declaration
    context.declared_attributes.append(made)
    note_the_room(declaration, attribute_type)
}

func attribute_type_of(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Model.Type {
    if declaration.declared_type {
        return type_of(declaration.declared_type)
    }
    var written = typing.written_type_of(declaration.value)
    if written {
        return type_of(written)
    }
    var known = typing.literal_type_of(declaration.value)
    if not known.is_empty() {
        return type_of_a_name(known)
    }
    var attribute_types = Validators.NameResolution.AttributeType.Validator()
    attribute_types.refuse(context.file.path, line, context.key, declaration.name)
    return Model.Type('nothing', "")
}

func note_the_room(
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    attribute_type: Model.Type,
) {
    fallback attribute_type.name == "Buffer"
    fallback context.room_size == 0
    context.room_size = typing.room_size_of(declaration.value)
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    line = declaration.line
    read_function_name = declaration.name
    read_function_path = declaration.path
    var made = Model.FunctionModel(declaration.name, context.key)
    made.declaration = declaration
    var simple_name = simple_name_of(context.file)
    made.is_constructor = declaration.name == simple_name
    declaration.parameters.each(refuse_an_old_range)
    var template_index = template_index_of(declaration)
    if template_index >= 0 {
        made.is_a_member_template = true
        made.template_index = template_index
        mark_the_attribute_reads(declaration, template_index)
        context.declared_functions.append(made)
        return
    }
    read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = read_parameters
    var hand_copies = Validators.NameResolution.HandCopy.Validator()
    hand_copies.check(context.file, simple_name, declaration)
    made.reflected_answer_index = reflected_answer_index_of(declaration)
    if declaration.result and made.reflected_answer_index < 0 {
        made.answer = type_of(declaration.result)
    }
    context.declared_functions.append(made)
}

func reflected_answer_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var result = declaration.result
    if result == AbstractSyntaxTree.Shapes.Types.NamedType {
        return reflection_parameter_named(declaration, result.path)
    }
    return -1
}

func reflection_parameter_named(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    path: List<String>,
): Integer {
    var named = path[0]
    if not named or path.count() < 2 {
        return -1
    }
    var reflections = [
        "Spite.Argument"
        "Spite.Attribute"
        "Spite.AttributeDeclaration"
        "Spite.Class"
        "Spite.FunctionDeclaration"
    ]
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var range = range_of(parameter.declared_type)
        if parameter.name == named and reflections.contains(range) {
            return index
        }
        index = index + 1
    }
    return -1
}

func refuse_an_old_range(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var written = parameter.declared_type
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        refuse_a_written_range(parameter.name, written)
    }
}

func refuse_a_written_range(name: String, written: AbstractSyntaxTree.Shapes.Types.NamedType) {
    fallback not written.arguments.is_empty()
    var path = written.path.join(".")
    var argument = written.arguments[0]
    var owner = generic_argument_text(argument)
    var refusal = Validators.NameResolution.TemplateRange.Validator()
    if path == "Symbol" {
        var symbol_advice = advice_for_a_symbol(name, owner)
        refusal.refuse_a_symbol(read_function_path, line, context.shown, read_function_name, name, owner, symbol_advice)
    }
    var ranges = ["Spite.AttributeDeclaration", "Spite.Attribute", "Spite.FunctionDeclaration", "Spite.Argument"]
    fallback ranges.contains(path)
    var advice = "write '{name}: Spite.AttributeDeclaration' and read it as 'value[{name}]' on a value of '{owner}'"
    if path == "Spite.FunctionDeclaration" {
        advice = "write '{name}: Spite.FunctionDeclaration' and call the function on a value of '{owner}', as in 'value.{name}_each(...)'"
    }
    if path == "Spite.Argument" {
        advice = "write '{name}: Spite.Argument' and spread its plural into a call of the function whose arguments it walks"
    }
    refusal.refuse_a_written_owner(
        read_function_path,
        line,
        context.shown,
        read_function_name,
        name,
        path,
        owner,
        advice,
    )
}

func generic_argument_text(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument): String {
    var written = argument.type_reference
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        return written.path.join(".")
    }
    return argument.text
}

func advice_for_a_symbol(name: String, owner: String): String {
    var parts = owner.split(".")
    var last_part = parts.last()
    crash last_part
    var initial = last_part.slice(0, 1)
    crash initial
    var names_a_function = parts.count() == 2 and initial == initial.lower_case()
    if names_a_function {
        return advice_for_a_function(name, parts)
    }
    var attribute_advice = "write '{name}: Spite.AttributeDeclaration' and read the attribute as 'value[{name}]' on a value of '{owner}'"
    if owner.starts_with("$") {
        return attribute_advice
    }
    var folder = symbols.namespace_folder(owner)
    var named_class = symbols.find(owner, context.file.namespace)
    if folder and not named_class {
        return "walk the classes of '{owner}' as ordinary code, '{owner}.classes.each({read_function_name})', with '{name}: Spite.Class'"
    }
    var declared = declared_type_in(parts, context)
    if declared and declared.kind == 'enumeration' {
        return "walk the values of '{owner}' as ordinary code, '{owner}.values.each({read_function_name})', with '{name}: {owner}'"
    }
    return attribute_advice
}

func advice_for_a_function(name: String, parts: List<String>): String {
    var class_part = parts[0]
    var function_part = parts[1]
    crash class_part
    crash function_part
    var words = function_part.split("_")
    if words.contains(name) {
        return "write '{name}: Spite.FunctionDeclaration' and call the function as 'value.{function_part}(...)' on a value of '{class_part}'"
    }
    var plural = replaced_name_word(read_function_name, name, "{name}s")
    return "write '{name}: Spite.Argument' and spread its plural into the call, as in 'value.{function_part}({plural}())'"
}

func replaced_name_word(text: String, word: String, replacement: String): String {
    var words = text.split("_")
    var renamed = List<String>()
    var index = 0
    while index < words.count() {
        var each_word = words[index]
        if each_word == word {
            renamed.append(replacement)
        } else {
            renamed.append(each_word)
        }
        index = index + 1
    }
    return renamed.join("_")
}

func template_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var words = declaration.name.split("_")
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and is_a_declaration_type(parameter.declared_type) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_a_declaration_type(written: Type?): Boolean {
    var path = range_of(written)
    var ranges = ["Spite.AttributeDeclaration", "Spite.FunctionDeclaration", "Spite.Argument"]
    return ranges.contains(path)
}

func range_of(written: Type?): String {
    if written == AbstractSyntaxTree.Shapes.Types.NamedType and written.arguments.is_empty() {
        return written.path.join(".")
    }
    return ""
}

func range_of_a_template(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return range_of(parameter.declared_type)
}

func mark_the_attribute_reads(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    template_index: Integer,
) {
    var parameter = declaration.parameters[template_index]
    crash parameter
    fallback range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
            mark_an_attribute_read(expression, parameter.name)
        }
        index = index + 1
    }
}

func mark_an_attribute_read(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String) {
    fallback indexes_by(indexed, name)
    var target = indexed.target
    crash target
    if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback target.name != "attributes"
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback target.name != "attributes"
        fallback not names_a_key_map(target.name)
    }
    var listed = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, "attributes")
    indexed.target = listed
}

func names_a_key_map(name: String): Boolean {
    var attribute = context.attribute_named(name)
    fallback attribute
    var model = program.class_named(attribute.attribute_type.name)
    fallback model
    var key_type = model.bound_types["$key_type"]
    fallback key_type
    return key_type.name == "Spite.AttributeDeclaration"
}

func indexes_by(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String): Boolean {
    var written = indexed.index
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

func template_owner_of(template: Model.FunctionModel, model: Model.ClassModel): Model.Type? {
    if template.inferred_owner {
        return template.inferred_owner
    }
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var range = range_of(parameter.declared_type)
    var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
    walk.read_function(declaration)
    var outer = context
    context = model
    line = declaration.line
    var found: Model.Type? = null
    if range == "Spite.AttributeDeclaration" {
        found = attribute_owner(template, declaration, parameter.name, walk)
    }
    if range == "Spite.FunctionDeclaration" {
        found = function_owner(declaration, parameter.name, walk)
    }
    context = outer
    fill_the_waiting()
    template.inferred_owner = found
    return found
}

func attribute_owner(
    template: Model.FunctionModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var classes = List<Model.Type>()
    note_the_attribute_uses(declaration, name, walk, classes, true)
    note_the_attribute_uses(declaration, name, walk, classes, false)
    if classes.is_empty() {
        return owner_without_a_read(declaration, name, walk)
    }
    var owner = classes[0]
    template.narrowed_names = common_attributes(declaration, name, classes)
    return owner
}

func owner_without_a_read(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var passed = attribute_owner_passed_on(name, walk)
    if passed {
        return passed
    }
    var given = class_of_a_parameter(declaration, name)
    if given {
        return given
    }
    fallback passing_depth == 0
    var refusal = Validators.NameResolution.TemplateRange.Validator()
    refusal.refuse_an_unused_attribute(declaration.path, declaration.line, context.shown, declaration.name, name)
    return null
}

func attribute_owner_passed_on(name: String, walk: AbstractSyntaxTree.Walk.Walk): Model.Type? {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var owner = attribute_owner_in_a_call(expression, name)
            if owner {
                return owner
            }
        }
        index = index + 1
    }
    return null
}

func attribute_owner_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and passing_depth < 8
        return attribute_owner_in_a_helper(helper, place)
    }
    return null
}

func attribute_owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
    walk.read_function(declaration)
    var standing_in = Model.FunctionModel(helper.name, helper.owner)
    passing_depth = passing_depth + 1
    var found = attribute_owner(standing_in, declaration, parameter.name, walk)
    passing_depth = passing_depth - 1
    return found
}

func class_of_a_parameter(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
): Model.Type? {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.name != name and parameter.declared_type {
            var given = type_of(parameter.declared_type)
            if given.kind == 'object' or given.kind == 'shape' {
                return given
            }
        }
        index = index + 1
    }
    return null
}

func note_the_attribute_uses(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
    on_parameters: Boolean,
) {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression and reads_a_parameter(expression, declaration) == on_parameters {
            note_an_attribute_use(expression, declaration, name, walk, classes)
        }
        index = index + 1
    }
}

func reads_a_parameter(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    var listed = indexed.target
    if listed == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var target = listed.target
        if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            var names = declaration.parameters.map_names()
            return names.contains(target.name)
        }
    }
    return false
}

func note_an_attribute_use(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
) {
    fallback indexes_by(indexed, name)
    var listed = indexed.target
    var used: Model.Type? = null
    if listed == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback listed.name == "attributes"
        used = Model.Type('object', context.key)
    }
    if listed == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name == "attributes"
        used = class_of_a_use(listed.target, declaration, name, walk)
    }
    crash used
    var index = 0
    while index < classes.count() {
        var known = classes[index]
        fallback not known.is_the_same_as(used)
        index = index + 1
    }
    classes.append(used)
}

func class_of_a_use(
    target: Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type {
    var known = class_of_a_value(target, declaration, walk, 0)
    if known {
        return known
    }
    crash target
    var printer = Printers.Spite.ExpressionPrinter(target)
    var shown = printer.text()
    var refusal = Validators.NameResolution.TemplateRange.Validator()
    refusal.refuse_an_unknown_value(declaration.path, declaration.line, context.shown, declaration.name, name, shown)
    crash
}

func class_of_a_value(
    target: Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    fallback depth < 8
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_name(target.name, declaration, walk, depth)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return class_of_a_call(target)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return class_of_an_element(target, declaration, walk, depth)
    }
    return null
}

func class_of_a_name(
    name: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name == name and parameter.declared_type {
            return type_of(parameter.declared_type)
        }
        parameter_index = parameter_index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        var statement = found.statement
        if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return class_of_a_local(statement, declaration, walk, depth)
        }
        statement_index = statement_index + 1
    }
    var attribute = context.attribute_named(name)
    if attribute {
        return attribute.attribute_type.present()
    }
    return null
}

func class_of_a_local(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    if statement.declared_type {
        return present_type_of(statement.declared_type)
    }
    return class_of_a_value(statement.value, declaration, walk, depth + 1)
}

func present_type_of(written: Type): Model.Type {
    var found = type_of(written)
    return found.present()
}

func class_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_called_name(callee)
    }
    return null
}

func class_of_a_called_name(callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): Model.Type? {
    var function = context.function_named(callee.name)
    if function {
        return answer_of_a_function(function)
    }
    var first = callee.name.slice(0, 1)
    crash first
    fallback first != first.lower_case()
    var path = List<String>()
    path.append(callee.name)
    return type_of_a_path(path, callee.generic_arguments)
}

func answer_of_a_function(function: Model.FunctionModel): Model.Type? {
    if function.answer {
        return function.answer.present()
    }
    return null
}

func class_of_an_element(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var listed = class_of_a_value(indexed.target, declaration, walk, depth + 1)
    fallback listed and listed.kind == 'object'
    var model = program.class_named(listed.name)
    fallback model
    var element = model.bound_types["$element_type"]
    if element {
        return element.present()
    }
    var held = model.bound_types["$value_type"]
    if held {
        return held.present()
    }
    return null
}

func common_attributes(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    classes: List<Model.Type>,
): List<String> {
    var common = List<String>()
    if classes.count() < 2 {
        return common
    }
    var owner = classes[0]
    var owner_names = attribute_names_of(owner)
    var index = 0
    while index < owner_names.count() {
        var attribute = owner_names[index]
        if every_class_has(classes, attribute) {
            common.append(attribute)
        }
        index = index + 1
    }
    if common.is_empty() {
        var second = classes[1]
        var first_shown = shown_type(owner)
        var second_shown = shown_type(second)
        var refusal = Validators.NameResolution.TemplateRange.Validator()
        refusal.refuse_no_common_attribute(
            declaration.path,
            declaration.line,
            context.shown,
            declaration.name,
            name,
            first_shown,
            second_shown,
        )
    }
    return common
}

func shown_type(of_type: Model.Type): String {
    var model = program.class_named(of_type.name)
    if model {
        return model.shown
    }
    return of_type.name
}

func every_class_has(classes: List<Model.Type>, attribute: String): Boolean {
    var index = 1
    while index < classes.count() {
        var other = classes[index]
        var names = attribute_names_of(other)
        fallback names.contains(attribute)
        index = index + 1
    }
    return true
}

func attribute_names_of(of_type: Model.Type): List<String> {
    if of_type.kind == 'shape' {
        return shape_attribute_names(of_type)
    }
    var model = program.class_named(of_type.name)
    fallback model
    return model.declared_attributes.map_names()
}

func shape_attribute_names(of_type: Model.Type): List<String> {
    var shape = program.shape_keyed(of_type.name)
    fallback shape
    return shape.members.filter_is_an_attribute().map_names()
}

func function_owner(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var owner = owner_of_a_pattern_use(expression, declaration, name, walk)
            if owner {
                return owner
            }
        }
        index = index + 1
    }
    fallback passing_depth == 0
    var refusal = Validators.NameResolution.TemplateRange.Validator()
    refusal.refuse_an_unused_function(declaration.path, declaration.line, context.shown, declaration.name, name)
    return null
}

func owner_of_a_pattern_use(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var called = owner_of_a_pattern_call(call, declaration, name, walk)
    if called {
        return called
    }
    var written = owner_of_a_written_pattern(call, name)
    if written {
        return written
    }
    return owner_passed_on(call, name)
}

func owner_of_a_written_pattern(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var pattern = written_pattern_of(call, name)
        fallback not pattern.is_empty()
        var path = class_path_named(callee.target)
        fallback not path.is_empty()
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var walked = type_of_a_path(path, no_arguments)
        return Model.Type('parameters', "{walked.name}|{pattern}")
    }
    return null
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): String {
    var hole = "<{name}>"
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = text_of_a_literal(argument)
            if text.contains(hole) {
                return text.replace(hole, name)
            }
        }
        index = index + 1
    }
    return ""
}

func text_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var pieces = literal.pieces.map_texts()
    return pieces.join("")
}

func class_path_named(target: Expression?): List<String> {
    var path = List<String>()
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var initial = target.name.slice(0, 1)
        crash initial
        if target.name.starts_with("$") or initial != initial.lower_case() {
            path.append(target.name)
        }
    }
    return path
}

func owner_passed_on(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and passing_depth < 8
        return owner_in_a_helper(helper, place)
    }
    return null
}

func owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback range_of(parameter.declared_type) == "Spite.FunctionDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
    walk.read_function(declaration)
    passing_depth = passing_depth + 1
    var found = function_owner(declaration, parameter.name, walk)
    passing_depth = passing_depth - 1
    return found
}

func place_of_the_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Integer {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and argument.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func owner_of_a_pattern_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var words = callee.name.split("_")
        if words.contains(name) {
            var walked = class_of_a_use(callee.target, declaration, name, walk)
            return Model.Type('parameters', "{walked.name}|{callee.name}")
        }
    }
    return null
}

func function_of_parameters(owner: Model.Type): Model.FunctionModel? {
    var parts = owner.name.split("|")
    var class_key = parts[0]
    var function_name = parts[1]
    crash class_key
    crash function_name
    var walked_class = program.class_named(class_key)
    fallback walked_class
    return walked_class.function_named(function_name)
}

func specialized(
    template: Model.FunctionModel,
    called_name: String,
    member: String,
    member_type: Model.Type,
    is_a_function: Boolean,
    model: Model.ClassModel,
): Model.FunctionModel {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var made = Model.FunctionModel(called_name, template.owner)
    made.declaration = declaration
    made.bound_member = member
    made.bound_member_type = member_type
    made.bound_member_is_a_function = is_a_function
    made.template_index = template.template_index
    var outer_name = bound_member_name
    var outer_type = bound_member_type
    var outer_is_a_class = bound_member_is_a_class
    var outer = context
    context = model
    line = declaration.line
    bind_member(declaration, template.template_index, member_type)
    made.bound_parameter = bound_member_name
    read_parameters = List<Model.ParameterModel>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if index != template.template_index {
            read_parameter(parameter)
        }
        index = index + 1
    }
    made.parameters = read_parameters
    if declaration.result {
        made.answer = type_of(declaration.result)
    }
    bound_member_name = outer_name
    bound_member_type = outer_type
    bound_member_is_a_class = outer_is_a_class
    context = outer
    fill_the_waiting()
    return made
}

func bind_member(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    parameter_index: Integer,
    member_type: Model.Type,
) {
    var parameter = declaration.parameters[parameter_index]
    crash parameter
    bound_member_name = parameter.name
    bound_member_type = member_type
    bound_member_is_a_class = range_of(parameter.declared_type) == "Spite.Class"
}

func unbind_member() {
    bound_member_name = ""
    bound_member_type = null
    bound_member_is_a_class = false
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    crash parameter.declared_type
    var collecting = read_parameters
    var parameter_type = type_of(parameter.declared_type)
    read_parameters = collecting
    var made = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
    read_parameters.append(made)
}

func simple_name_of(file: AbstractSyntaxTree.Shapes.SourceFile): String {
    var names = Mapping.Names()
    var segment = names.last_segment(file.path)
    var extension_length = 6
    var base_length = segment.length() - extension_length
    fallback base_length >= 0
    var base = segment.slice(0, base_length)
    crash base
    return names.class_name_of(base)
}

func type_of(written: Type): Model.Type {
    switch written {
        AbstractSyntaxTree.Shapes.Types.NamedType: return type_of_a_named(written)
    }
}

func type_of_a_named(written: AbstractSyntaxTree.Shapes.Types.NamedType): Model.Type {
    if not written.asked.is_empty() {
        return asked_type_of(written)
    }
    var found = type_of_a_path(written.path, written.arguments)
    if written.is_nullable {
        return found.nullable()
    }
    return found
}

func type_of_a_name(name: String): Model.Type {
    var path = List<String>()
    path.append(name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return type_of_a_path(path, no_arguments)
}

func type_of_a_path(path: List<String>, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var first = path[0]
    crash first
    if first.starts_with("$") {
        return bound_type_of(path)
    }
    var written = path.join(".")
    if bound_member_type and bound_member_is_a_class and written == bound_member_name {
        return bound_member_type
    }
    if bound_member_type and written == "{bound_member_name}.class" {
        return bound_member_type
    }
    if bound_member_type and written == "{bound_member_name}.class.element_type" {
        return element_type_of(bound_member_type)
    }
    if written == "Spite.Function" and not arguments.is_empty() {
        return function_type_of(arguments)
    }
    if written == "Symbol" {
        var no_symbol = Validators.NameResolution.UnknownType.Validator()
        no_symbol.refuse_a_symbol(context.file.path, line, context.shown)
    }
    if written == "Nothing" and arguments.is_empty() {
        return Model.Type('nothing', "")
    }
    var is_open = written == "Anything" or written == "Number"
    if is_open and arguments.is_empty() {
        return open_shape(written)
    }
    var names_a_handle = written == "Parallel" or written == "Concurrent"
    if names_a_handle and arguments.count() == 1 {
        return handle_type_of(written, arguments)
    }
    var bound = context.bound_types.keys()
    var own_name = simple_name_of(context.file)
    var names_itself = written == own_name and arguments.is_empty() and not bound.is_empty()
    if names_itself {
        return Model.Type('object', context.key)
    }
    var declared = declared_type_of(path)
    if declared {
        return declared
    }
    var found = symbols.find(written, context.file.namespace)
    if not found and scalars.of(written) {
        return Model.Type('scalar', written)
    }
    if not found and names_a_run_time_class(path) {
        var run_time = Validators.NameResolution.UnknownType.Validator()
        run_time.refuse_a_run_time_class(context.file.path, line, context.shown, typing_function_name, written)
    }
    if not found {
        var unpinned = symbols.unpinned_versions_holding(written, context.file.namespace)
        var versioned = Validators.NameResolution.UnknownType.Validator()
        versioned.refuse_an_unpinned_version(context.file.path, line, context.shown, written, unpinned)
    }
    if not found {
        refuse_a_class_member(path)
        var suggestion = suggested_type(path)
        var unknown = Validators.NameResolution.UnknownType.Validator()
        unknown.refuse(context.file.path, line, context.shown, written, suggestion)
    }
    crash found
    if not symbols.file_for(found.path) {
        read_later_class(found)
    }
    return class_type_of(found, arguments)
}

func names_a_run_time_class(path: List<String>): Boolean {
    var named = path[0]
    fallback named and path.count() == 1
    if names_a_value_of_the_function(named) {
        return true
    }
    var attribute = context.attribute_named(named)
    fallback attribute
    var attribute_type = attribute.attribute_type
    return attribute_type.kind == 'object' and attribute_type.name == "Spite.Class"
}

func names_a_value_of_the_function(named: String): Boolean {
    fallback not typing_function_name.is_empty()
    var index = 0
    while index < symbols.walks.count() {
        var walk = symbols.walks[index]
        if walk.file.path == context.file.path and walk_names_a_value(walk, named) {
            return true
        }
        index = index + 1
    }
    return false
}

func walk_names_a_value(walk: AbstractSyntaxTree.Walk.Walk, named: String): Boolean {
    var index = 0
    while index < walk.function_declarations.count() {
        var declaration = walk.function_declarations[index]
        var is_the_function = declaration.name == typing_function_name
        if is_the_function and declaration.parameters.find_by_name(named) {
            return true
        }
        index = index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        var statement = found.statement
        var is_in_the_function = found.function_name == typing_function_name
        if is_in_the_function and statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == named {
            return true
        }
        statement_index = statement_index + 1
    }
    return false
}

func suggested_type(path: List<String>): String {
    var start = 1
    while start < path.count() {
        var shorter = List<String>()
        var index = start
        while index < path.count() {
            var segment = path[index]
            shorter.append(segment)
            index = index + 1
        }
        var written = shorter.join(".")
        var found = symbols.find(written, context.file.namespace)
        if found {
            return found.namespace
        }
        start = start + 1
    }
    fallback path.count() == 1
    var wanted = path[0]
    var named = List<String>()
    var every = symbols.map.every_class()
    var class_index = 0
    while class_index < every.count() {
        var class_file = every[class_index]
        if class_file.simple_name == wanted and not named.contains(class_file.namespace) {
            named.append(class_file.namespace)
        }
        class_index = class_index + 1
    }
    fallback named.count() == 1
    return named[0]
}

func list_type_of(element: Model.Type): Model.Type {
    var path = List<String>()
    path.append("List")
    var found = symbols.find("List", context.file.namespace)
    crash found
    var file = symbols.file_for(found.path)
    if not file {
        read_later_class(found)
    }
    var read = symbols.file_for(found.path)
    crash read
    var names = generic_names_of(read)
    var given = List<Model.Type>()
    given.append(element)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, read, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func handle_type_of(written: String, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var given = types_of_arguments(arguments)
    var answer = given[0]
    crash answer
    return handle_of(written, answer)
}

func handle_of(written: String, answer: Model.Type): Model.Type {
    var made = Model.Type('handle', written)
    made.answer = answer
    var carried = answer
    if answer.kind == 'nothing' {
        carried = Model.Type('scalar', "Boolean")
    }
    var carriers = List<Model.Type>()
    carriers.append(carried)
    var key = instance_key("Spite.Work", carriers)
    if not program.has(key) {
        made_work(key, carried, carriers)
    }
    fill_the_waiting()
    made.carrier = key
    return made
}

func made_work(key: String, carried: Model.Type, carriers: List<Model.Type>) {
    var shown = shown_name_of("Spite.Work", carriers)
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var model = Model.ClassModel(key, shown, no_file)
    model.bound_types["$result_type"] = carried
    var boolean = Model.Type('scalar', "Boolean")
    var result = carried.nullable()
    var text = Model.Type('object', "String")
    add_work_function(model, "get_finished", boolean)
    add_work_function(model, "finished_value", result)
    add_work_function(model, "_settled", result)
    add_work_function(model, "_finished_or_waited", boolean)
    var nothing = Model.Type('nothing', "")
    add_work_function(model, "drop", nothing)
    var handing = work_function(model, "_hand_in_flight", nothing)
    var integer = Model.Type('scalar', "Integer")
    var site = Model.ParameterModel("site", integer, false)
    handing.parameters.append(site)
    var debugging = work_function(model, "to_debug", text)
    debugging.is_synthetic = true
    debugging.is_written_by_the_compiler = false
    program.add(model)
}

func add_work_function(model: Model.ClassModel, name: String, answer: Model.Type) {
    var made = Model.FunctionModel(name, model.key)
    made.is_written_by_the_compiler = true
    if not answer.is_nothing() {
        made.answer = answer
    }
    model.declared_functions.append(made)
}

func work_function(model: Model.ClassModel, name: String, answer: Model.Type): Model.FunctionModel {
    add_work_function(model, name, answer)
    var made = model.declared_functions.last()
    crash made
    return made
}

func instance_named(written: String, given: List<Model.Type>): Model.Type {
    var found = symbols.find(written, "")
    crash found
    var file = symbols.file_for(found.path)
    if not file {
        read_later_class(found)
    }
    var read = symbols.file_for(found.path)
    crash read
    var names = generic_names_of(read)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, read, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func open_shape(written: String): Model.Type {
    if not program.shape_keyed(written) {
        var made = Model.ShapeModel(written, written)
        var text = Model.Type('object', "String")
        var shown = Model.FunctionModel("to_string", written)
        shown.answer = text
        made.members.append(shown)
        var debugged = Model.FunctionModel("to_debug", written)
        debugged.answer = text
        made.members.append(debugged)
        program.shapes[written] = made
    }
    return Model.Type('shape', written)
}

func symbol_type(): Model.Type {
    var path = List<String>()
    path.append("String")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var text = type_of_a_path(path, no_arguments)
    var made = Model.Type(text.kind, text.name)
    made.is_symbol = true
    return made
}

func class_model_named(written: String): Model.ClassModel? {
    read_class_named(written)
    var found = symbols.find(written, "")
    fallback found
    return program.class_named(found.namespace)
}

func read_class_named(written: String) {
    var found = symbols.find(written, "")
    fallback found
    fallback not symbols.file_for(found.path)
    read_later_class(found)
    fill_the_waiting()
}

func read_later_class(found: Mapping.ClassFile) {
    var known = symbols.read_paths()
    var start = known.count()
    symbols.read_class(found)
    var read = symbols.read_paths()
    var index = start
    while index < read.count() {
        var path = read[index]
        add_a_plain_class(path)
        index = index + 1
    }
}

func bound_type_of(path: List<String>): Model.Type {
    var first = path[0]
    crash first
    var bound = context.bound_types[first]
    var codegen_line = Validators.NameResolution.CodegenLine.Validator()
    codegen_line.check(context.file.path, line, context.shown, first, bound)
    crash bound
    if path.count() == 1 {
        return bound
    }
    var member = path[1]
    crash member
    if member == "value_type" and bound.is_nullable {
        return bound.present()
    }
    var bound_model = program.class_named(bound.name)
    crash bound_model
    if member == "element_type" or member == "value_type" or member == "key_type" {
        var inner_bound = bound_model.bound_types["${member}"]
        if inner_bound {
            return inner_bound
        }
    }
    var inner = bound_model.bound_types["${member}"]
    if not inner {
        var member_rule = Validators.NameResolution.TypeMember.Validator()
        var shown_bound = shown_type(bound)
        member_rule.refuse(context.file.path, line, context.shown, building_function_name, shown_bound, member)
    }
    crash inner
    return inner
}

func asked_type_of(written: AbstractSyntaxTree.Shapes.Types.NamedType): Model.Type {
    var question = written.path.last()
    var bound_path = written.path.copy()
    crash bound_path.remove_last()
    var bound = bound_type_of(bound_path)
    var shown = written.path.join(".")
    var rule = Validators.NameResolution.TypeMember.Validator()
    if question != "argument_class" or written.asked.count() != 2 {
        rule.refuse_a_question(context.file.path, line, shown)
    }
    var function_text = written.asked[0]
    var place_text = written.asked[1]
    crash function_text
    crash place_text
    var function_name = function_text.replace("\"", "")
    var place = place_text.to_integer()
    var outer_context = context
    var outer_line = line
    var outer_parameters = read_parameters
    fill_the_waiting()
    context = outer_context
    line = outer_line
    read_parameters = outer_parameters
    var model = program.class_named(bound.name)
    crash model
    var function = model.function_named(function_name)
    if not function {
        rule.refuse_a_missing_function(context.file.path, line, context.shown, model.shown, function_name, place_text)
    }
    crash function
    crash place
    var parameter = function.parameters[place]
    if not parameter {
        var count = function.parameters.count()
        rule.refuse_a_missing_parameter(
            context.file.path,
            line,
            context.shown,
            model.shown,
            function_name,
            place,
            count,
        )
    }
    crash parameter
    return parameter.parameter_type
}

func element_type_of(listed: Model.Type): Model.Type {
    var model = program.class_named(listed.name)
    crash model
    var element = model.bound_types["$element_type"]
    crash element
    return element
}

func function_type_of(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var made = Model.Type('function', "Spite.Function")
    var written_types = types_of_arguments(arguments)
    var written_answer = written_types.remove_last()
    crash written_answer
    if written_answer.kind != 'nothing' {
        made.answer = same_member_type(written_answer)
    }
    var index = 0
    while index < written_types.count() {
        var written = written_types[index]
        var parameter = same_member_type(written)
        made.parameters.append(parameter)
        index = index + 1
    }
    return made
}

func declared_type_of(path: List<String>): Model.Type? {
    var owner = context
    var name = path[0]
    crash name
    if path.count() >= 2 {
        var whole = declared_as_a_file(path)
        if whole {
            return whole
        }
        var owner_path = path.copy()
        var last_name = owner_path.remove_last()
        crash last_name
        var owner_name = owner_path.join(".")
        var owner_file = symbols.find(owner_name, context.file.namespace)
        fallback owner_file
        if not symbols.file_for(owner_file.path) {
            read_later_class(owner_file)
        }
        var outer_context = context
        var outer_line = line
        var outer_parameters = read_parameters
        fill_the_waiting()
        context = outer_context
        line = outer_line
        read_parameters = outer_parameters
        var owner_model = program.class_named(owner_file.namespace)
        if not owner_model and owner_file.path == context.file.path {
            owner_model = context
        }
        fallback owner_model
        owner = owner_model
        name = last_name
        refuse_a_copy_named_outside(owner, name, path)
    }
    var made_enum = owner.enum_named(name)
    if made_enum {
        return Model.Type('enumeration', made_enum.key)
    }
    var made_union = owner.union_named(name)
    if made_union {
        var union_type = Model.Type('union', made_union.key)
        return same_member_type(union_type)
    }
    var made_shape = owner.shape_named(name)
    if made_shape {
        var shape_type = Model.Type('shape', made_shape.key)
        return same_member_type(shape_type)
    }
    fallback path.count() == 1
    var named_class = symbols.find(name, context.file.namespace)
    if named_class {
        return declared_by_its_file(named_class, name)
    }
    return null
}

func declared_as_a_file(path: List<String>): Model.Type? {
    var dotted = path.join(".")
    var found = symbols.find(dotted, context.file.namespace)
    fallback found
    var last_name = path.last()
    crash last_name
    return declared_by_its_file(found, last_name)
}

func declared_by_its_file(found: Mapping.ClassFile, name: String): Model.Type? {
    if not symbols.file_for(found.path) {
        read_later_class(found)
    }
    var file = symbols.file_for(found.path)
    crash file
    fallback file.declarations.count() == 1
    var only = file.declarations[0]
    var declared_name = symbols.name_of(only)
    fallback declared_name == name
    var key = "{found.namespace}.{name}"
    if only == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
        return Model.Type('enumeration', key)
    }
    if only == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        return Model.Type('union', key)
    }
    if only == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        return Model.Type('shape', key)
    }
    return null
}

func declared_in(model: Model.ClassModel, name: String): Model.Type? {
    var made_enum = model.enum_named(name)
    if made_enum {
        return Model.Type('enumeration', made_enum.key)
    }
    var made_union = model.union_named(name)
    if made_union {
        var union_type = Model.Type('union', made_union.key)
        return same_member_type(union_type)
    }
    var made_shape = model.shape_named(name)
    if made_shape {
        var shape_type = Model.Type('shape', made_shape.key)
        return same_member_type(shape_type)
    }
    return null
}

func declared_type_in(path: List<String>, model: Model.ClassModel): Model.Type? {
    var outer = context
    context = model
    var found = declared_type_of(path)
    context = outer
    return found
}

# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func refuse_a_class_member(path: List<String>) {
    var last_name = path.last()
    crash last_name
    var owners = List<String>()
    var namespace_name = ""
    if path.count() == 1 {
        owners = classes_declaring(last_name)
    } else {
        var owner_path = path.copy()
        var dropped = owner_path.remove_last()
        crash dropped
        var written_owner = owner_path.join(".")
        var folder = namespace_folder_named(written_owner)
        fallback folder
        namespace_name = folder.namespace
        owners = classes_of_the_folder_declaring(folder, last_name)
    }
    fallback not owners.is_empty()
    refuse_a_copy_named_by_its_owner(owners, path)
    var namings = List<String>()
    var index = 0
    while index < owners.count() {
        var owner = owners[index]
        var shortest = shortest_name_of(owner)
        namings.append("{shortest}.{last_name}")
        index = index + 1
    }
    var written = path.join(".")
    var refusal = Validators.NameResolution.ClassMember.Validator()
    if namespace_name.is_empty() {
        refusal.refuse_outside_its_class(context.file.path, line, context.shown, typing_function_name, written, owners, namings)
    } else {
        refusal.refuse_through_a_namespace(
            context.file.path,
            line,
            context.shown,
            typing_function_name,
            written,
            namespace_name,
            owners,
            namings,
        )
    }
}

# ../../spite_spec/specs/classes_and_files.md#files-are-classes
func refuse_a_copy_named_outside(owner: Model.ClassModel, name: String, path: List<String>) {
    fallback owner.key != context.key and not symbols.generated_texts.contains(context.file.path)
    var kind = copied_kind_in(owner, name)
    fallback not kind.is_empty()
    var owners = [owner.key]
    var written = path.join(".")
    var refusal = Validators.NameResolution.ClassMember.Validator()
    refusal.refuse_a_copy_named_outside(context.file.path, line, context.shown, typing_function_name, written, kind, owners)
}

func refuse_a_copy_named_by_its_owner(owners: List<String>, path: List<String>) {
    fallback not symbols.generated_texts.contains(context.file.path)
    var first_owner = owners[0]
    crash first_owner
    var owner = program.class_named(first_owner)
    fallback owner
    var last_name = path.last()
    crash last_name
    var kind = copied_kind_in(owner, last_name)
    fallback not kind.is_empty()
    var written = path.join(".")
    var refusal = Validators.NameResolution.ClassMember.Validator()
    refusal.refuse_a_copy_named_outside(context.file.path, line, context.shown, typing_function_name, written, kind, owners)
}

func copied_kind_in(owner: Model.ClassModel, name: String): String {
    if owner.union_named(name) {
        return "union"
    }
    if owner.shape_named(name) {
        return "type"
    }
    return ""
}

func classes_declaring(name: String): List<String> {
    var outer_context = context
    var outer_line = line
    var outer_parameters = read_parameters
    fill_the_waiting()
    context = outer_context
    line = outer_line
    read_parameters = outer_parameters
    var owners = List<String>()
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        var owner = model.file.namespace
        if declares_a_type(model, name) and not owners.contains(owner) {
            owners.append(owner)
        }
        index = index + 1
    }
    return owners
}

func namespace_folder_named(written: String): Mapping.MappedFolder? {
    var names = Mapping.Names()
    var searched = context.file.namespace
    var keep_going = true
    while keep_going {
        var candidate = names.joined(searched, written)
        var folder = symbols.map.folder_named(candidate)
        if folder {
            return folder
        }
        keep_going = not searched.is_empty()
        searched = symbols.enclosing(searched)
    }
    return null
}

func classes_of_the_folder_declaring(folder: Mapping.MappedFolder, name: String): List<String> {
    var owners = List<String>()
    var index = 0
    while index < folder.files.count() {
        var class_file = folder.files[index]
        if not symbols.file_for(class_file.path) {
            read_later_class(class_file)
        }
        index = index + 1
    }
    var outer_context = context
    var outer_line = line
    var outer_parameters = read_parameters
    fill_the_waiting()
    context = outer_context
    line = outer_line
    read_parameters = outer_parameters
    var file_index = 0
    while file_index < folder.files.count() {
        var class_file = folder.files[file_index]
        var model = program.class_named(class_file.namespace)
        var declares = false
        if model {
            declares = declares_a_type(model, name)
        }
        if declares and not owners.contains(class_file.namespace) {
            owners.append(class_file.namespace)
        }
        file_index = file_index + 1
    }
    return owners
}

func shortest_name_of(owner: String): String {
    var segments = owner.split(".")
    var start = segments.count() - 1
    while start > 0 {
        var shorter = List<String>()
        var index = start
        while index < segments.count() {
            var segment = segments[index]
            shorter.append(segment)
            index = index + 1
        }
        var written = shorter.join(".")
        var found = symbols.find(written, context.file.namespace)
        if found and found.namespace == owner {
            return written
        }
        start = start - 1
    }
    return owner
}

func declares_a_type(model: Model.ClassModel, name: String): Boolean {
    if model.enum_named(name) or model.union_named(name) {
        return true
    }
    if model.shape_named(name) {
        return true
    }
    return false
}

func class_type_of(
    found: Mapping.ClassFile,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): Model.Type {
    var file = symbols.file_for(found.path)
    crash file
    var names = generic_names_of(file)
    var parameter_count = names.count()
    var argument_count = arguments.count()
    var generic_arguments = Validators.NameResolution.GenericArguments.Validator()
    generic_arguments.check(context.file.path, line, found.namespace, names, argument_count)
    if parameter_count == 0 {
        return plain_type_of(found.namespace)
    }
    var given = types_of_arguments(arguments)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, file, names, given)
    }
    return Model.Type('object', key)
}

func inferred_instance(
    path: List<String>,
    model: Model.ClassModel,
    at_line: Integer,
    argument_types: List<Model.Type>,
): Model.Type? {
    var outer = context
    context = model
    line = at_line
    var written = path.join(".")
    var found = symbols.find(written, context.file.namespace)
    context = outer
    fallback found
    if not symbols.file_for(found.path) {
        read_later_class(found)
    }
    var file = symbols.file_for(found.path)
    fallback file
    var names = generic_names_of(file)
    fallback not names.is_empty()
    var simple_name = simple_name_of(file)
    var constructor = constructor_declaration_of(file, simple_name)
    fallback constructor
    var given = List<Model.Type>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = bound_by_the_arguments(constructor, name, argument_types)
        fallback bound
        given.append(bound)
        index = index + 1
    }
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, file, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func constructor_declaration_of(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    simple_name: String,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and declaration.name == simple_name {
            return declaration
        }
        index = index + 1
    }
    return null
}

func bound_by_the_arguments(
    constructor: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    argument_types: List<Model.Type>,
): Model.Type? {
    var index = 0
    while index < constructor.parameters.count() {
        var parameter = constructor.parameters[index]
        var written = parameter.declared_type
        var given = argument_types[index]
        if given {
            var found = bound_inside_a_known(written, name, given)
            if found {
                return found
            }
        }
        index = index + 1
    }
    return null
}

func bound_inside_a_known(
    written: Type?,
    name: String,
    given: Model.Type,
): Model.Type? {
    fallback not given.is_nothing()
    return bound_inside(written, name, given)
}

func bound_inside(written: Type?, name: String, given: Model.Type): Model.Type? {
    if names_the_generic(written, name) {
        return given.present()
    }
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        return bound_inside_a_named(written, name, given)
    }
    return null
}

func bound_inside_a_named(
    written: AbstractSyntaxTree.Shapes.Types.NamedType,
    name: String,
    given: Model.Type,
): Model.Type? {
    var joined = written.path.join(".")
    if joined == "Spite.Function" and given.kind == 'function' {
        return bound_inside_a_function(written, name, given)
    }
    fallback given.kind == 'object' and not written.arguments.is_empty()
    var model = program.class_named(given.name)
    fallback model
    var names = List<String>()
    if joined == "List" {
        names.append("$element_type")
    }
    if joined == "Dictionary" {
        names.append("$key_type")
        names.append("$value_type")
    }
    var index = 0
    while index < names.count() and index < written.arguments.count() {
        var argument = written.arguments[index]
        var codegen_name = names[index]
        var inner = model.bound_types[codegen_name]
        if inner {
            var found = bound_inside(argument.type_reference, name, inner)
            if found {
                return found
            }
        }
        index = index + 1
    }
    return null
}

func bound_inside_a_function(
    written: AbstractSyntaxTree.Shapes.Types.NamedType,
    name: String,
    given: Model.Type,
): Model.Type? {
    var last = written.arguments.count() - 1
    var index = 0
    while index < last {
        var argument = written.arguments[index]
        var inner = given.parameters[index]
        if inner {
            var found = bound_inside(argument.type_reference, name, inner)
            if found {
                return found
            }
        }
        index = index + 1
    }
    var answered = written.arguments[last]
    fallback answered
    if not given.answer {
        return bound_to_nothing(answered.type_reference, name)
    }
    return bound_inside(answered.type_reference, name, given.answer)
}

func bound_to_nothing(written: Type?, name: String): Model.Type? {
    fallback names_the_generic(written, name)
    return Model.Type('nothing', "")
}

func names_the_generic(written: Type?, name: String): Boolean {
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        var joined = written.path.join(".")
        return joined == name
    }
    return false
}

func plain_type_of(key: String): Model.Type {
    if scalars.is_a_scalar(key) {
        return Model.Type('scalar', key)
    }
    return Model.Type('object', key)
}

func types_of_arguments(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): List<Model.Type> {
    var outer = resolved_arguments
    resolved_arguments = List<Model.Type>()
    arguments.each(resolve_an_argument)
    var resolved = resolved_arguments
    resolved_arguments = outer
    return resolved
}

func resolve_an_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if not argument.type_reference {
        var constant = constant_argument(argument.text)
        resolved_arguments.append(constant)
        return
    }
    var resolved = type_of(argument.type_reference)
    resolved_arguments.append(resolved)
}

func constant_argument(written: String): Model.Type {
    var kind_name = "Integer"
    if written == "true" or written == "false" {
        kind_name = "Boolean"
    } else if written.starts_with("\"") {
        kind_name = "String"
    } else if written.contains(".") {
        kind_name = "Float"
    }
    var made = Model.Type('scalar', kind_name)
    if kind_name == "String" {
        made = Model.Type('object', kind_name)
    }
    made.constant = written
    return made
}

func constant_key(written: String): String {
    var kept = ""
    var index = 0
    while index < written.length() {
        var code = written.byte_at(index)
        var is_a_letter = code >= 97 and code <= 122 or code >= 65 and code <= 90 or code >= 48 and code <= 57
        if is_a_letter {
            var character = written[index]
            crash character
            kept = "{kept}{character}"
        } else {
            kept = "{kept}_"
        }
        index = index + 1
    }
    return "value_{kept}"
}

func instance_key(class_key: String, given: List<Model.Type>): String {
    var written = List<String>()
    var index = 0
    while index < given.count() {
        var argument = given[index]
        var argument_key = key_of_an_argument(argument)
        written.append(argument_key)
        index = index + 1
    }
    var joined = written.join("_and_")
    return "{class_key}_of_{joined}"
}

func key_of_an_argument(given: Model.Type): String {
    var argument = same_member_type(given)
    var argument_key = argument.name.replace(".", "_")
    if argument.is_symbol {
        argument_key = "Symbol"
    }
    if argument.kind == 'function' {
        argument_key = function_key_of(argument)
    }
    if argument.kind == 'nothing' {
        argument_key = "Nothing"
    }
    if not argument.constant.is_empty() {
        argument_key = constant_key(argument.constant)
    }
    if argument.is_nullable {
        argument_key = "{argument_key}_maybe"
    }
    return argument_key
}

# ../../spite_spec/specs/values_and_types.md#unions-in-full
func same_member_type(given: Model.Type): Model.Type {
    if given.kind != 'union' and given.kind != 'shape' {
        return given
    }
    var members = written_members_of(given)
    if members.is_empty() {
        return given
    }
    var index = 0
    while index < first_types.count() {
        var first = first_types[index]
        var first_members = first_type_members[index]
        crash first_members
        if first.kind == given.kind and has_the_same_members(members, first_members) {
            var copy = first.present()
            copy.written_name = given.name
            if given.is_nullable {
                return copy.nullable()
            }
            return copy
        }
        index = index + 1
    }
    var present = given.present()
    first_types.append(present)
    first_type_members.append(members)
    return given
}

func has_the_same_members(members: List<String>, others: List<String>): Boolean {
    fallback members.count() == others.count()
    var index = 0
    while index < members.count() {
        var member = members[index]
        fallback others.contains(member)
        index = index + 1
    }
    return true
}

func written_members_of(declared: Model.Type): List<String> {
    var members = List<String>()
    var parts = declared.name.split(".")
    var simple = parts.remove_last()
    crash simple
    var owner_key = parts.join(".")
    var owner = program.class_named(owner_key)
    if not owner {
        return members
    }
    var index = 0
    while index < owner.file.declarations.count() {
        var declaration = owner.file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration and declaration.name == simple {
            add_the_written_members(members, declaration, owner)
        }
        if declaration == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration and declaration.name == simple {
            add_the_written_signatures(members, declaration)
        }
        index = index + 1
    }
    return members
}

func add_the_written_members(
    members: List<String>,
    declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration,
    owner: Model.ClassModel,
) {
    var index = 0
    while index < declaration.member_names.count() {
        var written = declaration.member_names[index]
        var found = symbols.find(written, owner.file.namespace)
        if found {
            members.append(found.namespace)
        } else {
            members.append(written)
        }
        index = index + 1
    }
}

func add_the_written_signatures(
    members: List<String>,
    declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration,
) {
    var index = 0
    while index < declaration.members.count() {
        var member = declaration.members[index]
        var written = List<String>()
        var parameter_index = 0
        while parameter_index < member.parameters.count() {
            var parameter = member.parameters[parameter_index]
            var parameter_text = written_type_text(parameter.declared_type)
            written.append(parameter_text)
            parameter_index = parameter_index + 1
        }
        var joined = written.join(", ")
        var answer = written_type_text(member.result)
        var signature = "{member.name}({joined}): {answer}"
        if member.is_an_attribute {
            signature = "{member.name}: {answer}"
        }
        members.append(signature)
        index = index + 1
    }
}

func written_type_text(written: Type?): String {
    fallback written
    var printer = Printers.Spite.TypePrinter(written)
    return printer.text()
}

func function_key_of(described: Model.Type): String {
    var written = List<String>()
    var index = 0
    while index < described.parameters.count() {
        var parameter = described.parameters[index]
        var parameter_key = key_of_an_argument(parameter)
        written.append(parameter_key)
        index = index + 1
    }
    var answer_key = "Nothing"
    if described.answer {
        answer_key = key_of_an_argument(described.answer)
    }
    var joined = written.join("_and_")
    return "Function_of_{joined}_to_{answer_key}"
}

func mint(
    key: String,
    found: Mapping.ClassFile,
    file: AbstractSyntaxTree.Shapes.SourceFile,
    names: List<String>,
    given: List<Model.Type>,
) {
    var shown = shown_name_of(found.namespace, given)
    var model = Model.ClassModel(key, shown, file)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var written_bound = given[index]
        crash written_bound
        var bound = same_member_type(written_bound)
        model.bound_types[name] = bound
        index = index + 1
    }
    program.add(model)
    waiting.append(model)
}

func shown_name_of(class_key: String, given: List<Model.Type>): String {
    var written = List<String>()
    var index = 0
    while index < given.count() {
        var argument = given[index]
        var argument_shown = shown_argument(argument)
        written.append(argument_shown)
        index = index + 1
    }
    var joined = written.join(", ")
    return "{class_key}<{joined}>"
}

func shown_argument(argument: Model.Type): String {
    var instance = program.class_named(argument.name)
    if argument.is_symbol {
        return "Symbol"
    }
    if argument.kind == 'object' and instance {
        return instance.shown
    }
    return argument.name
}

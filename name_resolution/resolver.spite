var empty_map = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(empty_map)
var program = Model.ProgramModel()
var waiting = List<Model.ClassModel>()
var scalars = Model.Scalars()
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Model.ClassModel("", "", empty_file)
var line = 0
var resolved_arguments = List<Model.Type>()
var read_parameters = List<Model.ParameterModel>()
var typing = Inference()
var bound_member_name = ""
var bound_member_type: Model.Type? = null

func Resolver(starting_symbols: Symbols.SymbolTable) {
    symbols = starting_symbols
}

func resolve(entry: Mapping.ClassFile): Model.ProgramModel {
    program.entry = entry.namespace
    var paths = symbols.read_paths()
    paths.each(add_a_plain_class)
    fill_the_waiting()
    return program
}

func fill_the_waiting() {
    while not waiting.is_empty() {
        var next = waiting.remove_first()
        crash next
        fill(next)
    }
}

func type_in(written: AbstractSyntaxTree.Shapes.Types.Type, model: Model.ClassModel, at_line: Integer): Model.Type {
    var outer = context
    context = model
    line = at_line
    var found = type_of(written)
    context = outer
    fill_the_waiting()
    return found
}

func class_type_in(
    path: List<String>,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    model: Model.ClassModel,
    at_line: Integer,
): Model.Type {
    var outer = context
    context = model
    line = at_line
    var found = type_of_a_path(path, arguments)
    context = outer
    fill_the_waiting()
    return found
}

func add_a_plain_class(path: String) {
    var class_file = symbols.class_file_for(path)
    var file = symbols.file_for(path)
    crash class_file
    crash file
    assert not is_a_template(file)
    assert not program.has(class_file.namespace)
    var model = Model.ClassModel(class_file.namespace, class_file.namespace, file)
    program.add(model)
    waiting.append(model)
}

func is_a_template(file: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    var names = generic_names_of(file)
    return not names.is_empty()
}

func generic_names_of(file: AbstractSyntaxTree.Shapes.SourceFile): List<String> {
    var found = List<String>()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
            found.append(declaration.name)
        }
        index = index + 1
    }
    return found
}

func fill(model: Model.ClassModel) {
    var outer = context
    context = model
    model.file.declarations.each(read_enum_or_union)
    model.file.declarations.each(read_declaration)
    context = outer
}

func read_enum_or_union(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: context.is_singleton = true
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_name(declaration)
        _: return
    }
}

func read_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    var made = Model.EnumModel("{context.key}.{declaration.name}", declaration.name)
    var counted: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        if value.number {
            counted = typing.whole_number_of(value.number)
        }
        made.values.append(value.name)
        made.numbers.append(counted)
        counted = counted + 1
        index = index + 1
    }
    context.enums.append(made)
}

func read_union_name(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var made = Model.UnionModel("{context.key}.{declaration.name}", declaration.name)
    context.unions.append(made)
}

func read_shape_name(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var made = Model.ShapeModel("{context.key}.{declaration.name}", declaration.name)
    context.shapes.append(made)
    program.shapes[made.key] = made
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
        _: return
    }
}

func read_union_members(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    line = declaration.line
    var made = context.union_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        var path = member.split(".")
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member_type = type_of_a_path(path, no_arguments)
        made.members.append(member_type)
        index = index + 1
    }
}

func read_shape_members(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    line = declaration.line
    var made = context.shape_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.members.count() {
        line = declaration.line + index + 1
        var member = declaration.members[index]
        var function = Model.FunctionModel(member.name, made.key)
        function.is_an_attribute = member.is_an_attribute
        read_parameters = List<Model.ParameterModel>()
        member.parameters.each(read_parameter)
        function.parameters = read_parameters
        if member.result {
            function.answer = type_of(member.result)
        }
        made.members.append(function)
        index = index + 1
    }
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    line = declaration.line
    var attribute_type = attribute_type_of(declaration)
    var made = Model.AttributeModel(declaration.name, context.key, attribute_type)
    made.declaration = declaration
    context.declared_attributes.append(made)
    note_the_room(declaration, attribute_type)
}

func attribute_type_of(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Model.Type {
    if declaration.declared_type {
        return type_of(declaration.declared_type)
    }
    var written = typing.written_type_of(declaration.value)
    if written {
        return type_of(written)
    }
    var known = typing.literal_type_of(declaration.value)
    if not known.is_empty() {
        return type_of_a_name(known)
    }
    var attribute_types = Validators.NameResolution.AttributeType.Validator()
    attribute_types.refuse(context.file.path, line, context.key, declaration.name)
    return Model.Type('nothing', "")
}

func note_the_room(
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    attribute_type: Model.Type,
) {
    assert attribute_type.name == "Buffer"
    assert context.room_size == 0
    context.room_size = typing.room_size_of(declaration.value)
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    line = declaration.line
    var made = Model.FunctionModel(declaration.name, context.key)
    made.declaration = declaration
    var simple_name = simple_name_of(context.file)
    made.is_constructor = declaration.name == simple_name
    var template_index = template_index_of(declaration)
    if template_index >= 0 {
        made.is_a_member_template = true
        made.template_index = template_index
        context.declared_functions.append(made)
        return
    }
    read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = read_parameters
    if declaration.result {
        made.answer = type_of(declaration.result)
    }
    context.declared_functions.append(made)
}

func template_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var words = declaration.name.split("_")
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and is_a_declaration_type(parameter.declared_type) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_a_declaration_type(written: AbstractSyntaxTree.Shapes.Types.Type?): Boolean {
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        if path == "Symbol" {
            return true
        }
        return path == "Spite.AttributeDeclaration" and not written.arguments.is_empty()
    }
    return false
}

func template_owner_of(template: Model.FunctionModel, model: Model.ClassModel): Model.Type? {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var written = parameter.declared_type
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        return owner_of_a_declaration(written, declaration, model)
    }
    return null
}

func owner_of_a_declaration(
    written: AbstractSyntaxTree.Shapes.Types.NamedType,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    model: Model.ClassModel,
): Model.Type? {
    if written.arguments.is_empty() {
        return Model.Type('object', model.key)
    }
    var argument = written.arguments[0]
    var owner_written = argument.type_reference
    if owner_written == AbstractSyntaxTree.Shapes.Types.NamedType {
        return owner_named(owner_written, declaration, model)
    }
    return null
}

func owner_named(
    owner_written: AbstractSyntaxTree.Shapes.Types.NamedType,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    model: Model.ClassModel,
): Model.Type? {
    if owner_written.path.count() == 2 {
        return parameters_owner(owner_written, declaration, model)
    }
    assert owner_written.path.count() == 1
    var written = owner_written.path[0]
    var folder = symbols.namespace_folder(written)
    var named_class = symbols.find(written, model.file.namespace)
    if folder and not named_class {
        return Model.Type('namespace', folder.namespace)
    }
    var outer = context
    context = model
    line = declaration.line
    var found = type_of(owner_written)
    context = outer
    fill_the_waiting()
    return found
}

func parameters_owner(
    owner_written: AbstractSyntaxTree.Shapes.Types.NamedType,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    model: Model.ClassModel,
): Model.Type? {
    var class_part = owner_written.path[0]
    var function_part = owner_written.path[1]
    crash class_part
    crash function_part
    var class_path = List<String>()
    class_path.append(class_part)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var outer = context
    context = model
    line = declaration.line
    var found = type_of_a_path(class_path, no_arguments)
    context = outer
    fill_the_waiting()
    assert found.kind == 'object' and not found.is_nullable
    var walked_class = program.class_named(found.name)
    if walked_class {
        var enumeration = walked_class.enum_named(function_part)
        if enumeration {
            return Model.Type('enumeration', enumeration.key)
        }
    }
    return Model.Type('parameters', "{found.name}|{function_part}")
}

func function_of_parameters(owner: Model.Type): Model.FunctionModel? {
    var parts = owner.name.split("|")
    var class_key = parts[0]
    var function_name = parts[1]
    crash class_key
    crash function_name
    var walked_class = program.class_named(class_key)
    assert walked_class
    return walked_class.function_named(function_name)
}

func specialized(
    template: Model.FunctionModel,
    called_name: String,
    member: String,
    member_type: Model.Type,
    is_a_function: Boolean,
    model: Model.ClassModel,
): Model.FunctionModel {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var made = Model.FunctionModel(called_name, template.owner)
    made.declaration = declaration
    made.bound_member = member
    made.bound_member_type = member_type
    made.bound_member_is_a_function = is_a_function
    made.template_index = template.template_index
    var outer_name = bound_member_name
    var outer_type = bound_member_type
    var outer = context
    context = model
    line = declaration.line
    bind_member(declaration, template.template_index, member_type)
    made.bound_parameter = bound_member_name
    read_parameters = List<Model.ParameterModel>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if index != template.template_index {
            read_parameter(parameter)
        }
        index = index + 1
    }
    made.parameters = read_parameters
    if declaration.result {
        made.answer = type_of(declaration.result)
    }
    bound_member_name = outer_name
    bound_member_type = outer_type
    context = outer
    fill_the_waiting()
    return made
}

func bind_member(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    parameter_index: Integer,
    member_type: Model.Type,
) {
    var parameter = declaration.parameters[parameter_index]
    crash parameter
    bound_member_name = parameter.name
    bound_member_type = member_type
}

func unbind_member() {
    bound_member_name = ""
    bound_member_type = null
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    crash parameter.declared_type
    var parameter_type = type_of(parameter.declared_type)
    var made = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
    read_parameters.append(made)
}

func simple_name_of(file: AbstractSyntaxTree.Shapes.SourceFile): String {
    var names = Mapping.Names()
    var segment = names.last_segment(file.path)
    var extension_length = 6
    var base_length = segment.length() - extension_length
    var base = segment.slice(0, base_length)
    return names.class_name_of(base)
}

func type_of(written: AbstractSyntaxTree.Shapes.Types.Type): Model.Type {
    switch written {
        AbstractSyntaxTree.Shapes.Types.NamedType: return type_of_a_named(written)
    }
}

func type_of_a_named(written: AbstractSyntaxTree.Shapes.Types.NamedType): Model.Type {
    var found = type_of_a_path(written.path, written.arguments)
    if written.is_nullable {
        return found.nullable()
    }
    return found
}

func type_of_a_name(name: String): Model.Type {
    var path = List<String>()
    path.append(name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return type_of_a_path(path, no_arguments)
}

func type_of_a_path(path: List<String>, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var first = path[0]
    crash first
    if first.starts_with("$") {
        return bound_type_of(path)
    }
    var written = path.join(".")
    if bound_member_type and written == "{bound_member_name}.class" {
        return bound_member_type
    }
    if bound_member_type and written == "{bound_member_name}.class.element_type" {
        return element_type_of(bound_member_type)
    }
    if written == "Spite.Function" and not arguments.is_empty() {
        return function_type_of(arguments)
    }
    if written == "Symbol" and arguments.is_empty() {
        return symbol_type()
    }
    if written == "Nothing" and arguments.is_empty() {
        return Model.Type('nothing', "")
    }
    var is_open = written == "Anything" or written == "Number"
    if is_open and arguments.is_empty() {
        return open_shape(written)
    }
    var names_a_handle = written == "Parallel" or written == "Concurrent"
    if names_a_handle and arguments.count() == 1 {
        return handle_type_of(written, arguments)
    }
    var bound = context.bound_types.keys()
    var own_name = simple_name_of(context.file)
    var names_itself = written == own_name and arguments.is_empty() and not bound.is_empty()
    if names_itself {
        return Model.Type('object', context.key)
    }
    var declared = declared_type_of(path)
    if declared {
        return declared
    }
    var found = symbols.find(written, context.file.namespace)
    if not found and scalars.of(written) {
        return Model.Type('scalar', written)
    }
    if not found {
        var suggestion = suggested_type(path)
        var unknown = Validators.NameResolution.UnknownType.Validator()
        unknown.refuse(context.file.path, line, context.shown, written, suggestion)
    }
    crash found
    if not symbols.file_for(found.path) {
        read_later_class(found)
    }
    return class_type_of(found, arguments)
}

func suggested_type(path: List<String>): String {
    var start = 1
    while start < path.count() {
        var shorter = List<String>()
        var index = start
        while index < path.count() {
            var segment = path[index]
            shorter.append(segment)
            index = index + 1
        }
        var written = shorter.join(".")
        var found = symbols.find(written, context.file.namespace)
        if found {
            return found.namespace
        }
        start = start + 1
    }
    if path.count() != 1 {
        return ""
    }
    var wanted = path[0]
    var named = List<String>()
    var every = symbols.map.every_class()
    var class_index = 0
    while class_index < every.count() {
        var class_file = every[class_index]
        if class_file.simple_name == wanted and not named.contains(class_file.namespace) {
            named.append(class_file.namespace)
        }
        class_index = class_index + 1
    }
    if named.count() != 1 {
        return ""
    }
    return named[0]
}

func list_type_of(element: Model.Type): Model.Type {
    var path = List<String>()
    path.append("List")
    var found = symbols.find("List", context.file.namespace)
    crash found
    var file = symbols.file_for(found.path)
    if not file {
        read_later_class(found)
    }
    var read = symbols.file_for(found.path)
    crash read
    var names = generic_names_of(read)
    var given = List<Model.Type>()
    given.append(element)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, read, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func handle_type_of(written: String, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var given = types_of_arguments(arguments)
    var answer = given[0]
    crash answer
    return handle_of(written, answer)
}

func handle_of(written: String, answer: Model.Type): Model.Type {
    var made = Model.Type('handle', written)
    made.answer = answer
    var carried = answer
    if answer.kind == 'nothing' {
        carried = Model.Type('scalar', "Boolean")
    }
    var carriers = List<Model.Type>()
    carriers.append(carried)
    var work = instance_named("Spite.Internal.Work", carriers)
    made.carrier = work.name
    return made
}

func instance_named(written: String, given: List<Model.Type>): Model.Type {
    var found = symbols.find(written, "")
    crash found
    var file = symbols.file_for(found.path)
    if not file {
        read_later_class(found)
    }
    var read = symbols.file_for(found.path)
    crash read
    var names = generic_names_of(read)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, read, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func open_shape(written: String): Model.Type {
    if not program.shape_keyed(written) {
        var made = Model.ShapeModel(written, written)
        var text = Model.Type('object', "String")
        var shown = Model.FunctionModel("to_string", written)
        shown.answer = text
        made.members.append(shown)
        var debugged = Model.FunctionModel("to_debug", written)
        debugged.answer = text
        made.members.append(debugged)
        program.shapes[written] = made
    }
    return Model.Type('shape', written)
}

func symbol_type(): Model.Type {
    var path = List<String>()
    path.append("String")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var text = type_of_a_path(path, no_arguments)
    var made = Model.Type(text.kind, text.name)
    made.is_symbol = true
    return made
}

func class_model_named(written: String): Model.ClassModel? {
    var found = symbols.find(written, "")
    assert found
    if not symbols.file_for(found.path) {
        read_later_class(found)
        fill_the_waiting()
    }
    return program.class_named(found.namespace)
}

func read_later_class(found: Mapping.ClassFile) {
    var known = symbols.read_paths()
    var start = known.count()
    symbols.read_class(found)
    var read = symbols.read_paths()
    var index = start
    while index < read.count() {
        var path = read[index]
        add_a_plain_class(path)
        index = index + 1
    }
}

func bound_type_of(path: List<String>): Model.Type {
    var first = path[0]
    crash first
    var bound = context.bound_types[first]
    var codegen_line = Validators.NameResolution.CodegenLine.Validator()
    codegen_line.check(context.file.path, line, first, bound)
    crash bound
    if path.count() == 1 {
        return bound
    }
    var member = path[1]
    crash member
    if member == "value_type" and bound.is_nullable {
        return bound.present()
    }
    var bound_model = program.class_named(bound.name)
    crash bound_model
    if member == "element_type" or member == "value_type" or member == "key_type" {
        var inner_bound = bound_model.bound_types["${member}"]
        if inner_bound {
            return inner_bound
        }
    }
    var inner = bound_model.bound_types["${member}"]
    if not inner {
        var member_rule = Validators.NameResolution.TypeMember.Validator()
        member_rule.refuse(context.file.path, line, bound.name, member)
    }
    crash inner
    return inner
}

func element_type_of(listed: Model.Type): Model.Type {
    var model = program.class_named(listed.name)
    crash model
    var element = model.bound_types["$element_type"]
    crash element
    return element
}

func function_type_of(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Model.Type {
    var made = Model.Type('function', "Spite.Function")
    var types = types_of_arguments(arguments)
    var answer = types.remove_last()
    crash answer
    if answer.kind != 'nothing' {
        made.answer = answer
    }
    made.parameters = types
    return made
}

func declared_type_of(path: List<String>): Model.Type? {
    var owner = context
    var name = path[0]
    crash name
    if path.count() == 2 {
        var owner_file = symbols.find(name, context.file.namespace)
        assert owner_file
        if not symbols.file_for(owner_file.path) {
            read_later_class(owner_file)
        }
        var outer_context = context
        var outer_line = line
        var outer_parameters = read_parameters
        fill_the_waiting()
        context = outer_context
        line = outer_line
        read_parameters = outer_parameters
        var owner_model = program.class_named(owner_file.namespace)
        if not owner_model and owner_file.path == context.file.path {
            owner_model = context
        }
        assert owner_model
        owner = owner_model
        var second = path[1]
        name = second
    }
    var made_enum = owner.enum_named(name)
    if made_enum {
        return Model.Type('enumeration', made_enum.key)
    }
    var made_union = owner.union_named(name)
    if made_union {
        return Model.Type('union', made_union.key)
    }
    var made_shape = owner.shape_named(name)
    if made_shape {
        return Model.Type('shape', made_shape.key)
    }
    assert path.count() == 1
    var named_class = symbols.find(name, context.file.namespace)
    assert not named_class
    return declared_anywhere(name)
}

func declared_anywhere(name: String): Model.Type? {
    var outer_context = context
    var outer_line = line
    var outer_parameters = read_parameters
    fill_the_waiting()
    context = outer_context
    line = outer_line
    read_parameters = outer_parameters
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        var made_enum = model.enum_named(name)
        if made_enum {
            return Model.Type('enumeration', made_enum.key)
        }
        var made_union = model.union_named(name)
        if made_union {
            return Model.Type('union', made_union.key)
        }
        var made_shape = model.shape_named(name)
        if made_shape {
            return Model.Type('shape', made_shape.key)
        }
        index = index + 1
    }
    return null
}

func class_type_of(
    found: Mapping.ClassFile,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): Model.Type {
    var file = symbols.file_for(found.path)
    crash file
    var names = generic_names_of(file)
    var parameter_count = names.count()
    var argument_count = arguments.count()
    var generic_arguments = Validators.NameResolution.GenericArguments.Validator()
    generic_arguments.check(context.file.path, line, found.namespace, parameter_count, argument_count)
    if parameter_count == 0 {
        return plain_type_of(found.namespace)
    }
    var given = types_of_arguments(arguments)
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, file, names, given)
    }
    return Model.Type('object', key)
}

func inferred_instance(
    path: List<String>,
    model: Model.ClassModel,
    at_line: Integer,
    argument_types: List<Model.Type>,
): Model.Type? {
    var outer = context
    context = model
    line = at_line
    var written = path.join(".")
    var found = symbols.find(written, context.file.namespace)
    context = outer
    assert found
    if not symbols.file_for(found.path) {
        read_later_class(found)
    }
    var file = symbols.file_for(found.path)
    assert file
    var names = generic_names_of(file)
    assert not names.is_empty()
    var simple_name = simple_name_of(file)
    var constructor = constructor_declaration_of(file, simple_name)
    assert constructor
    var given = List<Model.Type>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = bound_by_the_arguments(constructor, name, argument_types)
        assert bound
        given.append(bound)
        index = index + 1
    }
    var key = instance_key(found.namespace, given)
    if not program.has(key) {
        mint(key, found, file, names, given)
    }
    fill_the_waiting()
    return Model.Type('object', key)
}

func constructor_declaration_of(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    simple_name: String,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            if declaration.name == simple_name {
                return declaration
            }
        }
        index = index + 1
    }
    return null
}

func bound_by_the_arguments(
    constructor: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    argument_types: List<Model.Type>,
): Model.Type? {
    var index = 0
    while index < constructor.parameters.count() {
        var parameter = constructor.parameters[index]
        var written = parameter.declared_type
        var given = argument_types[index]
        if names_the_generic(written, name) and given {
            return given.present()
        }
        index = index + 1
    }
    return null
}

func names_the_generic(written: AbstractSyntaxTree.Shapes.Types.Type?, name: String): Boolean {
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        var joined = written.path.join(".")
        return joined == name
    }
    return false
}

func plain_type_of(key: String): Model.Type {
    if scalars.is_a_scalar(key) {
        return Model.Type('scalar', key)
    }
    return Model.Type('object', key)
}

func types_of_arguments(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): List<Model.Type> {
    var outer = resolved_arguments
    resolved_arguments = List<Model.Type>()
    arguments.each(resolve_an_argument)
    var resolved = resolved_arguments
    resolved_arguments = outer
    return resolved
}

func resolve_an_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if not argument.type_reference {
        var constant = constant_argument(argument.text)
        resolved_arguments.append(constant)
        return
    }
    var resolved = type_of(argument.type_reference)
    resolved_arguments.append(resolved)
}

func constant_argument(written: String): Model.Type {
    var kind_name = "Integer"
    if written == "true" or written == "false" {
        kind_name = "Boolean"
    } else if written.starts_with("\"") {
        kind_name = "String"
    } else if written.contains(".") {
        kind_name = "Float"
    }
    var made = Model.Type('scalar', kind_name)
    if kind_name == "String" {
        made = Model.Type('object', kind_name)
    }
    made.constant = written
    return made
}

func constant_key(written: String): String {
    var kept = ""
    var index = 0
    while index < written.length() {
        var code = written.code_at(index)
        var character = written.character_at(index)
        var is_a_letter = code >= 97 and code <= 122 or code >= 65 and code <= 90 or code >= 48 and code <= 57
        if is_a_letter {
            kept = "{kept}{character}"
        } else {
            kept = "{kept}_"
        }
        index = index + 1
    }
    return "value_{kept}"
}

func instance_key(class_key: String, given: List<Model.Type>): String {
    var written = List<String>()
    var index = 0
    while index < given.count() {
        var argument = given[index]
        var argument_key = argument.name.replace(".", "_")
        if not argument.constant.is_empty() {
            argument_key = constant_key(argument.constant)
        }
        if argument.is_nullable {
            argument_key = "{argument_key}_maybe"
        }
        written.append(argument_key)
        index = index + 1
    }
    var joined = written.join("_and_")
    return "{class_key}_of_{joined}"
}

func mint(
    key: String,
    found: Mapping.ClassFile,
    file: AbstractSyntaxTree.Shapes.SourceFile,
    names: List<String>,
    given: List<Model.Type>,
) {
    var shown = shown_name_of(found.namespace, given)
    var model = Model.ClassModel(key, shown, file)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = given[index]
        crash bound
        model.bound_types[name] = bound
        index = index + 1
    }
    program.add(model)
    waiting.append(model)
}

func shown_name_of(class_key: String, given: List<Model.Type>): String {
    var written = given.map_names()
    var joined = written.join(", ")
    return "{class_key}<{joined}>"
}

var state = ResolutionState()
var same_members = SameMembers(state)
var monomorphiser = Instances(state)
var types = Types(state)
var owners = Owners(state)
var reading = Reading(state)

func Resolver(starting_symbols: Symbols.SymbolTable) {
    state.symbols = starting_symbols
}

func resolve(entry: Mapping.ClassFile): Model.ProgramModel {
    state.program.entry = entry.namespace
    var paths = state.symbols.read_paths()
    paths.each(monomorphiser.add_a_plain_class)
    monomorphiser.fill_the_waiting()
    return state.program
}

var state = ResolutionState()
var same_members = SameMembers(state)
var monomorphiser = Instances(state)
var types = Types(state)
var typing = Inference()

func Resolver(starting_symbols: Symbols.SymbolTable) {
    state.symbols = starting_symbols
}

func resolve(entry: Mapping.ClassFile): Model.ProgramModel {
    state.program.entry = entry.namespace
    var paths = state.symbols.read_paths()
    paths.each(monomorphiser.add_a_plain_class)
    monomorphiser.fill_the_waiting()
    return state.program
}

func fill(model: Model.ClassModel) {
    var outer = state.context
    state.context = model
    model.file.declarations.each(read_enum_or_union)
    model.file.declarations.each(read_declaration)
    state.context = outer
}

func read_enum_or_union(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: state.context.is_singleton = true
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return
    }
}

func read_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    var made = Model.EnumModel("{state.context.key}.{declaration.name}", declaration.name)
    var counted: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        if value.number {
            counted = typing.whole_number_of(value.number)
        }
        made.values.append(value.name)
        made.numbers.append(counted)
        counted = counted + 1
        index = index + 1
    }
    state.context.enums.append(made)
}

func read_union_name(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var made = Model.UnionModel("{state.context.key}.{declaration.name}", declaration.name)
    state.context.unions.append(made)
}

func read_shape_name(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var made = Model.ShapeModel("{state.context.key}.{declaration.name}", declaration.name)
    state.context.shapes.append(made)
    state.program.shapes[made.key] = made
}

func read_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_shape_members(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
    }
}

func read_union_members(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    state.line = declaration.line
    var made = state.context.union_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        var path = member.split(".")
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member_type = types.type_of_a_path(path, no_arguments)
        made.members.append(member_type)
        index = index + 1
    }
}

func read_shape_members(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    state.line = declaration.line
    var made = state.context.shape_named(declaration.name)
    crash made
    var index = 0
    while index < declaration.members.count() {
        state.line = declaration.line + index + 1
        var member = declaration.members[index]
        var function = Model.FunctionModel(member.name, made.key)
        function.is_an_attribute = member.is_an_attribute
        state.read_parameters = List<Model.ParameterModel>()
        member.parameters.each(read_parameter)
        function.parameters = state.read_parameters
        if member.result {
            function.answer = types.type_of(member.result)
        }
        made.members.append(function)
        index = index + 1
    }
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    state.line = declaration.line
    var attribute_type = attribute_type_of(declaration)
    var made = Model.AttributeModel(declaration.name, state.context.key, attribute_type)
    made.declaration = declaration
    state.context.declared_attributes.append(made)
    note_the_room(declaration, attribute_type)
}

func attribute_type_of(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Model.Type {
    if declaration.declared_type {
        return types.type_of(declaration.declared_type)
    }
    var written = typing.written_type_of(declaration.value)
    if written and types.names_a_preset(written) {
        return types.type_of_a_preset(written)
    }
    if written {
        return types.type_of(written)
    }
    var known = typing.literal_type_of(declaration.value)
    var attribute_types = Validators.NameResolution.AttributeType.Validator()
    attribute_types.check(known, state.context.file.path, state.line, state.context.key, declaration.name)
    return types.type_of_a_name(known)
}

func note_the_room(
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    attribute_type: Model.Type,
) {
    fallback attribute_type.name == "Buffer"
    fallback state.context.room_size == 0
    state.context.room_size = typing.room_size_of(declaration.value)
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    state.line = declaration.line
    state.read_function_name = declaration.name
    state.read_function_path = declaration.path
    var key = declaration.declared_key()
    var made = Model.FunctionModel(key, state.context.key)
    made.declaration = declaration
    var simple_name = monomorphiser.simple_name_of(state.context.file)
    made.is_constructor = declaration.is_a_constructor_of(simple_name)
    made.is_a_conversion = declaration.is_a_conversion()
    made.is_a_preset = declaration.is_a_preset_of(simple_name)
    declaration.parameters.each(check_an_old_range)
    var template_index = template_index_of(declaration)
    if template_index >= 0 {
        made.is_a_member_template = true
        made.template_index = template_index
        mark_the_attribute_reads(declaration, template_index)
        state.context.declared_functions.append(made)
        return
    }
    state.read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = state.read_parameters
    var hand_copies = Validators.NameResolution.HandCopy.Validator()
    hand_copies.check(state.context.file, simple_name, declaration)
    made.reflected_answer_index = reflected_answer_index_of(declaration)
    if declaration.result and made.reflected_answer_index < 0 {
        made.answer = types.type_of(declaration.result)
    }
    state.context.declared_functions.append(made)
}

func reflected_answer_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var result = declaration.result
    if result.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        return reflection_parameter_named(declaration, result.path)
    }
    return -1
}

func reflection_parameter_named(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    path: List<String>,
): Integer {
    var named = path[0]
    if not named or path.count() < 2 {
        return -1
    }
    var reflections = [
        "Spite.Argument"
        "Spite.Attribute"
        "Spite.AttributeDeclaration"
        "Spite.Class"
        "Spite.FunctionDeclaration"
    ]
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var range = types.range_of(parameter.declared_type)
        if parameter.name == named and reflections.contains(range) {
            return index
        }
        index = index + 1
    }
    return -1
}

func check_an_old_range(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var written = parameter.declared_type
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        check_a_written_range(parameter.name, written)
    }
}

func check_a_written_range(name: String, written: AbstractSyntaxTree.Shapes.Types.NamedType) {
    fallback not written.arguments.is_empty()
    var path = written.path.join(".")
    var argument = written.arguments[0]
    var owner = generic_argument_text(argument)
    var symbol_advice = advice_for_a_written_symbol(name, path, owner)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_range(name, path, owner, symbol_advice, state.read_function_path, state.line, state.context.shown, state.read_function_name)
}

func advice_for_a_written_symbol(name: String, path: String, owner: String): String {
    fallback path == "Symbol"
    return advice_for_a_symbol(name, owner)
}

func generic_argument_text(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument): String {
    var written = argument.type_reference
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        return written.path.join(".")
    }
    return argument.text
}

func advice_for_a_symbol(name: String, owner: String): String {
    var parts = owner.split(".")
    var last_part = parts.last()
    crash last_part
    var initial = last_part.slice(0, 1)
    crash initial
    var names_a_function = parts.count() == 2 and initial == initial.lower_case()
    if names_a_function {
        return advice_for_a_function(name, parts)
    }
    var attribute_advice = "write '{name}: Spite.AttributeDeclaration' and read the attribute as 'value[{name}]' on a value of '{owner}'"
    if owner.starts_with("$") {
        return attribute_advice
    }
    var folder = state.symbols.namespace_folder(owner)
    var named_class = state.symbols.find(owner, state.context.file.namespace)
    if folder and not named_class {
        return "walk the classes of '{owner}' as ordinary code, '{owner}.classes.each({state.read_function_name})', with '{name}: Spite.Class'"
    }
    var declared = types.declared_type_in(parts, state.context)
    if declared and declared.kind == 'enumeration' {
        return "walk the values of '{owner}' as ordinary code, '{owner}.values.each({state.read_function_name})', with '{name}: {owner}'"
    }
    return attribute_advice
}

func advice_for_a_function(name: String, parts: List<String>): String {
    var class_part = parts[0]
    var function_part = parts[1]
    crash class_part
    crash function_part
    var words = function_part.split("_")
    if words.contains(name) {
        return "write '{name}: Spite.FunctionDeclaration' and call the function as 'value.{function_part}(...)' on a value of '{class_part}'"
    }
    var plural = replaced_name_word(state.read_function_name, name, "{name}s")
    return "write '{name}: Spite.Argument' and spread its plural into the call, as in 'value.{function_part}({plural}())'"
}

func replaced_name_word(text: String, word: String, replacement: String): String {
    var words = text.split("_")
    var renamed = List<String>()
    var index = 0
    while index < words.count() {
        var each_word = words[index]
        if each_word == word {
            renamed.append(replacement)
        } else {
            renamed.append(each_word)
        }
        index = index + 1
    }
    return renamed.join("_")
}

func template_index_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var words = declaration.name.split("_")
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and types.is_a_declaration_type(parameter.declared_type) {
            return index
        }
        index = index + 1
    }
    return -1
}

func range_of_a_template(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return types.range_of(parameter.declared_type)
}

func mark_the_attribute_reads(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    template_index: Integer,
) {
    var parameter = declaration.parameters[template_index]
    crash parameter
    fallback types.range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
            mark_an_attribute_read(expression, parameter.name)
        }
        index = index + 1
    }
}

func mark_an_attribute_read(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String) {
    fallback indexes_by(indexed, name)
    var target = indexed.target
    crash target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback target.name != "attributes"
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback target.name != "attributes"
        fallback not names_a_key_map(target.name)
    }
    var listed = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, "attributes")
    indexed.target = listed
}

func names_a_key_map(name: String): Boolean {
    var attribute = state.context.attribute_named(name)
    fallback attribute
    var model = state.program.class_named(attribute.attribute_type.name)
    fallback model
    var key_type = model.bound_types["$key_type"]
    fallback key_type
    return key_type.name == "Spite.AttributeDeclaration"
}

func indexes_by(indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, name: String): Boolean {
    var written = indexed.index
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

func template_owner_of(template: Model.FunctionModel, model: Model.ClassModel): Model.Type? {
    if template.inferred_owner {
        return template.inferred_owner
    }
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var range = types.range_of(parameter.declared_type)
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var outer = state.context
    state.context = model
    state.line = declaration.line
    var found: Model.Type? = null
    if range == "Spite.AttributeDeclaration" {
        found = attribute_owner(template, declaration, parameter.name, walk)
    }
    if range == "Spite.FunctionDeclaration" {
        found = function_owner(declaration, parameter.name, walk)
    }
    state.context = outer
    monomorphiser.fill_the_waiting()
    template.inferred_owner = found
    return found
}

func attribute_owner(
    template: Model.FunctionModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var classes = List<Model.Type>()
    note_the_attribute_uses(declaration, name, walk, classes, true)
    note_the_attribute_uses(declaration, name, walk, classes, false)
    if classes.is_empty() {
        return owner_without_a_read(declaration, name, walk)
    }
    var owner = classes[0]
    template.narrowed_names = common_attributes(declaration, name, classes)
    return owner
}

func owner_without_a_read(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var passed = attribute_owner_passed_on(name, walk)
    if passed {
        return passed
    }
    var is_passed_on = state.passing_depth > 0
    fallback not is_passed_on
    var value = name_of_a_class_parameter(declaration, name)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_an_attribute_owner(
        passed,
        is_passed_on,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
        value,
    )
    return null
}

func attribute_owner_passed_on(name: String, walk: AbstractSyntaxTree.Walk.Walk): Model.Type? {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var owner = attribute_owner_in_a_call(expression, name)
            if owner {
                return owner
            }
        }
        index = index + 1
    }
    return null
}

func attribute_owner_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = state.context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and state.passing_depth < 8
        return attribute_owner_in_a_helper(helper, place)
    }
    return null
}

func attribute_owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback types.range_of(parameter.declared_type) == "Spite.AttributeDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    var standing_in = Model.FunctionModel(helper.name, helper.owner)
    state.passing_depth = state.passing_depth + 1
    var found = attribute_owner(standing_in, declaration, parameter.name, walk)
    state.passing_depth = state.passing_depth - 1
    return found
}

func name_of_a_class_parameter(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
): String {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if parameter.name != name and parameter.declared_type {
            var given = types.type_of(parameter.declared_type)
            if given.kind == 'object' or given.kind == 'shape' {
                return parameter.name
            }
        }
        index = index + 1
    }
    return "value"
}

func note_the_attribute_uses(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
    on_parameters: Boolean,
) {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression and reads_a_parameter(expression, declaration) == on_parameters {
            note_an_attribute_use(expression, declaration, name, walk, classes)
        }
        index = index + 1
    }
}

func reads_a_parameter(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    var listed = indexed.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var target = listed.target
        if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            var names = declaration.parameters.map_names()
            return names.contains(target.name)
        }
    }
    return false
}

func note_an_attribute_use(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
    classes: List<Model.Type>,
) {
    fallback indexes_by(indexed, name)
    var listed = indexed.target
    var used: Model.Type? = null
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback listed.name == "attributes"
        used = Model.Type('object', state.context.key)
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name == "attributes"
        used = class_of_a_use(listed.target, declaration, name, walk)
    }
    crash used
    var index = 0
    while index < classes.count() {
        var known = classes[index]
        fallback not known.is_the_same_as(used)
        index = index + 1
    }
    classes.append(used)
}

func class_of_a_use(
    target: SpiteCompiler.Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type {
    var known = class_of_a_value(target, declaration, walk, 0)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_known_value(known, target, declaration.path, declaration.line, state.context.shown, declaration.name, name)
    crash known
    return known
}

func class_of_a_value(
    target: SpiteCompiler.Expression?,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    fallback depth < 8
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_name(target.name, declaration, walk, depth)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return class_of_a_call(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return class_of_an_element(target, declaration, walk, depth)
    }
    return null
}

func class_of_a_name(
    name: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var parameter_index = 0
    while parameter_index < declaration.parameters.count() {
        var parameter = declaration.parameters[parameter_index]
        if parameter.name == name and parameter.declared_type {
            return types.type_of(parameter.declared_type)
        }
        parameter_index = parameter_index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return class_of_a_local(statement, declaration, walk, depth)
        }
        statement_index = statement_index + 1
    }
    var attribute = state.context.attribute_named(name)
    if attribute {
        return attribute.attribute_type.present()
    }
    return null
}

func class_of_a_local(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    if statement.declared_type {
        return present_type_of(statement.declared_type)
    }
    return class_of_a_value(statement.value, declaration, walk, depth + 1)
}

func present_type_of(written: SpiteCompiler.Type): Model.Type {
    var found = types.type_of(written)
    return found.present()
}

func class_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_called_name(callee)
    }
    return null
}

func class_of_a_called_name(callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): Model.Type? {
    var function = state.context.function_named(callee.name)
    if function {
        return answer_of_a_function(function)
    }
    var first = callee.name.slice(0, 1)
    crash first
    fallback first != first.lower_case()
    var path = List<String>()
    path.append(callee.name)
    return types.type_of_a_path(path, callee.generic_arguments)
}

func answer_of_a_function(function: Model.FunctionModel): Model.Type? {
    if function.answer {
        return function.answer.present()
    }
    return null
}

func class_of_an_element(
    indexed: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Model.Type? {
    var listed = class_of_a_value(indexed.target, declaration, walk, depth + 1)
    fallback listed and listed.kind == 'object'
    var model = state.program.class_named(listed.name)
    fallback model
    var element = model.bound_types["$element_type"]
    if element {
        return element.present()
    }
    var held = model.bound_types["$value_type"]
    if held {
        return held.present()
    }
    return null
}

func common_attributes(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    classes: List<Model.Type>,
): List<String> {
    var common = List<String>()
    if classes.count() < 2 {
        return common
    }
    var owner = classes[0]
    var owner_names = attribute_names_of(owner)
    var index = 0
    while index < owner_names.count() {
        var attribute = owner_names[index]
        if every_class_has(classes, attribute) {
            common.append(attribute)
        }
        index = index + 1
    }
    var second = classes[1]
    var first_shown = types.shown_type(owner)
    var second_shown = types.shown_type(second)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_common_attribute(
        common,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
        first_shown,
        second_shown,
    )
    return common
}

func every_class_has(classes: List<Model.Type>, attribute: String): Boolean {
    var index = 1
    while index < classes.count() {
        var other = classes[index]
        var names = attribute_names_of(other)
        fallback names.contains(attribute)
        index = index + 1
    }
    return true
}

func attribute_names_of(of_type: Model.Type): List<String> {
    if of_type.kind == 'shape' {
        return shape_attribute_names(of_type)
    }
    var model = state.program.class_named(of_type.name)
    fallback model
    return model.declared_attributes.map_names()
}

func shape_attribute_names(of_type: Model.Type): List<String> {
    var shape = state.program.shape_keyed(of_type.name)
    fallback shape
    return shape.members.filter_is_an_attribute().map_names()
}

func function_owner(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var owner: Model.Type? = null
    var index = 0
    while not owner and index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            owner = owner_of_a_pattern_use(expression, declaration, name, walk)
        }
        index = index + 1
    }
    var is_passed_on = state.passing_depth > 0
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_function_owner(
        owner,
        is_passed_on,
        declaration.path,
        declaration.line,
        state.context.shown,
        declaration.name,
        name,
    )
    return owner
}

func owner_of_a_pattern_use(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var called = owner_of_a_pattern_call(call, declaration, name, walk)
    if called {
        return called
    }
    var written = owner_of_a_written_pattern(call, name)
    if written {
        return written
    }
    return owner_passed_on(call, name)
}

func owner_of_a_written_pattern(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var pattern = written_pattern_of(call, name)
        fallback not pattern.is_empty()
        var path = class_path_named(callee.target)
        fallback not path.is_empty()
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var walked = types.type_of_a_path(path, no_arguments)
        return Model.Type('parameters', "{walked.name}|{pattern}")
    }
    return null
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): String {
    var hole = "<{name}>"
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = text_of_a_literal(argument)
            if text.contains(hole) {
                return text.replace(hole, name)
            }
        }
        index = index + 1
    }
    return ""
}

func text_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var pieces = literal.pieces.map_texts()
    return pieces.join("")
}

func class_path_named(target: SpiteCompiler.Expression?): List<String> {
    var path = List<String>()
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var initial = target.name.slice(0, 1)
        crash initial
        if target.name.starts_with("$") or initial != initial.lower_case() {
            path.append(target.name)
        }
    }
    return path
}

func owner_passed_on(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var helper = state.context.function_named(callee.name)
        fallback helper and helper.declaration
        var place = place_of_the_name(call, name)
        fallback place >= 0 and state.passing_depth < 8
        return owner_in_a_helper(helper, place)
    }
    return null
}

func owner_in_a_helper(helper: Model.FunctionModel, place: Integer): Model.Type? {
    crash helper.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = helper.declaration
    var parameter = declaration.parameters[place]
    fallback parameter
    fallback types.range_of(parameter.declared_type) == "Spite.FunctionDeclaration" and declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(state.empty_file)
    walk.read_function(declaration)
    state.passing_depth = state.passing_depth + 1
    var found = function_owner(declaration, parameter.name, walk)
    state.passing_depth = state.passing_depth - 1
    return found
}

func place_of_the_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Integer {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and argument.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func owner_of_a_pattern_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    walk: AbstractSyntaxTree.Walk.Walk,
): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var words = callee.name.split("_")
        if words.contains(name) {
            var walked = class_of_a_use(callee.target, declaration, name, walk)
            return Model.Type('parameters', "{walked.name}|{callee.name}")
        }
    }
    return null
}

func function_of_parameters(owner: Model.Type): Model.FunctionModel? {
    var parts = owner.name.split("|")
    var class_key = parts[0]
    var function_name = parts[1]
    crash class_key
    crash function_name
    var walked_class = state.program.class_named(class_key)
    fallback walked_class
    return walked_class.function_named(function_name)
}

func specialized(
    template: Model.FunctionModel,
    called_name: String,
    member: String,
    member_type: Model.Type,
    is_a_function: Boolean,
    model: Model.ClassModel,
): Model.FunctionModel {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var made = Model.FunctionModel(called_name, template.owner)
    made.declaration = declaration
    made.bound_member = member
    made.bound_member_type = member_type
    made.bound_member_is_a_function = is_a_function
    made.template_index = template.template_index
    var outer_name = state.bound_member_name
    var outer_type = state.bound_member_type
    var outer_is_a_class = state.bound_member_is_a_class
    var outer = state.context
    state.context = model
    state.line = declaration.line
    bind_member(declaration, template.template_index, member_type)
    made.bound_parameter = state.bound_member_name
    state.read_parameters = List<Model.ParameterModel>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if index != template.template_index {
            read_parameter(parameter)
        }
        index = index + 1
    }
    made.parameters = state.read_parameters
    if declaration.result {
        made.answer = types.type_of(declaration.result)
    }
    state.bound_member_name = outer_name
    state.bound_member_type = outer_type
    state.bound_member_is_a_class = outer_is_a_class
    state.context = outer
    monomorphiser.fill_the_waiting()
    return made
}

# ../../spite_documentation/reflection.md#spitefunctiondeclaration
func read_as_a_walker(template: Model.FunctionModel, made: Model.FunctionModel, model: Model.ClassModel) {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var outer = state.context
    state.context = model
    state.line = declaration.line
    state.read_parameters = List<Model.ParameterModel>()
    declaration.parameters.each(read_parameter)
    made.parameters = state.read_parameters
    if declaration.result {
        made.answer = types.type_of(declaration.result)
    }
    state.context = outer
    monomorphiser.fill_the_waiting()
}

func bind_member(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    parameter_index: Integer,
    member_type: Model.Type,
) {
    var parameter = declaration.parameters[parameter_index]
    crash parameter
    state.bound_member_name = parameter.name
    state.bound_member_type = member_type
    state.bound_member_is_a_class = types.range_of(parameter.declared_type) == "Spite.Class"
}

func unbind_member() {
    state.bound_member_name = ""
    state.bound_member_type = null
    state.bound_member_is_a_class = false
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    crash parameter.declared_type
    var collecting = state.read_parameters
    var parameter_type = types.type_of(parameter.declared_type)
    state.read_parameters = collecting
    var made = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
    state.read_parameters.append(made)
}

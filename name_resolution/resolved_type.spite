var path = List<String>()
var arguments = List<ResolvedType>()
var is_nullable = false
var kind = "named"
var owner_type: ResolvedType? = null
var argument_keys = List<String>()

func ResolvedType(
    starting_path: List<String>,
    starting_arguments: List<ResolvedType>,
    starting_nullable: Boolean,
    starting_kind: String,
) {
    path = starting_path
    arguments = starting_arguments
    is_nullable = starting_nullable
    kind = starting_kind
}

func with(
    starting_path: List<String>,
    starting_arguments: List<ResolvedType>,
    starting_nullable: Boolean,
): ResolvedType {
    return ResolvedType(starting_path, starting_arguments, starting_nullable, kind)
}

func is_a_parameter(): Boolean {
    return kind == "parameter"
}

func is_a_member(): Boolean {
    return kind == "member"
}

func is_a_value(): Boolean {
    return kind == "value"
}

func key(): String {
    switch kind {
        "parameter": return path.join(".")
        "member": return path.join(".")
        "value": return path.join(".")
        _: return named_key()
    }
}

func named_key(): String {
    var name = path.join(".")
    if arguments.count() > 0 {
        argument_keys = List<String>()
        arguments.each(add_argument_key)
        var joined = argument_keys.join(", ")
        name = "{name}<{joined}>"
    }
    if is_nullable {
        return "{name}?"
    }
    return name
}

func add_argument_key(argument: ResolvedType) {
    var argument_key = argument.key()
    argument_keys.append(argument_key)
}

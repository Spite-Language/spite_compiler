var mangle = Mangle()
var names = Mapping.Names()
var types = Types()

func of(shape: AbstractSyntaxTree.Shapes.Types.Type, substitution: Substitution): String {
    var path = shape.path
    if path.is_empty() {
        return ""
    }
    var first = path.first()
    crash first
    if first.starts_with("$") {
        return of_a_parameter(first, substitution)
    }
    if not names_a_class(first) {
        return ""
    }
    var last = path.last()
    crash last
    return of_the_class(last, shape.arguments, substitution)
}

func of_a_parameter(name: String, substitution: Substitution): String {
    var bound = substitution.lookup(name)
    if bound {
        return of_a_bound_type(bound)
    } else {
        return ""
    }
}

func of_the_class(
    name: String,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    substitution: Substitution,
): String {
    var single = List<String>()
    single.append(name)
    var only_the_class = AbstractSyntaxTree.Shapes.Types.NamedType(single, arguments)
    var written = types.convert(only_the_class)
    var applied = substitution.apply(written)
    return of_a_bound_type(applied)
}

func of_a_bound_type(written: ResolvedType): String {
    if written.is_a_parameter() {
        return ""
    }
    if written.is_a_member() {
        return ""
    }
    if written.is_a_value() {
        return ""
    }
    var path = written.path
    if path.is_empty() {
        return ""
    }
    var last = path.last()
    crash last
    return mangle.of(last, written.arguments)
}

func names_a_class(written: String): Boolean {
    if written.is_empty() {
        return false
    }
    var first = written.code_at(0)
    return not names.is_lower_letter(first)
}

var found = List<TypeUse>()
var arguments = List<ResolvedType>()
var parameters = Dictionary<String, ResolvedType>()
var held_attributes = Dictionary<String, ResolvedType>()
var current_line = 0
var types = Types()

func find(file: AbstractSyntaxTree.Shapes.SourceFile): List<TypeUse> {
    found = List<TypeUse>()
    held_attributes = Dictionary<String, ResolvedType>()
    file.declarations.each(read_declaration)
    var answer = found
    found = List<TypeUse>()
    return answer
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: read_generic(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_type_shape(declaration)
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: read_singleton()
    }
}

func read_singleton() {
    return
}

func read_union(_declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    return
}

func read_enum(_declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    return
}

func read_generic(declaration: AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration) {
    if declaration.bound {
        add(declaration.bound, declaration.line)
    } else {
        return
    }
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    if declaration.declared_type {
        add(declaration.declared_type, declaration.line)
        var written = convert(declaration.declared_type, declaration.line)
        held_attributes[declaration.name] = as_type(written)
    } else {
        return
    }
}

func read_type_shape(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    declaration.members.each(read_member)
}

func read_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    member.parameters.each(read_parameter)
    if member.result {
        add(member.result, 0)
    } else {
        return
    }
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    current_line = declaration.line
    parameters = Dictionary<String, ResolvedType>()
    declaration.parameters.each(read_parameter)
    if declaration.result {
        add(declaration.result, declaration.line)
    } else {
        return
    }
    if declaration.body {
        read_block(declaration.body)
    } else {
        return
    }
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block) {
    block.statements.each(read_statement)
}

func read_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        read_variable(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        read_held(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        read_assigned(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        read_return(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        read_if(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        read_while(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.SwitchStatement {
        read_switch(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.AssertStatement {
        read_assert(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.CrashStatement {
        read_crash(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
        read_load(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.Block {
        read_block(statement)
        return
    }
    return
}

func read_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    current_line = statement.line
    if statement.declared_type {
        add(statement.declared_type, statement.line)
    }
    read_expression(statement.value)
}

func read_held(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    current_line = statement.line
    read_expression(statement.value)
}

func read_assigned(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    current_line = statement.line
    read_expression(statement.target)
    read_expression(statement.value)
}

func read_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    current_line = statement.line
    read_expression(statement.value)
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    current_line = statement.line
    read_expression(statement.condition)
    if statement.then_branch {
        read_block(statement.then_branch)
    } else {
        return
    }
    if statement.else_branch {
        read_block(statement.else_branch)
    } else {
        return
    }
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    current_line = statement.line
    read_expression(statement.condition)
    if statement.body {
        read_block(statement.body)
    } else {
        return
    }
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    current_line = statement.line
    read_expression(statement.value)
    statement.cases.each(read_case)
}

func read_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    read_expression(switch_case.value)
    if switch_case.body {
        read_block(switch_case.body)
    } else {
        return
    }
}

func read_assert(statement: AbstractSyntaxTree.Shapes.Statements.AssertStatement) {
    current_line = statement.line
    read_expression(statement.condition)
}

func read_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    current_line = statement.line
    read_expression(statement.condition)
}

func read_load(statement: AbstractSyntaxTree.Shapes.Statements.LoadStatement) {
    read_expression(statement.folder)
}

func read_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if expression {
        read_a_expression(expression)
    } else {
        return
    }
}

func read_a_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_call(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_member(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_binary(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_unary(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        read_index(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        read_text(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        read_list(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        read_entry(expression)
        return
    }
    return
}

func read_call(expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    expression.generic_arguments.each(read_argument)
    if expression.generic_arguments.count() != 0 {
        read_a_generic_call(expression)
    }
    read_expression(expression.callee)
    expression.arguments.each(read_a_expression)
}

func read_a_generic_call(expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    assert expression.generic_arguments.count() != 0
    var callee = expression.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = callee
        if name.is_a_class_name {
            var path = List<String>()
            path.append(name.name)
            var use = convert_a_use(path, expression.generic_arguments, current_line)
            found.append(use)
        }
    }
}

func read_a_member(expression: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    read_expression(expression.target)
}

func read_binary(expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    read_expression(expression.left)
    read_expression(expression.right)
}

func read_unary(expression: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    read_expression(expression.operand)
}

func read_index(expression: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    read_expression(expression.target)
    read_expression(expression.index)
}

func read_text(expression: AbstractSyntaxTree.Shapes.Expressions.TextLiteral) {
    expression.pieces.each(read_piece)
}

func read_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    read_expression(piece.hole)
}

func read_list(expression: AbstractSyntaxTree.Shapes.Expressions.ListLiteral) {
    expression.entries.each(read_a_expression)
}

func read_entry(expression: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral) {
    read_expression(expression.key)
    read_expression(expression.value)
}

func read_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.is_type {
        read_a_type_argument(argument)
    } else {
        return
    }
}

func read_a_type_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.type_reference {
        add(argument.type_reference, 0)
    } else {
        return
    }
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    if parameter.declared_type {
        add(parameter.declared_type, 0)
        var written = convert(parameter.declared_type, 0)
        parameters[parameter.name] = as_type(written)
    } else {
        return
    }
}

func add(shape: AbstractSyntaxTree.Shapes.Types.Type, line: Integer) {
    if shape == AbstractSyntaxTree.Shapes.Types.NamedType {
        var written = convert(shape, line)
        found.append(written)
    } else {
        return
    }
}

func convert(shape: AbstractSyntaxTree.Shapes.Types.Type, line: Integer): TypeUse {
    var named = shape
    return convert_a_use(named.path, named.arguments, line)
}

func convert_a_use(
    path: List<String>,
    generic_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    line: Integer,
): TypeUse {
    var outer = arguments
    arguments = List<ResolvedType>()
    generic_arguments.each(convert_argument)
    var mine = arguments
    arguments = outer
    var kind = classify(path)
    var use = TypeUse(path, mine, kind, line)
    if kind == "member" {
        var owner = path[0]
        crash owner
        use.owner = owner
        var known = owner_type_of(owner)
        use.owner_type = known
    }
    return use
}

func classify(segments: List<String>): String {
    if segments.count() == 1 {
        return classify_one(segments)
    } else {
        return "member"
    }
}

func classify_one(segments: List<String>): String {
    var first = segments[0]
    crash first
    if starts_with_dollar(first) {
        return "parameter"
    } else {
        return "named"
    }
}

func convert_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.is_type {
        append_a_type(argument)
    } else {
        var written = types.value(argument.text)
        arguments.append(written)
    }
}

func append_a_type(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.type_reference {
        var inner = convert(argument.type_reference, 0)
        var written = as_type(inner)
        arguments.append(written)
    } else {
        var written = types.value("")
        arguments.append(written)
    }
}

func as_type(use: TypeUse): ResolvedType {
    if use.kind == "parameter" {
        var name = use.path.join(".")
        return types.parameter(name)
    }
    if use.kind == "member" {
        var member_name = use.path[1]
        crash member_name
        return types.member(use.owner, member_name, use.owner_type)
    }
    return types.named(use.path, use.arguments)
}

func owner_type_of(owner: String): ResolvedType? {
    var from_parameter = parameters[owner]
    if from_parameter {
        return from_parameter
    }
    var from_attribute = held_attributes[owner]
    if from_attribute {
        return from_attribute
    }
    return null
}

func starts_with_dollar(name: String): Boolean {
    return name.starts_with("$")
}

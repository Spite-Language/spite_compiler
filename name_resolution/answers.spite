var by_class = Dictionary<String, Dictionary<String, String>>()
var sizes = Dictionary<String, Integer>()
var by_attribute = Dictionary<String, Dictionary<String, String>>()
var by_generic = Dictionary<String, Dictionary<String, String>>()

func note(class_name: String, function_name: String, answered: String) {
    if answered.is_empty() {
        return
    } else {
        var functions = functions_of(class_name)
        functions[function_name] = answered
    }
}

func note_attribute(class_name: String, attribute_name: String, answered: String) {
    if answered.is_empty() {
        return
    } else {
        var attributes = attributes_of(class_name)
        attributes[attribute_name] = answered
    }
}

func attribute_of(class_name: String, attribute_name: String): String {
    var attributes = by_attribute[class_name]
    if attributes {
        return the_answer_of(attributes, attribute_name)
    } else {
        return ""
    }
}

func note_generic(class_name: String, written_use: String, instance_name: String) {
    if instance_name.is_empty() {
        return
    } else {
        var uses = generics_of(class_name)
        uses[written_use] = instance_name
    }
}

func generic_of(class_name: String, written_use: String): String {
    var uses = by_generic[class_name]
    if uses {
        return the_answer_of(uses, written_use)
    } else {
        return ""
    }
}

func generics_of(class_name: String): Dictionary<String, String> {
    var found = by_generic[class_name]
    if found {
        return found
    } else {
        var made = Dictionary<String, String>()
        by_generic[class_name] = made
        return made
    }
}

func attributes_of(class_name: String): Dictionary<String, String> {
    var found = by_attribute[class_name]
    if found {
        return found
    } else {
        var made = Dictionary<String, String>()
        by_attribute[class_name] = made
        return made
    }
}

func answer_of(class_name: String, function_name: String): String {
    var functions = by_class[class_name]
    if functions {
        return the_answer_of(functions, function_name)
    } else {
        return ""
    }
}

func functions_of(class_name: String): Dictionary<String, String> {
    var found = by_class[class_name]
    if found {
        return found
    } else {
        var made = Dictionary<String, String>()
        by_class[class_name] = made
        return made
    }
}

func the_answer_of(functions: Dictionary<String, String>, function_name: String): String {
    var answered = functions[function_name]
    if answered {
        return answered
    } else {
        return ""
    }
}

func note_size(class_name: String, size: Integer) {
    sizes[class_name] = size
}

func size_of(class_name: String): Integer {
    var known = sizes[class_name]
    if known {
        return known
    } else {
        return 0
    }
}

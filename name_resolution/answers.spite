var by_class = Dictionary<String, Dictionary<String, String>>()

func note(class_name: String, function_name: String, answered: String) {
    if answered.is_empty() {
        return
    } else {
        var functions = functions_of(class_name)
        functions[function_name] = answered
    }
}

func answer_of(class_name: String, function_name: String): String {
    var functions = by_class[class_name]
    if functions {
        return the_answer_of(functions, function_name)
    } else {
        return ""
    }
}

func functions_of(class_name: String): Dictionary<String, String> {
    var found = by_class[class_name]
    if found {
        return found
    } else {
        var made = Dictionary<String, String>()
        by_class[class_name] = made
        return made
    }
}

func the_answer_of(functions: Dictionary<String, String>, function_name: String): String {
    var answered = functions[function_name]
    if answered {
        return answered
    } else {
        return ""
    }
}

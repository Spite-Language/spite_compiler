var origin = ""
var class_name = ""
var name = ""
var parameters = List<String>()
var substitution = Substitution()

func Instance(
    starting_origin: String,
    starting_class_name: String,
    starting_name: String,
    starting_parameters: List<String>,
    starting_substitution: Substitution,
) {
    origin = starting_origin
    class_name = starting_class_name
    name = starting_name
    parameters = starting_parameters
    substitution = starting_substitution
}

func bound_parameters(): String {
    return parameters.join(", ")
}

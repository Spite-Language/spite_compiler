var keywords = [
    "func"
    "var"
    "enum"
    "union"
    "type"
    "return"
    "if"
    "while"
    "switch"
    "fallback"
    "crash"
    "load"
    "generic"
]
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(path: String, class_name: String, tokens: List<AbstractSyntaxTree.Tokens.Token>): List<Diagnostics.Problem> {
    var index = 0
    while index + 1 < tokens.count() {
        var token = tokens[index]
        var next = tokens[index + 1]
        if token.kind == 'name' and next.line == token.line and starts_a_value(next) and starts_its_line(tokens, index) {
            fix_the_word(path, class_name, token)
        }
        index = index + 1
    }
    return found_problems
}

func starts_its_line(tokens: List<AbstractSyntaxTree.Tokens.Token>, index: Integer): Boolean {
    if index == 0 {
        return true
    }
    var before = tokens[index - 1]
    var token = tokens[index]
    crash before
    crash token
    return before.line != token.line
}

func starts_a_value(next: AbstractSyntaxTree.Tokens.Token): Boolean {
    var kind = next.kind
    var is_a_name = kind == 'name' or kind == 'class_name' or kind == 'generic_name'
    var is_a_literal = kind == 'integer_literal' or kind == 'decimal_literal' or kind == 'text_literal'
    return is_a_name or is_a_literal or kind == 'not' or kind == 'keyword_this' or kind == 'keyword_true' or kind == 'keyword_false'
}

func fix_the_word(path: String, class_name: String, token: AbstractSyntaxTree.Tokens.Token) {
    var keyword = the_one_keyword_near(token.lexeme)
    fallback not keyword.is_empty()
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, "", 1)
    var kind = lexer.keywords[keyword]
    crash kind
    var problem = Diagnostics.Problem(
        path,
        token.line,
        "'{token.lexeme}' was one letter from the keyword '{keyword}' and from no other word that starts a line; wrote '{keyword}'",
    )
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.append(problem)
    token.kind = kind
    token.lexeme = keyword
    token.text = keyword
}

func the_one_keyword_near(word: String): String {
    var found = ""
    var index = 0
    while index < keywords.count() {
        var keyword = keywords[index]
        if is_one_letter_from(word, keyword) {
            fallback found.is_empty()
            found = keyword
        }
        index = index + 1
    }
    return found
}

func is_one_letter_from(word: String, keyword: String): Boolean {
    fallback word != "{keyword}s"
    var word_length = word.length()
    var keyword_length = keyword.length()
    if word_length == keyword_length {
        return differs_by_one_letter(word, keyword)
    }
    if word_length == keyword_length + 1 {
        return drops_to(word, keyword)
    }
    if keyword_length == word_length + 1 and word_length > 1 {
        return drops_to(keyword, word)
    }
    return false
}

func differs_by_one_letter(word: String, keyword: String): Boolean {
    var first = -1
    var differences = 0
    var index = 0
    while index < word.length() {
        if word.byte_at(index) != keyword.byte_at(index) {
            if first < 0 {
                first = index
            }
            differences = differences + 1
        }
        index = index + 1
    }
    if differences == 1 {
        return word.length() > 2
    }
    fallback differences == 2 and first + 1 < word.length()
    var swapped_first = word.byte_at(first) == keyword.byte_at(first + 1)
    var swapped_second = word.byte_at(first + 1) == keyword.byte_at(first)
    return swapped_first and swapped_second
}

func drops_to(longer: String, shorter: String): Boolean {
    var skipped = 0
    var long_index = 0
    var short_index = 0
    while short_index < shorter.length() {
        if longer.byte_at(long_index) == shorter.byte_at(short_index) {
            short_index = short_index + 1
        } else {
            skipped = skipped + 1
            fallback skipped == 1
        }
        long_index = long_index + 1
    }
    return true
}

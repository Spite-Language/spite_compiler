var rule = Validators.AbstractSyntaxTree.MisspeltKeyword.Validator()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(path: String, class_name: String, tokens: List<AbstractSyntaxTree.Tokens.Token>): List<Diagnostics.Problem> {
    var index = 0
    while index + 1 < tokens.count() {
        var token = tokens[index]
        var answer = rule.check(tokens, index)
        if answer.is_fixable() {
            fix_the_word(path, class_name, token)
        }
        index = index + 1
    }
    return found_problems
}

func fix_the_word(path: String, class_name: String, token: AbstractSyntaxTree.Tokens.Token) {
    var keyword = rule.the_one_keyword_near(token.lexeme)
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, "", 1)
    var kind = lexer.keywords[keyword]
    crash kind
    var problem = Diagnostics.Problem(
        path,
        token.line,
        "'{token.lexeme}' was one letter from the keyword '{keyword}' and from no other word that starts a line; wrote '{keyword}'",
    )
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.append(problem)
    token.kind = kind
    token.lexeme = keyword
    token.text = keyword
}

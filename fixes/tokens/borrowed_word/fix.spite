var rule = Validators.AbstractSyntaxTree.BorrowedWord.Validator()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(path: String, class_name: String, tokens: List<AbstractSyntaxTree.Tokens.Token>): List<Diagnostics.Problem> {
    var index = 0
    while index + 1 < tokens.count() {
        var token = tokens[index]
        var answer = rule.check_a_load(tokens, index)
        if answer.is_fixable() {
            var folder = tokens[index + 1]
            fix_the_load(path, class_name, token, folder)
        }
        index = index + 1
    }
    return found_problems
}

func fix_the_load(
    path: String,
    class_name: String,
    token: AbstractSyntaxTree.Tokens.Token,
    folder: AbstractSyntaxTree.Tokens.Token,
) {
    var message = rule.messages[token.lexeme]
    crash message
    var problem = Diagnostics.Problem(path, token.line, "{message}; wrote 'load \"{folder.lexeme}\"'")
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.append(problem)
    token.kind = 'keyword_load'
    token.lexeme = "load"
    token.text = "load"
}

var rule = Validators.AbstractSyntaxTree.LineBreak.Validator()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#what-the-formatter-rewrites
func fixed(path: String, class_name: String, text: String): List<Diagnostics.Problem> {
    var answer = rule.check(text)
    if answer.is_fixable() {
        fix_the_line_breaks(path, class_name, text)
    }
    return found_problems
}

func fix_the_line_breaks(path: String, class_name: String, text: String) {
    var written = "\\r"
    if text.contains("\r\n") {
        written = "\\r\\n"
    }
    var problem = Diagnostics.Problem(
        path,
        0,
        "a line ended with '{written}', and a Spite file ends every line with '\\n' alone; wrote '\\n' at the end of every line",
    )
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.append(problem)
}

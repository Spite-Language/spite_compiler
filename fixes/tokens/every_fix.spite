# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    path: String,
    class_name: String,
    text: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
): List<Diagnostics.Problem> {
    var found = Diagnostics.Report()
    var line_breaks = Fixes.Tokens.LineBreak.Fix()
    var rewritten_breaks = line_breaks.fixed(path, class_name, text)
    found.add_all(rewritten_breaks)
    var keywords = Fixes.Tokens.MisspeltKeyword.Fix()
    var corrected = keywords.fixed(path, class_name, tokens)
    found.add_all(corrected)
    return found.problems
}

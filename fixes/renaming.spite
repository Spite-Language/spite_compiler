var function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var old_name = ""
var new_name = ""

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func Renaming(
    starting_function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    starting_old_name: String,
    starting_new_name: String,
) {
    function = starting_function
    old_name = starting_old_name
    new_name = starting_new_name
}

func run() {
    crash function
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == old_name {
            parameter.name = new_name
        }
        index = index + 1
    }
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(function)
    var walk = AbstractSyntaxTree.Walk.Walk(holder)
    walk.statements.each(rename_a_declared)
    walk.expressions.each(rename_an_identifier)
}

func rename_a_declared(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == old_name {
        statement.name = new_name
    }
}

func rename_an_identifier(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name == old_name {
        expression.name = new_name
    }
}

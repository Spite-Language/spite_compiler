var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var found_problems = List<Diagnostics.Problem>()
var names = Validators.AbstractSyntaxTree.Names.Validator()
var rule = Validators.AbstractSyntaxTree.LocalNames.Validator()
var abbreviations = AbstractSyntaxTree.Names.Abbreviations()
var underscore = 95

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    walk.function_declarations.each(fix_the_parameters)
    walk.statements.each(fix_a_local)
    return found_problems
}

func fix_the_parameters(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        fix_a_parameter(function, parameter.name)
        index = index + 1
    }
}

func fix_a_parameter(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String) {
    var right = spelled(function, name, function.line, "parameter")
    var answer = rule.check_a_read_parameter(walk, function, right)
    if answer.is_fixable() {
        take_the_underscore_off(function, right, function.line)
    }
}

func fix_a_local(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    var function = walk.function_named(found.function_name)
    crash function
    var right = spelled(function, statement.name, statement.line, "variable")
    var answer = rule.check_a_read_local(walk, function, found.function_name, statement, right)
    if answer.is_fixable() {
        take_the_underscore_off(function, right, statement.line)
    }
}

func spelled(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    line: Integer,
    what: String,
): String {
    var right = name
    var case_answer = rule.check_the_case(right)
    if case_answer.is_fixable() {
        var snake = snake_case_of(right)
        right = step(
            function,
            right,
            snake,
            line,
            "the {what} '{right}' was not written in snake_case, lowercase words joined by underscores; renamed it '{snake}'",
        )
    }
    var joined = joined_once(right)
    if joined != right {
        right = step(
            function,
            right,
            joined,
            line,
            "the {what} '{right}' joined its words with more than one underscore or ended with one; renamed it '{joined}'",
        )
    }
    var full = spelled_out(right)
    if full != right {
        right = step(
            function,
            right,
            full,
            line,
            "'{right}' abbreviated, and Spite has no abbreviations outside its own keywords; renamed it '{full}'",
        )
    }
    return right
}

func take_the_underscore_off(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    line: Integer,
) {
    var bare = rule.bare_of(name)
    rename(
        function,
        name,
        bare,
        line,
        "'{name}' was read, so it must not start with an underscore: only a parameter the body ignores is named that way; renamed it '{bare}'",
    )
}

func step(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    right: String,
    line: Integer,
    text: String,
): String {
    var answer = rule.check_a_rename(walk, function, name, right)
    if not answer.is_fixable() {
        return name
    }
    rename(function, name, right, line, text)
    return right
}

func rename(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    right: String,
    line: Integer,
    text: String,
) {
    var renaming = Fixes.Renaming(function, name, right)
    renaming.run()
    var problem = Diagnostics.Problem(walk.file.path, line, text)
    problem.class_name = class_name
    problem.function_name = function.declared_key()
    problem.is_fix = true
    found_problems.append(problem)
}

func snake_case_of(name: String): String {
    var index = 0
    var previous = underscore
    while index < name.length() {
        var code = name.byte_at(index)
        var is_upper = names.is_an_upper_letter(code)
        var fits = names.is_a_lower_letter(code) or is_upper or names.is_a_digit(code) or code == underscore
        fallback fits and not (is_upper and names.is_an_upper_letter(previous))
        previous = code
        index = index + 1
    }
    var pieces = name.split("_")
    var snake_pieces = List<String>()
    var piece_index = 0
    while piece_index < pieces.count() {
        var piece = pieces[piece_index]
        var snake = piece.snake_case()
        snake_pieces.append(snake)
        piece_index = piece_index + 1
    }
    return snake_pieces.join("_")
}

func joined_once(name: String): String {
    var shown = ""
    var index = 0
    var previous = 0
    while index < name.length() {
        var code = name.byte_at(index)
        var letter = name[index]
        crash letter
        if code != underscore or previous != underscore {
            shown = "{shown}{letter}"
        }
        previous = code
        index = index + 1
    }
    while shown.ends_with("_") {
        var end = shown.length() - 1
        var cut = shown.slice(0, end)
        crash cut
        shown = cut
    }
    return shown
}

func spelled_out(name: String): String {
    var words = names.words_of(name)
    var spelled_words = List<String>()
    var has_a_full_word = false
    var index = 0
    while index < words.count() {
        var word = words[index]
        var meanings = abbreviations.meanings_of(word)
        if not meanings.is_empty() {
            return name
        }
        var full = abbreviations.full_word_of(word)
        if full.is_empty() {
            spelled_words.append(word)
        } else {
            spelled_words.append(full)
            has_a_full_word = true
        }
        index = index + 1
    }
    if has_a_full_word {
        return names.spelled_like(name, spelled_words)
    }
    return name
}

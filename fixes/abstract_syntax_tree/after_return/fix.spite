var path = ""
var class_name = ""
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    path = walk.file.path
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    walk.blocks.each(fix_block)
    return found_problems
}

func fix_block(found: AbstractSyntaxTree.Walk.Found.Block) {
    crash found.block
    var statements = found.block.statements
    var index = 0
    while index + 1 < statements.count() {
        var ending = statements[index]
        if ending.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            remove_after(statements, index + 1, found.function_name)
            return
        }
        index = index + 1
    }
}

func remove_after(statements: List<SpiteCompiler.WrittenStatement>, first: Integer, function_name: String) {
    fallback not holds_a_load(statements, first)
    var following = statements[first]
    crash following
    var problem = Diagnostics.Problem(
        path,
        following.line,
        "this statement came after a 'return', so it never ran; removed it and whatever followed it",
    )
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_fix = true
    found_problems.append(problem)
    statements.truncate(first)
}

func holds_a_load(statements: List<SpiteCompiler.WrittenStatement>, first: Integer): Boolean {
    var index = first
    while index < statements.count() {
        var statement = statements[index]
        if is_or_holds_a_load(statement) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_or_holds_a_load(statement: SpiteCompiler.WrittenStatement): Boolean {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return true
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return an_if_holds_a_load(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: return a_block_holds_a_load(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return a_case_holds_a_load(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: return a_block_holds_a_load(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return false
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return false
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return false
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return false
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return false
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return false
    }
}

func an_if_holds_a_load(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement): Boolean {
    return a_block_holds_a_load(branch.then_branch) or a_block_holds_a_load(branch.else_branch)
}

func a_case_holds_a_load(chosen: AbstractSyntaxTree.Shapes.Statements.SwitchStatement): Boolean {
    var index = 0
    while index < chosen.cases.count() {
        var switch_case = chosen.cases[index]
        if a_block_holds_a_load(switch_case.body) {
            return true
        }
        index = index + 1
    }
    return false
}

func a_block_holds_a_load(block: AbstractSyntaxTree.Shapes.Statements.Block?): Boolean {
    fallback block
    return holds_a_load(block.statements, 0)
}

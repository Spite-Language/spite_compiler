var rule = Validators.AbstractSyntaxTree.OwnNamespace.Validator()
var taken = List<String>()
var found_problems = List<Diagnostics.Problem>()
var lines = List<String>()
var table: Symbols.SymbolTable
var tree: AbstractSyntaxTree.Shapes.SourceFile
var class_name: String

func Fix(
    starting_table: Symbols.SymbolTable,
    starting_tree: AbstractSyntaxTree.Shapes.SourceFile,
    starting_class_name: String,
) {
    table = starting_table
    tree = starting_tree
    class_name = starting_class_name
}

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func read_again(parsing: AbstractSyntaxTree.AbstractSyntaxTree, text: String): AbstractSyntaxTree.AbstractSyntaxTree {
    tree.declarations.each(note_a_name)
    lines = text.split("\n")
    var index = parsing.tokens.count() - 1
    while index >= 0 {
        fix_a_path_ending_at(parsing.tokens, index)
        index = index - 1
    }
    if found_problems.is_empty() {
        return parsing
    }
    var shortened = lines.join("\n")
    var again = AbstractSyntaxTree.AbstractSyntaxTree(tree.path, tree.namespace, shortened)
    again.keeps_the_comments = parsing.keeps_the_comments
    again.fixes_as_class = parsing.fixes_as_class
    tree = again.run()
    found_problems.each(again.token_fixes.append)
    return again
}

func note_a_name(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: taken.append(declaration.name)
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: taken.append(declaration.name)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: taken.append(declaration.name)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: taken.append(declaration.name)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: taken.append(declaration.name)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: note_a_function(declaration)
    }
}

func note_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback not function.is_a_constructor_of(class_name)
    taken.append(function.name)
}

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func fix_a_path_ending_at(tokens: List<AbstractSyntaxTree.Tokens.Token>, last: Integer) {
    var token = tokens[last]
    crash token
    fallback token.kind == 'class_name'
    var written = Fixes.AbstractSyntaxTree.OwnNamespace.WrittenPath(tokens)
    written.read_back_from(last)
    fallback written.is_whole and written.names.count() >= 2
    var answer = rule.check(written.names, table, tree.namespace, taken)
    fallback answer.is_fixable()
    var kept = answer.fix.split(".")
    var dropped = written.names.count() - kept.count()
    var first = written.token_at(0)
    var kept_first = written.token_at(dropped)
    fallback first.line == kept_first.line
    cut(first.line, first.column, kept_first.column)
    var whole = written.names.join(".")
    var text = rule.shortened_text(whole, answer.fix)
    var problem = Diagnostics.Problem(tree.path, first.line, text)
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.prepend(problem)
}

func cut(line: Integer, from_column: Integer, to_column: Integer) {
    var line_text = lines[line - 1]
    crash line_text
    var length = line_text.length()
    var before = line_text.slice(0, from_column - 1)
    crash before
    var after = line_text.slice(to_column - 1, length)
    crash after
    lines[line - 1] = "{before}{after}"
}

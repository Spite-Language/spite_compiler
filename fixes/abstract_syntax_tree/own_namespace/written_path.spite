var is_whole = false
var names = List<String>()
var places = List<Integer>()
var tokens: List<AbstractSyntaxTree.Tokens.Token>

func WrittenPath(starting_tokens: List<AbstractSyntaxTree.Tokens.Token>) {
    tokens = starting_tokens
}

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func read_back_from(last: Integer) {
    var index = last
    take(index)
    while kind_at(index - 1) == 'dot' and kind_at(index - 2) == 'class_name' {
        index = index - 2
        take(index)
    }
    var continues = kind_at(last + 1) == 'dot' and kind_at(last + 2) == 'class_name'
    is_whole = kind_at(index - 1) != 'dot' and not continues
}

func take(index: Integer) {
    var token = token_at_place(index)
    names.prepend(token.text)
    places.prepend(index)
}

func token_at(place: Integer): AbstractSyntaxTree.Tokens.Token {
    var index = places[place]
    crash index
    return token_at_place(index)
}

func token_at_place(index: Integer): AbstractSyntaxTree.Tokens.Token {
    var token = tokens[index]
    crash token
    return token
}

func kind_at(index: Integer): AbstractSyntaxTree.Tokens.Token.Kind {
    if index < 0 or index >= tokens.count() {
        return 'end_of_file'
    }
    var token = tokens[index]
    return token.kind
}

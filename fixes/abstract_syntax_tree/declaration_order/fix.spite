var order = "the singleton line, generic lines, enums, unions, types, variables, the constructor, conversions, presets, then functions"

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Diagnostics.Problem> {
    var found = List<Diagnostics.Problem>()
    var naming = Validators.AbstractSyntaxTree.DeclarationOrder.Validator()
    var highest = 0
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var rank = file.rank_of(declaration, class_name)
        if rank < highest {
            var later = naming.rank_name(rank)
            var earlier = naming.rank_name(highest)
            var text = "{later} came after {earlier} here; moved it up, since a file is ordered: {order}"
            var problem = Diagnostics.Problem(file.path, declaration.line, text)
            problem.class_name = class_name
            problem.is_fix = true
            found.append(problem)
        } else {
            highest = rank
        }
        index = index + 1
    }
    return found
}

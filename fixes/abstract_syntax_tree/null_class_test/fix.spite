var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var found_problems = List<Diagnostics.Problem>()
var rule = Validators.AbstractSyntaxTree.NullClassTest.Validator()

# ../../../../spite_documentation/values_and_types.md#null-is-the-one-null
func fixed(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    walk.statements.each(fix_found)
    return found_problems
}

func fix_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        var turned_if = turned(found, statement.condition, statement.line)
        if turned_if {
            statement.condition = turned_if
        }
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        var turned_while = turned(found, statement.condition, statement.line)
        if turned_while {
            statement.condition = turned_while
        }
    }
}

func turned(
    found: AbstractSyntaxTree.Walk.Found.Statement,
    condition: SpiteCompiler.Expression?,
    line: Integer,
): SpiteCompiler.Expression? {
    var answer = rule.check(condition)
    fallback answer.is_fixable()
    crash condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    var asked = condition.left
    crash asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    crash asked.target
    var written_printer = Printers.Spite.ExpressionPrinter(condition)
    var written = written_printer.text()
    var narrowing: SpiteCompiler.Expression = asked.target
    if condition.operator == 'equal_equal' {
        narrowing = AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', asked.target)
    }
    var printer = Printers.Spite.ExpressionPrinter(narrowing)
    var rewritten = printer.text()
    var text = "'{written}' asks whether the value is null, which the narrowing form says and narrows by: wrote '{rewritten}' in its place"
    var problem = Diagnostics.Problem(walk.file.path, line, text)
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_fix = true
    found_problems.append(problem)
    return narrowing
}

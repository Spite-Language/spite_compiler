var rule = Validators.AbstractSyntaxTree.OwnStorage.Validator()
var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var class_name = ""
var name = ""
var function_name = ""
var line = 0
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func fixed(
    starting_file: AbstractSyntaxTree.Shapes.SourceFile,
    starting_class_name: String,
): List<Diagnostics.Problem> {
    file = starting_file
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    file.declarations.each(fix_a_declaration)
    return found_problems
}

func fix_a_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        fix_a_function(declaration)
    }
}

func fix_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var answer = rule.check(function, file)
    fallback answer.is_fixable()
    name = answer.fix
    function_name = function.name
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(function)
    var walk = AbstractSyntaxTree.Walk(holder)
    walk.statements.each(fix_a_statement)
}

func fix_a_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    crash found.statement
    line = found.statement.line
    switch found.statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: fix_an_assignment(found.statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: fix_a_variable(found.statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: fix_an_evaluation(found.statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: fix_a_return(found.statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: fix_an_if(found.statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: fix_a_while(found.statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: fix_a_crash(found.statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: fix_a_fallback(found.statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: fix_a_switch(found.statement)
        AbstractSyntaxTree.Shapes.Statements.Block: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func fix_an_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    if rule.holds_the_name(statement.target, name) {
        statement.target = rebuilt(statement.target)
    }
    if rule.holds_the_name(statement.value, name) {
        statement.value = rebuilt(statement.value)
    }
}

func fix_a_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    if rule.holds_the_name(statement.value, name) {
        statement.value = rebuilt(statement.value)
    }
}

func fix_an_evaluation(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    if rule.holds_the_name(statement.value, name) {
        statement.value = rebuilt(statement.value)
    }
}

func fix_a_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if rule.holds_the_name(statement.value, name) {
        statement.value = rebuilt(statement.value)
    }
}

func fix_an_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    if rule.holds_the_name(statement.condition, name) {
        statement.condition = rebuilt(statement.condition)
    }
}

func fix_a_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    if rule.holds_the_name(statement.condition, name) {
        statement.condition = rebuilt(statement.condition)
    }
}

func fix_a_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    if rule.holds_the_name(statement.condition, name) {
        statement.condition = rebuilt(statement.condition)
    }
}

func fix_a_fallback(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement) {
    if rule.holds_the_name(statement.condition, name) {
        statement.condition = rebuilt(statement.condition)
    }
}

func fix_a_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    if rule.holds_the_name(statement.value, name) {
        statement.value = rebuilt(statement.value)
    }
}

# ../../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func rebuilt(written: SpiteCompiler.Expression?): SpiteCompiler.Expression {
    crash written
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return identifier_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return binary_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return unary_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return call_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return member_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return list_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return dictionary_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return entry_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return text_rebuilt(written)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return written
    }
}

func identifier_rebuilt(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): SpiteCompiler.Expression {
    if identifier.name != name {
        return identifier
    }
    var own = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("attributes")
    var piece = AbstractSyntaxTree.Shapes.Expressions.TextPiece(name, null)
    var pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
    pieces.append(piece)
    var key = AbstractSyntaxTree.Shapes.Expressions.TextLiteral(pieces)
    var index = AbstractSyntaxTree.Shapes.Expressions.IndexExpression(own, key)
    var storage = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(index, "value")
    storage.line = identifier.line
    storage.column = identifier.column
    var printer = Printers.Spite.ExpressionPrinter(storage)
    var rewritten = printer.text()
    var problem = Diagnostics.Problem(
        file.path,
        line,
        "'{name}' inside '{function_name}' would run '{function_name}' again: wrote '{rewritten}', which reaches the storage",
    )
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_fix = true
    found_problems.append(problem)
    return storage
}

func binary_rebuilt(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): SpiteCompiler.Expression {
    var left = rebuilt(binary.left)
    var right = rebuilt(binary.right)
    var made = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(left, binary.operator, right)
    made.line = binary.line
    made.column = binary.column
    return made
}

func unary_rebuilt(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression): SpiteCompiler.Expression {
    var operand = rebuilt(unary.operand)
    var made = AbstractSyntaxTree.Shapes.Expressions.UnaryExpression(unary.operator, operand)
    made.line = unary.line
    made.column = unary.column
    return made
}

func call_rebuilt(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Expression {
    var callee = rebuilt(call.callee)
    var arguments = items_rebuilt(call.arguments)
    var made = AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, call.generic_arguments, arguments)
    made.answer_is_dropped = call.answer_is_dropped
    made.line = call.line
    made.column = call.column
    return made
}

func member_rebuilt(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Expression {
    var target = rebuilt(member.target)
    var made = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, member.name)
    made.is_a_class_name = member.is_a_class_name
    made.generic_arguments = member.generic_arguments
    made.line = member.line
    made.column = member.column
    return made
}

func index_rebuilt(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): SpiteCompiler.Expression {
    var target = rebuilt(index.target)
    var key = rebuilt(index.index)
    var made = AbstractSyntaxTree.Shapes.Expressions.IndexExpression(target, key)
    made.line = index.line
    made.column = index.column
    return made
}

func list_rebuilt(listed: AbstractSyntaxTree.Shapes.Expressions.ListLiteral): SpiteCompiler.Expression {
    var entries = items_rebuilt(listed.entries)
    var made = AbstractSyntaxTree.Shapes.Expressions.ListLiteral(entries)
    made.line = listed.line
    made.column = listed.column
    return made
}

func dictionary_rebuilt(listed: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral): SpiteCompiler.Expression {
    var pairs = items_rebuilt(listed.pairs)
    var made = AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral(pairs)
    made.line = listed.line
    made.column = listed.column
    return made
}

func entry_rebuilt(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral): SpiteCompiler.Expression {
    var key = rebuilt(entry.key)
    var value = rebuilt(entry.value)
    var made = AbstractSyntaxTree.Shapes.Expressions.EntryLiteral(key, value)
    made.line = entry.line
    made.column = entry.column
    return made
}

func text_rebuilt(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): SpiteCompiler.Expression {
    var pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        var made_piece = piece_rebuilt(piece)
        pieces.append(made_piece)
        index = index + 1
    }
    var made = AbstractSyntaxTree.Shapes.Expressions.TextLiteral(pieces)
    made.line = literal.line
    made.column = literal.column
    return made
}

func piece_rebuilt(
    piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece,
): AbstractSyntaxTree.Shapes.Expressions.TextPiece {
    if piece.hole {
        var hole = rebuilt(piece.hole)
        return AbstractSyntaxTree.Shapes.Expressions.TextPiece(piece.text, hole)
    }
    return piece
}

func items_rebuilt(items: List<SpiteCompiler.Expression>): List<SpiteCompiler.Expression> {
    var made = List<SpiteCompiler.Expression>()
    var index = 0
    while index < items.count() {
        var item = items[index]
        var made_item = rebuilt(item)
        made.append(made_item)
        index = index + 1
    }
    return made
}

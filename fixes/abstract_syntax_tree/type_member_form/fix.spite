var rule = Validators.AbstractSyntaxTree.TypeMemberForm.Validator()
var path = ""
var class_name = ""
var line = 0
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): List<Diagnostics.Problem> {
    path = file.path
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    file.declarations.each(fix_a_declaration)
    return found_problems
}

func fix_a_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        fix_the_members(declaration)
    }
}

func fix_the_members(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var index = 0
    while index < declaration.members.count() {
        var member = declaration.members[index]
        line = declaration.line + index + 1
        var answer = rule.check(member)
        if answer.is_fixable() {
            fix_a_member(member)
        }
        index = index + 1
    }
}

func fix_a_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    var written = call_form_text(member)
    var function_type = function_type_of(member)
    var printing = Printers.Spite.TypePrinter(function_type)
    var rewritten = printing.text()
    var problem = Diagnostics.Problem(
        path,
        line,
        "a member of a type has one form: '{written}' is now written '{member.name}: {rewritten}'",
    )
    problem.class_name = class_name
    problem.is_fix = true
    found_problems.append(problem)
    member.parameters = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
    member.result = function_type
    member.is_an_attribute = true
}

func call_form_text(member: AbstractSyntaxTree.Shapes.Types.TypeMember): String {
    var written = List<String>()
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        crash parameter.declared_type
        var printing = Printers.Spite.TypePrinter(parameter.declared_type)
        var shown = printing.text()
        written.append(shown)
        index = index + 1
    }
    var joined = written.join(", ")
    if member.result {
        var answer_printing = Printers.Spite.TypePrinter(member.result)
        var answer = answer_printing.text()
        return "{member.name}({joined}): {answer}"
    }
    return "{member.name}({joined})"
}

func function_type_of(member: AbstractSyntaxTree.Shapes.Types.TypeMember): AbstractSyntaxTree.Shapes.Types.NamedType {
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        crash parameter.declared_type
        var taken = argument_of(parameter.declared_type)
        arguments.append(taken)
        index = index + 1
    }
    var answer = answer_of(member)
    var answered = argument_of(answer)
    arguments.append(answered)
    var path = ["Spite", "Function"]
    return AbstractSyntaxTree.Shapes.Types.NamedType(path, arguments)
}

func answer_of(member: AbstractSyntaxTree.Shapes.Types.TypeMember): SpiteCompiler.Type {
    if member.result {
        return member.result
    }
    var path = ["Nothing"]
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return AbstractSyntaxTree.Shapes.Types.NamedType(path, no_arguments)
}

func argument_of(written: SpiteCompiler.Type): AbstractSyntaxTree.Shapes.Types.GenericArgument {
    var argument = AbstractSyntaxTree.Shapes.Types.GenericArgument(false, "")
    argument.of_type(written)
    return argument
}

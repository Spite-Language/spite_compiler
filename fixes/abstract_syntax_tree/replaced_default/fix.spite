var rule = Validators.AbstractSyntaxTree.ReplacedDefault.Validator()

# ../../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func fixed(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Diagnostics.Problem> {
    var found = List<Diagnostics.Problem>()
    var paths = AbstractSyntaxTree.Walk.ConstructorPaths(file)
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            fix_when_fixable(declaration, file, paths, found, class_name)
        }
        index = index + 1
    }
    return found
}

func fix_when_fixable(
    attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    file: AbstractSyntaxTree.Shapes.SourceFile,
    paths: AbstractSyntaxTree.Walk.ConstructorPaths,
    found: List<Diagnostics.Problem>,
    class_name: String,
) {
    var answer = rule.check(attribute, file, paths)
    fallback answer.is_fixable()
    var written_type = rule.type_of(attribute)
    crash written_type
    attribute.declared_type = written_type
    attribute.value = null
    var shown = Printers.Spite.TypePrinter(written_type)
    var written = shown.text()
    var text = "the default of '{attribute.name}' was made and then replaced by the constructor on every path; removed it, 'var {attribute.name}: {written}'"
    var problem = Diagnostics.Problem(file.path, attribute.line, text)
    problem.class_name = class_name
    problem.is_fix = true
    found.append(problem)
}

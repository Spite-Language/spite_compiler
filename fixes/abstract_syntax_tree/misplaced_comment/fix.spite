# ../../../../spite_documentation/style.md#comments-are-links
func fixed(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Diagnostics.Problem> {
    var found = List<Diagnostics.Problem>()
    var index = 0
    while index < file.misplaced_comments.count() {
        var comment = file.misplaced_comments[index]
        var place = file.misplaced_places[index]
        crash place
        var problem = Diagnostics.Problem(
            file.path,
            comment.line,
            "a comment {place} belongs to its class; moved it to the top of the file",
        )
        problem.class_name = class_name
        problem.is_fix = true
        found.append(problem)
        index = index + 1
    }
    return found
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var found_problems = List<Diagnostics.Problem>()
var rule = Validators.AbstractSyntaxTree.DefaultGuard.Validator()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    rule.read_the_else_ifs(walk, class_name)
    walk.statements.each(fix_found)
    walk.statements.each(hoist_found)
    return found_problems
}

func fix_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        fix_if(found, statement)
    }
}

func fix_if(found: AbstractSyntaxTree.Walk.Found.Statement, guard: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var answer = rule.check_a_guard(found, guard)
    fallback answer.is_fixable()
    crash guard.then_branch
    var only = guard.then_branch.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        fix_return(found, guard, only)
    }
}

func fix_return(
    found: AbstractSyntaxTree.Walk.Found.Statement,
    guard: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    crash guard.condition
    var opposite = AbstractSyntaxTree.DefaultGuard.Opposite()
    var turned = opposite.of(guard.condition)
    var printer = Printers.Spite.ExpressionPrinter(turned)
    var asserted = printer.text()
    if returned.value {
        var value_printer = Printers.Spite.ExpressionPrinter(returned.value)
        var written = value_printer.text()
        replace(
            found,
            guard,
            turned,
            "this 'if' only returned '{written}', which is what 'fallback' returns when its condition fails; wrote 'fallback {asserted}' in its place",
        )
        return
    }
    replace(found, guard, turned, "this 'if' only returned; wrote 'fallback {asserted}' in its place")
}

func replace(
    found: AbstractSyntaxTree.Walk.Found.Statement,
    guard: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    turned: SpiteCompiler.Expression,
    text: String,
) {
    crash found.holder
    var replacement = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(turned)
    replacement.line = guard.line
    var index = 0
    while index < found.holder.statements.count() {
        var statement = found.holder.statements[index]
        if statement.line == guard.line {
            found.holder.statements[index] = replacement
        }
        index = index + 1
    }
    var problem = Diagnostics.Problem(walk.file.path, guard.line, text)
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_fix = true
    found_problems.append(problem)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func hoist_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var answer = rule.check_a_hoist(found)
    fallback answer.is_fixable()
    var statement = found.statement
    crash statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    crash statement.else_branch
    var inner = statement.else_branch.statements[0]
    if inner.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        hoist_the_guard(found, statement, inner)
    }
}

func hoist_the_guard(
    found: AbstractSyntaxTree.Walk.Found.Statement,
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    guard: AbstractSyntaxTree.Shapes.Statements.IfStatement,
) {
    crash guard.condition
    var opposite = AbstractSyntaxTree.DefaultGuard.Opposite()
    var turned = opposite.of(guard.condition)
    var printer = Printers.Spite.ExpressionPrinter(turned)
    var asserted = printer.text()
    var hoisted = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(turned)
    hoisted.line = statement.line
    crash found.holder
    crash statement.condition
    crash statement.then_branch
    var alone = AbstractSyntaxTree.Shapes.Statements.IfStatement(statement.condition, statement.then_branch, null)
    alone.line = statement.line
    insert_above(found.holder.statements, statement.line, hoisted, alone)
    var problem = Diagnostics.Problem(
        walk.file.path,
        guard.line,
        "this 'else if' only returned, and no value passes both it and the 'if' above it; wrote 'fallback {asserted}' above that 'if'",
    )
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_fix = true
    found_problems.append(problem)
}

func insert_above(
    statements: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
    hoisted: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
    alone: AbstractSyntaxTree.Shapes.Statements.IfStatement,
) {
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if statement.line == line {
            statements[index] = alone
            statements.insert(index, hoisted)
            return
        }
        index = index + 1
    }
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Diagnostics.Problem> {
    var found = Diagnostics.Report()
    var forms = Fixes.AbstractSyntaxTree.TypeMemberForm.Fix()
    var rewritten_forms = forms.fixed(file, class_name)
    found.add_all(rewritten_forms)
    var comments = Fixes.AbstractSyntaxTree.MisplacedComment.Fix()
    var moved_comments = comments.fixed(file, class_name)
    found.add_all(moved_comments)
    var replaced = Fixes.AbstractSyntaxTree.ReplacedDefault.Fix()
    var removed_defaults = replaced.fixed(file, class_name)
    found.add_all(removed_defaults)
    var order = Fixes.AbstractSyntaxTree.DeclarationOrder.Fix()
    var moved = order.fixed(file, class_name)
    found.add_all(moved)
    var walk = AbstractSyntaxTree.Walk.Walk(file)
    var endings = Fixes.AbstractSyntaxTree.AfterReturn.Fix()
    var cut = endings.fixed(walk, class_name)
    found.add_all(cut)
    if not cut.is_empty() {
        walk = AbstractSyntaxTree.Walk.Walk(file)
    }
    var names = Fixes.AbstractSyntaxTree.LocalNames.Fix()
    var renamed = names.fixed(walk, class_name)
    found.add_all(renamed)
    var guards = Fixes.AbstractSyntaxTree.DefaultGuard.Fix()
    var guarded = guards.fixed(walk, class_name)
    found.add_all(guarded)
    return found.problems
}

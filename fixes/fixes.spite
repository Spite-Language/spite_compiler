singleton

var console = Console()
var environment = Environment()
var program = Program()
var most_restarts = 8
var restarts_name = "SPITE_FIX_RESTARTS"
var later_trees = Dictionary<String, AbstractSyntaxTree.Shapes.SourceFile>()
var later_problems = List<Diagnostics.Problem>()
var later_changes = List<Fixes.LaterChange>()
var later_renamings = List<Fixes.Renaming>()
var later_moves = List<Fixes.Move>()
var resting_changes = List<Integer>()
var resting_problems = List<Integer>()

# ../../spite_documentation/style.md#what-the-formatter-rewrites
func rewritten(
    path: String,
    written: String,
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    problems: List<Diagnostics.Problem>,
): String {
    if not holds_every_comment(tree) {
        return written
    }
    var printer = Printers.Spite.Printer(tree)
    var text = printer.text()
    if text == written {
        return written
    }
    write(path, tree, text)
    if problems.is_empty() {
        console.error("formatted {path}")
    } else {
        tell(problems)
    }
    return text
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func found_later(tree: AbstractSyntaxTree.Shapes.SourceFile, problem: Diagnostics.Problem) {
    later_trees[tree.path] = tree
    later_problems.append(problem)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func removed_later(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    block: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
    problem: Diagnostics.Problem,
) {
    var nothing = List<SpiteCompiler.WrittenStatement>()
    replaced_later(tree, block, line, nothing, problem)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func replaced_later(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    block: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
    replacing: List<SpiteCompiler.WrittenStatement>,
    problem: Diagnostics.Problem,
) {
    var change = Fixes.LaterChange(block, line, replacing, false)
    later_changes.append(change)
    found_later(tree, problem)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func cut_later(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    block: List<SpiteCompiler.WrittenStatement>,
    line: Integer,
    replacing: List<SpiteCompiler.WrittenStatement>,
    problem: Diagnostics.Problem,
) {
    var change = Fixes.LaterChange(block, line, replacing, true)
    later_changes.append(change)
    found_later(tree, problem)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func removed_with_the_last_fix(block: List<SpiteCompiler.WrittenStatement>, line: Integer) {
    var nothing = List<SpiteCompiler.WrittenStatement>()
    var change = Fixes.LaterChange(block, line, nothing, false)
    later_changes.append(change)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func renamed_with_the_last_fix(renaming: Fixes.Renaming) {
    later_renamings.append(renaming)
}

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func moved_later(move: Fixes.Move, problem: Diagnostics.Problem) {
    later_moves.append(move)
    later_problems.append(problem)
}

func has_fixed(path: String, line: Integer): Boolean {
    var index = 0
    while index < later_problems.count() {
        var problem = later_problems[index]
        if problem.file_path == path and problem.line == line {
            return true
        }
        index = index + 1
    }
    return false
}

# ../ARCHITECTURE.md#a-fix-rests-on-no-narrowing-a-proof-took-back
func rests_on_a_narrowing(changes_before: Integer, problems_before: Integer) {
    var change_index = changes_before
    while change_index < later_changes.count() {
        resting_changes.append(change_index)
        change_index = change_index + 1
    }
    var problem_index = problems_before
    while problem_index < later_problems.count() {
        resting_problems.append(problem_index)
        problem_index = problem_index + 1
    }
}

# ../ARCHITECTURE.md#a-fix-rests-on-no-narrowing-a-proof-took-back
func a_narrowing_was_taken_back() {
    while not resting_changes.is_empty() {
        var change_index = resting_changes.remove_last()
        crash change_index
        later_changes.remove_at(change_index)
    }
    while not resting_problems.is_empty() {
        var problem_index = resting_problems.remove_last()
        crash problem_index
        later_problems.remove_at(problem_index)
    }
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func run() {
    fallback not later_problems.is_empty()
    var problems = later_problems
    later_problems = List<Diagnostics.Problem>()
    remove_the_statements()
    var trees = later_trees.values()
    var texts = List<String>()
    var index = 0
    while index < trees.count() {
        var tree = trees[index]
        var printer = Printers.Spite.Printer(tree)
        var text = printer.text()
        check_it_reads_back(tree.path, tree, text)
        texts.append(text)
        index = index + 1
    }
    index = 0
    while index < trees.count() {
        var tree = trees[index]
        var text = texts[index]
        crash text
        save(tree.path, text)
        index = index + 1
    }
    move_the_paths()
    tell(problems)
    restart(problems)
}

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func move_the_paths() {
    var index = later_moves.count() - 1
    while index >= 0 {
        var move = later_moves[index]
        crash move
        move.run()
        index = index - 1
    }
    later_moves = List<Fixes.Move>()
}

func remove_the_statements() {
    var index = later_changes.count() - 1
    while index >= 0 {
        var change = later_changes[index]
        crash change
        change.run()
        index = index - 1
    }
    later_renamings.each(rename)
}

func rename(renaming: Fixes.Renaming) {
    renaming.run()
}

# ../../spite_documentation/style.md#comments-are-links
func holds_every_comment(tree: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    var held = tree.heading.count() + tree.misplaced_comments.count()
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            held = held + declaration.comments.count()
        }
        index = index + 1
    }
    return held == tree.comments.count()
}

# ../../spite_documentation/style.md#what-the-formatter-rewrites
func write(path: String, tree: AbstractSyntaxTree.Shapes.SourceFile, text: String) {
    check_it_reads_back(path, tree, text)
    save(path, text)
}

func check_it_reads_back(path: String, tree: AbstractSyntaxTree.Shapes.SourceFile, text: String) {
    var reading = AbstractSyntaxTree.AbstractSyntaxTree(path, tree.namespace, text)
    var reread = reading.run()
    var printing_again = Printers.Spite.Printer(reread)
    var again = printing_again.text()
    var written_comments = tree.comments.count()
    var printed_comments = reread.comments.count()
    var safety = Validators.AbstractSyntaxTree.Formatting.Validator()
    var safety_answer = safety.check(path, text, again, written_comments, printed_comments)
    safety_answer.tell()
    safety.check_the_texts(path, tree, reread)
}

func save(path: String, text: String) {
    var file_path: Path? = path
    crash file_path
    var file = File(file_path)
    var saved = file.write_string(text)
    var writable = Validators.CommandLine.WritableFile.Validator()
    var writing = CommandLine.Attempt(path, saved)
    var writable_answer = writable.check(writing)
    writable_answer.tell()
}

func tell(problems: List<Diagnostics.Problem>) {
    var report = Diagnostics.Report()
    report.add_all(problems)
    var shown = Printers.Diagnostics.Printer(report)
    var notes = shown.text()
    console.error(notes)
}

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func restart(problems: List<Diagnostics.Problem>) {
    var restarts = restarts_so_far() + 1
    var keeps_coming_back = restarts > most_restarts
    if keeps_coming_back {
        var first = problems.first()
        crash first
        console.error("a fix came back after {most_restarts} restarts of the compile: {first.text}")
    }
    crash not keeps_coming_back
    var path = program.executable_path()
    crash path
    var windows_path = path.replace("/", "\\")
    var given = environment.given_flags()
    var compiling = Process(windows_path, given)
    compiling.environment_variables[restarts_name] = restarts.to_string()
    var rounds = Diagnostics.Rounds()
    rounds.forget()
    compiling.environment_variables[rounds.round_name] = rounds.first_round.to_string()
    var answered = compiling.run_attached()
    var runnable = Validators.CommandLine.RunnableProgram.Validator()
    var runnable_answer = runnable.check(windows_path, answered)
    runnable_answer.tell()
    crash answered
    program.exit(answered)
}

func restarts_so_far(): Integer {
    var written = program.environment(restarts_name)
    fallback written
    var counted: Integer? = written
    crash counted
    return counted
}

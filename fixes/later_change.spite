var block = List<SpiteCompiler.WrittenStatement>()
var line = 0
var replacing = List<SpiteCompiler.WrittenStatement>()
var cuts_the_rest = false

# ../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func LaterChange(
    starting_block: List<SpiteCompiler.WrittenStatement>,
    starting_line: Integer,
    starting_replacing: List<SpiteCompiler.WrittenStatement>,
    starting_cuts_the_rest: Boolean,
) {
    block = starting_block
    line = starting_line
    replacing = starting_replacing
    cuts_the_rest = starting_cuts_the_rest
}

func run() {
    var index = 0
    while index < block.count() {
        var statement = block[index]
        if statement.line == line {
            replace_at(index)
            return
        }
        index = index + 1
    }
}

func replace_at(index: Integer) {
    if cuts_the_rest {
        block.truncate(index)
    } else {
        block.remove_at(index)
    }
    var placed = 0
    while placed < replacing.count() {
        var replacement = replacing[placed]
        block.insert(index + placed, replacement)
        placed = placed + 1
    }
}

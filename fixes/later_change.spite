var problem: Diagnostics.Problem? = null
var was_made = false
var block: List<SpiteCompiler.WrittenStatement>
var line: Integer
var written: List<SpiteCompiler.WrittenStatement>
var moved: List<SpiteCompiler.WrittenStatement>
var cuts_the_rest: Boolean

# ../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func LaterChange(
    starting_block: List<SpiteCompiler.WrittenStatement>,
    starting_line: Integer,
    starting_written: List<SpiteCompiler.WrittenStatement>,
    starting_moved: List<SpiteCompiler.WrittenStatement>,
    starting_cuts_the_rest: Boolean,
) {
    block = starting_block
    line = starting_line
    written = starting_written
    moved = starting_moved
    cuts_the_rest = starting_cuts_the_rest
}

func run() {
    var index = 0
    while index < block.count() {
        var statement = block[index]
        if statement.line == line {
            replace_at(index)
            was_made = true
            return
        }
        index = index + 1
    }
}

func replace_at(index: Integer) {
    if cuts_the_rest {
        block.truncate(index)
    } else {
        block.remove_at(index)
    }
    var placing = written.copy()
    var moving = 0
    while moving < moved.count() {
        var statement = moved[moving]
        placing.append(statement)
        moving = moving + 1
    }
    moved.clear()
    var placed = 0
    while placed < placing.count() {
        var replacement = placing[placed]
        block.insert(index + placed, replacement)
        placed = placed + 1
    }
}

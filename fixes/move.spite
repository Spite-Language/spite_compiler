var from: String
var to: String
var is_folder: Boolean

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func Move(starting_from: String, starting_to: String, starting_is_folder: Boolean) {
    from = starting_from
    to = starting_to
    is_folder = starting_is_folder
}

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func run() {
    var lowered_from = from.lower_case()
    var lowered_to = to.lower_case()
    if lowered_from == lowered_to {
        var passing = "{to}.renaming"
        moved(from, passing)
        moved(passing, to)
        return
    }
    moved(from, to)
}

func moved(old_path: String, new_path: String) {
    var old_place: Path? = old_path
    crash old_place
    var new_place: Path? = new_path
    crash new_place
    var renamed = false
    if is_folder {
        var directory = Directory(old_place)
        renamed = directory.move_to(new_place)
    } else {
        var file = File(old_place)
        renamed = file.move_to(new_place)
    }
    var moving = CommandLine.Attempt(old_path, renamed)
    moving.moved_to = new_path
    var movable = Validators.CommandLine.MovablePath.Validator()
    movable.check(moving)
}

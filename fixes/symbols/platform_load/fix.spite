var writer = Fixes.Fixes()
var library = Mapping.LibraryFile()
var reader = Mapping.LoadReader()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

# ../../../../spite_documentation/programs.md#how-a-program-is-loaded
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    fallback not table.map.loads_a_platform()
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk.Walk) {
    fallback table.may_fix_later(walk.file.path)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if found.statement and found.statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            fix_a_load(walk, found.statement, found.function_name)
        }
        index = index + 1
    }
}

func fix_a_load(
    walk: AbstractSyntaxTree.Walk.Walk,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
    function_name: String,
) {
    var written = reader.text_of(loaded)
    fallback written and not written.contains("@")
    var from_folder = table.folder_of(walk.file.path)
    fallback table.map.is_the_library_common("{from_folder}/{written}")
    var platform = library.platform_beside(written)
    var platform_path: Path? = "{from_folder}/{platform}"
    crash platform_path
    var directory = Directory(platform_path)
    fallback directory.exists()
    var expression = loaded.folder
    crash expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    var piece = expression.pieces[0]
    crash piece
    piece.text = platform
    var problem = Diagnostics.Problem(
        walk.file.path,
        loaded.line,
        "'load \"{written}\"' loaded the library's 'common' folder alone; changed it to 'load \"{platform}\"', the system's folder, which loads 'common' itself",
    )
    problem.class_name = walk.file.class_name()
    problem.function_name = function_name
    problem.is_fix = true
    writer.found_later(walk.file, problem)
}

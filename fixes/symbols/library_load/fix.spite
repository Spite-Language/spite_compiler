var writer = Fixes()
var reader = Mapping.LoadReader()
var rule = Validators.Mapping.LibraryLoad.Validator()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

# ../../../../spite_documentation/programs.md#the-standard-library-needs-no-load
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk) {
    var index = 0
    while index < walk.blocks.count() {
        var found = walk.blocks[index]
        fix_a_block(walk, found)
        index = index + 1
    }
}

func fix_a_block(walk: AbstractSyntaxTree.Walk, found: AbstractSyntaxTree.Walk.Found.Block) {
    crash found.block
    var index = found.block.statements.count() - 1
    while index >= 0 {
        var statement = found.block.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            fix_a_load(walk, found.block, index, statement, found.function_name)
        }
        index = index - 1
    }
}

func fix_a_load(
    walk: AbstractSyntaxTree.Walk,
    block: AbstractSyntaxTree.Shapes.Statements.Block,
    index: Integer,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
    function_name: String,
) {
    var answer = rule.check_a_load(table, walk, loaded)
    fallback answer.is_fixable()
    var written = reader.text_of(loaded)
    crash written
    var text = "'load \"{written}\"' loaded the standard library, which every program has without a load; removed it"
    block.statements.remove_at(index)
    var emptied = rule.check_the_constructor_left(walk)
    if emptied.is_fixable() {
        remove_the_empty_constructor(walk)
        text = "{text}, and the constructor it was alone in, since a class without one is made from its defaults"
    }
    var problem = Diagnostics.Problem(walk.file.path, loaded.line, text)
    problem.class_name = walk.file.class_name()
    problem.function_name = function_name
    problem.is_fix = true
    writer.found_later(walk.file, problem)
}

func remove_the_empty_constructor(walk: AbstractSyntaxTree.Walk) {
    var class_name = walk.file.class_name()
    var index = walk.file.declarations.count() - 1
    while index >= 0 {
        var declaration = walk.file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and rule.is_empty_constructor(declaration, class_name) {
            walk.file.declarations.remove_at(index)
        }
        index = index - 1
    }
}

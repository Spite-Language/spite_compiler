var writer = Fixes.Fixes()
var reader = Mapping.LoadReader()
var rule = Validators.Mapping.LibraryLoad.Validator()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

# ../../../../spite_documentation/programs.md#the-standard-library-needs-no-load
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk.Walk) {
    var index = 0
    while index < walk.blocks.count() {
        var found = walk.blocks[index]
        fix_a_block(walk, found)
        index = index + 1
    }
}

func fix_a_block(walk: AbstractSyntaxTree.Walk.Walk, found: AbstractSyntaxTree.Walk.Found.Block) {
    crash found.block
    var index = found.block.statements.count() - 1
    while index >= 0 {
        var statement = found.block.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            fix_a_load(walk, found.block, index, statement, found.function_name)
        }
        index = index - 1
    }
}

func fix_a_load(
    walk: AbstractSyntaxTree.Walk.Walk,
    block: AbstractSyntaxTree.Shapes.Statements.Block,
    index: Integer,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
    function_name: String,
) {
    var answer = rule.check_a_load(table, walk, loaded)
    fallback answer.is_fixable()
    var written = reader.text_of(loaded)
    crash written
    var problem = Diagnostics.Problem(
        walk.file.path,
        loaded.line,
        "'load \"{written}\"' loaded the standard library, which every program has without a load; removed it",
    )
    problem.class_name = walk.file.class_name()
    problem.function_name = function_name
    problem.is_fix = true
    block.statements.remove_at(index)
    writer.found_later(walk.file, problem)
}

var writer = Fixes()

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(table: Symbols.SymbolTable) {
    fix_the_doubled_paths(table)
    var paths = MisnamedPath.Fix()
    paths.fixed(table)
    var library = LibraryLoad.Fix()
    library.fixed(table)
    var loads = UnneededLoad.Fix()
    loads.fixed(table)
    var finding = Symbols.RepeatedDeclarations(table)
    table.repeated_declarations = finding.run()
    var moving = RepeatedDeclaration.Fix(table)
    var problems = moving.fixed(table.repeated_declarations)
    var index = 0
    while index < problems.count() {
        var problem = problems[index]
        var tree = moving.changed_trees[index]
        crash tree
        writer.found_later(tree, problem)
        index = index + 1
    }
    writer.run()
}

# ../../../spite_documentation/classes_and_files.md#a-folder-is-a-class
func fix_the_doubled_paths(table: Symbols.SymbolTable) {
    var problems = List<Diagnostics.Problem>()
    var index = 0
    while index < table.paths_read.count() {
        var path = table.paths_read[index]
        if table.may_fix_later(path) {
            var found = doubled_paths_of(table, path)
            found.each(problems.append)
        }
        index = index + 1
    }
    fallback not problems.is_empty()
    writer.tell(problems)
    writer.restart(problems)
}

# ../../../spite_documentation/classes_and_files.md#a-folder-is-a-class
func doubled_paths_of(table: Symbols.SymbolTable, path: String): List<Diagnostics.Problem> {
    var tree = table.files[path]
    var class_file = table.class_files[path]
    fallback tree and class_file
    var text = table.text_of_the_class(path)
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer(text, first_line)
    var tokens = lexer.tokens_of()
    var doubled = Fixes.AbstractSyntaxTree.DoubledPath.Fix(table, tree, class_file.simple_name)
    var shortened = doubled.shortened(tokens, text)
    fallback not doubled.found_problems.is_empty()
    writer.save(path, shortened)
    return doubled.found_problems
}

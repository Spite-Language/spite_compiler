var writer = Fixes.Fixes()

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(table: Symbols.SymbolTable) {
    var platform = Fixes.Symbols.PlatformLoad.Fix()
    platform.fixed(table)
    var loads = Fixes.Symbols.UnneededLoad.Fix()
    loads.fixed(table)
    var finding = Symbols.RepeatedDeclarations(table)
    table.repeated_declarations = finding.run()
    var moving = Fixes.Symbols.RepeatedDeclaration.Fix(table)
    var problems = moving.fixed(table.repeated_declarations)
    var index = 0
    while index < problems.count() {
        var problem = problems[index]
        var tree = moving.changed_trees[index]
        crash tree
        writer.found_later(tree, problem)
        index = index + 1
    }
    writer.run()
}

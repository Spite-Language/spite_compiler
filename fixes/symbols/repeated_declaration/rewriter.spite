var written_names = Dictionary<String, String>()
var collected = List<String>()
var collects = false

# ../../../../spite_spec/specs/classes_and_files.md#a-repeated-union-or-type-moves-to-the-entry-class
func rewrite(tree: AbstractSyntaxTree.Shapes.SourceFile, names: Dictionary<String, String>) {
    written_names = names
    tree.declarations.each(rewrite_declaration)
    var walk = AbstractSyntaxTree.Walk.Walk(tree)
    walk.statements.each(rewrite_statement)
    walk.expressions.each(rewrite_expression)
}

func rewrite_for_the_entry(declaration: SpiteCompiler.Declaration, names: Dictionary<String, String>) {
    written_names = names
    rewrite_declaration(declaration)
}

func names_written_in(declaration: SpiteCompiler.Declaration): List<String> {
    collected = List<String>()
    collects = true
    rewrite_declaration(declaration)
    collects = false
    return collected
}

func rewrite_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: rewrite_type(declaration.bound)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: rewrite_union(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: declaration.members.each(rewrite_member)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: rewrite_type(declaration.declared_type)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: rewrite_function(declaration)
    }
}

func rewrite_union(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        if collects {
            collected.append(member)
        }
        var written = written_names[member]
        if written {
            declaration.member_names[index] = written
        }
        index = index + 1
    }
}

func rewrite_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    member.parameters.each(rewrite_parameter)
    rewrite_type(member.result)
}

func rewrite_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    function.parameters.each(rewrite_parameter)
    rewrite_type(function.result)
}

func rewrite_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    rewrite_type(parameter.declared_type)
}

func rewrite_type(written: SpiteCompiler.Type?) {
    fallback written
    switch written {
        AbstractSyntaxTree.Shapes.Types.NamedType: rewrite_named(written)
    }
}

func rewrite_named(named: AbstractSyntaxTree.Shapes.Types.NamedType) {
    named.arguments.each(rewrite_argument)
    var dotted = named.path.join(".")
    if collects {
        collected.append(dotted)
    }
    var written = written_names[dotted]
    fallback written
    named.path = written.split(".")
}

func rewrite_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    fallback argument.is_type
    rewrite_type(argument.type_reference)
}

func rewrite_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.statement
    fallback found.statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    rewrite_type(found.statement.declared_type)
}

func rewrite_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback found.expression
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        found.expression.generic_arguments.each(rewrite_argument)
    }
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        found.expression.generic_arguments.each(rewrite_argument)
        rewrite_a_written_class(found, found.expression)
    }
}

func rewrite_a_written_class(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    fallback identifier.is_a_class_name and not found.is_called
    var written = written_names[identifier.name]
    fallback written
    identifier.name = written
}

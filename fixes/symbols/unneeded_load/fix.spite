var writer = Fixes.Fixes()
var library = Mapping.LibraryFile()
var read_without_a_name = ["Program", "Environment", "Build"]
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk.Walk) {
    fallback table.judges_the_loads and walk.file.path == table.entry_path and table.may_fix_later(walk.file.path)
    var index = 0
    while index < walk.function_declarations.count() {
        var function = walk.function_declarations[index]
        if function.body {
            fix_a_body(walk, function.body)
        }
        index = index + 1
    }
}

func fix_a_body(walk: AbstractSyntaxTree.Walk.Walk, body: AbstractSyntaxTree.Shapes.Statements.Block) {
    var index = body.statements.count() - 1
    while index >= 0 {
        var statement = body.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement and is_unneeded(walk, statement) {
            remove(walk, body, index, statement)
        }
        index = index - 1
    }
}

func is_unneeded(
    walk: AbstractSyntaxTree.Walk.Walk,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
): Boolean {
    var text = written_folder(loaded)
    fallback not text.is_empty()
    var from_folder = table.folder_of(walk.file.path)
    var root = table.map.root_at("{from_folder}/{text}")
    fallback root
    var brought_in = brought_in_by(root)
    var every = table.map.every_class()
    var index = 0
    while index < brought_in.count() {
        var folder = brought_in[index]
        fallback not stays_whatever_is_named(folder)
        fallback no_class_in_it_is_needed(every, folder, brought_in)
        index = index + 1
    }
    return true
}

func brought_in_by(root: Mapping.MappedFolder): List<Mapping.MappedFolder> {
    var brought_in = [root]
    var index = 0
    while index < brought_in.count() {
        var folder = brought_in[index]
        add_what_it_loads(folder, brought_in)
        index = index + 1
    }
    return brought_in
}

func add_what_it_loads(folder: Mapping.MappedFolder, brought_in: List<Mapping.MappedFolder>) {
    var index = 0
    while index < table.load_folders.count() {
        var loaded = table.load_folders[index]
        var origin = table.load_origins[index]
        crash origin
        var loaded_root = table.map.root_at(loaded)
        if loaded_root and table.map.inside(origin, folder.path) {
            add_once(loaded_root, brought_in)
        }
        index = index + 1
    }
}

func add_once(folder: Mapping.MappedFolder, brought_in: List<Mapping.MappedFolder>) {
    var known = brought_in.find_by_path(folder.path)
    if not known {
        brought_in.append(folder)
    }
}

func stays_whatever_is_named(folder: Mapping.MappedFolder): Boolean {
    return library.holds("{folder.path}/") or folder.path.contains(".spite/git/")
}

func no_class_in_it_is_needed(
    every: List<Mapping.ClassFile>,
    folder: Mapping.MappedFolder,
    brought_in: List<Mapping.MappedFolder>,
): Boolean {
    var is_in_the_program = is_inside_the_program(folder)
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        if table.map.inside(class_file.path, folder.path) {
            fallback may_go(class_file, brought_in)
            fallback not is_in_the_program or holds_no_attribute(class_file)
        }
        index = index + 1
    }
    return true
}

func is_inside_the_program(folder: Mapping.MappedFolder): Boolean {
    var program_root = table.map.roots.first()
    crash program_root
    return table.map.inside(folder.path, program_root.path)
}

func holds_no_attribute(class_file: Mapping.ClassFile): Boolean {
    var tree = table.files[class_file.path]
    fallback tree
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        fallback declaration.class != AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
        index = index + 1
    }
    return true
}

func may_go(class_file: Mapping.ClassFile, brought_in: List<Mapping.MappedFolder>): Boolean {
    fallback not read_without_a_name.contains(class_file.simple_name)
    var namespaces = table.mentioned_from[class_file.path]
    if not namespaces {
        return true
    }
    var index = 0
    while index < namespaces.count() {
        var namespace = namespaces[index]
        fallback is_from_inside(namespace, brought_in)
        index = index + 1
    }
    return true
}

func is_from_inside(namespace: String, brought_in: List<Mapping.MappedFolder>): Boolean {
    var index = 0
    while index < brought_in.count() {
        var folder = brought_in[index]
        if namespace == folder.namespace or namespace.starts_with("{folder.namespace}.") {
            return true
        }
        index = index + 1
    }
    return false
}

func written_folder(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement): String {
    var reader = Mapping.LoadReader()
    var written = reader.text_of(loaded)
    fallback written
    return written
}

func remove(
    walk: AbstractSyntaxTree.Walk.Walk,
    body: AbstractSyntaxTree.Shapes.Statements.Block,
    index: Integer,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
) {
    var text = written_folder(loaded)
    var problem = Diagnostics.Problem(
        walk.file.path,
        loaded.line,
        "'load \"{text}\"' loaded a folder nothing in the program uses; removed it",
    )
    problem.class_name = walk.file.class_name()
    problem.function_name = function_name_of(walk, loaded.line)
    problem.is_fix = true
    body.statements.remove_at(index)
    writer.found_later(walk.file, problem)
}

func function_name_of(walk: AbstractSyntaxTree.Walk.Walk, line: Integer): String {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        crash found.statement
        if found.statement.line == line {
            return found.function_name
        }
        index = index + 1
    }
    return ""
}

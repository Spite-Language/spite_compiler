var writer = Fixes.Fixes()
var rule = Validators.Mapping.UnneededLoad.Validator()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk.Walk) {
    var index = 0
    while index < walk.function_declarations.count() {
        var function = walk.function_declarations[index]
        if function.body {
            fix_a_body(walk, function.body)
        }
        index = index + 1
    }
}

func fix_a_body(walk: AbstractSyntaxTree.Walk.Walk, body: AbstractSyntaxTree.Shapes.Statements.Block) {
    var index = body.statements.count() - 1
    while index >= 0 {
        var statement = body.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            fix_a_load(walk, body, index, statement)
        }
        index = index - 1
    }
}

func fix_a_load(
    walk: AbstractSyntaxTree.Walk.Walk,
    body: AbstractSyntaxTree.Shapes.Statements.Block,
    index: Integer,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
) {
    var answer = rule.check(table, walk, loaded)
    fallback answer.is_fixable()
    var text = rule.written_folder(loaded)
    var problem = Diagnostics.Problem(
        walk.file.path,
        loaded.line,
        "'load \"{text}\"' loaded a folder nothing in the program uses; removed it",
    )
    problem.class_name = walk.file.class_name()
    problem.function_name = function_name_of(walk, loaded.line)
    problem.is_fix = true
    body.statements.remove_at(index)
    writer.found_later(walk.file, problem)
}

func function_name_of(walk: AbstractSyntaxTree.Walk.Walk, line: Integer): String {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        crash found.statement
        if found.statement.line == line {
            return found.function_name
        }
        index = index + 1
    }
    return ""
}

var named: AbstractSyntaxTree.Shapes.Types.NamedType
var line: Integer
var function_name: String

func Site(
    starting_named: AbstractSyntaxTree.Shapes.Types.NamedType,
    starting_line: Integer,
    starting_function_name: String,
) {
    named = starting_named
    line = starting_line
    function_name = starting_function_name
}

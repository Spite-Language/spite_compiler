var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)
var sites = List<Fixes.Symbols.EntryClassMember.Site>()
var line = 0
var function_name = ""

func WrittenTypes(starting_table: Symbols.SymbolTable) {
    table = starting_table
}

# ../../../../spite_documentation/values_and_types.md#enums
func found_in(walk: AbstractSyntaxTree.Walk.Walk): List<Fixes.Symbols.EntryClassMember.Site> {
    sites = List<Fixes.Symbols.EntryClassMember.Site>()
    walk.file.declarations.each(take_a_declaration)
    walk.statements.each(take_a_statement)
    walk.expressions.each(take_an_expression)
    return sites
}

func take_a_declaration(declaration: SpiteCompiler.Declaration) {
    line = table.line_of(declaration)
    function_name = ""
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: take_a_type(declaration.bound)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: declaration.members.each(take_a_member)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: take_a_type(declaration.declared_type)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: take_a_function(declaration)
    }
}

func take_a_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    member.parameters.each(take_a_parameter)
    take_a_type(member.result)
}

func take_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    function_name = function.name
    function.parameters.each(take_a_parameter)
    take_a_type(function.result)
}

func take_a_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    take_a_type(parameter.declared_type)
}

func take_a_type(written: SpiteCompiler.Type?) {
    fallback written
    switch written {
        AbstractSyntaxTree.Shapes.Types.NamedType: take_a_named_type(written)
    }
}

func take_a_named_type(named: AbstractSyntaxTree.Shapes.Types.NamedType) {
    named.arguments.each(take_an_argument)
    fallback named.path.count() > 1
    var site = Fixes.Symbols.EntryClassMember.Site(named, line, function_name)
    sites.append(site)
}

func take_an_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    fallback argument.is_type
    take_a_type(argument.type_reference)
}

func take_a_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.statement
    fallback found.statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    line = found.statement.line
    function_name = found.function_name
    take_a_type(found.statement.declared_type)
}

func take_an_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback found.expression
    line = found.line
    function_name = found.function_name
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        found.expression.generic_arguments.each(take_an_argument)
    }
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        found.expression.generic_arguments.each(take_an_argument)
    }
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        found.expression.generic_arguments.each(take_an_argument)
    }
}

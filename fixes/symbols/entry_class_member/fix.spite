var writer = Fixes.Fixes()
var rule = Validators.NameResolution.ClassMember.Validator()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)
var file = AbstractSyntaxTree.Shapes.SourceFile("", "")

# ../../../../spite_documentation/values_and_types.md#enums
func fixed(starting_table: Symbols.SymbolTable) {
    table = starting_table
    table.walks.each(fix_a_walk)
}

func fix_a_walk(walk: AbstractSyntaxTree.Walk.Walk) {
    file = walk.file
    var finding = Fixes.Symbols.EntryClassMember.WrittenTypes(table)
    var sites = finding.found_in(walk)
    sites.each(fix_a_site)
}

func fix_a_site(site: Fixes.Symbols.EntryClassMember.Site) {
    var written = site.named.path.join(".")
    var class_name = file.class_name()
    var place = NameResolution.Place(file.path, site.line, class_name, site.function_name, table.walks)
    var answer = rule.check_an_entry_class_member(table, site.named.path, file.namespace, file.path, place)
    fallback answer.is_fixable()
    site.named.path = answer.fix.split(".")
    var text = rule.written_through_its_class(written, answer.fix)
    var problem = Diagnostics.Problem(file.path, site.line, text)
    problem.class_name = class_name
    problem.function_name = site.function_name
    problem.is_fix = true
    writer.found_later(file, problem)
}

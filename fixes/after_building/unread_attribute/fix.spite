var writer = Fixes.Fixes()
var rule = Validators.HighIntermediaryRepresentation.ReadAttribute.Validator()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    table: Symbols.SymbolTable,
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    path: String,
    owner: String,
) {
    var answer = rule.check(table, declaration, path, owner)
    fallback answer.is_fixable()
    var tree = table.files[path]
    crash tree
    var place = rule.place_of(tree, declaration)
    crash place
    tree.remove_declaration_at(place)
    var text = "the attribute '{declaration.name}' was never read, and making it does nothing; removed it"
    if not rule.write_lines.is_empty() {
        text = "the attribute '{declaration.name}' was never read, and nothing written to it does anything; removed it and every write"
    }
    var problem = Diagnostics.Problem(path, declaration.line, text)
    problem.class_name = owner
    problem.is_among_the_attributes = true
    problem.is_fix = true
    writer.found_later(tree, problem)
    var index = 0
    while index < rule.write_lines.count() {
        var block = rule.write_blocks[index]
        var line = rule.write_lines[index]
        crash block
        crash line
        writer.removed_with_the_last_fix(block, line)
        index = index + 1
    }
}

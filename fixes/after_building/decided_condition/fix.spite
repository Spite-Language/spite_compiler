var writer = Fixes.Fixes()
var naming = Validators.HighIntermediaryRepresentation.Typing.Validator()

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    fallback site.keyword == "if" or site.keyword == "while" and not site.holds
    var sites = Fixes.AfterBuilding.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    var path = context.path()
    if writer.has_fixed(path, site.line) {
        return true
    }
    var index = 0
    while index < site.block.count() {
        var statement = site.block[index]
        if statement.line == site.line {
            return fix_the_statement(context, site, tree, statement)
        }
        index = index + 1
    }
    return false
}

func fix_the_statement(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    statement: SpiteCompiler.WrittenStatement,
): Boolean {
    var is_an_if = statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement and site.keyword == "if"
    var is_a_while = statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement and site.keyword == "while"
    fallback is_an_if or is_a_while
    var kept = kept_statements(site, statement)
    fallback not moves_a_name_onto_another(context, statement, kept)
    var did = what_it_did(site, statement)
    var said = known(site)
    var meant = what_it_meant(site)
    var text = "{said}{meant}; {did}"
    var path = context.path()
    var problem = Diagnostics.Problem(path, site.line, text)
    problem.class_name = naming.plain_class_name(context.current_class.shown)
    problem.function_name = naming.shown_function_name(context.current_function)
    problem.is_fix = true
    writer.replaced_later(tree, site.block, site.line, kept, problem)
    return true
}

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func moves_a_name_onto_another(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: SpiteCompiler.WrittenStatement,
    kept: List<SpiteCompiler.WrittenStatement>,
): Boolean {
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    crash context.current_function.declaration
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(context.current_function.declaration)
    var walk = AbstractSyntaxTree.Walk.Walk(holder)
    var last_line = last_line_of(statement)
    var index = 0
    while index < kept.count() {
        var held = kept[index]
        if held.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and is_mentioned_outside(walk, held.name, statement.line, last_line) {
            return true
        }
        index = index + 1
    }
    return false
}

func last_line_of(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Integer {
    crash statement.then_branch
    if not statement.else_branch {
        return statement.then_branch.end_line
    }
    if not statement.else_branch.is_an_else_if {
        return statement.else_branch.end_line
    }
    var inner = statement.else_branch.statements[0]
    crash inner.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    return last_line_of(inner)
}

func is_mentioned_outside(
    walk: AbstractSyntaxTree.Walk.Walk,
    name: String,
    first_line: Integer,
    last_line: Integer,
): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var is_outside = found.line < first_line or found.line > last_line
        crash found.expression
        if is_outside and found.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and found.expression.name == name {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < walk.statements.count() {
        var found_statement = walk.statements[index]
        crash found_statement.statement
        var is_away = found_statement.statement.line < first_line or found_statement.statement.line > last_line
        if is_away and found_statement.statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and found_statement.statement.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func kept_statements(
    site: HighIntermediaryRepresentation.Building.CheckSite,
    statement: SpiteCompiler.WrittenStatement,
): List<SpiteCompiler.WrittenStatement> {
    var kept = List<SpiteCompiler.WrittenStatement>()
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        if site.holds and statement.then_branch {
            return statement.then_branch.statements
        }
        if not site.holds and statement.else_branch {
            return statement.else_branch.statements
        }
    }
    return kept
}

func what_it_did(
    site: HighIntermediaryRepresentation.Building.CheckSite,
    statement: SpiteCompiler.WrittenStatement,
): String {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        if site.holds {
            return "removed the 'if' and kept the code it runs"
        }
        if statement.else_branch {
            return "removed it and kept its 'else'"
        }
    }
    return "removed it"
}

func known(site: HighIntermediaryRepresentation.Building.CheckSite): String {
    var answer = "false"
    if site.holds {
        answer = "true"
    }
    var said = "'{site.keyword} {site.written}' was decided while compiling and was always {answer} here"
    if site.source {
        return "{said}, since {site.source}"
    }
    return said
}

func what_it_meant(site: HighIntermediaryRepresentation.Building.CheckSite): String {
    if site.keyword == "while" {
        return ", so the loop never ran"
    }
    if site.holds {
        return ", so it told a reader nothing"
    }
    return ", so the code it guarded never ran"
}

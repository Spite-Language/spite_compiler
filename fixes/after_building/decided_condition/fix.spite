var writer = Fixes.Fixes()
var naming = Validators.HighIntermediaryRepresentation.EveryRule()
var rule = Validators.HighIntermediaryRepresentation.ProvenCheck.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var answer = rule.check_a_decided_condition(context, site)
    fallback answer.is_fixable()
    var statement = rule.statement_at_the_site(site)
    crash statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.FallbackStatement {
        fix_a_fallback(context, site)
        return
    }
    var said = known(site)
    var meant = what_it_meant(site)
    replace_by_what_it_runs(context, site, statement, site.holds, "{said}{meant}")
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func replace_by_what_it_runs(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
    statement: SpiteCompiler.WrittenStatement,
    holds: Boolean,
    said: String,
) {
    var tree = sites.tree_of(context)
    crash tree
    var did = what_it_did(holds, statement)
    var kept = sites.kept_statements(holds, statement)
    var problem = problem_at(context, site.line, "{said}; {did}")
    writer.replaced_later(tree, site.block, site.line, kept, problem)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func problem_at(
    context: HighIntermediaryRepresentation.Building.Context,
    line: Integer,
    text: String,
): Diagnostics.Problem {
    var path = context.path()
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = naming.plain_class_name(context.current_class.shown)
    problem.function_name = naming.shown_function_name(context.current_function)
    problem.is_fix = true
    return problem
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fix_a_fallback(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var tree = sites.tree_of(context)
    crash tree
    crash context.current_function.declaration
    var answering = List<SpiteCompiler.WrittenStatement>()
    var did = "removed it with the code after it"
    var ends_the_function = rule.is_a_line_of_the_body(context.current_function.declaration, site.line)
    if context.current_function.declaration.result or not ends_the_function {
        var answer = rule.default_answer(context.current_function.declaration)
        crash answer
        answer.line = site.line
        answering.append(answer)
        var printer = Printers.Spite.StatementPrinter(answer)
        var written = printer.text()
        did = "wrote '{written}' in place of it and the code after it"
    }
    var said = known(site)
    var problem = problem_at(context, site.line, "{said}, so the function always answered nothing from here; {did}")
    writer.cut_later(tree, site.block, site.line, answering, problem)
}

func what_it_did(holds: Boolean, statement: SpiteCompiler.WrittenStatement): String {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        if holds {
            return "removed the 'if' and kept the code it runs"
        }
        if statement.else_branch {
            return "removed it and kept its 'else'"
        }
    }
    return "removed it"
}

func known(site: HighIntermediaryRepresentation.Building.CheckSite): String {
    var answer = "false"
    if site.holds {
        answer = "true"
    }
    var said = "'{site.keyword} {site.written}' was decided while compiling and was always {answer} here"
    if site.source {
        return "{said}, since {site.source}"
    }
    return said
}

func what_it_meant(site: HighIntermediaryRepresentation.Building.CheckSite): String {
    if site.keyword == "while" {
        return ", so the loop never ran"
    }
    if site.holds {
        return ", so it told a reader nothing"
    }
    return ", so the code it guarded never ran"
}

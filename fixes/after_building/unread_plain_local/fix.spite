var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var reading = Validators.AbstractSyntaxTree.UnusedNames.Reads()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    walk.function_declarations.each(fix_function)
    return found_problems
}

func fix_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    function_name = function.declared_key()
    reading = Validators.AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, function_name)
    walk.statements.each(fix_found)
}

func fix_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.function_name == function_name
    var statement = found.statement
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    fallback not reading.is_read_while_declared(statement)
    fallback not reading.assigned.contains(statement.name)
    fallback reading.does_nothing(statement.value)
    crash found.holder
    var index = 0
    while index < found.holder.statements.count() {
        var held = found.holder.statements[index]
        if held.line == statement.line and held.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
            found.holder.statements.remove_at(index)
            var problem = Diagnostics.Problem(
                walk.file.path,
                statement.line,
                "'{statement.name}' was never read, and making it does nothing; removed it",
            )
            problem.class_name = class_name
            problem.function_name = function_name
            problem.is_fix = true
            found_problems.append(problem)
            return
        }
        index = index + 1
    }
}

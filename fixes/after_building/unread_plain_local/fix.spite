var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var reading = AbstractSyntaxTree.UnusedNames.Reads()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    found_problems = List<Diagnostics.Problem>()
    walk.function_declarations.each(fix_function)
    return found_problems
}

func fix_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    function_name = function.declared_key()
    reading = AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, function_name)
    walk.statements.each(fix_found)
}

func fix_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.function_name == function_name
    var statement = found.statement
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    fallback not reading.is_read_while_declared(statement)
    fallback reading.does_nothing(statement.value)
    var is_written = reading.assigned.contains(statement.name)
    fallback not is_written or every_write_may_go(statement.name)
    crash found.holder
    var index = 0
    while index < found.holder.statements.count() {
        var held = found.holder.statements[index]
        if held.line == statement.line and held.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
            found.holder.statements.remove_at(index)
            remove_the_writes(statement.name)
            note_it(statement, is_written)
            return
        }
        index = index + 1
    }
}

func note_it(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement, is_written: Boolean) {
    var text = "'{statement.name}' was never read, and making it does nothing; removed it"
    if is_written {
        text = "'{statement.name}' was never read, and nothing written to it does anything; removed it and every write"
    }
    var problem = Diagnostics.Problem(walk.file.path, statement.line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_fix = true
    found_problems.append(problem)
}

func every_write_may_go(name: String): Boolean {
    var declared = 0
    var index = 0
    while index < reading.declared.count() {
        var local = reading.declared[index]
        if local.name == name {
            declared = declared + 1
        }
        index = index + 1
    }
    fallback declared == 1
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_a_write_of(found, name) {
            fallback write_may_go(found)
        }
        index = index + 1
    }
    return true
}

func write_may_go(found: AbstractSyntaxTree.Walk.Found.Statement): Boolean {
    var statement = found.statement
    crash found.holder
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    return reading.does_nothing(statement.value) and found.holder.statements.count() > 1
}

func is_a_write_of(found: AbstractSyntaxTree.Walk.Found.Statement, name: String): Boolean {
    var statement = found.statement
    fallback found.function_name == function_name
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    var target = statement.target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    return target.name == name
}

func remove_the_writes(name: String) {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_a_write_of(found, name) {
            remove_the_statement(found)
        }
        index = index + 1
    }
}

func remove_the_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    crash found.holder
    var index = found.holder.statements.count() - 1
    while index >= 0 {
        var held = found.holder.statements[index]
        crash found.statement
        if held.line == found.statement.line {
            found.holder.statements.remove_at(index)
        }
        index = index - 1
    }
}

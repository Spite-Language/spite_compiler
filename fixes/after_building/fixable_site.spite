# ../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func tree_of(context: HighIntermediaryRepresentation.Building.Context): AbstractSyntaxTree.Shapes.SourceFile? {
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    fallback not is_a_walk and not is_generic and not function.is_a_walk_copy
    var path = context.path()
    var table = context.resolver.symbols
    fallback table.may_fix_later(path)
    return table.files[path]
}

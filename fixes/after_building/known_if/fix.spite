var writer = Fixes.Fixes()

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    var why = what_narrowed_it(site)
    fallback why
    var statement = if_at_the_site(site)
    fallback statement
    crash statement.condition
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    var condition = printer.text()
    var holds = condition == site.written
    fallback holds or condition == "not {site.written}"
    return replaced(context, site, statement, holds, "'{site.written}' was already narrowed by {why}")
}

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    var statement = if_at_the_site(site)
    fallback statement
    crash statement.condition
    crash site.source
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    var condition = printer.text()
    fallback condition == site.whole_test
    var shown = context.shown(site.checked_type)
    var holds = shown == site.source
    var said = what_the_test_knew(site, shown)
    return replaced(context, site, statement, holds, said)
}

func what_the_test_knew(site: HighIntermediaryRepresentation.Building.CheckSite, shown: String): String {
    crash site.source
    if site.check {
        return "'{site.written}' was already a {shown}, narrowed by {site.check}"
    }
    if shown == site.source {
        return "'{site.written}' was a {shown} here, so this test was decided while compiling"
    }
    return "'{site.written}' was a {shown} here, so it was never {site.source} and this test was decided while compiling"
}

func what_narrowed_it(site: HighIntermediaryRepresentation.Building.CheckSite): String? {
    if site.kind == "proven check" {
        return site.check
    }
    if site.kind == "proven value" {
        return "the proof that every value it can hold is present"
    }
    return null
}

func replaced(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    holds: Boolean,
    said: String,
): Boolean {
    var sites = Fixes.AfterBuilding.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    var path = context.path()
    if writer.has_fixed(path, site.line) {
        return true
    }
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var did = deciding.what_it_did(holds, statement)
    return deciding.replaced_by_what_it_runs(context, site, tree, statement, holds, "{said}; {did}")
}

func if_at_the_site(
    site: HighIntermediaryRepresentation.Building.CheckSite,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    var index = 0
    while index < site.block.count() {
        var statement = site.block[index]
        if statement.line == site.line and statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            return statement
        }
        index = index + 1
    }
    return null
}

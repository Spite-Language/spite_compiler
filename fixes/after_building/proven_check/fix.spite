var writer = Fixes.Fixes()
var naming = Validators.HighIntermediaryRepresentation.EveryRule()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    var sites = Fixes.AfterBuilding.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    var function = context.current_function
    var path = context.path()
    if writer.has_fixed(path, site.line) {
        return true
    }
    var text = fixed_text(context, site)
    fallback text
    var statements = written_checks(site)
    var index = 0
    while index < site.block.count() {
        var statement = site.block[index]
        if statement.line == site.line and is_one_of(statement, statements) {
            var problem = Diagnostics.Problem(path, site.line, text)
            problem.class_name = naming.plain_class_name(context.current_class.shown)
            problem.function_name = naming.shown_function_name(function)
            problem.is_fix = true
            writer.removed_later(tree, site.block, site.line, problem)
            return true
        }
        index = index + 1
    }
    return false
}

func is_one_of(statement: SpiteCompiler.WrittenStatement, statements: List<String>): Boolean {
    var printer = Printers.Spite.StatementPrinter(statement)
    var written = printer.text()
    return statements.contains(written)
}

func written_checks(site: HighIntermediaryRepresentation.Building.CheckSite): List<String> {
    var statements = List<String>()
    if site.keyword.is_empty() {
        statements.append("crash {site.written}")
        statements.append("fallback {site.written}")
    } else {
        statements.append("{site.keyword} {site.written}")
    }
    return statements
}

func fixed_text(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): String? {
    var written = site.written
    var keyword = site.keyword
    if site.kind == "proven check" and site.check {
        return "'{written}' was already narrowed by {site.check}; removed this check"
    }
    if site.kind == "proven value" {
        return "'{written}' was already narrowed by the proof that every value it can hold is present; removed this check"
    }
    if site.kind == "proven read" and site.check {
        return "'{written}' was already proven by {site.check}, so this '{keyword}' proved nothing; removed it"
    }
    if site.kind == "repeated check" and site.check {
        return "'{written}' was already checked on line {site.check}, and nothing between could change it; removed this check"
    }
    if site.kind == "proven divisor" and site.check {
        return "'{written}' was already proven by {site.check}; removed this check"
    }
    if site.kind == "always holds" {
        return "'{keyword} {written}' was decided while compiling and always held here; removed it"
    }
    if site.kind == "plain value" {
        var shown = context.shown(site.checked_type)
        var article = naming.article_of(shown)
        return "this value cannot be null here (it is {article} {shown}), so '{keyword}' on it proved nothing; removed the check"
    }
    return null
}

var writer = Fixes.Fixes()
var rule = Validators.HighIntermediaryRepresentation.ProvenCheck.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var answer = rule.check_a_copy(context, site)
    fallback answer.is_fixable()
    var tree = sites.tree_of(context)
    var found = rule.copy_at_the_site(context, site)
    crash tree and found
    crash found.holder
    crash site.source
    crash context.current_function.declaration
    var statement = found.statement
    crash statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var problem = deciding.problem_at(
        context,
        site.line,
        "'{statement.name}' only copied '{site.source}' so it could be narrowed; narrowed '{site.source}' itself and used it directly",
    )
    writer.removed_later(tree, found.holder.statements, site.line, problem)
    var renaming = Fixes.Renaming(context.current_function.declaration, statement.name, site.source)
    writer.renamed_with_the_last_fix(renaming)
}

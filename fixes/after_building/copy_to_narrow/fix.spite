var writer = Fixes.Fixes()
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    var sites = Fixes.AfterBuilding.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    var path = context.path()
    if writer.has_fixed(path, site.line) {
        return true
    }
    crash site.source
    crash context.current_function.declaration
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(context.current_function.declaration)
    walk = AbstractSyntaxTree.Walk.Walk(holder)
    fallback declared_once(site.written)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.line == site.line {
            return fix_the_copy(context, site, tree, context.current_function.declaration, found, statement)
        }
        index = index + 1
    }
    return false
}

func fix_the_copy(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    found: AbstractSyntaxTree.Walk.Found.Statement,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
): Boolean {
    crash found.holder
    crash site.source
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var problem = deciding.problem_at(
        context,
        site.line,
        "'{statement.name}' only copied '{site.source}' so it could be narrowed; narrowed '{site.source}' itself and used it directly",
    )
    writer.removed_later(tree, found.holder.statements, site.line, problem)
    var renaming = Fixes.Renaming(function, statement.name, site.source)
    writer.renamed_with_the_last_fix(renaming)
    return true
}

func declared_once(name: String): Boolean {
    var declared = 0
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            declared = declared + 1
        }
        index = index + 1
    }
    return declared == 1
}

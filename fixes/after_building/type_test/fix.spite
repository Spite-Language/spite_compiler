var writer = Fixes.Fixes()
var naming = Validators.HighIntermediaryRepresentation.EveryRule()
var rule = Validators.HighIntermediaryRepresentation.ClassTest.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    written: SpiteCompiler.Expression?,
): SpiteCompiler.Expression? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return fixed_a_binary(context, values, written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        written.operand = fixed(context, values, written.operand)
    }
    return written
}

# ../../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func fixed_a_statement(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    statement: SpiteCompiler.WrittenStatement,
) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: statement.value = fixed(context, values, statement.value)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: statement.value = fixed(context, values, statement.value)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: statement.value = fixed(context, values, statement.value)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: statement.condition = fixed(context, values, statement.condition)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: statement.condition = fixed(context, values, statement.condition)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.Block: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func fixed_a_binary(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): SpiteCompiler.Expression {
    if binary.operator == 'and' or binary.operator == 'or' {
        binary.left = fixed(context, values, binary.left)
        binary.right = fixed(context, values, binary.right)
        return binary
    }
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    if not operators.is_a_class_test(binary) {
        return binary
    }
    var tree = sites.tree_of(context)
    if not tree {
        return binary
    }
    var left = binary.left
    var asks_a_value = false
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class" {
        asks_a_value = operators.is_a_value_path(left.target)
    }
    if not asks_a_value {
        return binary
    }
    var path = values.class_test_path_of(binary)
    var type_arguments = values.type_arguments_of(binary.right)
    var member = context.resolver.types.class_type_in(path, type_arguments, context.current_class, context.line)
    var answer = rule.check_a_type_compared(context, binary, member, values)
    if not answer.is_fixable() {
        return binary
    }
    return rewritten(context, binary)
}

func rewritten(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): SpiteCompiler.Expression {
    var tree = sites.tree_of(context)
    crash tree
    crash binary.left
    crash binary.right
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(binary.left, "satisfies_type")
    callee.line = binary.line
    callee.column = binary.column
    var arguments = List<SpiteCompiler.Expression>()
    arguments.append(binary.right)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var call = AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, no_generics, arguments)
    call.line = binary.line
    call.column = binary.column
    var made: SpiteCompiler.Expression = call
    if binary.operator == 'not_equal' {
        var negated = AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', call)
        negated.line = binary.line
        negated.column = binary.column
        made = negated
    }
    var made_printer = Printers.Spite.ExpressionPrinter(made)
    var turned = made_printer.text()
    var path = context.path()
    var problem = Diagnostics.Problem(
        path,
        context.line,
        "'{shown}' compares a class with a type, which no class equals: wrote '{turned}' in its place, which asks whether the class fits it",
    )
    problem.class_name = naming.plain_class_name(context.current_class.shown)
    problem.function_name = naming.shown_function_name(context.current_function)
    problem.is_fix = true
    writer.found_later(tree, problem)
    return made
}

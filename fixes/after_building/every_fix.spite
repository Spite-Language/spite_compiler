var writer = Fixes.Fixes()

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    if site.kind == "copy" {
        var copies = Fixes.AfterBuilding.CopyToNarrow.Fix()
        copies.fixed(context, site)
        return
    }
    var changes_before = writer.later_changes.count()
    var problems_before = writer.later_problems.count()
    fixed_from_what_was_proven(context, site)
    writer.rests_on_a_narrowing(changes_before, problems_before)
}

# ../../ARCHITECTURE.md#a-fix-rests-on-no-narrowing-a-proof-took-back
func fixed_from_what_was_proven(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    if site.kind == "decided condition" {
        var decided = Fixes.AfterBuilding.DecidedCondition.Fix()
        decided.fixed(context, site)
        return
    }
    var known = Fixes.AfterBuilding.KnownIf.Fix()
    if site.kind == "answered class test" {
        known.fixed_a_class_test(context, site)
        return
    }
    known.fixed(context, site)
    var checks = Fixes.AfterBuilding.ProvenCheck.Fix()
    checks.fixed(context, site)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_terminal_if(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    written: String,
) {
    var terminal = Fixes.AfterBuilding.TerminalIf.Fix()
    terminal.fixed(context, site, written)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_an_attribute(
    table: Symbols.SymbolTable,
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    path: String,
    owner: String,
) {
    var attributes = Fixes.AfterBuilding.UnreadAttribute.Fix()
    attributes.fixed(table, declaration, path, owner)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_walk(walk: AbstractSyntaxTree.Walk.Walk, class_name: String): AbstractSyntaxTree.Walk.Walk {
    var locals = Fixes.AfterBuilding.UnreadPlainLocal.Fix()
    var removed = locals.fixed(walk, class_name)
    var index = 0
    while index < removed.count() {
        var problem = removed[index]
        writer.found_later(walk.file, problem)
        index = index + 1
    }
    if removed.is_empty() {
        return walk
    }
    return AbstractSyntaxTree.Walk.Walk(walk.file)
}

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func fixed_the_default_order(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
) {
    var order = Fixes.AfterBuilding.DefaultOrder.Fix()
    order.fixed(table, owner, moves)
}

var writer = Fixes()

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    if site.kind == "copy" {
        var copies = CopyToNarrow.Fix()
        copies.fixed(context, site)
        return
    }
    var changes_before = writer.later_changes.count()
    var problems_before = writer.later_problems.count()
    var renamings_before = writer.later_renamings.count()
    fixed_from_what_was_proven(context, site)
    writer.rests_on_a_narrowing(changes_before, problems_before, renamings_before)
}

# ../../ARCHITECTURE.md#a-fix-rests-on-no-narrowing-a-proof-took-back
func fixed_from_what_was_proven(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    if site.kind == "decided condition" {
        var decided = DecidedCondition.Fix()
        decided.fixed(context, site)
        return
    }
    var known = KnownIf.Fix()
    if site.kind == "answered class test" {
        known.fixed_a_class_test(context, site)
        return
    }
    known.fixed(context, site)
    var checks = ProvenCheck.Fix()
    checks.fixed(context, site)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_terminal_if(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    written: String,
) {
    var terminal = TerminalIf.Fix()
    terminal.fixed(context, site, written)
}

# ../../../spite_documentation/functions_and_operators.md#a-comparison-is-a-call-on-its-left-side
func fixed_a_comparison(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left_type: Model.Type,
    right_type: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
) {
    var comparisons = SwappedComparison.Fix()
    comparisons.fixed(context, binary, left_type, right_type, values)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func fixed_a_type_test(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    written: SpiteCompiler.Expression?,
): SpiteCompiler.Expression? {
    var tests = TypeTest.Fix()
    return tests.fixed(context, values, written)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func fixed_the_type_tests_of(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    statement: SpiteCompiler.WrittenStatement,
) {
    var tests = TypeTest.Fix()
    tests.fixed_a_statement(context, values, statement)
}

# ../../../spite_documentation/failure.md#an-if-that-only-returns-what-a-fallback-returns-is-a-fallback
func fixed_a_negated_order(
    context: HighIntermediaryRepresentation.Building.Context,
    guard: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
    built: SpiteCompiler.Value,
) {
    var orders = NegatedOrder.Fix()
    orders.fixed(context, guard, built)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_an_attribute(
    table: Symbols.SymbolTable,
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    path: String,
    owner: String,
) {
    var attributes = UnreadAttribute.Fix()
    attributes.fixed(table, declaration, path, owner)
}

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_walk(walk: AbstractSyntaxTree.Walk, class_name: String): AbstractSyntaxTree.Walk {
    var locals = UnreadPlainLocal.Fix()
    var removed = locals.fixed(walk, class_name)
    var index = 0
    while index < removed.count() {
        var problem = removed[index]
        writer.found_later(walk.file, problem)
        index = index + 1
    }
    if removed.is_empty() {
        return walk
    }
    return AbstractSyntaxTree.Walk(walk.file)
}

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func fixed_the_default_order(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
) {
    var order = DefaultOrder.Fix()
    order.fixed(table, owner, moves)
}

var writer = Fixes.Fixes()

# ../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
): Boolean {
    if site.kind == "decided condition" {
        var decided = Fixes.AfterBuilding.DecidedCondition.Fix()
        return decided.fixed(context, site)
    }
    var checks = Fixes.AfterBuilding.ProvenCheck.Fix()
    return checks.fixed(context, site)
}

# ../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed_a_walk(walk: AbstractSyntaxTree.Walk.Walk, class_name: String): Boolean {
    var locals = Fixes.AfterBuilding.UnreadPlainLocal.Fix()
    var removed = locals.fixed(walk, class_name)
    var index = 0
    while index < removed.count() {
        var problem = removed[index]
        writer.found_later(walk.file, problem)
        index = index + 1
    }
    return not removed.is_empty()
}

var writer = Fixes.Fixes()

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func fixed(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
) {
    var rule = Validators.HighIntermediaryRepresentation.DefaultOrder.Validator()
    var answer = rule.check_the_moves(owner, moves)
    fallback answer.is_fixable()
    var moved_paths = List<String>()
    var index = 0
    while index < moves.placed.count() {
        var name = moves.placed[index]
        var at = moves.names.index_of(name)
        crash at
        var home = moves.homes[at]
        crash home
        if moves.has_moved_up(name) and not moved_paths.contains(home) {
            moved_paths.append(home)
        }
        index = index + 1
    }
    var path_index = 0
    while path_index < moved_paths.count() {
        var path = moved_paths[path_index]
        reorder(table, owner, moves, path)
        path_index = path_index + 1
    }
}

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func reorder(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
    path: String,
) {
    var tree = table.files[path]
    crash tree
    var slots = List<Integer>()
    var held = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            slots.append(index)
            held.append(declaration)
        }
        index = index + 1
    }
    var slot_index = 0
    while slot_index < slots.count() {
        var slot = slots[slot_index]
        crash slot
        var chosen = earliest_placed(moves, held)
        crash chosen
        tree.declarations[slot] = chosen
        slot_index = slot_index + 1
    }
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var shown = every_rule.plain_class_name(owner.shown)
    var moved_index = 0
    while moved_index < moves.placed.count() {
        var name = moves.placed[moved_index]
        var placer = moves.placers[moved_index]
        crash name and placer
        var at = moves.names.index_of(name)
        crash at
        var home = moves.homes[at]
        crash home
        if home == path and moves.has_moved_up(name) {
            tell(tree, owner, moves, shown, name, placer)
        }
        moved_index = moved_index + 1
    }
}

func earliest_placed(
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
    held: List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>,
): AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration? {
    var best_index = 0
    var best_place = moves.placed.count()
    var index = 0
    while index < held.count() {
        var declaration = held[index]
        var place_of = moves.placed.index_of(declaration.name)
        if place_of and place_of < best_place {
            best_place = place_of
            best_index = index
        }
        index = index + 1
    }
    var chosen = held[best_index]
    held.remove_at(best_index)
    return chosen
}

func tell(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    owner: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
    shown: String,
    name: String,
    placer: String,
) {
    var attribute = owner.attribute_named(name)
    crash attribute
    crash attribute.declaration
    fallback not writer.has_fixed(tree.path, attribute.declaration.line)
    var how = moves.how_it_is_used(placer, name)
    var text = "'{name}' was declared below '{placer}', whose default {how} it; moved it above, since a default may only read or write attributes already given a value"
    if not moves.directly_uses(placer, name) {
        text = "'{name}' was declared below '{placer}', whose default {how} it through other defaults; moved it above, since a default may only read or write attributes already given a value"
    }
    var problem = Diagnostics.Problem(tree.path, attribute.declaration.line, text)
    problem.class_name = shown
    problem.is_among_the_attributes = true
    problem.is_fix = true
    writer.found_later(tree, problem)
}

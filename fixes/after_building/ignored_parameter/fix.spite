var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk(empty_file)
var class_name = ""
var replacing = List<AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>()
var rule = Validators.AbstractSyntaxTree.UnusedNames.Validator()
var found_problems = List<Diagnostics.Problem>()

# ../../../../spite_documentation/style.md#nothing-unused
func fixed(
    starting_walk: AbstractSyntaxTree.Walk,
    starting_class_name: String,
    starting_replacing: List<AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>,
): List<Diagnostics.Problem> {
    walk = starting_walk
    class_name = starting_class_name
    replacing = starting_replacing
    found_problems = List<Diagnostics.Problem>()
    walk.function_declarations.each(fix_function)
    return found_problems
}

func fix_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var names = function.parameters.map_names()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var answer = rule.check_an_ignored_parameter(walk, function, name, replacing)
        if answer.is_fixable() {
            ignore(function, name)
        }
        index = index + 1
    }
}

func ignore(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String) {
    var ignored = "_{name}"
    var renaming = Fixes.Renaming(function, name, ignored)
    renaming.run()
    var text = "the parameter '{name}' was never read, and '{function.name}' replaces the function of the class it reopens, so it keeps its parameters; renamed it '{ignored}'"
    var problem = Diagnostics.Problem(walk.file.path, function.line, text)
    problem.class_name = class_name
    problem.function_name = function.declared_key()
    problem.is_fix = true
    found_problems.append(problem)
}

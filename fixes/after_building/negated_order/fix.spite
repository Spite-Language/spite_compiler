var writer = Fixes.Fixes()
var rule = Validators.HighIntermediaryRepresentation.NegatedOrder.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/failure.md#an-if-that-only-returns-what-a-fallback-returns-is-a-fallback
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    guard: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
    built: SpiteCompiler.Value,
) {
    var answer = rule.check(context, guard, built)
    fallback answer.is_fixable()
    var tree = sites.tree_of(context)
    crash tree
    var negated = guard.condition
    crash negated.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    crash negated.operand
    var opposite = AbstractSyntaxTree.DefaultGuard.Opposite()
    var turned = opposite.flipped(negated.operand)
    var printer = Printers.Spite.ExpressionPrinter(turned)
    var asserted = printer.text()
    var negated_printer = Printers.Spite.ExpressionPrinter(negated)
    var written = negated_printer.text()
    var flipped_guard = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(turned)
    flipped_guard.line = guard.line
    flipped_guard.column = guard.column
    var guarding = List<SpiteCompiler.WrittenStatement>()
    guarding.append(flipped_guard)
    var none_moved = List<SpiteCompiler.WrittenStatement>()
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var problem = deciding.problem_at(
        context,
        guard.line,
        "'{written}' only compares whole numbers, which are never NaN, so the 'not' goes in: wrote 'fallback {asserted}' in its place",
    )
    writer.replaced_later(tree, context.block_statements, guard.line, guarding, none_moved, problem)
}

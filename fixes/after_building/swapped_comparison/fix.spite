var writer = Fixes()
var naming = Validators.HighIntermediaryRepresentation.EveryRule()
var rule = Validators.HighIntermediaryRepresentation.SwappedComparison.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/functions_and_operators.md#a-comparison-is-a-call-on-its-left-side
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left_type: Model.Type,
    right_type: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
) {
    var answer = rule.check(context, binary, left_type, right_type, values)
    fallback answer.is_fixable()
    var tree = sites.tree_of(context)
    crash tree
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var left = binary.left
    binary.left = binary.right
    binary.right = left
    binary.operator = operators.turned_around(binary.operator)
    var turned_printer = Printers.Spite.ExpressionPrinter(binary)
    var turned = turned_printer.text()
    var shown_left = context.shown(left_type)
    var shown_right = context.shown(right_type)
    var left_article = naming.article_of(shown_left)
    var right_article = naming.article_of(shown_right)
    var path = context.path()
    var problem = Diagnostics.Problem(
        path,
        context.line,
        "'{shown}' called on {left_article} {shown_left}, which {right_article} {shown_right} on the right may not fit; swapped the sides to '{turned}'",
    )
    problem.class_name = naming.plain_class_name(context.current_class.shown)
    problem.function_name = naming.shown_function_name(context.current_function)
    problem.is_fix = true
    writer.found_later(tree, problem)
}

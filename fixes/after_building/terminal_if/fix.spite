var writer = Fixes.Fixes()
var rule = Validators.HighIntermediaryRepresentation.GuardAssert.Validator()
var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    written: String,
) {
    var answer = rule.check_a_terminal_if(context, site, written)
    fallback answer.is_fixable()
    var tree = sites.tree_of(context)
    var statement = rule.terminal_if_of(site)
    crash tree and statement
    crash statement.then_branch
    crash statement.condition
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var guard = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(statement.condition)
    guard.line = statement.line
    var replacing = statement.then_branch.statements.copy()
    replacing.prepend(guard)
    var problem = deciding.problem_at(
        context,
        statement.line,
        "this 'if' was the last thing the function did and had no 'else', so it only checked that '{written}' was there; wrote 'fallback {written}' and moved the code it ran left",
    )
    writer.replaced_later(tree, site.block, statement.line, replacing, problem)
}

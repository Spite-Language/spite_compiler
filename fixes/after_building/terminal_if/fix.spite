var writer = Fixes.Fixes()
var naming = Validators.HighIntermediaryRepresentation.Typing.Validator()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func fixed(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    written: String,
): Boolean {
    var sites = Fixes.AfterBuilding.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    crash context.current_function.declaration
    var class_name = naming.plain_class_name(context.current_class.shown)
    fallback not context.current_function.declaration.is_a_constructor_of(class_name)
    var path = context.path()
    if writer.has_fixed(path, site.statement_line) {
        return true
    }
    var index = 0
    while index < site.block.count() {
        var statement = site.block[index]
        if statement.line == site.statement_line and statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            return fix_the_if(context, site, tree, statement, written)
        }
        index = index + 1
    }
    return false
}

func fix_the_if(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    written: String,
): Boolean {
    crash statement.then_branch
    crash statement.condition
    var deciding = Fixes.AfterBuilding.DecidedCondition.Fix()
    var kept = statement.then_branch.statements
    fallback not deciding.moves_a_name_onto_another(context, statement, kept)
    var guard = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(statement.condition)
    guard.line = statement.line
    var replacing = kept.copy()
    replacing.prepend(guard)
    var problem = deciding.problem_at(
        context,
        statement.line,
        "this 'if' was the last thing the function did and had no 'else', so it only checked that '{written}' was there; wrote 'fallback {written}' and moved the code it ran left",
    )
    writer.replaced_later(tree, site.block, statement.line, replacing, problem)
    return true
}

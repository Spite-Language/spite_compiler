var console = Console()

func formatted(
    path: String,
    written: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
): String {
    var printer = Printers.FormattedSource.Printer(written, tokens, comments)
    var text = printer.text()
    if text == written {
        return written
    }
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, text, first_line)
    var formatted_tokens = lexer.tokens_of()
    var safety = Validators.AbstractSyntaxTree.Formatting.Validator()
    safety.check(path, tokens, comments, formatted_tokens, lexer.comments)
    var file = File(path)
    var saved = file.write(text)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, saved)
    console.error("formatted {path}")
    return text
}

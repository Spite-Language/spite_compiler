var console = Console()

# ../../spite_spec/specs/style.md#formatting
func formatted(path: String, class_name: String, written: String, tree: AbstractSyntaxTree.Shapes.SourceFile): String {
    if not holds_every_comment(tree) {
        return written
    }
    var text = printed(tree, written)
    if text == written {
        return written
    }
    var reading = AbstractSyntaxTree.AbstractSyntaxTree(path, tree.namespace, text)
    var reread = reading.run()
    var again = printed(reread, written)
    var written_comments = tree.comments.count()
    var printed_comments = reread.comments.count()
    var safety = Validators.AbstractSyntaxTree.Formatting.Validator()
    safety.check(path, text, again, written_comments, printed_comments)
    var file = File(path)
    var saved = file.write_string(text)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, saved)
    console.error("formatted {path}")
    tell_the_moved_comments(path, class_name, tree)
    return text
}

# ../../spite_spec/specs/style.md#comments
func holds_every_comment(tree: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    var held = tree.heading.count() + tree.misplaced_comments.count()
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            held = held + declaration.comments.count()
        }
        index = index + 1
    }
    return held == tree.comments.count()
}

func printed(tree: AbstractSyntaxTree.Shapes.SourceFile, written: String): String {
    var printer = Printers.Spite.FilePrinter(tree)
    if written.contains("\r\n") {
        printer.line_break = "\r\n"
    }
    return printer.text()
}

# ../../spite_spec/specs/style.md#comments
func tell_the_moved_comments(path: String, class_name: String, tree: AbstractSyntaxTree.Shapes.SourceFile) {
    fallback not tree.misplaced_comments.is_empty()
    var report = Diagnostics.Report()
    var index = 0
    while index < tree.misplaced_comments.count() {
        var comment = tree.misplaced_comments[index]
        var place = tree.misplaced_places[index]
        crash place
        var problem = Diagnostics.Problem(
            path,
            comment.line,
            "a comment {place} belongs to its class; moved it to the top of the file",
        )
        problem.class_name = class_name
        problem.is_fix = true
        report.add(problem)
        index = index + 1
    }
    var shown = Printers.Diagnostics.Printer(report)
    var notes = shown.text()
    console.error(notes)
}

var console = Console()

# ../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func fixed(path: String, text: String, problems: List<Diagnostics.Problem>): String {
    var file = File(path)
    var saved = file.write_string(text)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, saved)
    var report = Diagnostics.Report()
    report.add_all(problems)
    var printer = Printers.Diagnostics.Printer(report)
    var notes = printer.text()
    console.error(notes)
    return text
}

# ../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func remove_the_line(path: String, statements: List<String>, problem: Diagnostics.Problem) {
    var file = File(path)
    var text = file.read_as_string()
    fallback text
    var unbroken = text.replace("\r\n", "\n")
    var lines = unbroken.split("\n")
    var written = lines[problem.line - 1]
    fallback written
    var trimmed = written.trim()
    fallback statements.contains(trimmed)
    var fix = Diagnostics.Fix(problem, problem.line, problem.line, "")
    var fixes = List<Diagnostics.Fix>()
    fixes.append(fix)
    var printer = Printers.FixedSource.Printer(text, fixes)
    var changed = printer.text()
    var problems = List<Diagnostics.Problem>()
    problems.append(problem)
    var written_text = fixed(path, changed, problems)
    crash not written_text.is_empty()
    var restart = CommandLine.Restart()
    restart.run()
}

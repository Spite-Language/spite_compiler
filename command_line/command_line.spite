var program = Program()
var folder = ""
var flags = Dictionary<String, String>()
var written_flags = List<String>()
var bare_flags = List<String>()
var writes_high_ir = false
var writes_low_ir = false
var program_folder = ""
var program_name = ""
var only_checks = false
var compiler_options = [
    "check",
    "build",
    "executable_path",
    "final_classes",
    "optimization_report",
    "high_ir",
    "low_ir",
    "optimized",
    "development",
    "repl",
    "repl_port",
    "hot_reload",
    "debug_memory",
    "trace_fallbacks",
]
var reloads = false
var reload_host: Model.ReloadHost? = null

func run() {
    var settings = Settings()
    folder = settings.folder
    flags = settings.flags
    written_flags = settings.written_flags
    bare_flags = settings.bare_flags
    writes_high_ir = settings.writes_high_ir
    writes_low_ir = settings.writes_low_ir
    program_folder = resolved_folder(folder)
    program_name = entry_name_of(program_folder)
    if not flags.contains("program") {
        flags["program"] = program_folder
    }
    if flags["hot_reload"] == "true" and not flags.contains("development") {
        flags["development"] = "true"
    }
    only_checks = flags["check"] == "true"
    reloads = flags.contains("reload_at")
    if not reloads and not only_checks {
        remove_the_last_build()
    }
}

# ../../spite_spec/specs/programs.md#build-settings-build
func take_the_build(model: Model.ProgramModel) {
    var build = model.class_named("Build")
    fallback build
    var path_before = executable_path()
    var index = 0
    while index < compiler_options.count() {
        var name = compiler_options[index]
        take_an_option(build, name)
        index = index + 1
    }
    var field_index = 0
    while field_index < build.declared_attributes.count() {
        var field = build.declared_attributes[field_index]
        take_from_the_environment(field)
        field_index = field_index + 1
    }
    writes_high_ir = writes_high_ir or flags["high_ir"] == "true"
    writes_low_ir = writes_low_ir or flags["low_ir"] == "true"
    if flags["hot_reload"] == "true" and not flags.contains("development") {
        flags["development"] = "true"
    }
    only_checks = flags["check"] == "true"
    var settled = Validators.CommandLine.KnownFlag.Validator()
    settled.check_the_build_settings(flags)
    if reloads {
        read_the_reload_host()
    }
    var path_now = executable_path()
    if not only_checks and not reloads and path_now != path_before {
        remove_the_last_build()
    }
}

# ../../spite_spec/specs/programs.md#build-settings-build
func take_from_the_environment(field: Model.AttributeModel) {
    fallback not flags.contains(field.name)
    fallback not compiler_options.contains(field.name)
    var literal = Validators.NameResolution.Settings.Validator()
    fallback literal.is_the_programs(field, program_folder)
    var variable = field.name.upper_case()
    var value = program.environment(variable)
    fallback value
    var flag = field.name.replace("_", "-")
    var known = Validators.CommandLine.KnownFlag.Validator()
    known.check_the_value(field, flag, value, false)
    flags[field.name] = value
}

func take_an_option(build: Model.ClassModel, name: String) {
    fallback not flags.contains(name)
    var attribute = build.attribute_named(name)
    fallback attribute
    var literal = Validators.NameResolution.Settings.Validator()
    literal.check_the_option(attribute)
    var written = declared_text(attribute.declaration)
    var is_off = written.is_empty() or written == "false" or written == "0"
    fallback not is_off
    flags[name] = written
}

func declared_text(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration?): String {
    fallback declaration
    var no_flags = Dictionary<String, String>()
    var reader = Symbols.BuildCondition(no_flags, no_flags)
    return reader.literal_text(declaration.value)
}

func runs_the_program(): Boolean {
    return not only_checks and not reloads and flags["build"] != "true"
}

# ../HOT_RELOAD.md#the-manifest
func read_the_reload_host() {
    var path = beside_the_executable("reload_host")
    var file = File(path)
    var text = file.read_as_string()
    if not text {
        var refusing = Validators.HotReload.Validator()
        refusing.refuse("'{path}' cannot be read: a reload compiles against the manifest its --hot-reload build wrote beside it")
    }
    crash text
    var reader = ReloadHostReader()
    reload_host = reader.read(text)
}

func beside_the_executable(extension: String): String {
    var executable = executable_path()
    var stem = executable
    if executable.ends_with(".exe") {
        var length = executable.length()
        var sliced_stem = executable.slice(0, length - 4)
        crash sliced_stem
        stem = sliced_stem
    }
    return "{stem}.{extension}"
}

func remove_the_last_build() {
    var path = executable_path()
    var last = File(path)
    if last.exists() {
        var removed = last.remove()
        var writable = Validators.CommandLine.WritableFile.Validator()
        writable.check(path, removed)
    }
}

func executable_path(): String {
    var given = flags["executable_path"]
    if given {
        return given
    }
    var build = build_folder()
    return "{build}/{program_name}.exe"
}

func build_folder(): String {
    make_a_folder("{program_folder}/.spite")
    make_a_folder("{program_folder}/.spite/build")
    return "{program_folder}/.spite/build"
}

func make_a_folder(path: String) {
    var folder = Directory(path)
    fallback not folder.exists()
    var made = folder.create()
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, made)
}

func entry_name_of(folder: String): String {
    var names = Mapping.Names()
    var segment = names.last_segment(folder)
    return names.snake_case_of(segment)
}

func resolved_folder(named: String): String {
    if named == "." {
        var working = program.working_directory()
        crash working
        return working.replace("\\", "/")
    }
    return named
}

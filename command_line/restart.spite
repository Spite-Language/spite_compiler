var environment = Environment()
var program = Program()

# ../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func run() {
    var path = program.executable_path()
    crash path
    var windows_path = path.replace("/", "\\")
    var given = environment.given_flags()
    var compiling = Process(windows_path, given)
    var answered = compiling.run_attached()
    var runnable = Validators.CommandLine.RunnableProgram.Validator()
    runnable.check(windows_path, answered)
    crash answered
    program.exit(answered)
}

# ../../spite_documentation/compiler.md#development-builds-and-tree-shaking
func holds(flags: Dictionary<String, String>): Boolean {
    return swaps(flags) or flags["development"] == "true"
}

# ../../spite_documentation/repl.md#typing-spite-into-a-running-program
func swaps(flags: Dictionary<String, String>): Boolean {
    return has_a_session(flags) or flags["hot_reload"] == "true"
}

func has_a_session(flags: Dictionary<String, String>): Boolean {
    return flags["repl"] == "true" or serves_a_port(flags)
}

func serves_a_port(flags: Dictionary<String, String>): Boolean {
    var port = flags["repl_port"]
    fallback port
    return port != "0"
}

# ../../spite_spec/specs/compiler.md#inspectable-and-production-builds
func holds(flags: Dictionary<String, String>): Boolean {
    var port = flags["repl_port"]
    var serves = false
    if port {
        serves = port != "0"
    }
    var asked = flags["repl"] == "true" or flags["development"] == "true"
    return serves or asked or flags["hot_reload"] == "true"
}

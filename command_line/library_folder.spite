var program = Program()
var systems = ["windows", "linux", "mac"]
var written = ""
var is_given = false
var is_bare = false
var executable = ""
var folder = ""
var exists = false
var missing = ""
var system = "windows"

# ../../spite_documentation/compiler.md#where-the-standard-library-comes-from
func find(flags: Dictionary<String, String>, bare_flags: List<String>, program_folder: String) {
    var target = flags["target_operating_system"]
    if target and systems.contains(target) {
        system = target
    }
    var given = flags["standard_library_path"]
    if given {
        is_given = true
        written = given
        is_bare = bare_flags.contains("standard_library_path") or given.is_empty()
        folder = resolved(given, program_folder)
    } else {
        folder = installed_folder()
    }
    fallback not is_bare and not folder.is_empty()
    exists = holds_a_folder(folder)
    fallback exists
    if not holds_a_folder("{folder}/common") {
        missing = "common"
    } else if not holds_a_folder("{folder}/{system}") {
        missing = system
    }
}

func resolved(given: String, program_folder: String): String {
    var written_path: Path? = given
    fallback written_path
    if written_path.is_rooted {
        return written_path.to_string()
    }
    var joined: Path? = "{program_folder}/{given}"
    crash joined
    return joined.to_string()
}

# ../../spite_documentation/compiler.md#where-the-standard-library-comes-from
func installed_folder(): String {
    var running = program.executable_path()
    fallback running
    executable = running.replace("\\", "/")
    var segments = executable.split("/")
    crash segments.remove_last()
    while not segments.is_empty() {
        var above = segments.join("/")
        var candidate = "{above}/spite_standard_library"
        if holds_a_folder(candidate) {
            return candidate
        }
        crash segments.remove_last()
    }
    return ""
}

func holds_a_folder(path: String): Boolean {
    var folder_path: Path? = path
    fallback folder_path
    var directory = Directory(folder_path)
    return directory.exists()
}

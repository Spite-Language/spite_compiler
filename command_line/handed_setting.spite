var name = ""
var is_given = false
var from_the_environment: String? = null

# ../ARCHITECTURE.md#validators
func HandedSetting(starting_name: String, starting_is_given: Boolean, starting_from_the_environment: String?) {
    name = starting_name
    is_given = starting_is_given
    from_the_environment = starting_from_the_environment
}

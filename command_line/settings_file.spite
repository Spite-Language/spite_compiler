singleton

var values = Dictionary<String, String>()
var declared = List<String>()

# ../../spite_documentation/programs.md#compile-time-settings-build
func SettingsFile() {
    read_the_values()
    read_the_declared()
}

func value_of(name: String): String? {
    fallback declared.contains(name)
    var variable = name.upper_case()
    return values[variable]
}

func read_the_values() {
    var file = File(".env")
    var text = file.read_as_string()
    fallback text
    var lines = text.lines()
    lines.each(read_a_value)
}

func read_a_value(line: String) {
    var trimmed = line.trim()
    fallback not trimmed.is_empty() and not trimmed.starts_with("#")
    var equals = trimmed.index_of("=")
    fallback equals
    var end = trimmed.length()
    var named = trimmed.slice(0, equals)
    var valued = trimmed.slice(equals + 1, end)
    crash named
    crash valued
    var key = named.trim()
    var value = valued.trim()
    values[key] = value
}

func read_the_declared() {
    var file = File("build.spite")
    var text = file.read_as_string()
    fallback text
    var lines = text.lines()
    lines.each(read_a_declared)
}

func read_a_declared(line: String) {
    fallback line.starts_with("var ")
    var end = line.length()
    var rest = line.slice(4, end)
    crash rest
    var name = rest
    var stops = [" ", ":", "="]
    var index = 0
    while index < stops.count() {
        var stop = stops[index]
        var at = name.index_of(stop)
        if at {
            var cut = name.slice(0, at)
            crash cut
            name = cut
        }
        index = index + 1
    }
    declared.append(name)
}

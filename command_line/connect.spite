# ../../spite_spec/specs/repl.md#spite---connectport
var console = Console()
var program = Program()
var environment = Environment()
var _largest_port = 65535

func asks(): Boolean {
    return environment.connect != 0
}

func run() {
    var port = environment.connect
    var command = environment.command
    var has_a_command = not command.is_empty()
    if port < 1 or port > _largest_port {
        stop("error: --connect takes a port number from 1 to 65535: spite --connect=4000")
    }
    var socket = Tcp.Client()
    if not socket.connect_locally(port) {
        stop("error: nothing is listening on 127.0.0.1:{port}")
    }
    if has_a_command {
        var answered = asked(socket, command)
        console.print(answered)
        socket.close()
        return
    }
    talk(socket)
    socket.close()
}

func stop(text: String) {
    console.error(text)
    program.exit(1)
}

func asked(socket: Tcp.Client, command: String): String {
    var sent = socket.write_line(command)
    if not sent {
        stop("error: the program on the port closed the connection")
    }
    var answered = socket.read_line()
    if not answered {
        stop("error: the program on the port closed the connection")
    }
    crash answered
    return answered
}

func talk(socket: Tcp.Client) {
    var keeps_going = true
    while keeps_going {
        console.write("spite> ")
        var line = console.read_line()
        if not line {
            console.print("")
            return
        }
        var command = line.trim()
        var answered = asked(socket, command)
        var shown = shown_of(answered)
        if not shown.is_empty() {
            console.print(shown)
        }
        keeps_going = command != "exit"
    }
}

func shown_of(answered: String): String {
    var succeeded = answered.starts_with("\{\"ok\":true")
    if not succeeded {
        var error = field_of(answered, "error")
        return "error: {error}"
    }
    var value = field_of(answered, "value")
    var class_name = field_of(answered, "type")
    if class_name.is_empty() or class_name == "Nothing" {
        return value
    }
    return "{value} ({class_name})"
}

func field_of(answered: String, name: String): String {
    var opening = "\"{name}\":\""
    var found = answered.index_of(opening)
    fallback found
    var read = ""
    var index = found + opening.length()
    var length = answered.length()
    while index < length {
        var character = answered[index]
        crash character
        if character == "\"" {
            return read
        }
        var is_a_code = character == "\\" and index + 5 < length and answered[index + 1] == "u"
        if is_a_code {
            var digits = answered.slice(index + 2, index + 6)
            crash digits
            var coded = code_of(digits)
            read = "{read}{coded}"
            index = index + 6
        } else if character == "\\" and index + 1 < length {
            var escaped = answered[index + 1]
            crash escaped
            var meant = unescaped(escaped)
            read = "{read}{meant}"
            index = index + 1 + escaped.length()
        } else {
            read = "{read}{character}"
            index = index + character.length()
        }
    }
    return read
}

func unescaped(escaped: String): String {
    if escaped == "n" {
        return "\n"
    } else if escaped == "t" {
        return "\t"
    } else if escaped == "r" {
        return "\r"
    } else {
        return escaped
    }
}

func code_of(digits: String): String {
    var hexadecimal = "0123456789abcdef"
    var code = 0
    var index = 0
    while index < digits.length() {
        var digit = digits[index]
        crash digit
        var value = hexadecimal.index_of(digit)
        crash value
        code = code * 16 + value
        index = index + 1
    }
    var made = String()
    made.append_code(code)
    return made
}

var environment = Environment()
var program = Program()
var console = Console()
var given_count = 0

var folder = "."
var writes_high_ir = false
var writes_low_ir = false
var flags = Dictionary<String, String>()
var written_flags = List<String>()
var bare_flags = List<String>()

# ../../spite_spec/specs/compiler.md#flags-and-settings
func Settings() {
    var given = environment.given_flags()
    given_count = given.count()
    given.each(read_argument)
    writes_high_ir = environment.high_ir
    writes_low_ir = environment.low_ir
    take_a_switch("check", environment.check)
    take_a_switch("build", environment.build)
    take_a_text("executable_path", environment.executable_path)
    take_a_text("final_classes", environment.final_classes)
    take_a_text("optimization_report", environment.optimization_report)
    take_a_switch("high_ir", environment.high_ir)
    take_a_switch("low_ir", environment.low_ir)
    take_a_switch("optimized", environment.optimized)
    take_a_switch("development", environment.development)
    take_a_switch("repl", environment.repl)
    take_a_number("repl_port", environment.repl_port)
    take_a_switch("hot_reload", environment.hot_reload)
    take_a_switch("debug_memory", environment.debug_memory)
    take_a_switch("trace_fallbacks", environment.trace_fallbacks)
    take_a_text("target_operating_system", environment.target_operating_system)
    take_a_text("reload_at", environment.reload_at)
}

func take_a_switch(name: String, value: Boolean) {
    if value {
        check_handed(name)
    }
    fallback value or flags.contains(name)
    if value {
        flags[name] = "true"
    } else {
        flags[name] = "false"
    }
}

func take_a_text(name: String, value: String) {
    if not value.is_empty() {
        check_handed(name)
    }
    fallback not value.is_empty() or flags.contains(name)
    flags[name] = value
}

func take_a_number(name: String, value: Integer) {
    if value != 0 {
        check_handed(name)
    }
    fallback value != 0 or flags.contains(name)
    flags[name] = value.to_string()
}

func check_handed(name: String) {
    fallback given_count == 0
    var variable = name.upper_case()
    var from_the_environment = program.environment(variable)
    fallback not from_the_environment
    console.error("error: this compiler was given --{name} but not handed its flags: build it with a compiler that fills Environment._flags")
    program.exit(1)
}

func read_argument(argument: String) {
    var argument_length = argument.length()
    var written = argument.slice(2, argument_length)
    crash written
    var value = "true"
    var equals = written.index_of("=")
    if equals {
        var written_length = written.length()
        var sliced_value = written.slice(equals + 1, written_length)
        crash sliced_value
        value = sliced_value
        var sliced_written = written.slice(0, equals)
        crash sliced_written
        written = sliced_written
    }
    written_flags.append(written)
    var name = written.replace("-", "_")
    if not equals {
        bare_flags.append(name)
    }
    flags[name] = value
}

var folder = ""
var writes_high_ir = false
var writes_low_ir = false
var flags = Dictionary<String, String>()
var written_flags = List<String>()
var bare_flags = List<String>()
var given_arguments = List<String>()

func Settings() {
    var arguments = Arguments()
    var index = 0
    while index < arguments.count() {
        var argument = arguments.get(index)
        read_argument(argument)
        index = index + 1
    }
    var named = Validators.CommandLine.ProgramNamed.Validator()
    named.check(folder)
}

func read_argument(argument: String) {
    if not argument.starts_with("--") {
        read_a_word(argument)
        return
    }
    given_arguments.append(argument)
    if argument == "--high-ir" {
        writes_high_ir = true
        return
    }
    if argument == "--low-ir" {
        writes_low_ir = true
    }
    var argument_length = argument.length()
    var written = argument.slice(2, argument_length)
    var value = "true"
    var equals = written.index_of("=")
    if equals {
        var written_length = written.length()
        value = written.slice(equals + 1, written_length)
        written = written.slice(0, equals)
    }
    written_flags.append(written)
    var name = written.replace("-", "_")
    if not equals {
        bare_flags.append(name)
    }
    flags[name] = value
}

func read_a_word(argument: String) {
    if folder.is_empty() {
        folder = argument
        return
    }
    given_arguments.append(argument)
}

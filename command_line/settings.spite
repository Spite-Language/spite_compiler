var folder = ""
var writes_high_ir = false
var writes_low_ir = false

func Settings() {
    var arguments = Arguments()
    var index = 0
    while index < arguments.count() {
        var argument = arguments.get(index)
        read_argument(argument)
        index = index + 1
    }
    var named = Validators.CommandLine.ProgramNamed.Validator()
    named.check(folder)
}

func read_argument(argument: String) {
    if not argument.starts_with("--") {
        folder = argument
        return
    }
    if argument == "--high-ir" {
        writes_high_ir = true
        return
    }
    if argument == "--low-ir" {
        writes_low_ir = true
        return
    }
    var known = Validators.CommandLine.KnownFlag.Validator()
    known.refuse(argument)
}

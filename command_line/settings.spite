var folder = ""
var high_intermediary_representation_folder = ""
var low_intermediary_representation_folder = ""
var unknown_flags = List<String>()

func Settings() {
    var arguments = Arguments()
    var index = 0
    while index < arguments.count() {
        var argument = arguments.get(index)
        read_argument(argument)
        index = index + 1
    }
}

func read_argument(argument: String) {
    if not argument.starts_with("--") {
        folder = argument
        return
    }
    if argument.starts_with("--high-ir=") {
        high_intermediary_representation_folder = value_of(argument)
        return
    }
    if argument.starts_with("--low-ir=") {
        low_intermediary_representation_folder = value_of(argument)
        return
    }
    unknown_flags.append(argument)
}

func value_of(argument: String): String {
    var equals_at = argument.index_of("=")
    var start = equals_at + 1
    var end = argument.length()
    return argument.slice(start, end)
}

# ../HOT_RELOAD.md#the-manifest
var host = Model.ReloadHost()

func read(text: String): Model.ReloadHost {
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        crash line
        if not line.is_empty() and not line.starts_with("#") {
            read_line(line)
        }
        index = index + 1
    }
    return host
}

func read_line(line: String) {
    var parts = line.split("\t")
    var kind = part(parts, 0)
    var first = part(parts, 1)
    switch kind {
        "generation": host.generation = whole_of(first)
        "text": host.text_base = long_of(first)
        "routines": host.routines = first
        "function": read_function(parts)
        "state": read_state(parts)
        "import": host.imports[first] = address_of(parts)
        "library": host.library_imports[first] = address_of(parts)
        "class": read_class(parts)
        "enum": read_enum(parts)
        "file": read_file(parts)
        _: refuse(line)
    }
}

func read_function(parts: List<String>) {
    var key = part(parts, 1)
    var stub_text = part(parts, 2)
    var stub = long_of(stub_text)
    var slot_text = part(parts, 3)
    var slot = long_of(slot_text)
    var digest = part(parts, 4)
    var owner = part(parts, 5)
    host.add_a_function(key, stub, slot, digest, owner)
}

func read_state(parts: List<String>) {
    var name = part(parts, 1)
    var address = address_of(parts)
    host.add_a_state(name, address)
}

func read_class(parts: List<String>) {
    var key = part(parts, 1)
    var id_text = part(parts, 2)
    var id = whole_of(id_text)
    var layout = part(parts, 3)
    host.add_a_class(key, id, layout)
}

func read_enum(parts: List<String>) {
    var key = part(parts, 1)
    var values = part(parts, 2)
    host.add_an_enum(key, values)
}

func read_file(parts: List<String>) {
    var path = part(parts, 1)
    var digest = part(parts, 2)
    host.add_a_file(path, digest)
}

func address_of(parts: List<String>): Long {
    var address_text = part(parts, 2)
    return long_of(address_text)
}

func part(parts: List<String>, index: Integer): String {
    var found = parts[index]
    if not found {
        return ""
    }
    return found
}

func whole_of(text: String): Integer {
    var read_number = text.to_integer()
    crash read_number
    return read_number
}

func long_of(text: String): Long {
    var read_number = text.to_long()
    crash read_number
    return read_number
}

func refuse(line: String) {
    var refusing = Validators.HotReload.Validator()
    refusing.refuse(
        "the reload manifest holds a line this compiler does not read, so another compiler wrote it: '{line}'. Build the program again with this compiler",
    )
}

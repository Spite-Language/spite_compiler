var operation: LowIntermediaryRepresentation.Vector.Operation = 'copy'
var target = -1
var left = -1
var right = -1
var format: LowIntermediaryRepresentation.Vector.Format = 'whole_32'
var from_format: LowIntermediaryRepresentation.Vector.Format = 'whole_32'
var arithmetic: LowIntermediaryRepresentation.ArithmeticOperator = 'add'
var comparison: LowIntermediaryRepresentation.Comparison = 'equal'
var width: LowIntermediaryRepresentation.Width = 'bits_32'
var base = -1
var offset = 0
var is_signed = true
var source = -1
var number: Long = 0

func Step(starting_operation: LowIntermediaryRepresentation.Vector.Operation, starting_target: Integer) {
    operation = starting_operation
    target = starting_target
}

enum Operation {
    'load'
    'store'
    'broadcast'
    'zero'
    'decimal'
    'whole'
    'compare'
    'decimal_compare'
    'convert'
    'widen'
    'narrow'
    'absolute'
    'copy'
}

enum Format {
    'float'
    'double'
    'whole_32'
    'whole_64'
}

# ../../OPTIMIZATIONS.md#a-counted-loop-over-numbers-runs-eight-at-a-time
var operation: Operation = 'copy'
var target = -1
var left = -1
var right = -1
var format: Format = 'whole_32'
var from_format: Format = 'whole_32'
var arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator = 'add'
var comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison = 'equal'
var width: LowIntermediaryRepresentation.Instructions.Load.Width = 'bits_32'
var base = -1
var offset = 0
var is_signed = true
var source = -1
var number: Long = 0

func Step(starting_operation: Operation, starting_target: Integer) {
    operation = starting_operation
    target = starting_target
}

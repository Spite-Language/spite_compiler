func is_selected(key: String): Boolean {
    return selects_every_function or selected_keys.contains(key)
}

# ../HOT_RELOAD.md#the-manifest
func name_state(label: Integer, name: String) {
    if hot_reload {
        state_names[label] = name
    }
}

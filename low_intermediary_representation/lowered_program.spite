func is_selected(key: String): Boolean {
    return selects_every_function or selected_keys.contains(key)
}

# ../OPTIMIZATIONS.md#a-text-literal-is-made-once-in-the-programs-data
func note_a_pointer(label: Integer, place: Integer, target: Integer) {
    note_a_pointer_to(label, place, label, target)
}

# ../OPTIMIZATIONS.md#a-class-object-is-static-data
func note_a_pointer_to(label: Integer, place: Integer, target_label: Integer, target: Integer) {
    pointer_labels.append(label)
    pointer_places.append(place)
    pointer_target_labels.append(target_label)
    pointer_targets.append(target)
}

# ../HOT_RELOAD.md#the-manifest
func name_state(label: Integer, name: String) {
    if hot_reload {
        state_names[label] = name
    }
}

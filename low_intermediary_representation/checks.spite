# ../ARCHITECTURE.md#a-checked-operation-is-two-instructions

func check_after(
    instructions: List<SpiteCompiler.Instruction>,
    index: Integer,
): LowIntermediaryRepresentation.Instructions.Check? {
    var following = index + 1
    fallback following < instructions.count()
    var instruction = instructions[following]
    if instruction.class == LowIntermediaryRepresentation.Instructions.Check {
        return instruction
    }
    return null
}

func is_checked_at(instructions: List<SpiteCompiler.Instruction>, index: Integer): Boolean {
    var check = check_after(instructions, index)
    if check {
        return true
    }
    return false
}

func end_of(instructions: List<SpiteCompiler.Instruction>, index: Integer): Integer {
    if is_checked_at(instructions, index) {
        return index + 2
    }
    return index + 1
}

func is_a_check(instruction: SpiteCompiler.Instruction): Boolean {
    return instruction.class == LowIntermediaryRepresentation.Instructions.Check
}

# ../ARCHITECTURE.md#a-checked-operation-is-two-instructions
func operation_count(instructions: List<SpiteCompiler.Instruction>): Integer {
    var count = 0
    var index = 0
    while index < instructions.count() {
        var instruction = instructions[index]
        if not is_a_check(instruction) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

# ../PROOFS.md#a-counted-loop-reads-its-items-unchecked
var decided_blocks = List<Integer>()
var decided_indexes = List<Integer>()
var decided_answers = List<Long>()
var proven_branches = List<Integer>()

func decide(block_index: Integer, at: Integer, answer: Long) {
    decided_blocks.append(block_index)
    decided_indexes.append(at)
    decided_answers.append(answer)
}

func is_decided(block_index: Integer, at: Integer): Boolean {
    var index = 0
    while index < decided_blocks.count() {
        if decided_blocks[index] == block_index and decided_indexes[index] == at {
            return true
        }
        index = index + 1
    }
    return false
}

func is_proven(block_index: Integer): Boolean {
    return proven_branches.contains(block_index)
}

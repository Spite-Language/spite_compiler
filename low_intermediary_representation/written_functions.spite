var written = Dictionary<String, Boolean>()

func crash_on_an_unwritten_call(program: LoweredProgram) {
    program.lowered_functions.each(note_a_written)
    program.lowered_functions.each(look_at_the_calls_of)
    if program.gates_crashes {
        crash_unless_written("_crash_gate")
    }
}

func note_a_written(function: LowFunction) {
    written[function.key] = true
}

func look_at_the_calls_of(function: LowFunction) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
                crash_unless_written(instruction.function)
            } else if instruction.class == LowIntermediaryRepresentation.Instructions.FunctionAddress {
                crash_unless_written(instruction.function)
            } else if instruction.class == LowIntermediaryRepresentation.Instructions.StartThread {
                crash_unless_written(instruction.entry)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func crash_unless_written(key: String) {
    var calls_a_written_function = written[key] == true
    crash calls_a_written_function
}

var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var counts_memory = false

func LowIntermediaryRepresentation(starting_high: HighIntermediaryRepresentation.HighProgram, starting_counts_memory: Boolean) {
    high = starting_high
    counts_memory = starting_counts_memory
}

func run(): LoweredProgram {
    var lowering = LowIntermediaryRepresentation.Lowering.Lowering(high)
    lowering.counts_memory = counts_memory
    return lowering.lowered()
}

var held_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var entry = ""

func LowProgram(starting_functions: List<LowIntermediaryRepresentation.Functions.LowFunction>, starting_entry: String) {
    held_functions = starting_functions
    entry = starting_entry
}

func function_named(wanted: String): LowIntermediaryRepresentation.Functions.LowFunction? {
    return held_functions.find_by_name(wanted)
}

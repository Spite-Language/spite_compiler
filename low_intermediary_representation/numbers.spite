# ../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing

var _byte_mask: Long = 255
var _largest_long: Long = 9223372036854775807

func size_of_width(width: Instructions.Load.Width): Integer {
    switch width {
        'bits_8': return 1
        'bits_16': return 2
        'bits_32': return 4
        'bits_64': return 8
    }
}

func extended(value: Long, size: Integer, is_signed: Boolean): Long {
    if size >= 8 {
        return value
    }
    var one: Long = 1
    var span = one.shifted_left(8 * size)
    var low = value.bits_and(span - 1)
    var half = one.shifted_left(8 * size - 1)
    if is_signed and low >= half {
        return low - span
    }
    return low
}

func swapped(value: Long, size: Integer): Long {
    var result: Long = 0
    var index = 0
    while index < size {
        var moved = value.shifted_right(8 * index)
        var read = moved.bits_and(_byte_mask)
        var placed = read.shifted_left(8 * (size - 1 - index))
        result = result.bits_or(placed)
        index = index + 1
    }
    return result
}

func byte_of(value: Long, index: Integer): Long {
    var moved = value.shifted_right(8 * index)
    return moved.bits_and(_byte_mask)
}

func unsigned_less(left: Long, right: Long): Boolean {
    var left_negative = left < 0
    var right_negative = right < 0
    if left_negative != right_negative {
        return right_negative
    }
    return left < right
}

func compared(comparison: Instructions.Compare.Comparison, left: Long, right: Long, is_signed: Boolean): Boolean {
    var less = left < right
    if not is_signed {
        less = unsigned_less(left, right)
    }
    switch comparison {
        'equal': return left == right
        'not_equal': return left != right
        'less': return less
        'less_or_equal': return less or left == right
        'greater': return not less and left != right
        'greater_or_equal': return not less
    }
}

func shifted_right_of(value: Long, count: Integer, is_signed: Boolean): Long {
    var moved = value.shifted_right(count)
    if is_signed or count == 0 or value >= 0 {
        return moved
    }
    var largest: Long = _largest_long
    var mask = largest.shifted_right(count - 1)
    return moved.bits_and(mask)
}

func wrapped(operator: Instructions.Arithmetic.Operator, left: Long, right: Long): Long? {
    switch operator {
        'add': return left.wrapping_sum(right)
        'subtract': return left.wrapping_subtract(right)
        'multiply': return left.wrapping_multiply(right)
        'bits_and': return left.bits_and(right)
        'bits_or': return left.bits_or(right)
        'bits_xor': return left.bits_exclusive_or(right)
        'shift_left': return null
        'shift_right': return null
        'divide': return null
        'remainder': return null
        'square_root': return null
    }
}

func shifted(operation: Instructions.Arithmetic, left: Long, right: Long): Long {
    var size = size_of_width(operation.width)
    var masked = right.bits_and(63)
    var count: Integer? = masked
    crash count
    var result = left.shifted_left(count)
    if operation.operator == 'shift_right' {
        result = shifted_right_of(left, count, operation.is_signed)
    }
    return extended(result, size, operation.is_signed)
}

func unchecked(operation: Instructions.Arithmetic, left: Long, right: Long): Long? {
    var operator = operation.operator
    if operator == 'shift_left' or operator == 'shift_right' {
        return shifted(operation, left, right)
    }
    var result = wrapped(operator, left, right)
    fallback result
    var size = size_of_width(operation.width)
    return extended(result, size, operation.is_signed)
}

func loaded(width: Instructions.Load.Width, is_signed: Boolean, is_swapped: Boolean, little: Long): Long {
    var size = size_of_width(width)
    var value = little
    if is_swapped {
        value = swapped(value, size)
    }
    return extended(value, size, is_signed)
}

func stored(width: Instructions.Load.Width, is_swapped: Boolean, value: Long): Long {
    var size = size_of_width(width)
    if is_swapped {
        return swapped(value, size)
    }
    return value
}

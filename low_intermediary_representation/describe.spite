var lines = List<String>()
var total = 0
var empty_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var program = LowIntermediaryRepresentation.Programs.LowProgram(empty_functions, "")

func Describe(starting_program: LowIntermediaryRepresentation.Programs.LowProgram) {
    program = starting_program
}

func text(): String {
    lines = List<String>()
    lines.append("program, entry {program.entry}")
    program.held_functions.each(describe_function)
    return lines.join("\n")
}

func describe_function(own: LowIntermediaryRepresentation.Functions.LowFunction) {
    var heading = "{own.name}: {own.slots} slots, {own.instructions.count()} instructions"
    lines.append(heading)
    own.instructions.each(describe_instruction)
}

func describe_instruction(own: LowIntermediaryRepresentation.Instructions.Instruction) {
    var line = "  {written(own)}"
    lines.append(line)
}

func written(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    switch own.kind {
        "number": return number_line(own)
        "read": return "r{own.second} = p{own.first}"
        "write": return "p{own.first} = r{own.second}"
        "operation": return operation_line(own)
        "jump": return "jump to {own.to}"
        "jump_if_false": return conditional_line(own)
        "call": return call_line(own)
        "copy": return "r{own.second} = r{own.first}"
        "object_address": return "r{own.second} = &p{own.first}"
        "read_attribute": return "r{own.third} = p{own.first}[{own.second}]"
        "write_attribute": return "p{own.first}[{own.second}] = r{own.third}"
        "buffer_read": return "r{own.third} = byte at r{own.first} + r{own.second}"
        "buffer_write": return "byte at r{own.first} + r{own.second} = r{own.third}"
        "attribute_address": return "r{own.third} = &r{own.first}[{own.second}]"
        "place_address": return "r{own.second} = &p{own.first}"
        "foreign_call": return foreign_line(own)
        "return": return return_line(own)
        "crash": return "the program stops: {own.text}"
        _: return "return r{own.first}"
    }
}

func foreign_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    var given = own.places.join(", ")
    return "r{own.first} = {own.text}({given})"
}

func return_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    if own.first >= 0 {
        return "return r{own.first}"
    } else {
        return "return"
    }
}

func number_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    return "r{own.first} = {own.text}"
}

func operation_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    return "r{own.third} = r{own.first} {own.text} r{own.second}"
}

func conditional_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    return "jump to {own.to} when r{own.first} is false"
}

func call_line(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    var given = own.places.join(", ")
    return "r{own.first} = {called_name(own)}({given})"
}

func called_name(own: LowIntermediaryRepresentation.Instructions.Instruction): String {
    if own.owner.is_empty() {
        return own.callee
    } else {
        return "{own.owner}.{own.callee}"
    }
}

func instruction_count(): Integer {
    total = 0
    program.held_functions.each(count_function)
    return total
}

func count_function(own: LowIntermediaryRepresentation.Functions.LowFunction) {
    total = total + own.instructions.count()
}

var library = Validators.LibraryFile()

func frame_line(place: String, line: Integer): String {
    var tab = first_tab(place)
    fallback tab > 0
    var length = place.length()
    var head = place.slice(0, tab)
    crash head
    var rest = place.slice(tab, length)
    crash rest
    var colon = last_colon(head)
    fallback colon > 0
    var path = head.slice(0, colon)
    crash path
    fallback not library.holds(path)
    if line <= 0 {
        return place
    }
    return "{path}:{line}{rest}"
}

func first_tab(text: String): Integer {
    var index = 0
    while index < text.length() and text.byte_at(index) != 9 {
        index = index + 1
    }
    return index
}

func last_colon(text: String): Integer {
    var index = text.length() - 1
    while index >= 0 and text.byte_at(index) != 58 {
        index = index - 1
    }
    return index
}

func add_every(frames: List<String>, added: List<String>) {
    var index = 0
    while index < added.count() {
        var frame = added[index]
        frames.append(frame)
        index = index + 1
    }
}

var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)
var watched_offset = 32
var event_offset = 40
var main_thread_offset = 48
var stop_offset = 56

# ../../../spite_spec/specs/repl.md#--repl-portport
func PromptWaits(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func write_the_watch() {
    machine.begin("_prompt_watch", 1)
    var name_text = "ws2_32.dll"
    var name_bytes = name_text.to_bytes()
    name_bytes.append(0)
    var name_label = machine.writing.data_label(name_bytes)
    var name = machine.data_at(name_label)
    var library = machine.writing.new_register()
    var opened = LowIntermediaryRepresentation.Instructions.OpenLibrary(library, name)
    machine.writing.emit(opened)
    var poll = machine.writing.new_register()
    var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(poll, library, "WSAPoll")
    machine.writing.emit(found)
    var waited = machine.room(16)
    var objects = machine.data_at(lowering.program.prompt_objects_label)
    var flag = machine.data_at(lowering.program.prompt_flag_label)
    var one = machine.constant_of(1)
    var resting = machine.one_listed(one)
    var top = machine.loop_top()
    var stopping = machine.loaded(objects, 16)
    var goes_on = machine.is_zero(stopping)
    var done = machine.loop_while(goes_on)
    var flag_value = machine.loaded(flag, 0)
    var is_raised = machine.compared_to('not_equal', flag_value, 0)
    var taken = machine.opened_when(is_raised)
    machine.imported("Sleep", resting)
    machine.closed(taken)
    var flag_down = machine.opened_unless(is_raised)
    var handle = machine.loaded(objects, watched_offset)
    var has_none = machine.is_zero(handle)
    var nothing_to_watch = machine.opened_when(has_none)
    machine.imported("Sleep", resting)
    machine.closed(nothing_to_watch)
    var watching = machine.opened_unless(has_none)
    machine.stored(waited, 0, handle)
    machine.stored_number(waited, 8, 256)
    var count = machine.constant_of(1)
    var timeout = machine.constant_of(100)
    var polling = machine.three_listed(waited, count, timeout)
    var answer = machine.writing.new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(answer, poll, polling)
    called.answers_32_bits = true
    machine.writing.emit(called)
    var events = machine.loaded(waited, 8)
    var is_ready = machine.compared_to('greater', events, 65535)
    var ready = machine.opened_when(is_ready)
    machine.stored_number(flag, 0, 1)
    var event = machine.loaded(objects, event_offset)
    var waking = machine.one_listed(event)
    machine.imported("SetEvent", waking)
    machine.closed(ready)
    var failed = machine.compared_to('less', answer, 0)
    var went_wrong = machine.opened_when(failed)
    machine.imported("Sleep", resting)
    machine.closed(went_wrong)
    machine.closed(watching)
    machine.closed(flag_down)
    machine.loop_back(top, done)
    var nothing = machine.constant_of(0)
    machine.answered(nothing)
    machine.finish()
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func write_the_sleep() {
    machine.begin("_prompt_sleep", 1)
    var objects = machine.data_at(lowering.program.prompt_objects_label)
    var flag = machine.data_at(lowering.program.prompt_flag_label)
    var nothing = machine.constant_of(0)
    var sleeping = machine.one_listed(0)
    var not_positive = machine.compared_to('less_or_equal', 0, 0)
    var positive = machine.opened_when(not_positive)
    machine.imported("Sleep", sleeping)
    machine.answered_nothing()
    machine.closed(positive)
    var main_thread = machine.loaded(objects, main_thread_offset)
    var thread = machine.thread_now()
    var is_main = machine.compared('equal', thread, main_thread)
    var elsewhere = machine.opened_unless(is_main)
    machine.imported("Sleep", sleeping)
    machine.answered_nothing()
    machine.closed(elsewhere)
    var high_resolution = machine.constant_of(2)
    var every_right = machine.constant_of(2031619)
    var making = machine.three_listed(nothing, nothing, high_resolution)
    making.append(every_right)
    var timer = machine.imported("CreateWaitableTimerExW", making)
    var has_no_timer = machine.is_zero(timer)
    var has_a_timer = machine.opened_when(has_no_timer)
    machine.imported("Sleep", sleeping)
    machine.answered_nothing()
    machine.closed(has_a_timer)
    var due = machine.room(8)
    var ticks_per_millisecond = machine.constant_of(-10000)
    var relative = machine.product_of(0, ticks_per_millisecond)
    machine.stored(due, 0, relative)
    var setting = machine.three_listed(timer, due, nothing)
    setting.append(nothing)
    setting.append(nothing)
    setting.append(nothing)
    var was_set = machine.imported("SetWaitableTimer", setting)
    var failed = machine.is_zero(was_set)
    var set_badly = machine.opened_when(failed)
    machine.imported("Sleep", sleeping)
    var closing_early = machine.one_listed(timer)
    machine.imported("CloseHandle", closing_early)
    machine.answered_nothing()
    machine.closed(set_badly)
    var handles = machine.room(16)
    machine.stored(handles, 0, timer)
    var event = machine.loaded(objects, event_offset)
    machine.stored(handles, 8, event)
    var two = machine.constant_of(2)
    var forever = machine.constant_of(-1)
    var top = machine.loop_top()
    var waiting = machine.three_listed(two, handles, nothing)
    waiting.append(forever)
    var woken = machine.imported("WaitForMultipleObjects", waiting)
    var by_the_prompt = machine.compared_to('equal', woken, 1)
    var done = machine.loop_while(by_the_prompt)
    machine.stored(flag, 0, nothing)
    var prompt_object = machine.loaded(objects, 0)
    var entry_object = machine.loaded(objects, 8)
    var serving = machine.two_listed(prompt_object, entry_object)
    machine.called_for_nothing(lowering.program.prompt_check_point, serving)
    machine.loop_back(top, done)
    var by_the_timer = machine.compared_to('equal', woken, 0)
    var went_wrong = machine.opened_unless(by_the_timer)
    machine.halted("spite: the program stopped: the system's timer could not be waited for (WaitForMultipleObjects failed)\n")
    machine.closed(went_wrong)
    var closing = machine.one_listed(timer)
    machine.imported("CloseHandle", closing)
    machine.answered_nothing()
    machine.finish()
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func watched(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var value = call.arguments[0]
    crash value
    var handle = lowering.lower_value(value)
    var objects = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(objects, lowering.program.prompt_objects_label)
    lowering.emit(addressed)
    var stored = LowIntermediaryRepresentation.Instructions.Store(objects, watched_offset, handle.value, 'bits_64')
    stored.region = "prompt.watched"
    lowering.emit(stored)
    return Lowered(-1, -1)
}

func raised(): Lowered {
    var flag = lowering.new_register()
    var flag_address = LowIntermediaryRepresentation.Instructions.DataAddress(flag, lowering.program.prompt_flag_label)
    lowering.emit(flag_address)
    var one = lowering.constant(1)
    var stored = LowIntermediaryRepresentation.Instructions.Store(flag, 0, one, 'bits_64')
    stored.region = "prompt.flag"
    lowering.emit(stored)
    var objects = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(objects, lowering.program.prompt_objects_label)
    lowering.emit(addressed)
    var event = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(event, objects, event_offset, 'bits_64')
    lowering.emit(loaded)
    var arguments = List<Integer>()
    arguments.append(event)
    var woken = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "SetEvent", arguments)
    lowering.emit(woken)
    return Lowered(-1, -1)
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func start(lowering_at_start: FunctionLowering) {
    var objects = lowering_at_start.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(objects, lowering.program.prompt_objects_label)
    lowering_at_start.emit(addressed)
    var nothing = lowering_at_start.constant(0)
    var making = List<Integer>()
    making.append(nothing)
    making.append(nothing)
    making.append(nothing)
    making.append(nothing)
    var event = lowering_at_start.new_register()
    var made = LowIntermediaryRepresentation.Instructions.ImportCall(event, "CreateEventA", making)
    lowering_at_start.emit(made)
    var kept_event = LowIntermediaryRepresentation.Instructions.Store(objects, event_offset, event, 'bits_64')
    lowering_at_start.emit(kept_event)
    var thread = lowering_at_start.new_register()
    var identified = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    lowering_at_start.emit(identified)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(objects, main_thread_offset, thread, 'bits_64')
    lowering_at_start.emit(kept_thread)
    write_the_watch()
    write_the_sleep()
    var no_block = lowering_at_start.constant(0)
    var watcher = lowering_at_start.new_register()
    var started = LowIntermediaryRepresentation.Instructions.StartThread(watcher, "_prompt_watch", no_block)
    lowering_at_start.emit(started)
}

# ../../../spite_spec/specs/repl.md#command-language
func objects_here(): Integer {
    var objects = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(objects, lowering.program.prompt_objects_label)
    lowering.emit(addressed)
    return objects
}

func this_thread(): Integer {
    var thread = lowering.new_register()
    var identified = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    lowering.emit(identified)
    return thread
}

func claimed_stop(): Lowered {
    var objects = objects_here()
    var thread = this_thread()
    var free = lowering.constant(0)
    var before = lowering.new_register()
    var exchanged = LowIntermediaryRepresentation.Instructions.CompareExchange(before, objects, stop_offset, free, thread)
    lowering.emit(exchanged)
    var won = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, free)
    lowering.emit(compared)
    return lowering.single(won)
}

func released_stop(): Lowered {
    var objects = objects_here()
    var free = lowering.constant(0)
    var stored = LowIntermediaryRepresentation.Instructions.Store(objects, stop_offset, free, 'bits_64')
    stored.region = "prompt.stop"
    lowering.emit(stored)
    return Lowered(-1, -1)
}

func stop_holder(): Integer {
    var objects = objects_here()
    var holder = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(holder, objects, stop_offset, 'bits_64')
    loaded.region = "prompt.stop"
    lowering.emit(loaded)
    return holder
}

func stop_held_here(): Lowered {
    var holder = stop_holder()
    var thread = this_thread()
    var is_mine = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_mine, 'equal', holder, thread)
    lowering.emit(compared)
    return lowering.single(is_mine)
}

func stop_held_elsewhere(): Lowered {
    var holder = stop_holder()
    var thread = this_thread()
    var free = lowering.constant(0)
    var is_held = lowering.new_register()
    var held = LowIntermediaryRepresentation.Instructions.Compare(is_held, 'not_equal', holder, free)
    lowering.emit(held)
    var is_other = lowering.new_register()
    var other = LowIntermediaryRepresentation.Instructions.Compare(is_other, 'not_equal', holder, thread)
    lowering.emit(other)
    var both = lowering.new_register()
    var joined = LowIntermediaryRepresentation.Instructions.Arithmetic(both, 'bits_and', is_held, is_other)
    joined.is_checked = false
    lowering.emit(joined)
    return lowering.single(both)
}

func on_the_main_thread(): Lowered {
    var objects = objects_here()
    var main_thread = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(main_thread, objects, main_thread_offset, 'bits_64')
    lowering.emit(loaded)
    var thread = this_thread()
    var is_main = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_main, 'equal', main_thread, thread)
    lowering.emit(compared)
    return lowering.single(is_main)
}

func keep_the_main_thread(lowering_at_start: FunctionLowering, objects: Integer) {
    var thread = lowering_at_start.new_register()
    var identified = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    lowering_at_start.emit(identified)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(objects, main_thread_offset, thread, 'bits_64')
    lowering_at_start.emit(kept_thread)
}

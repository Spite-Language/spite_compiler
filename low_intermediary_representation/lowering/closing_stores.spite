# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it

var _anything = "*"
var _function_value = "Spite.FunctionValue"
var no_program = Model.ProgramModel()
var model = Model.ProgramModel()
var layout = HighIntermediaryRepresentation.Layout(no_program)
var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var links = DeepLinks(no_high, layout, lowering)
var keys = List<String>()
var holds = Dictionary<String, List<String>>()
var held_by = Dictionary<String, List<String>>()
var components = Dictionary<String, Integer>()
var component_sizes = Dictionary<Integer, Integer>()
var receivers = List<String>()

func ClosingStores(starting_layout: HighIntermediaryRepresentation.Layout, starting_lowering: FunctionLowering) {
    layout = starting_layout
    model = starting_layout.program
    lowering = starting_lowering
    links = DeepLinks(no_high, starting_layout, starting_lowering)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func study(high: HighIntermediaryRepresentation.HighProgram): Dictionary<String, Integer> {
    note_the_receivers(high)
    if not receivers.is_empty() {
        var function_value_id = layout.class_id_of(_function_value)
        crash function_value_id >= 0
    }
    keys = every_class()
    keys.each(note_what_it_holds)
    holds[_anything] = keys
    note_who_holds(_anything)
    keys.each(note_who_holds)
    find_the_components()
    var capable = Dictionary<String, Integer>()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if closes_a_cycle(key) {
            var component = components[key]
            crash component
            capable[key] = component
        }
        index = index + 1
    }
    return capable
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func may_close(capable: Dictionary<String, Integer>, holder: String, value_type: Model.Type): Boolean {
    fallback capable.contains(holder)
    var component = capable[holder]
    crash component
    var reached = List<String>()
    add_the_classes_of(value_type, reached)
    var index = 0
    while index < reached.count() {
        var key = reached[index]
        if key == _anything {
            return true
        }
        if capable.contains(key) and capable[key] == component {
            return true
        }
        index = index + 1
    }
    return false
}

func reaches_a_capable(capable: Dictionary<String, Integer>, of_type: Model.Type): Boolean {
    var reached = List<String>()
    add_the_classes_of(of_type, reached)
    var index = 0
    while index < reached.count() {
        var key = reached[index]
        if key == _anything or capable.contains(key) {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_receivers(high: HighIntermediaryRepresentation.HighProgram) {
    if not high.assignments {
        receivers.append(_anything)
        return
    }
    var index = 0
    while index < high.assignments.taken_as_values.count() {
        var key = high.assignments.taken_as_values[index]
        var parts = key.split(".")
        var last = parts.count() - 1
        parts.remove_at(last)
        var owner = parts.join(".")
        if is_known(owner) and not receivers.contains(owner) {
            receivers.append(owner)
        }
        index = index + 1
    }
}

func is_a_node(key: String): Boolean {
    fallback is_known(key) and not lowering.state.scalars.of(key)
    fallback not key.starts_with("Spite.Work_of_")
    if key == _function_value {
        return true
    }
    fallback not key.starts_with("Spite.FunctionValue")
    fallback key != "String" and key != "Buffer" and key != "Spite.SymbolBox"
    var class_model = model.class_named(key)
    fallback class_model
    return not class_model.is_singleton
}

func note_what_it_holds(key: String) {
    var reached = List<String>()
    holds[key] = reached
    fallback is_a_node(key)
    if key == _function_value {
        receivers.each(add_a_receiver)
        return
    }
    var class_model = model.class_named(key)
    crash class_model
    fallback not holds_its_links_back(class_model)
    var element = class_model.bound_types["$element_type"]
    if element and links.releases_its_items(class_model) {
        add_the_classes_of(element, reached)
    }
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        if links.releases_an_attribute(attribute) and not attribute.name.contains("$") {
            add_the_classes_of(attribute.attribute_type, reached)
        }
        index = index + 1
    }
}

func add_a_receiver(receiver: String) {
    var reached = holds[_function_value]
    crash reached
    if receiver == _anything or is_a_node(receiver) {
        add_once(receiver, reached)
    }
}

func note_who_holds(key: String) {
    var reached = holds[key]
    crash reached
    var index = 0
    while index < reached.count() {
        var target = reached[index]
        if not held_by.contains(target) {
            var none_yet = List<String>()
            held_by[target] = none_yet
        }
        var holders = held_by[target]
        crash holders
        holders.append(key)
        index = index + 1
    }
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func add_the_classes_of(of_type: Model.Type, reached: List<String>) {
    var kind = of_type.kind
    fallback kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
    if kind == 'function' and layout.class_ids.contains(_function_value) {
        add_once(_function_value, reached)
        return
    }
    fallback kind != 'function'
    if kind == 'union' {
        add_the_members(of_type, reached)
        return
    }
    if kind == 'shape' {
        add_the_fitting_classes(of_type, reached)
        return
    }
    if not of_type.is_a_walked_name and is_known(of_type.name) {
        if is_a_node(of_type.name) {
            add_once(of_type.name, reached)
        }
        return
    }
    add_once(_anything, reached)
}

func add_the_members(of_type: Model.Type, reached: List<String>) {
    var parts = of_type.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = model.class_named(owner_key)
    var declared_union: Model.UnionModel? = null
    if owner {
        declared_union = owner.union_named(simple)
    }
    if not declared_union {
        add_once(_anything, reached)
        return
    }
    var index = 0
    while index < declared_union.members.count() {
        var member = declared_union.members[index]
        add_the_classes_of(member, reached)
        index = index + 1
    }
}

func add_the_fitting_classes(of_type: Model.Type, reached: List<String>) {
    var shape = model.shape_keyed(of_type.name)
    if not shape {
        add_once(_anything, reached)
        return
    }
    if keys.is_empty() {
        keys = every_class()
    }
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if is_a_node(key) and fits(shape, key) {
            add_once(key, reached)
        }
        index = index + 1
    }
}

func fits(shape: Model.ShapeModel, key: String): Boolean {
    var class_model = model.class_named(key)
    fallback class_model
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        var is_an_attribute = class_model.attribute_named(member.name)
        var is_a_function = class_model.function_named(member.name)
        fallback is_an_attribute or is_a_function
        index = index + 1
    }
    return true
}

func add_once(key: String, reached: List<String>) {
    if not reached.contains(key) {
        reached.append(key)
    }
}

func closes_a_cycle(key: String): Boolean {
    fallback is_a_node(key) and components.contains(key)
    var component = components[key]
    crash component
    var size = component_sizes[component]
    crash size
    if size > 1 {
        return true
    }
    var reached = holds[key]
    crash reached
    return reached.contains(key)
}

func find_the_components() {
    var visited = Dictionary<String, Boolean>()
    var finished = List<String>()
    finish_from(_anything, visited, finished)
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        finish_from(key, visited, finished)
        index = index + 1
    }
    var component = 0
    index = finished.count() - 1
    while index >= 0 {
        var key = finished[index]
        crash key
        if not components.contains(key) {
            gather_the_component(key, component)
            component = component + 1
        }
        index = index - 1
    }
}

func finish_from(start: String, visited: Dictionary<String, Boolean>, finished: List<String>) {
    fallback visited[start] != true
    visited[start] = true
    var path = List<String>()
    var next_links = List<Integer>()
    path.append(start)
    next_links.append(0)
    while not path.is_empty() {
        var last = path.count() - 1
        var key = path[last]
        var position = next_links[last]
        crash key
        crash position
        var reached = held_from(key)
        if position < reached.count() {
            next_links[last] = position + 1
            var target = reached[position]
            if visited[target] != true {
                visited[target] = true
                path.append(target)
                next_links.append(0)
            }
        } else {
            finished.append(key)
            path.remove_at(last)
            next_links.remove_at(last)
        }
    }
}

func gather_the_component(start: String, component: Integer) {
    components[start] = component
    var size = 1
    var waiting = List<String>()
    waiting.append(start)
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        var holders = held_by[key]
        if holders {
            var index = 0
            while index < holders.count() {
                var holder = holders[index]
                if not components.contains(holder) {
                    components[holder] = component
                    size = size + 1
                    waiting.append(holder)
                }
                index = index + 1
            }
        }
    }
    component_sizes[component] = size
}

func held_from(key: String): List<String> {
    var reached = holds[key]
    if reached {
        return reached
    }
    return List<String>()
}

# ../../../spite_documentation/memory.md#cycles-are-freed
func holds_its_links_back(class_model: Model.ClassModel): Boolean {
    var holding_back = class_model.function_named("_held_back")
    if holding_back {
        return true
    }
    return false
}

func is_known(key: String): Boolean {
    if layout.class_ids.contains(key) {
        return true
    }
    var class_model = model.class_named(key)
    if class_model {
        return true
    }
    return false
}

func every_class(): List<String> {
    var found = layout.class_ids.keys()
    var listed = Dictionary<String, Boolean>()
    var index = 0
    while index < found.count() {
        var listed_key = found[index]
        listed[listed_key] = true
        index = index + 1
    }
    index = 0
    while index < model.order.count() {
        var class_model = model.order[index]
        if listed[class_model.key] != true {
            listed[class_model.key] = true
            found.append(class_model.key)
        }
        index = index + 1
    }
    return found
}

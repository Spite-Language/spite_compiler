# ../../../spite_spec/specs/repl.md#command-language
var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var prompt_key = "ReadEvaluatePrintLoop"

func PromptIntrinsics(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func is_one(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if call.function.owner != prompt_key {
        return false
    }
    return lowering.program.prompt_intrinsics.contains(call.function.name)
}

func lowered(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var described = lowering.program.prompt_intrinsics[call.function.name]
    crash described
    var parts = described.split("\t")
    var kind = parts[0]
    crash kind
    switch kind {
        "made": return made(parts)
        "address": return address(call)
        "size": return size(parts)
        "offset": return offset(parts)
        "width": return width(parts)
        "storage": return storage(call, parts)
        "watch": return watched(call)
        "raise": return raised()
        _: return item_size(parts)
    }
}

func watched(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var waits = PromptWaits(lowering)
    return waits.watched(call)
}

func raised(): Lowered {
    var waits = PromptWaits(lowering)
    return waits.raised()
}

func part(parts: List<String>, index: Integer): String {
    var found = parts[index]
    crash found
    return found
}

func made(parts: List<String>): Lowered {
    var class_key = part(parts, 1)
    var slot_key = part(parts, 2)
    if lowering.program.static_singletons.contains(class_key) {
        var static_object = lowering.static_object_of(class_key)
        return lowering.single(static_object)
    }
    if class_key == "Build" {
        return made_settings(class_key)
    }
    var label = lowering.slot_label_of(slot_key)
    var slot = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    lowering.emit(addressed)
    var object = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    lowering.emit(loaded)
    return lowering.single(object)
}

func made_settings(class_key: String): Lowered {
    var model = lowering.layout.program.class_named(class_key)
    crash model
    var settings_type = model.type_of_an_instance()
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var making = HighIntermediaryRepresentation.Values.MakeObject(settings_type, null, no_arguments)
    var object = lowering.singleton_of(class_key, making)
    return lowering.single(object)
}

func address(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var value = call.arguments[0]
    crash value
    var lowered_value = lowering.lower_value(value)
    return lowering.single(lowered_value.value)
}

func size(parts: List<String>): Lowered {
    var class_key = part(parts, 1)
    var bytes = lowering.layout.made_size_of(class_key)
    var made_constant = lowering.constant(bytes)
    return lowering.single(made_constant)
}

func attribute_of(parts: List<String>): Model.AttributeModel {
    var class_key = part(parts, 1)
    var name = part(parts, 2)
    var model = lowering.layout.program.class_named(class_key)
    crash model
    var attribute = model.attribute_named(name)
    crash attribute
    return attribute
}

func offset(parts: List<String>): Lowered {
    var attribute = attribute_of(parts)
    var placed = -1
    if lowering.layout.has_a_slot(attribute) {
        placed = lowering.layout.offset_of(attribute)
    }
    var made_constant = lowering.constant(placed)
    return lowering.single(made_constant)
}

func width(parts: List<String>): Lowered {
    var attribute = attribute_of(parts)
    var bytes = lowering.layout.width_in_bytes(attribute.attribute_type)
    var made_constant = lowering.constant(bytes)
    return lowering.single(made_constant)
}

func storage(call: HighIntermediaryRepresentation.Values.Call, parts: List<String>): Lowered {
    var class_key = part(parts, 1)
    var list = address(call)
    var owner = lowering.layout.program.class_named(class_key)
    crash owner
    var buffer_attribute = owner.attribute_named("_buffer")
    crash buffer_attribute
    var placed = lowering.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, list.value, placed, 'bits_64')
    loaded.region = "{owner.key}._buffer"
    lowering.emit(loaded)
    var stored = lowering.storage_of(buffer)
    return lowering.single(stored)
}

func item_size(parts: List<String>): Lowered {
    var class_key = part(parts, 1)
    var owner = lowering.layout.program.class_named(class_key)
    crash owner
    var element = owner.bound_types["$element_type"]
    crash element
    var intrinsics = Intrinsics(lowering)
    var bytes = intrinsics.slot_size_of(class_key, element)
    var made_constant = lowering.constant(bytes)
    return lowering.single(made_constant)
}

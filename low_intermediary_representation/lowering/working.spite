union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)

func Working(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func started(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    var is_parallel = conversion.value_type.name == "Parallel"
    if is_parallel {
        return started_in_parallel(conversion.converted, conversion.value_type.carrier)
    }
    return started_from(conversion.converted, conversion.value_type.carrier)
}

func started_in_parallel(work: Value?, carrier: String): Lowered {
    crash work
    if work == HighIntermediaryRepresentation.Values.Call {
        return started_on_a_thread(work, carrier)
    }
    return finished_at_once(work, carrier)
}

func started_on_a_thread(work: HighIntermediaryRepresentation.Values.Call, carrier: String): Lowered {
    var block = block_on_a_thread(work)
    var on_a_thread = lowering.constant(1)
    var running = running_of(block, on_a_thread)
    var made = handle_of(carrier, running)
    return lowering.owned(made)
}

func running_of(frame: Integer, on_a_thread: Integer): Integer {
    var arguments = List<Integer>()
    arguments.append(frame)
    arguments.append(on_a_thread)
    var running = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Call(running, "_scheduler_running", arguments)
    lowering.emit(made)
    return running
}

func handle_of(carrier: String, running: Integer): Integer {
    var size = lowering.constant(40)
    var made = lowering.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(made, size)
    var class_id = lowering.layout.class_id_of(carrier)
    allocated.class_id = class_id
    lowering.emit(allocated)
    var id_register = lowering.constant(class_id)
    store(made, 0, id_register)
    var one = lowering.constant(1)
    store(made, 8, one)
    store(made, 16, running)
    var zero = lowering.constant(0)
    store(made, 24, zero)
    store(made, 32, zero)
    return made
}

func store(address: Integer, offset: Integer, value: Integer) {
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, offset, value, 'bits_64')
    lowering.emit(stored)
}

func call_with(key: String, first_register: Integer) {
    var arguments = List<Integer>()
    arguments.append(first_register)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, key, arguments)
    lowering.emit(called)
}

func helped(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var block = block_on_a_thread(call)
    if lowering.resumable_mode {
        var point = lowering.resume_point()
        var done = lowering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(done, block, 8, 'bits_64')
        lowering.emit(loaded)
        var waiting = lowering.new_block()
        var after = lowering.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(done, after, waiting)
        lowering.emit(test)
        lowering.switch_to(waiting)
        var soon = ticks()
        var one = lowering.constant(1)
        var deadline = lowering.new_register()
        var added = LowIntermediaryRepresentation.Instructions.Arithmetic(deadline, 'add', soon, one)
        added.is_checked = false
        lowering.emit(added)
        call_with("_scheduler_note_deadline", deadline)
        lowering.suspend_at(point)
        lowering.switch_to(after)
    } else {
        call_with("_scheduler_wait_for_a_helper", block)
    }
    call_with("_pool_join", block)
    var answer = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        answer = lowering.new_register()
        var loaded_answer = LowIntermediaryRepresentation.Instructions.Load(answer, block, 16, 'bits_64')
        lowering.emit(loaded_answer)
    }
    if lowering.is_a_nullable_scalar(call.value_type) {
        presence = lowering.new_register()
        var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(presence, block, 24, 'bits_64')
        lowering.emit(loaded_presence)
    }
    var freed = LowIntermediaryRepresentation.Instructions.Free(block)
    lowering.emit(freed)
    var made = Lowered(answer, presence)
    made.owned = lowering.counts_an_answer(call.value_type)
    return made
}

func block_on_a_thread(work: HighIntermediaryRepresentation.Values.Call): Integer {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var registers = List<Integer>()
    var pointers = List<Boolean>()
    var receiver = lowering.lower_value(work.receiver)
    crash work.receiver
    lowering.release_later(receiver, work.receiver.value_type)
    registers.append(receiver.value)
    var receiver_is_a_pointer = lowering.is_a_pointer(work.receiver.value_type)
    pointers.append(receiver_is_a_pointer)
    var index = 0
    while index < work.arguments.count() {
        var argument = work.arguments[index]
        var lowered_argument = lowering.lower_value(argument)
        lowering.release_later(lowered_argument, argument.value_type)
        registers.append(lowered_argument.value)
        var argument_is_a_pointer = lowering.is_a_pointer(argument.value_type)
        pointers.append(argument_is_a_pointer)
        if lowered_argument.presence >= 0 {
            registers.append(lowered_argument.presence)
            pointers.append(false)
        }
        index = index + 1
    }
    var register_count = registers.count()
    var size = lowering.constant(40 + 8 * register_count)
    var block = lowering.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(block, size)
    allocated.zeroed_bytes = 40
    lowering.emit(allocated)
    var stored_index = 0
    while stored_index < registers.count() {
        var register = registers[stored_index]
        var is_a_pointer = pointers[stored_index] == true
        if is_a_pointer {
            lowering.retain(register)
        }
        var stored = LowIntermediaryRepresentation.Instructions.Store(block, 40 + 8 * stored_index, register, 'bits_64')
        lowering.emit(stored)
        stored_index = stored_index + 1
    }
    lowering.release_the_pending()
    lowering.pending_releases = outer
    var counts_tasks = counts_the_tasks()
    var entry = thread_entry(work, pointers, counts_tasks)
    if counts_tasks {
        lowering.count_a_task(1)
    }
    var address = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, entry)
    lowering.emit(found)
    var kept_entry = LowIntermediaryRepresentation.Instructions.Store(block, 0, address, 'bits_64')
    lowering.emit(kept_entry)
    lowering.program.uses_threads = true
    lowering.program.uses_the_pool = true
    call_with("_pool_submit", block)
    return block
}

func counts_the_tasks(): Boolean {
    if not lowering.waits {
        return false
    }
    return lowering.waits.locks_any() and lowering.waits.skips_locks_while_idle()
}

func thread_entry(
    work: HighIntermediaryRepresentation.Values.Call,
    pointers: List<Boolean>,
    counts_tasks: Boolean,
): String {
    var number = lowering.program.lowered_functions.count()
    var key = "_parallel_{number}"
    var entering = FunctionLowering(lowering.layout, lowering.program, lowering.singleton_slots)
    entering.start(key)
    var block = entering.new_register()
    entering.function.parameter_count = 1
    var arguments = List<Integer>()
    var index = 0
    while index < pointers.count() {
        var register = entering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(register, block, 40 + 8 * index, 'bits_64')
        entering.emit(loaded)
        arguments.append(register)
        index = index + 1
    }
    var answer = -1
    if not work.value_type.is_nothing() {
        answer = entering.new_register()
    }
    var function_key = work.function.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(answer, function_key, arguments)
    var presence = -1
    if entering.is_a_nullable_scalar(work.value_type) {
        presence = entering.new_register()
        called.presence = presence
    }
    entering.emit(called)
    if answer >= 0 {
        var stored_answer = LowIntermediaryRepresentation.Instructions.Store(block, 16, answer, 'bits_64')
        entering.emit(stored_answer)
    }
    if presence < 0 and answer >= 0 {
        presence = entering.constant(1)
    }
    if presence >= 0 {
        var stored_presence = LowIntermediaryRepresentation.Instructions.Store(block, 24, presence, 'bits_64')
        entering.emit(stored_presence)
    }
    var released = 0
    while released < pointers.count() {
        var is_a_pointer = pointers[released] == true
        var register = arguments[released]
        crash register
        if is_a_pointer {
            entering.release(register)
        }
        released = released + 1
    }
    if counts_tasks {
        entering.count_a_task(-1)
    }
    var zero = entering.constant(0)
    var returned = LowIntermediaryRepresentation.Instructions.Return(zero)
    entering.emit(returned)
    lowering.program.lowered_functions.append(entering.function)
    return key
}

func started_from(work: Value?, carrier: String): Lowered {
    crash work
    if work == HighIntermediaryRepresentation.Values.Call {
        return started_call(work, carrier)
    }
    if work == HighIntermediaryRepresentation.Values.ShapeCall {
        return started_through_a_shape(work, carrier)
    }
    return finished_at_once(work, carrier)
}

func started_through_a_shape(work: HighIntermediaryRepresentation.Values.ShapeCall, carrier: String): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var receiver = lowering.lower_value(work.receiver)
    crash work.receiver
    lowering.release_later(receiver, work.receiver.value_type)
    var class_id = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, receiver.value, 0, 'bits_64')
    lowering.emit(loaded)
    var made = lowering.new_register()
    var after = lowering.new_block()
    var fillers = lowering.layout.program.fillers_of(work.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var key = "{filler.name}.{work.member.name}"
        var wanted = lowering.layout.class_id_of(filler.name)
        var wanted_register = lowering.constant(wanted)
        var matches = lowering.new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
        lowering.emit(compared)
        var starting = lowering.new_block()
        var next = lowering.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, starting, next)
        lowering.emit(test)
        lowering.switch_to(starting)
        var handed = started_filler(key, receiver.value, carrier)
        var kept = LowIntermediaryRepresentation.Instructions.Copy(made, handed)
        lowering.emit(kept)
        lowering.jump_to(after)
        lowering.switch_to(next)
        index = index + 1
    }
    var stop_text = "spite: no class fills '{work.shape.name}' here, at {lowering.path}:{lowering.line}\n"
    var label = lowering.text_label(stop_text)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
    lowering.switch_to(after)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    return lowering.owned(made)
}

func started_filler(key: String, receiver: Integer, carrier: String): Integer {
    var arguments = List<Integer>()
    arguments.append(receiver)
    if lowering.is_resumable(key) {
        var frame = lowering.new_register()
        var made_frame = LowIntermediaryRepresentation.Instructions.Call(frame, "{key}$frame", arguments)
        lowering.emit(made_frame)
        return handed_frame(frame, carrier)
    }
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, key, arguments)
    lowering.emit(called)
    var no_running = lowering.constant(0)
    return handle_of(carrier, no_running)
}

func handed_frame(frame: Integer, carrier: String): Integer {
    var stepped_here = lowering.constant(0)
    var running = running_of(frame, stepped_here)
    call_with("_scheduler_start", running)
    return handle_of(carrier, running)
}

func started_call(work: HighIntermediaryRepresentation.Values.Call, carrier: String): Lowered {
    var key = work.function.key()
    if lowering.is_resumable(key) {
        return started_in_a_frame(work, carrier)
    }
    return finished_at_once(work, carrier)
}

func started_in_a_frame(work: HighIntermediaryRepresentation.Values.Call, carrier: String): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var arguments = lowering.lowered_call_arguments(work)
    var frame = lowering.new_register()
    var work_key = work.function.key()
    var made_frame = LowIntermediaryRepresentation.Instructions.Call(frame, "{work_key}$frame", arguments)
    lowering.emit(made_frame)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    var made = handed_frame(frame, carrier)
    return lowering.owned(made)
}

func finished_at_once(work: Value, carrier: String): Lowered {
    var value = lowering.lower_value(work)
    var no_running = lowering.constant(0)
    var made = handle_of(carrier, no_running)
    if not work.value_type.is_nothing() {
        store(made, 24, value.value)
        if value.presence >= 0 {
            store(made, 32, value.presence)
        } else {
            var present = lowering.constant(1)
            store(made, 32, present)
        }
        var keeps_a_reference = lowering.is_a_pointer(work.value_type) and not value.owned
        if keeps_a_reference {
            lowering.retain(value.value)
        }
    }
    return lowering.owned(made)
}

func joined(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    crash conversion.converted
    var handle = lowering.lower_value(conversion.converted)
    var carrier = conversion.converted.value_type.carrier
    if lowering.resumable_mode {
        wait_until_finished(handle.value, carrier)
    }
    var arguments = List<Integer>()
    arguments.append(handle.value)
    var model = lowering.layout.program.class_named(carrier)
    crash model
    var settled = model.function_named("_settled")
    crash settled
    crash settled.answer
    var answer = lowering.new_register()
    var settled_key = settled.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(answer, settled_key, arguments)
    var presence = -1
    if lowering.is_a_nullable_scalar(settled.answer) {
        presence = lowering.new_register()
        called.presence = presence
    }
    lowering.emit(called)
    if handle.owned {
        lowering.release(handle.value)
    }
    var kept_presence = -1
    if lowering.is_a_nullable_scalar(conversion.value_type) {
        kept_presence = presence
    }
    var made = Lowered(answer, kept_presence)
    made.owned = lowering.is_a_pointer(conversion.value_type)
    return made
}

func wait_until_finished(handle: Integer, carrier: String) {
    var point = lowering.resume_point()
    var arguments = List<Integer>()
    arguments.append(handle)
    var finished = lowering.new_register()
    var asked = LowIntermediaryRepresentation.Instructions.Call(finished, "{carrier}._finished_or_waited", arguments)
    lowering.emit(asked)
    lowering.suspend_unless(finished, point)
}

func waiting_call(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var arguments = lowering.lowered_call_arguments(call)
    var answer = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        answer = lowering.new_register()
    }
    if lowering.is_a_nullable_scalar(call.value_type) {
        presence = lowering.new_register()
    }
    var call_key = call.function.key()
    waited_into(call_key, arguments, answer, presence)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    var made = Lowered(answer, presence)
    made.owned = lowering.counts_an_answer(call.value_type)
    return made
}

func waited_into(call_key: String, arguments: List<Integer>, answer: Integer, presence: Integer) {
    var frame = lowering.new_register()
    var made_frame = LowIntermediaryRepresentation.Instructions.Call(frame, "{call_key}$frame", arguments)
    lowering.emit(made_frame)
    finish_the_frame(frame, "{call_key}$step", -1, answer, presence)
}

func finish_the_frame(frame: Integer, step_key: String, step_address: Integer, answer: Integer, presence: Integer) {
    var point = lowering.resume_point()
    var stepping = List<Integer>()
    stepping.append(frame)
    var done = lowering.new_register()
    if step_key.is_empty() {
        var stepped_at = LowIntermediaryRepresentation.Instructions.CallAt(done, step_address, stepping)
        lowering.emit(stepped_at)
    } else {
        var stepped = LowIntermediaryRepresentation.Instructions.Call(done, step_key, stepping)
        lowering.emit(stepped)
    }
    lowering.suspend_unless(done, point)
    if answer >= 0 {
        var loaded = LowIntermediaryRepresentation.Instructions.Load(answer, frame, 16, 'bits_64')
        lowering.emit(loaded)
    }
    if presence >= 0 {
        var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(presence, frame, 24, 'bits_64')
        lowering.emit(loaded_presence)
    }
    var freed = LowIntermediaryRepresentation.Instructions.Free(frame)
    lowering.emit(freed)
}

func waiting_sleep(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var milliseconds = lowering.sleep_milliseconds(call)
    var now = ticks()
    var deadline = lowering.new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(deadline, 'add', now, milliseconds)
    added.is_checked = false
    lowering.emit(added)
    var point = lowering.resume_point()
    var later = ticks()
    var due = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(due, 'greater_or_equal', later, deadline)
    compared.is_signed = true
    lowering.emit(compared)
    var waiting = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(due, after, waiting)
    lowering.emit(test)
    lowering.switch_to(waiting)
    call_with("_scheduler_note_deadline", deadline)
    lowering.suspend_at(point)
    lowering.switch_to(after)
    return Lowered(-1, -1)
}

func plain_sleep(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var milliseconds = lowering.sleep_milliseconds(call)
    call_with("_scheduler_sleep", milliseconds)
    return Lowered(-1, -1)
}

func call_with_nothing(key: String) {
    var arguments = List<Integer>()
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, key, arguments)
    lowering.emit(called)
}

func begin() {
    call_with_nothing("_scheduler_begin")
}

func drain() {
    call_with_nothing("_scheduler_drain")
}

func end(lets_go_of_flights: Boolean) {
    if lets_go_of_flights {
        call_with_nothing("_in_flight_let_go")
    }
    call_with_nothing("_scheduler_end")
}

func ticks(): Integer {
    var arguments = List<Integer>()
    var now = lowering.new_register()
    var called = LowIntermediaryRepresentation.Instructions.Call(now, "_scheduler_ticks", arguments)
    lowering.emit(called)
    return now
}

func frame_function(
    step: LowIntermediaryRepresentation.LowFunction,
    key: String,
): LowIntermediaryRepresentation.LowFunction {
    lowering.start("{key}$frame")
    var count = step.parameter_count
    lowering.reserve_registers(count)
    lowering.function.parameter_count = count
    var header = 48
    var slots = 8 * step.register_count
    var size = lowering.constant(header + slots)
    var frame = lowering.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(frame, size)
    allocated.zeroed_bytes = header + slots
    lowering.emit(allocated)
    var parameter = 0
    while parameter < count {
        var offset = header + 8 * (step.register_count - 1 - parameter)
        var stored = LowIntermediaryRepresentation.Instructions.Store(frame, offset, parameter, 'bits_64')
        lowering.emit(stored)
        parameter = parameter + 1
    }
    var address = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, "{key}$step")
    lowering.emit(found)
    var kept = LowIntermediaryRepresentation.Instructions.Store(frame, 32, address, 'bits_64')
    lowering.emit(kept)
    var returned = LowIntermediaryRepresentation.Instructions.Return(frame)
    lowering.emit(returned)
    return lowering.function
}

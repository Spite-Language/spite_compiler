func file_of(library: SpiteCompiler.Value?): String {
    if library.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return file_of_an_attribute(library.attribute)
    }
    return ""
}

func file_of_an_attribute(attribute: Model.AttributeModel): String {
    fallback attribute.declaration
    var made = attribute.declaration.value
    fallback made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback not made.arguments.is_empty()
    var written = made.arguments[0]
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    fallback written.pieces.count() == 1
    var piece = written.pieces[0]
    fallback not piece.hole
    return piece.text
}

var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)
var circle_text = "spite: the program stopped at a join of a Concurrent that waits for this one, so neither can finish (joins_a_concurrent_that_waits_for_this_one=true)\n"
var stuck_text = "spite: the program stopped waiting: every Concurrent waits for another and none sleeps, so none can finish (every_concurrent_waits_for_another=true)\n"
var poll_text = "spite: the program stopped polling a Concurrent that nothing steps between two reads (unfinished_polls_with_no_frame_stepped=1000000)\n"
var timer_text = "spite: the program stopped: the system's timer could not be waited for (WaitForSingleObject failed)\n"
var frequency_text = "spite: the program stopped: the system's performance counter has no frequency (QueryPerformanceFrequency failed)\n"

func Scheduling(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

func write_the_scheduler() {
    assert not machine.is_written("_scheduler_begin")
    lowering.program.scheduler_state = machine.zeroed_label(128)
    lowering.program.name_state(lowering.program.scheduler_state, "scheduler")
    write_begin()
    write_end()
    write_loop_here()
    write_running()
    write_hold()
    write_let_go()
    write_wait_on()
    write_start()
    write_step()
    write_run_once()
    write_remove_the_done()
    write_wait_for()
    write_joined()
    write_wait_for_a_helper()
    write_drain()
    write_any_running()
    write_pause()
    write_polled_unfinished()
    write_waits_on()
    write_sleep()
    write_note_deadline()
    write_ticks()
    write_rest()
}

func state(): Integer {
    return machine.data_at(lowering.program.scheduler_state)
}

func loop_here(): Integer {
    var nothing = machine.none_listed()
    return machine.called("_scheduler_loop_here", nothing)
}

func call_with(key: String, first_register: Integer) {
    var passed = machine.one_listed(first_register)
    machine.called_for_nothing(key, passed)
}

func call_with_nothing(key: String) {
    var passed = machine.none_listed()
    machine.called_for_nothing(key, passed)
}

func write_begin() {
    machine.begin("_scheduler_begin", 0)
    var scheduler = state()
    var thread = machine.thread_now()
    machine.stored(scheduler, 0, thread)
    var first_loop = machine.plus_number(scheduler, 64)
    machine.stored_number(first_loop, 16, -1)
    machine.answered_nothing()
    machine.finish()
}

func write_end() {
    machine.begin("_scheduler_end", 0)
    var scheduler = state()
    var head = machine.loaded(scheduler, 24)
    var walking = machine.kept(head)
    var top = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var done = machine.loop_while(present)
    var next = machine.loaded(walking, 48)
    machine.freed(walking)
    machine.copied(walking, next)
    machine.loop_back(top, done)
    machine.stored_number(scheduler, 24, 0)
    machine.answered_nothing()
    machine.finish()
}

func write_loop_here() {
    machine.begin("_scheduler_loop_here", 0)
    var scheduler = state()
    var thread = machine.thread_now()
    var first_thread = machine.loaded(scheduler, 0)
    var is_the_first = machine.compared('equal', thread, first_thread)
    var other_thread = machine.opened_when(is_the_first)
    var first_loop = machine.plus_number(scheduler, 64)
    machine.answered(first_loop)
    machine.closed(other_thread)
    var lock = machine.plus_number(scheduler, 16)
    var locking = machine.one_listed(lock)
    machine.imported("AcquireSRWLockExclusive", locking)
    var head = machine.loaded(scheduler, 24)
    var walking = machine.kept(head)
    var top = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var done = machine.loop_while(present)
    var owner = machine.loaded(walking, 40)
    var is_mine = machine.compared('equal', owner, thread)
    var not_mine = machine.opened_when(is_mine)
    machine.imported("ReleaseSRWLockExclusive", locking)
    machine.answered(walking)
    machine.closed(not_mine)
    var next = machine.loaded(walking, 48)
    machine.copied(walking, next)
    machine.loop_back(top, done)
    var made = machine.allocated(56)
    machine.stored_number(made, 0, 0)
    machine.stored_number(made, 8, 0)
    machine.stored_number(made, 16, -1)
    machine.stored_number(made, 24, 0)
    machine.stored_number(made, 32, 0)
    machine.stored(made, 40, thread)
    var others = machine.loaded(scheduler, 24)
    machine.stored(made, 48, others)
    machine.stored(scheduler, 24, made)
    machine.imported("ReleaseSRWLockExclusive", locking)
    machine.answered(made)
    machine.finish()
}

func write_running() {
    machine.begin("_scheduler_running", 2)
    var made = machine.allocated(64)
    machine.stored(made, 0, 0)
    machine.stored_number(made, 8, 0)
    machine.stored_number(made, 16, 0)
    machine.stored(made, 24, 1)
    machine.stored_number(made, 32, 0)
    machine.stored_number(made, 40, 1)
    machine.stored_number(made, 48, 0)
    machine.stored_number(made, 56, 0)
    machine.answered(made)
    machine.finish()
}

func write_hold() {
    machine.begin("_scheduler_hold", 1)
    var count = machine.loaded(0, 40)
    var more = machine.plus_number(count, 1)
    machine.stored(0, 40, more)
    machine.answered_nothing()
    machine.finish()
}

func write_let_go() {
    machine.begin("_scheduler_let_go", 1)
    var count = machine.loaded(0, 40)
    var left = machine.plus_number(count, -1)
    machine.stored(0, 40, left)
    var is_gone = machine.is_zero(left)
    var kept_on = machine.opened_when(is_gone)
    var waited = machine.loaded(0, 32)
    machine.freed(0)
    var waits = machine.compared_to('not_equal', waited, 0)
    var waits_for_none = machine.opened_when(waits)
    call_with("_scheduler_let_go", waited)
    machine.closed(waits_for_none)
    machine.closed(kept_on)
    machine.answered_nothing()
    machine.finish()
}

func write_wait_on() {
    machine.begin("_scheduler_wait_on", 2)
    var before = machine.loaded(0, 32)
    var waits = machine.compared_to('not_equal', 1, 0)
    var waits_for_none = machine.opened_when(waits)
    call_with("_scheduler_hold", 1)
    machine.closed(waits_for_none)
    machine.stored(0, 32, 1)
    var waited = machine.compared_to('not_equal', before, 0)
    var waited_for_none = machine.opened_when(waited)
    call_with("_scheduler_let_go", before)
    machine.closed(waited_for_none)
    machine.answered_nothing()
    machine.finish()
}

func write_start() {
    machine.begin("_scheduler_start", 1)
    var stepping = machine.one_listed(0)
    var finished = machine.called("_scheduler_step", stepping)
    var is_finished = machine.opened_unless(finished)
    var here = loop_here()
    call_with("_scheduler_hold", 0)
    machine.stored_number(0, 48, 0)
    var tail = machine.loaded(here, 8)
    var is_empty = machine.is_zero(tail)
    var has_items = machine.opened_when(is_empty)
    machine.stored(here, 0, 0)
    machine.closed(has_items)
    var was_empty = machine.opened_unless(is_empty)
    machine.stored(tail, 48, 0)
    machine.closed(was_empty)
    machine.stored(here, 8, 0)
    machine.closed(is_finished)
    machine.answered_nothing()
    machine.finish()
}

func write_step() {
    machine.begin("_scheduler_step", 1)
    var scheduler = state()
    machine.stored_number(scheduler, 32, 0)
    var here = loop_here()
    var outer = machine.loaded(here, 32)
    machine.stored(0, 56, outer)
    machine.stored(here, 32, 0)
    machine.stored_number(0, 16, 1)
    var nobody = machine.constant_of(0)
    var clearing = machine.two_listed(0, nobody)
    machine.called_for_nothing("_scheduler_wait_on", clearing)
    var frame = machine.loaded(0, 0)
    var address = machine.loaded(frame, 32)
    var stepping = machine.one_listed(frame)
    var finished = machine.called_at(address, stepping)
    machine.stored_number(0, 16, 0)
    var restored = machine.loaded(0, 56)
    machine.stored(here, 32, restored)
    var unfinished = machine.opened_when(finished)
    machine.stored_number(0, 8, 1)
    machine.answered(finished)
    machine.closed(unfinished)
    var count = machine.variable(1)
    var head = machine.loaded(here, 0)
    var walking = machine.kept(head)
    var counting = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var counted = machine.loop_while(present)
    machine.step_by(count, 1)
    var next = machine.loaded(walking, 48)
    machine.copied(walking, next)
    machine.loop_back(counting, counted)
    var first_waited = machine.loaded(0, 32)
    var waited = machine.kept(first_waited)
    var following = machine.loop_top()
    var waits = machine.compared_to('not_equal', waited, 0)
    var steps_left = machine.compared_to('greater', count, 0)
    var goes_on = machine.both(waits, steps_left)
    var followed = machine.loop_while(goes_on)
    var is_a_circle = machine.compared('equal', waited, 0)
    var no_circle = machine.opened_when(is_a_circle)
    machine.halted(circle_text)
    machine.closed(no_circle)
    var further = machine.loaded(waited, 32)
    machine.copied(waited, further)
    machine.step_by(count, -1)
    machine.loop_back(following, followed)
    machine.answered(finished)
    machine.finish()
}

func write_run_once() {
    machine.begin("_scheduler_run_once", 0)
    var here = loop_here()
    var depth = machine.loaded(here, 24)
    var deeper = machine.plus_number(depth, 1)
    machine.stored(here, 24, deeper)
    machine.stored_number(here, 16, -1)
    var finished = machine.variable(0)
    var head = machine.loaded(here, 0)
    var walking = machine.kept(head)
    var top = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var done = machine.loop_while(present)
    var stepping = machine.loaded(walking, 16)
    var walked_done = machine.loaded(walking, 8)
    var is_busy = machine.either(stepping, walked_done)
    var busy = machine.opened_unless(is_busy)
    var passed = machine.one_listed(walking)
    var stepped = machine.called("_scheduler_step", passed)
    var still_running = machine.opened_when(stepped)
    machine.step_by(finished, 1)
    machine.closed(still_running)
    machine.closed(busy)
    var next = machine.loaded(walking, 48)
    machine.copied(walking, next)
    machine.loop_back(top, done)
    var depth_now = machine.loaded(here, 24)
    var shallower = machine.plus_number(depth_now, -1)
    machine.stored(here, 24, shallower)
    var is_outermost = machine.is_zero(shallower)
    var nested = machine.opened_when(is_outermost)
    call_with("_scheduler_remove_the_done", here)
    machine.closed(nested)
    machine.answered(finished)
    machine.finish()
}

func write_remove_the_done() {
    machine.begin("_scheduler_remove_the_done", 1)
    var previous = machine.variable(0)
    var head = machine.loaded(0, 0)
    var walking = machine.kept(head)
    var top = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var done = machine.loop_while(present)
    var next = machine.loaded(walking, 48)
    var is_done = machine.loaded(walking, 8)
    var still_running = machine.opened_when(is_done)
    var is_the_head = machine.is_zero(previous)
    var not_the_head = machine.opened_when(is_the_head)
    machine.stored(0, 0, next)
    machine.closed(not_the_head)
    var the_head = machine.opened_unless(is_the_head)
    machine.stored(previous, 48, next)
    machine.closed(the_head)
    var tail = machine.loaded(0, 8)
    var is_the_tail = machine.compared('equal', tail, walking)
    var not_the_tail = machine.opened_when(is_the_tail)
    machine.stored(0, 8, previous)
    machine.closed(not_the_tail)
    call_with("_scheduler_let_go", walking)
    machine.closed(still_running)
    var removed = machine.opened_unless(is_done)
    machine.copied(previous, walking)
    machine.closed(removed)
    machine.copied(walking, next)
    machine.loop_back(top, done)
    machine.answered_nothing()
    machine.finish()
}

func write_wait_for() {
    machine.begin("_scheduler_wait_for", 1)
    var on_a_thread = machine.loaded(0, 24)
    var stepped_here = machine.opened_when(on_a_thread)
    call_with("_scheduler_joined", 0)
    machine.answered_nothing()
    machine.closed(stepped_here)
    var top = machine.loop_top()
    var done = machine.loaded(0, 8)
    var unfinished = machine.is_zero(done)
    var finished = machine.loop_while(unfinished)
    var nothing = machine.none_listed()
    var stepped = machine.called("_scheduler_run_once", nothing)
    var done_now = machine.loaded(0, 8)
    var still = machine.is_zero(done_now)
    var none_stepped = machine.is_zero(stepped)
    var waits = machine.both(still, none_stepped)
    var moved = machine.opened_when(waits)
    call_with_nothing("_scheduler_pause")
    machine.closed(moved)
    machine.loop_back(top, finished)
    machine.answered_nothing()
    machine.finish()
}

func write_joined() {
    machine.begin("_scheduler_joined", 1)
    var done = machine.loaded(0, 8)
    var running = machine.opened_when(done)
    machine.answered_nothing()
    machine.closed(running)
    if lowering.program.uses_the_pool {
        var block = machine.loaded(0, 0)
        call_with("_pool_join", block)
    }
    machine.stored_number(0, 8, 1)
    machine.answered_nothing()
    machine.finish()
}

func write_wait_for_a_helper() {
    machine.begin("_scheduler_wait_for_a_helper", 1)
    var top = machine.loop_top()
    var done = machine.loaded(0, 8)
    var unfinished = machine.is_zero(done)
    var finished = machine.loop_while(unfinished)
    var nothing = machine.none_listed()
    var stepped = machine.called("_scheduler_run_once", nothing)
    var none_stepped = machine.is_zero(stepped)
    var moved = machine.opened_when(none_stepped)
    var one = machine.constant_of(1)
    call_with("_scheduler_rest", one)
    machine.closed(moved)
    machine.loop_back(top, finished)
    machine.answered_nothing()
    machine.finish()
}

func write_drain() {
    machine.begin("_scheduler_drain", 0)
    var nothing = machine.none_listed()
    var top = machine.loop_top()
    var any = machine.called("_scheduler_any_running", nothing)
    var finished = machine.loop_while(any)
    var stepped = machine.called("_scheduler_run_once", nothing)
    var none_stepped = machine.is_zero(stepped)
    var any_left = machine.called("_scheduler_any_running", nothing)
    var waits = machine.both(none_stepped, any_left)
    var moved = machine.opened_when(waits)
    call_with_nothing("_scheduler_pause")
    machine.closed(moved)
    machine.loop_back(top, finished)
    machine.answered_nothing()
    machine.finish()
}

func write_any_running() {
    machine.begin("_scheduler_any_running", 0)
    var here = loop_here()
    var head = machine.loaded(here, 0)
    var walking = machine.kept(head)
    var top = machine.loop_top()
    var present = machine.compared_to('not_equal', walking, 0)
    var done = machine.loop_while(present)
    var walked_done = machine.loaded(walking, 8)
    var finished = machine.opened_unless(walked_done)
    var yes = machine.constant_of(1)
    machine.answered(yes)
    machine.closed(finished)
    var next = machine.loaded(walking, 48)
    machine.copied(walking, next)
    machine.loop_back(top, done)
    var no = machine.constant_of(0)
    machine.answered(no)
    machine.finish()
}

func write_pause() {
    machine.begin("_scheduler_pause", 0)
    var here = loop_here()
    var nearest = machine.loaded(here, 16)
    var sleeps_none = machine.compared_to('less', nearest, 0)
    var some_sleep = machine.opened_when(sleeps_none)
    machine.halted(stuck_text)
    machine.closed(some_sleep)
    var nothing = machine.none_listed()
    var now = machine.called("_scheduler_ticks", nothing)
    var is_later = machine.compared('greater', nearest, now)
    var is_due = machine.opened_when(is_later)
    var waiting = machine.difference_of(nearest, now)
    call_with("_scheduler_rest", waiting)
    machine.closed(is_due)
    machine.answered_nothing()
    machine.finish()
}

func write_polled_unfinished() {
    machine.begin("_scheduler_polled_unfinished", 0)
    var scheduler = state()
    var polls = machine.loaded(scheduler, 32)
    var more = machine.plus_number(polls, 1)
    machine.stored(scheduler, 32, more)
    var too_many = machine.compared_to('greater_or_equal', more, 1000000)
    var below = machine.opened_when(too_many)
    machine.halted(poll_text)
    machine.closed(below)
    machine.answered_nothing()
    machine.finish()
}

func write_waits_on() {
    machine.begin("_scheduler_waits_on", 1)
    var here = loop_here()
    var current = machine.loaded(here, 32)
    var stepping = machine.compared_to('not_equal', current, 0)
    var outside = machine.opened_when(stepping)
    var noting = machine.two_listed(current, 0)
    machine.called_for_nothing("_scheduler_wait_on", noting)
    machine.closed(outside)
    machine.answered_nothing()
    machine.finish()
}

func write_sleep() {
    machine.begin("_scheduler_sleep", 1)
    var nothing = machine.none_listed()
    var started = machine.called("_scheduler_ticks", nothing)
    var deadline = machine.sum_of(started, 0)
    var first_moment = machine.called("_scheduler_ticks", nothing)
    var moment = machine.kept(first_moment)
    var top = machine.loop_top()
    var is_early = machine.compared('less', moment, deadline)
    var done = machine.loop_while(is_early)
    var stepped = machine.called("_scheduler_run_once", nothing)
    call_with("_scheduler_note_deadline", deadline)
    var none_stepped = machine.is_zero(stepped)
    var moved = machine.opened_when(none_stepped)
    call_with_nothing("_scheduler_pause")
    machine.closed(moved)
    var later = machine.called("_scheduler_ticks", nothing)
    machine.copied(moment, later)
    machine.loop_back(top, done)
    machine.answered_nothing()
    machine.finish()
}

func write_note_deadline() {
    machine.begin("_scheduler_note_deadline", 1)
    var here = loop_here()
    var nearest = machine.loaded(here, 16)
    var sleeps_none = machine.compared_to('less', nearest, 0)
    var is_sooner = machine.compared('less', 0, nearest)
    var replaces = machine.either(sleeps_none, is_sooner)
    var later = machine.opened_when(replaces)
    machine.stored(here, 16, 0)
    machine.closed(later)
    machine.answered_nothing()
    machine.finish()
}

func write_ticks() {
    machine.begin("_scheduler_ticks", 0)
    var reading = machine.room(8)
    var asking = machine.one_listed(reading)
    machine.imported("QueryPerformanceFrequency", asking)
    var per_second = machine.loaded(reading, 0)
    var has_none = machine.compared_to('less_or_equal', per_second, 0)
    var has_one = machine.opened_when(has_none)
    machine.halted(frequency_text)
    machine.closed(has_one)
    machine.imported("QueryPerformanceCounter", asking)
    var counted = machine.loaded(reading, 0)
    var thousand = machine.constant_of(1000)
    var seconds = machine.quotient_of(counted, per_second)
    var whole = machine.product_of(seconds, thousand)
    var rest = machine.remainder_of(counted, per_second)
    var scaled = machine.product_of(rest, thousand)
    var part = machine.quotient_of(scaled, per_second)
    var milliseconds = machine.sum_of(whole, part)
    machine.answered(milliseconds)
    machine.finish()
}

func write_rest() {
    machine.begin("_scheduler_rest", 1)
    var nothing = machine.constant_of(0)
    var high_resolution = machine.constant_of(2)
    var every_right = machine.constant_of(2031619)
    var making = machine.three_listed(nothing, nothing, high_resolution)
    making.append(every_right)
    var timer = machine.imported("CreateWaitableTimerExW", making)
    var sleeping = machine.one_listed(0)
    var has_no_timer = machine.is_zero(timer)
    var has_a_timer = machine.opened_when(has_no_timer)
    machine.imported("Sleep", sleeping)
    machine.answered_nothing()
    machine.closed(has_a_timer)
    var due = machine.room(8)
    var ticks_per_millisecond = machine.constant_of(-10000)
    var relative = machine.product_of(0, ticks_per_millisecond)
    machine.stored(due, 0, relative)
    var setting = machine.three_listed(timer, due, nothing)
    setting.append(nothing)
    setting.append(nothing)
    setting.append(nothing)
    var was_set = machine.imported("SetWaitableTimer", setting)
    var failed = machine.is_zero(was_set)
    var set_well = machine.opened_when(failed)
    machine.imported("Sleep", sleeping)
    machine.closed(set_well)
    var set_badly = machine.opened_unless(failed)
    var forever = machine.constant_of(-1)
    var waiting = machine.two_listed(timer, forever)
    var waited = machine.imported("WaitForSingleObject", waiting)
    var went_wrong = machine.compared_to('not_equal', waited, 0)
    var went_well = machine.opened_when(went_wrong)
    machine.halted(timer_text)
    machine.closed(went_well)
    machine.closed(set_badly)
    var closing = machine.one_listed(timer)
    machine.imported("CloseHandle", closing)
    machine.answered_nothing()
    machine.finish()
}

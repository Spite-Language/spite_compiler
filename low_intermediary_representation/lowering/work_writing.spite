var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)
var key = ""
var result_is_a_pointer = false
var result_has_a_presence = false
var full_text = "spite: the program stopped: more calls in a row run at once than their sites allow, which cannot happen (in_flight_table_full=true)\n"

func WorkWriting(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

func is_a_work(class_key: String): Boolean {
    return class_key.starts_with("Spite.Work_of_")
}

func write_every_work() {
    var index = 0
    while index < lowering.layout.program.order.count() {
        var model = lowering.layout.program.order[index]
        if is_a_work(model.key) {
            write_the_work(model)
        }
        index = index + 1
    }
}

func write_the_work(model: Model.ClassModel) {
    assert not machine.is_written("{model.key}.get_finished")
    key = model.key
    var result = model.bound_types["$result_type"]
    crash result
    var nullable = result.nullable()
    result_is_a_pointer = lowering.is_a_pointer(result)
    result_has_a_presence = lowering.is_a_nullable_scalar(nullable)
    write_get_finished()
    write_settle()
    write_settled()
    write_finished_value()
    write_finished_or_waited()
    write_drop()
    write_hand_in_flight()
}

func write_get_finished() {
    machine.begin("{key}.get_finished", 1)
    var running = machine.loaded(0, 16)
    var is_settled = machine.is_zero(running)
    var unsettled = machine.opened_when(is_settled)
    var yes = machine.constant_of(1)
    machine.answered(yes)
    machine.closed(unsettled)
    var on_a_thread = machine.loaded(running, 24)
    var done = machine.loaded(running, 8)
    var finished = machine.kept(done)
    var not_done = machine.is_zero(done)
    var asks_the_thread = machine.both(on_a_thread, not_done)
    var stepped_here = machine.opened_when(asks_the_thread)
    var block = machine.loaded(running, 0)
    var thread_done = machine.loaded(block, 8)
    machine.copied(finished, thread_done)
    machine.closed(stepped_here)
    var unfinished = machine.is_zero(finished)
    var stepped = machine.is_zero(on_a_thread)
    var counts = machine.both(unfinished, stepped)
    var not_counted = machine.opened_when(counts)
    var nothing = machine.none_listed()
    machine.called_for_nothing("_scheduler_polled_unfinished", nothing)
    machine.closed(not_counted)
    machine.answered(finished)
    machine.finish()
}

func write_settle() {
    machine.begin("{key}._settle", 1)
    var running = machine.loaded(0, 16)
    var is_settled = machine.is_zero(running)
    var unsettled = machine.opened_when(is_settled)
    machine.answered_nothing()
    machine.closed(unsettled)
    var done = machine.loaded(running, 8)
    var finished = machine.opened_unless(done)
    var waiting = machine.one_listed(running)
    machine.called_for_nothing("_scheduler_wait_for", waiting)
    machine.closed(finished)
    var still_held = machine.loaded(0, 16)
    var taken_meanwhile = machine.is_zero(still_held)
    var untaken = machine.opened_when(taken_meanwhile)
    machine.answered_nothing()
    machine.closed(untaken)
    var frame = machine.loaded(running, 0)
    var value = machine.loaded(frame, 16)
    var presence = machine.loaded(frame, 24)
    machine.stored(0, 24, value)
    machine.stored(0, 32, presence)
    machine.freed(frame)
    machine.stored_number(0, 16, 0)
    machine.called_for_nothing("_scheduler_let_go", waiting)
    machine.answered_nothing()
    machine.finish()
}

func answer_the_result() {
    var settling = machine.one_listed(0)
    machine.called_for_nothing("{key}._settle", settling)
    var value = machine.loaded(0, 24)
    if result_is_a_pointer {
        machine.writing.retain(value)
    }
    if result_has_a_presence {
        var presence = machine.loaded(0, 32)
        machine.answered_with(value, presence)
    } else {
        machine.answered(value)
    }
}

func write_settled() {
    machine.begin("{key}._settled", 1)
    answer_the_result()
    machine.finish()
}

func write_finished_value() {
    machine.begin("{key}.finished_value", 1)
    var asking = machine.one_listed(0)
    var finished = machine.called("{key}.get_finished", asking)
    var unfinished = machine.opened_unless(finished)
    var no_value = machine.constant_of(0)
    if result_has_a_presence {
        machine.answered_with(no_value, no_value)
    } else {
        machine.answered(no_value)
    }
    machine.closed(unfinished)
    answer_the_result()
    machine.finish()
}

func write_finished_or_waited() {
    machine.begin("{key}._finished_or_waited", 1)
    var asking = machine.one_listed(0)
    var finished = machine.called("{key}.get_finished", asking)
    var unfinished = machine.opened_unless(finished)
    var running = machine.loaded(0, 16)
    var noting = machine.one_listed(running)
    machine.called_for_nothing("_scheduler_waits_on", noting)
    machine.closed(unfinished)
    machine.answered(finished)
    machine.finish()
}

func write_drop() {
    machine.begin("{key}.drop", 1)
    var settling = machine.one_listed(0)
    machine.called_for_nothing("{key}._settle", settling)
    machine.answered_nothing()
    machine.finish()
}

func write_free() {
    machine.begin("_free_{key}", 1)
    var settling = machine.one_listed(0)
    machine.called_for_nothing("{key}._settle", settling)
    if result_is_a_pointer {
        var value = machine.loaded(0, 24)
        machine.writing.release(value)
    }
    machine.freed(0)
    machine.answered_nothing()
    machine.finish()
}

func write_the_free(model: Model.ClassModel) {
    key = model.key
    var result = model.bound_types["$result_type"]
    crash result
    result_is_a_pointer = lowering.is_a_pointer(result)
    write_free()
}

func write_hand_in_flight() {
    machine.begin("{key}._hand_in_flight", 2)
    var sites = lowering.program.in_flight_room
    var table_label = lowering.program.in_flight_table
    var is_handed = table_label >= 0
    if is_handed {
        hand_in_flight(table_label, sites)
    }
    machine.answered_nothing()
    machine.finish()
}

func hand_in_flight(table_label: Integer, room: Integer) {
    var table = machine.data_at(table_label)
    enter_the_table(table)
    let_go_of_the_finished(table)
    var asking = machine.one_listed(0)
    var finished = machine.called("{key}.get_finished", asking)
    var kept_on = machine.opened_unless(finished)
    var count = machine.loaded(table, 16)
    var is_full = machine.compared_to('greater_or_equal', count, room)
    var has_room = machine.opened_when(is_full)
    machine.halted(full_text)
    machine.closed(has_room)
    machine.writing.retain(0)
    var entry = entry_at(table, count)
    machine.stored(entry, 0, 1)
    machine.stored(entry, 8, 0)
    var more = machine.plus_number(count, 1)
    machine.stored(table, 16, more)
    machine.closed(kept_on)
    var top = machine.loop_top()
    var unfinished = unfinished_from(table)
    var too_many = machine.compared_to('greater', unfinished, 8)
    var done = machine.loop_while(too_many)
    let_go_of_the_oldest(table)
    machine.loop_back(top, done)
    leave_the_table(table)
}

func entry_at(table: Integer, index: Integer): Integer {
    var sixteen = machine.constant_of(16)
    var scaled = machine.product_of(index, sixteen)
    var start = machine.plus_number(table, 24)
    return machine.sum_of(start, scaled)
}

func enter_the_table(table: Integer) {
    var thread = machine.thread_now()
    var owner = machine.loaded(table, 0)
    var is_mine = machine.compared('equal', owner, thread)
    var taking = machine.opened_unless(is_mine)
    var free = machine.constant_of(0)
    var top = machine.loop_top()
    var before = machine.writing.new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, table, 0, free, thread)
    machine.writing.emit(claimed)
    var is_taken = machine.compared_to('not_equal', before, 0)
    var won = machine.loop_while(is_taken)
    var zero = machine.constant_of(0)
    var yielding = machine.one_listed(zero)
    machine.call_imported("Sleep", yielding)
    machine.loop_back(top, won)
    machine.closed(taking)
    var depth = machine.loaded(table, 8)
    var deeper = machine.plus_number(depth, 1)
    machine.stored(table, 8, deeper)
}

func leave_the_table(table: Integer) {
    var depth = machine.loaded(table, 8)
    var shallower = machine.plus_number(depth, -1)
    machine.stored(table, 8, shallower)
    var is_out = machine.is_zero(shallower)
    var still_in = machine.opened_when(is_out)
    machine.stored_number(table, 0, 0)
    machine.closed(still_in)
}

func let_go_of_the_finished(table: Integer) {
    var count = machine.loaded(table, 16)
    var last = machine.plus_number(count, -1)
    var index = machine.kept(last)
    var top = machine.loop_top()
    var in_range = machine.compared_to('greater_or_equal', index, 0)
    var done = machine.loop_while(in_range)
    var entry = entry_at(table, index)
    var held = machine.loaded(entry, 8)
    var asking = machine.one_listed(held)
    var finished = machine.called("{key}.get_finished", asking)
    var unfinished = machine.opened_when(finished)
    remove_at(table, index)
    machine.writing.release(held)
    machine.closed(unfinished)
    machine.step_by(index, -1)
    machine.loop_back(top, done)
}

func remove_at(table: Integer, removed: Integer) {
    var count = machine.loaded(table, 16)
    var last = machine.plus_number(count, -1)
    var index = machine.kept(removed)
    var top = machine.loop_top()
    var in_range = machine.compared('less', index, last)
    var done = machine.loop_while(in_range)
    var entry = entry_at(table, index)
    var following_site = machine.loaded(entry, 16)
    var following_handle = machine.loaded(entry, 24)
    machine.stored(entry, 0, following_site)
    machine.stored(entry, 8, following_handle)
    machine.step_by(index, 1)
    machine.loop_back(top, done)
    machine.stored(table, 16, last)
}

func unfinished_from(table: Integer): Integer {
    var unfinished = machine.variable(0)
    var index = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(table, 16)
    var in_range = machine.compared('less', index, count)
    var done = machine.loop_while(in_range)
    var entry = entry_at(table, index)
    var site = machine.loaded(entry, 0)
    var held = machine.loaded(entry, 8)
    var is_the_site = machine.compared('equal', site, 1)
    var other_site = machine.opened_when(is_the_site)
    var asking = machine.one_listed(held)
    var finished = machine.called("{key}.get_finished", asking)
    var counted = machine.opened_unless(finished)
    machine.step_by(unfinished, 1)
    machine.closed(counted)
    machine.closed(other_site)
    machine.step_by(index, 1)
    machine.loop_back(top, done)
    return unfinished
}

func let_go_of_the_oldest(table: Integer) {
    var index = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(table, 16)
    var in_range = machine.compared('less', index, count)
    var done = machine.loop_while(in_range)
    var entry = entry_at(table, index)
    var site = machine.loaded(entry, 0)
    var held = machine.loaded(entry, 8)
    var is_the_site = machine.compared('equal', site, 1)
    var other_site = machine.opened_when(is_the_site)
    var asking = machine.one_listed(held)
    var finished = machine.called("{key}.get_finished", asking)
    var counted = machine.opened_unless(finished)
    remove_at(table, index)
    machine.writing.release(held)
    machine.writing.jump_to(done)
    machine.closed(counted)
    machine.closed(other_site)
    machine.step_by(index, 1)
    machine.loop_back(top, done)
}

func write_let_go_of_every_flight() {
    machine.begin("_in_flight_let_go", 0)
    var table_label = lowering.program.in_flight_table
    var table = machine.data_at(table_label)
    var top = machine.loop_top()
    var count = machine.loaded(table, 16)
    var some = machine.compared_to('greater', count, 0)
    var done = machine.loop_while(some)
    var last = machine.plus_number(count, -1)
    var entry = entry_at(table, last)
    var held = machine.loaded(entry, 8)
    machine.stored(table, 16, last)
    machine.writing.release(held)
    machine.loop_back(top, done)
    machine.answered_nothing()
    machine.finish()
}

var state = LoweringState()
var _largest_long: Long = 9223372036854775807
var _largest_float_as_double_bits: Long = 5183643170566569984
var _infinity_as_double_bits: Long = 9218868437227405312
var _double_exponent_bias: Integer = 1023

func FunctionLowering(starting_state: LoweringState) {
    state = starting_state
}

func lowered(
    high: HighIntermediaryRepresentation.HighFunction,
    starting_path: String,
): LowIntermediaryRepresentation.LowFunction {
    var frame_lists = FrameLists(state)
    var counting = Counting(state)
    var statements = Statements(state)
    var singletons = Singletons(state)
    state.path = starting_path
    var key = high.function.key()
    if state.resumable_mode {
        key = "{key}$step"
    }
    if state.skips_the_lock {
        key = "{key}$unguarded"
    }
    state.lowering_owner = high.function.owner
    state.lowering_name = high.function.name
    state.counts_the_answer = true
    if high.function.answer {
        state.counts_the_answer = not is_a_singleton_type(high.function.answer)
    }
    start(key)
    state.function.is_resumable = state.resumable_mode
    frame_lists.note_the_frame_lists()
    state.column_items = Dictionary<String, String>()
    state.column_storages = Dictionary<String, Integer>()
    state.column_capacities = Dictionary<String, Integer>()
    state.column_indices = Dictionary<String, Integer>()
    state.column_addresses = Dictionary<String, Integer>()
    state.column_regions = Dictionary<String, String>()
    state.column_parts = List<String>()
    frame_lists.note_the_slot_appends(high)
    if high.function.declaration {
        note_the_place(high.function, high.function.declaration.line)
    } else if high.function.placed_at_line > 0 {
        note_the_place(high.function, high.function.placed_at_line)
    }
    state.resume_blocks = List<Integer>()
    var dispatch = state.current
    var this_register = new_register()
    state.locals["this"] = this_register
    state.scopes = List<List<Integer>>()
    var held = List<Integer>()
    state.scopes.append(held)
    note_the_borrowed_parameters(high)
    state.borrowed_sources = List<SpiteCompiler.Value>()
    note_the_fresh_attributes(high.function)
    high.function.parameters.each(take_parameter)
    state.function.parameter_count = state.function.register_count
    var body = state.current
    if state.resumable_mode {
        body = new_block()
        switch_to(body)
    }
    hold_the_parameters(high.function)
    var owner_key = high.function.owner
    var guarded = state.waits and not high.function.is_constructor and not state.skips_the_lock
    if guarded and is_locked_here() {
        state.locks_its_singleton = true
        state.locked_class = owner_key
        singletons.lock_the_singleton()
    }
    var columns = ColumnLists(this)
    if high.function.name == "_reserve" and columns.is_columnar(owner_key) {
        columns.write_the_reserve(owner_key)
        return state.function
    }
    statements.lower_block(high.body)
    if not state.terminated {
        counting.release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
    }
    if state.resumable_mode {
        dispatch_the_resumes(dispatch, body)
    }
    return state.function
}

func note_the_borrowed_parameters(high: HighIntermediaryRepresentation.HighFunction) {
    state.borrows_parameters = false
    state.reassigned_names = List<String>()
    fallback not state.resumable_mode
    fallback state.assignments
    state.reassigned_names = state.assignments.names_assigned_in(high.body)
    state.borrows_parameters = true
}

func note_the_place(model: Model.FunctionModel, declared_line: Integer) {
    var owner_model = state.layout.program.class_named(model.owner)
    var owner_shown = model.owner
    if owner_model {
        owner_shown = owner_model.shown
    }
    state.function.place = "{state.path}:{declared_line}\t{owner_shown}\t{model.name}"
}

func dispatch_the_resumes(dispatch: Integer, body: Integer) {
    switch_to(dispatch)
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var resumed = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(resumed, frame, 0, 'bits_64')
    emit(loaded)
    var index = 0
    while index < state.resume_blocks.count() {
        var target = state.resume_blocks[index]
        var number = constant(index + 1)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', resumed, number)
        emit(compared)
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, target, next)
        emit(test)
        switch_to(next)
        index = index + 1
    }
    jump_to(body)
}

func resume_point(): Integer {
    var block = new_block()
    jump_to(block)
    switch_to(block)
    state.resume_blocks.append(block)
    return state.resume_blocks.count()
}

func suspend_unless(holds: Integer, point: Integer) {
    var waiting = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(holds, after, waiting)
    emit(test)
    switch_to(waiting)
    suspend_at(point)
    switch_to(after)
}

func suspend_at(point: Integer) {
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var number = constant(point)
    var stored = LowIntermediaryRepresentation.Instructions.Store(frame, 0, number, 'bits_64')
    emit(stored)
    var zero = constant(0)
    var returned = LowIntermediaryRepresentation.Instructions.Return(zero)
    returned.is_a_suspension = true
    emit(returned)
}

func blocks(key: String): Boolean {
    fallback state.waits
    return state.waits.blocks(key)
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func waits_in_the_library(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback state.waits
    var called_key = call.function.key()
    fallback state.waits.reaches_a_wait(called_key)
    var owner = state.layout.program.class_named(call.function.owner)
    fallback owner
    var library = Mapping.LibraryFile()
    return library.holds(owner.file.path)
}

func is_locked_here(): Boolean {
    fallback state.waits
    return state.waits.is_locked(state.function.key)
}

func is_resumable(key: String): Boolean {
    fallback state.waits
    return state.waits.is_resumable(key)
}

func counts_an_answer(of_type: Model.Type): Boolean {
    return is_a_pointer(of_type) and not is_a_singleton_type(of_type)
}

func is_a_singleton_type(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object'
    var model = state.layout.program.class_named(of_type.name)
    fallback model
    return model.is_singleton
}

func start(key: String) {
    state.function = LowIntermediaryRepresentation.LowFunction(key, 0)
    state.locals = Dictionary<String, Integer>()
    state.plain_registers = List<Integer>()
    state.atomic_registers = List<Integer>()
    state.local_presences = Dictionary<String, Integer>()
    var first = new_block()
    switch_to(first)
}

func take_parameter(parameter: Model.ParameterModel) {
    var value = new_register()
    state.locals[parameter.name] = value
    if is_a_nullable_scalar(parameter.parameter_type) {
        var presence = new_register()
        state.local_presences[parameter.name] = presence
    }
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func hold_the_parameters(model: Model.FunctionModel) {
    var key = model.key()
    var index = 0
    while index < model.parameters.count() {
        var parameter = model.parameters[index]
        if takes_the_argument(key, index) {
            hold_a_taken_parameter(parameter)
        } else {
            hold_a_parameter(parameter)
        }
        index = index + 1
    }
}

func takes_the_argument(key: String, index: Integer): Boolean {
    fallback not state.resumable_mode and state.taken
    return state.taken.is_taken(key, index)
}

func hands_the_argument(callee: String, index: Integer): Boolean {
    fallback state.taken
    return state.taken.is_taken(callee, index)
}

func hold_a_taken_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    var register = state.locals[parameter.name]
    crash register
    counting.hold(register)
}

func note_the_fresh_attributes(model: Model.FunctionModel) {
    state.fresh_attributes = List<String>()
    fallback not state.resumable_mode and model.is_constructor
    var found = state.fresh_by_constructor[model.key()]
    fallback found
    var index = 0
    while index < found.count() {
        var name = found[index]
        state.fresh_attributes.append(name)
        index = index + 1
    }
}

func hold_a_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    fallback is_a_pointer(parameter.parameter_type)
    fallback not state.borrows_parameters or state.reassigned_names.contains(parameter.name)
    var register = state.locals[parameter.name]
    crash register
    counting.retain_counted(register, parameter.parameter_type)
    counting.note_the_count(register, parameter.parameter_type)
    counting.hold(register)
}

func width_of_a_presence(): LowIntermediaryRepresentation.Instructions.Load.Width {
    if state.layout.packs {
        return 'bits_8'
    }
    return 'bits_64'
}

func is_a_pointer(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'handle' {
        return true
    }
    return kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
}

func new_register(): Integer {
    var made = state.function.register_count
    state.function.register_count = made + 1
    return made
}

func reserve_registers(count: Integer) {
    state.function.register_count = state.function.register_count + count
}

func new_block(): Integer {
    var made = LowIntermediaryRepresentation.LowBlock()
    state.function.blocks.append(made)
    return state.function.blocks.count() - 1
}

func switch_to(block: Integer) {
    state.current = block
    state.terminated = false
}

func note_the_line(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        note_a_call_line(instruction)
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.CallAt {
        note_a_call_at_line(instruction)
    }
}

func note_a_call_line(call: LowIntermediaryRepresentation.Instructions.Call) {
    if call.line == 0 {
        call.line = state.line
    }
}

func note_a_call_at_line(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    if call.line == 0 {
        call.line = state.line
    }
}

func emit(instruction: SpiteCompiler.Instruction) {
    if state.terminated {
        var unreachable = new_block()
        switch_to(unreachable)
    }
    var block = state.function.blocks[state.current]
    crash block
    note_the_line(instruction)
    block.instructions.append(instruction)
    var ends = instruction.class == LowIntermediaryRepresentation.Instructions.Jump
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Branch
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Return
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Exit
    if instruction.class == LowIntermediaryRepresentation.Instructions.Stop {
        ends = not instruction.continues
    }
    state.terminated = ends
}

func jump_to(block: Integer) {
    if not state.terminated {
        var jump = LowIntermediaryRepresentation.Instructions.Jump(block)
        emit(jump)
    }
}

func constant(number: Long): Integer {
    var target = new_register()
    var made = LowIntermediaryRepresentation.Instructions.Constant(target, number)
    emit(made)
    return target
}

func data_label(bytes: Buffer): Integer {
    state.program.data.append(bytes)
    return state.program.data.count() - 1
}

func text_label(text: String): Integer {
    var bytes = text.to_buffer()
    var label = data_label(bytes)
    state.program.constant_labels.append(label)
    return label
}

func lower_a_statement(statement: SpiteCompiler.Statement) {
    var statements = Statements(state)
    if statement.class != HighIntermediaryRepresentation.Statements.Assign.Attribute {
        state.fresh_attributes = List<String>()
    }
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: statements.lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: statements.lower_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: statements.lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: statements.lower_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: statements.lower_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: statements.lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: statements.lower_while(statement)
        HighIntermediaryRepresentation.Statements.Return: statements.lower_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: statements.lower_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: statements.lower_block(statement)
    }
}

func is_unsigned_whole(name: String): Boolean {
    return name == "Byte" or name == "UnsignedShort" or name == "UnsignedInteger" or name == "UnsignedLong"
}

func lower_value(value: SpiteCompiler.Value?): Lowered {
    var values = Values(state)
    var calls = Calls(state)
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return values.lower_whole_number(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return values.lower_decimal_number(value)
        HighIntermediaryRepresentation.Values.TextConstant: return values.lower_text(value)
        HighIntermediaryRepresentation.Values.NullConstant: return values.lower_null(value.value_type)
        HighIntermediaryRepresentation.Values.LocalRead: return values.lower_local(value)
        HighIntermediaryRepresentation.Values.ThisRead: return values.lower_this()
        HighIntermediaryRepresentation.Values.AttributeRead: return values.lower_attribute(value)
        HighIntermediaryRepresentation.Values.Call: return calls.lower_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: return values.lower_make_object(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return values.lower_operation(value)
        HighIntermediaryRepresentation.Values.Negation: return values.lower_negation(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return calls.lower_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Membership: return values.lower_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return values.lower_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: return lower_conversion(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return values.lower_number_room(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return lower_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: return lower_enum_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return lower_enum_from_text(value)
        HighIntermediaryRepresentation.Values.Class.Object: return values.lower_class_object(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: return values.lower_class_of_value(value)
        HighIntermediaryRepresentation.Values.Function.Value: return calls.lower_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return calls.lower_function_value_call(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return values.lower_function_fact(value)
    }
}

func single(register: Integer): Lowered {
    return Lowered(register, -1)
}

func address_plus(base: Integer, offset_register: Integer): Integer {
    var target = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'add', base, offset_register)
    added.is_signed = false
    added.is_checked = false
    emit(added)
    return target
}

func is_a_decimal(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func lower_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    if conversion.kind == 'into_handle' {
        var starting = Working(this)
        return starting.started(conversion)
    }
    if conversion.kind == 'join' {
        var joining = Working(this)
        return joining.joined(conversion)
    }
    if conversion.kind == 'proven' {
        var reads = ListReads(this)
        var read = reads.read(conversion)
        if read {
            return read
        }
    }
    var converted = lower_value(conversion.converted)
    if conversion.kind == 'nullable' {
        return made_nullable(converted, conversion.value_type)
    }
    if conversion.kind == 'into_shape' {
        crash conversion.converted
        var boxed = conversion.converted.value_type
        if conversion.value_type.is_nullable and boxed.is_nullable {
            return boxed_into_a_maybe(converted, boxed)
        }
        return boxed_into_a_shape(converted, boxed)
    }
    crash conversion.converted
    var from_type = conversion.converted.value_type
    if conversion.kind == 'widen' and is_a_decimal(from_type) {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'narrow_decimal' {
        check_the_float_range(converted.value, from_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_decimal' {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_whole' {
        check_the_decimal_range(converted.value, from_type, conversion.value_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'address' {
        return single(converted.value)
    }
    if conversion.kind == 'unbox' {
        var unboxed = new_register()
        var loaded_box = LowIntermediaryRepresentation.Instructions.Load(unboxed, converted.value, 16, 'bits_64')
        emit(loaded_box)
        return single(unboxed)
    }
    if conversion.kind == 'proven' {
        if from_type.is_nullable or converted.presence >= 0 {
            stop_if_missing(converted, conversion.shown)
        }
        return carried(converted)
    }
    if conversion.kind == 'narrow' {
        check_the_range(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'present' {
        stop_if_a_back_reference_is_gone(conversion.converted, converted)
    }
    return carried(converted)
}

# ../../PROOFS.md#a-back-reference-read-holds-its-object
func stop_if_a_back_reference_is_gone(value: SpiteCompiler.Value?, read: Lowered) {
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback state.layout.is_back(value.attribute)
    stop_if_gone(read, "{value.attribute.owner}.{value.attribute.name}")
}

func stop_if_gone(read: Lowered, shown: String) {
    var zero = constant(0)
    var present = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(present, 'not_equal', read.value, zero)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(present, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' was proven present, but its object was freed since, and a back reference holds no count: prove it again after the call that lets it go, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func carried(converted: Lowered): Lowered {
    var made = Lowered(converted.value, -1)
    made.owned = converted.owned
    return made
}

func stop_if_missing(converted: Lowered, shown: String) {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' is outside its list: a bound proves only the top of an index, and this one is below 0 or the list changed, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func lower_symbol_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var counting = Counting(state)
    var values = Values(state)
    var text = lower_value(read.text)
    var target = new_register()
    var zero = constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = values.lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_name.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        counting.release(lowered_name.value)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    counting.discard(text, read.text.value_type)
    return counting.owned(target)
}

func lower_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var counting = Counting(state)
    var values = Values(state)
    if read.value_type.is_a_walked_name {
        return lower_symbol_from_text(read)
    }
    var text = lower_value(read.text)
    var target = new_register()
    var presence = new_register()
    var zero = constant(0)
    var absent = LowIntermediaryRepresentation.Instructions.Copy(presence, zero)
    emit(absent)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var number = read.enumeration.numbers[index]
        crash number
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = values.lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        counting.release(lowered_name.value)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var value = constant(number)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, value)
        emit(copied)
        var one = constant(1)
        var present = LowIntermediaryRepresentation.Instructions.Copy(presence, one)
        emit(present)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    counting.discard(text, read.text.value_type)
    return Lowered(target, presence)
}

func lower_enum_text(text: HighIntermediaryRepresentation.Values.EnumText): Lowered {
    var number = lower_value(text.number)
    return enum_text_of(number.value, text.enumeration, text.value_type)
}

func enum_text_of(number: Integer, enumeration: Model.EnumModel, string_type: Model.Type): Lowered {
    var counting = Counting(state)
    var values = Values(state)
    var target = new_register()
    var after = new_block()
    var index = 0
    while index < enumeration.values.count() {
        var name = enumeration.values[index]
        var value = enumeration.numbers[index]
        crash value
        var wanted = constant(value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', number, wanted)
        emit(compared)
        var naming = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, naming, next)
        emit(test)
        switch_to(naming)
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(name)
        constant_text.value_type = string_type
        var made = values.lower_text(constant_text)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value outside its enum '{enumeration.name}', at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    return counting.owned(target)
}

func boxed_into_a_shape(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.kind == 'shape' {
        return carried(converted)
    }
    if boxed.is_nullable {
        return maybe_boxed(converted, boxed)
    }
    return present_boxed(converted, boxed)
}

func boxed_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    if boxed.is_a_walked_name {
        return symbol_into_a_maybe(converted, boxed)
    }
    if is_a_pointer(boxed) {
        return carried(converted)
    }
    var presence = converted.presence
    crash presence >= 0
    var target = new_register()
    var boxing = new_block()
    var missing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, missing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(missing)
    var nothing = constant(0)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, nothing)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func symbol_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', converted.value, zero)
    emit(compared)
    var target = new_register()
    var boxing = new_block()
    var nothing_held = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, nothing_held, boxing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(nothing_held)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func maybe_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var target = new_register()
    var boxing = new_block()
    var naming = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, naming)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    if not made.owned {
        counting.retain(made.value)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(naming)
    var absent_size = state.layout.size_of("Spite.Absent")
    var absent = small_object("Spite.Absent", absent_size)
    var copied_absent = LowIntermediaryRepresentation.Instructions.Copy(target, absent)
    emit(copied_absent)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func present_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    if boxed.is_a_walked_name {
        counting.kept(converted, boxed)
        var symbol_box = small_object("Spite.SymbolBox", 24)
        var stored_symbol = LowIntermediaryRepresentation.Instructions.Store(symbol_box, 16, converted.value, 'bits_64')
        emit(stored_symbol)
        return counting.owned(symbol_box)
    }
    if boxed.kind == 'enumeration' {
        var enum_box = small_object(boxed.name, 24)
        var stored_enum = LowIntermediaryRepresentation.Instructions.Store(enum_box, 16, converted.value, 'bits_64')
        emit(stored_enum)
        return counting.owned(enum_box)
    }
    if boxed.kind != 'scalar' {
        return converted
    }
    var box = small_object(boxed.name, 24)
    var stored = LowIntermediaryRepresentation.Instructions.Store(box, 16, converted.value, 'bits_64')
    emit(stored)
    return counting.owned(box)
}

func small_object(class_key: String, size: Integer): Integer {
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    var class_id = state.layout.class_id_of(class_key)
    allocated.class_id = class_id
    allocated.zeroed_bytes = size
    emit(allocated)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    return object
}

func filled_members(call: HighIntermediaryRepresentation.Values.ShapeCall): List<String> {
    var filled = List<String>()
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        filled.append("{filler.name}.{call.member.name}")
        filled.append("{filler.name}.get_{call.member.name}")
        index = index + 1
    }
    return filled
}

func lower_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall): Lowered {
    var counting = Counting(state)
    var calls = Calls(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var filled = filled_members(call)
    var receiver = lower_value(call.receiver)
    crash call.receiver
    calls.passed_on(receiver, call.receiver, filled)
    var arguments = List<Integer>()
    calls.add_arguments(arguments, call.arguments, filled)
    var target = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
    }
    var shared = shared_reading_filler(call)
    if shared {
        read_a_filling_attribute(call, shared, receiver.value, target, presence)
    } else {
        call_the_fillers(call, receiver.value, arguments, target, presence)
    }
    counting.release_the_pending()
    state.pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = counts_an_answer(call.value_type)
    return answer
}

func call_the_fillers(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    receiver: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, receiver, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        call_a_filler(call, filler, receiver, class_id, arguments, target, presence, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{call.shape.name}' here, at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

# ../../../spite_spec/specs/memory.md#the-memory-model
func is_a_shared_copy(call: HighIntermediaryRepresentation.Values.ShapeCall, filler: Model.Type): Boolean {
    var name = call.member.name
    fallback name == "copy" or name == "deep_copy" or name == "_deep_copy_in"
    if filler.kind == 'scalar' or filler.kind == 'enumeration' or filler.is_a_walked_name {
        return true
    }
    fallback filler.kind == 'object'
    if filler.name == "String" {
        return true
    }
    var filling_class = state.layout.program.class_named(filler.name)
    fallback filling_class
    return filling_class.is_singleton
}

func shared_reading_filler(call: HighIntermediaryRepresentation.Values.ShapeCall): Model.Type? {
    fallback call.arguments.is_empty()
    return shared_filler(call.shape.key, call.member.name)
}

func shared_filler(shape_key: String, member: String): Model.Type? {
    var shared = state.layout.shared_offset_of(shape_key, member)
    fallback shared >= 0
    var fillers = state.layout.program.fillers_of(shape_key)
    return fillers.first()
}

func call_a_filler(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    receiver: Integer,
    class_id: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
    after: Integer,
) {
    var counting = Counting(state)
    var filler_key = state.layout.box_key_of(filler)
    var wanted = state.layout.class_id_of(filler_key)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var calling = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, calling, next)
    emit(test)
    switch_to(calling)
    if is_a_shared_copy(call, filler) {
        counting.retain_counted(receiver, call.value_type)
        var shared = LowIntermediaryRepresentation.Instructions.Copy(target, receiver)
        emit(shared)
        jump_to(after)
        switch_to(next)
        return
    }
    var own = receiver
    var is_boxed = filler.kind == 'scalar' or filler.kind == 'enumeration' or filler.is_a_walked_name
    if is_boxed {
        own = new_register()
        var unboxed = LowIntermediaryRepresentation.Instructions.Load(own, receiver, 16, 'bits_64')
        emit(unboxed)
    }
    var is_named = filler.kind == 'enumeration' or filler.is_a_walked_name
    var lists_no_attributes = is_named and call.member.name == "_attribute_list"
    if lists_no_attributes {
        var nothing_held = constant(0)
        var none_given = List<Integer>()
        none_given.append(nothing_held)
        var listed = LowIntermediaryRepresentation.Instructions.Call(
            target,
            "Spite.Attribute._no_attributes",
            none_given,
        )
        emit(listed)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.is_a_walked_name {
        counting.retain(own)
        var symbol_name = Lowered(own, -1)
        symbol_name.owned = true
        if call.member.name == "to_debug" {
            symbol_name = quoted_enum_text(symbol_name)
        }
        var copied_symbol = LowIntermediaryRepresentation.Instructions.Copy(target, symbol_name.value)
        emit(copied_symbol)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.kind == 'enumeration' {
        var enumeration = enum_model_of(filler.name)
        var string_type = call.value_type
        var named = enum_text_of(own, enumeration, string_type)
        if call.member.name == "to_debug" {
            named = quoted_enum_text(named)
        }
        var copied_name = LowIntermediaryRepresentation.Instructions.Copy(target, named.value)
        emit(copied_name)
        jump_to(after)
        switch_to(next)
        return
    }
    if fills_with_an_attribute(call, filler) {
        read_a_filling_attribute(call, filler, own, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    check_own_class_arguments(call, filler, arguments)
    var passed = List<Integer>()
    passed.append(own)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        passed.append(argument)
        index = index + 1
    }
    var member_name = call.member.name
    var filling_class = state.layout.program.class_named(filler.name)
    if filling_class and member_name == "to_string" and not filling_class.function_named("to_string") {
        member_name = "to_debug"
    }
    if filling_class and call.member.is_an_attribute {
        member_name = "get_{member_name}"
    }
    var key = "{filler.name}.{member_name}"
    if state.resumable_mode and is_resumable(key) {
        var working = Working(this)
        working.waited_into(key, passed, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, passed)
    called.presence = presence
    emit(called)
    jump_to(after)
    switch_to(next)
}

func enum_model_of(enum_key: String): Model.EnumModel {
    var parts = enum_key.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.layout.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func check_own_class_arguments(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    arguments: List<Integer>,
) {
    var model = state.layout.program.class_named(filler.name)
    fallback model
    var filling = model.function_named(call.member.name)
    fallback filling
    var index = 0
    while index < filling.parameters.count() and index < arguments.count() {
        var parameter = filling.parameters[index]
        var wanted = call.member.parameters[index]
        var argument = arguments[index]
        var takes_its_own = parameter.parameter_type.name == filler.name and parameter.parameter_type.kind == 'object'
        if wanted and takes_its_own and wanted.parameter_type.kind == 'shape' {
            check_an_own_class(call, model, argument)
        }
        index = index + 1
    }
}

func check_an_own_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    argument: Integer,
) {
    var argument_class = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(argument_class, argument, 0, 'bits_64')
    emit(loaded)
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var other = fillers[index]
        if other.name != model.key {
            stop_on_another_class(call, model, other, argument_class)
        }
        index = index + 1
    }
}

func stop_on_another_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    other: Model.Type,
    argument_class: Integer,
) {
    var other_key = state.layout.box_key_of(other)
    var other_id = state.layout.class_id_of(other_key)
    var other_register = constant(other_id)
    var same = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(same, 'equal', argument_class, other_register)
    emit(compared)
    var stopping = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(same, stopping, next)
    emit(test)
    switch_to(stopping)
    var other_shown = other.name
    var other_model = state.layout.program.class_named(other.name)
    if other_model {
        other_shown = other_model.shown
    }
    var own_article = article_of(model.shown)
    var other_article = article_of(other_shown)
    var written = call.shown
    if written.is_empty() {
        written = "{call.shape.name}.{call.member.name}"
    }
    var label = text_label(
        "spite: '{written}' works in {own_article} {model.shown}, the class of its left side, and its right side is {other_article} {other_shown}, which is not one, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(next)
}

func fills_with_an_attribute(call: HighIntermediaryRepresentation.Values.ShapeCall, filler: Model.Type): Boolean {
    var model = state.layout.program.class_named(filler.name)
    if not model {
        return call.member.is_an_attribute
    }
    if model.attribute_named(call.member.name) {
        return call.member.is_an_attribute or call.arguments.is_empty()
    }
    return false
}

func read_a_filling_attribute(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    object: Integer,
    target: Integer,
    presence: Integer,
) {
    var counting = Counting(state)
    var values = Values(state)
    var model = state.layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(call.member.name)
    crash attribute
    var loaded = values.load_attribute(object, attribute)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, loaded.value)
    emit(copied)
    if is_a_pointer(call.value_type) and not loaded.owned {
        counting.retain(target)
    }
    if presence >= 0 {
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, loaded.presence)
        emit(copied_presence)
    }
}

func quoted_enum_text(named: Lowered): Lowered {
    var counting = Counting(state)
    var values = Values(state)
    var quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var opening = values.lower_text(quote)
    var arguments = List<Integer>()
    arguments.append(opening.value)
    arguments.append(named.value)
    var joined = new_register()
    var summed = LowIntermediaryRepresentation.Instructions.Call(joined, "String.sum", arguments)
    emit(summed)
    counting.release(opening.value)
    counting.release(named.value)
    var closing_quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var closing = values.lower_text(closing_quote)
    var closing_arguments = List<Integer>()
    closing_arguments.append(joined)
    closing_arguments.append(closing.value)
    var finished = new_register()
    var closed = LowIntermediaryRepresentation.Instructions.Call(finished, "String.sum", closing_arguments)
    emit(closed)
    counting.release(joined)
    counting.release(closing.value)
    return counting.owned(finished)
}

func decimal_converted(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    if from_type.name == "UnsignedLong" {
        return unsigned_long_into_decimal(source, to_type)
    }
    if to_type.name == "UnsignedLong" {
        return decimal_into_unsigned_long(source, from_type)
    }
    return plain_decimal_conversion(source, from_type, to_type)
}

func unsigned_long_into_decimal(source: Integer, to_type: Model.Type): Lowered {
    var long_type = Model.Type('scalar', "Long")
    var target = new_register()
    var zero = constant(0)
    var is_small = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_small, 'greater_or_equal', source, zero)
    compared.is_signed = true
    emit(compared)
    var small = new_block()
    var large = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_small, small, large)
    emit(test)
    switch_to(small)
    var direct = plain_decimal_conversion(source, long_type, to_type)
    var copied_direct = LowIntermediaryRepresentation.Instructions.Copy(target, direct.value)
    emit(copied_direct)
    jump_to(after)
    switch_to(large)
    var one = constant(1)
    var half = unchecked_bits(source, 'shift_right', one, false)
    var lowest = unchecked_bits(source, 'bits_and', one, false)
    var sticky = unchecked_bits(half, 'bits_or', lowest, false)
    var halved = plain_decimal_conversion(sticky, long_type, to_type)
    var doubled = new_register()
    var adding = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        doubled,
        'add',
        halved.value,
        halved.value,
    )
    adding.is_double = to_type.name == "Double"
    emit(adding)
    var copied_doubled = LowIntermediaryRepresentation.Instructions.Copy(target, doubled)
    emit(copied_doubled)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func decimal_into_unsigned_long(source: Integer, from_type: Model.Type): Lowered {
    var long_type = Model.Type('scalar', "Long")
    var double_type = Model.Type('scalar', "Double")
    var wide = source
    if from_type.name == "Float" {
        var widened = plain_decimal_conversion(source, from_type, double_type)
        wide = widened.value
    }
    var target = new_register()
    var top_bits = double_bits_of_power(63)
    var top = constant(top_bits)
    var is_small = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_small, 'less', wide, top)
    emit(compared)
    var small = new_block()
    var large = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_small, small, large)
    emit(test)
    switch_to(small)
    var direct = plain_decimal_conversion(wide, double_type, long_type)
    var copied_direct = LowIntermediaryRepresentation.Instructions.Copy(target, direct.value)
    emit(copied_direct)
    jump_to(after)
    switch_to(large)
    var taken_off = new_register()
    var taking = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(taken_off, 'subtract', wide, top)
    emit(taking)
    var converted = plain_decimal_conversion(taken_off, double_type, long_type)
    var top_bit: Long = -_largest_long - 1
    var bit = constant(top_bit)
    var restored = unchecked_bits(converted.value, 'bits_xor', bit, false)
    var copied_restored = LowIntermediaryRepresentation.Instructions.Copy(target, restored)
    emit(copied_restored)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func unchecked_bits(
    left: Integer,
    operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator,
    right: Integer,
    compares_signed: Boolean,
): Integer {
    var target = new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.width = 'bits_64'
    computed.is_signed = compares_signed
    computed.is_checked = false
    emit(computed)
    return target
}

func check_the_float_range(value: Integer, from_type: Model.Type) {
    fallback from_type.name == "Double"
    var largest_float: Long = _largest_float_as_double_bits
    var infinity: Long = _infinity_as_double_bits
    var negative_largest: Long = largest_float - _largest_long - 1
    var negative_infinity: Long = infinity - _largest_long - 1
    var message = "spite: a Double beyond 3.4028235e+38, the largest Float, does not fit in a Float, at {state.path}:{state.line} in {state.function.key}\n"
    float_stop_between(value, 'greater', largest_float, 'less', infinity, message)
    float_stop_between(value, 'less', negative_largest, 'greater', negative_infinity, message)
}

func float_stop_between(
    value: Integer,
    past: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit_bits: Long,
    within: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    end_bits: Long,
    message: String,
) {
    var limit = constant(limit_bits)
    var is_past = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_past, past, value, limit)
    emit(compared)
    var testing_the_end = new_block()
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_past, testing_the_end, after)
    emit(test)
    switch_to(testing_the_end)
    var end = constant(end_bits)
    var is_finite = new_register()
    var compared_end = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_finite, within, value, end)
    emit(compared_end)
    var end_test = LowIntermediaryRepresentation.Instructions.Branch(is_finite, stopping, after)
    emit(end_test)
    switch_to(stopping)
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func plain_decimal_conversion(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    var target = new_register()
    var converting = LowIntermediaryRepresentation.Instructions.Decimal.Conversion(target, source)
    var from_scalar = state.scalars.of(from_type.name)
    var to_scalar = state.scalars.of(to_type.name)
    crash from_scalar
    crash to_scalar
    if from_scalar.is_decimal {
        converting.from_decimal_size = from_scalar.size
    } else {
        converting.whole_is_signed = from_scalar.is_signed
        converting.whole_width = width_of(from_type)
    }
    if to_scalar.is_decimal {
        converting.to_decimal_size = to_scalar.size
    } else {
        converting.whole_is_signed = to_scalar.is_signed
        converting.whole_width = width_of(to_type)
    }
    emit(converting)
    return single(target)
}

func check_the_decimal_range(value: Integer, from_type: Model.Type, to_type: Model.Type) {
    var to_scalar = state.scalars.of(to_type.name)
    crash to_scalar
    var wide = value
    if from_type.name == "Float" {
        var double_type = Model.Type('scalar', "Double")
        var widened = decimal_converted(value, from_type, double_type)
        wide = widened.value
    }
    var lowest_bits = decimal_bits_of(to_scalar.smallest)
    crash not to_scalar.largest.starts_with("-")
    var above = state.scalars.increased(to_scalar.largest)
    var above_bits = decimal_bits_of(above)
    var article = article_of(to_type.name)
    var from_article = article_of(from_type.name)
    var message = ", {from_article} {from_type.name}, does not fit in {article} {to_type.name}, at {state.path}:{state.line} in {state.function.key}\n"
    decimal_stop_unless(wide, 'greater_or_equal', lowest_bits, message)
    decimal_stop_unless(wide, 'less', above_bits, message)
}

func decimal_bits_of(bound: String): Long {
    var read: Double? = bound
    crash read
    return read.bits()
}

func double_bits_of_power(bits: Integer): Long {
    var exponent: Long = _double_exponent_bias + bits
    return exponent.shifted_left(52)
}

func decimal_stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit_bits: Long,
    message: String,
) {
    var bound = constant(limit_bits)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(fits, comparison, value, bound)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var long_bits = double_bits_of_power(63)
    var lowest_long: Long = long_bits - _largest_long - 1
    var numbered = new_block()
    var unnumbered = new_block()
    var past_the_low = new_block()
    var above_the_low = new_register()
    var low_bound = constant(lowest_long)
    var compared_low = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        above_the_low,
        'greater_or_equal',
        value,
        low_bound,
    )
    emit(compared_low)
    var low_test = LowIntermediaryRepresentation.Instructions.Branch(above_the_low, past_the_low, unnumbered)
    emit(low_test)
    switch_to(past_the_low)
    var below_the_high = new_register()
    var high_bound = constant(long_bits)
    var compared_high = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        below_the_high,
        'less',
        value,
        high_bound,
    )
    emit(compared_high)
    var high_test = LowIntermediaryRepresentation.Instructions.Branch(below_the_high, numbered, unnumbered)
    emit(high_test)
    switch_to(numbered)
    var double_type = Model.Type('scalar', "Double")
    var long_type = Model.Type('scalar', "Long")
    var whole = decimal_converted(value, double_type, long_type)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(whole.value)
    stopped.signed_numbers.append(1)
    emit(stopped)
    switch_to(unnumbered)
    var unnumbered_label = text_label("spite: a value that is not a number, or outside every whole number{message}")
    var stopped_unnumbered = LowIntermediaryRepresentation.Instructions.Stop(unnumbered_label)
    emit(stopped_unnumbered)
    switch_to(after)
}

# ../../../spite_spec/specs/values_and_types.md#casting
func check_the_range(value: Integer, given: Model.Type, wanted: Model.Type) {
    var given_scalar = state.scalars.of(given.name)
    var wanted_scalar = state.scalars.of(wanted.name)
    crash given_scalar
    crash wanted_scalar
    var given_article = article_of(given.name)
    var wanted_article = article_of(wanted.name)
    var message = ", {given_article} {given.name}, does not fit in {wanted_article} {wanted.name}, at {state.path}:{state.line} in {state.function.key}\n"
    if state.scalars.is_below(given_scalar.smallest, wanted_scalar.smallest) {
        var lowest = whole_bound_of(wanted_scalar.smallest)
        stop_unless(value, 'greater_or_equal', lowest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
    if state.scalars.is_below(wanted_scalar.largest, given_scalar.largest) {
        var highest = whole_bound_of(wanted_scalar.largest)
        stop_unless(value, 'less_or_equal', highest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
}

func whole_bound_of(bound: String): Long {
    var read: Long? = bound
    crash read
    return read
}

func stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit: Long,
    compares_signed: Boolean,
    message: String,
    value_is_signed: Boolean,
) {
    var bound = constant(limit)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(fits, comparison, value, bound)
    compared.is_signed = compares_signed
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(value)
    var sign = 0
    if value_is_signed {
        sign = 1
    }
    stopped.signed_numbers.append(sign)
    emit(stopped)
    switch_to(after)
}

func article_of(name: String): String {
    var first = name.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func made_nullable(converted: Lowered, nullable_type: Model.Type): Lowered {
    if not is_a_nullable_scalar(nullable_type) {
        return carried(converted)
    }
    var present = constant(1)
    return Lowered(converted.value, present)
}

func decimal_size_of(of_type: Model.Type): Integer {
    fallback is_a_decimal(of_type)
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func storage_of(buffer: Integer): Integer {
    var storage = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(
        storage,
        buffer,
        state.layout.storage_offset,
        'bits_64',
    )
    loaded.region = "Buffer.$storage"
    emit(loaded)
    return storage
}

# ../../OPTIMIZATIONS.md#an-attribute-a-loop-only-reads-is-read-before-it
func items_region_of(owner_key: String, element: Model.Type): String {
    if element.kind == 'scalar' or element.kind == 'enumeration' {
        return "{owner_key}.[]"
    }
    return ""
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func width_of(of_type: Model.Type): LowIntermediaryRepresentation.Instructions.Load.Width {
    if of_type.kind != 'scalar' {
        return 'bits_64'
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    if scalar.size == 1 {
        return 'bits_8'
    } else if scalar.size == 2 {
        return 'bits_16'
    } else if scalar.size == 4 {
        return 'bits_32'
    } else {
        return 'bits_64'
    }
}

func is_signed(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return true
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_signed and not scalar.is_decimal
}

var no_program = Model.ProgramModel()
var layout = Layout(no_program)
var program = LowIntermediaryRepresentation.LowProgram()
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var current = 0
var terminated = false
var locals = Dictionary<String, Integer>()
var local_presences = Dictionary<String, Integer>()
var scalars = Model.Scalars()
var path = ""
var line = 0
var singleton_slots = Dictionary<String, Integer>()
var scopes = List<List<Integer>>()
var pending_releases = List<Integer>()

func FunctionLowering(
    starting_layout: Layout,
    starting_program: LowIntermediaryRepresentation.LowProgram,
    starting_slots: Dictionary<String, Integer>,
) {
    layout = starting_layout
    program = starting_program
    singleton_slots = starting_slots
}

func lowered(
    high: HighIntermediaryRepresentation.HighFunction,
    starting_path: String,
): LowIntermediaryRepresentation.LowFunction {
    path = starting_path
    var key = high.function.key()
    start(key)
    var this_register = new_register()
    locals["this"] = this_register
    scopes = List<List<Integer>>()
    var held = List<Integer>()
    scopes.append(held)
    high.function.parameters.each(take_parameter)
    function.parameter_count = function.register_count
    high.function.parameters.each(hold_a_parameter)
    lower_block(high.body)
    if not terminated {
        release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
    }
    return function
}

func start(key: String) {
    function = LowIntermediaryRepresentation.LowFunction(key, 0)
    locals = Dictionary<String, Integer>()
    local_presences = Dictionary<String, Integer>()
    var first = new_block()
    switch_to(first)
}

func take_parameter(parameter: Model.ParameterModel) {
    var value = new_register()
    locals[parameter.name] = value
    if is_a_nullable_scalar(parameter.parameter_type) {
        var presence = new_register()
        local_presences[parameter.name] = presence
    }
}

func hold_a_parameter(parameter: Model.ParameterModel) {
    assert is_a_pointer(parameter.parameter_type)
    var register = locals[parameter.name]
    crash register
    retain(register)
    hold(register)
}

func is_a_pointer(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'handle' {
        crash of_type.answer
        var answer: Model.Type = of_type.answer
        return is_a_pointer(answer)
    }
    return kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
}

func owned(register: Integer): Lowered {
    var made = Lowered(register, -1)
    made.owned = true
    return made
}

func retain(register: Integer) {
    var retained = LowIntermediaryRepresentation.Instructions.Retain(register)
    emit(retained)
}

func release(register: Integer) {
    var arguments = List<Integer>()
    arguments.append(register)
    var released = LowIntermediaryRepresentation.Instructions.Call(-1, "_release", arguments)
    emit(released)
}

func kept(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and not value.owned {
        retain(value.value)
    }
}

func release_later(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and value.owned {
        pending_releases.append(value.value)
    }
}

func release_the_pending() {
    pending_releases.each(release)
    pending_releases = List<Integer>()
}

func discard(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and value.owned {
        release(value.value)
    }
}

func hold(register: Integer) {
    var innermost = scopes.last()
    crash innermost
    innermost.append(register)
}

func release_every_scope() {
    var index = scopes.count() - 1
    while index >= 0 {
        var scope = scopes[index]
        crash scope
        scope.each(release)
        index = index - 1
    }
}

func new_register(): Integer {
    var made = function.register_count
    function.register_count = made + 1
    return made
}

func new_block(): Integer {
    var made = LowIntermediaryRepresentation.LowBlock()
    function.blocks.append(made)
    return function.blocks.count() - 1
}

func switch_to(block: Integer) {
    current = block
    terminated = false
}

func emit(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if terminated {
        var unreachable = new_block()
        switch_to(unreachable)
    }
    var block = function.blocks[current]
    crash block
    block.instructions.append(instruction)
    var ends = instruction == LowIntermediaryRepresentation.Instructions.Jump
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Branch
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Return
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Stop
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Exit
    terminated = ends
}

func jump_to(block: Integer) {
    if not terminated {
        var jump = LowIntermediaryRepresentation.Instructions.Jump(block)
        emit(jump)
    }
}

func constant(number: Long): Integer {
    var target = new_register()
    var made = LowIntermediaryRepresentation.Instructions.Constant(target, number)
    emit(made)
    return target
}

func data_label(bytes: Buffer): Integer {
    program.data.append(bytes)
    return program.data.count() - 1
}

func text_label(text: String): Integer {
    var bytes = text.to_bytes()
    return data_label(bytes)
}

func lower_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    crash block
    var held = List<Integer>()
    scopes.append(held)
    block.statements.each(lower_statement)
    if not terminated {
        held.each(release)
    }
    var last = scopes.count() - 1
    scopes.remove_at(last)
}

func lower_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: lower_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.AssignThroughShape: lower_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: lower_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: lower_while(statement)
        HighIntermediaryRepresentation.Statements.Return: lower_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: lower_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: lower_block(statement)
    }
}

func lower_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    line = declare.line
    var value = lower_value(declare.value)
    var register = new_register()
    locals[declare.name] = register
    kept(value, declare.declared_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    emit(copied)
    if is_a_pointer(declare.declared_type) {
        hold(register)
    }
    if is_a_nullable_scalar(declare.declared_type) {
        var presence = new_register()
        local_presences[declare.name] = presence
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
        emit(copied_presence)
    }
}

func lower_assign(assign: HighIntermediaryRepresentation.Statements.Assign) {
    line = assign.line
    var value = lower_value(assign.value)
    var register = locals[assign.name]
    crash register
    crash assign.value
    var assigned_type = assign.value.value_type
    kept(value, assigned_type)
    var old = new_register()
    var saved = LowIntermediaryRepresentation.Instructions.Copy(old, register)
    emit(saved)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    emit(copied)
    if is_a_pointer(assigned_type) {
        release(old)
    }
    var presence = local_presences[assign.name]
    assert presence
    var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
    emit(copied_presence)
}

func lower_assign_attribute(assign: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    line = assign.line
    var object = lower_value(assign.object)
    var value = lower_value(assign.value)
    var offset = layout.offset_of(assign.attribute)
    var attribute_type = assign.attribute.attribute_type
    var width = width_of(attribute_type)
    kept(value, attribute_type)
    var old = new_register()
    if is_a_pointer(attribute_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object.value, offset, 'bits_64')
        emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object.value, offset, value.value, width)
    emit(stored)
    if is_a_pointer(attribute_type) {
        release(old)
    }
    crash assign.object
    discard(object, assign.object.value_type)
    if is_a_nullable_scalar(assign.attribute.attribute_type) {
        var presence_offset = offset + 8
        var stored_presence = LowIntermediaryRepresentation.Instructions.Store(
            object.value,
            presence_offset,
            value.presence,
            'bits_64',
        )
        emit(stored_presence)
    }
}

func lower_assign_through_shape(assign: HighIntermediaryRepresentation.Statements.AssignThroughShape) {
    line = assign.line
    var object = lower_value(assign.object)
    var value = lower_value(assign.value)
    crash assign.value
    var value_type = assign.value.value_type
    kept(value, value_type)
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, object.value, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = layout.program.fillers_of(assign.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        store_in_a_filler(filler, assign.member, object.value, class_id, value, value_type, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{assign.shape.name}' here, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func store_in_a_filler(
    filler: Model.Type,
    member: String,
    object: Integer,
    class_id: Integer,
    value: Lowered,
    value_type: Model.Type,
    after: Integer,
) {
    var model = layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(member)
    crash attribute
    var wanted = layout.class_id_of(filler.name)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var storing = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, storing, next)
    emit(test)
    switch_to(storing)
    var offset = layout.offset_of(attribute)
    var width = width_of(attribute.attribute_type)
    var old = new_register()
    if is_a_pointer(value_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
        emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, width)
    emit(stored)
    if is_a_pointer(value_type) {
        release(old)
    }
    jump_to(after)
    switch_to(next)
}

func lower_evaluate(evaluate: HighIntermediaryRepresentation.Statements.Evaluate) {
    line = evaluate.line
    var value = lower_value(evaluate.value)
    crash evaluate.value
    discard(value, evaluate.value.value_type)
}

func lower_if(branch: HighIntermediaryRepresentation.Statements.If) {
    line = branch.line
    var condition = lower_value(branch.condition)
    crash branch.condition
    discard(condition, branch.condition.value_type)
    var then_block = new_block()
    var after = new_block()
    var else_block = after
    if branch.else_branch {
        else_block = new_block()
    }
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, then_block, else_block)
    emit(test)
    switch_to(then_block)
    lower_block(branch.then_branch)
    jump_to(after)
    if branch.else_branch {
        switch_to(else_block)
        lower_block(branch.else_branch)
        jump_to(after)
    }
    switch_to(after)
}

func lower_while(loop: HighIntermediaryRepresentation.Statements.While) {
    line = loop.line
    var header = new_block()
    var body = new_block()
    var after = new_block()
    jump_to(header)
    switch_to(header)
    var condition = lower_value(loop.condition)
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, body, after)
    emit(test)
    switch_to(body)
    lower_block(loop.body)
    jump_to(header)
    switch_to(after)
}

func lower_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    line = returned.line
    if not returned.value {
        release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
        return
    }
    var value = lower_value(returned.value)
    var returned_type = returned.value.value_type
    kept(value, returned_type)
    release_every_scope()
    var made = LowIntermediaryRepresentation.Instructions.Return(value.value)
    made.presence = value.presence
    emit(made)
}

func lower_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    var label = text_label("{stop.message}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
}

func lower_value(value: HighIntermediaryRepresentation.Values.Value?): Lowered {
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return lower_whole_number(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return lower_decimal_number(value)
        HighIntermediaryRepresentation.Values.TextConstant: return lower_text(value)
        HighIntermediaryRepresentation.Values.NullConstant: return lower_null()
        HighIntermediaryRepresentation.Values.LocalRead: return lower_local(value)
        HighIntermediaryRepresentation.Values.ThisRead: return lower_this()
        HighIntermediaryRepresentation.Values.AttributeRead: return lower_attribute(value)
        HighIntermediaryRepresentation.Values.Call: return lower_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: return lower_make_object(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return lower_operation(value)
        HighIntermediaryRepresentation.Values.Negation: return lower_negation(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return lower_foreign_call(value)
        HighIntermediaryRepresentation.Values.ClassTest: return lower_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return lower_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: return lower_conversion(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return lower_number_room(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return lower_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: return lower_enum_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return lower_enum_from_text(value)
        HighIntermediaryRepresentation.Values.ClassObject: return lower_class_object(value)
        HighIntermediaryRepresentation.Values.ClassOfValue: return lower_class_of_value(value)
        HighIntermediaryRepresentation.Values.FunctionValue: return lower_function_value(value)
        HighIntermediaryRepresentation.Values.FunctionValueCall: return lower_function_value_call(value)
    }
}

func lower_whole_number(number: HighIntermediaryRepresentation.Values.WholeNumber): Lowered {
    var register = constant(number.number)
    return single(register)
}

func lower_decimal_number(number: HighIntermediaryRepresentation.Values.DecimalNumber): Lowered {
    var bits: Long = 0
    if number.value_type.name == "Float" {
        var parsed_float = number.written.to_float()
        crash parsed_float
        bits = parsed_float.bits()
    } else {
        var parsed = number.written.to_double()
        crash parsed
        bits = parsed.bits()
    }
    var register = constant(bits)
    return single(register)
}

func single(register: Integer): Lowered {
    return Lowered(register, -1)
}

func lower_null(): Lowered {
    var zero = constant(0)
    var absent = constant(0)
    return Lowered(zero, absent)
}

func lower_this(): Lowered {
    var this_register = locals["this"]
    crash this_register
    return single(this_register)
}

func lower_local(read: HighIntermediaryRepresentation.Values.LocalRead): Lowered {
    var register = locals[read.name]
    crash register
    var presence = local_presences[read.name]
    if presence and read.value_type.is_nullable {
        return Lowered(register, presence)
    }
    return single(register)
}

func lower_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead): Lowered {
    var object = lower_value(read.object)
    return load_attribute(object.value, read.attribute)
}

func load_attribute(object_register: Integer, attribute: Model.AttributeModel): Lowered {
    var object = single(object_register)
    var offset = layout.offset_of(attribute)
    var attribute_type = attribute.attribute_type
    var target = new_register()
    var width = width_of(attribute_type)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(target, object.value, offset, width)
    loaded.is_signed = is_signed(attribute_type)
    emit(loaded)
    if not is_a_nullable_scalar(attribute_type) {
        return single(target)
    }
    var presence = new_register()
    var presence_offset = offset + 8
    var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(
        presence,
        object.value,
        presence_offset,
        'bits_64',
    )
    emit(loaded_presence)
    return Lowered(target, presence)
}

func lower_text(text: HighIntermediaryRepresentation.Values.TextConstant): Lowered {
    var string_type = text.value_type
    var made = make_object(string_type.name)
    var label = text_label(text.text)
    var made_text = owned(made)
    var bytes = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(bytes, label)
    emit(addressed)
    var length = text.text.length()
    var index = 0
    while index < length {
        var offset_register = constant(index)
        var code = load_byte(bytes, offset_register)
        var arguments = List<Integer>()
        arguments.append(made)
        arguments.append(code)
        var appended = LowIntermediaryRepresentation.Instructions.Call(-1, "String.append_code", arguments)
        emit(appended)
        index = index + 1
    }
    return made_text
}

func load_byte(base: Integer, offset_register: Integer): Integer {
    var address = address_plus(base, offset_register)
    var target = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(target, address, 0, 'bits_8')
    loaded.is_signed = false
    emit(loaded)
    return target
}

func address_plus(base: Integer, offset_register: Integer): Integer {
    var target = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'add', base, offset_register)
    added.is_signed = false
    added.is_checked = false
    emit(added)
    return target
}

func lower_make_object(made: HighIntermediaryRepresentation.Values.MakeObject): Lowered {
    var class_key = made.value_type.name
    var made_model = layout.program.class_named(class_key)
    crash made_model
    if made_model.is_singleton {
        var singleton = singleton_of(class_key, made)
        return single(singleton)
    }
    var object = make_object(class_key)
    call_the_constructor(object, made)
    return owned(object)
}

func make_object(class_key: String): Integer {
    var size = layout.size_of(class_key)
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    emit(allocated)
    var class_id = layout.class_id_of(class_key)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    var arguments = List<Integer>()
    arguments.append(object)
    var defaults = LowIntermediaryRepresentation.Instructions.Call(-1, "{class_key}._attribute_defaults", arguments)
    emit(defaults)
    return object
}

func call_the_constructor(object: Integer, made: HighIntermediaryRepresentation.Values.MakeObject) {
    assert made.constructor
    var constructor_key = made.constructor.key()
    var outer = pending_releases
    pending_releases = List<Integer>()
    var arguments = List<Integer>()
    arguments.append(object)
    add_arguments(arguments, made.arguments)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, constructor_key, arguments)
    emit(called)
    release_the_pending()
    pending_releases = outer
}

func singleton_of(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var object = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    emit(loaded)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    emit(compared)
    var making = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, making, after)
    emit(test)
    switch_to(making)
    var fresh = make_object(class_key)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    call_the_constructor(fresh, made)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(object, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    return object
}

func slot_label_of(class_key: String): Integer {
    var known = singleton_slots[class_key]
    if known {
        return known
    }
    var empty = Buffer()
    var index = 0
    while index < 8 {
        empty.append(0)
        index = index + 1
    }
    var label = data_label(empty)
    singleton_slots[class_key] = label
    return label
}

func add_arguments(arguments: List<Integer>, values: List<HighIntermediaryRepresentation.Values.Value>) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        var argument_value = lower_value(value)
        release_later(argument_value, value.value_type)
        arguments.append(argument_value.value)
        if argument_value.presence >= 0 {
            arguments.append(argument_value.presence)
        }
        index = index + 1
    }
}

func lower_call(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var intrinsic = Intrinsics(this)
    if not call.function.has_a_body() {
        return intrinsic.lowered(call)
    }
    var outer = pending_releases
    pending_releases = List<Integer>()
    var arguments = List<Integer>()
    var receiver = lower_value(call.receiver)
    crash call.receiver
    release_later(receiver, call.receiver.value_type)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments)
    var answer = finished_call(call, arguments)
    release_the_pending()
    pending_releases = outer
    return answer
}

func finished_call(call: HighIntermediaryRepresentation.Values.Call, arguments: List<Integer>): Lowered {
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var function_key = call.function.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, function_key, arguments)
    if is_a_nullable_scalar(call.value_type) {
        var presence = new_register()
        called.presence = presence
        emit(called)
        return Lowered(target, presence)
    }
    emit(called)
    if is_a_pointer(call.value_type) {
        return owned(target)
    }
    return single(target)
}

func lower_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    if operation.operator == 'and' or operation.operator == 'or' {
        return lower_logic(operation)
    }
    var left = lower_value(operation.left)
    var right = lower_value(operation.right)
    var target = new_register()
    crash operation.left
    var operand_type = operation.left.value_type
    var comparison = comparison_of(operation.operator)
    if is_a_decimal(operand_type) {
        return decimal_operation(operation, operand_type, left.value, right.value, target)
    }
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.Compare(target, comparison, left.value, right.value)
        compared.is_signed = is_signed(operand_type)
        emit(compared)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(
        target,
        arithmetic_operator,
        left.value,
        right.value,
    )
    computed.width = width_of(operand_type)
    computed.is_signed = is_signed(operand_type)
    computed.line = line
    computed.shown = operation.shown
    computed.type_name = operand_type.name
    computed.path = path
    emit(computed)
    return single(target)
}

func is_a_decimal(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return false
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_operation(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    operand_type: Model.Type,
    left: Integer,
    right: Integer,
    target: Integer,
): Lowered {
    var is_double = operand_type.name == "Double"
    var comparison = comparison_of(operation.operator)
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.DecimalCompare(target, comparison, left, right)
        compared.is_double = is_double
        emit(compared)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    if arithmetic_operator == 'remainder' {
        return unbuilt()
    }
    var computed = LowIntermediaryRepresentation.Instructions.DecimalArithmetic(
        target,
        arithmetic_operator,
        left,
        right,
    )
    computed.is_double = is_double
    emit(computed)
    return single(target)
}

func lower_logic(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    var target = new_register()
    var left = lower_value(operation.left)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, left.value)
    emit(copied)
    var right_block = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(left.value, right_block, after)
    if operation.operator == 'or' {
        test = LowIntermediaryRepresentation.Instructions.Branch(left.value, after, right_block)
    }
    emit(test)
    switch_to(right_block)
    var right = lower_value(operation.right)
    var copied_right = LowIntermediaryRepresentation.Instructions.Copy(target, right.value)
    emit(copied_right)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func comparison_of(
    operator: HighIntermediaryRepresentation.Values.Operator,
): LowIntermediaryRepresentation.Comparison? {
    switch operator {
        'equal': return 'equal'
        'not_equal': return 'not_equal'
        'less': return 'less'
        'less_or_equal': return 'less_or_equal'
        'greater': return 'greater'
        'greater_or_equal': return 'greater_or_equal'
        _: return null
    }
}

func arithmetic_of(
    operator: HighIntermediaryRepresentation.Values.Operator,
): LowIntermediaryRepresentation.ArithmeticOperator {
    switch operator {
        'add': return 'add'
        'subtract': return 'subtract'
        'multiply': return 'multiply'
        'divide': return 'divide'
        _: return 'remainder'
    }
}

func lower_negation(negation: HighIntermediaryRepresentation.Values.Negation): Lowered {
    var negated = lower_value(negation.negated)
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', negated.value, zero)
    emit(compared)
    return single(target)
}

func lower_class_test(test: HighIntermediaryRepresentation.Values.ClassTest): Lowered {
    var tested = lower_value(test.tested)
    crash test.tested
    release_later(tested, test.tested.value_type)
    var target = new_register()
    var zero = constant(0)
    var present = new_register()
    var compared_present = LowIntermediaryRepresentation.Instructions.Compare(present, 'not_equal', tested.value, zero)
    emit(compared_present)
    var reading = new_block()
    var after = new_block()
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, present)
    emit(copied)
    var branched = LowIntermediaryRepresentation.Instructions.Branch(present, reading, after)
    emit(branched)
    switch_to(reading)
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, tested.value, 0, 'bits_64')
    emit(loaded)
    var wanted = layout.class_id_of(test.member.name)
    var wanted_register = constant(wanted)
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', class_id, wanted_register)
    emit(compared)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func lower_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest): Lowered {
    var tested = lower_value(test.tested)
    crash test.tested
    release_later(tested, test.tested.value_type)
    if tested.presence >= 0 {
        return single(tested.presence)
    }
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'not_equal', tested.value, zero)
    emit(compared)
    return single(target)
}

func lower_number_room(room: HighIntermediaryRepresentation.Values.NumberRoom): Lowered {
    var made = lower_value(room.made)
    var number = lower_value(room.number)
    var storage = storage_of(made.value)
    crash room.number
    var width = width_of(room.number.value_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(storage, 0, number.value, width)
    emit(stored)
    var buffer_model = layout.program.class_named("Buffer")
    crash buffer_model
    var count_attribute = buffer_model.attribute_named("item_count")
    crash count_attribute
    var count_offset = layout.offset_of(count_attribute)
    var counted = constant(room.width)
    var count_stored = LowIntermediaryRepresentation.Instructions.Store(made.value, count_offset, counted, 'bits_32')
    emit(count_stored)
    return owned(made.value)
}

func lower_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    var converted = lower_value(conversion.converted)
    if conversion.kind == 'nullable' {
        return made_nullable(converted, conversion.value_type)
    }
    if conversion.kind == 'into_shape' {
        crash conversion.converted
        var boxed = conversion.converted.value_type
        return boxed_into_a_shape(converted, boxed)
    }
    crash conversion.converted
    var from_type = conversion.converted.value_type
    if conversion.kind == 'widen' and is_a_decimal(from_type) {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_decimal' or conversion.kind == 'narrow_decimal' {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_whole' {
        check_the_decimal_range(converted.value, from_type, conversion.value_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'unbox' {
        var unboxed = new_register()
        var loaded_box = LowIntermediaryRepresentation.Instructions.Load(unboxed, converted.value, 16, 'bits_64')
        emit(loaded_box)
        return single(unboxed)
    }
    if conversion.kind == 'proven' {
        stop_if_missing(converted, conversion.shown)
        return carried(converted)
    }
    if conversion.kind == 'narrow' {
        check_the_range(converted.value, from_type, conversion.value_type)
    }
    return carried(converted)
}

func carried(converted: Lowered): Lowered {
    var made = Lowered(converted.value, -1)
    made.owned = converted.owned
    return made
}

func stop_if_missing(converted: Lowered, shown: String) {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' is outside its list: a bound proves only the top of an index, and this one is below 0 or the list changed, at {path}:{line} in {function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func lower_class_object(object: HighIntermediaryRepresentation.Values.ClassObject): Lowered {
    var kind = object.reflection_kind
    var slot_key = "{kind}:{object.described}"
    var label = slot_label_of(slot_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var made = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(made, slot, 0, 'bits_64')
    emit(loaded)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', made, zero)
    emit(compared)
    var making = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, making, after)
    emit(test)
    switch_to(making)
    var fresh = make_object(kind)
    var name_text = HighIntermediaryRepresentation.Values.TextConstant(object.described)
    var parts = object.described.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    name_text.text = simple
    var name = lower_text(name_text)
    var constructor_arguments = List<Integer>()
    constructor_arguments.append(fresh)
    constructor_arguments.append(name.value)
    var simple_kind = kind.split(".")
    var kind_last = simple_kind.count() - 1
    var constructor_name = simple_kind[kind_last]
    crash constructor_name
    if kind == "Spite.Namespace" {
        constructor_arguments.append(name.value)
    }
    var constructed = LowIntermediaryRepresentation.Instructions.Call(
        -1,
        "{kind}.{constructor_name}",
        constructor_arguments,
    )
    emit(constructed)
    release(name.value)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    var fill_arguments = List<Integer>()
    fill_arguments.append(fresh)
    var filled = LowIntermediaryRepresentation.Instructions.Call(-1, "{kind}._fill_{object.described}", fill_arguments)
    emit(filled)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(made, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    return single(made)
}

func lower_class_of_value(made: HighIntermediaryRepresentation.Values.ClassOfValue): Lowered {
    var described = lower_value(made.described)
    var target = new_register()
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, described.value, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var index = 0
    while index < made.candidates.count() {
        var candidate = made.candidates[index]
        var wanted = layout.class_id_of(candidate)
        var wanted_register = constant(wanted)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var object = HighIntermediaryRepresentation.Values.ClassObject(made.value_type, candidate)
        var lowered_object = lower_class_object(object)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_object.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value of no class this program knows, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    crash made.described
    discard(described, made.described.value_type)
    return single(target)
}

func lower_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var text = lower_value(read.text)
    var target = new_register()
    var presence = new_register()
    var zero = constant(0)
    var absent = LowIntermediaryRepresentation.Instructions.Copy(presence, zero)
    emit(absent)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var number = read.enumeration.numbers[index]
        crash number
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        release(lowered_name.value)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var value = constant(number)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, value)
        emit(copied)
        var one = constant(1)
        var present = LowIntermediaryRepresentation.Instructions.Copy(presence, one)
        emit(present)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    discard(text, read.text.value_type)
    return Lowered(target, presence)
}

func lower_enum_text(text: HighIntermediaryRepresentation.Values.EnumText): Lowered {
    var number = lower_value(text.number)
    return enum_text_of(number.value, text.enumeration, text.value_type)
}

func enum_text_of(number: Integer, enumeration: Model.EnumModel, string_type: Model.Type): Lowered {
    var target = new_register()
    var after = new_block()
    var index = 0
    while index < enumeration.values.count() {
        var name = enumeration.values[index]
        var value = enumeration.numbers[index]
        crash value
        var wanted = constant(value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', number, wanted)
        emit(compared)
        var naming = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, naming, next)
        emit(test)
        switch_to(naming)
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(name)
        constant_text.value_type = string_type
        var made = lower_text(constant_text)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value outside its enum '{enumeration.name}', at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    return owned(target)
}

func boxed_into_a_shape(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.kind == 'shape' {
        return carried(converted)
    }
    if boxed.is_nullable {
        return maybe_boxed(converted, boxed)
    }
    return present_boxed(converted, boxed)
}

func maybe_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var target = new_register()
    var boxing = new_block()
    var naming = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, naming)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    if not made.owned {
        retain(made.value)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(naming)
    var absent = HighIntermediaryRepresentation.Values.TextConstant("null")
    var named = lower_text(absent)
    var copied_name = LowIntermediaryRepresentation.Instructions.Copy(target, named.value)
    emit(copied_name)
    jump_to(after)
    switch_to(after)
    return owned(target)
}

func present_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.kind == 'enumeration' {
        var enum_box = small_object(boxed.name, 24)
        var stored_enum = LowIntermediaryRepresentation.Instructions.Store(enum_box, 16, converted.value, 'bits_64')
        emit(stored_enum)
        return owned(enum_box)
    }
    if boxed.kind != 'scalar' {
        return converted
    }
    var box = small_object(boxed.name, 24)
    var stored = LowIntermediaryRepresentation.Instructions.Store(box, 16, converted.value, 'bits_64')
    emit(stored)
    return owned(box)
}

func small_object(class_key: String, size: Integer): Integer {
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    emit(allocated)
    var class_id = layout.class_id_of(class_key)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    return object
}

func lower_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var receiver = lower_value(call.receiver)
    crash call.receiver
    release_later(receiver, call.receiver.value_type)
    var arguments = List<Integer>()
    add_arguments(arguments, call.arguments)
    var target = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
    }
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, receiver.value, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        call_a_filler(call, filler, receiver.value, class_id, arguments, target, presence, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{call.shape.name}' here, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    release_the_pending()
    pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = is_a_pointer(call.value_type)
    return answer
}

func call_a_filler(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    receiver: Integer,
    class_id: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
    after: Integer,
) {
    var wanted = layout.class_id_of(filler.name)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var calling = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, calling, next)
    emit(test)
    switch_to(calling)
    var own = receiver
    var is_boxed = filler.kind == 'scalar' or filler.kind == 'enumeration'
    if is_boxed {
        own = new_register()
        var unboxed = LowIntermediaryRepresentation.Instructions.Load(own, receiver, 16, 'bits_64')
        emit(unboxed)
    }
    if filler.kind == 'enumeration' {
        var enumeration = enum_model_of(filler.name)
        var string_type = call.value_type
        var named = enum_text_of(own, enumeration, string_type)
        if call.member.name == "to_debug" {
            named = quoted_enum_text(named)
        }
        var copied_name = LowIntermediaryRepresentation.Instructions.Copy(target, named.value)
        emit(copied_name)
        jump_to(after)
        switch_to(next)
        return
    }
    if call.member.is_an_attribute {
        read_a_filling_attribute(call, filler, own, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    var passed = List<Integer>()
    passed.append(own)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        passed.append(argument)
        index = index + 1
    }
    var member_name = call.member.name
    var filling_class = layout.program.class_named(filler.name)
    if filling_class and member_name == "to_string" {
        if not filling_class.function_named("to_string") {
            member_name = "to_debug"
        }
    }
    var key = "{filler.name}.{member_name}"
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, passed)
    called.presence = presence
    emit(called)
    jump_to(after)
    switch_to(next)
}

func enum_model_of(enum_key: String): Model.EnumModel {
    var parts = enum_key.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = layout.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func read_a_filling_attribute(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    object: Integer,
    target: Integer,
    presence: Integer,
) {
    var model = layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(call.member.name)
    crash attribute
    var loaded = load_attribute(object, attribute)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, loaded.value)
    emit(copied)
    if presence >= 0 {
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, loaded.presence)
        emit(copied_presence)
    }
}

func quoted_enum_text(named: Lowered): Lowered {
    var quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var opening = lower_text(quote)
    var arguments = List<Integer>()
    arguments.append(opening.value)
    arguments.append(named.value)
    var joined = new_register()
    var summed = LowIntermediaryRepresentation.Instructions.Call(joined, "String.sum", arguments)
    emit(summed)
    release(opening.value)
    release(named.value)
    var closing_quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var closing = lower_text(closing_quote)
    var closing_arguments = List<Integer>()
    closing_arguments.append(joined)
    closing_arguments.append(closing.value)
    var finished = new_register()
    var closed = LowIntermediaryRepresentation.Instructions.Call(finished, "String.sum", closing_arguments)
    emit(closed)
    release(joined)
    release(closing.value)
    return owned(finished)
}

func lower_function_value(made: HighIntermediaryRepresentation.Values.FunctionValue): Lowered {
    var receiver = lower_value(made.receiver)
    var object = small_object("Spite.FunctionValue", 32)
    var address = new_register()
    var key = made.function.key()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, key)
    emit(found)
    var stored_address = LowIntermediaryRepresentation.Instructions.Store(object, 16, address, 'bits_64')
    emit(stored_address)
    crash made.receiver
    kept(receiver, made.receiver.value_type)
    var stored_receiver = LowIntermediaryRepresentation.Instructions.Store(object, 24, receiver.value, 'bits_64')
    emit(stored_receiver)
    return owned(object)
}

func lower_function_value_call(call: HighIntermediaryRepresentation.Values.FunctionValueCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var called = lower_value(call.called)
    crash call.called
    release_later(called, call.called.value_type)
    var address = new_register()
    var loaded_address = LowIntermediaryRepresentation.Instructions.Load(address, called.value, 16, 'bits_64')
    emit(loaded_address)
    var receiver = new_register()
    var loaded_receiver = LowIntermediaryRepresentation.Instructions.Load(receiver, called.value, 24, 'bits_64')
    emit(loaded_receiver)
    var arguments = List<Integer>()
    arguments.append(receiver)
    add_arguments(arguments, call.arguments)
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var made = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    var presence = -1
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
        made.presence = presence
    }
    emit(made)
    release_the_pending()
    pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = is_a_pointer(call.value_type)
    return answer
}

func decimal_converted(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    var target = new_register()
    var converting = LowIntermediaryRepresentation.Instructions.DecimalConversion(target, source)
    var from_scalar = scalars.of(from_type.name)
    var to_scalar = scalars.of(to_type.name)
    crash from_scalar
    crash to_scalar
    if from_scalar.is_decimal {
        converting.from_decimal_size = from_scalar.size
    } else {
        converting.whole_is_signed = from_scalar.is_signed
        converting.whole_width = width_of(from_type)
    }
    if to_scalar.is_decimal {
        converting.to_decimal_size = to_scalar.size
    } else {
        converting.whole_is_signed = to_scalar.is_signed
        converting.whole_width = width_of(to_type)
    }
    emit(converting)
    return single(target)
}

func check_the_decimal_range(value: Integer, from_type: Model.Type, to_type: Model.Type) {
    var to_scalar = scalars.of(to_type.name)
    crash to_scalar
    var wide = value
    if from_type.name == "Float" {
        var double_type = Model.Type('scalar', "Double")
        var widened = decimal_converted(value, from_type, double_type)
        wide = widened.value
    }
    var bits = value_bits_of(to_scalar)
    var above_bits = double_bits_of_power(bits)
    var lowest_bits: Long = 0
    if to_scalar.is_signed {
        lowest_bits = above_bits - 9223372036854775807 - 1
    }
    var article = article_of(to_type.name)
    var from_article = article_of(from_type.name)
    var message = "spite: {from_article} {from_type.name} does not fit in {article} {to_type.name}, at {path}:{line} in {function.key}\n"
    decimal_stop_unless(wide, 'greater_or_equal', lowest_bits, message)
    decimal_stop_unless(wide, 'less', above_bits, message)
}

func double_bits_of_power(bits: Integer): Long {
    var exponent: Long = 1023 + bits
    return exponent.shifted_left(52)
}

func decimal_stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Comparison,
    limit_bits: Long,
    message: String,
) {
    var bound = constant(limit_bits)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.DecimalCompare(fits, comparison, value, bound)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func check_the_range(value: Integer, given: Model.Type, wanted: Model.Type) {
    var given_scalar = scalars.of(given.name)
    var wanted_scalar = scalars.of(wanted.name)
    crash given_scalar
    crash wanted_scalar
    var given_article = article_of(given.name)
    var wanted_article = article_of(wanted.name)
    var message = ", {given_article} {given.name}, does not fit in {wanted_article} {wanted.name}, at {path}:{line} in {function.key}\n"
    var loses_the_sign = not wanted_scalar.is_signed or wanted_scalar.size < given_scalar.size
    if given_scalar.is_signed and loses_the_sign {
        var lowest = lowest_of(wanted_scalar)
        stop_unless(value, 'greater_or_equal', lowest, true, message, given_scalar.is_signed)
    }
    var wanted_bits = value_bits_of(wanted_scalar)
    if value_bits_of(given_scalar) > wanted_bits {
        var half = power_of_two(wanted_bits - 1) - 1
        var highest = half * 2 + 1
        stop_unless(value, 'less_or_equal', highest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
}

func value_bits_of(scalar: Model.Scalar): Integer {
    if scalar.is_signed {
        return scalar.size * 8 - 1
    }
    return scalar.size * 8
}

func lowest_of(scalar: Model.Scalar): Long {
    if not scalar.is_signed {
        return 0
    }
    var bits = value_bits_of(scalar)
    var zero: Long = 0
    return zero - power_of_two(bits)
}

func power_of_two(bits: Integer): Long {
    var power: Long = 1
    var index = 0
    while index < bits {
        power = power * 2
        index = index + 1
    }
    return power
}

func stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Comparison,
    limit: Long,
    compares_signed: Boolean,
    message: String,
    value_is_signed: Boolean,
) {
    var bound = constant(limit)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(fits, comparison, value, bound)
    compared.is_signed = compares_signed
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(value)
    var sign = 0
    if value_is_signed {
        sign = 1
    }
    stopped.signed_numbers.append(sign)
    emit(stopped)
    switch_to(after)
}

func article_of(name: String): String {
    var first = name.code_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func made_nullable(converted: Lowered, nullable_type: Model.Type): Lowered {
    if not is_a_nullable_scalar(nullable_type) {
        return carried(converted)
    }
    var present = constant(1)
    return Lowered(converted.value, present)
}

func lower_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var library = lower_value(call.library)
    var library_model = layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = layout.offset_of(handle_attribute)
    var handle = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(handle, library.value, handle_offset, 'bits_64')
    emit(loaded)
    var address = new_register()
    var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(address, handle, call.function_name)
    emit(found)
    var arguments = List<Integer>()
    var decimal_sizes = List<Integer>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = foreign_argument(argument)
        arguments.append(passed)
        var size = decimal_size_of(argument.value_type)
        decimal_sizes.append(size)
        index = index + 1
    }
    var target = new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    called.answers_32_bits = call.value_type.name == "Integer"
    called.decimal_sizes = decimal_sizes
    called.answer_decimal_size = decimal_size_of(call.value_type)
    emit(called)
    release_the_pending()
    pending_releases = outer
    return single(target)
}

func decimal_size_of(of_type: Model.Type): Integer {
    if not is_a_decimal(of_type) {
        return 0
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func foreign_argument(argument: HighIntermediaryRepresentation.Values.Value): Integer {
    var argument_value = lower_value(argument)
    var argument_type = argument.value_type
    release_later(argument_value, argument_type)
    if argument_type.kind == 'object' and argument_type.name == "String" {
        return bytes_of_text(argument_value.value)
    }
    if argument_type.kind == 'object' and argument_type.name == "Buffer" {
        return storage_of(argument_value.value)
    }
    return argument_value.value
}

func bytes_of_text(text: Integer): Integer {
    var string_model = layout.program.class_named("String")
    crash string_model
    var buffer_attribute = string_model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = layout.offset_of(buffer_attribute)
    var buffer = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, text, buffer_offset, 'bits_64')
    emit(loaded)
    return storage_of(buffer)
}

func storage_of(buffer: Integer): Integer {
    var storage = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(storage, buffer, layout.storage_offset, 'bits_64')
    emit(loaded)
    return storage
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func width_of(of_type: Model.Type): LowIntermediaryRepresentation.Width {
    if of_type.kind != 'scalar' {
        return 'bits_64'
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    switch scalar.size {
        1: return 'bits_8'
        2: return 'bits_16'
        4: return 'bits_32'
        _: return 'bits_64'
    }
}

func is_signed(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return true
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_signed and not scalar.is_decimal
}

func unbuilt(): Lowered {
    var buildable = Validators.HighIntermediaryRepresentation.Buildable.Validator()
    buildable.refuse(path, line, function.key)
    return single(-1)
}

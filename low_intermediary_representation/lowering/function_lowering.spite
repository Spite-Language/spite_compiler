var no_program = Model.ProgramModel()
var layout = Layout(no_program)
var program = LowIntermediaryRepresentation.LoweredProgram()
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var counts_the_answer = true
var current = 0
var terminated = false
var locals = Dictionary<String, Integer>()
var held_types = Dictionary<Integer, Model.Type>()
var local_presences = Dictionary<String, Integer>()
var scalars = Model.Scalars()
var path = ""
var line = 0
var singleton_slots = Dictionary<String, Integer>()
var scopes = List<List<Integer>>()
var pending_releases = List<Integer>()
var statement_releases = List<Integer>()
var gathers_for_the_statement = false
var waits: Waits? = null
var assignments: Assignments? = null
var reassigned_names = List<String>()
var borrows_parameters = false
var trimmed_keys = List<String>()
var block_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
var statement_index = 0
var makes_work = false
var resumable_mode = false
var resume_blocks = List<Integer>()
var locks_its_singleton = false
var locked_class = ""
var lowering_owner = ""
var skips_the_lock = false
var coarse_class = ""

func FunctionLowering(
    starting_layout: Layout,
    starting_program: LowIntermediaryRepresentation.LoweredProgram,
    starting_slots: Dictionary<String, Integer>,
) {
    layout = starting_layout
    program = starting_program
    singleton_slots = starting_slots
}

func lowered(
    high: HighIntermediaryRepresentation.HighFunction,
    starting_path: String,
): LowIntermediaryRepresentation.LowFunction {
    path = starting_path
    var key = high.function.key()
    if resumable_mode {
        key = "{key}$step"
    }
    if skips_the_lock {
        key = "{key}$unguarded"
    }
    lowering_owner = high.function.owner
    counts_the_answer = true
    if high.function.answer {
        counts_the_answer = not is_a_singleton_type(high.function.answer)
    }
    start(key)
    function.is_resumable = resumable_mode
    if high.function.declaration {
        note_the_place(high.function, high.function.declaration.line)
    }
    resume_blocks = List<Integer>()
    var dispatch = current
    var this_register = new_register()
    locals["this"] = this_register
    scopes = List<List<Integer>>()
    var held = List<Integer>()
    scopes.append(held)
    note_the_borrowed_parameters(high)
    high.function.parameters.each(take_parameter)
    function.parameter_count = function.register_count
    var body = current
    if resumable_mode {
        body = new_block()
        switch_to(body)
    }
    high.function.parameters.each(hold_a_parameter)
    var owner_key = high.function.owner
    var guarded = waits and not high.function.is_constructor and not skips_the_lock
    if guarded and is_locked_here() {
        locks_its_singleton = true
        locked_class = owner_key
        lock_the_singleton()
    }
    lower_block(high.body)
    if not terminated {
        release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
    }
    if resumable_mode {
        dispatch_the_resumes(dispatch, body)
    }
    return function
}

func note_the_borrowed_parameters(high: HighIntermediaryRepresentation.HighFunction) {
    borrows_parameters = false
    reassigned_names = List<String>()
    assert not resumable_mode
    assert assignments
    reassigned_names = assignments.names_assigned_in(high.body)
    borrows_parameters = true
}

func note_the_place(model: Model.FunctionModel, declared_line: Integer) {
    var owner_model = layout.program.class_named(model.owner)
    var owner_shown = model.owner
    if owner_model {
        owner_shown = owner_model.shown
    }
    function.place = "{path}:{declared_line}\t{owner_shown}\t{model.name}"
}

func dispatch_the_resumes(dispatch: Integer, body: Integer) {
    switch_to(dispatch)
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var resumed = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(resumed, frame, 0, 'bits_64')
    emit(loaded)
    var index = 0
    while index < resume_blocks.count() {
        var target = resume_blocks[index]
        var number = constant(index + 1)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', resumed, number)
        emit(compared)
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, target, next)
        emit(test)
        switch_to(next)
        index = index + 1
    }
    jump_to(body)
}

func resume_point(): Integer {
    var block = new_block()
    jump_to(block)
    switch_to(block)
    resume_blocks.append(block)
    return resume_blocks.count()
}

func suspend_unless(holds: Integer, point: Integer) {
    var waiting = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(holds, after, waiting)
    emit(test)
    switch_to(waiting)
    suspend_at(point)
    switch_to(after)
}

func suspend_at(point: Integer) {
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var number = constant(point)
    var stored = LowIntermediaryRepresentation.Instructions.Store(frame, 0, number, 'bits_64')
    emit(stored)
    var zero = constant(0)
    var returned = LowIntermediaryRepresentation.Instructions.Return(zero)
    returned.is_a_suspension = true
    emit(returned)
}

func blocks(key: String): Boolean {
    if not waits {
        return false
    }
    return waits.blocks(key)
}

func is_locked_here(): Boolean {
    if not waits {
        return false
    }
    return waits.is_locked(function.key)
}

func is_resumable(key: String): Boolean {
    if not waits {
        return false
    }
    return waits.is_resumable(key)
}

func lowered_call_arguments(call: HighIntermediaryRepresentation.Values.Call): List<Integer> {
    var arguments = List<Integer>()
    var receiver = lower_value(call.receiver)
    crash call.receiver
    var unknown = unknown_callees()
    passed_on(receiver, call.receiver, unknown)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, unknown)
    return arguments
}

func unknown_callees(): List<String> {
    var unknown = List<String>()
    unknown.append("$unknown")
    return unknown
}

func passed_on(value: Lowered, given: HighIntermediaryRepresentation.Values.Value, called_keys: List<String>) {
    release_later(value, given.value_type)
    assert is_a_pointer(given.value_type) and not value.owned
    assert not is_steady(given, called_keys)
    retain(value.value)
    pending_releases.append(value.value)
}

func is_steady(given: HighIntermediaryRepresentation.Values.Value?, called_keys: List<String>): Boolean {
    crash given
    if is_a_singleton_type(given.value_type) {
        return true
    }
    switch given {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.Conversion: return carries_steadily(given, called_keys)
        HighIntermediaryRepresentation.Values.AttributeRead: return is_a_steady_attribute(given, called_keys)
        _: return false
    }
}

func counts_an_answer(of_type: Model.Type): Boolean {
    return is_a_pointer(of_type) and not is_a_singleton_type(of_type)
}

func is_a_singleton_type(of_type: Model.Type): Boolean {
    if of_type.kind != 'object' {
        return false
    }
    var model = layout.program.class_named(of_type.name)
    if not model {
        return false
    }
    return model.is_singleton
}

func carries_steadily(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    called_keys: List<String>,
): Boolean {
    if conversion.kind == 'join' or conversion.kind == 'into_handle' {
        return false
    }
    return is_steady(conversion.converted, called_keys)
}

func is_a_steady_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    called_keys: List<String>,
): Boolean {
    if layout.is_back(read.attribute) {
        return false
    }
    if not is_steady(read.object, called_keys) {
        return false
    }
    if not assignments {
        return false
    }
    return not assignments.may_assign(called_keys, read.attribute)
}

func start(key: String) {
    function = LowIntermediaryRepresentation.LowFunction(key, 0)
    locals = Dictionary<String, Integer>()
    local_presences = Dictionary<String, Integer>()
    var first = new_block()
    switch_to(first)
}

func take_parameter(parameter: Model.ParameterModel) {
    var value = new_register()
    locals[parameter.name] = value
    if is_a_nullable_scalar(parameter.parameter_type) {
        var presence = new_register()
        local_presences[parameter.name] = presence
    }
}

func hold_a_parameter(parameter: Model.ParameterModel) {
    assert is_a_pointer(parameter.parameter_type)
    assert not borrows_parameters or reassigned_names.contains(parameter.name)
    var register = locals[parameter.name]
    crash register
    retain(register)
    hold(register)
}

func is_a_pointer(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'handle' {
        return true
    }
    return kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
}

func owned(register: Integer): Lowered {
    var made = Lowered(register, -1)
    made.owned = true
    return made
}

func retain(register: Integer) {
    var retained = LowIntermediaryRepresentation.Instructions.Retain(register)
    emit(retained)
}

func release_held(register: Integer) {
    var held_type = held_types[register]
    if held_type {
        settle_before_letting_go(register, held_type)
    }
    release(register)
}

func settle_before_letting_go(register: Integer, of_type: Model.Type) {
    assert resumable_mode
    var settling = Settling(this)
    assert settling.may_hold_work(of_type)
    settling.wait_until_settled(register, of_type)
}

func settle_before_clearing(call: HighIntermediaryRepresentation.Values.Call, receiver: Integer) {
    assert resumable_mode and call.function.name == "clear"
    crash call.receiver
    settle_before_letting_go(receiver, call.receiver.value_type)
}

func release(register: Integer) {
    var arguments = List<Integer>()
    arguments.append(register)
    var released = LowIntermediaryRepresentation.Instructions.Call(-1, "_release", arguments)
    emit(released)
}

func kept(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and not value.owned {
        retain(value.value)
    }
}

func release_later(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and value.owned {
        pending_releases.append(value.value)
    }
}

func release_the_pending() {
    pending_releases.each(release)
    pending_releases = List<Integer>()
}

func discard(value: Lowered, of_type: Model.Type) {
    if is_a_pointer(of_type) and value.owned {
        release(value.value)
    }
}

func hold(register: Integer) {
    var innermost = scopes.last()
    crash innermost
    innermost.append(register)
}

func release_every_scope() {
    var index = scopes.count() - 1
    while index >= 0 {
        var scope = scopes[index]
        crash scope
        scope.each(release_held)
        index = index - 1
    }
    if locks_its_singleton {
        unlock_the_singleton()
    }
}

func new_register(): Integer {
    var made = function.register_count
    function.register_count = made + 1
    return made
}

func new_block(): Integer {
    var made = LowIntermediaryRepresentation.LowBlock()
    function.blocks.append(made)
    return function.blocks.count() - 1
}

func switch_to(block: Integer) {
    current = block
    terminated = false
}

func note_the_line(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        note_a_call_line(instruction)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.CallAt {
        note_a_call_at_line(instruction)
    }
}

func note_a_call_line(call: LowIntermediaryRepresentation.Instructions.Call) {
    if call.line == 0 {
        call.line = line
    }
}

func note_a_call_at_line(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    if call.line == 0 {
        call.line = line
    }
}

func emit(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if terminated {
        var unreachable = new_block()
        switch_to(unreachable)
    }
    var block = function.blocks[current]
    crash block
    note_the_line(instruction)
    block.instructions.append(instruction)
    var ends = instruction == LowIntermediaryRepresentation.Instructions.Jump
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Branch
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Return
    ends = ends or instruction == LowIntermediaryRepresentation.Instructions.Exit
    if instruction == LowIntermediaryRepresentation.Instructions.Stop {
        ends = not instruction.continues
    }
    terminated = ends
}

func jump_to(block: Integer) {
    if not terminated {
        var jump = LowIntermediaryRepresentation.Instructions.Jump(block)
        emit(jump)
    }
}

func constant(number: Long): Integer {
    var target = new_register()
    var made = LowIntermediaryRepresentation.Instructions.Constant(target, number)
    emit(made)
    return target
}

func data_label(bytes: Buffer): Integer {
    program.data.append(bytes)
    return program.data.count() - 1
}

func text_label(text: String): Integer {
    var bytes = text.to_bytes()
    var label = data_label(bytes)
    program.constant_labels.append(label)
    return label
}

func lower_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    crash block
    var held = List<Integer>()
    scopes.append(held)
    var outer_statements = block_statements
    var outer_index = statement_index
    var outer_releases = statement_releases
    var outer_gathering = gathers_for_the_statement
    statement_releases = List<Integer>()
    block_statements = block.statements
    statement_index = 0
    while statement_index < block_statements.count() {
        var statement = block_statements[statement_index]
        gathers_for_the_statement = not resumable_mode and is_a_plain_statement(statement)
        lower_statement(statement)
        gathers_for_the_statement = false
        statement_index = statement_index + 1
        release_at_the_statement_end(statement)
    }
    statement_releases = outer_releases
    gathers_for_the_statement = outer_gathering
    block_statements = outer_statements
    statement_index = outer_index
    if not terminated {
        held.each(release_held)
    }
    var last = scopes.count() - 1
    scopes.remove_at(last)
}

func is_a_plain_statement(statement: HighIntermediaryRepresentation.Statements.Statement): Boolean {
    var branches = statement == HighIntermediaryRepresentation.Statements.If
    branches = branches or statement == HighIntermediaryRepresentation.Statements.While
    branches = branches or statement == HighIntermediaryRepresentation.Statements.Block
    var leaves = statement == HighIntermediaryRepresentation.Statements.Return
    leaves = leaves or statement == HighIntermediaryRepresentation.Statements.Stop
    return not branches and not leaves
}

func release_at_the_statement_end(statement: HighIntermediaryRepresentation.Statements.Statement) {
    assert not statement_releases.is_empty()
    var next = block_statements[statement_index]
    if next {
        var continues = is_a_plain_statement(next) and next.line == statement.line
        assert not continues
    }
    statement_releases.each(release)
    statement_releases = List<Integer>()
}

func lower_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    var outer = pending_releases
    pending_releases = List<Integer>()
    lower_a_statement(statement)
    if not terminated {
        release_the_pending()
    }
    pending_releases = outer
}

func lower_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: lower_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: lower_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: lower_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: lower_while(statement)
        HighIntermediaryRepresentation.Statements.Return: lower_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: lower_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: lower_block(statement)
    }
}

func lower_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    line = declare.line
    var value = lower_value(declare.value)
    var register = new_register()
    locals[declare.name] = register
    var borrowed = is_a_borrowed_local(declare, value)
    if not borrowed {
        kept(value, declare.declared_type)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    emit(copied)
    if is_a_pointer(declare.declared_type) and not borrowed {
        hold(register)
        held_types[register] = declare.declared_type
    }
    if is_a_nullable_scalar(declare.declared_type) {
        var presence = new_register()
        local_presences[declare.name] = presence
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
        emit(copied_presence)
    }
    if declare.hides != "" {
        let_go_of_the_hidden(declare.hides)
    }
}

func let_go_of_the_hidden(hidden: String) {
    var register = locals[hidden]
    assert register
    var innermost = scopes.last()
    crash innermost
    var at = innermost.index_of(register)
    assert at
    innermost.remove_at(at)
    release_held(register)
}

func is_a_borrowed_local(declare: HighIntermediaryRepresentation.Statements.Declare, value: Lowered): Boolean {
    if not borrows_parameters or value.owned or not is_a_pointer(declare.declared_type) {
        return false
    }
    if reassigned_names.contains(declare.name) {
        return false
    }
    var watched = List<String>()
    if not gather_the_sources(declare.value, watched) or watched.is_empty() {
        return false
    }
    if not assignments {
        return false
    }
    var after = statement_index + 1
    return assignments.leaves_alone(block_statements, after, watched)
}

func gather_the_sources(given: HighIntermediaryRepresentation.Values.Value?, watched: List<String>): Boolean {
    crash given
    if is_a_singleton_type(given.value_type) {
        return true
    }
    switch given {
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.LocalRead: return not reassigned_names.contains(given.name)
        HighIntermediaryRepresentation.Values.Conversion: return gather_through_a_conversion(given, watched)
        HighIntermediaryRepresentation.Values.AttributeRead: return gather_through_an_attribute(given, watched)
        HighIntermediaryRepresentation.Values.Call: return gather_through_a_slot(given, watched)
        _: return false
    }
}

func gather_through_a_conversion(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    watched: List<String>,
): Boolean {
    if conversion.kind == 'join' or conversion.kind == 'into_handle' {
        return false
    }
    return gather_the_sources(conversion.converted, watched)
}

func gather_through_an_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    watched: List<String>,
): Boolean {
    if layout.is_back(read.attribute) {
        return false
    }
    watched.append("{read.attribute.owner}.{read.attribute.name}")
    return gather_the_sources(read.object, watched)
}

func gather_through_a_slot(call: HighIntermediaryRepresentation.Values.Call, watched: List<String>): Boolean {
    if call.function.has_a_body() or call.function.name != "_read_value" {
        return false
    }
    watched.append("[]{call.function.owner}")
    return gather_the_sources(call.receiver, watched)
}

func lower_assign(assign: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    line = assign.line
    var value = lower_value(assign.value)
    var register = locals[assign.name]
    crash register
    crash assign.value
    var assigned_type = assign.value.value_type
    kept(value, assigned_type)
    var old = new_register()
    var saved = LowIntermediaryRepresentation.Instructions.Copy(old, register)
    emit(saved)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    emit(copied)
    if is_a_pointer(assigned_type) {
        settle_before_letting_go(old, assigned_type)
        release(old)
    }
    var presence = local_presences[assign.name]
    assert presence
    var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
    emit(copied_presence)
}

func lower_assign_attribute(assign: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    line = assign.line
    var updates = AtomicUpdates(this)
    var is_atomic_here = false
    if waits {
        is_atomic_here = waits.is_atomic(lowering_owner)
    }
    assert not is_atomic_here or not updates.lowered_an_update(assign)
    var object = lower_value(assign.object)
    var value = lower_value(assign.value)
    if layout.is_back(assign.attribute) {
        store_a_back_reference(object.value, assign.attribute, value)
    } else {
        store_an_attribute(object.value, assign.attribute, value)
    }
    bind_the_foreign_names(assign.attribute, value.value)
    crash assign.object
    discard(object, assign.object.value_type)
}

func bind_the_foreign_names(attribute: Model.AttributeModel, library: Integer) {
    var names = attribute.foreign_names
    assert not names.is_empty()
    var library_model = layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = layout.offset_of(handle_attribute)
    var handle = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(handle, library, handle_offset, 'bits_64')
    emit(loaded)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var address = new_register()
        var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(address, handle, name)
        emit(found)
        index = index + 1
    }
}

func store_an_attribute(object: Integer, attribute: Model.AttributeModel, value: Lowered) {
    var offset = layout.offset_of(attribute)
    var attribute_type = attribute.attribute_type
    var width = width_of(attribute_type)
    kept(value, attribute_type)
    var old = new_register()
    if is_a_pointer(attribute_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
        emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, width)
    emit(stored)
    if is_a_pointer(attribute_type) {
        settle_before_letting_go(old, attribute_type)
        release(old)
    }
    assert is_a_nullable_scalar(attribute_type)
    var presence_offset = layout.presence_offset_of(attribute)
    var presence_width = layout.presence_width()
    var stored_presence = LowIntermediaryRepresentation.Instructions.Store(
        object,
        presence_offset,
        value.presence,
        presence_width,
    )
    emit(stored_presence)
}

func store_a_back_reference(object: Integer, attribute: Model.AttributeModel, value: Lowered) {
    var offset = layout.offset_of(attribute)
    var old = new_register()
    var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
    emit(loaded_old)
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, 'bits_64')
    emit(stored)
    var slot = layout.back_slot_of(attribute)
    count_back(value.value, slot, "_point_back")
    if value.owned {
        release(value.value)
    }
    count_back(old, slot, "_let_go_back")
}

func count_back(object: Integer, slot: Integer, helper: String) {
    var slot_register = constant(slot)
    var arguments = List<Integer>()
    arguments.append(object)
    arguments.append(slot_register)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, helper, arguments)
    emit(called)
}

func lower_assign_through_shape(assign: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    line = assign.line
    var object = lower_value(assign.object)
    var value = lower_value(assign.value)
    crash assign.value
    var value_type = assign.value.value_type
    kept(value, value_type)
    store_through_shape(assign.shape, assign.member, object.value, value, value_type)
}

func store_through_shape(
    shape: Model.ShapeModel,
    member: String,
    object: Integer,
    value: Lowered,
    value_type: Model.Type,
) {
    var shared = shared_filler(shape.key, member)
    if shared {
        store_in_a_shared_block(shared, member, object, value, value_type)
        return
    }
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, object, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = layout.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        store_in_a_filler(filler, member, object, class_id, value, value_type, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{shape.name}' here, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func store_in_a_shared_block(
    filler: Model.Type,
    member: String,
    object: Integer,
    value: Lowered,
    value_type: Model.Type,
) {
    var model = layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(member)
    crash attribute
    store_in_place(object, attribute, value, value_type)
}

func store_in_a_filler(
    filler: Model.Type,
    member: String,
    object: Integer,
    class_id: Integer,
    value: Lowered,
    value_type: Model.Type,
    after: Integer,
) {
    var model = layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(member)
    crash attribute
    var wanted = layout.class_id_of(filler.name)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var storing = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, storing, next)
    emit(test)
    switch_to(storing)
    if layout.is_back(attribute) {
        var held = owned(value.value)
        store_a_back_reference(object, attribute, held)
    } else {
        store_in_place(object, attribute, value, value_type)
    }
    jump_to(after)
    switch_to(next)
}

func store_in_place(object: Integer, attribute: Model.AttributeModel, value: Lowered, value_type: Model.Type) {
    var offset = layout.offset_of(attribute)
    var width = width_of(attribute.attribute_type)
    var old = new_register()
    if is_a_pointer(value_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
        emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, width)
    emit(stored)
    assert is_a_pointer(value_type)
    release(old)
}

func lower_evaluate(evaluate: HighIntermediaryRepresentation.Statements.Evaluate) {
    line = evaluate.line
    if resumable_mode and evaluate.waited {
        var in_place = lower_value(evaluate.waited)
        discard(in_place, evaluate.waited.value_type)
        return
    }
    var value = lower_value(evaluate.value)
    crash evaluate.value
    discard(value, evaluate.value.value_type)
}

func lower_if(branch: HighIntermediaryRepresentation.Statements.If) {
    line = branch.line
    var condition = lower_value(branch.condition)
    crash branch.condition
    discard(condition, branch.condition.value_type)
    release_the_pending()
    var then_block = new_block()
    var after = new_block()
    var else_block = after
    if branch.else_branch {
        else_block = new_block()
    }
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, then_block, else_block)
    emit(test)
    switch_to(then_block)
    lower_block(branch.then_branch)
    jump_to(after)
    if branch.else_branch {
        switch_to(else_block)
        lower_block(branch.else_branch)
        jump_to(after)
    }
    switch_to(after)
}

func lower_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var coarse = CoarseLoops(this)
    var held = coarse.singleton_held_by(loop)
    if held.is_empty() {
        lower_a_plain_while(loop)
        return
    }
    lock_a_singleton(held)
    var outer = coarse_class
    coarse_class = held
    lower_a_plain_while(loop)
    coarse_class = outer
    unlock_a_singleton(held)
}

func lower_a_plain_while(loop: HighIntermediaryRepresentation.Statements.While) {
    line = loop.line
    var header = new_block()
    var body = new_block()
    var after = new_block()
    jump_to(header)
    switch_to(header)
    var condition = lower_value(loop.condition)
    release_the_pending()
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, body, after)
    emit(test)
    switch_to(body)
    lower_block(loop.body)
    jump_to(header)
    switch_to(after)
}

func lower_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    line = returned.line
    if not returned.value {
        release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
        return
    }
    var value = lower_value(returned.value)
    var returned_type = returned.value.value_type
    if counts_the_answer {
        kept(value, returned_type)
    }
    release_the_pending()
    release_every_scope()
    var made = LowIntermediaryRepresentation.Instructions.Return(value.value)
    made.presence = value.presence
    emit(made)
}

func lower_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    var plain = stop.pieces.is_empty() and not stop.then
    if plain and stop.message.is_empty() {
        var failure = constant(1)
        var exited = LowIntermediaryRepresentation.Instructions.Exit(failure)
        emit(exited)
        return
    }
    if not plain {
        lower_a_reported_stop(stop)
        return
    }
    var label = text_label("{stop.message}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
}

func lower_a_reported_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    var pieces = stop.pieces
    if pieces.is_empty() {
        pieces = List<String>()
        pieces.append(stop.message)
    }
    var last_index = pieces.count() - 1
    var last = pieces[last_index]
    crash last
    pieces[last_index] = "{last}\n"
    var first_text = pieces[0]
    crash first_text
    var opening = text_label(first_text)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var label = text_label(piece)
        stopped.labels.append(label)
        index = index + 1
    }
    var value_index = 0
    while value_index < stop.shown.count() {
        var shown = stop.shown[value_index]
        var shown_value = lower_value(shown)
        stopped.numbers.append(shown_value.value)
        var sign = 1
        if is_unsigned_whole(shown.value_type.name) {
            sign = 0
        }
        stopped.signed_numbers.append(sign)
        value_index = value_index + 1
    }
    if not stop.then {
        emit(stopped)
        return
    }
    stopped.continues = true
    emit(stopped)
    var reported = lower_value(stop.then)
    release_later(reported, stop.then.value_type)
    var failure = constant(1)
    var exited = LowIntermediaryRepresentation.Instructions.Exit(failure)
    emit(exited)
}

func is_unsigned_whole(name: String): Boolean {
    return name == "Byte" or name == "UnsignedShort" or name == "UnsignedInteger" or name == "UnsignedLong"
}

func lower_value(value: HighIntermediaryRepresentation.Values.Value?): Lowered {
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return lower_whole_number(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return lower_decimal_number(value)
        HighIntermediaryRepresentation.Values.TextConstant: return lower_text(value)
        HighIntermediaryRepresentation.Values.NullConstant: return lower_null(value.value_type)
        HighIntermediaryRepresentation.Values.LocalRead: return lower_local(value)
        HighIntermediaryRepresentation.Values.ThisRead: return lower_this()
        HighIntermediaryRepresentation.Values.AttributeRead: return lower_attribute(value)
        HighIntermediaryRepresentation.Values.Call: return lower_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: return lower_make_object(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return lower_operation(value)
        HighIntermediaryRepresentation.Values.Negation: return lower_negation(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return lower_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Test: return lower_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return lower_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: return lower_conversion(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return lower_number_room(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return lower_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: return lower_enum_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return lower_enum_from_text(value)
        HighIntermediaryRepresentation.Values.Class.Object: return lower_class_object(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: return lower_class_of_value(value)
        HighIntermediaryRepresentation.Values.Function.Value: return lower_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return lower_function_value_call(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return lower_function_fact(value)
    }
}

func lower_function_fact(fact: HighIntermediaryRepresentation.Values.Function.Fact): Lowered {
    crash fact.is_answered
    var number = 0
    if fact.answer {
        number = 1
    }
    var register = constant(number)
    return single(register)
}

func lower_whole_number(number: HighIntermediaryRepresentation.Values.WholeNumber): Lowered {
    var register = constant(number.number)
    return single(register)
}

func lower_decimal_number(number: HighIntermediaryRepresentation.Values.DecimalNumber): Lowered {
    var bits: Long = 0
    if number.value_type.name == "Float" {
        var parsed_float = number.written.to_float()
        crash parsed_float
        bits = parsed_float.bits()
    } else {
        var parsed = number.written.to_double()
        crash parsed
        bits = parsed.bits()
    }
    var register = constant(bits)
    return single(register)
}

func single(register: Integer): Lowered {
    return Lowered(register, -1)
}

func lower_null(null_type: Model.Type): Lowered {
    var zero = constant(0)
    if not is_a_nullable_scalar(null_type) {
        return single(zero)
    }
    var absent = constant(0)
    return Lowered(zero, absent)
}

func lower_this(): Lowered {
    var this_register = locals["this"]
    crash this_register
    return single(this_register)
}

func lower_local(read: HighIntermediaryRepresentation.Values.LocalRead): Lowered {
    var register = locals[read.name]
    crash register
    var presence = local_presences[read.name]
    if presence and read.value_type.is_nullable {
        return Lowered(register, presence)
    }
    return single(register)
}

func lower_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead): Lowered {
    var standing = layout.standing_in_for(read)
    if standing {
        return lower_value(standing)
    }
    var object = lower_value(read.object)
    var loaded = load_attribute(object.value, read.attribute)
    crash read.object
    var is_a_temporary = is_a_pointer(read.object.value_type) and object.owned
    if gathers_for_the_statement and is_a_temporary {
        statement_releases.append(object.value)
    } else {
        release_later(object, read.object.value_type)
    }
    return loaded
}

func load_attribute(object_register: Integer, attribute: Model.AttributeModel): Lowered {
    var rebuilder = layout.rebuilder_of(attribute)
    if rebuilder {
        return rebuilt_in_place(object_register, rebuilder)
    }
    var object = single(object_register)
    var offset = layout.offset_of(attribute)
    var attribute_type = attribute.attribute_type
    var target = new_register()
    var width = width_of(attribute_type)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(target, object.value, offset, width)
    loaded.is_signed = is_signed(attribute_type)
    emit(loaded)
    if layout.is_back(attribute) {
        return held_back(target)
    }
    if not is_a_nullable_scalar(attribute_type) {
        return single(target)
    }
    var presence = new_register()
    var presence_offset = layout.presence_offset_of(attribute)
    var presence_width = layout.presence_width()
    var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(
        presence,
        object.value,
        presence_offset,
        presence_width,
    )
    loaded_presence.is_signed = false
    emit(loaded_presence)
    return Lowered(target, presence)
}

func rebuilt_in_place(object: Integer, rebuilder: Model.FunctionModel): Lowered {
    var target = new_register()
    var arguments = List<Integer>()
    arguments.append(object)
    var key = rebuilder.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, arguments)
    emit(called)
    if not rebuilder.answer or counts_an_answer(rebuilder.answer) {
        return owned(target)
    }
    return single(target)
}

func held_back(object: Integer): Lowered {
    var held = new_register()
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.Call(held, "_back_if_alive", arguments)
    emit(called)
    return single(held)
}

func lower_text(text: HighIntermediaryRepresentation.Values.TextConstant): Lowered {
    var joins = TextJoins(this)
    return joins.lower_text(text)
}

func address_plus(base: Integer, offset_register: Integer): Integer {
    var target = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'add', base, offset_register)
    added.is_signed = false
    added.is_checked = false
    emit(added)
    return target
}

func lower_make_object(made: HighIntermediaryRepresentation.Values.MakeObject): Lowered {
    var class_key = made.value_type.name
    var made_model = layout.program.class_named(class_key)
    crash made_model
    if made_model.is_singleton {
        var singleton = singleton_of(class_key, made)
        return single(singleton)
    }
    var object = make_object_for(class_key, made)
    call_the_constructor(object, made)
    if class_key == "ForeignCallback" {
        var callbacks = Callbacks(this)
        callbacks.handed_over(object, made)
    }
    return owned(object)
}

func make_object_for(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    if made.constructor {
        var constructor_key = made.constructor.key()
        if trimmed_keys.contains(constructor_key) {
            return make_object_with(class_key, "{constructor_key}$defaults")
        }
    }
    return make_object(class_key)
}

func make_object(class_key: String): Integer {
    return make_object_with(class_key, "{class_key}._attribute_defaults")
}

func make_object_with(class_key: String, defaults_key: String): Integer {
    var is_a_text = class_key == "String" and defaults_key == "String._attribute_defaults"
    if is_a_text and layout.plain_text_room >= 0 and layout.holds_texts_whole() {
        var joins = TextJoins(this)
        return joins.empty_text(layout.plain_text_room)
    }
    var size = layout.made_size_of(class_key)
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    emit(allocated)
    var class_id = layout.class_id_of(class_key)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    if layout.is_back_held(class_key) {
        var back_slot = layout.back_offset_of(class_key)
        var stored_back = LowIntermediaryRepresentation.Instructions.Store(object, back_slot, one, 'bits_64')
        emit(stored_back)
    }
    var arguments = List<Integer>()
    arguments.append(object)
    var defaults = LowIntermediaryRepresentation.Instructions.Call(-1, defaults_key, arguments)
    emit(defaults)
    return object
}

func call_the_constructor(object: Integer, made: HighIntermediaryRepresentation.Values.MakeObject) {
    assert made.constructor
    var constructor_key = made.constructor.key()
    var outer = pending_releases
    pending_releases = List<Integer>()
    var arguments = List<Integer>()
    arguments.append(object)
    var constructing = List<String>()
    constructing.append(constructor_key)
    add_arguments(arguments, made.arguments, constructing)
    if resumable_mode and is_resumable(constructor_key) and not is_a_singleton_class(made.value_type.name) {
        var working = Working(this)
        working.waited_into(constructor_key, arguments, -1, -1)
    } else {
        var called = LowIntermediaryRepresentation.Instructions.Call(-1, constructor_key, arguments)
        emit(called)
    }
    release_the_pending()
    pending_releases = outer
}

func is_a_singleton_class(class_key: String): Boolean {
    var made_model = layout.program.class_named(class_key)
    crash made_model
    return made_model.is_singleton
}

func singleton_of(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    var slot_key = singleton_slot_key(class_key, made)
    var label = slot_label_of(slot_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var object = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    emit(loaded)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    emit(compared)
    var making = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, making, after)
    emit(test)
    switch_to(making)
    var maker_key = maker_of(class_key, made, label)
    var no_arguments = List<Integer>()
    var called = LowIntermediaryRepresentation.Instructions.Call(object, maker_key, no_arguments)
    emit(called)
    jump_to(after)
    switch_to(after)
    return object
}

func maker_of(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject, label: Integer): String {
    var key = "_make_{class_key}${label}"
    if program.singleton_makers.contains(key) {
        return key
    }
    program.singleton_makers.append(key)
    var maker = FunctionLowering(layout, program, singleton_slots)
    maker.waits = waits
    maker.assignments = assignments
    maker.trimmed_keys = trimmed_keys
    maker.makes_work = makes_work
    maker.path = path
    maker.line = line
    maker.write_the_maker(key, class_key, made, label, function.place)
    program.lowered_functions.append(maker.function)
    return key
}

func write_the_maker(
    key: String,
    class_key: String,
    made: HighIntermediaryRepresentation.Values.MakeObject,
    label: Integer,
    place: String,
) {
    start(key)
    function.place = place
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var object = new_register()
    var after = new_block()
    halt_on_state(
        slot,
        3,
        "spite: a drop() at exit used the singleton {class_key} after it was destroyed: singletons are destroyed in reverse order of when they were made, so keep {class_key} in an attribute of the singleton whose drop() uses it\n",
    )
    var thread = new_register()
    var no_arguments = List<Integer>()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(thread, "GetCurrentThreadId", no_arguments)
    emit(asked)
    var never_made = constant(0)
    var being_made = constant(1)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 16, never_made, being_made)
    emit(claimed)
    var won = new_register()
    var compared_claim = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, never_made)
    emit(compared_claim)
    var building = new_block()
    var someone_else = new_block()
    var claim_test = LowIntermediaryRepresentation.Instructions.Branch(won, building, someone_else)
    emit(claim_test)
    switch_to(someone_else)
    wait_for_the_maker(slot, thread, class_key, object, after)
    switch_to(building)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(slot, 32, thread, 'bits_64')
    emit(kept_thread)
    var fresh = make_object(class_key)
    call_the_constructor(fresh, made)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    var finished = constant(2)
    var marked_made = LowIntermediaryRepresentation.Instructions.Store(slot, 16, finished, 'bits_64')
    emit(marked_made)
    record_the_making(slot, class_key)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(object, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    var answered = LowIntermediaryRepresentation.Instructions.Return(object)
    emit(answered)
}

func singleton_slot_key(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): String {
    if made.arguments.is_empty() {
        return class_key
    }
    var written = List<String>()
    var index = 0
    while index < made.arguments.count() {
        var argument = made.arguments[index]
        var shown = literal_key_of(argument)
        written.append(shown)
        index = index + 1
    }
    var joined = written.join(", ")
    return "{class_key}({joined})"
}

func literal_key_of(value: HighIntermediaryRepresentation.Values.Value): String {
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number.to_string()
    }
    if value == HighIntermediaryRepresentation.Values.DecimalNumber {
        return value.written
    }
    if value == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text.to_debug()
    }
    if value == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        return literal_key_of(value.converted)
    }
    crash
}

func lock_the_singleton() {
    lock_a_singleton(locked_class)
}

func lock_a_singleton(class_key: String) {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var thread = new_register()
    var asked = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    emit(asked)
    var trying = new_block()
    var again = new_block()
    var taken = new_block()
    var unowned = new_block()
    var owner = new_register()
    var loaded_owner = LowIntermediaryRepresentation.Instructions.Load(owner, slot, 40, 'bits_64')
    emit(loaded_owner)
    var mine = new_register()
    var compared_owner = LowIntermediaryRepresentation.Instructions.Compare(mine, 'equal', owner, thread)
    emit(compared_owner)
    var owner_test = LowIntermediaryRepresentation.Instructions.Branch(mine, taken, unowned)
    emit(owner_test)
    switch_to(unowned)
    if waits and waits.skips_locks_while_idle() {
        claim_while_idle(slot, thread, trying, taken)
    } else {
        jump_to(trying)
    }
    switch_to(trying)
    var free = constant(0)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 40, free, thread)
    emit(claimed)
    var won = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, free)
    emit(compared)
    var won_test = LowIntermediaryRepresentation.Instructions.Branch(won, taken, again)
    emit(won_test)
    switch_to(again)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(trying)
    switch_to(taken)
    var depth = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(depth, slot, 48, 'bits_64')
    emit(loaded)
    var one = constant(1)
    var deeper = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(deeper, 'add', depth, one)
    added.is_checked = false
    emit(added)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 48, deeper, 'bits_64')
    emit(stored)
}

func claim_while_idle(slot: Integer, thread: Integer, trying: Integer, taken: Integer) {
    var tasks_label = record_label_of("$tasks")
    var tasks = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(tasks, tasks_label)
    emit(addressed)
    var running = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(running, tasks, 0, 'bits_64')
    emit(loaded)
    var none_running = constant(0)
    var idle = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(idle, 'equal', running, none_running)
    emit(compared)
    var claiming = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(idle, claiming, trying)
    emit(test)
    switch_to(claiming)
    var claimed = LowIntermediaryRepresentation.Instructions.Store(slot, 40, thread, 'bits_64')
    emit(claimed)
    jump_to(taken)
}

func count_a_task(amount: Long) {
    var tasks_label = record_label_of("$tasks")
    var tasks = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(tasks, tasks_label)
    emit(addressed)
    var left = new_register()
    var counted = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, tasks, 0, amount)
    emit(counted)
}

func unlock_the_singleton() {
    unlock_a_singleton(locked_class)
}

func unlock_a_singleton(class_key: String) {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var depth = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(depth, slot, 48, 'bits_64')
    emit(loaded)
    var one = constant(1)
    var shallower = new_register()
    var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(shallower, 'subtract', depth, one)
    subtracted.is_checked = false
    emit(subtracted)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 48, shallower, 'bits_64')
    emit(stored)
    var zero = constant(0)
    var released = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(released, 'equal', shallower, zero)
    emit(compared)
    var freeing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(released, freeing, after)
    emit(test)
    switch_to(freeing)
    var opened = LowIntermediaryRepresentation.Instructions.Store(slot, 40, zero, 'bits_64')
    emit(opened)
    jump_to(after)
    switch_to(after)
}

func wait_for_the_filling(slot: Integer, thread: Integer, made: Integer, after: Integer) {
    var maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(maker, slot, 32, 'bits_64')
    emit(loaded_maker)
    var is_this_thread = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_this_thread, 'equal', maker, thread)
    emit(compared)
    var taking = new_block()
    var waiting = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_this_thread, taking, waiting)
    emit(test)
    switch_to(waiting)
    var state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(state, slot, 16, 'bits_64')
    emit(loaded_state)
    var filled = constant(2)
    var is_filled = new_register()
    var compared_state = LowIntermediaryRepresentation.Instructions.Compare(is_filled, 'equal', state, filled)
    emit(compared_state)
    var pausing = new_block()
    var filled_test = LowIntermediaryRepresentation.Instructions.Branch(is_filled, taking, pausing)
    emit(filled_test)
    switch_to(pausing)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(waiting)
    switch_to(taking)
    var taken = LowIntermediaryRepresentation.Instructions.Load(made, slot, 0, 'bits_64')
    emit(taken)
    jump_to(after)
}

func wait_for_the_maker(slot: Integer, thread: Integer, class_key: String, object: Integer, after: Integer) {
    var maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(maker, slot, 32, 'bits_64')
    emit(loaded_maker)
    var is_this_thread = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_this_thread, 'equal', maker, thread)
    emit(compared)
    var circling = new_block()
    var waiting = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_this_thread, circling, waiting)
    emit(test)
    switch_to(circling)
    var circle = ""
    if waits {
        circle = waits.circle_of(class_key)
    }
    var message = "spite: singleton '{class_key}' is asked for while it is being made: a singleton cannot reach itself as it initialises\n"
    if not circle.is_empty() {
        message = "spite: singleton {circle}: singletons initialise each other in a circle\n"
    }
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(waiting)
    var state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(state, slot, 16, 'bits_64')
    emit(loaded_state)
    var made_state = constant(2)
    var is_made = new_register()
    var compared_state = LowIntermediaryRepresentation.Instructions.Compare(is_made, 'equal', state, made_state)
    emit(compared_state)
    var pausing = new_block()
    var taking = new_block()
    var made_test = LowIntermediaryRepresentation.Instructions.Branch(is_made, taking, pausing)
    emit(made_test)
    switch_to(pausing)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(waiting)
    switch_to(taking)
    var taken = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    emit(taken)
    jump_to(after)
}

func halt_on_state(slot: Integer, state: Integer, message: String) {
    var current = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(current, slot, 16, 'bits_64')
    emit(loaded)
    var wanted = constant(state)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', current, wanted)
    emit(compared)
    var halting = new_block()
    var going_on = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, halting, going_on)
    emit(test)
    switch_to(halting)
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(going_on)
}

func record_the_making(slot: Integer, class_key: String) {
    var head_label = made_singletons_label()
    var head = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(head, head_label)
    emit(addressed)
    var newest = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(newest, head, 0, 'bits_64')
    emit(loaded)
    var linked = LowIntermediaryRepresentation.Instructions.Store(slot, 8, newest, 'bits_64')
    emit(linked)
    var destroy = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(destroy, "_destroy_{class_key}")
    emit(found)
    var kept_destroy = LowIntermediaryRepresentation.Instructions.Store(slot, 24, destroy, 'bits_64')
    emit(kept_destroy)
    var pushed = LowIntermediaryRepresentation.Instructions.Store(head, 0, slot, 'bits_64')
    emit(pushed)
}

func made_singletons_label(): Integer {
    return record_label_of("")
}

func slot_label_of(class_key: String): Integer {
    return record_label_of(class_key)
}

func record_label_of(class_key: String): Integer {
    var known = singleton_slots[class_key]
    if known {
        return known
    }
    var empty = Buffer(0)
    var index = 0
    while index < 56 {
        empty.append(0)
        index = index + 1
    }
    var label = data_label(empty)
    singleton_slots[class_key] = label
    return label
}

func add_arguments(
    arguments: List<Integer>,
    values: List<HighIntermediaryRepresentation.Values.Value>,
    called_keys: List<String>,
) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        var argument_value = lower_value(value)
        passed_on(argument_value, value, called_keys)
        arguments.append(argument_value.value)
        if argument_value.presence >= 0 {
            arguments.append(argument_value.presence)
        }
        index = index + 1
    }
}

func lower_call(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var intrinsic = Intrinsics(this)
    var is_an_intrinsic = not call.function.has_a_body() and not call.function.is_written_by_the_compiler
    if is_an_intrinsic {
        return intrinsic.lowered(call)
    }
    var reads = ListReads(this)
    if reads.is_a_count(call) {
        return reads.counted(call)
    }
    var joins = TextJoins(this)
    if joins.is_a_join(call) {
        return joins.joined(call)
    }
    if joins.is_an_append(call) {
        return joins.appended(call)
    }
    if not call.number_positions.is_empty() {
        return lower_number_dispatch(call)
    }
    var called_key = call.function.key()
    var working = Working(this)
    if resumable_mode and is_resumable(called_key) {
        return working.waiting_call(call)
    }
    if resumable_mode and called_key == "Program.sleep" {
        return working.waiting_sleep(call)
    }
    if makes_work and blocks(called_key) and not is_locked_here() {
        return working.helped(call)
    }
    if makes_work and called_key == "Program.sleep" and not is_locked_here() {
        return working.plain_sleep(call)
    }
    var outer = pending_releases
    pending_releases = List<Integer>()
    var arguments = List<Integer>()
    var calling = List<String>()
    calling.append(called_key)
    var held = is_a_held_receiver(call, calling)
    var receiver = lower_a_receiver(call, held)
    crash call.receiver
    if not held {
        passed_on(receiver, call.receiver, calling)
    }
    settle_before_clearing(call, receiver.value)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, calling)
    var answer = finished_call(call, arguments)
    release_the_pending()
    pending_releases = outer
    return answer
}

func is_a_held_receiver(call: HighIntermediaryRepresentation.Values.Call, calling: List<String>): Boolean {
    var given = call.receiver
    if given == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_held_item(given, call, calling)
    }
    return false
}

func lower_a_receiver(call: HighIntermediaryRepresentation.Values.Call, held: Boolean): Lowered {
    var given = call.receiver
    if given == HighIntermediaryRepresentation.Values.Conversion {
        return lower_a_held_conversion(given, held)
    }
    return lower_value(given)
}

func lower_a_held_conversion(given: HighIntermediaryRepresentation.Values.Conversion, held: Boolean): Lowered {
    if held {
        var reads = ListReads(this)
        return reads.held_item(given)
    }
    return lower_value(given)
}

func is_a_held_item(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    if conversion.kind != 'proven' or resumable_mode {
        return false
    }
    var read = conversion.converted
    if read == HighIntermediaryRepresentation.Values.Call {
        return is_a_held_read(read, call, calling)
    }
    return false
}

func is_a_held_read(
    read: HighIntermediaryRepresentation.Values.Call,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    var reads = ListReads(this)
    if not reads.is_a_plain_get(read) or not is_a_pointer(read.value_type) {
        return false
    }
    if not is_steady(read.receiver, calling) or not read.arguments.all(is_plain_reading) {
        return false
    }
    if not call.arguments.all(is_plain_reading) {
        return false
    }
    return leaves_the_items(calling, read.function.owner)
}

func leaves_the_items(calling: List<String>, list_key: String): Boolean {
    if not assignments {
        return false
    }
    return not assignments.may_write_items(calling, list_key)
}

func is_plain_reading(value: HighIntermediaryRepresentation.Values.Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_plain_reading_of(value.object)
        _: return false
    }
}

func is_plain_reading_of(object: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not object {
        return false
    }
    return is_plain_reading(object)
}

func lower_number_dispatch(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var receiver = lower_value(call.receiver)
    crash call.receiver
    var unknown = unknown_callees()
    passed_on(receiver, call.receiver, unknown)
    var registers = List<Integer>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var lowered_argument = lower_value(argument)
        passed_on(lowered_argument, argument, unknown)
        registers.append(lowered_argument.value)
        index = index + 1
    }
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var after = new_block()
    var chosen = List<String>()
    call.number_types.each(chosen.append)
    dispatch_a_number(call, receiver.value, registers, chosen, 0, target, after)
    switch_to(after)
    release_the_pending()
    pending_releases = outer
    if counts_an_answer(call.value_type) {
        return owned(target)
    }
    return single(target)
}

func dispatch_a_number(
    call: HighIntermediaryRepresentation.Values.Call,
    receiver: Integer,
    registers: List<Integer>,
    chosen: List<String>,
    position_index: Integer,
    target: Integer,
    after: Integer,
) {
    if position_index == call.number_positions.count() {
        call_a_number_copy(call, receiver, registers, chosen, target)
        jump_to(after)
        return
    }
    var position = call.number_positions[position_index]
    crash position
    var boxed = registers[position]
    crash boxed
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, boxed, 0, 'bits_64')
    emit(loaded)
    var fillers = layout.program.fillers_of("Number")
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var wanted = layout.class_id_of(filler.name)
        var wanted_register = constant(wanted)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
        emit(compared)
        var calling = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, calling, next)
        emit(test)
        switch_to(calling)
        var unboxed = new_register()
        var read = LowIntermediaryRepresentation.Instructions.Load(unboxed, boxed, 16, 'bits_64')
        emit(read)
        var given = List<Integer>()
        registers.each(given.append)
        given[position] = unboxed
        var picked = List<String>()
        chosen.each(picked.append)
        picked[position] = filler.name
        dispatch_a_number(call, receiver, given, picked, position_index + 1, target, after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: no number class fills 'Number' here, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
}

func call_a_number_copy(
    call: HighIntermediaryRepresentation.Values.Call,
    receiver: Integer,
    registers: List<Integer>,
    chosen: List<String>,
    target: Integer,
) {
    var name = call.function.number_copy_name(chosen)
    var key = "{call.function.owner}.{name}"
    var arguments = List<Integer>()
    arguments.append(receiver)
    registers.each(arguments.append)
    var answered = -1
    if target >= 0 {
        answered = new_register()
    }
    var called = LowIntermediaryRepresentation.Instructions.Call(answered, key, arguments)
    emit(called)
    if target >= 0 {
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, answered)
        emit(copied)
    }
}

func finished_call(call: HighIntermediaryRepresentation.Values.Call, arguments: List<Integer>): Lowered {
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var written_key = call.function.key()
    var function_key = unguarded_in_a_coarse_loop(written_key)
    var called = LowIntermediaryRepresentation.Instructions.Call(target, function_key, arguments)
    if is_a_nullable_scalar(call.value_type) {
        var presence = new_register()
        called.presence = presence
        emit(called)
        return Lowered(target, presence)
    }
    emit(called)
    if counts_an_answer(call.value_type) {
        return owned(target)
    }
    return single(target)
}

func unguarded_in_a_coarse_loop(key: String): String {
    if coarse_class.is_empty() or not waits {
        return key
    }
    if waits.owner_of(key) != coarse_class or not waits.is_locked(key) {
        return key
    }
    if not program.unguarded_keys.contains(key) {
        program.unguarded_keys.append(key)
    }
    return "{key}$unguarded"
}

func lower_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    if operation.operator == 'and' or operation.operator == 'or' {
        return lower_logic(operation)
    }
    if operation.is_folded {
        var folded = constant(operation.folded_number)
        return single(folded)
    }
    var left = lower_value(operation.left)
    var right = lower_value(operation.right)
    var target = new_register()
    crash operation.left
    var operand_type = operation.left.value_type
    var comparison = comparison_of(operation.operator)
    if is_a_decimal(operand_type) {
        return decimal_operation(operation, operand_type, left.value, right.value, target)
    }
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.Compare(target, comparison, left.value, right.value)
        compared.is_signed = is_signed(operand_type)
        emit(compared)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(
        target,
        arithmetic_operator,
        left.value,
        right.value,
    )
    computed.width = width_of(operand_type)
    computed.is_signed = is_signed(operand_type)
    computed.is_checked = not operation.is_proven_to_fit
    var divides = arithmetic_operator == 'divide' or arithmetic_operator == 'remainder'
    if divides {
        computed.is_checked = not operation.is_divisor_proven
    }
    computed.line = line
    computed.shown = operation.shown
    computed.type_name = operand_type.name
    computed.path = path
    emit(computed)
    return single(target)
}

func is_a_decimal(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return false
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_operation(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    operand_type: Model.Type,
    left: Integer,
    right: Integer,
    target: Integer,
): Lowered {
    var is_double = operand_type.name == "Double"
    var comparison = comparison_of(operation.operator)
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(target, comparison, left, right)
        compared.is_double = is_double
        emit(compared)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    var computed = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        target,
        arithmetic_operator,
        left,
        right,
    )
    computed.is_double = is_double
    emit(computed)
    return single(target)
}

func lower_logic(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    var target = new_register()
    var left = lower_value(operation.left)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, left.value)
    emit(copied)
    var testing_block = current
    var right_block = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(left.value, right_block, after)
    if operation.operator == 'or' {
        test = LowIntermediaryRepresentation.Instructions.Branch(left.value, after, right_block)
    }
    var pending_before = pending_releases.count()
    var statement_before = statement_releases.count()
    switch_to(right_block)
    var right = lower_value(operation.right)
    var copied_right = LowIntermediaryRepresentation.Instructions.Copy(target, right.value)
    emit(copied_right)
    jump_to(after)
    switch_to(testing_block)
    clear_the_skipped(pending_releases, pending_before)
    clear_the_skipped(statement_releases, statement_before)
    emit(test)
    switch_to(after)
    return single(target)
}

func clear_the_skipped(releases: List<Integer>, first: Integer) {
    var index = first
    while index < releases.count() {
        var released = releases[index]
        var zero = LowIntermediaryRepresentation.Instructions.Constant(released, 0)
        emit(zero)
        index = index + 1
    }
}

func comparison_of(
    operator: HighIntermediaryRepresentation.Values.Operator,
): LowIntermediaryRepresentation.Comparison? {
    switch operator {
        'equal': return 'equal'
        'not_equal': return 'not_equal'
        'less': return 'less'
        'less_or_equal': return 'less_or_equal'
        'greater': return 'greater'
        'greater_or_equal': return 'greater_or_equal'
        _: return null
    }
}

func arithmetic_of(
    operator: HighIntermediaryRepresentation.Values.Operator,
): LowIntermediaryRepresentation.ArithmeticOperator {
    switch operator {
        'add': return 'add'
        'subtract': return 'subtract'
        'multiply': return 'multiply'
        'divide': return 'divide'
        _: return 'remainder'
    }
}

func lower_negation(negation: HighIntermediaryRepresentation.Values.Negation): Lowered {
    var negated = lower_value(negation.negated)
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', negated.value, zero)
    emit(compared)
    return single(target)
}

func lower_class_test(test: HighIntermediaryRepresentation.Values.Class.Test): Lowered {
    var tested = lower_value(test.tested)
    crash test.tested
    release_later(tested, test.tested.value_type)
    var target = new_register()
    var zero = constant(0)
    var present = new_register()
    var compared_present = LowIntermediaryRepresentation.Instructions.Compare(present, 'not_equal', tested.value, zero)
    emit(compared_present)
    var reading = new_block()
    var after = new_block()
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, present)
    emit(copied)
    var branched = LowIntermediaryRepresentation.Instructions.Branch(present, reading, after)
    emit(branched)
    switch_to(reading)
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, tested.value, 0, 'bits_64')
    emit(loaded)
    var wanted = layout.class_id_of(test.member.name)
    var wanted_register = constant(wanted)
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', class_id, wanted_register)
    emit(compared)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func lower_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest): Lowered {
    var reads = ListReads(this)
    var ranged = reads.presence_of(test.tested)
    if ranged {
        return ranged
    }
    var tested = lower_value(test.tested)
    crash test.tested
    release_later(tested, test.tested.value_type)
    if tested.presence >= 0 {
        return single(tested.presence)
    }
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'not_equal', tested.value, zero)
    emit(compared)
    return single(target)
}

func lower_number_room(room: HighIntermediaryRepresentation.Values.NumberRoom): Lowered {
    var made = lower_value(room.made)
    var number = lower_value(room.number)
    var storage = storage_of(made.value)
    crash room.number
    var width = width_of(room.number.value_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(storage, 0, number.value, width)
    emit(stored)
    var buffer_model = layout.program.class_named("Buffer")
    crash buffer_model
    var count_attribute = buffer_model.attribute_named("item_count")
    crash count_attribute
    var count_offset = layout.offset_of(count_attribute)
    var counted = constant(room.width)
    var count_stored = LowIntermediaryRepresentation.Instructions.Store(made.value, count_offset, counted, 'bits_32')
    emit(count_stored)
    return owned(made.value)
}

func lower_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    if conversion.kind == 'into_handle' {
        var starting = Working(this)
        return starting.started(conversion)
    }
    if conversion.kind == 'join' {
        var joining = Working(this)
        return joining.joined(conversion)
    }
    if conversion.kind == 'proven' {
        var reads = ListReads(this)
        var read = reads.read(conversion)
        if read {
            return read
        }
    }
    var converted = lower_value(conversion.converted)
    if conversion.kind == 'nullable' {
        return made_nullable(converted, conversion.value_type)
    }
    if conversion.kind == 'into_shape' {
        crash conversion.converted
        var boxed = conversion.converted.value_type
        if conversion.value_type.is_nullable and boxed.is_nullable {
            return boxed_into_a_maybe(converted, boxed)
        }
        return boxed_into_a_shape(converted, boxed)
    }
    crash conversion.converted
    var from_type = conversion.converted.value_type
    if conversion.kind == 'widen' and is_a_decimal(from_type) {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_decimal' or conversion.kind == 'narrow_decimal' {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_whole' {
        check_the_decimal_range(converted.value, from_type, conversion.value_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'address' {
        return single(converted.value)
    }
    if conversion.kind == 'unbox' {
        var unboxed = new_register()
        var loaded_box = LowIntermediaryRepresentation.Instructions.Load(unboxed, converted.value, 16, 'bits_64')
        emit(loaded_box)
        return single(unboxed)
    }
    if conversion.kind == 'proven' {
        stop_if_missing(converted, conversion.shown)
        return carried(converted)
    }
    if conversion.kind == 'narrow' {
        check_the_range(converted.value, from_type, conversion.value_type)
    }
    return carried(converted)
}

func carried(converted: Lowered): Lowered {
    var made = Lowered(converted.value, -1)
    made.owned = converted.owned
    return made
}

func stop_if_missing(converted: Lowered, shown: String) {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' is outside its list: a bound proves only the top of an index, and this one is below 0 or the list changed, at {path}:{line} in {function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func lower_class_object(object: HighIntermediaryRepresentation.Values.Class.Object): Lowered {
    var kind = object.reflection_kind
    var slot_key = "{kind}:{object.described}"
    var label = slot_label_of(slot_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var made = new_register()
    var state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(state, slot, 16, 'bits_64')
    emit(loaded_state)
    var filled = constant(2)
    var is_filled = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_filled, 'equal', state, filled)
    emit(compared)
    var making = new_block()
    var ready = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_filled, ready, making)
    emit(test)
    switch_to(ready)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(made, slot, 0, 'bits_64')
    emit(loaded)
    jump_to(after)
    switch_to(making)
    var thread = new_register()
    var no_arguments = List<Integer>()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(thread, "GetCurrentThreadId", no_arguments)
    emit(asked)
    var never_made = constant(0)
    var being_made = constant(1)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 16, never_made, being_made)
    emit(claimed)
    var won = new_register()
    var compared_claim = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, never_made)
    emit(compared_claim)
    var building = new_block()
    var someone_else = new_block()
    var claim_test = LowIntermediaryRepresentation.Instructions.Branch(won, building, someone_else)
    emit(claim_test)
    switch_to(someone_else)
    wait_for_the_filling(slot, thread, made, after)
    switch_to(building)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(slot, 32, thread, 'bits_64')
    emit(kept_thread)
    var fresh = make_object(kind)
    var name_text = HighIntermediaryRepresentation.Values.TextConstant(object.described)
    var parts = object.described.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    name_text.text = simple
    var name = lower_text(name_text)
    var constructor_arguments = List<Integer>()
    constructor_arguments.append(fresh)
    constructor_arguments.append(name.value)
    var simple_kind = kind.split(".")
    var kind_last = simple_kind.count() - 1
    var constructor_name = simple_kind[kind_last]
    crash constructor_name
    if kind == "Spite.Namespace" {
        constructor_arguments.append(name.value)
    }
    var constructed = LowIntermediaryRepresentation.Instructions.Call(
        -1,
        "{kind}.{constructor_name}",
        constructor_arguments,
    )
    emit(constructed)
    release(name.value)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    var fill_arguments = List<Integer>()
    fill_arguments.append(fresh)
    var filling = LowIntermediaryRepresentation.Instructions.Call(-1, "{kind}._fill_{object.described}", fill_arguments)
    emit(filling)
    var marked = LowIntermediaryRepresentation.Instructions.Store(slot, 16, filled, 'bits_64')
    emit(marked)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(made, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    return single(made)
}

func lower_class_of_value(made: HighIntermediaryRepresentation.Values.Class.OfValue): Lowered {
    var described = lower_value(made.described)
    var target = new_register()
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, described.value, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var index = 0
    while index < made.candidates.count() {
        var candidate = made.candidates[index]
        var wanted = layout.class_id_of(candidate)
        var wanted_register = constant(wanted)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var object = HighIntermediaryRepresentation.Values.Class.Object(made.value_type, candidate)
        var lowered_object = lower_class_object(object)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_object.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value of no class this program knows, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    crash made.described
    discard(described, made.described.value_type)
    return single(target)
}

func lower_symbol_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var text = lower_value(read.text)
    var target = new_register()
    var zero = constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_name.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        release(lowered_name.value)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    discard(text, read.text.value_type)
    return owned(target)
}

func lower_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    if read.value_type.is_symbol {
        return lower_symbol_from_text(read)
    }
    var text = lower_value(read.text)
    var target = new_register()
    var presence = new_register()
    var zero = constant(0)
    var absent = LowIntermediaryRepresentation.Instructions.Copy(presence, zero)
    emit(absent)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var number = read.enumeration.numbers[index]
        crash number
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        release(lowered_name.value)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var value = constant(number)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, value)
        emit(copied)
        var one = constant(1)
        var present = LowIntermediaryRepresentation.Instructions.Copy(presence, one)
        emit(present)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    discard(text, read.text.value_type)
    return Lowered(target, presence)
}

func lower_enum_text(text: HighIntermediaryRepresentation.Values.EnumText): Lowered {
    var number = lower_value(text.number)
    return enum_text_of(number.value, text.enumeration, text.value_type)
}

func enum_text_of(number: Integer, enumeration: Model.EnumModel, string_type: Model.Type): Lowered {
    var target = new_register()
    var after = new_block()
    var index = 0
    while index < enumeration.values.count() {
        var name = enumeration.values[index]
        var value = enumeration.numbers[index]
        crash value
        var wanted = constant(value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', number, wanted)
        emit(compared)
        var naming = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, naming, next)
        emit(test)
        switch_to(naming)
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(name)
        constant_text.value_type = string_type
        var made = lower_text(constant_text)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value outside its enum '{enumeration.name}', at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    return owned(target)
}

func boxed_into_a_shape(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.kind == 'shape' {
        return carried(converted)
    }
    if boxed.is_nullable {
        return maybe_boxed(converted, boxed)
    }
    return present_boxed(converted, boxed)
}

func boxed_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.is_symbol {
        return symbol_into_a_maybe(converted, boxed)
    }
    if is_a_pointer(boxed) {
        return carried(converted)
    }
    var presence = converted.presence
    crash presence >= 0
    var target = new_register()
    var boxing = new_block()
    var missing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, missing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(missing)
    var nothing = constant(0)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, nothing)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return owned(target)
}

func symbol_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', converted.value, zero)
    emit(compared)
    var target = new_register()
    var boxing = new_block()
    var nothing_held = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, nothing_held, boxing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(nothing_held)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return owned(target)
}

func maybe_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var target = new_register()
    var boxing = new_block()
    var naming = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, naming)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    if not made.owned {
        retain(made.value)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(naming)
    var absent_size = layout.size_of("Spite.Absent")
    var absent = small_object("Spite.Absent", absent_size)
    var copied_absent = LowIntermediaryRepresentation.Instructions.Copy(target, absent)
    emit(copied_absent)
    jump_to(after)
    switch_to(after)
    return owned(target)
}

func present_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.is_symbol {
        kept(converted, boxed)
        var symbol_box = small_object("Spite.SymbolBox", 24)
        var stored_symbol = LowIntermediaryRepresentation.Instructions.Store(symbol_box, 16, converted.value, 'bits_64')
        emit(stored_symbol)
        return owned(symbol_box)
    }
    if boxed.kind == 'enumeration' {
        var enum_box = small_object(boxed.name, 24)
        var stored_enum = LowIntermediaryRepresentation.Instructions.Store(enum_box, 16, converted.value, 'bits_64')
        emit(stored_enum)
        return owned(enum_box)
    }
    if boxed.kind != 'scalar' {
        return converted
    }
    var box = small_object(boxed.name, 24)
    var stored = LowIntermediaryRepresentation.Instructions.Store(box, 16, converted.value, 'bits_64')
    emit(stored)
    return owned(box)
}

func small_object(class_key: String, size: Integer): Integer {
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    emit(allocated)
    var class_id = layout.class_id_of(class_key)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    return object
}

func filled_members(call: HighIntermediaryRepresentation.Values.ShapeCall): List<String> {
    var filled = List<String>()
    var fillers = layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        filled.append("{filler.name}.{call.member.name}")
        filled.append("{filler.name}.get_{call.member.name}")
        index = index + 1
    }
    return filled
}

func lower_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var filled = filled_members(call)
    var receiver = lower_value(call.receiver)
    crash call.receiver
    passed_on(receiver, call.receiver, filled)
    var arguments = List<Integer>()
    add_arguments(arguments, call.arguments, filled)
    var target = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
    }
    var shared = shared_reading_filler(call)
    if shared {
        read_a_filling_attribute(call, shared, receiver.value, target, presence)
    } else {
        call_the_fillers(call, receiver.value, arguments, target, presence)
    }
    release_the_pending()
    pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = counts_an_answer(call.value_type)
    return answer
}

func call_the_fillers(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    receiver: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, receiver, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        call_a_filler(call, filler, receiver, class_id, arguments, target, presence, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{call.shape.name}' here, at {path}:{line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func shared_reading_filler(call: HighIntermediaryRepresentation.Values.ShapeCall): Model.Type? {
    assert call.arguments.is_empty()
    return shared_filler(call.shape.key, call.member.name)
}

func shared_filler(shape_key: String, member: String): Model.Type? {
    var shared = layout.shared_offset_of(shape_key, member)
    assert shared >= 0
    var fillers = layout.program.fillers_of(shape_key)
    return fillers.first()
}

func call_a_filler(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    receiver: Integer,
    class_id: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
    after: Integer,
) {
    var filler_key = layout.box_key_of(filler)
    var wanted = layout.class_id_of(filler_key)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var calling = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, calling, next)
    emit(test)
    switch_to(calling)
    var own = receiver
    var is_boxed = filler.kind == 'scalar' or filler.kind == 'enumeration' or filler.is_symbol
    if is_boxed {
        own = new_register()
        var unboxed = LowIntermediaryRepresentation.Instructions.Load(own, receiver, 16, 'bits_64')
        emit(unboxed)
    }
    var is_named = filler.kind == 'enumeration' or filler.is_symbol
    var lists_no_attributes = is_named and call.member.name == "_attribute_list"
    if lists_no_attributes {
        var nothing_held = constant(0)
        var none_given = List<Integer>()
        none_given.append(nothing_held)
        var listed = LowIntermediaryRepresentation.Instructions.Call(
            target,
            "Spite.Attribute._no_attributes",
            none_given,
        )
        emit(listed)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.is_symbol {
        retain(own)
        var symbol_name = Lowered(own, -1)
        symbol_name.owned = true
        if call.member.name == "to_debug" {
            symbol_name = quoted_enum_text(symbol_name)
        }
        var copied_symbol = LowIntermediaryRepresentation.Instructions.Copy(target, symbol_name.value)
        emit(copied_symbol)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.kind == 'enumeration' {
        var enumeration = enum_model_of(filler.name)
        var string_type = call.value_type
        var named = enum_text_of(own, enumeration, string_type)
        if call.member.name == "to_debug" {
            named = quoted_enum_text(named)
        }
        var copied_name = LowIntermediaryRepresentation.Instructions.Copy(target, named.value)
        emit(copied_name)
        jump_to(after)
        switch_to(next)
        return
    }
    if fills_with_an_attribute(call, filler) {
        read_a_filling_attribute(call, filler, own, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    check_own_class_arguments(call, filler, arguments)
    var passed = List<Integer>()
    passed.append(own)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        passed.append(argument)
        index = index + 1
    }
    var member_name = call.member.name
    var filling_class = layout.program.class_named(filler.name)
    if filling_class and member_name == "to_string" and not filling_class.function_named("to_string") {
        member_name = "to_debug"
    }
    if filling_class and call.member.is_an_attribute {
        member_name = "get_{member_name}"
    }
    var key = "{filler.name}.{member_name}"
    if resumable_mode and is_resumable(key) {
        var working = Working(this)
        working.waited_into(key, passed, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, passed)
    called.presence = presence
    emit(called)
    jump_to(after)
    switch_to(next)
}

func enum_model_of(enum_key: String): Model.EnumModel {
    var parts = enum_key.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = layout.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func check_own_class_arguments(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    arguments: List<Integer>,
) {
    var model = layout.program.class_named(filler.name)
    assert model
    var filling = model.function_named(call.member.name)
    assert filling
    var index = 0
    while index < filling.parameters.count() and index < arguments.count() {
        var parameter = filling.parameters[index]
        var wanted = call.member.parameters[index]
        var argument = arguments[index]
        var takes_its_own = parameter.parameter_type.name == filler.name and parameter.parameter_type.kind == 'object'
        if wanted and takes_its_own and wanted.parameter_type.kind == 'shape' {
            check_an_own_class(call, model, argument)
        }
        index = index + 1
    }
}

func check_an_own_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    argument: Integer,
) {
    var argument_class = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(argument_class, argument, 0, 'bits_64')
    emit(loaded)
    var fillers = layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var other = fillers[index]
        if other.name != model.key {
            stop_on_another_class(call, model, other, argument_class)
        }
        index = index + 1
    }
}

func stop_on_another_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    other: Model.Type,
    argument_class: Integer,
) {
    var other_key = layout.box_key_of(other)
    var other_id = layout.class_id_of(other_key)
    var other_register = constant(other_id)
    var same = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(same, 'equal', argument_class, other_register)
    emit(compared)
    var stopping = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(same, stopping, next)
    emit(test)
    switch_to(stopping)
    var other_shown = other.name
    var other_model = layout.program.class_named(other.name)
    if other_model {
        other_shown = other_model.shown
    }
    var own_article = article_of(model.shown)
    var other_article = article_of(other_shown)
    var written = call.shown
    if written.is_empty() {
        written = "{call.shape.name}.{call.member.name}"
    }
    var label = text_label(
        "spite: '{written}' works in {own_article} {model.shown}, the class of its left side, and its right side is {other_article} {other_shown}, which is not one, at {path}:{line} in {function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(next)
}

func fills_with_an_attribute(call: HighIntermediaryRepresentation.Values.ShapeCall, filler: Model.Type): Boolean {
    var model = layout.program.class_named(filler.name)
    if not model {
        return call.member.is_an_attribute
    }
    if model.attribute_named(call.member.name) {
        return call.member.is_an_attribute or call.arguments.is_empty()
    }
    return false
}

func read_a_filling_attribute(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    object: Integer,
    target: Integer,
    presence: Integer,
) {
    var model = layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(call.member.name)
    crash attribute
    var loaded = load_attribute(object, attribute)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, loaded.value)
    emit(copied)
    if is_a_pointer(call.value_type) and not loaded.owned {
        retain(target)
    }
    if presence >= 0 {
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, loaded.presence)
        emit(copied_presence)
    }
}

func quoted_enum_text(named: Lowered): Lowered {
    var quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var opening = lower_text(quote)
    var arguments = List<Integer>()
    arguments.append(opening.value)
    arguments.append(named.value)
    var joined = new_register()
    var summed = LowIntermediaryRepresentation.Instructions.Call(joined, "String.sum", arguments)
    emit(summed)
    release(opening.value)
    release(named.value)
    var closing_quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var closing = lower_text(closing_quote)
    var closing_arguments = List<Integer>()
    closing_arguments.append(joined)
    closing_arguments.append(closing.value)
    var finished = new_register()
    var closed = LowIntermediaryRepresentation.Instructions.Call(finished, "String.sum", closing_arguments)
    emit(closed)
    release(joined)
    release(closing.value)
    return owned(finished)
}

func lower_function_value(made: HighIntermediaryRepresentation.Values.Function.Value): Lowered {
    var receiver = lower_value(made.receiver)
    crash made.receiver
    var value_class = "Spite.FunctionValue"
    if not is_a_pointer(made.receiver.value_type) {
        value_class = "Spite.FunctionValueOfANumber"
    }
    var object = small_object(value_class, 48)
    var address = new_register()
    var key = made.function.key()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, key)
    emit(found)
    var stored_address = LowIntermediaryRepresentation.Instructions.Store(object, 16, address, 'bits_64')
    emit(stored_address)
    var frame_maker = constant(0)
    var stepper = constant(0)
    if is_resumable(key) {
        frame_maker = new_register()
        var found_maker = LowIntermediaryRepresentation.Instructions.FunctionAddress(frame_maker, "{key}$frame")
        emit(found_maker)
        stepper = new_register()
        var found_stepper = LowIntermediaryRepresentation.Instructions.FunctionAddress(stepper, "{key}$step")
        emit(found_stepper)
    }
    var stored_maker = LowIntermediaryRepresentation.Instructions.Store(object, 32, frame_maker, 'bits_64')
    emit(stored_maker)
    var stored_stepper = LowIntermediaryRepresentation.Instructions.Store(object, 40, stepper, 'bits_64')
    emit(stored_stepper)
    kept(receiver, made.receiver.value_type)
    var stored_receiver = LowIntermediaryRepresentation.Instructions.Store(object, 24, receiver.value, 'bits_64')
    emit(stored_receiver)
    return owned(object)
}

func lower_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var called = lower_value(call.called)
    crash call.called
    var unknown = unknown_callees()
    passed_on(called, call.called, unknown)
    var address = new_register()
    var loaded_address = LowIntermediaryRepresentation.Instructions.Load(address, called.value, 16, 'bits_64')
    emit(loaded_address)
    var receiver = new_register()
    var loaded_receiver = LowIntermediaryRepresentation.Instructions.Load(receiver, called.value, 24, 'bits_64')
    emit(loaded_receiver)
    var arguments = List<Integer>()
    arguments.append(receiver)
    add_arguments(arguments, call.arguments, unknown)
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var made = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    var presence = -1
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
        made.presence = presence
    }
    if resumable_mode {
        call_a_value_that_may_wait(made, called.value, arguments, target, presence)
    } else {
        emit(made)
    }
    release_the_pending()
    pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = counts_an_answer(call.value_type)
    return answer
}

func call_a_value_that_may_wait(
    plain: LowIntermediaryRepresentation.Instructions.CallAt,
    called: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var frame_maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(frame_maker, called, 32, 'bits_64')
    emit(loaded_maker)
    var zero = constant(0)
    var is_plain = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_plain, 'equal', frame_maker, zero)
    emit(compared)
    var calling = new_block()
    var framing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_plain, calling, framing)
    emit(test)
    switch_to(calling)
    emit(plain)
    jump_to(after)
    switch_to(framing)
    var stepper = new_register()
    var loaded_stepper = LowIntermediaryRepresentation.Instructions.Load(stepper, called, 40, 'bits_64')
    emit(loaded_stepper)
    var frame = new_register()
    var made_frame = LowIntermediaryRepresentation.Instructions.CallAt(frame, frame_maker, arguments)
    emit(made_frame)
    var working = Working(this)
    working.finish_the_frame(frame, "", stepper, target, presence)
    jump_to(after)
    switch_to(after)
}

func decimal_converted(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    var target = new_register()
    var converting = LowIntermediaryRepresentation.Instructions.Decimal.Conversion(target, source)
    var from_scalar = scalars.of(from_type.name)
    var to_scalar = scalars.of(to_type.name)
    crash from_scalar
    crash to_scalar
    if from_scalar.is_decimal {
        converting.from_decimal_size = from_scalar.size
    } else {
        converting.whole_is_signed = from_scalar.is_signed
        converting.whole_width = width_of(from_type)
    }
    if to_scalar.is_decimal {
        converting.to_decimal_size = to_scalar.size
    } else {
        converting.whole_is_signed = to_scalar.is_signed
        converting.whole_width = width_of(to_type)
    }
    emit(converting)
    return single(target)
}

func check_the_decimal_range(value: Integer, from_type: Model.Type, to_type: Model.Type) {
    var to_scalar = scalars.of(to_type.name)
    crash to_scalar
    var wide = value
    if from_type.name == "Float" {
        var double_type = Model.Type('scalar', "Double")
        var widened = decimal_converted(value, from_type, double_type)
        wide = widened.value
    }
    var bits = value_bits_of(to_scalar)
    var above_bits = double_bits_of_power(bits)
    var lowest_bits: Long = 0
    if to_scalar.is_signed {
        lowest_bits = above_bits - 9223372036854775807 - 1
    }
    var article = article_of(to_type.name)
    var from_article = article_of(from_type.name)
    var message = ", {from_article} {from_type.name}, does not fit in {article} {to_type.name}, at {path}:{line} in {function.key}\n"
    decimal_stop_unless(wide, 'greater_or_equal', lowest_bits, message)
    decimal_stop_unless(wide, 'less', above_bits, message)
}

func double_bits_of_power(bits: Integer): Long {
    var exponent: Long = 1023 + bits
    return exponent.shifted_left(52)
}

func decimal_stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Comparison,
    limit_bits: Long,
    message: String,
) {
    var bound = constant(limit_bits)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(fits, comparison, value, bound)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var long_bits = double_bits_of_power(63)
    var lowest_long: Long = long_bits - 9223372036854775807 - 1
    var numbered = new_block()
    var unnumbered = new_block()
    var past_the_low = new_block()
    var above_the_low = new_register()
    var low_bound = constant(lowest_long)
    var compared_low = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        above_the_low,
        'greater_or_equal',
        value,
        low_bound,
    )
    emit(compared_low)
    var low_test = LowIntermediaryRepresentation.Instructions.Branch(above_the_low, past_the_low, unnumbered)
    emit(low_test)
    switch_to(past_the_low)
    var below_the_high = new_register()
    var high_bound = constant(long_bits)
    var compared_high = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        below_the_high,
        'less',
        value,
        high_bound,
    )
    emit(compared_high)
    var high_test = LowIntermediaryRepresentation.Instructions.Branch(below_the_high, numbered, unnumbered)
    emit(high_test)
    switch_to(numbered)
    var double_type = Model.Type('scalar', "Double")
    var long_type = Model.Type('scalar', "Long")
    var whole = decimal_converted(value, double_type, long_type)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(whole.value)
    stopped.signed_numbers.append(1)
    emit(stopped)
    switch_to(unnumbered)
    var unnumbered_label = text_label("spite: a value that is not a number, or outside every whole number{message}")
    var stopped_unnumbered = LowIntermediaryRepresentation.Instructions.Stop(unnumbered_label)
    emit(stopped_unnumbered)
    switch_to(after)
}

func check_the_range(value: Integer, given: Model.Type, wanted: Model.Type) {
    var given_scalar = scalars.of(given.name)
    var wanted_scalar = scalars.of(wanted.name)
    crash given_scalar
    crash wanted_scalar
    var given_article = article_of(given.name)
    var wanted_article = article_of(wanted.name)
    var message = ", {given_article} {given.name}, does not fit in {wanted_article} {wanted.name}, at {path}:{line} in {function.key}\n"
    var loses_the_sign = not wanted_scalar.is_signed or wanted_scalar.size < given_scalar.size
    if given_scalar.is_signed and loses_the_sign {
        var lowest = lowest_of(wanted_scalar)
        stop_unless(value, 'greater_or_equal', lowest, true, message, given_scalar.is_signed)
    }
    var wanted_bits = value_bits_of(wanted_scalar)
    if value_bits_of(given_scalar) > wanted_bits {
        var half = power_of_two(wanted_bits - 1) - 1
        var highest = half * 2 + 1
        stop_unless(value, 'less_or_equal', highest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
}

func value_bits_of(scalar: Model.Scalar): Integer {
    if scalar.is_signed {
        return scalar.size * 8 - 1
    }
    return scalar.size * 8
}

func lowest_of(scalar: Model.Scalar): Long {
    if not scalar.is_signed {
        return 0
    }
    var bits = value_bits_of(scalar)
    var zero: Long = 0
    return zero - power_of_two(bits)
}

func power_of_two(bits: Integer): Long {
    var power: Long = 1
    var index = 0
    while index < bits {
        power = power * 2
        index = index + 1
    }
    return power
}

func stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Comparison,
    limit: Long,
    compares_signed: Boolean,
    message: String,
    value_is_signed: Boolean,
) {
    var bound = constant(limit)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(fits, comparison, value, bound)
    compared.is_signed = compares_signed
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(value)
    var sign = 0
    if value_is_signed {
        sign = 1
    }
    stopped.signed_numbers.append(sign)
    emit(stopped)
    switch_to(after)
}

func article_of(name: String): String {
    var first = name.code_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func made_nullable(converted: Lowered, nullable_type: Model.Type): Lowered {
    if not is_a_nullable_scalar(nullable_type) {
        return carried(converted)
    }
    var present = constant(1)
    return Lowered(converted.value, present)
}

func lower_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall): Lowered {
    var outer = pending_releases
    pending_releases = List<Integer>()
    var library = lower_value(call.library)
    var library_model = layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = layout.offset_of(handle_attribute)
    var handle = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(handle, library.value, handle_offset, 'bits_64')
    emit(loaded)
    var address = new_register()
    var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(address, handle, call.function_name)
    emit(found)
    var arguments = List<Integer>()
    var decimal_sizes = List<Integer>()
    var callbacks = Callbacks(this)
    var structs = ForeignStructs(this)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = passed_into_c(argument, callbacks, structs)
        arguments.append(passed)
        var size = decimal_size_of(argument.value_type)
        decimal_sizes.append(size)
        index = index + 1
    }
    var target = new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    called.answers_32_bits = call.value_type.name == "Integer"
    called.decimal_sizes = decimal_sizes
    called.answer_decimal_size = decimal_size_of(call.value_type)
    var tracked = program.reports_faults
    if tracked {
        note_the_foreign_call(call, library.value)
    }
    emit(called)
    if tracked {
        var slot = foreign_slot()
        var unused_site = constant(0)
        var cleared = LowIntermediaryRepresentation.Instructions.Store(slot, 0, unused_site, 'bits_64')
        emit(cleared)
    }
    structs.written_back()
    callbacks.restore()
    release_the_pending()
    pending_releases = outer
    if call.value_type.kind == 'object' and call.value_type.name == "String" {
        var joins = TextJoins(this)
        return joins.copied_c_text(target, call.function_name)
    }
    return single(target)
}

func note_the_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall, library: Integer) {
    var text = "foreign={call.function_name}\tfrom={path}:{line}"
    program.foreign_sites.append(text)
    var site_number = program.foreign_sites.count()
    var site = constant(site_number)
    var slot = foreign_slot()
    var stored_site = LowIntermediaryRepresentation.Instructions.Store(slot, 0, site, 'bits_64')
    emit(stored_site)
    var stored_library = LowIntermediaryRepresentation.Instructions.Store(slot, 8, library, 'bits_64')
    emit(stored_library)
}

func foreign_slot(): Integer {
    var label = record_label_of("_foreign")
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    return slot
}

func decimal_size_of(of_type: Model.Type): Integer {
    if not is_a_decimal(of_type) {
        return 0
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func passed_into_c(
    argument: HighIntermediaryRepresentation.Values.Value,
    callbacks: Callbacks,
    structs: ForeignStructs,
): Integer {
    if argument.value_type.kind == 'function' {
        return callbacks.handed_for_the_call(argument)
    }
    if structs.is_a_struct(argument) {
        return structs.struct_of(argument)
    }
    if structs.is_a_number_list(argument) {
        return structs.storage_of_a_list(argument)
    }
    return foreign_argument(argument)
}

func foreign_argument(argument: HighIntermediaryRepresentation.Values.Value): Integer {
    var argument_value = lower_value(argument)
    var argument_type = argument.value_type
    release_later(argument_value, argument_type)
    if argument_type.kind == 'object' and argument_type.name == "String" {
        return bytes_of_text(argument_value.value)
    }
    if argument_type.kind == 'object' and argument_type.name == "Buffer" {
        return storage_of(argument_value.value)
    }
    return argument_value.value
}

func bytes_of_text(text: Integer): Integer {
    var string_model = layout.program.class_named("String")
    crash string_model
    var buffer_attribute = string_model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = layout.offset_of(buffer_attribute)
    var buffer = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, text, buffer_offset, 'bits_64')
    emit(loaded)
    return storage_of(buffer)
}

func storage_of(buffer: Integer): Integer {
    var storage = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(storage, buffer, layout.storage_offset, 'bits_64')
    emit(loaded)
    return storage
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func width_of(of_type: Model.Type): LowIntermediaryRepresentation.Width {
    if of_type.kind != 'scalar' {
        return 'bits_64'
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    switch scalar.size {
        1: return 'bits_8'
        2: return 'bits_16'
        4: return 'bits_32'
        _: return 'bits_64'
    }
}

func is_signed(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return true
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_signed and not scalar.is_decimal
}

func unbuilt(): Lowered {
    var buildable = Validators.HighIntermediaryRepresentation.Buildable.Validator()
    buildable.refuse(path, line, function.key)
    return single(-1)
}

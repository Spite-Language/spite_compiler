var state = FunctionLoweringState()

func FunctionLowering(starting_state: FunctionLoweringState) {
    state = starting_state
}

func lowered(
    high: HighIntermediaryRepresentation.HighFunction,
    starting_path: String,
): LowIntermediaryRepresentation.LowFunction {
    var frame_lists = FrameLists(state)
    var counting = Counting(state)
    var statements = Statements(state)
    var singletons = Singletons(state)
    state.path = starting_path
    var key = high.function.key()
    if state.resumable_mode {
        key = "{key}$step"
    }
    if state.skips_the_lock {
        key = "{key}$unguarded"
    }
    if state.copies_for_the_bands {
        key = "{key}$logged"
    }
    state.lowering_owner = high.function.owner
    state.lowering_name = high.function.name
    state.counts_the_answer = true
    if high.function.answer {
        state.counts_the_answer = not is_a_singleton_type(high.function.answer)
    }
    start(key)
    state.function.is_resumable = state.resumable_mode
    state.counts_alone = high.runs_alone and not state.resumable_mode and not state.skips_the_lock
    state.function.counts_alone = state.counts_alone
    frame_lists.note_the_frame_lists()
    state.column_items = Dictionary<String, String>()
    state.column_storages = Dictionary<String, Integer>()
    state.column_capacities = Dictionary<String, Integer>()
    state.column_indices = Dictionary<String, Integer>()
    state.column_addresses = Dictionary<String, Integer>()
    state.column_regions = Dictionary<String, String>()
    state.column_parts = List<String>()
    frame_lists.note_the_slot_appends(high)
    if high.function.declaration {
        note_the_place(high.function, high.function.declaration.line)
    } else if high.function.placed_at_line > 0 {
        note_the_place(high.function, high.function.placed_at_line)
    }
    state.resume_blocks = List<Integer>()
    var dispatch = state.current
    var this_register = new_register()
    state.locals["this"] = this_register
    state.scopes = List<List<Integer>>()
    var held = List<Integer>()
    state.scopes.append(held)
    note_the_borrowed_parameters(high)
    state.borrowed_sources = List<SpiteCompiler.Value>()
    note_the_fresh_attributes(high.function)
    high.function.parameters.each(take_parameter)
    state.function.parameter_count = state.function.register_count
    var body = state.current
    if state.resumable_mode {
        body = new_block()
        switch_to(body)
    }
    hold_the_parameters(high.function)
    var owner_key = high.function.owner
    var guarded = state.waits and not high.function.is_a_constructor() and not state.skips_the_lock
    if guarded and is_locked_here() {
        state.locks_its_singleton = true
        state.locked_class = owner_key
        singletons.lock_the_singleton()
    }
    var columns = ColumnLists(this)
    if high.function.name == "_reserve" and columns.is_columnar(owner_key) {
        columns.write_the_reserve(owner_key)
        return state.function
    }
    statements.lower_block(high.body)
    if not state.terminated {
        counting.release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1, -1, false)
        emit(nothing)
    }
    if state.resumable_mode {
        dispatch_the_resumes(dispatch, body)
    }
    return state.function
}

func note_the_borrowed_parameters(high: HighIntermediaryRepresentation.HighFunction) {
    state.borrows_parameters = false
    state.reassigned_names = List<String>()
    fallback not state.resumable_mode
    fallback state.assignments
    state.reassigned_names = state.assignments.names_assigned_in(high.body)
    state.borrows_parameters = true
}

func note_the_place(model: Model.FunctionModel, declared_line: Integer) {
    var owner_model = state.layout.program.class_named(model.owner)
    var owner_shown = model.owner
    if owner_model {
        owner_shown = owner_model.shown
    }
    state.function.place = "{state.path}:{declared_line}\t{owner_shown}\t{model.name}"
}

func dispatch_the_resumes(dispatch: Integer, body: Integer) {
    switch_to(dispatch)
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var resumed = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(resumed, frame, 0, 'bits_64', true, "", false)
    emit(loaded)
    var index = 0
    while index < state.resume_blocks.count() {
        var target = state.resume_blocks[index]
        var number = constant(index + 1)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', resumed, number, true)
        emit(compared)
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, target, next)
        emit(test)
        switch_to(next)
        index = index + 1
    }
    jump_to(body)
}

func resume_point(): Integer {
    var block = new_block()
    jump_to(block)
    switch_to(block)
    state.resume_blocks.append(block)
    return state.resume_blocks.count()
}

func suspend_unless(holds: Integer, point: Integer) {
    var waiting = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(holds, after, waiting)
    emit(test)
    switch_to(waiting)
    suspend_at(point)
    switch_to(after)
}

func suspend_at(point: Integer) {
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var number = constant(point)
    var stored = LowIntermediaryRepresentation.Instructions.Store(frame, 0, number, 'bits_64', "", false)
    emit(stored)
    var zero = constant(0)
    var returned = LowIntermediaryRepresentation.Instructions.Return(zero, -1, true)
    emit(returned)
}

func blocks(key: String): Boolean {
    fallback state.waits
    return state.waits.helps_blocking_calls() and state.waits.blocks(key)
}

# ../../../spite_documentation/repl.md#remote---repl-port
func waits_in_the_library(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback state.waits
    var called_key = call.function.key()
    fallback state.waits.reaches_a_wait(called_key)
    var owner = state.layout.program.class_named(call.function.owner)
    fallback owner
    var library = Mapping.LibraryFile()
    return library.holds(owner.file.path)
}

func is_locked_here(): Boolean {
    fallback state.waits
    return state.waits.is_locked(state.function.key)
}

func is_resumable(key: String): Boolean {
    fallback state.waits
    return state.waits.is_resumable(key)
}

func counts_an_answer(of_type: Model.Type): Boolean {
    return is_a_pointer(of_type) and not is_a_singleton_type(of_type)
}

func is_a_singleton_type(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object'
    var model = state.layout.program.class_named(of_type.name)
    fallback model
    return model.is_singleton
}

func start(key: String) {
    state.function = LowIntermediaryRepresentation.LowFunction(key, 0)
    state.counts_alone = false
    state.locals = Dictionary<String, Integer>()
    state.plain_registers = List<Integer>()
    state.atomic_registers = List<Integer>()
    state.local_presences = Dictionary<String, Integer>()
    var first = new_block()
    switch_to(first)
}

func take_parameter(parameter: Model.ParameterModel) {
    var value = new_register()
    state.locals[parameter.name] = value
    if is_a_nullable_scalar(parameter.parameter_type) {
        var presence = new_register()
        state.local_presences[parameter.name] = presence
    }
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func hold_the_parameters(model: Model.FunctionModel) {
    var key = model.key()
    var index = 0
    while index < model.parameters.count() {
        var parameter = model.parameters[index]
        if takes_the_argument(key, index) {
            hold_a_taken_parameter(parameter)
        } else {
            hold_a_parameter(parameter)
        }
        index = index + 1
    }
}

func takes_the_argument(key: String, index: Integer): Boolean {
    fallback not state.resumable_mode and state.taken
    return state.taken.is_taken(key, index)
}

func hands_the_argument(callee: String, index: Integer): Boolean {
    fallback state.taken
    return state.taken.is_taken(callee, index)
}

func hold_a_taken_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    var register = state.locals[parameter.name]
    crash register
    counting.hold(register)
}

func note_the_fresh_attributes(model: Model.FunctionModel) {
    state.fresh_attributes = List<String>()
    fallback not state.resumable_mode and model.is_a_constructor()
    var found = state.fresh_by_constructor[model.key()]
    fallback found
    var index = 0
    while index < found.count() {
        var name = found[index]
        state.fresh_attributes.append(name)
        index = index + 1
    }
}

func hold_a_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    fallback is_a_pointer(parameter.parameter_type)
    fallback not state.borrows_parameters or state.reassigned_names.contains(parameter.name)
    var register = state.locals[parameter.name]
    crash register
    counting.retain_counted(register, parameter.parameter_type)
    counting.note_the_count(register, parameter.parameter_type)
    counting.hold(register)
}

func width_of_a_presence(): LowIntermediaryRepresentation.Instructions.Load.Width {
    if state.layout.packs {
        return 'bits_8'
    }
    return 'bits_64'
}

func is_a_pointer(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'handle' {
        return true
    }
    return kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
}

func new_register(): Integer {
    var made = state.function.register_count
    state.function.register_count = made + 1
    return made
}

func reserve_registers(count: Integer) {
    state.function.register_count = state.function.register_count + count
}

func new_block(): Integer {
    var made = LowIntermediaryRepresentation.LowBlock()
    state.function.blocks.append(made)
    return state.function.blocks.count() - 1
}

func switch_to(block: Integer) {
    state.current = block
    state.terminated = false
}

func note_the_line(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        note_a_call_line(instruction)
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.CallAt {
        note_a_call_at_line(instruction)
    }
}

func note_a_call_line(call: LowIntermediaryRepresentation.Instructions.Call) {
    if call.line == 0 {
        call.line = state.line
    }
}

func note_a_call_at_line(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    if call.line == 0 {
        call.line = state.line
    }
}

func emit(instruction: SpiteCompiler.Instruction) {
    if state.terminated {
        var unreachable = new_block()
        switch_to(unreachable)
    }
    var block = state.function.blocks[state.current]
    crash block
    note_the_line(instruction)
    if state.copies_for_the_bands {
        log_through_the_copies(instruction)
    }
    if state.in_a_logged_section and instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        state.program.logged_root_calls.append(instruction)
        state.logged_section_calls = state.logged_section_calls + 1
    }
    block.instructions.append(instruction)
    var ends = instruction.class == LowIntermediaryRepresentation.Instructions.Jump
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Branch
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Return
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Exit
    if instruction.class == LowIntermediaryRepresentation.Instructions.Stop {
        ends = not instruction.continues
    }
    state.terminated = ends
}

# ../../OPTIMIZATIONS.md#a-call-that-only-changes-a-singleton-waits-for-the-join
func log_through_the_copies(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        if state.logged_names.contains(instruction.function) {
            instruction.function = "{instruction.function}$logged"
        }
        return
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.FunctionAddress and state.logged_names.contains(instruction.function) {
        instruction.function = "{instruction.function}$logged"
    }
}

func jump_to(block: Integer) {
    if not state.terminated {
        var jump = LowIntermediaryRepresentation.Instructions.Jump(block)
        emit(jump)
    }
}

func constant(number: Long): Integer {
    var target = new_register()
    var made = LowIntermediaryRepresentation.Instructions.Constant(target, number)
    emit(made)
    return target
}

func data_label(bytes: Buffer): Integer {
    state.program.data.append(bytes)
    return state.program.data.count() - 1
}

func text_label(text: String): Integer {
    var bytes = text.to_buffer()
    var label = data_label(bytes)
    state.program.constant_labels.append(label)
    return label
}

func lower_a_statement(statement: SpiteCompiler.Statement) {
    var statements = Statements(state)
    if statement.class != HighIntermediaryRepresentation.Statements.Assign.Attribute {
        state.fresh_attributes = List<String>()
    }
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: statements.lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: statements.lower_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: statements.lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: statements.lower_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: statements.lower_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: statements.lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: statements.lower_while(statement)
        HighIntermediaryRepresentation.Statements.Return: statements.lower_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: statements.lower_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: statements.lower_block(statement)
    }
}

func is_unsigned_whole(name: String): Boolean {
    return name == "Byte" or name == "UnsignedShort" or name == "UnsignedInteger" or name == "UnsignedLong"
}

func lower_value(value: SpiteCompiler.Value?): Lowered {
    var values = Values(state)
    var calls = Calls(state)
    var conversions = Conversions(state)
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return values.lower_whole_number(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return values.lower_decimal_number(value)
        HighIntermediaryRepresentation.Values.TextConstant: return values.lower_text(value)
        HighIntermediaryRepresentation.Values.NullConstant: return values.lower_null(value.value_type)
        HighIntermediaryRepresentation.Values.LocalRead: return values.lower_local(value)
        HighIntermediaryRepresentation.Values.ThisRead: return values.lower_this()
        HighIntermediaryRepresentation.Values.AttributeRead: return values.lower_attribute(value)
        HighIntermediaryRepresentation.Values.Call: return calls.lower_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: return values.lower_make_object(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return values.lower_operation(value)
        HighIntermediaryRepresentation.Values.Negation: return values.lower_negation(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return calls.lower_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Membership: return values.lower_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return values.lower_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: return conversions.lower_conversion(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return values.lower_number_room(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return conversions.lower_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: return conversions.lower_enum_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return conversions.lower_enum_from_text(value)
        HighIntermediaryRepresentation.Values.Class.Object: return values.lower_class_object(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: return values.lower_class_of_value(value)
        HighIntermediaryRepresentation.Values.Function.Value: return calls.lower_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return calls.lower_function_value_call(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return values.lower_function_fact(value)
    }
}

func single(register: Integer): Lowered {
    return Lowered(register, -1)
}

func address_plus(base: Integer, offset_register: Integer): Integer {
    var target = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(
        target,
        'add',
        base,
        offset_register,
        'bits_64',
        false,
        false,
    )
    emit(added)
    return target
}

func is_a_decimal(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_size_of(of_type: Model.Type): Integer {
    fallback is_a_decimal(of_type)
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func storage_of(buffer: Integer): Integer {
    var storage = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(
        storage,
        buffer,
        state.layout.storage_offset,
        'bits_64',
        true,
        "Buffer.$storage",
        false,
    )
    emit(loaded)
    return storage
}

# ../../OPTIMIZATIONS.md#an-attribute-a-loop-only-reads-is-read-before-it
func items_region_of(owner_key: String, element: Model.Type): String {
    if element.kind == 'scalar' or element.kind == 'enumeration' {
        return "{owner_key}.[]"
    }
    return ""
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func width_of(of_type: Model.Type): LowIntermediaryRepresentation.Instructions.Load.Width {
    if of_type.kind != 'scalar' {
        return 'bits_64'
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    if scalar.size == 1 {
        return 'bits_8'
    } else if scalar.size == 2 {
        return 'bits_16'
    } else if scalar.size == 4 {
        return 'bits_32'
    } else {
        return 'bits_64'
    }
}

func is_signed(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return true
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_signed and not scalar.is_decimal
}

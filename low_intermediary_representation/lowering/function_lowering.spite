var state = LoweringState()
var _largest_long: Long = 9223372036854775807
var _largest_float_as_double_bits: Long = 5183643170566569984
var _infinity_as_double_bits: Long = 9218868437227405312
var _double_exponent_bias: Integer = 1023

func FunctionLowering(starting_state: LoweringState) {
    state = starting_state
}

func lowered(
    high: HighIntermediaryRepresentation.HighFunction,
    starting_path: String,
): LowIntermediaryRepresentation.LowFunction {
    var frame_lists = FrameLists(state)
    var counting = Counting(state)
    var statements = Statements(state)
    state.path = starting_path
    var key = high.function.key()
    if state.resumable_mode {
        key = "{key}$step"
    }
    if state.skips_the_lock {
        key = "{key}$unguarded"
    }
    state.lowering_owner = high.function.owner
    state.lowering_name = high.function.name
    state.counts_the_answer = true
    if high.function.answer {
        state.counts_the_answer = not is_a_singleton_type(high.function.answer)
    }
    start(key)
    state.function.is_resumable = state.resumable_mode
    frame_lists.note_the_frame_lists()
    state.column_items = Dictionary<String, String>()
    state.column_storages = Dictionary<String, Integer>()
    state.column_capacities = Dictionary<String, Integer>()
    state.column_indices = Dictionary<String, Integer>()
    state.column_addresses = Dictionary<String, Integer>()
    state.column_regions = Dictionary<String, String>()
    state.column_parts = List<String>()
    frame_lists.note_the_slot_appends(high)
    if high.function.declaration {
        note_the_place(high.function, high.function.declaration.line)
    } else if high.function.placed_at_line > 0 {
        note_the_place(high.function, high.function.placed_at_line)
    }
    state.resume_blocks = List<Integer>()
    var dispatch = state.current
    var this_register = new_register()
    state.locals["this"] = this_register
    state.scopes = List<List<Integer>>()
    var held = List<Integer>()
    state.scopes.append(held)
    note_the_borrowed_parameters(high)
    state.borrowed_sources = List<SpiteCompiler.Value>()
    note_the_fresh_attributes(high.function)
    high.function.parameters.each(take_parameter)
    state.function.parameter_count = state.function.register_count
    var body = state.current
    if state.resumable_mode {
        body = new_block()
        switch_to(body)
    }
    hold_the_parameters(high.function)
    var owner_key = high.function.owner
    var guarded = state.waits and not high.function.is_constructor and not state.skips_the_lock
    if guarded and is_locked_here() {
        state.locks_its_singleton = true
        state.locked_class = owner_key
        lock_the_singleton()
    }
    var columns = ColumnLists(this)
    if high.function.name == "_reserve" and columns.is_columnar(owner_key) {
        columns.write_the_reserve(owner_key)
        return state.function
    }
    statements.lower_block(high.body)
    if not state.terminated {
        counting.release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
        emit(nothing)
    }
    if state.resumable_mode {
        dispatch_the_resumes(dispatch, body)
    }
    return state.function
}

func note_the_borrowed_parameters(high: HighIntermediaryRepresentation.HighFunction) {
    state.borrows_parameters = false
    state.reassigned_names = List<String>()
    fallback not state.resumable_mode
    fallback state.assignments
    state.reassigned_names = state.assignments.names_assigned_in(high.body)
    state.borrows_parameters = true
}

func note_the_place(model: Model.FunctionModel, declared_line: Integer) {
    var owner_model = state.layout.program.class_named(model.owner)
    var owner_shown = model.owner
    if owner_model {
        owner_shown = owner_model.shown
    }
    state.function.place = "{state.path}:{declared_line}\t{owner_shown}\t{model.name}"
}

func dispatch_the_resumes(dispatch: Integer, body: Integer) {
    switch_to(dispatch)
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var resumed = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(resumed, frame, 0, 'bits_64')
    emit(loaded)
    var index = 0
    while index < state.resume_blocks.count() {
        var target = state.resume_blocks[index]
        var number = constant(index + 1)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', resumed, number)
        emit(compared)
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, target, next)
        emit(test)
        switch_to(next)
        index = index + 1
    }
    jump_to(body)
}

func resume_point(): Integer {
    var block = new_block()
    jump_to(block)
    switch_to(block)
    state.resume_blocks.append(block)
    return state.resume_blocks.count()
}

func suspend_unless(holds: Integer, point: Integer) {
    var waiting = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(holds, after, waiting)
    emit(test)
    switch_to(waiting)
    suspend_at(point)
    switch_to(after)
}

func suspend_at(point: Integer) {
    var frame = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(frame)
    emit(found)
    var number = constant(point)
    var stored = LowIntermediaryRepresentation.Instructions.Store(frame, 0, number, 'bits_64')
    emit(stored)
    var zero = constant(0)
    var returned = LowIntermediaryRepresentation.Instructions.Return(zero)
    returned.is_a_suspension = true
    emit(returned)
}

func blocks(key: String): Boolean {
    fallback state.waits
    return state.waits.blocks(key)
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func waits_in_the_library(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback state.waits
    var called_key = call.function.key()
    fallback state.waits.reaches_a_wait(called_key)
    var owner = state.layout.program.class_named(call.function.owner)
    fallback owner
    var library = Mapping.LibraryFile()
    return library.holds(owner.file.path)
}

func is_locked_here(): Boolean {
    fallback state.waits
    return state.waits.is_locked(state.function.key)
}

func is_resumable(key: String): Boolean {
    fallback state.waits
    return state.waits.is_resumable(key)
}

func lowered_call_arguments(call: HighIntermediaryRepresentation.Values.Call): List<Integer> {
    var arguments = List<Integer>()
    var receiver = lower_value(call.receiver)
    crash call.receiver
    var unknown = unknown_callees()
    passed_on(receiver, call.receiver, unknown)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, unknown)
    return arguments
}

func unknown_callees(): List<String> {
    var unknown = List<String>()
    unknown.append("$unknown")
    return unknown
}

func passed_on(value: Lowered, given: SpiteCompiler.Value, called_keys: List<String>) {
    var counting = Counting(state)
    counting.release_later(value, given.value_type)
    fallback is_a_pointer(given.value_type) and not value.owned
    fallback not is_steady(given, called_keys)
    counting.retain_counted(value.value, given.value_type)
    counting.note_the_count(value.value, given.value_type)
    state.pending_releases.append(value.value)
}

func is_steady(given: SpiteCompiler.Value?, called_keys: List<String>): Boolean {
    crash given
    if is_a_singleton_type(given.value_type) {
        return true
    }
    switch given {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.Conversion: return carries_steadily(given, called_keys)
        HighIntermediaryRepresentation.Values.AttributeRead: return is_a_steady_attribute(given, called_keys)
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func counts_an_answer(of_type: Model.Type): Boolean {
    return is_a_pointer(of_type) and not is_a_singleton_type(of_type)
}

func is_a_singleton_type(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object'
    var model = state.layout.program.class_named(of_type.name)
    fallback model
    return model.is_singleton
}

func carries_steadily(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    called_keys: List<String>,
): Boolean {
    fallback conversion.kind != 'join' and conversion.kind != 'into_handle'
    return is_steady(conversion.converted, called_keys)
}

func is_a_steady_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    called_keys: List<String>,
): Boolean {
    fallback not state.layout.is_back(read.attribute)
    fallback is_steady(read.object, called_keys)
    fallback state.assignments
    return not state.assignments.may_assign(called_keys, read.attribute)
}

func start(key: String) {
    state.function = LowIntermediaryRepresentation.LowFunction(key, 0)
    state.locals = Dictionary<String, Integer>()
    state.plain_registers = List<Integer>()
    state.atomic_registers = List<Integer>()
    state.local_presences = Dictionary<String, Integer>()
    var first = new_block()
    switch_to(first)
}

func take_parameter(parameter: Model.ParameterModel) {
    var value = new_register()
    state.locals[parameter.name] = value
    if is_a_nullable_scalar(parameter.parameter_type) {
        var presence = new_register()
        state.local_presences[parameter.name] = presence
    }
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func hold_the_parameters(model: Model.FunctionModel) {
    var key = model.key()
    var index = 0
    while index < model.parameters.count() {
        var parameter = model.parameters[index]
        if takes_the_argument(key, index) {
            hold_a_taken_parameter(parameter)
        } else {
            hold_a_parameter(parameter)
        }
        index = index + 1
    }
}

func takes_the_argument(key: String, index: Integer): Boolean {
    fallback not state.resumable_mode and state.taken
    return state.taken.is_taken(key, index)
}

func hands_the_argument(callee: String, index: Integer): Boolean {
    fallback state.taken
    return state.taken.is_taken(callee, index)
}

func hold_a_taken_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    var register = state.locals[parameter.name]
    crash register
    counting.hold(register)
}

func note_the_fresh_attributes(model: Model.FunctionModel) {
    state.fresh_attributes = List<String>()
    fallback not state.resumable_mode and model.is_constructor
    var found = state.fresh_by_constructor[model.key()]
    fallback found
    var index = 0
    while index < found.count() {
        var name = found[index]
        state.fresh_attributes.append(name)
        index = index + 1
    }
}

func hold_a_parameter(parameter: Model.ParameterModel) {
    var counting = Counting(state)
    fallback is_a_pointer(parameter.parameter_type)
    fallback not state.borrows_parameters or state.reassigned_names.contains(parameter.name)
    var register = state.locals[parameter.name]
    crash register
    counting.retain_counted(register, parameter.parameter_type)
    counting.note_the_count(register, parameter.parameter_type)
    counting.hold(register)
}

func width_of_a_presence(): LowIntermediaryRepresentation.Instructions.Load.Width {
    if state.layout.packs {
        return 'bits_8'
    }
    return 'bits_64'
}

func is_a_pointer(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'handle' {
        return true
    }
    return kind == 'object' or kind == 'union' or kind == 'shape' or kind == 'function'
}

func new_register(): Integer {
    var made = state.function.register_count
    state.function.register_count = made + 1
    return made
}

func reserve_registers(count: Integer) {
    state.function.register_count = state.function.register_count + count
}

func new_block(): Integer {
    var made = LowIntermediaryRepresentation.LowBlock()
    state.function.blocks.append(made)
    return state.function.blocks.count() - 1
}

func switch_to(block: Integer) {
    state.current = block
    state.terminated = false
}

func note_the_line(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        note_a_call_line(instruction)
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.CallAt {
        note_a_call_at_line(instruction)
    }
}

func note_a_call_line(call: LowIntermediaryRepresentation.Instructions.Call) {
    if call.line == 0 {
        call.line = state.line
    }
}

func note_a_call_at_line(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    if call.line == 0 {
        call.line = state.line
    }
}

func emit(instruction: SpiteCompiler.Instruction) {
    if state.terminated {
        var unreachable = new_block()
        switch_to(unreachable)
    }
    var block = state.function.blocks[state.current]
    crash block
    note_the_line(instruction)
    block.instructions.append(instruction)
    var ends = instruction.class == LowIntermediaryRepresentation.Instructions.Jump
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Branch
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Return
    ends = ends or instruction.class == LowIntermediaryRepresentation.Instructions.Exit
    if instruction.class == LowIntermediaryRepresentation.Instructions.Stop {
        ends = not instruction.continues
    }
    state.terminated = ends
}

func jump_to(block: Integer) {
    if not state.terminated {
        var jump = LowIntermediaryRepresentation.Instructions.Jump(block)
        emit(jump)
    }
}

func constant(number: Long): Integer {
    var target = new_register()
    var made = LowIntermediaryRepresentation.Instructions.Constant(target, number)
    emit(made)
    return target
}

func data_label(bytes: Buffer): Integer {
    state.program.data.append(bytes)
    return state.program.data.count() - 1
}

func text_label(text: String): Integer {
    var bytes = text.to_buffer()
    var label = data_label(bytes)
    state.program.constant_labels.append(label)
    return label
}

func lower_a_statement(statement: SpiteCompiler.Statement) {
    var statements = Statements(state)
    if statement.class != HighIntermediaryRepresentation.Statements.Assign.Attribute {
        state.fresh_attributes = List<String>()
    }
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: statements.lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: statements.lower_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: statements.lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: statements.lower_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: statements.lower_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: statements.lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: statements.lower_while(statement)
        HighIntermediaryRepresentation.Statements.Return: statements.lower_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: statements.lower_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: statements.lower_block(statement)
    }
}

# ../../PROOFS.md#no-attribute-is-read-past-the-lock
func count_inside_the_lock(loaded: Lowered, attribute: Model.AttributeModel) {
    var counting = Counting(state)
    var attribute_type = attribute.attribute_type
    fallback is_a_pointer(attribute_type) and not loaded.owned
    counting.retain_counted(loaded.value, attribute_type)
    loaded.owned = true
}

func reads_a_changing_attribute(attribute: Model.AttributeModel): Boolean {
    crash state.waits
    return state.waits.is_assigned_after_making(attribute)
}

# ../../PROOFS.md#read-only-and-atomic-singletons
func reads_under_the_lock(attribute: Model.AttributeModel): Boolean {
    fallback not state.program.lone_atomic_attributes.contains("{attribute.owner}.{attribute.name}")
    return reads_a_changing_attribute(attribute)
}

func locks_from_outside(owner_key: String): Boolean {
    fallback state.waits and owner_key != state.lowering_owner
    return state.waits.is_a_locked_class(owner_key)
}

func is_unsigned_whole(name: String): Boolean {
    return name == "Byte" or name == "UnsignedShort" or name == "UnsignedInteger" or name == "UnsignedLong"
}

func lower_value(value: SpiteCompiler.Value?): Lowered {
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return lower_whole_number(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return lower_decimal_number(value)
        HighIntermediaryRepresentation.Values.TextConstant: return lower_text(value)
        HighIntermediaryRepresentation.Values.NullConstant: return lower_null(value.value_type)
        HighIntermediaryRepresentation.Values.LocalRead: return lower_local(value)
        HighIntermediaryRepresentation.Values.ThisRead: return lower_this()
        HighIntermediaryRepresentation.Values.AttributeRead: return lower_attribute(value)
        HighIntermediaryRepresentation.Values.Call: return lower_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: return lower_make_object(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return lower_operation(value)
        HighIntermediaryRepresentation.Values.Negation: return lower_negation(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return lower_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Membership: return lower_class_test(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return lower_presence_test(value)
        HighIntermediaryRepresentation.Values.Conversion: return lower_conversion(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return lower_number_room(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return lower_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: return lower_enum_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return lower_enum_from_text(value)
        HighIntermediaryRepresentation.Values.Class.Object: return lower_class_object(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: return lower_class_of_value(value)
        HighIntermediaryRepresentation.Values.Function.Value: return lower_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return lower_function_value_call(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return lower_function_fact(value)
    }
}

func lower_function_fact(fact: HighIntermediaryRepresentation.Values.Function.Fact): Lowered {
    crash fact.is_answered
    var number = 0
    if fact.answer {
        number = 1
    }
    var register = constant(number)
    return single(register)
}

func lower_whole_number(number: HighIntermediaryRepresentation.Values.WholeNumber): Lowered {
    var register = constant(number.number)
    return single(register)
}

func lower_decimal_number(number: HighIntermediaryRepresentation.Values.DecimalNumber): Lowered {
    var bits: Long = 0
    if number.value_type.name == "Float" {
        var parsed_float: Float? = number.written
        crash parsed_float
        bits = parsed_float.bits()
    } else {
        var parsed: Double? = number.written
        crash parsed
        bits = parsed.bits()
    }
    var register = constant(bits)
    return single(register)
}

func single(register: Integer): Lowered {
    return Lowered(register, -1)
}

func lower_null(null_type: Model.Type): Lowered {
    var zero = constant(0)
    if not is_a_nullable_scalar(null_type) {
        return single(zero)
    }
    var absent = constant(0)
    return Lowered(zero, absent)
}

func lower_this(): Lowered {
    var this_register = state.locals["this"]
    crash this_register
    return single(this_register)
}

func lower_local(read: HighIntermediaryRepresentation.Values.LocalRead): Lowered {
    var held_in_columns = state.column_parts.contains(read.name) or state.column_items.contains(read.name)
    if held_in_columns and not state.locals.contains(read.name) {
        var columns = ColumnLists(this)
        return columns.handed_out_whole(read.value_type.name)
    }
    var register = state.locals[read.name]
    crash register
    var presence = state.local_presences[read.name]
    if presence and read.value_type.is_nullable {
        return Lowered(register, presence)
    }
    return single(register)
}

func lower_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead): Lowered {
    var counting = Counting(state)
    var columns = ColumnLists(this)
    var from_columns = columns.read_of(read)
    if from_columns {
        return from_columns
    }
    var standing = state.layout.standing_in_for(read)
    if standing {
        return lower_value(standing)
    }
    var object = lower_value(read.object)
    crash read.object
    var region = region_of(read.object.value_type, read.attribute)
    var owner_key = read.attribute.owner
    var takes_the_lock = locks_from_outside(owner_key) and reads_under_the_lock(read.attribute)
    if takes_the_lock {
        lock_a_singleton(owner_key)
    }
    var loaded = load_attribute_in(object.value, read.attribute, region)
    if takes_the_lock {
        count_inside_the_lock(loaded, read.attribute)
        unlock_a_singleton(owner_key)
    }
    if state.layout.is_back(read.attribute) and not read.value_type.is_nullable {
        stop_if_gone(loaded, "{read.attribute.owner}.{read.attribute.name}")
    }
    var is_a_temporary = is_a_pointer(read.object.value_type) and object.owned
    if state.gathers_for_the_statement and is_a_temporary {
        state.statement_releases.append(object.value)
    } else {
        counting.release_later(object, read.object.value_type)
    }
    return loaded
}

func region_of(object_type: Model.Type, attribute: Model.AttributeModel): String {
    fallback object_type.kind == 'object' and object_type.name == attribute.owner
    return "{attribute.owner}.{attribute.name}"
}

func load_attribute(object_register: Integer, attribute: Model.AttributeModel): Lowered {
    return load_attribute_in(object_register, attribute, "")
}

func load_attribute_in(object_register: Integer, attribute: Model.AttributeModel, region: String): Lowered {
    var rebuilder = state.layout.rebuilder_of(attribute)
    if rebuilder {
        return rebuilt_in_place(object_register, rebuilder)
    }
    var object = single(object_register)
    var offset = state.layout.offset_of(attribute)
    if state.layout.is_embedded(attribute) {
        return the_part_inside(object_register, offset)
    }
    var attribute_type = attribute.attribute_type
    var target = new_register()
    var width = width_of(attribute_type)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(target, object.value, offset, width)
    loaded.is_signed = is_signed(attribute_type)
    loaded.region = region
    emit(loaded)
    if state.layout.is_back(attribute) {
        return held_back(target)
    }
    if not is_a_nullable_scalar(attribute_type) {
        return single(target)
    }
    var presence = new_register()
    var presence_offset = state.layout.presence_offset_of(attribute)
    var presence_width = width_of_a_presence()
    var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(
        presence,
        object.value,
        presence_offset,
        presence_width,
    )
    loaded_presence.is_signed = false
    if not region.is_empty() {
        loaded_presence.region = "{region}?"
    }
    emit(loaded_presence)
    return Lowered(target, presence)
}

# ../../OPTIMIZATIONS.md#an-object-only-its-holder-holds-lives-inside-it
func the_part_inside(object: Integer, offset: Integer): Lowered {
    var room = constant(offset)
    var part = new_register()
    var found = LowIntermediaryRepresentation.Instructions.Arithmetic(part, 'add', object, room)
    found.is_checked = false
    emit(found)
    return single(part)
}

func store_the_part_inside(object: Integer, attribute: Model.AttributeModel, value: Lowered) {
    var counting = Counting(state)
    var embedded_parts = Validators.HighIntermediaryRepresentation.EmbeddedParts.Validator()
    embedded_parts.check(value.owned, state.path, state.line, state.function.key, "{attribute.owner}.{attribute.name}")
    var offset = state.layout.offset_of(attribute)
    var part = the_part_inside(object, offset)
    var held = attribute.attribute_type.name
    var model = state.layout.program.class_named(held)
    crash model
    var id_number = state.layout.class_id_of(held)
    var class_id = constant(id_number)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(part.value, 0, class_id, 'bits_64')
    emit(stored_id)
    var count = constant(state.layout.immortal_count)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(part.value, 8, count, 'bits_64')
    emit(stored_count)
    var index = 0
    while index < model.declared_attributes.count() {
        var copied = model.declared_attributes[index]
        copy_a_number(value.value, part.value, copied)
        index = index + 1
    }
    counting.release(value.value)
}

func copy_a_number(from: Integer, into: Integer, copied: Model.AttributeModel) {
    fallback state.layout.has_a_slot(copied)
    var offset = state.layout.offset_of(copied)
    var width = width_of(copied.attribute_type)
    var region = "{copied.owner}.{copied.name}"
    var number = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(number, from, offset, width)
    loaded.is_signed = is_signed(copied.attribute_type)
    loaded.region = region
    emit(loaded)
    var stored = LowIntermediaryRepresentation.Instructions.Store(into, offset, number, width)
    stored.region = region
    emit(stored)
}

func rebuilt_in_place(object: Integer, rebuilder: Model.FunctionModel): Lowered {
    var counting = Counting(state)
    var target = new_register()
    var arguments = List<Integer>()
    arguments.append(object)
    var key = rebuilder.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, arguments)
    emit(called)
    if not rebuilder.answer or counts_an_answer(rebuilder.answer) {
        return counting.owned(target)
    }
    return single(target)
}

# ../../PROOFS.md#a-back-reference-read-holds-its-object
func held_back(object: Integer): Lowered {
    var counting = Counting(state)
    var held = new_register()
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.Call(held, "_back_counted", arguments)
    emit(called)
    return counting.owned(held)
}

func lower_text(text: HighIntermediaryRepresentation.Values.TextConstant): Lowered {
    var joins = TextJoins(this)
    return joins.lower_text(text)
}

func address_plus(base: Integer, offset_register: Integer): Integer {
    var target = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'add', base, offset_register)
    added.is_signed = false
    added.is_checked = false
    emit(added)
    return target
}

func lower_make_object(made: HighIntermediaryRepresentation.Values.MakeObject): Lowered {
    var counting = Counting(state)
    var class_key = made.value_type.name
    var made_model = state.layout.program.class_named(class_key)
    crash made_model
    if state.program.static_singletons.contains(class_key) {
        var static_object = static_object_of(class_key)
        return single(static_object)
    }
    if made_model.is_singleton {
        var made_singleton = singleton_of(class_key, made)
        return single(made_singleton)
    }
    var object = make_object_for(class_key, made)
    call_the_constructor(object, made)
    if class_key == "ForeignCallback" {
        var callbacks = Callbacks(this)
        callbacks.handed_over(object, made)
    }
    return counting.owned(object)
}

# ../../OPTIMIZATIONS.md#a-singleton-that-holds-nothing-is-a-static-object
func static_object_of(class_key: String): Integer {
    var known = state.program.static_objects[class_key]
    var label = 0
    if known {
        label = known
    } else {
        label = static_object_label(class_key)
    }
    var object = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(object, label)
    emit(addressed)
    return object
}

func static_object_label(class_key: String): Integer {
    var size = state.layout.made_size_of(class_key)
    var bytes = Buffer(0)
    var index = 0
    while index < size {
        bytes.append(0)
        index = index + 1
    }
    var class_id: Long = state.layout.class_id_of(class_key)
    bytes.write_long_little_endian_at(0, class_id)
    bytes.write_long_little_endian_at(8, state.layout.immortal_count)
    var label = data_label(bytes)
    state.program.static_objects[class_key] = label
    state.program.name_state(label, "static.{class_key}")
    return label
}

func make_object_for(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    if made.skips_the_defaults {
        return make_object_with(class_key, "")
    }
    if made.constructor {
        var constructor_key = made.constructor.key()
        if state.trimmed_keys.contains(constructor_key) {
            return make_object_with(class_key, "{constructor_key}$defaults")
        }
        expect_slots_with_defaults(constructor_key)
    }
    return make_object(class_key)
}

func expect_slots_with_defaults(constructor_key: String) {
    var expects_its_slots_fresh = state.fresh_by_constructor.contains(constructor_key)
    crash not expects_its_slots_fresh
}

func make_object(class_key: String): Integer {
    return make_object_with(class_key, "{class_key}._attribute_defaults")
}

func make_object_with(class_key: String, defaults_key: String): Integer {
    var is_a_text = class_key == "String" and defaults_key == "String._attribute_defaults"
    if is_a_text and state.layout.plain_text_room >= 0 and state.layout.holds_texts_whole() {
        var joins = TextJoins(this)
        return joins.empty_text(state.layout.plain_text_room)
    }
    var size = state.layout.made_size_of(class_key)
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    var class_id = state.layout.class_id_of(class_key)
    allocated.class_id = class_id
    allocated.zeroed_bytes = state.layout.size_of(class_key)
    emit(allocated)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    if state.layout.is_back_held(class_key) {
        var back_slot = state.layout.back_offset_of(class_key)
        var stored_back = LowIntermediaryRepresentation.Instructions.Store(object, back_slot, one, 'bits_64')
        emit(stored_back)
    }
    if not defaults_key.is_empty() {
        var arguments = List<Integer>()
        arguments.append(object)
        var defaults = LowIntermediaryRepresentation.Instructions.Call(-1, defaults_key, arguments)
        emit(defaults)
    }
    return object
}

func call_the_constructor(object: Integer, made: HighIntermediaryRepresentation.Values.MakeObject) {
    var counting = Counting(state)
    fallback made.constructor
    var constructor_key = made.constructor.key()
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var arguments = List<Integer>()
    arguments.append(object)
    var constructing = List<String>()
    constructing.append(constructor_key)
    add_arguments(arguments, made.arguments, constructing)
    if state.resumable_mode and is_resumable(constructor_key) and not is_a_singleton_class(made.value_type.name) {
        var working = Working(this)
        working.waited_into(constructor_key, arguments, -1, -1)
    } else {
        var called = LowIntermediaryRepresentation.Instructions.Call(-1, constructor_key, arguments)
        emit(called)
    }
    counting.release_the_pending()
    state.pending_releases = outer
}

func is_a_singleton_class(class_key: String): Boolean {
    var made_model = state.layout.program.class_named(class_key)
    crash made_model
    return made_model.is_singleton
}

func singleton_of(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    var slot_key = singleton_slot_key(class_key, made)
    var label = slot_label_of(slot_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var object = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    emit(loaded)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    emit(compared)
    var making = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, making, after)
    emit(test)
    switch_to(making)
    var maker_key = maker_of(class_key, made, label)
    var no_arguments = List<Integer>()
    var called = LowIntermediaryRepresentation.Instructions.Call(object, maker_key, no_arguments)
    emit(called)
    jump_to(after)
    switch_to(after)
    return object
}

func maker_of(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject, label: Integer): String {
    var key = "_make_{class_key}${label}"
    if state.program.hot_reload {
        var slot_key = singleton_slot_key(class_key, made)
        key = "_make_{slot_key}"
    }
    if state.program.singleton_makers.contains(key) {
        return key
    }
    state.program.singleton_makers.append(key)
    var maker_state = LoweringState()
    maker_state.start_from(state.layout, state.program, state.singleton_slots)
    var maker = FunctionLowering(maker_state)
    maker.state.waits = state.waits
    maker.state.assignments = state.assignments
    maker.state.trimmed_keys = state.trimmed_keys
    maker.state.makes_work = state.makes_work
    maker.state.path = state.path
    maker.state.line = state.line
    maker.write_the_maker(key, class_key, made, label, state.function.place)
    state.program.lowered_functions.append(maker.state.function)
    return key
}

func write_the_maker(
    key: String,
    class_key: String,
    made: HighIntermediaryRepresentation.Values.MakeObject,
    label: Integer,
    place: String,
) {
    start(key)
    state.function.place = place
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var object = new_register()
    var after = new_block()
    halt_on_state(
        slot,
        3,
        "spite: a drop() at exit used the singleton {class_key} after it was destroyed: singletons are destroyed in reverse order of when they were made, so keep {class_key} in an attribute of the singleton whose drop() uses it\n",
    )
    var thread = new_register()
    var no_arguments = List<Integer>()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(thread, "GetCurrentThreadId", no_arguments)
    emit(asked)
    var never_made = constant(0)
    var being_made = constant(1)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 16, never_made, being_made)
    emit(claimed)
    var won = new_register()
    var compared_claim = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, never_made)
    emit(compared_claim)
    var building = new_block()
    var someone_else = new_block()
    var claim_test = LowIntermediaryRepresentation.Instructions.Branch(won, building, someone_else)
    emit(claim_test)
    switch_to(someone_else)
    wait_for_the_maker(slot, thread, class_key, object, after)
    switch_to(building)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(slot, 32, thread, 'bits_64')
    emit(kept_thread)
    var fresh = make_object(class_key)
    call_the_constructor(fresh, made)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    var finished = constant(2)
    var marked_made = LowIntermediaryRepresentation.Instructions.Store(slot, 16, finished, 'bits_64')
    emit(marked_made)
    record_the_making(slot, class_key)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(object, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    var answered = LowIntermediaryRepresentation.Instructions.Return(object)
    emit(answered)
}

func singleton_slot_key(class_key: String, made: HighIntermediaryRepresentation.Values.MakeObject): String {
    if made.arguments.is_empty() {
        return class_key
    }
    var written = List<String>()
    var index = 0
    while index < made.arguments.count() {
        var argument = made.arguments[index]
        var shown = literal_key_of(argument)
        written.append(shown)
        index = index + 1
    }
    var joined = written.join(", ")
    return "{class_key}({joined})"
}

func literal_key_of(value: SpiteCompiler.Value): String {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number.to_string()
    }
    if value.class == HighIntermediaryRepresentation.Values.DecimalNumber {
        return value.written
    }
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text.to_debug()
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        return literal_key_of(value.converted)
    }
    crash
}

func lock_the_singleton() {
    lock_a_singleton(state.locked_class)
}

func lock_a_singleton(class_key: String) {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var thread = new_register()
    var asked = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    emit(asked)
    var trying = new_block()
    var again = new_block()
    var taken = new_block()
    var unowned = new_block()
    var owner = new_register()
    var loaded_owner = LowIntermediaryRepresentation.Instructions.Load(owner, slot, 40, 'bits_64')
    emit(loaded_owner)
    var mine = new_register()
    var compared_owner = LowIntermediaryRepresentation.Instructions.Compare(mine, 'equal', owner, thread)
    emit(compared_owner)
    var owner_test = LowIntermediaryRepresentation.Instructions.Branch(mine, taken, unowned)
    emit(owner_test)
    switch_to(unowned)
    if state.waits and state.waits.skips_locks_while_idle() {
        claim_while_idle(slot, thread, trying, taken)
    } else {
        jump_to(trying)
    }
    switch_to(trying)
    var free = constant(0)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 40, free, thread)
    emit(claimed)
    var won = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, free)
    emit(compared)
    var won_test = LowIntermediaryRepresentation.Instructions.Branch(won, taken, again)
    emit(won_test)
    switch_to(again)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(trying)
    switch_to(taken)
    if state.waits and state.waits.shares_the_lock(class_key) {
        wait_for_the_readers(slot)
    }
    var depth = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(depth, slot, 48, 'bits_64')
    emit(loaded)
    var one = constant(1)
    var deeper = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(deeper, 'add', depth, one)
    added.is_checked = false
    emit(added)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 48, deeper, 'bits_64')
    emit(stored)
}

func claim_while_idle(slot: Integer, thread: Integer, trying: Integer, taken: Integer) {
    var tasks_label = record_label_of("$tasks")
    var tasks = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(tasks, tasks_label)
    emit(addressed)
    var running = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(running, tasks, 0, 'bits_64')
    emit(loaded)
    var none_running = constant(0)
    var idle = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(idle, 'equal', running, none_running)
    emit(compared)
    var claiming = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(idle, claiming, trying)
    emit(test)
    switch_to(claiming)
    var claimed = LowIntermediaryRepresentation.Instructions.Store(slot, 40, thread, 'bits_64')
    emit(claimed)
    jump_to(taken)
}

func count_a_task(amount: Long) {
    var tasks_label = record_label_of("$tasks")
    var tasks = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(tasks, tasks_label)
    emit(addressed)
    var left = new_register()
    var counted = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, tasks, 0, amount)
    emit(counted)
}

func unlock_the_singleton() {
    unlock_a_singleton(state.locked_class)
}

func unlock_a_singleton(class_key: String) {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var depth = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(depth, slot, 48, 'bits_64')
    emit(loaded)
    var one = constant(1)
    var shallower = new_register()
    var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(shallower, 'subtract', depth, one)
    subtracted.is_checked = false
    emit(subtracted)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 48, shallower, 'bits_64')
    emit(stored)
    var zero = constant(0)
    var released = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(released, 'equal', shallower, zero)
    emit(compared)
    var freeing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(released, freeing, after)
    emit(test)
    switch_to(freeing)
    var opened = LowIntermediaryRepresentation.Instructions.Store(slot, 40, zero, 'bits_64')
    emit(opened)
    jump_to(after)
    switch_to(after)
}

func wait_for_the_filling(slot: Integer, thread: Integer, made: Integer, after: Integer) {
    var maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(maker, slot, 32, 'bits_64')
    emit(loaded_maker)
    var is_this_thread = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_this_thread, 'equal', maker, thread)
    emit(compared)
    var taking = new_block()
    var waiting = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_this_thread, taking, waiting)
    emit(test)
    switch_to(waiting)
    var slot_state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(slot_state, slot, 16, 'bits_64')
    emit(loaded_state)
    var filled = constant(2)
    var is_filled = new_register()
    var compared_state = LowIntermediaryRepresentation.Instructions.Compare(is_filled, 'equal', slot_state, filled)
    emit(compared_state)
    var pausing = new_block()
    var filled_test = LowIntermediaryRepresentation.Instructions.Branch(is_filled, taking, pausing)
    emit(filled_test)
    switch_to(pausing)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(waiting)
    switch_to(taking)
    var taken = LowIntermediaryRepresentation.Instructions.Load(made, slot, 0, 'bits_64')
    emit(taken)
    jump_to(after)
}

func wait_for_the_maker(slot: Integer, thread: Integer, class_key: String, object: Integer, after: Integer) {
    var maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(maker, slot, 32, 'bits_64')
    emit(loaded_maker)
    var is_this_thread = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_this_thread, 'equal', maker, thread)
    emit(compared)
    var circling = new_block()
    var waiting = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_this_thread, circling, waiting)
    emit(test)
    switch_to(circling)
    var circle = ""
    if state.waits {
        circle = state.waits.circle_of(class_key)
    }
    var message = "spite: singleton '{class_key}' is asked for while it is being made: a singleton cannot reach itself as it initialises\n"
    if not circle.is_empty() {
        message = "spite: singleton {circle}: singletons initialise each other in a circle\n"
    }
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(waiting)
    var slot_state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(slot_state, slot, 16, 'bits_64')
    emit(loaded_state)
    var made_state = constant(2)
    var is_made = new_register()
    var compared_state = LowIntermediaryRepresentation.Instructions.Compare(is_made, 'equal', slot_state, made_state)
    emit(compared_state)
    var pausing = new_block()
    var taking = new_block()
    var made_test = LowIntermediaryRepresentation.Instructions.Branch(is_made, taking, pausing)
    emit(made_test)
    switch_to(pausing)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(waiting)
    switch_to(taking)
    var taken = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    emit(taken)
    jump_to(after)
}

func halt_on_state(slot: Integer, slot_state: Integer, message: String) {
    var current = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(current, slot, 16, 'bits_64')
    emit(loaded)
    var wanted = constant(slot_state)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', current, wanted)
    emit(compared)
    var halting = new_block()
    var going_on = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, halting, going_on)
    emit(test)
    switch_to(halting)
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(going_on)
}

func record_the_making(slot: Integer, class_key: String) {
    record_with(slot, "_destroy_{class_key}")
}

# ../../ARCHITECTURE.md#the-list-let-go-at-exit
func record_with(slot: Integer, destroy_name: String) {
    var head_label = made_singletons_label()
    var head = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(head, head_label)
    emit(addressed)
    var destroy = new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(destroy, destroy_name)
    emit(found)
    var kept_destroy = LowIntermediaryRepresentation.Instructions.Store(slot, 24, destroy, 'bits_64')
    emit(kept_destroy)
    var pushing = new_block()
    var recorded = new_block()
    jump_to(pushing)
    switch_to(pushing)
    var newest = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(newest, head, 0, 'bits_64')
    emit(loaded)
    var linked = LowIntermediaryRepresentation.Instructions.Store(slot, 8, newest, 'bits_64')
    emit(linked)
    var before = new_register()
    var pushed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, head, 0, newest, slot)
    emit(pushed)
    var unchanged = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(unchanged, 'equal', before, newest)
    emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(unchanged, recorded, pushing)
    emit(test)
    switch_to(recorded)
}

func made_singletons_label(): Integer {
    return record_label_of("")
}

func slot_label_of(class_key: String): Integer {
    return record_label_of(class_key)
}

func record_label_of(class_key: String): Integer {
    var known = state.singleton_slots[class_key]
    if known {
        return known
    }
    var empty = Buffer(0)
    var index = 0
    while index < 64 {
        empty.append(0)
        index = index + 1
    }
    var label = data_label(empty)
    state.singleton_slots[class_key] = label
    state.program.name_state(label, "singleton.{class_key}")
    return label
}

func add_arguments(arguments: List<Integer>, values: List<SpiteCompiler.Value>, called_keys: List<String>) {
    var callee = taking_callee(called_keys)
    var index = 0
    while index < values.count() {
        var value = values[index]
        if hands_the_argument(callee, index) {
            var handed = handed_over(value)
            arguments.append(handed)
        } else if is_a_held_argument(value, values, called_keys) {
            var held = lower_a_held_argument(value)
            arguments.append(held.value)
        } else {
            var argument_value = lower_value(value)
            passed_on(argument_value, value, called_keys)
            arguments.append(argument_value.value)
            if argument_value.presence >= 0 {
                arguments.append(argument_value.presence)
            }
        }
        index = index + 1
    }
    note_a_handed_call(callee)
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func taking_callee(called_keys: List<String>): String {
    fallback state.taken and called_keys.count() == 1
    var key = called_keys[0]
    fallback state.taken.takes_any(key)
    return key
}

func handed_over(value: SpiteCompiler.Value): Integer {
    var counting = Counting(state)
    var handed = counting.lower_a_kept_value(value)
    if not handed.owned {
        counting.retain_counted(handed.value, value.value_type)
    }
    return handed.value
}

func note_a_handed_call(callee: String) {
    fallback not callee.is_empty()
    var known = state.program.handed_calls[callee]
    if known {
        state.program.handed_calls[callee] = known + 1
    } else {
        state.program.handed_calls[callee] = 1
    }
}

func lower_call(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var counting = Counting(state)
    var statements = Statements(state)
    var intrinsic = Intrinsics(this)
    var is_an_intrinsic = not call.function.has_a_body() and not call.function.is_written_by_the_compiler
    if is_an_intrinsic {
        return intrinsic.lowered(call)
    }
    var reads = ListReads(this)
    if reads.is_a_count(call) {
        return reads.counted(call)
    }
    var joins = TextJoins(this)
    if joins.is_a_join(call) {
        return joins.joined(call)
    }
    if joins.is_an_append(call) {
        return joins.appended(call)
    }
    var called_key = call.function.key()
    var working = Working(this)
    if state.resumable_mode and is_resumable(called_key) {
        return working.waiting_call(call)
    }
    if state.resumable_mode and called_key == "Program.sleep" {
        return working.waiting_sleep(call)
    }
    if state.makes_work and blocks(called_key) and not is_locked_here() {
        return working.helped(call)
    }
    if state.makes_work and called_key == "Program.sleep" and not is_locked_here() {
        return working.plain_sleep(call)
    }
    if state.program.prompt_sleeps and called_key == "Program.sleep" {
        return sleep_answering_the_prompt(call)
    }
    var add_a_check_point = false
    if statements.checks_points() and not is_locked_here() and waits_in_the_library(call) {
        add_a_check_point = true
        statements.write_a_check_point()
    }
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var arguments = List<Integer>()
    var calling = List<String>()
    calling.append(called_key)
    var held = is_a_held_receiver(call, calling)
    var receiver = lower_a_receiver(call, held)
    crash call.receiver
    if not held {
        passed_on(receiver, call.receiver, calling)
    }
    counting.settle_before_clearing(call, receiver.value)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, calling)
    var answer = finished_call(call, arguments)
    if add_a_check_point {
        statements.write_a_check_point()
    }
    counting.release_the_pending()
    state.pending_releases = outer
    return answer
}

# ../../../spite_spec/specs/repl.md#--repl-portport
func sleep_answering_the_prompt(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var statements = Statements(state)
    var milliseconds = sleep_milliseconds(call)
    var arguments = List<Integer>()
    arguments.append(milliseconds)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_prompt_sleep", arguments)
    emit(called)
    if statements.checks_points() and not is_locked_here() {
        statements.write_a_check_point()
    }
    return Lowered(-1, -1)
}

# ../../../spite_spec/specs/concurrency.md#what-runs-at-once
func sleep_milliseconds(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var duration_value = call.arguments[0]
    crash duration_value
    var duration_model = state.layout.program.class_named("Duration")
    crash duration_model
    var total = duration_model.function_named("total")
    crash total
    var unit_parameter = total.parameters[0]
    crash unit_parameter
    var unit_model = duration_model.enum_named("Unit")
    crash unit_model
    var place = unit_model.values.index_of("milliseconds")
    crash place
    var unit_number = unit_model.numbers[place]
    crash unit_number
    var unit_type = unit_parameter.parameter_type.present()
    var unit_value = HighIntermediaryRepresentation.Values.WholeNumber(unit_type, unit_number)
    var unit_arguments = List<SpiteCompiler.Value>()
    unit_arguments.append(unit_value)
    var reading = HighIntermediaryRepresentation.Values.Call(total, duration_value, unit_arguments)
    var milliseconds = lower_value(reading)
    return milliseconds.value
}

func is_a_held_receiver(call: HighIntermediaryRepresentation.Values.Call, calling: List<String>): Boolean {
    var given = call.receiver
    if given.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_held_item(given, call, calling)
    }
    return false
}

func lower_a_receiver(call: HighIntermediaryRepresentation.Values.Call, held: Boolean): Lowered {
    var given = call.receiver
    if given.class == HighIntermediaryRepresentation.Values.Conversion {
        return lower_a_held_conversion(given, held)
    }
    return lower_value(given)
}

func lower_a_held_conversion(given: HighIntermediaryRepresentation.Values.Conversion, held: Boolean): Lowered {
    if held {
        var reads = ListReads(this)
        return reads.held_item(given)
    }
    return lower_value(given)
}

func is_a_held_item(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    fallback conversion.kind == 'proven' and not state.resumable_mode
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        return is_a_held_read(read, call, calling)
    }
    return false
}

func is_a_held_read(
    read: HighIntermediaryRepresentation.Values.Call,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    var reads = ListReads(this)
    fallback reads.is_a_plain_get(read) and is_a_pointer(read.value_type)
    fallback is_steady(read.receiver, calling) and read.arguments.all(is_plain_reading)
    fallback call.arguments.all(is_plain_reading)
    return leaves_the_items(calling, read.function.owner)
}

# ../../OPTIMIZATIONS.md#an-item-a-call-cannot-let-go-is-passed-without-counting
func is_a_held_argument(
    value: SpiteCompiler.Value,
    values: List<SpiteCompiler.Value>,
    called_keys: List<String>,
): Boolean {
    fallback not state.resumable_mode and not called_keys.contains("$unknown")
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_held_item_argument(value, values, called_keys)
    }
    return false
}

func is_a_held_item_argument(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    values: List<SpiteCompiler.Value>,
    called_keys: List<String>,
): Boolean {
    fallback conversion.kind == 'proven'
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        fallback is_a_steady_item_read(read, called_keys)
        fallback values.all(reads_without_writing)
        return leaves_the_items(called_keys, read.function.owner)
    }
    return false
}

func is_a_steady_item_read(read: HighIntermediaryRepresentation.Values.Call, called_keys: List<String>): Boolean {
    var reads = ListReads(this)
    fallback reads.is_a_plain_get(read) and is_a_pointer(read.value_type)
    return is_steady(read.receiver, called_keys) and read.arguments.all(is_plain_reading)
}

func reads_without_writing(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_proven_plain_get(value)
    }
    return is_plain_reading(value)
}

func is_a_proven_plain_get(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    fallback conversion.kind == 'proven'
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        var reads = ListReads(this)
        fallback reads.is_a_plain_get(read) and is_plain_reading_of(read.receiver)
        return read.arguments.all(is_plain_reading)
    }
    return false
}

func lower_a_held_argument(value: SpiteCompiler.Value): Lowered {
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        var reads = ListReads(this)
        return reads.held_item(value)
    }
    crash
}

func leaves_the_items(calling: List<String>, list_key: String): Boolean {
    fallback state.assignments
    return not state.assignments.may_write_items(calling, list_key)
}

func is_plain_reading(value: SpiteCompiler.Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_plain_reading_of(value.object)
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Conversion: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func is_plain_reading_of(object: SpiteCompiler.Value?): Boolean {
    fallback object
    return is_plain_reading(object)
}

func finished_call(call: HighIntermediaryRepresentation.Values.Call, arguments: List<Integer>): Lowered {
    var counting = Counting(state)
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var written_key = call.function.key()
    var function_key = unguarded_in_a_coarse_loop(written_key)
    var called = LowIntermediaryRepresentation.Instructions.Call(target, function_key, arguments)
    called.known_positions = call.known_positions
    called.known_regions = call.known_regions
    called.known_values = call.known_values
    if is_a_nullable_scalar(call.value_type) {
        var presence = new_register()
        called.presence = presence
        emit(called)
        return Lowered(target, presence)
    }
    emit(called)
    if counts_an_answer(call.value_type) {
        return counting.owned(target)
    }
    return single(target)
}

func unguarded_in_a_coarse_loop(key: String): String {
    if state.coarse_class.is_empty() or not state.waits {
        return key
    }
    if state.waits.owner_of(key) != state.coarse_class or not state.waits.is_locked(key) {
        return key
    }
    if not state.program.unguarded_keys.contains(key) {
        state.program.unguarded_keys.append(key)
    }
    return "{key}$unguarded"
}

func lower_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    var counting = Counting(state)
    if operation.operator == 'and' or operation.operator == 'or' {
        return lower_logic(operation)
    }
    if operation.is_folded {
        var folded = constant(operation.folded_number)
        return single(folded)
    }
    var left = lower_value(operation.left)
    var right = lower_value(operation.right)
    var target = new_register()
    crash operation.left
    var operand_type = operation.left.value_type
    var comparison = comparison_of(operation.operator)
    if is_a_decimal(operand_type) {
        return decimal_operation(operation, operand_type, left.value, right.value, target)
    }
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.Compare(target, comparison, left.value, right.value)
        compared.is_signed = is_signed(operand_type)
        emit(compared)
        counting.discard(left, operand_type)
        crash operation.right
        counting.discard(right, operation.right.value_type)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(
        target,
        arithmetic_operator,
        left.value,
        right.value,
    )
    computed.width = width_of(operand_type)
    computed.is_signed = is_signed(operand_type)
    computed.is_checked = not operation.is_proven_to_fit
    var divides = arithmetic_operator == 'divide' or arithmetic_operator == 'remainder'
    if divides {
        computed.is_checked = not operation.is_divisor_proven
    }
    computed.line = state.line
    computed.shown = operation.shown
    computed.type_name = operand_type.name
    computed.path = state.path
    emit(computed)
    return single(target)
}

func is_a_decimal(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_operation(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    operand_type: Model.Type,
    left: Integer,
    right: Integer,
    target: Integer,
): Lowered {
    var is_double = operand_type.name == "Double"
    var comparison = comparison_of(operation.operator)
    if comparison {
        var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(target, comparison, left, right)
        compared.is_double = is_double
        emit(compared)
        return single(target)
    }
    var arithmetic_operator = arithmetic_of(operation.operator)
    if arithmetic_operator == 'remainder' {
        return exact_remainder(left, right, target, is_double)
    }
    var computed = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        target,
        arithmetic_operator,
        left,
        right,
    )
    computed.is_double = is_double
    emit(computed)
    return single(target)
}

# ../../OPTIMIZATIONS.md#the-maths-functions-are-one-call-into-the-c-library
func exact_remainder(left: Integer, right: Integer, target: Integer, is_double: Boolean): Lowered {
    var size = 4
    var name = "fmodf"
    if is_double {
        size = 8
        name = "fmod"
    }
    var arguments = List<Integer>()
    arguments.append(left)
    arguments.append(right)
    var sizes = List<Integer>()
    sizes.append(size)
    sizes.append(size)
    var computed = LowIntermediaryRepresentation.Instructions.ImportCall(target, name, arguments)
    computed.library = "ucrtbase.dll"
    computed.decimal_sizes = sizes
    computed.answer_decimal_size = size
    emit(computed)
    return single(target)
}

func lower_logic(operation: HighIntermediaryRepresentation.Values.MachineOperation): Lowered {
    var target = new_register()
    var left = lower_value(operation.left)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, left.value)
    emit(copied)
    var testing_block = state.current
    var right_block = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(left.value, right_block, after)
    if operation.operator == 'or' {
        test = LowIntermediaryRepresentation.Instructions.Branch(left.value, after, right_block)
    }
    var pending_before = state.pending_releases.count()
    var statement_before = state.statement_releases.count()
    switch_to(right_block)
    var right = lower_value(operation.right)
    var copied_right = LowIntermediaryRepresentation.Instructions.Copy(target, right.value)
    emit(copied_right)
    jump_to(after)
    switch_to(testing_block)
    clear_the_skipped(state.pending_releases, pending_before)
    clear_the_skipped(state.statement_releases, statement_before)
    emit(test)
    switch_to(after)
    return single(target)
}

func clear_the_skipped(releases: List<Integer>, first: Integer) {
    var index = first
    while index < releases.count() {
        var released = releases[index]
        var zero = LowIntermediaryRepresentation.Instructions.Constant(released, 0)
        emit(zero)
        index = index + 1
    }
}

func comparison_of(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): LowIntermediaryRepresentation.Instructions.Compare.Comparison? {
    switch operator {
        'equal': return 'equal'
        'not_equal': return 'not_equal'
        'less': return 'less'
        'less_or_equal': return 'less_or_equal'
        'greater': return 'greater'
        'greater_or_equal': return 'greater_or_equal'
        'add': return null
        'subtract': return null
        'multiply': return null
        'divide': return null
        'remainder': return null
        'and': return null
        'or': return null
    }
}

func arithmetic_of(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): LowIntermediaryRepresentation.Instructions.Arithmetic.Operator {
    switch operator {
        'add': return 'add'
        'subtract': return 'subtract'
        'multiply': return 'multiply'
        'divide': return 'divide'
        'remainder': return 'remainder'
        'equal': return 'remainder'
        'not_equal': return 'remainder'
        'less': return 'remainder'
        'less_or_equal': return 'remainder'
        'greater': return 'remainder'
        'greater_or_equal': return 'remainder'
        'and': return 'remainder'
        'or': return 'remainder'
    }
}

func lower_negation(negation: HighIntermediaryRepresentation.Values.Negation): Lowered {
    var negated = lower_value(negation.negated)
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', negated.value, zero)
    emit(compared)
    return single(target)
}

func lower_class_test(test: HighIntermediaryRepresentation.Values.Class.Membership): Lowered {
    var counting = Counting(state)
    var tested = lower_value(test.tested)
    crash test.tested
    counting.release_later(tested, test.tested.value_type)
    var target = new_register()
    var zero = constant(0)
    var present = new_register()
    var compared_present = LowIntermediaryRepresentation.Instructions.Compare(present, 'not_equal', tested.value, zero)
    emit(compared_present)
    var reading = new_block()
    var after = new_block()
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, present)
    emit(copied)
    var branched = LowIntermediaryRepresentation.Instructions.Branch(present, reading, after)
    emit(branched)
    switch_to(reading)
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, tested.value, 0, 'bits_64')
    emit(loaded)
    if test.member.kind == 'shape' {
        test_the_fillers(test.member, class_id, target)
    } else {
        var wanted = state.layout.class_id_of(test.member.name)
        var wanted_register = constant(wanted)
        var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'equal', class_id, wanted_register)
        emit(compared)
    }
    jump_to(after)
    switch_to(after)
    return single(target)
}

func test_the_fillers(shape: Model.Type, class_id: Integer, target: Integer) {
    var zero = constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var fillers = state.layout.program.fillers_of(shape.name)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if filler.kind == 'object' and not filler.is_a_walked_name {
            var wanted = state.layout.class_id_of(filler.name)
            var wanted_register = constant(wanted)
            var matched = new_register()
            var compared = LowIntermediaryRepresentation.Instructions.Compare(
                matched,
                'equal',
                class_id,
                wanted_register,
            )
            emit(compared)
            var joined = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'bits_or', target, matched)
            joined.is_checked = false
            emit(joined)
        }
        index = index + 1
    }
}

func lower_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest): Lowered {
    var counting = Counting(state)
    var reads = ListReads(this)
    var ranged = reads.presence_of(test.tested)
    if ranged {
        return ranged
    }
    var tested = lower_value(test.tested)
    crash test.tested
    counting.release_later(tested, test.tested.value_type)
    if tested.presence >= 0 {
        return single(tested.presence)
    }
    var zero = constant(0)
    var target = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(target, 'not_equal', tested.value, zero)
    emit(compared)
    return single(target)
}

func lower_number_room(room: HighIntermediaryRepresentation.Values.NumberRoom): Lowered {
    var counting = Counting(state)
    var made = lower_value(room.made)
    var number = lower_value(room.number)
    var storage = storage_of(made.value)
    crash room.number
    var width = width_of(room.number.value_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(storage, 0, number.value, width)
    emit(stored)
    var buffer_model = state.layout.program.class_named("Buffer")
    crash buffer_model
    var count_attribute = buffer_model.attribute_named("item_count")
    crash count_attribute
    var count_offset = state.layout.offset_of(count_attribute)
    var counted = constant(room.width)
    var count_stored = LowIntermediaryRepresentation.Instructions.Store(made.value, count_offset, counted, 'bits_32')
    emit(count_stored)
    return counting.owned(made.value)
}

func lower_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    if conversion.kind == 'into_handle' {
        var starting = Working(this)
        return starting.started(conversion)
    }
    if conversion.kind == 'join' {
        var joining = Working(this)
        return joining.joined(conversion)
    }
    if conversion.kind == 'proven' {
        var reads = ListReads(this)
        var read = reads.read(conversion)
        if read {
            return read
        }
    }
    var converted = lower_value(conversion.converted)
    if conversion.kind == 'nullable' {
        return made_nullable(converted, conversion.value_type)
    }
    if conversion.kind == 'into_shape' {
        crash conversion.converted
        var boxed = conversion.converted.value_type
        if conversion.value_type.is_nullable and boxed.is_nullable {
            return boxed_into_a_maybe(converted, boxed)
        }
        return boxed_into_a_shape(converted, boxed)
    }
    crash conversion.converted
    var from_type = conversion.converted.value_type
    if conversion.kind == 'widen' and is_a_decimal(from_type) {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'narrow_decimal' {
        check_the_float_range(converted.value, from_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_decimal' {
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'to_whole' {
        check_the_decimal_range(converted.value, from_type, conversion.value_type)
        return decimal_converted(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'address' {
        return single(converted.value)
    }
    if conversion.kind == 'unbox' {
        var unboxed = new_register()
        var loaded_box = LowIntermediaryRepresentation.Instructions.Load(unboxed, converted.value, 16, 'bits_64')
        emit(loaded_box)
        return single(unboxed)
    }
    if conversion.kind == 'proven' {
        if from_type.is_nullable or converted.presence >= 0 {
            stop_if_missing(converted, conversion.shown)
        }
        return carried(converted)
    }
    if conversion.kind == 'narrow' {
        check_the_range(converted.value, from_type, conversion.value_type)
    }
    if conversion.kind == 'present' {
        stop_if_a_back_reference_is_gone(conversion.converted, converted)
    }
    return carried(converted)
}

# ../../PROOFS.md#a-back-reference-read-holds-its-object
func stop_if_a_back_reference_is_gone(value: SpiteCompiler.Value?, read: Lowered) {
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback state.layout.is_back(value.attribute)
    stop_if_gone(read, "{value.attribute.owner}.{value.attribute.name}")
}

func stop_if_gone(read: Lowered, shown: String) {
    var zero = constant(0)
    var present = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(present, 'not_equal', read.value, zero)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(present, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' was proven present, but its object was freed since, and a back reference holds no count: prove it again after the call that lets it go, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func carried(converted: Lowered): Lowered {
    var made = Lowered(converted.value, -1)
    made.owned = converted.owned
    return made
}

func stop_if_missing(converted: Lowered, shown: String) {
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, after, stopping)
    emit(test)
    switch_to(stopping)
    var label = text_label(
        "spite: '{shown}' is outside its list: a bound proves only the top of an index, and this one is below 0 or the list changed, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func lower_class_object(object: HighIntermediaryRepresentation.Values.Class.Object): Lowered {
    var kind = object.reflection_kind
    var slot_key = "{kind}:{object.described}"
    var label = slot_label_of(slot_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var made = new_register()
    var slot_state = new_register()
    var loaded_state = LowIntermediaryRepresentation.Instructions.Load(slot_state, slot, 16, 'bits_64')
    emit(loaded_state)
    var filled = constant(2)
    var is_filled = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_filled, 'equal', slot_state, filled)
    emit(compared)
    var making = new_block()
    var ready = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_filled, ready, making)
    emit(test)
    switch_to(ready)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(made, slot, 0, 'bits_64')
    emit(loaded)
    jump_to(after)
    switch_to(making)
    halt_on_state(
        slot,
        3,
        "spite: a drop() at exit read the {kind} of {object.described} after it was let go: reflection objects are let go at exit, newest first, after the singletons made after them\n",
    )
    var thread = new_register()
    var no_arguments = List<Integer>()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(thread, "GetCurrentThreadId", no_arguments)
    emit(asked)
    var never_made = constant(0)
    var being_made = constant(1)
    var before = new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, slot, 16, never_made, being_made)
    emit(claimed)
    var won = new_register()
    var compared_claim = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, never_made)
    emit(compared_claim)
    var building = new_block()
    var someone_else = new_block()
    var claim_test = LowIntermediaryRepresentation.Instructions.Branch(won, building, someone_else)
    emit(claim_test)
    switch_to(someone_else)
    wait_for_the_filling(slot, thread, made, after)
    switch_to(building)
    var kept_thread = LowIntermediaryRepresentation.Instructions.Store(slot, 32, thread, 'bits_64')
    emit(kept_thread)
    var fresh = reflection_object_of(kind)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, fresh, 'bits_64')
    emit(stored)
    record_with(slot, "_let_go_of_reflected_{kind}")
    var fill_arguments = List<Integer>()
    fill_arguments.append(fresh)
    var filling = LowIntermediaryRepresentation.Instructions.Call(-1, "{kind}._fill_{object.described}", fill_arguments)
    emit(filling)
    var marked = LowIntermediaryRepresentation.Instructions.Store(slot, 16, filled, 'bits_64')
    emit(marked)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(made, fresh)
    emit(copied)
    jump_to(after)
    switch_to(after)
    return single(made)
}

# ../../../spite_spec/specs/reflection.md#reflection-objects
func reflection_object_of(kind: String): Integer {
    var model = state.layout.program.class_named(kind)
    crash model
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var constructor_key = declared.key()
        if declared.is_constructor and state.trimmed_keys.contains(constructor_key) {
            return make_object_with(kind, "{constructor_key}$defaults")
        }
        index = index + 1
    }
    return make_object(kind)
}

func lower_class_of_value(made: HighIntermediaryRepresentation.Values.Class.OfValue): Lowered {
    var counting = Counting(state)
    var described = lower_value(made.described)
    var target = new_register()
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, described.value, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var index = 0
    while index < made.candidates.count() {
        var candidate = made.candidates[index]
        var wanted = state.layout.class_id_of(candidate)
        var wanted_register = constant(wanted)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var object = HighIntermediaryRepresentation.Values.Class.Object(made.value_type, candidate)
        var lowered_object = lower_class_object(object)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_object.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value of no class this program knows, at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    crash made.described
    counting.discard(described, made.described.value_type)
    return single(target)
}

func lower_symbol_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var counting = Counting(state)
    var text = lower_value(read.text)
    var target = new_register()
    var zero = constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, lowered_name.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        counting.release(lowered_name.value)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    counting.discard(text, read.text.value_type)
    return counting.owned(target)
}

func lower_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText): Lowered {
    var counting = Counting(state)
    if read.value_type.is_a_walked_name {
        return lower_symbol_from_text(read)
    }
    var text = lower_value(read.text)
    var target = new_register()
    var presence = new_register()
    var zero = constant(0)
    var absent = LowIntermediaryRepresentation.Instructions.Copy(presence, zero)
    emit(absent)
    var cleared = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(cleared)
    var after = new_block()
    var index = 0
    while index < read.enumeration.values.count() {
        var name = read.enumeration.values[index]
        var number = read.enumeration.numbers[index]
        crash number
        var named = HighIntermediaryRepresentation.Values.TextConstant(name)
        var lowered_name = lower_text(named)
        var arguments = List<Integer>()
        arguments.append(text.value)
        arguments.append(lowered_name.value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Call(matches, "String.equals", arguments)
        emit(compared)
        counting.release(lowered_name.value)
        var answering = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        emit(test)
        switch_to(answering)
        var value = constant(number)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, value)
        emit(copied)
        var one = constant(1)
        var present = LowIntermediaryRepresentation.Instructions.Copy(presence, one)
        emit(present)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    jump_to(after)
    switch_to(after)
    crash read.text
    counting.discard(text, read.text.value_type)
    return Lowered(target, presence)
}

func lower_enum_text(text: HighIntermediaryRepresentation.Values.EnumText): Lowered {
    var number = lower_value(text.number)
    return enum_text_of(number.value, text.enumeration, text.value_type)
}

func enum_text_of(number: Integer, enumeration: Model.EnumModel, string_type: Model.Type): Lowered {
    var counting = Counting(state)
    var target = new_register()
    var after = new_block()
    var index = 0
    while index < enumeration.values.count() {
        var name = enumeration.values[index]
        var value = enumeration.numbers[index]
        crash value
        var wanted = constant(value)
        var matches = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', number, wanted)
        emit(compared)
        var naming = new_block()
        var next = new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, naming, next)
        emit(test)
        switch_to(naming)
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(name)
        constant_text.value_type = string_type
        var made = lower_text(constant_text)
        var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
        emit(copied)
        jump_to(after)
        switch_to(next)
        index = index + 1
    }
    var label = text_label("spite: a value outside its enum '{enumeration.name}', at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
    return counting.owned(target)
}

func boxed_into_a_shape(converted: Lowered, boxed: Model.Type): Lowered {
    if boxed.kind == 'shape' {
        return carried(converted)
    }
    if boxed.is_nullable {
        return maybe_boxed(converted, boxed)
    }
    return present_boxed(converted, boxed)
}

func boxed_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    if boxed.is_a_walked_name {
        return symbol_into_a_maybe(converted, boxed)
    }
    if is_a_pointer(boxed) {
        return carried(converted)
    }
    var presence = converted.presence
    crash presence >= 0
    var target = new_register()
    var boxing = new_block()
    var missing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, missing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(missing)
    var nothing = constant(0)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, nothing)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func symbol_into_a_maybe(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    var zero = constant(0)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', converted.value, zero)
    emit(compared)
    var target = new_register()
    var boxing = new_block()
    var nothing_held = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, nothing_held, boxing)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(nothing_held)
    var copied_nothing = LowIntermediaryRepresentation.Instructions.Copy(target, zero)
    emit(copied_nothing)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func maybe_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    var presence = converted.presence
    if presence < 0 {
        var zero = constant(0)
        presence = new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(presence, 'not_equal', converted.value, zero)
        emit(compared)
    }
    var target = new_register()
    var boxing = new_block()
    var naming = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(presence, boxing, naming)
    emit(test)
    switch_to(boxing)
    var present_type = boxed.present()
    var present = Lowered(converted.value, -1)
    present.owned = converted.owned
    var made = present_boxed(present, present_type)
    if not made.owned {
        counting.retain(made.value)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, made.value)
    emit(copied)
    jump_to(after)
    switch_to(naming)
    var absent_size = state.layout.size_of("Spite.Absent")
    var absent = small_object("Spite.Absent", absent_size)
    var copied_absent = LowIntermediaryRepresentation.Instructions.Copy(target, absent)
    emit(copied_absent)
    jump_to(after)
    switch_to(after)
    return counting.owned(target)
}

func present_boxed(converted: Lowered, boxed: Model.Type): Lowered {
    var counting = Counting(state)
    if boxed.is_a_walked_name {
        counting.kept(converted, boxed)
        var symbol_box = small_object("Spite.SymbolBox", 24)
        var stored_symbol = LowIntermediaryRepresentation.Instructions.Store(symbol_box, 16, converted.value, 'bits_64')
        emit(stored_symbol)
        return counting.owned(symbol_box)
    }
    if boxed.kind == 'enumeration' {
        var enum_box = small_object(boxed.name, 24)
        var stored_enum = LowIntermediaryRepresentation.Instructions.Store(enum_box, 16, converted.value, 'bits_64')
        emit(stored_enum)
        return counting.owned(enum_box)
    }
    if boxed.kind != 'scalar' {
        return converted
    }
    var box = small_object(boxed.name, 24)
    var stored = LowIntermediaryRepresentation.Instructions.Store(box, 16, converted.value, 'bits_64')
    emit(stored)
    return counting.owned(box)
}

func small_object(class_key: String, size: Integer): Integer {
    var size_register = constant(size)
    var object = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(object, size_register)
    var class_id = state.layout.class_id_of(class_key)
    allocated.class_id = class_id
    allocated.zeroed_bytes = size
    emit(allocated)
    var id_register = constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    emit(stored_id)
    var one = constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    emit(stored_count)
    return object
}

func filled_members(call: HighIntermediaryRepresentation.Values.ShapeCall): List<String> {
    var filled = List<String>()
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        filled.append("{filler.name}.{call.member.name}")
        filled.append("{filler.name}.get_{call.member.name}")
        index = index + 1
    }
    return filled
}

func lower_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall): Lowered {
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var filled = filled_members(call)
    var receiver = lower_value(call.receiver)
    crash call.receiver
    passed_on(receiver, call.receiver, filled)
    var arguments = List<Integer>()
    add_arguments(arguments, call.arguments, filled)
    var target = -1
    var presence = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
    }
    var shared = shared_reading_filler(call)
    if shared {
        read_a_filling_attribute(call, shared, receiver.value, target, presence)
    } else {
        call_the_fillers(call, receiver.value, arguments, target, presence)
    }
    counting.release_the_pending()
    state.pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = counts_an_answer(call.value_type)
    return answer
}

func call_the_fillers(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    receiver: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var class_id = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, receiver, 0, 'bits_64')
    emit(loaded)
    var after = new_block()
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        call_a_filler(call, filler, receiver, class_id, arguments, target, presence, after)
        index = index + 1
    }
    var label = text_label("spite: no class fills '{call.shape.name}' here, at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

# ../../../spite_spec/specs/memory.md#the-memory-model
func is_a_shared_copy(call: HighIntermediaryRepresentation.Values.ShapeCall, filler: Model.Type): Boolean {
    var name = call.member.name
    fallback name == "copy" or name == "deep_copy" or name == "_deep_copy_in"
    if filler.kind == 'scalar' or filler.kind == 'enumeration' or filler.is_a_walked_name {
        return true
    }
    fallback filler.kind == 'object'
    if filler.name == "String" {
        return true
    }
    var filling_class = state.layout.program.class_named(filler.name)
    fallback filling_class
    return filling_class.is_singleton
}

func shared_reading_filler(call: HighIntermediaryRepresentation.Values.ShapeCall): Model.Type? {
    fallback call.arguments.is_empty()
    return shared_filler(call.shape.key, call.member.name)
}

func shared_filler(shape_key: String, member: String): Model.Type? {
    var shared = state.layout.shared_offset_of(shape_key, member)
    fallback shared >= 0
    var fillers = state.layout.program.fillers_of(shape_key)
    return fillers.first()
}

func call_a_filler(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    receiver: Integer,
    class_id: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
    after: Integer,
) {
    var counting = Counting(state)
    var filler_key = state.layout.box_key_of(filler)
    var wanted = state.layout.class_id_of(filler_key)
    var wanted_register = constant(wanted)
    var matches = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    emit(compared)
    var calling = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, calling, next)
    emit(test)
    switch_to(calling)
    if is_a_shared_copy(call, filler) {
        counting.retain_counted(receiver, call.value_type)
        var shared = LowIntermediaryRepresentation.Instructions.Copy(target, receiver)
        emit(shared)
        jump_to(after)
        switch_to(next)
        return
    }
    var own = receiver
    var is_boxed = filler.kind == 'scalar' or filler.kind == 'enumeration' or filler.is_a_walked_name
    if is_boxed {
        own = new_register()
        var unboxed = LowIntermediaryRepresentation.Instructions.Load(own, receiver, 16, 'bits_64')
        emit(unboxed)
    }
    var is_named = filler.kind == 'enumeration' or filler.is_a_walked_name
    var lists_no_attributes = is_named and call.member.name == "_attribute_list"
    if lists_no_attributes {
        var nothing_held = constant(0)
        var none_given = List<Integer>()
        none_given.append(nothing_held)
        var listed = LowIntermediaryRepresentation.Instructions.Call(
            target,
            "Spite.Attribute._no_attributes",
            none_given,
        )
        emit(listed)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.is_a_walked_name {
        counting.retain(own)
        var symbol_name = Lowered(own, -1)
        symbol_name.owned = true
        if call.member.name == "to_debug" {
            symbol_name = quoted_enum_text(symbol_name)
        }
        var copied_symbol = LowIntermediaryRepresentation.Instructions.Copy(target, symbol_name.value)
        emit(copied_symbol)
        jump_to(after)
        switch_to(next)
        return
    }
    if filler.kind == 'enumeration' {
        var enumeration = enum_model_of(filler.name)
        var string_type = call.value_type
        var named = enum_text_of(own, enumeration, string_type)
        if call.member.name == "to_debug" {
            named = quoted_enum_text(named)
        }
        var copied_name = LowIntermediaryRepresentation.Instructions.Copy(target, named.value)
        emit(copied_name)
        jump_to(after)
        switch_to(next)
        return
    }
    if fills_with_an_attribute(call, filler) {
        read_a_filling_attribute(call, filler, own, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    check_own_class_arguments(call, filler, arguments)
    var passed = List<Integer>()
    passed.append(own)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        passed.append(argument)
        index = index + 1
    }
    var member_name = call.member.name
    var filling_class = state.layout.program.class_named(filler.name)
    if filling_class and member_name == "to_string" and not filling_class.function_named("to_string") {
        member_name = "to_debug"
    }
    if filling_class and call.member.is_an_attribute {
        member_name = "get_{member_name}"
    }
    var key = "{filler.name}.{member_name}"
    if state.resumable_mode and is_resumable(key) {
        var working = Working(this)
        working.waited_into(key, passed, target, presence)
        jump_to(after)
        switch_to(next)
        return
    }
    var called = LowIntermediaryRepresentation.Instructions.Call(target, key, passed)
    called.presence = presence
    emit(called)
    jump_to(after)
    switch_to(next)
}

func enum_model_of(enum_key: String): Model.EnumModel {
    var parts = enum_key.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.layout.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func check_own_class_arguments(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    arguments: List<Integer>,
) {
    var model = state.layout.program.class_named(filler.name)
    fallback model
    var filling = model.function_named(call.member.name)
    fallback filling
    var index = 0
    while index < filling.parameters.count() and index < arguments.count() {
        var parameter = filling.parameters[index]
        var wanted = call.member.parameters[index]
        var argument = arguments[index]
        var takes_its_own = parameter.parameter_type.name == filler.name and parameter.parameter_type.kind == 'object'
        if wanted and takes_its_own and wanted.parameter_type.kind == 'shape' {
            check_an_own_class(call, model, argument)
        }
        index = index + 1
    }
}

func check_an_own_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    argument: Integer,
) {
    var argument_class = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(argument_class, argument, 0, 'bits_64')
    emit(loaded)
    var fillers = state.layout.program.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var other = fillers[index]
        if other.name != model.key {
            stop_on_another_class(call, model, other, argument_class)
        }
        index = index + 1
    }
}

func stop_on_another_class(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ClassModel,
    other: Model.Type,
    argument_class: Integer,
) {
    var other_key = state.layout.box_key_of(other)
    var other_id = state.layout.class_id_of(other_key)
    var other_register = constant(other_id)
    var same = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(same, 'equal', argument_class, other_register)
    emit(compared)
    var stopping = new_block()
    var next = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(same, stopping, next)
    emit(test)
    switch_to(stopping)
    var other_shown = other.name
    var other_model = state.layout.program.class_named(other.name)
    if other_model {
        other_shown = other_model.shown
    }
    var own_article = article_of(model.shown)
    var other_article = article_of(other_shown)
    var written = call.shown
    if written.is_empty() {
        written = "{call.shape.name}.{call.member.name}"
    }
    var label = text_label(
        "spite: '{written}' works in {own_article} {model.shown}, the class of its left side, and its right side is {other_article} {other_shown}, which is not one, at {state.path}:{state.line} in {state.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(next)
}

func fills_with_an_attribute(call: HighIntermediaryRepresentation.Values.ShapeCall, filler: Model.Type): Boolean {
    var model = state.layout.program.class_named(filler.name)
    if not model {
        return call.member.is_an_attribute
    }
    if model.attribute_named(call.member.name) {
        return call.member.is_an_attribute or call.arguments.is_empty()
    }
    return false
}

func read_a_filling_attribute(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    filler: Model.Type,
    object: Integer,
    target: Integer,
    presence: Integer,
) {
    var counting = Counting(state)
    var model = state.layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(call.member.name)
    crash attribute
    var loaded = load_attribute(object, attribute)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, loaded.value)
    emit(copied)
    if is_a_pointer(call.value_type) and not loaded.owned {
        counting.retain(target)
    }
    if presence >= 0 {
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, loaded.presence)
        emit(copied_presence)
    }
}

func quoted_enum_text(named: Lowered): Lowered {
    var counting = Counting(state)
    var quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var opening = lower_text(quote)
    var arguments = List<Integer>()
    arguments.append(opening.value)
    arguments.append(named.value)
    var joined = new_register()
    var summed = LowIntermediaryRepresentation.Instructions.Call(joined, "String.sum", arguments)
    emit(summed)
    counting.release(opening.value)
    counting.release(named.value)
    var closing_quote = HighIntermediaryRepresentation.Values.TextConstant("'")
    var closing = lower_text(closing_quote)
    var closing_arguments = List<Integer>()
    closing_arguments.append(joined)
    closing_arguments.append(closing.value)
    var finished = new_register()
    var closed = LowIntermediaryRepresentation.Instructions.Call(finished, "String.sum", closing_arguments)
    emit(closed)
    counting.release(joined)
    counting.release(closing.value)
    return counting.owned(finished)
}

func lower_function_value(made: HighIntermediaryRepresentation.Values.Function.Value): Lowered {
    var counting = Counting(state)
    var receiver = lower_value(made.receiver)
    crash made.receiver
    var value_class = "Spite.FunctionValue"
    if not is_a_pointer(made.receiver.value_type) {
        value_class = "Spite.FunctionValueOfANumber"
    }
    var object = small_object(value_class, 48)
    var address = new_register()
    var key = made.function.key()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, key)
    emit(found)
    var stored_address = LowIntermediaryRepresentation.Instructions.Store(object, 16, address, 'bits_64')
    stored_address.region = "Spite.FunctionValue.address"
    emit(stored_address)
    var frame_maker = constant(0)
    var stepper = constant(0)
    if is_resumable(key) {
        frame_maker = new_register()
        var found_maker = LowIntermediaryRepresentation.Instructions.FunctionAddress(frame_maker, "{key}$frame")
        emit(found_maker)
        stepper = new_register()
        var found_stepper = LowIntermediaryRepresentation.Instructions.FunctionAddress(stepper, "{key}$step")
        emit(found_stepper)
    }
    var stored_maker = LowIntermediaryRepresentation.Instructions.Store(object, 32, frame_maker, 'bits_64')
    emit(stored_maker)
    var stored_stepper = LowIntermediaryRepresentation.Instructions.Store(object, 40, stepper, 'bits_64')
    emit(stored_stepper)
    counting.kept(receiver, made.receiver.value_type)
    var stored_receiver = LowIntermediaryRepresentation.Instructions.Store(object, 24, receiver.value, 'bits_64')
    stored_receiver.region = "Spite.FunctionValue.receiver"
    emit(stored_receiver)
    return counting.owned(object)
}

func lower_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall): Lowered {
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var called = lower_value(call.called)
    crash call.called
    var unknown = unknown_callees()
    passed_on(called, call.called, unknown)
    var address = new_register()
    var loaded_address = LowIntermediaryRepresentation.Instructions.Load(address, called.value, 16, 'bits_64')
    loaded_address.region = "Spite.FunctionValue.address"
    emit(loaded_address)
    var receiver = new_register()
    var loaded_receiver = LowIntermediaryRepresentation.Instructions.Load(receiver, called.value, 24, 'bits_64')
    loaded_receiver.region = "Spite.FunctionValue.receiver"
    emit(loaded_receiver)
    var arguments = List<Integer>()
    arguments.append(receiver)
    add_arguments(arguments, call.arguments, unknown)
    var target = -1
    if not call.value_type.is_nothing() {
        target = new_register()
    }
    var made = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    var presence = -1
    if is_a_nullable_scalar(call.value_type) {
        presence = new_register()
        made.presence = presence
    }
    if state.resumable_mode {
        call_a_value_that_may_wait(made, called.value, arguments, target, presence)
    } else {
        emit(made)
    }
    counting.release_the_pending()
    state.pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = counts_an_answer(call.value_type)
    return answer
}

func call_a_value_that_may_wait(
    plain: LowIntermediaryRepresentation.Instructions.CallAt,
    called: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var frame_maker = new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(frame_maker, called, 32, 'bits_64')
    emit(loaded_maker)
    var zero = constant(0)
    var is_plain = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_plain, 'equal', frame_maker, zero)
    emit(compared)
    var calling = new_block()
    var framing = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_plain, calling, framing)
    emit(test)
    switch_to(calling)
    emit(plain)
    jump_to(after)
    switch_to(framing)
    var stepper = new_register()
    var loaded_stepper = LowIntermediaryRepresentation.Instructions.Load(stepper, called, 40, 'bits_64')
    emit(loaded_stepper)
    var frame = new_register()
    var made_frame = LowIntermediaryRepresentation.Instructions.CallAt(frame, frame_maker, arguments)
    emit(made_frame)
    var working = Working(this)
    working.finish_the_frame(frame, "", stepper, target, presence)
    jump_to(after)
    switch_to(after)
}

func decimal_converted(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    if from_type.name == "UnsignedLong" {
        return unsigned_long_into_decimal(source, to_type)
    }
    if to_type.name == "UnsignedLong" {
        return decimal_into_unsigned_long(source, from_type)
    }
    return plain_decimal_conversion(source, from_type, to_type)
}

func unsigned_long_into_decimal(source: Integer, to_type: Model.Type): Lowered {
    var long_type = Model.Type('scalar', "Long")
    var target = new_register()
    var zero = constant(0)
    var is_small = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_small, 'greater_or_equal', source, zero)
    compared.is_signed = true
    emit(compared)
    var small = new_block()
    var large = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_small, small, large)
    emit(test)
    switch_to(small)
    var direct = plain_decimal_conversion(source, long_type, to_type)
    var copied_direct = LowIntermediaryRepresentation.Instructions.Copy(target, direct.value)
    emit(copied_direct)
    jump_to(after)
    switch_to(large)
    var one = constant(1)
    var half = unchecked_bits(source, 'shift_right', one, false)
    var lowest = unchecked_bits(source, 'bits_and', one, false)
    var sticky = unchecked_bits(half, 'bits_or', lowest, false)
    var halved = plain_decimal_conversion(sticky, long_type, to_type)
    var doubled = new_register()
    var adding = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        doubled,
        'add',
        halved.value,
        halved.value,
    )
    adding.is_double = to_type.name == "Double"
    emit(adding)
    var copied_doubled = LowIntermediaryRepresentation.Instructions.Copy(target, doubled)
    emit(copied_doubled)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func decimal_into_unsigned_long(source: Integer, from_type: Model.Type): Lowered {
    var long_type = Model.Type('scalar', "Long")
    var double_type = Model.Type('scalar', "Double")
    var wide = source
    if from_type.name == "Float" {
        var widened = plain_decimal_conversion(source, from_type, double_type)
        wide = widened.value
    }
    var target = new_register()
    var top_bits = double_bits_of_power(63)
    var top = constant(top_bits)
    var is_small = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_small, 'less', wide, top)
    emit(compared)
    var small = new_block()
    var large = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_small, small, large)
    emit(test)
    switch_to(small)
    var direct = plain_decimal_conversion(wide, double_type, long_type)
    var copied_direct = LowIntermediaryRepresentation.Instructions.Copy(target, direct.value)
    emit(copied_direct)
    jump_to(after)
    switch_to(large)
    var taken_off = new_register()
    var taking = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(taken_off, 'subtract', wide, top)
    emit(taking)
    var converted = plain_decimal_conversion(taken_off, double_type, long_type)
    var top_bit: Long = -_largest_long - 1
    var bit = constant(top_bit)
    var restored = unchecked_bits(converted.value, 'bits_xor', bit, false)
    var copied_restored = LowIntermediaryRepresentation.Instructions.Copy(target, restored)
    emit(copied_restored)
    jump_to(after)
    switch_to(after)
    return single(target)
}

func unchecked_bits(
    left: Integer,
    operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator,
    right: Integer,
    compares_signed: Boolean,
): Integer {
    var target = new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.width = 'bits_64'
    computed.is_signed = compares_signed
    computed.is_checked = false
    emit(computed)
    return target
}

func check_the_float_range(value: Integer, from_type: Model.Type) {
    fallback from_type.name == "Double"
    var largest_float: Long = _largest_float_as_double_bits
    var infinity: Long = _infinity_as_double_bits
    var negative_largest: Long = largest_float - _largest_long - 1
    var negative_infinity: Long = infinity - _largest_long - 1
    var message = "spite: a Double beyond 3.4028235e+38, the largest Float, does not fit in a Float, at {state.path}:{state.line} in {state.function.key}\n"
    float_stop_between(value, 'greater', largest_float, 'less', infinity, message)
    float_stop_between(value, 'less', negative_largest, 'greater', negative_infinity, message)
}

func float_stop_between(
    value: Integer,
    past: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit_bits: Long,
    within: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    end_bits: Long,
    message: String,
) {
    var limit = constant(limit_bits)
    var is_past = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_past, past, value, limit)
    emit(compared)
    var testing_the_end = new_block()
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_past, testing_the_end, after)
    emit(test)
    switch_to(testing_the_end)
    var end = constant(end_bits)
    var is_finite = new_register()
    var compared_end = LowIntermediaryRepresentation.Instructions.Decimal.Compare(is_finite, within, value, end)
    emit(compared_end)
    var end_test = LowIntermediaryRepresentation.Instructions.Branch(is_finite, stopping, after)
    emit(end_test)
    switch_to(stopping)
    var label = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    emit(stopped)
    switch_to(after)
}

func plain_decimal_conversion(source: Integer, from_type: Model.Type, to_type: Model.Type): Lowered {
    var target = new_register()
    var converting = LowIntermediaryRepresentation.Instructions.Decimal.Conversion(target, source)
    var from_scalar = state.scalars.of(from_type.name)
    var to_scalar = state.scalars.of(to_type.name)
    crash from_scalar
    crash to_scalar
    if from_scalar.is_decimal {
        converting.from_decimal_size = from_scalar.size
    } else {
        converting.whole_is_signed = from_scalar.is_signed
        converting.whole_width = width_of(from_type)
    }
    if to_scalar.is_decimal {
        converting.to_decimal_size = to_scalar.size
    } else {
        converting.whole_is_signed = to_scalar.is_signed
        converting.whole_width = width_of(to_type)
    }
    emit(converting)
    return single(target)
}

func check_the_decimal_range(value: Integer, from_type: Model.Type, to_type: Model.Type) {
    var to_scalar = state.scalars.of(to_type.name)
    crash to_scalar
    var wide = value
    if from_type.name == "Float" {
        var double_type = Model.Type('scalar', "Double")
        var widened = decimal_converted(value, from_type, double_type)
        wide = widened.value
    }
    var lowest_bits = decimal_bits_of(to_scalar.smallest)
    crash not to_scalar.largest.starts_with("-")
    var above = state.scalars.increased(to_scalar.largest)
    var above_bits = decimal_bits_of(above)
    var article = article_of(to_type.name)
    var from_article = article_of(from_type.name)
    var message = ", {from_article} {from_type.name}, does not fit in {article} {to_type.name}, at {state.path}:{state.line} in {state.function.key}\n"
    decimal_stop_unless(wide, 'greater_or_equal', lowest_bits, message)
    decimal_stop_unless(wide, 'less', above_bits, message)
}

func decimal_bits_of(bound: String): Long {
    var read: Double? = bound
    crash read
    return read.bits()
}

func double_bits_of_power(bits: Integer): Long {
    var exponent: Long = _double_exponent_bias + bits
    return exponent.shifted_left(52)
}

func decimal_stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit_bits: Long,
    message: String,
) {
    var bound = constant(limit_bits)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Decimal.Compare(fits, comparison, value, bound)
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var long_bits = double_bits_of_power(63)
    var lowest_long: Long = long_bits - _largest_long - 1
    var numbered = new_block()
    var unnumbered = new_block()
    var past_the_low = new_block()
    var above_the_low = new_register()
    var low_bound = constant(lowest_long)
    var compared_low = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        above_the_low,
        'greater_or_equal',
        value,
        low_bound,
    )
    emit(compared_low)
    var low_test = LowIntermediaryRepresentation.Instructions.Branch(above_the_low, past_the_low, unnumbered)
    emit(low_test)
    switch_to(past_the_low)
    var below_the_high = new_register()
    var high_bound = constant(long_bits)
    var compared_high = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        below_the_high,
        'less',
        value,
        high_bound,
    )
    emit(compared_high)
    var high_test = LowIntermediaryRepresentation.Instructions.Branch(below_the_high, numbered, unnumbered)
    emit(high_test)
    switch_to(numbered)
    var double_type = Model.Type('scalar', "Double")
    var long_type = Model.Type('scalar', "Long")
    var whole = decimal_converted(value, double_type, long_type)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(whole.value)
    stopped.signed_numbers.append(1)
    emit(stopped)
    switch_to(unnumbered)
    var unnumbered_label = text_label("spite: a value that is not a number, or outside every whole number{message}")
    var stopped_unnumbered = LowIntermediaryRepresentation.Instructions.Stop(unnumbered_label)
    emit(stopped_unnumbered)
    switch_to(after)
}

# ../../../spite_spec/specs/values_and_types.md#casting
func check_the_range(value: Integer, given: Model.Type, wanted: Model.Type) {
    var given_scalar = state.scalars.of(given.name)
    var wanted_scalar = state.scalars.of(wanted.name)
    crash given_scalar
    crash wanted_scalar
    var given_article = article_of(given.name)
    var wanted_article = article_of(wanted.name)
    var message = ", {given_article} {given.name}, does not fit in {wanted_article} {wanted.name}, at {state.path}:{state.line} in {state.function.key}\n"
    if state.scalars.is_below(given_scalar.smallest, wanted_scalar.smallest) {
        var lowest = whole_bound_of(wanted_scalar.smallest)
        stop_unless(value, 'greater_or_equal', lowest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
    if state.scalars.is_below(wanted_scalar.largest, given_scalar.largest) {
        var highest = whole_bound_of(wanted_scalar.largest)
        stop_unless(value, 'less_or_equal', highest, given_scalar.is_signed, message, given_scalar.is_signed)
    }
}

func whole_bound_of(bound: String): Long {
    var read: Long? = bound
    crash read
    return read
}

func stop_unless(
    value: Integer,
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    limit: Long,
    compares_signed: Boolean,
    message: String,
    value_is_signed: Boolean,
) {
    var bound = constant(limit)
    var fits = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(fits, comparison, value, bound)
    compared.is_signed = compares_signed
    emit(compared)
    var stopping = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, after, stopping)
    emit(test)
    switch_to(stopping)
    var opening = text_label("spite: ")
    var closing = text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    stopped.labels.append(opening)
    stopped.labels.append(closing)
    stopped.numbers.append(value)
    var sign = 0
    if value_is_signed {
        sign = 1
    }
    stopped.signed_numbers.append(sign)
    emit(stopped)
    switch_to(after)
}

func article_of(name: String): String {
    var first = name.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func made_nullable(converted: Lowered, nullable_type: Model.Type): Lowered {
    if not is_a_nullable_scalar(nullable_type) {
        return carried(converted)
    }
    var present = constant(1)
    return Lowered(converted.value, present)
}

func lower_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall): Lowered {
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var library = lower_value(call.library)
    var library_model = state.layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = state.layout.offset_of(handle_attribute)
    var handle = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(handle, library.value, handle_offset, 'bits_64')
    emit(loaded)
    var address = new_register()
    var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(address, handle, call.function_name)
    emit(found)
    var arguments = List<Integer>()
    var decimal_sizes = List<Integer>()
    var callbacks = Callbacks(this)
    var structs = ForeignStructs(this)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = passed_into_c(argument, callbacks, structs)
        arguments.append(passed)
        var size = decimal_size_of(argument.value_type)
        decimal_sizes.append(size)
        index = index + 1
    }
    var target = new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    called.answers_32_bits = call.value_type.name == "Integer"
    called.decimal_sizes = decimal_sizes
    called.answer_decimal_size = decimal_size_of(call.value_type)
    var tracked = state.program.reports_faults
    if tracked {
        note_the_foreign_call(call, library.value)
    }
    emit(called)
    free_the_terminated_copies()
    if tracked {
        var slot = foreign_slot()
        var unused_site = constant(0)
        var cleared = LowIntermediaryRepresentation.Instructions.Store(slot, 0, unused_site, 'bits_64')
        emit(cleared)
    }
    structs.written_back()
    callbacks.restore()
    counting.release_the_pending()
    state.pending_releases = outer
    if call.value_type.kind == 'object' and call.value_type.name == "String" {
        var joins = TextJoins(this)
        return joins.copied_c_text(target, call.function_name)
    }
    return single(target)
}

func note_the_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall, library: Integer) {
    var text = "foreign={call.function_name}\tfrom={state.path}:{state.line}"
    state.program.foreign_sites.append(text)
    var site_number = state.program.foreign_sites.count()
    var site = constant(site_number)
    var slot = foreign_slot()
    var stored_site = LowIntermediaryRepresentation.Instructions.Store(slot, 0, site, 'bits_64')
    emit(stored_site)
    var stored_library = LowIntermediaryRepresentation.Instructions.Store(slot, 8, library, 'bits_64')
    emit(stored_library)
}

func foreign_slot(): Integer {
    var label = record_label_of("_foreign")
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    return slot
}

func decimal_size_of(of_type: Model.Type): Integer {
    fallback is_a_decimal(of_type)
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func passed_into_c(argument: SpiteCompiler.Value, callbacks: Callbacks, structs: ForeignStructs): Integer {
    if argument.value_type.kind == 'function' {
        return callbacks.handed_for_the_call(argument)
    }
    if structs.is_a_struct(argument) {
        return structs.struct_of(argument)
    }
    if structs.is_a_number_list(argument) {
        return structs.storage_of_a_list(argument)
    }
    return foreign_argument(argument)
}

func foreign_argument(argument: SpiteCompiler.Value): Integer {
    var counting = Counting(state)
    var argument_value = lower_value(argument)
    var argument_type = argument.value_type
    counting.release_later(argument_value, argument_type)
    if argument_type.kind == 'object' and argument_type.name == "String" {
        return terminated_text(argument_value.value)
    }
    if argument_type.kind == 'object' and argument_type.name == "Buffer" {
        return storage_of(argument_value.value)
    }
    return argument_value.value
}

func bytes_of_text(text: Integer): Integer {
    var string_model = state.layout.program.class_named("String")
    crash string_model
    var buffer_attribute = string_model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = state.layout.offset_of(buffer_attribute)
    var buffer = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, text, buffer_offset, 'bits_64')
    emit(loaded)
    return storage_of(buffer)
}

# ../../OPTIMIZATIONS.md#small-blocks-come-from-the-compilers-own-free-lists
func terminated_text(text: Integer): Integer {
    var string_model = state.layout.program.class_named("String")
    crash string_model
    var length_attribute = string_model.attribute_named("_length")
    crash length_attribute
    var length_offset = state.layout.offset_of(length_attribute)
    var length = new_register()
    var loaded_length = LowIntermediaryRepresentation.Instructions.Load(length, text, length_offset, 'bits_32')
    emit(loaded_length)
    var bytes = bytes_of_text(text)
    var end = address_plus(bytes, length)
    var end_byte = new_register()
    var loaded_end = LowIntermediaryRepresentation.Instructions.Load(end_byte, end, 0, 'bits_8')
    loaded_end.is_signed = false
    emit(loaded_end)
    var zero = constant(0)
    var passed = new_register()
    var passing_the_text = LowIntermediaryRepresentation.Instructions.Copy(passed, bytes)
    emit(passing_the_text)
    var held_copy = new_register()
    var keeping_nothing = LowIntermediaryRepresentation.Instructions.Copy(held_copy, zero)
    emit(keeping_nothing)
    var is_ended = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_ended, 'equal', end_byte, zero)
    emit(compared)
    var copying = new_block()
    var ended = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_ended, ended, copying)
    emit(test)
    switch_to(copying)
    var one = constant(1)
    var room = address_plus(length, one)
    var fresh = new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(fresh, room)
    emit(allocated)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(fresh, bytes, length)
    emit(copied)
    var fresh_end = address_plus(fresh, length)
    var stored = LowIntermediaryRepresentation.Instructions.Store(fresh_end, 0, zero, 'bits_8')
    emit(stored)
    var passing_the_copy = LowIntermediaryRepresentation.Instructions.Copy(passed, fresh)
    emit(passing_the_copy)
    var keeping_the_copy = LowIntermediaryRepresentation.Instructions.Copy(held_copy, fresh)
    emit(keeping_the_copy)
    jump_to(ended)
    switch_to(ended)
    state.terminated_copies.append(held_copy)
    return passed
}

func free_the_terminated_copies() {
    state.terminated_copies.each(free_a_terminated_copy)
    state.terminated_copies = List<Integer>()
}

func free_a_terminated_copy(held_copy: Integer) {
    var zero = constant(0)
    var is_held_copy = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_held_copy, 'not_equal', held_copy, zero)
    emit(compared)
    var freeing = new_block()
    var done = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_held_copy, freeing, done)
    emit(test)
    switch_to(freeing)
    var freed = LowIntermediaryRepresentation.Instructions.Free(held_copy)
    emit(freed)
    jump_to(done)
    switch_to(done)
}

func storage_of(buffer: Integer): Integer {
    var storage = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(
        storage,
        buffer,
        state.layout.storage_offset,
        'bits_64',
    )
    loaded.region = "Buffer.$storage"
    emit(loaded)
    return storage
}

# ../../OPTIMIZATIONS.md#an-attribute-a-loop-only-reads-is-read-before-it
func items_region_of(owner_key: String, element: Model.Type): String {
    if element.kind == 'scalar' or element.kind == 'enumeration' {
        return "{owner_key}.[]"
    }
    return ""
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func width_of(of_type: Model.Type): LowIntermediaryRepresentation.Instructions.Load.Width {
    if of_type.kind != 'scalar' {
        return 'bits_64'
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    if scalar.size == 1 {
        return 'bits_8'
    } else if scalar.size == 2 {
        return 'bits_16'
    } else if scalar.size == 4 {
        return 'bits_32'
    } else {
        return 'bits_64'
    }
}

func is_signed(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return true
    }
    var scalar = state.scalars.of(of_type.name)
    crash scalar
    return scalar.is_signed and not scalar.is_decimal
}

# ../../OPTIMIZATIONS.md#a-counted-loop-of-reads-shares-its-singletons-lock
func share_a_singleton(class_key: String): Integer {
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var thread = new_register()
    var asked = LowIntermediaryRepresentation.Instructions.ThreadIdentity(thread)
    emit(asked)
    var exclusive = new_register()
    var owner = new_register()
    var loaded_owner = LowIntermediaryRepresentation.Instructions.Load(owner, slot, 40, 'bits_64')
    emit(loaded_owner)
    var mine = new_register()
    var compared_owner = LowIntermediaryRepresentation.Instructions.Compare(mine, 'equal', owner, thread)
    emit(compared_owner)
    var deeper = new_block()
    var trying = new_block()
    var backing = new_block()
    var shared = new_block()
    var after = new_block()
    var owner_test = LowIntermediaryRepresentation.Instructions.Branch(mine, deeper, trying)
    emit(owner_test)
    switch_to(deeper)
    var depth = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(depth, slot, 48, 'bits_64')
    emit(loaded)
    var one = constant(1)
    var added_depth = new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(added_depth, 'add', depth, one)
    added.is_checked = false
    emit(added)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 48, added_depth, 'bits_64')
    emit(stored)
    var held_alone = LowIntermediaryRepresentation.Instructions.Constant(exclusive, 1)
    emit(held_alone)
    jump_to(after)
    switch_to(trying)
    var readers = new_register()
    var entered = LowIntermediaryRepresentation.Instructions.AtomicAdd(readers, slot, 56, 1)
    emit(entered)
    var writer = new_register()
    var loaded_writer = LowIntermediaryRepresentation.Instructions.Load(writer, slot, 40, 'bits_64')
    emit(loaded_writer)
    var nobody = constant(0)
    var free = new_register()
    var compared_writer = LowIntermediaryRepresentation.Instructions.Compare(free, 'equal', writer, nobody)
    emit(compared_writer)
    var free_test = LowIntermediaryRepresentation.Instructions.Branch(free, shared, backing)
    emit(free_test)
    switch_to(backing)
    var left = new_register()
    var backed = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, slot, 56, -1)
    emit(backed)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(trying)
    switch_to(shared)
    var held_shared = LowIntermediaryRepresentation.Instructions.Constant(exclusive, 0)
    emit(held_shared)
    jump_to(after)
    switch_to(after)
    return exclusive
}

func unshare_a_singleton(class_key: String, exclusive: Integer) {
    var alone = new_block()
    var shared = new_block()
    var after = new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(exclusive, alone, shared)
    emit(test)
    switch_to(alone)
    unlock_a_singleton(class_key)
    jump_to(after)
    switch_to(shared)
    var label = slot_label_of(class_key)
    var slot = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    emit(addressed)
    var left = new_register()
    var leaving = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, slot, 56, -1)
    emit(leaving)
    jump_to(after)
    switch_to(after)
}

func wait_for_the_readers(slot: Integer) {
    var waiting = new_block()
    var pausing = new_block()
    var after = new_block()
    jump_to(waiting)
    switch_to(waiting)
    var readers = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(readers, slot, 56, 'bits_64')
    emit(loaded)
    var nobody = constant(0)
    var none_left = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(none_left, 'equal', readers, nobody)
    emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(none_left, after, pausing)
    emit(test)
    switch_to(pausing)
    var no_wait = constant(0)
    var pause_arguments = List<Integer>()
    pause_arguments.append(no_wait)
    var paused = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "Sleep", pause_arguments)
    emit(paused)
    jump_to(waiting)
    switch_to(after)
}

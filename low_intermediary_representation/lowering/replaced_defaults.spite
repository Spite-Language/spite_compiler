var model = Model.ProgramModel()
var defaults = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var trimmed = List<HighIntermediaryRepresentation.HighFunction>()
var trimmed_keys = List<String>()
var replaced = List<String>()
var observed = List<String>()
var escaped = false
var visiting = List<String>()
var quiet_calls = ["Buffer._resize_room"]

func ReplacedDefaults(high: HighIntermediaryRepresentation.HighProgram) {
    model = high.model
    high.built_functions.each(note_a_function)
    high.built_functions.each(trim_for_a_constructor)
}

func note_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    bodies[key] = function
    if function.function.name == "_attribute_defaults" {
        defaults[function.function.owner] = function
    }
}

func trim_for_a_constructor(constructor: HighIntermediaryRepresentation.HighFunction) {
    assert constructor.function.is_constructor
    var class_key = constructor.function.owner
    var found = defaults[class_key]
    assert found
    assert not any_default_names_this(found.body)
    replaced = List<String>()
    note_the_leading_writes(constructor.body)
    assert not replaced.is_empty()
    var body = HighIntermediaryRepresentation.Statements.Block()
    var index = 0
    while index < found.body.statements.count() {
        var statement = found.body.statements[index]
        if not is_skipped(statement) {
            body.statements.append(statement)
        }
        index = index + 1
    }
    assert body.statements.count() < found.body.statements.count()
    var variant = HighIntermediaryRepresentation.HighFunction(found.function, body)
    trimmed.append(variant)
    var key = constructor.function.key()
    trimmed_keys.append(key)
}

func is_skipped(statement: HighIntermediaryRepresentation.Statements.Statement): Boolean {
    if statement == HighIntermediaryRepresentation.Statements.AssignAttribute {
        return is_a_skipped_write(statement)
    }
    return false
}

func is_a_skipped_write(written: HighIntermediaryRepresentation.Statements.AssignAttribute): Boolean {
    if not replaced.contains(written.attribute.name) {
        return false
    }
    if reads_a_local(written.value) {
        return false
    }
    var bound = Dictionary<String, Long>()
    return is_quiet(written.value, bound)
}

func any_default_names_this(body: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement_names_this(statement) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_names_this(statement: HighIntermediaryRepresentation.Statements.Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return names_this(statement.value)
        HighIntermediaryRepresentation.Statements.AssignAttribute: return a_write_names_this(statement)
        _: return true
    }
}

func a_write_names_this(written: HighIntermediaryRepresentation.Statements.AssignAttribute): Boolean {
    if written.object != HighIntermediaryRepresentation.Values.ThisRead {
        return true
    }
    return names_this(written.value)
}

func note_the_leading_writes(body: HighIntermediaryRepresentation.Statements.Block) {
    observed = List<String>()
    escaped = false
    var index = 0
    while not escaped and index < body.statements.count() {
        var statement = body.statements[index]
        note_a_constructor_statement(statement)
        index = index + 1
    }
}

func note_a_constructor_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    if statement == HighIntermediaryRepresentation.Statements.AssignAttribute {
        note_a_constructor_write(statement)
        return
    }
    observe_a_statement(statement)
}

func note_a_constructor_write(written: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    if written.object != HighIntermediaryRepresentation.Values.ThisRead {
        observe_a_statement(written)
        return
    }
    observe(written.value)
    var name = written.attribute.name
    if not escaped and not observed.contains(name) and not replaced.contains(name) {
        replaced.append(name)
    }
}

func observe_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: observe(statement.value)
        HighIntermediaryRepresentation.Statements.Assign: observe_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: observe_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.AssignThroughShape: observe_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: observe_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.If: observe_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: observe_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: observe_a_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: observe_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: observe_a_block(statement)
    }
}

func observe_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign) {
    observe(assigned.value)
}

func observe_a_shape_write(written: HighIntermediaryRepresentation.Statements.AssignThroughShape) {
    observe(written.object)
    observe(written.value)
}

func observe_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    observe(branch.condition)
    observe_a_block(branch.then_branch)
    observe_a_block(branch.else_branch)
}

func observe_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    observe(loop.condition)
    observe_a_block(loop.body)
}

func observe_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    escaped = true
    observe(returned.value)
}

func observe_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(observe_present)
    observe(stop.then)
}

func observe_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(observe_a_statement)
}

func observe_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    observe(first)
    observe(second)
}

func observe_present(value: HighIntermediaryRepresentation.Values.Value) {
    observe(value)
}

func observe(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.ThisRead: note_an_escape()
        HighIntermediaryRepresentation.Values.AttributeRead: observe_a_read(value)
        HighIntermediaryRepresentation.Values.Call: observe_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.ShapeCall: observe_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.FunctionValueCall: observe_a_call(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.ForeignCall: observe_a_call(value.library, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: observe_a_call(null, value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: observe(value.converted)
        HighIntermediaryRepresentation.Values.ClassOfValue: observe(value.described)
        HighIntermediaryRepresentation.Values.ClassTest: observe(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: observe(value.text)
        HighIntermediaryRepresentation.Values.EnumText: observe(value.number)
        HighIntermediaryRepresentation.Values.FunctionValue: observe(value.receiver)
        HighIntermediaryRepresentation.Values.MachineOperation: observe_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.NumberRoom: observe_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.Negation: observe(value.negated)
        HighIntermediaryRepresentation.Values.PresenceTest: observe(value.tested)
        _: return
    }
}

func note_an_escape() {
    escaped = true
}

func observe_a_call(
    receiver: HighIntermediaryRepresentation.Values.Value?,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
) {
    observe(receiver)
    arguments.each(observe_present)
}

func observe_a_read(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    if read.object == HighIntermediaryRepresentation.Values.ThisRead {
        observed.append(read.attribute.name)
        return
    }
    observe(read.object)
}

func names_this(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not value {
        return false
    }
    switch value {
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.Call: return names_this_in_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.ShapeCall: return names_this_in_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.FunctionValueCall: return names_this_in_a_call(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.ForeignCall: return names_this_in_a_call(value.library, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: return names_this_in_a_call(null, value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: return names_this(value.converted)
        HighIntermediaryRepresentation.Values.AttributeRead: return names_this(value.object)
        HighIntermediaryRepresentation.Values.ClassOfValue: return names_this(value.described)
        HighIntermediaryRepresentation.Values.ClassTest: return names_this(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: return names_this(value.text)
        HighIntermediaryRepresentation.Values.EnumText: return names_this(value.number)
        HighIntermediaryRepresentation.Values.FunctionValue: return names_this(value.receiver)
        HighIntermediaryRepresentation.Values.MachineOperation: return names_this_in_either(value.left, value.right)
        HighIntermediaryRepresentation.Values.NumberRoom: return names_this_in_either(value.made, value.number)
        HighIntermediaryRepresentation.Values.Negation: return names_this(value.negated)
        HighIntermediaryRepresentation.Values.PresenceTest: return names_this(value.tested)
        _: return false
    }
}

func names_this_in_either(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
): Boolean {
    return names_this(first) or names_this(second)
}

func names_this_in_a_call(
    receiver: HighIntermediaryRepresentation.Values.Value?,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
): Boolean {
    if names_this(receiver) {
        return true
    }
    return arguments.any(names_this_present)
}

func names_this_present(value: HighIntermediaryRepresentation.Values.Value): Boolean {
    return names_this(value)
}

func reads_a_local(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not value {
        return false
    }
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.MakeObject: return any_reads_a_local(value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: return reads_a_local(value.converted)
        _: return false
    }
}

func any_reads_a_local(values: List<HighIntermediaryRepresentation.Values.Value>): Boolean {
    return values.any(reads_a_present_local)
}

func reads_a_present_local(value: HighIntermediaryRepresentation.Values.Value): Boolean {
    return reads_a_local(value)
}

func is_quiet(value: HighIntermediaryRepresentation.Values.Value?, bound: Dictionary<String, Long>): Boolean {
    if not value {
        return true
    }
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.NullConstant: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_quiet(value.object, bound)
        HighIntermediaryRepresentation.Values.Conversion: return is_a_quiet_conversion(value, bound)
        HighIntermediaryRepresentation.Values.MakeObject: return is_a_quiet_making(value, bound)
        HighIntermediaryRepresentation.Values.Call: return is_a_quiet_call(value, bound)
        _: return false
    }
}

func are_quiet(values: List<HighIntermediaryRepresentation.Values.Value>, bound: Dictionary<String, Long>): Boolean {
    var index = 0
    while index < values.count() {
        var value = values[index]
        if not is_quiet(value, bound) {
            return false
        }
        index = index + 1
    }
    return true
}

func is_a_quiet_conversion(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    bound: Dictionary<String, Long>,
): Boolean {
    var kind = conversion.kind
    var carries = kind == 'present' or kind == 'nullable' or kind == 'into_union' or kind == 'into_shape'
    carries = carries or kind == 'widen' or kind == 'proven' or kind == 'to_decimal'
    if not carries {
        return false
    }
    return is_quiet(conversion.converted, bound)
}

func is_a_quiet_making(
    made: HighIntermediaryRepresentation.Values.MakeObject,
    bound: Dictionary<String, Long>,
): Boolean {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    if not made_model {
        return false
    }
    if made_model.is_singleton or made_model.function_named("drop") or class_key == "ForeignCallback" {
        return false
    }
    if not are_quiet(made.arguments, bound) {
        return false
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var no_bound = Dictionary<String, Long>()
    if not is_a_quiet_function("{class_key}._attribute_defaults", no_arguments, no_bound) {
        return false
    }
    if not made.constructor {
        return true
    }
    var constructor_key = made.constructor.key()
    return is_a_quiet_function(constructor_key, made.arguments, bound)
}

func is_a_quiet_call(call: HighIntermediaryRepresentation.Values.Call, bound: Dictionary<String, Long>): Boolean {
    if not is_quiet(call.receiver, bound) or not are_quiet(call.arguments, bound) {
        return false
    }
    var key = call.function.key()
    if not call.function.has_a_body() {
        return quiet_calls.contains(key)
    }
    if not call.number_positions.is_empty() {
        return false
    }
    return is_a_quiet_function(key, call.arguments, bound)
}

func is_a_quiet_function(
    key: String,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
    outer: Dictionary<String, Long>,
): Boolean {
    var function = bodies[key]
    if not function or visiting.contains(key) {
        return false
    }
    var bound = Dictionary<String, Long>()
    var index = 0
    while index < function.function.parameters.count() and index < arguments.count() {
        var parameter = function.function.parameters[index]
        var argument = arguments[index]
        var known = constant_of(argument, outer)
        if known {
            bound[parameter.name] = known
        }
        index = index + 1
    }
    visiting.append(key)
    var quiet = is_a_quiet_block(function.body, bound)
    var last = visiting.count() - 1
    visiting.remove_at(last)
    return quiet
}

func constant_of(value: HighIntermediaryRepresentation.Values.Value?, bound: Dictionary<String, Long>): Long? {
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number
    }
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        return bound[value.name]
    }
    return null
}

func is_a_quiet_block(
    block: HighIntermediaryRepresentation.Statements.Block?,
    bound: Dictionary<String, Long>,
): Boolean {
    if not block {
        return true
    }
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if not is_a_quiet_statement(statement, bound) {
            return false
        }
        index = index + 1
    }
    return true
}

func is_a_quiet_statement(
    statement: HighIntermediaryRepresentation.Statements.Statement,
    bound: Dictionary<String, Long>,
): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return is_quiet(statement.value, bound)
        HighIntermediaryRepresentation.Statements.AssignAttribute: return is_a_quiet_write(statement, bound)
        HighIntermediaryRepresentation.Statements.Evaluate: return is_a_quiet_evaluation(statement, bound)
        HighIntermediaryRepresentation.Statements.If: return is_a_quiet_if(statement, bound)
        HighIntermediaryRepresentation.Statements.Block: return is_a_quiet_block(statement, bound)
        _: return false
    }
}

func is_a_quiet_write(
    written: HighIntermediaryRepresentation.Statements.AssignAttribute,
    bound: Dictionary<String, Long>,
): Boolean {
    if written.object != HighIntermediaryRepresentation.Values.ThisRead {
        return false
    }
    return is_quiet(written.value, bound)
}

func is_a_quiet_evaluation(
    evaluated: HighIntermediaryRepresentation.Statements.Evaluate,
    bound: Dictionary<String, Long>,
): Boolean {
    if evaluated.waited {
        return false
    }
    return is_quiet(evaluated.value, bound)
}

func is_a_quiet_if(branch: HighIntermediaryRepresentation.Statements.If, bound: Dictionary<String, Long>): Boolean {
    var folded = folded_condition(branch.condition, bound)
    if folded == 1 {
        return is_a_quiet_block(branch.then_branch, bound)
    }
    if folded == 0 {
        return is_a_quiet_block(branch.else_branch, bound)
    }
    var quiet = is_quiet(branch.condition, bound) and is_a_quiet_block(branch.then_branch, bound)
    return quiet and is_a_quiet_block(branch.else_branch, bound)
}

func folded_condition(
    condition: HighIntermediaryRepresentation.Values.Value?,
    bound: Dictionary<String, Long>,
): Integer {
    if condition == HighIntermediaryRepresentation.Values.Negation {
        var inner = folded_condition(condition.negated, bound)
        if inner < 0 {
            return inner
        }
        return 1 - inner
    }
    if condition == HighIntermediaryRepresentation.Values.MachineOperation {
        return folded_comparison(condition, bound)
    }
    return -1
}

func folded_comparison(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    bound: Dictionary<String, Long>,
): Integer {
    var left = constant_of(operation.left, bound)
    var right = constant_of(operation.right, bound)
    if not left or not right {
        return -1
    }
    var holds = false
    switch operation.operator {
        'equal': holds = left == right
        'not_equal': holds = left != right
        'less': holds = left < right
        'less_or_equal': holds = left <= right
        'greater': holds = left > right
        'greater_or_equal': holds = left >= right
        _: return -1
    }
    if holds {
        return 1
    }
    return 0
}

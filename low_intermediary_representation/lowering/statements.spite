var state = FunctionLoweringState()

func Statements(starting_state: FunctionLoweringState) {
    state = starting_state
}

func lower_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    var counting = Counting(state)
    crash block
    var held = List<Integer>()
    state.scopes.append(held)
    var outer_statements = state.block_statements
    var outer_index = state.statement_index
    var outer_releases = state.statement_releases
    var outer_gathering = state.gathers_for_the_statement
    state.statement_releases = List<Integer>()
    state.block_statements = block.statements
    state.statement_index = 0
    while state.statement_index < state.block_statements.count() {
        var statement = state.block_statements[state.statement_index]
        state.gathers_for_the_statement = not state.resumable_mode and is_a_plain_statement(statement)
        lower_statement(statement)
        state.gathers_for_the_statement = false
        state.statement_index = state.statement_index + 1
        release_at_the_statement_end(statement)
    }
    state.statement_releases = outer_releases
    state.gathers_for_the_statement = outer_gathering
    state.block_statements = outer_statements
    state.statement_index = outer_index
    if not state.terminated {
        held.each(counting.release_held)
    }
    var last = state.scopes.count() - 1
    state.scopes.remove_at(last)
}

func is_a_plain_statement(statement: SpiteCompiler.Statement): Boolean {
    var branches = statement.class == HighIntermediaryRepresentation.Statements.If
    branches = branches or statement.class == HighIntermediaryRepresentation.Statements.While
    branches = branches or statement.class == HighIntermediaryRepresentation.Statements.Block
    var leaves = statement.class == HighIntermediaryRepresentation.Statements.Return
    leaves = leaves or statement.class == HighIntermediaryRepresentation.Statements.Stop
    return not branches and not leaves
}

func release_at_the_statement_end(statement: SpiteCompiler.Statement) {
    var counting = Counting(state)
    fallback not state.statement_releases.is_empty()
    var next = state.block_statements[state.statement_index]
    if next {
        var continues = is_a_plain_statement(next) and next.line == statement.line
        fallback not continues
    }
    state.statement_releases.each(counting.release)
    state.statement_releases = List<Integer>()
}

func lower_statement(statement: SpiteCompiler.Statement) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    lowering.lower_a_statement(statement)
    if not state.terminated {
        counting.release_the_pending()
    }
    state.pending_releases = outer
}

func lower_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    var lowering = FunctionLowering(state)
    var frame_lists = FrameLists(state)
    var counting = Counting(state)
    state.line = declare.line
    var columns = ColumnLists(lowering)
    fallback not columns.declares_an_item(declare)
    if state.slot_appends.contains(declare.name) {
        frame_lists.make_in_the_slot(declare)
        return
    }
    if declare.frame_items > 0 and not state.resumable_mode {
        state.frame_list_counts[declare.name] = declare.frame_items
        frame_lists.lower_a_frame_list(declare, declare.frame_items)
        return
    }
    state.line = declare.line
    var value = lower_a_declared_value(declare)
    var register = lowering.new_register()
    state.locals[declare.name] = register
    var borrowed = is_a_borrowed_local(declare, value)
    if not borrowed {
        counting.kept(value, declare.declared_type)
    }
    if borrowed and declare.value {
        state.borrowed_sources.append(declare.value)
    }
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    lowering.emit(copied)
    if lowering.is_a_pointer(declare.declared_type) and not borrowed {
        counting.hold(register)
        state.held_types[register] = declare.declared_type
        counting.note_the_count(register, declare.declared_type)
    }
    if lowering.is_a_nullable_scalar(declare.declared_type) {
        var presence = lowering.new_register()
        state.local_presences[declare.name] = presence
        var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
        lowering.emit(copied_presence)
    }
    if declare.hides != "" {
        let_go_of_the_hidden(declare.hides)
    }
}

func let_go_of_the_hidden(hidden: String) {
    var counting = Counting(state)
    var register = state.locals[hidden]
    fallback register
    var innermost = state.scopes.last()
    crash innermost
    var at = innermost.index_of(register)
    fallback at
    innermost.remove_at(at)
    counting.release_held(register)
}

# ../../OPTIMIZATIONS.md#a-name-holding-an-item-or-an-attribute-is-not-counted
func lower_a_declared_value(declare: HighIntermediaryRepresentation.Statements.Declare): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var given = declare.value
    if given.class == HighIntermediaryRepresentation.Values.Conversion and is_a_borrowed_item(declare, given) {
        var reads = ListReads(lowering)
        return reads.held_item(given)
    }
    return counting.lower_a_kept_value(declare.value)
}

func is_a_borrowed_item(
    declare: HighIntermediaryRepresentation.Statements.Declare,
    conversion: HighIntermediaryRepresentation.Values.Conversion,
): Boolean {
    var lowering = FunctionLowering(state)
    fallback state.borrows_parameters and not state.resumable_mode and lowering.is_a_pointer(declare.declared_type)
    fallback conversion.kind == 'proven' and not state.reassigned_names.contains(declare.name)
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        return is_a_borrowed_read(read, declare.name)
    }
    return false
}

func is_a_borrowed_read(read: HighIntermediaryRepresentation.Values.Call, name: String): Boolean {
    var lowering = FunctionLowering(state)
    var reads = ListReads(lowering)
    fallback reads.gets.is_a_plain_get(read) and lowering.is_a_pointer(read.value_type)
    var watched = List<String>()
    fallback gather_the_sources(read, watched) and state.assignments
    var after = state.statement_index + 1
    if state.assignments.leaves_alone(state.block_statements, after, watched) {
        return true
    }
    return leaves_alone_but_its_write_back(read, name, watched)
}

# ../../OPTIMIZATIONS.md#an-item-written-back-to-the-slot-it-came-from-is-not-written
func leaves_alone_but_its_write_back(
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
    watched: List<String>,
): Boolean {
    crash state.assignments
    var index_value = read.arguments[0]
    crash index_value
    var plain_index = index_value.class == HighIntermediaryRepresentation.Values.LocalRead
    plain_index = plain_index or index_value.class == HighIntermediaryRepresentation.Values.WholeNumber
    fallback plain_index
    var after = state.statement_index + 1
    var back = write_back_of(read, name, after)
    if back < 0 {
        return leaves_alone_but_a_nested_write_back(read, name, watched, index_value)
    }
    fallback not index_moves_before(index_value, after, back)
    var rest = List<SpiteCompiler.Statement>()
    var index = after
    while index < state.block_statements.count() {
        var statement = state.block_statements[index]
        if index != back {
            rest.append(statement)
        }
        index = index + 1
    }
    watched.append("{read.function.owner}._length")
    fallback state.assignments.leaves_alone(rest, 0, watched)
    state.block_statements[back] = HighIntermediaryRepresentation.Statements.Block()
    return true
}

# ../../PROOFS.md#an-item-written-back-to-its-own-slot-is-the-slot
func leaves_alone_but_a_nested_write_back(
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
    watched: List<String>,
    index_value: SpiteCompiler.Value,
): Boolean {
    crash state.assignments
    var after = state.statement_index + 1
    state.nested_back_statements = List<SpiteCompiler.Statement>()
    state.nested_back_index = -1
    var index = after
    while index < state.block_statements.count() and state.nested_back_index < 0 {
        var statement = state.block_statements[index]
        find_a_nested_write_back(statement, read, name)
        index = index + 1
    }
    var count = state.block_statements.count()
    fallback state.nested_back_index >= 0 and not index_moves_before(index_value, after, count)
    var written_back = state.nested_back_statements[state.nested_back_index]
    crash written_back
    var emptied = HighIntermediaryRepresentation.Statements.Block()
    state.nested_back_statements[state.nested_back_index] = emptied
    watched.append("{read.function.owner}._length")
    if state.assignments.leaves_alone(state.block_statements, after, watched) {
        return true
    }
    state.nested_back_statements[state.nested_back_index] = written_back
    return false
}

func find_a_nested_write_back(
    statement: SpiteCompiler.Statement,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: find_a_write_back_in_an_if(statement, read, name)
        HighIntermediaryRepresentation.Statements.While: find_a_write_back_in(statement.body, read, name)
        HighIntermediaryRepresentation.Statements.Block: find_a_write_back_in(statement, read, name)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func find_a_write_back_in_an_if(
    branch: HighIntermediaryRepresentation.Statements.If,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
) {
    find_a_write_back_in(branch.then_branch, read, name)
    if state.nested_back_index < 0 {
        find_a_write_back_in(branch.else_branch, read, name)
    }
}

func find_a_write_back_in(
    block: HighIntermediaryRepresentation.Statements.Block?,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
) {
    fallback block
    var index = 0
    while index < block.statements.count() and state.nested_back_index < 0 {
        var statement = block.statements[index]
        if is_a_write_back(statement, read, name) {
            state.nested_back_statements = block.statements
            state.nested_back_index = index
        } else {
            find_a_nested_write_back(statement, read, name)
        }
        index = index + 1
    }
}

func write_back_of(read: HighIntermediaryRepresentation.Values.Call, name: String, after: Integer): Integer {
    var index = after
    while index < state.block_statements.count() {
        var statement = state.block_statements[index]
        if is_a_write_back(statement, read, name) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_a_write_back(
    statement: SpiteCompiler.Statement,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
): Boolean {
    if statement.class == HighIntermediaryRepresentation.Statements.Evaluate {
        return is_a_written_back_value(statement.value, read, name)
    }
    return false
}

func is_a_written_back_value(
    value: SpiteCompiler.Value?,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        return writes_back(value, read, name)
    }
    return false
}

func writes_back(
    written: HighIntermediaryRepresentation.Values.Call,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
): Boolean {
    var lowering = FunctionLowering(state)
    fallback written.function.name == "set_at" and written.function.owner == read.function.owner
    var reads = ListReads(lowering)
    fallback reads.gets.is_the_library_list(written.function, "list.spite") and written.arguments.count() == 2
    fallback is_the_same_path(written.receiver, read.receiver)
    fallback is_the_same_path(written.arguments[0], read.arguments[0])
    return state.uses.is_the_local(written.arguments[1], name)
}

func is_the_same_path(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?): Boolean {
    fallback first and second
    if first.class == HighIntermediaryRepresentation.Values.ThisRead {
        return second.class == HighIntermediaryRepresentation.Values.ThisRead
    }
    if first.class == HighIntermediaryRepresentation.Values.LocalRead {
        return state.uses.is_the_local(second, first.name)
    }
    if first.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return is_the_same_number(second, first.number)
    }
    if first.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return is_the_same_attribute_path(first, second)
    }
    return false
}

func is_the_same_number(value: SpiteCompiler.Value, number: Long): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number == number
    }
    return false
}

func is_the_same_attribute_path(
    first: HighIntermediaryRepresentation.Values.AttributeRead,
    second: SpiteCompiler.Value,
): Boolean {
    if second.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return are_the_same_attributes(first, second)
    }
    return false
}

func are_the_same_attributes(
    first: HighIntermediaryRepresentation.Values.AttributeRead,
    second: HighIntermediaryRepresentation.Values.AttributeRead,
): Boolean {
    fallback first.attribute.owner == second.attribute.owner and first.attribute.name == second.attribute.name
    return is_the_same_path(first.object, second.object)
}

func index_moves_before(index_value: SpiteCompiler.Value, after: Integer, back: Integer): Boolean {
    if index_value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return is_assigned_between(index_value.name, after, back)
    }
    return false
}

func is_assigned_between(name: String, after: Integer, back: Integer): Boolean {
    crash state.assignments
    var between = HighIntermediaryRepresentation.Statements.Block()
    var index = after
    while index < back {
        var statement = state.block_statements[index]
        crash statement
        between.statements.append(statement)
        index = index + 1
    }
    var assigned = state.assignments.names_assigned_in(between)
    return assigned.contains(name)
}

func is_a_borrowed_local(declare: HighIntermediaryRepresentation.Statements.Declare, value: Lowered): Boolean {
    var lowering = FunctionLowering(state)
    fallback state.borrows_parameters and not value.owned and lowering.is_a_pointer(declare.declared_type)
    fallback not state.reassigned_names.contains(declare.name)
    if lowering.is_a_singleton_type(declare.declared_type) and declare.value {
        return lowering.is_a_singleton_type(declare.value.value_type)
    }
    var watched = List<String>()
    fallback gather_the_sources(declare.value, watched) and not watched.is_empty()
    fallback state.assignments
    var after = state.statement_index + 1
    return state.assignments.leaves_alone(state.block_statements, after, watched)
}

func gather_the_sources(given: SpiteCompiler.Value?, watched: List<String>): Boolean {
    var lowering = FunctionLowering(state)
    crash given
    if lowering.is_a_singleton_type(given.value_type) {
        return true
    }
    switch given {
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.LocalRead: return not state.reassigned_names.contains(given.name)
        HighIntermediaryRepresentation.Values.Conversion: return gather_through_a_conversion(given, watched)
        HighIntermediaryRepresentation.Values.AttributeRead: return gather_through_an_attribute(given, watched)
        HighIntermediaryRepresentation.Values.Call: return gather_through_a_slot(given, watched)
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func gather_through_a_conversion(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    watched: List<String>,
): Boolean {
    fallback conversion.kind != 'join' and conversion.kind != 'into_handle'
    return gather_the_sources(conversion.converted, watched)
}

func gather_through_an_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    watched: List<String>,
): Boolean {
    fallback not state.layout.is_back(read.attribute)
    watched.append("{read.attribute.owner}.{read.attribute.name}")
    return gather_the_sources(read.object, watched)
}

func gather_through_a_slot(call: HighIntermediaryRepresentation.Values.Call, watched: List<String>): Boolean {
    var lowering = FunctionLowering(state)
    var reads = ListReads(lowering)
    var is_a_read = not call.function.has_a_body() and call.function.name == "_read_value"
    fallback is_a_read or reads.gets.is_a_plain_get(call)
    var list_key = call.function.owner
    watched.append("[]{list_key}")
    if state.layout.inline_stride_of(list_key) > 0 or state.layout.columnar.contains(list_key) {
        watched.append("[+]{list_key}")
    }
    return gather_the_sources(call.receiver, watched)
}

func lower_assign(assign: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    state.line = assign.line
    var value = counting.lower_a_kept_value(assign.value)
    var register = state.locals[assign.name]
    crash register
    crash assign.value
    var assigned_type = assign.value.value_type
    counting.kept(value, assigned_type)
    var old = lowering.new_register()
    var saved = LowIntermediaryRepresentation.Instructions.Copy(old, register)
    lowering.emit(saved)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(register, value.value)
    lowering.emit(copied)
    if lowering.is_a_pointer(assigned_type) {
        counting.settle_before_letting_go(old, assigned_type)
        counting.release_counted(old, assigned_type)
    }
    var presence = state.local_presences[assign.name]
    fallback presence
    var copied_presence = LowIntermediaryRepresentation.Instructions.Copy(presence, value.presence)
    lowering.emit(copied_presence)
}

# ../../PROOFS.md#no-attribute-is-read-past-the-lock
func lower_assign_attribute(assign: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var singletons = Singletons(state)
    var owner_key = assign.attribute.owner
    var takes_the_lock = singletons.locks_from_outside(owner_key)
    if takes_the_lock {
        singletons.lock_a_singleton(owner_key)
    }
    lower_an_attribute_store(assign)
    if takes_the_lock {
        singletons.unlock_a_singleton(owner_key)
    }
}

func lower_an_attribute_store(assign: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var values = Values(state)
    state.line = assign.line
    var updates = AtomicUpdates(lowering)
    var is_atomic_here = false
    if state.waits {
        is_atomic_here = state.waits.is_atomic(state.lowering_owner)
    }
    fallback not is_atomic_here or not updates.lowered_an_update(assign)
    var columns = ColumnLists(lowering)
    fallback not columns.writes(assign)
    var fresh = is_a_fresh_slot(assign)
    var object = lowering.lower_value(assign.object)
    crash assign.object
    var region = values.region_of(assign.object.value_type, assign.attribute)
    if state.layout.is_back(assign.attribute) {
        var value = lowering.lower_value(assign.value)
        store_a_back_reference(object.value, assign.attribute, value)
        bind_the_foreign_names(assign.attribute, value.value)
        counting.discard(object, assign.object.value_type)
        return
    }
    if state.layout.is_lent(assign.attribute) {
        store_a_lent_item(object.value, assign, region)
        counting.discard(object, assign.object.value_type)
        return
    }
    var kept_value = counting.lower_a_kept_value(assign.value)
    if state.layout.is_embedded(assign.attribute) {
        values.store_the_part_inside(object.value, assign.attribute, kept_value)
        counting.discard(object, assign.object.value_type)
        return
    }
    if fresh {
        store_in_a_fresh_slot(object.value, assign.attribute, kept_value, region)
    } else {
        store_an_attribute(object.value, assign.attribute, kept_value, region)
    }
    var value = kept_value
    bind_the_foreign_names(assign.attribute, value.value)
    counting.discard(object, assign.object.value_type)
}

# ../../OPTIMIZATIONS.md#an-attribute-that-only-holds-an-item-of-its-holders-list-is-not-counted
func store_a_lent_item(
    object: Integer,
    assign: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    region: String,
) {
    var lowering = FunctionLowering(state)
    var offset = state.layout.offset_of(assign.attribute)
    var given = assign.value
    var stored_value = 0
    if state.lowering_name == "_attribute_defaults" {
        stored_value = lowering.constant(0)
    } else if given.class == HighIntermediaryRepresentation.Values.Conversion {
        var reads = ListReads(lowering)
        var item = reads.held_item(given)
        fallback not item.owned
        stored_value = item.value
    } else {
        crash
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(
        object,
        offset,
        stored_value,
        'bits_64',
        region,
        false,
    )
    lowering.emit(stored)
}

func bind_the_foreign_names(attribute: Model.AttributeModel, library: Integer) {
    var lowering = FunctionLowering(state)
    var names = attribute.foreign_names
    fallback not names.is_empty()
    var library_model = state.layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = state.layout.offset_of(handle_attribute)
    var handle = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(handle, library, handle_offset, 'bits_64')
    lowering.emit(loaded)
    var library_files = LibraryFiles()
    var file_name = library_files.file_of_an_attribute(attribute)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var address = lowering.new_register()
        var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(address, handle, name, file_name)
        lowering.emit(found)
        index = index + 1
    }
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func is_a_fresh_slot(assign: HighIntermediaryRepresentation.Statements.Assign.Attribute): Boolean {
    var lowering = FunctionLowering(state)
    fallback not state.fresh_attributes.is_empty()
    var on_this = assign.object.class == HighIntermediaryRepresentation.Values.ThisRead
    if state.scopes.count() != 2 or not on_this or state.uses.names_this(assign.value) {
        state.fresh_attributes = List<String>()
        return false
    }
    var at = state.fresh_attributes.index_of(assign.attribute.name)
    fallback at
    state.fresh_attributes.remove_at(at)
    return lowering.is_a_pointer(assign.attribute.attribute_type) and not lowering.is_a_nullable_scalar(assign.attribute.attribute_type)
}

func store_in_a_fresh_slot(object: Integer, attribute: Model.AttributeModel, value: Lowered, region: String) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var offset = state.layout.offset_of(attribute)
    counting.kept(value, attribute.attribute_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, 'bits_64', region, false)
    lowering.emit(stored)
}

func store_an_attribute(object: Integer, attribute: Model.AttributeModel, value: Lowered, region: String) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var offset = state.layout.offset_of(attribute)
    var attribute_type = attribute.attribute_type
    var width = lowering.width_of(attribute_type)
    counting.kept(value, attribute_type)
    var old = lowering.new_register()
    if lowering.is_a_pointer(attribute_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
        loaded_old.region = region
        lowering.emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, width, region, false)
    lowering.emit(stored)
    if lowering.is_a_pointer(attribute_type) {
        counting.settle_before_letting_go(old, attribute_type)
        counting.release_counted(old, attribute_type)
    }
    fallback lowering.is_a_nullable_scalar(attribute_type)
    var presence_offset = state.layout.presence_offset_of(attribute)
    var presence_width = lowering.width_of_a_presence()
    var stored_presence = LowIntermediaryRepresentation.Instructions.Store(
        object,
        presence_offset,
        value.presence,
        presence_width,
        "",
        false,
    )
    if not region.is_empty() {
        stored_presence.region = "{region}?"
    }
    lowering.emit(stored_presence)
}

func store_a_back_reference(object: Integer, attribute: Model.AttributeModel, value: Lowered) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var offset = state.layout.offset_of(attribute)
    var old = lowering.new_register()
    var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
    lowering.emit(loaded_old)
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, 'bits_64', "", false)
    lowering.emit(stored)
    var slot = state.layout.back_slot_of(attribute)
    count_back(value.value, slot, "_point_back")
    if value.owned {
        counting.release(value.value)
    }
    count_back(old, slot, "_let_go_back")
}

func count_back(object: Integer, slot: Integer, helper: String) {
    var lowering = FunctionLowering(state)
    var slot_register = lowering.constant(slot)
    var arguments = List<Integer>()
    arguments.append(object)
    arguments.append(slot_register)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, helper, arguments)
    lowering.emit(called)
}

func lower_assign_through_shape(assign: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    state.line = assign.line
    var object = lowering.lower_value(assign.object)
    var value = lowering.lower_value(assign.value)
    crash assign.value
    var value_type = assign.value.value_type
    counting.kept(value, value_type)
    store_through_shape(assign.shape, assign.member, object.value, value, value_type)
}

func store_through_shape(
    shape: Model.ShapeModel,
    member: String,
    object: Integer,
    value: Lowered,
    value_type: Model.Type,
) {
    var lowering = FunctionLowering(state)
    var conversions = Conversions(state)
    var shared = conversions.shared_filler(shape.key, member)
    if shared {
        store_in_a_shared_block(shared, member, object, value, value_type)
        return
    }
    var class_id = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(class_id, object, 0, 'bits_64')
    lowering.emit(loaded)
    var after = lowering.new_block()
    var fillers = state.layout.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        store_in_a_filler(filler, member, object, class_id, value, value_type, after)
        index = index + 1
    }
    var label = lowering.text_label("spite: no class fills '{shape.name}' here, at {state.path}:{state.line}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
    lowering.switch_to(after)
}

func store_in_a_shared_block(
    filler: Model.Type,
    member: String,
    object: Integer,
    value: Lowered,
    value_type: Model.Type,
) {
    var model = state.layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(member)
    crash attribute
    store_in_place(object, attribute, value, value_type)
}

func store_in_a_filler(
    filler: Model.Type,
    member: String,
    object: Integer,
    class_id: Integer,
    value: Lowered,
    value_type: Model.Type,
    after: Integer,
) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var model = state.layout.program.class_named(filler.name)
    crash model
    var attribute = model.attribute_named(member)
    crash attribute
    var wanted = state.layout.class_id_of(filler.name)
    var wanted_register = lowering.constant(wanted)
    var matches = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register, true)
    lowering.emit(compared)
    var storing = lowering.new_block()
    var next = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, storing, next)
    lowering.emit(test)
    lowering.switch_to(storing)
    if state.layout.is_back(attribute) {
        var held = counting.owned(value.value)
        store_a_back_reference(object, attribute, held)
    } else {
        store_in_place(object, attribute, value, value_type)
    }
    lowering.jump_to(after)
    lowering.switch_to(next)
}

func store_in_place(object: Integer, attribute: Model.AttributeModel, value: Lowered, value_type: Model.Type) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var offset = state.layout.offset_of(attribute)
    var width = lowering.width_of(attribute.attribute_type)
    var old = lowering.new_register()
    if lowering.is_a_pointer(value_type) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, object, offset, 'bits_64')
        lowering.emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, offset, value.value, width, "", false)
    lowering.emit(stored)
    fallback lowering.is_a_pointer(value_type)
    counting.release_counted(old, value_type)
}

func lower_evaluate(evaluate: HighIntermediaryRepresentation.Statements.Evaluate) {
    var lowering = FunctionLowering(state)
    var frame_lists = FrameLists(state)
    var counting = Counting(state)
    state.line = evaluate.line
    if state.resumable_mode and evaluate.waited {
        var in_place = lowering.lower_value(evaluate.waited)
        counting.discard(in_place, evaluate.waited.value_type)
        return
    }
    fallback not frame_lists.fills_a_frame_list(evaluate.value)
    fallback not frame_lists.ends_a_slot_append(evaluate.value)
    var written_back = WrittenBackCalls(lowering)
    fallback not written_back.is_a_needless_write_back(evaluate.value)
    var value = lowering.lower_value(evaluate.value)
    crash evaluate.value
    counting.discard(value, evaluate.value.value_type)
}

func lower_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    state.line = branch.line
    var condition = lowering.lower_value(branch.condition)
    crash branch.condition
    counting.discard(condition, branch.condition.value_type)
    counting.release_the_pending()
    var then_block = lowering.new_block()
    var after = lowering.new_block()
    var else_block = after
    if branch.else_branch {
        else_block = lowering.new_block()
    }
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, then_block, else_block)
    lowering.emit(test)
    lowering.switch_to(then_block)
    lower_block(branch.then_branch)
    lowering.jump_to(after)
    if branch.else_branch {
        lowering.switch_to(else_block)
        lower_block(branch.else_branch)
        lowering.jump_to(after)
    }
    lowering.switch_to(after)
}

func lower_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var singletons = Singletons(state)
    var coarse = HighIntermediaryRepresentation.CoarseLoops(state.layout.program, state.waits)
    coarse.owner = state.lowering_owner
    coarse.resumable = state.resumable_mode
    var held = coarse.singleton_held_by(loop)
    if held.is_empty() {
        lower_a_plain_while(loop)
        return
    }
    crash state.assignments
    crash state.waits
    var sharing = state.waits.shares_the_lock(held) and coarse.only_reads(state.assignments)
    var exclusive = -1
    if sharing {
        exclusive = singletons.share_a_singleton(held)
    } else {
        singletons.lock_a_singleton(held)
    }
    var outer = state.coarse_class
    state.coarse_class = held
    lower_a_plain_while(loop)
    state.coarse_class = outer
    if sharing {
        singletons.unshare_a_singleton(held, exclusive)
    } else {
        singletons.unlock_a_singleton(held)
    }
}

func lower_a_plain_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    state.line = loop.line
    var header = lowering.new_block()
    var body = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(header)
    lowering.switch_to(header)
    var condition = lowering.lower_value(loop.condition)
    counting.release_the_pending()
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition.value, body, after)
    lowering.emit(test)
    lowering.switch_to(body)
    lower_block(loop.body)
    if checks_points() and not state.terminated {
        write_a_check_point()
    }
    lowering.jump_to(header)
    lowering.switch_to(after)
}

# ../../../spite_documentation/repl.md#remote---repl-port
func checks_points(): Boolean {
    var has_a_check_point = not state.program.prompt_check_point.is_empty() or not state.program.reload_check_point.is_empty()
    fallback has_a_check_point and not state.path.is_empty()
    var library = Mapping.LibraryFile()
    return not library.holds(state.path)
}

func write_a_check_point() {
    var lowering = FunctionLowering(state)
    var flag = lowering.new_register()
    var flag_address = LowIntermediaryRepresentation.Instructions.DataAddress(flag, state.program.prompt_flag_label)
    lowering.emit(flag_address)
    var raised = lowering.new_register()
    var read_flag = LowIntermediaryRepresentation.Instructions.Load(raised, flag, 0, 'bits_64')
    read_flag.region = "prompt.flag"
    lowering.emit(read_flag)
    var zero = lowering.constant(0)
    var is_raised = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_raised, 'not_equal', raised, zero, true)
    lowering.emit(compared)
    var answering = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_raised, answering, after)
    lowering.emit(test)
    lowering.switch_to(answering)
    var lowered_flag = LowIntermediaryRepresentation.Instructions.Store(flag, 0, zero, 'bits_64', "prompt.flag", false)
    lowering.emit(lowered_flag)
    var objects = lowering.new_register()
    var objects_address = LowIntermediaryRepresentation.Instructions.DataAddress(
        objects,
        state.program.prompt_objects_label,
    )
    lowering.emit(objects_address)
    if not state.program.reload_check_point.is_empty() {
        call_the_reload_check_point(objects)
    }
    if not state.program.prompt_check_point.is_empty() {
        call_the_prompt_check_point(objects)
    }
    lowering.jump_to(after)
    lowering.switch_to(after)
}

func call_the_prompt_check_point(objects: Integer) {
    var lowering = FunctionLowering(state)
    var prompt_object = lowering.new_register()
    var read_prompt = LowIntermediaryRepresentation.Instructions.Load(prompt_object, objects, 0, 'bits_64')
    lowering.emit(read_prompt)
    var entry_object = lowering.new_register()
    var read_entry = LowIntermediaryRepresentation.Instructions.Load(entry_object, objects, 8, 'bits_64')
    lowering.emit(read_entry)
    var arguments = List<Integer>()
    arguments.append(prompt_object)
    arguments.append(entry_object)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, state.program.prompt_check_point, arguments)
    lowering.emit(called)
}

# ../../../spite_documentation/repl.md#how-it-works
func call_the_reload_check_point(objects: Integer) {
    var lowering = FunctionLowering(state)
    var reloader = lowering.new_register()
    var read_reloader = LowIntermediaryRepresentation.Instructions.Load(reloader, objects, 24, 'bits_64')
    lowering.emit(read_reloader)
    var arguments = List<Integer>()
    arguments.append(reloader)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, state.program.reload_check_point, arguments)
    lowering.emit(called)
}

func lower_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    state.line = returned.line
    if not returned.value {
        counting.release_every_scope()
        var nothing = LowIntermediaryRepresentation.Instructions.Return(-1, -1, false)
        lowering.emit(nothing)
        return
    }
    var value = lower_returned_value(returned.value)
    var returned_type = returned.value.value_type
    if state.counts_the_answer {
        counting.kept(value, returned_type)
    }
    counting.release_the_pending()
    counting.release_every_scope()
    var made = LowIntermediaryRepresentation.Instructions.Return(value.value, value.presence, false)
    lowering.emit(made)
}

func lower_returned_value(value: SpiteCompiler.Value?): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    if state.counts_the_answer {
        return counting.lower_a_kept_value(value)
    }
    return lowering.lower_value(value)
}

func lower_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    var lowering = FunctionLowering(state)
    var plain = stop.pieces.is_empty() and not stop.then
    if plain and stop.message.is_empty() {
        var failure = lowering.constant(1)
        var exited = LowIntermediaryRepresentation.Instructions.Exit(failure)
        lowering.emit(exited)
        return
    }
    if not plain {
        lower_a_reported_stop(stop)
        return
    }
    var label = lowering.text_label("{stop.message}\n")
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
}

func lower_a_reported_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var pieces = stop.pieces
    if pieces.is_empty() {
        pieces = List<String>()
        pieces.append(stop.message)
    }
    var last_index = pieces.count() - 1
    var last = pieces[last_index]
    crash last
    pieces[last_index] = "{last}\n"
    var first_text = pieces[0]
    crash first_text
    var opening = lowering.text_label(first_text)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(opening)
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var label = lowering.text_label(piece)
        stopped.labels.append(label)
        index = index + 1
    }
    var value_index = 0
    while value_index < stop.shown.count() {
        var shown = stop.shown[value_index]
        var shown_value = lowering.lower_value(shown)
        stopped.numbers.append(shown_value.value)
        var sign = 1
        if lowering.is_unsigned_whole(shown.value_type.name) {
            sign = 0
        }
        stopped.signed_numbers.append(sign)
        value_index = value_index + 1
    }
    if not stop.then {
        lowering.emit(stopped)
        return
    }
    stopped.continues = true
    lowering.emit(stopped)
    var reported = lowering.lower_value(stop.then)
    counting.release_later(reported, stop.then.value_type)
    var failure = lowering.constant(1)
    var exited = LowIntermediaryRepresentation.Instructions.Exit(failure)
    lowering.emit(exited)
}

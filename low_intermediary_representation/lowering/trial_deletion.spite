# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it

var _word = 8
var _set_slots = 0
var _set_room = 8
var _set_used = 16
var _set_filled = 24
var _events = 32
var _threshold = 40
var _suspect_threshold = 200
var _square_share = 16384
var _collecting = 48
var _grays = 56
var _stack = 80
var _blacks = 104
var _whites = 128
var _roots = 152
var _order = 176
var _record_size = 384
var _pair = 16
var _high_half = 32
var _spreading: Long = -7046029254386353131
var _first_room = 64
var _zeroed_memory = 8
var _gray_mode = 1
var _black_mode = 2
var _scan_mode = 3
var _restore_mode = 4
var _clear_mode = 5
var _drop_mode = 6
var _gray: Long = 4611686018427387904
var _black: Long = 2305843009213693952
var _white: Long = 6917529027641081856
var _count_mask: Long = 2305843009213693951
var _mark: Long = 576460752303423488
var _skipped: Long = 288230376151711744
var _white_ceiling: Long = 864691128455135232
var _out_of_memory = "spite: the program ran out of memory while freeing a cycle\n"
var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var machine = MachineWriting(lowering)

func TrialDeletion(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write(table_size: Integer) {
    lowering.state.program.cycle_record = machine.zeroed_label(_record_size)
    lowering.state.program.name_state(lowering.state.program.cycle_record, "cycles")
    var threads = CycleThreads(machine)
    if lowering.state.program.uses_threads {
        threads.write()
    } else {
        threads.write_nothing_to_do()
    }
    write_the_suspect()
    write_the_let_go()
    write_the_drop_point()
    write_the_maybe_collect()
    write_the_find()
    write_the_add()
    write_the_remove()
    write_the_rebuild()
    write_the_push()
    write_the_visit(table_size)
    write_the_collect()
    write_the_collect_at_exit()
}

func write_nothing_to_do() {
    var threads = CycleThreads(machine)
    threads.write_nothing_to_do()
    machine.begin("_cycle_suspect", 1)
    machine.answered_nothing()
    machine.finish()
    machine.begin("_cycle_drop_point", 0)
    machine.answered_nothing()
    machine.finish()
}

func write_the_drop_point() {
    machine.begin("_cycle_drop_point", 0)
    var base = record()
    if lowering.state.program.uses_threads {
        var threads = CycleThreads(machine)
        threads.return_unless_alone(base)
    }
    count_an_event(base)
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_maybe_collect", no_arguments)
    machine.answered_nothing()
    machine.finish()
}

func suspect_bit(): Integer {
    var largest = Long.Largest()
    var negated = 0 - largest
    var top = negated - 1
    return machine.constant_of(top)
}

func record(): Integer {
    return machine.data_at(lowering.state.program.cycle_record)
}

func process_heap(): Integer {
    var no_arguments = machine.none_listed()
    return machine.imported("GetProcessHeap", no_arguments)
}

func stop_without(block: Integer) {
    var missing = machine.is_zero(block)
    var made = machine.opened_when(missing)
    machine.halted(_out_of_memory)
    machine.closed(made)
}

func count_an_event(base: Integer) {
    var events = machine.loaded(base, _events)
    var more = machine.plus_number(events, 1)
    machine.stored(base, _events, more)
}

func write_the_suspect() {
    machine.begin("_cycle_suspect", 1)
    var missing = machine.is_zero(0)
    var present = machine.opened_when(missing)
    machine.answered_nothing()
    machine.closed(present)
    var word = machine.loaded(0, 8)
    var plain = machine.compared_to('greater_or_equal', word, 0)
    var marking = machine.opened_when(plain)
    if lowering.state.program.uses_threads {
        mark_among_threads()
    } else {
        mark_alone(word)
    }
    machine.closed(marking)
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_drop_point", no_arguments)
    machine.answered_nothing()
    machine.finish()
}

func mark_alone(word: Integer) {
    var mask = machine.constant_of(_count_mask)
    var count = machine.both(word, mask)
    var counted = machine.compared_to('less', count, _skipped)
    var counting = machine.opened_when(counted)
    var bit = suspect_bit()
    var marked = machine.either(word, bit)
    machine.stored(0, 8, marked)
    var passed = machine.one_listed(0)
    machine.called_for_nothing("_cycle_add", passed)
    machine.closed(counting)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func mark_among_threads() {
    var threads = CycleThreads(machine)
    threads.locked()
    var word = machine.loaded(0, 8)
    var plain = machine.compared_to('greater_or_equal', word, 0)
    var marking = machine.opened_when(plain)
    var mask = machine.constant_of(_count_mask)
    var count = machine.both(word, mask)
    var counted = machine.compared_to('less', count, _skipped)
    var counting = machine.opened_when(counted)
    var bit = suspect_bit()
    threads.set_the_suspect_bit(0, bit)
    var passed = machine.one_listed(0)
    machine.called_for_nothing("_cycle_add", passed)
    machine.closed(counting)
    machine.closed(marking)
    threads.unlocked()
}

func write_the_let_go() {
    machine.begin("_cycle_let_go", 2)
    var bit = suspect_bit()
    var gone = machine.compared('equal', 1, bit)
    var held = machine.opened_when(gone)
    var threads = CycleThreads(machine)
    var among_threads = lowering.state.program.uses_threads
    if among_threads {
        threads.locked()
    }
    var passed = machine.one_listed(0)
    machine.called_for_nothing("_cycle_remove", passed)
    if among_threads {
        threads.unlocked()
    }
    machine.stored_number(0, 8, 0)
    var yes = machine.constant_of(1)
    machine.answered(yes)
    machine.closed(held)
    var no = machine.constant_of(0)
    machine.answered(no)
    machine.finish()
}

func write_the_maybe_collect() {
    machine.begin("_cycle_maybe_collect", 0)
    var base = record()
    var collecting = machine.loaded(base, _collecting)
    var busy = machine.compared_to('not_equal', collecting, 0)
    var idle = machine.opened_when(busy)
    machine.answered_nothing()
    machine.closed(idle)
    var events = machine.loaded(base, _events)
    var threshold = machine.loaded(base, _threshold)
    var few_events = machine.compared('less', events, threshold)
    var suspects = machine.loaded(base, _set_used)
    var suspect_threshold = machine.loaded(base, _suspect_threshold)
    var few_suspects = machine.compared('less', suspects, suspect_threshold)
    var early = machine.both(few_events, few_suspects)
    var due = machine.opened_when(early)
    machine.answered_nothing()
    machine.closed(due)
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_collect", no_arguments)
    machine.answered_nothing()
    machine.finish()
}

func home_of(object: Integer, room: Integer): Integer {
    var four = machine.constant_of(4)
    var shifted = machine.arithmetic('shift_right', object, four)
    var spread = machine.constant_of(_spreading)
    var mixed = machine.writing.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(
        mixed,
        'multiply',
        shifted,
        spread,
        'bits_64',
        false,
        true,
    )
    machine.writing.emit(multiplied)
    var high_half = machine.constant_of(_high_half)
    var high = machine.arithmetic('shift_right', mixed, high_half)
    var mask = machine.plus_number(room, -1)
    var home = machine.both(high, mask)
    return machine.kept(home)
}

func slot_at(slots: Integer, index: Integer): Integer {
    var word = machine.constant_of(_word)
    var scaled = machine.product_of(index, word)
    return machine.sum_of(slots, scaled)
}

func pair_at(slots: Integer, index: Integer): Integer {
    var pair = machine.constant_of(_pair)
    var scaled = machine.product_of(index, pair)
    return machine.sum_of(slots, scaled)
}

func step_around(index: Integer, room: Integer) {
    var next = machine.plus_number(index, 1)
    var mask = machine.plus_number(room, -1)
    var wrapped = machine.both(next, mask)
    machine.copied(index, wrapped)
}

func write_the_find() {
    machine.begin("_cycle_find", 1)
    var base = record()
    var room = machine.loaded(base, _set_room)
    var unmade = machine.is_zero(room)
    var made = machine.opened_when(unmade)
    var nothing = machine.constant_of(0)
    machine.answered(nothing)
    machine.closed(made)
    var slots = machine.loaded(base, _set_slots)
    var index = home_of(0, room)
    var top = machine.loop_top()
    var place = pair_at(slots, index)
    var held = machine.loaded(place, 0)
    var taken = machine.compared_to('not_equal', held, 0)
    var done = machine.loop_while(taken)
    var same = machine.compared('equal', held, 0)
    var other = machine.opened_when(same)
    machine.answered(place)
    machine.closed(other)
    step_around(index, room)
    machine.loop_back(top, done)
    var missing = machine.constant_of(0)
    machine.answered(missing)
    machine.finish()
}

func write_the_add() {
    machine.begin("_cycle_add", 1)
    var passed = machine.one_listed(0)
    var found = machine.called("_cycle_find", passed)
    var known = machine.compared_to('not_equal', found, 0)
    var fresh = machine.opened_when(known)
    machine.answered_nothing()
    machine.closed(fresh)
    var base = record()
    var filled = machine.loaded(base, _set_filled)
    var room = machine.loaded(base, _set_room)
    var after = machine.plus_number(filled, 1)
    var doubled = machine.sum_of(after, after)
    var crowded = machine.compared('greater', doubled, room)
    var roomy = machine.opened_when(crowded)
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_rebuild", no_arguments)
    machine.closed(roomy)
    var position = machine.loaded(base, _order + 8)
    pushed(_order, 0)
    var slots = machine.loaded(base, _set_slots)
    var size = machine.loaded(base, _set_room)
    var index = home_of(0, size)
    var top = machine.loop_top()
    var place = pair_at(slots, index)
    var held = machine.loaded(place, 0)
    var busy = machine.compared_to('greater', held, 1)
    var done = machine.loop_while(busy)
    step_around(index, size)
    machine.loop_back(top, done)
    var empty_place = pair_at(slots, index)
    var was = machine.loaded(empty_place, 0)
    machine.stored(empty_place, 0, 0)
    machine.stored(empty_place, _word, position)
    var used = machine.loaded(base, _set_used)
    var more = machine.plus_number(used, 1)
    machine.stored(base, _set_used, more)
    var was_empty = machine.is_zero(was)
    var tomb = machine.opened_when(was_empty)
    var filled_now = machine.loaded(base, _set_filled)
    var filled_more = machine.plus_number(filled_now, 1)
    machine.stored(base, _set_filled, filled_more)
    machine.closed(tomb)
    machine.answered_nothing()
    machine.finish()
}

func write_the_remove() {
    machine.begin("_cycle_remove", 1)
    var passed = machine.one_listed(0)
    var place = machine.called("_cycle_find", passed)
    var missing = machine.is_zero(place)
    var present = machine.opened_when(missing)
    machine.answered_nothing()
    machine.closed(present)
    machine.stored_number(place, 0, 1)
    var position = machine.loaded(place, _word)
    var base = record()
    var block = machine.loaded(base, _order)
    var ordered = slot_at(block, position)
    machine.stored_number(ordered, 0, 0)
    var used = machine.loaded(base, _set_used)
    var fewer = machine.plus_number(used, -1)
    machine.stored(base, _set_used, fewer)
    machine.answered_nothing()
    machine.finish()
}

func write_the_rebuild() {
    machine.begin("_cycle_rebuild", 0)
    var base = record()
    var room = machine.loaded(base, _set_room)
    var used = machine.loaded(base, _set_used)
    var new_room = machine.kept(room)
    var unmade = machine.is_zero(room)
    var made = machine.opened_when(unmade)
    var first = machine.constant_of(_first_room)
    machine.copied(new_room, first)
    machine.closed(made)
    var four = machine.constant_of(4)
    var quadrupled = machine.product_of(used, four)
    var full = machine.compared('greater', quadrupled, room)
    var even = machine.opened_when(full)
    var bigger = machine.sum_of(room, room)
    machine.copied(new_room, bigger)
    machine.closed(even)
    var pair = machine.constant_of(_pair)
    var bytes = machine.product_of(new_room, pair)
    var heap = process_heap()
    var zeroed = machine.constant_of(_zeroed_memory)
    var asked = machine.three_listed(heap, zeroed, bytes)
    var fresh = machine.imported("HeapAlloc", asked)
    stop_without(fresh)
    var old = machine.loaded(base, _set_slots)
    var position = machine.variable(0)
    var top = machine.loop_top()
    var more = machine.compared('less', position, room)
    var done = machine.loop_while(more)
    var place = pair_at(old, position)
    var held = machine.loaded(place, 0)
    var live = machine.compared_to('greater', held, 1)
    var skipping = machine.opened_when(live)
    var order = machine.loaded(place, _word)
    move_into(fresh, new_room, held, order)
    machine.closed(skipping)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
    var had_any = machine.compared_to('not_equal', old, 0)
    var freeing = machine.opened_when(had_any)
    var other_heap = process_heap()
    var nothing = machine.constant_of(0)
    var given_back = machine.three_listed(other_heap, nothing, old)
    machine.call_imported("HeapFree", given_back)
    machine.closed(freeing)
    machine.stored(base, _set_slots, fresh)
    machine.stored(base, _set_room, new_room)
    machine.stored(base, _set_filled, used)
    machine.answered_nothing()
    machine.finish()
}

func move_into(slots: Integer, room: Integer, held: Integer, order: Integer) {
    var index = home_of(held, room)
    var top = machine.loop_top()
    var place = pair_at(slots, index)
    var taken = machine.loaded(place, 0)
    var busy = machine.compared_to('not_equal', taken, 0)
    var done = machine.loop_while(busy)
    step_around(index, room)
    machine.loop_back(top, done)
    var empty = pair_at(slots, index)
    machine.stored(empty, 0, held)
    machine.stored(empty, _word, order)
}

func compact_the_order(base: Integer) {
    var kept_count = machine.variable(0)
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _order + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var held = item_of(base, _order, position)
    var live = machine.compared_to('not_equal', held, 0)
    var skipping = machine.opened_when(live)
    var block = machine.loaded(base, _order)
    var moved = slot_at(block, kept_count)
    machine.stored(moved, 0, held)
    var passed = machine.one_listed(held)
    var place = machine.called("_cycle_find", passed)
    machine.stored(place, _word, kept_count)
    machine.step_by(kept_count, 1)
    machine.closed(skipping)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
    machine.stored(base, _order + 8, kept_count)
}

func write_the_push() {
    machine.begin("_cycle_push", 2)
    var base = record()
    var list = machine.sum_of(base, 0)
    var count = machine.loaded(list, 8)
    var room = machine.loaded(list, 16)
    var full = machine.compared('equal', count, room)
    var roomy = machine.opened_when(full)
    grow(list, room)
    machine.closed(roomy)
    var block = machine.loaded(list, 0)
    var place = slot_at(block, count)
    machine.stored(place, 0, 1)
    var more = machine.plus_number(count, 1)
    machine.stored(list, 8, more)
    machine.answered_nothing()
    machine.finish()
}

func grow(list: Integer, room: Integer) {
    var new_room = machine.sum_of(room, room)
    var empty = machine.is_zero(room)
    var started = machine.opened_when(empty)
    var first = machine.constant_of(_first_room)
    machine.copied(new_room, first)
    machine.closed(started)
    var word = machine.constant_of(_word)
    var bytes = machine.product_of(new_room, word)
    var block = machine.loaded(list, 0)
    var moved = machine.kept(block)
    var none_yet = machine.is_zero(block)
    var making = machine.opened_when(none_yet)
    var heap = process_heap()
    var nothing = machine.constant_of(0)
    var asked = machine.three_listed(heap, nothing, bytes)
    var fresh = machine.imported("HeapAlloc", asked)
    machine.copied(moved, fresh)
    machine.closed(making)
    var had_one = machine.compared_to('not_equal', block, 0)
    var moving = machine.opened_when(had_one)
    var other_heap = process_heap()
    var no_flags = machine.constant_of(0)
    var asked_again = machine.three_listed(other_heap, no_flags, block)
    asked_again.append(bytes)
    var grown = machine.imported("HeapReAlloc", asked_again)
    machine.copied(moved, grown)
    machine.closed(moving)
    stop_without(moved)
    machine.stored(list, 0, moved)
    machine.stored(list, 16, new_room)
}

func pushed(list_offset: Integer, value: Integer) {
    var offset = machine.constant_of(list_offset)
    var passed = machine.two_listed(offset, value)
    machine.called_for_nothing("_cycle_push", passed)
}

func item_of(base: Integer, list_offset: Integer, index: Integer): Integer {
    var block = machine.loaded(base, list_offset)
    var place = slot_at(block, index)
    return machine.loaded(place, 0)
}

func popped(base: Integer, list_offset: Integer): Integer {
    var count_offset = list_offset + 8
    var count = machine.loaded(base, count_offset)
    var left = machine.plus_number(count, -1)
    machine.stored(base, count_offset, left)
    return item_of(base, list_offset, left)
}

func emptied(base: Integer, list_offset: Integer) {
    var count_offset = list_offset + 8
    machine.stored_number(base, count_offset, 0)
}

func class_flag(table: Integer, class_id: Integer): Integer {
    var address = machine.sum_of(table, class_id)
    var flag = machine.writing.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(flag, address, 0, 'bits_8', false, "", false)
    machine.writing.emit(loaded)
    return flag
}

func write_the_visit(table_size: Integer) {
    machine.begin("_cycle_visit", 3)
    var missing = machine.is_zero(0)
    var present = machine.opened_when(missing)
    machine.answered_nothing()
    machine.closed(present)
    var class_id = machine.loaded(0, 0)
    var below = machine.compared_to('less', class_id, 0)
    var above = machine.compared_to('greater_or_equal', class_id, table_size)
    var outside = machine.either(below, above)
    var inside = machine.opened_when(outside)
    machine.answered_nothing()
    machine.closed(inside)
    var table = machine.data_at(lowering.state.program.cycle_table)
    var flag = class_flag(table, class_id)
    var plain = machine.is_zero(flag)
    var capable = machine.opened_when(plain)
    machine.answered_nothing()
    machine.closed(capable)
    var word = machine.loaded(0, 8)
    var mask = machine.constant_of(_count_mask)
    var count = machine.both(word, mask)
    visit_to_clear(count)
    var skipped = machine.compared_to('greater_or_equal', count, _skipped)
    var walked_block = machine.opened_when(skipped)
    machine.answered_nothing()
    machine.closed(walked_block)
    var colors = machine.constant_of(_white)
    var color = machine.both(word, colors)
    visit_to_gray(word, color)
    visit_to_blacken(word, color)
    visit_to_scan(color)
    visit_to_restore(word, color)
    machine.answered_nothing()
    machine.finish()
}

func visit_to_clear(count: Integer) {
    var clearing = machine.compared_to('equal', 1, _clear_mode)
    var cleared = machine.opened_when(clearing)
    var marked_low = machine.compared_to('greater_or_equal', count, _skipped)
    var marked_high = machine.compared_to('less', count, _white_ceiling)
    var is_marked = machine.both(marked_low, marked_high)
    var clearing_slot = machine.opened_when(is_marked)
    machine.stored_number(2, 0, 0)
    machine.closed(clearing_slot)
    machine.answered_nothing()
    machine.closed(cleared)
}

func visit_to_gray(word: Integer, color: Integer) {
    var graying = machine.compared_to('equal', 1, _gray_mode)
    var grayed_block = machine.opened_when(graying)
    var lowered_word = machine.plus_number(word, -1)
    var is_gray = machine.compared_to('equal', color, _gray)
    var newly = machine.opened_unless(is_gray)
    var uncolored = machine.difference_of(lowered_word, color)
    var grayed = machine.plus_number(uncolored, _gray)
    machine.stored(0, 8, grayed)
    pushed(_grays, 0)
    machine.answered_nothing()
    machine.closed(newly)
    machine.stored(0, 8, lowered_word)
    machine.answered_nothing()
    machine.closed(grayed_block)
}

func visit_to_blacken(word: Integer, color: Integer) {
    var blackening = machine.compared_to('equal', 1, _black_mode)
    var black_block = machine.opened_when(blackening)
    var raised = machine.plus_number(word, 1)
    var is_black = machine.compared_to('equal', color, _black)
    var newly = machine.opened_unless(is_black)
    var uncolored = machine.difference_of(raised, color)
    var blackened = machine.plus_number(uncolored, _black)
    machine.stored(0, 8, blackened)
    pushed(_blacks, 0)
    machine.answered_nothing()
    machine.closed(newly)
    machine.stored(0, 8, raised)
    machine.answered_nothing()
    machine.closed(black_block)
}

func visit_to_scan(color: Integer) {
    var scanning = machine.compared_to('equal', 1, _scan_mode)
    var scan_block = machine.opened_when(scanning)
    var still_gray = machine.compared_to('equal', color, _gray)
    var pushing = machine.opened_when(still_gray)
    pushed(_stack, 0)
    machine.closed(pushing)
    machine.answered_nothing()
    machine.closed(scan_block)
}

func visit_to_restore(word: Integer, color: Integer) {
    var restoring = machine.compared_to('equal', 1, _restore_mode)
    var restore_block = machine.opened_when(restoring)
    var is_white = machine.compared_to('equal', color, _white)
    var restored = machine.opened_unless(is_white)
    var given_back = machine.plus_number(word, 1)
    machine.stored(0, 8, given_back)
    machine.closed(restored)
    machine.closed(restore_block)
}

func walked(object: Integer, mode: Integer) {
    var mode_register = machine.constant_of(mode)
    var passed = machine.two_listed(object, mode_register)
    machine.called_for_nothing("_cycle_walk_by_class", passed)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write_the_collect() {
    machine.begin("_cycle_collect", 0)
    var base = record()
    var threads = CycleThreads(machine)
    var among_threads = lowering.state.program.uses_threads
    if among_threads {
        threads.walk_alone_or_answer(base)
    }
    machine.stored_number(base, _collecting, 1)
    emptied(base, _roots)
    emptied(base, _grays)
    emptied(base, _stack)
    emptied(base, _blacks)
    emptied(base, _whites)
    gather_the_roots(base)
    gray_the_roots(base)
    walk_the_grays(base)
    scan_the_roots(base)
    each_white_of_the_grays(base, _restore_mode)
    mark_the_whites(base)
    if among_threads {
        threads.let_the_others_in(base)
    }
    each_white(base, _drop_mode)
    each_white(base, _clear_mode)
    free_the_whites(base)
    if among_threads {
        threads.locked()
    }
    compact_the_order(base)
    if among_threads {
        threads.unlocked()
    }
    var walked_count = machine.loaded(base, _grays + 8)
    var freed = machine.loaded(base, _whites + 8)
    var kept_count = machine.difference_of(walked_count, freed)
    var four = machine.constant_of(4)
    var quarter = machine.quotient_of(kept_count, four)
    var squared = machine.product_of(kept_count, kept_count)
    var share = machine.constant_of(_square_share)
    var squared_share = machine.quotient_of(squared, share)
    var waited = machine.sum_of(quarter, squared_share)
    var threshold = machine.plus_number(waited, 1)
    machine.stored(base, _threshold, threshold)
    var kept_suspects = machine.loaded(base, _set_used)
    var doubled = machine.sum_of(kept_suspects, kept_suspects)
    var suspect_threshold = machine.plus_number(doubled, 1)
    machine.stored(base, _suspect_threshold, suspect_threshold)
    machine.stored_number(base, _events, 0)
    machine.stored_number(base, _collecting, 0)
    machine.answered(freed)
    machine.finish()
}

func gather_the_roots(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _order + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var held = item_of(base, _order, position)
    var live = machine.compared_to('not_equal', held, 0)
    var skipping = machine.opened_when(live)
    pushed(_roots, held)
    machine.closed(skipping)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func gray_the_roots(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _roots + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var root = item_of(base, _roots, position)
    var word = machine.loaded(root, 8)
    var mask = machine.constant_of(_count_mask)
    var counted = machine.both(word, mask)
    var walkable = machine.compared_to('less', counted, _skipped)
    var graying = machine.opened_when(walkable)
    var colors = machine.constant_of(_white)
    var color = machine.both(word, colors)
    var is_gray = machine.compared_to('equal', color, _gray)
    var newly = machine.opened_unless(is_gray)
    var uncolored = machine.difference_of(word, color)
    var grayed = machine.plus_number(uncolored, _gray)
    machine.stored(root, 8, grayed)
    pushed(_grays, root)
    machine.closed(newly)
    machine.closed(graying)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func walk_the_grays(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _grays + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var gray = item_of(base, _grays, position)
    walked(gray, _gray_mode)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func scan_the_roots(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _roots + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var root = item_of(base, _roots, position)
    pushed(_stack, root)
    scan_the_stack(base)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func scan_the_stack(base: Integer) {
    var top = machine.loop_top()
    var count = machine.loaded(base, _stack + 8)
    var more = machine.compared_to('greater', count, 0)
    var done = machine.loop_while(more)
    var object = popped(base, _stack)
    var word = machine.loaded(object, 8)
    var colors = machine.constant_of(_white)
    var color = machine.both(word, colors)
    var is_gray = machine.compared_to('equal', color, _gray)
    var scanning = machine.opened_when(is_gray)
    var mask = machine.constant_of(_count_mask)
    var counted = machine.both(word, mask)
    var held = machine.compared_to('greater', counted, 0)
    var held_block = machine.opened_when(held)
    var uncolored = machine.difference_of(word, color)
    var blackened = machine.plus_number(uncolored, _black)
    machine.stored(object, 8, blackened)
    pushed(_blacks, object)
    blacken_the_pushed(base)
    machine.closed(held_block)
    var after = machine.loaded(object, 8)
    var after_color = machine.both(after, colors)
    var still_gray = machine.compared_to('equal', after_color, _gray)
    var whitening = machine.opened_when(still_gray)
    var whitened = machine.plus_number(after, _black)
    machine.stored(object, 8, whitened)
    walked(object, _scan_mode)
    machine.closed(whitening)
    machine.closed(scanning)
    machine.loop_back(top, done)
}

func blacken_the_pushed(base: Integer) {
    var top = machine.loop_top()
    var count = machine.loaded(base, _blacks + 8)
    var more = machine.compared_to('greater', count, 0)
    var done = machine.loop_while(more)
    var object = popped(base, _blacks)
    walked(object, _black_mode)
    machine.loop_back(top, done)
}

func each_white_of_the_grays(base: Integer, mode: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _grays + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var gray = item_of(base, _grays, position)
    var word = machine.loaded(gray, 8)
    var colors = machine.constant_of(_white)
    var color = machine.both(word, colors)
    var is_white = machine.compared_to('equal', color, _white)
    var walking = machine.opened_when(is_white)
    walked(gray, mode)
    machine.closed(walking)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func mark_the_whites(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _grays + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var gray = item_of(base, _grays, position)
    var word = machine.loaded(gray, 8)
    var colors = machine.constant_of(_white)
    var color = machine.both(word, colors)
    var is_white = machine.compared_to('equal', color, _white)
    var whitening = machine.opened_when(is_white)
    var suspected = machine.compared_to('less', word, 0)
    var plain = machine.opened_when(suspected)
    var passed = machine.one_listed(gray)
    machine.called_for_nothing("_cycle_remove", passed)
    machine.closed(plain)
    machine.stored_number(gray, 8, _mark)
    pushed(_whites, gray)
    machine.closed(whitening)
    var kept_word = machine.loaded(gray, 8)
    var kept_color = machine.both(kept_word, colors)
    var uncolored = machine.difference_of(kept_word, kept_color)
    var is_marked = machine.compared_to('equal', kept_word, _mark)
    var settling = machine.opened_unless(is_marked)
    machine.stored(gray, 8, uncolored)
    machine.closed(settling)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func each_white(base: Integer, mode: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _whites + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var white = item_of(base, _whites, position)
    walked(white, mode)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func free_the_whites(base: Integer) {
    var position = machine.variable(0)
    var top = machine.loop_top()
    var count = machine.loaded(base, _whites + 8)
    var more = machine.compared('less', position, count)
    var done = machine.loop_while(more)
    var white = item_of(base, _whites, position)
    machine.stored_number(white, 8, _mark)
    var passed = machine.one_listed(white)
    machine.called_for_nothing("_free_by_class", passed)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func write_the_collect_at_exit() {
    machine.begin("_cycle_collect_at_exit", 0)
    var top = machine.loop_top()
    var no_arguments = machine.none_listed()
    var freed = machine.called("_cycle_collect", no_arguments)
    var any = machine.compared_to('greater', freed, 0)
    var done = machine.loop_while(any)
    machine.loop_back(top, done)
    machine.answered_nothing()
    machine.finish()
}

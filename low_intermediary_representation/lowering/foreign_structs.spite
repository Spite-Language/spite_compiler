var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var passed = List<SpiteCompiler.Value>()
var rooms = List<Integer>()
var no_arguments = List<SpiteCompiler.Value>()

func ForeignStructs(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func is_a_struct(argument: SpiteCompiler.Value): Boolean {
    return argument.value_type.kind == 'shape'
}

func is_a_number_list(argument: SpiteCompiler.Value): Boolean {
    var argument_type = argument.value_type
    fallback argument_type.kind == 'object' and argument_type.name != "String" and argument_type.name != "Buffer"
    var model = lowering.state.layout.program.class_named(argument_type.name)
    crash model
    var buffer_attribute = model.attribute_named("_buffer")
    if buffer_attribute {
        return true
    }
    return false
}

func shape_of(argument: SpiteCompiler.Value): Model.ShapeModel {
    var shape = lowering.state.layout.program.shape_keyed(argument.value_type.name)
    crash shape
    return shape
}

func offsets_of(shape: Model.ShapeModel): List<Integer> {
    var offsets = List<Integer>()
    var offset = 0
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        if member.is_an_attribute {
            var width = width_in_a_struct(member.answer)
            var past = offset % width
            if past > 0 {
                offset = offset + width - past
            }
            offsets.append(offset)
            offset = offset + width
        }
        index = index + 1
    }
    return offsets
}

func size_of(shape: Model.ShapeModel): Integer {
    var offset = 0
    var widest = 1
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        if member.is_an_attribute {
            var width = width_in_a_struct(member.answer)
            if width > widest {
                widest = width
            }
            var past = offset % width
            if past > 0 {
                offset = offset + width - past
            }
            offset = offset + width
        }
        index = index + 1
    }
    var tail = offset % widest
    if tail > 0 {
        offset = offset + widest - tail
    }
    return offset
}

func width_in_a_struct(held: Model.Type): Integer {
    var scalar = lowering.state.scalars.of(held.name)
    crash scalar
    return scalar.size
}

func struct_of(argument: SpiteCompiler.Value): Integer {
    var shape = shape_of(argument)
    var offsets = offsets_of(shape)
    var size = size_of(shape)
    var room = lowering.new_register()
    if lowering.state.resumable_mode {
        var allocated = LowIntermediaryRepresentation.Instructions.Allocate(room, size)
        lowering.emit(allocated)
    } else {
        var reserved = LowIntermediaryRepresentation.Instructions.FrameRoom(room, size)
        lowering.emit(reserved)
    }
    var place = 0
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            var offset = offsets[place]
            crash offset
            write_a_field(argument, shape, member, room, offset)
            place = place + 1
        }
        index = index + 1
    }
    passed.append(argument)
    rooms.append(room)
    return room
}

func write_a_field(
    argument: SpiteCompiler.Value,
    shape: Model.ShapeModel,
    member: Model.FunctionModel,
    room: Integer,
    offset: Integer,
) {
    crash member.answer
    var read = HighIntermediaryRepresentation.Values.ShapeCall(shape, member, argument, no_arguments)
    var field = lowering.lower_value(read)
    var width = lowering.width_of(member.answer)
    var stored = LowIntermediaryRepresentation.Instructions.Store(room, offset, field.value, width)
    lowering.emit(stored)
}

func storage_of_a_list(argument: SpiteCompiler.Value): Integer {
    var lowering_counting = Counting(lowering.state)
    var list = lowering.lower_value(argument)
    lowering_counting.release_later(list, argument.value_type)
    var model = lowering.state.layout.program.class_named(argument.value_type.name)
    crash model
    var buffer_attribute = model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = lowering.state.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, list.value, buffer_offset, 'bits_64')
    lowering.emit(loaded)
    return lowering.storage_of(buffer)
}

func written_back() {
    var index = 0
    while index < passed.count() {
        var argument = passed[index]
        var room = rooms[index]
        crash room
        write_back(argument, room)
        index = index + 1
    }
}

func write_back(argument: SpiteCompiler.Value, room: Integer) {
    var lowering_counting = Counting(lowering.state)
    var shape = shape_of(argument)
    var offsets = offsets_of(shape)
    var object = lowering.lower_value(argument)
    var place = 0
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            var offset = offsets[place]
            crash offset
            read_a_field(shape, member, object.value, room, offset)
            place = place + 1
        }
        index = index + 1
    }
    lowering_counting.release_later(object, argument.value_type)
    if lowering.state.resumable_mode {
        var freed = LowIntermediaryRepresentation.Instructions.Free(room)
        lowering.emit(freed)
    }
}

func read_a_field(
    shape: Model.ShapeModel,
    member: Model.FunctionModel,
    object: Integer,
    room: Integer,
    offset: Integer,
) {
    var lowering_statements = Statements(lowering.state)
    crash member.answer
    var target = lowering.new_register()
    var width = lowering.width_of(member.answer)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(target, room, offset, width)
    loaded.is_signed = lowering.is_signed(member.answer)
    lowering.emit(loaded)
    var field = lowering.single(target)
    lowering_statements.store_through_shape(shape, member.name, object, field, member.answer)
}

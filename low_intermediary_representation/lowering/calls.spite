var state = FunctionLoweringState()

func Calls(starting_state: FunctionLoweringState) {
    state = starting_state
}

func lowered_call_arguments(call: HighIntermediaryRepresentation.Values.Call): List<Integer> {
    var lowering = FunctionLowering(state)
    var arguments = List<Integer>()
    var receiver = lowering.lower_value(call.receiver)
    crash call.receiver
    var unknown = unknown_callees()
    passed_on(receiver, call.receiver, unknown)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, unknown)
    return arguments
}

func unknown_callees(): List<String> {
    var unknown = List<String>()
    unknown.append("$unknown")
    return unknown
}

func passed_on(value: Lowered, given: SpiteCompiler.Value, called_keys: List<String>) {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    counting.release_later(value, given.value_type)
    fallback lowering.is_a_pointer(given.value_type) and not value.owned
    fallback not is_steady(given, called_keys)
    counting.retain_counted(value.value, given.value_type)
    counting.note_the_count(value.value, given.value_type)
    state.pending_releases.append(value.value)
}

func is_steady(given: SpiteCompiler.Value?, called_keys: List<String>): Boolean {
    var lowering = FunctionLowering(state)
    crash given
    if lowering.is_a_singleton_type(given.value_type) {
        return true
    }
    switch given {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.Conversion: return carries_steadily(given, called_keys)
        HighIntermediaryRepresentation.Values.AttributeRead: return is_a_steady_attribute(given, called_keys)
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func carries_steadily(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    called_keys: List<String>,
): Boolean {
    fallback conversion.kind != 'join' and conversion.kind != 'into_handle'
    return is_steady(conversion.converted, called_keys)
}

func is_a_steady_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    called_keys: List<String>,
): Boolean {
    fallback not state.layout.is_back(read.attribute)
    fallback is_steady(read.object, called_keys)
    fallback state.assignments
    return not state.assignments.may_assign(called_keys, read.attribute)
}

func add_arguments(arguments: List<Integer>, values: List<SpiteCompiler.Value>, called_keys: List<String>) {
    var lowering = FunctionLowering(state)
    var callee = taking_callee(called_keys)
    var index = 0
    while index < values.count() {
        var value = values[index]
        if lowering.hands_the_argument(callee, index) {
            var handed = handed_over(value)
            arguments.append(handed)
        } else if is_a_held_argument(value, values, called_keys) {
            var held = lower_a_held_argument(value)
            arguments.append(held.value)
        } else {
            var argument_value = lowering.lower_value(value)
            passed_on(argument_value, value, called_keys)
            arguments.append(argument_value.value)
            if argument_value.presence >= 0 {
                arguments.append(argument_value.presence)
            }
        }
        index = index + 1
    }
    note_a_handed_call(callee)
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func taking_callee(called_keys: List<String>): String {
    fallback state.taken and called_keys.count() == 1
    var key = called_keys[0]
    fallback state.taken.takes_any(key)
    return key
}

func handed_over(value: SpiteCompiler.Value): Integer {
    var counting = Counting(state)
    var handed = counting.lower_a_kept_value(value)
    if not handed.owned {
        counting.retain_counted(handed.value, value.value_type)
    }
    return handed.value
}

func note_a_handed_call(callee: String) {
    fallback not callee.is_empty()
    var known = state.program.handed_calls[callee]
    if known {
        state.program.handed_calls[callee] = known + 1
    } else {
        state.program.handed_calls[callee] = 1
    }
}

func lower_call(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var statements = Statements(state)
    var intrinsic = Intrinsics(lowering)
    var is_an_intrinsic = not call.function.has_a_body() and not call.function.is_written_by_the_compiler
    if is_an_intrinsic {
        return intrinsic.lowered(call)
    }
    var reads = ListReads(lowering)
    if reads.is_a_count(call) {
        return reads.counted(call)
    }
    var joins = TextJoins(lowering)
    if joins.is_a_join(call) {
        return joins.joined(call)
    }
    if joins.is_an_append(call) {
        return joins.appended(call)
    }
    var called_key = call.function.key()
    var working = Working(lowering)
    if state.resumable_mode and lowering.is_resumable(called_key) {
        return working.waiting_call(call)
    }
    if state.resumable_mode and called_key == "Program.sleep" {
        return working.waiting_sleep(call)
    }
    if state.makes_work and lowering.blocks(called_key) and not lowering.is_locked_here() {
        return working.helped(call)
    }
    if state.makes_work and called_key == "Program.sleep" and not lowering.is_locked_here() {
        return working.plain_sleep(call)
    }
    if state.program.prompt_sleeps and called_key == "Program.sleep" {
        return sleep_answering_the_prompt(call)
    }
    var add_a_check_point = false
    if statements.checks_points() and not lowering.is_locked_here() and lowering.waits_in_the_library(call) {
        add_a_check_point = true
        statements.write_a_check_point()
    }
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var arguments = List<Integer>()
    var calling = List<String>()
    calling.append(called_key)
    var held = is_a_held_receiver(call, calling)
    var receiver = lower_a_receiver(call, held)
    crash call.receiver
    if not held {
        passed_on(receiver, call.receiver, calling)
    }
    counting.settle_before_clearing(call, receiver.value)
    arguments.append(receiver.value)
    add_arguments(arguments, call.arguments, calling)
    var answer = finished_call(call, arguments)
    if add_a_check_point {
        statements.write_a_check_point()
    }
    counting.release_the_pending()
    state.pending_releases = outer
    return answer
}

# ../../../spite_documentation/repl.md#remote---repl-port
func sleep_answering_the_prompt(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var lowering = FunctionLowering(state)
    var statements = Statements(state)
    var milliseconds = sleep_milliseconds(call)
    var arguments = List<Integer>()
    arguments.append(milliseconds)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_prompt_sleep", arguments)
    lowering.emit(called)
    if statements.checks_points() and not lowering.is_locked_here() {
        statements.write_a_check_point()
    }
    return Lowered(-1, -1)
}

# ../../../spite_documentation/concurrency.md#what-runs-at-once
func sleep_milliseconds(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var lowering = FunctionLowering(state)
    var duration_value = call.arguments[0]
    crash duration_value
    var duration_model = state.layout.program.class_named("Duration")
    crash duration_model
    var total = duration_model.function_named("total")
    crash total
    var unit_parameter = total.parameters[0]
    crash unit_parameter
    var unit_model = duration_model.enum_named("Unit")
    crash unit_model
    var place = unit_model.values.index_of("milliseconds")
    crash place
    var unit_number = unit_model.numbers[place]
    crash unit_number
    var unit_type = unit_parameter.parameter_type.present()
    var unit_value = HighIntermediaryRepresentation.Values.WholeNumber(unit_type, unit_number, false)
    var unit_arguments = List<SpiteCompiler.Value>()
    unit_arguments.append(unit_value)
    var reading = HighIntermediaryRepresentation.Values.Call(total, duration_value, unit_arguments)
    var milliseconds = lowering.lower_value(reading)
    return milliseconds.value
}

func is_a_held_receiver(call: HighIntermediaryRepresentation.Values.Call, calling: List<String>): Boolean {
    var given = call.receiver
    if given.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_held_item(given, call, calling)
    }
    return false
}

func lower_a_receiver(call: HighIntermediaryRepresentation.Values.Call, held: Boolean): Lowered {
    var lowering = FunctionLowering(state)
    var given = call.receiver
    if given.class == HighIntermediaryRepresentation.Values.Conversion {
        return lower_a_held_conversion(given, held)
    }
    return lowering.lower_value(given)
}

func lower_a_held_conversion(given: HighIntermediaryRepresentation.Values.Conversion, held: Boolean): Lowered {
    var lowering = FunctionLowering(state)
    if held {
        var reads = ListReads(lowering)
        return reads.held_item(given)
    }
    return lowering.lower_value(given)
}

func is_a_held_item(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    fallback conversion.kind == 'proven' and not state.resumable_mode
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        return is_a_held_read(read, call, calling)
    }
    return false
}

func is_a_held_read(
    read: HighIntermediaryRepresentation.Values.Call,
    call: HighIntermediaryRepresentation.Values.Call,
    calling: List<String>,
): Boolean {
    var lowering = FunctionLowering(state)
    var reads = ListReads(lowering)
    fallback reads.gets.is_a_plain_get(read) and lowering.is_a_pointer(read.value_type)
    fallback is_steady(read.receiver, calling) and read.arguments.all(is_plain_reading)
    fallback call.arguments.all(is_plain_reading)
    return leaves_the_items(calling, read.function.owner)
}

# ../../OPTIMIZATIONS.md#an-item-a-call-cannot-let-go-is-passed-without-counting
func is_a_held_argument(
    value: SpiteCompiler.Value,
    values: List<SpiteCompiler.Value>,
    called_keys: List<String>,
): Boolean {
    fallback not state.resumable_mode and not called_keys.contains("$unknown")
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_held_item_argument(value, values, called_keys)
    }
    return false
}

func is_a_held_item_argument(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    values: List<SpiteCompiler.Value>,
    called_keys: List<String>,
): Boolean {
    fallback conversion.kind == 'proven'
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        fallback is_a_steady_item_read(read, called_keys)
        fallback values.all(reads_without_writing)
        return leaves_the_items(called_keys, read.function.owner)
    }
    return false
}

func is_a_steady_item_read(read: HighIntermediaryRepresentation.Values.Call, called_keys: List<String>): Boolean {
    var lowering = FunctionLowering(state)
    var reads = ListReads(lowering)
    fallback reads.gets.is_a_plain_get(read) and lowering.is_a_pointer(read.value_type)
    return is_steady(read.receiver, called_keys) and read.arguments.all(is_plain_reading)
}

func reads_without_writing(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_proven_plain_get(value)
    }
    return is_plain_reading(value)
}

func is_a_proven_plain_get(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    var lowering = FunctionLowering(state)
    fallback conversion.kind == 'proven'
    var read = conversion.converted
    if read.class == HighIntermediaryRepresentation.Values.Call {
        var reads = ListReads(lowering)
        fallback reads.gets.is_a_plain_get(read) and is_plain_reading_of(read.receiver)
        return read.arguments.all(is_plain_reading)
    }
    return false
}

func lower_a_held_argument(value: SpiteCompiler.Value): Lowered {
    var lowering = FunctionLowering(state)
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        var reads = ListReads(lowering)
        return reads.held_item(value)
    }
    crash
}

func leaves_the_items(calling: List<String>, list_key: String): Boolean {
    fallback state.assignments
    return not state.assignments.may_write_items(calling, list_key)
}

func is_plain_reading(value: SpiteCompiler.Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_plain_reading_of(value.object)
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Conversion: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func is_plain_reading_of(object: SpiteCompiler.Value?): Boolean {
    fallback object
    return is_plain_reading(object)
}

func finished_call(call: HighIntermediaryRepresentation.Values.Call, arguments: List<Integer>): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var target = -1
    if not call.value_type.is_nothing() {
        target = lowering.new_register()
    }
    var written_key = call.function.key()
    var function_key = unguarded_in_a_coarse_loop(written_key)
    var called = LowIntermediaryRepresentation.Instructions.Call(target, function_key, arguments)
    called.known_positions = call.known_positions
    called.known_regions = call.known_regions
    called.known_values = call.known_values
    if lowering.is_a_nullable_scalar(call.value_type) {
        var presence = lowering.new_register()
        called.presence = presence
        lowering.emit(called)
        return Lowered(target, presence)
    }
    lowering.emit(called)
    if lowering.counts_an_answer(call.value_type) {
        return counting.owned(target)
    }
    return lowering.single(target)
}

func unguarded_in_a_coarse_loop(key: String): String {
    if state.coarse_class.is_empty() or not state.waits {
        return key
    }
    if state.waits.owner_of(key) != state.coarse_class or not state.waits.is_locked(key) {
        return key
    }
    if not state.program.unguarded_keys.contains(key) {
        state.program.unguarded_keys.append(key)
    }
    return "{key}$unguarded"
}

func lower_function_value(made: HighIntermediaryRepresentation.Values.Function.Value): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var conversions = Conversions(state)
    var receiver = lowering.lower_value(made.receiver)
    crash made.receiver
    var value_class = "Spite.FunctionValue"
    if not lowering.is_a_pointer(made.receiver.value_type) {
        value_class = "Spite.FunctionValueOfANumber"
    }
    var object = conversions.small_object(value_class, 48)
    var address = lowering.new_register()
    var key = made.function.key()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(address, key)
    lowering.emit(found)
    var stored_address = LowIntermediaryRepresentation.Instructions.Store(
        object,
        16,
        address,
        'bits_64',
        "Spite.FunctionValue.address",
        false,
    )
    lowering.emit(stored_address)
    var frame_maker = lowering.constant(0)
    var stepper = lowering.constant(0)
    if lowering.is_resumable(key) {
        frame_maker = lowering.new_register()
        var found_maker = LowIntermediaryRepresentation.Instructions.FunctionAddress(frame_maker, "{key}$frame")
        lowering.emit(found_maker)
        stepper = lowering.new_register()
        var found_stepper = LowIntermediaryRepresentation.Instructions.FunctionAddress(stepper, "{key}$step")
        lowering.emit(found_stepper)
    }
    var stored_maker = LowIntermediaryRepresentation.Instructions.Store(object, 32, frame_maker, 'bits_64', "", false)
    lowering.emit(stored_maker)
    var stored_stepper = LowIntermediaryRepresentation.Instructions.Store(object, 40, stepper, 'bits_64', "", false)
    lowering.emit(stored_stepper)
    counting.kept(receiver, made.receiver.value_type)
    var stored_receiver = LowIntermediaryRepresentation.Instructions.Store(
        object,
        24,
        receiver.value,
        'bits_64',
        "Spite.FunctionValue.receiver",
        false,
    )
    lowering.emit(stored_receiver)
    return counting.owned(object)
}

func lower_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var called = lowering.lower_value(call.called)
    crash call.called
    var unknown = unknown_callees()
    passed_on(called, call.called, unknown)
    var address = lowering.new_register()
    var loaded_address = LowIntermediaryRepresentation.Instructions.Load(
        address,
        called.value,
        16,
        'bits_64',
        true,
        "Spite.FunctionValue.address",
        false,
    )
    lowering.emit(loaded_address)
    var receiver = lowering.new_register()
    var loaded_receiver = LowIntermediaryRepresentation.Instructions.Load(
        receiver,
        called.value,
        24,
        'bits_64',
        true,
        "Spite.FunctionValue.receiver",
        false,
    )
    lowering.emit(loaded_receiver)
    var arguments = List<Integer>()
    arguments.append(receiver)
    add_arguments(arguments, call.arguments, unknown)
    var target = -1
    if not call.value_type.is_nothing() {
        target = lowering.new_register()
    }
    var made = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    var presence = -1
    if lowering.is_a_nullable_scalar(call.value_type) {
        presence = lowering.new_register()
        made.presence = presence
    }
    if state.resumable_mode {
        call_a_value_that_may_wait(made, called.value, arguments, target, presence)
    } else {
        lowering.emit(made)
    }
    counting.release_the_pending()
    state.pending_releases = outer
    var answer = Lowered(target, presence)
    answer.owned = lowering.counts_an_answer(call.value_type)
    return answer
}

func call_a_value_that_may_wait(
    plain: LowIntermediaryRepresentation.Instructions.CallAt,
    called: Integer,
    arguments: List<Integer>,
    target: Integer,
    presence: Integer,
) {
    var lowering = FunctionLowering(state)
    var frame_maker = lowering.new_register()
    var loaded_maker = LowIntermediaryRepresentation.Instructions.Load(
        frame_maker,
        called,
        32,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded_maker)
    var zero = lowering.constant(0)
    var is_plain = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_plain, 'equal', frame_maker, zero, true)
    lowering.emit(compared)
    var calling = lowering.new_block()
    var framing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_plain, calling, framing)
    lowering.emit(test)
    lowering.switch_to(calling)
    lowering.emit(plain)
    lowering.jump_to(after)
    lowering.switch_to(framing)
    var stepper = lowering.new_register()
    var loaded_stepper = LowIntermediaryRepresentation.Instructions.Load(
        stepper,
        called,
        40,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded_stepper)
    var frame = lowering.new_register()
    var made_frame = LowIntermediaryRepresentation.Instructions.CallAt(frame, frame_maker, arguments)
    lowering.emit(made_frame)
    var working = Working(lowering)
    working.finish_the_frame(frame, "", stepper, target, presence)
    lowering.jump_to(after)
    lowering.switch_to(after)
}

func lower_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall): Lowered {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var outer = state.pending_releases
    state.pending_releases = List<Integer>()
    var library = lowering.lower_value(call.library)
    var library_model = state.layout.program.class_named("DynamicLibrary")
    crash library_model
    var handle_attribute = library_model.attribute_named("handle")
    crash handle_attribute
    var handle_offset = state.layout.offset_of(handle_attribute)
    var handle = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(
        handle,
        library.value,
        handle_offset,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded)
    var address = lowering.new_register()
    var library_files = LibraryFiles()
    var file_name = library_files.file_of(call.library)
    var found = LowIntermediaryRepresentation.Instructions.ForeignAddress(
        address,
        handle,
        call.function_name,
        file_name,
    )
    lowering.emit(found)
    var arguments = List<Integer>()
    var decimal_sizes = List<Integer>()
    var callbacks = Callbacks(lowering)
    var structs = ForeignStructs(lowering)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = passed_into_c(argument, callbacks, structs)
        arguments.append(passed)
        var size = lowering.decimal_size_of(argument.value_type)
        decimal_sizes.append(size)
        index = index + 1
    }
    var target = lowering.new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    called.answers_32_bits = call.value_type.name == "Integer"
    called.decimal_sizes = decimal_sizes
    called.answer_decimal_size = lowering.decimal_size_of(call.value_type)
    var tracked = state.program.reports_faults
    if tracked {
        note_the_foreign_call(call, library.value)
    }
    lowering.emit(called)
    free_the_terminated_copies()
    if tracked {
        var slot = foreign_slot()
        var unused_site = lowering.constant(0)
        var cleared = LowIntermediaryRepresentation.Instructions.Store(slot, 0, unused_site, 'bits_64', "", false)
        lowering.emit(cleared)
    }
    structs.written_back()
    callbacks.restore()
    counting.release_the_pending()
    state.pending_releases = outer
    if call.value_type.kind == 'object' and call.value_type.name == "String" {
        var joins = TextJoins(lowering)
        return joins.copied_c_text(target, call.function_name)
    }
    return lowering.single(target)
}

func note_the_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall, library: Integer) {
    var lowering = FunctionLowering(state)
    var text = "foreign={call.function_name}\tfrom={state.path}:{state.line}"
    state.program.foreign_sites.append(text)
    var site_number = state.program.foreign_sites.count()
    var site = lowering.constant(site_number)
    var slot = foreign_slot()
    var stored_site = LowIntermediaryRepresentation.Instructions.Store(slot, 0, site, 'bits_64', "", false)
    lowering.emit(stored_site)
    var stored_library = LowIntermediaryRepresentation.Instructions.Store(slot, 8, library, 'bits_64', "", false)
    lowering.emit(stored_library)
}

func foreign_slot(): Integer {
    var lowering = FunctionLowering(state)
    var singletons = Singletons(state)
    var label = singletons.record_label_of("_foreign")
    var slot = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    lowering.emit(addressed)
    return slot
}

func passed_into_c(argument: SpiteCompiler.Value, callbacks: Callbacks, structs: ForeignStructs): Integer {
    if argument.value_type.kind == 'function' {
        return callbacks.handed_for_the_call(argument)
    }
    if structs.is_a_struct(argument) {
        return structs.struct_of(argument)
    }
    if structs.is_a_number_list(argument) {
        return structs.storage_of_a_list(argument)
    }
    return foreign_argument(argument)
}

func foreign_argument(argument: SpiteCompiler.Value): Integer {
    var lowering = FunctionLowering(state)
    var counting = Counting(state)
    var argument_value = lowering.lower_value(argument)
    var argument_type = argument.value_type
    counting.release_later(argument_value, argument_type)
    if argument_type.kind == 'object' and argument_type.name == "String" {
        return terminated_text(argument_value.value)
    }
    if argument_type.kind == 'object' and argument_type.name == "Buffer" {
        return lowering.storage_of(argument_value.value)
    }
    return argument_value.value
}

func bytes_of_text(text: Integer): Integer {
    var lowering = FunctionLowering(state)
    var string_model = state.layout.program.class_named("String")
    crash string_model
    var buffer_attribute = string_model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = state.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(
        buffer,
        text,
        buffer_offset,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded)
    return lowering.storage_of(buffer)
}

# ../../OPTIMIZATIONS.md#small-blocks-come-from-the-compilers-own-free-lists
func terminated_text(text: Integer): Integer {
    var lowering = FunctionLowering(state)
    var string_model = state.layout.program.class_named("String")
    crash string_model
    var length_attribute = string_model.attribute_named("_length")
    crash length_attribute
    var length_offset = state.layout.offset_of(length_attribute)
    var length = lowering.new_register()
    var loaded_length = LowIntermediaryRepresentation.Instructions.Load(
        length,
        text,
        length_offset,
        'bits_32',
        true,
        "",
        false,
    )
    lowering.emit(loaded_length)
    var bytes = bytes_of_text(text)
    var end = lowering.address_plus(bytes, length)
    var end_byte = lowering.new_register()
    var loaded_end = LowIntermediaryRepresentation.Instructions.Load(end_byte, end, 0, 'bits_8', false, "", false)
    lowering.emit(loaded_end)
    var zero = lowering.constant(0)
    var passed = lowering.new_register()
    var passing_the_text = LowIntermediaryRepresentation.Instructions.Copy(passed, bytes)
    lowering.emit(passing_the_text)
    var held_copy = lowering.new_register()
    var keeping_nothing = LowIntermediaryRepresentation.Instructions.Copy(held_copy, zero)
    lowering.emit(keeping_nothing)
    var is_ended = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_ended, 'equal', end_byte, zero, true)
    lowering.emit(compared)
    var copying = lowering.new_block()
    var ended = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_ended, ended, copying)
    lowering.emit(test)
    lowering.switch_to(copying)
    var one = lowering.constant(1)
    var room = lowering.address_plus(length, one)
    var fresh = lowering.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(fresh, room, 0, 0)
    lowering.emit(allocated)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(fresh, bytes, length, false)
    lowering.emit(copied)
    var fresh_end = lowering.address_plus(fresh, length)
    var stored = LowIntermediaryRepresentation.Instructions.Store(fresh_end, 0, zero, 'bits_8', "", false)
    lowering.emit(stored)
    var passing_the_copy = LowIntermediaryRepresentation.Instructions.Copy(passed, fresh)
    lowering.emit(passing_the_copy)
    var keeping_the_copy = LowIntermediaryRepresentation.Instructions.Copy(held_copy, fresh)
    lowering.emit(keeping_the_copy)
    lowering.jump_to(ended)
    lowering.switch_to(ended)
    state.terminated_copies.append(held_copy)
    return passed
}

func free_the_terminated_copies() {
    state.terminated_copies.each(free_a_terminated_copy)
    state.terminated_copies = List<Integer>()
}

func free_a_terminated_copy(held_copy: Integer) {
    var lowering = FunctionLowering(state)
    var zero = lowering.constant(0)
    var is_held_copy = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_held_copy, 'not_equal', held_copy, zero, true)
    lowering.emit(compared)
    var freeing = lowering.new_block()
    var done = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_held_copy, freeing, done)
    lowering.emit(test)
    lowering.switch_to(freeing)
    var freed = LowIntermediaryRepresentation.Instructions.Free(held_copy)
    lowering.emit(freed)
    lowering.jump_to(done)
    lowering.switch_to(done)
}

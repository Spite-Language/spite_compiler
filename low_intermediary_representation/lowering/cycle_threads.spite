# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it

var _others = 256
var _program_thread = 264
var _lock = 320
var _left = 208
var _collecting: Long = 1073741824
var _counted: Long = 1073741823
var no_state = FunctionLoweringState()
var no_lowering = FunctionLowering(no_state)
var machine = MachineWriting(no_lowering)

func CycleThreads(starting_machine: MachineWriting) {
    machine = starting_machine
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write() {
    write_the_lock()
    write_the_unlock()
    write_the_enter()
    write_the_leave()
    write_the_work_started()
    write_the_work_ended()
    write_the_program_thread()
}

func write_nothing_to_do() {
    machine.begin("_cycle_enter", 0)
    var nobody = machine.constant_of(0)
    machine.answered(nobody)
    machine.finish()
    machine.begin("_cycle_leave", 1)
    machine.answered_nothing()
    machine.finish()
    machine.begin("_cycle_note_the_program_thread", 0)
    machine.answered_nothing()
    machine.finish()
}

func record(): Integer {
    return machine.data_at(machine.program.cycle_record)
}

func exchanged(address: Integer, offset: Integer, expected: Integer, desired: Integer): Integer {
    var before = machine.writing.new_register()
    var exchanging = LowIntermediaryRepresentation.Instructions.CompareExchange(
        before,
        address,
        offset,
        expected,
        desired,
        'bits_64',
        true,
    )
    machine.writing.emit(exchanging)
    return before
}

func added(address: Integer, offset: Integer, amount: Long) {
    var after = machine.writing.new_register()
    var adding = LowIntermediaryRepresentation.Instructions.AtomicAdd(after, address, offset, amount)
    machine.writing.emit(adding)
}

func let_others_run() {
    var no_time = machine.constant_of(0)
    var sleeping = machine.one_listed(no_time)
    machine.call_imported("Sleep", sleeping)
}

func write_the_lock() {
    machine.begin("_cycle_lock", 0)
    var base = record()
    var free = machine.constant_of(0)
    var taken = machine.constant_of(1)
    var top = machine.loop_top()
    var before = exchanged(base, _lock, free, taken)
    var missed = machine.compared_to('not_equal', before, 0)
    var done = machine.loop_while(missed)
    let_others_run()
    machine.loop_back(top, done)
    machine.answered_nothing()
    machine.finish()
}

func write_the_unlock() {
    machine.begin("_cycle_unlock", 0)
    var base = record()
    added(base, _lock, -1)
    machine.answered_nothing()
    machine.finish()
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write_the_enter() {
    machine.begin("_cycle_enter", 0)
    var base = record()
    var thread = machine.thread_now()
    var program_thread = machine.loaded(base, _program_thread)
    var same = machine.compared('equal', thread, program_thread)
    var elsewhere = machine.opened_when(same)
    var nobody = machine.constant_of(0)
    machine.answered(nobody)
    machine.closed(elsewhere)
    var top = machine.loop_top()
    var seen = machine.loaded(base, _others)
    var mask = machine.constant_of(_counted)
    var expected = machine.both(seen, mask)
    var desired = machine.plus_number(expected, 1)
    var before = exchanged(base, _others, expected, desired)
    var missed = machine.compared('not_equal', before, expected)
    var done = machine.loop_while(missed)
    let_others_run()
    machine.loop_back(top, done)
    var one = machine.constant_of(1)
    machine.answered(one)
    machine.finish()
}

func write_the_leave() {
    machine.begin("_cycle_leave", 1)
    var stayed = machine.is_zero(0)
    var entered = machine.opened_when(stayed)
    machine.answered_nothing()
    machine.closed(entered)
    var base = record()
    added(base, _others, -1)
    machine.answered_nothing()
    machine.finish()
}

func write_the_work_started() {
    machine.begin("_cycle_work_started", 0)
    var base = record()
    added(base, _others, 1)
    machine.answered_nothing()
    machine.finish()
}

func write_the_work_ended() {
    machine.begin("_cycle_work_ended", 0)
    var base = record()
    added(base, _others, -1)
    machine.answered_nothing()
    machine.finish()
}

func write_the_program_thread() {
    machine.begin("_cycle_note_the_program_thread", 0)
    var base = record()
    var thread = machine.thread_now()
    machine.stored(base, _program_thread, thread)
    machine.answered_nothing()
    machine.finish()
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func walk_alone_or_answer(base: Integer) {
    var free = machine.constant_of(0)
    var walking = machine.constant_of(_collecting)
    var before = exchanged(base, _others, free, walking)
    var busy = machine.compared_to('not_equal', before, 0)
    var alone = machine.opened_when(busy)
    var nothing_freed = machine.constant_of(0)
    machine.answered(nothing_freed)
    machine.closed(alone)
}

func let_the_others_in(base: Integer) {
    var amount = 0 - _collecting
    added(base, _others, amount)
}

func return_unless_alone(base: Integer) {
    var others = machine.loaded(base, _others)
    var running = machine.compared_to('not_equal', others, 0)
    var alone = machine.opened_when(running)
    machine.answered_nothing()
    machine.closed(alone)
}

func locked() {
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_lock", no_arguments)
}

func unlocked() {
    var no_arguments = machine.none_listed()
    machine.called_for_nothing("_cycle_unlock", no_arguments)
}

func set_the_suspect_bit(object: Integer, bit: Integer) {
    var top = machine.loop_top()
    var word = machine.loaded(object, 8)
    var marked = machine.either(word, bit)
    var before = exchanged(object, 8, word, marked)
    var missed = machine.compared('not_equal', before, word)
    var done = machine.loop_while(missed)
    machine.loop_back(top, done)
}

func count_when_alone(base: Integer) {
    var others = machine.loaded(base, _others)
    var alone = machine.is_zero(others)
    var counting = machine.opened_when(alone)
    var left = machine.loaded(base, _left)
    var fewer = machine.plus_number(left, -1)
    machine.stored(base, _left, fewer)
    machine.closed(counting)
}

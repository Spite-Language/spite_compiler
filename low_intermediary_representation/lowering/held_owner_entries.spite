var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)

func HeldOwnerEntries(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

# ../../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func holds_back(made: HighIntermediaryRepresentation.Values.Function.Value): Boolean {
    fallback made.holds_its_receiver_back
    if made.holds_back_only_a_held_owner {
        fallback lowering.state.layout.is_back_held(made.function.owner)
    }
    if not made.holds_its_owner_for_the_call {
        return true
    }
    var key = made.function.key()
    return not lowering.is_resumable(key)
}

# ../../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func entry_of(made: HighIntermediaryRepresentation.Values.Function.Value): String {
    var key = made.function.key()
    if not made.holds_its_owner_for_the_call or not holds_back(made) {
        return key
    }
    var entry = "{key}$held"
    if made.skips_a_freed_owner {
        entry = "{key}$held_or_skipped"
    }
    if not is_lowered(entry) {
        lower_the_entry(made.function, entry, made.skips_a_freed_owner)
    }
    return entry
}

func is_lowered(key: String): Boolean {
    var lowered_functions = lowering.state.program.lowered_functions
    var index = 0
    while index < lowered_functions.count() {
        var function = lowered_functions[index]
        if function.key == key {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func lower_the_entry(function: Model.FunctionModel, entry: String, skips: Boolean) {
    var making_state = FunctionLoweringState()
    making_state.start_from(lowering.state.layout, lowering.state.program, lowering.state.singleton_slots)
    var making = FunctionLowering(making_state)
    var making_counting = Counting(making_state)
    making.start(entry)
    var receiver = making.new_register()
    var arguments = List<Integer>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var value = making.new_register()
        arguments.append(value)
        if making.is_a_nullable_scalar(parameter.parameter_type) {
            var presence = making.new_register()
            arguments.append(presence)
        }
        index = index + 1
    }
    making.state.function.parameter_count = making.state.function.register_count
    var owner = making.new_register()
    var counted = List<Integer>()
    counted.append(receiver)
    var held = LowIntermediaryRepresentation.Instructions.Call(owner, "_back_counted", counted, -1, false)
    making.emit(held)
    var zero = making.constant(0)
    var is_gone = making.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_gone, 'equal', owner, zero, true)
    making.emit(compared)
    var gone = making.new_block()
    var calling = making.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_gone, gone, calling)
    making.emit(test)
    making.switch_to(gone)
    if skips {
        var skipped = LowIntermediaryRepresentation.Instructions.Return(-1, -1, false)
        making.emit(skipped)
    } else {
        var words = gone_words(function)
        var label = making.text_label(words)
        var stopped = LowIntermediaryRepresentation.Instructions.Stop(label, false)
        making.emit(stopped)
    }
    making.switch_to(calling)
    arguments.insert(0, owner)
    var target = -1
    var presence = -1
    if function.answer {
        target = making.new_register()
        making.state.function.answer_decimal_size = making.decimal_size_of(function.answer)
        if making.is_a_nullable_scalar(function.answer) {
            presence = making.new_register()
        }
    }
    var callee_key = function.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, callee_key, arguments, presence, false)
    making.emit(called)
    making_counting.release(owner)
    var answered = LowIntermediaryRepresentation.Instructions.Return(target, presence, false)
    making.emit(answered)
    lowering.state.program.lowered_functions.append(making.state.function)
}

func gone_words(function: Model.FunctionModel): String {
    var shown = function.owner
    var owner = lowering.state.layout.program.class_named(function.owner)
    if owner {
        shown = owner.shown
    }
    var name = function.name
    return "spite: '{shown}.{name}' was called through a function value after the object it is bound to was freed\n"
}

var callees = Dictionary<String, List<String>>()
var waits_itself = List<String>()
var resumable = List<String>()
var current = List<String>()
var is_waiting = false
var started = List<String>()
var started_in_parallel = List<String>()
var reached_in_parallel = List<String>()
var locked = List<String>()
var starting_name = ""

func Waits(high: HighIntermediaryRepresentation.HighProgram) {
    high.built_functions.each(read_a_function)
    started_in_parallel.each(reach_in_parallel)
    var index = 0
    while index < reached_in_parallel.count() {
        var key = reached_in_parallel[index]
        if is_a_singleton_function(high, key) {
            var owner_key = owner_of(key)
            locked.append(owner_key)
        }
        index = index + 1
    }
    started.each(make_resumable)
}

func reach_in_parallel(key: String) {
    assert not reached_in_parallel.contains(key)
    reached_in_parallel.append(key)
    var called = callees[key]
    assert called
    called.each(reach_in_parallel)
}

func owner_of(key: String): String {
    var parts = key.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    return parts.join(".")
}

func is_a_singleton_function(high: HighIntermediaryRepresentation.HighProgram, key: String): Boolean {
    var owner_key = owner_of(key)
    var owner = high.model.class_named(owner_key)
    if not owner {
        return false
    }
    return owner.is_singleton
}

func is_locked(key: String): Boolean {
    var owner_key = owner_of(key)
    return locked.contains(owner_key)
}

func read_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    current = List<String>()
    is_waiting = false
    read_a_block(function.body)
    var key = function.function.key()
    callees[key] = current
    if is_waiting {
        waits_itself.append(key)
    }
}

func waits(key: String): Boolean {
    var seen = List<String>()
    return waits_through(key, seen)
}

func waits_through(key: String, seen: List<String>): Boolean {
    if waits_itself.contains(key) {
        return true
    }
    if seen.contains(key) {
        return false
    }
    seen.append(key)
    var called = callees[key]
    if not called {
        return false
    }
    var index = 0
    while index < called.count() {
        var callee = called[index]
        if waits_through(callee, seen) {
            return true
        }
        index = index + 1
    }
    return false
}

func make_resumable(key: String) {
    assert not resumable.contains(key) and waits(key) and not is_locked(key)
    resumable.append(key)
    var called = callees[key]
    assert called
    called.each(make_resumable)
}

func is_resumable(key: String): Boolean {
    return resumable.contains(key)
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_value(statement.value)
        HighIntermediaryRepresentation.Statements.Assign: read_a_value(statement.value)
        HighIntermediaryRepresentation.Statements.AssignAttribute: read_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.AssignThroughShape: read_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: read_a_value(statement.value)
        HighIntermediaryRepresentation.Statements.Return: read_a_value(statement.value)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
        _: return
    }
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    read_a_value(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    read_a_value(loop.condition)
    read_a_block(loop.body)
}

func read_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    read_a_value(first)
    read_a_value(second)
}

func read_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: read_a_conversion(value)
        HighIntermediaryRepresentation.Values.AttributeRead: read_a_value(value.object)
        HighIntermediaryRepresentation.Values.ClassOfValue: read_a_value(value.described)
        HighIntermediaryRepresentation.Values.ClassTest: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: read_a_value(value.text)
        HighIntermediaryRepresentation.Values.EnumText: read_a_value(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: value.arguments.each(read_a_present)
        HighIntermediaryRepresentation.Values.FunctionValue: read_a_value(value.receiver)
        HighIntermediaryRepresentation.Values.FunctionValueCall: read_a_function_value_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(read_a_present)
        HighIntermediaryRepresentation.Values.Negation: read_a_value(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: read_a_shape_call(value)
        _: return
    }
}

func read_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    read_a_value(value)
}

func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var key = call.function.key()
    if key == "Program.sleep" {
        is_waiting = true
    }
    current.append(key)
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

func read_a_function_value_call(call: HighIntermediaryRepresentation.Values.FunctionValueCall) {
    read_a_value(call.called)
    call.arguments.each(read_a_present)
}

func read_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

func read_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    if conversion.kind == 'join' {
        is_waiting = true
    }
    if conversion.kind == 'into_handle' {
        starting_name = conversion.value_type.name
        note_a_start(conversion.converted)
        return
    }
    read_a_value(conversion.converted)
}

func note_a_start(work: HighIntermediaryRepresentation.Values.Value?) {
    if work == HighIntermediaryRepresentation.Values.Call {
        var key = work.function.key()
        if starting_name == "Parallel" {
            started_in_parallel.append(key)
        } else {
            started.append(key)
        }
        read_a_value(work.receiver)
        work.arguments.each(read_a_present)
        return
    }
    read_a_value(work)
}

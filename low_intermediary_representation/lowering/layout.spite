var program = Model.ProgramModel()
var class_ids = Dictionary<String, Integer>()
var offsets = Dictionary<String, Integer>()
var sizes = Dictionary<String, Integer>()
var back_attributes = List<String>()
var back_held = List<String>()
var back_offsets = Dictionary<String, Integer>()
var header_size = 16
var slot_size = 8
var storage_offset = 16

func Layout(starting_program: Model.ProgramModel) {
    program = starting_program
    offsets["Spite.FunctionValue.owner"] = 24
    program.order.each(note_the_back_references)
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        class_ids[model.key] = index + 1
        lay_out(model)
        index = index + 1
    }
}

func lay_out(model: Model.ClassModel) {
    var offset = header_size
    if model.key == "Buffer" {
        offset = offset + slot_size
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        offsets["{model.key}.{attribute.name}"] = offset
        offset = offset + slot_size
        if is_a_nullable_scalar(attribute.attribute_type) {
            offset = offset + slot_size
        }
        index = index + 1
    }
    if back_held.contains(model.key) {
        back_offsets[model.key] = offset
        offset = offset + slot_size
    }
    sizes[model.key] = offset
}

func note_the_back_references(model: Model.ClassModel) {
    model.declared_attributes.each(note_a_back_reference)
}

func note_a_back_reference(attribute: Model.AttributeModel) {
    assert program.holds_no_count(attribute)
    back_attributes.append("{attribute.owner}.{attribute.name}")
    var held = attribute.attribute_type.name
    assert not back_held.contains(held)
    back_held.append(held)
}

func is_back(attribute: Model.AttributeModel): Boolean {
    return back_attributes.contains("{attribute.owner}.{attribute.name}")
}

func has_back_references(): Boolean {
    return not back_attributes.is_empty()
}

func is_back_held(class_key: String): Boolean {
    return back_held.contains(class_key)
}

func back_offset_of(class_key: String): Integer {
    var found = back_offsets[class_key]
    crash found
    return found
}

func back_slot_of(attribute: Model.AttributeModel): Integer {
    return back_offset_of(attribute.attribute_type.name)
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func offset_of(attribute: Model.AttributeModel): Integer {
    var found = offsets["{attribute.owner}.{attribute.name}"]
    crash found
    return found
}

func size_of(class_key: String): Integer {
    var found = sizes[class_key]
    crash found
    return found
}

func box_key_of(filler: Model.Type): String {
    if filler.is_symbol {
        return "Spite.SymbolBox"
    }
    return filler.name
}

func class_id_of(class_key: String): Integer {
    var found = class_ids[class_key]
    if found {
        return found
    }
    var made = class_ids.count() + 1
    class_ids[class_key] = made
    return made
}

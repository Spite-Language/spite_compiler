var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)
var forever: Long = 4294967295

func CrashGateWriting(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

# ../../OPTIMIZATIONS.md#the-first-crash-stops-every-thread
func write_the_gate() {
    assert not machine.is_written("_crash_gate")
    machine.begin("_crash_gate", 0)
    var gate = machine.zeroed_label(8)
    lowering.program.name_state(gate, "crash.gate")
    lowering.program.gates_crashes = true
    var address = machine.data_at(gate)
    var thread = machine.thread_now()
    var free = machine.constant_of(0)
    var before = machine.writing.new_register()
    var claimed = LowIntermediaryRepresentation.Instructions.CompareExchange(before, address, 0, free, thread)
    machine.writing.emit(claimed)
    var was_free = machine.is_zero(before)
    var won = machine.opened_when(was_free)
    machine.answered_nothing()
    machine.closed(won)
    var own = machine.compared('equal', before, thread)
    var again = machine.opened_when(own)
    machine.answered_nothing()
    machine.closed(again)
    var top = machine.loop_top()
    var waiting = machine.constant_of(forever)
    var asleep = machine.one_listed(waiting)
    machine.call_imported("Sleep", asleep)
    machine.writing.jump_to(top)
    var after = machine.writing.new_block()
    machine.writing.switch_to(after)
    machine.answered_nothing()
    machine.finish()
}

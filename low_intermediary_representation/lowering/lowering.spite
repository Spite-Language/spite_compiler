var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var layout = Layout(no_program)
var program = LowIntermediaryRepresentation.LoweredProgram()
var singleton_slots = Dictionary<String, Integer>()
var waits: Waits? = null
var assignments: Assignments? = null
var trimmed_keys = List<String>()
var library = Validators.LibraryFile()
var counts_memory = false
var taken: HighIntermediaryRepresentation.Ownership.TakenParameters? = null
var fresh_by_constructor = Dictionary<String, List<String>>()
var calls_of = Dictionary<String, Integer>()

func Lowering(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
    layout = Layout(starting_high.model)
    layout.lay_out_by_use(starting_high)
}

func lowered(): LowIntermediaryRepresentation.LoweredProgram {
    waits = Waits(high)
    assignments = Assignments(high)
    crash waits
    crash assignments
    if waits.locks_any() {
        waits.find_the_shared_loops(high, assignments)
    }
    var inlining = InlineItems(high, layout, assignments)
    layout.inline_strides = inlining.found()
    layout.columnar = inlining.columnar
    var replacing = ReplacedDefaults(high)
    trimmed_keys = replacing.trimmed_keys
    note_the_fresh_slots(replacing)
    var not_taking = keys_that_take_nothing()
    var taking = HighIntermediaryRepresentation.Ownership.TakenParameters(high.model, not_taking)
    taking.study(high)
    taken = taking
    if layout.program.class_named("Spite.Fault") {
        program.reports_faults = true
        var placeholder = Buffer(0)
        program.data.append(placeholder)
        program.place_table = program.data.count() - 1
        var call_placeholder = Buffer(0)
        program.data.append(call_placeholder)
        program.call_table = program.data.count() - 1
    }
    if counts_memory {
        program.counts_memory = true
        program.allocation_count_label = zeroed_count()
        program.free_count_label = zeroed_count()
    }
    layout.plain_text_room = plain_text_room()
    high.built_functions.each(lower_function)
    lower_the_unguarded_bodies()
    lower_the_trimmed_defaults(replacing)
    if high.makes_work {
        write_the_work()
    }
    var guards_debug_texts = layout.program.class_named("Spite.Debugging")
    if guards_debug_texts {
        var guard_writer = FunctionLowering(layout, program, singleton_slots)
        var guarding = DebugGuardWriting(guard_writer)
        guarding.write_the_guard()
    }
    lower_the_start()
    check_the_handed_calls()
    var freeing = Freeing(high, layout, program, singleton_slots)
    freeing.lower_the_release()
    if program.reports_faults {
        lower_the_fault_handler()
        lower_the_site_texts()
    }
    note_the_steady_singletons()
    program.locked_singletons = waits.locked
    program.shared_classes = waits.shared_owners()
    high.quiet_singletons.each(note_a_quiet_singleton)
    return program
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func note_the_fresh_slots(replacing: ReplacedDefaults) {
    var index = 0
    while index < replacing.trimmed_keys.count() {
        var key = replacing.trimmed_keys[index]
        crash key
        var skipped = replacing.skipped_attributes[key]
        if skipped and is_made_fresh(key) {
            fresh_by_constructor[key] = skipped
        }
        index = index + 1
    }
}

func is_made_fresh(constructor_key: String): Boolean {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == constructor_key {
            return is_an_ordinary_class(function.function.owner)
        }
        index = index + 1
    }
    return false
}

func is_an_ordinary_class(class_key: String): Boolean {
    var model = high.model.class_named(class_key)
    if not model or model.is_singleton {
        return false
    }
    if high.entry and high.entry.owner == class_key {
        return false
    }
    if high.prompt and high.prompt.owner == class_key {
        return false
    }
    return not class_key.starts_with("Spite.")
}

func keys_that_take_nothing(): List<String> {
    var found = List<String>()
    crash waits
    crash assignments
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var key = function.function.key()
        var not_ordinary = not is_an_ordinary_class(function.function.owner)
        if not_ordinary or waits.is_resumable(key) or waits.blocks(key) or assignments.taken_as_values.contains(key) {
            found.append(key)
        }
        index = index + 1
    }
    return found
}

func check_the_handed_calls() {
    crash taken
    program.lowered_functions.each(count_the_handed_calls_in)
    var keys = taken.taken_keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        crash key
        var calls = calls_of[key]
        var handed = program.handed_calls[key]
        var made = 0
        if calls {
            made = calls
        }
        var given = 0
        if handed {
            given = handed
        }
        if made != given {
            var emittable = Validators.LowIntermediaryRepresentation.Emittable.Validator()
            emittable.refuse('unhanded_call', key)
        }
        index = index + 1
    }
}

func count_the_handed_calls_in(function: LowIntermediaryRepresentation.LowFunction) {
    crash taken
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction == LowIntermediaryRepresentation.Instructions.Call {
                instruction.hands_over = count_a_call(instruction.function)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_call(called: String): Boolean {
    crash taken
    var base = called
    if called.ends_with("$unguarded") {
        base = called.replace("$unguarded", "")
    }
    if not taken.takes_any(base) {
        return false
    }
    var known = calls_of[base]
    if known {
        calls_of[base] = known + 1
    } else {
        calls_of[base] = 1
    }
    return true
}

func note_a_quiet_singleton(class_key: String) {
    if singleton_slots.contains(class_key) {
        var label = singleton_slots[class_key]
        crash label
        program.quiet_singletons.append(label)
    }
}

func note_the_steady_singletons() {
    var classes = singleton_slots.keys()
    var forms = SingletonForms(high, classes)
    var index = 0
    while index < forms.steady.count() {
        var class_key = forms.steady[index]
        var label = singleton_slots[class_key]
        crash label
        program.steady_singletons.append(label)
        index = index + 1
    }
}

func write_the_work() {
    var writer = FunctionLowering(layout, program, singleton_slots)
    if high.in_flight_sites > 0 {
        program.in_flight_room = 9 * high.in_flight_sites + 1
        var machine = MachineWriting(writer)
        program.in_flight_table = machine.zeroed_label(24 + 16 * program.in_flight_room)
    }
    var scheduling = Scheduling(writer)
    scheduling.write_the_scheduler()
    var works = WorkWriting(writer)
    works.write_every_work()
    if high.in_flight_sites > 0 {
        works.write_let_go_of_every_flight()
    }
}

func zeroed_count(): Integer {
    var room = Buffer(0)
    var index = 0
    while index < 8 {
        room.append(0)
        index = index + 1
    }
    program.data.append(room)
    return program.data.count() - 1
}

func plain_text_room(): Integer {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == "String._attribute_defaults" {
            return room_of_the_defaults(function)
        }
        index = index + 1
    }
    return -1
}

func room_of_the_defaults(function: HighIntermediaryRepresentation.HighFunction): Integer {
    var statements = function.body.statements
    if statements.count() != 2 {
        return -1
    }
    var room = -1
    var length_is_zero = false
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if statement == HighIntermediaryRepresentation.Statements.Assign.Attribute {
            var name = statement.attribute.name
            if name == "_buffer" {
                room = buffer_room_of(statement.value)
            }
            if name == "_length" {
                length_is_zero = is_zero(statement.value)
            }
        }
        index = index + 1
    }
    if not length_is_zero {
        return -1
    }
    return room
}

func buffer_room_of(value: HighIntermediaryRepresentation.Values.Value?): Integer {
    if not value {
        return -1
    }
    if value == HighIntermediaryRepresentation.Values.MakeObject {
        return room_made(value)
    }
    return -1
}

func room_made(made: HighIntermediaryRepresentation.Values.MakeObject): Integer {
    if made.value_type.name != "Buffer" or made.arguments.count() != 1 or not made.constructor {
        return -1
    }
    var constructor = made.constructor
    if constructor.key() != "Buffer.Buffer" or not constructor.declaration {
        return -1
    }
    var written = constructor.declaration.path.replace("\\", "/")
    if not library.holds(written) or not written.ends_with("/common/buffer.spite") {
        return -1
    }
    var size = made.arguments[0]
    if not size {
        return -1
    }
    return whole_number_of(size)
}

func whole_number_of(value: HighIntermediaryRepresentation.Values.Value): Integer {
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        return small_number(value.number)
    }
    return -1
}

func small_number(number: Long): Integer {
    if number < 0 or number > 1000000 {
        return -1
    }
    return number
}

func is_zero(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not value {
        return false
    }
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number == 0
    }
    return false
}

func lower_function(function: HighIntermediaryRepresentation.HighFunction) {
    var owner = high.model.class_named(function.function.owner)
    crash owner
    var lowering = FunctionLowering(layout, program, singleton_slots)
    lowering.waits = waits
    lowering.assignments = assignments
    lowering.trimmed_keys = trimmed_keys
    lowering.makes_work = high.makes_work
    lowering.taken = taken
    lowering.fresh_by_constructor = fresh_by_constructor
    var made = lowering.lowered(function, owner.file.path)
    program.lowered_functions.append(made)
    var key = function.function.key()
    if lowering.is_resumable(key) {
        lower_a_step(function, owner.file.path, key)
    }
}

func lower_the_unguarded_bodies() {
    program.unguarded_keys.each(lower_an_unguarded_body)
}

func lower_an_unguarded_body(key: String) {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == key {
            lower_unguarded(function)
            return
        }
        index = index + 1
    }
    crash
}

func lower_unguarded(function: HighIntermediaryRepresentation.HighFunction) {
    var owner = high.model.class_named(function.function.owner)
    crash owner
    var lowering = FunctionLowering(layout, program, singleton_slots)
    lowering.waits = waits
    lowering.assignments = assignments
    lowering.trimmed_keys = trimmed_keys
    lowering.makes_work = high.makes_work
    lowering.taken = taken
    lowering.fresh_by_constructor = fresh_by_constructor
    lowering.skips_the_lock = true
    var made = lowering.lowered(function, owner.file.path)
    program.lowered_functions.append(made)
}

func lower_the_trimmed_defaults(replacing: ReplacedDefaults) {
    var index = 0
    while index < replacing.trimmed.count() {
        var variant = replacing.trimmed[index]
        var constructor_key = replacing.trimmed_keys[index]
        crash constructor_key
        var owner = high.model.class_named(variant.function.owner)
        crash owner
        var lowering = FunctionLowering(layout, program, singleton_slots)
        lowering.assignments = assignments
        lowering.taken = taken
        lowering.trimmed_keys = trimmed_keys
        lowering.fresh_by_constructor = fresh_by_constructor
        var made = lowering.lowered(variant, owner.file.path)
        made.key = "{constructor_key}$defaults"
        program.lowered_functions.append(made)
        index = index + 1
    }
}

func lower_a_step(function: HighIntermediaryRepresentation.HighFunction, source_path: String, key: String) {
    var stepping = FunctionLowering(layout, program, singleton_slots)
    stepping.waits = waits
    stepping.assignments = assignments
    stepping.trimmed_keys = trimmed_keys
    stepping.makes_work = true
    stepping.taken = taken
    stepping.fresh_by_constructor = fresh_by_constructor
    stepping.resumable_mode = true
    var step = stepping.lowered(function, source_path)
    program.lowered_functions.append(step)
    var framing = FunctionLowering(layout, program, singleton_slots)
    var working = Working(framing)
    var frame = working.frame_function(step, key)
    program.lowered_functions.append(frame)
}

func lower_the_start() {
    var lowering = FunctionLowering(layout, program, singleton_slots)
    lowering.taken = taken
    lowering.trimmed_keys = trimmed_keys
    lowering.fresh_by_constructor = fresh_by_constructor
    lowering.start("_start")
    if program.reports_faults {
        listen_for_faults(lowering)
    }
    if high.makes_work {
        var beginning = Working(lowering)
        beginning.begin()
    }
    var entry_key = high.model.entry
    var object = lowering.make_object(entry_key)
    var code = lowering.constant(0)
    if high.entry {
        code = call_the_entry(lowering, object, high.entry)
    }
    if high.makes_work {
        var working = Working(lowering)
        working.drain()
    }
    if high.prompt {
        call_the_prompt(lowering, object, high.prompt)
    }
    if high.makes_work {
        var ending = Working(lowering)
        var lets_go_of_flights = high.in_flight_sites > 0
        ending.end(lets_go_of_flights)
    }
    var guards_debug_texts = layout.program.class_named("Spite.Debugging")
    if guards_debug_texts {
        var no_arguments = List<Integer>()
        var freed_guard = LowIntermediaryRepresentation.Instructions.Call(-1, "_debugging_end", no_arguments)
        lowering.emit(freed_guard)
    }
    if singleton_slots.count() > 0 {
        destroy_the_singletons(lowering)
    }
    if counts_memory {
        report_the_memory(lowering)
    }
    var exited = LowIntermediaryRepresentation.Instructions.Exit(code)
    lowering.emit(exited)
    program.lowered_functions.append(lowering.function)
}

func report_the_memory(lowering: FunctionLowering) {
    var allocations = count_at(lowering, program.allocation_count_label)
    var frees = count_at(lowering, program.free_count_label)
    var opening = lowering.text_label("allocations: ")
    var between = lowering.text_label(" frees: ")
    var closing = lowering.text_label("\n")
    var reported = LowIntermediaryRepresentation.Instructions.Stop(opening)
    reported.labels.append(opening)
    reported.labels.append(between)
    reported.labels.append(closing)
    reported.numbers.append(allocations)
    reported.numbers.append(frees)
    reported.signed_numbers.append(0)
    reported.signed_numbers.append(0)
    reported.continues = true
    lowering.emit(reported)
}

func count_at(lowering: FunctionLowering, label: Integer): Integer {
    var address = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(address, label)
    lowering.emit(addressed)
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, address, 0, 'bits_64')
    lowering.emit(loaded)
    return count
}

func listen_for_faults(lowering: FunctionLowering) {
    var handler = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(handler, "_fault_handler")
    lowering.emit(found)
    var first = lowering.constant(1)
    var adding = List<Integer>()
    adding.append(first)
    adding.append(handler)
    var added = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "AddVectoredExceptionHandler", adding)
    lowering.emit(added)
    var room = Buffer(0)
    room.append(0)
    room.append(0)
    room.append(1)
    room.append(0)
    room.append(0)
    room.append(0)
    room.append(0)
    room.append(0)
    var label = lowering.data_label(room)
    var guarantee = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(guarantee, label)
    lowering.emit(addressed)
    var guaranteeing = List<Integer>()
    guaranteeing.append(guarantee)
    var guaranteed = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "SetThreadStackGuarantee", guaranteeing)
    lowering.emit(guaranteed)
}

func lower_the_fault_handler() {
    var handling = FunctionLowering(layout, program, singleton_slots)
    handling.start("_fault_handler")
    var pointers = handling.new_register()
    handling.function.parameter_count = 1
    var record = handling.new_register()
    var loaded_record = LowIntermediaryRepresentation.Instructions.Load(record, pointers, 0, 'bits_64')
    handling.emit(loaded_record)
    var code = handling.new_register()
    var loaded_code = LowIntermediaryRepresentation.Instructions.Load(code, record, 0, 'bits_32')
    loaded_code.is_signed = false
    handling.emit(loaded_code)
    var reporting = handling.new_block()
    var passing = handling.new_block()
    var watched: List<Long> = [3221225477, 3221225725, 3221225501, 3221226356, 3221225620]
    var index = 0
    while index < watched.count() {
        var watched_code = watched[index]
        var wanted = handling.constant(watched_code)
        var matches = handling.new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', code, wanted)
        handling.emit(compared)
        var next = handling.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, reporting, next)
        handling.emit(test)
        handling.switch_to(next)
        index = index + 1
    }
    handling.jump_to(passing)
    handling.switch_to(passing)
    var continuing = handling.constant(0)
    var passed = LowIntermediaryRepresentation.Instructions.Return(continuing)
    handling.emit(passed)
    handling.switch_to(reporting)
    var address = handling.new_register()
    var loaded_address = LowIntermediaryRepresentation.Instructions.Load(address, record, 16, 'bits_64')
    handling.emit(loaded_address)
    var detail = handling.new_register()
    var loaded_detail = LowIntermediaryRepresentation.Instructions.Load(detail, record, 32, 'bits_64')
    handling.emit(loaded_detail)
    var accessed = handling.new_register()
    var loaded_accessed = LowIntermediaryRepresentation.Instructions.Load(accessed, record, 40, 'bits_64')
    handling.emit(loaded_accessed)
    var context = handling.new_register()
    var loaded_context = LowIntermediaryRepresentation.Instructions.Load(context, pointers, 8, 'bits_64')
    handling.emit(loaded_context)
    var frame = handling.new_register()
    var loaded_frame = LowIntermediaryRepresentation.Instructions.Load(frame, context, 160, 'bits_64')
    handling.emit(loaded_frame)
    var nobody = handling.constant(0)
    var arguments = List<Integer>()
    arguments.append(nobody)
    arguments.append(code)
    arguments.append(address)
    arguments.append(detail)
    arguments.append(accessed)
    arguments.append(frame)
    var reported = LowIntermediaryRepresentation.Instructions.Call(-1, "Spite.Fault.report", arguments)
    handling.emit(reported)
    var one = handling.constant(1)
    var exited = LowIntermediaryRepresentation.Instructions.Exit(one)
    handling.emit(exited)
    program.lowered_functions.append(handling.function)
}

func lower_the_site_texts() {
    var texts = FunctionLowering(layout, program, singleton_slots)
    texts.start("_foreign_site_text")
    var site = texts.new_register()
    texts.function.parameter_count = 1
    var index = 0
    while index < program.foreign_sites.count() {
        var written = program.foreign_sites[index]
        var number = texts.constant(index + 1)
        var matches = texts.new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', site, number)
        texts.emit(compared)
        var answering = texts.new_block()
        var next = texts.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        texts.emit(test)
        texts.switch_to(answering)
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(written)
        var text = texts.lower_text(constant_text)
        var answered = LowIntermediaryRepresentation.Instructions.Return(text.value)
        texts.emit(answered)
        texts.switch_to(next)
        index = index + 1
    }
    var empty = HighIntermediaryRepresentation.Values.TextConstant("foreign=?\tfrom=?")
    var nothing_known = texts.lower_text(empty)
    var answered_nothing = LowIntermediaryRepresentation.Instructions.Return(nothing_known.value)
    texts.emit(answered_nothing)
    program.lowered_functions.append(texts.function)
}

func destroy_the_singletons(lowering: FunctionLowering) {
    var head_label = lowering.made_singletons_label()
    var head = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(head, head_label)
    lowering.emit(addressed)
    var checking = lowering.new_block()
    var destroying = lowering.new_block()
    var done = lowering.new_block()
    lowering.jump_to(checking)
    lowering.switch_to(checking)
    var record = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(record, head, 0, 'bits_64')
    lowering.emit(loaded)
    var zero = lowering.constant(0)
    var empty = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(empty, 'equal', record, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(empty, done, destroying)
    lowering.emit(test)
    lowering.switch_to(destroying)
    var older = lowering.new_register()
    var loaded_older = LowIntermediaryRepresentation.Instructions.Load(older, record, 8, 'bits_64')
    lowering.emit(loaded_older)
    var popped = LowIntermediaryRepresentation.Instructions.Store(head, 0, older, 'bits_64')
    lowering.emit(popped)
    var object = lowering.new_register()
    var loaded_object = LowIntermediaryRepresentation.Instructions.Load(object, record, 0, 'bits_64')
    lowering.emit(loaded_object)
    var destroy = lowering.new_register()
    var loaded_destroy = LowIntermediaryRepresentation.Instructions.Load(destroy, record, 24, 'bits_64')
    lowering.emit(loaded_destroy)
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.CallAt(-1, destroy, arguments)
    lowering.emit(called)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(record, 0, zero, 'bits_64')
    lowering.emit(cleared)
    var destroyed = lowering.constant(3)
    var marked = LowIntermediaryRepresentation.Instructions.Store(record, 16, destroyed, 'bits_64')
    lowering.emit(marked)
    lowering.jump_to(checking)
    lowering.switch_to(done)
}

func call_the_prompt(lowering: FunctionLowering, entry_object: Integer, prompt: Model.FunctionModel) {
    var prompt_object = lowering.make_object(prompt.owner)
    var arguments = List<Integer>()
    arguments.append(prompt_object)
    arguments.append(entry_object)
    var prompt_key = prompt.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, prompt_key, arguments)
    lowering.emit(called)
    if high.makes_work {
        var working = Working(lowering)
        working.drain()
    }
}

func call_the_entry(lowering: FunctionLowering, object: Integer, entry: Model.FunctionModel): Integer {
    var arguments = List<Integer>()
    arguments.append(object)
    var code = lowering.constant(0)
    var target = -1
    if entry.answer {
        target = code
    }
    var entry_key_2 = entry.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, entry_key_2, arguments)
    lowering.emit(called)
    return code
}

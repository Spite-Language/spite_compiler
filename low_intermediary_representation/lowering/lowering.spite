var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var layout = HighIntermediaryRepresentation.Layout(no_program)
var program = LowIntermediaryRepresentation.LoweredProgram()
var singleton_slots = Dictionary<String, Integer>()
var waits: HighIntermediaryRepresentation.Waits? = null
var assignments: HighIntermediaryRepresentation.Assignments? = null
var trimmed_keys = List<String>()
var counts_memory = false
var taken: HighIntermediaryRepresentation.Ownership.TakenParameters? = null
var fresh_by_constructor = Dictionary<String, List<String>>()
var calls_of = Dictionary<String, Integer>()
var _access_violation_code: Long = 3221225477
var _stack_overflow_code: Long = 3221225725
var _illegal_instruction_code: Long = 3221225501
var _heap_corruption_code: Long = 3221226356
var _integer_divide_by_zero_code: Long = 3221225620
var _continue_searching = 0
var _frame_continues_the_search = 1
var _unwinding_flags = 6
var _foreign_slots_size = 16
var _check_point_room = 64
var _thread_storage_out_of_indexes: Long = 4294967295

func Lowering(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
    crash starting_high.layout
    layout = starting_high.layout
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func study_the_cycles() {
    var cycle_state = FunctionLoweringState()
    cycle_state.start_from(layout, program, singleton_slots)
    var cycle_lowering = FunctionLowering(cycle_state)
    var cycles = ClosingStores(layout, cycle_lowering)
    program.cycle_capable = cycles.study(high)
    fallback not program.cycle_capable.is_empty()
    var holders = UnreachedHolders(cycles, program.cycle_capable)
    holders.mark(high, program.hot_reload)
    program.collects_cycles = true
    if high.prompt or program.hot_reload {
        program.marks_suspects = true
    }
}

# ../../../spite_documentation/programs.md#preloaded-files
func read_the_preloaded_paths() {
    crash high.context
    var preloads = high.context.resolver.state.symbols.preloads
    fallback preloads.holds_a_volume()
    var table = Symbols.VolumeTable()
    table.read(preloads)
    program.preloaded_paths = table.paths
    program.preloaded_disk_paths = table.disk_paths
}

func lowered(): LowIntermediaryRepresentation.LoweredProgram {
    waits = high.waits
    assignments = high.assignments
    crash waits
    crash assignments
    trimmed_keys = high.trimmed_keys
    taken = high.taken_parameters
    fresh_by_constructor = high.fresh_by_constructor
    program.thread_counted_classes = high.thread_counted_classes
    program.lone_atomic_attributes = high.lone_atomic_attributes
    program.steady_singleton_attributes = high.steady_singleton_attributes
    program.split_parameter_keys = high.split_parameter_keys
    program.split_built_keys = high.split_built_keys
    program.static_singletons = high.static_singletons
    program.static_class_objects = high.static_class_objects
    program.counts_every_class_atomically = high.counts_every_class_atomically
    program.counts_alone_outside_the_work = high.counts_alone_outside_the_work
    note_the_deferred()
    crash high.context
    var inspection = CommandLine.Inspection()
    program.hot_reload = inspection.swaps(high.context.build_flags)
    if layout.program.class_named("Spite.Fault") {
        program.reports_faults = true
        var placeholder = Buffer()
        program.data.append(placeholder)
        program.place_table = program.data.count() - 1
        program.name_state(program.place_table, "table.places")
        program.foreign_slots = zeroed_room(_foreign_slots_size)
        program.name_state(program.foreign_slots, "foreign.slots")
        var call_placeholder = Buffer()
        program.data.append(call_placeholder)
        program.call_table = program.data.count() - 1
        program.name_state(program.call_table, "table.calls")
    }
    read_the_preloaded_paths()
    if counts_memory {
        program.fills_fresh_memory = true
    }
    if counts_memory or high.prompt or reads_the_live_memory() {
        program.counts_memory = true
        program.allocation_count_label = zeroed_count()
        program.name_state(program.allocation_count_label, "memory.allocations")
        program.free_count_label = zeroed_count()
        program.name_state(program.free_count_label, "memory.frees")
        program.live_list_label = zeroed_count()
        program.name_state(program.live_list_label, "memory.live")
        program.live_bytes_label = zeroed_count()
        program.name_state(program.live_bytes_label, "memory.live_bytes")
    }
    if high.reload_check_point {
        program.prompt_flag_label = zeroed_count()
        program.name_state(program.prompt_flag_label, "prompt.flag")
        program.prompt_sleeps = true
        program.prompt_objects_label = zeroed_room(_check_point_room)
        program.name_state(program.prompt_objects_label, "prompt.objects")
    }
    if high.reload_check_point {
        program.reload_check_point = high.reload_check_point.key()
    }
    study_the_cycles()
    write_the_whole_class_objects()
    high.built_functions.each(lower_function)
    lower_the_unguarded_bodies()
    lower_the_trimmed_defaults()
    if high.makes_work {
        write_the_work()
    }
    if program.uses_the_pool {
        var pool_writer_state = FunctionLoweringState()
        pool_writer_state.start_from(layout, program, singleton_slots)
        var pool_writer = FunctionLowering(pool_writer_state)
        var pooling = PoolWriting(pool_writer)
        pooling.write_the_pool()
    }
    if not program.deferred_keys.is_empty() {
        var deferred_writer_state = FunctionLoweringState()
        deferred_writer_state.start_from(layout, program, singleton_slots)
        var deferred_writer = FunctionLowering(deferred_writer_state)
        var deferring = DeferredWriting(deferred_writer)
        deferring.write_the_logs()
        copy_for_the_bands(deferring)
    }
    if program.uses_threads or high.makes_work {
        var gate_writer_state = FunctionLoweringState()
        gate_writer_state.start_from(layout, program, singleton_slots)
        var gate_writer = FunctionLowering(gate_writer_state)
        var gating = CrashGateWriting(gate_writer)
        gating.write_the_gate()
    }
    var guards_debug_texts = layout.program.class_named("Spite.Debugging")
    if guards_debug_texts {
        write_a_cycle_guard("Spite.Debugging", 1, "_debugging_end", "debug.guard")
    }
    var guards_comparisons = layout.program.class_named("Spite._PairsBeingCompared")
    if guards_comparisons {
        write_a_cycle_guard("Spite._PairsBeingCompared", 2, "_pairs_being_compared_end", "pairs_being_compared")
    }
    lower_the_start()
    check_the_handed_calls()
    var freeing = Freeing(high, layout, program, singleton_slots)
    freeing.lower_the_release()
    if program.reports_faults {
        lower_the_fault_handler()
        lower_the_site_texts()
    }
    note_the_steady_singletons()
    program.locked_singletons = waits.locked
    program.shared_classes = waits.shared_owners()
    high.quiet_singletons.each(note_a_quiet_singleton)
    if counts_memory {
        var report_writer_state = FunctionLoweringState()
        report_writer_state.start_from(layout, program, singleton_slots)
        var report_writer = FunctionLowering(report_writer_state)
        var leaks = LeakReportWriting(report_writer)
        leaks.write_the_report()
    }
    var alone_counts = AloneCounts(program)
    alone_counts.settle()
    return program
}

func check_the_handed_calls() {
    crash taken
    program.lowered_functions.each(count_the_handed_calls_in)
    var keys = taken.taken_keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var calls = calls_of[key]
        var handed = program.handed_calls[key]
        var made = 0
        if calls {
            made = calls
        }
        var given = 0
        if handed {
            given = handed
        }
        var hands_the_count_it_keeps = made == given
        crash hands_the_count_it_keeps
        index = index + 1
    }
}

func count_the_handed_calls_in(function: LowIntermediaryRepresentation.LowFunction) {
    crash taken
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
                instruction.hands_over = count_a_call(instruction.function)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_call(called: String): Boolean {
    crash taken
    var base = called
    if called.ends_with("$logged") {
        base = called.replace("$logged", "")
    }
    if base.ends_with("$unguarded") {
        base = base.replace("$unguarded", "")
    }
    fallback taken.takes_any(base)
    var known = calls_of[base]
    if known {
        calls_of[base] = known + 1
    } else {
        calls_of[base] = 1
    }
    return true
}

func note_a_quiet_singleton(class_key: String) {
    if singleton_slots.contains(class_key) {
        var label = singleton_slots[class_key]
        crash label
        program.quiet_singletons.append(label)
    }
}

func note_the_steady_singletons() {
    var classes = singleton_slots.keys()
    var forms = HighIntermediaryRepresentation.SingletonForms(high, classes)
    var index = 0
    while index < forms.steady.count() {
        var class_key = forms.steady[index]
        var label = singleton_slots[class_key]
        crash label
        program.steady_singletons.append(label)
        index = index + 1
    }
}

# ../../ARCHITECTURE.md#what-the-compiler-writes-itself
func write_a_cycle_guard(key: String, addresses: Integer, ending: String, state_name: String) {
    var guard_writer_state = FunctionLoweringState()
    guard_writer_state.start_from(layout, program, singleton_slots)
    var guard_writer = FunctionLowering(guard_writer_state)
    var guarding = CycleGuardWriting(guard_writer, key, addresses, ending, state_name)
    guarding.write_the_guard()
}

func write_the_work() {
    var writer_state = FunctionLoweringState()
    writer_state.start_from(layout, program, singleton_slots)
    var writer = FunctionLowering(writer_state)
    if high.in_flight_sites > 0 {
        var machine = MachineWriting(writer)
        program.in_flight_table = machine.zeroed_label(40)
        program.name_state(program.in_flight_table, "flights")
    }
    var scheduling = Scheduling(writer)
    scheduling.write_the_scheduler()
    var works = WorkWriting(writer)
    works.write_every_work()
    if high.in_flight_sites > 0 {
        works.write_let_go_of_every_flight()
    }
}

# ../../../spite_documentation/repl.md#the-wire-protocol
func reads_the_live_memory(): Boolean {
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        if key == "Program.live_allocations" or key == "Program.live_bytes" {
            return true
        }
        index = index + 1
    }
    return false
}

func zeroed_count(): Integer {
    return zeroed_room(8)
}

func zeroed_room(size: Integer): Integer {
    var room = Buffer()
    var index = 0
    while index < size {
        room.append(0)
        index = index + 1
    }
    program.data.append(room)
    var label = program.data.count() - 1
    program.name_state(label, "")
    return label
}

# ../../OPTIMIZATIONS.md#a-class-object-is-static-data
func write_the_whole_class_objects() {
    var writing_state = FunctionLoweringState()
    writing_state.start_from(layout, program, singleton_slots)
    var class_objects = StaticClassObjects(writing_state)
    class_objects.write_the_whole(high)
}

func lower_function(function: HighIntermediaryRepresentation.HighFunction) {
    var function_key = function.function.key()
    fallback not program.whole_class_object_fills.contains(function_key)
    var owner = high.model.class_named(function.function.owner)
    crash owner
    var lowering_state = FunctionLoweringState()
    lowering_state.start_from(layout, program, singleton_slots)
    var lowering = FunctionLowering(lowering_state)
    lowering.state.waits = waits
    lowering.state.assignments = assignments
    lowering.state.trimmed_keys = trimmed_keys
    lowering.state.makes_work = high.makes_work
    lowering.state.taken = taken
    lowering.state.fresh_by_constructor = fresh_by_constructor
    var made = lowering.lowered(function, owner.file.path)
    program.lowered_functions.append(made)
    var key = function.function.key()
    if lowering.is_resumable(key) {
        lower_a_step(function, owner.file.path, key)
    }
}

func lower_the_unguarded_bodies() {
    program.unguarded_keys.each(lower_an_unguarded_body)
}

func lower_an_unguarded_body(key: String) {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == key {
            lower_unguarded(function)
            return
        }
        index = index + 1
    }
    crash
}

func lower_unguarded(function: HighIntermediaryRepresentation.HighFunction) {
    var owner = high.model.class_named(function.function.owner)
    crash owner
    var lowering_state = FunctionLoweringState()
    lowering_state.start_from(layout, program, singleton_slots)
    var lowering = FunctionLowering(lowering_state)
    lowering.state.waits = waits
    lowering.state.assignments = assignments
    lowering.state.trimmed_keys = trimmed_keys
    lowering.state.makes_work = high.makes_work
    lowering.state.taken = taken
    lowering.state.fresh_by_constructor = fresh_by_constructor
    lowering.state.skips_the_lock = true
    var made = lowering.lowered(function, owner.file.path)
    program.lowered_functions.append(made)
}

func lower_the_trimmed_defaults() {
    var index = 0
    while index < high.trimmed_defaults.count() {
        var variant = high.trimmed_defaults[index]
        var constructor_key = high.trimmed_keys[index]
        crash constructor_key
        var owner = high.model.class_named(variant.function.owner)
        crash owner
        var lowering_state = FunctionLoweringState()
        lowering_state.start_from(layout, program, singleton_slots)
        var lowering = FunctionLowering(lowering_state)
        lowering.state.assignments = assignments
        lowering.state.taken = taken
        lowering.state.trimmed_keys = trimmed_keys
        lowering.state.fresh_by_constructor = fresh_by_constructor
        var made = lowering.lowered(variant, owner.file.path)
        made.key = "{constructor_key}$defaults"
        program.lowered_functions.append(made)
        index = index + 1
    }
}

func lower_a_step(function: HighIntermediaryRepresentation.HighFunction, source_path: String, key: String) {
    var stepping_state = FunctionLoweringState()
    stepping_state.start_from(layout, program, singleton_slots)
    var stepping = FunctionLowering(stepping_state)
    stepping.state.waits = waits
    stepping.state.assignments = assignments
    stepping.state.trimmed_keys = trimmed_keys
    stepping.state.makes_work = true
    stepping.state.taken = taken
    stepping.state.fresh_by_constructor = fresh_by_constructor
    stepping.state.resumable_mode = true
    var step = stepping.lowered(function, source_path)
    program.lowered_functions.append(step)
    var framing_state = FunctionLoweringState()
    framing_state.start_from(layout, program, singleton_slots)
    var framing = FunctionLowering(framing_state)
    var working = Working(framing)
    var frame = working.frame_function(step, key)
    program.lowered_functions.append(frame)
}

# ../../OPTIMIZATIONS.md#a-call-that-only-changes-a-singleton-waits-for-the-join
func note_the_deferred() {
    var index = 0
    while index < high.deferred_functions.count() {
        var function = high.deferred_functions[index]
        var key = function.key()
        if is_built(key) {
            program.deferred_keys.append(key)
            var arguments = function.parameters.count()
            program.deferred_argument_counts.append(arguments)
        }
        index = index + 1
    }
    fallback not program.deferred_keys.is_empty()
    program.deferred_slot = zeroed_count()
    program.name_state(program.deferred_slot, "deferred.slot")
}

func is_built(key: String): Boolean {
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        if built.function.key() == key {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-call-that-only-changes-a-singleton-waits-for-the-join
func copy_for_the_bands(deferring: DeferredWriting) {
    var copies = BandCopies(program)
    var by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
    var built_index = 0
    while built_index < high.built_functions.count() {
        var built = high.built_functions[built_index]
        var built_key = built.function.key()
        by_key[built_key] = built
        built_index = built_index + 1
    }
    var index = 0
    while index < copies.copied.count() {
        var name = copies.copied[index]
        if copies.is_deferred(name) {
            var original = lowered_named(name)
            deferring.write_a_logged_call(name, original.parameter_count)
        } else if name == "_deferred_replay" {
            deferring.write_the_logged_replay()
        } else {
            copy_for_a_band(name, by_key, copies.reaching)
        }
        index = index + 1
    }
}

func lowered_named(name: String): LowIntermediaryRepresentation.LowFunction {
    var index = 0
    while index < program.lowered_functions.count() {
        var function = program.lowered_functions[index]
        if function.key == name {
            return function
        }
        index = index + 1
    }
    crash
}

func copy_for_a_band(
    name: String,
    by_key: Dictionary<String, HighIntermediaryRepresentation.HighFunction>,
    reaching: Dictionary<String, Integer>,
) {
    var key = name
    var unguarded = name.ends_with("$unguarded")
    if unguarded {
        key = name.replace("$unguarded", "")
    }
    if key.ends_with("$defaults") {
        copy_the_defaults(key, reaching)
        return
    }
    var function = by_key[key]
    crash function
    var owner = high.model.class_named(function.function.owner)
    crash owner
    var lowering_state = FunctionLoweringState()
    lowering_state.start_from(layout, program, singleton_slots)
    var lowering = FunctionLowering(lowering_state)
    lowering.state.waits = waits
    lowering.state.assignments = assignments
    lowering.state.trimmed_keys = trimmed_keys
    lowering.state.makes_work = high.makes_work
    lowering.state.taken = taken
    lowering.state.fresh_by_constructor = fresh_by_constructor
    lowering.state.skips_the_lock = unguarded
    lowering.state.copies_for_the_bands = true
    lowering.state.logged_names = reaching
    var made = lowering.lowered(function, owner.file.path)
    program.lowered_functions.append(made)
}

func copy_the_defaults(name: String, reaching: Dictionary<String, Integer>) {
    var constructor_key = name.replace("$defaults", "")
    var index = trimmed_keys.index_of(constructor_key)
    crash index
    var variant = high.trimmed_defaults[index]
    crash variant
    var owner = high.model.class_named(variant.function.owner)
    crash owner
    var lowering_state = FunctionLoweringState()
    lowering_state.start_from(layout, program, singleton_slots)
    var lowering = FunctionLowering(lowering_state)
    lowering.state.assignments = assignments
    lowering.state.taken = taken
    lowering.state.trimmed_keys = trimmed_keys
    lowering.state.fresh_by_constructor = fresh_by_constructor
    lowering.state.copies_for_the_bands = true
    lowering.state.logged_names = reaching
    var made = lowering.lowered(variant, owner.file.path)
    made.key = "{name}$logged"
    program.lowered_functions.append(made)
}

func take_the_deferred_slot(lowering: FunctionLowering) {
    var machine = MachineWriting(lowering)
    var no_arguments = machine.none_listed()
    var slot = machine.imported("TlsAlloc", no_arguments)
    var label = machine.data_at(program.deferred_slot)
    machine.stored(label, 0, slot)
}

# ../../../spite_documentation/failure.md#a-fault-a-foreign-library-catches-itself
func take_the_foreign_slots(lowering: FunctionLowering) {
    var slots = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slots, program.foreign_slots)
    lowering.emit(addressed)
    take_a_foreign_slot(lowering, slots, 0)
    take_a_foreign_slot(lowering, slots, 8)
}

func take_a_foreign_slot(lowering: FunctionLowering, slots: Integer, offset: Integer) {
    var no_arguments = List<Integer>()
    var slot = lowering.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.ImportCall(slot, "TlsAlloc", no_arguments, "", 0)
    lowering.emit(allocated)
    var none_left = lowering.constant(_thread_storage_out_of_indexes)
    var failed = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(failed, 'equal', slot, none_left, true)
    lowering.emit(compared)
    var stopping = lowering.new_block()
    var taken = lowering.new_block()
    var tested = LowIntermediaryRepresentation.Instructions.Branch(failed, stopping, taken)
    lowering.emit(tested)
    lowering.switch_to(stopping)
    var label = lowering.text_label(
        "spite: the program stopped: the system had no thread slot left for the foreign-call site (TlsAlloc failed)\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label, false)
    lowering.emit(stopped)
    lowering.switch_to(taken)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slots, offset, slot, 'bits_64', "", false)
    lowering.emit(stored)
}

func lower_the_start() {
    var lowering_state = FunctionLoweringState()
    lowering_state.start_from(layout, program, singleton_slots)
    var lowering = FunctionLowering(lowering_state)
    var lowering_values = Values(lowering.state)
    var lowering_counting = Counting(lowering.state)
    lowering.state.taken = taken
    lowering.state.trimmed_keys = trimmed_keys
    lowering.state.fresh_by_constructor = fresh_by_constructor
    lowering.start("_start")
    note_the_program_thread(lowering)
    if program.reports_faults {
        listen_for_faults(lowering)
        take_the_foreign_slots(lowering)
    }
    if high.makes_work {
        var beginning = Working(lowering)
        beginning.begin()
    }
    if not program.deferred_keys.is_empty() {
        take_the_deferred_slot(lowering)
    }
    var class_objects = StaticClassObjects(lowering.state)
    class_objects.fill_them_all()
    if high.settings_check {
        check_the_settings(lowering, high.settings_check)
    }
    var entry_key = high.model.entry
    var object = lowering_values.make_object(entry_key)
    var prompt_object = -1
    if high.prompt {
        prompt_object = lowering_values.make_object(high.prompt.owner)
    }
    var reloader = -1
    if high.reload_start {
        reloader = start_the_reloader(lowering, object, high.reload_start)
    }
    var code = lowering.constant(0)
    if high.entry {
        code = call_the_entry(lowering, object, high.entry)
    }
    if high.makes_work {
        var working = Working(lowering)
        working.drain()
    }
    if high.prompt and high.prompt_runs_the_console {
        call_the_prompt(lowering, prompt_object, object, high.prompt)
    }
    if high.makes_work {
        var ending = Working(lowering)
        var lets_go_of_flights = high.in_flight_sites > 0
        ending.end(lets_go_of_flights)
    }
    if reloader >= 0 {
        lowering_counting.release(reloader)
    }
    lowering_counting.release(object)
    if program.hot_reload {
        var no_arguments = List<Integer>()
        var ended = LowIntermediaryRepresentation.Instructions.Call(-1, "_ends", no_arguments, -1, false)
        lowering.emit(ended)
        lower_the_ends()
    } else {
        end_the_pieces(lowering)
    }
    if counts_memory {
        report_the_memory(lowering)
    }
    var exited = LowIntermediaryRepresentation.Instructions.Exit(code)
    lowering.emit(exited)
    lowering.state.function.counts_alone = program.counts_alone_outside_the_work
    program.lowered_functions.append(lowering.state.function)
}

# ../../HOT_RELOAD.md#the-parts
func lower_the_ends() {
    var ends_state = FunctionLoweringState()
    ends_state.start_from(layout, program, singleton_slots)
    var ends = FunctionLowering(ends_state)
    ends.start("_ends")
    end_the_pieces(ends)
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1, -1, false)
    ends.emit(nothing)
    ends.state.function.counts_alone = program.counts_alone_outside_the_work
    program.lowered_functions.append(ends.state.function)
}

func end_the_pieces(lowering: FunctionLowering) {
    var guards_debug_texts = layout.program.class_named("Spite.Debugging")
    if guards_debug_texts {
        var no_arguments = List<Integer>()
        var freed_guard = LowIntermediaryRepresentation.Instructions.Call(-1, "_debugging_end", no_arguments, -1, false)
        lowering.emit(freed_guard)
    }
    var guards_comparisons = layout.program.class_named("Spite._PairsBeingCompared")
    if guards_comparisons {
        var none_given = List<Integer>()
        var freed_pairs = LowIntermediaryRepresentation.Instructions.Call(
            -1,
            "_pairs_being_compared_end",
            none_given,
            -1,
            false,
        )
        lowering.emit(freed_pairs)
    }
    collect_the_cycles(lowering)
    if singleton_slots.count() > 0 {
        destroy_the_singletons(lowering)
        collect_the_cycles(lowering)
    }
    if program.takes_callback_places {
        free_the_callback_table(lowering)
    }
}

func free_the_callback_table(lowering: FunctionLowering) {
    var lowering_singletons = Singletons(lowering.state)
    var label = lowering_singletons.record_label_of("_callback_table")
    var record = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(record, label)
    lowering.emit(addressed)
    var directory = lowering.new_register()
    var loaded_directory = LowIntermediaryRepresentation.Instructions.Load(
        directory,
        record,
        8,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded_directory)
    var blocks = lowering.new_register()
    var loaded_blocks = LowIntermediaryRepresentation.Instructions.Load(blocks, record, 16, 'bits_64', true, "", false)
    lowering.emit(loaded_blocks)
    var zero = lowering.constant(0)
    var one = lowering.constant(1)
    var eight = lowering.constant(8)
    var index = lowering.constant(0)
    var header = lowering.new_block()
    var body = lowering.new_block()
    var done = lowering.new_block()
    lowering.jump_to(header)
    lowering.switch_to(header)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'less', index, blocks, true)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, body, done)
    lowering.emit(test)
    lowering.switch_to(body)
    var offset = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(
        offset,
        'multiply',
        index,
        eight,
        'bits_64',
        true,
        false,
    )
    lowering.emit(multiplied)
    var address = lowering.address_plus(directory, offset)
    var block = lowering.new_register()
    var loaded_block = LowIntermediaryRepresentation.Instructions.Load(block, address, 0, 'bits_64', true, "", false)
    lowering.emit(loaded_block)
    var freed_block = LowIntermediaryRepresentation.Instructions.Free(block)
    lowering.emit(freed_block)
    var next = lowering.new_register()
    var added = LowIntermediaryRepresentation.Instructions.Arithmetic(next, 'add', index, one, 'bits_64', true, false)
    lowering.emit(added)
    var stepped = LowIntermediaryRepresentation.Instructions.Copy(index, next)
    lowering.emit(stepped)
    lowering.jump_to(header)
    lowering.switch_to(done)
    var freed_directory = LowIntermediaryRepresentation.Instructions.Free(directory)
    lowering.emit(freed_directory)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(record, 8, zero, 'bits_64', "", false)
    lowering.emit(cleared)
}

func report_the_memory(lowering: FunctionLowering) {
    var no_arguments = List<Integer>()
    var leaks_named = LowIntermediaryRepresentation.Instructions.Call(-1, "_leak_report", no_arguments, -1, false)
    lowering.emit(leaks_named)
    var allocations = count_at(lowering, program.allocation_count_label)
    var frees = count_at(lowering, program.free_count_label)
    var opening = lowering.text_label("allocations: ")
    var between = lowering.text_label(" frees: ")
    var closing = lowering.text_label("\n")
    var reported = LowIntermediaryRepresentation.Instructions.Stop(opening, true)
    reported.labels.append(opening)
    reported.labels.append(between)
    reported.labels.append(closing)
    reported.numbers.append(allocations)
    reported.numbers.append(frees)
    reported.signed_numbers.append(0)
    reported.signed_numbers.append(0)
    lowering.emit(reported)
}

func count_at(lowering: FunctionLowering, label: Integer): Integer {
    var address = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(address, label)
    lowering.emit(addressed)
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, address, 0, 'bits_64', true, "", false)
    lowering.emit(loaded)
    return count
}

func listen_for_faults(lowering: FunctionLowering) {
    var handler = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.FunctionAddress(handler, "_fault_handler")
    lowering.emit(found)
    var first = lowering.constant(1)
    var adding = List<Integer>()
    adding.append(first)
    adding.append(handler)
    var added = LowIntermediaryRepresentation.Instructions.ImportCall(-1, "AddVectoredExceptionHandler", adding, "", 0)
    lowering.emit(added)
    var filter = lowering.new_register()
    var found_filter = LowIntermediaryRepresentation.Instructions.FunctionAddress(filter, "_unhandled_fault")
    lowering.emit(found_filter)
    var filtering = List<Integer>()
    filtering.append(filter)
    var filtered = LowIntermediaryRepresentation.Instructions.ImportCall(
        -1,
        "SetUnhandledExceptionFilter",
        filtering,
        "",
        0,
    )
    lowering.emit(filtered)
    var room = Buffer()
    room.append(0)
    room.append(0)
    room.append(1)
    room.append(0)
    room.append(0)
    room.append(0)
    room.append(0)
    room.append(0)
    var label = lowering.data_label(room)
    var guarantee = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(guarantee, label)
    lowering.emit(addressed)
    var guaranteeing = List<Integer>()
    guaranteeing.append(guarantee)
    var guaranteed = LowIntermediaryRepresentation.Instructions.ImportCall(
        -1,
        "SetThreadStackGuarantee",
        guaranteeing,
        "",
        0,
    )
    lowering.emit(guaranteed)
}


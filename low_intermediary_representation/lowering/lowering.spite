func lower_the_fault_handler() {
    var report_writer_state = FunctionLoweringState()
    report_writer_state.start_from(layout, program, singleton_slots)
    var report_writer = FunctionLowering(report_writer_state)
    var reporting = FaultReportWriting(report_writer)
    reporting.write_the_report()
    lower_the_vectored_handler()
    lower_the_frame_handler()
    lower_the_unhandled_fault()
}

func fault_handling(key: String): FunctionLowering {
    var handling_state = FunctionLoweringState()
    handling_state.start_from(layout, program, singleton_slots)
    var handling = FunctionLowering(handling_state)
    handling.start(key)
    return handling
}

func parameters_of(handling: FunctionLowering, count: Integer): List<Integer> {
    var registers = List<Integer>()
    var index = 0
    while index < count {
        var register = handling.new_register()
        registers.append(register)
        index = index + 1
    }
    handling.state.function.parameter_count = count
    return registers
}

func loaded_at(handling: FunctionLowering, base: Integer, offset: Integer): Integer {
    var value = handling.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, base, offset, 'bits_64', true, "", false)
    handling.emit(loaded)
    return value
}

func code_of(handling: FunctionLowering, record: Integer): Integer {
    var code = handling.new_register()
    var loaded_code = LowIntermediaryRepresentation.Instructions.Load(code, record, 0, 'bits_32', false, "", false)
    handling.emit(loaded_code)
    return code
}

func answer(handling: FunctionLowering, value: Integer) {
    var answered = handling.constant(value)
    var returned = LowIntermediaryRepresentation.Instructions.Return(answered, -1, false)
    handling.emit(returned)
}

func branch_on_the_watched_codes(handling: FunctionLowering, code: Integer, watching: Integer, passing: Integer) {
    var watched: List<Long> = [
        _access_violation_code
        _stack_overflow_code
        _illegal_instruction_code
        _heap_corruption_code
        _integer_divide_by_zero_code
    ]
    var index = 0
    while index < watched.count() {
        var watched_code = watched[index]
        var wanted = handling.constant(watched_code)
        var matches = handling.new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', code, wanted, true)
        handling.emit(compared)
        var next = handling.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, watching, next)
        handling.emit(test)
        handling.switch_to(next)
        index = index + 1
    }
    handling.jump_to(passing)
}

func report_the_fault(handling: FunctionLowering, record: Integer, context: Integer) {
    var arguments = List<Integer>()
    arguments.append(record)
    arguments.append(context)
    var reported = LowIntermediaryRepresentation.Instructions.Call(-1, "_report_the_fault", arguments, -1, false)
    handling.emit(reported)
    var one = handling.constant(1)
    var exited = LowIntermediaryRepresentation.Instructions.Exit(one)
    handling.emit(exited)
}

func lower_the_vectored_handler() {
    var handling = fault_handling("_fault_handler")
    var parameters = parameters_of(handling, 1)
    var pointers = parameters[0]
    crash pointers
    var record = loaded_at(handling, pointers, 0)
    var code = code_of(handling, record)
    var watching = handling.new_block()
    var reporting = handling.new_block()
    var passing = handling.new_block()
    branch_on_the_watched_codes(handling, code, watching, passing)
    handling.switch_to(passing)
    answer(handling, _continue_searching)
    handling.switch_to(watching)
    if program.hot_reload or program.foreign_sites.is_empty() {
        handling.jump_to(reporting)
    } else {
        pass_what_a_foreign_call_raised(handling, record, code, reporting, passing)
    }
    handling.switch_to(reporting)
    var context = loaded_at(handling, pointers, 8)
    report_the_fault(handling, record, context)
    program.lowered_functions.append(handling.state.function)
}

func pass_what_a_foreign_call_raised(
    handling: FunctionLowering,
    record: Integer,
    code: Integer,
    reporting: Integer,
    passing: Integer,
) {
    var heap = handling.constant(_heap_corruption_code)
    var is_heap = handling.new_register()
    var compared_heap = LowIntermediaryRepresentation.Instructions.Compare(is_heap, 'equal', code, heap, true)
    handling.emit(compared_heap)
    var checking_the_call = handling.new_block()
    var tested_heap = LowIntermediaryRepresentation.Instructions.Branch(is_heap, reporting, checking_the_call)
    handling.emit(tested_heap)
    handling.switch_to(checking_the_call)
    var site = foreign_site_keeping_the_error(handling)
    var zero = handling.constant(0)
    var no_call = handling.new_register()
    var compared_site = LowIntermediaryRepresentation.Instructions.Compare(no_call, 'equal', site, zero, true)
    handling.emit(compared_site)
    var checking_the_start = handling.new_block()
    var tested_site = LowIntermediaryRepresentation.Instructions.Branch(no_call, reporting, checking_the_start)
    handling.emit(tested_site)
    handling.switch_to(checking_the_start)
    var address = loaded_at(handling, record, 16)
    var asking = List<Integer>()
    asking.append(zero)
    var own_start = handling.new_register()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(own_start, "GetModuleHandleA", asking, "", 0)
    handling.emit(asked)
    var below = handling.new_register()
    var compared_start = LowIntermediaryRepresentation.Instructions.Compare(below, 'less', address, own_start, false)
    handling.emit(compared_start)
    var checking_the_end = handling.new_block()
    var tested_start = LowIntermediaryRepresentation.Instructions.Branch(below, passing, checking_the_end)
    handling.emit(tested_start)
    handling.switch_to(checking_the_end)
    var own_end = handling.new_register()
    var addressed_end = LowIntermediaryRepresentation.Instructions.DataAddress(own_end, program.place_table)
    handling.emit(addressed_end)
    var inside = handling.new_register()
    var compared_end = LowIntermediaryRepresentation.Instructions.Compare(inside, 'less', address, own_end, false)
    handling.emit(compared_end)
    var tested_end = LowIntermediaryRepresentation.Instructions.Branch(inside, reporting, passing)
    handling.emit(tested_end)
}

# ../../../spite_documentation/failure.md#a-fault-a-foreign-library-catches-itself
func foreign_site_keeping_the_error(handling: FunctionLowering): Integer {
    var handling_calls = Calls(handling.state)
    var kept_error = handling_calls.kept_last_error()
    var site = handling_calls.foreign_slot_value(0)
    handling_calls.restore_last_error(kept_error)
    return site
}

func lower_the_frame_handler() {
    var handling = fault_handling("_frame_handler")
    var parameters = parameters_of(handling, 4)
    var record = parameters[0]
    var context = parameters[2]
    crash record
    crash context
    var flags = handling.new_register()
    var loaded_flags = LowIntermediaryRepresentation.Instructions.Load(flags, record, 4, 'bits_32', false, "", false)
    handling.emit(loaded_flags)
    var unwinding_flags = handling.constant(_unwinding_flags)
    var unwinding = handling.new_register()
    var masked = LowIntermediaryRepresentation.Instructions.Arithmetic(
        unwinding,
        'bits_and',
        flags,
        unwinding_flags,
        'bits_64',
        false,
        false,
    )
    handling.emit(masked)
    var zero = handling.constant(0)
    var is_unwinding = handling.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_unwinding, 'not_equal', unwinding, zero, true)
    handling.emit(compared)
    var reporting = handling.new_block()
    var dispatching = handling.new_block()
    var continuing = handling.new_block()
    var tested = LowIntermediaryRepresentation.Instructions.Branch(is_unwinding, reporting, dispatching)
    handling.emit(tested)
    handling.switch_to(dispatching)
    var code = code_of(handling, record)
    branch_on_the_watched_codes(handling, code, reporting, continuing)
    handling.switch_to(continuing)
    answer(handling, _frame_continues_the_search)
    handling.switch_to(reporting)
    report_the_fault(handling, record, context)
    program.lowered_functions.append(handling.state.function)
}

func lower_the_unhandled_fault() {
    var handling = fault_handling("_unhandled_fault")
    var parameters = parameters_of(handling, 1)
    var pointers = parameters[0]
    crash pointers
    var record = loaded_at(handling, pointers, 0)
    var code = code_of(handling, record)
    var reporting = handling.new_block()
    var passing = handling.new_block()
    branch_on_the_watched_codes(handling, code, reporting, passing)
    handling.switch_to(passing)
    answer(handling, _continue_searching)
    handling.switch_to(reporting)
    var context = loaded_at(handling, pointers, 8)
    report_the_fault(handling, record, context)
    program.lowered_functions.append(handling.state.function)
}

func lower_the_site_texts() {
    var texts_state = FunctionLoweringState()
    texts_state.start_from(layout, program, singleton_slots)
    var texts = FunctionLowering(texts_state)
    var texts_values = Values(texts.state)
    texts.start("_foreign_site_text")
    var site = texts.new_register()
    texts.state.function.parameter_count = 1
    var index = 0
    while index < program.foreign_sites.count() {
        var written = program.foreign_sites[index]
        var site_number = program.foreign_site_numbers[index]
        crash site_number
        var number = texts.constant(site_number)
        var matches = texts.new_register()
        var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', site, number, true)
        texts.emit(compared)
        var answering = texts.new_block()
        var next = texts.new_block()
        var test = LowIntermediaryRepresentation.Instructions.Branch(matches, answering, next)
        texts.emit(test)
        texts.switch_to(answering)
        var value_type = Model.Type('object', "String")
        var constant_text = HighIntermediaryRepresentation.Values.TextConstant(written, value_type, false)
        var text = texts_values.lower_text(constant_text)
        var answered = LowIntermediaryRepresentation.Instructions.Return(text.value, -1, false)
        texts.emit(answered)
        texts.switch_to(next)
        index = index + 1
    }
    var empty_value_type = Model.Type('object', "String")
    var empty = HighIntermediaryRepresentation.Values.TextConstant("foreign=?\tfrom=?", empty_value_type, false)
    var nothing_known = texts_values.lower_text(empty)
    var answered_nothing = LowIntermediaryRepresentation.Instructions.Return(nothing_known.value, -1, false)
    texts.emit(answered_nothing)
    program.lowered_functions.append(texts.state.function)
}

func destroy_the_singletons(lowering: FunctionLowering) {
    var lowering_singletons = Singletons(lowering.state)
    var head_label = lowering_singletons.made_singletons_label()
    var head = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(head, head_label)
    lowering.emit(addressed)
    var checking = lowering.new_block()
    var destroying = lowering.new_block()
    var done = lowering.new_block()
    lowering.jump_to(checking)
    lowering.switch_to(checking)
    var record = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(record, head, 0, 'bits_64', true, "", false)
    lowering.emit(loaded)
    var zero = lowering.constant(0)
    var empty = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(empty, 'equal', record, zero, true)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(empty, done, destroying)
    lowering.emit(test)
    lowering.switch_to(destroying)
    var older = lowering.new_register()
    var loaded_older = LowIntermediaryRepresentation.Instructions.Load(older, record, 8, 'bits_64', true, "", false)
    lowering.emit(loaded_older)
    var popped = LowIntermediaryRepresentation.Instructions.Store(head, 0, older, 'bits_64', "", false)
    lowering.emit(popped)
    var object = lowering.new_register()
    var loaded_object = LowIntermediaryRepresentation.Instructions.Load(object, record, 0, 'bits_64', true, "", false)
    lowering.emit(loaded_object)
    var destroy = lowering.new_register()
    var loaded_destroy = LowIntermediaryRepresentation.Instructions.Load(
        destroy,
        record,
        24,
        'bits_64',
        true,
        "",
        false,
    )
    lowering.emit(loaded_destroy)
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.CallAt(-1, destroy, arguments, false, -1, 0)
    lowering.emit(called)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(record, 0, zero, 'bits_64', "", false)
    lowering.emit(cleared)
    var destroyed = lowering.constant(3)
    var marked = LowIntermediaryRepresentation.Instructions.Store(record, 16, destroyed, 'bits_64', "", false)
    lowering.emit(marked)
    lowering.jump_to(checking)
    lowering.switch_to(done)
}

# ../../../spite_documentation/repl.md#how-it-works
func start_the_reloader(lowering: FunctionLowering, entry_object: Integer, starting: Model.FunctionModel): Integer {
    var lowering_values = Values(lowering.state)
    var reloader = lowering_values.make_object(starting.owner)
    var objects = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(objects, program.prompt_objects_label)
    lowering.emit(addressed)
    var kept_entry = LowIntermediaryRepresentation.Instructions.Store(objects, 8, entry_object, 'bits_64', "", false)
    lowering.emit(kept_entry)
    var kept_reloader = LowIntermediaryRepresentation.Instructions.Store(objects, 24, reloader, 'bits_64', "", false)
    lowering.emit(kept_reloader)
    var waits = PromptWaits(lowering)
    waits.keep_the_main_thread(lowering, objects)
    var arguments = List<Integer>()
    arguments.append(reloader)
    if not starting.parameters.is_empty() {
        arguments.append(entry_object)
    }
    var starting_key = starting.key()
    var started_watching = LowIntermediaryRepresentation.Instructions.Call(-1, starting_key, arguments, -1, false)
    lowering.emit(started_watching)
    waits.start_the_sleep(lowering)
    write_the_alarm()
    var no_block = lowering.constant(0)
    var thread = lowering.new_register()
    var started = LowIntermediaryRepresentation.Instructions.StartThread(thread, "_prompt_alarm", no_block)
    lowering.emit(started)
    return reloader
}

# ../../../spite_documentation/repl.md#remote---repl-port
func write_the_alarm() {
    var writer_state = FunctionLoweringState()
    writer_state.start_from(layout, program, singleton_slots)
    var writer = FunctionLowering(writer_state)
    var machine = MachineWriting(writer)
    machine.begin("_prompt_alarm", 1)
    var top = machine.loop_top()
    var objects = machine.data_at(program.prompt_objects_label)
    var stopping = machine.loaded(objects, 16)
    var goes_on = machine.is_zero(stopping)
    var done = machine.loop_while(goes_on)
    var pause = machine.constant_of(25)
    var pausing = machine.one_listed(pause)
    machine.call_imported("Sleep", pausing)
    var flag = machine.data_at(program.prompt_flag_label)
    machine.stored_number(flag, 0, 1)
    if program.prompt_sleeps {
        var event = machine.loaded(objects, 40)
        var waking = machine.one_listed(event)
        machine.call_imported("SetEvent", waking)
    }
    machine.loop_back(top, done)
    var nothing = machine.constant_of(0)
    machine.answered(nothing)
    machine.finish()
}

func call_the_prompt(
    lowering: FunctionLowering,
    prompt_object: Integer,
    entry_object: Integer,
    prompt: Model.FunctionModel,
) {
    var lowering_counting = Counting(lowering.state)
    var arguments = List<Integer>()
    arguments.append(prompt_object)
    if not prompt.parameters.is_empty() {
        arguments.append(entry_object)
    }
    var prompt_key = prompt.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, prompt_key, arguments, -1, false)
    lowering.emit(called)
    if high.makes_work {
        var working = Working(lowering)
        working.drain()
    }
    lowering_counting.release(prompt_object)
}

# ../../../spite_documentation/programs.md#run-time-settings-environment
func check_the_settings(lowering: FunctionLowering, check: Model.FunctionModel) {
    var nobody = lowering.constant(0)
    var arguments = List<Integer>()
    arguments.append(nobody)
    var check_key = check.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, check_key, arguments, -1, false)
    lowering.emit(called)
}

func call_the_entry(lowering: FunctionLowering, object: Integer, entry: Model.FunctionModel): Integer {
    var arguments = List<Integer>()
    arguments.append(object)
    var code = lowering.constant(0)
    var target = -1
    if entry.answer {
        target = code
    }
    var entry_key_2 = entry.key()
    var called = LowIntermediaryRepresentation.Instructions.Call(target, entry_key_2, arguments, -1, false)
    lowering.emit(called)
    return code
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func collect_the_cycles(lowering: FunctionLowering) {
    fallback program.collects_cycles and program.marks_suspects and frees_cycles_at_the_end()
    var nothing_passed = List<Integer>()
    var collected = LowIntermediaryRepresentation.Instructions.Call(
        -1,
        "_cycle_collect_at_exit",
        nothing_passed,
        -1,
        false,
    )
    lowering.emit(collected)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func note_the_program_thread(lowering: FunctionLowering) {
    fallback program.collects_cycles and program.marks_suspects and program.enters_the_cycles
    var nothing_passed = List<Integer>()
    var noted = LowIntermediaryRepresentation.Instructions.Call(
        -1,
        "_cycle_note_the_program_thread",
        nothing_passed,
        -1,
        false,
    )
    lowering.emit(noted)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func frees_cycles_at_the_end(): Boolean {
    if program.counts_memory or program.hot_reload {
        return true
    }
    var keys = program.cycle_capable.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var class_model = layout.program.class_named(key)
        if class_model {
            var dropping = class_model.function_named("drop")
            if dropping {
                return true
            }
        }
        index = index + 1
    }
    return false
}

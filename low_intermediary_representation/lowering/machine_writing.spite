var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var writing = FunctionLowering(no_layout, no_low, no_slots)
var layout: HighIntermediaryRepresentation.Layout = no_layout
var program: LowIntermediaryRepresentation.LoweredProgram = no_low
var slots: Dictionary<String, Integer> = no_slots

func MachineWriting(starting_lowering: FunctionLowering) {
    writing = starting_lowering
    layout = starting_lowering.layout
    program = starting_lowering.program
    slots = starting_lowering.singleton_slots
}

func is_written(key: String): Boolean {
    return program.machine_keys.contains(key)
}

func begin(key: String, parameter_count: Integer) {
    program.machine_keys.append(key)
    writing = FunctionLowering(layout, program, slots)
    writing.start(key)
    writing.function.parameter_count = parameter_count
    writing.reserve_registers(parameter_count)
}

func finish() {
    program.lowered_functions.append(writing.function)
}

func constant_of(value: Long): Integer {
    return writing.constant(value)
}

func variable(value: Long): Integer {
    var start = constant_of(value)
    return kept(start)
}

func loaded(address: Integer, offset: Integer): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Load(target, address, offset, 'bits_64')
    writing.emit(made)
    return target
}

func stored(address: Integer, offset: Integer, value: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.Store(address, offset, value, 'bits_64')
    writing.emit(made)
}

func stored_number(address: Integer, offset: Integer, value: Long) {
    var register = constant_of(value)
    stored(address, offset, register)
}

func arithmetic(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator, left: Integer, right: Integer): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    made.is_checked = false
    writing.emit(made)
    return target
}

func sum_of(left: Integer, right: Integer): Integer {
    return arithmetic('add', left, right)
}

func difference_of(left: Integer, right: Integer): Integer {
    return arithmetic('subtract', left, right)
}

func product_of(left: Integer, right: Integer): Integer {
    return arithmetic('multiply', left, right)
}

func quotient_of(left: Integer, right: Integer): Integer {
    return arithmetic('divide', left, right)
}

func remainder_of(left: Integer, right: Integer): Integer {
    return arithmetic('remainder', left, right)
}

func plus_number(value: Integer, amount: Long): Integer {
    var register = constant_of(amount)
    return sum_of(value, register)
}

func step_by(target: Integer, amount: Long) {
    var register = constant_of(amount)
    var made = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'add', target, register)
    made.is_checked = false
    writing.emit(made)
}

func compared(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison, left: Integer, right: Integer): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Compare(target, comparison, left, right)
    writing.emit(made)
    return target
}

func compared_to(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison, left: Integer, right: Long): Integer {
    var register = constant_of(right)
    return compared(comparison, left, register)
}

func is_zero(value: Integer): Integer {
    return compared_to('equal', value, 0)
}

func copied(target: Integer, source: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.Copy(target, source)
    writing.emit(made)
}

func kept(source: Integer): Integer {
    var target = writing.new_register()
    copied(target, source)
    return target
}

func called(key: String, arguments: List<Integer>): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Call(target, key, arguments)
    writing.emit(made)
    return target
}

func called_for_nothing(key: String, arguments: List<Integer>) {
    var made = LowIntermediaryRepresentation.Instructions.Call(-1, key, arguments)
    writing.emit(made)
}

func called_at(address: Integer, arguments: List<Integer>): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.CallAt(target, address, arguments)
    writing.emit(made)
    return target
}

func both(left: Integer, right: Integer): Integer {
    return arithmetic('bits_and', left, right)
}

func either(left: Integer, right: Integer): Integer {
    return arithmetic('bits_or', left, right)
}

func joined_thread(thread: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.JoinThread(thread)
    writing.emit(made)
}

func imported(name: String, arguments: List<Integer>): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.ImportCall(target, name, arguments)
    writing.emit(made)
    return target
}

func call_imported(name: String, arguments: List<Integer>) {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.ImportCall(target, name, arguments)
    writing.emit(made)
}

func answered(value: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.Return(value)
    writing.emit(made)
}

func answered_with(value: Integer, presence: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.Return(value)
    made.presence = presence
    writing.emit(made)
}

func answered_nothing() {
    var made = LowIntermediaryRepresentation.Instructions.Return(-1)
    writing.emit(made)
}

func opened_when(condition: Integer): Integer {
    var yes = writing.new_block()
    var after = writing.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition, yes, after)
    writing.emit(test)
    writing.switch_to(yes)
    return after
}

func opened_unless(condition: Integer): Integer {
    var yes = writing.new_block()
    var after = writing.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition, after, yes)
    writing.emit(test)
    writing.switch_to(yes)
    return after
}

func closed(after: Integer) {
    writing.jump_to(after)
    writing.switch_to(after)
}

func loop_top(): Integer {
    var top = writing.new_block()
    writing.jump_to(top)
    writing.switch_to(top)
    return top
}

func loop_while(condition: Integer): Integer {
    var body = writing.new_block()
    var done = writing.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(condition, body, done)
    writing.emit(test)
    writing.switch_to(body)
    return done
}

func loop_back(top: Integer, done: Integer) {
    writing.jump_to(top)
    writing.switch_to(done)
}

func none_listed(): List<Integer> {
    return List<Integer>()
}

func one_listed(first_register: Integer): List<Integer> {
    var made = List<Integer>()
    made.append(first_register)
    return made
}

func two_listed(first_register: Integer, second_register: Integer): List<Integer> {
    var made = one_listed(first_register)
    made.append(second_register)
    return made
}

func three_listed(first_register: Integer, second_register: Integer, third_register: Integer): List<Integer> {
    var made = two_listed(first_register, second_register)
    made.append(third_register)
    return made
}

func data_at(label: Integer): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.DataAddress(target, label)
    writing.emit(made)
    return target
}

func zeroed_label(size: Integer): Integer {
    var bytes = Buffer(0)
    var index = 0
    while index < size {
        bytes.append(0)
        index = index + 1
    }
    var label = writing.data_label(bytes)
    writing.program.name_state(label, "")
    return label
}

func thread_now(): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.ThreadIdentity(target)
    writing.emit(made)
    return target
}

func allocated(size: Integer): Integer {
    var size_register = constant_of(size)
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Allocate(target, size_register)
    writing.emit(made)
    return target
}

func freed(address: Integer) {
    var made = LowIntermediaryRepresentation.Instructions.Free(address)
    writing.emit(made)
}

func room(size: Integer): Integer {
    var target = writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.FrameRoom(target, size)
    writing.emit(made)
    return target
}

func written_to_the_errors(text: String) {
    var which = constant_of(-12)
    var asked = one_listed(which)
    var errors = imported("GetStdHandle", asked)
    var bytes = text.to_buffer()
    var length = bytes.count()
    var label = writing.text_label(text)
    var address = data_at(label)
    var length_register = constant_of(length)
    var counted = room(8)
    var nothing = constant_of(0)
    var arguments = three_listed(errors, address, length_register)
    arguments.append(counted)
    arguments.append(nothing)
    call_imported("WriteFile", arguments)
}

func halted(text: String) {
    written_to_the_errors(text)
    var walks = layout.program.class_named("Spite.Fault")
    if walks and program.call_table >= 0 {
        var nobody = constant_of(0)
        var passed = one_listed(nobody)
        called_for_nothing("Spite.Fault.frames", passed)
    }
    var failure = constant_of(1)
    var exited = LowIntermediaryRepresentation.Instructions.Exit(failure)
    writing.emit(exited)
}

var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)

func Intrinsics(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func lowered(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var key = call.function.key()
    var prompt = PromptIntrinsics(lowering)
    if prompt.is_one(call) {
        return prompt.lowered(call)
    }
    switch key {
        "Buffer._resize_room": return resize_room(call)
        "DynamicLibrary.open_library": return open_library(call)
        "DynamicLibrary.close_library": return close_library(call)
        _: return typed_access(call, key)
    }
}

func stepped(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var frame_value = call.arguments[0]
    crash frame_value
    var frame = lowering.lower_value(frame_value)
    var address = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(address, frame.value, 32, 'bits_64')
    lowering.emit(loaded)
    var arguments = List<Integer>()
    arguments.append(frame.value)
    var done = lowering.new_register()
    var called = LowIntermediaryRepresentation.Instructions.CallAt(done, address, arguments)
    lowering.emit(called)
    return lowering.single(done)
}

func frame_result(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var frame_value = call.arguments[0]
    crash frame_value
    var frame = lowering.lower_value(frame_value)
    var value = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, frame.value, 16, 'bits_64')
    lowering.emit(loaded)
    var presence = -1
    if lowering.is_a_nullable_scalar(call.value_type) {
        presence = lowering.new_register()
        var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(presence, frame.value, 24, 'bits_64')
        lowering.emit(loaded_presence)
    }
    var made = Lowered(value, presence)
    made.owned = lowering.is_a_pointer(call.value_type)
    return made
}

func joined_thread(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var frame_value = call.arguments[0]
    crash frame_value
    var frame = lowering.lower_value(frame_value)
    var thread = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(thread, frame.value, 32, 'bits_64')
    lowering.emit(loaded)
    var joining = LowIntermediaryRepresentation.Instructions.JoinThread(thread)
    lowering.emit(joining)
    return Lowered(-1, -1)
}

func frame_done(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var frame_value = call.arguments[0]
    crash frame_value
    var frame = lowering.lower_value(frame_value)
    var done = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(done, frame.value, 8, 'bits_64')
    lowering.emit(loaded)
    return lowering.single(done)
}

func foreign_slot_read(offset: Integer): Lowered {
    var slot = lowering.foreign_slot()
    var value = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, slot, offset, 'bits_64')
    lowering.emit(loaded)
    if offset == 8 {
        lowering.retain(value)
        return lowering.owned(value)
    }
    return lowering.single(value)
}

func foreign_site_text(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var site_value = call.arguments[0]
    crash site_value
    var site = lowering.lower_value(site_value)
    var arguments = List<Integer>()
    arguments.append(site.value)
    var text = lowering.new_register()
    var called = LowIntermediaryRepresentation.Instructions.Call(text, "_foreign_site_text", arguments)
    lowering.emit(called)
    return lowering.owned(text)
}

func place_table(): Lowered {
    var address = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.DataAddress(address, lowering.program.place_table)
    lowering.emit(found)
    return lowering.single(address)
}

func call_table(): Lowered {
    var address = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.DataAddress(address, lowering.program.call_table)
    lowering.emit(found)
    return lowering.single(address)
}

func frame_pointer(): Lowered {
    var address = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.FrameAddress(address)
    lowering.emit(found)
    return lowering.single(address)
}

func read_memory(
    call: HighIntermediaryRepresentation.Values.Call,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
): Lowered {
    var address_value = call.arguments[0]
    crash address_value
    var address = lowering.lower_value(address_value)
    var value = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, address.value, 0, width)
    loaded.is_signed = false
    lowering.emit(loaded)
    return lowering.single(value)
}

func held_once(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var object = lowering.lower_value(call.receiver)
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, object.value, 8, 'bits_64')
    lowering.emit(loaded)
    var one = lowering.constant(1)
    var once = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(once, 'equal', count, one)
    lowering.emit(compared)
    return lowering.single(once)
}

# ../../OPTIMIZATIONS.md#a-loop-whose-passes-write-only-their-own-item-runs-in-bands
func item_held_once(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var address = item_address(call, element)
    var object = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, address, 0, 'bits_64')
    lowering.emit(loaded)
    var count = lowering.new_register()
    var loaded_count = LowIntermediaryRepresentation.Instructions.Load(count, object, 8, 'bits_64')
    lowering.emit(loaded_count)
    var one = lowering.constant(1)
    var once = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(once, 'equal', count, one)
    lowering.emit(compared)
    return lowering.single(once)
}

# ../../../spite_spec/specs/repl.md#command-language
func live_allocations(): Lowered {
    var made = counted_at(lowering.program.allocation_count_label)
    var freed = counted_at(lowering.program.free_count_label)
    var live = lowering.new_register()
    var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(live, 'subtract', made.value, freed.value)
    subtracted.is_checked = false
    subtracted.wraps = true
    lowering.emit(subtracted)
    return lowering.single(live)
}

func counted_at(label: Integer): Lowered {
    crash label >= 0
    var place = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(place, label)
    lowering.emit(addressed)
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, place, 0, 'bits_64')
    lowering.emit(loaded)
    return lowering.single(count)
}

func processor_count(): Lowered {
    var every_group = lowering.constant(65535)
    var arguments = List<Integer>()
    arguments.append(every_group)
    var answered = lowering.new_register()
    var asked = LowIntermediaryRepresentation.Instructions.ImportCall(answered, "GetActiveProcessorCount", arguments)
    lowering.emit(asked)
    var low_half = lowering.constant(4294967295)
    var count = lowering.new_register()
    var masked = LowIntermediaryRepresentation.Instructions.Arithmetic(count, 'bits_and', answered, low_half)
    masked.is_checked = false
    masked.wraps = true
    lowering.emit(masked)
    return lowering.single(count)
}

# ../../OPTIMIZATIONS.md#the-first-crash-stops-every-thread
func crash_gate(): Lowered {
    if lowering.makes_work {
        var no_arguments = List<Integer>()
        var gated = LowIntermediaryRepresentation.Instructions.Call(-1, "_crash_gate", no_arguments)
        lowering.emit(gated)
    }
    return Lowered(-1, -1)
}

func freed_frame(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var frame_value = call.arguments[0]
    crash frame_value
    var frame = lowering.lower_value(frame_value)
    var freed = LowIntermediaryRepresentation.Instructions.Free(frame.value)
    lowering.emit(freed)
    return Lowered(-1, -1)
}

func let_go(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var cell = argument(call, 0)
    var zero = lowering.constant(0)
    var clearing = lowering.new_block()
    var done = lowering.new_block()
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', cell, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, done, clearing)
    lowering.emit(test)
    lowering.switch_to(clearing)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(cell, 0, zero, 'bits_64')
    lowering.emit(cleared)
    lowering.jump_to(done)
    lowering.switch_to(done)
    return Lowered(-1, -1)
}

func typed_access(call: HighIntermediaryRepresentation.Values.Call, key: String): Lowered {
    switch call.function.name {
        "_read_value": return read_value(call)
        "_write_value": return write_value(call)
        "_forget_value": return forget_value(call)
        "_item_size": return item_size(call)
        "_bits_and": return bits(call, 'bits_and')
        "_bits_or": return bits(call, 'bits_or')
        "_bits_xor": return bits(call, 'bits_xor')
        "_shifted_left": return bits(call, 'shift_left')
        "_shifted_right": return bits(call, 'shift_right')
        "_wrapping_sum": return bits(call, 'add')
        "_wrapping_subtract": return bits(call, 'subtract')
        "_wrapping_multiply": return bits(call, 'multiply')
        "_bits_not": return bits_not(call)
        "_bits_as_unsigned": return bits_as_other(call)
        "_bits_as_signed": return bits_as_other(call)
        "_bits": return same_bits(call)
        "_key_bits": return key_bits(call)
        "_bits_as_float": return same_bits(call)
        "_bits_as_double": return same_bits(call)
        "_square_root": return square_root(call)
        "_sine": return c_maths(call, "sin")
        "_cosine": return c_maths(call, "cos")
        "_tangent": return c_maths(call, "tan")
        "_arc_sine": return c_maths(call, "asin")
        "_arc_cosine": return c_maths(call, "acos")
        "_arc_tangent": return c_maths(call, "atan")
        "_arc_tangent_over": return c_maths(call, "atan2")
        "_raised_to": return c_maths(call, "pow")
        "_exponential": return c_maths(call, "exp")
        "_logarithm": return c_maths(call, "log")
        "_logarithm_base_2": return c_maths(call, "log2")
        "_logarithm_base_10": return c_maths(call, "log10")
        "_floor": return c_maths(call, "floor")
        "_ceiling": return c_maths(call, "ceil")
        "_truncate": return c_maths(call, "trunc")
        "_round": return c_maths(call, "round")
        "_step": return stepped(call)
        "_frame_result": return frame_result(call)
        "_free_frame": return freed_frame(call)
        "_join_thread": return joined_thread(call)
        "_frame_done": return frame_done(call)
        "_foreign_site": return foreign_slot_read(0)
        "_foreign_library": return foreign_slot_read(8)
        "_foreign_site_text": return foreign_site_text(call)
        "_place_table": return place_table()
        "_call_table": return call_table()
        "_frame_pointer": return frame_pointer()
        "_read_long": return read_memory(call, 'bits_64')
        "_read_byte": return read_memory(call, 'bits_8')
        "_is_held_once": return held_once(call)
        "_item_held_once": return item_held_once(call)
        "_processor_count": return processor_count()
        "_live_allocations": return live_allocations()
        "_live_bytes": return counted_at(lowering.program.live_bytes_label)
        "_let_go": return let_go(call)
        "_crash_gate": return crash_gate()
        "_copy_bytes": return copy_bytes(call)
        _: return byte_access(call, key)
    }
}

func byte_access(call: HighIntermediaryRepresentation.Values.Call, key: String): Lowered {
    var is_an_access = key.starts_with("Buffer._") and key.ends_with("_at")
    if is_an_access and key.starts_with("Buffer._read_") {
        return read_at(call)
    }
    if is_an_access and key.starts_with("Buffer._write_") {
        return write_at(call)
    }
    return unknown(key)
}

func read_at(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var in_place = read_in_place(call)
    if in_place {
        return in_place
    }
    var buffer = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var storage = lowering.storage_of(buffer.value)
    var address = lowering.address_plus(storage, at)
    crash call.function.answer
    var answer: Model.Type = call.function.answer
    var width = lowering.width_of(answer)
    var read = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(read, address, 0, width)
    loaded.is_signed = lowering.is_signed(answer)
    loaded.is_swapped = call.function.name.contains("_big_endian_")
    lowering.emit(loaded)
    if buffer.owned {
        lowering.release(buffer.value)
    }
    return lowering.single(read)
}

func read_in_place(call: HighIntermediaryRepresentation.Values.Call): Lowered? {
    assert not call.function.name.contains("_big_endian_")
    var receiver = call.receiver
    if receiver == HighIntermediaryRepresentation.Values.NumberRoom {
        return read_of_the_room(receiver, call)
    }
    return null
}

func read_of_the_room(
    room: HighIntermediaryRepresentation.Values.NumberRoom,
    call: HighIntermediaryRepresentation.Values.Call,
): Lowered? {
    var at = call.arguments[0]
    if at == HighIntermediaryRepresentation.Values.WholeNumber {
        return read_of_the_number(room, call, at.number)
    }
    return null
}

func read_of_the_number(
    room: HighIntermediaryRepresentation.Values.NumberRoom,
    call: HighIntermediaryRepresentation.Values.Call,
    at: Long,
): Lowered? {
    crash room.number
    crash call.function.answer
    var number_type = room.number.value_type
    var answer: Model.Type = call.function.answer
    var same_width = lowering.width_of(answer) == lowering.width_of(number_type)
    var same_sign = lowering.is_signed(answer) == lowering.is_signed(number_type)
    assert at == 0 and same_width and same_sign and number_type.kind == 'scalar'
    var number = lowering.lower_value(room.number)
    return lowering.single(number.value)
}

func write_at(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var buffer = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var value = argument(call, 1)
    var storage = lowering.storage_of(buffer.value)
    var address = lowering.address_plus(storage, at)
    var written = call.function.parameters[1]
    crash written
    var width = lowering.width_of(written.parameter_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value, width)
    stored.is_swapped = call.function.name.contains("_big_endian_")
    lowering.emit(stored)
    if buffer.owned {
        lowering.release(buffer.value)
    }
    return lowering.single(-1)
}

func copy_bytes(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var buffer = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var source = argument(call, 1)
    var source_at = argument(call, 2)
    var count = argument(call, 3)
    var storage = lowering.storage_of(buffer.value)
    var destination = lowering.address_plus(storage, at)
    var source_storage = lowering.storage_of(source)
    var from = lowering.address_plus(source_storage, source_at)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(destination, from, count)
    lowering.emit(copied)
    return lowering.single(-1)
}

func resize_room(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var lowered_buffer = lowering.lower_value(call.receiver)
    var buffer = lowered_buffer.value
    var size = argument(call, 0)
    var storage = lowering.storage_of(buffer)
    var one = lowering.constant(1)
    var zero = lowering.constant(0)
    var with_an_end = lowering.address_plus(size, one)
    var offset = lowering.layout.inline_offset()
    var inline_offset = lowering.constant(offset)
    var inside = lowering.address_plus(buffer, inline_offset)
    var staying = lowering.new_block()
    var outside = lowering.new_block()
    var placing = lowering.new_block()
    var place = lowering.new_block()
    var moving = lowering.new_block()
    var done = lowering.new_block()
    var is_inside = compared_registers('equal', storage, inside)
    var inside_test = LowIntermediaryRepresentation.Instructions.Branch(is_inside, staying, outside)
    lowering.emit(inside_test)
    lowering.switch_to(outside)
    var is_missing = compared_registers('equal', storage, zero)
    var missing_test = LowIntermediaryRepresentation.Instructions.Branch(is_missing, placing, moving)
    lowering.emit(missing_test)
    lowering.switch_to(placing)
    var room = lowering.constant(lowering.layout.inline_room)
    var fits = compared_registers('less_or_equal', with_an_end, room)
    var fit_test = LowIntermediaryRepresentation.Instructions.Branch(fits, place, moving)
    lowering.emit(fit_test)
    lowering.switch_to(place)
    store_the_storage(buffer, inside)
    lowering.jump_to(done)
    lowering.switch_to(moving)
    var resized = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Resize(resized, storage, with_an_end)
    lowering.emit(made)
    store_the_storage(buffer, resized)
    lowering.jump_to(done)
    lowering.switch_to(staying)
    move_out_of_the_buffer(buffer, size, with_an_end, inside, done)
    lowering.switch_to(done)
    return lowering.single(-1)
}

func move_out_of_the_buffer(buffer: Integer, size: Integer, with_an_end: Integer, inside: Integer, done: Integer) {
    var capacity_offset = buffer_attribute_offset("_capacity")
    var capacity = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(capacity, buffer, capacity_offset, 'bits_32')
    lowering.emit(loaded)
    var room = lowering.constant(lowering.layout.inline_room)
    var fits_the_room = compared_registers('less_or_equal', with_an_end, room)
    var checking = lowering.new_block()
    var leaving = lowering.new_block()
    var room_test = LowIntermediaryRepresentation.Instructions.Branch(fits_the_room, done, checking)
    lowering.emit(room_test)
    lowering.switch_to(checking)
    var fits = compared_registers('less_or_equal', size, capacity)
    var test = LowIntermediaryRepresentation.Instructions.Branch(fits, done, leaving)
    lowering.emit(test)
    lowering.switch_to(leaving)
    var zero = lowering.constant(0)
    var fresh = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Resize(fresh, zero, with_an_end)
    lowering.emit(made)
    var one = lowering.constant(1)
    var kept = lowering.address_plus(capacity, one)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(fresh, inside, kept)
    lowering.emit(copied)
    store_the_storage(buffer, fresh)
    lowering.jump_to(done)
}

func compared_registers(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison, left: Integer, right: Integer): Integer {
    var target = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Compare(target, comparison, left, right)
    lowering.emit(made)
    return target
}

func store_the_storage(buffer: Integer, storage: Integer) {
    var offset = lowering.layout.storage_offset
    var stored = LowIntermediaryRepresentation.Instructions.Store(buffer, offset, storage, 'bits_64')
    lowering.emit(stored)
}

func buffer_attribute_offset(name: String): Integer {
    var owner = lowering.layout.program.class_named("Buffer")
    crash owner
    var attribute = owner.attribute_named(name)
    crash attribute
    return lowering.layout.offset_of(attribute)
}

func open_library(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var name = argument(call, 0)
    if lowering.program.fills_fresh_memory {
        lowering.end_the_text(name)
    }
    var bytes = lowering.bytes_of_text(name)
    var handle = lowering.new_register()
    var opened = LowIntermediaryRepresentation.Instructions.OpenLibrary(handle, bytes)
    lowering.emit(opened)
    return lowering.single(handle)
}

func close_library(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var handle = argument(call, 0)
    var zero = lowering.constant(0)
    var is_open = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_open, 'not_equal', handle, zero)
    lowering.emit(compared)
    var closing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_open, closing, after)
    lowering.emit(test)
    lowering.switch_to(closing)
    var freeing = List<Integer>()
    freeing.append(handle)
    var freed = lowering.new_register()
    var closed = LowIntermediaryRepresentation.Instructions.ImportCall(freed, "FreeLibrary", freeing)
    lowering.emit(closed)
    var failed = lowering.new_register()
    var compared_freed = LowIntermediaryRepresentation.Instructions.Compare(failed, 'equal', freed, zero)
    lowering.emit(compared_freed)
    var stopping = lowering.new_block()
    var test_freed = LowIntermediaryRepresentation.Instructions.Branch(failed, stopping, after)
    lowering.emit(test_freed)
    lowering.switch_to(stopping)
    var text = "spite: the program stopped: a library it opened could not be closed (FreeLibrary failed)\n"
    var label = lowering.text_label(text)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
    lowering.switch_to(after)
    return lowering.single(-1)
}

func bits(
    call: HighIntermediaryRepresentation.Values.Call,
    operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator,
): Lowered {
    var number = lowering.lower_value(call.receiver)
    var other = argument(call, 0)
    return unchecked(call, operator, number.value, other)
}

func bits_not(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    var every_bit = lowering.constant(-1)
    return unchecked(call, 'bits_xor', number.value, every_bit)
}

func same_bits(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    return lowering.single(number.value)
}

func key_bits(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var key = argument(call, 0)
    return lowering.single(key)
}

func square_root(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    crash call.receiver
    var number_type = call.receiver.value_type
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        target,
        'square_root',
        number.value,
        number.value,
    )
    computed.is_double = number_type.name == "Double"
    lowering.emit(computed)
    return lowering.single(target)
}

func c_maths(call: HighIntermediaryRepresentation.Values.Call, c_name: String): Lowered {
    var number = lowering.lower_value(call.receiver)
    crash call.receiver
    var number_type = call.receiver.value_type
    var size = 4
    var name = "{c_name}f"
    if number_type.name == "Double" {
        size = 8
        name = c_name
    }
    var arguments = List<Integer>()
    arguments.append(number.value)
    var sizes = List<Integer>()
    sizes.append(size)
    var index = 0
    while index < call.arguments.count() {
        var other = argument(call, index)
        arguments.append(other)
        sizes.append(size)
        index = index + 1
    }
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.ImportCall(target, name, arguments)
    computed.library = "ucrtbase.dll"
    computed.decimal_sizes = sizes
    computed.answer_decimal_size = size
    lowering.emit(computed)
    return lowering.single(target)
}

func bits_as_other(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    var zero = lowering.constant(0)
    crash call.function.answer
    var other_type: Model.Type = call.function.answer
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'bits_or', number.value, zero)
    computed.is_checked = false
    computed.width = lowering.width_of(other_type)
    computed.is_signed = lowering.is_signed(other_type)
    lowering.emit(computed)
    return lowering.single(target)
}

func unchecked(
    call: HighIntermediaryRepresentation.Values.Call,
    operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator,
    left: Integer,
    right: Integer,
): Lowered {
    crash call.receiver
    var number_type = call.receiver.value_type
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.is_checked = false
    computed.wraps = true
    computed.width = lowering.width_of(number_type)
    computed.is_signed = lowering.is_signed(number_type)
    lowering.emit(computed)
    return lowering.single(target)
}

func element_type_of(call: HighIntermediaryRepresentation.Values.Call): Model.Type {
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var element = owner.bound_types["$element_type"]
    crash element
    return element
}

func slot_size_of(list_key: String, element: Model.Type): Integer {
    var stride = lowering.layout.inline_stride_of(list_key)
    if stride > 0 {
        return stride
    }
    return item_size_of(element)
}

func item_size_of(element: Model.Type): Integer {
    if element.kind == 'enumeration' and element.is_nullable {
        return 9
    }
    if element.kind != 'scalar' {
        return 8
    }
    var scalar = lowering.scalars.of(element.name)
    crash scalar
    if element.is_nullable {
        return scalar.size + 1
    }
    return scalar.size
}

func item_size(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var size = slot_size_of(call.function.owner, element)
    var made = lowering.constant(size)
    return lowering.single(made)
}

func item_address(call: HighIntermediaryRepresentation.Values.Call, element: Model.Type): Integer {
    var list = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var buffer_attribute = owner.attribute_named("_buffer")
    crash buffer_attribute
    var offset = lowering.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, list.value, offset, 'bits_64')
    loaded.region = "{owner.key}._buffer"
    lowering.emit(loaded)
    var storage = lowering.storage_of(buffer)
    var size = slot_size_of(owner.key, element)
    var size_register = lowering.constant(size)
    var scaled = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(scaled, 'multiply', at, size_register)
    multiplied.is_checked = false
    lowering.emit(multiplied)
    return lowering.address_plus(storage, scaled)
}

# ../../OPTIMIZATIONS.md#a-lists-objects-sit-in-one-array-per-attribute
func write_into_columns(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var written = call.arguments[1]
    var value = lowering.lower_value(written)
    crash call.receiver
    var list = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var columns = ColumnLists(lowering)
    columns.write_an_item(list.value, call.function.owner, at, value)
    return lowering.single(-1)
}

func handed_out_of_columns(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var label = lowering.text_label(
        "spite: an item of a '{call.function.owner}' is held in one array per attribute and cannot be handed out whole, in {lowering.function.key}\n",
    )
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
    var after = lowering.new_block()
    lowering.switch_to(after)
    var zero = lowering.constant(0)
    return lowering.single(zero)
}

func read_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var columns = ColumnLists(lowering)
    if columns.is_columnar(call.function.owner) {
        return handed_out_of_columns(call)
    }
    var address = item_address(call, element)
    var stride = lowering.layout.inline_stride_of(call.function.owner)
    if stride > 0 {
        return lowering.single(address)
    }
    var value = lowering.new_register()
    var width = lowering.width_of(element)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, address, 0, width)
    loaded.is_signed = lowering.is_signed(element)
    loaded.region = lowering.items_region_of(call.function.owner, element)
    lowering.emit(loaded)
    if not lowering.is_a_nullable_scalar(element) {
        return lowering.single(value)
    }
    var presence = lowering.new_register()
    var presence_offset = item_size_of(element) - 1
    var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(presence, address, presence_offset, 'bits_8')
    loaded_presence.is_signed = false
    loaded_presence.region = "{loaded.region}?"
    lowering.emit(loaded_presence)
    return Lowered(value, presence)
}

func write_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var columns = ColumnLists(lowering)
    if columns.is_columnar(call.function.owner) {
        return write_into_columns(call)
    }
    var written = call.arguments[1]
    var value = lowering.lower_a_kept_value(written)
    var address = item_address(call, element)
    var width = lowering.width_of(element)
    var stride = lowering.layout.inline_stride_of(call.function.owner)
    if stride > 0 {
        write_in_place(address, value, stride)
        return lowering.single(-1)
    }
    if lowering.is_a_pointer(element) and writes_past_the_end(call) {
        write_into_an_empty_slot(address, value)
        return lowering.single(-1)
    }
    if lowering.is_a_pointer(element) {
        write_a_pointer(address, value)
        return lowering.single(-1)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value.value, width)
    stored.region = lowering.items_region_of(call.function.owner, element)
    lowering.emit(stored)
    if lowering.is_a_nullable_scalar(element) {
        var presence_offset = item_size_of(element) - 1
        var stored_presence = LowIntermediaryRepresentation.Instructions.Store(
            address,
            presence_offset,
            value.presence,
            'bits_8',
        )
        stored_presence.region = "{stored.region}?"
        lowering.emit(stored_presence)
    }
    return lowering.single(-1)
}

# ../../OPTIMIZATIONS.md#a-lists-objects-sit-inside-its-storage
func write_in_place(address: Integer, value: Lowered, stride: Integer) {
    var size = lowering.constant(stride)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(address, value.value, size)
    lowering.emit(copied)
    var count = lowering.constant(lowering.layout.immortal_count)
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 8, count, 'bits_64')
    lowering.emit(stored)
    if value.owned {
        lowering.release(value.value)
    }
}

# ../../OPTIMIZATIONS.md#an-object-handed-to-the-place-that-keeps-it-is-not-counted
func writes_past_the_end(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var reads = ListReads(lowering)
    if not reads.is_the_library_list(call.function, "list.spite") {
        return false
    }
    var index = call.arguments[0]
    if index == HighIntermediaryRepresentation.Values.AttributeRead {
        var on_this = index.object == HighIntermediaryRepresentation.Values.ThisRead
        return on_this and index.attribute.name == "_length"
    }
    return false
}

func write_into_an_empty_slot(address: Integer, value: Lowered) {
    if not value.owned {
        lowering.retain(value.value)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value.value, 'bits_64')
    lowering.emit(stored)
}

func write_a_pointer(address: Integer, value: Lowered) {
    var old = lowering.new_register()
    var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, address, 0, 'bits_64')
    lowering.emit(loaded_old)
    var same = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(same, 'equal', old, value.value)
    lowering.emit(compared)
    var keeping = lowering.new_block()
    var changing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(same, keeping, changing)
    lowering.emit(test)
    lowering.switch_to(changing)
    if not value.owned {
        lowering.retain(value.value)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value.value, 'bits_64')
    lowering.emit(stored)
    lowering.release(old)
    lowering.jump_to(after)
    lowering.switch_to(keeping)
    if value.owned {
        lowering.release(value.value)
    }
    lowering.jump_to(after)
    lowering.switch_to(after)
}

func forget_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var stride = lowering.layout.inline_stride_of(call.function.owner)
    if stride > 0 or not lowering.is_a_pointer(element) {
        return lowering.single(-1)
    }
    var address = item_address(call, element)
    var old = lowering.new_register()
    var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, address, 0, 'bits_64')
    lowering.emit(loaded_old)
    var zero = lowering.constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(address, 0, zero, 'bits_64')
    lowering.emit(cleared)
    lowering.release(old)
    return lowering.single(-1)
}

func argument(call: HighIntermediaryRepresentation.Values.Call, index: Integer): Integer {
    var value = call.arguments[index]
    var lowered_argument = lowering.lower_value(value)
    return lowered_argument.value
}

func unknown(key: String): Lowered {
    var emittable = Validators.LowIntermediaryRepresentation.Emittable.Validator()
    emittable.refuse('missing_function', key)
    return lowering.single(-1)
}

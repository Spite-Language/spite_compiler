var no_program = Model.ProgramModel()
var no_layout = Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LowProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)

func Intrinsics(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func lowered(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var key = call.function.key()
    switch key {
        "Buffer._resize_room": return resize_room(call)
        "DynamicLibrary.open_library": return open_library(call)
        "DynamicLibrary.close_library": return close_library()
        _: return typed_access(call, key)
    }
}

func typed_access(call: HighIntermediaryRepresentation.Values.Call, key: String): Lowered {
    switch call.function.name {
        "_read_value": return read_value(call)
        "_write_value": return write_value(call)
        "_forget_value": return forget_value(call)
        "_item_size": return item_size(call)
        "_bits_and": return bits(call, 'bits_and')
        "_bits_or": return bits(call, 'bits_or')
        "_bits_xor": return bits(call, 'bits_xor')
        "_shifted_left": return bits(call, 'shift_left')
        "_shifted_right": return bits(call, 'shift_right')
        "_wrapping_sum": return bits(call, 'add')
        "_wrapping_subtract": return bits(call, 'subtract')
        "_wrapping_multiply": return bits(call, 'multiply')
        "_bits_not": return bits_not(call)
        "_bits_as_unsigned": return bits_as_other(call)
        "_bits_as_signed": return bits_as_other(call)
        "_bits": return same_bits(call)
        "_bits_as_float": return same_bits(call)
        "_bits_as_double": return same_bits(call)
        "_square_root": return square_root(call)
        _: return byte_access(call, key)
    }
}

func byte_access(call: HighIntermediaryRepresentation.Values.Call, key: String): Lowered {
    var is_an_access = key.starts_with("Buffer._") and key.ends_with("_at")
    if is_an_access and key.starts_with("Buffer._read_") {
        return read_at(call)
    }
    if is_an_access and key.starts_with("Buffer._write_") {
        return write_at(call)
    }
    return unknown(key)
}

func read_at(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var buffer = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var storage = lowering.storage_of(buffer.value)
    var address = lowering.address_plus(storage, at)
    crash call.function.answer
    var answer: Model.Type = call.function.answer
    var width = lowering.width_of(answer)
    var read = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(read, address, 0, width)
    loaded.is_signed = lowering.is_signed(answer)
    lowering.emit(loaded)
    return lowering.single(read)
}

func write_at(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var buffer = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var value = argument(call, 1)
    var storage = lowering.storage_of(buffer.value)
    var address = lowering.address_plus(storage, at)
    var written = call.function.parameters[1]
    crash written
    var width = lowering.width_of(written.parameter_type)
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value, width)
    lowering.emit(stored)
    return lowering.single(-1)
}

func resize_room(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var buffer = lowering.lower_value(call.receiver)
    var size = argument(call, 0)
    var storage = lowering.storage_of(buffer.value)
    var one = lowering.constant(1)
    var with_an_end = lowering.address_plus(size, one)
    var resized = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Resize(resized, storage, with_an_end)
    lowering.emit(made)
    var offset = lowering.layout.storage_offset
    var stored = LowIntermediaryRepresentation.Instructions.Store(buffer.value, offset, resized, 'bits_64')
    lowering.emit(stored)
    return lowering.single(-1)
}

func open_library(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var name = argument(call, 0)
    var bytes = lowering.bytes_of_text(name)
    var handle = lowering.new_register()
    var opened = LowIntermediaryRepresentation.Instructions.OpenLibrary(handle, bytes)
    lowering.emit(opened)
    return lowering.single(handle)
}

func close_library(): Lowered {
    return lowering.single(-1)
}

func bits(
    call: HighIntermediaryRepresentation.Values.Call,
    operator: LowIntermediaryRepresentation.ArithmeticOperator,
): Lowered {
    var number = lowering.lower_value(call.receiver)
    var other = argument(call, 0)
    return unchecked(call, operator, number.value, other)
}

func bits_not(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    var every_bit = lowering.constant(-1)
    return unchecked(call, 'bits_xor', number.value, every_bit)
}

func same_bits(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    return lowering.single(number.value)
}

func square_root(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    crash call.receiver
    var number_type = call.receiver.value_type
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.DecimalArithmetic(
        target,
        'square_root',
        number.value,
        number.value,
    )
    computed.is_double = number_type.name == "Double"
    lowering.emit(computed)
    return lowering.single(target)
}

func bits_as_other(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var number = lowering.lower_value(call.receiver)
    var zero = lowering.constant(0)
    crash call.function.answer
    var other_type: Model.Type = call.function.answer
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, 'bits_or', number.value, zero)
    computed.is_checked = false
    computed.width = lowering.width_of(other_type)
    computed.is_signed = lowering.is_signed(other_type)
    lowering.emit(computed)
    return lowering.single(target)
}

func unchecked(
    call: HighIntermediaryRepresentation.Values.Call,
    operator: LowIntermediaryRepresentation.ArithmeticOperator,
    left: Integer,
    right: Integer,
): Lowered {
    crash call.receiver
    var number_type = call.receiver.value_type
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.is_checked = false
    computed.width = lowering.width_of(number_type)
    computed.is_signed = lowering.is_signed(number_type)
    lowering.emit(computed)
    return lowering.single(target)
}

func element_type_of(call: HighIntermediaryRepresentation.Values.Call): Model.Type {
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var element = owner.bound_types["$element_type"]
    crash element
    return element
}

func item_size_of(element: Model.Type): Integer {
    if element.kind == 'enumeration' and element.is_nullable {
        return 9
    }
    if element.kind != 'scalar' {
        return 8
    }
    var scalar = lowering.scalars.of(element.name)
    crash scalar
    if element.is_nullable {
        return scalar.size + 1
    }
    return scalar.size
}

func item_size(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var size = item_size_of(element)
    var made = lowering.constant(size)
    return lowering.single(made)
}

func item_address(call: HighIntermediaryRepresentation.Values.Call, element: Model.Type): Integer {
    var list = lowering.lower_value(call.receiver)
    var at = argument(call, 0)
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var buffer_attribute = owner.attribute_named("_buffer")
    crash buffer_attribute
    var offset = lowering.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, list.value, offset, 'bits_64')
    lowering.emit(loaded)
    var storage = lowering.storage_of(buffer)
    var size = item_size_of(element)
    var size_register = lowering.constant(size)
    var scaled = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(scaled, 'multiply', at, size_register)
    multiplied.is_checked = false
    lowering.emit(multiplied)
    return lowering.address_plus(storage, scaled)
}

func read_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var address = item_address(call, element)
    var value = lowering.new_register()
    var width = lowering.width_of(element)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, address, 0, width)
    loaded.is_signed = lowering.is_signed(element)
    lowering.emit(loaded)
    if not lowering.is_a_nullable_scalar(element) {
        return lowering.single(value)
    }
    var presence = lowering.new_register()
    var presence_offset = item_size_of(element) - 1
    var loaded_presence = LowIntermediaryRepresentation.Instructions.Load(presence, address, presence_offset, 'bits_8')
    loaded_presence.is_signed = false
    lowering.emit(loaded_presence)
    return Lowered(value, presence)
}

func write_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    var written = call.arguments[1]
    var value = lowering.lower_value(written)
    var address = item_address(call, element)
    var width = lowering.width_of(element)
    lowering.kept(value, element)
    var old = lowering.new_register()
    if lowering.is_a_pointer(element) {
        var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, address, 0, 'bits_64')
        lowering.emit(loaded_old)
    }
    var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, value.value, width)
    lowering.emit(stored)
    if lowering.is_a_pointer(element) {
        lowering.release(old)
    }
    if lowering.is_a_nullable_scalar(element) {
        var presence_offset = item_size_of(element) - 1
        var stored_presence = LowIntermediaryRepresentation.Instructions.Store(
            address,
            presence_offset,
            value.presence,
            'bits_8',
        )
        lowering.emit(stored_presence)
    }
    return lowering.single(-1)
}

func forget_value(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var element = element_type_of(call)
    if not lowering.is_a_pointer(element) {
        return lowering.single(-1)
    }
    var address = item_address(call, element)
    var old = lowering.new_register()
    var loaded_old = LowIntermediaryRepresentation.Instructions.Load(old, address, 0, 'bits_64')
    lowering.emit(loaded_old)
    var zero = lowering.constant(0)
    var cleared = LowIntermediaryRepresentation.Instructions.Store(address, 0, zero, 'bits_64')
    lowering.emit(cleared)
    lowering.release(old)
    return lowering.single(-1)
}

func argument(call: HighIntermediaryRepresentation.Values.Call, index: Integer): Integer {
    var value = call.arguments[index]
    var lowered_argument = lowering.lower_value(value)
    return lowered_argument.value
}

func unknown(key: String): Lowered {
    var emittable = Validators.LowIntermediaryRepresentation.Emittable.Validator()
    emittable.refuse('missing_function', key)
    return lowering.single(-1)
}

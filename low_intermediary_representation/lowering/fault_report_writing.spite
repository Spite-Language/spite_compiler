var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var machine = MachineWriting(lowering)
var _context_size = 1232
var _context_alignment = 16
var _context_stack_pointer_offset = 152
var _context_frame_pointer_offset = 160
var _context_instruction_pointer_offset = 248
var _most_callers = 64
var _most_steps = 256
var _caller_record_size = 16
var _unwind_information_offset = 8
var _exception_handler_flag = 8
var _consolidation_code: Long = 2147483689
var _consolidation_parameters = 15
var _catch_magic: Long = 429065504
var _parameter_count_offset = 24
var _caught_record_offset = 80
var _catch_magic_offset = 96
var _address_offset = 16
var _detail_offset = 32
var _accessed_offset = 40

func FaultReportWriting(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

# ../../../spite_documentation/failure.md#what-a-native-fault-reports
func write_the_report() {
    machine.begin("_report_the_fault", 2)
    var given = 0
    var context = 1
    var record = original_record(given)
    var code = narrow_loaded(record, 0, 'bits_32')
    var address = machine.loaded(record, _address_offset)
    var detail = machine.loaded(record, _detail_offset)
    var accessed = machine.loaded(record, _accessed_offset)
    var frame = callers_of(context)
    var nobody = machine.constant_of(0)
    var arguments = machine.three_listed(nobody, code, address)
    arguments.append(detail)
    arguments.append(accessed)
    arguments.append(frame)
    machine.called_for_nothing("Spite.Fault.report", arguments)
    machine.answered_nothing()
    machine.finish()
}

# ../../../spite_documentation/failure.md#a-c-exception-through-a-spite-frame
func original_record(record: Integer): Integer {
    var reported = machine.kept(record)
    var code = narrow_loaded(record, 0, 'bits_32')
    var consolidating = machine.compared_to('equal', code, _consolidation_code)
    var parameters = narrow_loaded(record, _parameter_count_offset, 'bits_32')
    var counted = machine.compared_to('equal', parameters, _consolidation_parameters)
    var magic = machine.loaded(record, _catch_magic_offset)
    var marked = machine.compared_to('equal', magic, _catch_magic)
    var shaped = machine.both(consolidating, counted)
    var caught = machine.both(shaped, marked)
    var unwrapping = machine.opened_when(caught)
    var original = machine.loaded(record, _caught_record_offset)
    machine.copied(reported, original)
    machine.closed(unwrapping)
    return reported
}

# ../../ARCHITECTURE.md#the-unwind-tables
func callers_of(context: Integer): Integer {
    if machine.program.hot_reload {
        return machine.loaded(context, _context_frame_pointer_offset)
    }
    var chain_size = _most_callers * _caller_record_size
    var chain = machine.room(chain_size)
    var walked = copied_context(context)
    var nothing = machine.constant_of(0)
    var asking = machine.one_listed(nothing)
    var own = machine.imported("GetModuleHandleA", asking)
    var base_room = machine.room(8)
    var handler_data = machine.room(8)
    var establisher = machine.room(8)
    var count = machine.variable(0)
    var steps = machine.variable(0)
    var top = machine.loop_top()
    var instruction = machine.loaded(walked, _context_instruction_pointer_offset)
    var running = machine.compared_to('not_equal', instruction, 0)
    var short = machine.compared_to('less', steps, _most_steps)
    var room_left = machine.compared_to('less', count, _most_callers)
    var bounded = machine.both(short, room_left)
    var going = machine.both(running, bounded)
    var done = machine.loop_while(going)
    var looking = machine.three_listed(instruction, base_room, nothing)
    var entry = machine.imported("RtlLookupFunctionEntry", looking)
    var unknown = machine.is_zero(entry)
    var described = machine.opened_unless(unknown)
    var base = machine.loaded(base_room, 0)
    var a_caller = is_a_spite_caller(entry, base, own, steps)
    var recording = machine.opened_when(a_caller)
    record_a_caller(chain, count, instruction)
    machine.closed(recording)
    var unwinding = machine.three_listed(nothing, base, instruction)
    unwinding.append(entry)
    unwinding.append(walked)
    unwinding.append(handler_data)
    unwinding.append(establisher)
    unwinding.append(nothing)
    machine.call_imported("RtlVirtualUnwind", unwinding)
    machine.closed(described)
    var leaf = machine.opened_when(unknown)
    step_out_of_a_leaf(walked, steps)
    machine.closed(leaf)
    machine.step_by(steps, 1)
    machine.loop_back(top, done)
    return chain_of(chain, count)
}

func copied_context(context: Integer): Integer {
    var room_size = _context_size + _context_alignment
    var room = machine.room(room_size)
    var raised = machine.plus_number(room, _context_alignment - 1)
    var mask = machine.constant_of(0 - _context_alignment)
    var aligned = machine.both(raised, mask)
    var size = machine.constant_of(_context_size)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(aligned, context, size, true)
    machine.writing.emit(copied)
    return aligned
}

func is_a_spite_caller(entry: Integer, base: Integer, own: Integer, steps: Integer): Integer {
    var at_home = machine.compared('equal', base, own)
    var information_offset = narrow_loaded(entry, _unwind_information_offset, 'bits_32')
    var information = machine.sum_of(base, information_offset)
    var flags = narrow_loaded(information, 0, 'bits_8')
    var flag = machine.constant_of(_exception_handler_flag)
    var handled = machine.both(flags, flag)
    var has_handler = machine.compared_to('not_equal', handled, 0)
    var past_the_fault = machine.compared_to('greater', steps, 0)
    var spite = machine.both(at_home, has_handler)
    return machine.both(spite, past_the_fault)
}

func record_a_caller(chain: Integer, count: Integer, instruction: Integer) {
    var size = machine.constant_of(_caller_record_size)
    var offset = machine.product_of(count, size)
    var at = machine.sum_of(chain, offset)
    var next = machine.sum_of(at, size)
    machine.stored(at, 0, next)
    machine.stored(at, 8, instruction)
    machine.step_by(count, 1)
}

func step_out_of_a_leaf(walked: Integer, steps: Integer) {
    var first = machine.is_zero(steps)
    var stepping = machine.opened_when(first)
    var top = machine.loaded(walked, _context_stack_pointer_offset)
    var returned = machine.loaded(top, 0)
    machine.stored(walked, _context_instruction_pointer_offset, returned)
    var popped = machine.plus_number(top, 8)
    machine.stored(walked, _context_stack_pointer_offset, popped)
    machine.closed(stepping)
    var ending = machine.opened_unless(first)
    machine.stored_number(walked, _context_instruction_pointer_offset, 0)
    machine.closed(ending)
}

func chain_of(chain: Integer, count: Integer): Integer {
    var frame = machine.variable(0)
    var empty = machine.is_zero(count)
    var ending = machine.opened_unless(empty)
    var last = machine.plus_number(count, -1)
    var size = machine.constant_of(_caller_record_size)
    var offset = machine.product_of(last, size)
    var at = machine.sum_of(chain, offset)
    machine.stored_number(at, 0, 0)
    machine.copied(frame, chain)
    machine.closed(ending)
    return frame
}

func narrow_loaded(
    address: Integer,
    offset: Integer,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
): Integer {
    var target = machine.writing.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Load(target, address, offset, width, false, "", false)
    machine.writing.emit(made)
    return target
}

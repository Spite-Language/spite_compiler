var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var layout = Layout(no_program)
var program = LowIntermediaryRepresentation.LoweredProgram()
var singleton_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(layout, program, singleton_slots)
var built = List<String>()
var destroyed = List<String>()

func Freeing(
    starting_high: HighIntermediaryRepresentation.HighProgram,
    starting_layout: Layout,
    starting_program: LowIntermediaryRepresentation.LoweredProgram,
    starting_slots: Dictionary<String, Integer>,
) {
    high = starting_high
    layout = starting_layout
    program = starting_program
    singleton_slots = starting_slots
    lowering = FunctionLowering(starting_layout, starting_program, starting_slots)
    high.built_functions.each(note_built)
}

func note_built(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    built.append(key)
}

func lower_the_release() {
    var keys = layout.class_ids.keys()
    lowering.start("_release")
    var object = lowering.new_register()
    lowering.function.parameter_count = 1
    var zero = lowering.constant(0)
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    lowering.emit(compared)
    var done = lowering.new_block()
    var counting = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, done, counting)
    lowering.emit(test)
    lowering.switch_to(counting)
    var lowered_count = lowering.new_register()
    if program.uses_threads {
        var decremented = LowIntermediaryRepresentation.Instructions.AtomicAdd(lowered_count, object, 8, -1)
        lowering.emit(decremented)
    } else {
        var count = lowering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(count, object, 8, 'bits_64')
        lowering.emit(loaded)
        var one = lowering.constant(1)
        var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(lowered_count, 'subtract', count, one)
        subtracted.is_checked = false
        lowering.emit(subtracted)
        var stored = LowIntermediaryRepresentation.Instructions.Store(object, 8, lowered_count, 'bits_64')
        lowering.emit(stored)
    }
    var gone = lowering.new_register()
    var compared_count = LowIntermediaryRepresentation.Instructions.Compare(gone, 'equal', lowered_count, zero)
    lowering.emit(compared_count)
    var freeing = lowering.new_block()
    var gone_test = LowIntermediaryRepresentation.Instructions.Branch(gone, freeing, done)
    lowering.emit(gone_test)
    lowering.switch_to(freeing)
    var passed = List<Integer>()
    passed.append(object)
    var freed = LowIntermediaryRepresentation.Instructions.Call(-1, "_free_by_class", passed)
    lowering.emit(freed)
    lowering.jump_to(done)
    lowering.switch_to(done)
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
    lowering.emit(nothing)
    program.lowered_functions.append(lowering.function)
    lower_the_free_by_class(keys)
    keys.each(lower_a_free)
    var singletons = singleton_slots.keys()
    singletons.each(lower_a_destroy)
    assert layout.has_back_references()
    lower_the_back_if_alive()
    lower_the_back_count("_point_back", 1)
    lower_the_back_count("_let_go_back", -1)
}

func lower_the_free_by_class(keys: List<String>) {
    lowering.start("_free_by_class")
    var object = lowering.new_register()
    lowering.function.parameter_count = 1
    var done = lowering.new_block()
    var class_id = lowering.new_register()
    var loaded_id = LowIntermediaryRepresentation.Instructions.Load(class_id, object, 0, 'bits_64')
    lowering.emit(loaded_id)
    if is_in_id_order(keys) {
        var last = keys.count() - 1
        free_in_range(keys, 0, last, object, class_id, done)
    } else {
        var index = 0
        while index < keys.count() {
            var key = keys[index]
            free_when(key, object, class_id, done)
            index = index + 1
        }
    }
    lowering.jump_to(done)
    lowering.switch_to(done)
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
    lowering.emit(nothing)
    program.lowered_functions.append(lowering.function)
}

func lower_the_back_if_alive() {
    lowering.start("_back_if_alive")
    var object = lowering.new_register()
    lowering.function.parameter_count = 1
    var zero = lowering.constant(0)
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    lowering.emit(compared)
    var gone = lowering.new_block()
    var looking = lowering.new_block()
    var alive = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, gone, looking)
    lowering.emit(test)
    lowering.switch_to(looking)
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, object, 8, 'bits_64')
    lowering.emit(loaded)
    var freed = lowering.new_register()
    var compared_count = LowIntermediaryRepresentation.Instructions.Compare(freed, 'equal', count, zero)
    lowering.emit(compared_count)
    var freed_test = LowIntermediaryRepresentation.Instructions.Branch(freed, gone, alive)
    lowering.emit(freed_test)
    lowering.switch_to(gone)
    var answered_nothing = LowIntermediaryRepresentation.Instructions.Return(zero)
    lowering.emit(answered_nothing)
    lowering.switch_to(alive)
    var answered = LowIntermediaryRepresentation.Instructions.Return(object)
    lowering.emit(answered)
    program.lowered_functions.append(lowering.function)
}

func lower_the_back_count(key: String, amount: Long) {
    lowering.start(key)
    var object = lowering.new_register()
    var slot = lowering.new_register()
    lowering.function.parameter_count = 2
    var zero = lowering.constant(0)
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    lowering.emit(compared)
    var done = lowering.new_block()
    var counting = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, done, counting)
    lowering.emit(test)
    lowering.switch_to(counting)
    var address = lowering.address_plus(object, slot)
    var left = lowering.new_register()
    if program.uses_threads {
        var changed = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, address, 0, amount)
        lowering.emit(changed)
    } else {
        var count = lowering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(count, address, 0, 'bits_64')
        lowering.emit(loaded)
        var amount_register = lowering.constant(amount)
        var added = LowIntermediaryRepresentation.Instructions.Arithmetic(left, 'add', count, amount_register)
        added.is_checked = false
        lowering.emit(added)
        var stored = LowIntermediaryRepresentation.Instructions.Store(address, 0, left, 'bits_64')
        lowering.emit(stored)
    }
    if amount < 0 {
        free_when_none_is_left(object, left, zero, done)
    }
    lowering.jump_to(done)
    lowering.switch_to(done)
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
    lowering.emit(nothing)
    program.lowered_functions.append(lowering.function)
}

func free_when_none_is_left(object: Integer, left: Integer, zero: Integer, done: Integer) {
    var none_left = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(none_left, 'equal', left, zero)
    lowering.emit(compared)
    var freeing = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(none_left, freeing, done)
    lowering.emit(test)
    lowering.switch_to(freeing)
    var freed = LowIntermediaryRepresentation.Instructions.Free(object)
    lowering.emit(freed)
}

func lower_a_destroy(slot_key: String) {
    assert not slot_key.is_empty()
    var key = class_of_a_slot(slot_key)
    assert not destroyed.contains(key)
    destroyed.append(key)
    var model = high.model.class_named(key)
    assert model
    assert model.is_singleton
    lowering.start("_destroy_{key}")
    var object = lowering.new_register()
    lowering.function.parameter_count = 1
    free_the_parts(model, object)
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
    lowering.emit(nothing)
    program.lowered_functions.append(lowering.function)
}

func class_of_a_slot(slot_key: String): String {
    var opening = slot_key.index_of("(")
    if opening and slot_key.ends_with(")") {
        return slot_key.slice(0, opening)
    }
    return slot_key
}

func is_in_id_order(keys: List<String>): Boolean {
    var previous = 0
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var id = layout.class_id_of(key)
        if id <= previous {
            return false
        }
        previous = id
        index = index + 1
    }
    return true
}

func free_in_range(
    keys: List<String>,
    low: Integer,
    high_end: Integer,
    object: Integer,
    class_id: Integer,
    done: Integer,
) {
    if high_end - low < 4 {
        var index = low
        while index <= high_end {
            var key = keys[index]
            crash key
            free_when(key, object, class_id, done)
            index = index + 1
        }
        lowering.jump_to(done)
        return
    }
    var middle = (low + high_end) / 2
    var middle_key = keys[middle]
    crash middle_key
    var middle_id = layout.class_id_of(middle_key)
    var middle_register = lowering.constant(middle_id)
    var below = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(below, 'less', class_id, middle_register)
    lowering.emit(compared)
    var lower_half = lowering.new_block()
    var upper_half = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(below, lower_half, upper_half)
    lowering.emit(test)
    lowering.switch_to(lower_half)
    var before_middle = middle - 1
    free_in_range(keys, low, before_middle, object, class_id, done)
    lowering.switch_to(upper_half)
    free_in_range(keys, middle, high_end, object, class_id, done)
}

func free_when(key: String, object: Integer, class_id: Integer, done: Integer) {
    var wanted = layout.class_id_of(key)
    program.free_keys[wanted] = "_free_{key}"
    var wanted_register = lowering.constant(wanted)
    var matches = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(matches, 'equal', class_id, wanted_register)
    lowering.emit(compared)
    var freeing = lowering.new_block()
    var next = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(matches, freeing, next)
    lowering.emit(test)
    lowering.switch_to(freeing)
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_free_{key}", arguments)
    lowering.emit(called)
    lowering.jump_to(done)
    lowering.switch_to(next)
}

func lower_a_free(key: String) {
    var work_model = high.model.class_named(key)
    if work_model and key.starts_with("Spite.Work_of_") {
        var works = WorkWriting(lowering)
        works.write_the_free(work_model)
        return
    }
    lowering.start("_free_{key}")
    var object = lowering.new_register()
    lowering.function.parameter_count = 1
    var model = high.model.class_named(key)
    var is_a_box = not model
    if lowering.scalars.of(key) {
        is_a_box = true
    }
    if key == "Spite.SymbolBox" {
        var symbol = lowering.new_register()
        var loaded_symbol = LowIntermediaryRepresentation.Instructions.Load(symbol, object, 16, 'bits_64')
        lowering.emit(loaded_symbol)
        lowering.release(symbol)
    }
    if key == "Spite.FunctionValue" {
        var receiver = lowering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(receiver, object, 24, 'bits_64')
        lowering.emit(loaded)
        lowering.release(receiver)
    }
    var is_whole = layout.holds_texts_whole() and (key == "String" or key == "Buffer")
    if is_whole and key == "String" {
        free_a_whole_text(object)
    } else if not is_a_box {
        crash model
        free_the_parts(model, object)
    }
    if is_whole and key == "Buffer" {
        free_a_buffer_of_a_text(object)
    } else if layout.is_back_held(key) {
        var slot = layout.back_offset_of(key)
        let_go_back(object, slot)
    } else if not is_whole {
        var freed = LowIntermediaryRepresentation.Instructions.Free(object)
        lowering.emit(freed)
    }
    var nothing = LowIntermediaryRepresentation.Instructions.Return(-1)
    lowering.emit(nothing)
    program.lowered_functions.append(lowering.function)
}

func free_a_whole_text(object: Integer) {
    var buffer_offset = text_attribute_offset("_buffer")
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, object, buffer_offset, 'bits_64')
    lowering.emit(loaded)
    var buffer_type = Model.Type('object', "Buffer")
    var zero = lowering.constant(0)
    var flag_offset = layout.text_flag_offset()
    var flag = lowering.new_register()
    var loaded_flag = LowIntermediaryRepresentation.Instructions.Load(flag, object, flag_offset, 'bits_8')
    loaded_flag.is_signed = false
    lowering.emit(loaded_flag)
    var is_whole = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_whole, 'not_equal', flag, zero)
    lowering.emit(compared)
    var whole = lowering.new_block()
    var apart = lowering.new_block()
    var freeing = lowering.new_block()
    var done = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_whole, whole, apart)
    lowering.emit(test)
    lowering.switch_to(apart)
    release_known(buffer, buffer_type)
    lowering.jump_to(freeing)
    lowering.switch_to(whole)
    var text_size_value = layout.size_of("String")
    var text_size = lowering.constant(text_size_value)
    var inside = lowering.address_plus(object, text_size)
    var is_inside = lowering.new_register()
    var compared_inside = LowIntermediaryRepresentation.Instructions.Compare(is_inside, 'equal', buffer, inside)
    lowering.emit(compared_inside)
    var own = lowering.new_block()
    var replaced = lowering.new_block()
    var inside_test = LowIntermediaryRepresentation.Instructions.Branch(is_inside, own, replaced)
    lowering.emit(inside_test)
    lowering.switch_to(own)
    var left = count_down(inside)
    var gone = lowering.new_register()
    var compared_left = LowIntermediaryRepresentation.Instructions.Compare(gone, 'equal', left, zero)
    lowering.emit(compared_left)
    var letting_go = lowering.new_block()
    var orphaning = lowering.new_block()
    var gone_test = LowIntermediaryRepresentation.Instructions.Branch(gone, letting_go, orphaning)
    lowering.emit(gone_test)
    lowering.switch_to(letting_go)
    var arguments = List<Integer>()
    arguments.append(inside)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_free_Buffer", arguments)
    lowering.emit(called)
    lowering.jump_to(freeing)
    lowering.switch_to(replaced)
    release_known(buffer, buffer_type)
    var count = lowering.new_register()
    var loaded_count = LowIntermediaryRepresentation.Instructions.Load(count, inside, 8, 'bits_64')
    lowering.emit(loaded_count)
    var is_dead = lowering.new_register()
    var compared_count = LowIntermediaryRepresentation.Instructions.Compare(is_dead, 'equal', count, zero)
    lowering.emit(compared_count)
    var held_test = LowIntermediaryRepresentation.Instructions.Branch(is_dead, freeing, orphaning)
    lowering.emit(held_test)
    lowering.switch_to(orphaning)
    var one = lowering.constant(1)
    var orphan_offset = layout.orphan_flag_offset()
    var orphaned = LowIntermediaryRepresentation.Instructions.Store(inside, orphan_offset, one, 'bits_8')
    lowering.emit(orphaned)
    lowering.jump_to(done)
    lowering.switch_to(freeing)
    var freed = LowIntermediaryRepresentation.Instructions.Free(object)
    lowering.emit(freed)
    lowering.jump_to(done)
    lowering.switch_to(done)
}

func free_a_buffer_of_a_text(object: Integer) {
    var zero = lowering.constant(0)
    var embedded_offset = layout.embedded_flag_offset()
    var embedded = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(embedded, object, embedded_offset, 'bits_8')
    loaded.is_signed = false
    lowering.emit(loaded)
    var is_embedded = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_embedded, 'not_equal', embedded, zero)
    lowering.emit(compared)
    var alone = lowering.new_block()
    var inside_a_text = lowering.new_block()
    var freeing_the_text = lowering.new_block()
    var done = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_embedded, inside_a_text, alone)
    lowering.emit(test)
    lowering.switch_to(alone)
    var freed = LowIntermediaryRepresentation.Instructions.Free(object)
    lowering.emit(freed)
    lowering.jump_to(done)
    lowering.switch_to(inside_a_text)
    var orphan_offset = layout.orphan_flag_offset()
    var orphan = lowering.new_register()
    var loaded_orphan = LowIntermediaryRepresentation.Instructions.Load(orphan, object, orphan_offset, 'bits_8')
    loaded_orphan.is_signed = false
    lowering.emit(loaded_orphan)
    var is_orphan = lowering.new_register()
    var compared_orphan = LowIntermediaryRepresentation.Instructions.Compare(is_orphan, 'not_equal', orphan, zero)
    lowering.emit(compared_orphan)
    var orphan_test = LowIntermediaryRepresentation.Instructions.Branch(is_orphan, freeing_the_text, done)
    lowering.emit(orphan_test)
    lowering.switch_to(freeing_the_text)
    var text_size_value = layout.size_of("String")
    var text_size = lowering.constant(text_size_value)
    var text = lowering.new_register()
    var found = LowIntermediaryRepresentation.Instructions.Arithmetic(text, 'subtract', object, text_size)
    found.is_checked = false
    lowering.emit(found)
    var freed_text = LowIntermediaryRepresentation.Instructions.Free(text)
    lowering.emit(freed_text)
    lowering.jump_to(done)
    lowering.switch_to(done)
}

func count_down(object: Integer): Integer {
    var left = lowering.new_register()
    if program.uses_threads {
        var decremented = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, object, 8, -1)
        lowering.emit(decremented)
        return left
    }
    var count = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(count, object, 8, 'bits_64')
    lowering.emit(loaded)
    var one = lowering.constant(1)
    var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(left, 'subtract', count, one)
    subtracted.is_checked = false
    lowering.emit(subtracted)
    var stored = LowIntermediaryRepresentation.Instructions.Store(object, 8, left, 'bits_64')
    lowering.emit(stored)
    return left
}

func text_attribute_offset(name: String): Integer {
    var owner = layout.program.class_named("String")
    crash owner
    var attribute = owner.attribute_named(name)
    crash attribute
    return layout.offset_of(attribute)
}

func free_the_parts(model: Model.ClassModel, object: Integer) {
    var dropping = model.function_named("drop")
    if dropping {
        call_the_drop(dropping, object)
    }
    if layout.is_back_held(model.key) {
        var zero = lowering.constant(0)
        var freed = LowIntermediaryRepresentation.Instructions.Store(object, 8, zero, 'bits_64')
        lowering.emit(freed)
    }
    var element = model.bound_types["$element_type"]
    var reads_items = model.function_named("_read_value")
    if element and reads_items {
        release_the_items(model, element, object)
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        release_an_attribute(attribute, object)
        index = index + 1
    }
    if model.key == "Buffer" {
        free_the_storage(object)
    }
}

func call_the_drop(dropping: Model.FunctionModel, object: Integer) {
    var key = dropping.key()
    assert built.contains(key)
    var one = lowering.constant(1)
    var counted = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    lowering.emit(counted)
    var arguments = List<Integer>()
    arguments.append(object)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, key, arguments)
    lowering.emit(called)
}

func release_an_attribute(attribute: Model.AttributeModel, object: Integer) {
    assert lowering.is_a_pointer(attribute.attribute_type)
    assert layout.has_a_slot(attribute)
    var offset = layout.offset_of(attribute)
    var held = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(held, object, offset, 'bits_64')
    lowering.emit(loaded)
    if layout.is_back(attribute) {
        var slot = layout.back_slot_of(attribute)
        let_go_back(held, slot)
    } else {
        release_known(held, attribute.attribute_type)
    }
}

func release_known(held: Integer, of_type: Model.Type) {
    var key = known_class_of(of_type)
    if key.is_empty() {
        lowering.release(held)
    } else {
        release_directly(held, key)
    }
}

func known_class_of(of_type: Model.Type): String {
    if of_type.kind != 'object' or of_type.is_symbol or not layout.class_ids.contains(of_type.name) {
        return ""
    }
    if of_type.name.starts_with("Spite.") {
        return ""
    }
    var model = high.model.class_named(of_type.name)
    if not model or model.is_singleton {
        return ""
    }
    return of_type.name
}

func release_directly(held: Integer, key: String) {
    var zero = lowering.constant(0)
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', held, zero)
    lowering.emit(compared)
    var counting = lowering.new_block()
    var freeing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, after, counting)
    lowering.emit(test)
    lowering.switch_to(counting)
    var left = lowering.new_register()
    if program.uses_threads {
        var decremented = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, held, 8, -1)
        lowering.emit(decremented)
    } else {
        var count = lowering.new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(count, held, 8, 'bits_64')
        lowering.emit(loaded)
        var one = lowering.constant(1)
        var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(left, 'subtract', count, one)
        subtracted.is_checked = false
        lowering.emit(subtracted)
        var stored = LowIntermediaryRepresentation.Instructions.Store(held, 8, left, 'bits_64')
        lowering.emit(stored)
    }
    var gone = lowering.new_register()
    var compared_left = LowIntermediaryRepresentation.Instructions.Compare(gone, 'equal', left, zero)
    lowering.emit(compared_left)
    var gone_test = LowIntermediaryRepresentation.Instructions.Branch(gone, freeing, after)
    lowering.emit(gone_test)
    lowering.switch_to(freeing)
    var arguments = List<Integer>()
    arguments.append(held)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_free_{key}", arguments)
    lowering.emit(called)
    lowering.jump_to(after)
    lowering.switch_to(after)
}

func let_go_back(object: Integer, slot: Integer) {
    var slot_register = lowering.constant(slot)
    var arguments = List<Integer>()
    arguments.append(object)
    arguments.append(slot_register)
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, "_let_go_back", arguments)
    lowering.emit(called)
}

func release_the_items(model: Model.ClassModel, element: Model.Type, object: Integer) {
    assert lowering.is_a_pointer(element)
    assert layout.inline_stride_of(model.key) == 0
    var buffer_attribute = model.attribute_named("_buffer")
    var length_attribute = model.attribute_named("_length")
    assert buffer_attribute
    assert length_attribute
    var buffer_offset = layout.offset_of(buffer_attribute)
    var length_offset = layout.offset_of(length_attribute)
    var buffer = lowering.new_register()
    var loaded_buffer = LowIntermediaryRepresentation.Instructions.Load(buffer, object, buffer_offset, 'bits_64')
    lowering.emit(loaded_buffer)
    var storage = lowering.storage_of(buffer)
    var length = lowering.new_register()
    var loaded_length = LowIntermediaryRepresentation.Instructions.Load(length, object, length_offset, 'bits_32')
    lowering.emit(loaded_length)
    var position = lowering.constant(0)
    var header = lowering.new_block()
    var body = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(header)
    lowering.switch_to(header)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'less', position, length)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, body, after)
    lowering.emit(test)
    lowering.switch_to(body)
    var eight = lowering.constant(8)
    var scaled = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(scaled, 'multiply', position, eight)
    multiplied.is_checked = false
    lowering.emit(multiplied)
    var address = lowering.address_plus(storage, scaled)
    var item = lowering.new_register()
    var loaded_item = LowIntermediaryRepresentation.Instructions.Load(item, address, 0, 'bits_64')
    lowering.emit(loaded_item)
    release_known(item, element)
    var one = lowering.constant(1)
    var advanced = LowIntermediaryRepresentation.Instructions.Arithmetic(position, 'add', position, one)
    advanced.is_checked = false
    lowering.emit(advanced)
    lowering.jump_to(header)
    lowering.switch_to(after)
}

func free_the_storage(object: Integer) {
    var storage = lowering.storage_of(object)
    var zero = lowering.constant(0)
    var missing = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', storage, zero)
    lowering.emit(compared)
    var outside = lowering.new_block()
    var freeing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, after, outside)
    lowering.emit(test)
    lowering.switch_to(outside)
    var offset = lowering.layout.inline_offset()
    var inline_offset = lowering.constant(offset)
    var inside = lowering.address_plus(object, inline_offset)
    var is_inside = lowering.new_register()
    var compared_inside = LowIntermediaryRepresentation.Instructions.Compare(is_inside, 'equal', storage, inside)
    lowering.emit(compared_inside)
    var inside_test = LowIntermediaryRepresentation.Instructions.Branch(is_inside, after, freeing)
    lowering.emit(inside_test)
    lowering.switch_to(freeing)
    var freed = LowIntermediaryRepresentation.Instructions.Free(storage)
    lowering.emit(freed)
    lowering.jump_to(after)
    lowering.switch_to(after)
}

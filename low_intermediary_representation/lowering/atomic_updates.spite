var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)

func AtomicUpdates(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func lowered_an_update(assign: HighIntermediaryRepresentation.Statements.Assign.Attribute): Boolean {
    var on_itself = assign.object.class == HighIntermediaryRepresentation.Values.ThisRead
    fallback on_itself
    var value = assign.value
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return lowered_with(assign, value)
    }
    return false
}

func lowered_with(
    assign: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): Boolean {
    var lowering_values = Values(lowering.state)
    var amount = amount_of(operation, assign.attribute)
    fallback amount
    var attribute = assign.attribute
    var width = lowering.width_of(attribute.attribute_type)
    crash width == 'bits_32' or width == 'bits_64'
    crash assign.object
    var object = lowering.lower_value(assign.object)
    var amount_value = lowering.lower_value(amount)
    var trying = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(trying)
    lowering.switch_to(trying)
    var old = lowering_values.load_attribute(object.value, attribute)
    var target = lowering.new_register()
    var operator = lowering_values.arithmetic_of(operation.operator)
    var is_signed = lowering.is_signed(attribute.attribute_type)
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(
        target,
        operator,
        old.value,
        amount_value.value,
        width,
        is_signed,
        false,
    )
    lowering.emit(computed)
    if not operation.is_proven_to_fit {
        var shown = operation.shown()
        var check = LowIntermediaryRepresentation.Instructions.Check(
            lowering.state.line,
            shown,
            attribute.attribute_type.name,
            lowering.state.path,
            "",
        )
        lowering.emit(check)
    }
    var offset = lowering.state.layout.offset_of(attribute)
    var before = lowering.new_register()
    var exchanged = LowIntermediaryRepresentation.Instructions.CompareExchange(
        before,
        object.value,
        offset,
        old.value,
        target,
        width,
        computed.is_signed,
    )
    lowering.emit(exchanged)
    var won = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(won, 'equal', before, old.value, true)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(won, after, trying)
    lowering.emit(test)
    lowering.switch_to(after)
    return true
}

func amount_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    attribute: Model.AttributeModel,
): SpiteCompiler.Value? {
    fallback operation.operator == 'add' or operation.operator == 'subtract'
    if reads_its_own(operation.left, attribute) {
        return operation.right
    }
    if operation.operator == 'add' and reads_its_own(operation.right, attribute) {
        return operation.left
    }
    return null
}

func reads_its_own(value: SpiteCompiler.Value?, attribute: Model.AttributeModel): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var on_itself = value.object.class == HighIntermediaryRepresentation.Values.ThisRead
        return on_itself and value.attribute.name == attribute.name and value.attribute.owner == attribute.owner
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it

var _drop_mode = 6
var _chain = 4
var _receiver_offset = 24
var no_program = Model.ProgramModel()
var model = Model.ProgramModel()
var layout = HighIntermediaryRepresentation.Layout(no_program)
var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var machine = MachineWriting(lowering)
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var links = DeepLinks(no_high, layout, lowering)
var cycles = ClosingStores(layout, lowering)
var capable: Dictionary<String, Integer>
var built: List<String>

func SuspectWalks(starting_links: DeepLinks, starting_lowering: FunctionLowering, starting_built: List<String>) {
    lowering = starting_lowering
    layout = starting_lowering.state.layout
    model = layout.program
    machine = MachineWriting(starting_lowering)
    links = starting_links
    cycles = ClosingStores(layout, starting_lowering)
    capable = starting_lowering.state.program.cycle_capable
    built = starting_built
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write(): Integer {
    var keys = laid_out_capable()
    var ids = Dictionary<Integer, Boolean>()
    var key_index = 0
    while key_index < keys.count() {
        var capable_key = keys[key_index]
        var capable_id = layout.class_id_of(capable_key)
        ids[capable_id] = true
        key_index = key_index + 1
    }
    var size = table_size()
    var table = Buffer()
    var index = 0
    while index < size {
        if ids[index] == true {
            table.append(1)
        } else {
            table.append(0)
        }
        index = index + 1
    }
    lowering.state.program.cycle_table = lowering.data_label(table)
    lowering.state.program.constant_labels.append(lowering.state.program.cycle_table)
    write_the_walk_by_class(keys)
    keys.each(write_a_walk)
    return size
}

func table_size(): Integer {
    var most = 0
    var keys = layout.class_ids.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var id = layout.class_id_of(key)
        if id > most {
            most = id
        }
        index = index + 1
    }
    return most + 1
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func write_the_walk_by_class(keys: List<String>) {
    machine.begin("_cycle_walk_by_class", 2)
    var class_id = machine.loaded(0, 0)
    var ids = List<Integer>()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var id = layout.class_id_of(key)
        ids.append(id)
        index = index + 1
    }
    var sorted = ids.sort_by(itself)
    var count = sorted.count()
    walk_between(class_id, sorted, 0, count)
    machine.answered_nothing()
    machine.finish()
}

func itself(id: Integer): Integer {
    return id
}

func walk_between(class_id: Integer, ids: List<Integer>, low: Integer, high: Integer) {
    if high - low <= _chain {
        walk_each_of(class_id, ids, low, high)
        return
    }
    var middle = (low + high) / 2
    var middle_id = ids[middle]
    crash middle_id
    var below = machine.compared_to('less', class_id, middle_id)
    var lower = machine.opened_when(below)
    walk_between(class_id, ids, low, middle)
    machine.answered_nothing()
    machine.closed(lower)
    walk_between(class_id, ids, middle, high)
}

func walk_each_of(class_id: Integer, ids: List<Integer>, low: Integer, high: Integer) {
    var index = low
    while index < high {
        var id = ids[index]
        crash id
        var key = key_of(id)
        var matches = machine.compared_to('equal', class_id, id)
        var other = machine.opened_when(matches)
        var passed = machine.two_listed(0, 1)
        machine.called_for_nothing("_cycle_walk_{key}", passed)
        machine.answered_nothing()
        machine.closed(other)
        index = index + 1
    }
}

func key_of(id: Integer): String {
    var keys = laid_out_capable()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if layout.class_id_of(key) == id {
            return key
        }
        index = index + 1
    }
    crash
}

func write_a_walk(key: String) {
    machine.begin("_cycle_walk_{key}", 2)
    var dropping = machine.compared_to('equal', 1, _drop_mode)
    var walking = machine.opened_when(dropping)
    drop_it(key)
    machine.answered_nothing()
    machine.closed(walking)
    if key == "Spite.FunctionValue" {
        visit_at(0, _receiver_offset)
        machine.answered_nothing()
        machine.finish()
        return
    }
    var class_model = model.class_named(key)
    crash class_model
    var element = class_model.bound_types["$element_type"]
    if element and links.releases_its_items(class_model) and cycles.reaches_a_capable(capable, element) {
        visit_the_items(class_model)
    }
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        var counted = links.releases_an_attribute(attribute)
        if counted and cycles.reaches_a_capable(capable, attribute.attribute_type) {
            var offset = layout.offset_of(attribute)
            visit_at(0, offset)
        }
        index = index + 1
    }
    machine.answered_nothing()
    machine.finish()
}

func drop_it(key: String) {
    var class_model = model.class_named(key)
    fallback class_model
    var dropping = class_model.function_named("drop")
    fallback dropping
    var drop_key = dropping.key()
    fallback built.contains(drop_key)
    var passed = machine.one_listed(0)
    machine.called_for_nothing(drop_key, passed)
}

func visit_at(object: Integer, offset: Integer) {
    var address = machine.plus_number(object, offset)
    var child = machine.loaded(address, 0)
    var passed = machine.three_listed(child, 1, address)
    machine.called_for_nothing("_cycle_visit", passed)
}

func visit_the_items(class_model: Model.ClassModel) {
    var buffer_attribute = class_model.attribute_named("_buffer")
    crash buffer_attribute
    var buffer_offset = layout.offset_of(buffer_attribute)
    var buffer = machine.loaded(0, buffer_offset)
    var storage = machine.writing.storage_of(buffer)
    var length_attribute = class_model.attribute_named("_length")
    crash length_attribute
    var length_offset = layout.offset_of(length_attribute)
    var length = machine.writing.new_register()
    var loaded_length = LowIntermediaryRepresentation.Instructions.Load(
        length,
        0,
        length_offset,
        'bits_32',
        true,
        "",
        false,
    )
    machine.writing.emit(loaded_length)
    var position = machine.variable(0)
    var top = machine.loop_top()
    var more = machine.compared('less', position, length)
    var done = machine.loop_while(more)
    var word = machine.constant_of(8)
    var scaled = machine.product_of(position, word)
    var address = machine.sum_of(storage, scaled)
    var child = machine.loaded(address, 0)
    var passed = machine.three_listed(child, 1, address)
    machine.called_for_nothing("_cycle_visit", passed)
    machine.step_by(position, 1)
    machine.loop_back(top, done)
}

func laid_out_capable(): List<String> {
    var found = List<String>()
    var keys = capable.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if layout.class_ids.contains(key) {
            found.append(key)
        }
        index = index + 1
    }
    return found
}

var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)

func LeakReportWriting(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

func write_the_report() {
    var names = names_by_id()
    machine.begin("_leak_report", 0)
    var allocated_at = machine.data_at(machine.program.allocation_count_label)
    var allocations = machine.loaded(allocated_at, 0)
    var freed_at = machine.data_at(machine.program.free_count_label)
    var frees = machine.loaded(freed_at, 0)
    var leaked = machine.difference_of(allocations, frees)
    var balanced = machine.compared_to('equal', leaked, 0)
    var after = machine.opened_unless(balanced)
    report("spite: --debug-memory: ", leaked, " allocation(s) leaked\n")
    var room = names.count() * 8 + 8
    var counts_label = machine.zeroed_label(room)
    machine.writing.program.name_state(counts_label, "memory.leaks")
    var counts = machine.data_at(counts_label)
    count_the_live_blocks(counts)
    var id = 1
    while id < names.count() {
        var name = names[id]
        name_the_leaked(counts, id, name)
        id = id + 1
    }
    machine.closed(after)
    machine.answered_nothing()
    machine.finish()
}

func names_by_id(): List<String> {
    var class_ids = machine.layout.class_ids
    var names = List<String>()
    names.append("")
    var keys = class_ids.keys()
    var index = 0
    while index < keys.count() {
        names.append("")
        index = index + 1
    }
    index = 0
    while index < keys.count() {
        var key = keys[index]
        var id = class_ids[key]
        crash id
        if id > 0 and id < names.count() {
            names[id] = key
        }
        index = index + 1
    }
    return names
}

func count_the_live_blocks(counts: Integer) {
    var head = machine.data_at(machine.program.live_list_label)
    var first = machine.loaded(head, 0)
    var block = machine.kept(first)
    var top = machine.loop_top()
    var more = machine.compared_to('not_equal', block, 0)
    var done = machine.loop_while(more)
    var class_id = machine.loaded(block, 24)
    var eight = machine.constant_of(8)
    var scaled = machine.product_of(class_id, eight)
    var slot = machine.sum_of(counts, scaled)
    var counted = machine.loaded(slot, 0)
    var one_more = machine.plus_number(counted, 1)
    machine.stored(slot, 0, one_more)
    var next = machine.loaded(block, 0)
    machine.copied(block, next)
    machine.loop_back(top, done)
}

func name_the_leaked(counts: Integer, id: Integer, name: String) {
    fallback not name.is_empty()
    var leaked = machine.loaded(counts, id * 8)
    var none_left = machine.compared_to('equal', leaked, 0)
    var after = machine.opened_unless(none_left)
    report("  {name}: ", leaked, " leaked object(s)\n")
    machine.closed(after)
}

func report(opening: String, number: Integer, closing: String) {
    var opening_label = lowering.text_label(opening)
    var closing_label = lowering.text_label(closing)
    var reported = LowIntermediaryRepresentation.Instructions.Stop(opening_label)
    reported.labels.append(opening_label)
    reported.labels.append(closing_label)
    reported.numbers.append(number)
    reported.signed_numbers.append(0)
    reported.continues = true
    machine.writing.emit(reported)
}

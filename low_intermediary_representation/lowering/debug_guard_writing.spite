var no_program = Model.ProgramModel()
var no_layout = Layout(no_program)
var no_low = LowIntermediaryRepresentation.LowProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low, no_slots)
var machine = MachineWriting(lowering)
var guard_label = -1

func DebugGuardWriting(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

func write_the_guard() {
    assert not machine.is_written("Spite.Debugging.enters")
    guard_label = machine.zeroed_label(32)
    write_enters()
    write_leaves()
    write_end()
}

func entry_at(entries: Integer, index: Integer): Integer {
    var sixteen = machine.constant_of(16)
    var scaled = machine.product_of(index, sixteen)
    return machine.sum_of(entries, scaled)
}

func write_enters() {
    machine.begin("Spite.Debugging.enters", 2)
    var guard = machine.data_at(guard_label)
    var locking = machine.one_listed(guard)
    machine.imported("AcquireSRWLockExclusive", locking)
    var thread = machine.thread_now()
    var entries = machine.loaded(guard, 8)
    var count = machine.loaded(guard, 16)
    var index = machine.variable(0)
    var top = machine.loop_top()
    var in_range = machine.compared('less', index, count)
    var done = machine.loop_while(in_range)
    var entry = entry_at(entries, index)
    var address = machine.loaded(entry, 0)
    var owner = machine.loaded(entry, 8)
    var same_address = machine.compared('equal', address, 1)
    var same_thread = machine.compared('equal', owner, thread)
    var is_inside = machine.both(same_address, same_thread)
    var elsewhere = machine.opened_when(is_inside)
    machine.imported("ReleaseSRWLockExclusive", locking)
    var no = machine.constant_of(0)
    machine.answered(no)
    machine.closed(elsewhere)
    machine.step_by(index, 1)
    machine.loop_back(top, done)
    var capacity = machine.loaded(guard, 24)
    var is_full = machine.compared('greater_or_equal', count, capacity)
    var has_room = machine.opened_when(is_full)
    var doubled = machine.plus_number(capacity, 0)
    machine.copied(doubled, capacity)
    machine.step_by(doubled, 8)
    var twice = machine.sum_of(doubled, capacity)
    var sixteen = machine.constant_of(16)
    var size = machine.product_of(twice, sixteen)
    var is_new = machine.is_zero(entries)
    var growing = machine.opened_when(is_new)
    var made = machine.writing.new_register()
    var allocated = LowIntermediaryRepresentation.Instructions.Allocate(made, size)
    machine.writing.emit(allocated)
    machine.stored(guard, 8, made)
    machine.closed(growing)
    var making = machine.opened_unless(is_new)
    var grown = machine.writing.new_register()
    var resized = LowIntermediaryRepresentation.Instructions.Resize(grown, entries, size)
    machine.writing.emit(resized)
    machine.stored(guard, 8, grown)
    machine.closed(making)
    machine.stored(guard, 24, twice)
    machine.closed(has_room)
    var kept_entries = machine.loaded(guard, 8)
    var added = entry_at(kept_entries, count)
    machine.stored(added, 0, 1)
    machine.stored(added, 8, thread)
    var more = machine.plus_number(count, 1)
    machine.stored(guard, 16, more)
    machine.imported("ReleaseSRWLockExclusive", locking)
    var yes = machine.constant_of(1)
    machine.answered(yes)
    machine.finish()
}

func write_leaves() {
    machine.begin("Spite.Debugging.leaves", 1)
    var guard = machine.data_at(guard_label)
    var locking = machine.one_listed(guard)
    machine.imported("AcquireSRWLockExclusive", locking)
    var thread = machine.thread_now()
    var entries = machine.loaded(guard, 8)
    var count = machine.loaded(guard, 16)
    var last = machine.plus_number(count, -1)
    var index = machine.kept(last)
    var top = machine.loop_top()
    var in_range = machine.compared_to('greater_or_equal', index, 0)
    var done = machine.loop_while(in_range)
    var entry = entry_at(entries, index)
    var owner = machine.loaded(entry, 8)
    var is_mine = machine.compared('equal', owner, thread)
    var not_mine = machine.opened_when(is_mine)
    var moving = machine.kept(index)
    var shifting = machine.loop_top()
    var has_next = machine.compared('less', moving, last)
    var shifted = machine.loop_while(has_next)
    var here = entry_at(entries, moving)
    var next_address = machine.loaded(here, 16)
    var next_owner = machine.loaded(here, 24)
    machine.stored(here, 0, next_address)
    machine.stored(here, 8, next_owner)
    machine.step_by(moving, 1)
    machine.loop_back(shifting, shifted)
    machine.stored(guard, 16, last)
    machine.imported("ReleaseSRWLockExclusive", locking)
    machine.answered_nothing()
    machine.closed(not_mine)
    machine.step_by(index, -1)
    machine.loop_back(top, done)
    machine.imported("ReleaseSRWLockExclusive", locking)
    machine.answered_nothing()
    machine.finish()
}

func write_end() {
    machine.begin("_debugging_end", 0)
    var guard = machine.data_at(guard_label)
    var entries = machine.loaded(guard, 8)
    var has_some = machine.compared_to('not_equal', entries, 0)
    var has_none = machine.opened_when(has_some)
    machine.freed(entries)
    machine.stored_number(guard, 8, 0)
    machine.closed(has_none)
    machine.answered_nothing()
    machine.finish()
}

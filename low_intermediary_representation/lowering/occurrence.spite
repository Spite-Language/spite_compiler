var target = ""
var name: String
var always: Boolean
var callee: String
var index: Integer

func Occurrence(starting_name: String, starting_always: Boolean, starting_callee: String, starting_index: Integer) {
    name = starting_name
    always = starting_always
    callee = starting_callee
    index = starting_index
}

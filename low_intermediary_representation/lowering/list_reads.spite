# ../../OPTIMIZATIONS.md#a-proven-read-tests-only-its-bounds
var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var gets = HighIntermediaryRepresentation.ListGets(no_program)

func ListReads(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    gets = HighIntermediaryRepresentation.ListGets(starting_lowering.layout.program)
}

func is_a_plain_get(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    return gets.is_a_plain_get(call)
}

func is_a_tested_get(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if call.function.name != "get_at" or call.arguments.count() != 1 {
        return false
    }
    var is_listed = is_the_library_list(call.function, "list.spite")
    if not is_listed {
        is_listed = is_the_library_list(call.function, "vector.spite")
    }
    if not is_listed {
        return false
    }
    var owner = lowering.layout.program.class_named(call.function.owner)
    if not owner {
        return false
    }
    var element = owner.bound_types["$element_type"]
    if not element {
        return false
    }
    if not owner.attribute_named("_length") {
        return false
    }
    return not element.is_nullable
}

func presence_of(tested: HighIntermediaryRepresentation.Values.Value?): Lowered? {
    if tested == HighIntermediaryRepresentation.Values.Call {
        assert is_a_tested_get(tested)
        return presence(tested)
    }
    return null
}

func presence(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var list = lowering.lower_value(call.receiver)
    crash call.receiver
    lowering.release_later(list, call.receiver.value_type)
    var position = call.arguments[0]
    crash position
    var at = lowering.lower_value(position)
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var length = length_of(owner, call.receiver, list.value)
    var inside = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(inside, 'less', at.value, length)
    compared.is_signed = false
    lowering.emit(compared)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    return lowering.single(inside)
}

func is_a_count(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if not call.arguments.is_empty() {
        return false
    }
    if call.function.name == "length" {
        return is_the_library_list(call.function, "string.spite")
    }
    if call.function.name != "count" {
        return false
    }
    var is_listed = is_the_library_list(call.function, "list.spite")
    if not is_listed {
        is_listed = is_the_library_list(call.function, "vector.spite")
    }
    if not is_listed {
        is_listed = is_the_library_list(call.function, "items.spite")
    }
    return is_listed
}

func is_the_library_list(function: Model.FunctionModel, file_name: String): Boolean {
    return gets.is_the_library_list(function, file_name)
}

func read(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered? {
    var converted = conversion.converted
    if converted == HighIntermediaryRepresentation.Values.Call {
        assert is_a_plain_get(converted)
        return read_the_item(converted, conversion.shown, true)
    }
    return null
}

func held_item(conversion: HighIntermediaryRepresentation.Values.Conversion): Lowered {
    var converted = conversion.converted
    if converted == HighIntermediaryRepresentation.Values.Call {
        return read_the_item(converted, conversion.shown, false)
    }
    return lowering.lower_value(conversion)
}

func read_the_item(call: HighIntermediaryRepresentation.Values.Call, shown: String, counts: Boolean): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var list = lowering.lower_value(call.receiver)
    crash call.receiver
    lowering.release_later(list, call.receiver.value_type)
    var position = call.arguments[0]
    crash position
    var at = lowering.lower_value(position)
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var length = length_of(owner, call.receiver, list.value)
    var inside = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(inside, 'less', at.value, length)
    compared.is_signed = false
    lowering.emit(compared)
    var tested = Lowered(-1, inside)
    lowering.stop_if_missing(tested, shown)
    var element = owner.bound_types["$element_type"]
    crash element
    var address = address_of_item(owner, call.receiver, list.value, at.value, element)
    var stride = lowering.layout.inline_stride_of(owner.key)
    if stride > 0 {
        lowering.release_the_pending()
        lowering.pending_releases = outer
        return lowering.single(address)
    }
    var value = lowering.new_register()
    var width = lowering.width_of(element)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(value, address, 0, width)
    loaded.is_signed = lowering.is_signed(element)
    loaded.region = lowering.items_region_of(owner.key, element)
    lowering.emit(loaded)
    var is_counted = counts and lowering.is_a_pointer(element)
    if is_counted {
        lowering.retain(value)
    }
    lowering.release_the_pending()
    lowering.pending_releases = outer
    if is_counted {
        return lowering.owned(value)
    }
    return lowering.single(value)
}

func counted(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var list = lowering.lower_value(call.receiver)
    crash call.receiver
    lowering.release_later(list, call.receiver.value_type)
    var owner = lowering.layout.program.class_named(call.function.owner)
    crash owner
    var length = length_of(owner, call.receiver, list.value)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    return lowering.single(length)
}

# ../../OPTIMIZATIONS.md#a-local-list-of-known-size-lives-in-the-frame
func length_of(owner: Model.ClassModel, receiver: HighIntermediaryRepresentation.Values.Value?, list: Integer): Integer {
    var known = lowering.frame_list_count_of(receiver)
    if known > 0 {
        return lowering.constant(known)
    }
    return load_the_length(owner, list)
}

func address_of_item(
    owner: Model.ClassModel,
    receiver: HighIntermediaryRepresentation.Values.Value?,
    list: Integer,
    at: Integer,
    element: Model.Type,
): Integer {
    var known = lowering.frame_list_count_of(receiver)
    if known == 0 {
        return item_address(owner, list, at, element)
    }
    var size = item_size_of(element)
    var size_register = lowering.constant(size)
    var scaled = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(scaled, 'multiply', at, size_register)
    multiplied.is_checked = false
    lowering.emit(multiplied)
    return lowering.address_plus(list, scaled)
}

func load_the_length(owner: Model.ClassModel, list: Integer): Integer {
    var length_attribute = owner.attribute_named("_length")
    crash length_attribute
    var offset = lowering.layout.offset_of(length_attribute)
    var length = lowering.new_register()
    var width = lowering.width_of(length_attribute.attribute_type)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(length, list, offset, width)
    loaded.region = "{owner.key}._length"
    lowering.emit(loaded)
    return length
}

func item_address(owner: Model.ClassModel, list: Integer, at: Integer, element: Model.Type): Integer {
    var buffer_attribute = owner.attribute_named("_buffer")
    crash buffer_attribute
    var offset = lowering.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, list, offset, 'bits_64')
    loaded.region = "{owner.key}._buffer"
    lowering.emit(loaded)
    var storage = lowering.storage_of(buffer)
    var size = item_size_of(element)
    var stride = lowering.layout.inline_stride_of(owner.key)
    if stride > 0 {
        size = stride
    }
    var size_register = lowering.constant(size)
    var scaled = lowering.new_register()
    var multiplied = LowIntermediaryRepresentation.Instructions.Arithmetic(scaled, 'multiply', at, size_register)
    multiplied.is_checked = false
    lowering.emit(multiplied)
    return lowering.address_plus(storage, scaled)
}

func item_size_of(element: Model.Type): Integer {
    if element.kind != 'scalar' {
        return 8
    }
    var scalar = lowering.scalars.of(element.name)
    crash scalar
    return scalar.size
}

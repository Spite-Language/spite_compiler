var state = FunctionLoweringState()
var fills = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var given = Dictionary<String, SpiteCompiler.Value>()

func StaticClassObjects(starting_state: FunctionLoweringState) {
    state = starting_state
}

# ../../OPTIMIZATIONS.md#a-class-object-is-static-data
func address_of(slot_key: String): Integer {
    var lowering = FunctionLowering(state)
    var label = label_of(slot_key)
    var object = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(object, label)
    lowering.emit(addressed)
    return object
}

func label_of(slot_key: String): Integer {
    var known = state.program.static_objects[slot_key]
    if known {
        return known
    }
    var lowering = FunctionLowering(state)
    var kind = kind_of(slot_key)
    var size = state.layout.made_size_of(kind)
    var bytes = Buffer()
    var index = 0
    while index < size {
        bytes.append(0)
        index = index + 1
    }
    var class_id: Long = state.layout.class_id_of(kind)
    bytes.write_long_little_endian_at(0, class_id)
    bytes.write_long_little_endian_at(8, state.layout.immortal_count)
    if state.layout.is_back_held(kind) {
        var back_slot = state.layout.back_offset_of(kind)
        var one: Long = 1
        bytes.write_long_little_endian_at(back_slot, one)
    }
    var label = lowering.data_label(bytes)
    state.program.static_objects[slot_key] = label
    return label
}

func kind_of(slot_key: String): String {
    var colon = slot_key.index_of(":")
    crash colon
    var kind = slot_key.slice(0, colon)
    crash kind
    return kind
}

func described_of(slot_key: String): String {
    var colon = slot_key.index_of(":")
    crash colon
    var key_length = slot_key.length()
    var described = slot_key.slice(colon + 1, key_length)
    crash described
    return described
}

# ../../OPTIMIZATIONS.md#a-class-object-is-static-data
func write_the_whole(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var index = 0
    while index < high.context.fills.count() {
        var fill_function = high.context.fills[index]
        var known = high.context.filled[index]
        crash known
        fills[known] = fill_function
        index = index + 1
    }
    high.built_functions.each(note_a_body)
    state.program.static_class_objects.each(write_if_whole)
}

func note_a_body(built: HighIntermediaryRepresentation.HighFunction) {
    var key = built.function.key()
    bodies[key] = built
}

func write_if_whole(slot_key: String) {
    fallback is_written_whole(slot_key)
    state.program.whole_class_objects.append(slot_key)
    var kind = kind_of(slot_key)
    var described = described_of(slot_key)
    state.program.whole_class_object_fills.append("{kind}._fill_{described}")
}

# ../../OPTIMIZATIONS.md#a-class-object-is-static-data
func fill_them_all() {
    state.program.static_class_objects.each(fill)
}

func fill(slot_key: String) {
    fallback not state.program.whole_class_objects.contains(slot_key)
    var lowering = FunctionLowering(state)
    var singletons = Singletons(state)
    var kind = kind_of(slot_key)
    var described = described_of(slot_key)
    var object = address_of(slot_key)
    run_the_defaults(kind, object)
    var label = singletons.slot_label_of(slot_key)
    var slot = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    lowering.emit(addressed)
    var stored = LowIntermediaryRepresentation.Instructions.Store(slot, 0, object, 'bits_64', "", false)
    lowering.emit(stored)
    singletons.record_with(slot, "_let_go_of_reflected_{kind}")
    var arguments = List<Integer>()
    arguments.append(object)
    var filling = LowIntermediaryRepresentation.Instructions.Call(-1, "{kind}._fill_{described}", arguments, -1, false)
    lowering.emit(filling)
    var filled = lowering.constant(2)
    var marked = LowIntermediaryRepresentation.Instructions.Store(slot, 16, filled, 'bits_64', "", false)
    lowering.emit(marked)
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func run_the_defaults(kind: String, object: Integer) {
    var lowering = FunctionLowering(state)
    var model = state.layout.program.class_named(kind)
    crash model
    var defaults_key = "{kind}._attribute_defaults"
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var constructor_key = declared.key()
        if declared.is_a_constructor() and state.trimmed_keys.contains(constructor_key) {
            defaults_key = "{constructor_key}$defaults"
        }
        index = index + 1
    }
    var arguments = List<Integer>()
    arguments.append(object)
    var defaults = LowIntermediaryRepresentation.Instructions.Call(-1, defaults_key, arguments, -1, false)
    lowering.emit(defaults)
}

# ../../OPTIMIZATIONS.md#a-class-object-is-static-data
func is_written_whole(slot_key: String): Boolean {
    var constructing = constructor_call_of(slot_key)
    fallback constructing
    var constructor_key = constructing.function.key()
    var constructor = bodies[constructor_key]
    fallback constructor
    given = Dictionary<String, SpiteCompiler.Value>()
    fallback constructor.body.statements.all(is_a_plain_write)
    fallback gives_the_arguments(constructing, constructor.function)
    var kind = kind_of(slot_key)
    var model = state.layout.program.class_named(kind)
    crash model
    fallback model.declared_attributes.all(is_given_whole)
    var label = label_of(slot_key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        write_an_attribute(label, attribute)
        index = index + 1
    }
    return true
}

func constructor_call_of(slot_key: String): HighIntermediaryRepresentation.Values.Call? {
    var fill_function = fills[slot_key]
    fallback fill_function
    var statements = fill_function.body.statements
    fallback statements.count() == 1
    var statement = statements[0]
    fallback statement.class == HighIntermediaryRepresentation.Statements.Evaluate
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
    fallback statement.value.function.is_a_constructor()
    fallback statement.value.receiver and statement.value.receiver.class == HighIntermediaryRepresentation.Values.ThisRead
    return statement.value
}

func is_a_plain_write(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Assign.Attribute
    fallback statement.object and statement.object.class == HighIntermediaryRepresentation.Values.ThisRead
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.LocalRead
    var name = statement.attribute.name
    fallback not given.contains(name)
    given[name] = statement.value
    return true
}

func gives_the_arguments(
    constructing: HighIntermediaryRepresentation.Values.Call,
    constructor: Model.FunctionModel,
): Boolean {
    var parameters = constructor.parameters
    fallback parameters.count() == constructing.arguments.count()
    var names = given.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var read = given[name]
        crash read
        fallback read.class == HighIntermediaryRepresentation.Values.LocalRead
        var position = parameter_position(parameters, read.name)
        fallback position
        var argument = constructing.arguments[position]
        crash argument
        given[name] = argument
        index = index + 1
    }
    return true
}

func parameter_position(parameters: List<Model.ParameterModel>, name: String): Integer? {
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        if parameter.name == name {
            return index
        }
        index = index + 1
    }
    return null
}

func is_given_whole(attribute: Model.AttributeModel): Boolean {
    if not state.layout.has_a_slot(attribute) {
        return true
    }
    var key = "{attribute.owner}.{attribute.name}"
    fallback state.layout.has_slot_named(key)
    fallback not state.layout.is_embedded(attribute) and not state.layout.is_lent(attribute)
    fallback not state.layout.is_back(attribute)
    var held = attribute.attribute_type
    fallback not state.layout.is_a_nullable_scalar(held)
    var value = given[attribute.name]
    fallback value
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.lives_in_data and state.layout.holds_texts_whole()
    }
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return is_a_written_number(held)
    }
    if value.class == HighIntermediaryRepresentation.Values.NullConstant {
        return held.kind == 'object'
    }
    if value.class == HighIntermediaryRepresentation.Values.Class.Object {
        return is_static(value)
    }
    return false
}

func is_a_written_number(held: Model.Type): Boolean {
    fallback held.kind == 'scalar'
    var lowering = FunctionLowering(state)
    var width = lowering.width_of(held)
    return width == 'bits_8' or width == 'bits_32' or width == 'bits_64'
}

func is_static(object: HighIntermediaryRepresentation.Values.Class.Object): Boolean {
    return state.program.static_class_objects.contains("{object.reflection_kind}:{object.described}")
}

func write_an_attribute(label: Integer, attribute: Model.AttributeModel) {
    fallback state.layout.has_a_slot(attribute)
    var value = given[attribute.name]
    crash value
    var offset = state.layout.offset_of(attribute)
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        point_at_a_text(label, offset, value.text)
    } else if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        write_a_number(label, offset, attribute.attribute_type, value.number)
    } else if value.class == HighIntermediaryRepresentation.Values.Class.Object {
        point_at_an_object(label, offset, value)
    }
}

func point_at_a_text(label: Integer, offset: Integer, text: String) {
    var lowering = FunctionLowering(state)
    var joins = TextJoins(lowering)
    var text_label = joins.constant_text_label(text)
    state.program.note_a_pointer_to(label, offset, text_label, 0)
}

func point_at_an_object(label: Integer, offset: Integer, object: HighIntermediaryRepresentation.Values.Class.Object) {
    var object_label = label_of("{object.reflection_kind}:{object.described}")
    state.program.note_a_pointer_to(label, offset, object_label, 0)
}

func write_a_number(label: Integer, offset: Integer, held: Model.Type, number: Long) {
    var lowering = FunctionLowering(state)
    var bytes = state.program.data[label]
    crash bytes
    var width = lowering.width_of(held)
    if width == 'bits_64' {
        bytes.write_long_little_endian_at(offset, number)
        return
    }
    var narrowed: Integer? = number
    crash narrowed
    if width == 'bits_32' {
        bytes.write_integer_little_endian_at(offset, narrowed)
        return
    }
    var low: Byte? = narrowed
    crash low
    bytes[offset] = low
}

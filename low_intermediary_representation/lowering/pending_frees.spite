# ../../OPTIMIZATIONS.md#freeing-a-deep-structure-takes-no-stack-per-level

var _word = 8
var _room_offset = 8
var _links_offset = 16
var _first_room = 16
var _out_of_memory = "spite: the program ran out of memory while freeing a deep structure\n"
var no_state = FunctionLoweringState()
var lowering = FunctionLowering(no_state)
var machine = MachineWriting(lowering)

func PendingFrees(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
    machine = MachineWriting(starting_lowering)
}

func write() {
    write_the_free_later()
    write_the_free_the_pending()
    write_the_free_a_pending()
}

func write_the_free_later() {
    machine.begin("_free_later", 2)
    var missing = machine.is_zero(1)
    var present = machine.opened_when(missing)
    machine.answered(0)
    machine.closed(present)
    var pending = machine.kept(0)
    var none_yet = machine.is_zero(pending)
    var made = machine.opened_when(none_yet)
    var size = _links_offset + _first_room * _word
    var size_register = machine.constant_of(size)
    var heap = process_heap()
    var nothing = machine.constant_of(0)
    var asked = machine.three_listed(heap, nothing, size_register)
    var fresh = machine.imported("HeapAlloc", asked)
    stop_without(fresh)
    machine.stored_number(fresh, 0, 0)
    machine.stored_number(fresh, _room_offset, _first_room)
    machine.copied(pending, fresh)
    machine.closed(made)
    var count = machine.loaded(pending, 0)
    var room = machine.loaded(pending, _room_offset)
    var full = machine.compared('equal', count, room)
    var roomy = machine.opened_when(full)
    grow(pending, room)
    machine.closed(roomy)
    var word = machine.constant_of(_word)
    var scaled = machine.product_of(count, word)
    var place = machine.sum_of(pending, scaled)
    machine.stored(place, _links_offset, 1)
    var more = machine.plus_number(count, 1)
    machine.stored(pending, 0, more)
    machine.answered(pending)
    machine.finish()
}

func grow(pending: Integer, room: Integer) {
    var doubled = machine.sum_of(room, room)
    var word = machine.constant_of(_word)
    var bytes = machine.product_of(doubled, word)
    var size = machine.plus_number(bytes, _links_offset)
    var heap = process_heap()
    var nothing = machine.constant_of(0)
    var asked = machine.three_listed(heap, nothing, pending)
    asked.append(size)
    var moved = machine.imported("HeapReAlloc", asked)
    stop_without(moved)
    machine.stored(moved, _room_offset, doubled)
    machine.copied(pending, moved)
}

func write_the_free_the_pending() {
    machine.begin("_free_the_pending", 1)
    var pending = machine.kept(0)
    var empty = machine.is_zero(pending)
    var started = machine.opened_when(empty)
    machine.answered_nothing()
    machine.closed(started)
    var top = machine.loop_top()
    var count = machine.loaded(pending, 0)
    var any = machine.compared_to('greater', count, 0)
    var done = machine.loop_while(any)
    var left = machine.plus_number(count, -1)
    machine.stored(pending, 0, left)
    var word = machine.constant_of(_word)
    var scaled = machine.product_of(left, word)
    var place = machine.sum_of(pending, scaled)
    var link = machine.loaded(place, _links_offset)
    var passed = machine.two_listed(link, pending)
    var after = machine.called("_free_a_pending", passed)
    machine.copied(pending, after)
    machine.loop_back(top, done)
    var heap = process_heap()
    var nothing = machine.constant_of(0)
    var given_back = machine.three_listed(heap, nothing, pending)
    machine.call_imported("HeapFree", given_back)
    machine.answered_nothing()
    machine.finish()
}

func write_the_free_a_pending() {
    machine.begin("_free_a_pending", 2)
    var left = counted_down(0)
    var held = machine.compared_to('not_equal', left, 0)
    var gone = machine.opened_when(held)
    if machine.program.collects_cycles {
        let_a_suspect_go(left)
    }
    machine.answered(1)
    machine.closed(gone)
    var passed = machine.two_listed(0, 1)
    var after = machine.called("_free_onto_by_class", passed)
    machine.answered(after)
    machine.finish()
}

func counted_down(object: Integer): Integer {
    if machine.program.uses_threads {
        var left = machine.writing.new_register()
        var decremented = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, object, 8, -1)
        decremented.is_a_count = true
        machine.writing.emit(decremented)
        return left
    }
    var count = machine.loaded(object, 8)
    var lowered = machine.plus_number(count, -1)
    machine.stored(object, 8, lowered)
    return lowered
}

func process_heap(): Integer {
    var no_arguments = machine.none_listed()
    return machine.imported("GetProcessHeap", no_arguments)
}

func stop_without(block: Integer) {
    var missing = machine.is_zero(block)
    var made = machine.opened_when(missing)
    var label = machine.writing.text_label(_out_of_memory)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label, false)
    machine.writing.emit(stopped)
    machine.closed(made)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func let_a_suspect_go(left: Integer) {
    var negative = machine.compared_to('less', left, 0)
    var plain = machine.opened_when(negative)
    var passed = machine.two_listed(0, left)
    var let_go = machine.called("_cycle_let_go", passed)
    var kept = machine.is_zero(let_go)
    var freeing = machine.opened_when(kept)
    machine.answered(1)
    machine.closed(freeing)
    var pending = machine.two_listed(0, 1)
    var after = machine.called("_free_onto_by_class", pending)
    machine.answered(after)
    machine.closed(plain)
}

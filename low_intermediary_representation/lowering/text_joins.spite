# ../../OPTIMIZATIONS.md#text-joined-in-one-piece
var no_program = Model.ProgramModel()
var no_layout = Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LowProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var library = Validators.LibraryFile()
var made = -1

func TextJoins(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func is_a_join(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if not call.is_a_join or call.arguments.count() != 1 {
        return false
    }
    if call.function.key() != "String.sum" or not call.function.declaration {
        return false
    }
    var written = call.function.declaration.path.replace("\\", "/")
    return library.holds(written) and written.ends_with("/common/string.spite")
}

func joined(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var pieces = List<HighIntermediaryRepresentation.Values.Value>()
    gather(call, pieces)
    made = lowering.make_object("String")
    pieces.each(append_a_piece)
    return lowering.owned(made)
}

func gather(
    call: HighIntermediaryRepresentation.Values.Call,
    pieces: List<HighIntermediaryRepresentation.Values.Value>,
) {
    crash call.receiver
    gather_a_receiver(call.receiver, pieces)
    var piece = call.arguments[0]
    crash piece
    pieces.append(piece)
}

func gather_a_receiver(
    receiver: HighIntermediaryRepresentation.Values.Value,
    pieces: List<HighIntermediaryRepresentation.Values.Value>,
) {
    if receiver == HighIntermediaryRepresentation.Values.Call {
        gather_a_call(receiver, pieces)
        return
    }
    pieces.append(receiver)
}

func gather_a_call(
    call: HighIntermediaryRepresentation.Values.Call,
    pieces: List<HighIntermediaryRepresentation.Values.Value>,
) {
    if is_a_join(call) {
        gather(call, pieces)
        return
    }
    pieces.append(call)
}

func append_a_piece(piece: HighIntermediaryRepresentation.Values.Value) {
    if piece == HighIntermediaryRepresentation.Values.TextConstant {
        append_the_constant(piece)
        return
    }
    if piece == HighIntermediaryRepresentation.Values.Call {
        append_a_call(piece)
        return
    }
    append_the_text(piece)
}

func append_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var numbers = NumberTexts(lowering)
    if numbers.is_a_number_text(call) {
        numbers.append_the_digits(call, made)
        return
    }
    append_the_text(call)
}

func append_the_text(piece: HighIntermediaryRepresentation.Values.Value) {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    var lowered = lowering.lower_value(piece)
    lowering.release_later(lowered, piece.value_type)
    var arguments = List<Integer>()
    arguments.append(made)
    arguments.append(lowered.value)
    var appended = LowIntermediaryRepresentation.Instructions.Call(-1, "String._append_text", arguments)
    lowering.emit(appended)
    lowering.release_the_pending()
    lowering.pending_releases = outer
}

func append_the_constant(text: HighIntermediaryRepresentation.Values.TextConstant) {
    var label = lowering.text_label(text.text)
    var bytes = lowering.new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(bytes, label)
    lowering.emit(addressed)
    var length = text.text.length()
    var index = 0
    while index < length {
        var offset_register = lowering.constant(index)
        var code = lowering.load_byte(bytes, offset_register)
        var arguments = List<Integer>()
        arguments.append(made)
        arguments.append(code)
        var appended = LowIntermediaryRepresentation.Instructions.Call(-1, "String.append_code", arguments)
        lowering.emit(appended)
        index = index + 1
    }
}

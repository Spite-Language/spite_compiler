union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#text-joined-in-one-piece
var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var library = Validators.LibraryFile()
var kinds = List<Integer>()
var values = List<Integer>()
var lengths = List<Integer>()
var labels = List<Integer>()
var known_length = 0
var added = -1
var is_fresh = false
var holds_on = false
var written_kind = 0
var text_kind = 1
var number_kind = 2
var address_kind = 3

func TextJoins(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func copied_c_text(address: Integer, function_name: String): Lowered {
    var zero = lowering.constant(0)
    var is_missing = lowering.new_register()
    var tested = LowIntermediaryRepresentation.Instructions.Compare(is_missing, 'equal', address, zero)
    lowering.emit(tested)
    var missing = lowering.new_block()
    var present = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_missing, missing, present)
    lowering.emit(test)
    lowering.switch_to(missing)
    var path = lowering.path
    var line = lowering.line
    var message = "spite: the foreign function '{function_name}' answered no text (a null pointer) for its '_as_text' call, at {path}:{line}\n"
    var label = lowering.text_label(message)
    var stopped = LowIntermediaryRepresentation.Instructions.Stop(label)
    lowering.emit(stopped)
    lowering.switch_to(present)
    var length = counted_length(address)
    note(address_kind, address, length, -1)
    var made = fresh_text()
    write_the_pieces(made)
    return lowering.owned(made)
}

func counted_length(address: Integer): Integer {
    var length = lowering.new_register()
    var started = lowering.constant(0)
    copy(length, started)
    var testing = lowering.new_block()
    var counting = lowering.new_block()
    var counted = lowering.new_block()
    lowering.jump_to(testing)
    lowering.switch_to(testing)
    var at = lowering.address_plus(address, length)
    var code = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(code, at, 0, 'bits_8')
    loaded.is_signed = false
    lowering.emit(loaded)
    var zero = lowering.constant(0)
    var is_the_end = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(is_the_end, 'equal', code, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(is_the_end, counted, counting)
    lowering.emit(test)
    lowering.switch_to(counting)
    var one = lowering.constant(1)
    var longer = unchecked('add', length, one)
    copy(length, longer)
    lowering.jump_to(testing)
    lowering.switch_to(counted)
    return length
}

func is_a_join(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.is_a_join and call.arguments.count() == 1
    return is_the_librarys(call, "String.sum")
}

func is_an_append(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.receiver and call.arguments.count() == 1
    return is_the_librarys(call, "String._append_text")
}

func is_the_librarys(call: HighIntermediaryRepresentation.Values.Call, key: String): Boolean {
    fallback call.function.key() == key and call.function.declaration
    var written = call.function.declaration.path.replace("\\", "/")
    return library.holds(written) and written.ends_with("/common/string.spite")
}

func joined(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var pieces = List<Value>()
    gather(call, pieces)
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    note_the_pieces(pieces)
    var made = fresh_text()
    write_the_pieces(made)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    return lowering.owned(made)
}

func appended(call: HighIntermediaryRepresentation.Values.Call): Lowered {
    var outer = lowering.pending_releases
    lowering.pending_releases = List<Integer>()
    crash call.receiver
    var receiver = lowering.lower_value(call.receiver)
    lowering.release_later(receiver, call.receiver.value_type)
    var piece = call.arguments[0]
    crash piece
    var pieces = List<Value>()
    gather_a_piece(piece, pieces)
    note_the_pieces(pieces)
    write_the_pieces(receiver.value)
    lowering.release_the_pending()
    lowering.pending_releases = outer
    return lowering.single(-1)
}

func lower_text(text: HighIntermediaryRepresentation.Values.TextConstant): Lowered {
    note_a_piece(text)
    var made = fresh_text()
    write_the_pieces(made)
    return lowering.owned(made)
}

func fresh_text(): Integer {
    if not lowering.layout.holds_texts_whole() {
        return lowering.make_object("String")
    }
    is_fresh = true
    var length = added_length()
    var one = lowering.constant(1)
    var room = lowering.new_register()
    var with_an_end = unchecked('add', length, one)
    copy(room, with_an_end)
    var least = lowering.constant(lowering.layout.inline_room)
    var small = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(small, 'less', room, least)
    lowering.emit(compared)
    var widening = lowering.new_block()
    var sized = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(small, widening, sized)
    lowering.emit(test)
    lowering.switch_to(widening)
    copy(room, least)
    lowering.jump_to(sized)
    lowering.switch_to(sized)
    return whole_text(room)
}

func empty_text(default_room: Integer): Integer {
    var room_value = default_room + 1
    if room_value < lowering.layout.inline_room {
        room_value = lowering.layout.inline_room
    }
    var room = lowering.constant(room_value)
    return whole_text(room)
}

func whole_text(room: Integer): Integer {
    var one = lowering.constant(1)
    var offset = lowering.layout.inline_offset()
    var inline_offset = lowering.constant(offset)
    var text_size_value = lowering.layout.size_of("String")
    var text_size = lowering.constant(text_size_value)
    var buffer_size = unchecked('add', inline_offset, room)
    var whole_size = unchecked('add', text_size, buffer_size)
    var made = allocated("String", whole_size, text_size_value + offset)
    var buffer = unchecked('add', made, text_size)
    header(buffer, "Buffer")
    var flag = lowering.constant(1)
    var text_flag_offset = lowering.layout.text_flag_offset()
    var stored_text_flag = LowIntermediaryRepresentation.Instructions.Store(made, text_flag_offset, flag, 'bits_8')
    lowering.emit(stored_text_flag)
    var embedded_offset = lowering.layout.embedded_flag_offset()
    var stored_flag = LowIntermediaryRepresentation.Instructions.Store(buffer, embedded_offset, flag, 'bits_8')
    lowering.emit(stored_flag)
    var inside = unchecked('add', buffer, inline_offset)
    var storage_offset = lowering.layout.storage_offset
    var stored_storage = LowIntermediaryRepresentation.Instructions.Store(buffer, storage_offset, inside, 'bits_64')
    lowering.emit(stored_storage)
    var capacity = unchecked('subtract', room, one)
    var capacity_offset = buffer_offset("_capacity")
    var stored_capacity = LowIntermediaryRepresentation.Instructions.Store(buffer, capacity_offset, capacity, 'bits_32')
    lowering.emit(stored_capacity)
    var buffer_slot = string_offset("_buffer")
    var stored_buffer = LowIntermediaryRepresentation.Instructions.Store(made, buffer_slot, buffer, 'bits_64')
    lowering.emit(stored_buffer)
    return made
}

func allocated(class_key: String, size: Integer, zeroed_bytes: Integer): Integer {
    var object = lowering.new_register()
    var made = LowIntermediaryRepresentation.Instructions.Allocate(object, size)
    made.class_id = lowering.layout.class_id_of(class_key)
    made.zeroed_bytes = zeroed_bytes
    lowering.emit(made)
    header(object, class_key)
    return object
}

func header(object: Integer, class_key: String) {
    var class_id = lowering.layout.class_id_of(class_key)
    var id_register = lowering.constant(class_id)
    var stored_id = LowIntermediaryRepresentation.Instructions.Store(object, 0, id_register, 'bits_64')
    lowering.emit(stored_id)
    var one = lowering.constant(1)
    var stored_count = LowIntermediaryRepresentation.Instructions.Store(object, 8, one, 'bits_64')
    lowering.emit(stored_count)
}

func added_length(): Integer {
    if added >= 0 {
        return added
    }
    var summed = lowering.constant(known_length)
    var index = 0
    while index < kinds.count() {
        var kind = kinds[index]
        var length = lengths[index]
        crash length
        if kind != written_kind {
            var more = unchecked('add', summed, length)
            summed = more
        }
        index = index + 1
    }
    added = summed
    return summed
}

func gather(
    call: HighIntermediaryRepresentation.Values.Call,
    pieces: List<Value>,
) {
    crash call.receiver
    gather_a_piece(call.receiver, pieces)
    var piece = call.arguments[0]
    crash piece
    pieces.append(piece)
}

func gather_a_piece(
    piece: Value,
    pieces: List<Value>,
) {
    if piece.class == HighIntermediaryRepresentation.Values.Call {
        gather_a_call(piece, pieces)
        return
    }
    pieces.append(piece)
}

func gather_a_call(
    call: HighIntermediaryRepresentation.Values.Call,
    pieces: List<Value>,
) {
    if is_a_join(call) {
        gather(call, pieces)
        return
    }
    pieces.append(call)
}

func note_a_piece(piece: Value) {
    if piece.class == HighIntermediaryRepresentation.Values.TextConstant {
        note_the_written(piece)
        return
    }
    if piece.class == HighIntermediaryRepresentation.Values.Call {
        note_a_call(piece)
        return
    }
    note_the_text(piece)
}

func note_the_written(text: HighIntermediaryRepresentation.Values.TextConstant) {
    var length = text.text.length()
    fallback length != 0
    var label = lowering.text_label(text.text)
    var length_register = lowering.constant(length)
    note(written_kind, -1, length_register, label)
    known_length = known_length + length
}

func note_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var numbers = NumberTexts(lowering)
    if numbers.is_a_number_text(call) {
        var number = numbers.number_of(call)
        var length = numbers.length_of(number)
        note(number_kind, number, length, -1)
        return
    }
    note_the_text(call)
}

func note_the_pieces(pieces: List<Value>) {
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        holds_on = calls_after(pieces, index)
        note_a_piece(piece)
        index = index + 1
    }
    holds_on = false
}

func calls_after(pieces: List<Value>, index: Integer): Boolean {
    var found = false
    var later = index + 1
    while later < pieces.count() and not found {
        var piece = pieces[later]
        found = piece.class == HighIntermediaryRepresentation.Values.Call
        later = later + 1
    }
    return found
}

func note_the_text(piece: Value) {
    var lowered = lowering.lower_value(piece)
    var is_a_pointer = lowering.is_a_pointer(piece.value_type)
    if holds_on and is_a_pointer and not lowered.owned {
        lowering.retain(lowered.value)
        lowering.pending_releases.append(lowered.value)
    } else {
        lowering.release_later(lowered, piece.value_type)
    }
    var length = length_of(lowered.value)
    note(text_kind, lowered.value, length, -1)
}

func note(kind: Integer, value: Integer, length: Integer, label: Integer) {
    kinds.append(kind)
    values.append(value)
    lengths.append(length)
    labels.append(label)
}

func write_the_pieces(made: Integer) {
    fallback not kinds.is_empty()
    var length = added_length()
    var start = lowering.constant(0)
    if not is_fresh {
        var held = length_of(made)
        start = held
        make_room(made, start, length)
    }
    var storage = lowering.bytes_of_text(made)
    var beginning = lowering.address_plus(storage, start)
    var position = lowering.new_register()
    copy(position, beginning)
    var index = 0
    while index < kinds.count() {
        write_a_piece(index, position)
        index = index + 1
    }
    var total = unchecked('add', start, length)
    store_the_length(made, total)
}

func write_a_piece(index: Integer, position: Integer) {
    var kind = kinds[index]
    var value = values[index]
    var length = lengths[index]
    var label = labels[index]
    crash kind
    crash value
    crash length
    crash label
    if kind == number_kind {
        var numbers = NumberTexts(lowering)
        numbers.write_the_digits(value, position, length)
    } else {
        var source = source_of(kind, value, label)
        var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(position, source, length)
        lowering.emit(copied)
    }
    var moved = lowering.address_plus(position, length)
    copy(position, moved)
}

func source_of(kind: Integer, value: Integer, label: Integer): Integer {
    if kind == written_kind {
        var bytes = lowering.new_register()
        var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(bytes, label)
        lowering.emit(addressed)
        return bytes
    }
    if kind == address_kind {
        return value
    }
    return lowering.bytes_of_text(value)
}

func make_room(made: Integer, start: Integer, added: Integer) {
    var buffer = buffer_of(made)
    var capacity_offset = buffer_offset("_capacity")
    var capacity = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(capacity, buffer, capacity_offset, 'bits_32')
    lowering.emit(loaded)
    var wanted = unchecked('add', start, added)
    var full = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(full, 'greater', wanted, capacity)
    lowering.emit(compared)
    var growing = lowering.new_block()
    var roomy = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(full, growing, roomy)
    lowering.emit(test)
    lowering.switch_to(growing)
    var arguments = List<Integer>()
    arguments.append(made)
    arguments.append(added)
    var grown = LowIntermediaryRepresentation.Instructions.Call(-1, "String._make_room_for", arguments)
    lowering.emit(grown)
    lowering.jump_to(roomy)
    lowering.switch_to(roomy)
}

func store_the_length(made: Integer, total: Integer) {
    var length_offset = string_offset("_length")
    var stored = LowIntermediaryRepresentation.Instructions.Store(made, length_offset, total, 'bits_32')
    lowering.emit(stored)
    var buffer = buffer_of(made)
    var count_offset = buffer_offset("item_count")
    var counted = LowIntermediaryRepresentation.Instructions.Store(buffer, count_offset, total, 'bits_32')
    lowering.emit(counted)
}

func length_of(text: Integer): Integer {
    var length_offset = string_offset("_length")
    var length = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(length, text, length_offset, 'bits_32')
    lowering.emit(loaded)
    return length
}

func buffer_of(text: Integer): Integer {
    var buffer_offset_in_text = string_offset("_buffer")
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, text, buffer_offset_in_text, 'bits_64')
    lowering.emit(loaded)
    return buffer
}

func string_offset(name: String): Integer {
    var owner = lowering.layout.program.class_named("String")
    crash owner
    var attribute = owner.attribute_named(name)
    crash attribute
    return lowering.layout.offset_of(attribute)
}

func buffer_offset(name: String): Integer {
    var owner = lowering.layout.program.class_named("Buffer")
    crash owner
    var attribute = owner.attribute_named(name)
    crash attribute
    return lowering.layout.offset_of(attribute)
}

func unchecked(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator, left: Integer, right: Integer): Integer {
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.is_checked = false
    lowering.emit(computed)
    return target
}

func copy(target: Integer, source: Integer) {
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, source)
    lowering.emit(copied)
}

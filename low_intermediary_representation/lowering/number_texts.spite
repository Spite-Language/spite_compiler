union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#a-number-joined-into-text-is-written-in-place
var no_program = Model.ProgramModel()
var no_layout = HighIntermediaryRepresentation.Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LoweredProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var library = Validators.LibraryFile()
var zero = -1
var ten = -1

func NumberTexts(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func is_a_number_text(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var key = call.function.key()
    var file_name = "integer.spite"
    if key == "Long.to_string" {
        file_name = "long.spite"
    } else if key != "Integer.to_string" {
        return false
    }
    if not call.arguments.is_empty() or not call.function.declaration {
        return false
    }
    var written = call.function.declaration.path.replace("\\", "/")
    if not library.holds(written) or not written.ends_with("/common/{file_name}") {
        return false
    }
    return is_held_as_a_value(call.receiver)
}

func is_held_as_a_value(receiver: Value?): Boolean {
    if not receiver {
        return false
    }
    if receiver == HighIntermediaryRepresentation.Values.Conversion {
        return receiver.kind != 'address'
    }
    return receiver.value_type.kind == 'scalar'
}

func number_of(call: HighIntermediaryRepresentation.Values.Call): Integer {
    crash call.receiver
    var lowered = lowering.lower_value(call.receiver)
    return lowered.value
}

func length_of(number: Integer): Integer {
    zero = lowering.constant(0)
    ten = lowering.constant(10)
    var one = lowering.constant(1)
    var digits = lowering.new_register()
    copy(digits, one)
    var left = lowering.new_register()
    var first_left = unchecked('divide', number, ten)
    copy(left, first_left)
    var testing = lowering.new_block()
    var counting = lowering.new_block()
    var counted = lowering.new_block()
    lowering.jump_to(testing)
    lowering.switch_to(testing)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'not_equal', left, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, counting, counted)
    lowering.emit(test)
    lowering.switch_to(counting)
    var added = unchecked('add', digits, one)
    copy(digits, added)
    var divided = unchecked('divide', left, ten)
    copy(left, divided)
    lowering.jump_to(testing)
    lowering.switch_to(counted)
    var negative = is_negative(number)
    var signing = lowering.new_block()
    var signed = lowering.new_block()
    var sign_test = LowIntermediaryRepresentation.Instructions.Branch(negative, signing, signed)
    lowering.emit(sign_test)
    lowering.switch_to(signing)
    var with_the_sign = unchecked('add', digits, one)
    copy(digits, with_the_sign)
    lowering.jump_to(signed)
    lowering.switch_to(signed)
    return digits
}

func write_the_digits(number: Integer, start: Integer, length: Integer) {
    zero = lowering.constant(0)
    ten = lowering.constant(10)
    var one = lowering.constant(1)
    var nought = lowering.constant(48)
    var beyond = lowering.address_plus(start, length)
    var position = lowering.new_register()
    var last = unchecked('subtract', beyond, one)
    copy(position, last)
    var left = lowering.new_register()
    copy(left, number)
    var writing = lowering.new_block()
    var written = lowering.new_block()
    lowering.jump_to(writing)
    lowering.switch_to(writing)
    var digit = remainder_by_ten(left)
    var code = unchecked('add', digit, nought)
    var stored = LowIntermediaryRepresentation.Instructions.Store(position, 0, code, 'bits_8')
    lowering.emit(stored)
    var moved = unchecked('subtract', position, one)
    copy(position, moved)
    var divided = unchecked('divide', left, ten)
    copy(left, divided)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'not_equal', left, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, writing, written)
    lowering.emit(test)
    lowering.switch_to(written)
    var negative = is_negative(number)
    var signing = lowering.new_block()
    var signed = lowering.new_block()
    var sign_test = LowIntermediaryRepresentation.Instructions.Branch(negative, signing, signed)
    lowering.emit(sign_test)
    lowering.switch_to(signing)
    var minus = lowering.constant(45)
    var stored_minus = LowIntermediaryRepresentation.Instructions.Store(start, 0, minus, 'bits_8')
    lowering.emit(stored_minus)
    lowering.jump_to(signed)
    lowering.switch_to(signed)
}

func is_negative(number: Integer): Integer {
    var negative = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(negative, 'less', number, zero)
    lowering.emit(compared)
    return negative
}

func remainder_by_ten(left: Integer): Integer {
    var digit = lowering.new_register()
    var remainder = unchecked('remainder', left, ten)
    copy(digit, remainder)
    var negative = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(negative, 'less', digit, zero)
    lowering.emit(compared)
    var flipping = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(negative, flipping, after)
    lowering.emit(test)
    lowering.switch_to(flipping)
    var flipped = unchecked('subtract', zero, digit)
    copy(digit, flipped)
    lowering.jump_to(after)
    lowering.switch_to(after)
    return digit
}

func unchecked(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator, left: Integer, right: Integer): Integer {
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.is_checked = false
    lowering.emit(computed)
    return target
}

func copy(target: Integer, source: Integer) {
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, source)
    lowering.emit(copied)
}

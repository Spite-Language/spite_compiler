# ../../OPTIMIZATIONS.md#a-number-joined-into-text-is-written-in-place
var no_program = Model.ProgramModel()
var no_layout = Layout(no_program)
var no_low_program = LowIntermediaryRepresentation.LowProgram()
var no_slots = Dictionary<String, Integer>()
var lowering = FunctionLowering(no_layout, no_low_program, no_slots)
var library = Validators.LibraryFile()
var made = -1
var zero = -1
var ten = -1

func NumberTexts(starting_lowering: FunctionLowering) {
    lowering = starting_lowering
}

func is_a_number_text(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var key = call.function.key()
    var file_name = "integer.spite"
    if key == "Long.to_string" {
        file_name = "long.spite"
    } else if key != "Integer.to_string" {
        return false
    }
    if not call.arguments.is_empty() or not call.function.declaration {
        return false
    }
    var written = call.function.declaration.path.replace("\\", "/")
    if not library.holds(written) or not written.ends_with("/common/{file_name}") {
        return false
    }
    return is_held_as_a_value(call.receiver)
}

func is_held_as_a_value(receiver: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not receiver {
        return false
    }
    if receiver == HighIntermediaryRepresentation.Values.Conversion {
        return receiver.kind != 'address'
    }
    return receiver.value_type.kind == 'scalar'
}

func append_the_digits(call: HighIntermediaryRepresentation.Values.Call, into: Integer) {
    made = into
    crash call.receiver
    var lowered = lowering.lower_value(call.receiver)
    var number = lowered.value
    zero = lowering.constant(0)
    ten = lowering.constant(10)
    append_the_sign(number)
    var digits = count_the_digits(number)
    var owner = lowering.layout.program.class_named("String")
    crash owner
    var start = length_of(owner)
    place_the_digits(digits)
    var storage = storage_of(owner)
    var base = lowering.address_plus(storage, start)
    var beyond = lowering.address_plus(base, digits)
    var one = lowering.constant(1)
    var position = lowering.new_register()
    var last = unchecked('subtract', beyond, one)
    copy(position, last)
    write_the_digits(number, position)
}

func append_the_sign(number: Integer) {
    var negative = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(negative, 'less', number, zero)
    lowering.emit(compared)
    var signing = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(negative, signing, after)
    lowering.emit(test)
    lowering.switch_to(signing)
    var minus = lowering.constant(45)
    append_code(minus)
    lowering.jump_to(after)
    lowering.switch_to(after)
}

func count_the_digits(number: Integer): Integer {
    var left = lowering.new_register()
    copy(left, number)
    var digits = lowering.new_register()
    copy(digits, zero)
    var one = lowering.constant(1)
    var counting = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(counting)
    lowering.switch_to(counting)
    var counted = unchecked('add', digits, one)
    copy(digits, counted)
    var divided = divided_by_ten(left)
    copy(left, divided)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'not_equal', left, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, counting, after)
    lowering.emit(test)
    lowering.switch_to(after)
    return digits
}

func place_the_digits(digits: Integer) {
    var placed = lowering.new_register()
    copy(placed, zero)
    var one = lowering.constant(1)
    var testing = lowering.new_block()
    var placing = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(testing)
    lowering.switch_to(testing)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'less', placed, digits)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, placing, after)
    lowering.emit(test)
    lowering.switch_to(placing)
    var nought = lowering.constant(48)
    append_code(nought)
    var counted = unchecked('add', placed, one)
    copy(placed, counted)
    lowering.jump_to(testing)
    lowering.switch_to(after)
}

func write_the_digits(number: Integer, position: Integer) {
    var left = lowering.new_register()
    copy(left, number)
    var one = lowering.constant(1)
    var nought = lowering.constant(48)
    var writing = lowering.new_block()
    var after = lowering.new_block()
    lowering.jump_to(writing)
    lowering.switch_to(writing)
    var digit = remainder_by_ten(left)
    var code = unchecked('add', digit, nought)
    var stored = LowIntermediaryRepresentation.Instructions.Store(position, 0, code, 'bits_8')
    lowering.emit(stored)
    var moved = unchecked('subtract', position, one)
    copy(position, moved)
    var divided = divided_by_ten(left)
    copy(left, divided)
    var more = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(more, 'not_equal', left, zero)
    lowering.emit(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(more, writing, after)
    lowering.emit(test)
    lowering.switch_to(after)
}

func remainder_by_ten(left: Integer): Integer {
    var digit = lowering.new_register()
    var remainder = unchecked('remainder', left, ten)
    copy(digit, remainder)
    var negative = lowering.new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(negative, 'less', digit, zero)
    lowering.emit(compared)
    var flipping = lowering.new_block()
    var after = lowering.new_block()
    var test = LowIntermediaryRepresentation.Instructions.Branch(negative, flipping, after)
    lowering.emit(test)
    lowering.switch_to(flipping)
    var flipped = unchecked('subtract', zero, digit)
    copy(digit, flipped)
    lowering.jump_to(after)
    lowering.switch_to(after)
    return digit
}

func divided_by_ten(left: Integer): Integer {
    return unchecked('divide', left, ten)
}

func unchecked(operator: LowIntermediaryRepresentation.ArithmeticOperator, left: Integer, right: Integer): Integer {
    var target = lowering.new_register()
    var computed = LowIntermediaryRepresentation.Instructions.Arithmetic(target, operator, left, right)
    computed.is_checked = false
    lowering.emit(computed)
    return target
}

func copy(target: Integer, source: Integer) {
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, source)
    lowering.emit(copied)
}

func append_code(code: Integer) {
    var arguments = List<Integer>()
    arguments.append(made)
    arguments.append(code)
    var appended = LowIntermediaryRepresentation.Instructions.Call(-1, "String.append_code", arguments)
    lowering.emit(appended)
}

func length_of(owner: Model.ClassModel): Integer {
    var length_attribute = owner.attribute_named("_length")
    crash length_attribute
    var offset = lowering.layout.offset_of(length_attribute)
    var length = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(length, made, offset, 'bits_32')
    lowering.emit(loaded)
    return length
}

func storage_of(owner: Model.ClassModel): Integer {
    var buffer_attribute = owner.attribute_named("_buffer")
    crash buffer_attribute
    var offset = lowering.layout.offset_of(buffer_attribute)
    var buffer = lowering.new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(buffer, made, offset, 'bits_64')
    lowering.emit(loaded)
    return lowering.storage_of(buffer)
}

# ../../PROOFS.md#a-function-only-one-thread-runs-counts-plainly

var program = LowIntermediaryRepresentation.LoweredProgram()
var by_key = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var waiting = List<String>()
var reached = Dictionary<String, Boolean>()

func AloneCounts(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
}

func settle() {
    var index = 0
    while index < program.lowered_functions.count() {
        var function = program.lowered_functions[index]
        by_key[function.key] = function
        index = index + 1
    }
    index = 0
    while index < program.lowered_functions.count() {
        var function = program.lowered_functions[index]
        if not function.counts_alone {
            reach(function.key)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        var function = by_key[key]
        if function {
            follow_the_calls(function)
        }
    }
}

func reach(key: String) {
    fallback not reached.contains(key)
    reached[key] = true
    waiting.append(key)
}

func follow_the_calls(function: LowIntermediaryRepresentation.LowFunction) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(follow_an_instruction)
        block_index = block_index + 1
    }
}

func follow_an_instruction(instruction: SpiteCompiler.Instruction) {
    var called = called_key(instruction)
    fallback not called.is_empty()
    var function = by_key[called]
    fallback function
    if function.counts_alone {
        count_atomically(function)
    }
    reach(called)
}

func called_key(instruction: SpiteCompiler.Instruction): String {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.function
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.FunctionAddress {
        return instruction.function
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.StartThread {
        return instruction.entry
    }
    return ""
}

func count_atomically(function: LowIntermediaryRepresentation.LowFunction) {
    function.counts_alone = false
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(count_an_instruction_atomically)
        block_index = block_index + 1
    }
}

func count_an_instruction_atomically(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Retain {
        instruction.is_atomic = true
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call and instruction.function == "_release" {
        instruction.counts_plainly = false
    }
}

var comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison
var limit: Long
var compares_signed: Boolean

func RangeBound(
    starting_comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    starting_limit: Long,
    starting_compares_signed: Boolean,
) {
    comparison = starting_comparison
    limit = starting_limit
    compares_signed = starting_compares_signed
}

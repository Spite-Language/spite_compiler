var empty_classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var empty_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var program = HighIntermediaryRepresentation.Programs.HighProgram(empty_classes, "")
var written = empty_functions
var current = LowIntermediaryRepresentation.Functions.LowFunction("", 0)
var places = Dictionary<String, Integer>()
var registers = List<Integer>()
var next_place = 0
var next_register = 0
var label = 0
var current_class = ""
var built = LowIntermediaryRepresentation.Instructions.InstructionBuild()

func Lowering(starting_program: HighIntermediaryRepresentation.Programs.HighProgram) {
    program = starting_program
}

func lowered(): LowIntermediaryRepresentation.Programs.LowProgram {
    written = List<LowIntermediaryRepresentation.Functions.LowFunction>()
    program.classes.each(lower_class)
    lower_the_entry()
    return LowIntermediaryRepresentation.Programs.LowProgram(written, program.entry)
}

func lower_the_entry() {
    var class = program.class_named(program.entry)
    if class {
        lower_the_entry_of(class)
    } else {
        return
    }
}

func lower_the_entry_of(class: HighIntermediaryRepresentation.Classes.HighClass) {
    places = Dictionary<String, Integer>()
    registers = List<Integer>()
    next_place = 0
    next_register = 0
    label = 0
    current = LowIntermediaryRepresentation.Functions.LowFunction("entry", 0)
    current.class_name = program.entry
    current.parameter_count = 0
    var address = make_the_instance(class)
    var answer = take_register()
    var given = List<Integer>()
    given.append(address)
    var called = built.call(program.entry, program.entry, given, answer)
    emit(called)
    var returned = built.return_value(answer)
    emit(returned)
    current.slots = next_place + next_register
    written.append(current)
}

func lower_class(own: HighIntermediaryRepresentation.Classes.HighClass) {
    current_class = own.name
    own.held_functions.each(lower_function)
}

func lower_function(own: HighIntermediaryRepresentation.Functions.HighFunction) {
    if own.body {
        lower_body_of(own, own.body)
    } else {
        return
    }
}

func lower_body_of(
    own: HighIntermediaryRepresentation.Functions.HighFunction,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    places = Dictionary<String, Integer>()
    registers = List<Integer>()
    next_place = 0
    next_register = 0
    label = 0
    current = LowIntermediaryRepresentation.Functions.LowFunction(own.name, 0)
    current.class_name = current_class
    current.parameter_count = own.parameters.count()
    own.parameters.each(declare_place)
    declare_the_places_of(body)
    lower_block(body)
    var last = built.return_value(-1)
    emit(last)
    current.slots = next_place + next_register
    written.append(current)
}

func declare_the_places_of(body: HighIntermediaryRepresentation.Statements.Block) {
    body.statements.each(read_the_place_of)
}

func read_the_place_of(statement: HighIntermediaryRepresentation.Statements.Statement) {
    if statement == HighIntermediaryRepresentation.Statements.Declare {
        var declaration = statement
        declare_place(declaration.name)
        return
    }
    if statement == HighIntermediaryRepresentation.Statements.Assign {
        var assignment = statement
        declare_place(assignment.name)
        return
    }
    if statement == HighIntermediaryRepresentation.Statements.While {
        var loop = statement
        if loop.body {
            declare_the_places_of(loop.body)
        }
        return
    }
    return
}

func declare_place(name: String) {
    var known = places[name]
    if known {
        return
    } else {
        places[name] = next_place + 1
        next_place = next_place + 1
    }
}

func place_of(name: String): Integer {
    var known = places[name]
    if known {
        return known - 1
    }
    var taken = next_place + next_register
    next_register = next_register + 1
    places[name] = taken + 1
    return taken
}

func take_register(): Integer {
    var taken = next_place + next_register
    next_register = next_register + 1
    return taken
}

func take_block(size: Integer): Integer {
    var slots = size / 4
    var taken = next_place + next_register
    next_register = next_register + slots
    return taken
}

func next_label(): Integer {
    label = label + 1
    return label
}

func emit(added: LowIntermediaryRepresentation.Instructions.Instruction) {
    current.instructions.append(added)
}

func lower_block(block: HighIntermediaryRepresentation.Statements.Block) {
    block.statements.each(lower_statement)
}

func lower_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: lower_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: lower_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.If: lower_if(statement)
        HighIntermediaryRepresentation.Statements.While: lower_while(statement)
        HighIntermediaryRepresentation.Statements.Call: lower_call(statement)
        HighIntermediaryRepresentation.Statements.ForeignCall: lower_held_foreign_call(statement)
        HighIntermediaryRepresentation.Statements.Return: lower_return(statement)
    }
}

func lower_declare(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    var place = place_of(declaration.name)
    var register = lower_value(declaration.value)
    var added = built.write(place, register)
    emit(added)
}

func lower_assign(assignment: HighIntermediaryRepresentation.Statements.Assign) {
    var place = place_of(assignment.name)
    var register = lower_value(assignment.value)
    var added = built.write(place, register)
    emit(added)
}

func lower_while(loop: HighIntermediaryRepresentation.Statements.While) {
    crash loop.condition
    var top = current.instructions.count()
    var test = lower_value(loop.condition)
    var out = built.jump_if_false(test, top)
    emit(out)
    crash loop.body
    lower_block(loop.body)
    var bottom = current.instructions.count()
    var back = built.jump(top)
    emit(back)
    out.to = bottom + 1
}

func lower_if(branch: HighIntermediaryRepresentation.Statements.If) {
    crash branch.condition
    var test = lower_value(branch.condition)
    var out = built.jump_if_false(test, 0)
    emit(out)
    crash branch.then_branch
    lower_block(branch.then_branch)
    var after_then = current.instructions.count()
    if branch.else_branch {
        var over = built.jump(0)
        emit(over)
        out.to = after_then + 1
        lower_block(branch.else_branch)
        over.to = current.instructions.count()
    } else {
        out.to = after_then
    }
}

func lower_assign_attribute(assignment: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    var object = lower_value(assignment.object)
    var offset = offset_of(assignment.class_name, assignment.name)
    var from = lower_value(assignment.value)
    var added = built.write_attribute(object, offset, from)
    emit(added)
}

func lower_call(call: HighIntermediaryRepresentation.Statements.Call) {
    if is_a_constructor(call.callee, call.owner) {
        lower_the_instance(call.callee, call.owner, call.arguments)
        return
    }
    var arguments = lower_arguments(call.arguments)
    var register = take_register()
    var added = built.call(call.callee, call.owner, arguments, register)
    emit(added)
}

func is_a_constructor(callee: String, owner: String): Boolean {
    if callee != owner {
        return false
    }
    var class = program.class_named(owner)
    if class {
        return true
    } else {
        return false
    }
}

func lower_the_instance(
    callee: String,
    owner: String,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
): Integer {
    var class = program.class_named(owner)
    var address = make_the_instance(class)
    var given = lower_arguments(arguments)
    var with_the_instance = List<Integer>()
    with_the_instance.append(address)
    given.each(with_the_instance.append)
    var answer = take_register()
    if has_a_constructor(class) {
        var called = built.call(callee, owner, with_the_instance, answer)
        emit(called)
    }
    return address
}

func has_a_constructor(class: HighIntermediaryRepresentation.Classes.HighClass?): Boolean {
    if not class {
        return false
    }
    var function = class.function_named(class.name)
    if function {
        return true
    } else {
        return false
    }
}

func make_the_instance(class: HighIntermediaryRepresentation.Classes.HighClass?): Integer {
    var size = 0
    if class {
        size = class.block_size
    }
    var block = take_block(size)
    var address = take_register()
    var made = built.object_address(block, address)
    emit(made)
    write_the_defaults(class, address)
    return address
}

func write_the_defaults(class: HighIntermediaryRepresentation.Classes.HighClass?, address: Integer) {
    if class {
        var index = 0
        while index < class.held_attributes.count() {
            write_one_default(class.held_attributes[index], address)
            index = index + 1
        }
    } else {
        return
    }
}

func write_one_default(attribute: HighIntermediaryRepresentation.Classes.HighAttribute, address: Integer) {
    if attribute.default_value {
        var value = lower_value(attribute.default_value)
        var written = built.write_attribute(address, attribute.offset, value)
        emit(written)
    } else {
        return
    }
}

func offset_of(class_name: String, attribute_name: String): Integer {
    var class = program.class_named(class_name)
    if class {
        return the_offset_in(class, attribute_name)
    } else {
        return 0
    }
}

func the_offset_in(class: HighIntermediaryRepresentation.Classes.HighClass, attribute_name: String): Integer {
    var attribute = class.held_attribute_named(attribute_name)
    if attribute {
        return attribute.offset
    } else {
        return 0
    }
}

func lower_arguments(given: List<HighIntermediaryRepresentation.Values.Value>): List<Integer> {
    var outer = registers
    registers = List<Integer>()
    given.each(lower_argument)
    var built = registers
    registers = outer
    return built
}

func lower_argument(argument: HighIntermediaryRepresentation.Values.Value) {
    var register = lower_value(argument)
    registers.append(register)
}

func lower_return(statement: HighIntermediaryRepresentation.Statements.Return) {
    if statement.value {
        var register = lower_value(statement.value)
        var added = built.return_value(register)
        emit(added)
    } else {
        var nothing = built.return_nothing()
        emit(nothing)
    }
}

func lower_held_foreign_call(statement: HighIntermediaryRepresentation.Statements.ForeignCall) {
    if statement.call {
        var value = statement.call
        lower_the_foreign_call_of(value)
    } else {
        return
    }
}

func lower_the_foreign_call_of(value: HighIntermediaryRepresentation.Values.Value) {
    if value == HighIntermediaryRepresentation.Values.ForeignCall {
        var foreign = value
        lower_foreign_call(foreign)
        return
    } else {
        return
    }
}

func lower_foreign_call(value: HighIntermediaryRepresentation.Values.ForeignCall): Integer {
    var handle = lower_value(value.receiver)
    var arguments = lower_arguments(value.arguments)
    var into = take_register()
    var added = built.foreign_call(value.name, handle, arguments, into)
    emit(added)
    return into
}

func lower_value(value: HighIntermediaryRepresentation.Values.Value?): Integer {
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        var number = value
        return lower_number(number)
    }
    if value == HighIntermediaryRepresentation.Values.Name {
        var name = value
        return lower_name(name)
    }
    if value == HighIntermediaryRepresentation.Values.Operation {
        var operation = value
        return lower_operation(operation)
    }
    if value == HighIntermediaryRepresentation.Values.Answer {
        var answer = value
        return lower_answer(answer)
    }
    if value == HighIntermediaryRepresentation.Values.Attribute {
        var attribute = value
        return lower_attribute(attribute)
    }
    if value == HighIntermediaryRepresentation.Values.ForeignCall {
        var foreign = value
        return lower_foreign_call(foreign)
    } else {
        return 0
    }
}

func lower_number(value: HighIntermediaryRepresentation.Values.WholeNumber): Integer {
    var into = take_register()
    var read = value.value()
    var added = built.number(read, into)
    emit(added)
    return into
}

func lower_name(value: HighIntermediaryRepresentation.Values.Name): Integer {
    var into = take_register()
    var place = place_of(value.name)
    var added = built.read(place, into)
    emit(added)
    return into
}

func lower_operation(value: HighIntermediaryRepresentation.Values.Operation): Integer {
    var left = lower_value(value.left)
    var right = lower_value(value.right)
    var into = take_register()
    var added = built.operation(value.operator, left, right, into)
    emit(added)
    return into
}

func lower_answer(value: HighIntermediaryRepresentation.Values.Answer): Integer {
    if is_a_constructor(value.callee, value.owner) {
        return lower_the_instance(value.callee, value.owner, value.arguments)
    }
    var arguments = lower_arguments(value.arguments)
    var into = take_register()
    var added = built.call(value.callee, value.owner, arguments, into)
    emit(added)
    return into
}

func lower_attribute(value: HighIntermediaryRepresentation.Values.Attribute): Integer {
    var object = lower_value(value.object)
    var offset = offset_of(value.class_name, value.name)
    var into = take_register()
    var added = built.read_attribute(object, offset, into)
    emit(added)
    return into
}

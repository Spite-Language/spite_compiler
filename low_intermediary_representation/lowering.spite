var empty_classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var empty_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var program = HighIntermediaryRepresentation.Programs.HighProgram(empty_classes, "")
var written = empty_functions
var current = LowIntermediaryRepresentation.Functions.LowFunction("", 0)
var places = Dictionary<String, Integer>()
var registers = List<Integer>()
var next_place = 0
var next_register = 0
var label = 0
var current_class = ""
var built = LowIntermediaryRepresentation.Instructions.InstructionBuild()

func Lowering(starting_program: HighIntermediaryRepresentation.Programs.HighProgram) {
    program = starting_program
}

func lowered(): LowIntermediaryRepresentation.Programs.LowProgram {
    written = List<LowIntermediaryRepresentation.Functions.LowFunction>()
    program.classes.each(lower_class)
    return LowIntermediaryRepresentation.Programs.LowProgram(written, program.entry)
}

func lower_class(own: HighIntermediaryRepresentation.Classes.HighClass) {
    current_class = own.name
    own.held_functions.each(lower_function)
}

func lower_function(own: HighIntermediaryRepresentation.Functions.HighFunction) {
    if own.body {
        lower_body_of(own, own.body)
    } else {
        return
    }
}

func lower_body_of(
    own: HighIntermediaryRepresentation.Functions.HighFunction,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    places = Dictionary<String, Integer>()
    registers = List<Integer>()
    next_place = 0
    next_register = 0
    label = 0
    current = LowIntermediaryRepresentation.Functions.LowFunction(own.name, 0)
    current.class_name = current_class
    current.parameter_count = own.parameters.count()
    own.parameters.each(declare_place)
    declare_the_places_of(body)
    lower_block(body)
    var last = built.return_value(-1)
    emit(last)
    current.slots = next_place + next_register
    written.append(current)
}

func declare_the_places_of(body: HighIntermediaryRepresentation.Statements.Block) {
    body.statements.each(read_the_place_of)
}

func read_the_place_of(statement: HighIntermediaryRepresentation.Statements.Statement) {
    if statement == HighIntermediaryRepresentation.Statements.Declare {
        var declaration = statement
        declare_place(declaration.name)
        return
    }
    if statement == HighIntermediaryRepresentation.Statements.Assign {
        var assignment = statement
        declare_place(assignment.name)
        return
    }
    if statement == HighIntermediaryRepresentation.Statements.While {
        var loop = statement
        if loop.body {
            declare_the_places_of(loop.body)
        }
        return
    }
    return
}

func declare_place(name: String) {
    var known = places[name]
    if known {
        return
    } else {
        places[name] = next_place
        next_place = next_place + 1
    }
}

func place_of(name: String): Integer {
    var known = places[name]
    if known {
        return known
    }
    var taken = next_place + next_register
    next_register = next_register + 1
    places[name] = taken
    return taken
}

func take_register(): Integer {
    var taken = next_place + next_register
    next_register = next_register + 1
    return taken
}

func next_label(): Integer {
    label = label + 1
    return label
}

func emit(added: LowIntermediaryRepresentation.Instructions.Instruction) {
    current.instructions.append(added)
}

func lower_block(block: HighIntermediaryRepresentation.Statements.Block) {
    block.statements.each(lower_statement)
}

func lower_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: lower_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: lower_assign(statement)
        HighIntermediaryRepresentation.Statements.While: lower_while(statement)
        HighIntermediaryRepresentation.Statements.Call: lower_call(statement)
        HighIntermediaryRepresentation.Statements.Return: lower_return(statement)
    }
}

func lower_declare(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    var place = place_of(declaration.name)
    var register = lower_value(declaration.value)
    var added = built.write(place, register)
    emit(added)
}

func lower_assign(assignment: HighIntermediaryRepresentation.Statements.Assign) {
    var place = place_of(assignment.name)
    var register = lower_value(assignment.value)
    var added = built.write(place, register)
    emit(added)
}

func lower_while(loop: HighIntermediaryRepresentation.Statements.While) {
    crash loop.condition
    var top = current.instructions.count()
    var test = lower_value(loop.condition)
    var out = built.jump_if_false(test, top)
    emit(out)
    crash loop.body
    lower_block(loop.body)
    var bottom = current.instructions.count()
    var back = built.jump(top)
    emit(back)
    out.to = bottom + 1
}

func lower_call(call: HighIntermediaryRepresentation.Statements.Call) {
    var arguments = lower_arguments(call.arguments)
    var register = take_register()
    var added = built.call(call.callee, call.owner, arguments, register)
    emit(added)
}

func lower_arguments(given: List<HighIntermediaryRepresentation.Values.Value>): List<Integer> {
    var outer = registers
    registers = List<Integer>()
    given.each(lower_argument)
    var built = registers
    registers = outer
    return built
}

func lower_argument(argument: HighIntermediaryRepresentation.Values.Value) {
    var register = lower_value(argument)
    registers.append(register)
}

func lower_return(statement: HighIntermediaryRepresentation.Statements.Return) {
    if statement.value {
        var register = lower_value(statement.value)
        var added = built.return_value(register)
        emit(added)
    } else {
        var nothing = built.return_nothing()
        emit(nothing)
    }
}

func lower_value(value: HighIntermediaryRepresentation.Values.Value?): Integer {
    if value == HighIntermediaryRepresentation.Values.WholeNumber {
        var number = value
        return lower_number(number)
    }
    if value == HighIntermediaryRepresentation.Values.Name {
        var name = value
        return lower_name(name)
    }
    if value == HighIntermediaryRepresentation.Values.Operation {
        var operation = value
        return lower_operation(operation)
    }
    if value == HighIntermediaryRepresentation.Values.Answer {
        var answer = value
        return lower_answer(answer)
    } else {
        return 0
    }
}

func lower_number(value: HighIntermediaryRepresentation.Values.WholeNumber): Integer {
    var into = take_register()
    var read = value.value()
    var added = built.number(read, into)
    emit(added)
    return into
}

func lower_name(value: HighIntermediaryRepresentation.Values.Name): Integer {
    var into = take_register()
    var place = place_of(value.name)
    var added = built.read(place, into)
    emit(added)
    return into
}

func lower_operation(value: HighIntermediaryRepresentation.Values.Operation): Integer {
    var left = lower_value(value.left)
    var right = lower_value(value.right)
    var into = take_register()
    var added = built.operation(value.operator, left, right, into)
    emit(added)
    return into
}

func lower_answer(value: HighIntermediaryRepresentation.Values.Answer): Integer {
    var arguments = lower_arguments(value.arguments)
    var into = take_register()
    var added = built.call(value.callee, value.owner, arguments, into)
    emit(added)
    return into
}

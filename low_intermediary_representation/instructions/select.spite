# ../../OPTIMIZATIONS.md#an-if-that-only-adds-or-picks-a-value-has-no-branch
var target = 0
var condition = 0
var when_true = 0
var when_false = 0

func Select(starting_target: Integer, starting_condition: Integer, starting_when_true: Integer, starting_when_false: Integer) {
    target = starting_target
    condition = starting_condition
    when_true = starting_when_true
    when_false = starting_when_false
}

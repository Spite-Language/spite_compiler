# ../../OPTIMIZATIONS.md#an-if-that-only-adds-or-picks-a-value-has-no-branch

var target: Integer
var condition: Integer
var when_true: Integer
var when_false: Integer

func Select(
    starting_target: Integer,
    starting_condition: Integer,
    starting_when_true: Integer,
    starting_when_false: Integer,
) {
    target = starting_target
    condition = starting_condition
    when_true = starting_when_true
    when_false = starting_when_false
}

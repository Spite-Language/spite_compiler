enum Comparison {
    'equal'
    'not_equal'
    'less'
    'less_or_equal'
    'greater'
    'greater_or_equal'
}

var target: Integer
var comparison: Comparison
var left: Integer
var right: Integer
var is_signed: Boolean

func Compare(
    starting_target: Integer,
    starting_comparison: Comparison,
    starting_left: Integer,
    starting_right: Integer,
    starting_is_signed: Boolean,
) {
    target = starting_target
    comparison = starting_comparison
    left = starting_left
    right = starting_right
    is_signed = starting_is_signed
}

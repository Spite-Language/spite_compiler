var target = 0
var comparison: LowIntermediaryRepresentation.Comparison = 'equal'
var left = 0
var right = 0
var is_signed = true

func Compare(
    starting_target: Integer,
    starting_comparison: LowIntermediaryRepresentation.Comparison,
    starting_left: Integer,
    starting_right: Integer,
) {
    target = starting_target
    comparison = starting_comparison
    left = starting_left
    right = starting_right
}

enum Operator {
    'add'
    'subtract'
    'multiply'
    'divide'
    'remainder'
    'bits_and'
    'bits_or'
    'bits_xor'
    'shift_left'
    'shift_right'
    'square_root'
}

var target = 0
var operator: Operator = 'add'
var left = 0
var right = 0
var width: LowIntermediaryRepresentation.Instructions.Load.Width = 'bits_64'
var is_signed = true
var is_checked = true
var wraps = false
var line = 0
var shown = ""
var type_name = ""
var path = ""
var owner = ""

func Arithmetic(
    starting_target: Integer,
    starting_operator: Operator,
    starting_left: Integer,
    starting_right: Integer,
) {
    target = starting_target
    operator = starting_operator
    left = starting_left
    right = starting_right
}

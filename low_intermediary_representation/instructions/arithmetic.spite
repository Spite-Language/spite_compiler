enum Operator {
    'add'
    'subtract'
    'multiply'
    'divide'
    'remainder'
    'bits_and'
    'bits_or'
    'bits_xor'
    'shift_left'
    'shift_right'
    'square_root'
}

var target: Integer
var operator: Operator
var left: Integer
var right: Integer
var width: LowIntermediaryRepresentation.Instructions.Load.Width
var is_signed: Boolean
var wraps: Boolean

func Arithmetic(
    starting_target: Integer,
    starting_operator: Operator,
    starting_left: Integer,
    starting_right: Integer,
    starting_width: LowIntermediaryRepresentation.Instructions.Load.Width,
    starting_is_signed: Boolean,
    starting_wraps: Boolean,
) {
    target = starting_target
    operator = starting_operator
    left = starting_left
    right = starting_right
    width = starting_width
    is_signed = starting_is_signed
    wraps = starting_wraps
}

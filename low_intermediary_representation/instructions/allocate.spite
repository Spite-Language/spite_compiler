var target: Integer
var size: Integer
var class_id: Integer
var zeroed_bytes: Integer

func Allocate(
    starting_target: Integer,
    starting_size: Integer,
    starting_class_id: Integer,
    starting_zeroed_bytes: Integer,
) {
    target = starting_target
    size = starting_size
    class_id = starting_class_id
    zeroed_bytes = starting_zeroed_bytes
}

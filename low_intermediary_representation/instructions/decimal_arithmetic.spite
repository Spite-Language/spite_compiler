var target = 0
var operator: LowIntermediaryRepresentation.ArithmeticOperator = 'add'
var left = 0
var right = 0
var is_double = true

func DecimalArithmetic(
    starting_target: Integer,
    starting_operator: LowIntermediaryRepresentation.ArithmeticOperator,
    starting_left: Integer,
    starting_right: Integer,
) {
    target = starting_target
    operator = starting_operator
    left = starting_left
    right = starting_right
}

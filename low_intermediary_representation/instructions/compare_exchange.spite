var target: Integer
var address: Integer
var offset: Integer
var expected: Integer
var desired: Integer
var width: LowIntermediaryRepresentation.Instructions.Load.Width
var is_signed: Boolean

func CompareExchange(
    starting_target: Integer,
    starting_address: Integer,
    starting_offset: Integer,
    starting_expected: Integer,
    starting_desired: Integer,
    starting_width: LowIntermediaryRepresentation.Instructions.Load.Width,
    starting_is_signed: Boolean,
) {
    target = starting_target
    address = starting_address
    offset = starting_offset
    expected = starting_expected
    desired = starting_desired
    width = starting_width
    is_signed = starting_is_signed
}

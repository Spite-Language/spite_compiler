var target = 0
var library = 0
var name = ""
var file_name = ""

func ForeignAddress(
    starting_target: Integer,
    starting_library: Integer,
    starting_name: String,
    starting_file_name: String,
) {
    target = starting_target
    library = starting_library
    name = starting_name
    file_name = starting_file_name
}

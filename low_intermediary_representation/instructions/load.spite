enum Width {
    'bits_8'
    'bits_16'
    'bits_32'
    'bits_64'
}

var is_invariant = false
var cannot_fault = false
var target: Integer
var address: Integer
var offset: Integer
var width: Width
var is_signed: Boolean
var is_swapped: Boolean
var region: String

func Load(
    starting_target: Integer,
    starting_address: Integer,
    starting_offset: Integer,
    starting_width: Width,
    starting_is_signed: Boolean,
    starting_region: String,
    starting_is_swapped: Boolean,
) {
    target = starting_target
    address = starting_address
    offset = starting_offset
    width = starting_width
    is_signed = starting_is_signed
    region = starting_region
    is_swapped = starting_is_swapped
}

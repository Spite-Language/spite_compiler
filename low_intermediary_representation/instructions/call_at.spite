var target = -1
var address = 0
var arguments = List<Integer>()
var answers_32_bits = false
var presence = -1
var decimal_sizes = List<Integer>()
var answer_decimal_size = 0
var line = 0
var frames = List<String>()

func CallAt(
    starting_target: Integer,
    starting_address: Integer,
    starting_arguments: List<Integer>,
    starting_answers_32_bits: Boolean,
    starting_presence: Integer,
    starting_answer_decimal_size: Integer,
) {
    target = starting_target
    address = starting_address
    arguments = starting_arguments
    answers_32_bits = starting_answers_32_bits
    presence = starting_presence
    answer_decimal_size = starting_answer_decimal_size
}

var target = 0
var comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison = 'equal'
var left = 0
var right = 0
var is_double = true

func Compare(
    starting_target: Integer,
    starting_comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    starting_left: Integer,
    starting_right: Integer,
    starting_is_double: Boolean,
) {
    target = starting_target
    comparison = starting_comparison
    left = starting_left
    right = starting_right
    is_double = starting_is_double
}

var target: Integer
var source: Integer
var from_decimal_size: Integer
var to_decimal_size: Integer
var whole_is_signed: Boolean
var whole_width: LowIntermediaryRepresentation.Instructions.Load.Width

func Conversion(
    starting_target: Integer,
    starting_source: Integer,
    starting_from_decimal_size: Integer,
    starting_to_decimal_size: Integer,
    starting_whole_is_signed: Boolean,
    starting_whole_width: LowIntermediaryRepresentation.Instructions.Load.Width,
) {
    target = starting_target
    source = starting_source
    from_decimal_size = starting_from_decimal_size
    to_decimal_size = starting_to_decimal_size
    whole_is_signed = starting_whole_is_signed
    whole_width = starting_whole_width
}

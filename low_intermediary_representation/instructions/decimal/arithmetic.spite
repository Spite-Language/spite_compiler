var target: Integer
var operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator
var left: Integer
var right: Integer
var is_double: Boolean

func Arithmetic(
    starting_target: Integer,
    starting_operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator,
    starting_left: Integer,
    starting_right: Integer,
    starting_is_double: Boolean,
) {
    target = starting_target
    operator = starting_operator
    left = starting_left
    right = starting_right
    is_double = starting_is_double
}

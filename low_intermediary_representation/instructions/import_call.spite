var target = -1
var decimal_sizes = List<Integer>()
var name: String
var arguments: List<Integer>
var library: String
var answer_decimal_size: Integer

func ImportCall(
    starting_target: Integer,
    starting_name: String,
    starting_arguments: List<Integer>,
    starting_library: String,
    starting_answer_decimal_size: Integer,
) {
    target = starting_target
    name = starting_name
    arguments = starting_arguments
    library = starting_library
    answer_decimal_size = starting_answer_decimal_size
}

func number(value: Long, into: Integer): Instruction {
    var written = value.to_string()
    return Instruction("number", written, into, 0, 0)
}

func read(place: Integer, into: Integer): Instruction {
    return Instruction("read", "", place, into, 0)
}

func write(place: Integer, from: Integer): Instruction {
    return Instruction("write", "", place, from, 0)
}

func operation(operator: String, left: Integer, right: Integer, into: Integer): Instruction {
    return Instruction("operation", operator, left, right, into)
}

func jump(label: Integer): Instruction {
    var written = Instruction("jump", "", 0, 0, 0)
    written.to = label
    return written
}

func jump_if_false(value: Integer, label: Integer): Instruction {
    var written = Instruction("jump_if_false", "", value, 0, 0)
    written.to = label
    return written
}

func return_value(value: Integer): Instruction {
    return Instruction("return", "", value, 0, 0)
}

func return_nothing(): Instruction {
    return Instruction("return", "", -1, 0, 0)
}

func copy(from: Integer, into: Integer): Instruction {
    return Instruction("copy", "", from, into, 0)
}

func object_address(block: Integer, into: Integer): Instruction {
    return Instruction("object_address", "", block, into, 0)
}

func read_attribute(base: Integer, offset: Integer, width: Integer, into: Integer): Instruction {
    var written = width.to_string()
    return Instruction("read_attribute", written, base, offset, into)
}

func write_attribute(base: Integer, offset: Integer, width: Integer, from: Integer): Instruction {
    var written = width.to_string()
    return Instruction("write_attribute", written, base, offset, from)
}

func buffer_read(object: Integer, offset: Integer, into: Integer): Instruction {
    return Instruction("buffer_read", "", object, offset, into)
}

func buffer_write(object: Integer, offset: Integer, from: Integer): Instruction {
    return Instruction("buffer_write", "", object, offset, from)
}

func attribute_address(base: Integer, offset: Integer, into: Integer): Instruction {
    return Instruction("attribute_address", "", base, offset, into)
}

func place_address(place: Integer, into: Integer): Instruction {
    return Instruction("place_address", "", place, into, 0)
}

func foreign_call(name: String, handle: Integer, arguments: List<Integer>, into: Integer): Instruction {
    var written = Instruction("foreign_call", name, into, handle, 0)
    written.places = arguments
    return written
}

func call(name: String, owner: String, arguments: List<Integer>, into: Integer): Instruction {
    var written = Instruction("call", name, into, 0, 0)
    written.callee = name
    written.owner = owner
    written.places = arguments
    return written
}

func a_crash(message: String): Instruction {
    return Instruction("crash", message, 0, 0, 0)
}

var destination: Integer
var source: Integer
var count: Integer
var goes_forwards: Boolean

func CopyBytes(
    starting_destination: Integer,
    starting_source: Integer,
    starting_count: Integer,
    starting_goes_forwards: Boolean,
) {
    destination = starting_destination
    source = starting_source
    count = starting_count
    goes_forwards = starting_goes_forwards
}

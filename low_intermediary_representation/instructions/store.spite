var address: Integer
var offset: Integer
var source: Integer
var width: LowIntermediaryRepresentation.Instructions.Load.Width
var is_swapped: Boolean
var region: String

func Store(
    starting_address: Integer,
    starting_offset: Integer,
    starting_source: Integer,
    starting_width: LowIntermediaryRepresentation.Instructions.Load.Width,
    starting_region: String,
    starting_is_swapped: Boolean,
) {
    address = starting_address
    offset = starting_offset
    source = starting_source
    width = starting_width
    region = starting_region
    is_swapped = starting_is_swapped
}

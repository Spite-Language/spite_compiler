var line = 0
var shown = ""
var type_name = ""
var path = ""
var owner = ""

func Check(
    starting_line: Integer,
    starting_shown: String,
    starting_type_name: String,
    starting_path: String,
    starting_owner: String,
) {
    line = starting_line
    shown = starting_shown
    type_name = starting_type_name
    path = starting_path
    owner = starting_owner
}

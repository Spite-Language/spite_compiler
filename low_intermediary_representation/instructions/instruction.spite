var kind = ""
var text = ""
var first = 0
var second = 0
var third = 0
var to = -1
var callee = ""
var places = List<Integer>()

func Instruction(
    starting_kind: String,
    starting_text: String,
    starting_first: Integer,
    starting_second: Integer,
    starting_third: Integer,
) {
    kind = starting_kind
    text = starting_text
    first = starting_first
    second = starting_second
    third = starting_third
}

func is_jump(): Boolean {
    if kind == "jump" {
        return true
    }
    return kind == "jump_if_false"
}

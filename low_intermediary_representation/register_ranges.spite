# ../PROOFS.md#the-range-of-a-register
var known = List<Boolean>()
var lows = List<Long>()
var highs = List<Long>()
var first_facts = List<Integer>()
var fact_counts = List<Integer>()
var fact_registers = List<Integer>()
var fact_lows = List<Long>()
var fact_highs = List<Long>()
var largest_bound: Long = 4611686018427387904
var smallest: Long = -9223372036854775807
var largest: Long = 9223372036854775807

func RegisterRanges(register_total: Integer, block_total: Integer) {
    var index = 0
    while index < register_total {
        known.append(false)
        lows.append(smallest)
        highs.append(largest)
        index = index + 1
    }
    index = 0
    while index < block_total {
        first_facts.append(0)
        fact_counts.append(0)
        index = index + 1
    }
}

func learn(register: Integer, low: Long, high: Long) {
    crash register >= 0 and register < known.count()
    var floor = lows[register]
    crash floor
    var kept = low
    if floor > kept and floor <= high {
        kept = floor
    }
    crash kept <= high
    known[register] = true
    lows[register] = kept
    highs[register] = high
}

func set_floor(register: Integer, low: Long) {
    crash register >= 0 and register < known.count() and not is_known(register)
    lows[register] = low
}

func start_the_facts_of(block_index: Integer) {
    first_facts[block_index] = fact_registers.count()
}

func add_a_fact(block_index: Integer, register: Integer, low: Long, high: Long) {
    fact_registers.append(register)
    fact_lows.append(low)
    fact_highs.append(high)
    var count = fact_counts[block_index]
    crash count
    fact_counts[block_index] = count + 1
}

func is_known(register: Integer): Boolean {
    if register < 0 or register >= known.count() {
        return false
    }
    return known[register] == true
}

func low_of(register: Integer): Long {
    if register < 0 or register >= known.count() {
        return smallest
    }
    var value = lows[register]
    crash value
    return value
}

func high_of(register: Integer): Long {
    if register < 0 or register >= known.count() {
        return largest
    }
    var value = highs[register]
    crash value
    return value
}

func low_at(block_index: Integer, register: Integer): Long {
    var low = low_of(register)
    if block_index < 0 or block_index >= first_facts.count() {
        return low
    }
    var first = first_facts[block_index]
    var count = fact_counts[block_index]
    crash first
    crash count
    var index = first
    while index < first + count {
        var fact_low = fact_lows[index]
        crash fact_low
        if fact_registers[index] == register and fact_low > low {
            low = fact_low
        }
        index = index + 1
    }
    return low
}

func high_at(block_index: Integer, register: Integer): Long {
    var high = high_of(register)
    if block_index < 0 or block_index >= first_facts.count() {
        return high
    }
    var first = first_facts[block_index]
    var count = fact_counts[block_index]
    crash first
    crash count
    var index = first
    while index < first + count {
        var fact_high = fact_highs[index]
        crash fact_high
        if fact_registers[index] == register and fact_high < high {
            high = fact_high
        }
        index = index + 1
    }
    return high
}

func is_known_at(block_index: Integer, register: Integer): Boolean {
    if register < 0 or register >= known.count() {
        return false
    }
    var low = low_at(block_index, register)
    var high = high_at(block_index, register)
    return low >= 0 - largest_bound and high <= largest_bound and low <= high
}

func is_never_negative_at(block_index: Integer, register: Integer): Boolean {
    var low = low_at(block_index, register)
    return low >= 0
}

func is_the_constant(register: Integer, value: Long): Boolean {
    return is_known(register) and low_of(register) == value and high_of(register) == value
}

var path = ""
var namespace = ""
var tokens = List<AbstractSyntaxTree.Tokens.Token>()
var position = 0
var text_line = 0
var raw = ""
var cursor = 0
var literal = ""
var pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
var no_path = List<String>()
var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
var no_values = List<AbstractSyntaxTree.Shapes.Declarations.EnumValue>()
var no_members = List<String>()
var no_shapes = List<AbstractSyntaxTree.Shapes.Types.TypeMember>()
var no_parameters = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
var no_statements = List<SpiteCompiler.WrittenStatement>()
var unfit = List<AbstractSyntaxTree.Shapes.Unfit>()
var holes = List<AbstractSyntaxTree.Parser.Hole>()
var lost = false
var stops = Dictionary<Integer, String>()
var placed_stops = List<Integer>()
var comments = List<AbstractSyntaxTree.Shapes.Comment>()
var comment_index = 0
var beyond_every_line = 2147483647
var _open_brace_code = 123
var _close_brace_code = 125

func Parser(starting_path: String, starting_namespace: String, starting_tokens: List<AbstractSyntaxTree.Tokens.Token>) {
    path = starting_path
    namespace = starting_namespace
    tokens = starting_tokens
}

func parse_file(): AbstractSyntaxTree.Shapes.SourceFile {
    var file = AbstractSyntaxTree.Shapes.SourceFile(path, namespace)
    comment_index = 0
    while not finished() {
        var first = current()
        var first_index = position
        var previous_line = 0
        if position > 0 {
            var before = tokens[position - 1]
            crash before
            previous_line = before.line
        }
        var written = declaration()
        place_the_comments(file, written, previous_line, first.line)
        file.declarations.append(written)
        end_of_statement()
        if lost {
            read_on_after(first_index, false)
        }
    }
    place_the_last_comments(file)
    return file
}

# ../../../spite_documentation/style.md#comments-are-links
func place_the_comments(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    written: SpiteCompiler.Declaration,
    previous_line: Integer,
    first_line: Integer,
) {
    var above = comments_before(previous_line, first_line)
    var blank_lines = first_line - previous_line - 1 - above.count()
    var index = file.declarations.count()
    if index > 0 and blank_lines > 0 {
        file.blank_before.append(index)
    }
    fallback not above.is_empty()
    var is_a_function = written.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    var kept = List<AbstractSyntaxTree.Shapes.Comment>()
    if index == 0 {
        kept = heading_and_rest(file, above, first_line, is_a_function)
    } else {
        kept = above
    }
    fallback not kept.is_empty()
    if written.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        add_the_texts(kept, written.comments)
        return
    }
    var place = place_of(written)
    misplace(file, kept, place)
}

func heading_and_rest(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    above: List<AbstractSyntaxTree.Shapes.Comment>,
    first_line: Integer,
    is_a_function: Boolean,
): List<AbstractSyntaxTree.Shapes.Comment> {
    var start = above.count()
    if is_a_function {
        var expected = first_line - 1
        while start > 0 and is_on_line(above, start - 1, expected) {
            start = start - 1
            expected = expected - 1
        }
    }
    var kept = List<AbstractSyntaxTree.Shapes.Comment>()
    var index = 0
    while index < above.count() {
        var comment = above[index]
        if index < start {
            file.heading.append(comment.text)
        } else {
            kept.append(comment)
        }
        index = index + 1
    }
    return kept
}

func is_on_line(above: List<AbstractSyntaxTree.Shapes.Comment>, index: Integer, line: Integer): Boolean {
    var comment = above[index]
    crash comment
    return comment.line == line
}

func place_the_last_comments(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var last_line = 0
    if tokens.count() > 1 {
        var last = tokens[tokens.count() - 2]
        crash last
        last_line = last.line
    }
    var rest = comments_before(last_line, beyond_every_line)
    fallback not rest.is_empty()
    if file.declarations.is_empty() {
        add_the_texts(rest, file.heading)
        return
    }
    misplace(file, rest, "at the end of the file")
}

func add_the_texts(kept: List<AbstractSyntaxTree.Shapes.Comment>, texts: List<String>) {
    var index = 0
    while index < kept.count() {
        var comment = kept[index]
        texts.append(comment.text)
        index = index + 1
    }
}

func misplace(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    kept: List<AbstractSyntaxTree.Shapes.Comment>,
    place: String,
) {
    var index = 0
    while index < kept.count() {
        var comment = kept[index]
        file.misplaced_comments.append(comment)
        file.misplaced_places.append(place)
        index = index + 1
    }
}

func place_of(written: SpiteCompiler.Declaration): String {
    switch written {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return "above the singleton line"
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return "above a generic line"
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return "above an enum"
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return "above a union"
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return "above a type"
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return "above an attribute"
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return "above a function"
    }
}

func comments_before(previous_line: Integer, first_line: Integer): List<AbstractSyntaxTree.Shapes.Comment> {
    var found = List<AbstractSyntaxTree.Shapes.Comment>()
    var keep_going = true
    while keep_going and comment_index < comments.count() {
        var comment = comments[comment_index]
        if comment.line >= first_line {
            keep_going = false
        } else {
            if comment.line > previous_line {
                found.append(comment)
            }
            comment_index = comment_index + 1
        }
    }
    return found
}

func declaration(): SpiteCompiler.Declaration {
    var kind = current().kind
    switch kind {
        'keyword_singleton': return singleton_declaration()
        'keyword_generic': return generic_declaration()
        'keyword_enum': return enum_declaration()
        'keyword_union': return union_declaration()
        'keyword_type': return type_declaration()
        'keyword_variable': return attribute_declaration()
        'keyword_function': return function_declaration()
        'end_of_file': return not_a_declaration()
        'name': return not_a_declaration()
        'class_name': return not_a_declaration()
        'generic_name': return not_a_declaration()
        'integer_literal': return not_a_declaration()
        'decimal_literal': return not_a_declaration()
        'text_literal': return not_a_declaration()
        'symbol_literal': return not_a_declaration()
        'open_brace': return not_a_declaration()
        'close_brace': return not_a_declaration()
        'open_parenthesis': return not_a_declaration()
        'close_parenthesis': return not_a_declaration()
        'open_bracket': return not_a_declaration()
        'close_bracket': return not_a_declaration()
        'comma': return not_a_declaration()
        'dot': return not_a_declaration()
        'dots': return not_a_declaration()
        'colon': return not_a_declaration()
        'question': return not_a_declaration()
        'equals': return not_a_declaration()
        'plus': return not_a_declaration()
        'minus': return not_a_declaration()
        'star': return not_a_declaration()
        'slash': return not_a_declaration()
        'percent': return not_a_declaration()
        'equal_equal': return not_a_declaration()
        'not_equal': return not_a_declaration()
        'less': return not_a_declaration()
        'greater': return not_a_declaration()
        'less_or_equal': return not_a_declaration()
        'greater_or_equal': return not_a_declaration()
        'and': return not_a_declaration()
        'or': return not_a_declaration()
        'not': return not_a_declaration()
        'keyword_return': return not_a_declaration()
        'keyword_if': return not_a_declaration()
        'keyword_else': return not_a_declaration()
        'keyword_while': return not_a_declaration()
        'keyword_switch': return not_a_declaration()
        'keyword_fallback': return not_a_declaration()
        'keyword_crash': return not_a_declaration()
        'keyword_load': return not_a_declaration()
        'keyword_this': return not_a_declaration()
        'keyword_null': return not_a_declaration()
        'keyword_true': return not_a_declaration()
        'keyword_false': return not_a_declaration()
    }
}

func singleton_declaration(): AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration {
    var start = advance()
    var written = AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration()
    written.line = start.line
    return written
}

func generic_declaration(): AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
    var start = advance()
    var token = current()
    if token.kind != 'generic_name' {
        keep_unfit('generic_value')
        return empty_generic(start.line)
    }
    var name_token = advance()
    var bound: SpiteCompiler.Type? = null
    if check('colon') {
        step()
        bound = type_reference()
    }
    var written = AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration(name_token.text, bound)
    written.line = start.line
    return written
}

func empty_generic(line: Integer): AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
    var no_bound: SpiteCompiler.Type? = null
    var written = AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration("", no_bound)
    written.line = line
    return written
}

func enum_declaration(): AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
    var start = advance()
    var name = class_name_expected('enum_name')
    var values = List<AbstractSyntaxTree.Shapes.Declarations.EnumValue>()
    if opening_brace_expected() {
        read_enum_values(values)
    } else {
        return empty_enum(start.line)
    }
    var written = AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration(name, values)
    written.line = start.line
    written.end_line = line_before()
    return written
}

func read_enum_values(values: List<AbstractSyntaxTree.Shapes.Declarations.EnumValue>) {
    while not finished() and not check('close_brace') and not lost {
        var token = current()
        if token.kind != 'symbol_literal' {
            keep_unfit('enum_value')
            return
        }
        var symbol = advance()
        var number: SpiteCompiler.Expression? = null
        if check('equals') {
            step()
            number = expression()
        }
        var value = AbstractSyntaxTree.Shapes.Declarations.EnumValue(symbol.text, number)
        values.append(value)
        end_of_statement()
    }
    closing_brace_expected()
}

func empty_enum(line: Integer): AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
    var written = AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration("", no_values)
    written.line = line
    return written
}

func union_declaration(): AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
    var start = advance()
    var name = class_name_expected('union_name')
    var members = List<String>()
    if opening_brace_expected() {
        read_union_members(members)
    } else {
        return empty_union(start.line)
    }
    var written = AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration(name, members)
    written.line = start.line
    written.end_line = line_before()
    return written
}

func read_union_members(members: List<String>) {
    while not finished() and not check('close_brace') and not lost {
        var token = current()
        if token.kind != 'class_name' {
            keep_unfit('union_member')
            return
        }
        var path = dotted_name()
        var arguments = generic_text_of_a_member()
        members.append("{path}{arguments}")
        end_of_statement()
    }
    closing_brace_expected()
}

func generic_text_of_a_member(): String {
    fallback check('less')
    var opening = current()
    var written = ""
    var depth = 0
    var keep_going = true
    while keep_going and not finished() and current().line == opening.line {
        var token = advance()
        written = "{written}{token.text}"
        if token.kind == 'less' {
            depth = depth + 1
        }
        if token.kind == 'greater' {
            depth = depth - 1
        }
        keep_going = depth > 0
    }
    return written
}

func dotted_name(): String {
    var first = advance()
    var written = first.text
    var keep_going = true
    while keep_going and check('dot') {
        step()
        var next_token = current()
        if next_token.kind != 'class_name' {
            keep_unfit('path_name')
            keep_going = false
        } else {
            var next_name = advance()
            written = "{written}.{next_name.text}"
        }
    }
    return written
}

func empty_union(line: Integer): AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
    var written = AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration("", no_members)
    written.line = line
    return written
}

func type_declaration(): SpiteCompiler.Declaration {
    var start = advance()
    var name = class_name_expected('type_name')
    var members = List<AbstractSyntaxTree.Shapes.Types.TypeMember>()
    if opening_brace_expected() {
        read_type_members(members)
    } else {
        return empty_type(start.line)
    }
    var written = AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration(name, members)
    written.line = start.line
    written.end_line = line_before()
    return written
}

func read_type_members(members: List<AbstractSyntaxTree.Shapes.Types.TypeMember>) {
    while not finished() and not check('close_brace') and not lost {
        var member = type_member()
        members.append(member)
    }
    closing_brace_expected()
}

func empty_type(line: Integer): AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
    var written = AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration("", no_shapes)
    written.line = line
    return written
}

func type_member(): AbstractSyntaxTree.Shapes.Types.TypeMember {
    var token = current()
    if token.kind != 'name' {
        keep_unfit('type_member')
        return empty_type_member()
    }
    var name = advance()
    var parameters = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
    var result: SpiteCompiler.Type? = null
    var is_an_attribute = not check('open_parenthesis')
    if check('open_parenthesis') {
        step()
        read_member_parameters(parameters)
        closing_parenthesis_expected('parameters_close')
    }
    if check('colon') {
        step()
        result = type_reference()
    }
    end_of_statement()
    var member = AbstractSyntaxTree.Shapes.Types.TypeMember(name.text, parameters, result)
    member.is_an_attribute = is_an_attribute
    return member
}

func read_member_parameters(parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>) {
    while not finished() and not check('close_parenthesis') and not lost {
        var taken = member_parameter()
        parameters.append(taken)
        if check('comma') {
            step()
        }
    }
}

func member_parameter(): AbstractSyntaxTree.Shapes.Declarations.Parameter {
    var declared = type_at('shape_parameter')
    return AbstractSyntaxTree.Shapes.Declarations.Parameter("", declared, false)
}

func empty_type_member(): AbstractSyntaxTree.Shapes.Types.TypeMember {
    var no_result: SpiteCompiler.Type? = null
    return AbstractSyntaxTree.Shapes.Types.TypeMember("", no_parameters, no_result)
}

func attribute_declaration(): AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
    var start = advance()
    var name = name_expected()
    var declared: SpiteCompiler.Type? = null
    if check('colon') {
        step()
        declared = type_reference()
    }
    if not check('equals') {
        keep_unfit('variable_equals')
    }
    step()
    var value = expression()
    var written = AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration(name, declared, value)
    written.line = start.line
    written.path = path
    return written
}

func function_declaration(): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
    var start = advance()
    var name = function_name()
    var parameters = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
    if check('open_parenthesis') {
        step()
        read_parameters(parameters)
        closing_parenthesis_expected('parameters_close')
    } else {
        keep_unfit('function_parameters')
    }
    var result: SpiteCompiler.Type? = null
    if check('colon') {
        step()
        result = type_reference()
    }
    var body: AbstractSyntaxTree.Shapes.Statements.Block? = null
    if check('open_brace') {
        body = block()
    }
    var written = AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration(name, parameters, result, body)
    written.line = start.line
    written.path = path
    return written
}

func function_name(): String {
    var token = current()
    if token.kind == 'name' or token.kind == 'class_name' {
        return advance().text
    }
    keep_unfit('function_name')
    return ""
}

func read_parameters(parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>) {
    while not finished() and not check('close_parenthesis') and not lost {
        var taken = parameter()
        parameters.append(taken)
        if check('comma') {
            step()
        }
    }
}

func parameter(): AbstractSyntaxTree.Shapes.Declarations.Parameter {
    if check('dots') {
        step()
        return named_parameter(true)
    }
    return named_parameter(false)
}

func named_parameter(is_variadic: Boolean): AbstractSyntaxTree.Shapes.Declarations.Parameter {
    var token = current()
    if not is_a_name(token) {
        keep_unfit('parameter_name')
        return empty_parameter(is_variadic)
    }
    var name = advance()
    if not check('colon') {
        keep_unfit('parameter_colon')
        return empty_parameter(is_variadic)
    }
    step()
    var declared = type_reference()
    return AbstractSyntaxTree.Shapes.Declarations.Parameter(name.text, declared, is_variadic)
}

func empty_parameter(is_variadic: Boolean): AbstractSyntaxTree.Shapes.Declarations.Parameter {
    var empty = AbstractSyntaxTree.Shapes.Types.NamedType(no_path, no_arguments)
    return AbstractSyntaxTree.Shapes.Declarations.Parameter("", empty, is_variadic)
}

func is_a_name(token: AbstractSyntaxTree.Tokens.Token): Boolean {
    return token.kind == 'name'
}

func name_expected(): String {
    var token = current()
    if not is_a_name(token) {
        keep_unfit('variable_name')
        return ""
    }
    return advance().text
}

func class_name_expected(place: AbstractSyntaxTree.Shapes.Unfit.Place): String {
    var token = current()
    if token.kind != 'class_name' {
        keep_unfit(place)
        return ""
    }
    return advance().text
}

func opening_brace_expected(): Boolean {
    if check('open_brace') {
        step()
        return true
    }
    keep_unfit('opening_brace')
    return false
}

func closing_brace_expected() {
    if check('close_brace') {
        step()
        return
    }
    keep_unfit('closing_brace')
}

func closing_parenthesis_expected(place: AbstractSyntaxTree.Shapes.Unfit.Place) {
    if check('close_parenthesis') {
        step()
        return
    }
    keep_unfit(place)
}

func statement(): SpiteCompiler.WrittenStatement {
    var start = current()
    var kind = start.kind
    switch kind {
        'keyword_variable': return variable_statement()
        'keyword_return': return return_statement()
        'keyword_if': return if_statement()
        'keyword_else': return stranded_else(start.line)
        'keyword_while': return while_statement()
        'keyword_switch': return switch_statement()
        'keyword_fallback': return fallback_statement(start.line)
        'keyword_crash': return crash_statement(start.line)
        'keyword_load': return load_statement()
        'open_brace': return block()
        'end_of_file': return simple_statement(start.line)
        'name': return simple_statement(start.line)
        'class_name': return simple_statement(start.line)
        'generic_name': return simple_statement(start.line)
        'integer_literal': return simple_statement(start.line)
        'decimal_literal': return simple_statement(start.line)
        'text_literal': return simple_statement(start.line)
        'symbol_literal': return simple_statement(start.line)
        'close_brace': return simple_statement(start.line)
        'open_parenthesis': return simple_statement(start.line)
        'close_parenthesis': return simple_statement(start.line)
        'open_bracket': return simple_statement(start.line)
        'close_bracket': return simple_statement(start.line)
        'comma': return simple_statement(start.line)
        'dot': return simple_statement(start.line)
        'dots': return simple_statement(start.line)
        'colon': return simple_statement(start.line)
        'question': return simple_statement(start.line)
        'equals': return simple_statement(start.line)
        'plus': return simple_statement(start.line)
        'minus': return simple_statement(start.line)
        'star': return simple_statement(start.line)
        'slash': return simple_statement(start.line)
        'percent': return simple_statement(start.line)
        'equal_equal': return simple_statement(start.line)
        'not_equal': return simple_statement(start.line)
        'less': return simple_statement(start.line)
        'greater': return simple_statement(start.line)
        'less_or_equal': return simple_statement(start.line)
        'greater_or_equal': return simple_statement(start.line)
        'and': return simple_statement(start.line)
        'or': return simple_statement(start.line)
        'not': return simple_statement(start.line)
        'keyword_function': return simple_statement(start.line)
        'keyword_enum': return simple_statement(start.line)
        'keyword_union': return simple_statement(start.line)
        'keyword_type': return simple_statement(start.line)
        'keyword_this': return simple_statement(start.line)
        'keyword_null': return simple_statement(start.line)
        'keyword_true': return simple_statement(start.line)
        'keyword_false': return simple_statement(start.line)
        'keyword_generic': return simple_statement(start.line)
        'keyword_singleton': return simple_statement(start.line)
    }
}

func variable_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var name = name_expected()
    var declared: SpiteCompiler.Type? = null
    if check('colon') {
        step()
        declared = type_reference()
    }
    if not check('equals') {
        keep_unfit('variable_equals')
    }
    step()
    var value = expression()
    var written = AbstractSyntaxTree.Shapes.Statements.VariableStatement(name, declared, value)
    written.line = start.line
    return written
}

func return_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var value: SpiteCompiler.Expression? = null
    if not at_end_of_statement() {
        value = expression()
    }
    var written = AbstractSyntaxTree.Shapes.Statements.ReturnStatement(value)
    written.line = start.line
    return written
}

func if_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var condition = expression()
    var then_branch = block()
    var else_branch: AbstractSyntaxTree.Shapes.Statements.Block? = null
    if check('keyword_else') {
        else_branch = else_of(start.line)
    }
    var written = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, then_branch, else_branch)
    written.line = start.line
    return written
}

func else_of(line: Integer): AbstractSyntaxTree.Shapes.Statements.Block {
    step()
    if check('keyword_if') {
        var inner = statement()
        var statements = List<SpiteCompiler.WrittenStatement>()
        statements.append(inner)
        var written = AbstractSyntaxTree.Shapes.Statements.Block(statements)
        written.line = line
        written.is_an_else_if = true
        return written
    } else {
        return block()
    }
}

func stranded_else(line: Integer): SpiteCompiler.WrittenStatement {
    keep_unfit('statement')
    var empty = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("")
    var written = AbstractSyntaxTree.Shapes.Statements.CrashStatement(empty)
    written.line = line
    return written
}

func while_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var condition = expression()
    var body = block()
    var written = AbstractSyntaxTree.Shapes.Statements.WhileStatement(condition, body)
    written.line = start.line
    return written
}

func switch_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var value = expression()
    var cases = List<AbstractSyntaxTree.Shapes.Statements.SwitchCase>()
    if opening_brace_expected() {
        read_cases(cases)
    }
    var written = AbstractSyntaxTree.Shapes.Statements.SwitchStatement(value, cases)
    written.line = start.line
    return written
}

func read_cases(cases: List<AbstractSyntaxTree.Shapes.Statements.SwitchCase>) {
    while not finished() and not check('close_brace') and not lost {
        var written = switch_case()
        cases.append(written)
    }
    closing_brace_expected()
}

func switch_case(): AbstractSyntaxTree.Shapes.Statements.SwitchCase {
    var start = current()
    var value = expression()
    if not check('colon') {
        keep_unfit('case_colon')
        return empty_case()
    }
    step()
    var body = case_body()
    var written = AbstractSyntaxTree.Shapes.Statements.SwitchCase(value, body)
    written.line = start.line
    return written
}

func empty_case(): AbstractSyntaxTree.Shapes.Statements.SwitchCase {
    var body = AbstractSyntaxTree.Shapes.Statements.Block(no_statements)
    var empty = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("")
    return AbstractSyntaxTree.Shapes.Statements.SwitchCase(empty, body)
}

func case_body(): AbstractSyntaxTree.Shapes.Statements.Block {
    if check('open_brace') {
        return block()
    }
    var statements = List<SpiteCompiler.WrittenStatement>()
    if not finished() {
        stop_before_a_statement(statements)
        var inner = statement()
        statements.append(inner)
    }
    return AbstractSyntaxTree.Shapes.Statements.Block(statements)
}

func fallback_statement(line: Integer): SpiteCompiler.WrittenStatement {
    var keyword = advance()
    var condition = expression()
    var written = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(condition)
    written.line = line
    written.column = keyword.column
    return written
}

func crash_statement(line: Integer): SpiteCompiler.WrittenStatement {
    var keyword = advance()
    var condition = crash_condition()
    var written = AbstractSyntaxTree.Shapes.Statements.CrashStatement(condition)
    written.line = line
    written.column = keyword.column
    return written
}

func crash_condition(): SpiteCompiler.Expression {
    if at_end_of_statement() {
        return AbstractSyntaxTree.Shapes.Expressions.LiteralExpression('keyword_false', "false")
    } else {
        return expression()
    }
}

func load_statement(): SpiteCompiler.WrittenStatement {
    var start = advance()
    var folder = expression()
    var written = AbstractSyntaxTree.Shapes.Statements.LoadStatement(folder)
    written.line = start.line
    return written
}

func simple_statement(line: Integer): SpiteCompiler.WrittenStatement {
    var value = expression()
    if check('equals') {
        step()
        var right = expression()
        var assigned = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(value, right)
        assigned.line = line
        return assigned
    }
    var written = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(value)
    written.line = line
    return written
}

func block(): AbstractSyntaxTree.Shapes.Statements.Block {
    var start = current()
    if lost or not opening_brace_expected() {
        var broken = AbstractSyntaxTree.Shapes.Statements.Block(no_statements)
        broken.line = start.line
        return broken
    }
    var statements = List<SpiteCompiler.WrittenStatement>()
    while not finished() and not check('close_brace') {
        var first_index = position
        stop_before_a_statement(statements)
        var inner = statement()
        statements.append(inner)
        end_of_statement()
        if lost {
            read_on_after(first_index, true)
        }
    }
    var closing = current()
    closing_brace_expected()
    var written = AbstractSyntaxTree.Shapes.Statements.Block(statements)
    written.line = start.line
    written.end_line = closing.line
    return written
}

# ../../../spite_documentation/repl.md#the-wire-protocol
func stop_before_a_statement(statements: List<SpiteCompiler.WrittenStatement>) {
    fallback not stops.is_empty()
    var start = current()
    var site = stops[start.line]
    fallback site
    fallback not placed_stops.contains(start.line)
    placed_stops.append(start.line)
    var name = "spite_breakpoint_on_line_{start.line}"
    var made = parsed_on_line("var {name} = Spite.Breakpoint()", start.line)
    statements.append(made)
    var listed = "spite_locals_on_line_{start.line}"
    var listing = parsed_on_line("var {listed} = List<String>()", start.line)
    statements.append(listing)
    var called = parsed_on_line("{name}.pause_at(\"{site}\", {listed})", start.line)
    if called.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        called.shows_the_locals = true
    }
    statements.append(called)
}

func parsed_on_line(text: String, line: Integer): SpiteCompiler.WrittenStatement {
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser.Parser(path, namespace, made_tokens)
    return parser.statement()
}

func not_a_declaration(): SpiteCompiler.Declaration {
    keep_unfit('declaration')
    return AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration()
}

func end_of_statement() {
    fallback not lost
    var token = current()
    var kind = token.kind
    var is_end = kind == 'end_of_file' or kind == 'close_brace'
    var last = tokens[position - 1]
    crash last
    var on_its_own_line = token.line > last.line
    fallback not is_end and not on_its_own_line
    keep_unfit('statement_end')
}

func at_end_of_statement(): Boolean {
    var token = current()
    var kind = token.kind
    var keyword = tokens[position - 1]
    crash keyword
    var on_a_new_line = token.line != keyword.line
    return kind == 'end_of_file' or kind == 'close_brace' or on_a_new_line
}

func expression(): SpiteCompiler.Expression {
    return or_expression()
}

func binary_of(
    left: SpiteCompiler.Expression,
    operator: AbstractSyntaxTree.Tokens.Token.Kind,
    right: SpiteCompiler.Expression,
): SpiteCompiler.Expression {
    var made = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(left, operator, right)
    made.line = left.line
    made.column = left.column
    return made
}

func unary_of(
    operator: AbstractSyntaxTree.Tokens.Token.Kind,
    operand: SpiteCompiler.Expression,
    written: AbstractSyntaxTree.Tokens.Token,
): SpiteCompiler.Expression {
    var made = AbstractSyntaxTree.Shapes.Expressions.UnaryExpression(operator, operand)
    made.line = written.line
    made.column = written.column
    return made
}

func or_expression(): SpiteCompiler.Expression {
    var value = and_expression()
    var keep_going = true
    while keep_going {
        if check('or') {
            step()
            var right = and_expression()
            value = binary_of(value, 'or', right)
        } else {
            keep_going = false
        }
    }
    return value
}

func and_expression(): SpiteCompiler.Expression {
    var value = not_expression()
    var keep_going = true
    while keep_going {
        if check('and') {
            step()
            var right = not_expression()
            value = binary_of(value, 'and', right)
        } else {
            keep_going = false
        }
    }
    return value
}

func not_expression(): SpiteCompiler.Expression {
    if check('not') {
        var keyword = advance()
        var operand = not_expression()
        return unary_of('not', operand, keyword)
    }
    return comparison_expression()
}

func comparison_expression(): SpiteCompiler.Expression {
    var value = sum_expression()
    var keep_going = true
    while keep_going {
        var operator = comparison_operator()
        if operator == 'end_of_file' {
            keep_going = false
        } else {
            step()
            var right = sum_expression()
            value = binary_of(value, operator, right)
        }
    }
    return value
}

func comparison_operator(): AbstractSyntaxTree.Tokens.Token.Kind {
    var kind = current().kind
    switch kind {
        'equal_equal': return kind
        'not_equal': return kind
        'less': return kind
        'greater': return kind
        'less_or_equal': return kind
        'greater_or_equal': return kind
        'end_of_file': return 'end_of_file'
        'name': return 'end_of_file'
        'class_name': return 'end_of_file'
        'generic_name': return 'end_of_file'
        'integer_literal': return 'end_of_file'
        'decimal_literal': return 'end_of_file'
        'text_literal': return 'end_of_file'
        'symbol_literal': return 'end_of_file'
        'open_brace': return 'end_of_file'
        'close_brace': return 'end_of_file'
        'open_parenthesis': return 'end_of_file'
        'close_parenthesis': return 'end_of_file'
        'open_bracket': return 'end_of_file'
        'close_bracket': return 'end_of_file'
        'comma': return 'end_of_file'
        'dot': return 'end_of_file'
        'dots': return 'end_of_file'
        'colon': return 'end_of_file'
        'question': return 'end_of_file'
        'equals': return 'end_of_file'
        'plus': return 'end_of_file'
        'minus': return 'end_of_file'
        'star': return 'end_of_file'
        'slash': return 'end_of_file'
        'percent': return 'end_of_file'
        'and': return 'end_of_file'
        'or': return 'end_of_file'
        'not': return 'end_of_file'
        'keyword_function': return 'end_of_file'
        'keyword_variable': return 'end_of_file'
        'keyword_enum': return 'end_of_file'
        'keyword_union': return 'end_of_file'
        'keyword_type': return 'end_of_file'
        'keyword_return': return 'end_of_file'
        'keyword_if': return 'end_of_file'
        'keyword_else': return 'end_of_file'
        'keyword_while': return 'end_of_file'
        'keyword_switch': return 'end_of_file'
        'keyword_fallback': return 'end_of_file'
        'keyword_crash': return 'end_of_file'
        'keyword_load': return 'end_of_file'
        'keyword_this': return 'end_of_file'
        'keyword_null': return 'end_of_file'
        'keyword_true': return 'end_of_file'
        'keyword_false': return 'end_of_file'
        'keyword_generic': return 'end_of_file'
        'keyword_singleton': return 'end_of_file'
    }
}

func sum_expression(): SpiteCompiler.Expression {
    var value = product_expression()
    var keep_going = true
    while keep_going {
        var kind = current().kind
        var adds = kind == 'plus' or kind == 'minus'
        if adds and starts_a_line() {
            adds = false
        }
        if adds {
            step()
            var right = product_expression()
            value = binary_of(value, kind, right)
        } else {
            keep_going = false
        }
    }
    return value
}

func product_expression(): SpiteCompiler.Expression {
    var value = negated_expression()
    var keep_going = true
    while keep_going {
        var kind = current().kind
        if kind == 'star' or kind == 'slash' or kind == 'percent' {
            step()
            var right = negated_expression()
            value = binary_of(value, kind, right)
        } else {
            keep_going = false
        }
    }
    return value
}

func negated_expression(): SpiteCompiler.Expression {
    if check('minus') {
        var sign = advance()
        var operand = negated_expression()
        return unary_of('minus', operand, sign)
    }
    return postfix_expression()
}

func postfix_expression(): SpiteCompiler.Expression {
    var value = primary_expression()
    var keep_going = true
    while keep_going {
        var following = after_primary(value)
        if following {
            value = following
        } else {
            keep_going = false
        }
    }
    return value
}

func after_primary(before: SpiteCompiler.Expression): SpiteCompiler.Expression? {
    var kind = current().kind
    switch kind {
        'dot': return member_after(before)
        'open_bracket': return index_after(before)
        'open_parenthesis': return call_after(before, no_arguments)
        'less': return generic_call_after(before)
        'end_of_file': return null
        'name': return null
        'class_name': return null
        'generic_name': return null
        'integer_literal': return null
        'decimal_literal': return null
        'text_literal': return null
        'symbol_literal': return null
        'open_brace': return null
        'close_brace': return null
        'close_parenthesis': return null
        'close_bracket': return null
        'comma': return null
        'dots': return null
        'colon': return null
        'question': return null
        'equals': return null
        'plus': return null
        'minus': return null
        'star': return null
        'slash': return null
        'percent': return null
        'equal_equal': return null
        'not_equal': return null
        'greater': return null
        'less_or_equal': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
        'not': return null
        'keyword_function': return null
        'keyword_variable': return null
        'keyword_enum': return null
        'keyword_union': return null
        'keyword_type': return null
        'keyword_return': return null
        'keyword_if': return null
        'keyword_else': return null
        'keyword_while': return null
        'keyword_switch': return null
        'keyword_fallback': return null
        'keyword_crash': return null
        'keyword_load': return null
        'keyword_this': return null
        'keyword_null': return null
        'keyword_true': return null
        'keyword_false': return null
        'keyword_generic': return null
        'keyword_singleton': return null
    }
}

func member_after(before: SpiteCompiler.Expression): SpiteCompiler.Expression {
    step()
    var token = current()
    var kind = token.kind
    if kind != 'name' and kind != 'class_name' and kind != 'generic_name' {
        keep_unfit('member_name')
        return AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("")
    }
    var name = advance()
    var member = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(before, name.text)
    if name.kind == 'class_name' {
        member.is_a_class_name = true
    }
    member.line = before.line
    member.column = before.column
    return member
}

func index_after(before: SpiteCompiler.Expression): SpiteCompiler.Expression {
    step()
    var index = expression()
    closing_bracket_expected()
    var read = AbstractSyntaxTree.Shapes.Expressions.IndexExpression(before, index)
    read.line = before.line
    read.column = before.column
    return read
}

func closing_bracket_expected() {
    if check('close_bracket') {
        step()
        return
    }
    keep_unfit('closing_bracket')
}

func call_after(
    before: SpiteCompiler.Expression,
    generic_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): SpiteCompiler.Expression {
    step()
    var arguments = List<SpiteCompiler.Expression>()
    read_arguments(arguments)
    closing_parenthesis_expected('arguments_close')
    var call = AbstractSyntaxTree.Shapes.Expressions.CallExpression(before, generic_arguments, arguments)
    call.line = before.line
    call.column = before.column
    return call
}

func read_arguments(arguments: List<SpiteCompiler.Expression>) {
    while not check('close_parenthesis') and not lost {
        var written = expression()
        arguments.append(written)
        if check('comma') {
            step()
        }
    }
}

func generic_call_after(before: SpiteCompiler.Expression): SpiteCompiler.Expression? {
    var saved = position
    step()
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    quiet_generic_arguments_into(arguments)
    var closed = check('greater')
    if closed {
        step()
    }
    if closed and check('open_parenthesis') {
        return call_after(before, arguments)
    }
    if closed and not arguments.is_empty() {
        var named = generic_class_name(before, arguments)
        if named {
            return named
        }
    }
    position = saved
    return null
}

func generic_class_name(
    before: SpiteCompiler.Expression,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): SpiteCompiler.Expression? {
    if before.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_name_with(before, arguments)
    }
    if before.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_class_name_with(before, arguments)
    }
    return null
}

func member_class_name_with(
    named: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): SpiteCompiler.Expression? {
    fallback named.is_a_class_name and named.generic_arguments.is_empty()
    named.generic_arguments = arguments
    return named
}

func class_name_with(
    named: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): SpiteCompiler.Expression? {
    fallback named.is_a_class_name and named.generic_arguments.is_empty()
    named.generic_arguments = arguments
    return named
}

func quiet_generic_argument(): AbstractSyntaxTree.Shapes.Types.GenericArgument? {
    var token = current()
    var kind = token.kind
    var is_number = kind == 'integer_literal' or kind == 'decimal_literal'
    var is_written = kind == 'text_literal' or kind == 'symbol_literal'
    var is_flag = kind == 'keyword_true' or kind == 'keyword_false'
    if is_number or is_written or is_flag {
        step()
        return AbstractSyntaxTree.Shapes.Types.GenericArgument(false, token.text)
    }
    var quiet = quiet_type()
    if quiet {
        var argument = AbstractSyntaxTree.Shapes.Types.GenericArgument(false, "")
        argument.of_type(quiet)
        return argument
    }
    return null
}

func quiet_generic_arguments_into(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>) {
    while not at_end() {
        var argument = quiet_generic_argument()
        if argument {
            arguments.append(argument)
        }
        if check('comma') {
            step()
        } else {
            return
        }
    }
}

func quiet_generic_arguments(): List<AbstractSyntaxTree.Shapes.Types.GenericArgument> {
    fallback check('less')
    var saved = position
    step()
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    quiet_generic_arguments_into(arguments)
    if check('greater') {
        step()
        return arguments
    }
    position = saved
    return List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
}

func primary_expression(): SpiteCompiler.Expression {
    var token = current()
    var kind = token.kind
    switch kind {
        'integer_literal': return literal_after(token)
        'decimal_literal': return literal_after(token)
        'symbol_literal': return literal_after(token)
        'keyword_true': return literal_after(token)
        'keyword_false': return literal_after(token)
        'keyword_null': return literal_after(token)
        'keyword_this': return literal_after(token)
        'keyword_load': return unfit_value()
        'text_literal': return text_after(token)
        'name': return name_after(token)
        'keyword_type': return unfit_value()
        'keyword_singleton': return unfit_value()
        'class_name': return name_after(token)
        'generic_name': return name_after(token)
        'open_parenthesis': return grouped()
        'open_bracket': return list_literal()
        'open_brace': return pair_literal()
        'question': return unfit_value()
        'end_of_file': return unfit_value()
        'close_brace': return unfit_value()
        'close_parenthesis': return unfit_value()
        'close_bracket': return unfit_value()
        'comma': return unfit_value()
        'dot': return unfit_value()
        'dots': return unfit_value()
        'colon': return unfit_value()
        'equals': return unfit_value()
        'plus': return unfit_value()
        'minus': return unfit_value()
        'star': return unfit_value()
        'slash': return unfit_value()
        'percent': return unfit_value()
        'equal_equal': return unfit_value()
        'not_equal': return unfit_value()
        'less': return unfit_value()
        'greater': return unfit_value()
        'less_or_equal': return unfit_value()
        'greater_or_equal': return unfit_value()
        'and': return unfit_value()
        'or': return unfit_value()
        'not': return unfit_value()
        'keyword_function': return unfit_value()
        'keyword_variable': return unfit_value()
        'keyword_enum': return unfit_value()
        'keyword_union': return unfit_value()
        'keyword_return': return unfit_value()
        'keyword_if': return unfit_value()
        'keyword_else': return unfit_value()
        'keyword_while': return unfit_value()
        'keyword_switch': return unfit_value()
        'keyword_fallback': return unfit_value()
        'keyword_crash': return unfit_value()
        'keyword_generic': return unfit_value()
    }
}

func literal_after(token: AbstractSyntaxTree.Tokens.Token): SpiteCompiler.Expression {
    step()
    var literal = AbstractSyntaxTree.Shapes.Expressions.LiteralExpression(token.kind, token.text)
    literal.written = token.lexeme
    literal.line = token.line
    literal.column = token.column
    return literal
}

func name_after(token: AbstractSyntaxTree.Tokens.Token): SpiteCompiler.Expression {
    step()
    var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(token.text)
    if token.kind == 'class_name' {
        identifier.is_a_class_name = true
    }
    identifier.line = token.line
    identifier.column = token.column
    return identifier
}

func grouped(): SpiteCompiler.Expression {
    step()
    var inner = expression()
    closing_parenthesis_expected('group_close')
    return inner
}

func list_literal(): SpiteCompiler.Expression {
    step()
    var entries = List<SpiteCompiler.Expression>()
    read_list_entries(entries)
    closing_bracket_expected()
    return AbstractSyntaxTree.Shapes.Expressions.ListLiteral(entries)
}

func read_list_entries(entries: List<SpiteCompiler.Expression>) {
    while not check('close_bracket') and not lost {
        var written = expression()
        entries.append(written)
        if check('comma') {
            step()
        }
    }
}

func pair_literal(): SpiteCompiler.Expression {
    step()
    var entries = List<SpiteCompiler.Expression>()
    read_pair_entries(entries)
    closing_brace_expected()
    return AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral(entries)
}

func read_pair_entries(entries: List<SpiteCompiler.Expression>) {
    while not check('close_brace') and not lost {
        var written = entry_literal()
        entries.append(written)
        if check('comma') {
            step()
        }
    }
}

func entry_literal(): AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
    var key = expression()
    if not check('colon') {
        keep_unfit('entry_colon')
        return empty_entry()
    }
    step()
    var value = expression()
    return AbstractSyntaxTree.Shapes.Expressions.EntryLiteral(key, value)
}

func empty_entry(): AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
    var empty = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("")
    return AbstractSyntaxTree.Shapes.Expressions.EntryLiteral(empty, empty)
}

func unfit_value(): SpiteCompiler.Expression {
    keep_unfit('value')
    return AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("")
}

func text_after(token: AbstractSyntaxTree.Tokens.Token): SpiteCompiler.Expression {
    step()
    text_line = token.line
    var written = text_pieces_of(token.text)
    var text = AbstractSyntaxTree.Shapes.Expressions.TextLiteral(written)
    text.line = token.line
    text.column = token.column
    return text
}

func type_reference(): SpiteCompiler.Type {
    return type_at('type')
}

func type_at(place: AbstractSyntaxTree.Shapes.Unfit.Place): SpiteCompiler.Type {
    var quiet = quiet_type()
    if quiet {
        return quiet
    }
    keep_unfit(place)
    return AbstractSyntaxTree.Shapes.Types.NamedType(no_path, no_arguments)
}

func quiet_type(): SpiteCompiler.Type? {
    var token = current()
    var kind = token.kind
    if kind == 'class_name' or kind == 'generic_name' or kind == 'name' {
        return named_type_after()
    }
    return null
}

func named_type_after(): SpiteCompiler.Type {
    var first = advance()
    var path = List<String>()
    path.append(first.text)
    read_type_path(path)
    read_a_generic_key(path)
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    if check('less') {
        arguments = quiet_generic_arguments()
    }
    var written = AbstractSyntaxTree.Shapes.Types.NamedType(path, arguments)
    var asks_a_question = first.text.starts_with("$") and path.count() > 1 and check('open_parenthesis')
    if asks_a_question {
        read_asked_literals(written.asked)
    }
    if check('question') {
        step()
        written.is_nullable = true
    }
    return written
}

func read_asked_literals(asked: List<String>) {
    step()
    while not check('close_parenthesis') and not at_end() {
        var token = advance()
        var is_a_literal = token.kind == 'text_literal' or token.kind == 'integer_literal'
        if not is_a_literal {
            keep_unfit('arguments_close')
        }
        asked.append(token.text)
        if check('comma') {
            step()
        }
    }
    closing_parenthesis_expected('arguments_close')
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func read_a_generic_key(path: List<String>) {
    fallback check('open_bracket')
    var last = path.last()
    fallback last == "generics"
    step()
    var key = current()
    if key.kind != 'text_literal' {
        keep_unfit('closing_bracket')
        return
    }
    step()
    if not check('close_bracket') {
        keep_unfit('closing_bracket')
        return
    }
    step()
    crash path.remove_last()
    path.append("generics[\"{key.text}\"]")
}

func read_type_path(path: List<String>) {
    while check('dot') {
        step()
        var next_token = current()
        if next_token.kind != 'class_name' and next_token.kind != 'name' and next_token.kind != 'generic_name' {
            keep_unfit('path_name')
            return
        }
        var next_name = advance()
        path.append(next_name.text)
    }
}

func text_pieces_of(starting_raw: String): List<AbstractSyntaxTree.Shapes.Expressions.TextPiece> {
    raw = starting_raw
    pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
    literal = ""
    cursor = 0
    while cursor < raw.length() {
        read_text_piece()
    }
    flush_literal()
    if pieces.is_empty() {
        var empty = AbstractSyntaxTree.Shapes.Expressions.TextPiece("", null)
        pieces.append(empty)
    }
    return pieces
}

func read_text_piece() {
    var code = raw.byte_at(cursor)
    if code == 92 {
        read_escape_piece()
    } else if code == _open_brace_code {
        read_hole_piece()
    } else {
        read_plain_piece()
    }
}

func read_escape_piece() {
    var pair = raw.slice(cursor, cursor + 2)
    crash pair
    literal = "{literal}{pair}"
    cursor = cursor + 2
}

func read_hole_piece() {
    var end = end_of_hole()
    var inner = raw.slice(cursor + 1, end)
    crash inner
    var hole = hole_between(inner)
    flush_literal()
    var piece = AbstractSyntaxTree.Shapes.Expressions.TextPiece("", hole)
    pieces.append(piece)
    cursor = end + 1
}

func read_plain_piece() {
    var letter = raw[cursor]
    crash letter
    literal = "{literal}{letter}"
    cursor = cursor + letter.length()
}

func flush_literal() {
    if not literal.is_empty() {
        var piece = AbstractSyntaxTree.Shapes.Expressions.TextPiece(literal, null)
        pieces.append(piece)
        literal = ""
    }
}

func end_of_hole(): Integer {
    var depth = 0
    var index = cursor
    while index < raw.length() {
        var code = raw.byte_at(index)
        if code == 34 {
            index = past_a_text_in_a_hole(index)
        } else {
            depth = depth + brace_of(code)
            if depth == 0 {
                return index
            }
            index = index + 1
        }
    }
    return raw.length() - 1
}

func past_a_text_in_a_hole(start: Integer): Integer {
    var index = start + 1
    while index < raw.length() {
        var code = raw.byte_at(index)
        if code == 92 {
            index = index + 2
        } else if code == 34 {
            return index + 1
        } else if code == _open_brace_code {
            index = past_a_hole_in_a_text(index)
        } else {
            index = index + 1
        }
    }
    return raw.length()
}

func past_a_hole_in_a_text(start: Integer): Integer {
    var depth = 0
    var index = start
    while index < raw.length() {
        var code = raw.byte_at(index)
        if code == 34 {
            index = past_a_text_in_a_hole(index)
        } else {
            depth = depth + brace_of(code)
            index = index + 1
            if depth == 0 {
                return index
            }
        }
    }
    return raw.length()
}

func brace_of(code: Integer): Integer {
    if code == _open_brace_code {
        return 1
    }
    if code == _close_brace_code {
        return -1
    }
    return 0
}

func hole_between(inner: String): SpiteCompiler.Expression? {
    var hole_lexer = AbstractSyntaxTree.Lexer.Lexer(path, inner, text_line)
    var hole_tokens = hole_lexer.tokens_of()
    var hole_parser = Parser(path, namespace, hole_tokens)
    var value = hole_parser.expression()
    var hole = AbstractSyntaxTree.Parser.Hole(hole_tokens, hole_lexer.unread, hole_parser.unfit)
    holes.append(hole)
    hole_parser.holes.each(keep_a_hole)
    return value
}

func keep_a_hole(hole: AbstractSyntaxTree.Parser.Hole) {
    holes.append(hole)
}

func starts_a_line(): Boolean {
    crash position > 0
    var token = current()
    var last = tokens[position - 1]
    crash last
    return token.line > last.line
}

func current(): AbstractSyntaxTree.Tokens.Token {
    var at = position
    if at >= tokens.count() {
        at = tokens.count() - 1
    }
    var token = tokens[at]
    crash token
    return token
}

func line_before(): Integer {
    var before = tokens[position - 1]
    crash before
    return before.line
}

func advance(): AbstractSyntaxTree.Tokens.Token {
    var token = current()
    step()
    return token
}

func step() {
    if not at_end() {
        position = position + 1
    }
}

func check(kind: AbstractSyntaxTree.Tokens.Token.Kind): Boolean {
    return current().kind == kind
}

func at_end(): Boolean {
    return position >= tokens.count() - 1
}

func finished(): Boolean {
    return at_end()
}

func keep_unfit(place: AbstractSyntaxTree.Shapes.Unfit.Place) {
    fallback not lost
    lost = true
    var count = tokens.count()
    var piece = AbstractSyntaxTree.Shapes.Unfit(place, position, count)
    unfit.append(piece)
}

# ../../ARCHITECTURE.md#validators
func read_on_after(start: Integer, inside_a_block: Boolean) {
    var piece = unfit.last()
    crash piece
    var resumed = safe_point_after(start, piece.at, inside_a_block)
    piece.start = start
    piece.resumed = resumed
    position = resumed
    lost = false
}

func safe_point_after(start: Integer, unfit_at: Integer, inside_a_block: Boolean): Integer {
    var last = tokens.count() - 1
    var depth = 0
    var index = start
    while index < last {
        var token = tokens[index]
        if index > start {
            var before = tokens[index - 1]
            crash before
            var begins_a_line = token.line > before.line
            if index > unfit_at and begins_a_line and depth == 0 {
                return index
            }
            if inside_a_block and depth == 0 and token.kind == 'close_brace' {
                return index
            }
        }
        depth = depth_after(token, depth)
        index = index + 1
    }
    return last
}

func depth_after(token: AbstractSyntaxTree.Tokens.Token, depth: Integer): Integer {
    if token.kind == 'open_brace' {
        return depth + 1
    }
    if token.kind == 'close_brace' and depth > 0 {
        return depth - 1
    }
    return depth
}

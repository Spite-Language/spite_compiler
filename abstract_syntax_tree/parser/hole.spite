var tokens: List<AbstractSyntaxTree.Tokens.Token>
var unread: List<AbstractSyntaxTree.Tokens.Unreadable>
var unfit: List<AbstractSyntaxTree.Shapes.Unfit>

func Hole(
    starting_tokens: List<AbstractSyntaxTree.Tokens.Token>,
    starting_unread: List<AbstractSyntaxTree.Tokens.Unreadable>,
    starting_unfit: List<AbstractSyntaxTree.Shapes.Unfit>,
) {
    tokens = starting_tokens
    unread = starting_unread
    unfit = starting_unfit
}

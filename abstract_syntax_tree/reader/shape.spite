func line_of(statement: AbstractSyntaxTree.Shapes.Statements.Statement): Integer {
    switch statement {
        _: return statement.line
    }
}

func line_of_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration): Integer {
    switch declaration {
        _: return declaration.line
    }
}

func as_identifier(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
): AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression
    }
    return null
}

func as_literal(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
): AbstractSyntaxTree.Shapes.Expressions.LiteralExpression? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression
    }
    return null
}

func as_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return expression
    }
    return null
}

func as_variable(
    statement: AbstractSyntaxTree.Shapes.Statements.Statement,
): AbstractSyntaxTree.Shapes.Statements.VariableStatement? {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement
    }
    return null
}

func as_function(
    declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        return declaration
    }
    return null
}

func as_attribute(
    declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration,
): AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration? {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        return declaration
    }
    return null
}

func as_named_type(type_reference: AbstractSyntaxTree.Shapes.Types.Type): AbstractSyntaxTree.Shapes.Types.NamedType? {
    if type_reference == AbstractSyntaxTree.Shapes.Types.NamedType {
        return type_reference
    }
    return null
}

func name_of(type_reference: AbstractSyntaxTree.Shapes.Types.Type): String {
    if type_reference == AbstractSyntaxTree.Shapes.Types.NamedType {
        return type_reference.path.join(".")
    }
    return ""
}

var report = Diagnostics.Report()
var path = ""
var cases_seen = List<String>()
var declarations = 0
var statements = 0
var expressions = 0
var blocks = 0
var calls = 0
var member_reads = 0
var accessor_reads = 0
var index_reads = 0
var texts = 0
var holes = 0
var entries = 0
var numbers = 0
var words = 0
var flags = 0
var absences = 0
var arithmetic = 0
var comparisons = 0
var joins = 0
var negations = 0
var private_names = 0
var variadic_parameters = 0

func Walk(starting_path: String, starting_report: Diagnostics.Report) {
    path = starting_path
    report = starting_report
}

func read(file: AbstractSyntaxTree.Shapes.SourceFile) {
    file.declarations.each(read_declaration)
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    declarations = declarations + 1
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: read_singleton()
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: read_generic()
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: read_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: read_union()
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: read_type_shape(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: read_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: read_function(declaration)
    }
}

func read_singleton() {
    return
}

func read_generic() {
    return
}

func read_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    declaration.values.each(read_enum_value)
}

func read_enum_value(value: AbstractSyntaxTree.Shapes.Declarations.EnumValue) {
    if value.number {
        read_expression(value.number)
    } else {
        return
    }
}

func read_union() {
    return
}

func read_type_shape(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    declaration.members.each(read_type_member)
}

func read_type_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    if member.result {
        read_type(member.result)
    }
    member.parameters.each(read_parameter)
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    if declaration.declared_type {
        read_type(declaration.declared_type)
    }
    assert declaration.value
    read_expression(declaration.value)
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if declaration.result {
        read_type(declaration.result)
    }
    declaration.parameters.each(read_parameter)
    if declaration.body {
        read_block(declaration.body)
    } else {
        return
    }
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    if parameter.declared_type {
        read_type(parameter.declared_type)
    }
    var is_variadic = parameter.is_variadic
    if is_variadic {
        variadic_parameters = variadic_parameters + 1
    }
}

func read_type(type_reference: AbstractSyntaxTree.Shapes.Types.Type) {
    if type_reference == AbstractSyntaxTree.Shapes.Types.NamedType {
        read_named_type(type_reference)
    }
}

func read_named_type(type_reference: AbstractSyntaxTree.Shapes.Types.NamedType) {
    type_reference.arguments.each(read_argument)
}

func read_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.is_type {
        if argument.type_reference {
            read_type(argument.type_reference)
        }
    } else {
        words = words + 1
    }
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block) {
    blocks = blocks + 1
    block.statements.each(read_statement)
}

func read_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    statements = statements + 1
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read_held_expression(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: read_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.AssertStatement: read_assert(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: read_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: read_load(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_nested(statement)
    }
}

func read_held_expression(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    assert statement.value
    read_expression(statement.value)
}

func read_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    if statement.declared_type {
        read_type(statement.declared_type)
    }
    assert statement.value
    read_expression(statement.value)
}

func read_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    if statement.target {
        read_expression(statement.target)
    }
    assert statement.value
    read_expression(statement.value)
}

func read_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if statement.value {
        read_expression(statement.value)
    } else {
        return
    }
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    assert statement.condition
    read_expression(statement.condition)
    assert statement.then_branch
    read_block(statement.then_branch)
    if statement.else_branch {
        read_block(statement.else_branch)
    } else {
        return
    }
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    assert statement.condition
    read_expression(statement.condition)
    assert statement.body
    read_block(statement.body)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    assert statement.value
    read_expression(statement.value)
    statement.cases.each(read_case)
}

func read_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    if switch_case.value {
        read_expression(switch_case.value)
        check_case_written(switch_case)
    } else {
        return
    }
    assert switch_case.body
    read_block(switch_case.body)
}

func check_case_written(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    assert switch_case.value
    var written = written_of(switch_case.value)
    var is_repeat = cases_seen.contains(written)
    if is_repeat {
        var message = repeated_message(written)
        report.at(path, switch_case.line, 0, message)
    } else {
        cases_seen.append(written)
    }
}

func written_of(value: AbstractSyntaxTree.Shapes.Expressions.Expression): String {
    if value == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return value.name
    }
    return "another value"
}

func repeated_message(written: String): String {
    return "'switch' has two cases for '{written}', so one of them is never reached"
}

func read_assert(statement: AbstractSyntaxTree.Shapes.Statements.AssertStatement) {
    assert statement.condition
    read_expression(statement.condition)
}

func read_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    assert statement.condition
    read_expression(statement.condition)
}

func read_load(statement: AbstractSyntaxTree.Shapes.Statements.LoadStatement) {
    assert statement.folder
    read_expression(statement.folder)
}

func read_nested(statement: AbstractSyntaxTree.Shapes.Statements.Block) {
    read_block(statement)
}

func read_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    expressions = expressions + 1
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_identifier(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        read_literal(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        read_text(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_member(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_call(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        read_index(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_binary(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_unary(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        read_list(expression)
        return
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        read_entry(expression)
        return
    }
}

func read_identifier(expression: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression) {
    words = words + 1
    var is_private = expression.name.starts_with("_")
    if is_private {
        private_names = private_names + 1
    }
}

func read_literal(expression: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression) {
    var kind = expression.kind
    if kind == 'integer_literal' or kind == 'decimal_literal' {
        numbers = numbers + 1
    } else if kind == 'keyword_true' or kind == 'keyword_false' {
        flags = flags + 1
    } else if kind == 'keyword_null' {
        absences = absences + 1
    } else {
        words = words + 1
    }
}

func read_text(expression: AbstractSyntaxTree.Shapes.Expressions.TextLiteral) {
    texts = texts + 1
    expression.pieces.each(read_piece)
}

func read_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    assert piece.hole
    holes = holes + 1
    read_expression(piece.hole)
}

func read_member(expression: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    member_reads = member_reads + 1
    if expression.target {
        read_expression(expression.target)
    }
    var is_accessor = expression.name.starts_with("get_") or expression.name.starts_with("set_")
    if is_accessor {
        accessor_reads = accessor_reads + 1
    }
}

func read_call(expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    calls = calls + 1
    assert expression.callee
    read_expression(expression.callee)
    expression.generic_arguments.each(read_argument)
    expression.arguments.each(read_expression)
}

func read_index(expression: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    index_reads = index_reads + 1
    assert expression.target
    read_expression(expression.target)
    assert expression.index
    read_expression(expression.index)
}

func read_binary(expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    assert expression.left
    read_expression(expression.left)
    assert expression.right
    read_expression(expression.right)
    var operator = expression.operator
    if operator == 'and' or operator == 'or' {
        joins = joins + 1
    } else if operator == 'equal_equal' or operator == 'not_equal' {
        comparisons = comparisons + 1
    } else if operator == 'less' or operator == 'greater' {
        comparisons = comparisons + 1
    } else {
        arithmetic = arithmetic + 1
    }
}

func read_unary(expression: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    assert expression.operand
    read_expression(expression.operand)
    var operator = expression.operator
    if operator == 'not' or operator == 'minus' {
        negations = negations + 1
    }
}

func read_list(expression: AbstractSyntaxTree.Shapes.Expressions.ListLiteral) {
    var is_written = expression.is_written
    if is_written {
        expression.entries.each(read_entry)
    } else {
        expression.entries.each(read_expression)
    }
}

func read_entry(entry: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    entries = entries + 1
    if entry == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        read_pair(entry)
    }
}

func read_pair(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral) {
    assert entry.key
    read_expression(entry.key)
    assert entry.value
    read_expression(entry.value)
}

func counts(): String {
    return "{declarations} declarations, {statements} statements, {expressions} expressions, {blocks} blocks"
}

func detail_counts(): String {
    return "{calls} calls, {member_reads} member reads, {index_reads} index reads, {texts} texts with {holes} holes"
}

func value_counts(): String {
    return "{numbers} numbers, {words} names and words, {flags} flags, {absences} absences, {entries} entries"
}

func operator_counts(): String {
    return "{arithmetic} arithmetic, {comparisons} comparisons, {joins} joins, {negations} negations"
}

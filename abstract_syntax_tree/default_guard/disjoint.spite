var function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var number_names = ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]

# ../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func Disjoint(starting_function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    function = starting_function
}

func holds(first: SpiteCompiler.Expression?, second: SpiteCompiler.Expression?): Boolean {
    fallback first.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    fallback second.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    var left = first.left
    var other_left = second.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback other_left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback left.name == other_left.name and is_a_number_here(left.name)
    var bound = number_of(first.right)
    var other_bound = number_of(second.right)
    fallback bound and other_bound
    return never_meet(first.operator, bound, second.operator, other_bound)
}

func number_of(written: SpiteCompiler.Expression?): Integer? {
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    fallback written.kind == 'integer_literal'
    return written.text
}

func never_meet(
    operator: AbstractSyntaxTree.Tokens.Token.Kind,
    bound: Integer,
    other_operator: AbstractSyntaxTree.Tokens.Token.Kind,
    other_bound: Integer,
): Boolean {
    if is_a_lower_limit(operator) and is_an_upper_limit(other_operator) {
        return lies_above(operator, bound, other_operator, other_bound)
    }
    if is_an_upper_limit(operator) and is_a_lower_limit(other_operator) {
        return lies_above(other_operator, other_bound, operator, bound)
    }
    return false
}

func is_a_lower_limit(operator: AbstractSyntaxTree.Tokens.Token.Kind): Boolean {
    return operator == 'greater' or operator == 'greater_or_equal' or operator == 'equal_equal'
}

func is_an_upper_limit(operator: AbstractSyntaxTree.Tokens.Token.Kind): Boolean {
    return operator == 'less' or operator == 'less_or_equal' or operator == 'equal_equal'
}

func lies_above(
    lower: AbstractSyntaxTree.Tokens.Token.Kind,
    lower_bound: Integer,
    upper: AbstractSyntaxTree.Tokens.Token.Kind,
    upper_bound: Integer,
): Boolean {
    if lower_bound != upper_bound {
        return lower_bound > upper_bound
    }
    return lower == 'greater' or upper == 'less'
}

func is_a_number_here(name: String): Boolean {
    crash function
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return is_a_number_type(parameter.declared_type)
        }
        index = index + 1
    }
    return false
}

func is_a_number_type(written: SpiteCompiler.Type?): Boolean {
    fallback written and not written.is_nullable
    var last = written.path.last()
    crash last
    return number_names.contains(last)
}

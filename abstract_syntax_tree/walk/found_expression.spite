var expression: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var line = 0
var function_name = ""

func FoundExpression(
    starting_expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_line: Integer,
    starting_function_name: String,
) {
    expression = starting_expression
    line = starting_line
    function_name = starting_function_name
}

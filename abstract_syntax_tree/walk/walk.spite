var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var function_declarations = List<AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>()
var attribute_declarations = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
var blocks = List<FoundBlock>()
var statements = List<FoundStatement>()
var expressions = List<FoundExpression>()
var function_name = ""
var line = 0

func Walk(starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    file = starting_file
    file.declarations.each(read_declaration)
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        read_function(declaration)
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        read_attribute(declaration)
    }
}

func read_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    attribute_declarations.append(attribute)
    function_name = ""
    line = attribute.line
    read_expression(attribute.value)
}

func read_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    function_declarations.append(function)
    function_name = function.name
    assert function.body
    read_block(function.body)
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    assert block
    var found = FoundBlock(block, function_name)
    blocks.append(found)
    block.statements.each(read_statement)
}

func read_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    var found = FoundStatement(statement, function_name)
    statements.append(found)
    line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.AssertStatement: read_assert(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: read_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: read_expression(statement.folder)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        _: read_expression(statement.value)
    }
}

func read_assert(statement: AbstractSyntaxTree.Shapes.Statements.AssertStatement) {
    read_expression(statement.condition)
}

func read_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    read_expression(statement.condition)
}

func read_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    read_expression(statement.target)
    read_expression(statement.value)
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    read_expression(statement.condition)
    read_block(statement.then_branch)
    read_block(statement.else_branch)
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    read_expression(statement.condition)
    read_block(statement.body)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    read_expression(statement.value)
    statement.cases.each(read_case)
}

func read_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    read_expression(switch_case.value)
    read_block(switch_case.body)
}

func read_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    assert expression
    var found = FoundExpression(expression, line, function_name)
    expressions.append(found)
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: expression.pieces.each(read_piece)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_expression(expression.target)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: read_call(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: read_index(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_binary(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read_expression(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: expression.entries.each(read_present_expression)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: expression.pairs.each(read_present_expression)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: read_entry(expression)
        _: return
    }
}

func read_present_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    read_expression(expression)
}

func read_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    read_expression(piece.hole)
}

func read_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    read_expression(call.callee)
    call.arguments.each(read_present_expression)
}

func read_index(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    read_expression(index.target)
    read_expression(index.index)
}

func read_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    read_expression(binary.left)
    read_expression(binary.right)
}

func read_entry(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral) {
    read_expression(entry.key)
    read_expression(entry.value)
}

func function_named(name: String): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    return function_declarations.find_by_name(name)
}

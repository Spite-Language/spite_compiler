var constructor: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var own_functions = List<String>()
var own_declarations = List<AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>()
var leaving = ""
var one_sided = ""
var reading = ""
var reading_path = ""
var followed = List<String>()
var holders = List<String>()
var held_names = List<String>()

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func ConstructorPaths(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var class_name = file.class_name()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            note_a_function(declaration, class_name)
        }
        index = index + 1
    }
    var attribute_index = 0
    while attribute_index < file.declarations.count() {
        var declaration = file.declarations[attribute_index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            note_what_it_holds(declaration)
        }
        attribute_index = attribute_index + 1
    }
}

func note_what_it_holds(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var function_name = function_named_by(attribute.value)
    fallback own_functions.contains(function_name)
    holders.append(attribute.name)
    held_names.append(function_name)
}

func function_named_by(value: SpiteCompiler.Expression?): String {
    fallback value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return value.name
    }
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback mentions(value.target, "this")
    return value.name
}

func note_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, class_name: String) {
    if function.is_a_constructor_of(class_name) {
        constructor = function
    } else {
        own_functions.append(function.name)
        own_declarations.append(function)
    }
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func made_in(): String {
    fallback constructor
    return constructor.path
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func path_without(name: String): String {
    leaving = ""
    one_sided = ""
    reading_path = ""
    if not constructor {
        return "the class has no constructor in this file to give it one"
    }
    var filled = fills(constructor.body, name)
    if not leaving.is_empty() {
        return leaving
    }
    fallback not filled
    if not one_sided.is_empty() {
        return one_sided
    }
    return "the constructor never gives it one"
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func read_before(name: String): String {
    reading = ""
    reading_path = ""
    fallback constructor
    fallback not names_a_parameter(constructor, name)
    look_for_reads_in(constructor.body, name)
    return reading
}

func names_a_parameter(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func look_for_reads_in(block: AbstractSyntaxTree.Shapes.Statements.Block?, name: String) {
    fallback block
    var is_filled = false
    var index = 0
    while index < block.statements.count() and reading.is_empty() and not is_filled {
        var statement = block.statements[index]
        is_filled = fills_before_read(statement, name)
        index = index + 1
    }
}

func filled_before_read(block: AbstractSyntaxTree.Shapes.Statements.Block?, name: String): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() and reading.is_empty() {
        var statement = block.statements[index]
        if fills_before_read(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func fills_before_read(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return an_assignment_fills(statement, name)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return a_return_leaves(statement, name)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return both_sides_fill_before_read(statement, name)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: return a_loop_gives_nothing_after(statement, name)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return a_switch_gives_nothing_after(statement, name)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return gives_nothing_after(statement.value, statement.line, name)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return a_local_hides_it(statement, name)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return gives_nothing_after(statement.condition, statement.line, name)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return gives_nothing_after(statement.condition, statement.line, name)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return false
        AbstractSyntaxTree.Shapes.Statements.Block: return filled_before_read(statement, name)
    }
}

func an_assignment_fills(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, name: String): Boolean {
    note_a_read(statement.value, statement.line, name)
    if names_the_attribute(statement.target, name) {
        return true
    }
    note_a_read(statement.target, statement.line, name)
    return false
}

func a_return_leaves(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement, name: String): Boolean {
    note_a_read(statement.value, statement.line, name)
    return true
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func both_sides_fill_before_read(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, name: String): Boolean {
    var then_fills = List<Boolean>()
    var both_fill = false
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = branch
    while link {
        var current = link
        link = null
        note_a_read(current.condition, current.line, name)
        var then_filled = filled_before_read(current.then_branch, name)
        then_fills.append(then_filled)
        var next = current.else_if()
        if next and reading.is_empty() {
            link = next
        } else if not next and current.else_branch {
            both_fill = filled_before_read(current.else_branch, name)
        }
    }
    var index = then_fills.count() - 1
    while index >= 0 {
        both_fill = then_fills[index] == true and both_fill
        index = index - 1
    }
    return both_fill
}

func a_loop_gives_nothing_after(loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement, name: String): Boolean {
    note_a_read(loop.condition, loop.line, name)
    look_for_reads_in(loop.body, name)
    return false
}

func a_switch_gives_nothing_after(choice: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, name: String): Boolean {
    note_a_read(choice.value, choice.line, name)
    var index = 0
    while index < choice.cases.count() {
        var switch_case = choice.cases[index]
        note_a_read(switch_case.value, switch_case.line, name)
        look_for_reads_in(switch_case.body, name)
        index = index + 1
    }
    return false
}

func gives_nothing_after(value: SpiteCompiler.Expression?, line: Integer, name: String): Boolean {
    note_a_read(value, line, name)
    return false
}

func a_local_hides_it(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement, name: String): Boolean {
    note_a_read(statement.value, statement.line, name)
    return statement.name == name
}

func note_a_read(value: SpiteCompiler.Expression?, line: Integer, name: String) {
    fallback reading.is_empty()
    fallback value
    if mentions(value, name) {
        reading = "line {line} reads it before it has one"
        return
    }
    if mentions(value, "this") {
        reading = "line {line} hands 'this' out before it has one"
        return
    }
    var reached = own_function_reaching(value, name)
    fallback reached
    reading = "line {line} calls '{reached.name}', which uses it, before it has one"
    reading_path = reached.path
}

func own_function_reaching(
    value: SpiteCompiler.Expression,
    name: String,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var index = 0
    while index < own_declarations.count() {
        var function = own_declarations[index]
        if names_the_function(value, function.name) {
            followed = List<String>()
            if reaches(function, name) {
                return function
            }
        }
        index = index + 1
    }
    return null
}

func reaches(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    fallback not followed.contains(function.name)
    followed.append(function.name)
    fallback not names_a_parameter(function, name)
    if block_mentions(function.body, name) or block_mentions(function.body, "this") {
        return true
    }
    var index = 0
    while index < own_declarations.count() {
        var called = own_declarations[index]
        if block_names_the_function(function.body, called.name) and reaches(called, name) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func names_the_function(value: SpiteCompiler.Expression, function_name: String): Boolean {
    if mentions(value, function_name) {
        return true
    }
    var index = 0
    while index < holders.count() {
        var holder = holders[index]
        if held_names[index] == function_name and mentions(value, holder) {
            return true
        }
        index = index + 1
    }
    return false
}

func block_names_the_function(block: AbstractSyntaxTree.Shapes.Statements.Block?, function_name: String): Boolean {
    if block_mentions(block, function_name) {
        return true
    }
    var index = 0
    while index < holders.count() {
        var holder = holders[index]
        if held_names[index] == function_name and block_mentions(block, holder) {
            return true
        }
        index = index + 1
    }
    return false
}

func block_mentions(block: AbstractSyntaxTree.Shapes.Statements.Block?, name: String): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement_mentions(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_mentions(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return mentions(statement.target, name) or mentions(statement.value, name)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return mentions(statement.value, name)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return an_if_mentions(statement, name)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: return mentions(statement.condition, name) or block_mentions(statement.body, name)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return a_switch_mentions(statement, name)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return mentions(statement.value, name)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return mentions(statement.value, name)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return mentions(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return mentions(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return false
        AbstractSyntaxTree.Shapes.Statements.Block: return block_mentions(statement, name)
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func an_if_mentions(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, name: String): Boolean {
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = branch
    while link {
        var current = link
        if mentions(current.condition, name) or block_mentions(current.then_branch, name) {
            return true
        }
        link = current.else_if()
        if not link {
            return block_mentions(current.else_branch, name)
        }
    }
    return false
}

func a_switch_mentions(choice: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, name: String): Boolean {
    if mentions(choice.value, name) {
        return true
    }
    var index = 0
    while index < choice.cases.count() {
        var switch_case = choice.cases[index]
        if mentions(switch_case.value, name) or block_mentions(switch_case.body, name) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func is_given_first(name: String): Boolean {
    fallback constructor
    fallback constructor.body
    var index = 0
    while index < constructor.body.statements.count() {
        var statement = constructor.body.statements[index]
        fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
        fallback not mentions(statement.value, name) and not mentions(statement.value, "this")
        fallback not calls_its_own_function(statement.value)
        if assigns(statement, name) {
            return true
        }
        fallback assigns_an_attribute(statement)
        index = index + 1
    }
    return false
}

func fills(block: AbstractSyntaxTree.Shapes.Statements.Block?, name: String): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if assigns(statement, name) {
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            note_leaving(statement.line)
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement and fills_both_sides(statement, name) {
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement and leaves_in_a_loop(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func leaves_in_a_loop(loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement, name: String): Boolean {
    var reached = fills(loop.body, name)
    return reached and not leaving.is_empty()
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func fills_both_sides(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, name: String): Boolean {
    var links = List<AbstractSyntaxTree.Shapes.Statements.IfStatement>()
    var then_fills = List<Boolean>()
    var else_fills = false
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = branch
    while link {
        var current = link
        links.append(current)
        var then_filled = fills(current.then_branch, name)
        then_fills.append(then_filled)
        link = current.else_if()
        if not link and current.else_branch {
            else_fills = fills(current.else_branch, name)
        }
    }
    var index = links.count() - 1
    while index >= 0 {
        var current = links[index]
        crash current
        var then_filled = then_fills[index] == true
        if then_filled != else_fills and one_sided.is_empty() {
            one_sided = "the 'if' at line {current.line} gives it one on one side only"
        }
        else_fills = then_filled and else_fills
        index = index - 1
    }
    return else_fills
}

func note_leaving(line: Integer) {
    if leaving.is_empty() {
        leaving = "the 'return' at line {line} leaves before it has one"
    }
}

func assigns(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return names_the_attribute(statement.target, name)
    }
    return false
}

func assigns_an_attribute(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement): Boolean {
    var target = statement.target
    return target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
}

func names_the_attribute(target: SpiteCompiler.Expression?, name: String): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return target.name == name
    }
    return false
}

func calls_its_own_function(value: SpiteCompiler.Expression?): Boolean {
    fallback value
    switch value {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return a_call_reaches_its_own_function(value)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return calls_its_own_function(value.target)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return a_binary_calls_its_own_function(value)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return calls_its_own_function(value.operand)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return calls_its_own_function(value.target) or calls_its_own_function(value.index)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return a_text_calls_its_own_function(value)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return any_calls_its_own_function(value.entries)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return any_calls_its_own_function(value.pairs)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return calls_its_own_function(value.key) or calls_its_own_function(value.value)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return own_functions.contains(value.name)
    }
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func a_binary_calls_its_own_function(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var links = [binary]
    var lowest = binary
    var next = called_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = called_left_link_of(lowest)
    }
    var found = calls_its_own_function(lowest.left)
    var index = links.count() - 1
    while not found and index >= 0 {
        var link = links[index]
        crash link
        found = calls_its_own_function(link.right)
        index = index - 1
    }
    return found
}

func called_left_link_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.BinaryExpression? {
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    return left
}

func a_call_reaches_its_own_function(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    return calls_its_own_function(call.callee) or any_calls_its_own_function(call.arguments)
}

func any_calls_its_own_function(values: List<SpiteCompiler.Expression>): Boolean {
    return values.any(a_present_value_calls_its_own_function)
}

func a_present_value_calls_its_own_function(value: SpiteCompiler.Expression): Boolean {
    return calls_its_own_function(value)
}

func a_text_calls_its_own_function(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        if calls_its_own_function(piece.hole) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func mentions(value: SpiteCompiler.Expression?, name: String): Boolean {
    fallback value
    switch value {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return value.name == name
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return mentions(value.target, name)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return mentions_in_a_call(value, name)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return mentions_in_a_binary(value, name)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return mentions(value.operand, name)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return mentions(value.target, name) or mentions(value.index, name)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return mentions_in_a_text(value, name)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return mentions_in_any(value.entries, name)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return mentions_in_any(value.pairs, name)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return mentions(value.key, name) or mentions(value.value, name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return name == "this" and value.kind == 'keyword_this'
    }
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func mentions_in_a_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, name: String): Boolean {
    var links = [binary]
    var lowest = binary
    var next = mentioned_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = mentioned_left_link_of(lowest)
    }
    var found = mentions(lowest.left, name)
    var index = links.count() - 1
    while not found and index >= 0 {
        var link = links[index]
        crash link
        found = mentions(link.right, name)
        index = index - 1
    }
    return found
}

func mentioned_left_link_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.BinaryExpression? {
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    return left
}

func mentions_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    return mentions(call.callee, name) or mentions_in_any(call.arguments, name)
}

func mentions_in_any(values: List<SpiteCompiler.Expression>, name: String): Boolean {
    var index = 0
    while index < values.count() {
        var value = values[index]
        if mentions(value, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func mentions_in_a_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral, name: String): Boolean {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        if mentions(piece.hole, name) {
            return true
        }
        index = index + 1
    }
    return false
}

var constructor: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var own_functions = List<String>()
var leaving = ""
var one_sided = ""

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func ConstructorPaths(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var class_name = file.class_name()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            note_a_function(declaration, class_name)
        }
        index = index + 1
    }
}

func note_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, class_name: String) {
    if function.is_a_constructor_of(class_name) {
        constructor = function
    } else {
        own_functions.append(function.name)
    }
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func path_without(name: String): String {
    leaving = ""
    one_sided = ""
    if not constructor {
        return "the class has no constructor in this file to give it one"
    }
    var filled = fills(constructor.body, name)
    if not leaving.is_empty() {
        return leaving
    }
    fallback not filled
    if not one_sided.is_empty() {
        return one_sided
    }
    return "the constructor never gives it one"
}

# ../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func is_given_first(name: String): Boolean {
    fallback constructor
    fallback constructor.body
    var index = 0
    while index < constructor.body.statements.count() {
        var statement = constructor.body.statements[index]
        fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
        fallback not mentions(statement.value, name) and not mentions(statement.value, "this")
        fallback not calls_its_own_function(statement.value)
        if assigns(statement, name) {
            return true
        }
        fallback assigns_an_attribute(statement)
        index = index + 1
    }
    return false
}

func fills(block: AbstractSyntaxTree.Shapes.Statements.Block?, name: String): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if assigns(statement, name) {
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            note_leaving(statement.line)
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement and fills_both_sides(statement, name) {
            return true
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement and leaves_in_a_loop(statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func leaves_in_a_loop(loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement, name: String): Boolean {
    var reached = fills(loop.body, name)
    return reached and not leaving.is_empty()
}

func fills_both_sides(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, name: String): Boolean {
    var then_fills = fills(branch.then_branch, name)
    var else_fills = false
    if branch.else_branch {
        else_fills = fills(branch.else_branch, name)
    }
    if then_fills != else_fills and one_sided.is_empty() {
        one_sided = "the 'if' at line {branch.line} gives it one on one side only"
    }
    return then_fills and else_fills
}

func note_leaving(line: Integer) {
    if leaving.is_empty() {
        leaving = "the 'return' at line {line} leaves before it has one"
    }
}

func assigns(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return names_the_attribute(statement.target, name)
    }
    return false
}

func assigns_an_attribute(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement): Boolean {
    var target = statement.target
    return target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
}

func names_the_attribute(target: SpiteCompiler.Expression?, name: String): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return target.name == name
    }
    return false
}

func calls_its_own_function(value: SpiteCompiler.Expression?): Boolean {
    fallback value
    switch value {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return a_call_reaches_its_own_function(value)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return calls_its_own_function(value.target)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return calls_its_own_function(value.left) or calls_its_own_function(value.right)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return calls_its_own_function(value.operand)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return calls_its_own_function(value.target) or calls_its_own_function(value.index)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return a_text_calls_its_own_function(value)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return any_calls_its_own_function(value.entries)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return any_calls_its_own_function(value.pairs)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return calls_its_own_function(value.key) or calls_its_own_function(value.value)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return own_functions.contains(value.name)
    }
}

func a_call_reaches_its_own_function(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    return calls_its_own_function(call.callee) or any_calls_its_own_function(call.arguments)
}

func any_calls_its_own_function(values: List<SpiteCompiler.Expression>): Boolean {
    return values.any(a_present_value_calls_its_own_function)
}

func a_present_value_calls_its_own_function(value: SpiteCompiler.Expression): Boolean {
    return calls_its_own_function(value)
}

func a_text_calls_its_own_function(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        if calls_its_own_function(piece.hole) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func mentions(value: SpiteCompiler.Expression?, name: String): Boolean {
    fallback value
    switch value {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return value.name == name
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return mentions(value.target, name)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return mentions_in_a_call(value, name)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return mentions(value.left, name) or mentions(value.right, name)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return mentions(value.operand, name)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return mentions(value.target, name) or mentions(value.index, name)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return mentions_in_a_text(value, name)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return mentions_in_any(value.entries, name)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return mentions_in_any(value.pairs, name)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return mentions(value.key, name) or mentions(value.value, name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return name == "this" and value.kind == 'keyword_this'
    }
}

func mentions_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    return mentions(call.callee, name) or mentions_in_any(call.arguments, name)
}

func mentions_in_any(values: List<SpiteCompiler.Expression>, name: String): Boolean {
    var index = 0
    while index < values.count() {
        var value = values[index]
        if mentions(value, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func mentions_in_a_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral, name: String): Boolean {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        if mentions(piece.hole, name) {
            return true
        }
        index = index + 1
    }
    return false
}

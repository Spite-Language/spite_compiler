enum Kind {
    'end_of_file'
    'name'
    'class_name'
    'generic_name'
    'integer_literal'
    'decimal_literal'
    'text_literal'
    'symbol_literal'
    'open_brace'
    'close_brace'
    'open_parenthesis'
    'close_parenthesis'
    'open_bracket'
    'close_bracket'
    'comma'
    'dot'
    'dots'
    'colon'
    'question'
    'equals'
    'plus'
    'minus'
    'star'
    'slash'
    'percent'
    'equal_equal'
    'not_equal'
    'less'
    'greater'
    'less_or_equal'
    'greater_or_equal'
    'and'
    'or'
    'not'
    'keyword_function'
    'keyword_variable'
    'keyword_enum'
    'keyword_union'
    'keyword_type'
    'keyword_return'
    'keyword_if'
    'keyword_else'
    'keyword_while'
    'keyword_switch'
    'keyword_assert'
    'keyword_crash'
    'keyword_load'
    'keyword_this'
    'keyword_null'
    'keyword_true'
    'keyword_false'
    'keyword_generic'
    'keyword_singleton'
}

var kind: Kind = 'end_of_file'
var lexeme = ""
var text = ""
var line = 0
var column = 0

func Token(
    starting_kind: Kind,
    starting_lexeme: String,
    starting_text: String,
    starting_line: Integer,
    starting_column: Integer,
) {
    kind = starting_kind
    lexeme = starting_lexeme
    text = starting_text
    line = starting_line
    column = starting_column
}

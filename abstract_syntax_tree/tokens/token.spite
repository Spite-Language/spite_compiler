var kind: AbstractSyntaxTree.Tokens.TokenKind = 'end_of_file'
var lexeme = ""
var text = ""
var line = 0
var column = 0

func Token(
    starting_kind: AbstractSyntaxTree.Tokens.TokenKind,
    starting_lexeme: String,
    starting_text: String,
    starting_line: Integer,
    starting_column: Integer,
) {
    kind = starting_kind
    lexeme = starting_lexeme
    text = starting_text
    line = starting_line
    column = starting_column
}

func written(): String {
    return "'{lexeme}'"
}

func where_written(): String {
    return "{line}:{column}: {written()}"
}

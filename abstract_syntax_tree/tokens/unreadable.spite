enum Reading {
    'mark'
    'symbol'
    'text'
    'hole'
    'codegen_value'
}

var reading: Reading = 'mark'
var written = ""
var following = ""
var line = 0

func Unreadable(
    starting_reading: Reading,
    starting_written: String,
    starting_following: String,
    starting_line: Integer,
) {
    reading = starting_reading
    written = starting_written
    following = starting_following
    line = starting_line
}

enum Reading {
    'mark'
    'symbol'
    'text'
    'hole'
    'codegen_value'
}

var reading: Reading
var written: String
var following: String
var line: Integer
var column: Integer

func Unreadable(
    starting_reading: Reading,
    starting_written: String,
    starting_following: String,
    starting_line: Integer,
    starting_column: Integer,
) {
    reading = starting_reading
    written = starting_written
    following = starting_following
    line = starting_line
    column = starting_column
}

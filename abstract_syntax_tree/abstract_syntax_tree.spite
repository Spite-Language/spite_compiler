var path = ""
var namespace = ""
var text = ""
var tokens = List<AbstractSyntaxTree.Tokens.Token>()
var comments = List<AbstractSyntaxTree.Shapes.Comment>()
var stops = Dictionary<Integer, String>()
var placed_stops = List<Integer>()
var fixes_as_class = ""
var token_fixes = List<Diagnostics.Problem>()
var gathering = Diagnostics.Gathering()
var keeps_the_comments = true

func AbstractSyntaxTree(starting_path: String, starting_namespace: String, starting_text: String) {
    path = starting_path
    namespace = starting_namespace
    text = starting_text
}

func run(): AbstractSyntaxTree.Shapes.SourceFile {
    var outer_check = gathering.running_check
    var outer_goes_on = gathering.goes_on
    gathering.start_reading(path)
    var tree = tree_of_the_text()
    gathering.start_a_check(outer_check)
    gathering.goes_on = outer_goes_on
    return tree
}

func tree_of_the_text(): AbstractSyntaxTree.Shapes.SourceFile {
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, text, first_line)
    tokens = lexer.tokens_of()
    if keeps_the_comments {
        comments = lexer.comments
    }
    if not fixes_as_class.is_empty() {
        var fixing = Fixes.Tokens.EveryFix()
        token_fixes = fixing.fixed(path, fixes_as_class, tokens)
    }
    var parser = AbstractSyntaxTree.Parser.Parser(path, namespace, tokens)
    parser.stops = stops
    parser.comments = comments
    var tree = parser.parse_file()
    placed_stops = parser.placed_stops
    tree.comments = comments
    if text.contains("\r\n") {
        tree.line_break = "\r\n"
    }
    return tree
}

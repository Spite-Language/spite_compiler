var found = List<AbstractSyntaxTree.Tokens.Token>()
var comments = List<AbstractSyntaxTree.Shapes.Comment>()
var keywords = Dictionary<String, AbstractSyntaxTree.Tokens.Token.Kind>()
var unread = List<AbstractSyntaxTree.Tokens.Unreadable>()
var position = 0
var column = 1
var line_break = 10
var carriage_return = 13
var _open_brace_code = 123
var _close_brace_code = 125
var _lowercase_z_code = 122
var _lowercase_e_code = 101
var path: String
var source: String
var line: Integer

func Lexer(starting_path: String, starting_source: String, starting_line: Integer) {
    path = starting_path
    source = starting_source
    line = starting_line
    learn_keywords()
}

func tokens_of(): List<AbstractSyntaxTree.Tokens.Token> {
    read_all_tokens()
    record('end_of_file', "", "", line, column)
    return found
}

func read_all_tokens() {
    while not at_end() {
        skip_layout()
        if not at_end() {
            read_token()
        }
    }
}

func skip_layout() {
    while layout_here() {
        skip_one_layout()
    }
}

func layout_here(): Boolean {
    fallback not at_end()
    var code = code_here()
    return is_space(code) or code == 35
}

func skip_one_layout() {
    var code = code_here()
    if is_space(code) {
        step()
    } else {
        skip_comment()
    }
}

func skip_comment() {
    var start = line
    var start_position = position + 1
    while not at_end() and not a_line_ends_here() {
        step()
    }
    var written = source.slice(start_position, position)
    crash written
    var trimmed = written.trim()
    var comment = AbstractSyntaxTree.Shapes.Comment(start, trimmed)
    comments.append(comment)
}

func read_token() {
    var code = code_here()
    if code == 34 {
        read_text()
    } else if code == 39 {
        read_symbol()
    } else if code == _open_brace_code {
        simple('open_brace')
    } else if code == _close_brace_code {
        simple('close_brace')
    } else if code == 40 {
        simple('open_parenthesis')
    } else if code == 41 {
        simple('close_parenthesis')
    } else if code == 91 {
        simple('open_bracket')
    } else if code == 93 {
        simple('close_bracket')
    } else if code == 44 {
        simple('comma')
    } else if code == 58 {
        simple('colon')
    } else if code == 63 {
        simple('question')
    } else if code == 46 {
        read_dot()
    } else if code == 36 {
        read_generic_name()
    } else if code == 37 {
        simple('percent')
    } else if code == 43 {
        simple('plus')
    } else if code == 45 {
        simple('minus')
    } else if code == 61 {
        read_equals()
    } else if code == 47 {
        simple('slash')
    } else if code == 42 {
        simple('star')
    } else if code == 60 {
        read_less()
    } else if code == 62 {
        read_greater()
    } else if code == 33 {
        read_not()
    } else {
        read_anything_else(code)
    }
}

func read_anything_else(code: Integer) {
    if starts_a_name(code) {
        read_name()
        return
    }
    if is_digit(code) {
        read_number()
        return
    }
    keep_a_mark()
}

func follows_a_dot(): Boolean {
    var last = found.last()
    fallback last
    return last.kind == 'dot'
}

func read_name() {
    var start = line
    var column_here = column
    var word = ""
    var code = code_here()
    while inside_name(code) {
        var letter = source[position]
        crash letter
        word = "{word}{letter}"
        step()
        code = code_here()
    }
    var is_a_member = follows_a_dot()
    var keyword = keywords[word]
    if keyword and not is_a_member {
        record(keyword, word, word, start, column_here)
        return
    }
    var kind: AbstractSyntaxTree.Tokens.Token.Kind = 'name'
    var first = word.byte_at(0)
    if is_upper_letter(first) {
        kind = 'class_name'
    }
    record(kind, word, word, start, column_here)
}

func read_number() {
    var start = line
    var column_here = column
    var word = digits_here()
    var kind: AbstractSyntaxTree.Tokens.Token.Kind = 'integer_literal'
    var code = code_here()
    var after_point = code_after(1)
    if code == 46 and starts_digits(after_point) {
        kind = 'decimal_literal'
        step()
        var fraction = digits_here()
        word = "{word}.{fraction}"
    }
    var exponent = exponent_here()
    var exponent_length = exponent.length()
    move_to(position + exponent_length)
    word = "{word}{exponent}"
    var value = word.replace("_", "")
    record(kind, word, value, start, column_here)
}

func digits_here(): String {
    var word = ""
    var code = code_here()
    while starts_digits(code) {
        var letter = source[position]
        crash letter
        word = "{word}{letter}"
        step()
        code = code_here()
    }
    return word
}

func starts_digits(code: Integer): Boolean {
    return is_digit(code) or code == 95
}

func exponent_here(): String {
    var length = exponent_length_here()
    fallback length > 0
    var exponent = source.slice(position, position + length)
    crash exponent
    return exponent
}

func exponent_length_here(): Integer {
    var code = code_here()
    fallback code == _lowercase_e_code or code == 69
    var length = 1
    var after = code_after(1)
    if after == 43 or after == 45 {
        length = 2
        after = code_after(2)
    }
    fallback is_digit(after)
    var next = code_after(length)
    while is_digit(next) {
        length = length + 1
        next = code_after(length)
    }
    return length
}

func read_symbol() {
    var start = line
    var column_here = column
    var word = ""
    step()
    var code = code_here()
    while inside_name(code) {
        var letter = source[position]
        crash letter
        word = "{word}{letter}"
        step()
        code = code_here()
    }
    if code != 39 {
        keep_unread('symbol', word, "", start, column_here)
        return
    }
    step()
    record('symbol_literal', word, word, start, column_here)
}

func read_generic_name() {
    var start = line
    var column_here = column
    var word = "$"
    step()
    var code = code_here()
    while inside_name(code) {
        var letter = source[position]
        crash letter
        word = "{word}{letter}"
        step()
        code = code_here()
    }
    if word == "$" {
        keep_unread('codegen_value', word, "", start, column_here)
        return
    }
    record('generic_name', word, word, start, column_here)
}

func read_text() {
    var start = line
    var column_here = column
    var content = ""
    step()
    while not at_end() {
        var code = code_here()
        if ends_a_line(code) {
            keep_unread('text', content, "", start, column_here)
            return
        } else if code == 34 {
            close_text(start, column_here, content)
            return
        } else if code == 92 and escape_ends_the_line() {
            keep_unread('text', content, "", line, column_here)
            return
        } else if code == _open_brace_code {
            var end = end_of_hole()
            if end < 0 {
                keep_unread('hole', content, "", line, column_here)
                var length = source.length()
                move_to(length)
                return
            }
            content = read_hole_text(content, end)
        } else {
            content = read_inside_text(code, content)
        }
    }
    keep_unread('text', content, "", start, column_here)
}

func read_inside_text(code: Integer, content: String): String {
    if code == 92 {
        return read_escape_pair(content)
    }
    return read_one_letter(content)
}

func close_text(start: Integer, column_here: Integer, content: String) {
    step()
    record('text_literal', content, content, start, column_here)
}

func escape_ends_the_line(): Boolean {
    var code = code_after(1)
    return ends_a_line(code) or code == -1
}

func read_escape_pair(content: String): String {
    var pair = source.slice(position, position + 2)
    crash pair
    move_to(position + 2)
    return "{content}{pair}"
}

func read_hole_text(content: String, end: Integer): String {
    var raw = source.slice(position, end + 1)
    crash raw
    move_to(end + 1)
    return "{content}{raw}"
}

func read_one_letter(content: String): String {
    var letter = source[position]
    crash letter
    var after = position + letter.length()
    move_to(after)
    return "{content}{letter}"
}

func move_to(where: Integer) {
    var keep_going = position < where
    while keep_going and not at_end() {
        step()
        keep_going = position < where
    }
}

func end_of_hole(): Integer {
    var depth = 0
    var index = position
    while index < source.length() {
        var code = source.byte_at(index)
        if code == 34 {
            index = past_inner_text(source, index)
        } else {
            depth = depth + brace_of(code)
            if depth == 0 {
                return index
            }
            index = index + 1
        }
    }
    return -1
}

func brace_of(code: Integer): Integer {
    if code == _open_brace_code {
        return 1
    }
    if code == _close_brace_code {
        return -1
    }
    return 0
}

func past_inner_text(content: String, start: Integer): Integer {
    var index = start + 1
    while index < content.length() {
        var code = content.byte_at(index)
        if code == 92 {
            index = index + 2
        } else if code == 34 {
            return index + 1
        } else if code == _open_brace_code {
            index = past_inner_hole(content, index)
        } else {
            index = index + 1
        }
    }
    return content.length()
}

func past_inner_hole(content: String, start: Integer): Integer {
    var depth = 0
    var index = start
    while index < content.length() {
        var code = content.byte_at(index)
        if code == 34 {
            index = past_inner_text(content, index)
        } else {
            depth = depth + brace_of(code)
            index = index + 1
            if depth == 0 {
                return index
            }
        }
    }
    return content.length()
}

func read_dot() {
    var second = code_after(1)
    var third = code_after(2)
    if second == 46 and third == 46 {
        written_run('dots', 3)
        return
    }
    simple('dot')
}

func read_equals() {
    var next_code = code_after(1)
    if next_code == 61 {
        written_run('equal_equal', 2)
        return
    }
    simple('equals')
}

func read_less() {
    var next_code = code_after(1)
    if next_code == 61 {
        written_run('less_or_equal', 2)
        return
    }
    simple('less')
}

func read_greater() {
    var next_code = code_after(1)
    if next_code == 61 {
        written_run('greater_or_equal', 2)
        return
    }
    simple('greater')
}

func read_not() {
    var next_code = code_after(1)
    if next_code == 61 {
        written_run('not_equal', 2)
        return
    }
    keep_a_mark()
}

func simple(kind: AbstractSyntaxTree.Tokens.Token.Kind) {
    var start = line
    var column_here = column
    var written = source[position]
    crash written
    step()
    record(kind, written, written, start, column_here)
}

func written_run(kind: AbstractSyntaxTree.Tokens.Token.Kind, count: Integer) {
    var start = line
    var column_here = column
    var written = ""
    var index = 0
    while index < count {
        var letter = source[position]
        crash letter
        written = "{written}{letter}"
        step()
        index = index + 1
    }
    record(kind, written, written, start, column_here)
}

func keep_a_mark() {
    var start = line
    var column_here = column
    var written = source[position]
    crash written
    var following = ""
    var after = position + written.length()
    var next = source[after]
    if next {
        following = next
    }
    move_to(after)
    keep_unread('mark', written, following, start, column_here)
}

func keep_unread(
    reading: AbstractSyntaxTree.Tokens.Unreadable.Reading,
    written: String,
    following: String,
    starting_line: Integer,
    starting_column: Integer,
) {
    var piece = AbstractSyntaxTree.Tokens.Unreadable(reading, written, following, starting_line, starting_column)
    unread.append(piece)
}

func record(
    kind: AbstractSyntaxTree.Tokens.Token.Kind,
    lexeme: String,
    text: String,
    starting_line: Integer,
    starting_column: Integer,
) {
    var token = AbstractSyntaxTree.Tokens.Token(kind, lexeme, text, starting_line, starting_column)
    found.append(token)
}

func at_end(): Boolean {
    return position >= source.length()
}

func code_here(): Integer {
    if at_end() {
        return -1
    }
    return source.byte_at(position)
}

func code_after(offset: Integer): Integer {
    var at = position + offset
    if at < 0 or at >= source.length() {
        return -1
    }
    return source.byte_at(at)
}

func advance(): Integer {
    var code = source.byte_at(position)
    step()
    return code
}

func step() {
    var code = source.byte_at(position)
    position = position + 1
    if ends_a_line(code) and not a_line_break_follows(code) {
        line = line + 1
        column = 1
    } else {
        column = column + 1
    }
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func ends_a_line(code: Integer): Boolean {
    return code == line_break or code == carriage_return
}

func a_line_ends_here(): Boolean {
    var code = code_here()
    return ends_a_line(code)
}

func a_line_break_follows(code: Integer): Boolean {
    return code == carriage_return and code_here() == line_break
}

func is_space(code: Integer): Boolean {
    if code == 32 {
        return true
    } else if code == 9 {
        return true
    } else if code == 13 {
        return true
    } else {
        return code == 10
    }
}

func is_digit(code: Integer): Boolean {
    return code >= 48 and code <= 57
}

func is_lower_letter(code: Integer): Boolean {
    return code >= 97 and code <= _lowercase_z_code
}

func is_upper_letter(code: Integer): Boolean {
    return code >= 65 and code <= 90
}

func starts_a_name(code: Integer): Boolean {
    if is_lower_letter(code) {
        return true
    }
    if is_upper_letter(code) {
        return true
    }
    return code == 95
}

func inside_name(code: Integer): Boolean {
    if starts_a_name(code) {
        return true
    }
    if is_digit(code) {
        return true
    }
    return code == 95
}

func learn_keywords() {
    keywords["func"] = 'keyword_function'
    keywords["var"] = 'keyword_variable'
    keywords["enum"] = 'keyword_enum'
    keywords["union"] = 'keyword_union'
    keywords["type"] = 'keyword_type'
    keywords["return"] = 'keyword_return'
    keywords["if"] = 'keyword_if'
    keywords["else"] = 'keyword_else'
    keywords["while"] = 'keyword_while'
    keywords["switch"] = 'keyword_switch'
    keywords["fallback"] = 'keyword_fallback'
    keywords["assert"] = 'keyword_fallback'
    keywords["crash"] = 'keyword_crash'
    keywords["load"] = 'keyword_load'
    keywords["this"] = 'keyword_this'
    keywords["null"] = 'keyword_null'
    keywords["true"] = 'keyword_true'
    keywords["false"] = 'keyword_false'
    keywords["generic"] = 'keyword_generic'
    keywords["singleton"] = 'keyword_singleton'
    keywords["and"] = 'and'
    keywords["or"] = 'or'
    keywords["not"] = 'not'
}

var _backslash = "\\"
var _quote = "\""
var pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
var children: List<AbstractSyntaxTree.Shapes.Markup.Child>

# ../../../spite_documentation/markup.md#children
func Children(starting_children: List<AbstractSyntaxTree.Shapes.Markup.Child>) {
    children = starting_children
}

func runs(): List<List<AbstractSyntaxTree.Shapes.Markup.Child>> {
    var found = List<List<AbstractSyntaxTree.Shapes.Markup.Child>>()
    var run = List<AbstractSyntaxTree.Shapes.Markup.Child>()
    var index = 0
    while index < children.count() {
        var child = children[index]
        if child.kind == 'element' {
            if not run.is_empty() {
                found.append(run)
            }
            var alone = List<AbstractSyntaxTree.Shapes.Markup.Child>()
            alone.append(child)
            found.append(alone)
            run = List<AbstractSyntaxTree.Shapes.Markup.Child>()
        } else {
            run.append(child)
        }
        index = index + 1
    }
    if not run.is_empty() {
        found.append(run)
    }
    return found
}

# ../../../spite_documentation/markup.md#text-between-tags
func holds_text(): Boolean {
    var index = 0
    while index < children.count() {
        var child = children[index]
        if child.kind == 'text' {
            return true
        }
        index = index + 1
    }
    return false
}

func text(): AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
    pieces = List<AbstractSyntaxTree.Shapes.Expressions.TextPiece>()
    var index = 0
    while index < children.count() {
        var child = children[index]
        add_a_piece(child, index)
        index = index + 1
    }
    var literal = AbstractSyntaxTree.Shapes.Expressions.TextLiteral(pieces)
    var first = children[0]
    crash first
    literal.line = first.line
    return literal
}

func add_a_piece(child: AbstractSyntaxTree.Shapes.Markup.Child, index: Integer) {
    if child.kind != 'text' {
        var hole = AbstractSyntaxTree.Shapes.Expressions.TextPiece("", child.expression)
        pieces.append(hole)
        return
    }
    var shown = spaced(child.text)
    if index == 0 {
        shown = without_leading_space(shown)
    }
    if index == children.count() - 1 {
        shown = without_trailing_space(shown)
    }
    var escaped = shown.replace(_backslash, "{_backslash}{_backslash}")
    var written = escaped.replace(_quote, "{_backslash}{_quote}")
    var piece = AbstractSyntaxTree.Shapes.Expressions.TextPiece(written, null)
    pieces.append(piece)
}

# ../../../spite_documentation/markup.md#text-between-tags
func spaced(written: String): String {
    var flat = written.replace("\r", " ")
    flat = flat.replace("\n", " ")
    flat = flat.replace("\t", " ")
    while flat.contains("  ") {
        flat = flat.replace("  ", " ")
    }
    return flat
}

func without_leading_space(written: String): String {
    var shown = written
    while shown.starts_with(" ") {
        var length = shown.length()
        var rest = shown.slice(1, length)
        crash rest
        shown = rest
    }
    return shown
}

func without_trailing_space(written: String): String {
    var shown = written
    while shown.ends_with(" ") {
        var length = shown.length()
        var rest = shown.slice(0, length - 1)
        crash rest
        shown = rest
    }
    return shown
}

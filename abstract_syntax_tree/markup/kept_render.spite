var class_name = ""
var found = false
var is_flow = false
var depth = 0
var loops = 0
var counted = 0
var root_type = ""
var locals = List<String>()
var sites = List<String>()
var site_classes = List<String>()
var list_sites = List<String>()
var named_sites = Dictionary<String, String>()
var last_site = ""
var bound_sites = List<String>()
var bound_attributes = List<String>()
var bound_values = List<String>()
var watched = List<String>()
var watched_types = List<String>()
var watched_lists = List<String>()
var watched_items = List<String>()
var written_setters = List<String>()
var narrowings = List<String>()
var narrows_through_locals = false
var source = "compiler jsx"
var next_line = 0
var file: AbstractSyntaxTree.Shapes.SourceFile

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func KeptRender(starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    file = starting_file
    var segments = file.path.replace("\\", "/").split("/")
    var last = segments.last()
    crash last
    var stem = last.replace(".spite", "")
    class_name = stem.pascal_case()
}

func finds_a_render(): Boolean {
    fallback not file.declarations.any(is_generic)
    var render = render_function()
    fallback render
    fallback render.parameters.is_empty() and render.result
    fallback holds_markup(render.body)
    var printer = Printers.Spite.TypePrinter(render.result)
    var printed = printer.text()
    root_type = printed
    if not printed.ends_with("?") {
        root_type = "{printed}?"
    }
    found = true
    next_line = last_line() + 1
    return true
}

func last_line(): Integer {
    var last = 0
    var index = 0
    while index < file.comments.count() {
        var comment = file.comments[index]
        if comment.line > last {
            last = comment.line
        }
        index = index + 1
    }
    index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var declared_last = last_line_of(declaration)
        if declared_last > last {
            last = declared_last
        }
        index = index + 1
    }
    return last
}

func last_line_of(declaration: SpiteCompiler.Declaration): Integer {
    var last = declaration.line
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    var in_body = last_line_in(declaration.body)
    if in_body > last {
        return in_body + 1
    }
    return last
}

func last_line_in(block: AbstractSyntaxTree.Shapes.Statements.Block?): Integer {
    fallback block
    var last = block.line
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var inner = last_line_of_a_statement(statement)
        if inner > last {
            last = inner
        }
        index = index + 1
    }
    return last
}

func last_line_of_a_statement(statement: SpiteCompiler.WrittenStatement): Integer {
    var last = statement.line
    var inner = 0
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.IfStatement: inner = last_line_of_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: inner = last_line_in(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: inner = last_line_of_cases(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: inner = last_line_in(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: inner = last_line_of_markup(statement.markup)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: inner = last_line_of_markup(statement.markup)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: inner = 0
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: inner = 0
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: inner = 0
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: inner = 0
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: inner = 0
    }
    if inner > last {
        return inner
    }
    return last
}

func last_line_of_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Integer {
    var then_last = last_line_in(statement.then_branch)
    var else_last = last_line_in(statement.else_branch)
    if else_last > then_last {
        return else_last
    }
    return then_last
}

func last_line_of_cases(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement): Integer {
    var last = statement.line
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var inner = last_line_in(switch_case.body)
        if inner > last {
            last = inner
        }
        index = index + 1
    }
    return last
}

func last_line_of_markup(element: AbstractSyntaxTree.Shapes.Markup.Element?): Integer {
    fallback element
    var last = element.line
    var index = 0
    while index < element.written_attributes.count() {
        var attribute = element.written_attributes[index]
        if attribute.line > last {
            last = attribute.line
        }
        index = index + 1
    }
    index = 0
    while index < element.children.count() {
        var child = element.children[index]
        var inner = child.line
        if child.element {
            inner = last_line_of_markup(child.element)
        }
        if inner > last {
            last = inner
        }
        index = index + 1
    }
    return last + 1
}

func is_generic(declaration: SpiteCompiler.Declaration): Boolean {
    return declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
}

func render_function(): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and declaration.name == "render" {
            return declaration
        }
        index = index + 1
    }
    return null
}

func holds_markup(block: AbstractSyntaxTree.Shapes.Statements.Block?): Boolean {
    fallback block
    return block.statements.any(statement_holds_markup)
}

func statement_holds_markup(statement: SpiteCompiler.WrittenStatement): Boolean {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return variable_holds_markup(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return return_holds_markup(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return branches_hold_markup(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: return holds_markup(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return statement.cases.any(case_holds_markup)
        AbstractSyntaxTree.Shapes.Statements.Block: return holds_markup(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return false
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return false
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return false
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return false
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return false
    }
}

func variable_holds_markup(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    fallback statement.markup
    return true
}

func return_holds_markup(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement): Boolean {
    fallback statement.markup
    return true
}

func branches_hold_markup(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Boolean {
    if holds_markup(statement.then_branch) {
        return true
    }
    return holds_markup(statement.else_branch)
}

func case_holds_markup(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase): Boolean {
    return holds_markup(switch_case.body)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func add_the_copies() {
    var render = render_function()
    crash render
    learn_the_locals(render.body)
    learn_the_narrowings(render.body)
    var replay = copy_of(render, "jsx_replay")
    var flow = copy_of(render, "jsx_flow")
    file.declarations.append(replay)
    file.declarations.append(flow)
    file.declarations.each(note_a_written_setter)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func learn_the_narrowings(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(learn_a_narrowing)
}

func learn_a_narrowing(statement: SpiteCompiler.WrittenStatement) {
    var condition = condition_of_a_guard(statement)
    fallback condition
    var mentioned = List<String>()
    mentions_of(condition, mentioned)
    if mentioned.any(locals.contains) {
        narrows_through_locals = true
        return
    }
    var printer = Printers.Spite.StatementPrinter(statement)
    var printed = printer.text()
    narrowings.append(printed)
}

func condition_of_a_guard(statement: SpiteCompiler.WrittenStatement): SpiteCompiler.Expression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.CrashStatement {
        return statement.condition
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.FallbackStatement {
        return statement.condition
    }
    return null
}

func copy_of(
    render: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
    var printer = Printers.Spite.DeclarationPrinter(render)
    var printed = printer.text()
    var lines = printed.split("\n")
    lines[0] = "func {name}(): Boolean \{"
    var text = lines.join("\n")
    var made = parsed_declarations(text, next_line)
    var copied = made[0]
    crash copied
    crash copied.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    return copied
}

func note_a_written_setter(declaration: SpiteCompiler.Declaration) {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    var is_a_setter = declaration.name.starts_with("set_") or declaration.name.starts_with("_set_")
    fallback is_a_setter and declaration.parameters.count() == 1
    written_setters.append(declaration.name)
}

func learn_the_locals(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(learn_a_local)
}

func learn_a_local(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: locals.append(statement.name)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: learn_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: learn_the_locals(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: statement.cases.each(learn_a_case)
        AbstractSyntaxTree.Shapes.Statements.Block: learn_the_locals(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func learn_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    learn_the_locals(statement.then_branch)
    learn_the_locals(statement.else_branch)
}

func learn_a_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    learn_the_locals(switch_case.body)
}

func is_kept(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    fallback found and function.source == source
    return function.name == "jsx_replay" or function.name == "jsx_flow"
}

func start(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    is_flow = function.name == "jsx_flow"
    depth = 0
    loops = 0
    counted = 0
}

func enter(is_a_loop: Boolean) {
    depth = depth + 1
    if is_a_loop {
        loops = loops + 1
    }
}

func leave(is_a_loop: Boolean) {
    depth = depth - 1
    if is_a_loop {
        loops = loops - 1
    }
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func take_of(element: AbstractSyntaxTree.Shapes.Markup.Element): String {
    counted = counted + 1
    var last = element.last_segment()
    var base = last.snake_case()
    var site = "{base}_{counted}"
    if not sites.contains(site) {
        sites.append(site)
        site_classes.append(element.tag)
    }
    if loops > 0 and not list_sites.contains(site) {
        list_sites.append(site)
    }
    last_site = site
    return "jsx_take_{site}()"
}

func remade(line: Integer): SpiteCompiler.WrittenStatement {
    var made = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("_jsx_made")
    made.line = line
    var true_value = parsed_expression("true", line)
    var assigned = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(made, true_value)
    assigned.line = line
    return assigned
}

func name_the_site(local: String) {
    named_sites[local] = last_site
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func is_a_binding(name: String, attribute: String, value: SpiteCompiler.Expression): Boolean {
    fallback depth == 0 and attribute != "children" and not narrows_through_locals
    var site = named_sites[name]
    fallback site
    var mentioned = List<String>()
    mentions_of(value, mentioned)
    fallback not mentioned.is_empty()
    fallback not mentioned.any(locals.contains)
    if not is_flow {
        bound_sites.append(site)
        bound_attributes.append(attribute)
        var printer = Printers.Spite.ExpressionPrinter(value)
        var printed = printer.text()
        bound_values.append(printed)
    }
    return true
}

func mentions_of(value: SpiteCompiler.Expression?, mentioned: List<String>) {
    fallback value
    switch value {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: mentioned.append(value.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: mentions_of(value.target, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: mentions_of_a_call(value, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: mentions_of_both(value.left, value.right, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: mentions_of(value.operand, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: mentions_of_both(value.target, value.index, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: mentions_of_all(value.entries, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: mentions_of_all(value.pairs, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: mentions_of_both(value.key, value.value, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: mentions_of_a_text(value, mentioned)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
    }
}

func mentions_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, mentioned: List<String>) {
    mentions_of(call.callee, mentioned)
    mentions_of_all(call.arguments, mentioned)
}

func mentions_of_both(first: SpiteCompiler.Expression?, second: SpiteCompiler.Expression?, mentioned: List<String>) {
    mentions_of(first, mentioned)
    mentions_of(second, mentioned)
}

func mentions_of_all(values: List<SpiteCompiler.Expression>, mentioned: List<String>) {
    var index = 0
    while index < values.count() {
        var value = values[index]
        mentions_of(value, mentioned)
        index = index + 1
    }
}

func mentions_of_a_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral, mentioned: List<String>) {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        mentions_of(piece.hole, mentioned)
        index = index + 1
    }
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func finish_a_copy(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    crash function.body
    end_the_returns(function.body)
    var begun = parsed_expression("jsx_begin()", function.line)
    var beginning = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(begun)
    beginning.line = function.line
    function.body.statements.insert(0, beginning)
    fallback not is_flow
    var watched_now = parsed_expression("jsx_watch()", function.line)
    var watching = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(watched_now)
    watching.line = function.line
    function.body.statements.insert(0, watching)
}

func end_the_returns(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    var ended = List<SpiteCompiler.WrittenStatement>()
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        end_a_statement(statement, ended)
        index = index + 1
    }
    block.statements = ended
}

func end_a_statement(statement: SpiteCompiler.WrittenStatement, ended: List<SpiteCompiler.WrittenStatement>) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        var ending = ending_of(statement.value, statement.line)
        ending.each(ended.append)
        return
    }
    end_inside(statement)
    ended.append(statement)
}

func end_inside(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.IfStatement: end_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: end_the_returns(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: statement.cases.each(end_a_case)
        AbstractSyntaxTree.Shapes.Statements.Block: end_the_returns(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func end_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    end_the_returns(statement.then_branch)
    end_the_returns(statement.else_branch)
}

func end_a_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    end_the_returns(switch_case.body)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func ending_of(value: SpiteCompiler.Expression?, line: Integer): List<SpiteCompiler.WrittenStatement> {
    crash value
    var ending = List<SpiteCompiler.WrittenStatement>()
    var kept_root = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("_jsx_root_value")
    kept_root.line = line
    var assigned = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(kept_root, value)
    assigned.line = line
    ending.append(assigned)
    var finished = parsed_expression("jsx_finish()", line)
    var returned = AbstractSyntaxTree.Shapes.Statements.ReturnStatement(finished)
    returned.line = line
    ending.append(returned)
    return ending
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func add_the_members() {
    file.declarations.each(learn_a_watched_attribute)
    var lines = List<String>()
    lines.append("var _jsx_bits = 0")
    lines.append("var _jsx_queue: List<{class_name}>? = null")
    lines.append("var _jsx_made = false")
    lines.append("var _jsx_learned = false")
    lines.append("var _jsx_others = false")
    lines.append("var _jsx_flow_mask = 0")
    lines.append("var _jsx_root_value: {root_type} = null")
    add_the_site_attributes(lines)
    add_the_watched_attributes(lines)
    add_the_mask_attributes(lines)
    add_the_takes(lines)
    add_the_begin(lines)
    add_the_finish(lines)
    add_the_update(lines)
    add_the_learning(lines)
    add_the_bits(lines)
    add_the_marking(lines)
    add_the_watching(lines)
    add_the_release(lines)
    add_the_setters(lines)
    var text = lines.join("\n")
    var made = parsed_declarations(text, next_line)
    made.each(add_a_declaration)
    add_the_bindings()
    add_the_written_marks()
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func add_a_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class != AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        file.declarations.append(declaration)
        return
    }
    var place = place_for_an_attribute()
    file.declarations.insert(place, declaration)
}

func place_for_an_attribute(): Integer {
    var after_defaults = -1
    var first_member = -1
    var index = 0
    while index < file.declarations.count() {
        var held = file.declarations[index]
        if holds_a_default(held) {
            after_defaults = index + 1
        }
        var is_an_attribute = held.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
        var is_a_function = held.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
        var is_a_member = is_an_attribute or is_a_function
        if is_a_member and first_member < 0 {
            first_member = index
        }
        index = index + 1
    }
    if after_defaults >= 0 {
        return after_defaults
    }
    if first_member >= 0 {
        return first_member
    }
    return file.declarations.count()
}

func holds_a_default(declaration: SpiteCompiler.Declaration): Boolean {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    fallback declaration.value
    return true
}

func learn_a_watched_attribute(declaration: SpiteCompiler.Declaration) {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    fallback not declaration.name.starts_with("_jsx_") and declaration.value
    var written = type_of_an_attribute(declaration)
    fallback not written.is_empty()
    watched.append(declaration.name)
    watched_types.append(written)
    var item = item_of_a_list(written)
    if not item.is_empty() {
        watched_lists.append(declaration.name)
        watched_items.append(item)
    }
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func type_of_an_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): String {
    if declaration.declared_type {
        var printer = Printers.Spite.TypePrinter(declaration.declared_type)
        return printer.text()
    }
    fallback declaration.value
    if declaration.value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return type_of_a_literal(declaration.value)
    }
    if declaration.value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return "String"
    }
    if declaration.value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression and declaration.value.arguments.is_empty() {
        return made_type_of(declaration.value)
    }
    return ""
}

func type_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'integer_literal' {
        return "Integer"
    }
    if literal.kind == 'keyword_true' or literal.kind == 'keyword_false' {
        return "Boolean"
    }
    return ""
}

func made_type_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    fallback call.callee and is_a_class_path(call.callee)
    var printer = Printers.Spite.ExpressionPrinter(call.callee)
    var printed = printer.text()
    var first = printed.slice(0, 1)
    fallback first and first != first.lower_case()
    if printed.contains("<") or call.generic_arguments.is_empty() {
        return printed
    }
    var written = List<String>()
    var index = 0
    while index < call.generic_arguments.count() {
        var argument = call.generic_arguments[index]
        var shown = written_argument(argument)
        written.append(shown)
        index = index + 1
    }
    var joined = written.join(", ")
    return "{printed}<{joined}>"
}

func is_a_class_path(callee: SpiteCompiler.Expression?): Boolean {
    fallback callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return true
    }
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    return is_a_class_path(callee.target)
}

func written_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument): String {
    if argument.type_reference {
        var printer = Printers.Spite.TypePrinter(argument.type_reference)
        return printer.text()
    }
    return argument.text
}

func item_of_a_list(written: String): String {
    fallback written.starts_with("List<") and written.ends_with(">")
    var written_length = written.length()
    var item = written.slice(5, written_length - 1)
    crash item
    return item
}

func add_the_site_attributes(lines: List<String>) {
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var made_class = site_classes[index]
        var is_a_list = list_sites.contains(site)
        crash made_class
        if is_a_list {
            lines.append("var _jsx_site_{site} = List<{made_class}>()")
            lines.append("var _jsx_count_{site} = 0")
        } else {
            lines.append("var _jsx_site_{site}: {made_class}? = null")
            lines.append("var _jsx_used_{site} = false")
        }
        index = index + 1
    }
}

func add_the_watched_attributes(lines: List<String>) {
    var index = 0
    while index < watched_lists.count() {
        var name = watched_lists[index]
        var item = watched_items[index]
        crash item
        var bare = bare_of(name)
        lines.append("var _jsx_watched_{bare}: List<{item}>? = null")
        index = index + 1
    }
}

func add_the_mask_attributes(lines: List<String>) {
    var index = 0
    while index < bound_sites.count() {
        lines.append("var _jsx_mask_{index} = 0")
        index = index + 1
    }
}

func add_the_takes(lines: List<String>) {
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var made_class = site_classes[index]
        var is_a_list = list_sites.contains(site)
        crash made_class
        lines.append("")
        lines.append("func jsx_take_{site}(): {made_class} \{")
        if is_a_list {
            lines.append("    var index = _jsx_count_{site}")
            lines.append("    _jsx_count_{site} = index + 1")
            lines.append("    if index < _jsx_site_{site}.count() \{")
            lines.append("        return _jsx_site_{site}[index]")
            lines.append("    }")
            lines.append("    var made = {made_class}()")
            lines.append("    _jsx_site_{site}.append(made)")
        } else {
            lines.append("    _jsx_used_{site} = true")
            lines.append("    var kept = _jsx_site_{site}")
            lines.append("    if kept \{")
            lines.append("        return kept")
            lines.append("    }")
            lines.append("    var made = {made_class}()")
            lines.append("    _jsx_site_{site} = made")
        }
        lines.append("    _jsx_made = true")
        lines.append("    return made")
        lines.append("}")
        index = index + 1
    }
}

func add_the_begin(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_begin() \{")
    lines.append("    _jsx_made = false")
    lines.append("    _jsx_bits = 0")
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var is_a_list = list_sites.contains(site)
        if is_a_list {
            lines.append("    _jsx_count_{site} = 0")
        } else {
            lines.append("    _jsx_used_{site} = false")
        }
        index = index + 1
    }
    lines.append("}")
}

func add_the_finish(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_finish(): Boolean \{")
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var is_a_list = list_sites.contains(site)
        if is_a_list {
            lines.append("    if _jsx_count_{site} < _jsx_site_{site}.count() \{")
            lines.append("        _jsx_site_{site}.truncate(_jsx_count_{site})")
            lines.append("        _jsx_made = true")
            lines.append("    }")
        } else {
            lines.append("    if not _jsx_used_{site} and _jsx_site_{site} \{")
            lines.append("        _jsx_site_{site} = null")
            lines.append("        _jsx_made = true")
            lines.append("    }")
        }
        index = index + 1
    }
    lines.append("    return _jsx_made")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_root(): {root_type} \{")
    lines.append("    return _jsx_root_value")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_attach(queue: List<{class_name}>?) \{")
    lines.append("    _jsx_queue = queue")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_pending(): Integer \{")
    lines.append("    return _jsx_bits")
    lines.append("}")
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func add_the_update(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_update(bits: Integer): Boolean \{")
    lines.append("    _jsx_bits = 0")
    lines.append("    jsx_learn()")
    lines.append("    var reshapes = bits.bits_and(_jsx_flow_mask) != 0")
    lines.append("    if reshapes or not _jsx_root_value \{")
    lines.append("        return jsx_replay()")
    lines.append("    }")
    var index = 0
    while index < bound_sites.count() {
        lines.append("    if bits.bits_and(_jsx_mask_{index}) != 0 \{")
        lines.append("        jsx_bind_{index}()")
        lines.append("    }")
        index = index + 1
    }
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_replays_each_frame(): Boolean \{")
    lines.append("    jsx_learn()")
    lines.append("    return _jsx_others")
    lines.append("}")
}

func add_the_learning(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_learn() \{")
    lines.append("    fallback not _jsx_learned")
    lines.append("    _jsx_learned = true")
    lines.append("    var flow = {class_name}.functions[\"jsx_flow\"]")
    lines.append("    crash flow")
    lines.append("    var flow_reads = flow.reads")
    lines.append("    _jsx_flow_mask = jsx_mask_of(flow_reads)")
    var index = 0
    while index < bound_sites.count() {
        lines.append("    var bind_{index} = {class_name}.functions[\"jsx_bind_{index}\"]")
        lines.append("    crash bind_{index}")
        lines.append("    var reads_{index} = bind_{index}.reads")
        lines.append("    _jsx_mask_{index} = jsx_mask_of(reads_{index})")
        index = index + 1
    }
    lines.append("}")
    lines.append("")
    lines.append("func jsx_mask_of(reads: List<Spite.AttributeDeclaration>): Integer \{")
    lines.append("    if reads.any(jsx_is_unwatched) \{")
    lines.append("        _jsx_others = true")
    lines.append("    }")
    lines.append("    return reads.sum_by(jsx_bit_of)")
    lines.append("}")
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func add_the_bits(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_bit_of(attribute: Spite.AttributeDeclaration): Integer \{")
    lines.append("    fallback attribute.owner_class == {class_name}")
    if not watched.is_empty() {
        lines.append("    var name = attribute.name")
    }
    var index = 0
    while index < watched.count() and index < 30 {
        var name = watched[index]
        var bit = bit_of(index)
        lines.append("    if name == \"{name}\" \{")
        lines.append("        return {bit}")
        lines.append("    }")
        index = index + 1
    }
    lines.append("    return 0")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_is_unwatched(attribute: Spite.AttributeDeclaration): Boolean \{")
    lines.append("    fallback not attribute.name.starts_with(\"_jsx_\")")
    lines.append("    var owner = attribute.owner_class")
    lines.append("    if owner == {class_name} \{")
    lines.append("        var bit = jsx_bit_of(attribute)")
    lines.append("        return bit == 0")
    lines.append("    }")
    var named = List<String>()
    var site_index = 0
    while site_index < site_classes.count() {
        var made_class = site_classes[site_index]
        if not named.contains(made_class) {
            named.append(made_class)
            lines.append("    fallback owner != {made_class}")
        }
        site_index = site_index + 1
    }
    lines.append("    return true")
    lines.append("}")
}

func bit_of(index: Integer): Integer {
    var bit = 1
    var shifted = 0
    while shifted < index {
        bit = bit * 2
        shifted = shifted + 1
    }
    return bit
}

func add_the_marking(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_mark(bit: Integer) \{")
    lines.append("    var earlier = _jsx_bits")
    lines.append("    _jsx_bits = earlier.bits_or(bit)")
    lines.append("    fallback earlier == 0 and _jsx_queue")
    lines.append("    _jsx_queue.append(this)")
    lines.append("}")
}

# ../../../spite_documentation/markup.md#a-list-a-render-reads
func add_the_watching(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_watch() \{")
    var index = 0
    while index < watched_lists.count() {
        var name = watched_lists[index]
        var bare = bare_of(name)
        lines.append("    jsx_watch_{bare}()")
        index = index + 1
    }
    lines.append("}")
    lines.append("")
    lines.append("func jsx_unwatch() \{")
    index = 0
    while index < watched_lists.count() {
        var name = watched_lists[index]
        var bare = bare_of(name)
        lines.append("    jsx_unwatch_{bare}()")
        index = index + 1
    }
    lines.append("}")
    index = 0
    while index < watched_lists.count() {
        add_a_list_watch(lines, index)
        index = index + 1
    }
}

# ../../../spite_documentation/markup.md#a-list-a-render-reads
func add_a_list_watch(lines: List<String>, index: Integer) {
    var name = watched_lists[index]
    var item = watched_items[index]
    crash name
    crash item
    var place = watched.index_of(name)
    crash place
    var bit = bit_of(place)
    var bare = bare_of(name)
    var watcher = watcher_of(name)
    lines.append("")
    lines.append("func jsx_watch_{bare}() \{")
    lines.append("    var watched = _jsx_watched_{bare}")
    lines.append("    if watched \{")
    lines.append("        fallback watched !== {name}")
    lines.append("        watched.unsubscribe({watcher})")
    lines.append("    }")
    lines.append("    {name}.subscribe({watcher})")
    lines.append("    _jsx_watched_{bare} = {name}")
    lines.append("}")
    lines.append("")
    lines.append("func jsx_unwatch_{bare}() \{")
    lines.append("    var watched = _jsx_watched_{bare}")
    lines.append("    fallback watched")
    lines.append("    watched.unsubscribe({watcher})")
    lines.append("    _jsx_watched_{bare} = null")
    lines.append("}")
    lines.append("")
    lines.append("func {watcher}(_change: ListChange<{item}>) \{")
    lines.append("    jsx_mark({bit})")
    lines.append("}")
}

func bare_of(name: String): String {
    if not name.starts_with("_") {
        return name
    }
    var name_length = name.length()
    var bare = name.slice(1, name_length)
    crash bare
    return bare
}

func add_the_release(lines: List<String>) {
    lines.append("")
    lines.append("func jsx_release() \{")
    lines.append("    jsx_unwatch()")
    lines.append("    _jsx_bits = 0")
    lines.append("    _jsx_root_value = null")
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var is_a_list = list_sites.contains(site)
        if is_a_list {
            lines.append("    _jsx_site_{site}.clear()")
        } else {
            lines.append("    _jsx_site_{site} = null")
        }
        index = index + 1
    }
    lines.append("}")
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func add_the_setters(lines: List<String>) {
    var index = 0
    while index < watched.count() {
        var name = watched[index]
        var written = watched_types[index]
        crash written
        var setter = setter_of(name)
        if not written_setters.contains(setter) {
            add_a_setter(lines, name, written, index)
        }
        index = index + 1
    }
}

func add_a_setter(lines: List<String>, name: String, written: String, place: Integer) {
    var bit = bit_of(place)
    if place >= 30 {
        bit = 0
    }
    lines.append("")
    var setter = setter_of(name)
    lines.append("func {setter}(value: {written}) \{")
    var compares = compares_by_value(written)
    if compares {
        lines.append("    var earlier = attributes[\"{name}\"].value")
    }
    lines.append("    attributes[\"{name}\"].value = value")
    if compares {
        lines.append("    fallback earlier != value")
    }
    if bit != 0 {
        lines.append("    jsx_mark({bit})")
    }
    lines.append("}")
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func watcher_of(name: String): String {
    var bare = name
    if name.starts_with("_") {
        var name_length = name.length()
        var sliced = name.slice(1, name_length)
        crash sliced
        bare = sliced
    }
    return "jsx_{bare}_changed"
}

func setter_of(name: String): String {
    if not name.starts_with("_") {
        return "set_{name}"
    }
    var name_length = name.length()
    var bare = name.slice(1, name_length)
    crash bare
    return "_set_{bare}"
}

func attribute_of_a_setter(setter: String): String {
    if setter.starts_with("_set_") {
        var setter_length = setter.length()
        var bare = setter.slice(5, setter_length)
        crash bare
        return "_{bare}"
    }
    return setter.replace("set_", "")
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func compares_by_value(written: String): Boolean {
    var values = ["Integer", "Long", "Boolean", "String", "Float", "Double", "Decimal"]
    return values.contains(written)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func add_the_bindings() {
    var index = 0
    while index < bound_sites.count() {
        var site = bound_sites[index]
        var attribute = bound_attributes[index]
        var value = bound_values[index]
        crash attribute
        crash value
        var lines = List<String>()
        lines.append("func jsx_bind_{index}() \{")
        add_the_narrowings(lines)
        lines.append("    fallback _jsx_site_{site}")
        lines.append("    _jsx_site_{site}.{attribute} = {value}")
        lines.append("}")
        var text = lines.join("\n")
        var made = parsed_declarations(text, next_line)
        made.each(file.declarations.append)
        index = index + 1
    }
}

func add_the_narrowings(lines: List<String>) {
    var index = 0
    while index < narrowings.count() {
        var narrowing = narrowings[index]
        lines.append("    {narrowing}")
        index = index + 1
    }
}

# ../../../spite_documentation/markup.md#what-a-write-marks
func add_the_written_marks() {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        mark_a_written_setter(declaration)
        index = index + 1
    }
}

func mark_a_written_setter(declaration: SpiteCompiler.Declaration) {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    fallback declaration.source != source and written_setters.contains(declaration.name)
    fallback declaration.body
    var name = attribute_of_a_setter(declaration.name)
    var place = watched.index_of(name)
    fallback place and place < 30
    var bit = bit_of(place)
    var marked = parsed_expression("jsx_mark({bit})", declaration.line)
    var called = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(marked)
    called.line = declaration.line
    declaration.body.statements.append(called)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func parsed_declarations(text: String, line: Integer): List<SpiteCompiler.Declaration> {
    var printed_lines = text.split("\n")
    next_line = line + printed_lines.count() + 1
    var lexer = AbstractSyntaxTree.Lexer(text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser(file.path, file.namespace, made_tokens)
    var parsed = parser.parse_file()
    parsed.declarations.each(mark_as_generated)
    return parsed.declarations
}

func mark_as_generated(declaration: SpiteCompiler.Declaration) {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    declaration.source = source
}

func parsed_expression(text: String, line: Integer): SpiteCompiler.Expression {
    var lexer = AbstractSyntaxTree.Lexer(text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser(file.path, file.namespace, made_tokens)
    return parser.expression()
}

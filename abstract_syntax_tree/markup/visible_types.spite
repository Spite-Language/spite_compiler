var declared = Dictionary<String, String>()
var values = Dictionary<String, SpiteCompiler.Expression>()
var results = Dictionary<String, String>()
var declared_functions = Dictionary<String, AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>()
var taken = List<String>()

# ../../../spite_documentation/markup.md#an-expression-as-a-child
func learn_the_file(file: AbstractSyntaxTree.Shapes.SourceFile) {
    file.declarations.each(learn_a_declaration)
}

func learn_a_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: learn_an_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: learn_a_result(declaration)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return
    }
}

func learn_an_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    learn_a_name(attribute.name, attribute.declared_type, attribute.value)
}

func learn_a_result(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    declared_functions[function.name] = function
    var head = head_of(function.result)
    results[function.name] = head
}

func learn_a_name(name: String, written_type: SpiteCompiler.Type?, value: SpiteCompiler.Expression?) {
    var head = head_of(written_type)
    if not head.is_empty() {
        declared[name] = head
        return
    }
    fallback value
    values[name] = value
}

func head_of(written_type: SpiteCompiler.Type?): String {
    fallback written_type
    switch written_type {
        AbstractSyntaxTree.Shapes.Types.NamedType: return written_type.path.join(".")
    }
}

# ../../../spite_documentation/markup.md#generated-names
func learn_the_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    taken = List<String>()
    function.parameters.each(learn_a_parameter)
    learn_a_block(function.body)
}

func learn_a_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    taken.append(parameter.name)
    var no_value: SpiteCompiler.Expression? = null
    learn_a_name(parameter.name, parameter.declared_type, no_value)
}

func learn_a_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(learn_a_statement)
}

func learn_a_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: learn_a_local(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: learn_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: learn_a_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: statement.cases.each(learn_a_case)
        AbstractSyntaxTree.Shapes.Statements.Block: learn_a_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func learn_a_local(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    taken.append(local.name)
    if local.markup {
        declared[local.name] = "markup"
        return
    }
    learn_a_name(local.name, local.declared_type, local.value)
}

func learn_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    learn_a_block(statement.then_branch)
    learn_a_block(statement.else_branch)
}

func learn_a_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    learn_a_block(switch_case.body)
}

# ../../../spite_documentation/markup.md#an-expression-as-a-child
func is_a_list(expression: SpiteCompiler.Expression?): Boolean {
    var head = head_of_value(expression)
    return head == "List"
}

func is_a_boolean(expression: SpiteCompiler.Expression?): Boolean {
    var head = head_of_value(expression)
    return head == "Boolean"
}

func head_of_value(expression: SpiteCompiler.Expression?): String {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return head_of_name(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return head_of_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return "String"
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return head_of_call(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return head_of_operation(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return head_of_unary(expression)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return "List"
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return "Dictionary"
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return ""
    }
}

func head_of_name(name: String): String {
    var written = declared[name]
    if written {
        return written
    }
    var value = values[name]
    fallback value
    values.remove_at(name)
    var head = head_of_value(value)
    values[name] = value
    return head
}

func head_of_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    var kind = literal.kind
    if kind == 'keyword_true' or kind == 'keyword_false' {
        return "Boolean"
    }
    return ""
}

func head_of_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return head_of_callee(callee)
    }
    return ""
}

func head_of_callee(callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if callee.is_a_class_name {
        return callee.name
    }
    var result = results[callee.name]
    fallback result
    return result
}

func head_of_operation(operation: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var operator = operation.operator
    var compares = operator == 'equal_equal' or operator == 'not_equal' or operator == 'less' or operator == 'greater'
    var orders = operator == 'less_or_equal' or operator == 'greater_or_equal'
    var joins = operator == 'and' or operator == 'or'
    if compares or orders or joins {
        return "Boolean"
    }
    return ""
}

func head_of_unary(operation: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression): String {
    if operation.operator == 'not' {
        return "Boolean"
    }
    return ""
}

# ../../../spite_documentation/markup.md#a-lowercase-tag-calls-a-function
func function_of(
    element: AbstractSyntaxTree.Shapes.Markup.Element,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var name = element.function_name()
    return declared_functions[name]
}

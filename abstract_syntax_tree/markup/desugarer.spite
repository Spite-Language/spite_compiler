var held = List<SpiteCompiler.WrittenStatement>()
var types = VisibleTypes()
var keeping = false
var assembling = false
var owner_name = "this"
var is_live = false
var in_an_assembly = false
var live_region = -1
var live_owner = ""
var file: AbstractSyntaxTree.Shapes.SourceFile
var kept: KeptRender
var live: LivePieces

# ../../../spite_documentation/markup.md#what-a-tag-becomes
func Desugarer(starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    file = starting_file
    kept = KeptRender(starting_file)
    live = LivePieces(starting_file, kept, types)
    types.learn_the_file(file)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func run() {
    var finds = kept.finds_a_render()
    if finds {
        kept.add_the_copies()
    }
    is_live = not finds
    file.declarations.each(lower_a_declaration)
    if finds {
        kept.add_the_members()
    }
    if is_live {
        live.add_the_members()
    }
}

func lower_a_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        lower_a_function(declaration)
    }
}

func lower_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    types.learn_the_function(function)
    var class_name = file.class_name()
    in_an_assembly = function.is_a_constructor_of(class_name) and function.parameters.is_empty()
    keeping = kept.is_kept(function)
    if keeping {
        kept.start(function)
    }
    lower_a_block(function.body)
    if keeping {
        kept.finish_a_copy(function)
    }
    keeping = false
    in_an_assembly = false
}

func lower_a_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    var outer = held
    held = List<SpiteCompiler.WrittenStatement>()
    block.statements.each(lower_a_statement)
    block.statements = held
    held = outer
}

func lower_a_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: lower_a_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: lower_a_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: lower_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: lower_a_loop(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: lower_the_cases(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: lower_a_body(statement, statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: lower_a_standing_tag(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: lower_an_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: held.append(statement)
    }
}

func lower_a_loop(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    fallback not lowers_a_live_block(statement)
    kept.enter(true)
    live.enter(statement)
    lower_a_body(statement, statement.body)
    live.leave()
    kept.leave(true)
}

# ../../../spite_documentation/markup.md#a-brace-runs-again-when-what-it-reads-is-written
func lower_an_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    if in_an_assembly {
        live.learn_an_assignment(statement)
    }
    held.append(statement)
}

func lower_a_body(statement: SpiteCompiler.WrittenStatement, body: AbstractSyntaxTree.Shapes.Statements.Block?) {
    lower_a_block(body)
    held.append(statement)
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func lower_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    fallback not lowers_a_live_block(statement)
    kept.enter(false)
    live.enter(statement)
    var opened = List<AbstractSyntaxTree.Shapes.Statements.IfStatement>()
    var outers = List<List<SpiteCompiler.WrittenStatement>>()
    var last = statement
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = statement
    while link {
        var current = link
        last = current
        lower_a_block(current.then_branch)
        link = current.else_if()
        if link {
            opened.append(current)
            outers.append(held)
            held = List<SpiteCompiler.WrittenStatement>()
        } else {
            lower_a_block(current.else_branch)
        }
    }
    held.append(last)
    var index = opened.count() - 1
    while index >= 0 {
        var closed = opened[index]
        var outer = outers[index]
        crash closed
        crash outer
        crash closed.else_branch
        closed.else_branch.statements = held
        held = outer
        held.append(closed)
        index = index - 1
    }
    live.leave()
    kept.leave(false)
}

func lower_the_cases(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    fallback not lowers_a_live_block(statement)
    kept.enter(false)
    live.enter(statement)
    statement.cases.each(lower_a_case)
    live.leave()
    kept.leave(false)
    held.append(statement)
}

# ../../../spite_documentation/markup.md#a-constructor-assembles-its-tags
func lower_a_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    crash switch_case.body
    switch_case.written_count = switch_case.body.statements.count()
    lower_a_block(switch_case.body)
}

# ../../../spite_documentation/markup.md#a-live-block-among-the-children
func lowers_a_live_block(statement: SpiteCompiler.WrittenStatement): Boolean {
    fallback assembling_live() and live.depth == 0
    fallback live.holds_tags(statement)
    fallback live.starts_a_block(statement)
    var index = live.current_region
    var outer = start_a_region(index)
    lower_a_statement(statement)
    finish_a_region(index, outer, statement.line)
    return true
}

func assembling_live(): Boolean {
    return in_an_assembly and is_live and live_region < 0
}

# ../../../spite_documentation/markup.md#a-live-block-among-the-children
func start_a_region(index: Integer): List<SpiteCompiler.WrittenStatement> {
    var outer = held
    held = List<SpiteCompiler.WrittenStatement>()
    live_region = index
    live_owner = owner_name
    owner_name = "live_owner_{index}"
    return outer
}

# ../../../spite_documentation/markup.md#a-live-block-among-the-children
func finish_a_region(index: Integer, outer: List<SpiteCompiler.WrittenStatement>, line: Integer) {
    var lowered = held
    held = outer
    owner_name = live_owner
    live_region = -1
    live.add_a_region(index, live_owner, lowered)
    if live_owner != "this" and live.needs_a_handle(live_owner) {
        var handle = named("_live_site_{live_owner}", line)
        var kept_handle = named(live_owner, line)
        var keeps = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(handle, kept_handle)
        keeps.line = line
        place(keeps)
    }
    var earlier = live.earlier_counts(index, live_owner)
    var fixed = named("_live_fixed_{index}", line)
    var counted = parsed_value("{live_owner}.children.count(){earlier}", line)
    var fixing = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(fixed, counted)
    fixing.line = line
    place(fixing)
    var call = parsed_value("_live_{index}()", line)
    var calling = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(call)
    calling.line = line
    place(calling)
}

# ../../../spite_documentation/markup.md#a-brace-among-the-children
func lowers_a_live_child(name: String, child: AbstractSyntaxTree.Shapes.Markup.Child): Boolean {
    fallback assembling_live() and live.depth == 0
    fallback child.expression
    fallback live.starts_a_child(child.expression)
    var index = live.current_region
    var outer_owner = owner_name
    owner_name = name
    var outer = start_a_region(index)
    var entry = entry_of(child)
    attach_a_child(owner_name, child, entry)
    finish_a_region(index, outer, child.line)
    owner_name = outer_owner
    return true
}

# ../../../spite_documentation/markup.md#a-constructor-assembles-its-tags
func lower_a_standing_tag(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    var element = statement.markup
    if not element {
        held.append(statement)
        return
    }
    statement.markup = null
    file.held_markup = true
    var outer = assembling
    assembling = true
    var owner = owner_name
    var name = built(element)
    attach(name, owner, element.line)
    assembling = outer
}

# ../../../spite_documentation/markup.md#statements-among-the-children
func lower_a_child_statement(name: String, child: AbstractSyntaxTree.Shapes.Markup.Child) {
    fallback assembling
    crash child.statement
    var outer = owner_name
    owner_name = name
    lower_a_statement(child.statement)
    owner_name = outer
}

# ../../../spite_documentation/markup.md#a-constructor-assembles-its-tags
func attach(name: String, owner_name: String, line: Integer) {
    if live_region >= 0 and owner_name == "live_owner_{live_region}" {
        insert(name, owner_name, line)
        return
    }
    if live_region >= 0 {
        live.note_a_parent_site(owner_name)
    }
    var linked = parsed_value(owner_name, line)
    assign(name, "parent", linked, line)
    var owner = parsed_value(owner_name, line)
    var children = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(owner, "children")
    children.line = line
    var append = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(children, "append")
    append.line = line
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var arguments = List<SpiteCompiler.Expression>()
    var child = named(name, line)
    arguments.append(child)
    var call = AbstractSyntaxTree.Shapes.Expressions.CallExpression(append, no_generics, arguments)
    call.line = line
    var appended = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(call)
    appended.line = line
    place(appended)
}

# ../../../spite_documentation/markup.md#a-live-block-among-the-children
func insert(name: String, owner_name: String, line: Integer) {
    var at = "live_at_{live_region}"
    var lines = List<String>()
    lines.append("{name}.parent = {owner_name}")
    lines.append("{owner_name}.children.insert({at}, {name})")
    lines.append("{at} = {at} + 1")
    var statements = parsed_statements(lines, line)
    statements.each(place)
}

# ../../../spite_documentation/markup.md#a-live-block-among-the-children
func parsed_statements(lines: List<String>, line: Integer): List<SpiteCompiler.WrittenStatement> {
    var text = lines.join("\n")
    var wrapped = "func _live_parsed() \{\n{text}\n}"
    var lexer = AbstractSyntaxTree.Lexer(wrapped, line - 1)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser(file.path, file.namespace, made_tokens)
    var parsed = parser.parse_file()
    var first = parsed.declarations.first()
    crash first
    crash first.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    crash first.body
    return first.body.statements
}

# ../../../spite_documentation/markup.md#a-constructor-assembles-its-tags
func attach_each(list_name: String, owner_name: String, line: Integer) {
    var index_name = fresh_name("index", line)
    var entry_name = fresh_name("entry", line)
    var start = parsed_value("0", line)
    var no_type: SpiteCompiler.Type? = null
    var counted = AbstractSyntaxTree.Shapes.Statements.VariableStatement(index_name, no_type, start)
    counted.line = line
    place(counted)
    var outer = held
    held = List<SpiteCompiler.WrittenStatement>()
    var entry = parsed_value("{list_name}[{index_name}]", line)
    var taken = AbstractSyntaxTree.Shapes.Statements.VariableStatement(entry_name, no_type, entry)
    taken.line = line
    place(taken)
    attach(entry_name, owner_name, line)
    var next = parsed_value("{index_name} + 1", line)
    var counter = named(index_name, line)
    var stepped = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(counter, next)
    stepped.line = line
    place(stepped)
    var body = AbstractSyntaxTree.Shapes.Statements.Block(held)
    body.line = line
    held = outer
    var condition = parsed_value("{index_name} < {list_name}.count()", line)
    var loop = AbstractSyntaxTree.Shapes.Statements.WhileStatement(condition, body)
    loop.line = line
    place(loop)
}

# ../../../spite_documentation/markup.md#where-a-tag-stands
func lower_a_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var element = statement.markup
    if not element {
        if in_an_assembly {
            live.learn_a_local(statement)
        }
        held.append(statement)
        return
    }
    statement.markup = null
    file.held_markup = true
    var made = made_value(element)
    statement.value = made
    place(statement)
    name_the_site(element, statement.name)
    fill(element, statement.name)
}

func lower_a_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var element = statement.markup
    if not element {
        held.append(statement)
        return
    }
    statement.markup = null
    file.held_markup = true
    if stands_alone(element) {
        var alone = made_value(element)
        statement.value = alone
        place(statement)
        return
    }
    var name = built(element)
    var answered = named(name, element.line)
    statement.value = answered
    held.append(statement)
}

# ../../../spite_documentation/markup.md#where-a-tag-stands
func stands_alone(element: AbstractSyntaxTree.Shapes.Markup.Element): Boolean {
    fallback element.children.is_empty()
    return element.calls_a_function() or element.written_attributes.is_empty()
}

# ../../../spite_documentation/markup.md#generated-names
func fresh_name(base: String, line: Integer): String {
    var name = "{base}_{line}"
    var count = 2
    while types.taken.contains(name) {
        name = "{base}_{line}_{count}"
        count = count + 1
    }
    types.taken.append(name)
    return name
}

func built(element: AbstractSyntaxTree.Shapes.Markup.Element): String {
    var base = element.tag
    if not element.calls_a_function() {
        var last = element.last_segment()
        base = last.snake_case()
    }
    var name = fresh_name(base, element.line)
    if live_region >= 0 and not element.calls_a_function() {
        take(element, name)
        fill(element, name)
        return name
    }
    var made = made_value(element)
    var no_type: SpiteCompiler.Type? = null
    var declared = AbstractSyntaxTree.Shapes.Statements.VariableStatement(name, no_type, made)
    declared.line = element.line
    place(declared)
    name_the_site(element, name)
    if assembling and is_live and not element.calls_a_function() {
        live.learn_a_site(name, element.tag)
    }
    fill(element, name)
    return name
}

# ../../../spite_documentation/markup.md#a-tag-in-a-live-block-is-matched
func take(element: AbstractSyntaxTree.Shapes.Markup.Element, name: String) {
    live.learn_a_region_site(name, element.tag)
    var lines = List<String>()
    var key = element.written_attributes.find_by_name("key")
    if key {
        var value = value_of(key)
        var printer = Printers.Spite.ExpressionPrinter(value)
        var printed = printer.text()
        lines.append("var {name}_key = {printed}")
        lines.append("var {name}_place = -1")
        lines.append("var {name}_look = 0")
        lines.append("while {name}_look < _live_last_{name}.count() \{")
        lines.append("    var {name}_held = _live_last_{name}[{name}_look]")
        lines.append("    var {name}_same = {name}_held.key == {name}_key")
        lines.append("    if {name}_place < 0 and {name}_same \{")
        lines.append("        {name}_place = {name}_look")
        lines.append("    }")
        lines.append("    {name}_look = {name}_look + 1")
        lines.append("}")
    } else {
        lines.append("var {name}_place = -1")
        lines.append("if not _live_last_{name}.is_empty() \{")
        lines.append("    {name}_place = 0")
        lines.append("}")
    }
    lines.append("var {name} = _live_take_{name}({name}_place)")
    var statements = parsed_statements(lines, element.line)
    statements.each(place)
    fallback key
    statements.each(note_a_key_comparison)
    file.live_key_tags.append(element.tag)
}

func note_a_key_comparison(statement: SpiteCompiler.WrittenStatement) {
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement and statement.body
    var compared = statement.body.statements[1]
    crash compared
    fallback compared.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and compared.value
    fallback compared.value.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    file.live_keys.append(compared.value)
}

# ../../../spite_documentation/markup.md#a-render-keeps-what-it-made
func name_the_site(element: AbstractSyntaxTree.Shapes.Markup.Element, name: String) {
    fallback keeping and not element.calls_a_function()
    kept.name_the_site(name)
}

# ../../../spite_documentation/markup.md#what-a-tag-becomes
func made_value(element: AbstractSyntaxTree.Shapes.Markup.Element): SpiteCompiler.Expression {
    if element.calls_a_function() and keeping {
        var remade = kept.remade(element.line)
        place(remade)
    }
    if element.calls_a_function() {
        return called(element)
    }
    if keeping {
        var taken = kept.take_of(element)
        return parsed_value(taken, element.line)
    }
    return parsed_value("{element.tag}()", element.line)
}

func fill(element: AbstractSyntaxTree.Shapes.Markup.Element, name: String) {
    fallback not element.calls_a_function()
    var index = 0
    while index < element.written_attributes.count() {
        var attribute = element.written_attributes[index]
        var value = value_of(attribute)
        assign(name, attribute.name, value, attribute.line)
        index = index + 1
    }
    var entries = List<SpiteCompiler.Expression>()
    var filling = Children(element.children)
    var runs = filling.runs()
    index = 0
    while index < runs.count() {
        var child_run = runs[index]
        add_a_run(name, child_run, entries)
        index = index + 1
    }
    fallback not entries.is_empty() and not assembling
    var children = AbstractSyntaxTree.Shapes.Expressions.ListLiteral(entries)
    children.line = element.line
    assign(name, "children", children, element.line)
}

func assign(name: String, attribute: String, value: SpiteCompiler.Expression, line: Integer) {
    if keeping {
        var binds = kept.is_a_binding(name, attribute, value)
        fallback not binds or not kept.is_flow
    }
    var owner = named(name, line)
    var target = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(owner, attribute)
    target.line = line
    var written = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(target, value)
    written.line = line
    place(written)
    fallback assembling and is_live
    fallback live.takes(name, attribute, value)
    fallback live.needs_a_handle(name)
    var handle = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("_live_site_{name}")
    handle.line = line
    var kept_handle = named(name, line)
    var keeps = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(handle, kept_handle)
    keeps.line = line
    place(keeps)
}

# ../../../spite_documentation/markup.md#children
func add_a_run(
    name: String,
    child_run: List<AbstractSyntaxTree.Shapes.Markup.Child>,
    entries: List<SpiteCompiler.Expression>,
) {
    var first = child_run[0]
    crash first
    if first.statement {
        lower_a_child_statement(name, first)
        return
    }
    var filling = Children(child_run)
    if filling.holds_text() {
        var text = filling.text()
        assign(name, "content", text, first.line)
        return
    }
    var index = 0
    while index < child_run.count() {
        var child = child_run[index]
        if not assembling or not lowers_a_live_child(name, child) {
            var entry = entry_of(child)
            entries.append(entry)
            attach_when_assembling(name, child, entry)
        }
        index = index + 1
    }
}

func attach_when_assembling(
    name: String,
    child: AbstractSyntaxTree.Shapes.Markup.Child,
    entry: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    fallback assembling
    attach_a_child(name, child, entry)
}

# ../../../spite_documentation/markup.md#a-constructor-assembles-its-tags
func attach_a_child(
    name: String,
    child: AbstractSyntaxTree.Shapes.Markup.Child,
    entry: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var is_a_list = false
    if child.expression {
        is_a_list = types.is_a_list(child.expression)
    }
    if is_a_list {
        attach_each(entry.name, name, child.line)
        return
    }
    attach(entry.name, name, child.line)
}

func entry_of(
    child: AbstractSyntaxTree.Shapes.Markup.Child,
): AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
    if child.element {
        var built_name = built(child.element)
        return named(built_name, child.line)
    }
    var kept = held_child(child)
    return named(kept, child.line)
}

# ../../../spite_documentation/markup.md#an-expression-as-a-child
func held_child(child: AbstractSyntaxTree.Shapes.Markup.Child): String {
    crash child.expression
    if child.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return child.expression.name
    }
    var base = name_of(child.expression)
    var kept = fresh_name(base, child.line)
    var no_type: SpiteCompiler.Type? = null
    var declared = AbstractSyntaxTree.Shapes.Statements.VariableStatement(kept, no_type, child.expression)
    declared.line = child.line
    place(declared)
    return kept
}

# ../../../spite_documentation/markup.md#a-lowercase-tag-calls-a-function
func called(element: AbstractSyntaxTree.Shapes.Markup.Element): SpiteCompiler.Expression {
    var function = types.function_of(element)
    crash function
    var arguments = List<SpiteCompiler.Expression>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = argument_for(element, parameter.name)
        arguments.append(argument)
        index = index + 1
    }
    var function_name = element.function_name()
    var callee = named(function_name, element.line)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var call = AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, no_generics, arguments)
    call.line = element.line
    return call
}

func argument_for(element: AbstractSyntaxTree.Shapes.Markup.Element, parameter: String): SpiteCompiler.Expression {
    var attribute = element.written_attributes.find_by_name(parameter)
    if attribute {
        return value_of(attribute)
    }
    return parsed_value("null", element.line)
}

func value_of(attribute: AbstractSyntaxTree.Shapes.Markup.Attribute): SpiteCompiler.Expression {
    if attribute.value {
        return attribute.value
    }
    return parsed_value("true", attribute.line)
}

# ../../../spite_documentation/markup.md#generated-names
func name_of(value: SpiteCompiler.Expression): String {
    var named_after = "child"
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        named_after = callee_name(value.callee)
    }
    var prefix = "render_"
    if named_after.starts_with(prefix) {
        var length = named_after.length()
        var start = prefix.length()
        var rest = named_after.slice(start, length)
        crash rest
        named_after = rest
    }
    return named_after.snake_case()
}

func callee_name(callee: SpiteCompiler.Expression?): String {
    fallback callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.name
    }
    return "child"
}

# ../../../spite_documentation/markup.md#positions
func place(statement: SpiteCompiler.WrittenStatement) {
    held.append(statement)
}

func named(name: String, line: Integer): AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
    var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
    identifier.line = line
    return identifier
}

func parsed_value(text: String, line: Integer): SpiteCompiler.Expression {
    var lexer = AbstractSyntaxTree.Lexer(text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser(file.path, file.namespace, made_tokens)
    return parser.expression()
}

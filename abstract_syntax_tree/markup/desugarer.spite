var placed_stops = List<Integer>()
var stops = Dictionary<Integer, String>()
var held = List<SpiteCompiler.WrittenStatement>()
var types = AbstractSyntaxTree.Markup.VisibleTypes()
var file: AbstractSyntaxTree.Shapes.SourceFile

# ../../../spite_documentation/markup.md#what-a-tag-becomes
func Desugarer(starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    file = starting_file
    types.learn_the_file(file)
}

func run() {
    file.declarations.each(lower_a_declaration)
}

func lower_a_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        lower_a_function(declaration)
    }
}

func lower_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    types.learn_the_function(function)
    lower_a_block(function.body)
}

func lower_a_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    var outer = held
    held = List<SpiteCompiler.WrittenStatement>()
    block.statements.each(lower_a_statement)
    block.statements = held
    held = outer
}

func lower_a_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: lower_a_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: lower_a_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: lower_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: lower_a_body(statement, statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: lower_the_cases(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: lower_a_body(statement, statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: held.append(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: held.append(statement)
    }
}

func lower_a_body(statement: SpiteCompiler.WrittenStatement, body: AbstractSyntaxTree.Shapes.Statements.Block?) {
    lower_a_block(body)
    held.append(statement)
}

func lower_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    lower_a_block(statement.then_branch)
    lower_a_block(statement.else_branch)
    held.append(statement)
}

func lower_the_cases(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    statement.cases.each(lower_a_case)
    held.append(statement)
}

func lower_a_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    lower_a_block(switch_case.body)
}

# ../../../spite_documentation/markup.md#where-a-tag-stands
func lower_a_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var element = statement.markup
    if not element {
        held.append(statement)
        return
    }
    statement.markup = null
    file.held_markup = true
    var made = made_value(element)
    statement.value = made
    place(statement, element.line)
    fill(element, statement.name)
}

func lower_a_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var element = statement.markup
    if not element {
        held.append(statement)
        return
    }
    statement.markup = null
    file.held_markup = true
    if stands_alone(element) {
        var alone = made_value(element)
        statement.value = alone
        place(statement, element.line)
        return
    }
    var name = built(element)
    var answered = named(name, element.line)
    statement.value = answered
    held.append(statement)
}

# ../../../spite_documentation/markup.md#where-a-tag-stands
func stands_alone(element: AbstractSyntaxTree.Shapes.Markup.Element): Boolean {
    fallback element.children.is_empty()
    return element.calls_a_function() or element.written_attributes.is_empty()
}

# ../../../spite_documentation/markup.md#generated-names
func fresh_name(base: String, line: Integer): String {
    var name = "{base}_{line}"
    var count = 2
    while types.taken.contains(name) {
        name = "{base}_{line}_{count}"
        count = count + 1
    }
    types.taken.append(name)
    return name
}

func built(element: AbstractSyntaxTree.Shapes.Markup.Element): String {
    var base = element.tag
    if not element.calls_a_function() {
        var last = element.last_segment()
        base = last.snake_case()
    }
    var name = fresh_name(base, element.line)
    var made = made_value(element)
    var no_type: SpiteCompiler.Type? = null
    var declared = AbstractSyntaxTree.Shapes.Statements.VariableStatement(name, no_type, made)
    declared.line = element.line
    place(declared, element.line)
    fill(element, name)
    return name
}

# ../../../spite_documentation/markup.md#what-a-tag-becomes
func made_value(element: AbstractSyntaxTree.Shapes.Markup.Element): SpiteCompiler.Expression {
    if element.calls_a_function() {
        return called(element)
    }
    return parsed_value("{element.tag}()", element.line)
}

func fill(element: AbstractSyntaxTree.Shapes.Markup.Element, name: String) {
    fallback not element.calls_a_function()
    var index = 0
    while index < element.written_attributes.count() {
        var attribute = element.written_attributes[index]
        var value = value_of(attribute)
        assign(name, attribute.name, value, attribute.line)
        index = index + 1
    }
    var filling = AbstractSyntaxTree.Markup.Children(element.children)
    var runs = filling.runs()
    index = 0
    while index < runs.count() {
        var child_run = runs[index]
        add_a_run(name, child_run)
        index = index + 1
    }
}

func assign(name: String, attribute: String, value: SpiteCompiler.Expression, line: Integer) {
    var owner = named(name, line)
    var target = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(owner, attribute)
    target.line = line
    var written = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(target, value)
    written.line = line
    place(written, line)
}

# ../../../spite_documentation/markup.md#children
func add_a_run(name: String, child_run: List<AbstractSyntaxTree.Shapes.Markup.Child>) {
    var first = child_run[0]
    crash first
    var filling = AbstractSyntaxTree.Markup.Children(child_run)
    if filling.holds_text() {
        var text = filling.text()
        assign(name, "content", text, first.line)
        return
    }
    var index = 0
    while index < child_run.count() {
        var child = child_run[index]
        add_a_child(name, child)
        index = index + 1
    }
}

func add_a_child(name: String, child: AbstractSyntaxTree.Shapes.Markup.Child) {
    if child.element {
        var built_name = built(child.element)
        append(name, "append_child", built_name, child.line)
        return
    }
    crash child.expression
    var kept = held_child(child)
    if types.is_a_list(child.expression) {
        append(name, "append_children", kept, child.line)
        return
    }
    var listed = fresh_name("children", child.line)
    var listing = parsed_statement("var {listed}: List<Anything?> = [{kept}]", child.line)
    place(listing, child.line)
    append(name, "append_children", listed, child.line)
}

# ../../../spite_documentation/markup.md#an-expression-as-a-child
func held_child(child: AbstractSyntaxTree.Shapes.Markup.Child): String {
    crash child.expression
    if child.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return child.expression.name
    }
    var base = name_of(child.expression)
    var kept = fresh_name(base, child.line)
    var no_type: SpiteCompiler.Type? = null
    var declared = AbstractSyntaxTree.Shapes.Statements.VariableStatement(kept, no_type, child.expression)
    declared.line = child.line
    place(declared, child.line)
    return kept
}

func append(name: String, adding: String, child: String, line: Integer) {
    var appended = parsed_statement("{name}.{adding}({child})", line)
    place(appended, line)
}

# ../../../spite_documentation/markup.md#a-lowercase-tag-calls-a-function
func called(element: AbstractSyntaxTree.Shapes.Markup.Element): SpiteCompiler.Expression {
    var function = types.function_of(element)
    crash function
    var children_name = ""
    if not element.children.is_empty() {
        children_name = children_of(element)
    }
    var arguments = List<SpiteCompiler.Expression>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = argument_for(element, parameter.name, children_name)
        arguments.append(argument)
        index = index + 1
    }
    var function_name = element.function_name()
    var callee = named(function_name, element.line)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var call = AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, no_generics, arguments)
    call.line = element.line
    return call
}

func argument_for(
    element: AbstractSyntaxTree.Shapes.Markup.Element,
    parameter: String,
    children_name: String,
): SpiteCompiler.Expression {
    if parameter == "children" {
        if children_name.is_empty() {
            return parsed_value("List<Anything>()", element.line)
        }
        return named(children_name, element.line)
    }
    var index = 0
    while index < element.written_attributes.count() {
        var attribute = element.written_attributes[index]
        if attribute.name == parameter {
            return value_of(attribute)
        }
        index = index + 1
    }
    return parsed_value("null", element.line)
}

func value_of(attribute: AbstractSyntaxTree.Shapes.Markup.Attribute): SpiteCompiler.Expression {
    if attribute.value {
        return attribute.value
    }
    return parsed_value("true", attribute.line)
}

func children_of(element: AbstractSyntaxTree.Shapes.Markup.Element): String {
    var name = fresh_name("children", element.line)
    var listing = parsed_statement("var {name} = List<Anything>()", element.line)
    place(listing, element.line)
    var index = 0
    while index < element.children.count() {
        var child = element.children[index]
        add_to_the_list(name, child)
        index = index + 1
    }
    return name
}

func add_to_the_list(name: String, child: AbstractSyntaxTree.Shapes.Markup.Child) {
    if child.element {
        var built_name = built(child.element)
        append(name, "append", built_name, child.line)
        return
    }
    fallback child.expression
    var kept = held_child(child)
    append(name, "append", kept, child.line)
}

# ../../../spite_documentation/markup.md#generated-names
func name_of(value: SpiteCompiler.Expression): String {
    var named_after = "child"
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        named_after = callee_name(value.callee)
    }
    var prefix = "render_"
    if named_after.starts_with(prefix) {
        var length = named_after.length()
        var start = prefix.length()
        var rest = named_after.slice(start, length)
        crash rest
        named_after = rest
    }
    return named_after.snake_case()
}

func callee_name(callee: SpiteCompiler.Expression?): String {
    fallback callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.name
    }
    return "child"
}

# ../../../spite_documentation/markup.md#positions
func place(statement: SpiteCompiler.WrittenStatement, line: Integer) {
    if stops.contains(line) and not placed_stops.contains(line) {
        var no_tokens = List<AbstractSyntaxTree.Tokens.Token>()
        var stopping = AbstractSyntaxTree.Parser.Parser(file.path, file.namespace, no_tokens)
        stopping.stops = stops
        stopping.placed_stops = placed_stops
        stopping.stop_on_line(held, line)
    }
    held.append(statement)
}

func named(name: String, line: Integer): AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
    var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
    identifier.line = line
    return identifier
}

func parsed_statement(text: String, line: Integer): SpiteCompiler.WrittenStatement {
    var lexer = AbstractSyntaxTree.Lexer.Lexer(file.path, text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser.Parser(file.path, file.namespace, made_tokens)
    return parser.statement()
}

func parsed_value(text: String, line: Integer): SpiteCompiler.Expression {
    var lexer = AbstractSyntaxTree.Lexer.Lexer(file.path, text, line)
    var made_tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser.Parser(file.path, file.namespace, made_tokens)
    return parser.expression()
}

enum Place {
    'declaration'
    'statement'
    'statement_end'
    'generic_value'
    'enum_name'
    'enum_value'
    'union_name'
    'union_member'
    'type_name'
    'type_member'
    'shape_parameter'
    'path_name'
    'member_name'
    'variable_name'
    'variable_equals'
    'function_name'
    'function_parameters'
    'parameter_name'
    'parameter_colon'
    'parameters_close'
    'opening_brace'
    'closing_brace'
    'arguments_close'
    'group_close'
    'closing_bracket'
    'case_colon'
    'entry_colon'
    'value'
    'type'
}

var start = 0
var place: Place
var at: Integer
var resumed: Integer

func Unfit(starting_place: Place, starting_at: Integer, starting_resumed: Integer) {
    place = starting_place
    at = starting_at
    resumed = starting_resumed
}

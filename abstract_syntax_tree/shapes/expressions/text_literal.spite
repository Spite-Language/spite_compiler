var pieces = List<TextPiece>()

func TextLiteral(starting_pieces: List<TextPiece>) {
    pieces = starting_pieces
}

func written(): String {
    var text = ""
    var index = 0
    while index < pieces.count() {
        text = "{text}{pieces[index].written()}"
        index = index + 1
    }
    return text
}

var callee: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
var generic_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()

func CallExpression(
    starting_callee: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_generic_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    starting_arguments: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
) {
    callee = starting_callee
    generic_arguments = starting_generic_arguments
    arguments = starting_arguments
}

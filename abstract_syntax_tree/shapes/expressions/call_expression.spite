var callee: SpiteCompiler.Expression? = null
var arguments = List<SpiteCompiler.Expression>()
var generic_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()

var line = 0
var column = 0

func CallExpression(
    starting_callee: SpiteCompiler.Expression,
    starting_generic_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    starting_arguments: List<SpiteCompiler.Expression>,
) {
    callee = starting_callee
    generic_arguments = starting_generic_arguments
    arguments = starting_arguments
}

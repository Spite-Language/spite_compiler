var target: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var index: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func IndexExpression(
    starting_target: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_index: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    target = starting_target
    index = starting_index
}

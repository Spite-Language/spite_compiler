var text = ""
var hole: SpiteCompiler.Expression? = null
var _backslash_code: Integer = 92
var _lowercase_n_code: Integer = 110
var _lowercase_t_code: Integer = 116
var _lowercase_r_code: Integer = 114

func TextPiece(starting_text: String, starting_hole: SpiteCompiler.Expression?) {
    text = starting_text
    hole = starting_hole
}

# ../../../../spite_spec/specs/values_and_types.md#text-escapes
func value(): String {
    var pieces = List<String>()
    var index = 0
    while index < text.length() {
        var code = text.byte_at(index)
        if code == _backslash_code and index + 1 < text.length() {
            var piece = escaped_text_at(index + 1)
            pieces.append(piece)
            index = index + 1 + piece.length()
        } else {
            var letter = letter_at(index)
            pieces.append(letter)
            index = index + letter.length()
        }
    }
    return pieces.join("")
}

func escaped_text_at(at: Integer): String {
    var escaped = text.byte_at(at)
    if escaped == _lowercase_n_code {
        return "\n"
    } else if escaped == _lowercase_t_code {
        return "\t"
    } else if escaped == _lowercase_r_code {
        return "\r"
    } else {
        return letter_at(at)
    }
}

func letter_at(at: Integer): String {
    var letter = text[at]
    crash letter
    return letter
}

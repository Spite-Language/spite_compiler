var text = ""
var hole: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func TextPiece(starting_text: String, starting_hole: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    text = starting_text
    hole = starting_hole
}

func written(): String {
    if hole {
        return "{text}\{"
    }
    return text
}

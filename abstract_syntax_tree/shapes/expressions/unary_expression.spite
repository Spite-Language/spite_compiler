var operator: AbstractSyntaxTree.Tokens.Token.Kind = 'minus'
var operand: SpiteCompiler.Expression? = null

var line = 0
var column = 0

func UnaryExpression(
    starting_operator: AbstractSyntaxTree.Tokens.Token.Kind,
    starting_operand: SpiteCompiler.Expression,
) {
    operator = starting_operator
    operand = starting_operand
}

var operator: AbstractSyntaxTree.Tokens.TokenKind = 'minus'
var operand: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func UnaryExpression(
    starting_operator: AbstractSyntaxTree.Tokens.TokenKind,
    starting_operand: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    operator = starting_operator
    operand = starting_operand
}

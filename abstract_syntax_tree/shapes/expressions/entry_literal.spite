var key: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var value: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func EntryLiteral(
    starting_key: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_value: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    key = starting_key
    value = starting_value
}

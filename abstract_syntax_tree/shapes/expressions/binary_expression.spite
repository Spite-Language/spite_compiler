var left: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var operator: AbstractSyntaxTree.Tokens.Token.Kind = 'plus'
var right: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func BinaryExpression(
    starting_left: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_operator: AbstractSyntaxTree.Tokens.Token.Kind,
    starting_right: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    left = starting_left
    operator = starting_operator
    right = starting_right
}

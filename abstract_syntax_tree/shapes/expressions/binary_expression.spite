var line = 0
var column = 0
var left: SpiteCompiler.Expression?
var operator: AbstractSyntaxTree.Tokens.Token.Kind
var right: SpiteCompiler.Expression?

func BinaryExpression(
    starting_left: SpiteCompiler.Expression,
    starting_operator: AbstractSyntaxTree.Tokens.Token.Kind,
    starting_right: SpiteCompiler.Expression,
) {
    left = starting_left
    operator = starting_operator
    right = starting_right
}

var declarations = List<SpiteCompiler.Declaration>()
var comments = List<Comment>()
var heading = List<String>()
var misplaced_comments = List<Comment>()
var misplaced_places = List<String>()
var blank_before = List<Integer>()
var merged_paths = List<String>()
var held_markup = false
var live_watches = List<String>()
var live_unfollowed = List<String>()
var live_unfollowed_lines = List<Integer>()
var live_unheard = List<String>()
var live_writes = List<String>()
var live_writes_lines = List<Integer>()
var live_keys = List<Expressions.BinaryExpression>()
var live_key_tags = List<String>()
var path: String
var namespace: String

func SourceFile(starting_path: String, starting_namespace: String) {
    path = starting_path
    namespace = starting_namespace
}

# ../../HOT_RELOAD.md#the-manifest
func written_paths(): List<String> {
    if not merged_paths.is_empty() {
        return merged_paths
    }
    var paths = List<String>()
    paths.append(path)
    return paths
}

func declarations_count(): Integer {
    return declarations.count()
}

# ../../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func remove_declaration_at(place: Integer) {
    declarations.remove_at(place)
    var shifted = List<Integer>()
    var index = 0
    while index < blank_before.count() {
        var kept = blank_before[index]
        crash kept
        if kept < place {
            shifted.append(kept)
        }
        if kept > place {
            shifted.append(kept - 1)
        }
        index = index + 1
    }
    blank_before = shifted
}

func class_name(): String {
    var segments = namespace.split(".")
    var last = segments.last()
    crash last
    return last
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func rank_of(declaration: SpiteCompiler.Declaration, of_class: String): Integer {
    switch declaration {
        Declarations.SingletonDeclaration: return 0
        Declarations.GenericDeclaration: return 1
        Declarations.EnumDeclaration: return 2
        Declarations.UnionDeclaration: return 3
        Declarations.TypeDeclaration: return 4
        Declarations.AttributeDeclaration: return rank_of_attribute(declaration)
        Declarations.FunctionDeclaration: return rank_of_function(declaration, of_class)
    }
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func rank_of_attribute(attribute: Declarations.AttributeDeclaration): Integer {
    if attribute.value or keeps_its_declared_layout() {
        return 5
    }
    return 6
}

# ../../../spite_documentation/classes_and_files.md#a-class-of-a-fixed-layout-keeps-its-order
func keeps_its_declared_layout(): Boolean {
    return namespace == "Buffer" or namespace == "ForeignCallback" or namespace.starts_with("Spite.")
}

func rank_of_function(function: Declarations.FunctionDeclaration, of_class: String): Integer {
    if function.is_a_conversion() {
        return 8
    }
    if function.is_a_preset_of(of_class) {
        return 9
    }
    if function.is_a_constructor_of(of_class) {
        return 7
    }
    return 10
}

var path = ""
var namespace = ""
var declarations = List<SpiteCompiler.Declaration>()
var comments = List<AbstractSyntaxTree.Shapes.Comment>()
var heading = List<String>()
var misplaced_comments = List<AbstractSyntaxTree.Shapes.Comment>()
var misplaced_places = List<String>()
var blank_before = List<Integer>()
var merged_paths = List<String>()

func SourceFile(starting_path: String, starting_namespace: String) {
    path = starting_path
    namespace = starting_namespace
}

# ../../HOT_RELOAD.md#the-manifest
func written_paths(): List<String> {
    if not merged_paths.is_empty() {
        return merged_paths
    }
    var paths = List<String>()
    paths.append(path)
    return paths
}

func declarations_count(): Integer {
    return declarations.count()
}

# ../../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func remove_declaration_at(place: Integer) {
    declarations.remove_at(place)
    var shifted = List<Integer>()
    var index = 0
    while index < blank_before.count() {
        var kept = blank_before[index]
        crash kept
        if kept < place {
            shifted.append(kept)
        }
        if kept > place {
            shifted.append(kept - 1)
        }
        index = index + 1
    }
    blank_before = shifted
}

func class_name(): String {
    var segments = namespace.split(".")
    var last = segments.last()
    crash last
    return last
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func rank_of(declaration: SpiteCompiler.Declaration, of_class: String): Integer {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return 0
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return 1
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return 2
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return 3
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return 4
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return rank_of_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return rank_of_function(declaration, of_class)
    }
}

# ../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func rank_of_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Integer {
    if attribute.value {
        return 5
    }
    return 6
}

func rank_of_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, of_class: String): Integer {
    if function.is_a_conversion() {
        return 8
    }
    if function.is_a_preset_of(of_class) {
        return 9
    }
    if function.is_a_constructor_of(of_class) {
        return 7
    }
    return 10
}

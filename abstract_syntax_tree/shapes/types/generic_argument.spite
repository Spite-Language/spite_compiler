var type_reference: SpiteCompiler.Type? = null
var is_type: Boolean
var text: String

func GenericArgument(starting_is_type: Boolean, starting_text: String) {
    is_type = starting_is_type
    text = starting_text
}

func of_type(starting_type: SpiteCompiler.Type) {
    is_type = true
    type_reference = starting_type
}

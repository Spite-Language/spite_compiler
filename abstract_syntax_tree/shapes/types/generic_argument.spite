var is_type = false
var text = ""
var type_reference: AbstractSyntaxTree.Shapes.Types.Type? = null

func GenericArgument(starting_is_type: Boolean, starting_text: String) {
    is_type = starting_is_type
    text = starting_text
}

func of_type(starting_type: AbstractSyntaxTree.Shapes.Types.Type) {
    is_type = true
    type_reference = starting_type
}

func written(): String {
    if is_type {
        crash type_reference
        return type_reference.written()
    }
    return text
}

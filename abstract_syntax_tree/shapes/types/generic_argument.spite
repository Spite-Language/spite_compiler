union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var is_type = false
var text = ""
var type_reference: Type? = null

func GenericArgument(starting_is_type: Boolean, starting_text: String) {
    is_type = starting_is_type
    text = starting_text
}

func of_type(starting_type: Type) {
    is_type = true
    type_reference = starting_type
}

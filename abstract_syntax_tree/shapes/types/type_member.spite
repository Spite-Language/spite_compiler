union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var name = ""
var parameters = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
var result: Type? = null
var is_an_attribute = false

func TypeMember(
    starting_name: String,
    starting_parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>,
    starting_result: Type?,
) {
    name = starting_name
    parameters = starting_parameters
    result = starting_result
}

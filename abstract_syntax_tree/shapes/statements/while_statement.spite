var condition: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var body: AbstractSyntaxTree.Shapes.Statements.Block? = null
var line = 0

func WhileStatement(
    starting_condition: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_body: AbstractSyntaxTree.Shapes.Statements.Block,
) {
    condition = starting_condition
    body = starting_body
}

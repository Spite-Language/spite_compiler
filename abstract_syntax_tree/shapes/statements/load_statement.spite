var line = 0
var preloads = false
var folder: SpiteCompiler.Expression?

func LoadStatement(starting_folder: SpiteCompiler.Expression) {
    folder = starting_folder
}

# ../../../../spite_documentation/programs.md#preloaded-files
func get_keyword(): String {
    if preloads {
        return "preload"
    }
    return "load"
}

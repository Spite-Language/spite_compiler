var line = 0
var condition: SpiteCompiler.Expression?
var then_branch: Block?
var else_branch: Block?

func IfStatement(starting_condition: SpiteCompiler.Expression, starting_then: Block, starting_else: Block?) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
}

# ../../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func else_if(): IfStatement? {
    fallback else_branch
    fallback else_branch.statements.count() == 1
    var only = else_branch.statements[0]
    fallback only.class == IfStatement
    return only
}

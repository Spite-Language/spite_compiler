var line = 0
var condition: SpiteCompiler.Expression?
var then_branch: AbstractSyntaxTree.Shapes.Statements.Block?
var else_branch: AbstractSyntaxTree.Shapes.Statements.Block?

func IfStatement(
    starting_condition: SpiteCompiler.Expression,
    starting_then: AbstractSyntaxTree.Shapes.Statements.Block,
    starting_else: AbstractSyntaxTree.Shapes.Statements.Block?,
) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
}

var target: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var value: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var line = 0

func AssignmentStatement(
    starting_target: AbstractSyntaxTree.Shapes.Expressions.Expression,
    starting_value: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    target = starting_target
    value = starting_value
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var name = ""
var parameters = List<Parameter>()
var result: Type? = null
var body: AbstractSyntaxTree.Shapes.Statements.Block? = null
var line = 0
var path = ""

func FunctionDeclaration(
    starting_name: String,
    starting_parameters: List<Parameter>,
    starting_result: Type?,
    starting_body: AbstractSyntaxTree.Shapes.Statements.Block?,
) {
    name = starting_name
    parameters = starting_parameters
    result = starting_result
    body = starting_body
}

# ../../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func is_a_constructor_of(class_name: String): Boolean {
    return name == class_name and not is_a_conversion()
}

func is_a_conversion(): Boolean {
    fallback result and parameters.count() == 1
    var only = parameters[0]
    return only.name == "from"
}

func is_a_preset_of(class_name: String): Boolean {
    fallback name != class_name and result and parameters.is_empty()
    var first = name.slice(0, 1)
    crash first
    return first != first.lower_case()
}

func declared_key(): String {
    if not is_a_conversion() {
        return name
    }
    var only = parameters[0]
    crash only
    crash only.declared_type
    var source_name = only.declared_type.path.join("_")
    return "{name}_from_{source_name}"
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var name = ""
var parameters = List<Parameter>()
var result: Type? = null
var body: AbstractSyntaxTree.Shapes.Statements.Block? = null
var line = 0
var path = ""

func FunctionDeclaration(
    starting_name: String,
    starting_parameters: List<Parameter>,
    starting_result: Type?,
    starting_body: AbstractSyntaxTree.Shapes.Statements.Block?,
) {
    name = starting_name
    parameters = starting_parameters
    result = starting_result
    body = starting_body
}

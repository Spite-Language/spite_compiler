var line = 0
var path = ""
var comments = List<String>()
var source = "written"
var name: String
var parameters: List<Parameter>
var result: SpiteCompiler.Type?
var body: AbstractSyntaxTree.Shapes.Statements.Block?

func FunctionDeclaration(
    starting_name: String,
    starting_parameters: List<Parameter>,
    starting_result: SpiteCompiler.Type?,
    starting_body: AbstractSyntaxTree.Shapes.Statements.Block?,
) {
    name = starting_name
    parameters = starting_parameters
    result = starting_result
    body = starting_body
}

# ../../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func is_a_constructor_of(class_name: String): Boolean {
    return name == class_name and not is_a_conversion()
}

func is_a_conversion(): Boolean {
    fallback result and parameters.count() == 1
    var only = parameters[0]
    return only.name == "from"
}

func is_a_preset_of(class_name: String): Boolean {
    fallback name != class_name and result and parameters.is_empty()
    var first = name.slice(0, 1)
    crash first
    return first != first.lower_case()
}

func declared_key(): String {
    if not is_a_conversion() {
        return name
    }
    var only = parameters[0]
    crash only
    crash only.declared_type
    var source_name = only.declared_type.path.join("_")
    return "{name}_from_{source_name}"
}

# ../../../../spite_documentation/foreign_libraries.md#declaring-a-foreign-function
func declared_foreign_call(): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    fallback body
    var statements = body.statements
    var last = statements.last()
    fallback last
    var handed = handed_value_of(last)
    fallback handed
    fallback handed.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback handed.generic_arguments.is_empty()
    var callee = handed.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback callee.target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback handed.arguments.count() == parameters.count()
    var index = 0
    while index < parameters.count() {
        var argument = handed.arguments[index]
        var parameter = parameters[index]
        fallback argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
        fallback argument.name == parameter.name
        index = index + 1
    }
    index = 0
    while index < statements.count() - 1 {
        var statement = statements[index]
        var bound = library_made_by(statement)
        fallback bound
        index = index + 1
    }
    return handed
}

func library_bound_as(name: String): SpiteCompiler.Expression? {
    fallback body
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        var bound = library_made_by(statement)
        if bound and statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return bound
        }
        index = index + 1
    }
    return null
}

func handed_value_of(statement: SpiteCompiler.WrittenStatement?): SpiteCompiler.Expression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return statement.value
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        return statement.value
    }
    return null
}

func library_made_by(statement: SpiteCompiler.WrittenStatement?): SpiteCompiler.Expression? {
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    fallback statement.value
    fallback statement.value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    var made_class = statement.value.callee
    fallback made_class.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback made_class.name == "DynamicLibrary"
    return statement.value
}

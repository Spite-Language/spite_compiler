var line = 0
var end_line = 0
var member_arguments = List<List<AbstractSyntaxTree.Shapes.Types.GenericArgument>>()
var name: String
var member_names: List<String>
var member_lines: List<Integer>

func UnionDeclaration(starting_name: String, starting_members: List<String>, starting_lines: List<Integer>) {
    name = starting_name
    member_names = starting_members
    member_lines = starting_lines
}

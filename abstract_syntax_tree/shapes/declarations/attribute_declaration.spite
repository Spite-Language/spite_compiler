var name = ""
var declared_type: AbstractSyntaxTree.Shapes.Types.Type? = null
var value: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var line = 0

func AttributeDeclaration(
    starting_name: String,
    starting_type: AbstractSyntaxTree.Shapes.Types.Type?,
    starting_value: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    name = starting_name
    declared_type = starting_type
    value = starting_value
}

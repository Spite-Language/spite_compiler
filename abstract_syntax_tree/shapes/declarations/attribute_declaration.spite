var name = ""
var declared_type: SpiteCompiler.Type? = null
var value: SpiteCompiler.Expression? = null
var line = 0
var path = ""

func AttributeDeclaration(
    starting_name: String,
    starting_type: SpiteCompiler.Type?,
    starting_value: SpiteCompiler.Expression?,
) {
    name = starting_name
    declared_type = starting_type
    value = starting_value
}

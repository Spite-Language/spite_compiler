union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var name = ""
var declared_type: Type? = null
var is_variadic = false

func Parameter(
    starting_name: String,
    starting_type: Type,
    starting_is_variadic: Boolean,
) {
    name = starting_name
    declared_type = starting_type
    is_variadic = starting_is_variadic
}

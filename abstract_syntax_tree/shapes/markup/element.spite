var _lowercase_z_code = 122
var line = 0
var written_attributes = List<AbstractSyntaxTree.Shapes.Markup.Attribute>()
var children = List<AbstractSyntaxTree.Shapes.Markup.Child>()
var tag: String

func Element(starting_tag: String) {
    tag = starting_tag
}

# ../../../../spite_documentation/markup.md#a-lowercase-tag-calls-a-function
func calls_a_function(): Boolean {
    var first = tag.byte_at(0)
    return first >= 97 and first <= _lowercase_z_code and not tag.contains(".")
}

func last_segment(): String {
    var segments = tag.split(".")
    var last = segments.last()
    crash last
    return last
}

func function_name(): String {
    return "render_{tag}"
}

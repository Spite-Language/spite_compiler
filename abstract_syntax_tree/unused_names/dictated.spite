var operator_names = [
    "sum"
    "subtract"
    "multiply"
    "divide"
    "remainder"
    "negate"
    "equals"
    "less_than"
    "greater_than"
    "get_at"
    "set_at"
    "get_attribute"
    "set_attribute"
    "run_callback"
]

# ../../../spite_spec/specs/style.md#unused-is-an-error
func is_dictated(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    attribute_names: List<String>,
): Boolean {
    if operator_names.contains(function.name) {
        return true
    }
    if is_a_template(function) {
        return true
    }
    var is_a_setter = function.name.starts_with("set_") and function.parameters.count() == 1
    if is_a_setter {
        var name_length = function.name.length()
        var attribute = function.name.slice(4, name_length)
        crash attribute
        return attribute_names.contains(attribute)
    }
    return false
}

func is_a_template(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    var words = function.name.split("_")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and describes_a_declaration(parameter.declared_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func describes_a_declaration(written: SpiteCompiler.Type?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        var ranges = ["Spite.AttributeDeclaration", "Spite.FunctionDeclaration", "Spite.Argument"]
        return ranges.contains(path) or path == "Symbol"
    }
    return false
}

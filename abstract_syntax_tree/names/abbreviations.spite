# ../../../spite_documentation/style.md#names
func meanings_of(word: String): List<String> {
    if word == "temp" {
        return ["temporary", "temperature"]
    } else if word == "res" {
        return ["response", "result", "resource"]
    } else if word == "dir" {
        return ["directory", "direction"]
    } else if word == "dirs" {
        return ["directories", "directions"]
    } else if word == "init" {
        return ["initialize", "initial"]
    } else if word == "ext" {
        return ["extension", "external"]
    } else if word == "desc" {
        return ["description", "descending"]
    } else if word == "pos" {
        return ["position", "positive"]
    } else if word == "cur" {
        return ["current", "cursor"]
    } else if word == "curr" {
        return ["current", "cursor"]
    } else if word == "auth" {
        return ["authentication", "authorization"]
    } else if word == "proc" {
        return ["process", "procedure"]
    } else if word == "ver" {
        return ["version", "verify"]
    } else if word == "sep" {
        return ["separator", "separate"]
    } else if word == "conf" {
        return ["configuration", "conference"]
    } else if word == "req" {
        return ["request", "required"]
    } else if word == "prev" {
        return ["previous", "preview"]
    } else if word == "val" {
        return ["value", "valid"]
    } else if word == "doc" {
        return ["document", "documentation"]
    } else if word == "docs" {
        return ["documents", "documentation"]
    } else if word == "spec" {
        return ["specification", "special"]
    } else if word == "calc" {
        return ["calculate", "calculator"]
    } else if word == "arr" {
        return ["array", "arrival"]
    } else if word == "cb" {
        return ["callback", "checkbox"]
    } else if word == "int" {
        return ["integer", "internal"]
    } else if word == "opt" {
        return ["option", "optional"]
    } else if word == "lst" {
        return ["list", "last"]
    } else if word == "fmt" {
        return ["format", "formatter"]
    } else {
        return List<String>()
    }
}

func windows_word_of(word: String): String {
    if word == "position" {
        return "pos"
    } else if word == "rectangle" {
        return "rect"
    } else if word == "parameter" {
        return "param"
    } else if word == "pointer" {
        return "ptr"
    } else {
        return word
    }
}

var _wide_letter = 87
var _narrow_letter = 65
var _first_lower_letter = 97
var _last_lower_letter = 122

# ../../../spite_documentation/foreign_libraries.md#spite-names-for-foreign-functions
func spite_name_of(symbol: String, prefix: String): String {
    var written = symbol.snake_case()
    var words = written.split("_")
    var kept = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        if not word.is_empty() {
            kept.append(word)
        }
        index = index + 1
    }
    if names_a_text_kind(symbol) and kept.count() > 1 {
        crash kept.remove_last()
    }
    if not prefix.is_empty() and kept.count() > 1 {
        var first = kept[0]
        if first == prefix.lower_case() {
            crash kept.remove_first()
        }
    }
    if kept.count() > 1 {
        var first = kept[0]
        if first == "get" {
            crash kept.remove_first()
        }
    }
    return full_words_of(kept)
}

func names_a_text_kind(symbol: String): Boolean {
    var length = symbol.length()
    fallback length > 2
    var last = symbol.byte_at(length - 1)
    var before = symbol.byte_at(length - 2)
    var is_wide_or_narrow = last == _wide_letter or last == _narrow_letter
    var follows_a_lower_letter = before >= _first_lower_letter and before <= _last_lower_letter
    return is_wide_or_narrow and follows_a_lower_letter
}

func full_words_of(words: List<String>): String {
    var abbreviations = Abbreviations()
    var full = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var full_word = abbreviations.full_word_of(word)
        if full_word.is_empty() {
            full.append(word)
        } else {
            full.append(full_word)
        }
        index = index + 1
    }
    return full.join("_")
}

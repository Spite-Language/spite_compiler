var path: String
var namespace: String

func TextReading(starting_path: String, starting_namespace: String) {
    path = starting_path
    namespace = starting_namespace
}

# ../../spite_documentation/style.md#what-the-formatter-rewrites
func tree_of(text: String): Shapes.SourceFile {
    var reading = AbstractSyntaxTree(path, namespace, text)
    return reading.run()
}

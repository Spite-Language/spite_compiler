# ../spite_documentation/compiler.md#pass-settings-to-the-program

var check = false
var build = false
var executable_path = ""
var final_classes = ""
var optimization_report = ""
var high_ir = false
var low_ir = false
var optimized = false
var development = false
var repl = false
var repl_port = 0
var hot_reload = false
var debug_memory = false
var trace_fallbacks = false
var target_operating_system = ""
var reload_at = ""
var connect = 0
var command = ""
var _flags = List<String>()
var _names = List<String>()
var _connection: List<String> = [Environment.attributes["connect"].name, Environment.attributes["command"].name]
var _outputs: List<String> = [
    Environment.attributes["check"].name
    Environment.attributes["build"].name
    Environment.attributes["executable_path"].name
    Environment.attributes["final_classes"].name
    Environment.attributes["optimization_report"].name
    Environment.attributes["high_ir"].name
    Environment.attributes["low_ir"].name
]
var _program_options: List<String> = [
    Environment.attributes["optimized"].name
    Environment.attributes["development"].name
    Environment.attributes["repl"].name
    Environment.attributes["repl_port"].name
    Environment.attributes["hot_reload"].name
    Environment.attributes["debug_memory"].name
    Environment.attributes["trace_fallbacks"].name
]
var _other_build_reads: List<String> = [
    Environment.attributes["final_classes"].name
    Environment.attributes["target_operating_system"].name
]
var _without_a_library: List<String> = [
    Environment.attributes["debug_memory"].name
    Environment.attributes["optimized"].name
]
var _reload_address: String = Environment.attributes["reload_at"].name

func given_flags(): List<String> {
    return _flags
}

func flag_names(): List<String> {
    if _names.is_empty() {
        Environment.attributes.each(note_a_flag)
    }
    return _names
}

func note_a_flag(attribute: Spite.AttributeDeclaration) {
    fallback not attribute.name.starts_with("_")
    _names.append(attribute.name)
}

func is_connection(name: String): Boolean {
    return _connection.contains(name)
}

func is_output(name: String): Boolean {
    return _outputs.contains(name)
}

func is_build_option(name: String): Boolean {
    return is_output(name) or _program_options.contains(name)
}

func is_the_compilers_own(name: String): Boolean {
    var read_from_build = _program_options.contains(name) or _other_build_reads.contains(name)
    var names = flag_names()
    return names.contains(name) and not read_from_build
}

func is_read_without_a_library(name: String): Boolean {
    return _without_a_library.contains(name)
}

func is_left_out_of_a_reload(name: String): Boolean {
    return is_output(name) or name == _reload_address
}

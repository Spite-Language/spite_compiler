var successors = List<List<Integer>>()
var predecessors = List<List<Integer>>()
var is_regular = true
var reachable = List<Boolean>()

func read_the_function(function: LowIntermediaryRepresentation.LowFunction) {
    successors = List<List<Integer>>()
    predecessors = List<List<Integer>>()
    is_regular = true
    var count = function.blocks.count()
    var index = 0
    while index < count {
        var leaving = List<Integer>()
        successors.append(leaving)
        var arriving = List<Integer>()
        predecessors.append(arriving)
        index = index + 1
    }
    index = 0
    while index < count {
        add_the_successors(function, index)
        index = index + 1
    }
    find_the_reachable(count)
}

func find_the_reachable(count: Integer) {
    reachable = List<Boolean>()
    var index = 0
    while index < count {
        reachable.append(false)
        index = index + 1
    }
    assert count > 0
    var waiting = List<Integer>()
    waiting.append(0)
    reachable[0] = true
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        var leaving = successors[taken]
        crash leaving
        var position = 0
        while position < leaving.count() {
            var next = leaving[position]
            if reachable[next] != true {
                reachable[next] = true
                waiting.append(next)
            }
            position = position + 1
        }
    }
}

func is_reachable(block_index: Integer): Boolean {
    return reachable[block_index] == true
}

func reachable_predecessor_count(block_index: Integer): Integer {
    var arriving = predecessors[block_index]
    crash arriving
    return arriving.count(is_reachable)
}

func add_the_successors(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var position = 0
    while position + 1 < block.instructions.count() {
        var inner = block.instructions[position]
        crash inner
        if ends_the_block(inner) {
            is_regular = false
        }
        position = position + 1
    }
    var last = block.instructions.last()
    if last {
        if last == LowIntermediaryRepresentation.Instructions.Jump {
            add_an_edge(block_index, last.block)
            return
        }
        if last == LowIntermediaryRepresentation.Instructions.Branch {
            add_an_edge(block_index, last.when_true)
            if last.when_false != last.when_true {
                add_an_edge(block_index, last.when_false)
            }
            return
        }
        assert not ends_the_block(last)
    }
    if block_index + 1 < function.blocks.count() {
        add_an_edge(block_index, block_index + 1)
    }
}

func add_an_edge(from_block: Integer, to_block: Integer) {
    if to_block < 0 or to_block >= successors.count() {
        is_regular = false
        return
    }
    var leaving = successors[from_block]
    crash leaving
    leaving.append(to_block)
    var arriving = predecessors[to_block]
    crash arriving
    arriving.append(from_block)
}

func ends_the_block(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.Stop: return not instruction.continues
        _: return false
    }
}

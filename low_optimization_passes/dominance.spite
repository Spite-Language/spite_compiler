# ../OPTIMIZATIONS.md#each-write-of-a-variable-is-a-value-of-its-own
var order = List<Integer>()
var order_of = List<Integer>()
var immediate = List<Integer>()
var children = List<List<Integer>>()
var frontiers = List<List<Integer>>()
var is_complete = false

func read_the_blocks(edges: LowOptimizationPasses.BlockEdges, count: Integer) {
    order = List<Integer>()
    order_of = List<Integer>()
    immediate = List<Integer>()
    children = List<List<Integer>>()
    frontiers = List<List<Integer>>()
    is_complete = false
    fallback count > 0
    var index = 0
    while index < count {
        order_of.append(-1)
        immediate.append(-1)
        var below = List<Integer>()
        children.append(below)
        var frontier = List<Integer>()
        frontiers.append(frontier)
        index = index + 1
    }
    number_in_order(edges, count)
    fallback find_the_dominators(edges)
    index = 1
    while index < order.count() {
        var block = order[index]
        crash block
        var above = immediate[block]
        crash above
        var below = children[above]
        crash below
        below.append(block)
        index = index + 1
    }
    find_the_frontiers(edges)
    is_complete = true
}

func number_in_order(edges: LowOptimizationPasses.BlockEdges, count: Integer) {
    var visited = List<Boolean>()
    var index = 0
    while index < count {
        visited.append(false)
        index = index + 1
    }
    var finished = List<Integer>()
    var waiting = List<Integer>()
    var next_child = List<Integer>()
    waiting.append(0)
    next_child.append(0)
    visited[0] = true
    while not waiting.is_empty() {
        var top = waiting.count() - 1
        var block = waiting[top]
        var child = next_child[top]
        crash block
        crash child
        var leaving = edges.successors[block]
        crash leaving
        if child < leaving.count() {
            next_child[top] = child + 1
            var successor = leaving[child]
            crash successor
            if visited[successor] != true {
                visited[successor] = true
                waiting.append(successor)
                next_child.append(0)
            }
        } else {
            finished.append(block)
            crash waiting.remove_last()
            crash next_child.remove_last()
        }
    }
    index = finished.count() - 1
    while index >= 0 {
        var block = finished[index]
        crash block
        order_of[block] = order.count()
        order.append(block)
        index = index - 1
    }
}

func find_the_dominators(edges: LowOptimizationPasses.BlockEdges): Boolean {
    immediate[0] = 0
    var changed = true
    var round = 0
    while changed and round < 256 {
        changed = false
        var position = 1
        while position < order.count() {
            var block = order[position]
            crash block
            var found = meet_of_the_predecessors(edges, block)
            if found >= 0 and immediate[block] != found {
                immediate[block] = found
                changed = true
            }
            position = position + 1
        }
        round = round + 1
    }
    return not changed
}

func meet_of_the_predecessors(edges: LowOptimizationPasses.BlockEdges, block: Integer): Integer {
    var found = -1
    var coming = edges.predecessors[block]
    crash coming
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        crash predecessor
        var known = immediate[predecessor]
        crash known
        var ordered = order_of[predecessor]
        crash ordered
        if known >= 0 and ordered >= 0 {
            if found < 0 {
                found = predecessor
            } else {
                found = intersected(found, predecessor)
            }
        }
        index = index + 1
    }
    return found
}

func intersected(first: Integer, second: Integer): Integer {
    var left = first
    var right = second
    while left != right {
        var left_order = order_of[left]
        var right_order = order_of[right]
        crash left_order
        crash right_order
        if left_order > right_order {
            var up = immediate[left]
            crash up
            left = up
        } else {
            var up = immediate[right]
            crash up
            right = up
        }
    }
    return left
}

func find_the_frontiers(edges: LowOptimizationPasses.BlockEdges) {
    var position = 0
    while position < order.count() {
        var block = order[position]
        crash block
        var coming = edges.predecessors[block]
        crash coming
        if coming.count() >= 2 {
            var above = immediate[block]
            crash above
            var index = 0
            while index < coming.count() {
                var runner = coming[index]
                crash runner
                var ordered = order_of[runner]
                crash ordered
                if ordered >= 0 {
                    add_to_the_frontiers(runner, above, block)
                }
                index = index + 1
            }
        }
        position = position + 1
    }
}

func add_to_the_frontiers(start: Integer, above: Integer, block: Integer) {
    var runner = start
    while runner != above {
        var frontier = frontiers[runner]
        crash frontier
        if not frontier.contains(block) {
            frontier.append(block)
        }
        fallback runner != 0
        var up = immediate[runner]
        crash up
        runner = up
    }
}

func is_reached(block: Integer): Boolean {
    var ordered = order_of[block]
    crash ordered
    return ordered >= 0
}

var function = LowIntermediaryRepresentation.LowFunction("", 0)

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    var edges = LowOptimizationPasses.JumpThreading.KnownEdges(function)
    edges.thread()
    function.blocks.each(thread_the_ending)
    clear_the_unreachable()
    return function
}

func thread_the_ending(block: LowIntermediaryRepresentation.LowBlock) {
    var count = block.instructions.count()
    assert count > 0
    var last = block.instructions[count - 1]
    crash last
    if last == LowIntermediaryRepresentation.Instructions.Jump {
        last.block = final_target(last.block)
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        last.when_true = final_target(last.when_true)
        last.when_false = final_target(last.when_false)
    }
}

func final_target(block: Integer): Integer {
    var target = block
    var hops = 0
    while hops < 16 {
        var next = only_jump_of(target)
        if next < 0 or next == target {
            return target
        }
        target = next
        hops = hops + 1
    }
    return target
}

func only_jump_of(block: Integer): Integer {
    var found = function.blocks[block]
    crash found
    if found.instructions.count() != 1 {
        return -1
    }
    var only = found.instructions[0]
    if only == LowIntermediaryRepresentation.Instructions.Jump {
        return only.block
    }
    return -1
}

func clear_the_unreachable() {
    var reached = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        reached.append(false)
        index = index + 1
    }
    var waiting = List<Integer>()
    waiting.append(0)
    reached[0] = true
    while not waiting.is_empty() {
        var block_index = waiting.remove_last()
        crash block_index
        var leaving = successors_of(block_index)
        var leaving_index = 0
        while leaving_index < leaving.count() {
            var successor = leaving[leaving_index]
            if reached[successor] != true {
                reached[successor] = true
                waiting.append(successor)
            }
            leaving_index = leaving_index + 1
        }
    }
    index = 0
    while index < function.blocks.count() {
        var block = function.blocks[index]
        if reached[index] != true {
            block.instructions.clear()
        }
        index = index + 1
    }
}

func successors_of(block_index: Integer): List<Integer> {
    var leaving = List<Integer>()
    var block = function.blocks[block_index]
    crash block
    var falls_through = true
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Jump {
            leaving.append(instruction.block)
        }
        if instruction == LowIntermediaryRepresentation.Instructions.Branch {
            leaving.append(instruction.when_true)
            leaving.append(instruction.when_false)
        }
        falls_through = not ends_the_block(instruction)
        index = index + 1
    }
    if falls_through and block_index + 1 < function.blocks.count() {
        leaving.append(block_index + 1)
    }
    return leaving
}

func ends_the_block(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Jump {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Branch {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Return {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Exit {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Stop {
        return not instruction.continues
    }
    return false
}

union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var register_total = 0
var readers = List<Integer>()
var known = List<Boolean>()
var values = List<Long>()
var booleans = List<Boolean>()
var touched = List<Integer>()
var copy_targets = List<Integer>()
var copy_sources = List<Integer>()
var rounds = 4

func KnownEdges(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func thread() {
    register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        readers.append(-1)
        known.append(false)
        values.append(0)
        booleans.append(false)
        index = index + 1
    }
    var round = 0
    var changed = true
    while changed and round < rounds {
        find_the_readers()
        changed = false
        var block_index = 0
        while block_index < function.blocks.count() {
            if thread_the_block(block_index) {
                changed = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
}

func find_the_readers() {
    var index = 0
    while index < register_total {
        readers[index] = -1
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            note_the_readers(block_index)
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func note_the_readers(block_index: Integer) {
    var index = 0
    while index < operands.uses.count() {
        var register = operands.uses[index]
        var earlier = readers[register]
        crash earlier
        if earlier == -1 {
            readers[register] = block_index
        } else if earlier != block_index {
            readers[register] = -2
        }
        index = index + 1
    }
}

func thread_the_block(block_index: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var last = block.instructions.last()
    fallback last
    if last == LowIntermediaryRepresentation.Instructions.Jump {
        var onward = decided(block_index, last.block, -1, 0)
        if onward >= 0 {
            last.block = onward
            return true
        }
        return false
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        return thread_a_branch(block_index, last)
    }
    return false
}

func thread_a_branch(block_index: Integer, branch: LowIntermediaryRepresentation.Instructions.Branch): Boolean {
    var changed = false
    var when_true = decided(block_index, branch.when_true, branch.condition, 1)
    if when_true >= 0 {
        branch.when_true = when_true
        changed = true
    }
    var when_false = decided(block_index, branch.when_false, branch.condition, 0)
    if when_false >= 0 {
        branch.when_false = when_false
        changed = true
    }
    return changed
}

func decided(from_block: Integer, target: Integer, condition: Integer, condition_value: Long): Integer {
    if target == from_block or not is_a_decision(target) {
        return -1
    }
    forget_everything()
    follow_the_block(from_block)
    if condition >= 0 {
        if condition_value != 0 and booleans[condition] != true {
            return -1
        }
        learn_the_condition(condition, condition_value)
    }
    var block = function.blocks[target]
    crash block
    var last_index = block.instructions.count() - 1
    var index = 0
    while index < last_index {
        var instruction = block.instructions[index]
        if not releases_nothing(instruction) {
            return -1
        }
        follow(instruction)
        index = index + 1
    }
    var last = block.instructions.last()
    crash last
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        return chosen_side(last, target)
    }
    return -1
}

func chosen_side(branch: LowIntermediaryRepresentation.Instructions.Branch, target: Integer): Integer {
    if known[branch.condition] != true {
        return -1
    }
    var value = values[branch.condition]
    crash value
    var chosen = branch.when_false
    if value != 0 {
        chosen = branch.when_true
    }
    if chosen == target {
        return -1
    }
    return chosen
}

func is_a_decision(target: Integer): Boolean {
    var block = function.blocks[target]
    crash block
    var last = block.instructions.last()
    fallback last
    fallback last == LowIntermediaryRepresentation.Instructions.Branch
    var last_index = block.instructions.count() - 1
    var index = 0
    while index < last_index {
        var instruction = block.instructions[index]
        fallback is_a_plain_step(instruction) and kept_inside(instruction, target)
        index = index + 1
    }
    return true
}

func is_a_plain_step(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Call: return is_a_release(instruction)
        _: return false
    }
}

func is_a_release(call: LowIntermediaryRepresentation.Instructions.Call): Boolean {
    return call.function == "_release" and call.arguments.count() == 1 and call.target < 0 and call.presence < 0
}

func releases_nothing(instruction: Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        var released = instruction.arguments[0]
        crash released
        fallback known[released] == true
        var value = values[released]
        crash value
        return value == 0
    }
    return true
}

func kept_inside(instruction: Instruction, target: Integer): Boolean {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        var reader = readers[register]
        crash reader
        fallback reader == -1 or reader == target
        index = index + 1
    }
    return true
}

func forget_everything() {
    var index = 0
    while index < touched.count() {
        var register = touched[index]
        known[register] = false
        booleans[register] = false
        index = index + 1
    }
    touched = List<Integer>()
    copy_targets = List<Integer>()
    copy_sources = List<Integer>()
}

func learn(register: Integer, value: Long) {
    fallback register >= 0
    known[register] = true
    values[register] = value
    touched.append(register)
}

func forget(register: Integer) {
    if register >= 0 {
        known[register] = false
        booleans[register] = false
    }
    var targets = List<Integer>()
    var sources = List<Integer>()
    var index = 0
    while index < copy_targets.count() {
        var copied = copy_targets[index]
        var source = copy_sources[index]
        crash source
        if copied != register and source != register {
            targets.append(copied)
            sources.append(source)
        }
        index = index + 1
    }
    copy_targets = targets
    copy_sources = sources
}

func follow_the_block(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    block.instructions.each(follow)
}

func follow(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: follow_a_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: follow_a_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: follow_a_compare(instruction)
        _: forget_the_defined(instruction)
    }
}

func forget_the_defined(instruction: Instruction) {
    operands.read(instruction)
    var defined = operands.defines.copy()
    defined.each(forget)
}

func follow_a_constant(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    forget(constant.target)
    learn(constant.target, constant.number)
}

func follow_a_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    forget(copy.target)
    fallback copy.target >= 0 and copy.source >= 0
    if known[copy.source] == true {
        var value = values[copy.source]
        crash value
        learn(copy.target, value)
    }
    if booleans[copy.source] == true {
        booleans[copy.target] = true
        touched.append(copy.target)
    }
    copy_targets.append(copy.target)
    copy_sources.append(copy.source)
}

func follow_a_compare(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    forget(compare.target)
    if compare.target >= 0 {
        booleans[compare.target] = true
        touched.append(compare.target)
    }
    fallback known[compare.left] == true and known[compare.right] == true
    var left = values[compare.left]
    var right = values[compare.right]
    crash left
    crash right
    var number: Long = 0
    if compared(compare.comparison, left, right, compare.is_signed) {
        number = 1
    }
    learn(compare.target, number)
}

func learn_the_condition(condition: Integer, value: Long) {
    learn(condition, value)
    var index = 0
    while index < copy_targets.count() {
        var copied = copy_targets[index]
        var source = copy_sources[index]
        crash source
        if source == condition {
            learn(copied, value)
        }
        if copied == condition {
            learn(source, value)
        }
        index = index + 1
    }
}

func compared(
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    left: Long,
    right: Long,
    is_signed: Boolean,
): Boolean {
    var less = left < right
    var left_is_negative = left < 0
    var right_is_negative = right < 0
    if not is_signed and left_is_negative != right_is_negative {
        less = left >= 0
    }
    switch comparison {
        'equal': return left == right
        'not_equal': return left != right
        'less': return less
        'less_or_equal': return less or left == right
        'greater': return not less and left != right
        'greater_or_equal': return not less
    }
}

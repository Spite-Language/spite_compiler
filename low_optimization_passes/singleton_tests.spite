# ../OPTIMIZATIONS.md#a-singleton-the-entry-class-makes-is-never-tested-again
func tested_label(
    of_function: LowIntermediaryRepresentation.LowFunction,
    block: LowIntermediaryRepresentation.LowBlock,
): Integer {
    var last = block.instructions.last()
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        return label_tested_by(of_function, block, last)
    }
    return -1
}

func label_tested_by(
    of_function: LowIntermediaryRepresentation.LowFunction,
    block: LowIntermediaryRepresentation.LowBlock,
    last: LowIntermediaryRepresentation.Instructions.Branch,
): Integer {
    var making = of_function.blocks[last.when_true]
    crash making
    var maker = maker_called_in(making, last.when_false)
    if maker.is_empty() {
        return -1
    }
    var index = block.instructions.count() - 1
    while index >= 0 {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.DataAddress {
            if maker.ends_with("${instruction.label}") {
                return instruction.label
            }
            return -1
        }
        index = index - 1
    }
    return -1
}

func maker_called_in(making: LowIntermediaryRepresentation.LowBlock, after: Integer): String {
    fallback making.instructions.count() == 2
    var called = making.instructions[0]
    var leaving = making.instructions[1]
    if leaving.class == LowIntermediaryRepresentation.Instructions.Jump {
        fallback leaving.block == after
        return maker_key_of(called)
    }
    return ""
}

func maker_key_of(called: SpiteCompiler.Instruction): String {
    if called.class == LowIntermediaryRepresentation.Instructions.Call {
        return maker_named_by(called)
    }
    return ""
}

func maker_named_by(called: LowIntermediaryRepresentation.Instructions.Call): String {
    if called.function.starts_with("_make_") and called.arguments.is_empty() {
        return called.function
    }
    return ""
}

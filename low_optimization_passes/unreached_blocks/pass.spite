# ../../OPTIMIZATIONS.md#the-class-of-an-object-made-in-the-function-is-known
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var edges = LowOptimizationPasses.BlockEdges()

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable or function.blocks.is_empty() {
        return function
    }
    edges.read_the_function(function)
    if not edges.is_regular {
        return function
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        if not edges.is_reachable(block_index) and not block.instructions.is_empty() {
            block.instructions = List<LowIntermediaryRepresentation.Instructions.Instruction>()
        }
        block_index = block_index + 1
    }
    return function
}

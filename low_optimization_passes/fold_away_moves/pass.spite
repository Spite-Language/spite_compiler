var empty_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var program = LowIntermediaryRepresentation.Programs.LowProgram(empty_functions, "")
var kept_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var built = LowIntermediaryRepresentation.Instructions.InstructionBuild()
var removed_stores = 0

func Pass(starting_program: LowIntermediaryRepresentation.Programs.LowProgram) {
    program = starting_program
}

func transformed(): LowIntermediaryRepresentation.Programs.LowProgram {
    kept_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
    program.held_functions.each(read_function)
    return LowIntermediaryRepresentation.Programs.LowProgram(kept_functions, program.entry)
}

func read_function(own: LowIntermediaryRepresentation.Functions.LowFunction) {
    var given = own.instructions
    var written = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var index = 0
    while index < given.count() {
        var one = given[index]
        var rewritten = fold(one, given, index)
        written.append(rewritten)
        index = index + 1
    }
    var moved = LowIntermediaryRepresentation.Functions.LowFunction(own.name, own.slots)
    moved.class_name = own.class_name
    moved.parameter_count = own.parameter_count
    moved.instructions = written
    kept_functions.append(moved)
}

func fold(
    own: LowIntermediaryRepresentation.Instructions.Instruction,
    given: List<LowIntermediaryRepresentation.Instructions.Instruction>,
    index: Integer,
): LowIntermediaryRepresentation.Instructions.Instruction {
    if own.kind == "read" {
        return fold_load(own, given, index)
    } else {
        return own
    }
}

func fold_load(
    own: LowIntermediaryRepresentation.Instructions.Instruction,
    given: List<LowIntermediaryRepresentation.Instructions.Instruction>,
    index: Integer,
): LowIntermediaryRepresentation.Instructions.Instruction {
    if index == 0 {
        return own
    }
    var before = given[index - 1]
    crash before
    var usable = before.kind == "write" and before.first == own.first and before.second != own.second
    if usable {
        return fold_when_it_is_safe(own, before, given, index)
    } else {
        return own
    }
}

func fold_when_it_is_safe(
    own: LowIntermediaryRepresentation.Instructions.Instruction,
    before: LowIntermediaryRepresentation.Instructions.Instruction,
    given: List<LowIntermediaryRepresentation.Instructions.Instruction>,
    index: Integer,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var lands_on_the_load = is_a_jump_to(given, index)
    var lands_on_the_store = is_a_jump_to(given, index - 1)
    var inside_a_loop = is_inside_a_loop(given, index - 1)
    if lands_on_the_load or lands_on_the_store or inside_a_loop {
        return own
    } else {
        removed_stores = removed_stores + 1
        return built.copy(before.second, own.second)
    }
}

func is_a_jump_to(given: List<LowIntermediaryRepresentation.Instructions.Instruction>, wanted: Integer): Boolean {
    var index = 0
    while index < given.count() {
        var one = given[index]
        if one.is_jump() and one.to == wanted {
            return true
        }
        index = index + 1
    }
    return false
}

func is_inside_a_loop(given: List<LowIntermediaryRepresentation.Instructions.Instruction>, at: Integer): Boolean {
    var index = at + 1
    while index < given.count() {
        var one = given[index]
        if one.is_jump() and one.to <= at {
            return true
        }
        index = index + 1
    }
    return false
}

func removed_count(): Integer {
    return removed_stores
}

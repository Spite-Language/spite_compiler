# ../../OPTIMIZATIONS.md#arithmetic-whose-operands-bounds-prove-it-fits-is-not-checked
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var register_total = 0
var definitions = List<Integer>()
var known = List<Boolean>()
var lows = List<Long>()
var highs = List<Long>()
var largest_bound: Long = 4611686018427387904
var largest_factor: Long = 2147483648
var learned = false

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        definitions.append(0)
        known.append(false)
        lows.append(0)
        highs.append(0)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(count_a_definition)
        block_index = block_index + 1
    }
    var round = 0
    learned = true
    while learned and round < 6 {
        learned = false
        block_index = 0
        while block_index < function.blocks.count() {
            var block = function.blocks[block_index]
            block.instructions.each(learn_a_range)
            block_index = block_index + 1
        }
        round = round + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(uncheck_when_it_fits)
        block_index = block_index + 1
    }
    return function
}

func count_a_definition(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        var count = definitions[register]
        crash count
        definitions[register] = count + 1
        index = index + 1
    }
}

func written_once(register: Integer): Boolean {
    if register < function.parameter_count or register < 0 {
        return false
    }
    return definitions[register] == 1
}

func is_known(register: Integer): Boolean {
    if register < 0 {
        return false
    }
    return known[register] == true
}

func low_of(register: Integer): Long {
    var value = lows[register]
    crash value
    return value
}

func high_of(register: Integer): Long {
    var value = highs[register]
    crash value
    return value
}

func learn(register: Integer, low: Long, high: Long) {
    assert written_once(register) and not is_known(register)
    assert low >= 0 - largest_bound and high <= largest_bound and low <= high
    known[register] = true
    lows[register] = low
    highs[register] = high
    learned = true
}

func learn_a_range(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: learn(instruction.target, instruction.number, instruction.number)
        LowIntermediaryRepresentation.Instructions.Copy: learn_a_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: learn(instruction.target, 0, 1)
        LowIntermediaryRepresentation.Instructions.Load: learn_a_load(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: learn_an_arithmetic(instruction)
        _: return
    }
}

func learn_a_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    assert is_known(copy.source)
    var low = low_of(copy.source)
    var high = high_of(copy.source)
    learn(copy.target, low, high)
}

func learn_a_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    assert not loaded.is_swapped
    switch loaded.width {
        'bits_8': learn_a_width(loaded.target, 256, loaded.is_signed)
        'bits_16': learn_a_width(loaded.target, 65536, loaded.is_signed)
        'bits_32': learn_a_width(loaded.target, 4294967296, loaded.is_signed)
        'bits_64': return
    }
}

func learn_a_width(target: Integer, span: Long, is_signed: Boolean) {
    if is_signed {
        var half = span / 2
        learn(target, 0 - half, half - 1)
    } else {
        learn(target, 0, span - 1)
    }
}

func learn_an_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert not arithmetic.wraps and written_once(arithmetic.target) and not is_known(arithmetic.target)
    if arithmetic.operator == 'remainder' {
        learn_a_remainder(arithmetic)
        return
    }
    if arithmetic.operator == 'bits_and' {
        learn_a_mask(arithmetic)
        return
    }
    assert is_known(arithmetic.left) and is_known(arithmetic.right) and fits_its_width(arithmetic)
    var low = result_low(arithmetic)
    var high = result_high(arithmetic)
    assert low <= high
    learn(arithmetic.target, low, high)
}

func learn_a_remainder(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert is_known(arithmetic.right)
    var divisor_low = low_of(arithmetic.right)
    var divisor_high = high_of(arithmetic.right)
    assert divisor_low == divisor_high and divisor_low > 0
    var largest = divisor_low - 1
    if is_known(arithmetic.left) and low_of(arithmetic.left) >= 0 {
        learn(arithmetic.target, 0, largest)
        return
    }
    learn(arithmetic.target, 0 - largest, largest)
}

func learn_a_mask(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if is_known(arithmetic.right) and low_of(arithmetic.right) >= 0 and low_of(arithmetic.right) == high_of(arithmetic.right) {
        var mask = high_of(arithmetic.right)
        learn(arithmetic.target, 0, mask)
        return
    }
    assert is_known(arithmetic.left) and low_of(arithmetic.left) >= 0 and low_of(arithmetic.left) == high_of(arithmetic.left)
    var left_mask = high_of(arithmetic.left)
    learn(arithmetic.target, 0, left_mask)
}

func is_small(register: Integer): Boolean {
    var low = low_of(register)
    var high = high_of(register)
    return low >= 0 - largest_factor and high <= largest_factor
}

func result_low(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Long {
    var left_low = low_of(arithmetic.left)
    var left_high = high_of(arithmetic.left)
    var right_low = low_of(arithmetic.right)
    var right_high = high_of(arithmetic.right)
    switch arithmetic.operator {
        'add': return left_low + right_low
        'subtract': return left_low - right_high
        'multiply': return smallest_product(left_low, left_high, right_low, right_high)
        _: return 1
    }
}

func result_high(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Long {
    var left_low = low_of(arithmetic.left)
    var left_high = high_of(arithmetic.left)
    var right_low = low_of(arithmetic.right)
    var right_high = high_of(arithmetic.right)
    switch arithmetic.operator {
        'add': return left_high + right_high
        'subtract': return left_high - right_low
        'multiply': return largest_product(left_low, left_high, right_low, right_high)
        _: return 0
    }
}

func smallest_product(left_low: Long, left_high: Long, right_low: Long, right_high: Long): Long {
    var found = left_low * right_low
    var other = left_low * right_high
    if other < found {
        found = other
    }
    other = left_high * right_low
    if other < found {
        found = other
    }
    other = left_high * right_high
    if other < found {
        found = other
    }
    return found
}

func largest_product(left_low: Long, left_high: Long, right_low: Long, right_high: Long): Long {
    var found = left_low * right_low
    var other = left_low * right_high
    if other > found {
        found = other
    }
    other = left_high * right_low
    if other > found {
        found = other
    }
    other = left_high * right_high
    if other > found {
        found = other
    }
    return found
}

func fits_its_width(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    var operator = arithmetic.operator
    if operator != 'add' and operator != 'subtract' and operator != 'multiply' {
        return false
    }
    if not is_small(arithmetic.left) or not is_small(arithmetic.right) {
        return false
    }
    var low = result_low(arithmetic)
    var high = result_high(arithmetic)
    switch arithmetic.width {
        'bits_8': return fits_between(arithmetic.is_signed, low, high, 256)
        'bits_16': return fits_between(arithmetic.is_signed, low, high, 65536)
        'bits_32': return fits_between(arithmetic.is_signed, low, high, 4294967296)
        'bits_64': return low >= 0 - largest_bound and high <= largest_bound and (arithmetic.is_signed or low >= 0)
    }
}

func fits_between(is_signed: Boolean, low: Long, high: Long, span: Long): Boolean {
    if is_signed {
        var half = span / 2
        return low >= 0 - half and high <= half - 1
    }
    return low >= 0 and high <= span - 1
}

func uncheck_when_it_fits(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Arithmetic {
        uncheck_an_arithmetic(instruction)
    }
}

func uncheck_an_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert arithmetic.is_checked and not arithmetic.wraps
    assert is_known(arithmetic.left) and is_known(arithmetic.right) and fits_its_width(arithmetic)
    arithmetic.is_checked = false
}

var empty_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var program = LowIntermediaryRepresentation.Programs.LowProgram(empty_functions, "")
var kept_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var given = List<LowIntermediaryRepresentation.Instructions.Instruction>()
var kept = List<LowIntermediaryRepresentation.Instructions.Instruction>()
var moved_to = List<Integer>()
var removed_jumps = 0
var shortened_jumps = 0

func Pass(starting_program: LowIntermediaryRepresentation.Programs.LowProgram) {
    program = starting_program
}

func transformed(): LowIntermediaryRepresentation.Programs.LowProgram {
    kept_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
    program.held_functions.each(read_function)
    return LowIntermediaryRepresentation.Programs.LowProgram(kept_functions, program.entry)
}

func read_function(own: LowIntermediaryRepresentation.Functions.LowFunction) {
    given = own.instructions
    kept = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    moved_to = List<Integer>()
    note_where_each_lands()
    kept.each(follow)
    var written = LowIntermediaryRepresentation.Functions.LowFunction(own.name, own.slots)
    written.class_name = own.class_name
    written.parameter_count = own.parameter_count
    written.instructions = kept
    kept_functions.append(written)
}

func note_where_each_lands() {
    var index = 0
    while index < given.count() {
        var one = given[index]
        var lands_here = kept.count()
        moved_to.append(lands_here)
        var drop = jumps_to_the_next(one, index)
        if drop {
            removed_jumps = removed_jumps + 1
        } else {
            kept.append(one)
        }
        index = index + 1
    }
}

func jumps_to_the_next(own: LowIntermediaryRepresentation.Instructions.Instruction, index: Integer): Boolean {
    if own.kind == "jump" {
        return own.to == index + 1
    } else {
        return false
    }
}

func follow(own: LowIntermediaryRepresentation.Instructions.Instruction) {
    if own.is_jump() {
        retarget(own)
    } else {
        return
    }
}

func retarget(own: LowIntermediaryRepresentation.Instructions.Instruction) {
    var landing = followed(own)
    var moved = moved_to[landing]
    assert moved
    if moved != own.to {
        shortened_jumps = shortened_jumps + 1
    }
    own.to = moved
}

func followed(own: LowIntermediaryRepresentation.Instructions.Instruction): Integer {
    return walk(own.to, 0)
}

func walk(where: Integer, walked: Integer): Integer {
    if where >= given.count() {
        return where
    }
    var landing = given[where]
    var steps_on = landing.kind == "jump" and landing.to != where and walked < 64
    if steps_on {
        return walk(landing.to, walked + 1)
    } else {
        return where
    }
}

func removed_count(): Integer {
    return removed_jumps
}

func shortened_count(): Integer {
    return shortened_jumps
}

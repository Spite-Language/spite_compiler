var lowered_by_key = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var free_keys = Dictionary<Integer, String>()

func read_the_program(program: LowIntermediaryRepresentation.LoweredProgram) {
    free_keys = program.free_keys
    program.lowered_functions.each(note_a_function)
}

func note_a_function(function: LowIntermediaryRepresentation.LowFunction) {
    lowered_by_key[function.key] = function
}

func frees_plainly(class_id: Long): Boolean {
    fallback class_id >= 0 and class_id <= 1000000
    var class_number: Integer = class_id
    var free_key = free_keys[class_number]
    fallback free_key
    var freeing = lowered_by_key[free_key]
    fallback freeing
    fallback freeing.parameter_count == 1 and freeing.blocks.count() == 1
    var block = freeing.blocks[0]
    fallback block.instructions.count() == 2
    var first = block.instructions[0]
    var second = block.instructions[1]
    if first.class == LowIntermediaryRepresentation.Instructions.Free and second.class == LowIntermediaryRepresentation.Instructions.Return {
        return first.pointer == 0
    }
    return false
}

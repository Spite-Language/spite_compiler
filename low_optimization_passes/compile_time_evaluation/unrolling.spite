var function = LowIntermediaryRepresentation.LowFunction("", 0)
var leaving = List<List<Integer>>()
var entering = List<List<Integer>>()
var order = List<Integer>()
var numbers = List<Integer>()
var dominators = List<Integer>()
var headers = List<Integer>()
var bodies = List<List<Boolean>>()
var saved_blocks = List<LowIntermediaryRepresentation.LowBlock>()
var saved_edited = List<LowIntermediaryRepresentation.LowBlock>()
var saved_instructions = List<List<LowIntermediaryRepresentation.Instructions.Instruction>>()

func Unrolling(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func ends_the_block(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.Stop: return not instruction.continues
        _: return false
    }
}

func successors_of(block_index: Integer): List<Integer> {
    var found = List<Integer>()
    var block = function.blocks[block_index]
    crash block
    var index = 0
    var ended = false
    while index < block.instructions.count() and not ended {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Jump {
            found.append(instruction.block)
        }
        if instruction == LowIntermediaryRepresentation.Instructions.Branch {
            found.append(instruction.when_true)
            if instruction.when_false != instruction.when_true {
                found.append(instruction.when_false)
            }
        }
        ended = ends_the_block(instruction)
        index = index + 1
    }
    if not ended and block_index + 1 < function.blocks.count() {
        found.append(block_index + 1)
    }
    return found
}

func block_order(): List<Integer> {
    leaving = List<List<Integer>>()
    var everywhere = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        var successors = successors_of(index)
        leaving.append(successors)
        everywhere.append(true)
        index = index + 1
    }
    number_the_blocks(everywhere)
    return order
}

func find_the_loops(reached: List<Boolean>) {
    var count = function.blocks.count()
    leaving = List<List<Integer>>()
    entering = List<List<Integer>>()
    var index = 0
    while index < count {
        var successors = successors_of(index)
        leaving.append(successors)
        var nothing_yet = List<Integer>()
        entering.append(nothing_yet)
        index = index + 1
    }
    index = 0
    while index < count {
        var successors = leaving[index]
        crash successors
        var position = 0
        while position < successors.count() {
            var successor = successors[position]
            crash successor
            if successor >= 0 and successor < count {
                var into = entering[successor]
                crash into
                into.append(index)
            }
            position = position + 1
        }
        index = index + 1
    }
    number_the_blocks(reached)
    find_the_dominators()
    find_the_back_edges()
}

func number_the_blocks(reached: List<Boolean>) {
    var count = function.blocks.count()
    numbers = List<Integer>()
    var index = 0
    while index < count {
        numbers.append(-1)
        index = index + 1
    }
    var finished = List<Integer>()
    var visited = List<Boolean>()
    index = 0
    while index < count {
        visited.append(false)
        index = index + 1
    }
    var stack = List<Integer>()
    var positions = List<Integer>()
    stack.append(0)
    positions.append(0)
    visited[0] = true
    while not stack.is_empty() {
        var top = stack.count() - 1
        var block_index = stack[top]
        var position = positions[top]
        crash block_index
        crash position
        var successors = leaving[block_index]
        crash successors
        if position < successors.count() {
            positions[top] = position + 1
            var successor = successors[position]
            crash successor
            var live = successor >= 0 and successor < reached.count() and reached[successor] == true
            if live and successor < count and visited[successor] != true {
                visited[successor] = true
                stack.append(successor)
                positions.append(0)
            }
        } else {
            finished.append(block_index)
            crash stack.remove_last()
            crash positions.remove_last()
        }
    }
    order = List<Integer>()
    index = finished.count() - 1
    while index >= 0 {
        var block_index = finished[index]
        crash block_index
        numbers[block_index] = order.count()
        order.append(block_index)
        index = index - 1
    }
}

func number_of(block_index: Integer): Integer {
    var number = numbers[block_index]
    crash number
    return number
}

func dominator_of(block_index: Integer): Integer {
    var dominator = dominators[block_index]
    crash dominator
    return dominator
}

func find_the_dominators() {
    dominators = List<Integer>()
    var index = 0
    while index < function.blocks.count() {
        dominators.append(-1)
        index = index + 1
    }
    dominators[0] = 0
    var changed = true
    var rounds = 0
    while changed and rounds < 1000 {
        changed = false
        var position = 1
        while position < order.count() {
            var block_index = order[position]
            crash block_index
            var chosen = chosen_dominator(block_index)
            if chosen >= 0 and dominator_of(block_index) != chosen {
                dominators[block_index] = chosen
                changed = true
            }
            position = position + 1
        }
        rounds = rounds + 1
    }
}

func chosen_dominator(block_index: Integer): Integer {
    var into = entering[block_index]
    crash into
    var chosen = -1
    var index = 0
    while index < into.count() {
        var predecessor = into[index]
        crash predecessor
        if number_of(predecessor) >= 0 and dominator_of(predecessor) >= 0 {
            if chosen < 0 {
                chosen = predecessor
            } else {
                chosen = meeting(predecessor, chosen)
            }
        }
        index = index + 1
    }
    return chosen
}

func meeting(first: Integer, second: Integer): Integer {
    var left = first
    var right = second
    var steps = 0
    while left != right and steps < 100000 {
        while number_of(left) > number_of(right) {
            left = dominator_of(left)
        }
        while number_of(right) > number_of(left) {
            right = dominator_of(right)
        }
        steps = steps + 1
    }
    return left
}

func dominates(dominator: Integer, block_index: Integer): Boolean {
    var walking = block_index
    var steps = 0
    while steps < 100000 {
        if walking == dominator {
            return true
        }
        if walking == 0 or walking < 0 {
            return false
        }
        walking = dominator_of(walking)
        steps = steps + 1
    }
    return false
}

func find_the_back_edges() {
    headers = List<Integer>()
    bodies = List<List<Boolean>>()
    var position = 0
    while position < order.count() {
        var block_index = order[position]
        crash block_index
        var successors = leaving[block_index]
        crash successors
        var index = 0
        while index < successors.count() {
            var successor = successors[index]
            crash successor
            if successor >= 0 and number_of(successor) >= 0 and dominates(successor, block_index) {
                add_the_loop(successor, block_index)
            }
            index = index + 1
        }
        position = position + 1
    }
}

func add_the_loop(header: Integer, latch: Integer) {
    var place = headers.index_of(header)
    var body = List<Boolean>()
    if place {
        var known = bodies[place]
        crash known
        body = known
    } else {
        var index = 0
        while index < function.blocks.count() {
            body.append(false)
            index = index + 1
        }
        body[header] = true
        headers.append(header)
        bodies.append(body)
    }
    var waiting = List<Integer>()
    if body[latch] != true {
        body[latch] = true
        waiting.append(latch)
    }
    while not waiting.is_empty() {
        var next = waiting.remove_last()
        crash next
        var into = entering[next]
        crash into
        var index = 0
        while index < into.count() {
            var predecessor = into[index]
            crash predecessor
            if number_of(predecessor) >= 0 and body[predecessor] != true {
                body[predecessor] = true
                waiting.append(predecessor)
            }
            index = index + 1
        }
    }
}

func loop_count(): Integer {
    return headers.count()
}

func header_of(loop: Integer): Integer {
    var header = headers[loop]
    crash header
    return header
}

func body_of(loop: Integer): List<Boolean> {
    var body = bodies[loop]
    crash body
    return body
}

func is_innermost(loop: Integer): Boolean {
    var body = body_of(loop)
    var header = header_of(loop)
    var index = 0
    while index < headers.count() {
        var other = headers[index]
        crash other
        if other != header and body[other] == true {
            return false
        }
        index = index + 1
    }
    return true
}

func ordered_body(loop: Integer): List<Integer> {
    var body = body_of(loop)
    var listed = List<Integer>()
    var position = 0
    while position < order.count() {
        var block_index = order[position]
        crash block_index
        if body[block_index] == true {
            listed.append(block_index)
        }
        position = position + 1
    }
    return listed
}

func outside_predecessors(loop: Integer): List<Integer> {
    var body = body_of(loop)
    var header = header_of(loop)
    var into = entering[header]
    crash into
    var outside = List<Integer>()
    var index = 0
    while index < into.count() {
        var predecessor = into[index]
        crash predecessor
        if body[predecessor] != true and number_of(predecessor) >= 0 and not outside.contains(predecessor) {
            outside.append(predecessor)
        }
        index = index + 1
    }
    return outside
}

func places_of(listed: List<Integer>): List<Integer> {
    var places = List<Integer>()
    var index = 0
    while index < function.blocks.count() {
        places.append(-1)
        index = index + 1
    }
    index = 0
    while index < listed.count() {
        var block_index = listed[index]
        crash block_index
        places[block_index] = index
        index = index + 1
    }
    return places
}

func size_of(listed: List<Integer>): Integer {
    var size = 0
    var index = 0
    while index < listed.count() {
        var block_index = listed[index]
        crash block_index
        var block = function.blocks[block_index]
        crash block
        size = size + block.instructions.count()
        index = index + 1
    }
    return size
}

func is_clonable(listed: List<Integer>): Boolean {
    var index = 0
    while index < listed.count() {
        var block_index = listed[index]
        crash block_index
        var block = function.blocks[block_index]
        crash block
        if not block.instructions.all(is_clonable_instruction) {
            return false
        }
        var last = block.instructions.last()
        var ends = false
        if last {
            ends = ends_the_block(last)
        }
        if not ends and block_index + 1 >= function.blocks.count() {
            return false
        }
        index = index + 1
    }
    return true
}

func is_clonable_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Store: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.Call: return true
        LowIntermediaryRepresentation.Instructions.CallAt: return true
        LowIntermediaryRepresentation.Instructions.ImportCall: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return true
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return true
        LowIntermediaryRepresentation.Instructions.Allocate: return true
        LowIntermediaryRepresentation.Instructions.Retain: return true
        LowIntermediaryRepresentation.Instructions.Free: return true
        LowIntermediaryRepresentation.Instructions.Resize: return true
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Return: return not instruction.is_a_suspension
        LowIntermediaryRepresentation.Instructions.Stop: return true
        _: return false
    }
}

func unroll(loop: Integer, copies: Integer) {
    var header = header_of(loop)
    var body = body_of(loop)
    var listed = ordered_body(loop)
    var places = places_of(listed)
    var outside = outside_predecessors(loop)
    saved_blocks = function.blocks.copy()
    saved_edited = List<LowIntermediaryRepresentation.LowBlock>()
    saved_instructions = List<List<LowIntermediaryRepresentation.Instructions.Instruction>>()
    var start = function.blocks.count()
    var size = listed.count()
    var mapping = Mapping(header, body, places, start, size, copies)
    var index = 0
    var copy = 0
    while copy < copies {
        mapping.copy = copy
        index = 0
        while index < listed.count() {
            var block_index = listed[index]
            crash block_index
            var made = cloned_block(block_index, mapping)
            function.blocks.append(made)
            index = index + 1
        }
        copy = copy + 1
    }
    var first = start
    index = 0
    while index < outside.count() {
        var predecessor = outside[index]
        crash predecessor
        enter_the_copies(predecessor, header, first)
        index = index + 1
    }
}

func undo() {
    function.blocks = saved_blocks
    var index = 0
    while index < saved_edited.count() {
        var block = saved_edited[index]
        var instructions = saved_instructions[index]
        crash instructions
        block.instructions = instructions
        index = index + 1
    }
}

func enter_the_copies(predecessor: Integer, header: Integer, first: Integer) {
    var block = function.blocks[predecessor]
    crash block
    saved_edited.append(block)
    saved_instructions.append(block.instructions)
    var rewritten = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var ended = false
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if ended {
            rewritten.append(instruction)
        } else {
            var entered = entered_instruction(instruction, header, first)
            rewritten.append(entered)
            ended = ends_the_block(instruction)
        }
        index = index + 1
    }
    if not ended and predecessor + 1 == header {
        var onward = LowIntermediaryRepresentation.Instructions.Jump(first)
        rewritten.append(onward)
    }
    block.instructions = rewritten
}

func entered_instruction(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    header: Integer,
    first: Integer,
): LowIntermediaryRepresentation.Instructions.Instruction {
    if instruction == LowIntermediaryRepresentation.Instructions.Jump {
        if instruction.block == header {
            return LowIntermediaryRepresentation.Instructions.Jump(first)
        }
        return instruction
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Branch {
        var when_true = instruction.when_true
        var when_false = instruction.when_false
        if when_true == header {
            when_true = first
        }
        if when_false == header {
            when_false = first
        }
        return LowIntermediaryRepresentation.Instructions.Branch(instruction.condition, when_true, when_false)
    }
    return instruction
}

func cloned_block(block_index: Integer, mapping: Mapping): LowIntermediaryRepresentation.LowBlock {
    var source = function.blocks[block_index]
    crash source
    var made = LowIntermediaryRepresentation.LowBlock()
    made.place = source.place
    var ended = false
    var index = 0
    while index < source.instructions.count() and not ended {
        var instruction = source.instructions[index]
        var copied = cloned(instruction, mapping)
        made.instructions.append(copied)
        ended = ends_the_block(instruction)
        index = index + 1
    }
    if not ended and block_index + 1 < mapping.start {
        var next = block_index + 1
        var target = mapping.mapped(next)
        var onward = LowIntermediaryRepresentation.Instructions.Jump(target)
        made.instructions.append(onward)
    }
    return made
}

func cloned(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    mapping: Mapping,
): LowIntermediaryRepresentation.Instructions.Instruction {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return cloned_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return cloned_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: return cloned_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: return cloned_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return cloned_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return cloned_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return cloned_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Load: return cloned_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: return cloned_store(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: return cloned_copy_bytes(instruction)
        LowIntermediaryRepresentation.Instructions.Call: return cloned_call(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: return cloned_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: return cloned_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: return cloned_data_address(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return cloned_function_address(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: return cloned_allocate(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: return cloned_retain(instruction)
        LowIntermediaryRepresentation.Instructions.Free: return cloned_free(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: return cloned_resize(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: return cloned_jump(instruction, mapping)
        LowIntermediaryRepresentation.Instructions.Branch: return cloned_branch(instruction, mapping)
        LowIntermediaryRepresentation.Instructions.Return: return cloned_return(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: return cloned_stop(instruction)
        _: return instruction
    }
}

func cloned_constant(
    made: LowIntermediaryRepresentation.Instructions.Constant,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.Constant(made.target, made.number)
}

func cloned_copy(copy: LowIntermediaryRepresentation.Instructions.Copy): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.Copy(copy.target, copy.source)
}

func cloned_arithmetic(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Arithmetic(
        arithmetic.target,
        arithmetic.operator,
        arithmetic.left,
        arithmetic.right,
    )
    copied.width = arithmetic.width
    copied.is_signed = arithmetic.is_signed
    copied.is_checked = arithmetic.is_checked
    copied.wraps = arithmetic.wraps
    copied.line = arithmetic.line
    copied.shown = arithmetic.shown
    copied.type_name = arithmetic.type_name
    copied.path = arithmetic.path
    copied.owner = arithmetic.owner
    return copied
}

func cloned_compare(
    compare: LowIntermediaryRepresentation.Instructions.Compare,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Compare(
        compare.target,
        compare.comparison,
        compare.left,
        compare.right,
    )
    copied.is_signed = compare.is_signed
    return copied
}

func cloned_decimal_arithmetic(
    arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(
        arithmetic.target,
        arithmetic.operator,
        arithmetic.left,
        arithmetic.right,
    )
    copied.is_double = arithmetic.is_double
    return copied
}

func cloned_decimal_compare(
    compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Compare(
        compare.target,
        compare.comparison,
        compare.left,
        compare.right,
    )
    copied.is_double = compare.is_double
    return copied
}

func cloned_conversion(
    conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Conversion(conversion.target, conversion.source)
    copied.from_decimal_size = conversion.from_decimal_size
    copied.to_decimal_size = conversion.to_decimal_size
    copied.whole_is_signed = conversion.whole_is_signed
    copied.whole_width = conversion.whole_width
    return copied
}

func cloned_load(loaded: LowIntermediaryRepresentation.Instructions.Load): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Load(loaded.target, loaded.address, loaded.offset, loaded.width)
    copied.is_signed = loaded.is_signed
    copied.is_swapped = loaded.is_swapped
    copied.is_invariant = loaded.is_invariant
    copied.cannot_fault = loaded.cannot_fault
    copied.region = loaded.region
    return copied
}

func cloned_store(stored: LowIntermediaryRepresentation.Instructions.Store): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Store(stored.address, stored.offset, stored.source, stored.width)
    copied.is_swapped = stored.is_swapped
    copied.region = stored.region
    return copied
}

func cloned_copy_bytes(
    copying: LowIntermediaryRepresentation.Instructions.CopyBytes,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.CopyBytes(copying.destination, copying.source, copying.count)
}

func cloned_call(called: LowIntermediaryRepresentation.Instructions.Call): LowIntermediaryRepresentation.Instructions.Instruction {
    var arguments = called.arguments.copy()
    var copied = LowIntermediaryRepresentation.Instructions.Call(called.target, called.function, arguments)
    copied.presence = called.presence
    copied.line = called.line
    copied.frames = called.frames.copy()
    copied.is_guarded = called.is_guarded
    copied.counts_plainly = called.counts_plainly
    return copied
}

func cloned_call_at(
    called: LowIntermediaryRepresentation.Instructions.CallAt,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var arguments = called.arguments.copy()
    var copied = LowIntermediaryRepresentation.Instructions.CallAt(called.target, called.address, arguments)
    copied.answers_32_bits = called.answers_32_bits
    copied.presence = called.presence
    copied.decimal_sizes = called.decimal_sizes.copy()
    copied.answer_decimal_size = called.answer_decimal_size
    copied.line = called.line
    copied.frames = called.frames.copy()
    return copied
}

func cloned_import_call(
    calling: LowIntermediaryRepresentation.Instructions.ImportCall,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var arguments = calling.arguments.copy()
    var copied = LowIntermediaryRepresentation.Instructions.ImportCall(calling.target, calling.name, arguments)
    copied.library = calling.library
    copied.decimal_sizes = calling.decimal_sizes.copy()
    copied.answer_decimal_size = calling.answer_decimal_size
    return copied
}

func cloned_data_address(
    address: LowIntermediaryRepresentation.Instructions.DataAddress,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.DataAddress(address.target, address.label)
}

func cloned_function_address(
    address: LowIntermediaryRepresentation.Instructions.FunctionAddress,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.FunctionAddress(address.target, address.function)
}

func cloned_allocate(
    made: LowIntermediaryRepresentation.Instructions.Allocate,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.Allocate(made.target, made.size)
}

func cloned_retain(held: LowIntermediaryRepresentation.Instructions.Retain): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Retain(held.object)
    copied.is_atomic = held.is_atomic
    return copied
}

func cloned_free(freeing: LowIntermediaryRepresentation.Instructions.Free): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.Free(freeing.pointer)
}

func cloned_resize(
    resizing: LowIntermediaryRepresentation.Instructions.Resize,
): LowIntermediaryRepresentation.Instructions.Instruction {
    return LowIntermediaryRepresentation.Instructions.Resize(resizing.target, resizing.pointer, resizing.size)
}

func cloned_jump(
    jumped: LowIntermediaryRepresentation.Instructions.Jump,
    mapping: Mapping,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var target = mapping.mapped(jumped.block)
    return LowIntermediaryRepresentation.Instructions.Jump(target)
}

func cloned_branch(
    test: LowIntermediaryRepresentation.Instructions.Branch,
    mapping: Mapping,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var when_true = mapping.mapped(test.when_true)
    var when_false = mapping.mapped(test.when_false)
    return LowIntermediaryRepresentation.Instructions.Branch(test.condition, when_true, when_false)
}

func cloned_return(
    returned: LowIntermediaryRepresentation.Instructions.Return,
): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Return(returned.source)
    copied.presence = returned.presence
    copied.is_a_suspension = returned.is_a_suspension
    return copied
}

func cloned_stop(stop: LowIntermediaryRepresentation.Instructions.Stop): LowIntermediaryRepresentation.Instructions.Instruction {
    var copied = LowIntermediaryRepresentation.Instructions.Stop(stop.label)
    copied.labels = stop.labels.copy()
    copied.numbers = stop.numbers.copy()
    copied.signed_numbers = stop.signed_numbers.copy()
    copied.continues = stop.continues
    return copied
}

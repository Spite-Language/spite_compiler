var values = List<Long>()
var tags = List<Integer>()
var known = List<Boolean>()
var block = 0
var position = 0

func Frame(register_total: Integer) {
    var index = 0
    while index < register_total {
        values.append(0)
        tags.append(-1)
        known.append(false)
        index = index + 1
    }
}

func holds(register: Integer): Boolean {
    if register < 0 or register >= known.count() {
        return false
    }
    return known[register] == true
}

func value_of(register: Integer): Long {
    var value = values[register]
    crash value
    return value
}

func tag_of(register: Integer): Integer {
    var tag = tags[register]
    crash tag
    return tag
}

func set(register: Integer, value: Long, tag: Integer) {
    assert register >= 0
    crash register < values.count()
    values[register] = value
    tags[register] = tag
    known[register] = true
}

func forget(register: Integer) {
    assert register >= 0 and register < known.count()
    known[register] = false
    tags[register] = -1
}

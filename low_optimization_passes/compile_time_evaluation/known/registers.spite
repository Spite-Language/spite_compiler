var slots = List<Integer>()
var kinds = List<Integer>()
var values = List<Long>()
var tags = List<Integer>()
var changed = List<Integer>()
var local_count = 0
var merged_kind = 0
var merged_value: Long = 0
var merged_tag = -1

func Registers(register_total: Integer) {
    var index = 0
    while index < register_total {
        slots.append(-1)
        kinds.append(0)
        values.append(0)
        tags.append(-1)
        index = index + 1
    }
}

func copied(): Registers {
    var made = Registers(0)
    made.slots = slots.copy()
    made.kinds = kinds.copy()
    made.values = values.copy()
    made.tags = tags.copy()
    made.local_count = local_count
    return made
}

func make_local(register: Integer) {
    assert register >= 0 and register < slots.count()
    slots[register] = local_count
    local_count = local_count + 1
}

func make_all_local() {
    var register = 0
    while register < slots.count() {
        make_local(register)
        register = register + 1
    }
}

func slot_of(register: Integer): Integer {
    if register < 0 or register >= slots.count() {
        return -2
    }
    var slot = slots[register]
    crash slot
    return slot
}

func global_kind(register: Integer): Integer {
    var kind = kinds[register]
    crash kind
    return kind
}

func global_value(register: Integer): Long {
    var value = values[register]
    crash value
    return value
}

func global_tag(register: Integer): Integer {
    var tag = tags[register]
    crash tag
    return tag
}

func put_global(register: Integer, kind: Integer, value: Long, tag: Integer) {
    var old_kind = global_kind(register)
    var old_value = global_value(register)
    var old_tag = global_tag(register)
    merge(old_kind, old_value, old_tag, kind, value, tag)
    var same = merged_kind == old_kind and merged_value == old_value and merged_tag == old_tag
    assert not same
    kinds[register] = merged_kind
    values[register] = merged_value
    tags[register] = merged_tag
    changed.append(register)
}

func base_of_value(kind: Integer, tag: Integer): Integer {
    if kind == 4 or kind == 1 and tag >= 0 {
        return tag
    }
    return -1
}

func take(kind: Integer, value: Long, tag: Integer) {
    merged_kind = kind
    merged_value = value
    merged_tag = tag
}

func merge(first_kind: Integer, first_value: Long, first_tag: Integer, kind: Integer, value: Long, tag: Integer) {
    if kind == 0 {
        take(first_kind, first_value, first_tag)
        return
    }
    if first_kind == 0 {
        take(kind, value, tag)
        return
    }
    if first_kind == 3 or kind == 3 {
        take(3, 0, -1)
        return
    }
    if first_kind == kind and first_value == value and first_tag == tag {
        take(first_kind, first_value, first_tag)
        return
    }
    var first_base = base_of_value(first_kind, first_tag)
    var base = base_of_value(kind, tag)
    if first_base >= 0 and base >= 0 and first_base != base {
        take(3, 0, -1)
        return
    }
    if first_base >= 0 {
        base = first_base
    }
    if base >= 0 {
        take(4, 0, base)
        return
    }
    take(2, 0, -1)
}

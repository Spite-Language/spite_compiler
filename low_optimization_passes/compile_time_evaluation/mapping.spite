var header = 0
var body = List<Boolean>()
var places = List<Integer>()
var start = 0
var size = 0
var copies = 0
var copy = 0

func Mapping(
    starting_header: Integer,
    starting_body: List<Boolean>,
    starting_places: List<Integer>,
    starting_start: Integer,
    starting_size: Integer,
    starting_copies: Integer,
) {
    header = starting_header
    body = starting_body
    places = starting_places
    start = starting_start
    size = starting_size
    copies = starting_copies
}

func place_of(block_index: Integer): Integer {
    var place = places[block_index]
    crash place
    return place
}

func mapped(target: Integer): Integer {
    if target == header {
        if copy + 1 < copies {
            return start + (copy + 1) * size + place_of(header)
        }
        return header
    }
    if target >= 0 and target < body.count() and body[target] == true {
        return start + copy * size + place_of(target)
    }
    return target
}

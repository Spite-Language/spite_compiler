func optimized(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        if low.is_selected(function.key) {
            var pass = Pass(function, low.uses_threads, low.collects_cycles)
            var transformed = pass.transformed()
            if low.collects_cycles {
                var drop_points = DropPoints(transformed, low.cycle_record, low.uses_threads)
                transformed = drop_points.expanded()
            }
            low.lowered_functions[index] = transformed
        }
        index = index + 1
    }
}

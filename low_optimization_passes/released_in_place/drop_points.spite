# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it

var _others = 256
var _left = 208
var _drop_point = "_cycle_drop_point"
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var next_register = 0
var record = -1
var among_threads: Boolean

func DropPoints(
    starting_function: LowIntermediaryRepresentation.LowFunction,
    starting_record: Integer,
    starting_among_threads: Boolean,
) {
    function = starting_function
    record = starting_record
    among_threads = starting_among_threads
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func expanded(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable or record < 0 {
        return function
    }
    next_register = operands.most_register_of(function)
    if function.register_count > next_register {
        next_register = function.register_count
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        split_at_a_drop_point(block_index)
        block_index = block_index + 1
    }
    function.register_count = next_register
    return function
}

func split_at_a_drop_point(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var at = first_drop_point(block)
    fallback at >= 0
    var head = List<SpiteCompiler.Instruction>()
    var tail = List<SpiteCompiler.Instruction>()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if index < at {
            head.append(instruction)
        }
        if index > at {
            tail.append(instruction)
        }
        index = index + 1
    }
    var counting = new_block(block.place)
    var due = new_block(block.place)
    var after = new_block(block.place)
    var base = new_register()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(base, record)
    head.append(addressed)
    var zero = new_register()
    var made_zero = LowIntermediaryRepresentation.Instructions.Constant(zero, 0)
    head.append(made_zero)
    if among_threads {
        var others = new_register()
        var loaded_others = LowIntermediaryRepresentation.Instructions.Load(
            others,
            base,
            _others,
            'bits_64',
            true,
            "",
            false,
        )
        head.append(loaded_others)
        var alone = new_register()
        var compared_others = LowIntermediaryRepresentation.Instructions.Compare(alone, 'equal', others, zero, true)
        head.append(compared_others)
        var alone_test = LowIntermediaryRepresentation.Instructions.Branch(alone, counting, after)
        head.append(alone_test)
    } else {
        var onward = LowIntermediaryRepresentation.Instructions.Jump(counting)
        head.append(onward)
    }
    block.instructions = head
    count_down(base, zero, counting, due, after)
    var due_block = function.blocks[due]
    crash due_block
    var no_arguments = List<Integer>()
    var collected = LowIntermediaryRepresentation.Instructions.Call(-1, "_cycle_when_due", no_arguments, -1, false)
    due_block.instructions.append(collected)
    var back = LowIntermediaryRepresentation.Instructions.Jump(after)
    due_block.instructions.append(back)
    var after_block = function.blocks[after]
    crash after_block
    after_block.instructions = tail
}

func count_down(base: Integer, zero: Integer, counting: Integer, due: Integer, after: Integer) {
    var counting_block = function.blocks[counting]
    crash counting_block
    var left = new_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(left, base, _left, 'bits_64', true, "", false)
    counting_block.instructions.append(loaded)
    var one = new_register()
    var made_one = LowIntermediaryRepresentation.Instructions.Constant(one, 1)
    counting_block.instructions.append(made_one)
    var fewer = new_register()
    var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(
        fewer,
        'subtract',
        left,
        one,
        'bits_64',
        true,
        false,
    )
    counting_block.instructions.append(subtracted)
    var stored = LowIntermediaryRepresentation.Instructions.Store(base, _left, fewer, 'bits_64', "", false)
    counting_block.instructions.append(stored)
    var waiting = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(waiting, 'greater', fewer, zero, true)
    counting_block.instructions.append(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(waiting, after, due)
    counting_block.instructions.append(test)
}

func first_drop_point(block: LowIntermediaryRepresentation.LowBlock): Integer {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.Call and instruction.function == _drop_point {
            return index
        }
        index = index + 1
    }
    return -1
}

func new_block(place: String): Integer {
    var block = LowIntermediaryRepresentation.LowBlock()
    block.place = place
    function.blocks.append(block)
    return function.blocks.count() - 1
}

func new_register(): Integer {
    var register = next_register
    next_register = next_register + 1
    return register
}

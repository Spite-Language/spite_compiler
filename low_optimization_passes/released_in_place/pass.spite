var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var next_register = 0
var frees_no_suspect = false
var uses_threads: Boolean
var collects_cycles: Boolean

func Pass(
    starting_function: LowIntermediaryRepresentation.LowFunction,
    starting_uses_threads: Boolean,
    starting_collects_cycles: Boolean,
) {
    function = starting_function
    uses_threads = starting_uses_threads
    collects_cycles = starting_collects_cycles
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable or function.key == "_release" {
        return function
    }
    next_register = operands.most_register_of(function)
    if function.register_count > next_register {
        next_register = function.register_count
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        split_at_a_release(block_index)
        block_index = block_index + 1
    }
    function.register_count = next_register
    return function
}

func split_at_a_release(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var at = first_release(block)
    fallback at >= 0
    var call = block.instructions[at]
    crash call
    var object = released_object(call)
    var atomic = uses_threads
    if call.class == LowIntermediaryRepresentation.Instructions.Call and call.counts_plainly {
        atomic = false
    }
    frees_no_suspect = call.class == LowIntermediaryRepresentation.Instructions.Call and call.frees_no_suspect
    var head = List<SpiteCompiler.Instruction>()
    var tail = List<SpiteCompiler.Instruction>()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if index < at {
            head.append(instruction)
        }
        if index > at {
            tail.append(instruction)
        }
        index = index + 1
    }
    var counting = new_block(block.place)
    var freeing = new_block(block.place)
    var after = new_block(block.place)
    var zero = new_register()
    var made_zero = LowIntermediaryRepresentation.Instructions.Constant(zero, 0)
    head.append(made_zero)
    var missing = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero, true)
    head.append(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, after, counting)
    head.append(test)
    block.instructions = head
    count_down(object, zero, counting, freeing, after, atomic)
    var passed = List<Integer>()
    passed.append(object)
    var freed = LowIntermediaryRepresentation.Instructions.Call(-1, "_free_by_class", passed, -1, false)
    var freeing_block = function.blocks[freeing]
    crash freeing_block
    freeing_block.instructions.append(freed)
    var onward = LowIntermediaryRepresentation.Instructions.Jump(after)
    freeing_block.instructions.append(onward)
    var after_block = function.blocks[after]
    crash after_block
    after_block.instructions = tail
}

# ../../OPTIMIZATIONS.md#plain-counts-where-no-other-thread-counts-a-class
func count_down(object: Integer, zero: Integer, counting: Integer, freeing: Integer, after: Integer, atomic: Boolean) {
    var counting_block = function.blocks[counting]
    crash counting_block
    var left = new_register()
    if atomic {
        var decremented = LowIntermediaryRepresentation.Instructions.AtomicAdd(left, object, 8, -1)
        decremented.is_a_count = true
        counting_block.instructions.append(decremented)
    } else {
        var count = new_register()
        var loaded = LowIntermediaryRepresentation.Instructions.Load(count, object, 8, 'bits_64', true, "", false)
        counting_block.instructions.append(loaded)
        var one = new_register()
        var made_one = LowIntermediaryRepresentation.Instructions.Constant(one, 1)
        counting_block.instructions.append(made_one)
        var subtracted = LowIntermediaryRepresentation.Instructions.Arithmetic(
            left,
            'subtract',
            count,
            one,
            'bits_64',
            true,
            false,
        )
        counting_block.instructions.append(subtracted)
        var stored = LowIntermediaryRepresentation.Instructions.Store(object, 8, left, 'bits_64', "", false)
        counting_block.instructions.append(stored)
    }
    var gone = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(gone, 'equal', left, zero, true)
    counting_block.instructions.append(compared)
    var held = after
    if collects_cycles and not frees_no_suspect {
        held = new_block(counting_block.place)
        check_a_suspect(held, object, left, zero, freeing, after)
    }
    var test = LowIntermediaryRepresentation.Instructions.Branch(gone, freeing, held)
    counting_block.instructions.append(test)
}

# ../../OPTIMIZATIONS.md#a-cycle-is-freed-by-a-count-that-knows-it
func check_a_suspect(held: Integer, object: Integer, left: Integer, zero: Integer, freeing: Integer, after: Integer) {
    var held_block = function.blocks[held]
    crash held_block
    var negative = new_register()
    var compared = LowIntermediaryRepresentation.Instructions.Compare(negative, 'less', left, zero, true)
    held_block.instructions.append(compared)
    var letting = new_block(held_block.place)
    var test = LowIntermediaryRepresentation.Instructions.Branch(negative, letting, after)
    held_block.instructions.append(test)
    var letting_block = function.blocks[letting]
    crash letting_block
    var answer = new_register()
    var arguments = List<Integer>()
    arguments.append(object)
    arguments.append(left)
    var let_go = LowIntermediaryRepresentation.Instructions.Call(answer, "_cycle_let_go", arguments, -1, false)
    letting_block.instructions.append(let_go)
    var gone = new_register()
    var compared_answer = LowIntermediaryRepresentation.Instructions.Compare(gone, 'not_equal', answer, zero, true)
    letting_block.instructions.append(compared_answer)
    var gone_test = LowIntermediaryRepresentation.Instructions.Branch(gone, freeing, after)
    letting_block.instructions.append(gone_test)
}

func first_release(block: LowIntermediaryRepresentation.LowBlock): Integer {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if released_object(instruction) >= 0 {
            return index
        }
        index = index + 1
    }
    return -1
}

func released_object(instruction: SpiteCompiler.Instruction): Integer {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        var releases = instruction.function == "_release" and instruction.target < 0 and instruction.presence < 0
        if releases and instruction.arguments.count() == 1 {
            return instruction.arguments[0]
        }
    }
    return -1
}

func new_block(place: String): Integer {
    var block = LowIntermediaryRepresentation.LowBlock()
    block.place = place
    function.blocks.append(block)
    return function.blocks.count() - 1
}

func new_register(): Integer {
    var register = next_register
    next_register = next_register + 1
    return register
}

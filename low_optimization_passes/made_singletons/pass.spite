union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

# ../../OPTIMIZATIONS.md#a-singleton-the-entry-class-makes-is-never-tested-again
var program = LowIntermediaryRepresentation.LoweredProgram()
var tests = LowOptimizationPasses.SingletonTests()
var operands = LowOptimizationPasses.Operands()
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var definitions = List<Integer>()
var slots = List<Boolean>()
var pointers = List<Boolean>()
var steady_pointers = List<Boolean>()

func Pass(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
}

func transformed() {
    var index = 0
    while index < program.lowered_functions.count() {
        var found = program.lowered_functions[index]
        program.lowered_functions[index] = settled(found)
        index = index + 1
    }
}

func settled(given: LowIntermediaryRepresentation.LowFunction): LowIntermediaryRepresentation.LowFunction {
    function = given
    if program.made_at_start.is_empty() or function.is_resumable {
        return function
    }
    if program.runs_before_the_entry.contains(function.key) {
        return function
    }
    function.blocks.each(skip_a_first_use_test)
    mark_the_steady_loads()
    return function
}

func skip_a_first_use_test(block: LowIntermediaryRepresentation.LowBlock) {
    var label = tests.tested_label(function, block)
    fallback label >= 0 and program.made_at_start.contains(label)
    var last = block.instructions.last()
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        skip_the_branch(block, last)
    }
}

func skip_the_branch(block: LowIntermediaryRepresentation.LowBlock, last: LowIntermediaryRepresentation.Instructions.Branch) {
    var after = last.when_false
    var making = function.blocks[last.when_true]
    crash making
    var skipped = List<Instruction>()
    var gone_on = LowIntermediaryRepresentation.Instructions.Jump(after)
    skipped.append(gone_on)
    making.instructions = skipped
    var count = block.instructions.count()
    var straight = LowIntermediaryRepresentation.Instructions.Jump(after)
    block.instructions[count - 1] = straight
}

func mark_the_steady_loads() {
    count_the_definitions()
    var round = 0
    var changed = true
    while changed and round < 4 {
        changed = false
        var block_index = 0
        while block_index < function.blocks.count() {
            var block = function.blocks[block_index]
            var index = 0
            while index < block.instructions.count() {
                var instruction = block.instructions[index]
                if marked(instruction) {
                    changed = true
                }
                index = index + 1
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
}

func count_the_definitions() {
    definitions.clear()
    slots.clear()
    pointers.clear()
    steady_pointers.clear()
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        slots.append(false)
        pointers.append(false)
        steady_pointers.append(false)
        index = index + 1
    }
    function.blocks.each(count_in_a_block)
}

func count_in_a_block(block: LowIntermediaryRepresentation.LowBlock) {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        operands.read(instruction)
        operands.defines.each(count_a_definition)
        index = index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func is_written_once(register: Integer): Boolean {
    fallback register >= function.parameter_count and register < definitions.count()
    return definitions[register] == 1
}

func marked(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.DataAddress: return marked_a_slot(instruction)
        LowIntermediaryRepresentation.Instructions.Load: return marked_a_load(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return marked_a_copy(instruction)
        _: return false
    }
}

func marked_a_slot(addressed: LowIntermediaryRepresentation.Instructions.DataAddress): Boolean {
    fallback slots[addressed.target] != true and is_written_once(addressed.target)
    fallback program.made_at_start.contains(addressed.label)
    slots[addressed.target] = true
    if program.steady_singletons.contains(addressed.label) {
        steady_pointers[addressed.target] = true
    }
    return true
}

func marked_a_load(loaded: LowIntermediaryRepresentation.Instructions.Load): Boolean {
    fallback loaded.address >= 0 and loaded.address < slots.count()
    var from_a_slot = slots[loaded.address] == true and loaded.offset == 0 and loaded.width == 'bits_64'
    if from_a_slot {
        loaded.is_invariant = true
        return marked_a_pointer(loaded)
    }
    var through_a_steady = pointers[loaded.address] == true and steady_pointers[loaded.address] == true
    if through_a_steady and loaded.offset >= 16 and not loaded.is_invariant {
        loaded.is_invariant = true
        return true
    }
    var through_a_made = pointers[loaded.address] == true
    if through_a_made and not loaded.is_invariant and program.steady_singleton_attributes.contains(loaded.region) {
        loaded.is_invariant = true
        return true
    }
    return false
}

func marked_a_pointer(loaded: LowIntermediaryRepresentation.Instructions.Load): Boolean {
    fallback pointers[loaded.target] != true and is_written_once(loaded.target)
    pointers[loaded.target] = true
    if steady_pointers[loaded.address] == true {
        steady_pointers[loaded.target] = true
    }
    return true
}

func marked_a_copy(copied: LowIntermediaryRepresentation.Instructions.Copy): Boolean {
    var source = copied.source
    var target = copied.target
    fallback source >= 0 and source < pointers.count() and pointers[source] == true
    fallback pointers[target] != true and is_written_once(target)
    pointers[target] = true
    if steady_pointers[source] == true {
        steady_pointers[target] = true
    }
    return true
}

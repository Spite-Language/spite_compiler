var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var uses_threads = false
var register_total = 0
var next_value = 0
var values = List<Integer>()
var open_places = List<Integer>()
var open_values = List<Integer>()
var removed = List<Boolean>()

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction, starting_uses_threads: Boolean) {
    function = starting_function
    uses_threads = starting_uses_threads
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable or uses_threads {
        return function
    }
    register_total = operands.most_register_of(function)
    function.blocks.each(balance_the_block)
    return function
}

func balance_the_block(block: LowIntermediaryRepresentation.LowBlock) {
    values = List<Integer>()
    var register = 0
    while register < register_total {
        values.append(register)
        register = register + 1
    }
    next_value = register_total
    open_places = List<Integer>()
    open_values = List<Integer>()
    removed = List<Boolean>()
    var any_removed = false
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        removed.append(false)
        follow(instruction, index)
        index = index + 1
    }
    var kept = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if removed[index] == true {
            any_removed = true
        } else {
            kept.append(instruction)
        }
        index = index + 1
    }
    if any_removed {
        block.instructions = kept
    }
}

func follow(instruction: LowIntermediaryRepresentation.Instructions.Instruction, index: Integer) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Retain: open_a_count(instruction, index)
        LowIntermediaryRepresentation.Instructions.Call: give_back(instruction, index)
        LowIntermediaryRepresentation.Instructions.Copy: copy_the_value(instruction)
        LowIntermediaryRepresentation.Instructions.Constant: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.Load: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.Store: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalArithmetic: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalCompare: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalConversion: renew_the_defined(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.Branch: return
        _: close_every_count(instruction)
    }
}

func open_a_count(retain: LowIntermediaryRepresentation.Instructions.Retain, index: Integer) {
    var value = value_of(retain.object)
    open_places.append(index)
    open_values.append(value)
}

func give_back(call: LowIntermediaryRepresentation.Instructions.Call, index: Integer) {
    var releases = call.function == "_release" and call.arguments.count() == 1 and call.target < 0
    if not releases {
        close_every_count(call)
        return
    }
    var argument = call.arguments[0]
    crash argument
    var value = value_of(argument)
    var open = open_values.count() - 1
    while open >= 0 {
        var held = open_values[open]
        if held == value {
            var place = open_places[open]
            crash place
            removed[place] = true
            removed[index] = true
            open_places.remove_at(open)
            open_values.remove_at(open)
            return
        }
        open = open - 1
    }
    close_every_count(call)
}

func close_every_count(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    open_places = List<Integer>()
    open_values = List<Integer>()
    renew_the_defined(instruction)
}

func copy_the_value(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    var value = value_of(copy.source)
    if copy.target >= 0 and copy.target < register_total {
        values[copy.target] = value
    }
}

func renew_the_defined(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    operands.read(instruction)
    operands.defines.each(renew)
}

func renew(register: Integer) {
    if register >= 0 and register < register_total {
        values[register] = next_value
        next_value = next_value + 1
    }
}

func value_of(register: Integer): Integer {
    if register < 0 or register >= register_total {
        return -1
    }
    var value = values[register]
    crash value
    return value
}

func optimized(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        if low.is_selected(function.key) {
            low.lowered_functions[index] = headed(function, low)
        }
        index = index + 1
    }
}

func headed(function: LowIntermediaryRepresentation.LowFunction, low: LowIntermediaryRepresentation.LoweredProgram): LowIntermediaryRepresentation.LowFunction {
    var heading = Pass(function, low)
    var known = heading.transformed()
    if not heading.changed {
        return known
    }
    var folding = LowOptimizationPasses.ConstantFolding.Pass(known)
    var folded = folding.transformed()
    var threading = LowOptimizationPasses.JumpThreading.Pass(folded)
    var threaded = threading.transformed()
    var clearing = LowOptimizationPasses.UnreachedBlocks.Pass(threaded)
    return clearing.transformed()
}

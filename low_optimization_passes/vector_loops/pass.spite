# ../../OPTIMIZATIONS.md#a-decimal-sum-is-split-into-lanes-only-where-every-partial-sum-is-exact

var state = VectorLoopState()

func Pass(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    state.program = starting_program
}

func transformed() {
    state.sums = LowOptimizationPasses.VectorLoops.ExactSums(state.program)
    state.sums.study()
    var index = 0
    while index < state.program.lowered_functions.count() {
        var listed = state.program.lowered_functions[index]
        state.function_index = index
        vectorize_the_function(listed)
        index = index + 1
    }
    state.program.vector_loops = state.made_count
}

func vectorize_the_function(starting_function: LowIntermediaryRepresentation.LowFunction) {
    var loop_finding = LoopFinding(state)
    state.function = starting_function
    if not state.function.is_resumable {
        state.register_total = state.operands.most_register_of(state.function)
        loop_finding.count_the_definitions()
        loop_finding.find_the_predecessors()
        var block_count = state.function.blocks.count()
        var block_index = 0
        while block_index < block_count {
            loop_finding.try_the_loop_at(block_index)
            block_index = block_index + 1
        }
    }
}

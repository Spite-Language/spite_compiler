var state = VectorLoopState()

func AddressTranslating(starting_state: VectorLoopState) {
    state = starting_state
}

func translate_an_address(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    is_checked: Boolean,
    left_kind: Integer,
    right_kind: Integer,
) {
    if is_checked {
        state.failed = true
        return
    }
    var target = arithmetic.target
    var left = arithmetic.left
    var right = arithmetic.right
    switch arithmetic.operator {
        'add': add_to_an_address(target, left, left_kind, right, right_kind)
        'subtract': subtract_from_an_address(target, left, left_kind, right, right_kind)
        'multiply': multiply_an_index(target, left, left_kind, right, right_kind)
        'shift_left': shift_an_index(target, left, left_kind, right, right_kind)
        'divide': state.failed = true
        'remainder': state.failed = true
        'bits_and': state.failed = true
        'bits_or': state.failed = true
        'bits_xor': state.failed = true
        'shift_right': state.failed = true
        'square_root': state.failed = true
    }
}

func add_to_an_address(target: Integer, left: Integer, left_kind: Integer, right: Integer, right_kind: Integer) {
    var translating = Translating(state)
    var lanes = Lanes(state)
    if (translating.is_affine(left_kind) or left_kind == 3) and right_kind == 5 {
        translating.copy_the_affine(target, left, left_kind)
        if left_kind == 6 {
            state.kinds[target] = 2
        }
        var moved = lanes.long_at(state.shifts, left)
        state.shifts[target] = moved + lanes.operand_value(right)
        return
    }
    if left_kind == 5 and (translating.is_affine(right_kind) or right_kind == 3) {
        add_to_an_address(target, right, right_kind, left, left_kind)
        return
    }
    if (left_kind == 8 or left_kind == 7) and translating.is_affine(right_kind) {
        point_at(target, left, right)
        return
    }
    if translating.is_affine(left_kind) and (right_kind == 8 or right_kind == 7) {
        point_at(target, right, left)
        return
    }
    state.failed = true
}

func point_at(target: Integer, base: Integer, index: Integer) {
    var lanes = Lanes(state)
    var held = base
    var alias = lanes.integer_at(state.aliases, base)
    if alias >= 0 {
        held = alias
    }
    state.kinds[target] = 3
    state.bases[target] = held
    state.scales[target] = lanes.long_at(state.scales, index)
    state.shifts[target] = lanes.long_at(state.shifts, index)
}

func subtract_from_an_address(target: Integer, left: Integer, left_kind: Integer, right: Integer, right_kind: Integer) {
    var translating = Translating(state)
    var lanes = Lanes(state)
    if (translating.is_affine(left_kind) or left_kind == 3) and right_kind == 5 {
        translating.copy_the_affine(target, left, left_kind)
        if left_kind == 6 {
            state.kinds[target] = 2
        }
        var moved = lanes.long_at(state.shifts, left)
        state.shifts[target] = moved - lanes.operand_value(right)
        return
    }
    state.failed = true
}

func multiply_an_index(target: Integer, left: Integer, left_kind: Integer, right: Integer, right_kind: Integer) {
    var translating = Translating(state)
    var lanes = Lanes(state)
    if translating.is_affine(left_kind) and right_kind == 5 {
        var factor = lanes.operand_value(right)
        state.kinds[target] = 2
        var scale = lanes.long_at(state.scales, left)
        var moved = lanes.long_at(state.shifts, left)
        state.scales[target] = scale * factor
        state.shifts[target] = moved * factor
        return
    }
    if left_kind == 5 and translating.is_affine(right_kind) {
        multiply_an_index(target, right, right_kind, left, left_kind)
        return
    }
    state.failed = true
}

func shift_an_index(target: Integer, left: Integer, left_kind: Integer, right: Integer, right_kind: Integer) {
    var translating = Translating(state)
    var lanes = Lanes(state)
    if translating.is_affine(left_kind) and right_kind == 5 {
        var count = lanes.operand_value(right)
        if count < 0 or count > 4 {
            state.failed = true
            return
        }
        var factor: Long = 1
        var places: Integer = count
        factor = factor.shifted_left(places)
        state.kinds[target] = 2
        var scale = lanes.long_at(state.scales, left)
        var moved = lanes.long_at(state.shifts, left)
        state.scales[target] = scale * factor
        state.shifts[target] = moved * factor
        return
    }
    state.failed = true
}

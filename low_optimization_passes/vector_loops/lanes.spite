var state = VectorLoopState()

func Lanes(starting_state: VectorLoopState) {
    state = starting_state
}

func integer_at(numbers: List<Integer>, index: Integer): Integer {
    var held = numbers[index]
    crash held
    return held
}

func long_at(numbers: List<Long>, index: Integer): Long {
    var held = numbers[index]
    crash held
    return held
}

func lane_format_of(lane: Integer): LowIntermediaryRepresentation.Vector.Step.Format {
    var format = state.lane_formats[lane]
    crash format
    return format
}

func new_lane(format: LowIntermediaryRepresentation.Vector.Step.Format): Integer {
    state.lane_formats.append(format)
    return state.lane_formats.count() - 1
}

func format_code(format: LowIntermediaryRepresentation.Vector.Step.Format): Long {
    switch format {
        'float': return 0
        'double': return 1
        'whole_32': return 2
        'whole_64': return 3
    }
}

func is_wide(format: LowIntermediaryRepresentation.Vector.Step.Format): Boolean {
    return format == 'double' or format == 'whole_64'
}

func broadcast(register: Integer, format: LowIntermediaryRepresentation.Vector.Step.Format): Integer {
    var code = format_code(format)
    var source = register
    var alias = state.aliases[register]
    crash alias
    if alias >= 0 {
        source = alias
    }
    var in_loop_constant = state.kinds[register] == 5
    var key: Long = source
    key = key * 4 + code
    if in_loop_constant {
        key = 0 - key - 1
    }
    if state.broadcast_keys.contains(key) {
        var held = state.broadcast_keys[key]
        crash held
        return held
    }
    var lane = new_lane(format)
    var step = LowIntermediaryRepresentation.Vector.Step('broadcast', lane)
    step.format = format
    if in_loop_constant {
        var number = state.shifts[register]
        crash number
        step.number = number
    } else {
        step.source = source
    }
    state.looping.setup.append(step)
    state.broadcast_keys[key] = lane
    return lane
}

func operand_kind(register: Integer): Integer {
    var loop_finding = LoopFinding(state)
    if register < 0 {
        return -1
    }
    var kind = state.kinds[register]
    crash kind
    if kind == 0 {
        if state.body_defined[register] != 0 {
            return -1
        }
        if loop_finding.is_constant(register) {
            return 5
        }
        return 8
    }
    return kind
}

func operand_value(register: Integer): Long {
    var loop_finding = LoopFinding(state)
    var kind = state.kinds[register]
    crash kind
    if kind == 5 {
        var held = state.shifts[register]
        crash held
        return held
    }
    return loop_finding.constant_value(register)
}

func lane_in(
    register: Integer,
    format: LowIntermediaryRepresentation.Vector.Step.Format,
    keeps_low_bits: Boolean,
): Integer {
    var kind = operand_kind(register)
    if kind == 5 or kind == 8 or kind == 7 {
        return broadcast(register, format)
    }
    if kind != 1 {
        state.failed = true
        return 0
    }
    var lane = state.lanes_of[register]
    crash lane
    var held = lane_format_of(lane)
    if held == format {
        return lane
    }
    if held == 'whole_32' and format == 'whole_64' {
        return widened(lane, true)
    }
    if held == 'whole_64' and format == 'whole_32' and keeps_low_bits {
        return narrowed(lane)
    }
    state.failed = true
    return 0
}

func widened(lane: Integer, is_signed: Boolean): Integer {
    if is_signed and state.widened_lanes.contains(lane) {
        var held = state.widened_lanes[lane]
        crash held
        return held
    }
    var made = new_lane('whole_64')
    var step = LowIntermediaryRepresentation.Vector.Step('widen', made)
    step.left = lane
    step.format = 'whole_64'
    step.from_format = 'whole_32'
    step.is_signed = is_signed
    state.looping.body.append(step)
    if is_signed {
        state.widened_lanes[lane] = made
    }
    return made
}

func narrowed(lane: Integer): Integer {
    if state.narrowed_lanes.contains(lane) {
        var held = state.narrowed_lanes[lane]
        crash held
        return held
    }
    var made = new_lane('whole_32')
    var step = LowIntermediaryRepresentation.Vector.Step('narrow', made)
    step.left = lane
    step.format = 'whole_32'
    step.from_format = 'whole_64'
    state.looping.body.append(step)
    state.narrowed_lanes[lane] = made
    return made
}

func set_lane(register: Integer, lane: Integer) {
    state.kinds[register] = 1
    state.lanes_of[register] = lane
}

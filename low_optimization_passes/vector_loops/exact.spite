# ../../OPTIMIZATIONS.md#a-decimal-sum-is-split-into-lanes-only-where-every-partial-sum-is-exact
var is_empty = true
var is_known = true
var exponent = 0
var low: Long = 0
var high: Long = 0
var negative_zero = false
var changes = 0

func is_zero(): Boolean {
    return is_known and not is_empty and low == 0 and high == 0
}

func largest(): Long {
    var lowest = magnitude_of(low)
    var highest = magnitude_of(high)
    return lowest.maximum(highest)
}

func magnitude_of(value: Long): Long {
    var bound: Long = 4611686018427387904
    if value <= 0 - bound or value >= bound {
        return bound
    }
    return value.absolute()
}

func forget() {
    is_empty = false
    is_known = false
}

func hold(starting_exponent: Integer, starting_low: Long, starting_high: Long) {
    is_empty = false
    is_known = true
    exponent = starting_exponent
    low = starting_low
    high = starting_high
}

func take(other: LowOptimizationPasses.VectorLoops.Exact) {
    is_empty = other.is_empty
    is_known = other.is_known
    exponent = other.exponent
    low = other.low
    high = other.high
    negative_zero = other.negative_zero
}

func same_as(other: LowOptimizationPasses.VectorLoops.Exact): Boolean {
    fallback is_empty == other.is_empty and is_known == other.is_known
    if is_empty or not is_known {
        return true
    }
    var same_range = low == other.low and high == other.high and negative_zero == other.negative_zero
    return same_range and exponent == other.exponent
}

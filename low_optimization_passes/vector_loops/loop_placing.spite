var state = VectorLoopState()

func LoopPlacing(starting_state: VectorLoopState) {
    state = starting_state
}

func finish_the_loop() {
    var decimal_translating = DecimalTranslating(state)
    var lanes = Lanes(state)
    decimal_translating.settle_the_sum()
    var undoes_writes = state.has_checked_sums and state.stream_stores.contains(true)
    var does_nothing = not state.stream_stores.contains(true) and state.looping.accumulators.is_empty()
    if not state.failed and not undoes_writes and not does_nothing and pairs_are_checked() {
        var wide = false
        var index = 0
        while index < state.lane_formats.count() {
            var format = state.lane_formats[index]
            crash format
            if lanes.is_wide(format) {
                wide = true
            }
            index = index + 1
        }
        if wide {
            state.looping.lanes = 4
        } else {
            state.looping.lanes = 8
        }
        place_the_loop()
    }
}

func pairs_are_checked(): Boolean {
    var first = 0
    while first < state.stream_bases.count() {
        if state.stream_stores[first] == true {
            var second = 0
            while second < state.stream_bases.count() {
                fallback second == first or pair_is_checked(first, second)
                second = second + 1
            }
        }
        first = first + 1
    }
    return true
}

func pair_is_checked(first: Integer, second: Integer): Boolean {
    var lanes = Lanes(state)
    var first_base = lanes.integer_at(state.stream_bases, first)
    var second_base = lanes.integer_at(state.stream_bases, second)
    var first_offset = lanes.integer_at(state.stream_offsets, first)
    var second_offset = lanes.integer_at(state.stream_offsets, second)
    var first_size = lanes.integer_at(state.stream_sizes, first)
    var second_size = lanes.integer_at(state.stream_sizes, second)
    if first_base == second_base and first_offset == second_offset {
        return first_size == second_size
    }
    var index = 0
    while index + 1 < state.looping.disjoint_bases.count() {
        var known_first = lanes.integer_at(state.looping.disjoint_bases, index)
        var known_second = lanes.integer_at(state.looping.disjoint_bases, index + 1)
        var known_first_offset = lanes.integer_at(state.looping.disjoint_offsets, index)
        var known_second_offset = lanes.integer_at(state.looping.disjoint_offsets, index + 1)
        var same = known_first == first_base and known_second == second_base and known_first_offset == first_offset
        var mirrored = known_first == second_base and known_second == first_base and known_first_offset == second_offset
        if same and known_second_offset == second_offset or mirrored and known_second_offset == first_offset {
            return true
        }
        index = index + 2
    }
    state.looping.disjoint_bases.append(first_base)
    state.looping.disjoint_bases.append(second_base)
    state.looping.disjoint_offsets.append(first_offset)
    state.looping.disjoint_offsets.append(second_offset)
    var larger = first_size.maximum(second_size)
    state.looping.disjoint_sizes.append(larger)
    return true
}

func place_the_loop() {
    var loop_finding = LoopFinding(state)
    var made = LowIntermediaryRepresentation.LowBlock()
    var head = state.function.blocks[state.header]
    crash head
    made.place = head.place
    made.instructions.append(state.looping)
    var back = LowIntermediaryRepresentation.Instructions.Jump(state.header)
    made.instructions.append(back)
    var made_index = state.function.blocks.count()
    var coming = loop_finding.predecessors_of(state.header)
    var outside = List<Integer>()
    var index = 0
    while index < coming.count() {
        var from_block = coming[index]
        crash from_block
        if state.in_path[from_block] != true and not outside.contains(from_block) {
            outside.append(from_block)
        }
        index = index + 1
    }
    if not outside.is_empty() {
        index = 0
        while index < outside.count() {
            var from_block = outside[index]
            crash from_block
            redirect(from_block, made_index)
            index = index + 1
        }
        state.function.blocks.append(made)
        state.in_path.append(false)
        var made_coming = List<Integer>()
        outside.each(made_coming.append)
        state.predecessors.append(made_coming)
        var kept = List<Integer>()
        index = 0
        while index < coming.count() {
            var from_block = coming[index]
            crash from_block
            if state.in_path[from_block] == true {
                kept.append(from_block)
            }
            index = index + 1
        }
        kept.append(made_index)
        state.predecessors[state.header] = kept
        state.made_count = state.made_count + 1
    }
}

func redirect(from_block: Integer, to_block: Integer) {
    var block = state.function.blocks[from_block]
    crash block
    var last = block.instructions.last()
    crash last
    if last.class == LowIntermediaryRepresentation.Instructions.Jump and last.block == state.header {
        last.block = to_block
    }
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        if last.when_true == state.header {
            last.when_true = to_block
        }
        if last.when_false == state.header {
            last.when_false = to_block
        }
    }
}

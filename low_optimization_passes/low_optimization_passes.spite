# ../ARCHITECTURE.md#passes
type LowOptimizationPass {
    optimized(LowIntermediaryRepresentation.LoweredProgram)
}

var passes = List<LowOptimizationPass>()
var running = false

func LowOptimizationPasses() {
    var cold_reports = LowOptimizationPasses.ColdReports.ColdReports()
    register(cold_reports)
    var made_at_start = Proofs.SingletonsMadeAtStart.SingletonsMadeAtStart()
    var proving_made_at_start = LowOptimizationPasses.Proving(made_at_start)
    register(proving_made_at_start)
    var made_singletons = LowOptimizationPasses.MadeSingletons.MadeSingletons()
    register(made_singletons)
    var first_folding = LowOptimizationPasses.ConstantFolding.ConstantFolding()
    register(first_folding)
    var first_threading = LowOptimizationPasses.JumpThreading.JumpThreading()
    register(first_threading)
    var answering = LowOptimizationPasses.CompileTimeEvaluation.CompileTimeEvaluation()
    register(answering)
    var inlining = LowOptimizationPasses.Inlining.Inlining()
    register(inlining)
    var evaluating = LowOptimizationPasses.CompileTimeEvaluation.CompileTimeEvaluation()
    register(evaluating)
    var specializing = LowOptimizationPasses.CompileTimeEvaluation.SpecializedCalls()
    register(specializing)
    register_the_placement()
    register_the_cleaning()
    register_the_placement()
    var directing = LowOptimizationPasses.DirectCalls.DirectCalls()
    register(directing)
    var late_inlining = LowOptimizationPasses.Inlining.LateInlining()
    register(late_inlining)
    register_the_placement()
    register_the_cleaning()
    var every_function = LowOptimizationPasses.EveryFunction()
    register(every_function)
    var releasing = LowOptimizationPasses.ReleasedInPlace.ReleasedInPlace()
    register(releasing)
    var vectorizing = LowOptimizationPasses.VectorLoops.VectorLoops()
    register(vectorizing)
    var dividing_once = LowOptimizationPasses.PairedDivisions.PairedDivisions()
    register(dividing_once)
    var shaping = LowOptimizationPasses.AvailableCopies.ShapedBlocks()
    register(shaping)
    var living = LowOptimizationPasses.LiveValues.LiveValues()
    register(living)
    var coalescing = LowOptimizationPasses.CopyCoalescing.CopyCoalescing()
    register(coalescing)
    var reliving = LowOptimizationPasses.LiveValues.LiveValues()
    register(reliving)
    var folding_identical = LowOptimizationPasses.IdenticalFunctions.IdenticalFunctions()
    register(folding_identical)
}

# ../OPTIMIZATIONS.md#the-class-of-an-object-made-in-the-function-is-known
func register_the_placement() {
    var heading = LowOptimizationPasses.KnownHeaders.KnownHeaders()
    register(heading)
    var objects_in_the_frame = Proofs.ObjectsInTheFrame.ObjectsInTheFrame()
    var proving_objects = LowOptimizationPasses.Proving(objects_in_the_frame)
    register(proving_objects)
    var placing = LowOptimizationPasses.ObjectPlacement.ObjectPlacement()
    register(placing)
}

func register_the_cleaning() {
    var settling = LowOptimizationPasses.MadeSingletons.Settled()
    register(settling)
    var folding = LowOptimizationPasses.ConstantFolding.ConstantFolding()
    register(folding)
    var versioning = LowOptimizationPasses.StaticSingleAssignment.StaticSingleAssignment()
    register(versioning)
    var copying_on_edges = LowOptimizationPasses.EdgeCopies.EdgeCopies()
    register(copying_on_edges)
    var coalescing_versions = LowOptimizationPasses.VersionCoalescing.VersionCoalescing()
    register(coalescing_versions)
    var threading = LowOptimizationPasses.JumpThreading.JumpThreading()
    register(threading)
    var propagating = LowOptimizationPasses.CopyPropagation.CopyPropagation()
    register(propagating)
    var cleaning = LowOptimizationPasses.DeadCode.DeadCode()
    register(cleaning)
    var reading_through = LowOptimizationPasses.AvailableCopies.AvailableCopies()
    register(reading_through)
    var living = LowOptimizationPasses.LiveValues.LiveValues()
    register(living)
    var leaving = LowOptimizationPasses.UnreadObjects.UnreadObjects()
    register(leaving)
    var pairing = LowOptimizationPasses.CountedPairs.CountedPairs()
    register(pairing)
    var sharing = LowOptimizationPasses.CommonSubexpressions.CommonSubexpressions()
    register(sharing)
    var repropagating = LowOptimizationPasses.CopyPropagation.CopyPropagation()
    register(repropagating)
    var signed_tests = Proofs.BoundsProvenBySignedTests.BoundsProvenBySignedTests()
    var proving_bounds = LowOptimizationPasses.Proving(signed_tests)
    register(proving_bounds)
    var dominating_tests = Proofs.DominatingTests.DominatingTests()
    var proving_dominated = LowOptimizationPasses.Proving(dominating_tests)
    register(proving_dominated)
    var bounding = LowOptimizationPasses.ProvenBounds.ProvenBounds()
    register(bounding)
    var register_ranges = Proofs.RegisterRanges.RegisterRanges()
    var proving_ranges = LowOptimizationPasses.Proving(register_ranges)
    register(proving_ranges)
    var ranging = LowOptimizationPasses.CheckedRanges.CheckedRanges()
    register(ranging)
    var shifting = LowOptimizationPasses.PowerDivisions.PowerDivisions()
    register(shifting)
    var refolding = LowOptimizationPasses.ConstantFolding.ConstantFolding()
    register(refolding)
    var rethreading = LowOptimizationPasses.JumpThreading.JumpThreading()
    register(rethreading)
    var masking = LowOptimizationPasses.RemainderTests.RemainderTests()
    register(masking)
    var hoisting = LowOptimizationPasses.LoopInvariants.LoopInvariants()
    register(hoisting)
    var resharing = LowOptimizationPasses.CommonSubexpressions.CommonSubexpressions()
    register(resharing)
    var copying = LowOptimizationPasses.CopyPropagation.CopyPropagation()
    register(copying)
    var trimming = LowOptimizationPasses.DeadCode.DeadCode()
    register(trimming)
    var selecting = LowOptimizationPasses.Selections.Selections()
    register(selecting)
    var coalescing = LowOptimizationPasses.CopyCoalescing.CopyCoalescing()
    register(coalescing)
    var sweeping = LowOptimizationPasses.DeadCode.DeadCode()
    register(sweeping)
    var settled_signed_tests = Proofs.BoundsProvenBySignedTests.BoundsProvenBySignedTests()
    var proving_settled_bounds = LowOptimizationPasses.Proving(settled_signed_tests)
    register(proving_settled_bounds)
    var settled_bounding = LowOptimizationPasses.ProvenBounds.ProvenBounds()
    register(settled_bounding)
    var resweeping = LowOptimizationPasses.DeadCode.DeadCode()
    register(resweeping)
    var rereading = LowOptimizationPasses.AvailableCopies.AvailableCopies()
    register(rereading)
    var reliving = LowOptimizationPasses.LiveValues.LiveValues()
    register(reliving)
}

func register(pass: LowOptimizationPass) {
    crash not running
    passes.append(pass)
}

func run(low: LowIntermediaryRepresentation.LoweredProgram): LowIntermediaryRepresentation.LoweredProgram {
    running = true
    var index = 0
    while index < passes.count() {
        var pass = passes[index]
        pass.optimized(low)
        index = index + 1
    }
    return low
}

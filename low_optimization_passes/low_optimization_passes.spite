# ../ARCHITECTURE.md#passes

type LowOptimizationPass {
    optimized: Spite.Function<LowIntermediaryRepresentation.LoweredProgram, Nothing>
}

var passes = List<LowOptimizationPass>()
var running = false

func LowOptimizationPasses() {
    var cold_reports = ColdReports()
    register(cold_reports)
    var made_at_start = Proofs.SingletonsMadeAtStart.Proof()
    var proving_made_at_start = Proving(made_at_start)
    register(proving_made_at_start)
    var made_singletons = MadeSingletons()
    register(made_singletons)
    var first_folding = ConstantFolding()
    register(first_folding)
    var first_threading = JumpThreading()
    register(first_threading)
    var answering = CompileTimeEvaluation()
    register(answering)
    var inlining = Inlining()
    register(inlining)
    var evaluating = CompileTimeEvaluation()
    register(evaluating)
    var specializing = CompileTimeEvaluation.SpecializedCalls()
    register(specializing)
    register_the_placement()
    register_the_cleaning()
    register_the_placement()
    var directing = DirectCalls()
    register(directing)
    var late_inlining = Inlining.LateInlining()
    register(late_inlining)
    register_the_placement()
    register_the_cleaning()
    var every_function = EveryFunction()
    register(every_function)
    var uncounting = UncountedConstants()
    register(uncounting)
    var releasing = ReleasedInPlace()
    register(releasing)
    var vectorizing = VectorLoops()
    register(vectorizing)
    var dividing_once = PairedDivisions()
    register(dividing_once)
    var shaping = AvailableCopies.ShapedBlocks()
    register(shaping)
    var sharing_copies = VersionCoalescing.SharedCopies()
    register(sharing_copies)
    var living = LiveValues()
    register(living)
    var coalescing = CopyCoalescing()
    register(coalescing)
    var reliving = LiveValues()
    register(reliving)
    var folding_identical = IdenticalFunctions()
    register(folding_identical)
}

# ../OPTIMIZATIONS.md#the-class-of-an-object-made-in-the-function-is-known
func register_the_placement() {
    var heading = KnownHeaders()
    register(heading)
    var objects_in_the_frame = Proofs.ObjectsInTheFrame.Proof()
    var proving_objects = Proving(objects_in_the_frame)
    register(proving_objects)
    var placing = ObjectPlacement()
    register(placing)
}

func register_the_cleaning() {
    var settling = MadeSingletons.Settled()
    register(settling)
    var folding = ConstantFolding()
    register(folding)
    var threading = JumpThreading()
    register(threading)
    var propagating = CopyPropagation()
    register(propagating)
    var cleaning = DeadCode()
    register(cleaning)
    var reading_through = AvailableCopies()
    register(reading_through)
    var versioning = StaticSingleAssignment()
    register(versioning)
    var copying_on_edges = EdgeCopies()
    register(copying_on_edges)
    var coalescing_versions = VersionCoalescing()
    register(coalescing_versions)
    var living = LiveValues()
    register(living)
    var leaving = UnreadObjects()
    register(leaving)
    var pairing = CountedPairs()
    register(pairing)
    var sharing = CommonSubexpressions()
    register(sharing)
    var repropagating = CopyPropagation()
    register(repropagating)
    var signed_tests = Proofs.BoundsProvenBySignedTests.Proof()
    var proving_bounds = Proving(signed_tests)
    register(proving_bounds)
    var dominating_tests = Proofs.DominatingTests.Proof()
    var proving_dominated = Proving(dominating_tests)
    register(proving_dominated)
    var bounding = ProvenBounds()
    register(bounding)
    var register_ranges = Proofs.RegisterRanges.Proof()
    var proving_ranges = Proving(register_ranges)
    register(proving_ranges)
    var ranging = CheckedRanges()
    register(ranging)
    var shifting = PowerDivisions()
    register(shifting)
    var refolding = ConstantFolding()
    register(refolding)
    var rethreading = JumpThreading()
    register(rethreading)
    var masking = RemainderTests()
    register(masking)
    var hoisting = LoopInvariants()
    register(hoisting)
    var resharing = CommonSubexpressions()
    register(resharing)
    var copying = CopyPropagation()
    register(copying)
    var trimming = DeadCode()
    register(trimming)
    var selecting = Selections()
    register(selecting)
    var coalescing = CopyCoalescing()
    register(coalescing)
    var sweeping = DeadCode()
    register(sweeping)
    var settled_signed_tests = Proofs.BoundsProvenBySignedTests.Proof()
    var proving_settled_bounds = Proving(settled_signed_tests)
    register(proving_settled_bounds)
    var settled_bounding = ProvenBounds()
    register(settled_bounding)
    var resweeping = DeadCode()
    register(resweeping)
    var rereading = AvailableCopies()
    register(rereading)
    var reliving = LiveValues()
    register(reliving)
}

func register(pass: LowOptimizationPass) {
    crash not running
    passes.append(pass)
}

func run(low: LowIntermediaryRepresentation.LoweredProgram): LowIntermediaryRepresentation.LoweredProgram {
    running = true
    var index = 0
    while index < passes.count() {
        var pass = passes[index]
        pass.optimized(low)
        index = index + 1
    }
    return low
}

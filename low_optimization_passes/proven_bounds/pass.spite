# ../../OPTIMIZATIONS.md#a-bound-a-signed-test-already-proved-is-not-tested-again
var function = LowIntermediaryRepresentation.LowFunction("", 0)

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    var facts = function.proven_tests
    if not facts {
        return function
    }
    function.proven_tests = null
    var index = 0
    while index < facts.decided_blocks.count() {
        var block_index = facts.decided_blocks[index]
        var at = facts.decided_indexes[index]
        var answer = facts.decided_answers[index]
        crash block_index
        crash at
        crash answer
        answer_the_compare(block_index, at, answer)
        index = index + 1
    }
    facts.proven_branches.each(take_the_branch)
    facts.refuted_branches.each(leave_the_branch)
    return function
}

func answer_the_compare(block_index: Integer, at: Integer, answer: Long) {
    var block = function.blocks[block_index]
    crash block
    var compared = block.instructions[at]
    crash compared
    crash compared.class == LowIntermediaryRepresentation.Instructions.Compare
    block.instructions[at] = LowIntermediaryRepresentation.Instructions.Constant(compared.target, answer)
}

func take_the_branch(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var count = block.instructions.count()
    var last = block.instructions[count - 1]
    crash last
    crash last.class == LowIntermediaryRepresentation.Instructions.Branch
    block.instructions[count - 1] = LowIntermediaryRepresentation.Instructions.Jump(last.when_true)
}

# ../../OPTIMIZATIONS.md#a-test-a-dominating-test-already-made-is-not-made-again
func leave_the_branch(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var count = block.instructions.count()
    var last = block.instructions[count - 1]
    crash last
    crash last.class == LowIntermediaryRepresentation.Instructions.Branch
    block.instructions[count - 1] = LowIntermediaryRepresentation.Instructions.Jump(last.when_false)
}

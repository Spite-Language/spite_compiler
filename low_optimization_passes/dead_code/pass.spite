var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var readings = List<Integer>()
var register_total = 0
var removed_any = false

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    register_total = operands.most_register_of(function)
    var round = 0
    removed_any = true
    while removed_any and round < 8 {
        removed_any = false
        count_the_readings()
        function.blocks.each(remove_the_dead)
        round = round + 1
    }
    return function
}

func count_the_readings() {
    readings.clear()
    var index = 0
    while index < register_total {
        readings.append(0)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            operands.uses.each(count_a_reading)
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_reading(register: Integer) {
    var count = readings[register]
    crash count
    readings[register] = count + 1
}

func remove_the_dead(block: LowIntermediaryRepresentation.LowBlock) {
    var kept = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var dropped = false
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if is_dead(instruction) {
            dropped = true
        } else {
            kept.append(instruction)
        }
        index = index + 1
    }
    assert dropped
    removed_any = true
    block.instructions = kept
}

func is_dead(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Copy and instruction.source == instruction.target {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Load and instruction.cannot_fault {
        return readings[instruction.target] == 0
    }
    if not operands.is_pure(instruction) {
        return false
    }
    operands.read(instruction)
    if operands.defines.is_empty() {
        return false
    }
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        if readings[register] != 0 {
            return false
        }
        index = index + 1
    }
    return true
}

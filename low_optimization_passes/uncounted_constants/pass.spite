# ../../OPTIMIZATIONS.md#a-data-constant-is-never-counted

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var answers = LowOptimizationPasses.UncountedConstants.ConstantAnswers()
var operands = LowOptimizationPasses.Operands()
var constants = List<Boolean>()
var labels = List<Boolean>()
var set_in_block = List<Integer>()
var current_block = 0
var readings = List<Integer>()

func Pass(
    starting_function: LowIntermediaryRepresentation.LowFunction,
    starting_answers: LowOptimizationPasses.UncountedConstants.ConstantAnswers,
) {
    function = starting_function
    answers = starting_answers
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable or not counts_anything() {
        return function
    }
    var registers = ConstantRegisters(function, answers.labels, answers.answering)
    constants = registers.holding()
    labels = answers.labels
    var register = 0
    while register < constants.count() {
        set_in_block.append(-1)
        register = register + 1
    }
    var removed = false
    var block_index = 0
    while block_index < function.blocks.count() {
        current_block = block_index
        var block = function.blocks[block_index]
        var kept = block.instructions.filter(is_kept)
        if kept.count() != block.instructions.count() {
            block.instructions = kept
            removed = true
        }
        block_index = block_index + 1
    }
    if removed {
        leave_out_the_unread_addresses()
    }
    return function
}

func counts_anything(): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if counted_register(instruction) >= 0 {
                return true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return false
}

func is_kept(instruction: SpiteCompiler.Instruction): Boolean {
    var counted = counted_register(instruction)
    if counted >= 0 {
        return constants[counted] != true and set_in_block[counted] != current_block
    }
    note_what_the_block_sets(instruction)
    return true
}

func note_what_the_block_sets(instruction: SpiteCompiler.Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        if sets_a_constant(instruction) {
            set_in_block[register] = current_block
        } else {
            set_in_block[register] = -1
        }
        index = index + 1
    }
}

func sets_a_constant(instruction: SpiteCompiler.Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.DataAddress {
        return labels[instruction.label] == true
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        fallback instruction.source >= 0
        return constants[instruction.source] == true or set_in_block[instruction.source] == current_block
    }
    return false
}

func counted_register(instruction: SpiteCompiler.Instruction): Integer {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Retain {
        return instruction.object
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        var releases = instruction.function == "_release" and instruction.target < 0 and instruction.presence < 0
        if releases and instruction.arguments.count() == 1 {
            return instruction.arguments[0]
        }
    }
    return -1
}

func leave_out_the_unread_addresses() {
    var total = operands.most_register_of(function)
    var index = 0
    while index < total {
        readings.append(0)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(count_the_readings)
        block.joins.each(count_the_join_readings)
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions = block.instructions.filter(is_read_or_more_than_an_address)
        block_index = block_index + 1
    }
}

func count_the_readings(instruction: SpiteCompiler.Instruction) {
    operands.read(instruction)
    operands.uses.each(count_a_reading)
}

func count_the_join_readings(joining: LowIntermediaryRepresentation.Instructions.Join) {
    joining.sources.each(count_a_reading)
}

func count_a_reading(register: Integer) {
    fallback register >= 0
    var count = readings[register]
    crash count
    readings[register] = count + 1
}

func is_read_or_more_than_an_address(instruction: SpiteCompiler.Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.DataAddress {
        return readings[instruction.target] != 0
    }
    return true
}

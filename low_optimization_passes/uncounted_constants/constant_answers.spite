# ../../PROOFS.md#a-data-constant-is-never-counted

var labels = List<Boolean>()
var answering = Dictionary<String, Boolean>()

func read_the_program(low: LowIntermediaryRepresentation.LoweredProgram) {
    note_the_constant_labels(low)
    fallback not low.hot_reload
    low.lowered_functions.each(note_a_candidate)
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < low.lowered_functions.count() {
            var function = low.lowered_functions[index]
            if answering.contains(function.key) and not answers_only_constants(function) {
                answering.remove_at(function.key)
                changed = true
            }
            index = index + 1
        }
    }
}

func note_the_constant_labels(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.data.count() {
        labels.append(false)
        index = index + 1
    }
    var texts = low.constant_text_buffers.keys()
    texts.each(note_a_label)
    var objects = low.static_objects.values()
    objects.each(note_a_label)
}

func note_a_label(label: Integer) {
    labels[label] = true
}

func note_a_candidate(function: LowIntermediaryRepresentation.LowFunction) {
    fallback not function.is_resumable and answers_anything(function)
    answering[function.key] = true
}

func answers_anything(function: LowIntermediaryRepresentation.LowFunction): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Return and instruction.source >= 0 {
                return true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return false
}

func answers_only_constants(function: LowIntermediaryRepresentation.LowFunction): Boolean {
    var registers = ConstantRegisters(function, labels, answering)
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Return {
                fallback instruction.source < 0 or registers.holds_a_constant(instruction.source)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return true
}

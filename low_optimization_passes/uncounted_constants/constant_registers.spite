# ../../PROOFS.md#a-data-constant-is-never-counted

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var defined = List<Boolean>()
var ruled_out = List<Boolean>()
var edge_targets = List<Integer>()
var edge_sources = List<Integer>()
var labels: List<Boolean>
var answering: Dictionary<String, Boolean>
var register_total: Integer

func ConstantRegisters(
    starting_function: LowIntermediaryRepresentation.LowFunction,
    starting_labels: List<Boolean>,
    starting_answering: Dictionary<String, Boolean>,
) {
    function = starting_function
    labels = starting_labels
    answering = starting_answering
    register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        defined.append(false)
        ruled_out.append(index < function.parameter_count)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(note_the_definitions)
        block.joins.each(note_a_join)
        block_index = block_index + 1
    }
    rule_out_through_the_edges()
}

func holds_a_constant(register: Integer): Boolean {
    fallback register >= 0 and register < register_total
    fallback defined[register] == true
    return ruled_out[register] != true
}

func holding(): List<Boolean> {
    var found = List<Boolean>()
    var register = 0
    while register < register_total {
        var holds = holds_a_constant(register)
        found.append(holds)
        register = register + 1
    }
    return found
}

func note_the_definitions(instruction: SpiteCompiler.Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        defined[register] = true
        if not defines_a_constant(instruction, register) {
            ruled_out[register] = true
        }
        index = index + 1
    }
}

func note_a_join(joining: LowIntermediaryRepresentation.Instructions.Join) {
    fallback joining.target >= 0
    defined[joining.target] = true
    var index = 0
    while index < joining.sources.count() {
        var source = joining.sources[index]
        note_an_edge(joining.target, source)
        index = index + 1
    }
}

func defines_a_constant(instruction: SpiteCompiler.Instruction, register: Integer): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.DataAddress {
        return labels[instruction.label] == true
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Constant {
        return instruction.number == 0
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        note_an_edge(register, instruction.source)
        return true
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Select {
        note_an_edge(register, instruction.when_true)
        note_an_edge(register, instruction.when_false)
        return true
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.target == register and answering.contains(instruction.function)
    }
    return false
}

func note_an_edge(target: Integer, source: Integer) {
    edge_targets.append(target)
    edge_sources.append(source)
}

func rule_out_through_the_edges() {
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < edge_targets.count() {
            var target = edge_targets[index]
            crash target
            var source = edge_sources[index]
            crash source
            var takes_a_constant = holds_a_constant(source)
            if ruled_out[target] != true and not takes_a_constant {
                ruled_out[target] = true
                changed = true
            }
            index = index + 1
        }
    }
}

# ../../OPTIMIZATIONS.md#a-number-never-negative-divided-by-a-power-of-two-is-a-shift
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var ranges = LowIntermediaryRepresentation.RegisterRanges(0, 0)
var next_register = 0

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    var proven = function.register_ranges
    function.register_ranges = null
    if function.is_resumable or not proven {
        return function
    }
    ranges = proven
    next_register = operands.most_register_of(function)
    if function.register_count > next_register {
        next_register = function.register_count
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        shift_in_block(block, block_index)
        block_index = block_index + 1
    }
    if next_register > function.register_count {
        function.register_count = next_register
    }
    return function
}

func shift_in_block(block: LowIntermediaryRepresentation.LowBlock, block_index: Integer) {
    var made = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Arithmetic {
            shift_if_proven(instruction, block_index, made)
        }
        made.append(instruction)
        index = index + 1
    }
    block.instructions = made
}

func shift_if_proven(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    block_index: Integer,
    made: List<LowIntermediaryRepresentation.Instructions.Instruction>,
) {
    var operator = arithmetic.operator
    var divides = operator == 'divide' or operator == 'remainder'
    assert divides and arithmetic.is_signed and not arithmetic.wraps
    assert ranges.is_known(arithmetic.right) and ranges.is_never_negative_at(block_index, arithmetic.left)
    var divisor = ranges.low_of(arithmetic.right)
    assert divisor == ranges.high_of(arithmetic.right)
    var shift = power_of_two(divisor)
    assert shift > 0
    var held = next_register
    next_register = next_register + 1
    if operator == 'divide' {
        var counted = shift.to_long()
        var counting = LowIntermediaryRepresentation.Instructions.Constant(held, counted)
        made.append(counting)
        arithmetic.operator = 'shift_right'
    } else {
        var masking = LowIntermediaryRepresentation.Instructions.Constant(held, divisor - 1)
        made.append(masking)
        arithmetic.operator = 'bits_and'
    }
    arithmetic.right = held
    arithmetic.is_checked = false
}

func power_of_two(value: Long): Integer {
    var shift = 1
    var power: Long = 2
    while shift < 62 and power < value {
        power = power * 2
        shift = shift + 1
    }
    if power == value {
        return shift
    }
    return 0
}

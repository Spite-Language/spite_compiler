# ../ARCHITECTURE.md#a-stages-passes

type LowProof {
    proved(LowIntermediaryRepresentation.LoweredProgram)
}

var proof: LowProof? = null

func Proving(starting_proof: LowProof) {
    proof = starting_proof
}

func optimized(low: LowIntermediaryRepresentation.LoweredProgram) {
    crash proof
    proof.proved(low)
}

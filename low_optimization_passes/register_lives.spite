}

# ../OPTIMIZATIONS.md#each-write-of-a-variable-is-a-value-of-its-own
var operands = LowOptimizationPasses.Operands()
var register_total = 0
var block_total = 0
var live_in_keys = Dictionary<Long, Boolean>()
var live_out_keys = Dictionary<Long, Boolean>()
var entering = List<List<Integer>>()
var leaving = List<List<Integer>>()
var defining_blocks = List<List<Integer>>()
var definition_counts = List<Integer>()
var root_blocks = List<List<Integer>>()

func read_the_lives(
    function: LowIntermediaryRepresentation.LowFunction,
    edges: LowOptimizationPasses.BlockEdges,
    starting_register_total: Integer,
) {
    register_total = starting_register_total
    block_total = function.blocks.count()
    live_in_keys = Dictionary<Long, Boolean>()
    live_out_keys = Dictionary<Long, Boolean>()
    entering = List<List<Integer>>()
    leaving = List<List<Integer>>()
    defining_blocks = List<List<Integer>>()
    definition_counts = List<Integer>()
    root_blocks = List<List<Integer>>()
    var index = 0
    while index < block_total {
        var arriving = List<Integer>()
        entering.append(arriving)
        var departing = List<Integer>()
        leaving.append(departing)
        index = index + 1
    }
    var last_defined = List<Integer>()
    var last_rooted = List<Integer>()
    index = 0
    while index < register_total {
        var defining = List<Integer>()
        defining_blocks.append(defining)
        var roots = List<Integer>()
        root_blocks.append(roots)
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definition_counts.append(implicit)
        last_defined.append(-1)
        last_rooted.append(-1)
        index = index + 1
    }
    var block_index = 0
    while block_index < block_total {
        if edges.is_reachable(block_index) {
            var block = function.blocks[block_index]
            crash block
            var at = 0
            while at < block.instructions.count() {
                var instruction = block.instructions[at]
                operands.read(instruction)
                note_the_uses(block_index, last_defined, last_rooted)
                note_the_defines(block_index, last_defined)
                at = at + 1
            }
        }
        block_index = block_index + 1
    }
    var live_marks = List<Integer>()
    var defined_marks = List<Integer>()
    index = 0
    while index < block_total {
        live_marks.append(-1)
        defined_marks.append(-1)
        index = index + 1
    }
    var register = 0
    while register < register_total {
        var roots = root_blocks[register]
        crash roots
        if not roots.is_empty() {
            walk_one_life(edges, register, roots, defined_marks, live_marks)
        }
        register = register + 1
    }
}

func note_the_uses(block_index: Integer, last_defined: List<Integer>, last_rooted: List<Integer>) {
    var index = 0
    while index < operands.uses.count() {
        var register = operands.uses[index]
        crash register
        var defined_in = last_defined[register]
        var rooted_in = last_rooted[register]
        crash defined_in
        crash rooted_in
        if defined_in != block_index and rooted_in != block_index {
            last_rooted[register] = block_index
            var roots = root_blocks[register]
            crash roots
            roots.append(block_index)
        }
        index = index + 1
    }
}

func note_the_defines(block_index: Integer, last_defined: List<Integer>) {
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        crash register
        var count = definition_counts[register]
        crash count
        definition_counts[register] = count + 1
        var defined_in = last_defined[register]
        crash defined_in
        if defined_in != block_index {
            last_defined[register] = block_index
            var defining = defining_blocks[register]
            crash defining
            defining.append(block_index)
        }
        index = index + 1
    }
}

func walk_one_life(
    edges: LowOptimizationPasses.BlockEdges,
    register: Integer,
    roots: List<Integer>,
    defined_marks: List<Integer>,
    live_marks: List<Integer>,
) {
    var defining = defining_blocks[register]
    crash defining
    var index = 0
    while index < defining.count() {
        var defined_block = defining[index]
        crash defined_block
        defined_marks[defined_block] = register
        index = index + 1
    }
    var waiting = List<Integer>()
    index = 0
    while index < roots.count() {
        var root = roots[index]
        crash root
        live_marks[root] = register
        waiting.append(root)
        index = index + 1
    }
    while not waiting.is_empty() {
        var block = waiting.remove_last()
        crash block
        note_a_live_in(register, block)
        var coming = edges.predecessors[block]
        crash coming
        var coming_index = 0
        while coming_index < coming.count() {
            var predecessor = coming[coming_index]
            crash predecessor
            if edges.is_reachable(predecessor) {
                note_a_live_out(register, predecessor)
                var defined_there = defined_marks[predecessor] == register
                var live_there = live_marks[predecessor] == register
                if not defined_there and not live_there {
                    live_marks[predecessor] = register
                    waiting.append(predecessor)
                }
            }
            coming_index = coming_index + 1
        }
    }
}

func key_of(register: Integer, block_index: Integer): Long {
    var key: Long = register
    return key * block_total + block_index
}

func note_a_live_in(register: Integer, block_index: Integer) {
    var key = key_of(register, block_index)
    live_in_keys[key] = true
    var arriving = entering[block_index]
    crash arriving
    arriving.append(register)
}

func note_a_live_out(register: Integer, block_index: Integer) {
    var key = key_of(register, block_index)
    fallback live_out_keys[key] != true
    live_out_keys[key] = true
    var departing = leaving[block_index]
    crash departing
    departing.append(register)
}

func is_live_in(register: Integer, block_index: Integer): Boolean {
    return live_in_keys[key_of(register, block_index)] == true
}

func is_live_out(register: Integer, block_index: Integer): Boolean {
    return live_out_keys[key_of(register, block_index)] == true
}

func definition_count_of(register: Integer): Integer {
    var count = definition_counts[register]
    crash count
    return count
}

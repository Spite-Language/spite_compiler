}

func copy_function_address(
    made: LowIntermediaryRepresentation.LowBlock,
    address: LowIntermediaryRepresentation.Instructions.FunctionAddress,
) {
    var target = moved(address.target)
    var copied = LowIntermediaryRepresentation.Instructions.FunctionAddress(target, address.function)
    made.instructions.append(copied)
}

func copy_retain(
    made: LowIntermediaryRepresentation.LowBlock,
    retain: LowIntermediaryRepresentation.Instructions.Retain,
) {
    var object = moved(retain.object)
    var copied = LowIntermediaryRepresentation.Instructions.Retain(object)
    copied.is_atomic = retain.is_atomic
    made.instructions.append(copied)
}

func copy_call(made: LowIntermediaryRepresentation.LowBlock, call: LowIntermediaryRepresentation.Instructions.Call) {
    var target = moved(call.target)
    var arguments = List<Integer>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var placed = moved(argument)
        arguments.append(placed)
        index = index + 1
    }
    var copied = LowIntermediaryRepresentation.Instructions.Call(target, call.function, arguments)
    copied.presence = moved(call.presence)
    copied.line = call.line
    copied.hands_over = call.hands_over
    call_frames.add_every(copied.frames, call.frames)
    if callee_is_placeless and call.function.starts_with("_make_") {
        copied.line = outer_line
        call_frames.add_every(copied.frames, outer_frames)
    } else {
        call_frames.add_every(copied.frames, inlined_frames)
    }
    made.instructions.append(copied)
}

func copy_allocate(
    made: LowIntermediaryRepresentation.LowBlock,
    allocate: LowIntermediaryRepresentation.Instructions.Allocate,
) {
    var target = moved(allocate.target)
    var size = moved(allocate.size)
    var copied = LowIntermediaryRepresentation.Instructions.Allocate(target, size)
    made.instructions.append(copied)
}

func copy_free(made: LowIntermediaryRepresentation.LowBlock, freed: LowIntermediaryRepresentation.Instructions.Free) {
    var pointer = moved(freed.pointer)
    var copied = LowIntermediaryRepresentation.Instructions.Free(pointer)
    made.instructions.append(copied)
}

func copy_constant(
    made: LowIntermediaryRepresentation.LowBlock,
    constant: LowIntermediaryRepresentation.Instructions.Constant,
) {
    var target = moved(constant.target)
    var copied = LowIntermediaryRepresentation.Instructions.Constant(target, constant.number)
    made.instructions.append(copied)
}

func copy_copy(made: LowIntermediaryRepresentation.LowBlock, copy: LowIntermediaryRepresentation.Instructions.Copy) {
    var target = moved(copy.target)
    var source = moved(copy.source)
    var copied = LowIntermediaryRepresentation.Instructions.Copy(target, source)
    made.instructions.append(copied)
}

func copy_arithmetic(
    made: LowIntermediaryRepresentation.LowBlock,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
) {
    var target = moved(arithmetic.target)
    var left = moved(arithmetic.left)
    var right = moved(arithmetic.right)
    var copied = LowIntermediaryRepresentation.Instructions.Arithmetic(target, arithmetic.operator, left, right)
    copied.width = arithmetic.width
    copied.is_signed = arithmetic.is_signed
    copied.is_checked = arithmetic.is_checked
    copied.wraps = arithmetic.wraps
    copied.line = arithmetic.line
    copied.shown = arithmetic.shown
    copied.type_name = arithmetic.type_name
    copied.path = arithmetic.path
    copied.owner = arithmetic.owner
    if copied.owner.is_empty() {
        copied.owner = callee_key
    }
    made.instructions.append(copied)
}

func copy_compare(
    made: LowIntermediaryRepresentation.LowBlock,
    compare: LowIntermediaryRepresentation.Instructions.Compare,
) {
    var target = moved(compare.target)
    var left = moved(compare.left)
    var right = moved(compare.right)
    var copied = LowIntermediaryRepresentation.Instructions.Compare(target, compare.comparison, left, right)
    copied.is_signed = compare.is_signed
    made.instructions.append(copied)
}

func copy_copy_bytes(
    made: LowIntermediaryRepresentation.LowBlock,
    copying: LowIntermediaryRepresentation.Instructions.CopyBytes,
) {
    var destination = moved(copying.destination)
    var source = moved(copying.source)
    var count = moved(copying.count)
    var copied = LowIntermediaryRepresentation.Instructions.CopyBytes(destination, source, count)
    made.instructions.append(copied)
}

func copy_load(made: LowIntermediaryRepresentation.LowBlock, loaded: LowIntermediaryRepresentation.Instructions.Load) {
    var target = moved(loaded.target)
    var address = moved(loaded.address)
    var copied = LowIntermediaryRepresentation.Instructions.Load(target, address, loaded.offset, loaded.width)
    copied.is_signed = loaded.is_signed
    copied.is_swapped = loaded.is_swapped
    copied.is_invariant = loaded.is_invariant
    copied.cannot_fault = loaded.cannot_fault
    copied.region = loaded.region
    made.instructions.append(copied)
}

func copy_store(
    made: LowIntermediaryRepresentation.LowBlock,
    stored: LowIntermediaryRepresentation.Instructions.Store,
) {
    var address = moved(stored.address)
    var source = moved(stored.source)
    var copied = LowIntermediaryRepresentation.Instructions.Store(address, stored.offset, source, stored.width)
    copied.is_swapped = stored.is_swapped
    copied.region = stored.region
    made.instructions.append(copied)
}

func copy_jump(made: LowIntermediaryRepresentation.LowBlock, jump: LowIntermediaryRepresentation.Instructions.Jump) {
    var copied = LowIntermediaryRepresentation.Instructions.Jump(block_base + jump.block)
    made.instructions.append(copied)
}

func copy_branch(
    made: LowIntermediaryRepresentation.LowBlock,
    branch: LowIntermediaryRepresentation.Instructions.Branch,
) {
    var condition = moved(branch.condition)
    var when_true = block_base + branch.when_true
    var when_false = block_base + branch.when_false
    var copied = LowIntermediaryRepresentation.Instructions.Branch(condition, when_true, when_false)
    made.instructions.append(copied)
}

func copy_return(
    made: LowIntermediaryRepresentation.LowBlock,
    returned: LowIntermediaryRepresentation.Instructions.Return,
) {
    var answers = answer >= 0 and returned.source >= 0
    var presents = answer_presence >= 0 and returned.presence >= 0
    var source = moved(returned.source)
    var presence = moved(returned.presence)
    if answers and presents and presence == answer {
        var held = register_base + held_register
        var holding = LowIntermediaryRepresentation.Instructions.Copy(held, presence)
        made.instructions.append(holding)
        presence = held
    }
    if answers {
        var answered = LowIntermediaryRepresentation.Instructions.Copy(answer, source)
        made.instructions.append(answered)
    }
    if presents {
        var present = LowIntermediaryRepresentation.Instructions.Copy(answer_presence, presence)
        made.instructions.append(present)
    }
    var leaving = LowIntermediaryRepresentation.Instructions.Jump(continuing)
    made.instructions.append(leaving)
}

func copy_stop(made: LowIntermediaryRepresentation.LowBlock, stop: LowIntermediaryRepresentation.Instructions.Stop) {
    var copied = LowIntermediaryRepresentation.Instructions.Stop(stop.label)
    copied.labels = stop.labels
    copied.signed_numbers = stop.signed_numbers
    copied.continues = stop.continues
    var index = 0
    while index < stop.numbers.count() {
        var number = stop.numbers[index]
        var placed = moved(number)
        copied.numbers.append(placed)
        index = index + 1
    }
    made.instructions.append(copied)
}

var program = LowIntermediaryRepresentation.LoweredProgram()
var operands = LowOptimizationPasses.Operands()
var inlinable = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var doing_nothing = List<String>()
var largest_callee = 24
var largest_calling_callee = 40
var calls_on = false
var addresses_on = false
var calls_others_on = false
var makes_on = false
var largest_plain_calling_callee = 24
var largest_written_calling_callee = 12
var wanting_a_made_argument = List<String>()
var largest_looping_callee = 128
var wanting_a_made_argument_in_a_loop = List<String>()
var largest_caller = 4000
var most_inlined = 64
var register_base = 0
var block_base = 0
var continuing = 0
var answer = -1
var answer_presence = -1
var callee_place = ""
var callee_key = ""
var passed_arguments = List<Integer>()
var inlined_frames = List<String>()
var outer_frames = List<String>()
var outer_line = 0
var callee_is_placeless = false
var call_frames = LowIntermediaryRepresentation.CallFrames()
var held_register = 0
var every_function = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()

func Pass(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
}

func transformed(): LowIntermediaryRepresentation.LoweredProgram {
    program.lowered_functions.each(note_a_function)
    program.lowered_functions.each(note_if_inlinable)
    program.lowered_functions.each(inline_into)
    return program
}

func note_if_inlinable(function: LowIntermediaryRepresentation.LowFunction) {
    assert not function.is_resumable and function.key != "_release"
    if does_nothing(function) {
        doing_nothing.append(function.key)
    }
    assert function.answer_decimal_size == 0 and function.parameter_decimal_sizes.is_empty()
    var count = 0
    var copyable = true
    calls_on = false
    makes_on = false
    addresses_on = false
    calls_others_on = false
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var halts = only_halts(block)
        var calling_before = calls_on
        var making_before = makes_on
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            copyable = copyable and is_copyable(instruction)
            if not halts {
                count = count + 1
            }
            index = index + 1
        }
        if halts {
            calls_on = calling_before
            makes_on = making_before
        }
        block_index = block_index + 1
    }
    var largest = largest_callee
    if calls_on {
        largest = largest_plain_calling_callee
        if function.place.is_empty() and calls_others_on {
            largest = largest_written_calling_callee
        }
    }
    if makes_on {
        largest = largest_calling_callee
    }
    if calls_on and not makes_on and count > largest and count <= largest_calling_callee {
        largest = largest_calling_callee
        wanting_a_made_argument.append(function.key)
    }
    var written = not function.place.is_empty()
    if written and not makes_on and count > largest and count <= largest_looping_callee {
        largest = largest_looping_callee
        wanting_a_made_argument_in_a_loop.append(function.key)
    }
    assert copyable and count <= largest
    assert not function.place.is_empty() or not addresses_on or not calls_others_on
    inlinable[function.key] = function
}

func only_halts(block: LowIntermediaryRepresentation.LowBlock): Boolean {
    var last = block.instructions.last()
    if last and last == LowIntermediaryRepresentation.Instructions.Stop {
        return not last.continues
    }
    return false
}

func does_nothing(function: LowIntermediaryRepresentation.LowFunction): Boolean {
    if function.blocks.count() != 1 or function.answer_decimal_size != 0 {
        return false
    }
    var block = function.blocks.first()
    crash block
    if block.instructions.count() != 1 {
        return false
    }
    var only = block.instructions[0]
    if only == LowIntermediaryRepresentation.Instructions.Return {
        return only.source < 0 and only.presence < 0 and not only.is_a_suspension
    }
    return false
}

func is_copyable(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Store: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Return: return not instruction.is_a_suspension
        LowIntermediaryRepresentation.Instructions.Stop: return not instruction.continues
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return true
        LowIntermediaryRepresentation.Instructions.FrameRoom: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return takes_an_address()
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return takes_an_address()
        LowIntermediaryRepresentation.Instructions.Retain: return true
        LowIntermediaryRepresentation.Instructions.Call: return calls_a_function_named(instruction.function)
        LowIntermediaryRepresentation.Instructions.Allocate: return makes_an_object()
        LowIntermediaryRepresentation.Instructions.Free: return calls_a_function()
        _: return false
    }
}

func takes_an_address(): Boolean {
    addresses_on = true
    return true
}

func calls_a_function_named(name: String): Boolean {
    if not name.starts_with("_make_") and not name.contains("$cold") {
        calls_others_on = true
    }
    return calls_a_function()
}

func makes_an_object(): Boolean {
    makes_on = true
    return calls_a_function()
}

func calls_a_function(): Boolean {
    calls_on = true
    return true
}

func inline_into(function: LowIntermediaryRepresentation.LowFunction) {
    assert not function.is_resumable and not function.place.is_empty()
    var inlined = 0
    var block_index = 0
    while block_index < function.blocks.count() and inlined < most_inlined {
        if inlined_in_block(function, block_index) {
            inlined = inlined + 1
        } else {
            block_index = block_index + 1
        }
    }
}

func size_of(function: LowIntermediaryRepresentation.LowFunction): Integer {
    var count = 0
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        count = count + block.instructions.count()
        block_index = block_index + 1
    }
    return count
}

func inlined_in_block(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if calls_nothing(instruction) {
            block.instructions.remove_at(index)
            return true
        }
        if guarded_in_place(function, block_index, index, instruction) {
            return true
        }
        var callee = callee_of(instruction, function, block_index)
        if callee {
            if size_of(function) > largest_caller {
                return false
            }
            if instruction == LowIntermediaryRepresentation.Instructions.Call {
                inline_the_call(function, block_index, index, instruction, callee)
                return true
            }
        }
        index = index + 1
    }
    return false
}

func note_a_function(function: LowIntermediaryRepresentation.LowFunction) {
    every_function[function.key] = function
}

func guarded_in_place(
    function: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
    index: Integer,
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        return guarded_call(function, block_index, index, instruction)
    }
    return false
}

func guarded_call(
    function: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
    index: Integer,
    instruction: LowIntermediaryRepresentation.Instructions.Call,
): Boolean {
    if instruction.is_guarded or instruction.target >= 0 or instruction.presence >= 0 {
        return false
    }
    if inlinable.contains(instruction.function) or instruction.function == function.key {
        return false
    }
    var callee = every_function[instruction.function]
    if not callee {
        return false
    }
    if callee.place.is_empty() {
        return false
    }
    if callee.is_resumable or callee.parameter_count != instruction.arguments.count() {
        return false
    }
    if callee.answer_decimal_size != 0 or not callee.parameter_decimal_sizes.is_empty() {
        return false
    }
    var side = returning_side(callee)
    if side < 0 or size_of(function) > largest_caller {
        return false
    }
    if not is_in_a_loop(function, block_index) {
        return false
    }
    guard_the_call(function, block_index, index, instruction, callee, side)
    return true
}

func returning_side(callee: LowIntermediaryRepresentation.LowFunction): Integer {
    var entry = callee.blocks.first()
    if not entry {
        return -1
    }
    var last = entry.instructions.last()
    if not last {
        return -1
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        return side_of(callee, entry, last)
    }
    return -1
}

func side_of(
    callee: LowIntermediaryRepresentation.LowFunction,
    entry: LowIntermediaryRepresentation.LowBlock,
    last: LowIntermediaryRepresentation.Instructions.Branch,
): Integer {
    var count = entry.instructions.count()
    if count > 12 {
        return -1
    }
    var index = 0
    while index + 1 < count {
        var instruction = entry.instructions[index]
        if not is_a_guard_step(instruction) or writes_a_parameter(instruction, callee.parameter_count) {
            return -1
        }
        index = index + 1
    }
    if only_returns(callee, last.when_true) {
        return 1
    }
    if only_returns(callee, last.when_false) {
        return 0
    }
    return -1
}

func is_a_guard_step(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Load: return not instruction.is_swapped
        LowIntermediaryRepresentation.Instructions.Arithmetic: return operands.is_pure(instruction)
        _: return false
    }
}

func writes_a_parameter(instruction: LowIntermediaryRepresentation.Instructions.Instruction, count: Integer): Boolean {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        if register < count {
            return true
        }
        index = index + 1
    }
    return false
}

func only_returns(callee: LowIntermediaryRepresentation.LowFunction, block_index: Integer): Boolean {
    if block_index == 0 {
        return false
    }
    var block = callee.blocks[block_index]
    if not block {
        return false
    }
    if block.instructions.count() != 1 {
        return false
    }
    var only = block.instructions[0]
    if only == LowIntermediaryRepresentation.Instructions.Return {
        return only.source < 0 and only.presence < 0 and not only.is_a_suspension
    }
    return false
}

func guard_the_call(
    function: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
    index: Integer,
    call: LowIntermediaryRepresentation.Instructions.Call,
    callee: LowIntermediaryRepresentation.LowFunction,
    side: Integer,
) {
    var block = function.blocks[block_index]
    crash block
    register_base = operands.most_register_of(function)
    var callee_registers = operands.most_register_of(callee)
    function.register_count = register_base + callee_registers + 1
    var calling = LowIntermediaryRepresentation.LowBlock()
    calling.place = block.place
    var after = LowIntermediaryRepresentation.LowBlock()
    after.place = block.place
    var calling_index = function.blocks.count()
    var after_index = calling_index + 1
    var before = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var position = 0
    while position < block.instructions.count() {
        var instruction = block.instructions[position]
        if position < index {
            before.append(instruction)
        }
        if position > index {
            after.instructions.append(instruction)
        }
        position = position + 1
    }
    var falls_through = after.instructions.is_empty() or not ends_the_block(after)
    if falls_through and block_index + 1 < calling_index {
        var onward = LowIntermediaryRepresentation.Instructions.Jump(block_index + 1)
        after.instructions.append(onward)
    }
    passed_arguments = List<Integer>()
    var parameter = 0
    while parameter < callee.parameter_count {
        var argument = call.arguments[parameter]
        crash argument
        passed_arguments.append(argument)
        parameter = parameter + 1
    }
    var guarded = LowIntermediaryRepresentation.LowBlock()
    var entry = callee.blocks[0]
    crash entry
    var last_index = entry.instructions.count() - 1
    var copied_index = 0
    while copied_index < last_index {
        var instruction = entry.instructions[copied_index]
        copy_into(guarded, instruction)
        copied_index = copied_index + 1
    }
    guarded.instructions.each(before.append)
    var condition = guard_condition(entry, last_index)
    var branch = LowIntermediaryRepresentation.Instructions.Branch(condition, after_index, calling_index)
    if side == 0 {
        branch = LowIntermediaryRepresentation.Instructions.Branch(condition, calling_index, after_index)
    }
    before.append(branch)
    block.instructions = before
    call.is_guarded = true
    calling.instructions.append(call)
    var onward = LowIntermediaryRepresentation.Instructions.Jump(after_index)
    calling.instructions.append(onward)
    function.blocks.append(calling)
    function.blocks.append(after)
}

func guard_condition(entry: LowIntermediaryRepresentation.LowBlock, last_index: Integer): Integer {
    var test = entry.instructions[last_index]
    crash test
    if test == LowIntermediaryRepresentation.Instructions.Branch {
        return moved(test.condition)
    }
    return -1
}

func is_in_a_loop(function: LowIntermediaryRepresentation.LowFunction, start: Integer): Boolean {
    var seen = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        seen.append(false)
        index = index + 1
    }
    var waiting = List<Integer>()
    add_the_successors(function, start, waiting)
    var steps = 0
    while not waiting.is_empty() and steps < 4000 {
        var taken = waiting.remove_last()
        crash taken
        if taken == start {
            return true
        }
        if seen[taken] != true {
            seen[taken] = true
            add_the_successors(function, taken, waiting)
        }
        steps = steps + 1
    }
    return false
}

func add_the_successors(
    function: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
    waiting: List<Integer>,
) {
    var block = function.blocks[block_index]
    crash block
    var last = block.instructions.last()
    if last {
        if last == LowIntermediaryRepresentation.Instructions.Jump {
            waiting.append(last.block)
            return
        }
        if last == LowIntermediaryRepresentation.Instructions.Branch {
            waiting.append(last.when_true)
            waiting.append(last.when_false)
            return
        }
        assert not ends_with_an_exit(last)
    }
    if block_index + 1 < function.blocks.count() {
        waiting.append(block_index + 1)
    }
}

func ends_with_an_exit(last: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch last {
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.Stop: return not last.continues
        _: return false
    }
}

func calls_nothing(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.target < 0 and instruction.presence < 0 and doing_nothing.contains(instruction.function)
    }
    return false
}

func callee_of(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    caller: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
): LowIntermediaryRepresentation.LowFunction? {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        var found = inlinable[instruction.function]
        if found and found.key != caller.key {
            var fits = instruction.arguments.count() == found.parameter_count
            if fits and is_worth_it(found, instruction, caller, block_index) {
                return found
            }
        }
    }
    return null
}

func is_worth_it(
    callee: LowIntermediaryRepresentation.LowFunction,
    call: LowIntermediaryRepresentation.Instructions.Call,
    caller: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
): Boolean {
    if wanting_a_made_argument_in_a_loop.contains(callee.key) {
        return is_in_a_loop(caller, block_index) and passes_a_made_object(call, caller)
    }
    if not wanting_a_made_argument.contains(callee.key) {
        return true
    }
    return passes_a_made_object(call, caller)
}

func passes_a_made_object(
    call: LowIntermediaryRepresentation.Instructions.Call,
    caller: LowIntermediaryRepresentation.LowFunction,
): Boolean {
    var made = made_registers_of(caller)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if made.contains(argument) {
            return true
        }
        index = index + 1
    }
    return false
}

func made_registers_of(caller: LowIntermediaryRepresentation.LowFunction): List<Integer> {
    var made = List<Integer>()
    var round = 0
    while round < 2 {
        var block_index = 0
        while block_index < caller.blocks.count() {
            var block = caller.blocks[block_index]
            var index = 0
            while index < block.instructions.count() {
                var instruction = block.instructions[index]
                note_a_made_register(instruction, made)
                index = index + 1
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
    return made
}

func note_a_made_register(instruction: LowIntermediaryRepresentation.Instructions.Instruction, made: List<Integer>) {
    if instruction == LowIntermediaryRepresentation.Instructions.Allocate and not made.contains(instruction.target) {
        made.append(instruction.target)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Copy and made.contains(instruction.source) and not made.contains(instruction.target) {
        made.append(instruction.target)
    }
}

func inline_the_call(
    function: LowIntermediaryRepresentation.LowFunction,
    block_index: Integer,
    index: Integer,
    call: LowIntermediaryRepresentation.Instructions.Call,
    callee: LowIntermediaryRepresentation.LowFunction,
) {
    var block = function.blocks[block_index]
    crash block
    register_base = operands.most_register_of(function)
    var callee_registers = operands.most_register_of(callee)
    held_register = callee_registers
    function.register_count = register_base + callee_registers + 1
    block_base = function.blocks.count()
    continuing = block_base + callee.blocks.count()
    answer = call.target
    answer_presence = call.presence
    callee_place = callee.place
    callee_key = callee.key
    callee_is_placeless = callee.place.is_empty()
    outer_line = call.line
    outer_frames = List<String>()
    call_frames.add_every(outer_frames, call.frames)
    note_the_inlined_frames(function, block, call)
    var before = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var after = LowIntermediaryRepresentation.LowBlock()
    after.place = block.place
    var position = 0
    while position < block.instructions.count() {
        var instruction = block.instructions[position]
        if position < index {
            before.append(instruction)
        }
        if position > index {
            after.instructions.append(instruction)
        }
        position = position + 1
    }
    var falls_through = after.instructions.is_empty() or not ends_the_block(after)
    if falls_through and block_index + 1 < block_base {
        var onward = LowIntermediaryRepresentation.Instructions.Jump(block_index + 1)
        after.instructions.append(onward)
    }
    passed_arguments = List<Integer>()
    var parameter = 0
    while parameter < callee.parameter_count {
        var argument = call.arguments[parameter]
        crash argument
        if writes_the_parameter(callee, parameter) {
            passed_arguments.append(-1)
            var passed = LowIntermediaryRepresentation.Instructions.Copy(register_base + parameter, argument)
            before.append(passed)
        } else {
            passed_arguments.append(argument)
        }
        parameter = parameter + 1
    }
    var entering = LowIntermediaryRepresentation.Instructions.Jump(block_base)
    before.append(entering)
    block.instructions = before
    var callee_index = 0
    while callee_index < callee.blocks.count() {
        var copied = copied_block(callee, callee_index)
        function.blocks.append(copied)
        callee_index = callee_index + 1
    }
    function.blocks.append(after)
}

func note_the_inlined_frames(
    function: LowIntermediaryRepresentation.LowFunction,
    block: LowIntermediaryRepresentation.LowBlock,
    call: LowIntermediaryRepresentation.Instructions.Call,
) {
    inlined_frames = List<String>()
    var caller_place = block.place
    if caller_place.is_empty() {
        caller_place = function.place
    }
    var own = call_frames.frame_line(caller_place, call.line)
    if not own.is_empty() {
        inlined_frames.append(own)
    }
    call_frames.add_every(inlined_frames, call.frames)
}

func ends_the_block(block: LowIntermediaryRepresentation.LowBlock): Boolean {
    var last = block.instructions.last()
    crash last
    if last == LowIntermediaryRepresentation.Instructions.Jump {
        return true
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        return true
    }
    if last == LowIntermediaryRepresentation.Instructions.Return {
        return true
    }
    if last == LowIntermediaryRepresentation.Instructions.Exit {
        return true
    }
    if last == LowIntermediaryRepresentation.Instructions.Stop {
        return not last.continues
    }
    return false
}

func copied_block(
    callee: LowIntermediaryRepresentation.LowFunction,
    callee_index: Integer,
): LowIntermediaryRepresentation.LowBlock {
    var source = callee.blocks[callee_index]
    crash source
    var made = LowIntermediaryRepresentation.LowBlock()
    made.place = callee_place
    if not source.place.is_empty() {
        made.place = source.place
    }
    var index = 0
    while index < source.instructions.count() {
        var instruction = source.instructions[index]
        copy_into(made, instruction)
        index = index + 1
    }
    var falls_through = made.instructions.is_empty() or not ends_the_block(made)
    if falls_through {
        var onward = LowIntermediaryRepresentation.Instructions.Jump(block_base + callee_index + 1)
        if callee_index + 1 >= callee.blocks.count() {
            onward = LowIntermediaryRepresentation.Instructions.Jump(continuing)
        }
        made.instructions.append(onward)
    }
    return made
}

func moved(register: Integer): Integer {
    if register < 0 {
        return register
    }
    if register < passed_arguments.count() {
        var argument = passed_arguments[register]
        if argument >= 0 {
            return argument
        }
    }
    return register_base + register
}

func writes_the_parameter(callee: LowIntermediaryRepresentation.LowFunction, parameter: Integer): Boolean {
    var block_index = 0
    while block_index < callee.blocks.count() {
        var block = callee.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            operands.read(instruction)
            if operands.defines.contains(parameter) {
                return true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return false
}

func copy_into(
    made: LowIntermediaryRepresentation.LowBlock,
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: copy_constant(made, instruction)
        LowIntermediaryRepresentation.Instructions.Copy: copy_copy(made, instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: copy_arithmetic(made, instruction)
        LowIntermediaryRepresentation.Instructions.Compare: copy_compare(made, instruction)
        LowIntermediaryRepresentation.Instructions.Load: copy_load(made, instruction)
        LowIntermediaryRepresentation.Instructions.Store: copy_store(made, instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: copy_copy_bytes(made, instruction)
        LowIntermediaryRepresentation.Instructions.Jump: copy_jump(made, instruction)
        LowIntermediaryRepresentation.Instructions.Branch: copy_branch(made, instruction)
        LowIntermediaryRepresentation.Instructions.Return: copy_return(made, instruction)
        LowIntermediaryRepresentation.Instructions.Stop: copy_stop(made, instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: copy_decimal_arithmetic(made, instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: copy_decimal_compare(made, instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: copy_decimal_conversion(made, instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: copy_frame_room(made, instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: copy_data_address(made, instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: copy_function_address(made, instruction)
        LowIntermediaryRepresentation.Instructions.Retain: copy_retain(made, instruction)
        LowIntermediaryRepresentation.Instructions.Call: copy_call(made, instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: copy_allocate(made, instruction)
        LowIntermediaryRepresentation.Instructions.Free: copy_free(made, instruction)
        _: crash
    }
}

func copy_decimal_arithmetic(
    made: LowIntermediaryRepresentation.LowBlock,
    arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic,
) {
    var target = moved(arithmetic.target)
    var left = moved(arithmetic.left)
    var right = moved(arithmetic.right)
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic(target, arithmetic.operator, left, right)
    copied.is_double = arithmetic.is_double
    made.instructions.append(copied)
}

func copy_decimal_compare(
    made: LowIntermediaryRepresentation.LowBlock,
    compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare,
) {
    var target = moved(compare.target)
    var left = moved(compare.left)
    var right = moved(compare.right)
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Compare(target, compare.comparison, left, right)
    copied.is_double = compare.is_double
    made.instructions.append(copied)
}

func copy_decimal_conversion(
    made: LowIntermediaryRepresentation.LowBlock,
    conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion,
) {
    var target = moved(conversion.target)
    var source = moved(conversion.source)
    var copied = LowIntermediaryRepresentation.Instructions.Decimal.Conversion(target, source)
    copied.from_decimal_size = conversion.from_decimal_size
    copied.to_decimal_size = conversion.to_decimal_size
    copied.whole_is_signed = conversion.whole_is_signed
    copied.whole_width = conversion.whole_width
    made.instructions.append(copied)
}


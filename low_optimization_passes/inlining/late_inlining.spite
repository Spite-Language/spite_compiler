# ../../OPTIMIZATIONS.md#a-function-called-in-a-loop-is-inlined-into-it
func optimized(low: LowIntermediaryRepresentation.LoweredProgram) {
    fallback not low.hot_reload
    var pass = Pass(low)
    pass.is_late = true
    pass.transformed()
    low.selected_keys = pass.changed_keys
    low.selects_every_function = false
}

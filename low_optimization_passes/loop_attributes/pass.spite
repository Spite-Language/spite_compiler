# ../../OPTIMIZATIONS.md#a-loop-over-one-objects-attributes-keeps-them-in-registers
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var flow = LowOptimizationPasses.ObjectPlacement.Flow()
var block_count = 0
var dominators = List<Boolean>()
var reached = List<Boolean>()
var definitions = List<Integer>()
var copied_from = List<Integer>()
var inside = List<Boolean>()
var largest_function = 400
var header = 0
var preheader = 0
var base = -1
var refused = false
var offsets = List<Integer>()
var widths = List<LowIntermediaryRepresentation.Width>()
var signs = List<Boolean>()
var signs_known = List<Boolean>()
var written = List<Boolean>()
var homes = List<Integer>()
var exits = List<Integer>()
var next_register = 0

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    block_count = function.blocks.count()
    if function.is_resumable or block_count > largest_function or block_count < 2 {
        return function
    }
    next_register = operands.most_register_of(function)
    flow.find_the_edges(function)
    find_the_dominators()
    count_the_definitions()
    var block_index = 0
    while block_index < block_count {
        promote_the_loops_ending_at(block_index)
        block_index = block_index + 1
    }
    if next_register > function.register_count {
        function.register_count = next_register
    }
    return function
}

func dominates(dominator: Integer, block_index: Integer): Boolean {
    return dominators[block_index * block_count + dominator] == true
}

func find_the_reached() {
    reached.clear()
    var index = 0
    while index < block_count {
        reached.append(false)
        index = index + 1
    }
    var waiting = List<Integer>()
    waiting.append(0)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if reached[taken] != true {
            reached[taken] = true
            var leaving = flow.successors[taken]
            crash leaving
            var leaving_index = 0
            while leaving_index < leaving.count() {
                var next = leaving[leaving_index]
                waiting.append(next)
                leaving_index = leaving_index + 1
            }
        }
    }
}

func is_reached(block_index: Integer): Boolean {
    return reached[block_index] == true
}

func find_the_dominators() {
    find_the_reached()
    dominators.clear()
    var total = block_count * block_count
    var index = 0
    while index < total {
        dominators.append(index >= block_count)
        index = index + 1
    }
    dominators[0] = true
    var changed = true
    var round = 0
    while changed and round < 64 {
        changed = false
        var block_index = 1
        while block_index < block_count {
            if narrow_the_dominators(block_index) {
                changed = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
}

func narrow_the_dominators(block_index: Integer): Boolean {
    var coming = flow.predecessors_of(block_index)
    var changed = false
    var candidate = 0
    while candidate < block_count {
        var slot = block_index * block_count + candidate
        var now = dominators[slot] == true
        if now and candidate != block_index {
            var kept = coming.count() > 0
            var index = 0
            while index < coming.count() {
                var predecessor = coming[index]
                if is_reached(predecessor) and not dominates(candidate, predecessor) {
                    kept = false
                }
                index = index + 1
            }
            if not kept {
                dominators[slot] = false
                changed = true
            }
        }
        candidate = candidate + 1
    }
    return changed
}

func count_the_definitions() {
    definitions.clear()
    copied_from.clear()
    var index = 0
    while index < next_register {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        copied_from.append(-1)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            if instruction == LowIntermediaryRepresentation.Instructions.Copy {
                copied_from[instruction.target] = instruction.source
            }
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func promote_the_loops_ending_at(latch: Integer) {
    assert is_reached(latch)
    var leaving = flow.successors[latch]
    crash leaving
    var index = 0
    while index < leaving.count() {
        var target = leaving[index]
        if dominates(target, latch) {
            promote_the_loop(target, latch)
        }
        index = index + 1
    }
}

func promote_the_loop(loop_header: Integer, latch: Integer) {
    header = loop_header
    find_the_body(latch)
    assert find_the_preheader()
    base = -1
    refused = false
    offsets = List<Integer>()
    widths = List<LowIntermediaryRepresentation.Width>()
    signs = List<Boolean>()
    signs_known = List<Boolean>()
    written = List<Boolean>()
    homes = List<Integer>()
    exits = List<Integer>()
    study_the_body()
    assert not refused and base >= 0 and not offsets.is_empty()
    assert no_write_is_lost()
    assert overlaps_nothing()
    rewrite_the_body()
}

func find_the_body(latch: Integer) {
    inside.clear()
    var index = 0
    while index < block_count {
        inside.append(false)
        index = index + 1
    }
    inside[header] = true
    var waiting = List<Integer>()
    waiting.append(latch)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if inside[taken] != true and is_reached(taken) {
            inside[taken] = true
            var coming = flow.predecessors_of(taken)
            var coming_index = 0
            while coming_index < coming.count() {
                var predecessor = coming[coming_index]
                waiting.append(predecessor)
                coming_index = coming_index + 1
            }
        }
    }
}

func find_the_preheader(): Boolean {
    var coming = flow.predecessors_of(header)
    var found = -1
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        if inside[predecessor] != true and is_reached(predecessor) {
            if found >= 0 {
                return false
            }
            found = predecessor
        }
        index = index + 1
    }
    if found < 0 {
        return false
    }
    var onward = flow.successors[found]
    crash onward
    if onward.count() != 1 {
        return false
    }
    preheader = found
    return true
}

func study_the_body() {
    var block_index = 0
    while block_index < block_count {
        if inside[block_index] == true {
            var block = function.blocks[block_index]
            crash block
            block.instructions.each(study_an_instruction)
            note_the_exits(block_index)
        }
        block_index = block_index + 1
    }
    assert base >= function.parameter_count
    if definitions[base] != 1 {
        refused = true
    }
}

func note_the_exits(block_index: Integer) {
    var leaving = flow.successors[block_index]
    crash leaving
    var index = 0
    while index < leaving.count() {
        var target = leaving[index]
        if inside[target] != true and not exits.contains(target) {
            exits.append(target)
        }
        index = index + 1
    }
}

func study_an_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    operands.read(instruction)
    if operands.defines.contains(base) and base >= 0 {
        refused = true
    }
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Load: note_a_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: note_a_store(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: refuse_a_test_of_the_base(instruction.left, instruction.right)
        LowIntermediaryRepresentation.Instructions.Branch: refuse_a_test_of_the_base(instruction.condition, -1)
        LowIntermediaryRepresentation.Instructions.Constant: return
        LowIntermediaryRepresentation.Instructions.Copy: refuse_a_test_of_the_base(instruction.source, -1)
        LowIntermediaryRepresentation.Instructions.Arithmetic: refuse_a_test_of_the_base(instruction.left, instruction.right)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.Stop: refuse_a_continuing_stop(instruction)
        _: refused = true
    }
}

func refuse_a_continuing_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    if stop.continues {
        refused = true
    }
}

func refuse_a_test_of_the_base(left: Integer, right: Integer) {
    var same_left = same_value_of(left)
    var same_right = same_value_of(right)
    if base >= 0 and (same_left == base or same_right == base) {
        refused = true
    }
}

func same_value_of(register: Integer): Integer {
    var current = register
    var steps = 0
    while current >= 0 and current < copied_from.count() and steps < 8 {
        var source = copied_from[current]
        crash source
        if source < 0 {
            return current
        }
        current = source
        steps = steps + 1
    }
    return current
}

func note_the_base(address: Integer) {
    var same = same_value_of(address)
    if base < 0 {
        base = same
    } else if base != same {
        refused = true
    }
}

func note_a_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    if not loaded.is_attribute or loaded.is_swapped or loaded.is_shared {
        refused = true
        return
    }
    note_the_base(loaded.address)
    note_a_read_offset(loaded.offset, loaded.width, loaded.is_signed)
}

func note_a_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    if not stored.is_attribute or stored.is_swapped or stored.is_shared {
        refused = true
        return
    }
    note_the_base(stored.address)
    var same_source = same_value_of(stored.source)
    if same_source == base {
        refused = true
    }
    var index = offsets.index_of(stored.offset)
    if index {
        var width = widths[index]
        if width != stored.width {
            refused = true
        }
        written[index] = true
        return
    }
    offsets.append(stored.offset)
    widths.append(stored.width)
    signs.append(true)
    signs_known.append(false)
    written.append(true)
    homes.append(-1)
}

func note_a_read_offset(offset: Integer, width: LowIntermediaryRepresentation.Width, is_signed: Boolean) {
    var index = offsets.index_of(offset)
    if index {
        var known_width = widths[index]
        var known_sign = signs[index]
        var is_known = signs_known[index] == true
        if known_width != width or is_known and known_sign != is_signed {
            refused = true
        }
        signs[index] = is_signed
        signs_known[index] = true
        return
    }
    offsets.append(offset)
    widths.append(width)
    signs.append(is_signed)
    signs_known.append(true)
    written.append(false)
    homes.append(-1)
}

func byte_count_of(width: LowIntermediaryRepresentation.Width): Integer {
    switch width {
        'bits_8': return 1
        'bits_16': return 2
        'bits_32': return 4
        _: return 8
    }
}

func overlaps_nothing(): Boolean {
    var index = 0
    while index < offsets.count() {
        var offset = offsets[index]
        var width = widths[index]
        crash offset
        crash width
        var end = offset + byte_count_of(width)
        var other = 0
        while other < offsets.count() {
            var other_offset = offsets[other]
            var other_width = widths[other]
            crash other_offset
            crash other_width
            var other_end = other_offset + byte_count_of(other_width)
            if other != index and other_offset < end and offset < other_end {
                return false
            }
            other = other + 1
        }
        index = index + 1
    }
    return true
}

func no_write_is_lost(): Boolean {
    var index = 0
    while index < exits.count() {
        var exit = exits[index]
        crash exit
        if not only_the_loop_reaches(exit) and not only_stops(exit) {
            return false
        }
        index = index + 1
    }
    return true
}

func only_the_loop_reaches(exit: Integer): Boolean {
    var coming = flow.predecessors_of(exit)
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        if inside[predecessor] != true and is_reached(predecessor) {
            return false
        }
        index = index + 1
    }
    return true
}

func only_stops(exit: Integer): Boolean {
    var block = function.blocks[exit]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        var plain = instruction == LowIntermediaryRepresentation.Instructions.Constant
        if instruction == LowIntermediaryRepresentation.Instructions.Stop {
            return not instruction.continues
        }
        if not plain {
            return false
        }
        index = index + 1
    }
    return false
}

func rewrite_the_body() {
    var block = function.blocks[preheader]
    crash block
    var index = 0
    while index < offsets.count() {
        var offset = offsets[index]
        var width = widths[index]
        var is_signed = signs[index] == true
        crash offset
        crash width
        var home = next_register
        next_register = next_register + 1
        homes[index] = home
        var loaded = LowIntermediaryRepresentation.Instructions.Load(home, base, offset, width)
        loaded.is_signed = is_signed
        loaded.is_attribute = true
        insert_before_the_end(block, loaded)
        index = index + 1
    }
    var block_index = 0
    while block_index < block_count {
        if inside[block_index] == true {
            rewrite_a_block(block_index)
        }
        block_index = block_index + 1
    }
    var exit_index = 0
    while exit_index < exits.count() {
        var exit = exits[exit_index]
        crash exit
        if only_the_loop_reaches(exit) {
            store_back_at(exit)
        }
        exit_index = exit_index + 1
    }
}

func insert_before_the_end(
    block: LowIntermediaryRepresentation.LowBlock,
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
) {
    var last = block.instructions.last()
    var ends = false
    if last {
        ends = flow.ends_the_block(last)
    }
    if not ends {
        block.instructions.append(instruction)
        return
    }
    var count = block.instructions.count()
    block.instructions.insert(count - 1, instruction)
}

func rewrite_a_block(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Load {
            var home = home_of(instruction.offset)
            block.instructions[index] = LowIntermediaryRepresentation.Instructions.Copy(instruction.target, home)
        }
        if instruction == LowIntermediaryRepresentation.Instructions.Store {
            var stored_home = home_of(instruction.offset)
            block.instructions[index] = LowIntermediaryRepresentation.Instructions.Copy(stored_home, instruction.source)
        }
        index = index + 1
    }
}

func home_of(offset: Integer): Integer {
    var index = offsets.index_of(offset)
    crash index
    var home = homes[index]
    crash home
    return home
}

func store_back_at(exit: Integer) {
    var block = function.blocks[exit]
    crash block
    var made = List<LowIntermediaryRepresentation.Instructions.Instruction>()
    var index = 0
    while index < offsets.count() {
        var was_written = written[index] == true
        if was_written {
            var offset = offsets[index]
            var width = widths[index]
            var home = homes[index]
            crash offset
            crash width
            crash home
            var stored = LowIntermediaryRepresentation.Instructions.Store(base, offset, home, width)
            stored.is_attribute = true
            made.append(stored)
        }
        index = index + 1
    }
    var kept = 0
    while kept < block.instructions.count() {
        var instruction = block.instructions[kept]
        made.append(instruction)
        kept = kept + 1
    }
    block.instructions = made
}

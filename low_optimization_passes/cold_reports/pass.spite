var program = LowIntermediaryRepresentation.LoweredProgram()
var operands = LowOptimizationPasses.Operands()
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var made = List<LowIntermediaryRepresentation.LowFunction>()
var stops = List<Boolean>()
var entered = List<Boolean>()
var region = List<Integer>()
var in_region = List<Boolean>()
var region_positions = List<Integer>()
var emptied = List<Boolean>()
var register_total = 0
var smallest_region = 8
var empty_label = -1
var cold_count = 0

func Pass(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
}

func transformed() {
    program.lowered_functions.each(cool)
    var index = 0
    while index < made.count() {
        var cold = made[index]
        program.lowered_functions.append(cold)
        index = index + 1
    }
}

func cool(cooled: LowIntermediaryRepresentation.LowFunction) {
    var is_plain = not cooled.is_resumable and cooled.key != "_start"
    fallback is_plain and not cooled.key.contains("$cold")
    function = cooled
    cold_count = 0
    register_total = operands.most_register_of(cooled)
    emptied = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        emptied.append(false)
        index = index + 1
    }
    var keeps_going = true
    while keeps_going {
        keeps_going = moved_one_region()
    }
    fallback cold_count > 0
    leave_out_the_emptied()
}

func moved_one_region(): Boolean {
    find_the_stops()
    find_the_entries()
    var index = 0
    while index < function.blocks.count() {
        if is_an_entry(index) and is_movable_from(index) {
            move_the_region(index)
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-crashs-report-is-a-cold-call
func find_the_stops() {
    var returns = List<Boolean>()
    var predecessors = List<List<Integer>>()
    var waiting = List<Integer>()
    var index = 0
    while index < function.blocks.count() {
        returns.append(false)
        var coming = List<Integer>()
        predecessors.append(coming)
        index = index + 1
    }
    index = 0
    while index < function.blocks.count() {
        var next = successors_of(index)
        var leaves_the_function = false
        var position = 0
        while position < next.count() {
            var following = next[position]
            var is_known = following >= 0 and following < returns.count()
            if is_known {
                var coming = predecessors[following]
                crash coming
                coming.append(index)
            } else {
                leaves_the_function = true
            }
            position = position + 1
        }
        if leaves_the_function or may_return_here(index) {
            returns[index] = true
            waiting.append(index)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var returning = waiting.remove_last()
        crash returning
        var coming = predecessors[returning]
        crash coming
        var position = 0
        while position < coming.count() {
            var from = coming[position]
            if returns[from] != true {
                returns[from] = true
                waiting.append(from)
            }
            position = position + 1
        }
    }
    stops = List<Boolean>()
    var stop_index = 0
    while stop_index < returns.count() {
        var returning = returns[stop_index] == true
        stops.append(not returning)
        stop_index = stop_index + 1
    }
}

func may_return_here(index: Integer): Boolean {
    var block = function.blocks[index]
    crash block
    var last = block.instructions.last()
    if not last {
        return true
    }
    switch last {
        LowIntermediaryRepresentation.Instructions.Exit: return false
        LowIntermediaryRepresentation.Instructions.Stop: return last.continues
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Check: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Store: return true
        LowIntermediaryRepresentation.Instructions.Call: return true
        LowIntermediaryRepresentation.Instructions.CallAt: return true
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return true
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return true
        LowIntermediaryRepresentation.Instructions.Allocate: return true
        LowIntermediaryRepresentation.Instructions.Retain: return true
        LowIntermediaryRepresentation.Instructions.Free: return true
        LowIntermediaryRepresentation.Instructions.Resize: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return true
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.FrameAddress: return true
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return true
        LowIntermediaryRepresentation.Instructions.FrameRoom: return true
        LowIntermediaryRepresentation.Instructions.StartThread: return true
        LowIntermediaryRepresentation.Instructions.JoinThread: return true
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return true
        LowIntermediaryRepresentation.Instructions.ImportCall: return true
        LowIntermediaryRepresentation.Instructions.CompareExchange: return true
        LowIntermediaryRepresentation.Instructions.VectorLoop: return true
        LowIntermediaryRepresentation.Instructions.Select: return true
    }
}

func stops_at(index: Integer): Boolean {
    fallback index >= 0 and index < stops.count()
    return stops[index] == true
}

func successors_of(index: Integer): List<Integer> {
    var found = List<Integer>()
    var block = function.blocks[index]
    crash block
    var last = block.instructions.last()
    if last.class == LowIntermediaryRepresentation.Instructions.Jump {
        found.append(last.block)
    }
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        found.append(last.when_true)
        found.append(last.when_false)
    }
    return found
}

func find_the_entries() {
    entered = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        entered.append(false)
        index = index + 1
    }
    var from = 0
    while from < function.blocks.count() {
        if not stops_at(from) {
            var next = successors_of(from)
            next.each(enter)
        }
        from = from + 1
    }
}

func enter(index: Integer) {
    if index >= 0 and index < entered.count() {
        entered[index] = true
    }
}

func is_an_entry(index: Integer): Boolean {
    fallback index != 0 and stops_at(index)
    return entered[index] == true
}

func is_movable_from(entry: Integer): Boolean {
    region = List<Integer>()
    in_region = List<Boolean>()
    var block_index = 0
    while block_index < function.blocks.count() {
        in_region.append(false)
        block_index = block_index + 1
    }
    add_to_the_region(entry)
    var position = 0
    while position < region.count() {
        var here = region[position]
        var next = successors_of(here)
        next.each(add_to_the_region)
        position = position + 1
    }
    return is_closed(entry) and is_worth_moving() and is_supported()
}

func add_to_the_region(block_index: Integer) {
    fallback not is_in_the_region(block_index)
    region.append(block_index)
    in_region[block_index] = true
}

func is_in_the_region(block_index: Integer): Boolean {
    fallback block_index >= 0 and block_index < in_region.count()
    return in_region[block_index] == true
}

func is_closed(entry: Integer): Boolean {
    var from = 0
    while from < function.blocks.count() {
        var next = successors_of(from)
        var index = 0
        while index < next.count() {
            var following = next[index]
            var enters = following != entry and is_in_the_region(following)
            fallback not enters or is_in_the_region(from)
            index = index + 1
        }
        from = from + 1
    }
    return true
}

func is_worth_moving(): Boolean {
    var count = 0
    var index = 0
    while index < region.count() {
        var at = region[index]
        var block = function.blocks[at]
        crash block
        count = count + block.instructions.count()
        index = index + 1
    }
    return count >= smallest_region
}

func is_supported(): Boolean {
    var index = 0
    while index < region.count() {
        var at = region[index]
        var block = function.blocks[at]
        crash block
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            fallback is_movable(instruction)
            instruction_index = instruction_index + 1
        }
        index = index + 1
    }
    return lives_are_untouched()
}

func is_movable(instruction: SpiteCompiler.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Check: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Store: return true
        LowIntermediaryRepresentation.Instructions.Call: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return true
        LowIntermediaryRepresentation.Instructions.Allocate: return true
        LowIntermediaryRepresentation.Instructions.Retain: return true
        LowIntermediaryRepresentation.Instructions.Free: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Stop: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.CallAt: return false
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Resize: return false
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return false
        LowIntermediaryRepresentation.Instructions.Return: return false
        LowIntermediaryRepresentation.Instructions.FrameAddress: return false
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return false
        LowIntermediaryRepresentation.Instructions.FrameRoom: return false
        LowIntermediaryRepresentation.Instructions.StartThread: return false
        LowIntermediaryRepresentation.Instructions.JoinThread: return false
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return false
        LowIntermediaryRepresentation.Instructions.ImportCall: return false
        LowIntermediaryRepresentation.Instructions.CompareExchange: return false
        LowIntermediaryRepresentation.Instructions.VectorLoop: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Select: return false
    }
}

func lives_are_untouched(): Boolean {
    var used = registers_of(true)
    var written = registers_of(false)
    var defined = marks_of(written)
    var written_outside = defined_outside()
    var outside = marks_of(written_outside)
    var index = 0
    while index < used.count() {
        var register = used[index]
        var is_both = defined[register] == true and outside[register] == true
        fallback not is_both
        index = index + 1
    }
    return true
}

func marks_of(registers: List<Integer>): List<Boolean> {
    var marks = List<Boolean>()
    var register = 0
    while register < register_total {
        marks.append(false)
        register = register + 1
    }
    var index = 0
    while index < registers.count() {
        var marked = registers[index]
        marks[marked] = true
        index = index + 1
    }
    return marks
}

func defined_outside(): List<Integer> {
    var found = List<Integer>()
    var parameter = 0
    while parameter < function.parameter_count {
        found.append(parameter)
        parameter = parameter + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        if not is_in_the_region(block_index) {
            var index = 0
            while index < block.instructions.count() {
                var instruction = block.instructions[index]
                operands.read(instruction)
                operands.defines.each(found.append)
                index = index + 1
            }
        }
        block_index = block_index + 1
    }
    return found
}

func registers_of(wants_uses: Boolean): List<Integer> {
    var found = List<Integer>()
    var index = 0
    while index < region.count() {
        var at = region[index]
        var block = function.blocks[at]
        crash block
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            if wants_uses {
                operands.uses.each(found.append)
            } else {
                operands.defines.each(found.append)
            }
            instruction_index = instruction_index + 1
        }
        index = index + 1
    }
    return found
}

func live_ins(defined: List<Boolean>): List<Integer> {
    var read = registers_of(true)
    var used = marks_of(read)
    var found = List<Integer>()
    var register = 0
    while register < register_total {
        var comes_in = used[register] == true and defined[register] != true
        if comes_in {
            found.append(register)
        }
        register = register + 1
    }
    return found
}

func move_the_region(entry: Integer) {
    var written = registers_of(false)
    var defined = marks_of(written)
    var incoming = live_ins(defined)
    var shift = incoming.count()
    var key = "{function.key}$cold{cold_count}"
    cold_count = cold_count + 1
    var cold = LowIntermediaryRepresentation.LowFunction(key, shift)
    var renaming = LowOptimizationPasses.Renaming()
    var next_register = shift
    var register = 0
    while register < register_total {
        var renamed = -1
        if defined[register] == true {
            renamed = next_register
            next_register = next_register + 1
        }
        renaming.renames.append(renamed)
        renaming.definition_renames.append(renamed)
        register = register + 1
    }
    cold.register_count = next_register
    var parameter = 0
    while parameter < shift {
        var passed = incoming[parameter]
        renaming.renames[passed] = parameter
        parameter = parameter + 1
    }
    var line = 0
    var index = 0
    while index < region.count() {
        var at = region[index]
        var block = function.blocks[at]
        crash block
        var first_line = cooled_block(block, renaming)
        if line == 0 {
            line = first_line
        }
        cold.blocks.append(block)
        var left = LowIntermediaryRepresentation.LowBlock()
        function.blocks[at] = left
        emptied[at] = true
        index = index + 1
    }
    note_the_region_positions()
    cold.blocks.each(point_into_the_region)
    made.append(cold)
    write_the_call(entry, key, incoming, line)
}

# ../../OPTIMIZATIONS.md#a-crashs-report-is-a-cold-call
func cooled_block(block: LowIntermediaryRepresentation.LowBlock, renaming: LowOptimizationPasses.Renaming): Integer {
    block.place = ""
    var line = 0
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        renaming.rename(instruction)
        renaming.rename_definitions(instruction)
        if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
            if line == 0 {
                line = instruction.line
            }
            instruction.line = 0
            instruction.frames = List<String>()
        }
        index = index + 1
    }
    return line
}

func note_the_region_positions() {
    region_positions = List<Integer>()
    var index = 0
    while index < function.blocks.count() {
        region_positions.append(-1)
        index = index + 1
    }
    var position = 0
    while position < region.count() {
        var at = region[position]
        region_positions[at] = position
        position = position + 1
    }
}

func point_into_the_region(block: LowIntermediaryRepresentation.LowBlock) {
    var last = block.instructions.last()
    if last.class == LowIntermediaryRepresentation.Instructions.Jump {
        last.block = position_of(last.block)
    }
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        last.when_true = position_of(last.when_true)
        last.when_false = position_of(last.when_false)
    }
}

func position_of(block_index: Integer): Integer {
    var found = region_positions[block_index]
    crash found
    crash found >= 0
    return found
}

func leave_out_the_emptied() {
    var positions = List<Integer>()
    var kept = List<LowIntermediaryRepresentation.LowBlock>()
    var index = 0
    while index < function.blocks.count() {
        var position = kept.count()
        positions.append(position)
        var block = function.blocks[index]
        if emptied[index] != true {
            kept.append(block)
        }
        index = index + 1
    }
    function.blocks = kept
    var block_index = 0
    while block_index < kept.count() {
        var block = kept[block_index]
        point_past_the_emptied(block, positions)
        block_index = block_index + 1
    }
}

func point_past_the_emptied(block: LowIntermediaryRepresentation.LowBlock, positions: List<Integer>) {
    var last = block.instructions.last()
    if last.class == LowIntermediaryRepresentation.Instructions.Jump {
        last.block = kept_position(last.block, positions)
    }
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        last.when_true = kept_position(last.when_true, positions)
        last.when_false = kept_position(last.when_false, positions)
    }
}

func kept_position(block_index: Integer, positions: List<Integer>): Integer {
    if block_index < 0 or block_index >= positions.count() {
        return block_index
    }
    crash emptied[block_index] != true
    var found = positions[block_index]
    crash found
    return found
}

func write_the_call(entry: Integer, key: String, incoming: List<Integer>, line: Integer) {
    var stub = function.blocks[entry]
    crash stub
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, key, incoming, -1, false)
    called.line = line
    stub.instructions.append(called)
    var label = halt_label()
    var halted = LowIntermediaryRepresentation.Instructions.Stop(label, false)
    stub.instructions.append(halted)
}

func halt_label(): Integer {
    if empty_label < 0 {
        var nothing = Buffer(0)
        program.data.append(nothing)
        empty_label = program.data.count() - 1
        program.constant_labels.append(empty_label)
    }
    return empty_label
}

var lowered_by_key = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var answers = Dictionary<String, Integer>()
var operands = LowOptimizationPasses.Operands()
var parents = List<Integer>()

func read_the_program(program: LowIntermediaryRepresentation.LowProgram) {
    program.lowered_functions.each(note_a_function)
}

func note_a_function(function: LowIntermediaryRepresentation.LowFunction) {
    lowered_by_key[function.key] = function
}

func function_named(key: String): LowIntermediaryRepresentation.LowFunction? {
    return lowered_by_key[key]
}

func keeps_nothing_of(key: String, index: Integer): Boolean {
    var asked = "{key}#{index}"
    var known = answers[asked]
    if known {
        return known == 1
    }
    var found = lowered_by_key[key]
    var answer = false
    if found {
        answer = only_reads(found, index)
    }
    var kept = 2
    if answer {
        kept = 1
    }
    answers[asked] = kept
    return answer
}

func only_reads(function: LowIntermediaryRepresentation.LowFunction, parameter: Integer): Boolean {
    if function.is_resumable or parameter >= function.parameter_count {
        return false
    }
    join_the_copies(function)
    var root = root_of(parameter)
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if not keeps_none(instruction, root) {
                return false
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return true
}

func keeps_none(instruction: LowIntermediaryRepresentation.Instructions.Instruction, root: Integer): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Store: return not in_the_group(instruction.source, root)
        _: return not uses_the_group(instruction, root)
    }
}

func uses_the_group(instruction: LowIntermediaryRepresentation.Instructions.Instruction, root: Integer): Boolean {
    operands.read(instruction)
    var index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        if in_the_group(used, root) {
            return true
        }
        index = index + 1
    }
    return false
}

func in_the_group(register: Integer, root: Integer): Boolean {
    if register < 0 or register >= parents.count() {
        return false
    }
    return root_of(register) == root
}

func join_the_copies(function: LowIntermediaryRepresentation.LowFunction) {
    parents = List<Integer>()
    var total = operands.most_register_of(function)
    var index = 0
    while index < total {
        parents.append(index)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(join_a_copy)
        block_index = block_index + 1
    }
}

func join_a_copy(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Copy {
        if instruction.source >= 0 and instruction.target >= 0 {
            var first = root_of(instruction.target)
            var second = root_of(instruction.source)
            if first != second {
                parents[second] = first
            }
        }
    }
}

func root_of(register: Integer): Integer {
    var current = register
    var parent = parents[current]
    crash parent
    while parent != current {
        current = parent
        var further = parents[current]
        crash further
        parent = further
    }
    return current
}

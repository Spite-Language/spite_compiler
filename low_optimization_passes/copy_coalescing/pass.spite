union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var definitions = List<Integer>()
var readings = List<Integer>()
var removed = List<Boolean>()
var reach = 64

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        definitions.append(0)
        readings.append(0)
        index = index + 1
    }
    count_the_operands()
    function.blocks.each(coalesce_in)
    return function
}

func count_the_operands() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            operands.read(instruction)
            operands.uses.each(count_a_reading)
            operands.defines.each(count_a_definition)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_reading(register: Integer) {
    var count = readings[register]
    crash count
    readings[register] = count + 1
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func coalesce_in(block: LowIntermediaryRepresentation.LowBlock) {
    removed.clear()
    var any_removed = false
    var index = 0
    while index < block.instructions.count() {
        removed.append(false)
        index = index + 1
    }
    index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Copy and coalesced(block, index, instruction) {
            removed[index] = true
            any_removed = true
        }
        index = index + 1
    }
    fallback any_removed
    var kept = List<Instruction>()
    index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if removed[index] != true {
            kept.append(instruction)
        }
        index = index + 1
    }
    block.instructions = kept
}

func coalesced(
    block: LowIntermediaryRepresentation.LowBlock,
    index: Integer,
    copy: LowIntermediaryRepresentation.Instructions.Copy,
): Boolean {
    var source = copy.source
    var target = copy.target
    if source == target {
        return true
    }
    fallback source >= function.parameter_count and definitions[source] == 1 and readings[source] == 1
    var earlier = index - 1
    var lowest = index - reach
    while earlier >= 0 and earlier >= lowest {
        var instruction = block.instructions[earlier]
        crash instruction
        if removed[earlier] != true {
            operands.read(instruction)
            if operands.defines.contains(source) {
                return defining_moved(instruction, source, target)
            }
            fallback not operands.uses.contains(target) and not operands.defines.contains(target)
        }
        earlier = earlier - 1
    }
    return false
}

func defining_moved(
    instruction: Instruction,
    source: Integer,
    target: Integer,
): Boolean {
    fallback not operands.defines.contains(target)
    fallback operands.retarget(instruction, source, target)
    definitions[source] = 0
    readings[source] = 0
    return true
}

union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var operands = LowOptimizationPasses.Operands()
var successors = List<List<Integer>>()
var predecessors = List<List<Integer>>()
var dense = List<Integer>()
var member_count = 0
var live_in = List<Boolean>()
var live_out = List<Boolean>()
var live_now = List<Boolean>()
var counts_references = true

func find_the_edges(function: LowIntermediaryRepresentation.LowFunction) {
    successors = List<List<Integer>>()
    predecessors = List<List<Integer>>()
    var count = function.blocks.count()
    var index = 0
    while index < count {
        var leaving = List<Integer>()
        successors.append(leaving)
        var coming = List<Integer>()
        predecessors.append(coming)
        index = index + 1
    }
    index = 0
    while index < count {
        var block = function.blocks[index]
        var leaving = successors[index]
        crash leaving
        add_the_successors(block, index, count, leaving)
        index = index + 1
    }
    var reached = reached_from_the_start(count)
    index = 0
    while index < count {
        if reached[index] == true {
            add_the_predecessors(index)
        } else {
            var leaves_nothing = List<Integer>()
            successors[index] = leaves_nothing
        }
        index = index + 1
    }
}

func reached_from_the_start(count: Integer): List<Boolean> {
    var reached = List<Boolean>()
    var index = 0
    while index < count {
        reached.append(false)
        index = index + 1
    }
    if count == 0 {
        return reached
    }
    var pending = List<Integer>()
    pending.append(0)
    reached[0] = true
    while not pending.is_empty() {
        var taken = pending.remove_last()
        crash taken
        var leaving = successors[taken]
        crash leaving
        var leaving_index = 0
        while leaving_index < leaving.count() {
            var next = leaving[leaving_index]
            if reached[next] != true {
                reached[next] = true
                pending.append(next)
            }
            leaving_index = leaving_index + 1
        }
    }
    return reached
}

func add_the_predecessors(index: Integer) {
    var leaving = successors[index]
    crash leaving
    var target_index = 0
    while target_index < leaving.count() {
        var target = leaving[target_index]
        var coming = predecessors[target]
        crash coming
        coming.append(index)
        target_index = target_index + 1
    }
}

func add_the_successors(
    block: LowIntermediaryRepresentation.LowBlock,
    index: Integer,
    count: Integer,
    leaving: List<Integer>,
) {
    var last = block.instructions.last()
    if last {
        if last == LowIntermediaryRepresentation.Instructions.Jump {
            leaving.append(last.block)
            return
        }
        if last == LowIntermediaryRepresentation.Instructions.Branch {
            leaving.append(last.when_true)
            leaving.append(last.when_false)
            return
        }
        assert not ends_the_block(last)
    }
    if index + 1 < count {
        leaving.append(index + 1)
    }
}

func ends_the_block(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.Stop: return not instruction.continues
        _: return false
    }
}

func predecessors_of(block_index: Integer): List<Integer> {
    var found = predecessors[block_index]
    crash found
    return found
}

func allocates_in_a_loop(function: LowIntermediaryRepresentation.LowFunction, members: List<Boolean>): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        if allocates_a_member(block, members) and reaches_itself(block_index) {
            return true
        }
        block_index = block_index + 1
    }
    return false
}

func allocates_a_member(block: LowIntermediaryRepresentation.LowBlock, members: List<Boolean>): Boolean {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Allocate and members[instruction.target] == true {
            return true
        }
        index = index + 1
    }
    return false
}

func reaches_itself(start: Integer): Boolean {
    var seen = List<Boolean>()
    var index = 0
    while index < successors.count() {
        seen.append(false)
        index = index + 1
    }
    var waiting = List<Integer>()
    var first = successors[start]
    crash first
    add_into(waiting, first)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if taken == start {
            return true
        }
        if seen[taken] != true {
            seen[taken] = true
            var onward = successors[taken]
            crash onward
            add_into(waiting, onward)
        }
    }
    return false
}

func add_into(waiting: List<Integer>, added: List<Integer>) {
    var index = 0
    while index < added.count() {
        var item = added[index]
        waiting.append(item)
        index = index + 1
    }
}

func number_the_members(members: List<Boolean>) {
    dense = List<Integer>()
    member_count = 0
    var index = 0
    while index < members.count() {
        if members[index] == true {
            dense.append(member_count)
            member_count = member_count + 1
        } else {
            dense.append(-1)
        }
        index = index + 1
    }
}

func dense_of(register: Integer): Integer {
    if register < 0 or register >= dense.count() {
        return -1
    }
    return dense[register]
}

func find_the_lives(function: LowIntermediaryRepresentation.LowFunction, members: List<Boolean>, counting: Boolean) {
    counts_references = counting
    number_the_members(members)
    var total = function.blocks.count() * member_count
    live_in = List<Boolean>()
    live_out = List<Boolean>()
    var index = 0
    while index < total {
        live_in.append(false)
        live_out.append(false)
        index = index + 1
    }
    var changed = true
    var round = 0
    while changed and round < 64 {
        changed = false
        var block_index = function.blocks.count() - 1
        while block_index >= 0 {
            if update_the_block(function, block_index) {
                changed = true
            }
            block_index = block_index - 1
        }
        round = round + 1
    }
}

func update_the_block(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer): Boolean {
    var leaving = successors[block_index]
    crash leaving
    live_now = List<Boolean>()
    var member = 0
    while member < member_count {
        var live = false
        var successor_index = 0
        while successor_index < leaving.count() {
            var successor = leaving[successor_index]
            if live_in[successor * member_count + member] == true {
                live = true
            }
            successor_index = successor_index + 1
        }
        live_now.append(live)
        live_out[block_index * member_count + member] = live
        member = member + 1
    }
    var block = function.blocks[block_index]
    crash block
    var index = block.instructions.count() - 1
    while index >= 0 {
        var instruction = block.instructions[index]
        crash instruction
        step_back(instruction)
        index = index - 1
    }
    var changed = false
    member = 0
    while member < member_count {
        var slot = block_index * member_count + member
        var now = live_now[member] == true
        if live_in[slot] != now {
            changed = true
        }
        live_in[slot] = now
        member = member + 1
    }
    return changed
}

func step_back(instruction: Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var defined = operands.defines[index]
        var place = dense_of(defined)
        if place >= 0 {
            live_now[place] = false
        }
        index = index + 1
    }
    assert counts_references or not only_counts(instruction)
    index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        var place = dense_of(used)
        if place >= 0 {
            live_now[place] = true
        }
        index = index + 1
    }
}

func only_counts(instruction: Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Retain {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.function == "_release" and instruction.arguments.count() == 1
    }
    return false
}

func any_member_live(): Boolean {
    var member = 0
    while member < member_count {
        if live_now[member] == true {
            return true
        }
        member = member + 1
    }
    return false
}

func start_from_the_end(block_index: Integer) {
    live_now = List<Boolean>()
    var member = 0
    while member < member_count {
        var live = live_out[block_index * member_count + member] == true
        live_now.append(live)
        member = member + 1
    }
}

func holds_one_at_a_time(function: LowIntermediaryRepresentation.LowFunction, members: List<Boolean>): Boolean {
    find_the_lives(function, members, true)
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        start_from_the_end(block_index)
        var index = block.instructions.count() - 1
        while index >= 0 {
            var instruction = block.instructions[index]
            crash instruction
            step_back(instruction)
            if makes_a_member(instruction) and any_member_live() {
                return false
            }
            index = index - 1
        }
        block_index = block_index + 1
    }
    return true
}

func makes_a_member(instruction: Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Allocate {
        return dense_of(instruction.target) >= 0
    }
    return false
}

func copies_are_moves(function: LowIntermediaryRepresentation.LowFunction, members: List<Boolean>): Boolean {
    find_the_lives(function, members, false)
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        start_from_the_end(block_index)
        var index = block.instructions.count() - 1
        while index >= 0 {
            var instruction = block.instructions[index]
            crash instruction
            if not is_a_move(instruction) {
                return false
            }
            step_back(instruction)
            index = index - 1
        }
        block_index = block_index + 1
    }
    return true
}

func is_a_move(instruction: Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Copy {
        var place = dense_of(instruction.source)
        if place < 0 or instruction.source == instruction.target {
            return true
        }
        return live_now[place] != true
    }
    return true
}

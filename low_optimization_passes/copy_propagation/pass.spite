var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var renaming = LowOptimizationPasses.Renaming()
var definitions = List<Integer>()
var reach = 64

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        renaming.renames.append(-1)
        index = index + 1
    }
    count_the_definitions()
    function.blocks.each(note_the_copies)
    resolve_the_chains()
    function.blocks.each(rename_in_block)
    return function
}

func count_the_definitions() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func note_the_copies(block: LowIntermediaryRepresentation.LowBlock) {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Copy {
            var target = instruction.target
            var source = instruction.source
            var once = target != source and source >= 0 and definitions[target] == 1 and definitions[source] == 1
            if once and target >= function.parameter_count and stays_the_same(block, index, source, target) {
                renaming.renames[target] = source
            }
        }
        index = index + 1
    }
}

func stays_the_same(
    block: LowIntermediaryRepresentation.LowBlock,
    index: Integer,
    source: Integer,
    target: Integer,
): Boolean {
    if source < function.parameter_count {
        return true
    }
    var earlier = index - 1
    var lowest = index - reach
    while earlier >= 0 and earlier >= lowest {
        var instruction = block.instructions[earlier]
        crash instruction
        operands.read(instruction)
        if operands.defines.contains(source) {
            return true
        }
        if operands.uses.contains(target) {
            return false
        }
        earlier = earlier - 1
    }
    return false
}

func resolve_the_chains() {
    var index = 0
    while index < renaming.renames.count() {
        var replacement = renaming.renames[index]
        if replacement >= 0 {
            var further = renaming.renames[replacement]
            crash further
            if further >= 0 {
                renaming.renames[index] = -1
            }
        }
        index = index + 1
    }
}

func rename_in_block(block: LowIntermediaryRepresentation.LowBlock) {
    block.instructions.each(rename_one)
}

func rename_one(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    renaming.rename(instruction)
}

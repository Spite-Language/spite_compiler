union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

# ../../OPTIMIZATIONS.md#a-division-and-a-remainder-of-the-same-two-numbers-are-one-division
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var definitions = List<Integer>()
var constants = List<Long>()
var next_register = 0

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    next_register = operands.most_register_of(function)
    if function.register_count > next_register {
        next_register = function.register_count
    }
    find_the_constants()
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        pair_in_block(block)
        block_index = block_index + 1
    }
    if next_register > function.register_count {
        function.register_count = next_register
    }
    return function
}

func find_the_constants() {
    definitions.clear()
    constants.clear()
    while definitions.count() < next_register {
        definitions.append(0)
        constants.append(0)
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            count_the_definitions(instruction)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func count_the_definitions(instruction: Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var register = operands.defines[index]
        if register < definitions.count() {
            var count = definitions[register]
            crash count
            definitions[register] = count + 1
        }
        index = index + 1
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Constant and instruction.target < constants.count() {
        constants[instruction.target] = instruction.number
    }
}

func is_constant(register: Integer): Boolean {
    fallback register >= function.parameter_count and register < definitions.count()
    var count = definitions[register]
    crash count
    return count == 1 and is_made_by_a_constant(register)
}

func is_made_by_a_constant(register: Integer): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Constant and instruction.target == register {
                return true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return false
}

func pair_in_block(block: LowIntermediaryRepresentation.LowBlock) {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.Arithmetic {
            bring_its_pair_beside(block, index, instruction)
        }
        index = index + 1
    }
}

func bring_its_pair_beside(
    block: LowIntermediaryRepresentation.LowBlock,
    at: Integer,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
) {
    var divides = arithmetic.operator == 'divide' or arithmetic.operator == 'remainder'
    fallback divides
    fallback arithmetic.target != arithmetic.left and arithmetic.target != arithmetic.right
    var index = at + 1
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.Arithmetic and pairs_with(arithmetic, instruction) {
            var beside = move_beside(block, at, index, instruction)
            if beside {
                multiply_back_the_rest(block, at, arithmetic, instruction)
            }
            return
        }
        operands.read(instruction)
        var keeps_the_left = not operands.defines.contains(arithmetic.left)
        var keeps_the_right = not operands.defines.contains(arithmetic.right)
        fallback keeps_the_left and keeps_the_right and not operands.defines.contains(arithmetic.target)
        index = index + 1
    }
}

func pairs_with(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    var divides = arithmetic.operator == 'divide' and following.operator == 'remainder'
    var takes_the_rest = arithmetic.operator == 'remainder' and following.operator == 'divide'
    fallback divides or takes_the_rest
    var same_numbers = arithmetic.left == following.left and arithmetic.right == following.right
    var same_kind = arithmetic.width == following.width and arithmetic.is_signed == following.is_signed
    fallback same_numbers and same_kind and arithmetic.wraps == following.wraps
    fallback not following.is_checked or arithmetic.is_checked or halts_never(arithmetic.right)
    return following.target != arithmetic.target
}

func move_beside(
    block: LowIntermediaryRepresentation.LowBlock,
    at: Integer,
    found: Integer,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    var target = following.target
    var index = at + 1
    while index < found {
        var between = block.instructions[index]
        crash between
        operands.read(between)
        fallback not operands.uses.contains(target) and not operands.defines.contains(target)
        index = index + 1
    }
    if found == at + 1 {
        return true
    }
    var made = List<Instruction>()
    index = 0
    while index < block.instructions.count() {
        if index != found {
            var instruction = block.instructions[index]
            made.append(instruction)
        }
        if index == at {
            made.append(following)
        }
        index = index + 1
    }
    block.instructions = made
    return true
}

func halts_never(divisor: Integer): Boolean {
    fallback is_constant(divisor)
    var value = constants[divisor]
    crash value
    return value != 0 and value != -1
}

# ../../OPTIMIZATIONS.md#a-remainder-by-a-constant-after-its-division-is-a-multiplication-back
func multiply_back_the_rest(
    block: LowIntermediaryRepresentation.LowBlock,
    at: Integer,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
) {
    fallback halts_never(arithmetic.right)
    var dividing = arithmetic
    var resting = following
    if arithmetic.operator == 'remainder' {
        dividing = following
        resting = arithmetic
    }
    fallback dividing.target != dividing.left and dividing.target != dividing.right
    var product = next_register
    next_register = next_register + 1
    var multiplying = LowIntermediaryRepresentation.Instructions.Arithmetic(
        product,
        'multiply',
        dividing.target,
        dividing.right,
    )
    copy_the_kind(multiplying, resting)
    var subtracting = LowIntermediaryRepresentation.Instructions.Arithmetic(
        resting.target,
        'subtract',
        dividing.left,
        product,
    )
    copy_the_kind(subtracting, resting)
    var made = List<Instruction>()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if index == at {
            made.append(dividing)
            made.append(multiplying)
            made.append(subtracting)
        } else if index != at + 1 {
            made.append(instruction)
        }
        index = index + 1
    }
    block.instructions = made
}

func copy_the_kind(
    made: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: LowIntermediaryRepresentation.Instructions.Arithmetic,
) {
    made.width = kind.width
    made.is_signed = kind.is_signed
    made.is_checked = false
    made.wraps = false
    made.line = kind.line
    made.shown = kind.shown
    made.type_name = kind.type_name
    made.path = kind.path
    made.owner = kind.owner
}

var values = List<Long>()
var tags = List<Integer>()
var known = List<Boolean>()
var block = 0
var position = 0
var keeps_a_start = false
var start_values = List<Long>()
var start_tags = List<Integer>()
var start_known = List<Boolean>()
var is_changed = List<Boolean>()
var changed = List<Integer>()

func Frame(register_total: Integer) {
    var index = 0
    while index < register_total {
        values.append(0)
        tags.append(-1)
        known.append(false)
        index = index + 1
    }
}

func holds(register: Integer): Boolean {
    fallback register >= 0 and register < known.count()
    return known[register] == true
}

func value_of(register: Integer): Long {
    var value = values[register]
    crash value
    return value
}

func tag_of(register: Integer): Integer {
    var tag = tags[register]
    crash tag
    return tag
}

func set(register: Integer, value: Long, tag: Integer) {
    fallback register >= 0
    crash register < values.count()
    note_a_change(register)
    values[register] = value
    tags[register] = tag
    known[register] = true
}

func forget(register: Integer) {
    fallback register >= 0 and register < known.count()
    note_a_change(register)
    known[register] = false
    tags[register] = -1
}

# ../OPTIMIZATIONS.md#compile-time-evaluation-starts-each-block-from-one-frame
func keep_as_the_start() {
    keeps_a_start = true
    start_values = values.copy()
    start_tags = tags.copy()
    start_known = known.copy()
    is_changed = List<Boolean>()
    var index = 0
    while index < values.count() {
        is_changed.append(false)
        index = index + 1
    }
    changed = List<Integer>()
}

func note_a_change(register: Integer) {
    if keeps_a_start and is_changed[register] != true {
        is_changed[register] = true
        changed.append(register)
    }
}

func back_to_the_start(register_total: Integer) {
    var index = 0
    while index < changed.count() {
        var register = changed[index]
        var value = start_values[register]
        var tag = start_tags[register]
        crash value
        crash tag
        values[register] = value
        tags[register] = tag
        known[register] = start_known[register] == true
        is_changed[register] = false
        index = index + 1
    }
    changed.clear()
    while values.count() < register_total {
        values.append(0)
        tags.append(-1)
        known.append(false)
        start_values.append(0)
        start_tags.append(-1)
        start_known.append(false)
        is_changed.append(false)
    }
    block = 0
    position = 0
}

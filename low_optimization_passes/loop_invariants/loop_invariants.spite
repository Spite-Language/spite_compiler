func optimized(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        if low.is_selected(function.key) {
            var pass = Pass(function)
            pass.uses_threads = low.uses_threads
            pass.locked_owners = low.locked_singletons
            pass.shared_owners = low.shared_classes
            if not low.counts_memory {
                pass.quiet_labels = low.quiet_singletons
            }
            low.lowered_functions[index] = pass.transformed()
        }
        index = index + 1
    }
}

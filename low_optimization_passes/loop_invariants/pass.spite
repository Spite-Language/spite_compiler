union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var flow = LowOptimizationPasses.Flow()
var block_count = 0
var dominators = List<Boolean>()
var definitions = List<Integer>()
var inside = List<Boolean>()
var defined_inside = List<Boolean>()
var largest_function = 400
var header = 0
var preheader = 0
var touches_memory = false
var counts_objects = false
var uses_threads = false
var locked_owners = List<String>()
var shared_owners = List<String>()
var latch_block = 0
var writes_outside_regions = false
var stored_regions = List<String>()
var tested_inside = List<Boolean>()
var register_total = 0
var defining = List<Instruction?>()
var regions = List<String>()
var region_bases = List<Integer>()
var region_offsets = List<Integer>()
var region_widths = List<LowIntermediaryRepresentation.Instructions.Load.Width>()
var region_signs = List<Boolean>()
var region_stored = List<Boolean>()
var region_loaded = List<Boolean>()
var region_refused = List<Boolean>()
var promotes = true
var quiet_labels = List<Integer>()

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    block_count = function.blocks.count()
    if function.is_resumable or block_count > largest_function or block_count < 2 {
        return function
    }
    if not quiet_labels.is_empty() {
        test_the_quiet_singletons_before_their_loops()
        block_count = function.blocks.count()
    }
    flow.find_the_edges(function)
    find_the_dominators()
    count_the_definitions()
    var round = 0
    while round < 2 {
        var block_index = 0
        while block_index < block_count {
            hoist_the_loops_ending_at(block_index)
            block_index = block_index + 1
        }
        round = round + 1
    }
    return function
}

func test_the_quiet_singletons_before_their_loops() {
    var done = 0
    var changed = true
    while changed and done < 8 {
        block_count = function.blocks.count()
        flow.find_the_edges(function)
        find_the_dominators()
        changed = tested_one_before_its_loop()
        done = done + 1
    }
}

func tested_one_before_its_loop(): Boolean {
    var latch = 0
    while latch < block_count {
        var leaving = flow.successors[latch]
        crash leaving
        var index = 0
        while index < leaving.count() {
            var target = leaving[index]
            if dominates(target, latch) and tested_before_the_loop(target, latch) {
                return true
            }
            index = index + 1
        }
        latch = latch + 1
    }
    return false
}

func tested_before_the_loop(loop_header: Integer, latch: Integer): Boolean {
    header = loop_header
    find_the_body(latch)
    fallback find_the_preheader()
    var block_index = 0
    while block_index < block_count {
        var block = function.blocks[block_index]
        crash block
        if inside[block_index] == true and moved_a_quiet_test(block) {
            return true
        }
        block_index = block_index + 1
    }
    return false
}

func moved_a_quiet_test(block: LowIntermediaryRepresentation.LowBlock): Boolean {
    var last = block.instructions.last()
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        return moved_the_test_of(block, last)
    }
    return false
}

func moved_the_test_of(block: LowIntermediaryRepresentation.LowBlock, last: LowIntermediaryRepresentation.Instructions.Branch): Boolean {
    var making = function.blocks[last.when_true]
    crash making
    fallback making.instructions.count() == 2
    var called = making.instructions[0]
    var leaving = making.instructions[1]
    var label = slot_tested_in(block)
    fallback label >= 0 and quiet_labels.contains(label)
    var maker = maker_of(called, leaving, last.when_false, label)
    fallback not maker.is_empty()
    var after = last.when_false
    var count = block.instructions.count()
    var straight = LowIntermediaryRepresentation.Instructions.Jump(after)
    block.instructions[count - 1] = straight
    var skipped = List<Instruction>()
    var gone_on = LowIntermediaryRepresentation.Instructions.Jump(after)
    skipped.append(gone_on)
    making.instructions = skipped
    mark_the_slot_load(block, label)
    test_in_the_preheader(label, maker)
    return true
}

func slot_tested_in(block: LowIntermediaryRepresentation.LowBlock): Integer {
    var index = block.instructions.count() - 1
    while index >= 0 {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.DataAddress {
            return instruction.label
        }
        index = index - 1
    }
    return -1
}

func maker_of(
    called: Instruction,
    leaving: Instruction,
    after: Integer,
    label: Integer,
): String {
    if leaving == LowIntermediaryRepresentation.Instructions.Jump {
        fallback leaving.block == after
        return maker_named(called, label)
    }
    return ""
}

func maker_named(called: Instruction, label: Integer): String {
    if called == LowIntermediaryRepresentation.Instructions.Call {
        return maker_called(called, label)
    }
    return ""
}

func maker_called(called: LowIntermediaryRepresentation.Instructions.Call, label: Integer): String {
    var named = called.function.starts_with("_make_") and called.function.ends_with("${label}")
    if named and called.arguments.is_empty() {
        return called.function
    }
    return ""
}

func mark_the_slot_load(block: LowIntermediaryRepresentation.LowBlock, label: Integer) {
    var slot = -1
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.DataAddress {
            slot = slot_of(instruction, label, slot)
        }
        if instruction == LowIntermediaryRepresentation.Instructions.Load {
            mark_if_the_slot(instruction, slot)
        }
        index = index + 1
    }
}

func slot_of(addressed: LowIntermediaryRepresentation.Instructions.DataAddress, label: Integer, known: Integer): Integer {
    if addressed.label == label {
        return addressed.target
    }
    return known
}

func mark_if_the_slot(loaded: LowIntermediaryRepresentation.Instructions.Load, slot: Integer) {
    if slot >= 0 and loaded.address == slot and loaded.offset == 0 and loaded.width == 'bits_64' {
        loaded.is_invariant = true
    }
}

func test_in_the_preheader(label: Integer, maker: String) {
    var first = operands.most_register_of(function)
    var slot = first
    var object = first + 1
    var zero = first + 2
    var missing = first + 3
    if function.register_count < first + 4 {
        function.register_count = first + 4
    }
    var testing_index = function.blocks.count()
    var making_index = testing_index + 1
    var entering_index = testing_index + 2
    var testing = LowIntermediaryRepresentation.LowBlock()
    var addressed = LowIntermediaryRepresentation.Instructions.DataAddress(slot, label)
    testing.instructions.append(addressed)
    var loaded = LowIntermediaryRepresentation.Instructions.Load(object, slot, 0, 'bits_64')
    testing.instructions.append(loaded)
    var nothing = LowIntermediaryRepresentation.Instructions.Constant(zero, 0)
    testing.instructions.append(nothing)
    var compared = LowIntermediaryRepresentation.Instructions.Compare(missing, 'equal', object, zero)
    testing.instructions.append(compared)
    var test = LowIntermediaryRepresentation.Instructions.Branch(missing, making_index, entering_index)
    testing.instructions.append(test)
    var making = LowIntermediaryRepresentation.LowBlock()
    var no_arguments = List<Integer>()
    var called = LowIntermediaryRepresentation.Instructions.Call(-1, maker, no_arguments)
    making.instructions.append(called)
    var made = LowIntermediaryRepresentation.Instructions.Jump(entering_index)
    making.instructions.append(made)
    var entered = LowIntermediaryRepresentation.LowBlock()
    var back = LowIntermediaryRepresentation.Instructions.Jump(header)
    entered.instructions.append(back)
    var entering = function.blocks[preheader]
    crash entering
    var into_the_test = LowIntermediaryRepresentation.Instructions.Jump(testing_index)
    var last = entering.instructions.last()
    var ends = false
    if last {
        ends = flow.ends_the_block(last)
    }
    if ends {
        var count = entering.instructions.count()
        entering.instructions[count - 1] = into_the_test
    } else {
        entering.instructions.append(into_the_test)
    }
    function.blocks.append(testing)
    function.blocks.append(making)
    function.blocks.append(entered)
}

func dominates(dominator: Integer, block_index: Integer): Boolean {
    return dominators[block_index * block_count + dominator] == true
}

func find_the_dominators() {
    dominators.clear()
    var total = block_count * block_count
    var index = 0
    while index < total {
        dominators.append(index >= block_count)
        index = index + 1
    }
    dominators[0] = true
    var changed = true
    var round = 0
    while changed and round < 64 {
        changed = false
        var block_index = 1
        while block_index < block_count {
            if narrow_the_dominators(block_index) {
                changed = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
}

func narrow_the_dominators(block_index: Integer): Boolean {
    var coming = flow.predecessors_of(block_index)
    var changed = false
    var candidate = 0
    while candidate < block_count {
        var slot = block_index * block_count + candidate
        var now = dominators[slot] == true
        if now and candidate != block_index {
            var kept = coming.count() > 0
            var index = 0
            while index < coming.count() {
                var predecessor = coming[index]
                if not dominates(candidate, predecessor) {
                    kept = false
                }
                index = index + 1
            }
            if not kept {
                dominators[slot] = false
                changed = true
            }
        }
        candidate = candidate + 1
    }
    return changed
}

func count_the_definitions() {
    var register_total_found = operands.most_register_of(function)
    definitions.clear()
    defined_inside.clear()
    tested_inside.clear()
    defining.clear()
    var index = 0
    while index < register_total_found {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        defined_inside.append(false)
        tested_inside.append(false)
        defining.append(null)
        index = index + 1
    }
    register_total = register_total_found
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            if operands.defines.count() == 1 {
                var defined = operands.defines[0]
                crash defined
                defining[defined] = instruction
            }
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func hoist_the_loops_ending_at(latch: Integer) {
    var leaving = flow.successors[latch]
    crash leaving
    var index = 0
    while index < leaving.count() {
        var target = leaving[index]
        if dominates(target, latch) {
            hoist_the_loop(target, latch)
        }
        index = index + 1
    }
}

func hoist_the_loop(loop_header: Integer, latch: Integer) {
    header = loop_header
    latch_block = latch
    find_the_body(latch)
    fallback find_the_preheader()
    study_the_body()
    var round = 0
    var moved_any = true
    while moved_any and round < 8 {
        moved_any = false
        var block_index = 0
        while block_index < block_count {
            if inside[block_index] == true and hoisted_from(block_index) {
                moved_any = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
    promote_the_regions()
}

func promote_the_regions() {
    regions.clear()
    region_bases.clear()
    region_offsets.clear()
    region_widths.clear()
    region_signs.clear()
    region_stored.clear()
    region_loaded.clear()
    region_refused.clear()
    promotes = true
    var block_index = 0
    while block_index < block_count {
        if inside[block_index] == true {
            var block = function.blocks[block_index]
            crash block
            block.instructions.each(note_a_region)
        }
        block_index = block_index + 1
    }
    fallback promotes and leaves_only_into_its_own_exits()
    var index = 0
    while index < regions.count() {
        var promotable = region_stored[index] == true and region_refused[index] != true
        if promotable and has_a_safe_base(index) {
            promote_a_region(index)
        }
        index = index + 1
    }
}

func note_a_region(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Load: note_a_load_place(instruction)
        LowIntermediaryRepresentation.Instructions.Store: note_a_store_place(instruction)
        _: note_a_plain(instruction)
    }
}

func note_a_plain(instruction: Instruction) {
    if not reads_only(instruction) {
        promotes = false
    }
}

func note_a_load_place(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    if loaded.is_swapped {
        promotes = false
        return
    }
    note_a_place(loaded.region, loaded.address, loaded.offset, loaded.width, loaded.is_signed, false)
}

func note_a_store_place(stored: LowIntermediaryRepresentation.Instructions.Store) {
    if stored.is_swapped {
        promotes = false
        return
    }
    note_a_place(stored.region, stored.address, stored.offset, stored.width, true, true)
}

func note_a_place(
    region: String,
    address: Integer,
    offset: Integer,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
    signed: Boolean,
    stores: Boolean,
) {
    if region.is_empty() {
        promotes = false
        return
    }
    var found = regions.index_of(region)
    if not found {
        regions.append(region)
        region_bases.append(address)
        region_offsets.append(offset)
        region_widths.append(width)
        region_signs.append(signed)
        region_stored.append(stores)
        region_loaded.append(not stores)
        var outside = address >= 0 and address < defined_inside.count() and defined_inside[address] != true
        var held = outside and may_hold_in_a_register(region)
        region_refused.append(not held)
        return
    }
    var same_place = region_bases[found] == address and region_offsets[found] == offset
    if not same_place or region_widths[found] != width {
        region_refused[found] = true
    }
    if stores {
        region_stored[found] = true
    } else {
        note_a_loaded_sign(found, signed)
    }
}

func note_a_loaded_sign(found: Integer, signed: Boolean) {
    if region_loaded[found] != true {
        region_loaded[found] = true
        region_signs[found] = signed
        return
    }
    if region_signs[found] != signed {
        region_refused[found] = true
    }
}

func may_hold_in_a_register(region: String): Boolean {
    if not uses_threads {
        return true
    }
    var named = region
    if named.ends_with("?") {
        var length = named.length()
        var sliced_named = named.slice(0, length - 1)
        crash sliced_named
        named = sliced_named
    }
    var parts = named.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner = parts.join(".")
    return locked_owners.contains(owner) or not shared_owners.contains(owner)
}

func leaves_only_into_its_own_exits(): Boolean {
    var block_index = 0
    while block_index < block_count {
        fallback inside[block_index] != true or exits_cleanly(block_index)
        block_index = block_index + 1
    }
    return true
}

func exits_cleanly(block_index: Integer): Boolean {
    var leaving = flow.successors[block_index]
    crash leaving
    var index = 0
    while index < leaving.count() {
        var next = leaving[index]
        fallback inside[next] == true or is_an_own_exit(next) or only_stops(next)
        index = index + 1
    }
    return true
}

func is_an_own_exit(block_index: Integer): Boolean {
    var coming = flow.predecessors_of(block_index)
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        fallback inside[predecessor] == true
        index = index + 1
    }
    return true
}

func only_stops(block_index: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction == LowIntermediaryRepresentation.Instructions.Stop {
            return not instruction.continues
        }
        fallback instruction == LowIntermediaryRepresentation.Instructions.Constant
        index = index + 1
    }
    return false
}

func has_a_safe_base(index: Integer): Boolean {
    var address = region_bases[index]
    crash address
    if not is_tested_inside(address) {
        return true
    }
    var source = address
    var steps = 0
    while steps < 8 and is_a_copy(defining[source]) {
        source = copied_from(defining[source], source)
        steps = steps + 1
    }
    if is_an_invariant_load(defining[source]) {
        return true
    }
    var head = function.blocks[header]
    crash head
    var position = 0
    while position < head.instructions.count() {
        var instruction = head.instructions[position]
        if reads_through(instruction, address) {
            return true
        }
        position = position + 1
    }
    return false
}

func is_a_copy(made: Instruction?): Boolean {
    return made == LowIntermediaryRepresentation.Instructions.Copy
}

func copied_from(made: Instruction?, known: Integer): Integer {
    if made == LowIntermediaryRepresentation.Instructions.Copy and (made.source >= 0 and made.source < definitions.count() and definitions[made.source] == 1) {
        return made.source
    }
    return known
}

func is_an_invariant_load(made: Instruction?): Boolean {
    if made == LowIntermediaryRepresentation.Instructions.Load {
        return made.is_invariant
    }
    return false
}

func reads_through(instruction: Instruction, address: Integer): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Load: return instruction.address == address
        LowIntermediaryRepresentation.Instructions.Store: return instruction.address == address
        _: return false
    }
}

func promote_a_region(index: Integer) {
    var region = regions[index]
    var address = region_bases[index]
    var offset = region_offsets[index]
    var width = region_widths[index]
    var signed = region_signs[index] == true
    crash region
    crash address
    crash offset
    crash width
    var held = fresh_register()
    var loaded = LowIntermediaryRepresentation.Instructions.Load(held, address, offset, width)
    loaded.is_signed = signed
    loaded.region = region
    hoist(loaded)
    var block_index = 0
    while block_index < block_count {
        var block = function.blocks[block_index]
        crash block
        if inside[block_index] == true {
            block.instructions = held_in(block, region, held, width, signed)
        } else if is_an_exit(block_index) {
            var stored = LowIntermediaryRepresentation.Instructions.Store(address, offset, held, width)
            stored.region = region
            block.instructions.insert(0, stored)
        }
        block_index = block_index + 1
    }
}

func is_an_exit(block_index: Integer): Boolean {
    var coming = flow.predecessors_of(block_index)
    return not coming.is_empty() and is_an_own_exit(block_index)
}

func fresh_register(): Integer {
    var made = register_total
    register_total = register_total + 1
    definitions.append(2)
    defined_inside.append(false)
    tested_inside.append(false)
    defining.append(null)
    if function.register_count < register_total {
        function.register_count = register_total
    }
    return made
}

func held_in(
    block: LowIntermediaryRepresentation.LowBlock,
    region: String,
    held: Integer,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
    signed: Boolean,
): List<Instruction> {
    var kept = List<Instruction>()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if not is_in_the_region(instruction, region) {
            kept.append(instruction)
        } else if instruction == LowIntermediaryRepresentation.Instructions.Load {
            var read = LowIntermediaryRepresentation.Instructions.Copy(instruction.target, held)
            kept.append(read)
        } else if instruction == LowIntermediaryRepresentation.Instructions.Store {
            write_into_the_held(kept, instruction, held, width, signed)
        }
        index = index + 1
    }
    return kept
}

func is_in_the_region(instruction: Instruction, region: String): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Load: return instruction.region == region
        LowIntermediaryRepresentation.Instructions.Store: return instruction.region == region
        _: return false
    }
}

func write_into_the_held(
    kept: List<Instruction>,
    stored: LowIntermediaryRepresentation.Instructions.Store,
    held: Integer,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
    signed: Boolean,
) {
    var shift = 64 - bits_in(width)
    if shift == 0 or fits_already(stored.source, width, signed) {
        var written = LowIntermediaryRepresentation.Instructions.Copy(held, stored.source)
        kept.append(written)
        return
    }
    var amount = fresh_register()
    var by = LowIntermediaryRepresentation.Instructions.Constant(amount, shift)
    kept.append(by)
    var raised = fresh_register()
    var up = LowIntermediaryRepresentation.Instructions.Arithmetic(raised, 'shift_left', stored.source, amount)
    up.is_checked = false
    kept.append(up)
    var down = LowIntermediaryRepresentation.Instructions.Arithmetic(held, 'shift_right', raised, amount)
    down.is_checked = false
    down.is_signed = signed
    kept.append(down)
}

func bits_in(width: LowIntermediaryRepresentation.Instructions.Load.Width): Integer {
    switch width {
        'bits_8': return 8
        'bits_16': return 16
        'bits_32': return 32
        _: return 64
    }
}

func fits_already(source: Integer, width: LowIntermediaryRepresentation.Instructions.Load.Width, signed: Boolean): Boolean {
    fallback source >= 0 and source < definitions.count() and definitions[source] == 1
    var made = defining[source]
    if made == LowIntermediaryRepresentation.Instructions.Arithmetic {
        return fits_from_arithmetic(made, width, signed)
    }
    if made == LowIntermediaryRepresentation.Instructions.Load {
        return made.width == width and made.is_signed == signed
    }
    if made == LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic {
        return fits_as_a_decimal(made.is_double, width, signed)
    }
    if made == LowIntermediaryRepresentation.Instructions.Decimal.Conversion {
        var is_double = made.to_decimal_size == 8
        return made.to_decimal_size > 0 and fits_as_a_decimal(is_double, width, signed)
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-decimal-lives-in-a-decimal-register
func fits_as_a_decimal(is_double: Boolean, width: LowIntermediaryRepresentation.Instructions.Load.Width, signed: Boolean): Boolean {
    if is_double {
        return width == 'bits_64'
    }
    return width == 'bits_32' and not signed
}

func fits_from_arithmetic(
    made: LowIntermediaryRepresentation.Instructions.Arithmetic,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
    signed: Boolean,
): Boolean {
    var adds = made.operator == 'add' or made.operator == 'subtract'
    return adds and made.is_checked and made.width == 'bits_32' and width == 'bits_32' and made.is_signed == signed
}

func find_the_body(latch: Integer) {
    inside.clear()
    var index = 0
    while index < block_count {
        inside.append(false)
        index = index + 1
    }
    inside[header] = true
    var waiting = List<Integer>()
    waiting.append(latch)
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        if inside[taken] != true {
            inside[taken] = true
            var coming = flow.predecessors_of(taken)
            var coming_index = 0
            while coming_index < coming.count() {
                var predecessor = coming[coming_index]
                waiting.append(predecessor)
                coming_index = coming_index + 1
            }
        }
    }
}

func find_the_preheader(): Boolean {
    var coming = flow.predecessors_of(header)
    var found = -1
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        if inside[predecessor] != true {
            fallback found < 0
            found = predecessor
        }
        index = index + 1
    }
    fallback found >= 0
    var onward = flow.successors[found]
    crash onward
    fallback onward.count() == 1
    preheader = found
    return true
}

func study_the_body() {
    touches_memory = false
    writes_outside_regions = false
    stored_regions.clear()
    counts_objects = false
    var index = 0
    while index < defined_inside.count() {
        defined_inside[index] = false
        tested_inside[index] = false
        index = index + 1
    }
    var block_index = 0
    while block_index < block_count {
        if inside[block_index] == true {
            var block = function.blocks[block_index]
            crash block
            block.instructions.each(study_an_instruction)
        }
        block_index = block_index + 1
    }
}

func study_an_instruction(instruction: Instruction) {
    operands.read(instruction)
    operands.defines.each(mark_defined_inside)
    if instruction == LowIntermediaryRepresentation.Instructions.Compare {
        mark_tested(instruction.left)
        mark_tested(instruction.right)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Branch {
        mark_tested(instruction.condition)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Retain {
        counts_objects = true
        writes_outside_regions = true
        return
    }
    if not reads_only(instruction) {
        touches_memory = true
        note_a_write(instruction)
    }
}

# ../../OPTIMIZATIONS.md#an-attribute-a-loop-only-reads-is-read-before-it
func note_a_write(instruction: Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Store {
        if instruction.region.is_empty() {
            writes_outside_regions = true
        } else if not stored_regions.contains(instruction.region) {
            stored_regions.append(instruction.region)
        }
        return
    }
    writes_outside_regions = true
}

func mark_tested(register: Integer) {
    var current = register
    var steps = 0
    while current >= 0 and current < tested_inside.count() and steps < 8 {
        tested_inside[current] = true
        current = copy_source_of(current)
        steps = steps + 1
    }
}

func is_tested_inside(register: Integer): Boolean {
    var current = register
    var steps = 0
    while current >= 0 and current < tested_inside.count() and steps < 8 {
        if tested_inside[current] == true {
            return true
        }
        current = copy_source_of(current)
        steps = steps + 1
    }
    return false
}

func no_other_thread_writes(region: String): Boolean {
    if not uses_threads {
        return true
    }
    var named = region
    if named.ends_with("?") {
        var length = named.length()
        var sliced_named = named.slice(0, length - 1)
        crash sliced_named
        named = sliced_named
    }
    var parts = named.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner = parts.join(".")
    return not shared_owners.contains(owner)
}

func copy_source_of(register: Integer): Integer {
    var made = defining[register]
    if made == LowIntermediaryRepresentation.Instructions.Copy {
        return made.source
    }
    return -1
}

func mark_defined_inside(register: Integer) {
    defined_inside[register] = true
}

func reads_only(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return true
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return true
        LowIntermediaryRepresentation.Instructions.Jump: return true
        LowIntermediaryRepresentation.Instructions.Branch: return true
        LowIntermediaryRepresentation.Instructions.Stop: return not instruction.continues
        _: return false
    }
}

func hoisted_from(block_index: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var kept = List<Instruction>()
    var moved_any = false
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if is_invariant(instruction, block_index) {
            hoist(instruction)
            moved_any = true
        } else {
            kept.append(instruction)
        }
        index = index + 1
    }
    if moved_any {
        block.instructions = kept
    }
    return moved_any
}

func is_invariant(instruction: Instruction, block_index: Integer): Boolean {
    fallback may_move(instruction, block_index)
    operands.read(instruction)
    fallback operands.defines.count() == 1
    var target = operands.defines[0]
    fallback target >= function.parameter_count and definitions[target] == 1
    var index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        fallback defined_inside[used] != true and used != target
        index = index + 1
    }
    return true
}

func may_move(instruction: Instruction, block_index: Integer): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return operands.is_pure(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return true
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return true
        LowIntermediaryRepresentation.Instructions.DataAddress: return true
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return true
        LowIntermediaryRepresentation.Instructions.Load: return may_move_a_load(instruction, block_index)
        _: return false
    }
}

func may_move_a_load(loaded: LowIntermediaryRepresentation.Instructions.Load, block_index: Integer): Boolean {
    if loaded.is_invariant {
        return true
    }
    fallback not counts_objects or loaded.offset != 8
    if not loaded.region.is_empty() {
        return may_move_a_region_load(loaded, block_index)
    }
    fallback not uses_threads and block_index == header and not touches_memory
    return true
}

func may_move_a_region_load(loaded: LowIntermediaryRepresentation.Instructions.Load, block_index: Integer): Boolean {
    var held = no_other_thread_writes(loaded.region)
    fallback held and not writes_outside_regions and not stored_regions.contains(loaded.region)
    if block_index == header {
        return true
    }
    return dominates(block_index, latch_block) and not is_tested_inside(loaded.address)
}

func hoist(instruction: Instruction) {
    operands.read(instruction)
    var target = operands.defines[0]
    crash target
    defined_inside[target] = false
    var block = function.blocks[preheader]
    crash block
    var last = block.instructions.last()
    var ends = false
    if last {
        ends = flow.ends_the_block(last)
    }
    if not ends {
        block.instructions.append(instruction)
        return
    }
    var count = block.instructions.count()
    block.instructions.insert(count - 1, instruction)
}

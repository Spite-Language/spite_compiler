union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var renames = List<Integer>()
var definition_renames = List<Integer>()

func renamed(register: Integer): Integer {
    if register < 0 or register >= renames.count() {
        return register
    }
    var replacement = renames[register]
    if replacement < 0 {
        return register
    }
    return replacement
}

func renamed_list(registers: List<Integer>): List<Integer> {
    var made = List<Integer>()
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        var replacement = renamed(register)
        made.append(replacement)
        index = index + 1
    }
    return made
}

func rename(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Copy: rename_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: rename_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: rename_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: rename_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: rename_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: rename_decimal_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Load: rename_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: rename_store(instruction)
        LowIntermediaryRepresentation.Instructions.Call: rename_call(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: rename_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: rename_foreign_address(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: rename_allocate(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: rename_retain(instruction)
        LowIntermediaryRepresentation.Instructions.Free: rename_free(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: rename_resize(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: rename_copy_bytes(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: rename_open_library(instruction)
        LowIntermediaryRepresentation.Instructions.Branch: rename_branch(instruction)
        LowIntermediaryRepresentation.Instructions.Return: rename_return(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: rename_start_thread(instruction)
        LowIntermediaryRepresentation.Instructions.JoinThread: rename_join_thread(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: rename_atomic_add(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: rename_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: rename_compare_exchange(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: rename_stop(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: rename_exit(instruction)
        LowIntermediaryRepresentation.Instructions.Select: rename_select(instruction)
        LowIntermediaryRepresentation.Instructions.Constant: return
        LowIntermediaryRepresentation.Instructions.DataAddress: return
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.FrameAddress: return
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return
        LowIntermediaryRepresentation.Instructions.FrameRoom: return
        LowIntermediaryRepresentation.Instructions.VectorLoop: return
    }
}

func rename_select(selecting: LowIntermediaryRepresentation.Instructions.Select) {
    selecting.condition = renamed(selecting.condition)
    selecting.when_true = renamed(selecting.when_true)
    selecting.when_false = renamed(selecting.when_false)
}

func rename_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    copy.source = renamed(copy.source)
}

func rename_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    arithmetic.left = renamed(arithmetic.left)
    arithmetic.right = renamed(arithmetic.right)
}

func rename_compare(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    compare.left = renamed(compare.left)
    compare.right = renamed(compare.right)
}

func rename_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    arithmetic.left = renamed(arithmetic.left)
    arithmetic.right = renamed(arithmetic.right)
}

func rename_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    compare.left = renamed(compare.left)
    compare.right = renamed(compare.right)
}

func rename_decimal_conversion(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    conversion.source = renamed(conversion.source)
}

func rename_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    loaded.address = renamed(loaded.address)
}

func rename_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    stored.address = renamed(stored.address)
    stored.source = renamed(stored.source)
}

func rename_call(call: LowIntermediaryRepresentation.Instructions.Call) {
    call.arguments = renamed_list(call.arguments)
}

func rename_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    call.arguments = renamed_list(call.arguments)
    call.address = renamed(call.address)
}

func rename_foreign_address(found: LowIntermediaryRepresentation.Instructions.ForeignAddress) {
    found.library = renamed(found.library)
}

func rename_allocate(allocate: LowIntermediaryRepresentation.Instructions.Allocate) {
    allocate.size = renamed(allocate.size)
}

func rename_retain(retain: LowIntermediaryRepresentation.Instructions.Retain) {
    retain.object = renamed(retain.object)
}

func rename_free(freed: LowIntermediaryRepresentation.Instructions.Free) {
    freed.pointer = renamed(freed.pointer)
}

func rename_resize(resize: LowIntermediaryRepresentation.Instructions.Resize) {
    resize.pointer = renamed(resize.pointer)
    resize.size = renamed(resize.size)
}

func rename_copy_bytes(copying: LowIntermediaryRepresentation.Instructions.CopyBytes) {
    copying.destination = renamed(copying.destination)
    copying.source = renamed(copying.source)
    copying.count = renamed(copying.count)
}

func rename_open_library(open: LowIntermediaryRepresentation.Instructions.OpenLibrary) {
    open.name = renamed(open.name)
}

func rename_branch(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    branch.condition = renamed(branch.condition)
}

func rename_return(returned: LowIntermediaryRepresentation.Instructions.Return) {
    returned.source = renamed(returned.source)
    returned.presence = renamed(returned.presence)
}

func rename_start_thread(starting: LowIntermediaryRepresentation.Instructions.StartThread) {
    starting.block = renamed(starting.block)
}

func rename_join_thread(joining: LowIntermediaryRepresentation.Instructions.JoinThread) {
    joining.thread = renamed(joining.thread)
}

func rename_atomic_add(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    adding.address = renamed(adding.address)
}

func rename_import_call(calling: LowIntermediaryRepresentation.Instructions.ImportCall) {
    calling.arguments = renamed_list(calling.arguments)
}

func rename_compare_exchange(exchanging: LowIntermediaryRepresentation.Instructions.CompareExchange) {
    exchanging.address = renamed(exchanging.address)
    exchanging.expected = renamed(exchanging.expected)
    exchanging.desired = renamed(exchanging.desired)
}

func rename_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    stop.numbers = renamed_list(stop.numbers)
}

func rename_exit(exit: LowIntermediaryRepresentation.Instructions.Exit) {
    exit.code = renamed(exit.code)
}

func renamed_definition(register: Integer): Integer {
    if register < 0 or register >= definition_renames.count() {
        return register
    }
    var replacement = definition_renames[register]
    crash replacement
    if replacement < 0 {
        return register
    }
    return replacement
}

# ../OPTIMIZATIONS.md#each-write-of-a-variable-is-a-value-of-its-own
func rename_definitions(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: rename_constant_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: rename_copy_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: rename_arithmetic_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: rename_compare_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: rename_decimal_arithmetic_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: rename_decimal_compare_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: rename_decimal_conversion_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Load: rename_load_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Call: rename_call_definition(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: rename_call_at_definition(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: rename_foreign_address_definition(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: rename_data_address_definition(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: rename_function_address_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: rename_allocate_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: rename_resize_definition(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: rename_open_library_definition(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: rename_frame_address_definition(instruction)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: rename_thread_identity_definition(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: rename_frame_room_definition(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: rename_start_thread_definition(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: rename_atomic_add_definition(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: rename_import_call_definition(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: rename_compare_exchange_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Select: rename_select_definition(instruction)
        LowIntermediaryRepresentation.Instructions.Store: return
        LowIntermediaryRepresentation.Instructions.Retain: return
        LowIntermediaryRepresentation.Instructions.Free: return
        LowIntermediaryRepresentation.Instructions.CopyBytes: return
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.Branch: return
        LowIntermediaryRepresentation.Instructions.Return: return
        LowIntermediaryRepresentation.Instructions.JoinThread: return
        LowIntermediaryRepresentation.Instructions.Stop: return
        LowIntermediaryRepresentation.Instructions.Exit: return
        LowIntermediaryRepresentation.Instructions.VectorLoop: crash
    }
}


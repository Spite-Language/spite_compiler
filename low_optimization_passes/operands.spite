var uses = List<Integer>()
var defines = List<Integer>()

func read(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    uses.clear()
    defines.clear()
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: read_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: read_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: read_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: read_compare(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalArithmetic: read_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalCompare: read_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalConversion: read_single(instruction.target, instruction.source)
        LowIntermediaryRepresentation.Instructions.Load: read_single(instruction.target, instruction.address)
        LowIntermediaryRepresentation.Instructions.Store: read_store(instruction)
        LowIntermediaryRepresentation.Instructions.Call: read_call(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: read_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: read_single(instruction.target, instruction.library)
        LowIntermediaryRepresentation.Instructions.DataAddress: read_data_address(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: read_function_address(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: read_single(instruction.target, instruction.size)
        LowIntermediaryRepresentation.Instructions.Retain: use(instruction.object)
        LowIntermediaryRepresentation.Instructions.Free: use(instruction.pointer)
        LowIntermediaryRepresentation.Instructions.Resize: read_pair(instruction.target, instruction.pointer, instruction.size)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: read_single(instruction.target, instruction.name)
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.Branch: use(instruction.condition)
        LowIntermediaryRepresentation.Instructions.Return: read_return(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: read_frame_address(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: define(instruction.target)
        LowIntermediaryRepresentation.Instructions.StartThread: read_single(instruction.target, instruction.block)
        LowIntermediaryRepresentation.Instructions.JoinThread: use(instruction.thread)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: read_atomic_add(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: read_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: read_compare_exchange(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: read_stop(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: use(instruction.code)
    }
}

func use(register: Integer) {
    if register >= 0 {
        uses.append(register)
    }
}

func define(register: Integer) {
    if register >= 0 {
        defines.append(register)
    }
}

func read_constant(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    define(constant.target)
}

func read_data_address(address: LowIntermediaryRepresentation.Instructions.DataAddress) {
    define(address.target)
}

func read_function_address(address: LowIntermediaryRepresentation.Instructions.FunctionAddress) {
    define(address.target)
}

func read_frame_address(address: LowIntermediaryRepresentation.Instructions.FrameAddress) {
    define(address.target)
}

func read_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    read_pair(arithmetic.target, arithmetic.left, arithmetic.right)
}

func read_compare(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    read_pair(compare.target, compare.left, compare.right)
}

func read_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.DecimalArithmetic) {
    read_pair(arithmetic.target, arithmetic.left, arithmetic.right)
}

func read_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.DecimalCompare) {
    read_pair(compare.target, compare.left, compare.right)
}

func read_atomic_add(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    read_single(adding.target, adding.address)
}

func read_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    use(copy.source)
    define(copy.target)
}

func read_single(target: Integer, source: Integer) {
    use(source)
    define(target)
}

func read_pair(target: Integer, left: Integer, right: Integer) {
    use(left)
    use(right)
    define(target)
}

func read_store(store: LowIntermediaryRepresentation.Instructions.Store) {
    use(store.address)
    use(store.source)
}

func read_call(call: LowIntermediaryRepresentation.Instructions.Call) {
    call.arguments.each(use)
    define(call.target)
    define(call.presence)
}

func read_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    call.arguments.each(use)
    use(call.address)
    define(call.target)
    define(call.presence)
}

func read_return(returned: LowIntermediaryRepresentation.Instructions.Return) {
    use(returned.source)
    use(returned.presence)
}

func read_import_call(calling: LowIntermediaryRepresentation.Instructions.ImportCall) {
    calling.arguments.each(use)
    define(calling.target)
}

func read_compare_exchange(exchanging: LowIntermediaryRepresentation.Instructions.CompareExchange) {
    use(exchanging.address)
    use(exchanging.expected)
    use(exchanging.desired)
    define(exchanging.target)
}

func read_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    stop.numbers.each(use)
}

func most_register_of(function: LowIntermediaryRepresentation.LowFunction): Integer {
    var most = function.register_count
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            read(instruction)
            most = at_least_past(most, uses)
            most = at_least_past(most, defines)
            index = index + 1
        }
        block_index = block_index + 1
    }
    return most
}

func at_least_past(most: Integer, registers: List<Integer>): Integer {
    var found = most
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        if register >= found {
            found = register + 1
        }
        index = index + 1
    }
    return found
}

func is_pure(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Arithmetic {
        return not instruction.is_checked and instruction.operator != 'divide' and instruction.operator != 'remainder'
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Constant {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Copy {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Compare {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.DecimalArithmetic {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.DecimalCompare {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.DecimalConversion {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.DataAddress {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.FunctionAddress {
        return true
    }
    return false
}

func retarget(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return retarget_constant(instruction, replaced, replacement)
        LowIntermediaryRepresentation.Instructions.Copy: return retarget_copy(instruction, replaced, replacement)
        LowIntermediaryRepresentation.Instructions.Arithmetic: return retarget_arithmetic(instruction, replaced, replacement)
        LowIntermediaryRepresentation.Instructions.Compare: return retarget_compare(instruction, replaced, replacement)
        LowIntermediaryRepresentation.Instructions.Load: return retarget_load(instruction, replaced, replacement)
        LowIntermediaryRepresentation.Instructions.Call: return retarget_call(instruction, replaced, replacement)
        _: return false
    }
}

func retarget_constant(
    constant: LowIntermediaryRepresentation.Instructions.Constant,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    crash constant.target == replaced
    constant.target = replacement
    return true
}

func retarget_copy(
    copy: LowIntermediaryRepresentation.Instructions.Copy,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    crash copy.target == replaced
    copy.target = replacement
    return true
}

func retarget_arithmetic(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    crash arithmetic.target == replaced
    arithmetic.target = replacement
    return true
}

func retarget_compare(
    compare: LowIntermediaryRepresentation.Instructions.Compare,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    crash compare.target == replaced
    compare.target = replacement
    return true
}

func retarget_load(
    loaded: LowIntermediaryRepresentation.Instructions.Load,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    crash loaded.target == replaced
    loaded.target = replacement
    return true
}

func retarget_call(
    call: LowIntermediaryRepresentation.Instructions.Call,
    replaced: Integer,
    replacement: Integer,
): Boolean {
    if call.target == replaced {
        call.target = replacement
        return true
    }
    crash call.presence == replaced
    call.presence = replacement
    return true
}

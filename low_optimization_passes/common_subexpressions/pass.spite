union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var keys = List<String>()
var targets = List<Integer>()
var lefts = List<Integer>()
var rights = List<Integer>()
var loaded = List<Boolean>()
var offsets = List<Integer>()
var regions = List<String>()
var most_kept = 64
var flow = LowOptimizationPasses.Flow()
var definitions = List<Integer>()
var leaving_keys = List<List<String>>()
var leaving_targets = List<List<Integer>>()
var visited = List<Boolean>()
var flowing_keys = List<String>()
var flowing_targets = List<Integer>()
var most_flowing = 128
var largest_function = 400
var defining = List<Instruction?>()
var _largest_integer: Long = 2147483647
var _largest_unsigned_integer: Long = 4294967295

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    count_the_definitions()
    function.blocks.each(share_in_block)
    if function.blocks.count() <= largest_function {
        share_across_blocks()
    }
    return function
}

func share_across_blocks() {
    flow.find_the_edges(function)
    var count = function.blocks.count()
    var index = 0
    while index < count {
        var no_keys = List<String>()
        var no_targets = List<Integer>()
        leaving_keys.append(no_keys)
        leaving_targets.append(no_targets)
        visited.append(false)
        index = index + 1
    }
    var changed = true
    var round = 0
    while changed and round < 16 {
        changed = false
        var block_index = 0
        while block_index < count {
            if flow_through(block_index, false) {
                changed = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
    fallback not changed
    var block_index = 0
    while block_index < count {
        rewrite_the_block(block_index)
        block_index = block_index + 1
    }
}

func count_the_definitions() {
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        defining.append(null)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            if operands.defines.count() == 1 {
                var defined = operands.defines[0]
                crash defined
                defining[defined] = instruction
            }
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func is_stable(register: Integer): Boolean {
    fallback register >= 0 and register < definitions.count()
    return definitions[register] == 1
}

func rewrite_the_block(block_index: Integer) {
    fallback flow_through(block_index, true)
}

func flow_through(block_index: Integer, rewrites: Boolean): Boolean {
    enter_the_block(block_index)
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        var key = stable_key_of(instruction)
        if key.is_empty() {
            forget_the_flowing_writes(instruction)
            forget_the_redefined(instruction)
            if instruction.class == LowIntermediaryRepresentation.Instructions.Store {
                flow_a_stored_value(instruction)
            }
        } else {
            var shared = shared_from_before(instruction, key)
            if rewrites and shared {
                block.instructions[index] = shared
            }
        }
        index = index + 1
    }
    var changed = visited[block_index] != true or not same_keys(block_index)
    visited[block_index] = true
    leaving_keys[block_index] = flowing_keys
    leaving_targets[block_index] = flowing_targets
    return changed
}

func shared_from_before(
    instruction: Instruction,
    key: String,
): Instruction? {
    operands.read(instruction)
    var target = operands.defines[0]
    crash target
    var found = flowing_index(key)
    if found < 0 {
        if flowing_keys.count() < most_flowing {
            flowing_keys.append(key)
            flowing_targets.append(target)
        }
        return null
    }
    var earlier = flowing_targets[found]
    crash earlier
    fallback earlier != target
    return LowIntermediaryRepresentation.Instructions.Copy(target, earlier)
}

func flow_a_stored_value(stored: LowIntermediaryRepresentation.Instructions.Store) {
    fallback is_stable(stored.address) and is_stable(stored.source)
    flow_a_stored_sign(stored, true)
    flow_a_stored_sign(stored, false)
}

func flow_a_stored_sign(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean) {
    var key = forwarded_key(stored, signed)
    if not key.is_empty() and flowing_keys.count() < most_flowing and flowing_index(key) < 0 {
        flowing_keys.append(key)
        flowing_targets.append(stored.source)
    }
}

func forwarded_key(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean): String {
    fallback fits_as(stored, signed)
    var shape = "{stored.width} {signed} {stored.is_swapped}"
    return "load {shape} in {stored.region} r{stored.address} {stored.offset}"
}

func fits_as(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean): Boolean {
    if stored.width == 'bits_64' {
        return true
    }
    fallback stored.width == 'bits_32' and is_stable(stored.source)
    var source = defining[stored.source]
    fallback source
    switch source {
        LowIntermediaryRepresentation.Instructions.Arithmetic: return fits_from_arithmetic(source, signed)
        LowIntermediaryRepresentation.Instructions.Load: return fits_from_a_load(source, stored, signed)
        LowIntermediaryRepresentation.Instructions.Constant: return fits_from_a_constant(source, signed)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return not signed and not source.is_double
        LowIntermediaryRepresentation.Instructions.Copy: return false
        LowIntermediaryRepresentation.Instructions.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.Store: return false
        LowIntermediaryRepresentation.Instructions.Call: return false
        LowIntermediaryRepresentation.Instructions.CallAt: return false
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Allocate: return false
        LowIntermediaryRepresentation.Instructions.Retain: return false
        LowIntermediaryRepresentation.Instructions.Free: return false
        LowIntermediaryRepresentation.Instructions.Resize: return false
        LowIntermediaryRepresentation.Instructions.CopyBytes: return false
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Return: return false
        LowIntermediaryRepresentation.Instructions.FrameAddress: return false
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return false
        LowIntermediaryRepresentation.Instructions.FrameRoom: return false
        LowIntermediaryRepresentation.Instructions.StartThread: return false
        LowIntermediaryRepresentation.Instructions.JoinThread: return false
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return false
        LowIntermediaryRepresentation.Instructions.ImportCall: return false
        LowIntermediaryRepresentation.Instructions.CompareExchange: return false
        LowIntermediaryRepresentation.Instructions.Stop: return false
        LowIntermediaryRepresentation.Instructions.Exit: return false
        LowIntermediaryRepresentation.Instructions.VectorLoop: return false
        LowIntermediaryRepresentation.Instructions.Select: return false
    }
}

func fits_from_arithmetic(made: LowIntermediaryRepresentation.Instructions.Arithmetic, signed: Boolean): Boolean {
    var adds = made.operator == 'add' or made.operator == 'subtract'
    return adds and made.is_checked and made.width == 'bits_32' and made.is_signed == signed
}

func fits_from_a_load(
    loaded_value: LowIntermediaryRepresentation.Instructions.Load,
    stored: LowIntermediaryRepresentation.Instructions.Store,
    signed: Boolean,
): Boolean {
    var same_shape = loaded_value.width == 'bits_32' and loaded_value.is_signed == signed
    return same_shape and loaded_value.is_swapped == stored.is_swapped
}

func fits_from_a_constant(constant: LowIntermediaryRepresentation.Instructions.Constant, signed: Boolean): Boolean {
    if signed {
        return constant.number >= -2147483648 and constant.number <= _largest_integer
    }
    return constant.number >= 0 and constant.number <= _largest_unsigned_integer
}

func flowing_index(key: String): Integer {
    var index = 0
    while index < flowing_keys.count() {
        var known = flowing_keys[index]
        if known == key {
            return index
        }
        index = index + 1
    }
    return -1
}

func same_keys(block_index: Integer): Boolean {
    var before = leaving_keys[block_index]
    crash before
    fallback before.count() == flowing_keys.count()
    var index = 0
    while index < before.count() {
        var key = before[index]
        fallback flowing_keys.contains(key)
        index = index + 1
    }
    return true
}

func enter_the_block(block_index: Integer) {
    flowing_keys = List<String>()
    flowing_targets = List<Integer>()
    fallback block_index != 0
    var coming = flow.predecessors_of(block_index)
    var first = true
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        if visited[predecessor] == true {
            meet_with(predecessor, first)
            first = false
        }
        index = index + 1
    }
}

func meet_with(predecessor: Integer, first: Boolean) {
    var keys_there = leaving_keys[predecessor]
    var targets_there = leaving_targets[predecessor]
    crash keys_there
    crash targets_there
    if first {
        var index = 0
        while index < keys_there.count() {
            var key = keys_there[index]
            var target = targets_there[index]
            crash target
            flowing_keys.append(key)
            flowing_targets.append(target)
            index = index + 1
        }
        return
    }
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var there = keys_there.index_of(key)
        if there {
            var other = targets_there[there]
            if other == target {
                kept_keys.append(key)
                kept_targets.append(target)
            }
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

func forget_the_flowing_writes(instruction: Instruction) {
    var only_counts = instruction.class == LowIntermediaryRepresentation.Instructions.Retain
    fallback only_counts or writes_memory(instruction)
    if instruction.class == LowIntermediaryRepresentation.Instructions.Store and not instruction.region.is_empty() {
        forget_the_flowing_loads_in(instruction.region)
        return
    }
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var is_a_load = key.starts_with("load ")
        var counted = key.ends_with(" 8")
        if not is_a_load or only_counts and not counted {
            kept_keys.append(key)
            kept_targets.append(target)
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

# ../../OPTIMIZATIONS.md#common-subexpressions-across-blocks
func forget_the_redefined(instruction: Instruction) {
    operands.read(instruction)
    var defined = operands.defines.copy()
    fallback not defined.is_empty()
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        if not defined.contains(target) and not names_any(key, defined) {
            kept_keys.append(key)
            kept_targets.append(target)
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

func names_any(key: String, registers: List<Integer>): Boolean {
    var words = key.split(" ")
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        if words.contains("r{register}") {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-write-to-one-attribute-keeps-what-was-read-from-another
func forget_the_flowing_loads_in(region: String) {
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var same = " in {region} r"
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var is_a_load = key.starts_with("load ")
        var touched = key.contains(same) or key.contains(" in  r")
        if not is_a_load or not touched {
            kept_keys.append(key)
            kept_targets.append(target)
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

func stable_key_of(instruction: Instruction): String {
    var key = key_of(instruction)
    fallback not key.is_empty()
    operands.read(instruction)
    fallback operands.defines.count() == 1
    var target = operands.defines[0]
    fallback is_stable(target) and target >= function.parameter_count
    return key
}

func forget_everything() {
    keys.clear()
    targets.clear()
    lefts.clear()
    rights.clear()
    loaded.clear()
    offsets.clear()
    regions.clear()
}

func share_in_block(block: LowIntermediaryRepresentation.LowBlock) {
    forget_everything()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        var key = key_of(instruction)
        if instruction.class == LowIntermediaryRepresentation.Instructions.Constant {
            key = constant_key(instruction)
        }
        var found = -1
        if not key.is_empty() {
            found = available(key)
        }
        operands.read(instruction)
        var target = -1
        if operands.defines.count() == 1 {
            var defined = operands.defines[0]
            target = defined
        }
        if found >= 0 and target >= 0 and found != target {
            var shared = LowIntermediaryRepresentation.Instructions.Copy(target, found)
            block.instructions[index] = shared
            forget_the_writes(instruction)
            forget_the_register(target)
        } else {
            forget_the_writes(instruction)
            operands.read(instruction)
            operands.defines.each(forget_the_register)
            if not key.is_empty() and target >= 0 {
                remember(instruction, key, target)
            }
            if instruction.class == LowIntermediaryRepresentation.Instructions.Store {
                remember_a_store(instruction)
            }
        }
        index = index + 1
    }
}

func available(key: String): Integer {
    var index = 0
    while index < keys.count() {
        var known = keys[index]
        if known == key {
            var found = targets[index]
            crash found
            return found
        }
        index = index + 1
    }
    return -1
}

func remember(instruction: Instruction, key: String, target: Integer) {
    operands.read(instruction)
    fallback not operands.uses.contains(target) and keys.count() < most_kept
    var left = -1
    var right = -1
    if operands.uses.count() > 0 {
        var first = operands.uses[0]
        left = first
    }
    if operands.uses.count() > 1 {
        var second = operands.uses[1]
        right = second
    }
    keys.append(key)
    targets.append(target)
    lefts.append(left)
    rights.append(right)
    var is_a_load = false
    if instruction.class == LowIntermediaryRepresentation.Instructions.Load {
        is_a_load = not instruction.is_invariant
    }
    loaded.append(is_a_load)
    var offset = -1
    var region = ""
    if instruction.class == LowIntermediaryRepresentation.Instructions.Load {
        offset = instruction.offset
        region = instruction.region
    }
    offsets.append(offset)
    regions.append(region)
}

func remember_a_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    fallback stored.address != stored.source
    remember_a_stored_sign(stored, true)
    remember_a_stored_sign(stored, false)
}

func remember_a_stored_sign(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean) {
    var key = forwarded_key(stored, signed)
    fallback not key.is_empty() and keys.count() < most_kept and available(key) < 0
    keys.append(key)
    targets.append(stored.source)
    lefts.append(stored.address)
    rights.append(stored.source)
    loaded.append(true)
    offsets.append(stored.offset)
    regions.append(stored.region)
}

func forget_the_register(register: Integer) {
    var index = keys.count() - 1
    while index >= 0 {
        var target = targets[index]
        var left = lefts[index]
        var right = rights[index]
        if target == register or left == register or right == register {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_at(index: Integer) {
    keys.remove_at(index)
    targets.remove_at(index)
    lefts.remove_at(index)
    rights.remove_at(index)
    loaded.remove_at(index)
    offsets.remove_at(index)
    regions.remove_at(index)
}

func forget_the_writes(instruction: Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Retain {
        forget_the_loads_at(8)
        return
    }
    fallback writes_memory(instruction)
    if instruction.class == LowIntermediaryRepresentation.Instructions.Store and not instruction.region.is_empty() {
        forget_the_loads_in(instruction.region)
        return
    }
    forget_the_loads_at(-1)
}

# ../../OPTIMIZATIONS.md#a-write-to-one-attribute-keeps-what-was-read-from-another
func forget_the_loads_in(region: String) {
    var index = keys.count() - 1
    while index >= 0 {
        var is_a_load = loaded[index] == true
        var other = regions[index]
        crash other
        if is_a_load and (other.is_empty() or other == region) {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_the_loads_at(offset: Integer) {
    var index = keys.count() - 1
    while index >= 0 {
        var is_a_load = loaded[index] == true
        var at = offsets[index]
        if is_a_load and (offset < 0 or at == offset) {
            forget_at(index)
        }
        index = index - 1
    }
}

func writes_memory(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return false
        LowIntermediaryRepresentation.Instructions.Copy: return false
        LowIntermediaryRepresentation.Instructions.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.Load: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Store: return true
        LowIntermediaryRepresentation.Instructions.Call: return true
        LowIntermediaryRepresentation.Instructions.CallAt: return true
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return true
        LowIntermediaryRepresentation.Instructions.Allocate: return true
        LowIntermediaryRepresentation.Instructions.Retain: return true
        LowIntermediaryRepresentation.Instructions.Free: return true
        LowIntermediaryRepresentation.Instructions.Resize: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return true
        LowIntermediaryRepresentation.Instructions.Return: return true
        LowIntermediaryRepresentation.Instructions.FrameAddress: return true
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return true
        LowIntermediaryRepresentation.Instructions.FrameRoom: return true
        LowIntermediaryRepresentation.Instructions.StartThread: return true
        LowIntermediaryRepresentation.Instructions.JoinThread: return true
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return true
        LowIntermediaryRepresentation.Instructions.ImportCall: return true
        LowIntermediaryRepresentation.Instructions.CompareExchange: return true
        LowIntermediaryRepresentation.Instructions.Stop: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
        LowIntermediaryRepresentation.Instructions.VectorLoop: return true
        LowIntermediaryRepresentation.Instructions.Select: return true
    }
}

func key_of(instruction: Instruction): String {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Arithmetic: return arithmetic_key(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return decimal_key(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return conversion_key(instruction)
        LowIntermediaryRepresentation.Instructions.Load: return load_key(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: return "data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return "function {instruction.function}"
        LowIntermediaryRepresentation.Instructions.Constant: return ""
        LowIntermediaryRepresentation.Instructions.Copy: return ""
        LowIntermediaryRepresentation.Instructions.Compare: return ""
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return ""
        LowIntermediaryRepresentation.Instructions.Store: return ""
        LowIntermediaryRepresentation.Instructions.Call: return ""
        LowIntermediaryRepresentation.Instructions.CallAt: return ""
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return ""
        LowIntermediaryRepresentation.Instructions.Allocate: return ""
        LowIntermediaryRepresentation.Instructions.Retain: return ""
        LowIntermediaryRepresentation.Instructions.Free: return ""
        LowIntermediaryRepresentation.Instructions.Resize: return ""
        LowIntermediaryRepresentation.Instructions.CopyBytes: return ""
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return ""
        LowIntermediaryRepresentation.Instructions.Jump: return ""
        LowIntermediaryRepresentation.Instructions.Branch: return ""
        LowIntermediaryRepresentation.Instructions.Return: return ""
        LowIntermediaryRepresentation.Instructions.FrameAddress: return ""
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return ""
        LowIntermediaryRepresentation.Instructions.FrameRoom: return ""
        LowIntermediaryRepresentation.Instructions.StartThread: return ""
        LowIntermediaryRepresentation.Instructions.JoinThread: return ""
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return ""
        LowIntermediaryRepresentation.Instructions.ImportCall: return ""
        LowIntermediaryRepresentation.Instructions.CompareExchange: return ""
        LowIntermediaryRepresentation.Instructions.Stop: return ""
        LowIntermediaryRepresentation.Instructions.Exit: return ""
        LowIntermediaryRepresentation.Instructions.VectorLoop: return ""
        LowIntermediaryRepresentation.Instructions.Select: return ""
    }
}

func arithmetic_key(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    fallback not arithmetic.is_checked and arithmetic.operator != 'divide' and arithmetic.operator != 'remainder'
    var left = arithmetic.left
    var right = arithmetic.right
    var turns = arithmetic.operator == 'add' or arithmetic.operator == 'multiply'
    turns = turns or arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    turns = turns or arithmetic.operator == 'bits_xor'
    if turns and right < left {
        left = arithmetic.right
        right = arithmetic.left
    }
    return "{arithmetic.operator} {arithmetic.width} {arithmetic.is_signed} r{left} r{right}"
}

# ../../OPTIMIZATIONS.md#the-same-computation-in-a-block-is-made-once
func constant_key(constant: LowIntermediaryRepresentation.Instructions.Constant): String {
    fallback constant.number != 0 and is_stable(constant.target) and constant.target >= function.parameter_count
    return "constant {constant.number}"
}

func decimal_key(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic): String {
    return "decimal {arithmetic.operator} {arithmetic.is_double} r{arithmetic.left} r{arithmetic.right}"
}

func conversion_key(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion): String {
    var sizes = "{conversion.from_decimal_size} {conversion.to_decimal_size}"
    return "conversion {sizes} {conversion.whole_is_signed} {conversion.whole_width} r{conversion.source}"
}

func load_key(loaded_value: LowIntermediaryRepresentation.Instructions.Load): String {
    var shape = "{loaded_value.width} {loaded_value.is_signed} {loaded_value.is_swapped}"
    if loaded_value.is_invariant {
        return "invariant load {shape} r{loaded_value.address} {loaded_value.offset}"
    }
    return "load {shape} in {loaded_value.region} r{loaded_value.address} {loaded_value.offset}"
}

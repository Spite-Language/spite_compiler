var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var keys = List<String>()
var targets = List<Integer>()
var lefts = List<Integer>()
var rights = List<Integer>()
var loaded = List<Boolean>()
var offsets = List<Integer>()
var regions = List<String>()
var most_kept = 64
var flow = LowOptimizationPasses.Flow()
var definitions = List<Integer>()
var leaving_keys = List<List<String>>()
var leaving_targets = List<List<Integer>>()
var visited = List<Boolean>()
var flowing_keys = List<String>()
var flowing_targets = List<Integer>()
var most_flowing = 128
var largest_function = 400
var defining = List<LowIntermediaryRepresentation.Instructions.Instruction?>()

func Pass(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func transformed(): LowIntermediaryRepresentation.LowFunction {
    if function.is_resumable {
        return function
    }
    count_the_definitions()
    function.blocks.each(share_in_block)
    if function.blocks.count() <= largest_function {
        share_across_blocks()
    }
    return function
}

func share_across_blocks() {
    flow.find_the_edges(function)
    var count = function.blocks.count()
    var index = 0
    while index < count {
        var no_keys = List<String>()
        var no_targets = List<Integer>()
        leaving_keys.append(no_keys)
        leaving_targets.append(no_targets)
        visited.append(false)
        index = index + 1
    }
    var changed = true
    var round = 0
    while changed and round < 16 {
        changed = false
        var block_index = 0
        while block_index < count {
            if flow_through(block_index, false) {
                changed = true
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
    var block_index = 0
    while block_index < count {
        flow_through(block_index, true)
        block_index = block_index + 1
    }
}

func count_the_definitions() {
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        defining.append(null)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            if operands.defines.count() == 1 {
                var defined = operands.defines[0]
                crash defined
                defining[defined] = instruction
            }
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func is_stable(register: Integer): Boolean {
    if register < 0 or register >= definitions.count() {
        return false
    }
    return definitions[register] == 1
}

func flow_through(block_index: Integer, rewrites: Boolean): Boolean {
    enter_the_block(block_index)
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        var key = stable_key_of(instruction)
        if key.is_empty() {
            forget_the_flowing_writes(instruction)
            if instruction == LowIntermediaryRepresentation.Instructions.Store {
                flow_a_stored_value(instruction)
            }
        } else {
            var shared = shared_from_before(instruction, key)
            if rewrites and shared {
                block.instructions[index] = shared
            }
        }
        index = index + 1
    }
    var changed = visited[block_index] != true or not same_keys(block_index)
    visited[block_index] = true
    leaving_keys[block_index] = flowing_keys
    leaving_targets[block_index] = flowing_targets
    return changed
}

func shared_from_before(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    key: String,
): LowIntermediaryRepresentation.Instructions.Instruction? {
    operands.read(instruction)
    var target = operands.defines[0]
    crash target
    var found = flowing_index(key)
    if found < 0 {
        if flowing_keys.count() < most_flowing {
            flowing_keys.append(key)
            flowing_targets.append(target)
        }
        return null
    }
    var earlier = flowing_targets[found]
    crash earlier
    assert earlier != target
    return LowIntermediaryRepresentation.Instructions.Copy(target, earlier)
}

func flow_a_stored_value(stored: LowIntermediaryRepresentation.Instructions.Store) {
    assert is_stable(stored.address) and is_stable(stored.source)
    flow_a_stored_sign(stored, true)
    flow_a_stored_sign(stored, false)
}

func flow_a_stored_sign(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean) {
    var key = forwarded_key(stored, signed)
    if not key.is_empty() and flowing_keys.count() < most_flowing and flowing_index(key) < 0 {
        flowing_keys.append(key)
        flowing_targets.append(stored.source)
    }
}

func forwarded_key(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean): String {
    if not fits_as(stored, signed) {
        return ""
    }
    var shape = "{stored.width} {signed} {stored.is_swapped}"
    return "load {shape} in {stored.region} r{stored.address} {stored.offset}"
}

func fits_as(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean): Boolean {
    if stored.width == 'bits_64' {
        return true
    }
    if stored.width != 'bits_32' or not is_stable(stored.source) {
        return false
    }
    var source = defining[stored.source]
    if not source {
        return false
    }
    switch source {
        LowIntermediaryRepresentation.Instructions.Arithmetic: return fits_from_arithmetic(source, signed)
        LowIntermediaryRepresentation.Instructions.Load: return fits_from_a_load(source, stored, signed)
        LowIntermediaryRepresentation.Instructions.Constant: return fits_from_a_constant(source, signed)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return not signed and not source.is_double
        _: return false
    }
}

func fits_from_arithmetic(made: LowIntermediaryRepresentation.Instructions.Arithmetic, signed: Boolean): Boolean {
    var adds = made.operator == 'add' or made.operator == 'subtract'
    return adds and made.is_checked and made.width == 'bits_32' and made.is_signed == signed
}

func fits_from_a_load(
    loaded_value: LowIntermediaryRepresentation.Instructions.Load,
    stored: LowIntermediaryRepresentation.Instructions.Store,
    signed: Boolean,
): Boolean {
    var same_shape = loaded_value.width == 'bits_32' and loaded_value.is_signed == signed
    return same_shape and loaded_value.is_swapped == stored.is_swapped
}

func fits_from_a_constant(constant: LowIntermediaryRepresentation.Instructions.Constant, signed: Boolean): Boolean {
    if signed {
        return constant.number >= -2147483648 and constant.number <= 2147483647
    }
    return constant.number >= 0 and constant.number <= 4294967295
}

func flowing_index(key: String): Integer {
    var index = 0
    while index < flowing_keys.count() {
        var known = flowing_keys[index]
        if known == key {
            return index
        }
        index = index + 1
    }
    return -1
}

func same_keys(block_index: Integer): Boolean {
    var before = leaving_keys[block_index]
    crash before
    if before.count() != flowing_keys.count() {
        return false
    }
    var index = 0
    while index < before.count() {
        var key = before[index]
        if not flowing_keys.contains(key) {
            return false
        }
        index = index + 1
    }
    return true
}

func enter_the_block(block_index: Integer) {
    flowing_keys = List<String>()
    flowing_targets = List<Integer>()
    assert block_index != 0
    var coming = flow.predecessors_of(block_index)
    var first = true
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        if visited[predecessor] == true {
            meet_with(predecessor, first)
            first = false
        }
        index = index + 1
    }
}

func meet_with(predecessor: Integer, first: Boolean) {
    var keys_there = leaving_keys[predecessor]
    var targets_there = leaving_targets[predecessor]
    crash keys_there
    crash targets_there
    if first {
        var index = 0
        while index < keys_there.count() {
            var key = keys_there[index]
            var target = targets_there[index]
            crash target
            flowing_keys.append(key)
            flowing_targets.append(target)
            index = index + 1
        }
        return
    }
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var there = keys_there.index_of(key)
        if there {
            var other = targets_there[there]
            if other == target {
                kept_keys.append(key)
                kept_targets.append(target)
            }
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

func forget_the_flowing_writes(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    var only_counts = instruction == LowIntermediaryRepresentation.Instructions.Retain
    assert only_counts or writes_memory(instruction)
    if instruction == LowIntermediaryRepresentation.Instructions.Store and not instruction.region.is_empty() {
        forget_the_flowing_loads_in(instruction.region)
        return
    }
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var is_a_load = key.starts_with("load ")
        var counted = key.ends_with(" 8")
        if not is_a_load or only_counts and not counted {
            kept_keys.append(key)
            kept_targets.append(target)
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

# ../../OPTIMIZATIONS.md#a-write-to-one-attribute-keeps-what-was-read-from-another
func forget_the_flowing_loads_in(region: String) {
    var kept_keys = List<String>()
    var kept_targets = List<Integer>()
    var same = " in {region} r"
    var index = 0
    while index < flowing_keys.count() {
        var key = flowing_keys[index]
        var target = flowing_targets[index]
        crash target
        var is_a_load = key.starts_with("load ")
        var touched = key.contains(same) or key.contains(" in  r")
        if not is_a_load or not touched {
            kept_keys.append(key)
            kept_targets.append(target)
        }
        index = index + 1
    }
    flowing_keys = kept_keys
    flowing_targets = kept_targets
}

func stable_key_of(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    var key = key_of(instruction)
    if key.is_empty() {
        return ""
    }
    operands.read(instruction)
    if operands.defines.count() != 1 {
        return ""
    }
    var target = operands.defines[0]
    if not is_stable(target) or target < function.parameter_count {
        return ""
    }
    var index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        if not is_stable(used) {
            return ""
        }
        index = index + 1
    }
    return key
}

func forget_everything() {
    keys.clear()
    targets.clear()
    lefts.clear()
    rights.clear()
    loaded.clear()
    offsets.clear()
    regions.clear()
}

func share_in_block(block: LowIntermediaryRepresentation.LowBlock) {
    forget_everything()
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        var key = key_of(instruction)
        if instruction == LowIntermediaryRepresentation.Instructions.Constant {
            key = constant_key(instruction)
        }
        var found = -1
        if not key.is_empty() {
            found = available(key)
        }
        operands.read(instruction)
        var target = -1
        if operands.defines.count() == 1 {
            var defined = operands.defines[0]
            target = defined
        }
        if found >= 0 and target >= 0 and found != target {
            var shared = LowIntermediaryRepresentation.Instructions.Copy(target, found)
            block.instructions[index] = shared
            forget_the_writes(instruction)
            forget_the_register(target)
        } else {
            forget_the_writes(instruction)
            operands.read(instruction)
            operands.defines.each(forget_the_register)
            if not key.is_empty() and target >= 0 {
                remember(instruction, key, target)
            }
            if instruction == LowIntermediaryRepresentation.Instructions.Store {
                remember_a_store(instruction)
            }
        }
        index = index + 1
    }
}

func available(key: String): Integer {
    var index = 0
    while index < keys.count() {
        var known = keys[index]
        if known == key {
            var found = targets[index]
            crash found
            return found
        }
        index = index + 1
    }
    return -1
}

func remember(instruction: LowIntermediaryRepresentation.Instructions.Instruction, key: String, target: Integer) {
    operands.read(instruction)
    assert not operands.uses.contains(target) and keys.count() < most_kept
    var left = -1
    var right = -1
    if operands.uses.count() > 0 {
        var first = operands.uses[0]
        left = first
    }
    if operands.uses.count() > 1 {
        var second = operands.uses[1]
        right = second
    }
    keys.append(key)
    targets.append(target)
    lefts.append(left)
    rights.append(right)
    var is_a_load = false
    if instruction == LowIntermediaryRepresentation.Instructions.Load {
        is_a_load = not instruction.is_invariant
    }
    loaded.append(is_a_load)
    var offset = -1
    var region = ""
    if instruction == LowIntermediaryRepresentation.Instructions.Load {
        offset = instruction.offset
        region = instruction.region
    }
    offsets.append(offset)
    regions.append(region)
}

func remember_a_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    assert stored.address != stored.source
    remember_a_stored_sign(stored, true)
    remember_a_stored_sign(stored, false)
}

func remember_a_stored_sign(stored: LowIntermediaryRepresentation.Instructions.Store, signed: Boolean) {
    var key = forwarded_key(stored, signed)
    assert not key.is_empty() and keys.count() < most_kept and available(key) < 0
    keys.append(key)
    targets.append(stored.source)
    lefts.append(stored.address)
    rights.append(stored.source)
    loaded.append(true)
    offsets.append(stored.offset)
    regions.append(stored.region)
}

func forget_the_register(register: Integer) {
    var index = keys.count() - 1
    while index >= 0 {
        var target = targets[index]
        var left = lefts[index]
        var right = rights[index]
        if target == register or left == register or right == register {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_at(index: Integer) {
    keys.remove_at(index)
    targets.remove_at(index)
    lefts.remove_at(index)
    rights.remove_at(index)
    loaded.remove_at(index)
    offsets.remove_at(index)
    regions.remove_at(index)
}

func forget_the_writes(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Retain {
        forget_the_loads_at(8)
        return
    }
    assert writes_memory(instruction)
    if instruction == LowIntermediaryRepresentation.Instructions.Store and not instruction.region.is_empty() {
        forget_the_loads_in(instruction.region)
        return
    }
    forget_the_loads_at(-1)
}

# ../../OPTIMIZATIONS.md#a-write-to-one-attribute-keeps-what-was-read-from-another
func forget_the_loads_in(region: String) {
    var index = keys.count() - 1
    while index >= 0 {
        var is_a_load = loaded[index] == true
        var other = regions[index]
        crash other
        if is_a_load and (other.is_empty() or other == region) {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_the_loads_at(offset: Integer) {
    var index = keys.count() - 1
    while index >= 0 {
        var is_a_load = loaded[index] == true
        var at = offsets[index]
        if is_a_load and (offset < 0 or at == offset) {
            forget_at(index)
        }
        index = index - 1
    }
}

func writes_memory(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return false
        LowIntermediaryRepresentation.Instructions.Copy: return false
        LowIntermediaryRepresentation.Instructions.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.Load: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        _: return true
    }
}

func key_of(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Arithmetic: return arithmetic_key(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return decimal_key(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return conversion_key(instruction)
        LowIntermediaryRepresentation.Instructions.Load: return load_key(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: return "data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return "function {instruction.function}"
        _: return ""
    }
}

func arithmetic_key(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    if arithmetic.is_checked or arithmetic.operator == 'divide' or arithmetic.operator == 'remainder' {
        return ""
    }
    var left = arithmetic.left
    var right = arithmetic.right
    var turns = arithmetic.operator == 'add' or arithmetic.operator == 'multiply'
    turns = turns or arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    turns = turns or arithmetic.operator == 'bits_xor'
    if turns and right < left {
        left = arithmetic.right
        right = arithmetic.left
    }
    return "{arithmetic.operator} {arithmetic.width} {arithmetic.is_signed} r{left} r{right}"
}

# ../../OPTIMIZATIONS.md#the-same-computation-in-a-block-is-made-once
func constant_key(constant: LowIntermediaryRepresentation.Instructions.Constant): String {
    if constant.number == 0 or not is_stable(constant.target) or constant.target < function.parameter_count {
        return ""
    }
    return "constant {constant.number}"
}

func decimal_key(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic): String {
    return "decimal {arithmetic.operator} {arithmetic.is_double} r{arithmetic.left} r{arithmetic.right}"
}

func conversion_key(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion): String {
    var sizes = "{conversion.from_decimal_size} {conversion.to_decimal_size}"
    return "conversion {sizes} {conversion.whole_is_signed} {conversion.whole_width} r{conversion.source}"
}

func load_key(loaded_value: LowIntermediaryRepresentation.Instructions.Load): String {
    var shape = "{loaded_value.width} {loaded_value.is_signed} {loaded_value.is_swapped}"
    if loaded_value.is_invariant {
        return "invariant load {shape} r{loaded_value.address} {loaded_value.offset}"
    }
    return "load {shape} in {loaded_value.region} r{loaded_value.address} {loaded_value.offset}"
}

var is_whole = false
var file_names = List<String>()
var name: String
var folder: String
var preloaded_from: String
var line: Integer
var written: String

# ../../spite_documentation/programs.md#preloaded-files
func PreloadedVolume(
    starting_name: String,
    starting_folder: String,
    starting_preloaded_from: String,
    starting_line: Integer,
    starting_written: String,
) {
    name = starting_name
    folder = starting_folder
    preloaded_from = starting_preloaded_from
    line = starting_line
    written = starting_written
}

func take(file_name: String) {
    if file_name.is_empty() {
        is_whole = true
        return
    }
    if not file_names.contains(file_name) {
        file_names.append(file_name)
    }
}

func get_key(): String {
    return "{name}://"
}

var class_name: String
var name: String
var earlier_path: String
var earlier_line: Integer
var later_path: String
var later_line: Integer

func Disagreement(
    starting_class_name: String,
    starting_name: String,
    starting_earlier_path: String,
    starting_earlier_line: Integer,
    starting_later_path: String,
    starting_later_line: Integer,
) {
    class_name = starting_class_name
    name = starting_name
    earlier_path = starting_earlier_path
    earlier_line = starting_earlier_line
    later_path = starting_later_path
    later_line = starting_later_line
}

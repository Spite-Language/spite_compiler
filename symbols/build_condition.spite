union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var flags = Dictionary<String, String>()
var defaults = Dictionary<String, String>()

func BuildCondition(starting_flags: Dictionary<String, String>, starting_defaults: Dictionary<String, String>) {
    flags = starting_flags
    defaults = starting_defaults
}

func is_a_build_condition(condition: Expression?): Boolean {
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return is_a_build_condition(condition.operand)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return binary_is_decided(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return is_a_truth(condition)
    }
    var asked = setting_asked(condition)
    return not asked.is_empty()
}

func binary_is_decided(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var joins = binary.operator == 'and' or binary.operator == 'or'
    if joins {
        return is_a_build_condition(binary.left) and is_a_build_condition(binary.right)
    }
    var asked = compared_setting(binary)
    return not asked.is_empty()
}

func is_a_truth(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Boolean {
    return literal.kind == 'keyword_true' or literal.kind == 'keyword_false'
}

func setting_asked(condition: Expression?): String {
    if condition == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return setting_of(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return setting_asked(condition.operand)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return setting_of_a_binary(condition)
    }
    return ""
}

func setting_of_a_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var joins = binary.operator == 'and' or binary.operator == 'or'
    if not joins {
        return compared_setting(binary)
    }
    var left = setting_asked(binary.left)
    var right = setting_asked(binary.right)
    fallback not left.is_empty() and not right.is_empty()
    return left
}

func compared_setting(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares
    var left = binary.left
    if left == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return setting_of(left)
    }
    return ""
}

func setting_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == "build" {
        return member.name
    }
    return ""
}

func holds(condition: Expression?): Boolean {
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return not holds(condition.operand)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return binary_holds(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return condition.kind == 'keyword_true'
    }
    var name = setting_asked(condition)
    var value = value_of(name)
    return value == "true"
}

func binary_holds(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    if binary.operator == 'and' {
        return holds(binary.left) and holds(binary.right)
    }
    if binary.operator == 'or' {
        return holds(binary.left) or holds(binary.right)
    }
    return compares_true(binary)
}

func compares_true(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var name = compared_setting(binary)
    var value = value_of(name)
    var wanted = literal_text(binary.right)
    var same = value == wanted
    if binary.operator == 'not_equal' {
        return not same
    }
    return same
}

func value_of(name: String): String {
    var given = flags[name]
    if given {
        return given
    }
    var declared = defaults[name]
    if declared {
        return declared
    }
    return ""
}

func literal_text(expression: Expression?): String {
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        return piece.text
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.text
    }
    return ""
}

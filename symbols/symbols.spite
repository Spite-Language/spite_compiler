var map = Mapping.FolderMap()
var gathering = Diagnostics.Gathering()
var program_folder: String
var build_flags: Dictionary<String, String>

func Symbols(starting_map: Mapping.FolderMap, starting_folder: String, starting_flags: Dictionary<String, String>) {
    map = starting_map
    program_folder = starting_folder
    build_flags = starting_flags
}

func run(): SymbolTable {
    var symbols = SymbolTable(map)
    symbols.build_flags = build_flags
    symbols.read_the_breakpoints()
    var entry = symbols.entry_class(program_folder)
    symbols.read_class(entry)
    var entry_file = symbols.file_for(entry.path)
    crash entry_file
    gathering.goes_on = true
    var entry_generic = Validators.AbstractSyntaxTree.EntryGeneric.Validator()
    var entry_generic_answer = entry_generic.check(entry_file, entry.simple_name)
    entry_generic_answer.tell()
    var entry_constructor = Validators.AbstractSyntaxTree.EntryConstructor.Validator()
    var entry_constructor_answer = entry_constructor.check(entry_file, entry.simple_name)
    entry_constructor_answer.tell()
    gathering.goes_on = false
    symbols.read_the_program()
    symbols.read_the_settings()
    gathering.tell_if_reading_broke()
    symbols.check_the_breakpoints()
    var fixing = Fixes.Symbols.EveryFix()
    fixing.fixed(symbols)
    var mapping_rules = Validators.Mapping.EveryRule()
    mapping_rules.check(map, entry, symbols)
    return symbols
}

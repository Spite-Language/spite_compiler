var lines = List<String>()

func fault_source(): String {
    lines = List<String>()
    add_the_fault_part_1()
    add_the_fault_part_2()
    add_the_fault_part_3()
    add_the_fault_part_4()
    return lines.join("\n")
}

func asserts_source(): String {
    lines = List<String>()
    add_the_asserts_part_1()
    return lines.join("\n")
}

func copy_table_source(): String {
    lines = List<String>()
    add_the_copy_table_part_1()
    return lines.join("\n")
}

func add_the_fault_part_1() {
    lines.append("func report(code: Long, address: Long, detail: Long, accessed: Long, frame: Long) \{")
    lines.append("    var site = _foreign_site()")
    lines.append("    var library = _foreign_library()")
    lines.append("    var console = Console()")
    lines.append("    var fields = List<String>()")
    lines.append("    fields.append(\"spite.fault\")")
    lines.append("    var kind = kind_of(code, detail)")
    lines.append("    fields.append(kind)")
    lines.append("    var place = \"-\t-\t-\"")
    lines.append("    if site == 0 \{")
    lines.append("        place = program_place(address)")
    lines.append("    }")
    lines.append("    fields.append(place)")
    lines.append("    if code == 3221225477 \{")
    lines.append("        var accessed_text = hexadecimal(accessed)")
    lines.append("        fields.append(\"address=0x\{accessed_text}\")")
    lines.append("    }")
    lines.append("    var code_text = hexadecimal(code)")
    lines.append("    if code == 3221226356 \{")
    lines.append("        fields.append(\"status=0x\{code_text}\")")
    lines.append("    } else \{")
    lines.append("        fields.append(\"code=0x\{code_text}\")")
    lines.append("    }")
    lines.append("    var module = module_place(address)")
    lines.append("    fields.append(\"at=\{module}\")")
    lines.append("    if site > 0 \{")
    lines.append("        add_the_foreign_call(fields, site, library)")
    lines.append("    }")
    lines.append("    var joined = fields.join(\"\\t\")")
    lines.append("    console.print(joined)")
    lines.append("    if site == 0 \{")
    lines.append("        named_frames(address, frame)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func add_the_foreign_call(fields: List<String>, site: Long, library: DynamicLibrary?) \{")
    lines.append("    var written = _foreign_site_text(site)")
    lines.append("    var parts = written.split(\"\\t\")")
    lines.append("    var foreign = parts[0]")
    lines.append("    var called_from = parts[1]")
    lines.append("    crash foreign")
    lines.append("    crash called_from")
    lines.append("    fields.append(foreign)")
    lines.append("    if library \{")
    lines.append("        fields.append(\"library=\{library.file_name}\")")
    lines.append("    }")
    lines.append("    fields.append(called_from)")
    lines.append("}")
    lines.append("")
    lines.append("func program_place(address: Long): String \{")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var own = kernel.GetModuleHandleA_as_long(0)")
    lines.append("    var code_offset = address - own - 4096")
    lines.append("    if code_offset < 0 \{")
    lines.append("        return \"-\t-\t-\"")
    lines.append("    }")
    lines.append("    var table = _place_table()")
    lines.append("    var count = _read_long(table)")
    lines.append("    var at = table + 8")
    lines.append("    var found = \"-\t-\t-\"")
    lines.append("    var index: Long = 0")
    lines.append("    while index < count \{")
    lines.append("        var start = _read_long(at)")
    lines.append("        var length = _read_long(at + 8)")
    lines.append("        if start > code_offset \{")
    lines.append("            return found")
    lines.append("        }")
    lines.append("        found = text_at(at + 16, length)")
    lines.append("        var padded = (length + 7) / 8 * 8")
    lines.append("        at = at + 16 + padded")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func text_at(at: Long, length: Long): String \{")
    lines.append("    var written = \"\"")
    lines.append("    var index: Long = 0")
    lines.append("    while index < length \{")
    lines.append("        var code = _read_byte(at + index)")
    lines.append("        var character: Integer = code")
    lines.append("        written.append_code(character)")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return written")
    lines.append("}")
    lines.append("")
    lines.append("func kind_of(code: Long, detail: Long): String \{")
    lines.append("    switch code \{")
    lines.append("        3221225477: return violation_of(detail)")
    lines.append("        3221225725: return \"stack-overflow\"")
    lines.append("        3221225501: return \"illegal-instruction\"")
    lines.append("        3221226356: return \"heap-corruption\"")
    lines.append("        3221225620: return \"integer-division-by-zero\"")
    lines.append("        _: return \"fault\"")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func violation_of(detail: Long): String \{")
    lines.append("    switch detail \{")
    lines.append("        0: return \"read-violation\"")
    lines.append("        1: return \"write-violation\"")
    lines.append("        _: return \"execute-violation\"")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func module_place(address: Long): String \{")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var room = Buffer(8)")
    lines.append("    room.append_long_little_endian(0)")
    lines.append("    var found = kernel.GetModuleHandleExA(6, address, room)")
    lines.append("    if found == 0 \{")
    lines.append("        var unknown = hexadecimal(address)")
    lines.append("        return \"0x\{unknown}\"")
    lines.append("    }")
    lines.append("    var module = room.read_long_little_endian_at(0)")
    lines.append("    crash module")
    lines.append("    var name_room = Buffer(260)")
    lines.append("    var length = kernel.GetModuleFileNameA(module, name_room, 260)")
    lines.append("    name_room.take_written(length)")
    lines.append("    var path = name_room.text(0, length)")
    lines.append("    crash path")
    lines.append("    var forward = path.replace(\"\\\\\", \"/\")")
}

func add_the_fault_part_2() {
    lines.append("    var pieces = forward.split(\"/\")")
    lines.append("    var last = pieces.count() - 1")
    lines.append("    var name = pieces[last]")
    lines.append("    crash name")
    lines.append("    var offset = hexadecimal(address - module)")
    lines.append("    return \"\{name}+0x\{offset}\"")
    lines.append("}")
    lines.append("")
    lines.append("func hexadecimal(value: Long): String \{")
    lines.append("    var digits = \"0123456789abcdef\"")
    lines.append("    var written = \"\"")
    lines.append("    var rest = value")
    lines.append("    var count = 0")
    lines.append("    while count < 16 \{")
    lines.append("        var nibble = rest.bits_and(15)")
    lines.append("        var digit = digits.slice(nibble, nibble + 1)")
    lines.append("        written = \"\{digit}\{written}\"")
    lines.append("        rest = rest.shifted_right(4)")
    lines.append("        count = count + 1")
    lines.append("    }")
    lines.append("    var start = 0")
    lines.append("    while start < 15 and written.slice(start, start + 1) == \"0\" \{")
    lines.append("        start = start + 1")
    lines.append("    }")
    lines.append("    return written.slice(start, 16)")
    lines.append("}")
    lines.append("")
    lines.append("func crashed(head: String, shown: String) \{")
    lines.append("    var line = head")
    lines.append("    if not shown.is_empty() \{")
    lines.append("        var length = shown.length()")
    lines.append("        var values = shown.slice(2, length)")
    lines.append("        line = \"\{head} (\{values})\"")
    lines.append("    }")
    lines.append("    written_to_the_errors(\"\{line}\\n\")")
    lines.append("}")
    lines.append("")
    lines.append("func written_to_the_errors(text: String) \{")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var errors = kernel.GetStdHandle_as_long(-12)")
    lines.append("    var room = Buffer(8)")
    lines.append("    room.append_long_little_endian(0)")
    lines.append("    var length = text.length()")
    lines.append("    kernel.WriteFile(errors, text, length, room, 0)")
    lines.append("}")
    lines.append("")
    lines.append("func cut(text: String): String \{")
    lines.append("    var length = text.length()")
    lines.append("    if length <= 80 \{")
    lines.append("        return text")
    lines.append("    }")
    lines.append("    var end = 80")
    lines.append("    while end > 0 and is_a_continuation(text, end) \{")
    lines.append("        end = end - 1")
    lines.append("    }")
    lines.append("    var kept = text.slice(0, end)")
    lines.append("    return \"\{kept}...(\{length} bytes)\"")
    lines.append("}")
    lines.append("")
    lines.append("func is_a_continuation(text: String, at: Integer): Boolean \{")
    lines.append("    var code = text.code_at(at)")
    lines.append("    return code >= 128 and code < 192")
    lines.append("}")
    lines.append("")
    lines.append("func frames() \{")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var own = kernel.GetModuleHandleA_as_long(0)")
    lines.append("    var code_start = own + 4096")
    lines.append("    var table = _call_table()")
    lines.append("    var at = _frame_pointer()")
    lines.append("    var walking = true")
    lines.append("    var steps = 0")
    lines.append("    var lines = 0")
    lines.append("    var previous = \"\"")
    lines.append("    var repeated = 0")
    lines.append("    while walking and steps < 256 \{")
    lines.append("        var returned = _read_long(at + 8)")
    lines.append("        var offset = returned - code_start")
    lines.append("        var found = call_text_index(table, offset)")
    lines.append("        walking = found >= -1")
    lines.append("        if found >= 0 \{")
    lines.append("            var text = call_text(table, found)")
    lines.append("            var frame_lines = text.split(\"\\n\")")
    lines.append("            var index = 0")
    lines.append("            while index < frame_lines.count() \{")
    lines.append("                var frame_line = frame_lines[index]")
    lines.append("                if frame_line == previous \{")
    lines.append("                    repeated = repeated + 1")
    lines.append("                } else \{")
    lines.append("                    lines = written_frame(previous, repeated, lines)")
    lines.append("                    previous = frame_line")
    lines.append("                    repeated = 1")
    lines.append("                }")
    lines.append("                index = index + 1")
    lines.append("            }")
    lines.append("        }")
    lines.append("        var next = _read_long(at)")
    lines.append("        var is_the_caller = next > at and next - at < 16777216")
    lines.append("        walking = walking and is_the_caller")
    lines.append("        at = next")
    lines.append("        steps = steps + 1")
    lines.append("    }")
    lines.append("    lines = written_frame(previous, repeated, lines)")
    lines.append("    if walking or lines > 16 \{")
    lines.append("        written_to_the_errors(\"spite.frame\\tmore\\n\")")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func written_frame(frame_line: String, repeated: Integer, lines: Integer): Integer \{")
    lines.append("    if frame_line.is_empty() \{")
    lines.append("        return lines")
    lines.append("    }")
    lines.append("    if lines >= 16 \{")
    lines.append("        return lines + 1")
    lines.append("    }")
    lines.append("    if repeated > 1 \{")
    lines.append("        written_to_the_errors(\"spite.frame\\t\{frame_line}\\trepeated=\{repeated}\\n\")")
    lines.append("    } else \{")
    lines.append("        written_to_the_errors(\"spite.frame\\t\{frame_line}\\n\")")
    lines.append("    }")
}

func add_the_fault_part_3() {
    lines.append("    return lines + 1")
    lines.append("}")
    lines.append("")
    lines.append("func call_text_index(table: Long, offset: Long): Long \{")
    lines.append("    var count = _read_long(table)")
    lines.append("    var low: Long = 0")
    lines.append("    var high = count")
    lines.append("    while low < high \{")
    lines.append("        var middle = (low + high) / 2")
    lines.append("        var entry = table + 8 + middle * 16")
    lines.append("        var start = _read_long(entry)")
    lines.append("        if start < offset \{")
    lines.append("            low = middle + 1")
    lines.append("        } else \{")
    lines.append("            high = middle")
    lines.append("        }")
    lines.append("    }")
    lines.append("    if low >= count \{")
    lines.append("        return -2")
    lines.append("    }")
    lines.append("    var found = table + 8 + low * 16")
    lines.append("    var start = _read_long(found)")
    lines.append("    if start != offset \{")
    lines.append("        return -2")
    lines.append("    }")
    lines.append("    return _read_long(found + 8)")
    lines.append("}")
    lines.append("")
    lines.append("func call_text(table: Long, index: Long): String \{")
    lines.append("    var count = _read_long(table)")
    lines.append("    var texts = table + 8 + count * 16")
    lines.append("    var placed = _read_long(texts + 8 + index * 8)")
    lines.append("    var at = texts + placed")
    lines.append("    var length = _read_long(at)")
    lines.append("    return text_at(at + 8, length)")
    lines.append("}")
    lines.append("")
    lines.append("func _call_table(): Long")
    lines.append("")
    lines.append("func _frame_pointer(): Long")
    lines.append("")
    lines.append("func _foreign_site(): Long")
    lines.append("")
    lines.append("func _foreign_site_text(site: Long): String")
    lines.append("")
    lines.append("func _foreign_library(): DynamicLibrary?")
    lines.append("")
    lines.append("func _place_table(): Long")
    lines.append("")
    lines.append("func _read_long(at: Long): Long")
    lines.append("")
    lines.append("func _read_byte(at: Long): Long")
}

func add_the_asserts_part_1() {
    lines.append("singleton")
    lines.append("")
    lines.append("var console = Console()")
    lines.append("var _sites = List<String>()")
    lines.append("var _counts = List<Integer>()")
    lines.append("var _newest = -1")
    lines.append("var _lines = 0")
    lines.append("")
    lines.append("func failed(site: String, streams: Boolean) \{")
    lines.append("    if streams \{")
    lines.append("        console.error(site)")
    lines.append("    }")
    lines.append("    if _lines > 0 and _sites[_newest] == site \{")
    lines.append("        var count = _counts[_newest]")
    lines.append("        crash count")
    lines.append("        _counts[_newest] = count + 1")
    lines.append("        return")
    lines.append("    }")
    lines.append("    _newest = (_newest + 1) % 32")
    lines.append("    if _sites.count() < 32 \{")
    lines.append("        _sites.append(site)")
    lines.append("        _counts.append(1)")
    lines.append("    } else \{")
    lines.append("        _sites[_newest] = site")
    lines.append("        _counts[_newest] = 1")
    lines.append("    }")
    lines.append("    _lines = _lines + 1")
    lines.append("}")
    lines.append("")
    lines.append("func report() \{")
    lines.append("    var kept = _sites.count()")
    lines.append("    if _lines > kept \{")
    lines.append("        var earlier = _lines - kept")
    lines.append("        console.error(\"spite.assert\\tearlier=\{earlier}\")")
    lines.append("    }")
    lines.append("    var oldest = 0")
    lines.append("    if kept == 32 \{")
    lines.append("        oldest = (_newest + 1) % 32")
    lines.append("    }")
    lines.append("    var index = 0")
    lines.append("    while index < kept \{")
    lines.append("        var place = (oldest + index) % 32")
    lines.append("        report_line(place)")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func report_line(place: Integer) \{")
    lines.append("    var site = _sites[place]")
    lines.append("    var count = _counts[place]")
    lines.append("    crash site")
    lines.append("    crash count")
    lines.append("    if count > 1 \{")
    lines.append("        console.error(\"\{site}\\trepeated=\{count}\")")
    lines.append("    } else \{")
    lines.append("        console.error(site)")
    lines.append("    }")
    lines.append("}")
}

func add_the_copy_table_part_1() {
    lines.append("var _copies = Dictionary<Long, Long>()")
    lines.append("var _settling = List<Spite.Function<Spite.CopyTable, Nothing>>()")
    lines.append("")
    lines.append("func copy_at(original: Long): Long? \{")
    lines.append("    return _copies[original]")
    lines.append("}")
    lines.append("")
    lines.append("func remember(original: Long, copied: Long) \{")
    lines.append("    _copies[original] = copied")
    lines.append("}")
    lines.append("")
    lines.append("func later(settling: Spite.Function<Spite.CopyTable, Nothing>) \{")
    lines.append("    _settling.append(settling)")
    lines.append("}")
    lines.append("")
    lines.append("func settle() \{")
    lines.append("    var index = 0")
    lines.append("    while index < _settling.count() \{")
    lines.append("        var settling = _settling[index]")
    lines.append("        settling(this)")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("}")
}

func add_the_fault_part_4() {
    lines.append("")
    lines.append("func named_frames(address: Long, frame: Long) \{")
    lines.append("    var map = function_map_text()")
    lines.append("    if map.is_empty() \{")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var own = kernel.GetModuleHandleA_as_long(0)")
    lines.append("    var code_start = own + 4096")
    lines.append("    var faulted = function_of(map, address - code_start)")
    lines.append("    written_to_the_errors(\"spite.function\\t\{faulted}\\n\")")
    lines.append("    var at = frame")
    lines.append("    var walking = at > 0")
    lines.append("    var steps = 0")
    lines.append("    var previous = \"\"")
    lines.append("    var repeated = 0")
    lines.append("    while walking and steps < 64 \{")
    lines.append("        var returned = _read_long(at + 8)")
    lines.append("        var caller = function_of(map, returned - code_start)")
    lines.append("        walking = not caller.is_empty()")
    lines.append("        if walking and caller == previous \{")
    lines.append("            repeated = repeated + 1")
    lines.append("        } else if walking \{")
    lines.append("            written_caller(previous, repeated)")
    lines.append("            previous = caller")
    lines.append("            repeated = 1")
    lines.append("        }")
    lines.append("        var next = _read_long(at)")
    lines.append("        var is_the_caller = next > at and next - at < 16777216")
    lines.append("        walking = walking and is_the_caller")
    lines.append("        at = next")
    lines.append("        steps = steps + 1")
    lines.append("    }")
    lines.append("    written_caller(previous, repeated)")
    lines.append("}")
    lines.append("")
    lines.append("func written_caller(caller: String, repeated: Integer) \{")
    lines.append("    if caller.is_empty() \{")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if repeated > 1 \{")
    lines.append("        written_to_the_errors(\"spite.caller\\t\{caller}\\trepeated=\{repeated}\\n\")")
    lines.append("    } else \{")
    lines.append("        written_to_the_errors(\"spite.caller\\t\{caller}\\n\")")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func function_map_text(): String \{")
    lines.append("    var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("    var name_room = Buffer(260)")
    lines.append("    var length = kernel.GetModuleFileNameA(0, name_room, 260)")
    lines.append("    name_room.take_written(length)")
    lines.append("    var path = name_room.text(0, length)")
    lines.append("    if not path or length < 4 \{")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    var stem = path.slice(0, length - 4)")
    lines.append("    var map_path = \"\{stem}.functions\"")
    lines.append("    var handle = kernel.CreateFileA_as_long(map_path, 2147483648, 1, 0, 3, 128, 0)")
    lines.append("    if handle == -1 \{")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    var size = kernel.GetFileSize(handle, 0)")
    lines.append("    if size <= 0 \{")
    lines.append("        kernel.CloseHandle(handle)")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    var room = Buffer(size)")
    lines.append("    var read_room = Buffer(8)")
    lines.append("    read_room.append_long_little_endian(0)")
    lines.append("    kernel.ReadFile(handle, room, size, read_room, 0)")
    lines.append("    kernel.CloseHandle(handle)")
    lines.append("    room.take_written(size)")
    lines.append("    var text = room.text(0, size)")
    lines.append("    if not text \{")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    return text")
    lines.append("}")
    lines.append("")
    lines.append("func function_of(map: String, offset: Long): String \{")
    lines.append("    if offset < 0 \{")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    var rows = map.split(\"\\n\")")
    lines.append("    var index = 1")
    lines.append("    while index < rows.count() \{")
    lines.append("        var row = rows[index]")
    lines.append("        var fields = row.split(\"\\t\")")
    lines.append("        if fields.count() == 3 \{")
    lines.append("            var start_text = fields[0]")
    lines.append("            var end_text = fields[1]")
    lines.append("            var key = fields[2]")
    lines.append("            var start = number_of_hexadecimal(start_text)")
    lines.append("            var end = number_of_hexadecimal(end_text)")
    lines.append("            if offset >= start and offset < end \{")
    lines.append("                return key")
    lines.append("            }")
    lines.append("        }")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return \"\"")
    lines.append("}")
    lines.append("")
    lines.append("func number_of_hexadecimal(text: String): Long \{")
    lines.append("    var value: Long = 0")
    lines.append("    var index = 0")
    lines.append("    while index < text.length() \{")
    lines.append("        var code = text.code_at(index)")
    lines.append("        var digit = code - 48")
    lines.append("        if code >= 97 \{")
    lines.append("            digit = code - 87")
    lines.append("        }")
    lines.append("        value = value * 16 + digit")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return value")
    lines.append("}")
}

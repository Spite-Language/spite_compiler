var lines = List<String>()

# ../../spite_spec/specs/repl.md#command-language
func breakpoint_source(): String {
    lines = List<String>()
    lines.append("singleton")
    lines.append("")
    lines.append("var console = Console()")
    lines.append("var stopper: Spite.Function<String, List<String>, Nothing>? = null")
    lines.append("")
    lines.append("func hold(stopping: Spite.Function<String, List<String>, Nothing>) \{")
    lines.append("    stopper = stopping")
    lines.append("}")
    lines.append("")
    lines.append("func let_go() \{")
    lines.append("    stopper = null")
    lines.append("}")
    lines.append("")
    lines.append("func pause_at(site: String, locals: List<String>) \{")
    lines.append("    var stopping = stopper")
    lines.append("    if stopping \{")
    lines.append("        stopping(site, locals)")
    lines.append("        return")
    lines.append("    }")
    lines.append(
        "    console.error(\"spite: the program passed the breakpoint at '\{site}' before the REPL had started, so it did not stop there\")",
    )
    lines.append("}")
    return lines.join("\n")
}

# ../HOT_RELOAD.md#the-parts
func hot_reload_commands_source(): String {
    lines = List<String>()
    add_the_hot_reload_commands()
    return lines.join("\n")
}

func add_the_hot_reload_commands() {
    lines.append("var breakpoints = List<String>()")
    lines.append("var last_code = \"\"")
    lines.append("")
    lines.append("func forget_the_left_files() \{")
    lines.append("    var left_path = code_path()")
    lines.append("    var left_code_path: Path? = left_path")
    lines.append("    crash left_code_path")
    lines.append("    var left_code = File(left_code_path)")
    lines.append("    if left_code.exists() \{")
    lines.append("        forget_a_left_file(left_code)")
    lines.append("    }")
    lines.append("    var left_breaks_path = breaks_path()")
    lines.append("    var left_breaks_file_path: Path? = left_breaks_path")
    lines.append("    crash left_breaks_file_path")
    lines.append("    var left_breaks = File(left_breaks_file_path)")
    lines.append("    if left_breaks.exists() \{")
    lines.append("        forget_a_left_file(left_breaks)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func forget_a_left_file(left: File) \{")
    lines.append("    var removed = left.remove()")
    lines.append("    if not removed \{")
    lines.append(
        "        console.error(\"spite: '\{left.path}', left by an earlier run, cannot be removed, so a reload may read what it holds\")",
    )
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func answer_reload(word: String): String \{")
    lines.append("    if word == \"last_reload\" \{")
    lines.append("        return last_answer")
    lines.append("    }")
    lines.append("    if word == \"wait_reload\" \{")
    lines.append("        return wait_reload()")
    lines.append("    }")
    lines.append("    return reload_now()")
    lines.append("}")
    lines.append("")
    lines.append("func code_path(): String \{")
    lines.append("    var executable = program.executable_path()")
    lines.append("    crash executable")
    lines.append("    if executable.ends_with(\".exe\") \{")
    lines.append("        var length = executable.length()")
    lines.append("        var stem = executable.slice(0, length - 4)")
    lines.append("        crash stem")
    lines.append("        return \"\{stem}.reload_prompt\"")
    lines.append("    }")
    lines.append("    return \"\{executable}.reload_prompt\"")
    lines.append("}")
    lines.append("")
    lines.append("func run_code(word: String, code: String): String \{")
    lines.append("    var path = code_path()")
    lines.append("    var file_path: Path? = path")
    lines.append("    crash file_path")
    lines.append("    var file = File(file_path)")
    lines.append("    var written = file.write_string(\"\{word}\\n\{code}\\n\")")
    lines.append("    if not written \{")
    lines.append("        succeeded = false")
    lines.append(
        "        return \"'\{word}' writes its code to '\{path}' for the compiler, and that file cannot be written\"",
    )
    lines.append("    }")
    lines.append("    quiet = true")
    lines.append("    var told = reload_now()")
    lines.append("    quiet = false")
    lines.append("    if succeeded \{")
    lines.append("        last_code = \"\{word}\\n\{code}\\n\"")
    lines.append("        return told")
    lines.append("    }")
    lines.append("    var restored = false")
    lines.append("    if last_code.is_empty() \{")
    lines.append("        restored = file.remove()")
    lines.append("    } else \{")
    lines.append("        restored = file.write_string(last_code)")
    lines.append("    }")
    lines.append("    if not restored \{")
    lines.append(
        "        told = \"\{told}, and '\{path}' could not be put back as it was, so the next reload compiles this code again\"",
    )
    lines.append("    }")
    lines.append("    succeeded = false")
    lines.append("    return told")
    lines.append("}")
    lines.append("")
    lines.append("func breaks_path(): String \{")
    lines.append("    var prompt_path = code_path()")
    lines.append("    var length = prompt_path.length()")
    lines.append("    var stem = prompt_path.slice(0, length - 14)")
    lines.append("    crash stem")
    lines.append("    return \"\{stem}.reload_breaks\"")
    lines.append("}")
    lines.append("")
    lines.append("func answer_breakpoints(word: String, site: String): String \{")
    lines.append("    succeeded = true")
    lines.append("    if word == \"breaks\" \{")
    lines.append("        if breakpoints.is_empty() \{")
    lines.append("            return \"no breakpoint is set: 'break hero.spite:12' sets one\"")
    lines.append("        }")
    lines.append("        return breakpoints.join(\"\\n\")")
    lines.append("    }")
    lines.append("    var wanted = List<String>()")
    lines.append("    var index = 0")
    lines.append("    while index < breakpoints.count() \{")
    lines.append("        var held = breakpoints[index]")
    lines.append("        crash held")
    lines.append("        if word == \"break\" or not site.is_empty() and held != site \{")
    lines.append("            wanted.append(held)")
    lines.append("        }")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    if word == \"break\" and breakpoints.contains(site) \{")
    lines.append("        return \"'\{site}' already holds a breakpoint: 'breaks' lists them\"")
    lines.append("    }")
    lines.append("    if word == \"break\" \{")
    lines.append("        wanted.append(site)")
    lines.append("    }")
    lines.append("    if word == \"clear\" and not site.is_empty() and not breakpoints.contains(site) \{")
    lines.append("        succeeded = false")
    lines.append("        return \"no breakpoint is set on '\{site}': 'breaks' lists them\"")
    lines.append("    }")
    lines.append("    var told = place_the_breakpoints(wanted)")
    lines.append("    if not succeeded \{")
    lines.append("        var put_back = place_the_breakpoints(breakpoints)")
    lines.append("        if not succeeded \{")
    lines.append("            told = \"\{told}, and the breakpoints set before could not be put back: \{put_back}\"")
    lines.append("        }")
    lines.append("        succeeded = false")
    lines.append("        return told")
    lines.append("    }")
    lines.append("    breakpoints = wanted")
    lines.append("    if word == \"break\" \{")
    lines.append("        return \"the program stops before the statement on \{site}\"")
    lines.append("    }")
    lines.append("    if site.is_empty() \{")
    lines.append("        return \"every breakpoint is cleared\"")
    lines.append("    }")
    lines.append("    return \"the breakpoint on \{site} is cleared\"")
    lines.append("}")
    lines.append("")
    lines.append("func place_the_breakpoints(wanted: List<String>): String \{")
    lines.append("    var path = breaks_path()")
    lines.append("    var file_path: Path? = path")
    lines.append("    crash file_path")
    lines.append("    var file = File(file_path)")
    lines.append("    var joined = wanted.join(\"\\n\")")
    lines.append("    var written = file.write_string(\"\{joined}\\n\")")
    lines.append("    if not written \{")
    lines.append("        succeeded = false")
    lines.append(
        "        return \"the breakpoints are written to '\{path}' for the compiler, and that file cannot be written\"",
    )
    lines.append("    }")
    lines.append("    quiet = true")
    lines.append("    var told = reload_now()")
    lines.append("    quiet = false")
    lines.append("    return told")
    lines.append("}")
    lines.append("")
    lines.append("func last_reload(): String \{")
    lines.append("    return last_answer")
    lines.append("}")
    lines.append("")
    lines.append("func wait_reload(): String \{")
    lines.append("    var changed = watcher.settled_changes()")
    lines.append("    if holds_saved_code(changed) \{")
    lines.append("        return reload_now()")
    lines.append("    }")
    lines.append("    return last_answer")
    lines.append("}")
}

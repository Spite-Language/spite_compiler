var lines = List<String>()

# ../../spite_spec/specs/repl.md#command-language
func breakpoint_source(): String {
    lines = List<String>()
    lines.append("singleton")
    lines.append("")
    lines.append("var console = Console()")
    lines.append("var stopper: Spite.Function<String, List<String>, Nothing>? = null")
    lines.append("")
    lines.append("func hold(stopping: Spite.Function<String, List<String>, Nothing>) \{")
    lines.append("    stopper = stopping")
    lines.append("}")
    lines.append("")
    lines.append("func let_go() \{")
    lines.append("    stopper = null")
    lines.append("}")
    lines.append("")
    lines.append("func pause_at(site: String, locals: List<String>) \{")
    lines.append("    var stopping = stopper")
    lines.append("    if stopping \{")
    lines.append("        stopping(site, locals)")
    lines.append("        return")
    lines.append("    }")
    lines.append(
        "    console.error(\"spite: the program passed the breakpoint at '\{site}' before the REPL had started, so it did not stop there\")",
    )
    lines.append("}")
    return lines.join("\n")
}

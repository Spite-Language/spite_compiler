var paths = List<String>()
var disk_paths = List<String>()

# ../../spite_documentation/programs.md#preloaded-files
func read(preloads: Preloads) {
    var keys = List<String>()
    var volume_index = 0
    while volume_index < preloads.volumes.count() {
        var volume = preloads.volumes[volume_index]
        keys.append(volume.key)
        volume_index = volume_index + 1
    }
    var sorted = sorted_texts(keys)
    var index = 0
    while index < sorted.count() {
        var key = sorted[index]
        read_the_volume(preloads, key)
        index = index + 1
    }
}

func read_the_volume(preloads: Preloads, key: String) {
    var mark = "://"
    var name_length = key.length() - mark.length()
    var name = key.slice(0, name_length)
    crash name
    var volume = preloads.volume_named(name)
    crash volume
    if volume.is_whole {
        add_a_folder(key, volume.folder)
        return
    }
    paths.append(key)
    disk_paths.append("")
    var chosen = sorted_texts(volume.file_names)
    var index = 0
    while index < chosen.count() {
        var file_name = chosen[index]
        paths.append("{key}{file_name}")
        disk_paths.append("{volume.folder}/{file_name}")
        index = index + 1
    }
}

func add_a_folder(key: String, folder: String) {
    paths.append(key)
    disk_paths.append("")
    var folder_path: Path? = folder
    crash folder_path
    var directory = Directory(folder_path)
    var entries = directory.entries()
    crash entries
    var children = List<String>()
    var folder_names = entries.filter_directories().map_folder_names()
    var index = 0
    while index < folder_names.count() {
        var folder_name = folder_names[index]
        if not folder_name.starts_with(".") {
            children.append("{folder_name}/")
        }
        index = index + 1
    }
    var file_names = entries.filter_files().map_file_names()
    index = 0
    while index < file_names.count() {
        var file_name = file_names[index]
        if not file_name.starts_with(".") {
            children.append(file_name)
        }
        index = index + 1
    }
    var sorted = sorted_texts(children)
    index = 0
    while index < sorted.count() {
        var child = sorted[index]
        add_a_child(key, folder, child)
        index = index + 1
    }
}

func add_a_child(key: String, folder: String, child: String) {
    if child.ends_with("/") {
        var length = child.length()
        var folder_name = child.slice(0, length - 1)
        crash folder_name
        add_a_folder("{key}{child}", "{folder}/{folder_name}")
        return
    }
    paths.append("{key}{child}")
    disk_paths.append("{folder}/{child}")
}

func sorted_texts(texts: List<String>): List<String> {
    var sorted = texts.copy()
    var index = 1
    while index < sorted.count() {
        var inner = index
        var placed = false
        while inner > 0 and not placed {
            var before = sorted[inner - 1]
            crash before
            var here = sorted[inner]
            crash here
            if here < before {
                sorted.swap(inner - 1, inner)
                inner = inner - 1
            } else {
                placed = true
            }
        }
        index = index + 1
    }
    return sorted
}

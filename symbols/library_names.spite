var waiting_lists = "high_intermediary_representation/waits.spite, assignments.spite and building/facts.spite"

func all_waits(): List<String> {
    var every = waits.copy()
    add_each(every, file_reads)
    add_each(every, file_writes)
    return every
}

func add_each(into: List<String>, names: List<String>) {
    var index = 0
    while index < names.count() {
        into.append(names[index])
        index = index + 1
    }
}

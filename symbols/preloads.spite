var volumes = List<PreloadedVolume>()

# ../../spite_documentation/programs.md#preloaded-files
func holds_a_volume(): Boolean {
    return not volumes.is_empty()
}

func volume_named(name: String): PreloadedVolume? {
    return volumes.find_by_name(name)
}

func add(volume: PreloadedVolume, file_name: String) {
    var known = volume_named(volume.name)
    if known {
        known.take(file_name)
        return
    }
    volume.take(file_name)
    volumes.append(volume)
}

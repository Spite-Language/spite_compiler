union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var map = Mapping.FolderMap()
var scalars = Model.Scalars()
var files = Dictionary<String, AbstractSyntaxTree.Shapes.SourceFile>()
var merged_files = Dictionary<String, AbstractSyntaxTree.Shapes.SourceFile>()
var merged_declarations = List<Declaration>()
var merged_places = Dictionary<String, Integer>()
var merged_paths = Dictionary<String, String>()
var disagreements = List<Disagreement>()
var merging_path = ""
var merging_class = ""
var replaced_attributes = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
var replacing_attributes = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
var replacing_paths = List<String>()
var replacing_classes = List<String>()
var names = Mapping.Names()
var unknown_names = List<String>()
var paths_read = List<String>()
var class_files = Dictionary<String, Mapping.ClassFile>()
var build_flags = Dictionary<String, String>()
var entry_path = ""
var library_folders = List<String>()
var program_asserts = false
var unchosen_folders = List<String>()
var followed_roots = List<String>()
var copy_origins = Dictionary<String, String>()
var walks = List<AbstractSyntaxTree.Walk.Walk>()
var walked_classes = List<String>()
var generated_texts = Dictionary<String, String>()
var machinery = ["Spite.Fault", "Spite.Asserts", "Spite.CopyTable", "Spite.Breakpoint"]
var machinery_added = List<String>()
var breakpoints = List<String>()
var breakpoint_files = List<String>()
var breakpoint_lines = List<Integer>()
var breakpoint_holders = Dictionary<String, List<String>>()
var placed_breakpoints = List<String>()
var breakpoint_sites = Dictionary<String, String>()

func SymbolTable(starting_map: Mapping.FolderMap) {
    map = starting_map
}

func entry_class(folder: String): Mapping.ClassFile {
    var segment = names.last_segment(folder)
    var wanted = names.of_folder(segment)
    var found = map.class_named(wanted)
    var entry_file = Validators.Mapping.EntryFile.Validator()
    entry_file.check(folder, segment, found)
    crash found
    entry_path = found.path
    return found
}

func read_class(class_file: Mapping.ClassFile) {
    fallback not files[class_file.path]
    var text = text_of_the_class(class_file.path)
    var is_generated = generated_texts.contains(class_file.path)
    var parsing = AbstractSyntaxTree.AbstractSyntaxTree(class_file.path, class_file.namespace, text)
    var tree = parsing.run()
    var tokens = parsing.tokens
    var formatted = formatted_text(class_file.path, text, tokens, parsing.comments, is_generated)
    if formatted != text {
        var reparsing = AbstractSyntaxTree.AbstractSyntaxTree(class_file.path, class_file.namespace, formatted)
        tree = reparsing.run()
        tokens = reparsing.tokens
    }
    read_the_loads(class_file, tree)
    if not is_generated {
        var rules = Validators.AbstractSyntaxTree.EveryRule()
        var walk = rules.check(tree, class_file.simple_name, this)
        walks.append(walk)
        walked_classes.append(class_file.simple_name)
        note_the_asserts(class_file.path, tokens)
        tree = stopped_tree(class_file, formatted, tree)
    }
    files[class_file.path] = tree
    paths_read.append(class_file.path)
    class_files[class_file.path] = class_file
    read_mentioned_classes(tokens, class_file.namespace)
}

# ../../spite_spec/specs/repl.md#command-language
func read_the_breakpoints() {
    var executable = build_flags["executable_path"]
    var reloads = build_flags.contains("reload_at") and build_flags["hot_reload"] == "true"
    fallback reloads
    fallback executable
    var stem = executable
    if executable.ends_with(".exe") {
        var length = executable.length()
        var sliced_stem = executable.slice(0, length - 4)
        crash sliced_stem
        stem = sliced_stem
    }
    var file = File("{stem}.reload_breaks")
    var text = file.read_as_string()
    fallback text
    var written_lines = text.split("\n")
    written_lines.each(read_a_breakpoint)
}

func read_a_breakpoint(written: String) {
    var site = written.trim()
    fallback not site.is_empty()
    var refusing = Validators.HotReload.Validator()
    var cut = site.length()
    var found = false
    while cut > 0 and not found {
        var before = site[cut - 1]
        found = before == ":"
        if not found {
            cut = cut - 1
        }
    }
    var site_length = site.length()
    var line_text = site.slice(cut, site_length)
    crash line_text
    var line: Integer? = line_text
    if cut < 2 or not line {
        refusing.refuse("'{site}' names no line of a file: a breakpoint is set as 'break hero.spite:12'")
    }
    crash line
    var file_text = site.slice(0, cut - 1)
    crash file_text
    var forward = file_text.replace("\\", "/")
    breakpoints.append(site)
    breakpoint_files.append(forward)
    breakpoint_lines.append(line)
}

func stopped_tree(
    class_file: Mapping.ClassFile,
    text: String,
    tree: AbstractSyntaxTree.Shapes.SourceFile,
): AbstractSyntaxTree.Shapes.SourceFile {
    if breakpoints.is_empty() or is_library_path(class_file.path) {
        return tree
    }
    var path = class_file.path.replace("\\", "/")
    var stops = Dictionary<Integer, String>()
    var held_sites = List<String>()
    var index = 0
    while index < breakpoints.count() {
        var site = breakpoints[index]
        var written = breakpoint_files[index]
        var line = breakpoint_lines[index]
        crash written
        crash line
        if path == written or path.ends_with("/{written}") {
            note_a_holder(site, path)
            stops[line] = site
            held_sites.append(site)
        }
        index = index + 1
    }
    if stops.is_empty() {
        return tree
    }
    breakpoint_sites[path] = held_sites.join(" ")
    var parsing = AbstractSyntaxTree.AbstractSyntaxTree(class_file.path, class_file.namespace, text)
    parsing.stops = stops
    var stopped = parsing.run()
    var stopping = find_files("Spite.Breakpoint", "")
    stopping.each(read_a_class)
    merge_the_class(stopping)
    var placed_index = 0
    while placed_index < parsing.placed_stops.count() {
        var placed_line = parsing.placed_stops[placed_index]
        crash placed_line
        var placed_site = stops[placed_line]
        crash placed_site
        placed_breakpoints.append(placed_site)
        placed_index = placed_index + 1
    }
    return stopped
}

func note_a_holder(site: String, path: String) {
    var holders = breakpoint_holders[site]
    if not holders {
        var first_holders = List<String>()
        first_holders.append(path)
        breakpoint_holders[site] = first_holders
        return
    }
    holders.append(path)
}

func check_the_breakpoints() {
    var refusing = Validators.HotReload.Validator()
    var index = 0
    while index < breakpoints.count() {
        var site = breakpoints[index]
        var written = breakpoint_files[index]
        crash written
        var holders = breakpoint_holders[site]
        if not holders {
            refusing.refuse("no file of the program ends in '{written}': a breakpoint names one of the program's own files, as in 'break hero.spite:12'")
        }
        crash holders
        if holders.count() > 1 {
            var named = holders.join(", ")
            refusing.refuse("'{written}' names more than one file of the program ({named}): write more of the path")
        }
        if not placed_breakpoints.contains(site) {
            refusing.refuse("no statement starts on '{site}': a breakpoint stops before a statement, so name the line a statement starts on")
        }
        index = index + 1
    }
}

func formatted_text(
    path: String,
    text: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
    is_generated: Boolean,
): String {
    var library = Validators.LibraryFile()
    var is_a_pinned_copy = path.contains(".spite/git/")
    var is_the_programs = not is_generated and not is_library_path(path) and not library.holds(path) and not is_a_pinned_copy
    if not is_the_programs {
        return text
    }
    var formatter = Formatting.Formatter()
    return formatter.formatted(path, text, tokens, comments)
}

func text_of_the_class(path: String): String {
    var generated = generated_texts[path]
    if generated {
        return generated
    }
    var file = File(path)
    var text = file.read_as_string()
    var readable = Validators.Mapping.ReadableFile.Validator()
    readable.check(path, text)
    crash text
    return text
}

func add_a_generated_class(namespace: String, path: String, text: String) {
    generated_texts[path] = text
    var class_file = Mapping.ClassFile(namespace, namespace, path)
    map.add_to_the_class(namespace, class_file)
}

func note_the_asserts(path: String, tokens: List<AbstractSyntaxTree.Tokens.Token>) {
    fallback not program_asserts and not is_library_path(path)
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.kind == 'keyword_fallback' {
            program_asserts = true
        }
        index = index + 1
    }
}

func check_after_building(text_holes: List<String>, other_holes: List<String>) {
    var number_rules = Validators.AbstractSyntaxTree.EveryRule()
    number_rules.check_the_numbers(walks, walked_classes)
    var index = 0
    while index < walks.count() {
        var walk = walks[index]
        var class_name = walked_classes[index]
        crash class_name
        var rules = Validators.AbstractSyntaxTree.EveryRule()
        rules.check_the_lone_holes(walk, class_name, text_holes, other_holes)
        index = index + 1
    }
    index = 0
    while index < walks.count() {
        var walk = walks[index]
        var class_name = walked_classes[index]
        crash class_name
        var rules = Validators.AbstractSyntaxTree.EveryRule()
        rules.check_after_building(walk, class_name)
        index = index + 1
    }
}

func is_library_path(path: String): Boolean {
    var forward = path.replace("\\", "/")
    var index = 0
    while index < library_folders.count() {
        var folder = library_folders[index]
        var forward_folder = folder.replace("\\", "/")
        if forward.starts_with("{forward_folder}/") {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_singleton(written: String, from_namespace: String): Boolean {
    var found = find_files(written, from_namespace)
    return found.any(opens_with_singleton)
}

func opens_with_singleton(class_file: Mapping.ClassFile): Boolean {
    var parsed = files[class_file.path]
    if parsed {
        return parsed_as_a_singleton(parsed)
    }
    var file = File(class_file.path)
    var text = file.read_as_string()
    fallback text
    var lines = text.split("\n")
    var first_line = lines.first()
    fallback first_line
    return first_line.trim() == "singleton"
}

func parsed_as_a_singleton(parsed: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    fallback not parsed.declarations.is_empty()
    var opening = parsed.declarations[0]
    if opening.class == AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration {
        return true
    }
    return false
}

func read_the_loads(class_file: Mapping.ClassFile, file: AbstractSyntaxTree.Shapes.SourceFile) {
    scalars.use_the_map(map)
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            var function = declaration
            if function.body {
                read_the_loads_of(function.body, class_file)
            }
        }
        index = index + 1
    }
}

func read_the_loads_of(block: AbstractSyntaxTree.Shapes.Statements.Block, class_file: Mapping.ClassFile) {
    var leading = class_file.path == entry_path
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var is_a_load = statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement
        if not is_a_load {
            leading = false
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            var loaded = statement
            note_a_library(loaded, class_file, leading)
            read_one_load(loaded, class_file)
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            read_the_chosen_loads(statement, class_file)
        }
        index = index + 1
    }
}

func read_the_chosen_loads(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, class_file: Mapping.ClassFile) {
    var no_defaults = Dictionary<String, String>()
    var probe = BuildCondition(build_flags, no_defaults)
    fallback probe.is_a_build_condition(branch.condition)
    var defaults = build_defaults()
    var condition = BuildCondition(build_flags, defaults)
    if condition.holds(branch.condition) {
        crash branch.then_branch
        read_the_loads_of(branch.then_branch, class_file)
        note_the_unchosen(branch.else_branch, class_file)
        return
    }
    crash branch.then_branch
    note_the_unchosen(branch.then_branch, class_file)
    fallback branch.else_branch
    read_the_loads_of(branch.else_branch, class_file)
}

func note_the_unchosen(block: AbstractSyntaxTree.Shapes.Statements.Block?, class_file: Mapping.ClassFile) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            note_an_unchosen_load(statement, class_file)
        }
        if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            note_both_unchosen(statement, class_file)
        }
        index = index + 1
    }
}

func note_both_unchosen(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, class_file: Mapping.ClassFile) {
    note_the_unchosen(branch.then_branch, class_file)
    note_the_unchosen(branch.else_branch, class_file)
}

func note_an_unchosen_load(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement, class_file: Mapping.ClassFile) {
    var expression = loaded.folder
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var folder = "{folder_of(class_file.path)}/{piece.text}"
        var forward = folder.replace("\\", "/")
        unchosen_folders.append(forward)
    }
}

func is_unchosen(path: String): Boolean {
    var forward = path.replace("\\", "/")
    var index = 0
    while index < unchosen_folders.count() {
        var folder = unchosen_folders[index]
        if forward.starts_with("{folder}/") {
            return true
        }
        index = index + 1
    }
    return false
}

func build_defaults(): Dictionary<String, String> {
    var defaults = Dictionary<String, String>()
    var builds = find_files("Build", "")
    var index = 0
    while index < builds.count() {
        var build_file = builds[index]
        if not files[build_file.path] {
            read_class(build_file)
        }
        var tree = files[build_file.path]
        crash tree
        read_the_defaults(tree, defaults)
        index = index + 1
    }
    return defaults
}

func read_the_defaults(tree: AbstractSyntaxTree.Shapes.SourceFile, defaults: Dictionary<String, String>) {
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            var no_flags = Dictionary<String, String>()
            var reader = BuildCondition(no_flags, no_flags)
            var written = reader.literal_text(declaration.value)
            defaults[declaration.name] = written
        }
        index = index + 1
    }
}

func read_one_load(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement, class_file: Mapping.ClassFile) {
    var expression = loaded.folder
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var relative = Validators.Mapping.RelativeLoad.Validator()
        relative.check(piece.text, class_file.path, loaded.line)
        var from_the_library = is_library_path(class_file.path)
        var loading_folder = folder_of(class_file.path)
        var folder = "{loading_folder}/{piece.text}"
        if from_the_library {
            folder = beside(loading_folder, piece.text)
        }
        var pins = Validators.Mapping.GitLoad.Validator()
        pins.check(piece.text, folder, class_file.path, loaded.line)
        var named = Validators.Mapping.FolderName.Validator()
        if pins.is_pinned {
            var pinning_folder = origin_folder(class_file.path, loading_folder, pins)
            var copying = Mapping.PinnedCopy(pins, pinning_folder)
            var copy = copying.fetched()
            var copied_package = package_of("{copy}/")
            copy_origins[copied_package] = copying.top_folder
            folder = copy
            if not pins.inside.is_empty() {
                folder = "{copy}/{pins.inside}"
                named.check_the_path(pins.inside, class_file.path, loaded.line)
            }
        } else {
            named.check_the_path(piece.text, class_file.path, loaded.line)
        }
        map.add_root(folder, class_file.path, loaded.line)
        follow_the_root(folder, from_the_library)
    }
}

# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func origin_folder(path: String, loading_folder: String, pins: Validators.Mapping.GitLoad.Validator): String {
    var package = package_of(path)
    if package.is_empty() or not pins.is_local(pins.repository) {
        return loading_folder
    }
    var origin = copy_origins[package]
    crash origin
    var is_fetched = origin.is_empty()
    pins.refuse_a_path_in_a_fetched_copy(is_fetched)
    var at = loading_folder.index_of(package)
    crash at
    var length = loading_folder.length()
    var package_length = package.length()
    var inner = loading_folder.slice(at + package_length, length)
    crash inner
    return "{origin}{inner}"
}

func package_of(path: String): String {
    var packages = Mapping.Packages()
    return packages.package_of(path)
}

func beside(folder: String, written: String): String {
    var segments = folder.replace("\\", "/").split("/")
    var rest = written
    while rest.starts_with("../") and not segments.is_empty() {
        var last_index = segments.count() - 1
        var last = segments[last_index]
        if last == ".." {
            return "{folder}/{written}"
        }
        segments.remove_at(last_index)
        var length = rest.length()
        var sliced_rest = rest.slice(3, length)
        crash sliced_rest
        rest = sliced_rest
    }
    var joined = segments.join("/")
    return "{joined}/{rest}"
}

func follow_the_root(folder: String, from_the_library: Boolean) {
    var root = map.root_at(folder)
    fallback root
    fallback not followed_roots.contains(root.path)
    followed_roots.append(root.path)
    if from_the_library {
        library_folders.append(folder)
    }
    root.files.each(follow_a_files_loads)
}

func follow_a_files_loads(class_file: Mapping.ClassFile) {
    fallback not files[class_file.path]
    var file = File(class_file.path)
    var text = file.read_as_string()
    fallback text
    fallback text.contains("load \"")
    var parsing = AbstractSyntaxTree.AbstractSyntaxTree(class_file.path, class_file.namespace, text)
    var tree = parsing.run()
    read_the_loads(class_file, tree)
}

func note_a_library(
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
    class_file: Mapping.ClassFile,
    leading: Boolean,
) {
    fallback leading
    var expression = loaded.folder
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var folder = "{folder_of(class_file.path)}/{piece.text}"
        library_folders.append(folder)
    }
}

func folder_of(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    crash segments.remove_last()
    return segments.join("/")
}

func read_mentioned_classes(tokens: List<AbstractSyntaxTree.Tokens.Token>, from_namespace: String) {
    var index = 0
    while index < tokens.count() {
        var kind = tokens[index].kind
        if kind == 'class_name' {
            index = read_mention_at(tokens, index, from_namespace)
        } else {
            index = index + 1
        }
    }
}

func read_mention_at(tokens: List<AbstractSyntaxTree.Tokens.Token>, start: Integer, from_namespace: String): Integer {
    var token = tokens[start]
    crash token
    var written = written_name_at(tokens, start)
    var steps = token_count(written)
    var found = find_files(written, from_namespace)
    if found.count() > 0 {
        found.each(read_a_class)
        merge_the_class(found)
    } else {
        note_missing(written)
    }
    return start + steps
}

func merge_the_class(written_files: List<Mapping.ClassFile>) {
    var class_files = in_merge_order(written_files)
    merged_declarations = List<Declaration>()
    merged_places = Dictionary<String, Integer>()
    merged_paths = Dictionary<String, String>()
    disagreements = List<Disagreement>()
    var index = 0
    while index < class_files.count() {
        var class_file = class_files[index]
        var file = files[class_file.path]
        merging_path = class_file.path
        merging_class = class_file.namespace
        if file {
            file.declarations.each(keep_the_declaration)
        }
        index = index + 1
    }
    disagreements.each(refuse_a_disagreement)
    var last = class_files.count() - 1
    var winner = class_files[last]
    var library = Validators.LibraryFile()
    var library_files = class_files.filter(library.holds_the_class)
    var last_library_file = library_files.last()
    if last_library_file and last_library_file.namespace != "Build" {
        winner = last_library_file
    }
    if winner {
        var merged = AbstractSyntaxTree.Shapes.SourceFile(winner.path, winner.namespace)
        merged.declarations = merged_declarations
        index = 0
        while index < class_files.count() {
            var class_file = class_files[index]
            merged_files[class_file.path] = merged
            index = index + 1
        }
    } else {
        return
    }
}

func in_merge_order(written_files: List<Mapping.ClassFile>): List<Mapping.ClassFile> {
    var library = Validators.LibraryFile()
    var ordered = List<Mapping.ClassFile>()
    var others = List<Mapping.ClassFile>()
    var index = 0
    while index < written_files.count() {
        var class_file = written_files[index]
        if library.holds(class_file.path) {
            ordered.append(class_file)
        } else {
            others.append(class_file)
        }
        index = index + 1
    }
    ordered = common_first(ordered)
    var loaded_order = in_load_order(others)
    var packages = Mapping.Packages()
    var pinned = loaded_order.filter(packages.is_pinned_class)
    var own = loaded_order.filter(packages.is_own_class)
    pinned.each(ordered.append)
    own.each(ordered.append)
    return ordered
}

func common_first(library_files: List<Mapping.ClassFile>): List<Mapping.ClassFile> {
    var first = List<Mapping.ClassFile>()
    var later = List<Mapping.ClassFile>()
    var index = 0
    while index < library_files.count() {
        var class_file = library_files[index]
        var written = class_file.path.replace("\\", "/")
        if written.contains("/spite_standard_library/common/") {
            first.append(class_file)
        } else {
            later.append(class_file)
        }
        index = index + 1
    }
    later.each(first.append)
    return first
}

func in_load_order(written_files: List<Mapping.ClassFile>): List<Mapping.ClassFile> {
    var first = written_files.first()
    if not first or first.namespace != "Build" {
        return written_files
    }
    var program_root = map.roots[0]
    crash program_root
    var loaded = List<Mapping.ClassFile>()
    var programs = List<Mapping.ClassFile>()
    var index = 0
    while index < written_files.count() {
        var class_file = written_files[index]
        if is_inside(class_file.path, program_root.path) {
            programs.append(class_file)
        } else {
            loaded.append(class_file)
        }
        index = index + 1
    }
    programs.each(loaded.append)
    return loaded
}

func is_inside(path: String, folder: String): Boolean {
    var forward = path.replace("\\", "/")
    var forward_folder = folder.replace("\\", "/")
    var direct = "{forward_folder}/"
    fallback forward.starts_with(direct)
    var length = forward.length()
    var direct_length = direct.length()
    var rest = forward.slice(direct_length, length)
    crash rest
    return not rest.contains("/")
}

func keep_the_declaration(declaration: Declaration) {
    var name = name_of(declaration)
    if name.is_empty() {
        fallback not merged_declarations.any(is_a_singleton_marker) or not is_a_singleton_marker(declaration)
        merged_declarations.append(declaration)
        return
    }
    var place = merged_places[name]
    if place {
        var replaced = merged_declarations[place]
        crash replaced
        note_a_reopened_attribute(replaced, declaration)
        note_a_disagreement(name, replaced, declaration)
        merged_declarations[place] = declaration
    } else {
        merged_places[name] = merged_declarations.count()
        merged_declarations.append(declaration)
    }
    merged_paths[name] = merging_path
}

# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func note_a_disagreement(name: String, replaced: Declaration, replacing: Declaration) {
    var earlier_path = merged_paths[name]
    crash earlier_path
    var packages = Mapping.Packages()
    fallback packages.other_commits_of_one_repository(earlier_path, merging_path)
    var earlier_line = line_of(replaced)
    var later_line = line_of(replacing)
    var earlier_text = declaration_text(earlier_path, earlier_line)
    var later_text = declaration_text(merging_path, later_line)
    fallback earlier_text != later_text
    var disagreement = Disagreement(merging_class, name, earlier_path, earlier_line, merging_path, later_line)
    disagreements.append(disagreement)
}

func refuse_a_disagreement(disagreement: Disagreement) {
    var kept_path = merged_paths[disagreement.name]
    crash kept_path
    var packages = Mapping.Packages()
    fallback packages.is_pinned(kept_path)
    var refusing = Validators.Mapping.MergedVersions.Validator()
    refusing.refuse(disagreement)
}

func declaration_text(path: String, line: Integer): String {
    var file = files[path]
    crash file
    var text = text_of_the_class(path)
    var written_lines = text.split("\n")
    var next_line = written_lines.count() + 1
    var index = 0
    while index < file.declarations.count() {
        var other = file.declarations[index]
        var other_line = line_of(other)
        if other_line > line and other_line < next_line {
            next_line = other_line
        }
        index = index + 1
    }
    var kept = List<String>()
    index = line - 1
    while index < next_line - 1 and index < written_lines.count() {
        var written = written_lines[index]
        var trimmed = written.trim()
        if not trimmed.is_empty() and not trimmed.starts_with("#") {
            kept.append(trimmed)
        }
        index = index + 1
    }
    return kept.join("\n")
}

func line_of(declaration: Declaration): Integer {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        var attribute = declaration
        return attribute.line
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        var function = declaration
        return function.line
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
        var enumeration = declaration
        return enumeration.line
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        var shape = declaration
        return shape.line
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        var shape = declaration
        return shape.line
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
        var value = declaration
        return value.line
    }
    var marker = declaration
    return marker.line
}

# ../../spite_spec/specs/classes_and_files.md
func note_a_reopened_attribute(
    replaced: Declaration,
    replacing: Declaration,
) {
    fallback replaced.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    fallback replacing.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    replaced_attributes.append(replaced)
    replacing_attributes.append(replacing)
    replacing_paths.append(merging_path)
    replacing_classes.append(merging_class)
}

func check_the_reopened_attributes(resolver: NameResolution.Resolver) {
    var index = 0
    while index < replaced_attributes.count() {
        var replaced = replaced_attributes[index]
        var replacing = replacing_attributes[index]
        var path = replacing_paths[index]
        var reopened_class = replacing_classes[index]
        crash replacing and path and reopened_class
        var types = Validators.Mapping.ReopenedType.Validator()
        types.check(replaced, replacing, path, reopened_class, resolver)
        index = index + 1
    }
}

func is_a_singleton_marker(declaration: Declaration): Boolean {
    return declaration.class == AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
}

func name_of(declaration: Declaration): String {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        var attribute = declaration
        return attribute.name
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        var function = declaration
        return function.declared_key()
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
        var enumeration = declaration
        return enumeration.name
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        var shape = declaration
        return shape.name
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        var shape = declaration
        return shape.name
    }
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
        var value = declaration
        return value.name
    }
    return ""
}

func read_a_class(found: Mapping.ClassFile) {
    var already = files[found.path]
    if already {
        return
    } else {
        read_class(found)
    }
}

func note_missing(written: String) {
    if not unknown_names.contains(written) {
        unknown_names.append(written)
    }
}

func token_count(written: String): Integer {
    var segments = written.split(".")
    return segments.count() * 2 - 1
}

func written_name_at(tokens: List<AbstractSyntaxTree.Tokens.Token>, start: Integer): String {
    var first = tokens[start]
    crash first
    var written = first.text
    var index = start + 1
    var keep_going = true
    while keep_going and index + 1 < tokens.count() {
        var dot = tokens[index].kind
        var next = tokens[index + 1].kind
        if dot == 'dot' and next == 'class_name' {
            written = "{written}.{tokens[index + 1].text}"
            index = index + 2
        } else {
            keep_going = false
        }
    }
    return written
}

func namespace_folder(written: String): Mapping.MappedFolder? {
    var folder = map.folder_named(written)
    fallback folder
    fallback not map.is_a_root(folder.path)
    return folder
}

func namespace_folders(): List<Mapping.MappedFolder> {
    var found = List<Mapping.MappedFolder>()
    var folders = map.folders_by_namespace.values()
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if not map.is_a_root(folder.path) {
            found.append(folder)
        }
        index = index + 1
    }
    return found
}

func read_the_program() {
    var every = map.every_class()
    var root = map.roots.first()
    fallback root
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        var path_length = class_file.path.length()
        var root_length = root.path.length()
        var rest = class_file.path.slice(root_length, path_length)
        crash rest
        var is_the_programs = class_file.path.starts_with(root.path) and not rest.contains("..")
        var is_left_out = is_unchosen(class_file.path)
        if is_the_programs and not is_left_out and not files[class_file.path] {
            read_class(class_file)
        }
        index = index + 1
    }
}

func find(written: String, from_namespace: String): Mapping.ClassFile? {
    var files = find_files(written, from_namespace)
    if files.count() > 0 {
        var last = files.count() - 1
        return files[last]
    } else {
        return null
    }
}

func class_files_of(written: String, from_namespace: String): List<Mapping.ClassFile> {
    return find_files(written, from_namespace)
}

func find_files(written: String, from_namespace: String): List<Mapping.ClassFile> {
    if is_machinery(written) {
        add_the_machinery(written)
    }
    var searched = from_namespace
    var keep_going = not searched.is_empty()
    while keep_going {
        var here = find_here(searched, written)
        if here.count() > 0 {
            return here
        }
        searched = enclosing(searched)
        keep_going = not searched.is_empty()
    }
    var roots = map.root_namespaces()
    var index = 0
    while index < roots.count() {
        var found = find_here(roots[index], written)
        if found.count() > 0 {
            return found
        }
        index = index + 1
    }
    return map.class_files_of(written)
}

func is_machinery(written: String): Boolean {
    return machinery.contains(written) and not machinery_added.contains(written)
}

func machinery_folder(): String {
    var folder = folder_of(entry_path)
    return "{folder}/.spite/build/spite"
}

func add_the_machinery(written: String) {
    fallback map.loads_the_library()
    machinery_added.append(written)
    var folder = machinery_folder()
    if not library_folders.contains(folder) {
        library_folders.append(folder)
    }
    var texts = Symbols.MachineryText()
    if written == "Spite.Fault" {
        var fault = texts.fault_source()
        add_a_generated_class(written, "{folder}/fault.spite", fault)
    } else if written == "Spite.Asserts" {
        var asserts = texts.asserts_source()
        add_a_generated_class(written, "{folder}/asserts.spite", asserts)
    } else if written == "Spite.Breakpoint" {
        var stopping = texts.breakpoint_source()
        add_a_generated_class(written, "{folder}/breakpoint.spite", stopping)
    } else {
        var copying = texts.copy_table_source()
        add_a_generated_class(written, "{folder}/copy_table.spite", copying)
    }
}

func find_here(namespace: String, written: String): List<Mapping.ClassFile> {
    var qualified = names.joined(namespace, written)
    return map.class_files_of(qualified)
}

func enclosing(namespace: String): String {
    var segments = namespace.split(".")
    fallback segments.count() >= 2
    var shorter = List<String>()
    var index = 0
    while index < segments.count() - 1 {
        shorter.append(segments[index])
        index = index + 1
    }
    return shorter.join(".")
}

func file_count(): Integer {
    return files.count()
}

func class_named(written: String, from_namespace: String): Mapping.ClassFile? {
    return find(written, from_namespace)
}

func read(class_file: Mapping.ClassFile) {
    var already = files[class_file.path]
    if already {
        return
    } else {
        read_class(class_file)
    }
}

func file_for(path: String): AbstractSyntaxTree.Shapes.SourceFile? {
    var merged = merged_files[path]
    if merged {
        return merged
    } else {
        return files[path]
    }
}

func read_paths(): List<String> {
    return paths_read
}

func class_file_for(path: String): Mapping.ClassFile? {
    return class_files[path]
}

func not_yet_resolved(): String {
    var names = unknown_names
    return names.join(", ")
}

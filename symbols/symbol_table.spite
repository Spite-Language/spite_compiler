var map = Mapping.FolderMap()
var files = Dictionary<String, AbstractSyntaxTree.Shapes.SourceFile>()
var merged_files = Dictionary<String, AbstractSyntaxTree.Shapes.SourceFile>()
var merged_declarations = List<AbstractSyntaxTree.Shapes.Declarations.Declaration>()
var merged_places = Dictionary<String, Integer>()
var names = Mapping.Names()
var unknown_names = List<String>()
var paths_read = List<String>()
var class_files = Dictionary<String, Mapping.ClassFile>()
var build_flags = Dictionary<String, String>()
var entry_path = ""
var library_folders = List<String>()
var program_asserts = false
var unchosen_folders = List<String>()
var walks = List<AbstractSyntaxTree.Walk.Walk>()
var walked_classes = List<String>()
var generated_texts = Dictionary<String, String>()

func SymbolTable(starting_map: Mapping.FolderMap) {
    map = starting_map
}

func entry_class(folder: String): Mapping.ClassFile {
    var segment = names.last_segment(folder)
    var wanted = names.of_folder(segment)
    var found = map.class_named(wanted)
    var entry_file = Validators.Mapping.EntryFile.Validator()
    entry_file.check(folder, wanted, found)
    crash found
    entry_path = found.path
    return found
}

func read_class(class_file: Mapping.ClassFile) {
    assert not files[class_file.path]
    var text = text_of_the_class(class_file.path)
    var is_generated = generated_texts.has(class_file.path)
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer.Lexer(class_file.path, text, first_line)
    var tokens = lexer.tokens_of()
    var parser = AbstractSyntaxTree.Parser.Parser(class_file.path, class_file.namespace, tokens)
    var tree = parser.parse_file()
    tree.comments = lexer.comments
    read_the_loads(class_file, tree)
    if not is_generated {
        var rules = Validators.AbstractSyntaxTree.EveryRule()
        var walk = rules.check(tree, class_file.simple_name, this)
        walks.append(walk)
        walked_classes.append(class_file.simple_name)
        note_the_asserts(class_file.path, tokens)
    }
    files[class_file.path] = tree
    paths_read.append(class_file.path)
    class_files[class_file.path] = class_file
    read_mentioned_classes(class_file.path, tokens, class_file.namespace)
}

func text_of_the_class(path: String): String {
    var generated = generated_texts[path]
    if generated {
        return generated
    }
    var file = File(path)
    var text = file.read()
    var readable = Validators.Mapping.ReadableFile.Validator()
    readable.check(path, text)
    crash text
    return text
}

func add_a_generated_class(namespace: String, path: String, text: String) {
    generated_texts[path] = text
    var class_file = Mapping.ClassFile(namespace, namespace, path)
    map.add_to_the_class(namespace, class_file)
}

func note_the_asserts(path: String, tokens: List<AbstractSyntaxTree.Tokens.Token>) {
    assert not program_asserts and not is_library_path(path)
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.kind == 'keyword_assert' {
            program_asserts = true
        }
        index = index + 1
    }
}

func check_after_building() {
    var index = 0
    while index < walks.count() {
        var walk = walks[index]
        var class_name = walked_classes[index]
        crash class_name
        var rules = Validators.AbstractSyntaxTree.EveryRule()
        rules.check_after_building(walk, class_name)
        index = index + 1
    }
}

func is_library_path(path: String): Boolean {
    var forward = path.replace("\\", "/")
    var index = 0
    while index < library_folders.count() {
        var folder = library_folders[index]
        var forward_folder = folder.replace("\\", "/")
        if forward.starts_with("{forward_folder}/") {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_singleton(written: String, from_namespace: String): Boolean {
    var found = find_files(written, from_namespace)
    return found.any(opens_with_singleton)
}

func opens_with_singleton(class_file: Mapping.ClassFile): Boolean {
    var parsed = files[class_file.path]
    if parsed {
        return parsed_as_a_singleton(parsed)
    }
    var file = File(class_file.path)
    var text = file.read()
    if not text {
        return false
    }
    var lines = text.split("\n")
    var first_line = lines.first()
    if not first_line {
        return false
    }
    return first_line.trim() == "singleton"
}

func parsed_as_a_singleton(parsed: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    if parsed.declarations.is_empty() {
        return false
    }
    var opening = parsed.declarations[0]
    if opening == AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration {
        return true
    }
    return false
}

func read_the_loads(class_file: Mapping.ClassFile, file: AbstractSyntaxTree.Shapes.SourceFile) {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            var function = declaration
            if function.body {
                read_the_loads_of(function.body, class_file)
            }
        }
        index = index + 1
    }
}

func read_the_loads_of(block: AbstractSyntaxTree.Shapes.Statements.Block, class_file: Mapping.ClassFile) {
    var leading = class_file.path == entry_path
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var is_a_load = statement == AbstractSyntaxTree.Shapes.Statements.LoadStatement
        if not is_a_load {
            leading = false
        }
        if statement == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            var loaded = statement
            read_one_load(loaded, class_file)
            note_a_library(loaded, class_file, leading)
        }
        if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            read_the_chosen_loads(statement, class_file)
        }
        index = index + 1
    }
}

func read_the_chosen_loads(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, class_file: Mapping.ClassFile) {
    var no_defaults = Dictionary<String, String>()
    var probe = BuildCondition(build_flags, no_defaults)
    assert probe.is_a_build_condition(branch.condition)
    var defaults = build_defaults()
    var condition = BuildCondition(build_flags, defaults)
    if condition.holds(branch.condition) {
        crash branch.then_branch
        read_the_loads_of(branch.then_branch, class_file)
        note_the_unchosen(branch.else_branch, class_file)
        return
    }
    crash branch.then_branch
    note_the_unchosen(branch.then_branch, class_file)
    assert branch.else_branch
    read_the_loads_of(branch.else_branch, class_file)
}

func note_the_unchosen(block: AbstractSyntaxTree.Shapes.Statements.Block?, class_file: Mapping.ClassFile) {
    assert block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            note_an_unchosen_load(statement, class_file)
        }
        if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            note_both_unchosen(statement, class_file)
        }
        index = index + 1
    }
}

func note_both_unchosen(branch: AbstractSyntaxTree.Shapes.Statements.IfStatement, class_file: Mapping.ClassFile) {
    note_the_unchosen(branch.then_branch, class_file)
    note_the_unchosen(branch.else_branch, class_file)
}

func note_an_unchosen_load(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement, class_file: Mapping.ClassFile) {
    var expression = loaded.folder
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var folder = "{folder_of(class_file.path)}/{piece.text}"
        var forward = folder.replace("\\", "/")
        unchosen_folders.append(forward)
    }
}

func is_unchosen(path: String): Boolean {
    var forward = path.replace("\\", "/")
    var index = 0
    while index < unchosen_folders.count() {
        var folder = unchosen_folders[index]
        if forward.starts_with("{folder}/") {
            return true
        }
        index = index + 1
    }
    return false
}

func build_defaults(): Dictionary<String, String> {
    var defaults = Dictionary<String, String>()
    var builds = find_files("Build", "")
    var index = 0
    while index < builds.count() {
        var build_file = builds[index]
        if not files[build_file.path] {
            read_class(build_file)
        }
        var tree = files[build_file.path]
        crash tree
        read_the_defaults(tree, defaults)
        index = index + 1
    }
    return defaults
}

func read_the_defaults(tree: AbstractSyntaxTree.Shapes.SourceFile, defaults: Dictionary<String, String>) {
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            var no_flags = Dictionary<String, String>()
            var reader = BuildCondition(no_flags, no_flags)
            var written = reader.literal_text(declaration.value)
            defaults[declaration.name] = written
        }
        index = index + 1
    }
}

func read_one_load(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement, class_file: Mapping.ClassFile) {
    var expression = loaded.folder
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var folder = "{folder_of(class_file.path)}/{piece.text}"
        map.add_root(folder, class_file.path, loaded.line)
    }
}

func note_a_library(
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
    class_file: Mapping.ClassFile,
    leading: Boolean,
) {
    assert leading
    var expression = loaded.folder
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = expression.pieces[0]
        crash piece
        var folder = "{folder_of(class_file.path)}/{piece.text}"
        library_folders.append(folder)
    }
}

func folder_of(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    return segments.join("/")
}

func read_mentioned_classes(path: String, tokens: List<AbstractSyntaxTree.Tokens.Token>, from_namespace: String) {
    var index = 0
    while index < tokens.count() {
        var kind = tokens[index].kind
        if kind == 'class_name' {
            index = read_mention_at(path, tokens, index, from_namespace)
        } else {
            index = index + 1
        }
    }
}

func read_mention_at(
    path: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    start: Integer,
    from_namespace: String,
): Integer {
    var token = tokens[start]
    crash token
    var written = written_name_at(tokens, start)
    var steps = token_count(written)
    var found = find_files(written, from_namespace)
    if found.count() > 0 {
        found.each(read_a_class)
        merge_the_class(found)
    } else {
        note_missing(written)
    }
    return start + steps
}

func merge_the_class(written_files: List<Mapping.ClassFile>) {
    var class_files = in_merge_order(written_files)
    merged_declarations = List<AbstractSyntaxTree.Shapes.Declarations.Declaration>()
    merged_places = Dictionary<String, Integer>()
    var index = 0
    while index < class_files.count() {
        var class_file = class_files[index]
        var file = files[class_file.path]
        if file {
            file.declarations.each(keep_the_declaration)
        }
        index = index + 1
    }
    var last = class_files.count() - 1
    var winner = class_files[last]
    var library = Validators.LibraryFile()
    var library_files = class_files.filter(library.holds_the_class)
    var last_library_file = library_files.last()
    if last_library_file and last_library_file.namespace != "Build" {
        winner = last_library_file
    }
    if winner {
        var merged = AbstractSyntaxTree.Shapes.SourceFile(winner.path, winner.namespace)
        merged.declarations = merged_declarations
        index = 0
        while index < class_files.count() {
            var class_file = class_files[index]
            merged_files[class_file.path] = merged
            index = index + 1
        }
    } else {
        return
    }
}

func in_merge_order(written_files: List<Mapping.ClassFile>): List<Mapping.ClassFile> {
    var library = Validators.LibraryFile()
    var ordered = List<Mapping.ClassFile>()
    var others = List<Mapping.ClassFile>()
    var index = 0
    while index < written_files.count() {
        var class_file = written_files[index]
        if library.holds(class_file.path) {
            ordered.append(class_file)
        } else {
            others.append(class_file)
        }
        index = index + 1
    }
    var loaded_order = in_load_order(others)
    loaded_order.each(ordered.append)
    return ordered
}

func in_load_order(written_files: List<Mapping.ClassFile>): List<Mapping.ClassFile> {
    var first = written_files.first()
    if not first or first.namespace != "Build" {
        return written_files
    }
    var program_root = map.roots[0]
    crash program_root
    var loaded = List<Mapping.ClassFile>()
    var programs = List<Mapping.ClassFile>()
    var index = 0
    while index < written_files.count() {
        var class_file = written_files[index]
        if is_inside(class_file.path, program_root.path) {
            programs.append(class_file)
        } else {
            loaded.append(class_file)
        }
        index = index + 1
    }
    programs.each(loaded.append)
    return loaded
}

func is_inside(path: String, folder: String): Boolean {
    var forward = path.replace("\\", "/")
    var forward_folder = folder.replace("\\", "/")
    var direct = "{forward_folder}/"
    if not forward.starts_with(direct) {
        return false
    }
    var length = forward.length()
    var direct_length = direct.length()
    var rest = forward.slice(direct_length, length)
    return not rest.contains("/")
}

func keep_the_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    var name = name_of(declaration)
    if name.is_empty() {
        if not merged_declarations.is_empty() {
            return
        } else {
            merged_declarations.append(declaration)
            return
        }
    }
    var place = merged_places[name]
    if place {
        merged_declarations[place] = declaration
    } else {
        merged_places[name] = merged_declarations.count()
        merged_declarations.append(declaration)
    }
}

func name_of(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration): String {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        var attribute = declaration
        return attribute.name
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        var function = declaration
        return function.name
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
        var enumeration = declaration
        return enumeration.name
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        var shape = declaration
        return shape.name
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        var shape = declaration
        return shape.name
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
        var value = declaration
        return value.name
    }
    return ""
}

func read_a_class(found: Mapping.ClassFile) {
    var already = files[found.path]
    if already {
        return
    } else {
        read_class(found)
    }
}

func note_missing(written: String) {
    if not unknown_names.contains(written) {
        unknown_names.append(written)
    }
}

func token_count(written: String): Integer {
    var segments = written.split(".")
    return segments.count() * 2 - 1
}

func written_name_at(tokens: List<AbstractSyntaxTree.Tokens.Token>, start: Integer): String {
    var first = tokens[start]
    crash first
    var written = first.text
    var index = start + 1
    var keep_going = true
    while keep_going and index + 1 < tokens.count() {
        var dot = tokens[index].kind
        var next = tokens[index + 1].kind
        if dot == 'dot' and next == 'class_name' {
            written = "{written}.{tokens[index + 1].text}"
            index = index + 2
        } else {
            keep_going = false
        }
    }
    return written
}

func namespace_folder(written: String): Mapping.MappedFolder? {
    var folder = map.folder_named(written)
    assert folder
    assert not map.is_a_root(folder.path)
    return folder
}

func namespace_folders(): List<Mapping.MappedFolder> {
    var found = List<Mapping.MappedFolder>()
    var folders = map.folders_by_namespace.values()
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if not map.is_a_root(folder.path) {
            found.append(folder)
        }
        index = index + 1
    }
    return found
}

func read_the_program(): List<Mapping.ClassFile> {
    var unread = List<Mapping.ClassFile>()
    var every = map.every_class()
    var root = map.roots.first()
    assert root
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        var path_length = class_file.path.length()
        var root_length = root.path.length()
        var rest = class_file.path.slice(root_length, path_length)
        var is_the_programs = class_file.path.starts_with(root.path) and not rest.contains("..")
        if is_the_programs and not files[class_file.path] {
            read_class(class_file)
            unread.append(class_file)
        }
        index = index + 1
    }
    return unread
}

func find(written: String, from_namespace: String): Mapping.ClassFile? {
    var files = find_files(written, from_namespace)
    if files.count() > 0 {
        var last = files.count() - 1
        return files[last]
    } else {
        return null
    }
}

func class_files_of(written: String, from_namespace: String): List<Mapping.ClassFile> {
    return find_files(written, from_namespace)
}

func find_files(written: String, from_namespace: String): List<Mapping.ClassFile> {
    var searched = from_namespace
    var keep_going = not searched.is_empty()
    while keep_going {
        var here = find_here(searched, written)
        if here.count() > 0 {
            return here
        }
        searched = enclosing(searched)
        keep_going = not searched.is_empty()
    }
    var roots = map.root_namespaces()
    var index = 0
    while index < roots.count() {
        var found = find_here(roots[index], written)
        if found.count() > 0 {
            return found
        }
        index = index + 1
    }
    return map.class_files_of(written)
}

func find_here(namespace: String, written: String): List<Mapping.ClassFile> {
    var qualified = names.joined(namespace, written)
    return map.class_files_of(qualified)
}

func enclosing(namespace: String): String {
    var segments = namespace.split(".")
    if segments.count() < 2 {
        return ""
    }
    var shorter = List<String>()
    var index = 0
    while index < segments.count() - 1 {
        shorter.append(segments[index])
        index = index + 1
    }
    return shorter.join(".")
}

func file_count(): Integer {
    return files.count()
}

func class_named(written: String, from_namespace: String): Mapping.ClassFile? {
    return find(written, from_namespace)
}

func read(class_file: Mapping.ClassFile) {
    var already = files[class_file.path]
    if already {
        return
    } else {
        read_class(class_file)
    }
}

func file_for(path: String): AbstractSyntaxTree.Shapes.SourceFile? {
    var merged = merged_files[path]
    if merged {
        return merged
    } else {
        return files[path]
    }
}

func read_paths(): List<String> {
    return paths_read
}

func class_file_for(path: String): Mapping.ClassFile? {
    return class_files[path]
}

func not_yet_resolved(): String {
    var names = unknown_names
    return names.join(", ")
}

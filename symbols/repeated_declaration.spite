enum Stay {
    'moves'
    'not_written'
    'two_contents'
    'taken_name'
    'generic_entry'
    'captured_name'
}

var kind = ""
var name = ""
var content = ""
var trees = List<AbstractSyntaxTree.Shapes.SourceFile>()
var declarations = List<SpiteCompiler.Declaration>()
var root_path = ""
var entry_path = ""
var entry_namespace = ""
var entry_name = ""
var folder_namespace = ""
var stays: Stay = 'moves'

func RepeatedDeclaration(
    starting_kind: String,
    starting_name: String,
    starting_content: String,
    starting_root: String,
) {
    kind = starting_kind
    name = starting_name
    content = starting_content
    root_path = starting_root
}

func entry_holds_a_copy(): Boolean {
    var index = 0
    while index < trees.count() {
        var tree = trees[index]
        if tree.path == entry_path {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func is_a_copy(declaration: SpiteCompiler.Declaration): Boolean {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return kind == "union" and declaration.name == name
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return kind == "type" and declaration.name == name
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return false
    }
}

func class_names(): List<String> {
    return trees.map_namespaces()
}

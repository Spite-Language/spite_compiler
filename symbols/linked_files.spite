var contents = Dictionary<String, String>()
var suppliers = List<String>()

# ../ARCHITECTURE.md#validators
func LinkedFiles(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var segments = file.path.replace("\\", "/").split("/")
    crash segments.remove_last()
    var folder = segments.join("/")
    var index = 0
    while index < file.comments.count() {
        var comment = file.comments[index]
        read_a_link(folder, comment.text)
        index = index + 1
    }
}

func read_a_link(folder: String, text: String) {
    fallback not text.contains(" ") and not text.is_empty()
    var parts = text.split("#")
    var linked = parts[0]
    crash linked
    if linked.ends_with(".spite") {
        find_a_supplier(folder, linked)
    }
    fallback linked.ends_with(".md")
    var linked_path: Path? = "{folder}/{linked}"
    crash linked_path
    var linked_file = File(linked_path)
    var content = linked_file.read_as_string()
    fallback content
    contents[linked] = content
}

func find_a_supplier(folder: String, linked: String) {
    var supplier_path: Path? = "{folder}/{linked}"
    crash supplier_path
    var supplier = File(supplier_path)
    if supplier.exists() and not suppliers.contains(linked) {
        suppliers.append(linked)
    }
}

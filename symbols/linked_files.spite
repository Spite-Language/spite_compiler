var contents = Dictionary<String, String>()
var suppliers = List<String>()
var unchecked = List<String>()
var repositories = "https://github.com/Spite-Language/"
var on_master = "/blob/master/"

# ../ARCHITECTURE.md#validators
func LinkedFiles(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var segments = file.path.replace("\\", "/").split("/")
    crash segments.remove_last()
    var folder = segments.join("/")
    var index = 0
    while index < file.comments.count() {
        var comment = file.comments[index]
        read_a_link(folder, comment.text)
        index = index + 1
    }
}

func read_a_link(folder: String, text: String) {
    fallback not text.contains(" ") and not text.is_empty()
    var parts = text.split("#")
    var linked = parts[0]
    crash linked
    if linked.starts_with(repositories) {
        read_an_absolute_link(folder, linked)
        return
    }
    if linked.ends_with(".spite") {
        find_a_supplier(folder, linked)
    }
    fallback linked.ends_with(".md")
    var linked_path: Path? = "{folder}/{linked}"
    crash linked_path
    var linked_file = File(linked_path)
    var content = linked_file.read_as_string()
    fallback content
    contents[linked] = content
}

func find_a_supplier(folder: String, linked: String) {
    var supplier_path: Path? = "{folder}/{linked}"
    crash supplier_path
    var supplier = File(supplier_path)
    if supplier.exists() and not suppliers.contains(linked) {
        suppliers.append(linked)
    }
}

# ../../spite_documentation/style.md#comments-are-links
func read_an_absolute_link(folder: String, linked: String) {
    var after = linked.length()
    var start = repositories.length()
    var rest = linked.slice(start, after)
    crash rest
    var place = rest.index_of(on_master)
    fallback place
    var repository = rest.slice(0, place)
    crash repository
    var path_start = place + on_master.length()
    var rest_length = rest.length()
    var path = rest.slice(path_start, rest_length)
    crash path
    var holder = holder_of(folder, repository)
    if not holder {
        unchecked.append(linked)
        return
    }
    var linked_path: Path? = "{holder}/{repository}/{path}"
    fallback linked_path
    var linked_file = File(linked_path)
    var content = linked_file.read_as_string()
    fallback content
    contents[linked] = content
}

# ../../spite_documentation/style.md#comments-are-links
func holder_of(folder: String, repository: String): String? {
    var segments = folder.split("/")
    while not segments.is_empty() {
        var holder = segments.join("/")
        var repository_path: Path? = "{holder}/{repository}"
        if repository_path {
            var repository_folder = Directory(repository_path)
            if repository_folder.exists() {
                return holder
            }
        }
        crash segments.remove_last()
    }
    return null
}

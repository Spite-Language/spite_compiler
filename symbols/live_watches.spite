var library = Mapping.LibraryFile()
var prepared = List<String>()
var values = [
    "Integer"
    "Long"
    "Short"
    "Byte"
    "UnsignedInteger"
    "UnsignedLong"
    "UnsignedShort"
    "Boolean"
    "String"
    "Float"
    "Double"
    "Decimal"
    "Rune"
]
var found_type = ""
var may_be_missing = false
var found_in: AbstractSyntaxTree.Shapes.SourceFile? = null
var symbols: SymbolTable

# ../../spite_documentation/markup.md#another-objects-attribute
func LiveWatches(starting_symbols: SymbolTable) {
    symbols = starting_symbols
}

# ../../spite_documentation/markup.md#another-objects-attribute
func run() {
    var paths = List<String>()
    symbols.paths_read.each(paths.append)
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var written = symbols.files[path]
        var reader = symbols.file_for(path)
        if written and reader {
            reader.live_watches = written.live_watches
            reader.live_unheard = written.live_unheard
            reader.live_keys = written.live_keys
            reader.live_key_tags = written.live_key_tags
            if not reader.live_watches.is_empty() {
                watch_for(reader)
            }
            compare_the_keys(reader)
        }
        index = index + 1
    }
}

# ../../spite_documentation/markup.md#a-tag-in-a-live-block-is-matched
func compare_the_keys(reader: AbstractSyntaxTree.Shapes.SourceFile) {
    var index = 0
    while index < reader.live_keys.count() {
        var compared = reader.live_keys[index]
        var tag = reader.live_key_tags[index]
        crash tag
        if keys_an_object(reader, tag) {
            compared.operator = 'equal_equal_equal'
        }
        index = index + 1
    }
}

func keys_an_object(reader: AbstractSyntaxTree.Shapes.SourceFile, tag: String): Boolean {
    var tagged = class_tree_of(tag, reader)
    fallback tagged
    var written = attribute_type(tagged, "key")
    var keyed = bare(written)
    fallback not keyed.is_empty()
    var keyed_tree = class_tree_of(keyed, tagged)
    fallback keyed_tree
    return true
}

func watch_for(reader: AbstractSyntaxTree.Shapes.SourceFile) {
    var pieces = List<String>()
    var index = 0
    while index < reader.live_watches.count() {
        var entry = reader.live_watches[index]
        var parts = entry.split("|")
        var piece = parts[0]
        crash piece
        if not pieces.contains(piece) {
            pieces.append(piece)
        }
        index = index + 1
    }
    var kept = AbstractSyntaxTree.Markup.KeptRender(reader)
    kept.next_line = kept.last_line() + 1
    index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        watch_a_piece(reader, kept, piece)
        index = index + 1
    }
    var rule = Validators.AbstractSyntaxTree.LiveRead.Validator()
    var answer = rule.check_the_watched_classes(reader)
    answer.tell()
}

# ../../spite_documentation/markup.md#another-objects-attribute
func watch_a_piece(
    reader: AbstractSyntaxTree.Shapes.SourceFile,
    kept: AbstractSyntaxTree.Markup.KeptRender,
    piece: String,
) {
    var roots = List<String>()
    var members = List<String>()
    var index = 0
    while index < reader.live_watches.count() {
        var entry = reader.live_watches[index]
        var parts = entry.split("|")
        var owner = parts[0]
        var root = parts[1]
        var member = parts[2]
        crash owner
        crash root
        crash member
        if owner == piece {
            roots.append(root)
            members.append(member)
        }
        index = index + 1
    }
    var lines = List<String>()
    var watching = List<String>()
    var heard = List<String>()
    var distinct = List<String>()
    index = 0
    while index < roots.count() {
        var root = roots[index]
        if not distinct.contains(root) and root.starts_with("@") {
            distinct.append(root)
            follow_a_local(reader, kept, piece, root, roots, members, lines, heard)
        } else if not distinct.contains(root) {
            distinct.append(root)
            watch_a_root(reader, kept, piece, root, roots, members, lines, watching, heard)
        }
        index = index + 1
    }
    fallback not watching.is_empty() or not heard.is_empty()
    if not watching.is_empty() {
        lines.append("")
        lines.append("func _live_watching_{piece}() \{")
        watching.each(lines.append)
        lines.append("}")
    }
    if not heard.is_empty() {
        var names = List<String>()
        heard.each(names.append)
        var asked = List<String>()
        var place = 0
        while place < names.count() {
            var name = names[place]
            asked.append("written == \"{name}\"")
            place = place + 1
        }
        var condition = asked.join(" or ")
        lines.append("")
        lines.append("func _live_heard_{piece}(written: String) \{")
        lines.append("    fallback {condition}")
        lines.append("    _live_{piece}()")
        lines.append("}")
    }
    var text = lines.join("\n")
    var made = kept.parsed_declarations(text, kept.next_line)
    made.each(kept.add_a_declaration)
    var class_name = reader.class_name()
    fallback not watching.is_empty()
    crash call_at_the_end(reader, kept, class_name, "_live_watching_{piece}()")
    crash call_at_the_end(reader, kept, "_live_{piece}", "_live_watching_{piece}()")
}

# ../../spite_documentation/markup.md#another-objects-attribute
func watch_a_root(
    reader: AbstractSyntaxTree.Shapes.SourceFile,
    kept: AbstractSyntaxTree.Markup.KeptRender,
    piece: String,
    root: String,
    roots: List<String>,
    members: List<String>,
    lines: List<String>,
    watching: List<String>,
    heard: List<String>,
) {
    var value = kept.parsed_expression(root, kept.next_line)
    found_type = ""
    found_in = null
    type_of(value, reader)
    may_be_missing = found_type.ends_with("?")
    var written = bare(found_type)
    var where = found_in
    if written.is_empty() or not where {
        tell(reader, root, "")
        return
    }
    fallback not values.contains(written)
    var place = watching.count()
    var seen = "_live_seen_{piece}_{place}"
    var item = item_of(written, "List<")
    if not item.is_empty() {
        var qualified = qualified_of(item, where)
        watch_a_collection(lines, watching, piece, root, place, "List<{qualified}>", "ListChange<{qualified}>")
        return
    }
    var pair = item_of(written, "Dictionary<")
    if not pair.is_empty() {
        var qualified = qualified_of(pair, where)
        watch_a_collection(
            lines,
            watching,
            piece,
            root,
            place,
            "Dictionary<{qualified}>",
            "DictionaryChange<{qualified}>",
        )
        return
    }
    var watched = class_tree_of(written, where)
    if not watched {
        tell(reader, root, written)
        return
    }
    var names = names_read(watched, root, roots, members)
    fallback not names.is_empty()
    prepare(watched, names)
    names.each(heard.append)
    var qualified = qualified_of(written, where)
    lines.append("var {seen}: {qualified}? = null")
    watching.append("    var watched_{place} = {root}")
    watching.append("    var earlier_{place} = {seen}")
    watching.append("    if earlier_{place} !== watched_{place} \{")
    watching.append("        if earlier_{place} \{")
    watching.append("            earlier_{place}.jsx_unwatch_writes(_live_heard_{piece})")
    watching.append("        }")
    if may_be_missing {
        watching.append("        if watched_{place} \{")
        watching.append("            watched_{place}.jsx_watch_writes(_live_heard_{piece})")
        watching.append("        }")
    } else {
        watching.append("        watched_{place}.jsx_watch_writes(_live_heard_{piece})")
    }
    watching.append("        {seen} = watched_{place}")
    watching.append("    }")
}

# ../../spite_documentation/markup.md#a-tag-in-a-live-block-is-matched
func follow_a_local(
    reader: AbstractSyntaxTree.Shapes.SourceFile,
    kept: AbstractSyntaxTree.Markup.KeptRender,
    piece: String,
    root: String,
    roots: List<String>,
    members: List<String>,
    lines: List<String>,
    heard: List<String>,
) {
    var equals = root.index_of("=")
    crash equals
    var root_length = root.length()
    var name = root.slice(1, equals)
    var written_value = root.slice(equals + 1, root_length)
    crash name
    crash written_value
    var value = kept.parsed_expression(written_value, kept.next_line)
    found_type = ""
    found_in = null
    type_of(value, reader)
    var written = bare(found_type)
    var where = found_in
    if written.is_empty() or not where {
        tell(reader, name, "")
        return
    }
    fallback not values.contains(written)
    var watched = class_tree_of(written, where)
    if not watched {
        tell(reader, name, written)
        return
    }
    var names = names_read(watched, root, roots, members)
    fallback not names.is_empty()
    prepare(watched, names)
    names.each(heard.append)
    var qualified = qualified_of(written, where)
    var followed = "_live_followed_{piece}_{name}"
    lines.append("var {followed} = List<{qualified}>()")
    lines.append("")
    lines.append("func _live_follow_{piece}_{name}(watched: {qualified}?) \{")
    lines.append("    fallback watched")
    lines.append("    watched.jsx_watch_writes(_live_heard_{piece})")
    lines.append("    {followed}.append(watched)")
    lines.append("}")
    lines.append("")
    lines.append("func _live_forget_{piece}_{name}() \{")
    lines.append("    var index = 0")
    lines.append("    while index < {followed}.count() \{")
    lines.append("        var watched = {followed}[index]")
    lines.append("        watched.jsx_unwatch_writes(_live_heard_{piece})")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    {followed}.clear()")
    lines.append("}")
    var body = body_of(reader, "_live_in_{piece}")
    crash body
    var forget = kept.parsed_expression("_live_forget_{piece}_{name}()", kept.next_line)
    var forgetting = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(forget)
    body.statements.insert(0, forgetting)
    follow_after(kept, body, name, "_live_follow_{piece}_{name}({name})")
}

func body_of(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    function_name: String,
): AbstractSyntaxTree.Shapes.Statements.Block? {
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and declaration.name == function_name {
            return declaration.body
        }
        index = index + 1
    }
    return null
}

func follow_after(
    kept: AbstractSyntaxTree.Markup.KeptRender,
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    name: String,
    call: String,
) {
    fallback block
    var followed = List<SpiteCompiler.WrittenStatement>()
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        followed.append(statement)
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            var called = kept.parsed_expression(call, statement.line)
            var calling = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(called)
            calling.line = statement.line
            followed.append(calling)
        }
        follow_inside(kept, statement, name, call)
        index = index + 1
    }
    block.statements = followed
}

func follow_inside(
    kept: AbstractSyntaxTree.Markup.KeptRender,
    statement: SpiteCompiler.WrittenStatement,
    name: String,
    call: String,
) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        follow_after(kept, statement.then_branch, name, call)
        follow_after(kept, statement.else_branch, name, call)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        follow_after(kept, statement.body, name, call)
    }
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        follow_after(kept, switch_case.body, name, call)
        index = index + 1
    }
}

# ../../spite_documentation/markup.md#a-list-a-brace-reads
func watch_a_collection(
    lines: List<String>,
    watching: List<String>,
    piece: String,
    root: String,
    place: Integer,
    written: String,
    change: String,
) {
    var seen = "_live_seen_{piece}_{place}"
    var told_function = "_live_heard_{piece}_{place}"
    lines.append("var {seen}: {written}? = null")
    lines.append("")
    lines.append("func {told_function}(_change: {change}) \{")
    lines.append("    _live_{piece}()")
    lines.append("}")
    watching.append("    var watched_{place} = {root}")
    watching.append("    var earlier_{place} = {seen}")
    watching.append("    if earlier_{place} !== watched_{place} \{")
    watching.append("        if earlier_{place} \{")
    watching.append("            earlier_{place}.unsubscribe({told_function})")
    watching.append("        }")
    if may_be_missing {
        watching.append("        if watched_{place} \{")
        watching.append("            watched_{place}.subscribe({told_function})")
        watching.append("        }")
    } else {
        watching.append("        watched_{place}.subscribe({told_function})")
    }
    watching.append("        {seen} = watched_{place}")
    watching.append("    }")
}

# ../../spite_documentation/markup.md#another-objects-attribute
func type_of(value: SpiteCompiler.Expression?, reader: AbstractSyntaxTree.Shapes.SourceFile) {
    fallback value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        found_type = attribute_type(reader, value.name)
        found_in = reader
        return
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        type_of(value.target, reader)
        var outer = bare(found_type)
        var where = found_in
        found_type = ""
        fallback where and not outer.is_empty()
        var tree = class_tree_of(outer, where)
        fallback tree
        found_type = attribute_type(tree, value.name)
        found_in = tree
        return
    }
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    type_of(value.target, reader)
    var outer = bare(found_type)
    found_type = ""
    var item = item_of(outer, "List<")
    if not item.is_empty() {
        found_type = "{item}?"
        return
    }
    var pair = item_of(outer, "Dictionary<")
    fallback not pair.is_empty()
    var parts = pair.split(", ")
    var last = parts.last()
    crash last
    found_type = "{last}?"
}

func attribute_type(tree: AbstractSyntaxTree.Shapes.SourceFile, name: String): String {
    var kept = AbstractSyntaxTree.Markup.KeptRender(tree)
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and declaration.name == name {
            return kept.type_of_an_attribute(declaration)
        }
        index = index + 1
    }
    return ""
}

func bare(written: String): String {
    if not written.ends_with("?") {
        return written
    }
    var written_length = written.length()
    var sliced = written.slice(0, written_length - 1)
    crash sliced
    return sliced
}

func item_of(written: String, opening: String): String {
    fallback written.starts_with(opening) and written.ends_with(">")
    var written_length = written.length()
    var start = opening.length()
    var item = written.slice(start, written_length - 1)
    crash item
    return item
}

func class_file_of(written: String, where: AbstractSyntaxTree.Shapes.SourceFile): Mapping.ClassFile? {
    fallback not written.contains("<") and not values.contains(written)
    return symbols.find(written, where.namespace)
}

func class_tree_of(
    written: String,
    where: AbstractSyntaxTree.Shapes.SourceFile,
): AbstractSyntaxTree.Shapes.SourceFile? {
    var class_file = class_file_of(written, where)
    fallback class_file
    fallback not library.holds(class_file.path) and not symbols.is_library_path(class_file.path)
    return symbols.file_for(class_file.path)
}

# ../../spite_documentation/markup.md#another-objects-attribute
func qualified_of(written: String, where: AbstractSyntaxTree.Shapes.SourceFile): String {
    var parts = written.split(", ")
    var qualified = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        var class_file = class_file_of(part, where)
        if class_file and not library.holds(class_file.path) and not symbols.is_library_path(class_file.path) {
            qualified.append(class_file.namespace)
        } else {
            qualified.append(part)
        }
        index = index + 1
    }
    return qualified.join(", ")
}

# ../../spite_documentation/markup.md#another-objects-attribute
func names_read(
    watched: AbstractSyntaxTree.Shapes.SourceFile,
    root: String,
    roots: List<String>,
    members: List<String>,
): List<String> {
    var attributes = List<String>()
    var typed = List<String>()
    learn_the_attributes(watched, attributes, typed)
    var names = List<String>()
    var index = 0
    while index < roots.count() {
        var other = roots[index]
        var member = members[index]
        crash member
        if other == root {
            var place = attributes.index_of(member)
            if place {
                add_once(names, member)
            } else {
                attributes.each(names.append)
            }
        }
        index = index + 1
    }
    var heard = List<String>()
    index = 0
    while index < names.count() {
        var name = names[index]
        var place = attributes.index_of(name)
        if place and not heard.contains(name) {
            heard.append(name)
        }
        index = index + 1
    }
    return heard
}

func add_once(names: List<String>, name: String) {
    if not names.contains(name) {
        names.append(name)
    }
}

func learn_the_attributes(
    watched: AbstractSyntaxTree.Shapes.SourceFile,
    attributes: List<String>,
    typed: List<String>,
) {
    var kept = AbstractSyntaxTree.Markup.KeptRender(watched)
    var index = 0
    while index < watched.declarations.count() {
        var declaration = watched.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and not declaration.name.starts_with("_") {
            var written = kept.type_of_an_attribute(declaration)
            if not written.is_empty() {
                attributes.append(declaration.name)
                typed.append(written)
            }
        }
        index = index + 1
    }
}

# ../../spite_documentation/markup.md#another-objects-attribute
func prepare(watched: AbstractSyntaxTree.Shapes.SourceFile, names: List<String>) {
    var kept = AbstractSyntaxTree.Markup.KeptRender(watched)
    kept.next_line = kept.last_line() + 1
    var lines = List<String>()
    if not prepared.contains(watched.path) {
        prepared.append(watched.path)
        var forward = watched.path.replace("\\", "/")
        symbols.markup_paths.append(forward)
        lines.append("var _jsx_writes: Observer<String>? = null")
        lines.append("")
        lines.append("func jsx_watch_writes(heard: Spite.Function<String, Nothing>) \{")
        lines.append("    if not _jsx_writes \{")
        lines.append("        _jsx_writes = Observer<String>()")
        lines.append("    }")
        lines.append("    crash _jsx_writes")
        lines.append("    _jsx_writes.subscribe(heard)")
        lines.append("}")
        lines.append("")
        lines.append("func jsx_unwatch_writes(heard: Spite.Function<String, Nothing>) \{")
        lines.append("    fallback _jsx_writes")
        lines.append("    _jsx_writes.unsubscribe(heard)")
        lines.append("}")
        lines.append("")
        lines.append("func _jsx_tell(written: String) \{")
        lines.append("    fallback _jsx_writes")
        lines.append("    _jsx_writes.notify(written)")
        lines.append("}")
    }
    var attributes = List<String>()
    var typed = List<String>()
    learn_the_attributes(watched, attributes, typed)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var key = "{watched.path}|{name}"
        if not prepared.contains(key) {
            prepared.append(key)
            tell_from_the_setter(watched, kept, name, attributes, typed, lines)
        }
        index = index + 1
    }
    fallback not lines.is_empty()
    var text = lines.join("\n")
    var made = kept.parsed_declarations(text, kept.next_line)
    made.each(kept.add_a_declaration)
}

func tell_from_the_setter(
    watched: AbstractSyntaxTree.Shapes.SourceFile,
    kept: AbstractSyntaxTree.Markup.KeptRender,
    name: String,
    attributes: List<String>,
    typed: List<String>,
    lines: List<String>,
) {
    var setter = kept.setter_of(name)
    var told_name = "_jsx_tell(\"{name}\")"
    fallback not call_at_the_end(watched, kept, setter, told_name)
    var place = attributes.index_of(name)
    crash place
    var written = typed[place]
    crash written
    lines.append("")
    lines.append("func {setter}(value: {written}) \{")
    lines.append("    attributes[\"{name}\"].value = value")
    lines.append("    {told_name}")
    lines.append("}")
}

func call_at_the_end(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    kept: AbstractSyntaxTree.Markup.KeptRender,
    function_name: String,
    call: String,
): Boolean {
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and declaration.name == function_name and declaration.body {
            var called = kept.parsed_expression(call, declaration.line)
            var statement = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(called)
            statement.line = declaration.line
            declaration.body.statements.append(statement)
            return true
        }
        index = index + 1
    }
    return false
}

# ../../spite_documentation/markup.md#a-read-the-compiler-cannot-follow
func tell(reader: AbstractSyntaxTree.Shapes.SourceFile, root: String, written: String) {
    var entry = "{root}|{written}"
    fallback not reader.live_unheard.contains(entry)
    reader.live_unheard.append(entry)
}

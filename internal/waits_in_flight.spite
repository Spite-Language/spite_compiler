singleton

var _sites = List<Integer>()
var _handles = List<Concurrent<Nothing>>()
var _most_per_site = 8

func hand(site: Integer, work: Concurrent<Nothing>) {
    let_go_of_the_finished()
    if not work.finished {
        _sites.append(site)
        _handles.append(work)
    }
    while unfinished_from(site) > _most_per_site {
        wait_for_the_oldest(site)
    }
}

func let_go_of_the_finished() {
    var index = _handles.count() - 1
    while index >= 0 and index < _handles.count() {
        var held = _handles[index]
        if held.finished {
            _handles.remove_at(index)
            _sites.remove_at(index)
        }
        index = index - 1
    }
}

func unfinished_from(site: Integer): Integer {
    var count = 0
    var index = 0
    while index < _handles.count() and index < _sites.count() {
        var held = _handles[index]
        var same_site = _sites[index] == site
        if same_site and not held.finished {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func wait_for_the_oldest(site: Integer) {
    var index = 0
    while index < _handles.count() and index < _sites.count() {
        var held = _handles[index]
        var same_site = _sites[index] == site
        if same_site and not held.finished {
            _handles.remove_at(index)
            _sites.remove_at(index)
            return
        }
        index = index + 1
    }
}

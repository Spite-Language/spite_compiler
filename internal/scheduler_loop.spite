var alive = List<Spite.Internal.Running>()
var nearest: Long = -1
var depth = 0
var _stepping = List<Spite.Internal.Running>()

func enter(running: Spite.Internal.Running) {
    _stepping.append(running)
}

func leave() {
    _stepping.remove_last()
}

func note_waiting_for(running: Spite.Internal.Running) {
    var current = _stepping.last()
    if current {
        current.waits_for = running
    }
}

var frame: Long = 0
var done = false
var stepping = false
var on_a_thread = false
var waits_for: Spite.Internal.Running? = null

func Running(starting_frame: Long) {
    frame = starting_frame
}

func runs_on_a_thread() {
    on_a_thread = true
}

func reaches(wanted: Long, steps: Integer): Boolean {
    var reached = false
    if waits_for and steps > 0 {
        reached = waits_for.frame == wanted or waits_for.reaches(wanted, steps - 1)
    }
    return reached
}

generic $result_type

var _running: Spite.Internal.Running? = null
var _result: $result_type? = null

func Work(running: Spite.Internal.Running?) {
    _running = running
}

func finished_with(result: $result_type) {
    _result = result
}

func finished_value(): $result_type? {
    if get_finished() {
        return _settled()
    }
    return null
}

func get_finished(): Boolean {
    if _running {
        return finished_running(_running)
    }
    return true
}

func _finished_or_waited(): Boolean {
    var finished = get_finished()
    if not finished {
        _note_the_wait()
    }
    return finished
}

func _note_the_wait() {
    assert _running
    var scheduler = Spite.Internal.Scheduler()
    scheduler.waits_on(_running)
}

func finished_running(running: Spite.Internal.Running): Boolean {
    if running.on_a_thread and not running.done {
        return _frame_done(running.frame)
    }
    return running.done
}

func _settled(): $result_type? {
    _settle()
    return _result
}

func _settle() {
    assert _running
    if not _running.done {
        var scheduler = Spite.Internal.Scheduler()
        scheduler.wait_for(_running)
    }
    _take_the_result()
}

func _take_the_result() {
    assert _running
    _result = _frame_result(_running.frame)
    _free_frame(_running.frame)
    _running = null
}

func drop() {
    _settle()
}

func _frame_result(frame: Long): $result_type?

func _free_frame(frame: Long)

func _frame_done(frame: Long): Boolean

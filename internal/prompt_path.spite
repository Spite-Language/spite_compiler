var written = ""
var kinds = List<String>()
var names = List<String>()
var labels = List<String>()
var typed_texts = List<String>()
var first_arguments = List<Integer>()
var argument_counts = List<Integer>()
var arguments = List<String>()
var problem = ""

func read(text: String) {
    written = text.trim()
    kinds = List<String>()
    names = List<String>()
    labels = List<String>()
    typed_texts = List<String>()
    first_arguments = List<Integer>()
    argument_counts = List<Integer>()
    arguments = List<String>()
    problem = ""
    var length = written.length()
    var at = 0
    var expects_a_name = true
    while at < length and problem.is_empty() {
        if expects_a_name {
            at = _read_a_name(at)
            expects_a_name = false
        } else {
            at = _read_after_a_step(at)
            expects_a_name = at < 0
            if at < 0 {
                at = 0 - at
            }
        }
    }
    if expects_a_name and length > 0 and problem.is_empty() {
        _refuse()
    }
    _leave_out_the_program()
}

func count(): Integer {
    return kinds.count()
}

func kind(at: Integer): String {
    var found = kinds[at]
    crash found
    return found
}

func name(at: Integer): String {
    var found = names[at]
    crash found
    return found
}

func label(at: Integer): String {
    if at == 0 {
        return "program"
    }
    var found = labels[at - 1]
    crash found
    return found
}

func typed(at: Integer): String {
    if at == 0 {
        return "program"
    }
    var found = typed_texts[at - 1]
    crash found
    return found
}

func argument_count(at: Integer): Integer {
    var found = argument_counts[at]
    crash found
    return found
}

func argument(at: Integer, index: Integer): String {
    var first = first_arguments[at]
    crash first
    var found = arguments[first + index]
    crash found
    return found
}

func arguments_text(at: Integer): String {
    var pieces = List<String>()
    var index = 0
    while index < argument_count(at) {
        var piece = argument(at, index)
        pieces.append(piece)
        index = index + 1
    }
    return pieces.join(", ")
}

func _refuse() {
    problem = "'{written}' is not a path the prompt reads: a path is names, [index] and calls with literal arguments, such as player.health or monsters[0].roar()"
}

func _leave_out_the_program() {
    assert not kinds.is_empty() and problem.is_empty()
    var first_kind = kind(0)
    var first_name = name(0)
    if first_kind == "name" and first_name == "program" {
        kinds.remove_at(0)
        names.remove_at(0)
        labels.remove_at(0)
        typed_texts.remove_at(0)
        first_arguments.remove_at(0)
        argument_counts.remove_at(0)
    }
}

func _read_a_name(start: Integer): Integer {
    var length = written.length()
    var code = written.code_at(start)
    var is_capital = code >= 65 and code <= 90
    var end = _name_end(start)
    if end == start {
        _refuse()
        return length
    }
    if is_capital {
        return _read_a_class_name(start, end)
    }
    var read_name = written.slice(start, end)
    if end < length and written.code_at(end) == 40 {
        var closing = _closing_of(end, 40, 41)
        if closing < 0 {
            _refuse()
            return length
        }
        _add_call("call", read_name, end + 1, closing)
        return closing + 1
    }
    _add("name", read_name, read_name)
    return end
}

func _read_a_class_name(start: Integer, first_end: Integer): Integer {
    var length = written.length()
    var end = first_end
    var keeps_going = true
    while keeps_going and end + 1 < length and written.code_at(end) == 46 {
        var next = written.code_at(end + 1)
        if next >= 65 and next <= 90 {
            end = _name_end(end + 1)
        } else {
            keeps_going = false
        }
    }
    if end < length and written.code_at(end) == 60 {
        var closing_angle = _closing_of(end, 60, 62)
        if closing_angle < 0 {
            _refuse()
            return length
        }
        end = closing_angle + 1
    }
    var class_name = written.slice(start, end)
    var without_spaces = class_name.replace(" ", "")
    var opens_a_call = end < length and written.code_at(end) == 40
    if not opens_a_call or not kinds.is_empty() {
        _refuse()
        return length
    }
    var closing = _closing_of(end, 40, 41)
    if closing < 0 {
        _refuse()
        return length
    }
    _add_call("singleton", without_spaces, end + 1, closing)
    return closing + 1
}

func _read_after_a_step(start: Integer): Integer {
    var length = written.length()
    var code = written.code_at(start)
    if code == 46 {
        return 0 - (start + 1)
    }
    if code == 91 {
        var closing = _closing_of(start, 91, 93)
        if closing < 0 {
            _refuse()
            return length
        }
        var inside = written.slice(start + 1, closing)
        var index_text = inside.trim()
        var step_count = kinds.count()
        var before = label(step_count)
        var shown = "{before}[{index_text}]"
        kinds.append("index")
        names.append(index_text)
        labels.append(shown)
        var typed_before = _typed_so_far()
        typed_texts.append("{typed_before}[{index_text}]")
        var no_arguments = arguments.count()
        first_arguments.append(no_arguments)
        argument_counts.append(0)
        return closing + 1
    }
    _refuse()
    return length
}

func _typed_so_far(): String {
    if typed_texts.is_empty() {
        return ""
    }
    var last = typed_texts.last()
    crash last
    return last
}

func _add(added_kind: String, added_name: String, shown: String) {
    var typed_before = _typed_so_far()
    var typed_now = shown
    if not typed_before.is_empty() {
        typed_now = "{typed_before}.{shown}"
    }
    kinds.append(added_kind)
    names.append(added_name)
    labels.append(shown)
    typed_texts.append(typed_now)
    var first_argument = arguments.count()
    first_arguments.append(first_argument)
    argument_counts.append(0)
}

func _add_call(added_kind: String, added_name: String, start: Integer, end: Integer) {
    var shown = "{added_name}()"
    if added_kind == "singleton" {
        shown = added_name
    }
    _add(added_kind, added_name, shown)
    if added_kind == "singleton" {
        var last = typed_texts.count() - 1
        typed_texts[last] = "{added_name}()"
    }
    var inside = written.slice(start, end)
    var trimmed = inside.trim()
    assert not trimmed.is_empty()
    var pieces = _split_arguments(trimmed)
    var last_count = argument_counts.count() - 1
    argument_counts[last_count] = pieces.count()
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        crash piece
        var argument_text = piece.trim()
        if argument_text.is_empty() {
            _refuse()
        }
        arguments.append(argument_text)
        index = index + 1
    }
}

func _split_arguments(inside: String): List<String> {
    var pieces = List<String>()
    var length = inside.length()
    var piece_start = 0
    var quote = 0
    var depth = 0
    var index = 0
    while index < length {
        var code = inside.code_at(index)
        var step = _step_at(code, quote)
        var was_outside = quote == 0
        quote = _quote_after(code, quote)
        if was_outside and quote == 0 {
            depth = _depth_after(code, depth)
        }
        var splits = was_outside and code == 44 and depth == 0
        if splits {
            var piece = inside.slice(piece_start, index)
            pieces.append(piece)
            piece_start = index + 1
        }
        index = index + step
    }
    var rest = inside.slice(piece_start, length)
    pieces.append(rest)
    return pieces
}

func _step_at(code: Integer, quote: Integer): Integer {
    if quote != 0 and code == 92 {
        return 2
    }
    return 1
}

func _quote_after(code: Integer, quote: Integer): Integer {
    var opens = quote == 0 and (code == 34 or code == 39)
    if opens {
        return code
    }
    if code == quote {
        return 0
    }
    return quote
}

func _depth_after(code: Integer, depth: Integer): Integer {
    if code == 40 or code == 91 or code == 60 {
        return depth + 1
    }
    if code == 41 or code == 93 or code == 62 {
        return depth - 1
    }
    return depth
}

func _name_end(start: Integer): Integer {
    var length = written.length()
    var end = start
    var keeps_going = end < length
    while keeps_going {
        var code = written.code_at(end)
        keeps_going = _is_a_name_code(code)
        if keeps_going {
            end = end + 1
            keeps_going = end < length
        }
    }
    return end
}

func _is_a_name_code(code: Integer): Boolean {
    var is_lower = code >= 97 and code <= 122
    var is_upper = code >= 65 and code <= 90
    var is_digit = code >= 48 and code <= 57
    return is_lower or is_upper or is_digit or code == 95
}

func _closing_of(start: Integer, opening: Integer, closing: Integer): Integer {
    var length = written.length()
    var depth = 0
    var quote = 0
    var index = start
    while index < length {
        var code = written.code_at(index)
        var step = _step_at(code, quote)
        var was_outside = quote == 0
        quote = _quote_after(code, quote)
        var counts = was_outside and quote == 0
        if counts and code == opening {
            depth = depth + 1
        }
        if counts and code == closing {
            depth = depth - 1
        }
        if counts and code == closing and depth == 0 {
            return index
        }
        index = index + step
    }
    return -1
}

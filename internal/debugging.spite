singleton

var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var _active = List<Long>()
var _threads = List<Integer>()

func enters(address: Long): Boolean {
    var thread = kernel.GetCurrentThreadId()
    var index = 0
    while index < _active.count() and index < _threads.count() {
        var same_place = _active[index] == address and _threads[index] == thread
        if same_place {
            return false
        }
        index = index + 1
    }
    _active.append(address)
    _threads.append(thread)
    return true
}

func leaves() {
    var thread = kernel.GetCurrentThreadId()
    var index = _threads.count() - 1
    while index >= 0 and index < _threads.count() {
        if _threads[index] == thread {
            _threads.remove_at(index)
            _active.remove_at(index)
            return
        }
        index = index - 1
    }
}

singleton

var console = Console()
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var target = Spite.Internal.PromptPath()
var source = Spite.Internal.PromptPath()
var walking = Spite.Internal.PromptPath()
var mode = ""
var assigned = ""
var assigned_kind = ""
var fetched: Anything? = null
var fetched_class = ""
var fetched_null = false
var fetch_failed = false
var walks_now = false
var enum_lines = ""
var class_lines = ""
var described_names = List<String>()
var described_short_names = List<String>()
var descriptions = List<String>()

func describes(qualified: String, short: String, description: String) {
    described_names.append(qualified)
    described_short_names.append(short)
    descriptions.append(description)
}

func reads(): Boolean {
    walks_now = false
    fetched = null
    fetched_class = ""
    fetched_null = false
    fetch_failed = false
    console.write("spite> ")
    var line = console.read_line()
    if not line {
        console.print("")
        return false
    }
    var command = line.trim()
    if command == "exit" {
        console.print("")
        return false
    }
    _answer(command)
    return true
}

func walks(): Boolean {
    return walks_now
}

func fetches(): Boolean {
    return walks_now and assigned_kind == "path"
}

func start_fetching() {
    walking = source
    mode = "fetch"
}

func fetching_went_well(): Boolean {
    if assigned_kind != "path" {
        return true
    }
    return fetched_null or fetched_class != ""
}

func start_walking() {
    walking = target
    if not assigned_kind.is_empty() {
        mode = "assign"
    }
}

func finish() {
    fetched = null
    walking = Spite.Internal.PromptPath()
}

func _answer(command: String) {
    mode = "show"
    assigned = ""
    assigned_kind = ""
    assert not command.is_empty()
    var words = command.split(" ")
    var first_word = words[0]
    crash first_word
    var rest = ""
    var first_length = first_word.length()
    var command_length = command.length()
    if command_length > first_length {
        var after = command.slice(first_length, command_length)
        rest = after.trim()
    }
    if first_word == "help" {
        _help()
    } else if first_word == "enums" and rest.is_empty() {
        _say_or(enum_lines, "the program declares no enum")
    } else if first_word == "classes" and rest.is_empty() {
        console.print(class_lines)
    } else if first_word == "describe" {
        _describe(rest)
    } else if first_word == "memory" and rest.is_empty() {
        console.print("'memory' counts the live allocations, and this build cannot count them yet")
    } else if first_word == "bytes" {
        _bytes(rest)
    } else if first_word == "attributes" {
        mode = "attributes"
        _read_the_path(rest)
    } else if first_word == "functions" {
        mode = "functions"
        _read_the_path(rest)
    } else {
        _read_an_expression(command)
    }
}

func _say_or(text: String, otherwise: String) {
    if text.is_empty() {
        console.print(otherwise)
    } else {
        console.print(text)
    }
}

func _help() {
    console.print("a path shows a value: program, player.health, monsters[0].name, World().tick")
    console.print("a call runs a function with literal arguments: monsters.count(), player.heal(5)")
    console.print("an assignment writes a literal, null or a path: turn = 7, nickname = null, follower = leader")
    console.print("attributes [path], functions [path], describe <Class>, classes, enums, bytes <path>, bytes <address> <count>, memory, help, exit")
}

func _describe(name: String) {
    if name.is_empty() {
        console.print("describe names a class, such as 'describe Monster': 'classes' lists them")
        return
    }
    var found = -1
    var shared = List<String>()
    var index = 0
    while index < described_names.count() {
        var qualified = described_names[index]
        var short = described_short_names[index]
        crash qualified
        crash short
        if qualified == name {
            found = index
            shared = List<String>()
            index = described_names.count()
        } else {
            if short == name {
                found = index
                shared.append(qualified)
            }
            index = index + 1
        }
    }
    if found < 0 {
        console.print("no class '{name}' in the program: 'classes' lists them")
        return
    }
    if shared.count() > 1 {
        var joined = shared.join(", ")
        console.print("'{name}' names more than one class: {joined}; describe one by its whole name")
        return
    }
    var description = descriptions[found]
    crash description
    console.print(description)
}

func _bytes(rest: String) {
    var words = rest.split(" ")
    var first_word = words[0]
    crash first_word
    var is_an_address = first_word.starts_with("0x")
    if not is_an_address {
        mode = "bytes"
        _read_the_path(rest)
        return
    }
    var count_text = ""
    if words.count() == 2 {
        var second = words[1]
        crash second
        count_text = second
    }
    var wanted = count_text.to_integer()
    var word_length = first_word.length()
    var hexadecimal = first_word.slice(2, word_length)
    var address = _hexadecimal_value(hexadecimal)
    var is_a_range = words.count() == 2 and wanted and address
    if not is_a_range {
        console.print("'bytes' reads a range as 'bytes 0x1f2a40 64': an address in hexadecimal and a count of bytes")
        return
    }
    crash wanted
    crash address
    if wanted < 1 or wanted > 4096 {
        console.print("'bytes' reads from 1 to 4096 bytes at a time, and {count_text} is not in that range")
        return
    }
    var copied = _copied_hex(address, wanted)
    if copied {
        console.print("\{\"address\":\"{first_word}\",\"bytes\":{wanted},\"hex\":\"{copied}\"}")
    } else {
        console.print("unreadable: {first_word} for {wanted} bytes")
    }
}

func _copied_hex(address: Long, wanted: Integer): String? {
    var room = Buffer(wanted)
    var process = kernel.GetCurrentProcess_as_long()
    var no_count: Long = 0
    var copied = kernel.ReadProcessMemory(process, address, room, wanted, no_count)
    assert copied != 0
    room.take_written(wanted)
    var digits = "0123456789abcdef"
    var hex = ""
    var index = 0
    while index < wanted {
        var byte = room.get_at(index)
        crash byte
        var high = digits.character_at(byte / 16)
        var low = digits.character_at(byte % 16)
        hex = "{hex}{high}{low}"
        index = index + 1
    }
    return hex
}

func _hexadecimal_value(digits: String): Long? {
    assert not digits.is_empty() and digits.length() <= 15
    var value: Long = 0
    var index = 0
    while index < digits.length() {
        var code = digits.code_at(index)
        var digit = -1
        if code >= 48 and code <= 57 {
            digit = code - 48
        } else if code >= 97 and code <= 102 {
            digit = code - 87
        } else if code >= 65 and code <= 70 {
            digit = code - 55
        }
        assert digit >= 0
        value = value * 16 + digit
        index = index + 1
    }
    return value
}

func _read_the_path(text: String) {
    target.read(text)
    if not target.problem.is_empty() {
        console.print(target.problem)
        return
    }
    walks_now = true
}

func _read_an_expression(command: String) {
    var equals = _assignment_place(command)
    if equals < 0 {
        _read_the_path(command)
        return
    }
    var left = command.slice(0, equals)
    var command_length = command.length()
    var right = command.slice(equals + 1, command_length)
    var target_text = left.trim()
    assigned = right.trim()
    target.read(target_text)
    if not target.problem.is_empty() {
        console.print(target.problem)
        return
    }
    var last = target.count() - 1
    var assignable = last >= 0
    if assignable {
        var last_kind = target.kind(last)
        assignable = last_kind == "name" or last_kind == "index"
    }
    if not assignable {
        console.print("'{target_text}' is not an attribute or an element: the prompt assigns into one, as in 'player.health = 5' or 'names[0] = \"ann\"'")
        return
    }
    if assigned.is_empty() {
        console.print("'{target_text} =' assigns nothing: write a literal, null or a path after '='")
        return
    }
    assigned_kind = _kind_of_the_literal(assigned)
    if assigned_kind == "path" {
        source.read(assigned)
        if not source.problem.is_empty() {
            console.print(source.problem)
            return
        }
    }
    walks_now = true
}

func _assignment_place(command: String): Integer {
    var scanner = Spite.Internal.PromptPath()
    var quote = 0
    var depth = 0
    var index = 0
    while index < command.length() {
        var code = command.code_at(index)
        var step = scanner._step_at(code, quote)
        var was_outside = quote == 0
        quote = scanner._quote_after(code, quote)
        if was_outside and quote == 0 {
            depth = scanner._depth_after(code, depth)
        }
        if was_outside and code == 61 and depth == 0 {
            return index
        }
        index = index + step
    }
    return -1
}

func _kind_of_the_literal(literal: String): String {
    if literal == "null" {
        return "null"
    }
    if is_whole(literal) or is_decimal(literal) or is_text(literal) or is_symbol(literal) or is_boolean(literal) {
        return "literal"
    }
    return "path"
}

func is_whole(literal: String): Boolean {
    var length = literal.length()
    var index = 0
    if length > 1 and literal.code_at(0) == 45 {
        index = 1
    }
    if index >= length {
        return false
    }
    while index < length {
        var code = literal.code_at(index)
        if code < 48 or code > 57 {
            return false
        }
        index = index + 1
    }
    return true
}

func is_decimal(literal: String): Boolean {
    var parts = literal.split(".")
    if parts.count() != 2 {
        return false
    }
    var whole_part = parts[0]
    var fraction = parts[1]
    crash whole_part
    crash fraction
    var fraction_is_digits = is_whole(fraction) and not fraction.starts_with("-")
    return is_whole(whole_part) and fraction_is_digits
}

func is_text(literal: String): Boolean {
    var length = literal.length()
    return length >= 2 and literal.starts_with("\"") and literal.ends_with("\"")
}

func is_symbol(literal: String): Boolean {
    var length = literal.length()
    return length >= 2 and literal.starts_with("'") and literal.ends_with("'")
}

func is_boolean(literal: String): Boolean {
    return literal == "true" or literal == "false"
}

func text_of(literal: String): String {
    var read = ""
    var length = literal.length()
    var index = 1
    while index < length - 1 {
        var character = literal.character_at(index)
        var escapes = character == "\\" and index + 1 < length - 1
        if escapes {
            var escaped = literal.character_at(index + 1)
            var meant = _escaped(escaped)
            read = "{read}{meant}"
            index = index + 2
        } else {
            read = "{read}{character}"
            index = index + 1
        }
    }
    return read
}

func _escaped(escaped: String): String {
    switch escaped {
        "n": return "\n"
        "t": return "\t"
        "r": return "\r"
        _: return escaped
    }
}

func has_a_hole(literal: String): Boolean {
    var length = literal.length()
    var index = 1
    while index < length - 1 {
        var code = literal.code_at(index)
        if code == 92 {
            index = index + 2
        } else if code == 123 {
            return true
        } else {
            index = index + 1
        }
    }
    return false
}

func symbol_of(literal: String): String {
    var length = literal.length()
    return literal.slice(1, length - 1)
}

func fits(literal: String, kind_name: String): Boolean {
    switch kind_name {
        "Integer": return is_whole(literal) and _reads_as_an_integer(literal)
        "Long": return is_whole(literal) and _reads_as_a_long(literal)
        "Double": return is_whole(literal) or is_decimal(literal)
        "Float": return is_whole(literal) or is_decimal(literal)
        "Boolean": return is_boolean(literal)
        "String": return is_text(literal)
        "enum": return is_symbol(literal)
        _: return false
    }
}

func _reads_as_an_integer(literal: String): Boolean {
    var read = literal.to_integer()
    if read {
        return true
    }
    return false
}

func _reads_as_a_long(literal: String): Boolean {
    var read = literal.to_long()
    if read {
        return true
    }
    return false
}

func integer_of(literal: String): Integer {
    var read = literal.to_integer()
    crash read
    return read
}

func long_of(literal: String): Long {
    var read = literal.to_long()
    crash read
    return read
}

func double_of(literal: String): Double {
    var read = literal.to_double()
    crash read
    return read
}

func float_of(literal: String): Float {
    var read = literal.to_float()
    crash read
    return read
}

func boolean_of(literal: String): Boolean {
    return literal == "true"
}

func article_of(class_name: String): String {
    var first = class_name.code_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an {class_name}"
    }
    return "a {class_name}"
}

func ends(at: Integer): Boolean {
    return at >= walking.count()
}

func assigns(at: Integer): Boolean {
    return mode == "assign" and at == walking.count() - 1
}

func step_kind(at: Integer): String {
    return walking.kind(at)
}

func step_name(at: Integer): String {
    return walking.name(at)
}

func shows(): Boolean {
    return mode == "show"
}

func lists_attributes(): Boolean {
    return mode == "attributes"
}

func lists_functions(): Boolean {
    return mode == "functions"
}

func is_fetching(): Boolean {
    return mode == "fetch"
}

func say(text: String) {
    console.print(text)
}

func fetch(value: Anything, class_name: String) {
    fetched = value
    fetched_class = class_name
}

func fetch_null() {
    fetched_null = true
    fetched_class = "null"
}

func reached_null(at: Integer) {
    if ends(at) and shows() {
        console.print("null")
        return
    }
    if ends(at) and is_fetching() {
        fetch_null()
        return
    }
    var held = walking.label(at)
    if ends(at) {
        console.print("{held} is null, and a null has no {mode}")
        return
    }
    var next = walking.name(at)
    console.print("{held} is null, so '{next}' cannot be read from it")
}

func refuse_bytes(at: Integer) {
    var held = walking.label(at)
    console.print("'bytes {walking.written}' shows the memory of {held}, which this build cannot read yet")
}

func no_attribute(at: Integer, class_name: String, known: String) {
    var held = walking.label(at)
    var asked = walking.name(at)
    var asked_kind = walking.kind(at)
    if asked_kind == "index" {
        var described = article_of(class_name)
        console.print("{held} is {described}, which holds no elements: only a list or a dictionary is indexed")
        return
    }
    if known.is_empty() {
        var described_class = article_of(class_name)
        console.print("{held} is {described_class}, which has no attributes")
        return
    }
    console.print("no attribute '{asked}' in {held}: {known}")
}

func no_attributes(at: Integer, class_name: String) {
    var held = walking.label(at)
    var described = article_of(class_name)
    console.print("{held} is {described}, which has no attributes")
}

func no_functions(at: Integer, class_name: String) {
    var held = walking.label(at)
    var described = article_of(class_name)
    console.print("{held} is {described}, which has no function the prompt can call")
}

func library_class(at: Integer, class_name: String) {
    var held = walking.label(at)
    var described = article_of(class_name)
    console.print("{held} is {described}, a class of the standard library, which the prompt does not walk into")
}

func no_function(at: Integer) {
    var held = walking.label(at)
    var asked = walking.name(at)
    if asked.starts_with("_") {
        console.print("'{asked}' is private to {held}, and the prompt calls what code outside the class may call")
        return
    }
    if asked == "drop" {
        console.print("'drop' runs when {held} is released, and the prompt never runs it")
        return
    }
    console.print("no function '{asked}' in {held}: 'functions' lists them")
}

func not_callable(at: Integer) {
    var typed = walking.typed(at + 1)
    var length = typed.length()
    var shown = typed.slice(0, length - 2)
    console.print("{shown} is not callable")
}

func takes(at: Integer, wanted: Integer): Boolean {
    var given = walking.argument_count(at)
    if given == wanted {
        return true
    }
    var asked = walking.name(at)
    console.print("'{asked}' takes {wanted} argument(s), and this call passes {given}")
    return false
}

func argument_fits(at: Integer, index: Integer, parameter: String, kind_name: String, class_name: String): Boolean {
    var literal = walking.argument(at, index)
    if fits(literal, kind_name) {
        if is_text(literal) and has_a_hole(literal) {
            _refuse_a_hole(literal)
            return false
        }
        return true
    }
    var described = article_of(class_name)
    console.print("type mismatch: {parameter} is {described}, and {literal} is not one")
    return false
}

func argument_text(at: Integer, index: Integer): String {
    return walking.argument(at, index)
}

func cannot_take(at: Integer) {
    var asked = walking.name(at)
    var given = walking.arguments_text(at)
    console.print("'{asked}' cannot take ({given}): the loop writes numbers, Boolean, text and an enum's own values")
}

func ran_nothing(at: Integer) {
    var typed = walking.typed(at + 1)
    console.print("{typed} ran, and it answers nothing, so nothing can follow it")
}

func answered_nothing(at: Integer) {
    var shown = ends(at + 1) and shows()
    if not shown {
        ran_nothing(at)
    }
}

func index_of_a_list(at: Integer, held_count: Integer): Integer? {
    var literal = walking.name(at)
    var held = walking.label(at)
    var is_an_index = is_whole(literal) and _reads_as_an_integer(literal)
    if not is_an_index {
        console.print("{held} is indexed by a whole number, and {literal} is not one")
        return null
    }
    var index = integer_of(literal)
    if index < 0 or index >= held_count {
        console.print("index {index} is out of range: {held} holds {held_count}")
        return null
    }
    return index
}

func key_fits(at: Integer, kind_name: String, class_name: String): Boolean {
    var literal = walking.name(at)
    if fits(literal, kind_name) {
        if is_text(literal) and has_a_hole(literal) {
            _refuse_a_hole(literal)
            return false
        }
        return true
    }
    var held = walking.label(at)
    var described = article_of(class_name)
    console.print("{held} is keyed by {described}, and {literal} is not one")
    return false
}

func key(at: Integer): String {
    return walking.name(at)
}

func no_key(at: Integer) {
    var held = walking.label(at)
    var literal = walking.name(at)
    console.print("{held} holds no key {literal}")
}

func no_keys(at: Integer) {
    var held = walking.label(at)
    console.print("{held} holds no keys")
}

func assigns_null(): Boolean {
    return assigned_kind == "null" or assigned_kind == "path" and fetched_null
}

func assigns_a_literal(): Boolean {
    return assigned_kind == "literal"
}

func literal_fits(kind_name: String, class_name: String): Boolean {
    if fits(assigned, kind_name) {
        if is_text(assigned) and has_a_hole(assigned) {
            _refuse_a_hole(assigned)
            return false
        }
        return true
    }
    mismatch(class_name)
    return false
}

func mismatch(class_name: String) {
    var described = article_of(class_name)
    console.print("type mismatch: {target.written} is {described}, and {assigned} is not one")
}

func never_null(class_name: String) {
    var described = article_of(class_name)
    console.print("{target.written} is {described}, which is never null: only a T? holds null")
}

func wrong_instance(class_name: String) {
    var found = article_of(fetched_class)
    var described = article_of(class_name)
    console.print("{target.written} is {described}, and {source.written} is {found}: the loop assigns an instance of the attribute's own class")
}

func not_a_value(class_name: String) {
    var described = article_of(class_name)
    console.print("{assigned} is not {described}, or {target.written} cannot be assigned")
}

func assigned_text(): String {
    return text_of(assigned)
}

func assigned_symbol(): String {
    return symbol_of(assigned)
}

func _refuse_a_hole(literal: String) {
    console.print("{literal} has a hole, and the prompt reads a text literal as it is written: \\\{ writes a brace, and 'eval' makes text from values")
}

func bound_without_arguments(at: Integer, class_name: String): Boolean {
    var given = walking.argument_count(at)
    if given == 0 {
        return true
    }
    console.print("'{class_name}' is a singleton made without arguments, so it takes none: {class_name}()")
    return false
}

func not_a_singleton(at: Integer) {
    var asked = walking.name(at)
    console.print("'{asked}' is a class, not a singleton: the prompt never makes an object, it reads the ones the program holds, and 'classes' lists the singletons")
}

func no_singleton(at: Integer) {
    var asked = walking.name(at)
    console.print("no singleton '{asked}' in the program: 'classes' lists them")
}

func shared_singleton(at: Integer, sharing: String) {
    var asked = walking.name(at)
    console.print("'{asked}' names more than one singleton: {sharing}; name one by its whole name")
}

func opaque(at: Integer, class_name: String) {
    var held = walking.label(at)
    if ends(at) and shows() {
        console.print("{class_name} \{...}")
        return
    }
    var described = article_of(class_name)
    console.print("{held} is {described}, which the prompt cannot read into")
}

func unwritable(class_name: String) {
    var described = article_of(class_name)
    console.print("{target.written} is {described}, and the loop writes Integer, Long, Double, Float, Boolean, text and an enum's own values")
}

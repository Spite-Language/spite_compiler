var _copies = Dictionary<Long, Long>()
var _settling = List<Spite.Function<Spite.Internal.CopyTable, Nothing>>()

func copy_at(original: Long): Long? {
    return _copies[original]
}

func remember(original: Long, copied: Long) {
    _copies[original] = copied
}

func later(settling: Spite.Function<Spite.Internal.CopyTable, Nothing>) {
    _settling.append(settling)
}

func settle() {
    var index = 0
    while index < _settling.count() {
        var settling = _settling[index]
        settling(this)
        index = index + 1
    }
}

singleton

var console = Console()
var _sites = List<String>()
var _counts = List<Integer>()
var _newest = -1
var _lines = 0

func failed(site: String, streams: Boolean) {
    if streams {
        console.error(site)
    }
    if _lines > 0 and _sites[_newest] == site {
        var count = _counts[_newest]
        crash count
        _counts[_newest] = count + 1
        return
    }
    _newest = (_newest + 1) % 32
    if _sites.count() < 32 {
        _sites.append(site)
        _counts.append(1)
    } else {
        _sites[_newest] = site
        _counts[_newest] = 1
    }
    _lines = _lines + 1
}

func report() {
    var kept = _sites.count()
    if _lines > kept {
        var earlier = _lines - kept
        console.error("spite.assert\tearlier={earlier}")
    }
    var oldest = 0
    if kept == 32 {
        oldest = (_newest + 1) % 32
    }
    var index = 0
    while index < kept {
        var place = (oldest + index) % 32
        report_line(place)
        index = index + 1
    }
}

func report_line(place: Integer) {
    var site = _sites[place]
    var count = _counts[place]
    crash site
    crash count
    if count > 1 {
        console.error("{site}\trepeated={count}")
    } else {
        console.error(site)
    }
}

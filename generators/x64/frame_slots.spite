var no_allocation = NoAllocation()
var state: AllocationState = no_allocation.state
var answers = Answers(state)

func FrameSlots(starting_state: AllocationState) {
    state = starting_state
    answers = Answers(starting_state)
}

func give_each_its_own_slot() {
    state.frame_homes.clear()
    var register = 0
    while register < state.register_total {
        state.frame_homes.append(register)
        register = register + 1
    }
    state.frame_slot_total = state.register_total
}

# ../../OPTIMIZATIONS.md#values-whose-lives-do-not-overlap-share-a-frame-slot
func share_the_slots() {
    answers.fill_with_numbers(state.frame_homes, state.register_total, -1)
    var starting = List<Integer>()
    var ending = List<Integer>()
    answers.fill_with_numbers(starting, state.position_total + 1, -1)
    answers.fill_with_numbers(ending, state.position_total + 1, -1)
    var next_starting = List<Integer>()
    var next_ending = List<Integer>()
    answers.fill_with_numbers(next_starting, state.register_total, -1)
    answers.fill_with_numbers(next_ending, state.register_total, -1)
    var register = state.register_total - 1
    while register >= 0 {
        var made_starts = state.segment_starts[register]
        var made_ends = state.segment_ends[register]
        crash made_starts
        crash made_ends
        if not made_starts.is_empty() {
            var first = made_starts[0]
            var last = made_ends.last()
            crash first
            crash last
            var first_starting = starting[first]
            var last_ending = ending[last]
            crash first_starting
            crash last_ending
            next_starting[register] = first_starting
            starting[first] = register
            next_ending[register] = last_ending
            ending[last] = register
        }
        register = register - 1
    }
    var free = List<Integer>()
    state.frame_slot_total = 0
    var position = 0
    while position <= state.position_total {
        var current = starting[position]
        crash current
        while current >= 0 {
            take_a_slot(current, free)
            var following = next_starting[current]
            crash following
            current = following
        }
        current = ending[position]
        crash current
        while current >= 0 {
            var slot = state.frame_homes[current]
            crash slot
            free.append(slot)
            var following = next_ending[current]
            crash following
            current = following
        }
        position = position + 1
    }
}

func take_a_slot(register: Integer, free: List<Integer>) {
    if free.is_empty() {
        state.frame_homes[register] = state.frame_slot_total
        state.frame_slot_total = state.frame_slot_total + 1
        return
    }
    var slot = free.remove_last()
    crash slot
    state.frame_homes[register] = slot
}

var state = AllocationState()
var answers = Answers(state)
var operand_readings = OperandReadings(state)
var address_folds = AddressFolds(state)
var block_flow = BlockFlow(state)
var intervals = Intervals(state)
var lives = Lives(state)

# ../../ARCHITECTURE.md#the-targets
func Allocation(starting_function: LowIntermediaryRepresentation.LowFunction, convention: CallingConvention) {
    state.function = starting_function
    state.keeping = convention.kept_registers
    state.volatile_homes = convention.scratch_registers
    state.argument_registers = convention.argument_registers
    state.first_kept_decimal = convention.first_kept_decimal
}

func allocate() {
    block_flow.lay_out_the_blocks()
    state.register_total = state.operands.most_register_of(state.function)
    make_the_tables()
    fallback not state.function.is_resumable
    operand_readings.read_the_operands()
    address_folds.fold_the_addresses()
    block_flow.find_the_flow()
    lives.find_the_lives()
    intervals.build_the_intervals()
    place_the_values()
}

func make_the_tables() {
    answers.fill_with_numbers(state.definitions, state.register_total, 0)
    answers.fill_with_numbers(state.readings, state.register_total, 0)
    answers.fill_with_numbers(state.homes, state.register_total, -1)
    answers.fill_with_numbers(state.starts, state.register_total, -1)
    answers.fill_with_numbers(state.ends, state.register_total, -1)
    var index = 0
    while index < state.register_total {
        state.is_constant.append(false)
        state.constants.append(0)
        state.fused.append(false)
        state.elided_targets.append(false)
        state.is_split.append(false)
        state.address_bases.append(-1)
        state.address_indexes.append(-1)
        state.address_scales.append(1)
        state.address_displacements.append(0)
        state.data_labels.append(-1)
        state.rematerialised.append(false)
        state.rematerialised_blocks.append(0)
        state.rematerialised_labels.append(-1)
        index = index + 1
    }
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func takes_a_split_volatile(register: Integer): Boolean {
    var decimal_size = state.decimal_sizes[register]
    crash decimal_size
    if decimal_size > 0 {
        return takes_a_split_decimal(register)
    }
    var slot_blocks = clobbered_blocks(register)
    fallback not slot_blocks.is_empty() and split_pays(register, slot_blocks)
    var kept_starts = List<Integer>()
    var kept_ends = List<Integer>()
    keep_the_stretches(register, slot_blocks, kept_starts, kept_ends)
    fallback not kept_starts.is_empty()
    var index = 0
    while index < state.volatile_homes.count() {
        var candidate = state.volatile_homes[index]
        crash candidate
        if may_hold(candidate, register) and is_free_over(candidate, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

func clobbered_blocks(register: Integer): List<Integer> {
    var found = List<Integer>()
    var blocks = state.value_blocks[register]
    var block_starts = state.value_block_starts[register]
    var block_ends = state.value_block_ends[register]
    crash blocks
    crash block_starts
    crash block_ends
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        var start = block_starts[index]
        var end = block_ends[index]
        crash block_index
        crash start
        crash end
        if clobbered_between(start, end) and not found.contains(block_index) {
            found.append(block_index)
        }
        index = index + 1
    }
    return found
}

func keep_the_stretches(
    register: Integer,
    slot_blocks: List<Integer>,
    kept_starts: List<Integer>,
    kept_ends: List<Integer>,
) {
    var blocks = state.value_blocks[register]
    var block_starts = state.value_block_starts[register]
    var block_ends = state.value_block_ends[register]
    crash blocks
    crash block_starts
    crash block_ends
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        var start = block_starts[index]
        var end = block_ends[index]
        crash block_index
        crash start
        crash end
        if not slot_blocks.contains(block_index) {
            intervals.add_to_stretches(kept_starts, kept_ends, start, end)
        }
        index = index + 1
    }
}

func split_pays(register: Integer, slot_blocks: List<Integer>): Boolean {
    return split_gain(register, slot_blocks) > 0
}

func split_gain(register: Integer, slot_blocks: List<Integer>): Long {
    var slots = block_set(slot_blocks)
    var benefit: Long = 0
    var counted = Dictionary<Long, Boolean>()
    var blocks = state.value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var key: Long = block_index
        if slots[key] != true and counted[key] != true {
            counted[key] = true
            benefit = benefit + lives.weight_in(register, block_index)
        }
        index = index + 1
    }
    return benefit - moves_of(register, slot_blocks, slots)
}

func block_set(blocks: List<Integer>): Dictionary<Long, Boolean> {
    var made = Dictionary<Long, Boolean>()
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var key: Long = block_index
        made[key] = true
        index = index + 1
    }
    return made
}

func holds(blocks: Dictionary<Long, Boolean>, block_index: Integer): Boolean {
    var key: Long = block_index
    return blocks[key] == true
}

func moves_of(register: Integer, slot_blocks: List<Integer>, slots: Dictionary<Long, Boolean>): Long {
    var cost: Long = 0
    var index = 0
    while index < slot_blocks.count() {
        var slot_block = slot_blocks[index]
        crash slot_block
        cost = cost + moves_around(register, slot_block, slots)
        index = index + 1
    }
    return cost
}

func moves_around(register: Integer, slot_block: Integer, slots: Dictionary<Long, Boolean>): Long {
    var cost: Long = 0
    var coming = state.predecessors[slot_block]
    var leaving = state.successors[slot_block]
    crash coming
    crash leaving
    var index = 0
    while lives.is_live_into(register, slot_block) and index < coming.count() {
        var predecessor = coming[index]
        crash predecessor
        if not holds(slots, predecessor) {
            cost = cost + lives.edge_weight(predecessor, slot_block)
        }
        index = index + 1
    }
    index = 0
    while index < leaving.count() {
        var successor = leaving[index]
        crash successor
        if lives.is_live_into(register, successor) and not holds(slots, successor) {
            cost = cost + lives.edge_weight(slot_block, successor)
        }
        index = index + 1
    }
    return cost
}

func is_free_over(physical: Integer, kept_starts: List<Integer>, kept_ends: List<Integer>): Boolean {
    if kept_starts.is_empty() {
        return true
    }
    var holding = state.every_holder[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        var other_starts = state.segment_starts[other]
        var other_ends = state.segment_ends[other]
        crash other_starts
        crash other_ends
        var other_end = state.ends[other]
        var first_kept = kept_starts[0]
        crash other_end
        crash first_kept
        var reaches = other_end >= first_kept
        fallback not reaches or not intervals.stretches_overlap(other_starts, other_ends, kept_starts, kept_ends)
        index = index + 1
    }
    return true
}

func split_around(register: Integer, slot_blocks: List<Integer>, kept_starts: List<Integer>, kept_ends: List<Integer>) {
    state.segment_starts[register] = kept_starts
    state.segment_ends[register] = kept_ends
    state.is_split[register] = true
    state.split_values.append(register)
    var index = 0
    while index < slot_blocks.count() {
        var slot_block = slot_blocks[index]
        crash slot_block
        state.slot_keys[answers.key_of(register, slot_block)] = true
        index = index + 1
    }
}

func gave_up_a_constant(slot: Integer, register: Integer): Boolean {
    var conflicts = conflicts_on(slot, register)
    fallback conflicts.count() == 1
    var other = conflicts[0]
    crash other
    fallback state.decimal_constants[other] == true and state.is_split[other] != true and not crosses_a_vector_loop(other)
    state.homes[other] = -1
    state.is_constant[other] = true
    var holding = state.assigned[slot]
    crash holding
    var at = holding.index_of(other)
    crash at
    holding.remove_at(at)
    var ever_holding = state.every_holder[slot]
    crash ever_holding
    var ever_at = ever_holding.index_of(other)
    crash ever_at
    ever_holding.remove_at(ever_at)
    give(slot, register)
    return true
}

func spill_the_cheapest(register: Integer) {
    var cheapest_physical = -1
    var cheapest_other = -1
    var cheapest_weight: Long = weight_of(register)
    var cheapest_length: Long = length_of(register)
    var index = 0
    while index < state.keeping.count() {
        var candidate = state.keeping[index]
        crash candidate
        var conflicts = conflicts_on(candidate, register)
        if conflicts.count() == 1 {
            var other = conflicts[0]
            crash other
            var other_weight: Long = weight_of(other)
            var other_length: Long = length_of(other)
            if other_weight * cheapest_length < cheapest_weight * other_length {
                cheapest_physical = candidate
                cheapest_other = other
                cheapest_weight = other_weight
                cheapest_length = other_length
            }
        }
        index = index + 1
    }
    if cheapest_physical < 0 {
        state.homes[register] = -1
        fallback not takes_a_loop_split(register)
        return
    }
    state.homes[cheapest_other] = -1
    var holding = state.assigned[cheapest_physical]
    crash holding
    var at = holding.index_of(cheapest_other)
    crash at
    holding.remove_at(at)
    var ever_holding = state.every_holder[cheapest_physical]
    crash ever_holding
    var ever_at = ever_holding.index_of(cheapest_other)
    crash ever_at
    ever_holding.remove_at(ever_at)
    give(cheapest_physical, register)
    fallback not takes_a_whole_volatile(cheapest_other, false, 3)
    fallback not takes_a_split_volatile(cheapest_other)
    fallback not takes_a_loop_split(cheapest_other)
}

# ../../OPTIMIZATIONS.md#a-value-spilled-outside-a-loop-lives-in-a-register-inside-it
func takes_a_loop_split(register: Integer): Boolean {
    fallback not crosses_a_vector_loop(register)
    var depth = deepest_use_of(register)
    while depth >= 1 {
        if takes_a_split_at(register, depth) {
            return true
        }
        depth = depth - 1
    }
    return false
}

func takes_a_split_at(register: Integer, depth: Integer): Boolean {
    var slot_blocks = shallower_blocks(register, depth)
    fallback not slot_blocks.is_empty() and split_pays(register, slot_blocks)
    var kept_starts = List<Integer>()
    var kept_ends = List<Integer>()
    keep_the_stretches(register, slot_blocks, kept_starts, kept_ends)
    fallback not kept_starts.is_empty()
    var decimal_size = state.decimal_sizes[register]
    crash decimal_size
    if decimal_size > 0 {
        return took_a_decimal_over(register, slot_blocks, kept_starts, kept_ends)
    }
    var index = 0
    while index < state.keeping.count() {
        var candidate = state.keeping[index]
        crash candidate
        if is_free_over(candidate, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    if not stretches_clobbered(kept_starts, kept_ends) {
        index = 0
        while index < state.volatile_homes.count() {
            var candidate = state.volatile_homes[index]
            crash candidate
            if may_hold(candidate, register) and is_free_over(candidate, kept_starts, kept_ends) {
                split_around(register, slot_blocks, kept_starts, kept_ends)
                give(candidate, register)
                return true
            }
            index = index + 1
        }
    }
    return took_from_a_holder(register, slot_blocks, kept_starts, kept_ends)
}

# ../../OPTIMIZATIONS.md#a-value-that-barely-uses-a-loop-gives-its-register-to-one-that-does
func took_from_a_holder(
    register: Integer,
    slot_blocks: List<Integer>,
    kept_starts: List<Integer>,
    kept_ends: List<Integer>,
): Boolean {
    var kept_blocks = Dictionary<Long, Boolean>()
    var gain: Long = 0
    var measured = false
    var index = 0
    while index < state.keeping.count() {
        var candidate = state.keeping[index]
        crash candidate
        var holder = lone_holder_over(candidate, kept_starts, kept_ends)
        if holder >= 0 and not measured {
            measured = true
            kept_blocks = blocks_outside(register, slot_blocks)
            gain = split_gain(register, slot_blocks)
        }
        if holder >= 0 and gave_way(holder, kept_blocks, gain) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

func blocks_outside(register: Integer, slot_blocks: List<Integer>): Dictionary<Long, Boolean> {
    var slots = block_set(slot_blocks)
    var found = Dictionary<Long, Boolean>()
    var blocks = state.value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        if not holds(slots, block_index) {
            var key: Long = block_index
            found[key] = true
        }
        index = index + 1
    }
    return found
}

func lone_holder_over(physical: Integer, kept_starts: List<Integer>, kept_ends: List<Integer>): Integer {
    var found = -1
    var first_kept = kept_starts[0]
    crash first_kept
    var holding = state.every_holder[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        var other_starts = state.segment_starts[other]
        var other_ends = state.segment_ends[other]
        var other_end = state.ends[other]
        crash other_starts
        crash other_ends
        crash other_end
        var reaches = other_end >= first_kept
        if reaches and intervals.stretches_overlap(other_starts, other_ends, kept_starts, kept_ends) {
            if found >= 0 {
                return -1
            }
            found = other
        }
        index = index + 1
    }
    return found
}

func gave_way(holder: Integer, kept_blocks: Dictionary<Long, Boolean>, gain: Long): Boolean {
    fallback holder >= state.function.parameter_count and state.is_split[holder] != true
    var decimal_size = state.decimal_sizes[holder]
    var joined = state.joined_lefts[holder]
    crash decimal_size
    crash joined
    fallback decimal_size <= 0 and joined < 0 and not crosses_a_vector_loop(holder)
    var holder_slots = List<Integer>()
    var taken = Dictionary<Long, Boolean>()
    var blocks = state.value_blocks[holder]
    crash blocks
    var loss: Long = 0
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var key: Long = block_index
        if kept_blocks[key] == true and taken[key] != true {
            taken[key] = true
            holder_slots.append(block_index)
            loss = loss + lives.weight_in(holder, block_index)
        }
        index = index + 1
    }
    fallback not holder_slots.is_empty()
    loss = loss + moves_of(holder, holder_slots, taken)
    fallback gain > loss
    var holder_starts = List<Integer>()
    var holder_ends = List<Integer>()
    keep_the_stretches(holder, holder_slots, holder_starts, holder_ends)
    fallback not holder_starts.is_empty()
    split_around(holder, holder_slots, holder_starts, holder_ends)
    return true
}

# ../../OPTIMIZATIONS.md#a-decimal-leaves-its-register-only-where-it-must
func takes_a_split_decimal(register: Integer): Boolean {
    fallback not crosses_a_vector_loop(register)
    var slot_blocks = clobbered_blocks(register)
    fallback not slot_blocks.is_empty() and split_pays(register, slot_blocks)
    var kept_starts = List<Integer>()
    var kept_ends = List<Integer>()
    keep_the_stretches(register, slot_blocks, kept_starts, kept_ends)
    fallback not kept_starts.is_empty()
    return took_a_decimal_over(register, slot_blocks, kept_starts, kept_ends)
}

func took_a_decimal_over(
    register: Integer,
    slot_blocks: List<Integer>,
    kept_starts: List<Integer>,
    kept_ends: List<Integer>,
): Boolean {
    var clobbered = stretches_clobbered(kept_starts, kept_ends)
    var candidate = 3
    while candidate < 16 {
        var slot = 16 + candidate
        var usable = candidate >= state.first_kept_decimal or not clobbered
        if usable and is_free_over(slot, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(slot, register)
            return true
        }
        candidate = candidate + 1
    }
    return false
}

func deepest_use_of(register: Integer): Integer {
    var deepest = 0
    var blocks = state.value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var depth = state.depths[block_index]
        crash depth
        if depth > deepest and lives.weight_in(register, block_index) > 0 {
            deepest = depth
        }
        index = index + 1
    }
    return deepest
}

func shallower_blocks(register: Integer, deepest: Integer): List<Integer> {
    var found = List<Integer>()
    var blocks = state.value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var depth = state.depths[block_index]
        crash depth
        if depth < deepest and not found.contains(block_index) {
            found.append(block_index)
        }
        index = index + 1
    }
    return found
}

func stretches_clobbered(kept_starts: List<Integer>, kept_ends: List<Integer>): Boolean {
    var index = 0
    while index < kept_starts.count() {
        var start = kept_starts[index]
        var end = kept_ends[index]
        crash start
        crash end
        if clobbered_between(start, end) {
            return true
        }
        index = index + 1
    }
    return false
}

func length_of(register: Integer): Integer {
    var made_starts = state.segment_starts[register]
    var made_ends = state.segment_ends[register]
    crash made_starts
    crash made_ends
    var length = 8
    var index = 0
    while index < made_starts.count() {
        var start = made_starts[index]
        var end = made_ends[index]
        crash start
        crash end
        length = length + end - start + 1
        index = index + 1
    }
    return length
}

func weight_of(register: Integer): Integer {
    if answers.is_rematerialised(register) {
        var block_index = state.rematerialised_blocks[register]
        crash block_index
        var depth = state.depths[block_index]
        crash depth
        return lives.weight_at_depth(depth)
    }
    var weight = state.weights[register]
    crash weight
    return weight
}

func place_the_values() {
    scan_the_intervals()
    find_the_saved()
}

func scan_the_intervals() {
    var heads = List<Integer>()
    answers.fill_with_numbers(heads, state.position_total + 1, -1)
    var chained = List<Integer>()
    answers.fill_with_numbers(chained, state.register_total, -1)
    var register = state.register_total - 1
    while register >= 0 {
        var start = state.starts[register]
        crash start
        if start >= 0 {
            var head = heads[start]
            crash head
            chained[register] = head
            heads[start] = register
        }
        register = register - 1
    }
    var physical = 0
    while physical < 32 {
        var holding = List<Integer>()
        state.assigned.append(holding)
        var ever_holding = List<Integer>()
        state.every_holder.append(ever_holding)
        physical = physical + 1
    }
    var position = 0
    while position <= state.position_total {
        var next = heads[position]
        crash next
        var current = next
        if current >= 0 {
            expire_the_assigned(position)
        }
        while current >= 0 {
            place(current)
            var following = chained[current]
            crash following
            current = following
        }
        position = position + 1
    }
}

func place(register: Integer) {
    var decimal_size = state.decimal_sizes[register]
    crash decimal_size
    fallback not joins_its_left(register)
    fallback decimal_size <= 0 or not placed_in_a_decimal(register)
    fallback decimal_size <= 0 or not took_a_constants_decimal(register)
    fallback decimal_size <= 0 or not takes_a_split_decimal(register)
    fallback decimal_size <= 0
    fallback not takes_a_whole_volatile(register, true, 1)
    var index = 0
    while index < state.keeping.count() {
        var candidate = state.keeping[index]
        crash candidate
        if is_free_for(candidate, register) {
            give(candidate, register)
            return
        }
        index = index + 1
    }
    fallback not takes_a_whole_volatile(register, true, 3)
    fallback not takes_a_split_volatile(register)
    spill_the_cheapest(register)
}

func may_hold(physical: Integer, register: Integer): Boolean {
    return not state.argument_registers.contains(physical) or register >= state.function.parameter_count
}

func takes_a_whole_volatile(register: Integer, starts_here: Boolean, tried: Integer): Boolean {
    fallback not clobbered_in_a_segment(register)
    var own_starts = state.segment_starts[register]
    var own_ends = state.segment_ends[register]
    crash own_starts
    crash own_ends
    var index = 0
    while index < tried {
        var candidate = state.volatile_homes[index]
        crash candidate
        var free = false
        if starts_here {
            free = is_free_for(candidate, register)
        } else {
            free = is_free_over(candidate, own_starts, own_ends)
        }
        if may_hold(candidate, register) and free {
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

func joins_its_left(register: Integer): Boolean {
    var left = state.joined_lefts[register]
    var position = state.joined_positions[register]
    var block_index = state.joined_blocks[register]
    crash left
    crash position
    crash block_index
    fallback left >= 0 and not answers.constant_of(left) and not answers.is_fused(left) and not answers.is_fused(register) and state.is_split[left] != true
    var physical = state.homes[left]
    crash physical
    var end = state.ends[left]
    crash end
    fallback physical >= 0 and end == position and state.live_out_keys[answers.key_of(left, block_index)] != true
    var decimal_size = state.decimal_sizes[register]
    var left_size = state.decimal_sizes[left]
    crash decimal_size
    crash left_size
    fallback decimal_size == left_size
    if physical >= 16 {
        var usable = physical >= 16 + state.first_kept_decimal or not clobbered_in_a_segment(register)
        fallback usable and not crosses_a_vector_loop(register)
    } else {
        fallback not answers.is_a_volatile_home(physical) or may_hold(physical, register) and not clobbered_in_a_segment(register)
    }
    fallback is_free_beside(physical, register, left, position)
    give(physical, register)
    return true
}

func is_free_beside(physical: Integer, register: Integer, left: Integer, position: Integer): Boolean {
    var holding = state.assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        if other == left {
            fallback not overlaps_beyond(left, register, position)
        } else {
            fallback not intervals.overlaps(other, register)
        }
        index = index + 1
    }
    return true
}

func overlaps_beyond(left: Integer, register: Integer, position: Integer): Boolean {
    var first_starts = state.segment_starts[left]
    var first_ends = state.segment_ends[left]
    var second_starts = state.segment_starts[register]
    var second_ends = state.segment_ends[register]
    crash first_starts
    crash first_ends
    crash second_starts
    crash second_ends
    var first_index = 0
    while first_index < first_starts.count() {
        var first_start = first_starts[first_index]
        var first_end = first_ends[first_index]
        crash first_start
        crash first_end
        var second_index = 0
        while second_index < second_starts.count() {
            var second_start = second_starts[second_index]
            var second_end = second_ends[second_index]
            crash second_start
            crash second_end
            var meets = first_end == position and second_start == position
            if first_start <= second_end and second_start <= first_end and not meets {
                return true
            }
            second_index = second_index + 1
        }
        first_index = first_index + 1
    }
    return false
}

func placed_in_a_decimal(register: Integer): Boolean {
    fallback not crosses_a_vector_loop(register)
    var clobbered = clobbered_in_a_segment(register)
    var candidate = 3
    while candidate < 16 {
        var slot = 16 + candidate
        var usable = candidate >= state.first_kept_decimal or not clobbered
        if usable and is_free_for(slot, register) {
            give(slot, register)
            return true
        }
        candidate = candidate + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-decimal-constant-gives-up-its-register-to-a-value
func took_a_constants_decimal(register: Integer): Boolean {
    fallback not crosses_a_vector_loop(register) and state.decimal_constants[register] != true
    var clobbered = clobbered_in_a_segment(register)
    var candidate = 3
    while candidate < 16 {
        var slot = 16 + candidate
        var usable = candidate >= state.first_kept_decimal or not clobbered
        if usable and gave_up_a_constant(slot, register) {
            return true
        }
        candidate = candidate + 1
    }
    return false
}

func find_the_saved() {
    var index = 0
    while index < state.keeping.count() {
        var candidate = state.keeping[index]
        if state.homes.contains(candidate) {
            state.saved.append(candidate)
        }
        index = index + 1
    }
    var decimal = state.first_kept_decimal
    while decimal < 16 {
        if state.homes.contains(16 + decimal) {
            state.saved_decimals.append(decimal)
        }
        decimal = decimal + 1
    }
}

func clobbered_between(start: Integer, end: Integer): Boolean {
    var before = 0
    if start > 0 {
        var counted = state.clobbers_until[start - 1]
        crash counted
        before = counted
    }
    var through = state.clobbers_until[end]
    crash through
    return through > before
}

func clobbered_in_a_segment(register: Integer): Boolean {
    var made_starts = state.segment_starts[register]
    var made_ends = state.segment_ends[register]
    crash made_starts
    crash made_ends
    var index = 0
    while index < made_starts.count() {
        var start = made_starts[index]
        var end = made_ends[index]
        crash start
        crash end
        if clobbered_between(start, end) {
            return true
        }
        index = index + 1
    }
    return false
}

func crosses_a_vector_loop(register: Integer): Boolean {
    fallback not state.vector_positions.is_empty()
    var made_starts = state.segment_starts[register]
    var made_ends = state.segment_ends[register]
    crash made_starts
    crash made_ends
    var loop_index = 0
    while loop_index < state.vector_positions.count() {
        var position = state.vector_positions[loop_index]
        var touched = state.vector_operands[loop_index]
        crash position
        crash touched
        if not touched.contains(register) {
            var index = 0
            while index < made_starts.count() {
                var start = made_starts[index]
                var end = made_ends[index]
                crash start
                crash end
                if start < position and end > position {
                    return true
                }
                index = index + 1
            }
        }
        loop_index = loop_index + 1
    }
    return false
}

func conflicts_on(physical: Integer, register: Integer): List<Integer> {
    var found = List<Integer>()
    var holding = state.assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        if intervals.overlaps(other, register) {
            found.append(other)
        }
        index = index + 1
    }
    return found
}

func is_free_for(physical: Integer, register: Integer): Boolean {
    var holding = state.assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        fallback not intervals.overlaps(other, register)
        index = index + 1
    }
    return true
}

func give(physical: Integer, register: Integer) {
    state.homes[register] = physical
    var holding = state.assigned[physical]
    crash holding
    holding.append(register)
    var ever_holding = state.every_holder[physical]
    crash ever_holding
    ever_holding.append(register)
}

func expire_the_assigned(position: Integer) {
    var physical = 0
    while physical < state.assigned.count() {
        var holding = state.assigned[physical]
        var index = 0
        while index < holding.count() {
            var other = holding[index]
            crash other
            var end = state.ends[other]
            crash end
            if end < position {
                holding.remove_at(index)
            } else {
                index = index + 1
            }
        }
        physical = physical + 1
    }
}

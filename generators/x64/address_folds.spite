var no_allocation = NoAllocation()
var state: AllocationState = no_allocation.state
var answers = Answers(state)
var checks = LowIntermediaryRepresentation.Checks()

func AddressFolds(starting_state: AllocationState) {
    state = starting_state
    answers = Answers(starting_state)
}

func fold_the_addresses() {
    find_the_fused_compares()
    find_the_addresses()
}

func find_the_fused_compares() {
    var block_index = 0
    while block_index < state.function.blocks.count() {
        var block = state.function.blocks[block_index]
        var index = 0
        while index + 1 < block.instructions.count() {
            var instruction = block.instructions[index]
            var following = block.instructions[index + 1]
            fuse_when_it_fits(instruction, following)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func fuse_when_it_fits(instruction: SpiteCompiler.Instruction, following: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Compare and following.class == LowIntermediaryRepresentation.Instructions.Branch {
        var target = instruction.target
        var only_read_here = following.condition == target and answers.reading_count_of(target) == 1
        var defined_once = state.definitions[target] == 1
        if only_read_here and defined_once and not answers.constant_of(target) and target >= state.function.parameter_count {
            state.fused[target] = true
        }
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Decimal.Compare and following.class == LowIntermediaryRepresentation.Instructions.Branch {
        var decimal_target = instruction.target
        var read_here = following.condition == decimal_target and answers.reading_count_of(decimal_target) == 1
        var written_once = state.definitions[decimal_target] == 1 and decimal_target >= state.function.parameter_count
        if read_here and written_once {
            state.fused[decimal_target] = true
        }
    }
}

func find_the_addresses() {
    var block_index = 0
    while block_index < state.function.blocks.count() {
        var block = state.function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            var address = address_of(instruction)
            if address >= 0 {
                fold_the_address(block, index, address)
            }
            if instruction.class == LowIntermediaryRepresentation.Instructions.Load {
                fold_a_data_address(block, block_index, index, instruction)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func address_of(instruction: SpiteCompiler.Instruction): Integer {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Load {
        return instruction.address
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Store {
        if instruction.source == instruction.address {
            return -1
        }
        return instruction.address
    }
    return -1
}

# ../../OPTIMIZATIONS.md#a-read-of-the-programs-data-is-one-instruction
func fold_a_data_address(
    block: LowIntermediaryRepresentation.LowBlock,
    block_index: Integer,
    using: Integer,
    loaded: LowIntermediaryRepresentation.Instructions.Load,
) {
    var address = loaded.address
    fallback not loaded.is_swapped and loaded.offset == 0 and loaded.width == 'bits_64' and is_single(address)
    fallback not answers.is_folded_address(address)
    var at = defining_index(block, using, address)
    fallback at >= 0
    var found = block.instructions[at]
    crash found
    if found.class == LowIntermediaryRepresentation.Instructions.DataAddress {
        state.data_labels[address] = found.label
        state.elided_targets[address] = true
        note_a_rematerialised(block_index, loaded, found.label)
    }
}

# ../../OPTIMIZATIONS.md#a-value-read-from-a-singleton-that-never-changes-is-read-again-rather-than-spilled
func note_a_rematerialised(
    block_index: Integer,
    loaded: LowIntermediaryRepresentation.Instructions.Load,
    label: Integer,
) {
    var target = loaded.target
    fallback loaded.is_invariant and target >= state.function.parameter_count and target < state.register_total
    var count = state.definitions[target]
    var decimal_size = state.decimal_sizes[target]
    crash count
    crash decimal_size
    fallback count == 1 and decimal_size == 0
    state.rematerialised[target] = true
    state.rematerialised_labels[target] = label
    state.rematerialised_blocks[target] = block_index
}

func is_single(register: Integer): Boolean {
    fallback register >= state.function.parameter_count and not answers.constant_of(register)
    return state.definitions[register] == 1 and state.readings[register] == 1
}

func fold_the_address(block: LowIntermediaryRepresentation.LowBlock, using: Integer, address: Integer) {
    fallback is_single(address)
    var adding = defining_index(block, using, address)
    fallback adding >= 0
    var found = block.instructions[adding]
    crash found
    if found.class == LowIntermediaryRepresentation.Instructions.Arithmetic {
        var is_checked = checks.is_checked_at(block.instructions, adding)
        var plain_add = found.operator == 'add' and not is_checked and found.width == 'bits_64'
        var steady = unchanged_between(block, adding, using, found.left)
        steady = steady and unchanged_between(block, adding, using, found.right)
        if plain_add and steady {
            fold_the_sum(block, adding, using, address, found.left, found.right)
        }
    }
}

func fold_the_sum(
    block: LowIntermediaryRepresentation.LowBlock,
    adding: Integer,
    using: Integer,
    address: Integer,
    left: Integer,
    right: Integer,
) {
    if small_displacement(right) {
        note_the_fold(address, left, -1, 1, right)
        return
    }
    if small_displacement(left) {
        note_the_fold(address, right, -1, 1, left)
        return
    }
    fallback not scaled_fold(block, adding, using, address, left, right)
    fallback not scaled_fold(block, adding, using, address, right, left)
    note_the_fold(address, left, right, 1, -1)
}

func small_displacement(register: Integer): Boolean {
    fallback answers.constant_of(register)
    var value = answers.value_of(register)
    return value > -1073741824 and value < 1073741824
}

func scaled_fold(
    block: LowIntermediaryRepresentation.LowBlock,
    adding: Integer,
    using: Integer,
    address: Integer,
    base: Integer,
    product: Integer,
): Boolean {
    fallback is_single(product)
    var multiplying = defining_index(block, adding, product)
    fallback multiplying >= 0
    var found = block.instructions[multiplying]
    crash found
    if found.class == LowIntermediaryRepresentation.Instructions.Arithmetic {
        var scale = scale_from(found)
        var steady = unchanged_between(block, multiplying, using, found.left)
        var is_checked = checks.is_checked_at(block.instructions, multiplying)
        if scale > 0 and steady and not is_checked {
            note_the_fold(address, base, found.left, scale, -1)
            state.elided_targets[product] = true
            return true
        }
    }
    return false
}

func scale_from(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Integer {
    fallback answers.constant_of(arithmetic.right)
    var value = answers.value_of(arithmetic.right)
    if arithmetic.operator == 'multiply' and (value == 1 or value == 2 or value == 4 or value == 8) {
        return value
    }
    if arithmetic.operator == 'shift_left' {
        return shifted_scale(value)
    }
    return 0
}

func shifted_scale(value: Long): Integer {
    if value == 0 {
        return 1
    } else if value == 1 {
        return 2
    } else if value == 2 {
        return 4
    } else if value == 3 {
        return 8
    } else {
        return 0
    }
}

func note_the_fold(address: Integer, base: Integer, index: Integer, scale: Integer, displacement: Integer) {
    state.address_bases[address] = base
    state.address_indexes[address] = index
    state.address_scales[address] = scale
    state.address_displacements[address] = 0
    if displacement >= 0 {
        var value = answers.value_of(displacement)
        state.address_displacements[address] = value
    }
    state.elided_targets[address] = true
}

func defining_index(block: LowIntermediaryRepresentation.LowBlock, before: Integer, register: Integer): Integer {
    var earlier = before - 1
    var looked = 0
    while earlier >= 0 and looked < 16 {
        var instruction = block.instructions[earlier]
        crash instruction
        if instruction.class != LowIntermediaryRepresentation.Instructions.Check {
            looked = looked + 1
        }
        state.operands.read(instruction)
        if state.operands.defines.contains(register) {
            return earlier
        }
        earlier = earlier - 1
    }
    return -1
}

func unchanged_between(
    block: LowIntermediaryRepresentation.LowBlock,
    from_index: Integer,
    to_index: Integer,
    register: Integer,
): Boolean {
    var between = from_index + 1
    while between < to_index {
        var instruction = block.instructions[between]
        crash instruction
        state.operands.read(instruction)
        fallback not state.operands.defines.contains(register)
        between = between + 1
    }
    return true
}

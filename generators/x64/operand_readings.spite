var no_allocation = NoAllocation()
var state: AllocationState = no_allocation.state
var answers = Answers(state)

func OperandReadings(starting_state: AllocationState) {
    state = starting_state
    answers = Answers(starting_state)
}

func read_the_operands() {
    count_the_operands()
    find_the_decimals()
}

func count_the_operands() {
    var block_index = 0
    while block_index < state.function.blocks.count() {
        var block = state.function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            state.operands.read(instruction)
            state.operands.uses.each(count_a_reading)
            state.operands.defines.each(count_a_definition)
            index = index + 1
        }
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < state.function.blocks.count() {
        var block = state.function.blocks[block_index]
        block.instructions.each(note_a_constant)
        block_index = block_index + 1
    }
}

func count_a_reading(register: Integer) {
    var count = state.readings[register]
    crash count
    state.readings[register] = count + 1
}

func count_a_definition(register: Integer) {
    var count = state.definitions[register]
    crash count
    state.definitions[register] = count + 1
}

func note_a_constant(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Constant {
        var target = instruction.target
        var count = state.definitions[target]
        crash count
        if count == 1 and target >= state.function.parameter_count {
            state.is_constant[target] = true
            state.constants[target] = instruction.number
        }
    }
}

func find_the_decimals() {
    answers.fill_with_numbers(state.decimal_sizes, state.register_total, 0)
    state.decimal_refused.clear()
    state.decimal_touched.clear()
    state.decimal_constants.clear()
    var index = 0
    while index < state.register_total {
        state.decimal_refused.append(false)
        state.decimal_touched.append(false)
        state.decimal_constants.append(false)
        index = index + 1
    }
    var block_index = 0
    while block_index < state.function.blocks.count() {
        var block = state.function.blocks[block_index]
        block.instructions.each(note_the_decimals)
        block_index = block_index + 1
    }
    var round = 0
    while round < 4 {
        block_index = 0
        while block_index < state.function.blocks.count() {
            var copying_block = state.function.blocks[block_index]
            copying_block.instructions.each(spread_through_a_copy)
            block_index = block_index + 1
        }
        round = round + 1
    }
    index = 0
    while index < state.register_total {
        var refused = state.decimal_refused[index] == true
        var touched = state.decimal_touched[index] == true
        if refused or not touched {
            state.decimal_sizes[index] = 0
        } else if answers.constant_of(index) {
            state.is_constant[index] = false
            state.decimal_constants[index] = true
        }
        index = index + 1
    }
}

func note_the_decimals(instruction: SpiteCompiler.Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: note_a_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: note_a_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: note_a_decimal_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return
        LowIntermediaryRepresentation.Instructions.Constant: return
        LowIntermediaryRepresentation.Instructions.Load: rule_out_a_decimal(instruction.address)
        LowIntermediaryRepresentation.Instructions.Store: rule_out_a_decimal(instruction.address)
        LowIntermediaryRepresentation.Instructions.Call: rule_out_a_decimal(instruction.presence)
        LowIntermediaryRepresentation.Instructions.CallAt: note_a_decimal_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: return
        LowIntermediaryRepresentation.Instructions.VectorLoop: return
        LowIntermediaryRepresentation.Instructions.Return: rule_out_a_decimal(instruction.presence)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Free: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Branch: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.JoinThread: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: rule_out_every_operand(instruction)
        LowIntermediaryRepresentation.Instructions.Select: rule_out_every_operand(instruction)
    }
}

func spread_through_a_copy(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        var target_size = answers.decimal_size_of(instruction.target)
        var source_size = answers.decimal_size_of(instruction.source)
        if target_size > 0 and source_size == 0 {
            note_a_decimal_size(instruction.source, target_size)
        }
        if source_size > 0 and target_size == 0 {
            note_a_decimal_size(instruction.target, source_size)
        }
    }
}

func note_a_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    var size = 4
    if arithmetic.is_double {
        size = 8
    }
    note_a_decimal_size(arithmetic.target, size)
    note_a_decimal_size(arithmetic.left, size)
    note_a_decimal_size(arithmetic.right, size)
}

func note_a_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var size = 4
    if compare.is_double {
        size = 8
    }
    note_a_decimal_size(compare.left, size)
    note_a_decimal_size(compare.right, size)
    rule_out_a_decimal(compare.target)
}

func note_a_decimal_conversion(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    if conversion.from_decimal_size > 0 {
        note_a_decimal_size(conversion.source, conversion.from_decimal_size)
    } else {
        rule_out_a_decimal(conversion.source)
    }
    if conversion.to_decimal_size > 0 {
        note_a_decimal_size(conversion.target, conversion.to_decimal_size)
    } else {
        rule_out_a_decimal(conversion.target)
    }
}

func note_a_decimal_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    rule_out_a_decimal(call.address)
    rule_out_a_decimal(call.presence)
}

func note_a_decimal_size(register: Integer, size: Integer) {
    fallback register >= 0 and register < state.register_total
    state.decimal_touched[register] = true
    var known = state.decimal_sizes[register]
    crash known
    if known == 0 {
        state.decimal_sizes[register] = size
    } else if known != size {
        state.decimal_refused[register] = true
    }
}

func rule_out_a_decimal(register: Integer) {
    if register >= 0 and register < state.register_total {
        state.decimal_refused[register] = true
    }
}

func rule_out_every_operand(instruction: SpiteCompiler.Instruction) {
    state.operands.read(instruction)
    state.operands.uses.each(rule_out_a_decimal)
    state.operands.defines.each(rule_out_a_decimal)
}

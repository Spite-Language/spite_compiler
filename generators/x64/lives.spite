var no_allocation = NoAllocation()
var state: AllocationState = no_allocation.state
var answers = Answers(state)
var checks = LowIntermediaryRepresentation.Checks()

func Lives(starting_state: AllocationState) {
    state = starting_state
    answers = Answers(starting_state)
}

func find_the_lives() {
    answers.fill_with_numbers(state.weights, state.register_total, 0)
    walk_the_lives()
}

func touch(register: Integer, position: Integer) {
    var start = state.starts[register]
    crash start
    if start < 0 or position < start {
        state.starts[register] = position
    }
    var end = state.ends[register]
    crash end
    if position > end {
        state.ends[register] = position
    }
}

func walk_the_lives() {
    state.block_total = state.function.blocks.count()
    var block_index_made = 0
    while block_index_made < state.block_total {
        var occurring = List<Integer>()
        state.occurring_registers.append(occurring)
        var entering = List<Integer>()
        state.entering_registers.append(entering)
        var leaving = List<Integer>()
        state.leaving_registers.append(leaving)
        block_index_made = block_index_made + 1
    }
    var last_defined = List<Integer>()
    var last_rooted = List<Integer>()
    answers.fill_with_numbers(last_defined, state.register_total, -1)
    answers.fill_with_numbers(last_rooted, state.register_total, -1)
    var index = 0
    while index < state.register_total {
        var roots = List<Integer>()
        state.root_blocks.append(roots)
        var defining = List<Integer>()
        state.defining_blocks.append(defining)
        index = index + 1
    }
    var parameter = 0
    while parameter < state.function.parameter_count and parameter < state.register_total {
        touch(parameter, 0)
        parameter = parameter + 1
    }
    var clobber_count = 0
    state.clobbers_until.append(0)
    var layout_index = 0
    while layout_index < state.layout.count() {
        var block_index = state.layout[layout_index]
        var block = state.function.blocks[block_index]
        crash block
        state.clobbers_until.append(clobber_count)
        var position = state.block_heads[block_index]
        crash position
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            var holds_a_place = not checks.is_a_check(instruction)
            if holds_a_place {
                position = position + 1
                if clobbers_the_volatiles(instruction) {
                    clobber_count = clobber_count + 1
                }
                state.clobbers_until.append(clobber_count)
            }
            if holds_a_place and state.reachable[block_index] == true and not answers.is_elided(instruction) {
                state.operands.read(instruction)
                var uses = answers.expanded_uses(state.operands.uses)
                var defines = state.operands.defines.copy()
                note_the_uses(uses, block_index, position, last_defined, last_rooted)
                note_the_defines(defines, block_index, position, last_defined)
            }
            instruction_index = instruction_index + 1
        }
        layout_index = layout_index + 1
    }
    var defined_marks = List<Integer>()
    var live_marks = List<Integer>()
    var block_count = state.function.blocks.count()
    answers.fill_with_numbers(defined_marks, block_count, -1)
    answers.fill_with_numbers(live_marks, block_count, -1)
    var register = 0
    while register < state.register_total {
        var roots = state.root_blocks[register]
        crash roots
        if not roots.is_empty() {
            walk_one_life(register, roots, defined_marks, live_marks)
        }
        register = register + 1
    }
}

func note_the_uses(
    uses: List<Integer>,
    block_index: Integer,
    position: Integer,
    last_defined: List<Integer>,
    last_rooted: List<Integer>,
) {
    var index = 0
    while index < uses.count() {
        var register = uses[index]
        if not answers.constant_of(register) and not answers.is_fused(register) {
            touch(register, position)
            note_an_occurrence(register, block_index, position)
            add_weight(register, block_index)
            var defined_in = last_defined[register]
            var rooted_in = last_rooted[register]
            crash defined_in
            crash rooted_in
            if defined_in != block_index and rooted_in != block_index {
                last_rooted[register] = block_index
                var roots = state.root_blocks[register]
                crash roots
                roots.append(block_index)
            }
        }
        index = index + 1
    }
}

func note_the_defines(defines: List<Integer>, block_index: Integer, position: Integer, last_defined: List<Integer>) {
    var index = 0
    while index < defines.count() {
        var register = defines[index]
        if not answers.is_fused(register) {
            touch(register, position)
            note_an_occurrence(register, block_index, position)
            add_weight(register, block_index)
            var defined_in = last_defined[register]
            crash defined_in
            if defined_in != block_index {
                last_defined[register] = block_index
                var defining = state.defining_blocks[register]
                crash defining
                defining.append(block_index)
            }
        }
        index = index + 1
    }
}

func walk_one_life(register: Integer, roots: List<Integer>, defined_marks: List<Integer>, live_marks: List<Integer>) {
    var defining = state.defining_blocks[register]
    crash defining
    var index = 0
    while index < defining.count() {
        var defined_block = defining[index]
        defined_marks[defined_block] = register
        index = index + 1
    }
    var waiting = List<Integer>()
    index = 0
    while index < roots.count() {
        var root = roots[index]
        var marked = live_marks[root]
        crash marked
        if marked != register {
            live_marks[root] = register
            waiting.append(root)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var block = waiting.remove_last()
        crash block
        var head = state.block_heads[block]
        crash head
        touch(register, head)
        note_a_live_in(register, block)
        if block == 0 {
            touch(register, 0)
        }
        var coming = state.predecessors[block]
        crash coming
        var coming_index = 0
        while coming_index < coming.count() {
            var predecessor = coming[coming_index]
            var tail = state.block_tails[predecessor]
            crash tail
            touch(register, tail)
            note_a_live_out(register, predecessor)
            var defined_there = defined_marks[predecessor] == register
            var live_there = live_marks[predecessor] == register
            if not defined_there and not live_there {
                live_marks[predecessor] = register
                waiting.append(predecessor)
            }
            coming_index = coming_index + 1
        }
    }
}

func clobbers_the_volatiles(instruction: SpiteCompiler.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return false
        LowIntermediaryRepresentation.Instructions.Copy: return false
        LowIntermediaryRepresentation.Instructions.Compare: return false
        LowIntermediaryRepresentation.Instructions.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Check: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.Load: return false
        LowIntermediaryRepresentation.Instructions.Store: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Retain: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Return: return false
        LowIntermediaryRepresentation.Instructions.FrameAddress: return false
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return false
        LowIntermediaryRepresentation.Instructions.FrameRoom: return false
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return false
        LowIntermediaryRepresentation.Instructions.CompareExchange: return false
        LowIntermediaryRepresentation.Instructions.VectorLoop: return false
        LowIntermediaryRepresentation.Instructions.Select: return false
        LowIntermediaryRepresentation.Instructions.Call: return true
        LowIntermediaryRepresentation.Instructions.CallAt: return true
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return true
        LowIntermediaryRepresentation.Instructions.Allocate: return true
        LowIntermediaryRepresentation.Instructions.Free: return true
        LowIntermediaryRepresentation.Instructions.Resize: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return true
        LowIntermediaryRepresentation.Instructions.StartThread: return true
        LowIntermediaryRepresentation.Instructions.JoinThread: return true
        LowIntermediaryRepresentation.Instructions.ImportCall: return true
        LowIntermediaryRepresentation.Instructions.Stop: return true
        LowIntermediaryRepresentation.Instructions.Exit: return true
    }
}

func add_weight(register: Integer, block_index: Integer) {
    var depth = state.depths[block_index]
    crash depth
    var cost = weight_at_depth(depth)
    var key = answers.key_of(register, block_index)
    var in_block = weight_in(register, block_index)
    if in_block < 1000000000 {
        state.block_weights[key] = in_block + cost
    }
    var weight = state.weights[register]
    crash weight
    if weight < 1000000000 {
        state.weights[register] = weight + cost
    }
}

func note_an_occurrence(register: Integer, block_index: Integer, position: Integer) {
    var key = answers.key_of(register, block_index)
    var first = state.block_firsts[key]
    if not first {
        state.block_firsts[key] = position
        state.block_lasts[key] = position
        var occurring = state.occurring_registers[block_index]
        crash occurring
        occurring.append(register)
        return
    }
    if position < first {
        state.block_firsts[key] = position
    }
    var last = state.block_lasts[key]
    crash last
    if position > last {
        state.block_lasts[key] = position
    }
}

func note_a_live_in(register: Integer, block_index: Integer) {
    var key = answers.key_of(register, block_index)
    state.live_in_keys[key] = true
    var entering = state.entering_registers[block_index]
    crash entering
    entering.append(register)
}

func note_a_live_out(register: Integer, block_index: Integer) {
    var key = answers.key_of(register, block_index)
    var known = state.live_out_keys[key]
    fallback not known
    state.live_out_keys[key] = true
    var leaving = state.leaving_registers[block_index]
    crash leaving
    leaving.append(register)
}

func weight_in(register: Integer, block_index: Integer): Integer {
    var weight = state.block_weights[answers.key_of(register, block_index)]
    fallback weight
    return weight
}

func is_live_into(register: Integer, block_index: Integer): Boolean {
    return state.live_in_keys[answers.key_of(register, block_index)] == true
}

func edge_weight(from_block: Integer, to_block: Integer): Integer {
    var from_depth = state.depths[from_block]
    var to_depth = state.depths[to_block]
    crash from_depth
    crash to_depth
    var depth = from_depth
    if to_depth < depth {
        depth = to_depth
    }
    return weight_at_depth(depth)
}

func weight_at_depth(depth: Integer): Integer {
    var cost = 1
    var level = 0
    while level < depth and level < 4 {
        cost = cost * 32
        level = level + 1
    }
    return cost
}

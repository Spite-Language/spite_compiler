# ../../OPTIMIZATIONS.md#dividing-by-a-constant-is-a-multiplication
var multiplier: Long = 0
var shift = 0
var is_a_power = false
var halves: Long = 4294967296

func UnsignedMagic(divisor: Long) {
    crash divisor > 2
    var bound: Long = 1
    var size = 1
    while divisor / 2 >= bound {
        bound = bound * 2
        size = size + 1
    }
    shift = size - 1
    is_a_power = bound == divisor
    if not is_a_power {
        find_the_multiplier(divisor, bound)
    }
}

func find_the_multiplier(divisor: Long, bound: Long) {
    var rest = bound - (divisor - bound)
    var high: Long = 0
    var low: Long = 0
    var step = 0
    while step < 64 {
        var bit: Long = 0
        if rest >= divisor - rest {
            bit = 1
            rest = rest - (divisor - rest)
        } else {
            rest = rest * 2
        }
        if step < 32 {
            high = high * 2 + bit
        } else {
            low = low * 2 + bit
        }
        step = step + 1
    }
    low = low + 1
    if low == halves {
        low = 0
        high = high + 1
    }
    if high >= 2147483648 {
        multiplier = (high - halves) * halves + low
    } else {
        multiplier = high * halves + low
    }
}

    rex(true, register, 0)
    byte(_load_effective_address_opcode)
    slot_operand(register, displacement)
}

func epilogue() {
    byte(72)
    byte(_move_store_opcode)
    byte(_rsp_from_rbp_operands)
    byte(93)
    byte(_return_opcode)
}

func fits_in_32_bits(value: Long): Boolean {
    return value >= -2147483648 and value <= _largest_signed_32_bit
}

func low_32_bits(value: Long): Integer {
    var low = value.bits_and(_low_32_bits_mask)
    if low >= 2147483648 {
        low = low - 4294967296
    }
    return low
}

func low_byte_of(value: Long): Integer {
    return value.bits_and(_low_8_bits_mask)
}

func short_rex(register: Integer, base: Integer) {
    var prefix = 64
    if register >= 8 {
        prefix = prefix + 4
    }
    if base >= 8 {
        prefix = prefix + 1
    }
    byte(prefix)
}

func clear_register(register: Integer) {
    if register >= 8 {
        byte(69)
    }
    byte(49)
    var bits = low_bits(register)
    byte(_register_direct_mode + bits * 8 + bits)
}

func move_small_immediate(register: Integer, value: Long) {
    if value == 0 {
        clear_register(register)
        return
    }
    if value > 0 and value <= _largest_unsigned_32_bit {
        if register >= 8 {
            byte(65)
        }
        var register_bits = low_bits(register)
        byte(_move_immediate_opcode + register_bits)
        var low = low_32_bits(value)
        dword(low)
        return
    }
    if fits_in_32_bits(value) {
        rex(true, 0, register)
        byte(_move_immediate_to_operand_opcode)
        var target_bits = low_bits(register)
        byte(_register_direct_mode + target_bits)
        var small: Integer = value
        dword(small)
        return
    }
    move_immediate(register, value)
}

func operation_immediate(extension: Integer, register: Integer, value: Long) {
    rex(true, 0, register)
    var register_bits = low_bits(register)
    if value >= -128 and value <= _largest_signed_byte_immediate {
        byte(_operation_immediate_8_opcode)
        byte(_register_direct_mode + extension * 8 + register_bits)
        var small = low_byte_of(value)
        byte(small)
        return
    }
    byte(_operation_immediate_32_opcode)
    byte(_register_direct_mode + extension * 8 + register_bits)
    var wide: Integer = value
    dword(wide)
}

func multiply_immediate(target: Integer, source: Integer, value: Long) {
    rex(true, target, source)
    var target_bits = low_bits(target) * 8
    var source_bits = low_bits(source)
    if value >= -128 and value <= _largest_signed_byte_immediate {
        byte(_multiply_by_immediate_8_opcode)
        byte(_register_direct_mode + target_bits + source_bits)
        var small = low_byte_of(value)
        byte(small)
        return
    }
    byte(_multiply_by_immediate_32_opcode)
    byte(_register_direct_mode + target_bits + source_bits)
    var wide: Integer = value
    dword(wide)
}

func multiply_registers(target: Integer, source: Integer) {
    rex(true, target, source)
    byte(15)
    byte(_multiply_signed_opcode)
    var target_bits = low_bits(target) * 8
    var source_bits = low_bits(source)
    byte(_register_direct_mode + target_bits + source_bits)
}

func shift_immediate(extension: Integer, register: Integer, count: Integer) {
    rex(true, 0, register)
    byte(_shift_by_immediate_opcode)
    var register_bits = low_bits(register)
    byte(_register_direct_mode + extension * 8 + register_bits)
    byte(count)
}

func test_register(register: Integer) {
    rex(true, register, register)
    byte(_test_opcode)
    var bits = low_bits(register)
    byte(_register_direct_mode + bits * 8 + bits)
}

func memory_rex(wide: Boolean, register: Integer, base: Integer) {
    var prefix = 64
    if wide {
        prefix = prefix + 8
    }
    if register >= 8 {
        prefix = prefix + 4
    }
    if indexing >= 8 {
        prefix = prefix + 2
    }
    if base >= 8 {
        prefix = prefix + 1
    }
    byte(prefix)
}

func memory_operand(register: Integer, base: Integer, displacement: Integer) {
    var register_bits = low_bits(register) * 8
    var base_bits = low_bits(base)
    var is_short = displacement >= -128 and displacement <= _largest_short_displacement
    var mode = 128
    if is_short {
        mode = 64
    }
    if indexing >= 0 {
        byte(mode + register_bits + 4)
        var index_bits = low_bits(indexing) * 8
        byte(scaling * 64 + index_bits + base_bits)
    } else {
        byte(mode + register_bits + base_bits)
        if base_bits == 4 {
            byte(36)
        }
    }
    if is_short {
        var small = displacement
        if small < 0 {
            small = small + 256
        }
        byte(small)
        return
    }
    dword(displacement)
}

func index_by(register: Integer, scale: Integer) {
    indexing = register
    scaling = 0
    if scale == 2 {
        scaling = 1
    }
    if scale == 4 {
        scaling = 2
    }
    if scale == 8 {
        scaling = 3
    }
}

func stop_indexing() {
    indexing = -1
    scaling = 0
}

func load_from(
    target: Integer,
    base: Integer,
    offset: Integer,
    width: LowIntermediaryRepresentation.Instructions.Load.Width,
    is_signed: Boolean,
) {
    switch width {
        'bits_64': load_quad_from(target, base, offset)
        'bits_32': load_double_word_from(target, base, offset, is_signed)
        'bits_16': load_extended_from(target, base, offset, is_signed, _sign_extend_word_opcode, _zero_extend_word_opcode)
        'bits_8': load_extended_from(target, base, offset, is_signed, _sign_extend_byte_opcode, _zero_extend_byte_opcode)
    }
}

func load_quad_from(target: Integer, base: Integer, offset: Integer) {
    memory_rex(true, target, base)
    byte(_move_load_opcode)
    memory_operand(target, base, offset)
}

func load_double_word_from(target: Integer, base: Integer, offset: Integer, is_signed: Boolean) {
    if is_signed {
        memory_rex(true, target, base)
        byte(99)
    } else {
        memory_rex(false, target, base)
        byte(_move_load_opcode)
    }
    memory_operand(target, base, offset)
}

func load_extended_from(
    target: Integer,
    base: Integer,
    offset: Integer,
    is_signed: Boolean,
    signed_code: Integer,
    unsigned_code: Integer,
) {
    memory_rex(true, target, base)
    byte(15)
    if is_signed {
        byte(signed_code)
    } else {
        byte(unsigned_code)
    }
    memory_operand(target, base, offset)
}

func store_to(base: Integer, offset: Integer, source: Integer, width: LowIntermediaryRepresentation.Instructions.Load.Width) {
    switch width {
        'bits_64': store_wide_to(base, offset, source, true, _move_store_opcode)
        'bits_32': store_wide_to(base, offset, source, false, _move_store_opcode)
        'bits_16': store_word_to(base, offset, source)
        'bits_8': store_wide_to(base, offset, source, false, _move_byte_store_opcode)
    }
}

func store_wide_to(base: Integer, offset: Integer, source: Integer, wide: Boolean, opcode: Integer) {
    if wide {
        memory_rex(true, source, base)
    } else {
        memory_rex(false, source, base)
    }
    byte(opcode)
    memory_operand(source, base, offset)
}

# ../../OPTIMIZATIONS.md#a-decimal-is-read-and-written-straight-from-memory
func load_decimal_from(xmm: Integer, base: Integer, offset: Integer, is_double: Boolean) {
    decimal_memory(16, xmm, base, offset, is_double)
}

func store_decimal_to(base: Integer, offset: Integer, xmm: Integer, is_double: Boolean) {
    decimal_memory(17, xmm, base, offset, is_double)
}

func decimal_memory(opcode: Integer, xmm: Integer, base: Integer, offset: Integer, is_double: Boolean) {
    if is_double {
        byte(_double_precision_prefix)
    } else {
        byte(_single_precision_prefix)
    }
    memory_rex(false, xmm, base)
    byte(15)
    byte(opcode)
    memory_operand(xmm, base, offset)
}

func store_word_to(base: Integer, offset: Integer, source: Integer) {
    byte(_operand_size_prefix)
    memory_rex(false, source, base)
    byte(_move_store_opcode)
    memory_operand(source, base, offset)
}

func store_immediate_to(base: Integer, offset: Integer, value: Long, width: LowIntermediaryRepresentation.Instructions.Load.Width) {
    switch width {
        'bits_64': store_double_word_immediate(base, offset, value, true)
        'bits_32': store_double_word_immediate(base, offset, value, false)
        'bits_16': store_word_immediate(base, offset, value)
        'bits_8': store_byte_immediate(base, offset, value)
    }
}

func store_double_word_immediate(base: Integer, offset: Integer, value: Long, wide: Boolean) {
    if wide {
        memory_rex(true, 0, base)
    } else {
        memory_rex(false, 0, base)
    }
    byte(_move_immediate_to_operand_opcode)
    memory_operand(0, base, offset)
    var low = low_32_bits(value)
    dword(low)
}

func store_word_immediate(base: Integer, offset: Integer, value: Long) {
    byte(_operand_size_prefix)
    memory_rex(false, 0, base)
    byte(_move_immediate_to_operand_opcode)
    memory_operand(0, base, offset)
    var low = value.bits_and(_low_16_bits_mask)
    var low_part = low.bits_and(_low_8_bits_mask)
    var high_part = low.shifted_right(8)
    var written_low: Integer? = low_part
    var written_high: Integer? = high_part
    byte(written_low)
    byte(written_high)
}

func store_byte_immediate(base: Integer, offset: Integer, value: Long) {
    memory_rex(false, 0, base)
    byte(_move_byte_immediate_opcode)
    memory_operand(0, base, offset)
    var low = low_byte_of(value)
    byte(low)
}

func store_slot_immediate(displacement: Integer, value: Long) {
    rex(true, 0, 0)
    byte(_move_immediate_to_operand_opcode)
    slot_operand(0, displacement)
    var small: Integer = value
    dword(small)
}

func increment_memory(base: Integer, offset: Integer) {
    memory_rex(true, 0, base)
    byte(_increment_or_call_group_opcode)
    memory_operand(0, base, offset)
}

func compare_registers(left: Integer, right: Integer) {
    register_operation(57, left, right)
}

func compare_with(register: Integer, value: Long) {
    if value == 0 {
        test_register(register)
        return
    }
    operation_immediate(7, register, value)
}

func narrow_rex(register: Integer, base: Integer) {
    if register >= 8 or base >= 8 {
        short_rex(register, base)
    }
}

func operation_immediate_narrow(extension: Integer, register: Integer, value: Long) {
    narrow_rex(0, register)
    var register_bits = low_bits(register)
    if value >= -128 and value <= _largest_signed_byte_immediate {
        byte(_operation_immediate_8_opcode)
        byte(_register_direct_mode + extension * 8 + register_bits)
        var small = low_byte_of(value)
        byte(small)
        return
    }
    byte(_operation_immediate_32_opcode)
    byte(_register_direct_mode + extension * 8 + register_bits)
    var wide: Integer = value
    dword(wide)
}

func register_operation_narrow(opcode: Integer, target: Integer, source: Integer) {
    narrow_rex(source, target)
    byte(opcode)
    var source_bits = low_bits(source) * 8
    var target_bits = low_bits(target)
    byte(_register_direct_mode + source_bits + target_bits)
}

func multiply_registers_narrow(target: Integer, source: Integer) {
    narrow_rex(target, source)

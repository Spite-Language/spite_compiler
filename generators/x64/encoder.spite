func sse_operands(prefix: Integer, wide: Boolean, opcode: Integer, register: Integer, other: Integer) {
    if prefix > 0 {
        byte(prefix)
    }
    var rex_byte = 64
    if wide {
        rex_byte = rex_byte + 8
    }
    if register >= 8 {
        rex_byte = rex_byte + 4
    }
    if other >= 8 {
        rex_byte = rex_byte + 1
    }
    if rex_byte != 64 {
        byte(rex_byte)
    }
    byte(15)
    byte(opcode)
    var register_bits = low_bits(register) * 8
    var other_bits = low_bits(other)
    byte(_register_direct_mode + register_bits + other_bits)
}

func xmm_from_register(xmm: Integer, register: Integer, is_double: Boolean) {
    sse_operands(_sse_mandatory_prefix, is_double, _move_to_xmm_opcode, xmm, register)
}

func register_from_xmm(register: Integer, xmm: Integer, is_double: Boolean) {
    sse_operands(_sse_mandatory_prefix, is_double, _move_from_xmm_opcode, xmm, register)
}

func move_xmm(target: Integer, source: Integer) {
    sse_operands(0, false, 40, target, source)
}

func scalar_operation(operation_code: Integer, target: Integer, source: Integer, is_double: Boolean) {
    var prefix = _single_precision_prefix
    if is_double {
        prefix = _double_precision_prefix
    }
    sse_operands(prefix, false, operation_code, target, source)
}

func compare_xmm(first: Integer, second: Integer, is_double: Boolean) {
    var prefix = 0
    if is_double {
        prefix = _sse_mandatory_prefix
    }
    sse_operands(prefix, false, 46, first, second)
}

func save_xmm(displacement: Integer, xmm: Integer) {
    if xmm >= 8 {

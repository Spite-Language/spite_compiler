# ../../OPTIMIZATIONS.md#a-counted-loop-over-numbers-runs-eight-at-a-time
func vex(map: Integer, prefix: Integer, wide: Boolean, long: Boolean, register: Integer, source: Integer, other: Integer) {
    byte(_three_byte_vex_prefix)
    var first = map
    if register < 8 {
        first = first + 128
    }
    if indexing < 8 {
        first = first + 64
    }
    if other < 8 {
        first = first + 32
    }
    byte(first)
    var second = prefix + (15 - source) * 8
    if wide {
        second = second + 128
    }
    if long {
        second = second + 4
    }
    byte(second)
}

func vector_registers(
    map: Integer,
    prefix: Integer,
    wide: Boolean,
    long: Boolean,
    opcode: Integer,
    target: Integer,
    first: Integer,
    second: Integer,
) {
    vex(map, prefix, wide, long, target, first, second)
    byte(opcode)
    var target_bits = low_bits(target) * 8
    var second_bits = low_bits(second)
    byte(_register_direct_mode + target_bits + second_bits)
}

func vector_memory(
    map: Integer,
    prefix: Integer,
    wide: Boolean,
    long: Boolean,
    opcode: Integer,
    register: Integer,
    first: Integer,
    base: Integer,
    displacement: Integer,
) {
    vex(map, prefix, wide, long, register, first, base)
    byte(opcode)
    memory_operand(register, base, displacement)
}

func move_if_not_zero(target: Integer, source: Integer) {
    rex(true, target, source)
    byte(15)
    byte(69)
    var target_bits = low_bits(target) * 8
    var source_bits = low_bits(source)
    byte(_register_direct_mode + target_bits + source_bits)
}

func clear_the_upper_halves() {
    byte(_two_byte_vex_prefix)
    byte(_vex_without_register_second_byte)
    byte(_zero_upper_halves_opcode)
}

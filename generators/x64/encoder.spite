func byte(value: Integer) {
    var written: Byte = value
    code.append(written)
}

func dword(value: Integer) {
    code.append_integer_little_endian(value)
}

func qword(value: Long) {
    code.append_long_little_endian(value)
}

func align_to(alignment: Integer) {
    var missing = (alignment - code.count() % alignment) % alignment
    while missing > 0 {
        var step = missing
        if step > 8 {
            step = 8
        }
        no_operation(step)
        missing = missing - step
    }
}

func no_operation(size: Integer) {
    if size == 1 {
        byte(_no_operation_opcode)
    } else if size == 2 {
        two_byte_no_operation()
    } else if size == 3 {
        three_byte_no_operation()
    } else if size == 4 {
        four_byte_no_operation()
    } else if size == 5 {
        five_byte_no_operation()
    } else if size == 6 {
        six_byte_no_operation()
    } else if size == 7 {
        seven_byte_no_operation()
    } else {
        eight_byte_no_operation()
    }
}

func two_byte_no_operation() {
    byte(_operand_size_prefix)
    byte(_no_operation_opcode)
}

func three_byte_no_operation() {
    byte(15)
    byte(31)
    byte(0)
}

func four_byte_no_operation() {
    byte(15)
    byte(31)
    byte(64)
    byte(0)
}

func five_byte_no_operation() {
    byte(15)
    byte(31)
    byte(68)
    byte(0)
    byte(0)
}

func six_byte_no_operation() {

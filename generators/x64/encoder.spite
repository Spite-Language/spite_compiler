    byte(_register_direct_mode + decimal_register * 8)
}

func decimal_remainder(is_double: Boolean) {
    var prefix = _single_precision_prefix
    var rounding = 10
    if is_double {
        prefix = _double_precision_prefix
        rounding = 11
    }
    byte(15)
    byte(40)
    byte(_xmm2_from_xmm0_operands)
    byte(prefix)
    byte(15)
    byte(94)
    byte(_xmm2_with_xmm1_operands)
    byte(_sse_mandatory_prefix)
    byte(15)
    byte(58)
    byte(rounding)
    byte(_xmm2_with_xmm2_operands)
    byte(3)
    byte(prefix)
    byte(15)
    byte(89)
    byte(_xmm2_with_xmm1_operands)
    byte(prefix)
    byte(15)
    byte(92)
    byte(_xmm0_with_xmm2_operands)
}


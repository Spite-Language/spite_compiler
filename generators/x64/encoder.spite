func swap_rax(width: LowIntermediaryRepresentation.Instructions.Load.Width, is_signed: Boolean) {
    switch width {
        'bits_64': swap_quad(0)
        'bits_32': swap_double_word_of_rax(is_signed)
        'bits_16': swap_word_of_rax(is_signed)
        'bits_8': return
    }
}


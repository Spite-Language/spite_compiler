    }
    byte(15)
    byte(17)
    slot_operand(xmm, displacement)
}

func load_xmm(xmm: Integer, displacement: Integer) {
    if xmm >= 8 {
        byte(68)
    }
    byte(15)
    byte(16)
    slot_operand(xmm, displacement)
}

func decimal_register_from(decimal_register: Integer, register: Integer, is_double: Boolean) {
    byte(_sse_mandatory_prefix)
    var prefix = 64
    if is_double {
        prefix = prefix + 8
    }
    if register >= 8 {
        prefix = prefix + 1
    }
    if prefix != 64 {
        byte(prefix)
    }
    byte(15)
    byte(_move_to_xmm_opcode)
    var low = low_bits(register)
    byte(_register_direct_mode + decimal_register * 8 + low)
}


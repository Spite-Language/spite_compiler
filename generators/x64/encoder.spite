    byte(_register_direct_mode + target_bits + source_bits)
}

func multiply_immediate_narrow(target: Integer, source: Integer, value: Long) {
    narrow_rex(target, source)
    var target_bits = low_bits(target) * 8
    var source_bits = low_bits(source)
    if value >= -128 and value <= _largest_signed_byte_immediate {
        byte(_multiply_by_immediate_8_opcode)
        byte(_register_direct_mode + target_bits + source_bits)
        var small = low_byte_of(value)
        byte(small)
        return
    }
    byte(_multiply_by_immediate_32_opcode)
    byte(_register_direct_mode + target_bits + source_bits)
    var wide: Integer = value
    dword(wide)
}

func sign_extend_double_word(target: Integer, source: Integer) {
    rex(true, target, source)
    byte(99)
    var target_bits = low_bits(target) * 8
    var source_bits = low_bits(source)
    byte(_register_direct_mode + target_bits + source_bits)
}

func move_double_word(target: Integer, source: Integer) {
    narrow_rex(source, target)
    byte(_move_store_opcode)
    var source_bits = low_bits(source) * 8
    var target_bits = low_bits(target)

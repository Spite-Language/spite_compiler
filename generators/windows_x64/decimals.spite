var state = EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Frames(state)

func Decimals(starting_state: EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Frames(starting_state)
}

# ../../OPTIMIZATIONS.md#a-decimal-lives-in-a-decimal-register
func decimal_register_of(virtual: Integer, scratch: Integer, is_double: Boolean): Integer {
    var home = state.allocation.decimal_home_of(virtual)
    if home >= 0 {
        return home
    }
    if state.allocation.constant_of(virtual) {
        var value = state.allocation.value_of(virtual)
        load_a_decimal_constant(scratch, value, is_double)
        return scratch
    }
    var general = state.allocation.home_of(virtual)
    if general >= 0 {
        encoder.xmm_from_register(scratch, general, is_double)
        return scratch
    }
    var displacement = encoder.slot_of(virtual)
    encoder.load_decimal_from(scratch, encoder.rbp, displacement, is_double)
    return scratch
}

# ../../OPTIMIZATIONS.md#a-decimal-constant-is-read-from-the-programs-data
func load_a_decimal_constant(xmm: Integer, bits: Long, is_double: Boolean) {
    if bits == 0 {
        encoder.clear_xmm(xmm)
        return
    }
    var label = decimal_label_of(bits)
    var at = encoder.load_decimal_at_label(xmm, is_double)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
}

func decimal_label_of(bits: Long): Integer {
    var known = state.decimal_labels[bits]
    if known {
        return known
    }
    var bytes = Buffer(0)
    bytes.append_long_little_endian(bits)
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    state.decimal_labels[bits] = label
    return label
}

func decimal_into(xmm: Integer, virtual: Integer, is_double: Boolean) {
    var source = decimal_register_of(virtual, xmm, is_double)
    if source != xmm {
        encoder.move_xmm(xmm, source)
    }
}

func decimal_from(virtual: Integer, xmm: Integer, is_double: Boolean) {
    var home = state.allocation.decimal_home_of(virtual)
    if home >= 0 {
        if home != xmm {
            encoder.move_xmm(home, xmm)
        }
        return
    }
    var general = state.allocation.home_of(virtual)
    if general >= 0 {
        encoder.register_from_xmm(general, xmm, is_double)
        return
    }
    if is_double {
        var displacement = encoder.slot_of(virtual)
        encoder.store_decimal_to(encoder.rbp, displacement, xmm, true)
        return
    }
    encoder.register_from_xmm(encoder.rax, xmm, is_double)
    frames.write_from(virtual, encoder.rax)
}

func decimal_code_of(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator): Integer {
    switch operator {
        'add': return 88
        'subtract': return 92
        'multiply': return 89
        'divide': return 94
        'remainder': return 0
        'bits_and': return 81
        'bits_or': return 81
        'bits_xor': return 81
        'shift_left': return 81
        'shift_right': return 81
        'square_root': return 81
    }
}

var _lock_prefix = 240
var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var frames = Generators.WindowsX64.Frames(state)
var opcodes = Generators.WindowsX64.Opcodes()

func Retain(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
    opcodes = Generators.WindowsX64.Opcodes()
}

func emit(retain: LowIntermediaryRepresentation.Instructions.Retain) {
    var object = frames.register_of(retain.object, encoder.rax)
    encoder.test_register(object)
    var zero = opcodes.jump_if_equal_code
    var skip = encoder.jump_if(zero)
    if state.program.uses_threads and retain.is_atomic and not state.counts_alone_here {
        encoder.byte(_lock_prefix)
    }
    encoder.increment_memory(object, 8)
    fixups.patch_here(skip)
}

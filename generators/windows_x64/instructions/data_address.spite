var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func DataAddress(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(address: LowIntermediaryRepresentation.Instructions.DataAddress) {
    fallback not state.allocation.answers.is_elided_target(address.target)
    var at = encoder.load_address_of(encoder.rax)
    var fixup = Generators.X64.Fixup(at, "", address.label)
    state.data_fixups.append(fixup)
    frames.write_from(address.target, encoder.rax)
}

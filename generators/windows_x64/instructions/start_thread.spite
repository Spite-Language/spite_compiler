var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var frames = Generators.WindowsX64.Frames(state)

func StartThread(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(starting: LowIntermediaryRepresentation.Instructions.StartThread) {
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.store_outgoing(4)
    encoder.store_outgoing(5)
    encoder.move_small_immediate(encoder.rcx, 0)
    encoder.move_small_immediate(encoder.rdx, 0)
    var at = encoder.load_address_of(encoder.r8)
    var fixup = Generators.X64.Fixup(at, starting.entry, 0)
    state.call_fixups.append(fixup)
    frames.read_into(encoder.r9, starting.block)
    fixups.call_import("CreateThread")
    frames.write_from(starting.target, encoder.rax)
}

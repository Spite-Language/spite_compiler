var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)
var runtime_routines = Generators.WindowsX64.RuntimeRoutines(state)

func Allocate(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
    runtime_routines = Generators.WindowsX64.RuntimeRoutines(starting_state)
}

func emit(allocate: LowIntermediaryRepresentation.Instructions.Allocate) {
    var size: Long = -1
    if state.allocation.constant_of(allocate.size) {
        size = state.allocation.value_of(allocate.size)
    }
    if state.small_blocks.inlines_size(size) {
        state.small_blocks.allocate_inline(size)
    } else {
        frames.read_into(encoder.rcx, allocate.size)
        state.small_blocks.call_allocate()
    }
    runtime_routines.check_memory()
    if state.program.fills_fresh_memory and (size < 0 or size > allocate.zeroed_bytes) {
        state.small_blocks.fill_the_fresh_bytes(allocate.zeroed_bytes)
    }
    state.small_blocks.name_the_allocation(allocate.class_id)
    frames.write_from(allocate.target, encoder.rax)
}

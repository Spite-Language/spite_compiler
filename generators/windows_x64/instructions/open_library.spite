var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var frames = Generators.WindowsX64.Frames(state)
var opcodes = Generators.WindowsX64.Opcodes()
var runtime_routines = Generators.WindowsX64.RuntimeRoutines(state)

func OpenLibrary(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
    opcodes = Generators.WindowsX64.Opcodes()
    runtime_routines = Generators.WindowsX64.RuntimeRoutines(starting_state)
}

func emit(open: LowIntermediaryRepresentation.Instructions.OpenLibrary) {
    frames.read_into(encoder.rcx, open.name)
    fixups.call_import("LoadLibraryA")
    encoder.test_rax()
    var not_zero = opcodes.jump_if_not_equal_code
    var opened = encoder.jump_if(not_zero)
    stop_naming_the_library(open.name)
    fixups.patch_here(opened)
    frames.write_from(open.target, encoder.rax)
}

func stop_naming_the_library(name: Integer) {
    runtime_routines.gate_the_crash()
    var before = runtime_routines.label_of_text("spite: the library '")
    runtime_routines.write_a_label(before)
    frames.read_into(encoder.rcx, name)
    fixups.call_import("lstrlenA")
    encoder.move_register(encoder.rdx, encoder.rax)
    frames.read_into(encoder.rcx, name)
    fixups.call_routine(state.text_writer)
    var after = runtime_routines.label_of_text(
        "' could not be opened, in {state.current_key}: it is not there, or it is not a library this program can load\n",
    )
    runtime_routines.write_a_label(after)
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

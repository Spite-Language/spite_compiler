var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var runtime_routines = Generators.WindowsX64.RuntimeRoutines(state)

func Stop(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    runtime_routines = Generators.WindowsX64.RuntimeRoutines(starting_state)
}

func emit(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    if stop.numbers.is_empty() and not stop.continues {
        runtime_routines.load_message(stop.label)
        return
    }
    runtime_routines.keep_the_numbers(stop.numbers)
    if not stop.continues {
        runtime_routines.gate_the_crash()
    }
    var index = 0
    while index < stop.labels.count() {
        var label = stop.labels[index]
        runtime_routines.write_a_label(label)
        if index < stop.numbers.count() {
            var number = stop.numbers[index]
            var sign = stop.signed_numbers[index]
            crash sign
            runtime_routines.write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    fallback not stop.continues
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

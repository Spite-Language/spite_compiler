var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)
var places = Generators.WindowsX64.Places(state)

func Call(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
    places = Generators.WindowsX64.Places(starting_state)
}

func emit(call: LowIntermediaryRepresentation.Instructions.Call) {
    frames.pass_arguments(call.arguments)
    var called = call.function
    if state.counts_alone_here and state.alone_copies.contains(called) {
        called = "{called}$alone"
    }
    if is_a_last_free(call) {
        state.skipped_position = state.instruction_position
        jump_to_the_free(called)
        return
    }
    var at = encoder.call_relative()
    var fixup = Generators.X64.Fixup(at, called, 0)
    state.call_fixups.append(fixup)
    if state.program.call_table >= 0 {
        places.note_a_call_site(call.line, call.frames)
    }
    if call.target >= 0 {
        frames.write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        frames.write_from(call.presence, encoder.rdx)
    }
}

# ../../../OPTIMIZATIONS.md#freeing-a-chain-takes-no-stack-per-link
func is_a_last_free(call: LowIntermediaryRepresentation.Instructions.Call): Boolean {
    fallback call.target < 0 and call.presence < 0 and call.arguments.count() <= state.parameter_registers.count()
    fallback is_a_free(state.current_key) and is_a_free(call.function)
    fallback not state.current_is_resumable and not state.current_ends_a_thread and state.room_slots == 0
    var next = state.current_instructions[state.instruction_position]
    fallback next
    if is_a_bare_return(next) {
        return true
    }
    fallback next.class == LowIntermediaryRepresentation.Instructions.Jump
    var block = state.allocation.state.function.blocks[next.block]
    crash block
    fallback block.instructions.count() == 1
    var only = block.instructions[0]
    return is_a_bare_return(only)
}

func is_a_free(key: String): Boolean {
    return key == "_release" or key.starts_with("_free_")
}

func is_a_bare_return(instruction: SpiteCompiler.Instruction): Boolean {
    fallback instruction.class == LowIntermediaryRepresentation.Instructions.Return
    return instruction.source < 0 and instruction.presence < 0
}

func jump_to_the_free(called: String) {
    frames.restore_the_kept_registers()
    encoder.leave_the_frame()
    var at = encoder.jump()
    var fixup = Generators.X64.Fixup(at, called, 0)
    state.call_fixups.append(fixup)
}

var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var decimals = Generators.WindowsX64.Decimals(state)
var frames = Generators.WindowsX64.Frames(state)

func Conversion(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    decimals = Generators.WindowsX64.Decimals(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    var from_double = conversion.from_decimal_size == 8
    var to_double = conversion.to_decimal_size == 8
    if conversion.from_decimal_size == 0 {
        frames.read_into(encoder.rax, conversion.source)
        encoder.whole_into_decimal(to_double)
        decimals.decimal_from(conversion.target, 0, to_double)
    } else if conversion.to_decimal_size == 0 {
        decimals.decimal_into(0, conversion.source, from_double)
        encoder.decimal_into_whole(from_double)
        cut_to_the_width(conversion)
        frames.write_from(conversion.target, encoder.rax)
    } else {
        decimals.decimal_into(0, conversion.source, from_double)
        resize_the_decimal(to_double)
        decimals.decimal_from(conversion.target, 0, to_double)
    }
}

func cut_to_the_width(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    fallback conversion.whole_width != 'bits_64'
    encoder.fits_back(conversion.whole_width, conversion.whole_is_signed)
    encoder.move_rdx_into_rax()
}

func resize_the_decimal(to_double: Boolean) {
    if to_double {
        encoder.float_into_double()
    } else {
        encoder.double_into_float()
    }
}

var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var decimals = Generators.WindowsX64.Decimals(state)

func Arithmetic(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    decimals = Generators.WindowsX64.Decimals(starting_state)
}

func emit(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    var is_double = arithmetic.is_double
    var code = decimals.decimal_code_of(arithmetic.operator)
    if code == 0 {
        decimals.decimal_into(0, arithmetic.left, is_double)
        decimals.decimal_into(1, arithmetic.right, is_double)
        encoder.decimal_remainder(is_double)
        decimals.decimal_from(arithmetic.target, 0, is_double)
        return
    }
    var target = state.allocation.decimal_home_of(arithmetic.target)
    var right_home = state.allocation.decimal_home_of(arithmetic.right)
    var working = 0
    if target >= 0 and target != right_home {
        working = target
    }
    if code != 81 {
        decimals.decimal_into(working, arithmetic.left, is_double)
    }
    var source = decimals.decimal_register_of(arithmetic.right, 1, is_double)
    encoder.scalar_operation(code, working, source, is_double)
    decimals.decimal_from(arithmetic.target, working, is_double)
}

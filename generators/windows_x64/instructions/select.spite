var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func Select(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

# ../../../OPTIMIZATIONS.md#an-if-that-only-adds-or-picks-a-value-has-no-branch
func emit(selecting: LowIntermediaryRepresentation.Instructions.Select) {
    var condition = frames.register_of(selecting.condition, encoder.rcx)
    var chosen = frames.register_of(selecting.when_true, encoder.rdx)
    frames.read_into(encoder.rax, selecting.when_false)
    encoder.test_register(condition)
    encoder.move_if_not_zero(encoder.rax, chosen)
    frames.write_from(selecting.target, encoder.rax)
}

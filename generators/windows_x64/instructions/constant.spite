var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var decimals = Generators.WindowsX64.Decimals(state)
var frames = Generators.WindowsX64.Frames(state)

func Constant(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    decimals = Generators.WindowsX64.Decimals(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    fallback not state.allocation.answers.constant_of(constant.target)
    var decimal = state.allocation.answers.decimal_home_of(constant.target)
    if decimal >= 0 {
        var size = state.allocation.answers.decimal_size_of(constant.target)
        decimals.load_a_decimal_constant(decimal, constant.number, size == 8)
        return
    }
    var home = state.allocation.answers.home_of(constant.target)
    if home >= 0 {
        encoder.move_small_immediate(home, constant.number)
        return
    }
    if encoder.fits_in_32_bits(constant.number) {
        var displacement = encoder.slot_of(constant.target)
        encoder.store_slot_immediate(displacement, constant.number)
        return
    }
    encoder.move_small_immediate(encoder.rax, constant.number)
    frames.write_from(constant.target, encoder.rax)
}

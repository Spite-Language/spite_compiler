var _set_if_less_code = 156
var _set_if_less_or_equal_code = 158
var _set_if_greater_code = 159
var _set_if_greater_or_equal_code = 157
var _set_if_below_code = 146
var _set_if_below_or_equal_code = 150
var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)
var opcodes = Generators.WindowsX64.Opcodes()

func Compare(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
    opcodes = Generators.WindowsX64.Opcodes()
}

func emit(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    var left = frames.register_of(compare.left, encoder.rax)
    if frames.small_constant(compare.right) {
        var value = state.allocation.answers.value_of(compare.right)
        encoder.compare_with(left, value)
    } else {
        var right = frames.register_of(compare.right, encoder.rcx)
        encoder.compare_registers(left, right)
    }
    var condition = condition_code(compare.comparison, compare.is_signed)
    state.flags_condition = condition
    state.flags_register = compare.target
    state.flags_have_parity = false
    fallback not state.allocation.answers.is_fused(compare.target)
    encoder.al_from_condition(condition)
    encoder.zero_extend_al_into_rax()
    frames.write_from(compare.target, encoder.rax)
}

func condition_code(
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    is_signed: Boolean,
): Integer {
    if is_signed {
        return signed_code(comparison)
    }
    return unsigned_code(comparison)
}

func signed_code(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison): Integer {
    switch comparison {
        'equal': return opcodes.set_if_equal_code
        'not_equal': return opcodes.set_if_not_equal_code
        'less': return _set_if_less_code
        'less_or_equal': return _set_if_less_or_equal_code
        'greater': return _set_if_greater_code
        'greater_or_equal': return _set_if_greater_or_equal_code
    }
}

func unsigned_code(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison): Integer {
    switch comparison {
        'equal': return opcodes.set_if_equal_code
        'not_equal': return opcodes.set_if_not_equal_code
        'less': return _set_if_below_code
        'less_or_equal': return _set_if_below_or_equal_code
        'greater': return opcodes.set_if_above_code
        'greater_or_equal': return opcodes.set_if_above_or_equal_code
    }
}

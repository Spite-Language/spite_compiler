var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)
var places = Generators.WindowsX64.Places(state)

func CallAt(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
    places = Generators.WindowsX64.Places(starting_state)
}

func emit(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    frames.pass_arguments(call.arguments)
    var index = 0
    while index < call.decimal_sizes.count() and index < 4 {
        var size = call.decimal_sizes[index]
        var register = state.parameter_registers[index]
        crash register
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    frames.read_into(encoder.r11, call.address)
    encoder.call_r11()
    if state.program.call_table >= 0 {
        places.note_a_call_site(call.line, call.frames)
    }
    if call.answers_32_bits {
        encoder.sign_extend_eax_into_rax()
    }
    if call.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(call.answer_decimal_size == 8)
    }
    if call.target >= 0 {
        frames.write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        frames.write_from(call.presence, encoder.rdx)
    }
}

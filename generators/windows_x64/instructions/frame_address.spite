var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func FrameAddress(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(found: LowIntermediaryRepresentation.Instructions.FrameAddress) {
    var header = 0
    if state.current_is_resumable {
        header = state.current_header
    }
    encoder.slot_address(encoder.rax, header)
    frames.write_from(found.target, encoder.rax)
}

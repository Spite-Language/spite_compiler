var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var frames = Generators.WindowsX64.Frames(state)
var opcodes = Generators.WindowsX64.Opcodes()
var runtime_routines = Generators.WindowsX64.RuntimeRoutines(state)

func ForeignAddress(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
    opcodes = Generators.WindowsX64.Opcodes()
    runtime_routines = Generators.WindowsX64.RuntimeRoutines(starting_state)
}

func emit(found: LowIntermediaryRepresentation.Instructions.ForeignAddress) {
    var slot = state.foreign_names.count()
    state.foreign_names.append(found.name)
    frames.read_into(encoder.rcx, found.library)
    var owner_loaded = encoder.load_from_address(encoder.rax)
    var owner_fixup = Generators.X64.Fixup(owner_loaded, "owner", slot)
    state.slot_fixups.append(owner_fixup)
    encoder.compare_rax_rcx()
    var not_equal = opcodes.jump_if_not_equal_code
    var not_zero = opcodes.jump_if_not_equal_code
    var looked_up = encoder.jump_if(not_equal)
    var loaded = encoder.load_from_address(encoder.rax)
    var loaded_fixup = Generators.X64.Fixup(loaded, "", slot)
    state.slot_fixups.append(loaded_fixup)
    var known = encoder.jump()
    fixups.patch_here(looked_up)
    var name_at = encoder.load_address_of(encoder.rdx)
    var name_fixup = Generators.X64.Fixup(name_at, "name", slot)
    state.slot_fixups.append(name_fixup)
    fixups.call_import("GetProcAddress")
    encoder.test_rax()
    var found_it = encoder.jump_if(not_zero)
    var missing = "the foreign function '{found.name}' is not in its library"
    if not found.file_name.is_empty() {
        missing = "the foreign function '{found.name}' is not in its library, '{found.file_name}'"
    }
    runtime_routines.stop_with(missing, 1)
    fixups.patch_here(found_it)
    keep_the_first_owner(found, slot)
    fixups.patch_here(known)
    frames.write_from(found.target, encoder.rax)
}

func keep_the_first_owner(found: LowIntermediaryRepresentation.Instructions.ForeignAddress, slot: Integer) {
    encoder.move_register(encoder.rdx, encoder.rax)
    var claimed_at = encoder.load_address_of(encoder.r11)
    var claimed_fixup = Generators.X64.Fixup(claimed_at, "owner", slot)
    state.slot_fixups.append(claimed_fixup)
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.move_small_immediate(encoder.rcx, -1)
    encoder.locked_compare_exchange(0)
    var not_zero = opcodes.jump_if_not_equal_code
    var taken = encoder.jump_if(not_zero)
    var stored = encoder.store_at_address(encoder.rdx)
    var stored_fixup = Generators.X64.Fixup(stored, "", slot)
    state.slot_fixups.append(stored_fixup)
    frames.read_into(encoder.rcx, found.library)
    var owned = encoder.store_at_address(encoder.rcx)
    var owned_fixup = Generators.X64.Fixup(owned, "owner", slot)
    state.slot_fixups.append(owned_fixup)
    fixups.patch_here(taken)
    encoder.move_register(encoder.rax, encoder.rdx)
}

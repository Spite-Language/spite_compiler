var _wait_forever: Long = 4294967295
var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Generators.WindowsX64.Fixups(state)
var frames = Generators.WindowsX64.Frames(state)

func JoinThread(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Generators.WindowsX64.Fixups(starting_state)
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(joining: LowIntermediaryRepresentation.Instructions.JoinThread) {
    frames.read_into(encoder.rcx, joining.thread)
    encoder.move_small_immediate(encoder.rdx, _wait_forever)
    fixups.call_import("WaitForSingleObject")
    frames.read_into(encoder.rcx, joining.thread)
    fixups.call_import("CloseHandle")
}

var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func Copy(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    var target_decimal = state.allocation.decimal_home_of(copy.target)
    var source_decimal = state.allocation.decimal_home_of(copy.source)
    if target_decimal >= 0 and source_decimal >= 0 {
        if target_decimal != source_decimal {
            encoder.move_xmm(target_decimal, source_decimal)
        }
        return
    }
    var home = state.allocation.home_of(copy.target)
    if home >= 0 {
        frames.read_into(home, copy.source)
        return
    }
    var source = frames.register_of(copy.source, encoder.rax)
    frames.write_from(copy.target, source)
}

var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func Store(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(stored: LowIntermediaryRepresentation.Instructions.Store) {
    var wide = stored.width == 'bits_64'
    var source = -1
    var immediate = false
    var value: Long = 0
    if state.allocation.answers.constant_of(stored.source) and not stored.is_swapped {
        value = state.allocation.answers.value_of(stored.source)
        immediate = not wide or encoder.fits_in_32_bits(value)
    }
    var decimal = state.allocation.answers.decimal_home_of(stored.source)
    var decimal_size = state.allocation.answers.decimal_size_of(stored.source)
    var whole = stored.width == 'bits_32' or decimal_size == 8 and stored.width == 'bits_64'
    if not immediate and not stored.is_swapped and decimal >= 0 and whole {
        frames.prepare_the_address(stored.address, stored.offset)
        encoder.store_decimal_to(state.addressed_base, state.addressed_displacement, decimal, stored.width == 'bits_64')
        encoder.stop_indexing()
        return
    }
    if not immediate {
        source = frames.register_of(stored.source, encoder.rcx)
    }
    if stored.is_swapped {
        if source != encoder.rcx {
            encoder.move_register(encoder.rcx, source)
        }
        encoder.swap_rcx(stored.width)
        source = encoder.rcx
    }
    frames.prepare_the_address(stored.address, stored.offset)
    if immediate {
        encoder.store_immediate_to(state.addressed_base, state.addressed_displacement, value, stored.width)
    } else {
        encoder.store_to(state.addressed_base, state.addressed_displacement, source, stored.width)
    }
    encoder.stop_indexing()
}

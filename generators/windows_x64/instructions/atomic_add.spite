var state = Generators.WindowsX64.EmitterState()
var encoder = Generators.X64.Encoder()
var frames = Generators.WindowsX64.Frames(state)

func AtomicAdd(starting_state: Generators.WindowsX64.EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    frames = Generators.WindowsX64.Frames(starting_state)
}

func emit(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    frames.read_into(encoder.rax, adding.address)
    encoder.move_small_immediate(encoder.rcx, adding.amount)
    encoder.locked_exchange_add(adding.offset)
    encoder.move_small_immediate(encoder.rax, adding.amount)
    encoder.add_rcx_into_rax()
    frames.write_from(adding.target, encoder.rax)
}

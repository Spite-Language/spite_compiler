var state = EmitterState()
var encoder = Generators.X64.Encoder()

func Fixups(starting_state: EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
}

func emit_a_byte(value: Integer) {
    encoder.byte(value)
}

func call_routine(routine: Integer) {
    var at = encoder.call_relative()
    encoder.patch_dword(at, routine - (at + 4))
    if state.program.hot_reload {
        var fixup = Generators.X64.Fixup(at, "", routine)
        state.routine_fixups.append(fixup)
    }
}

func call_import(name: String) {
    var at = encoder.call_through_memory()
    var fixup = Generators.X64.Fixup(at, name, 0)
    state.import_fixups.append(fixup)
}

func patch_here(at: Integer) {
    var here = encoder.position()
    encoder.patch_dword(at, here - (at + 4))
}

func call_library_import(name: String) {
    if not state.library_imports.contains(name) {
        state.library_imports.append(name)
    }
    var at = encoder.call_through_memory()
    var fixup = Generators.X64.Fixup(at, name, 0)
    state.library_fixups.append(fixup)
}

func fix_a_block(fixup: Generators.X64.Fixup) {
    var target = state.block_offsets[fixup.index]
    crash target
    encoder.patch_dword(fixup.at, target - (fixup.at + 4))
}

func fix_a_call(fixup: Generators.X64.Fixup) {
    var target = state.function_offsets[fixup.target]
    crash target
    encoder.patch_dword(fixup.at, target - (fixup.at + 4))
}

func fix_a_stop(fixup: Generators.X64.Fixup) {
    encoder.patch_dword(fixup.at, state.stop_routine - (fixup.at + 4))
}

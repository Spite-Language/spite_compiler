# ../../PROOFS.md#a-function-only-one-thread-runs-counts-plainly

var program = LowIntermediaryRepresentation.LoweredProgram()
var by_key = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var copied = Dictionary<String, Boolean>()
var copies = List<LowIntermediaryRepresentation.LowFunction>()
var waiting = List<LowIntermediaryRepresentation.LowFunction>()

func AloneCopies(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
}

func find() {
    fallback program.counts_alone_outside_the_work
    var index = 0
    while index < program.lowered_functions.count() {
        var function = program.lowered_functions[index]
        by_key[function.key] = function
        if function.counts_alone {
            waiting.append(function)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var function = waiting.remove_last()
        crash function
        follow_the_calls(function)
    }
}

func follow_the_calls(function: LowIntermediaryRepresentation.LowFunction) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(follow_an_instruction)
        block_index = block_index + 1
    }
}

func follow_an_instruction(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        follow_a_call(instruction.function)
    }
}

func follow_a_call(key: String) {
    var called = by_key[key]
    fallback called
    fallback not called.counts_alone and not copied.contains(key)
    fallback not called.is_resumable and not called.ends_a_thread
    fallback not starts_work(called)
    copied[key] = true
    copies.append(called)
    waiting.append(called)
}

func starts_work(function: LowIntermediaryRepresentation.LowFunction): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        if block.instructions.any(is_a_start) {
            return true
        }
        block_index = block_index + 1
    }
    return false
}

func is_a_start(instruction: SpiteCompiler.Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.function == "_pool_submit"
    }
    return instruction.class == LowIntermediaryRepresentation.Instructions.StartThread
}

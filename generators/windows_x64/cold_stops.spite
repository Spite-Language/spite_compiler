var state = EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Fixups(state)
var runtime_routines = RuntimeRoutines(state)

func ColdStops(starting_state: EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Fixups(starting_state)
    runtime_routines = RuntimeRoutines(starting_state)
}

func article_of(name: String): String {
    var first = name.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func undo_narrow_by(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, target: Integer, value: Long) {
    if arithmetic.operator == 'add' {
        encoder.operation_immediate_narrow(5, target, value)
    } else {
        encoder.operation_immediate_narrow(0, target, value)
    }
}

func undo_narrow_in_place(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if immediate {
        var value = state.allocation.value_of(arithmetic.right)
        undo_narrow_by(arithmetic, target, value)
    } else if arithmetic.operator == 'add' {
        encoder.register_operation_narrow(41, target, source)
    } else {
        encoder.register_operation_narrow(1, target, source)
    }
    if arithmetic.is_signed {
        encoder.sign_extend_double_word(target, target)
    }
}

func undo_in_place(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if immediate {
        var value = state.allocation.value_of(arithmetic.right)
        if arithmetic.operator == 'add' {
            encoder.operation_immediate(5, target, value)
        } else {
            encoder.operation_immediate(0, target, value)
        }
        return
    }
    if arithmetic.operator == 'add' {
        encoder.register_operation(41, target, source)
    } else {
        encoder.register_operation(1, target, source)
    }
}

func defer_a_stop(
    condition: Integer,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    var at = encoder.jump_if(condition)
    state.cold_jumps.append(at)
    state.cold_arithmetics.append(arithmetic)
    state.cold_kinds.append(kind)
    state.cold_targets.append(target)
    state.cold_sources.append(source)
    state.cold_immediates.append(immediate)
    state.cold_blocks.append(state.current_block_index)
}

func emit_the_cold_stops() {
    var index = 0
    while index < state.cold_jumps.count() {
        var at = state.cold_jumps[index]
        var arithmetic = state.cold_arithmetics[index]
        var kind = state.cold_kinds[index]
        var target = state.cold_targets[index]
        var source = state.cold_sources[index]
        var immediate = state.cold_immediates[index] == true
        var cold_block = state.cold_blocks[index]
        crash cold_block
        state.allocation.current_block = cold_block
        crash arithmetic
        crash kind
        crash target
        crash source
        fixups.patch_here(at)
        emit_a_cold_stop(arithmetic, kind, target, source, immediate)
        index = index + 1
    }
    state.cold_jumps.clear()
    state.cold_arithmetics.clear()
    state.cold_kinds.clear()
    state.cold_targets.clear()
    state.cold_sources.clear()
    state.cold_immediates.clear()
    state.cold_blocks.clear()
}

func emit_a_cold_stop(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if kind == 2 {
        stop_dividing_by_zero(arithmetic)
        return
    }
    if kind == 1 {
        undo_in_place(arithmetic, target, source, immediate)
    }
    if kind == 3 {
        undo_narrow_in_place(arithmetic, target, source, immediate)
    }
    stop_not_fitting(arithmetic)
}

func stop_not_fitting(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var symbol = symbol_of(arithmetic.operator)
    var article = article_of(arithmetic.type_name)
    var texts = List<String>()
    texts.append("spite: '{arithmetic.shown}' does not fit in {article} {arithmetic.type_name} (")
    texts.append(" {symbol} ")
    var owner = owner_of(arithmetic)
    texts.append("), at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var numbers = List<Integer>()
    numbers.append(arithmetic.left)
    numbers.append(arithmetic.right)
    var sign = 0
    if arithmetic.is_signed {
        sign = 1
    }
    var signs = List<Integer>()
    signs.append(sign)
    signs.append(sign)
    runtime_routines.stop_with_pieces(texts, numbers, signs)
}

func owner_of(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    if arithmetic.owner.is_empty() {
        return state.current_key
    }
    return arithmetic.owner
}

func symbol_of(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator): String {
    switch operator {
        'add': return "+"
        'subtract': return "-"
        'multiply': return "*"
        'divide': return "/"
        'remainder': return "%"
        'bits_and': return "%"
        'bits_or': return "%"
        'bits_xor': return "%"
        'shift_left': return "%"
        'shift_right': return "%"
        'square_root': return "%"
    }
}

func stop_dividing_by_zero(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var texts = List<String>()
    var owner = owner_of(arithmetic)
    texts.append("spite: '{arithmetic.shown}' divided by zero, at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var no_numbers = List<Integer>()
    var no_signs = List<Integer>()
    runtime_routines.stop_with_pieces(texts, no_numbers, no_signs)
}

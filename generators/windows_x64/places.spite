var state = EmitterState()
var encoder = Generators.X64.Encoder()

func Places(starting_state: EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
}

func note_the_place(start: Integer, place: String) {
    fallback not place.is_empty()
    var count = state.place_texts.count()
    if count > 0 {
        var last = state.place_texts[count - 1]
        crash last
        fallback last != place
    }
    state.place_starts.append(start)
    state.place_texts.append(place)
}

func note_a_call_site(line: Integer, frames: List<String>) {
    fallback state.program.call_table >= 0
    var lines = List<String>()
    var own = state.call_frames.frame_line(state.current_block_place, line)
    if not own.is_empty() {
        lines.append(own)
    }
    state.call_frames.add_every(lines, frames)
    var number = -1
    if not lines.is_empty() {
        var text = lines.join("\n")
        number = number_of_a_call_text(text)
    }
    var at = encoder.position()
    state.call_offsets.append(at)
    state.call_text_numbers.append(number)
}

func number_of_a_call_text(text: String): Integer {
    if state.call_numbers.contains(text) {
        var known = state.call_numbers[text]
        crash known
        return known
    }
    var number = state.call_texts.count()
    state.call_texts.append(text)
    state.call_numbers[text] = number
    return number
}

func write_the_calls() {
    var table = Buffer(0)
    var count: Long = state.call_offsets.count()
    table.append_long_little_endian(count)
    var index = 0
    while index < state.call_offsets.count() {
        var offset = state.call_offsets[index]
        var number = state.call_text_numbers[index]
        crash number
        var start: Long = offset
        var numbered: Long = number
        table.append_long_little_endian(start)
        table.append_long_little_endian(numbered)
        index = index + 1
    }
    var texts = Buffer(0)
    var text_count: Long = state.call_texts.count()
    texts.append_long_little_endian(text_count)
    var placed: Long = text_count * 8 + 8
    var text_index = 0
    while text_index < state.call_texts.count() {
        texts.append_long_little_endian(placed)
        var measured = state.call_texts[text_index]
        var measured_bytes = measured.to_buffer()
        var measured_length = measured_bytes.count()
        var padded = (measured_length + 7) / 8 * 8
        placed = placed + 8 + padded
        text_index = text_index + 1
    }
    text_index = 0
    while text_index < state.call_texts.count() {
        var text = state.call_texts[text_index]
        var bytes = text.to_buffer()
        var length: Long = bytes.count()
        texts.append_long_little_endian(length)
        var byte_index = 0
        while byte_index < bytes.count() {
            var written = bytes[byte_index]
            crash written
            texts.append(written)
            byte_index = byte_index + 1
        }
        while texts.count() % 8 != 0 {
            texts.append(0)
        }
        text_index = text_index + 1
    }
    var byte_index = 0
    while byte_index < texts.count() {
        var copied = texts[byte_index]
        crash copied
        table.append(copied)
        byte_index = byte_index + 1
    }
    state.program.data[state.program.call_table] = table
}

# ../../HOT_RELOAD.md#crash-reports-inside-reloaded-code
func write_the_places() {
    var table = Buffer(0)
    var count: Long = state.place_texts.count() + 1
    table.append_long_little_endian(count)
    var no_reload: Long = 0
    table.append_long_little_endian(no_reload)
    var placed_index = 0
    while placed_index < state.place_texts.count() {
        var place = state.place_texts[placed_index]
        var offset = state.place_starts[placed_index]
        crash offset
        var start: Long = offset
        append_a_place(table, start, place)
        placed_index = placed_index + 1
    }
    var end: Long = state.code_end
    append_a_place(table, end, "-\t-\t-")
    state.program.data[state.program.place_table] = table
}

func append_a_place(table: Buffer, start: Long, place: String) {
    table.append_long_little_endian(start)
    var bytes = place.to_buffer()
    var length: Long = bytes.count()
    table.append_long_little_endian(length)
    var byte_index = 0
    while byte_index < bytes.count() {
        var written = bytes[byte_index]
        crash written
        table.append(written)
        byte_index = byte_index + 1
    }
    while table.count() % 8 != 0 {
        table.append(0)
    }
}

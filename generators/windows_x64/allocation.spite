var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var register_total = 0
var definitions = List<Integer>()
var readings = List<Integer>()
var is_constant = List<Boolean>()
var constants = List<Long>()
var fused = List<Boolean>()
var homes = List<Integer>()
var saved = List<Integer>()
var starts = List<Integer>()
var ends = List<Integer>()
var block_heads = List<Integer>()
var block_tails = List<Integer>()
var successors = List<List<Integer>>()
var predecessors = List<List<Integer>>()
var root_blocks = List<List<Integer>>()
var defining_blocks = List<List<Integer>>()
var clobbers_until = List<Integer>()
var position_total = 0
var volatile_home = 10
var keeping = List<Integer>()
var depths = List<Integer>()
var weights = List<Integer>()
var layout = List<Integer>()
var deferred_blocks = List<Integer>()
var layout_positions = List<Integer>()
var reachable = List<Boolean>()
var elided_targets = List<Boolean>()
var address_bases = List<Integer>()
var address_indexes = List<Integer>()
var address_scales = List<Integer>()
var address_displacements = List<Integer>()
var decimal_sizes = List<Integer>()
var decimal_refused = List<Boolean>()
var decimal_touched = List<Boolean>()
var saved_decimals = List<Integer>()
var decimal_constants = List<Boolean>()
var block_total = 0
var block_firsts = Dictionary<Long, Integer>()
var block_lasts = Dictionary<Long, Integer>()
var live_in_keys = Dictionary<Long, Boolean>()
var live_out_keys = Dictionary<Long, Boolean>()
var occurring_registers = List<List<Integer>>()
var entering_registers = List<List<Integer>>()
var leaving_registers = List<List<Integer>>()
var segment_starts = List<List<Integer>>()
var segment_ends = List<List<Integer>>()
var assigned = List<List<Integer>>()
var every_holder = List<List<Integer>>()
var current_block = -1
var volatile_homes = List<Integer>()
var is_split = List<Boolean>()
var split_values = List<Integer>()
var slot_keys = Dictionary<Long, Boolean>()
var block_weights = Dictionary<Long, Integer>()
var value_blocks = List<List<Integer>>()
var value_block_starts = List<List<Integer>>()
var value_block_ends = List<List<Integer>>()
var vector_positions = List<Integer>()
var vector_operands = List<List<Integer>>()
var joined_lefts = List<Integer>()
var joined_positions = List<Integer>()
var joined_blocks = List<Integer>()

func Allocation(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
    keeping.append(3)
    keeping.append(6)
    keeping.append(7)
    keeping.append(12)
    keeping.append(13)
    keeping.append(14)
    keeping.append(15)
    volatile_homes.append(10)
    volatile_homes.append(9)
    volatile_homes.append(8)
}

func allocate() {
    lay_out_the_blocks()
    register_total = operands.most_register_of(function)
    fill_with_numbers(definitions, register_total, 0)
    fill_with_numbers(readings, register_total, 0)
    fill_with_numbers(homes, register_total, -1)
    fill_with_numbers(starts, register_total, -1)
    fill_with_numbers(ends, register_total, -1)
    var index = 0
    while index < register_total {
        is_constant.append(false)
        constants.append(0)
        fused.append(false)
        elided_targets.append(false)
        is_split.append(false)
        address_bases.append(-1)
        address_indexes.append(-1)
        address_scales.append(1)
        address_displacements.append(0)
        index = index + 1
    }
    assert not function.is_resumable
    count_the_operands()
    find_the_decimals()
    find_the_fused_compares()
    find_the_addresses()
    number_the_positions()
    find_the_joined()
    find_the_vector_loops()
    find_the_edges()
    find_the_depths()
    fill_with_numbers(weights, register_total, 0)
    walk_the_lives()
    build_the_segments()
    scan_the_intervals()
    find_the_saved()
}

func fill_with_numbers(numbers: List<Integer>, count: Integer, value: Integer) {
    numbers.clear()
    var index = 0
    while index < count {
        numbers.append(value)
        index = index + 1
    }
}

func count_the_operands() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            operands.read(instruction)
            operands.uses.each(count_a_reading)
            operands.defines.each(count_a_definition)
            index = index + 1
        }
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(note_a_constant)
        block_index = block_index + 1
    }
}

func count_a_reading(register: Integer) {
    var count = readings[register]
    crash count
    readings[register] = count + 1
}

func count_a_definition(register: Integer) {
    var count = definitions[register]
    crash count
    definitions[register] = count + 1
}

func note_a_constant(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Constant {
        var target = instruction.target
        var count = definitions[target]
        crash count
        if count == 1 and target >= function.parameter_count {
            is_constant[target] = true
            constants[target] = instruction.number
        }
    }
}

func constant_of(register: Integer): Boolean {
    if register < 0 or register >= register_total {
        return false
    }
    return is_constant[register] == true
}

func value_of(register: Integer): Long {
    var value = constants[register]
    crash value
    return value
}

func is_fused(register: Integer): Boolean {
    if register < 0 or register >= register_total {
        return false
    }
    return fused[register] == true
}

func home_of(register: Integer): Integer {
    return home_in(register, current_block)
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func home_in(register: Integer, block_index: Integer): Integer {
    if register < 0 or register >= homes.count() {
        return -1
    }
    var home = homes[register]
    crash home
    if home >= 16 {
        return -1
    }
    var split = home >= 0 and block_index >= 0 and is_split[register] == true
    if split and slot_keys[key_of(register, block_index)] == true {
        return -1
    }
    return home
}

func is_a_volatile_home(home: Integer): Boolean {
    return home == 8 or home == 9 or home == 10
}

func moves_at_the_head(block_index: Integer): Boolean {
    if split_values.is_empty() {
        return false
    }
    var coming = predecessors[block_index]
    crash coming
    return coming.count() == 1
}

func moves_on_the_edge(from_block: Integer, to_block: Integer): Boolean {
    if split_values.is_empty() {
        return false
    }
    var entering = entering_registers[to_block]
    crash entering
    var index = 0
    while index < entering.count() {
        var register = entering[index]
        crash register
        if differs_on_the_edge(register, from_block, to_block) {
            return true
        }
        index = index + 1
    }
    return false
}

func differs_on_the_edge(register: Integer, from_block: Integer, to_block: Integer): Boolean {
    if is_split[register] != true {
        return false
    }
    return home_in(register, from_block) != home_in(register, to_block)
}

# ../../OPTIMIZATIONS.md#a-decimal-lives-in-a-decimal-register
func decimal_home_of(register: Integer): Integer {
    if register < 0 or register >= homes.count() {
        return -1
    }
    var home = homes[register]
    crash home
    if home >= 16 {
        return home - 16
    }
    return -1
}

func decimal_size_of(register: Integer): Integer {
    if register < 0 or register >= decimal_sizes.count() {
        return 0
    }
    var size = decimal_sizes[register]
    crash size
    return size
}

func find_the_decimals() {
    fill_with_numbers(decimal_sizes, register_total, 0)
    decimal_refused.clear()
    decimal_touched.clear()
    decimal_constants.clear()
    var index = 0
    while index < register_total {
        decimal_refused.append(false)
        decimal_touched.append(false)
        decimal_constants.append(false)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(note_the_decimals)
        block_index = block_index + 1
    }
    var round = 0
    while round < 4 {
        block_index = 0
        while block_index < function.blocks.count() {
            var copying_block = function.blocks[block_index]
            copying_block.instructions.each(spread_through_a_copy)
            block_index = block_index + 1
        }
        round = round + 1
    }
    index = 0
    while index < register_total {
        var refused = decimal_refused[index] == true
        var touched = decimal_touched[index] == true
        if refused or not touched {
            decimal_sizes[index] = 0
        } else if constant_of(index) {
            is_constant[index] = false
            decimal_constants[index] = true
        }
        index = index + 1
    }
}

func note_the_decimals(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: note_a_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: note_a_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: note_a_decimal_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return
        LowIntermediaryRepresentation.Instructions.Constant: return
        LowIntermediaryRepresentation.Instructions.Load: refuse_a_decimal(instruction.address)
        LowIntermediaryRepresentation.Instructions.Store: refuse_a_decimal(instruction.address)
        LowIntermediaryRepresentation.Instructions.Call: refuse_a_decimal(instruction.presence)
        LowIntermediaryRepresentation.Instructions.CallAt: note_a_decimal_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: return
        LowIntermediaryRepresentation.Instructions.VectorLoop: return
        LowIntermediaryRepresentation.Instructions.Return: refuse_a_decimal(instruction.presence)
        _: refuse_every_operand(instruction)
    }
}

func spread_through_a_copy(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    if instruction == LowIntermediaryRepresentation.Instructions.Copy {
        var target_size = decimal_size_of(instruction.target)
        var source_size = decimal_size_of(instruction.source)
        if target_size > 0 and source_size == 0 {
            note_a_decimal_size(instruction.source, target_size)
        }
        if source_size > 0 and target_size == 0 {
            note_a_decimal_size(instruction.target, source_size)
        }
    }
}

func note_a_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    var size = 4
    if arithmetic.is_double {
        size = 8
    }
    note_a_decimal_size(arithmetic.target, size)
    note_a_decimal_size(arithmetic.left, size)
    note_a_decimal_size(arithmetic.right, size)
}

func note_a_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var size = 4
    if compare.is_double {
        size = 8
    }
    note_a_decimal_size(compare.left, size)
    note_a_decimal_size(compare.right, size)
    refuse_a_decimal(compare.target)
}

func note_a_decimal_conversion(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    if conversion.from_decimal_size > 0 {
        note_a_decimal_size(conversion.source, conversion.from_decimal_size)
    } else {
        refuse_a_decimal(conversion.source)
    }
    if conversion.to_decimal_size > 0 {
        note_a_decimal_size(conversion.target, conversion.to_decimal_size)
    } else {
        refuse_a_decimal(conversion.target)
    }
}

func note_a_decimal_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    refuse_a_decimal(call.address)
    refuse_a_decimal(call.presence)
}

func note_a_decimal_size(register: Integer, size: Integer) {
    assert register >= 0 and register < register_total
    decimal_touched[register] = true
    var known = decimal_sizes[register]
    crash known
    if known == 0 {
        decimal_sizes[register] = size
    } else if known != size {
        decimal_refused[register] = true
    }
}

func refuse_a_decimal(register: Integer) {
    if register >= 0 and register < register_total {
        decimal_refused[register] = true
    }
}

func refuse_every_operand(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    operands.read(instruction)
    operands.uses.each(refuse_a_decimal)
    operands.defines.each(refuse_a_decimal)
}

func reading_count_of(register: Integer): Integer {
    var count = readings[register]
    crash count
    return count
}

func find_the_fused_compares() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index + 1 < block.instructions.count() {
            var instruction = block.instructions[index]
            var following = block.instructions[index + 1]
            fuse_when_it_fits(instruction, following)
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func fuse_when_it_fits(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    following: LowIntermediaryRepresentation.Instructions.Instruction,
) {
    if instruction == LowIntermediaryRepresentation.Instructions.Compare and following == LowIntermediaryRepresentation.Instructions.Branch {
        var target = instruction.target
        var only_read_here = following.condition == target and reading_count_of(target) == 1
        var defined_once = definitions[target] == 1
        if only_read_here and defined_once and not constant_of(target) and target >= function.parameter_count {
            fused[target] = true
        }
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Decimal.Compare and following == LowIntermediaryRepresentation.Instructions.Branch {
        var decimal_target = instruction.target
        var read_here = following.condition == decimal_target and reading_count_of(decimal_target) == 1
        var written_once = definitions[decimal_target] == 1 and decimal_target >= function.parameter_count
        if read_here and written_once {
            fused[decimal_target] = true
        }
    }
}

func is_elided(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Constant {
        return constant_of(instruction.target)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Arithmetic {
        return is_elided_target(instruction.target)
    }
    return false
}

func is_elided_target(register: Integer): Boolean {
    if register < 0 or register >= register_total {
        return false
    }
    return elided_targets[register] == true
}

func is_folded_address(register: Integer): Boolean {
    if register < 0 or register >= register_total {
        return false
    }
    var base = address_bases[register]
    crash base
    return base >= 0
}

func base_of(register: Integer): Integer {
    var base = address_bases[register]
    crash base
    return base
}

func index_of(register: Integer): Integer {
    var index = address_indexes[register]
    crash index
    return index
}

func scale_of(register: Integer): Integer {
    var scale = address_scales[register]
    crash scale
    return scale
}

func displacement_of(register: Integer): Integer {
    var displacement = address_displacements[register]
    crash displacement
    return displacement
}

func expanded_uses(uses: List<Integer>): List<Integer> {
    var made = List<Integer>()
    var index = 0
    while index < uses.count() {
        var register = uses[index]
        if is_folded_address(register) {
            var base = base_of(register)
            made.append(base)
            var folded_index = index_of(register)
            if folded_index >= 0 {
                made.append(folded_index)
            }
        } else {
            made.append(register)
        }
        index = index + 1
    }
    return made
}

func find_the_addresses() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            var address = address_of(instruction)
            if address >= 0 {
                fold_the_address(block, index, address)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func address_of(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Integer {
    if instruction == LowIntermediaryRepresentation.Instructions.Load {
        return instruction.address
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Store {
        if instruction.source == instruction.address {
            return -1
        }
        return instruction.address
    }
    return -1
}

func is_single(register: Integer): Boolean {
    if register < function.parameter_count or constant_of(register) {
        return false
    }
    return definitions[register] == 1 and readings[register] == 1
}

func fold_the_address(block: LowIntermediaryRepresentation.LowBlock, using: Integer, address: Integer) {
    assert is_single(address)
    var adding = defining_index(block, using, address)
    assert adding >= 0
    var found = block.instructions[adding]
    crash found
    if found == LowIntermediaryRepresentation.Instructions.Arithmetic {
        var plain_add = found.operator == 'add' and not found.is_checked and found.width == 'bits_64'
        var steady = unchanged_between(block, adding, using, found.left)
        steady = steady and unchanged_between(block, adding, using, found.right)
        if plain_add and steady {
            fold_the_sum(block, adding, using, address, found.left, found.right)
        }
    }
}

func fold_the_sum(
    block: LowIntermediaryRepresentation.LowBlock,
    adding: Integer,
    using: Integer,
    address: Integer,
    left: Integer,
    right: Integer,
) {
    if small_displacement(right) {
        note_the_fold(address, left, -1, 1, right)
        return
    }
    if small_displacement(left) {
        note_the_fold(address, right, -1, 1, left)
        return
    }
    assert not scaled_fold(block, adding, using, address, left, right)
    assert not scaled_fold(block, adding, using, address, right, left)
    note_the_fold(address, left, right, 1, -1)
}

func small_displacement(register: Integer): Boolean {
    if not constant_of(register) {
        return false
    }
    var value = value_of(register)
    return value > -1073741824 and value < 1073741824
}

func scaled_fold(
    block: LowIntermediaryRepresentation.LowBlock,
    adding: Integer,
    using: Integer,
    address: Integer,
    base: Integer,
    product: Integer,
): Boolean {
    if not is_single(product) {
        return false
    }
    var multiplying = defining_index(block, adding, product)
    if multiplying < 0 {
        return false
    }
    var found = block.instructions[multiplying]
    crash found
    if found == LowIntermediaryRepresentation.Instructions.Arithmetic {
        var scale = scale_from(found)
        var steady = unchanged_between(block, multiplying, using, found.left)
        if scale > 0 and steady and not found.is_checked {
            note_the_fold(address, base, found.left, scale, -1)
            elided_targets[product] = true
            return true
        }
    }
    return false
}

func scale_from(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Integer {
    if not constant_of(arithmetic.right) {
        return 0
    }
    var value = value_of(arithmetic.right)
    if arithmetic.operator == 'multiply' and (value == 1 or value == 2 or value == 4 or value == 8) {
        return value.to_integer()
    }
    if arithmetic.operator == 'shift_left' {
        return shifted_scale(value)
    }
    return 0
}

func shifted_scale(value: Long): Integer {
    switch value {
        0: return 1
        1: return 2
        2: return 4
        3: return 8
        _: return 0
    }
}

func note_the_fold(address: Integer, base: Integer, index: Integer, scale: Integer, displacement: Integer) {
    address_bases[address] = base
    address_indexes[address] = index
    address_scales[address] = scale
    address_displacements[address] = 0
    if displacement >= 0 {
        var value = value_of(displacement)
        address_displacements[address] = value.to_integer()
    }
    elided_targets[address] = true
}

func defining_index(block: LowIntermediaryRepresentation.LowBlock, before: Integer, register: Integer): Integer {
    var earlier = before - 1
    var lowest = before - 16
    while earlier >= 0 and earlier >= lowest {
        var instruction = block.instructions[earlier]
        crash instruction
        operands.read(instruction)
        if operands.defines.contains(register) {
            return earlier
        }
        earlier = earlier - 1
    }
    return -1
}

func unchanged_between(
    block: LowIntermediaryRepresentation.LowBlock,
    from_index: Integer,
    to_index: Integer,
    register: Integer,
): Boolean {
    var between = from_index + 1
    while between < to_index {
        var instruction = block.instructions[between]
        crash instruction
        operands.read(instruction)
        if operands.defines.contains(register) {
            return false
        }
        between = between + 1
    }
    return true
}

func number_the_positions() {
    var block_count = function.blocks.count()
    fill_with_numbers(block_heads, block_count, 0)
    fill_with_numbers(block_tails, block_count, 0)
    var position = 1
    var layout_index = 0
    while layout_index < layout.count() {
        var block_index = layout[layout_index]
        var block = function.blocks[block_index]
        crash block
        block_heads[block_index] = position
        position = position + 1
        var last = position - 1
        var index = 0
        while index < block.instructions.count() {
            last = position
            position = position + 1
            index = index + 1
        }
        block_tails[block_index] = last
        layout_index = layout_index + 1
    }
    position_total = position
}

# ../../OPTIMIZATIONS.md#a-counted-loop-over-numbers-runs-eight-at-a-time
func find_the_vector_loops() {
    vector_positions.clear()
    vector_operands.clear()
    var layout_index = 0
    while layout_index < layout.count() {
        var block_index = layout[layout_index]
        crash block_index
        var block = function.blocks[block_index]
        crash block
        var head = block_heads[block_index]
        crash head
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction == LowIntermediaryRepresentation.Instructions.VectorLoop {
                vector_positions.append(head + 1 + index)
                operands.read(instruction)
                var touched = List<Integer>()
                operands.uses.each(touched.append)
                operands.defines.each(touched.append)
                vector_operands.append(touched)
            }
            index = index + 1
        }
        layout_index = layout_index + 1
    }
}

func crosses_a_vector_loop(register: Integer): Boolean {
    if vector_positions.is_empty() {
        return false
    }
    var made_starts = segment_starts[register]
    var made_ends = segment_ends[register]
    crash made_starts
    crash made_ends
    var loop_index = 0
    while loop_index < vector_positions.count() {
        var position = vector_positions[loop_index]
        var touched = vector_operands[loop_index]
        crash position
        crash touched
        if not touched.contains(register) {
            var index = 0
            while index < made_starts.count() {
                var start = made_starts[index]
                var end = made_ends[index]
                crash start
                crash end
                if start < position and end > position {
                    return true
                }
                index = index + 1
            }
        }
        loop_index = loop_index + 1
    }
    return false
}

func lay_out_the_blocks() {
    var count = function.blocks.count()
    layout = List<Integer>()
    layout_positions = List<Integer>()
    var placed = List<Boolean>()
    var index = 0
    while index < count {
        placed.append(false)
        layout_positions.append(0)
        index = index + 1
    }
    deferred_blocks.clear()
    var start = 0
    while start < count {
        var block = start
        while block >= 0 {
            while block >= 0 and placed[block] != true {
                placed[block] = true
                layout_positions[block] = layout.count()
                layout.append(block)
                block = preferred_next(block, placed)
            }
            block = next_deferred(placed)
        }
        start = start + 1
    }
}

func next_deferred(placed: List<Boolean>): Integer {
    while not deferred_blocks.is_empty() {
        var block = deferred_blocks.remove_last()
        crash block
        if placed[block] != true {
            return block
        }
    }
    return -1
}

func preferred_next(block: Integer, placed: List<Boolean>): Integer {
    var found = function.blocks[block]
    crash found
    var following = block + 1
    if following >= function.blocks.count() {
        following = -1
    }
    var last = found.instructions.last()
    if not last {
        return following
    }
    if last == LowIntermediaryRepresentation.Instructions.Jump {
        return last.block
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        if placed[last.when_true] != true {
            deferred_blocks.append(last.when_false)
            return last.when_true
        }
        return last.when_false
    }
    if ends_the_block(last) {
        return -1
    }
    return following
}

func find_the_edges() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var made = List<Integer>()
        successors.append(made)
        var coming = List<Integer>()
        predecessors.append(coming)
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var leaving = successors[block_index]
        crash leaving
        var falls_through = true
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            add_the_targets(instruction, leaving)
            falls_through = not ends_the_block(instruction)
            index = index + 1
        }
        if falls_through and block_index + 1 < function.blocks.count() {
            leaving.append(block_index + 1)
        }
        block_index = block_index + 1
    }
    find_the_reachable()
    block_index = 0
    while block_index < function.blocks.count() {
        if reachable[block_index] == true {
            add_the_arrivals(block_index)
        } else {
            var leaves_nothing = List<Integer>()
            successors[block_index] = leaves_nothing
        }
        block_index = block_index + 1
    }
}

func find_the_reachable() {
    var block_count = function.blocks.count()
    fill_with_flags(reachable, block_count)
    assert not function.blocks.is_empty()
    var waiting = List<Integer>()
    waiting.append(0)
    reachable[0] = true
    while not waiting.is_empty() {
        var taken = waiting.remove_last()
        crash taken
        var leaving = successors[taken]
        crash leaving
        var index = 0
        while index < leaving.count() {
            var next = leaving[index]
            if reachable[next] != true {
                reachable[next] = true
                waiting.append(next)
            }
            index = index + 1
        }
    }
}

func fill_with_flags(flags: List<Boolean>, count: Integer) {
    flags.clear()
    var index = 0
    while index < count {
        flags.append(false)
        index = index + 1
    }
}

func add_the_arrivals(block_index: Integer) {
    var leaving = successors[block_index]
    crash leaving
    var leaving_index = 0
    while leaving_index < leaving.count() {
        var successor = leaving[leaving_index]
        var arriving = predecessors[successor]
        crash arriving
        arriving.append(block_index)
        leaving_index = leaving_index + 1
    }
}

func add_the_targets(instruction: LowIntermediaryRepresentation.Instructions.Instruction, leaving: List<Integer>) {
    if instruction == LowIntermediaryRepresentation.Instructions.Jump {
        leaving.append(instruction.block)
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Branch {
        leaving.append(instruction.when_true)
        leaving.append(instruction.when_false)
    }
}

func ends_the_block(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Jump {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Branch {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Return {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Exit {
        return true
    }
    if instruction == LowIntermediaryRepresentation.Instructions.Stop {
        return not instruction.continues
    }
    return false
}

func touch(register: Integer, position: Integer) {
    var start = starts[register]
    crash start
    if start < 0 or position < start {
        starts[register] = position
    }
    var end = ends[register]
    crash end
    if position > end {
        ends[register] = position
    }
}

func walk_the_lives() {
    block_total = function.blocks.count()
    var block_index_made = 0
    while block_index_made < block_total {
        var occurring = List<Integer>()
        occurring_registers.append(occurring)
        var entering = List<Integer>()
        entering_registers.append(entering)
        var leaving = List<Integer>()
        leaving_registers.append(leaving)
        block_index_made = block_index_made + 1
    }
    var last_defined = List<Integer>()
    var last_rooted = List<Integer>()
    fill_with_numbers(last_defined, register_total, -1)
    fill_with_numbers(last_rooted, register_total, -1)
    var index = 0
    while index < register_total {
        var roots = List<Integer>()
        root_blocks.append(roots)
        var defining = List<Integer>()
        defining_blocks.append(defining)
        index = index + 1
    }
    var parameter = 0
    while parameter < function.parameter_count and parameter < register_total {
        touch(parameter, 0)
        parameter = parameter + 1
    }
    var clobber_count = 0
    clobbers_until.append(0)
    var layout_index = 0
    while layout_index < layout.count() {
        var block_index = layout[layout_index]
        var block = function.blocks[block_index]
        crash block
        clobbers_until.append(clobber_count)
        var position = block_heads[block_index]
        crash position
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            position = position + 1
            var instruction = block.instructions[instruction_index]
            if clobbers_the_volatiles(instruction) {
                clobber_count = clobber_count + 1
            }
            clobbers_until.append(clobber_count)
            if reachable[block_index] == true and not is_elided(instruction) {
                operands.read(instruction)
                var uses = expanded_uses(operands.uses)
                var defines = operands.defines.copy()
                note_the_uses(uses, block_index, position, last_defined, last_rooted)
                note_the_defines(defines, block_index, position, last_defined)
            }
            instruction_index = instruction_index + 1
        }
        layout_index = layout_index + 1
    }
    var defined_marks = List<Integer>()
    var live_marks = List<Integer>()
    var block_count = function.blocks.count()
    fill_with_numbers(defined_marks, block_count, -1)
    fill_with_numbers(live_marks, block_count, -1)
    var register = 0
    while register < register_total {
        var roots = root_blocks[register]
        crash roots
        if not roots.is_empty() {
            walk_one_life(register, roots, defined_marks, live_marks)
        }
        register = register + 1
    }
}

func note_the_uses(
    uses: List<Integer>,
    block_index: Integer,
    position: Integer,
    last_defined: List<Integer>,
    last_rooted: List<Integer>,
) {
    var index = 0
    while index < uses.count() {
        var register = uses[index]
        if not constant_of(register) and not is_fused(register) {
            touch(register, position)
            note_an_occurrence(register, block_index, position)
            add_weight(register, block_index)
            var defined_in = last_defined[register]
            var rooted_in = last_rooted[register]
            crash defined_in
            crash rooted_in
            if defined_in != block_index and rooted_in != block_index {
                last_rooted[register] = block_index
                var roots = root_blocks[register]
                crash roots
                roots.append(block_index)
            }
        }
        index = index + 1
    }
}

func note_the_defines(defines: List<Integer>, block_index: Integer, position: Integer, last_defined: List<Integer>) {
    var index = 0
    while index < defines.count() {
        var register = defines[index]
        if not is_fused(register) {
            touch(register, position)
            note_an_occurrence(register, block_index, position)
            add_weight(register, block_index)
            var defined_in = last_defined[register]
            crash defined_in
            if defined_in != block_index {
                last_defined[register] = block_index
                var defining = defining_blocks[register]
                crash defining
                defining.append(block_index)
            }
        }
        index = index + 1
    }
}

func walk_one_life(register: Integer, roots: List<Integer>, defined_marks: List<Integer>, live_marks: List<Integer>) {
    var defining = defining_blocks[register]
    crash defining
    var index = 0
    while index < defining.count() {
        var defined_block = defining[index]
        defined_marks[defined_block] = register
        index = index + 1
    }
    var waiting = List<Integer>()
    index = 0
    while index < roots.count() {
        var root = roots[index]
        var marked = live_marks[root]
        crash marked
        if marked != register {
            live_marks[root] = register
            waiting.append(root)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var block = waiting.remove_last()
        crash block
        var head = block_heads[block]
        crash head
        touch(register, head)
        note_a_live_in(register, block)
        if block == 0 {
            touch(register, 0)
        }
        var coming = predecessors[block]
        crash coming
        var coming_index = 0
        while coming_index < coming.count() {
            var predecessor = coming[coming_index]
            var tail = block_tails[predecessor]
            crash tail
            touch(register, tail)
            note_a_live_out(register, predecessor)
            var defined_there = defined_marks[predecessor] == register
            var live_there = live_marks[predecessor] == register
            if not defined_there and not live_there {
                live_marks[predecessor] = register
                waiting.append(predecessor)
            }
            coming_index = coming_index + 1
        }
    }
}

func clobbers_the_volatiles(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return false
        LowIntermediaryRepresentation.Instructions.Copy: return false
        LowIntermediaryRepresentation.Instructions.Compare: return false
        LowIntermediaryRepresentation.Instructions.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.Load: return false
        LowIntermediaryRepresentation.Instructions.Store: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Retain: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Return: return false
        LowIntermediaryRepresentation.Instructions.FrameAddress: return false
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return false
        LowIntermediaryRepresentation.Instructions.FrameRoom: return false
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return false
        LowIntermediaryRepresentation.Instructions.CompareExchange: return false
        LowIntermediaryRepresentation.Instructions.VectorLoop: return false
        LowIntermediaryRepresentation.Instructions.Select: return false
        _: return true
    }
}

func clobbered_between(start: Integer, end: Integer): Boolean {
    var before = 0
    if start > 0 {
        var counted = clobbers_until[start - 1]
        crash counted
        before = counted
    }
    var through = clobbers_until[end]
    crash through
    return through > before
}

func scan_the_intervals() {
    var heads = List<Integer>()
    fill_with_numbers(heads, position_total + 1, -1)
    var chained = List<Integer>()
    fill_with_numbers(chained, register_total, -1)
    var register = register_total - 1
    while register >= 0 {
        var start = starts[register]
        crash start
        if start >= 0 {
            var head = heads[start]
            crash head
            chained[register] = head
            heads[start] = register
        }
        register = register - 1
    }
    var physical = 0
    while physical < 32 {
        var holding = List<Integer>()
        assigned.append(holding)
        var ever_holding = List<Integer>()
        every_holder.append(ever_holding)
        physical = physical + 1
    }
    var position = 0
    while position <= position_total {
        var next = heads[position]
        crash next
        var current = next
        if current >= 0 {
            expire_the_assigned(position)
        }
        while current >= 0 {
            place(current)
            var following = chained[current]
            crash following
            current = following
        }
        position = position + 1
    }
}

func place(register: Integer) {
    var decimal_size = decimal_sizes[register]
    crash decimal_size
    assert not joins_its_left(register)
    assert decimal_size <= 0 or not placed_in_a_decimal(register)
    assert decimal_size <= 0 or not took_a_constants_decimal(register)
    assert not takes_a_whole_volatile(register, true, 1)
    var index = 0
    while index < keeping.count() {
        var candidate = keeping[index]
        crash candidate
        if is_free_for(candidate, register) {
            give(candidate, register)
            return
        }
        index = index + 1
    }
    assert not takes_a_whole_volatile(register, true, 3)
    assert not takes_a_split_volatile(register)
    spill_the_cheapest(register)
}

# ../../OPTIMIZATIONS.md#a-result-takes-the-register-of-the-operand-it-ends
func find_the_joined() {
    fill_with_numbers(joined_lefts, register_total, -1)
    fill_with_numbers(joined_positions, register_total, -1)
    fill_with_numbers(joined_blocks, register_total, -1)
    var layout_index = 0
    while layout_index < layout.count() {
        var block_index = layout[layout_index]
        crash block_index
        var block = function.blocks[block_index]
        crash block
        var head = block_heads[block_index]
        crash head
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if reachable[block_index] == true and not is_elided(instruction) {
                note_a_joining(instruction, block_index, head + 1 + index)
            }
            index = index + 1
        }
        layout_index = layout_index + 1
    }
}

func note_a_joining(
    instruction: LowIntermediaryRepresentation.Instructions.Instruction,
    block_index: Integer,
    position: Integer,
) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Copy: note_a_joined(instruction.target, instruction.source, block_index, position)
        LowIntermediaryRepresentation.Instructions.Arithmetic: note_a_joined_arithmetic(instruction, block_index, position)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: note_a_joined(instruction.target, instruction.left, block_index, position)
        _: return
    }
}

func note_a_joined_arithmetic(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    block_index: Integer,
    position: Integer,
) {
    var divides = arithmetic.operator == 'divide' or arithmetic.operator == 'remainder'
    if not divides {
        note_a_joined(arithmetic.target, arithmetic.left, block_index, position)
    }
}

func note_a_joined(target: Integer, left: Integer, block_index: Integer, position: Integer) {
    assert target >= function.parameter_count and target < register_total and left >= 0 and left != target
    assert left < register_total
    var count = definitions[target]
    crash count
    assert count == 1
    joined_lefts[target] = left
    joined_positions[target] = position
    joined_blocks[target] = block_index
}

func joins_its_left(register: Integer): Boolean {
    var left = joined_lefts[register]
    var position = joined_positions[register]
    var block_index = joined_blocks[register]
    crash left
    crash position
    crash block_index
    if left < 0 or constant_of(left) or is_fused(left) or is_fused(register) or is_split[left] == true {
        return false
    }
    var physical = homes[left]
    crash physical
    var end = ends[left]
    crash end
    if physical < 0 or end != position or live_out_keys[key_of(left, block_index)] == true {
        return false
    }
    var decimal_size = decimal_sizes[register]
    var left_size = decimal_sizes[left]
    crash decimal_size
    crash left_size
    if decimal_size != left_size {
        return false
    }
    if physical >= 16 {
        var usable = physical >= 22 or not clobbered_in_a_segment(register)
        if not usable or crosses_a_vector_loop(register) {
            return false
        }
    } else if is_a_volatile_home(physical) and (not may_hold(physical, register) or clobbered_in_a_segment(register)) {
        return false
    }
    if not is_free_beside(physical, register, left, position) {
        return false
    }
    give(physical, register)
    return true
}

func is_free_beside(physical: Integer, register: Integer, left: Integer, position: Integer): Boolean {
    var holding = assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        if other == left {
            if overlaps_beyond(left, register, position) {
                return false
            }
        } else if overlaps(other, register) {
            return false
        }
        index = index + 1
    }
    return true
}

func overlaps_beyond(left: Integer, register: Integer, position: Integer): Boolean {
    var first_starts = segment_starts[left]
    var first_ends = segment_ends[left]
    var second_starts = segment_starts[register]
    var second_ends = segment_ends[register]
    crash first_starts
    crash first_ends
    crash second_starts
    crash second_ends
    var first_index = 0
    while first_index < first_starts.count() {
        var first_start = first_starts[first_index]
        var first_end = first_ends[first_index]
        crash first_start
        crash first_end
        var second_index = 0
        while second_index < second_starts.count() {
            var second_start = second_starts[second_index]
            var second_end = second_ends[second_index]
            crash second_start
            crash second_end
            var meets = first_end == position and second_start == position
            if first_start <= second_end and second_start <= first_end and not meets {
                return true
            }
            second_index = second_index + 1
        }
        first_index = first_index + 1
    }
    return false
}

func may_hold(physical: Integer, register: Integer): Boolean {
    return physical == volatile_home or register >= function.parameter_count
}

func takes_a_whole_volatile(register: Integer, starts_here: Boolean, tried: Integer): Boolean {
    if clobbered_in_a_segment(register) {
        return false
    }
    var own_starts = segment_starts[register]
    var own_ends = segment_ends[register]
    crash own_starts
    crash own_ends
    var index = 0
    while index < tried {
        var candidate = volatile_homes[index]
        crash candidate
        var free = false
        if starts_here {
            free = is_free_for(candidate, register)
        } else {
            free = is_free_over(candidate, own_starts, own_ends)
        }
        if may_hold(candidate, register) and free {
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func takes_a_split_volatile(register: Integer): Boolean {
    var decimal_size = decimal_sizes[register]
    crash decimal_size
    if decimal_size > 0 {
        return false
    }
    var slot_blocks = clobbered_blocks(register)
    if slot_blocks.is_empty() or not split_pays(register, slot_blocks) {
        return false
    }
    var kept_starts = List<Integer>()
    var kept_ends = List<Integer>()
    keep_the_stretches(register, slot_blocks, kept_starts, kept_ends)
    if kept_starts.is_empty() {
        return false
    }
    var index = 0
    while index < volatile_homes.count() {
        var candidate = volatile_homes[index]
        crash candidate
        if may_hold(candidate, register) and is_free_over(candidate, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

func clobbered_blocks(register: Integer): List<Integer> {
    var found = List<Integer>()
    var blocks = value_blocks[register]
    var block_starts = value_block_starts[register]
    var block_ends = value_block_ends[register]
    crash blocks
    crash block_starts
    crash block_ends
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        var start = block_starts[index]
        var end = block_ends[index]
        crash block_index
        crash start
        crash end
        if clobbered_between(start, end) and not found.contains(block_index) {
            found.append(block_index)
        }
        index = index + 1
    }
    return found
}

func keep_the_stretches(
    register: Integer,
    slot_blocks: List<Integer>,
    kept_starts: List<Integer>,
    kept_ends: List<Integer>,
) {
    var blocks = value_blocks[register]
    var block_starts = value_block_starts[register]
    var block_ends = value_block_ends[register]
    crash blocks
    crash block_starts
    crash block_ends
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        var start = block_starts[index]
        var end = block_ends[index]
        crash block_index
        crash start
        crash end
        if not slot_blocks.contains(block_index) {
            add_to_stretches(kept_starts, kept_ends, start, end)
        }
        index = index + 1
    }
}

func add_to_stretches(made_starts: List<Integer>, made_ends: List<Integer>, start: Integer, end: Integer) {
    var count = made_ends.count()
    if count > 0 {
        var last_end = made_ends[count - 1]
        crash last_end
        if start <= last_end + 1 {
            if end > last_end {
                made_ends[count - 1] = end
            }
            return
        }
    }
    made_starts.append(start)
    made_ends.append(end)
}

func split_pays(register: Integer, slot_blocks: List<Integer>): Boolean {
    var benefit: Long = 0
    var cost: Long = 0
    var counted = List<Integer>()
    var blocks = value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        if not slot_blocks.contains(block_index) and not counted.contains(block_index) {
            counted.append(block_index)
            benefit = benefit + weight_in(register, block_index)
        }
        index = index + 1
    }
    index = 0
    while index < slot_blocks.count() {
        var slot_block = slot_blocks[index]
        crash slot_block
        cost = cost + moves_around(register, slot_block, slot_blocks)
        index = index + 1
    }
    return benefit > cost
}

func weight_in(register: Integer, block_index: Integer): Integer {
    var weight = block_weights[key_of(register, block_index)]
    if not weight {
        return 0
    }
    return weight
}

func moves_around(register: Integer, slot_block: Integer, slot_blocks: List<Integer>): Long {
    var cost: Long = 0
    var coming = predecessors[slot_block]
    var leaving = successors[slot_block]
    crash coming
    crash leaving
    var index = 0
    while is_live_into(register, slot_block) and index < coming.count() {
        var predecessor = coming[index]
        crash predecessor
        if not slot_blocks.contains(predecessor) {
            cost = cost + edge_weight(predecessor, slot_block)
        }
        index = index + 1
    }
    index = 0
    while index < leaving.count() {
        var successor = leaving[index]
        crash successor
        if is_live_into(register, successor) and not slot_blocks.contains(successor) {
            cost = cost + edge_weight(slot_block, successor)
        }
        index = index + 1
    }
    return cost
}

func is_live_into(register: Integer, block_index: Integer): Boolean {
    return live_in_keys[key_of(register, block_index)] == true
}

func edge_weight(from_block: Integer, to_block: Integer): Integer {
    var from_depth = depths[from_block]
    var to_depth = depths[to_block]
    crash from_depth
    crash to_depth
    var depth = from_depth
    if to_depth < depth {
        depth = to_depth
    }
    return weight_at_depth(depth)
}

func weight_at_depth(depth: Integer): Integer {
    var cost = 1
    var level = 0
    while level < depth and level < 4 {
        cost = cost * 32
        level = level + 1
    }
    return cost
}

func is_free_over(physical: Integer, kept_starts: List<Integer>, kept_ends: List<Integer>): Boolean {
    if kept_starts.is_empty() {
        return true
    }
    var holding = every_holder[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        var other_starts = segment_starts[other]
        var other_ends = segment_ends[other]
        crash other_starts
        crash other_ends
        var other_end = ends[other]
        var first_kept = kept_starts[0]
        crash other_end
        crash first_kept
        var reaches = other_end >= first_kept
        if reaches and stretches_overlap(other_starts, other_ends, kept_starts, kept_ends) {
            return false
        }
        index = index + 1
    }
    return true
}

func split_around(
    register: Integer,
    slot_blocks: List<Integer>,
    kept_starts: List<Integer>,
    kept_ends: List<Integer>,
) {
    segment_starts[register] = kept_starts
    segment_ends[register] = kept_ends
    is_split[register] = true
    split_values.append(register)
    var index = 0
    while index < slot_blocks.count() {
        var slot_block = slot_blocks[index]
        crash slot_block
        slot_keys[key_of(register, slot_block)] = true
        index = index + 1
    }
}

func placed_in_a_decimal(register: Integer): Boolean {
    if crosses_a_vector_loop(register) {
        return false
    }
    var clobbered = clobbered_in_a_segment(register)
    var candidate = 3
    while candidate < 16 {
        var slot = 16 + candidate
        var usable = candidate >= 6 or not clobbered
        if usable and is_free_for(slot, register) {
            give(slot, register)
            return true
        }
        candidate = candidate + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#a-decimal-constant-gives-up-its-register-to-a-value
func took_a_constants_decimal(register: Integer): Boolean {
    if crosses_a_vector_loop(register) or decimal_constants[register] == true {
        return false
    }
    var clobbered = clobbered_in_a_segment(register)
    var candidate = 3
    while candidate < 16 {
        var slot = 16 + candidate
        var usable = candidate >= 6 or not clobbered
        if usable and gave_up_a_constant(slot, register) {
            return true
        }
        candidate = candidate + 1
    }
    return false
}

func gave_up_a_constant(slot: Integer, register: Integer): Boolean {
    var conflicts = conflicts_on(slot, register)
    if conflicts.count() != 1 {
        return false
    }
    var other = conflicts[0]
    crash other
    if decimal_constants[other] != true or is_split[other] == true or crosses_a_vector_loop(other) {
        return false
    }
    homes[other] = -1
    is_constant[other] = true
    var holding = assigned[slot]
    crash holding
    var at = holding.index_of(other)
    crash at
    holding.remove_at(at)
    var ever_holding = every_holder[slot]
    crash ever_holding
    var ever_at = ever_holding.index_of(other)
    crash ever_at
    ever_holding.remove_at(ever_at)
    give(slot, register)
    return true
}

func spill_the_cheapest(register: Integer) {
    var cheapest_physical = -1
    var cheapest_other = -1
    var cheapest_weight: Long = weight_of(register)
    var cheapest_length: Long = length_of(register)
    var index = 0
    while index < keeping.count() {
        var candidate = keeping[index]
        crash candidate
        var conflicts = conflicts_on(candidate, register)
        if conflicts.count() == 1 {
            var other = conflicts[0]
            crash other
            var other_weight: Long = weight_of(other)
            var other_length: Long = length_of(other)
            if other_weight * cheapest_length < cheapest_weight * other_length {
                cheapest_physical = candidate
                cheapest_other = other
                cheapest_weight = other_weight
                cheapest_length = other_length
            }
        }
        index = index + 1
    }
    if cheapest_physical < 0 {
        homes[register] = -1
        assert not takes_a_loop_split(register)
        return
    }
    homes[cheapest_other] = -1
    var holding = assigned[cheapest_physical]
    crash holding
    var at = holding.index_of(cheapest_other)
    crash at
    holding.remove_at(at)
    var ever_holding = every_holder[cheapest_physical]
    crash ever_holding
    var ever_at = ever_holding.index_of(cheapest_other)
    crash ever_at
    ever_holding.remove_at(ever_at)
    give(cheapest_physical, register)
    assert not takes_a_whole_volatile(cheapest_other, false, 3)
    assert not takes_a_split_volatile(cheapest_other)
    assert not takes_a_loop_split(cheapest_other)
}

# ../../OPTIMIZATIONS.md#a-value-spilled-outside-a-loop-lives-in-a-register-inside-it
func takes_a_loop_split(register: Integer): Boolean {
    var decimal_size = decimal_sizes[register]
    crash decimal_size
    if decimal_size > 0 or crosses_a_vector_loop(register) {
        return false
    }
    var deepest = deepest_use_of(register)
    if deepest < 1 {
        return false
    }
    var slot_blocks = shallower_blocks(register, deepest)
    if slot_blocks.is_empty() or not split_pays(register, slot_blocks) {
        return false
    }
    var kept_starts = List<Integer>()
    var kept_ends = List<Integer>()
    keep_the_stretches(register, slot_blocks, kept_starts, kept_ends)
    if kept_starts.is_empty() {
        return false
    }
    var index = 0
    while index < keeping.count() {
        var candidate = keeping[index]
        crash candidate
        if is_free_over(candidate, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    if stretches_clobbered(kept_starts, kept_ends) {
        return false
    }
    index = 0
    while index < volatile_homes.count() {
        var candidate = volatile_homes[index]
        crash candidate
        if may_hold(candidate, register) and is_free_over(candidate, kept_starts, kept_ends) {
            split_around(register, slot_blocks, kept_starts, kept_ends)
            give(candidate, register)
            return true
        }
        index = index + 1
    }
    return false
}

func deepest_use_of(register: Integer): Integer {
    var deepest = 0
    var blocks = value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var depth = depths[block_index]
        crash depth
        if depth > deepest and weight_in(register, block_index) > 0 {
            deepest = depth
        }
        index = index + 1
    }
    return deepest
}

func shallower_blocks(register: Integer, deepest: Integer): List<Integer> {
    var found = List<Integer>()
    var blocks = value_blocks[register]
    crash blocks
    var index = 0
    while index < blocks.count() {
        var block_index = blocks[index]
        crash block_index
        var depth = depths[block_index]
        crash depth
        if depth < deepest and not found.contains(block_index) {
            found.append(block_index)
        }
        index = index + 1
    }
    return found
}

func stretches_clobbered(kept_starts: List<Integer>, kept_ends: List<Integer>): Boolean {
    var index = 0
    while index < kept_starts.count() {
        var start = kept_starts[index]
        var end = kept_ends[index]
        crash start
        crash end
        if clobbered_between(start, end) {
            return true
        }
        index = index + 1
    }
    return false
}

func length_of(register: Integer): Integer {
    var made_starts = segment_starts[register]
    var made_ends = segment_ends[register]
    crash made_starts
    crash made_ends
    var length = 8
    var index = 0
    while index < made_starts.count() {
        var start = made_starts[index]
        var end = made_ends[index]
        crash start
        crash end
        length = length + end - start + 1
        index = index + 1
    }
    return length
}

func weight_of(register: Integer): Integer {
    var weight = weights[register]
    crash weight
    return weight
}

func add_weight(register: Integer, block_index: Integer) {
    var depth = depths[block_index]
    crash depth
    var cost = weight_at_depth(depth)
    var key = key_of(register, block_index)
    var in_block = weight_in(register, block_index)
    if in_block < 1000000000 {
        block_weights[key] = in_block + cost
    }
    var weight = weights[register]
    crash weight
    if weight < 1000000000 {
        weights[register] = weight + cost
    }
}

func find_the_depths() {
    var block_count = function.blocks.count()
    fill_with_numbers(depths, block_count, 0)
    var block_index = 0
    while block_index < block_count {
        var leaving = successors[block_index]
        crash leaving
        var from_position = layout_positions[block_index]
        crash from_position
        var leaving_index = 0
        while leaving_index < leaving.count() {
            var successor = leaving[leaving_index]
            var to_position = layout_positions[successor]
            crash to_position
            if to_position <= from_position {
                deepen(to_position, from_position)
            }
            leaving_index = leaving_index + 1
        }
        block_index = block_index + 1
    }
}

func deepen(from_position: Integer, to_position: Integer) {
    var position = from_position
    while position <= to_position {
        var block = layout[position]
        crash block
        var depth = depths[block]
        crash depth
        depths[block] = depth + 1
        position = position + 1
    }
}

func find_the_saved() {
    var index = 0
    while index < keeping.count() {
        var candidate = keeping[index]
        if homes.contains(candidate) {
            saved.append(candidate)
        }
        index = index + 1
    }
    var decimal = 6
    while decimal < 16 {
        if homes.contains(16 + decimal) {
            saved_decimals.append(decimal)
        }
        decimal = decimal + 1
    }
}

func key_of(register: Integer, block_index: Integer): Long {
    var key: Long = register
    return key * block_total + block_index
}

func note_an_occurrence(register: Integer, block_index: Integer, position: Integer) {
    var key = key_of(register, block_index)
    var first = block_firsts[key]
    if not first {
        block_firsts[key] = position
        block_lasts[key] = position
        var occurring = occurring_registers[block_index]
        crash occurring
        occurring.append(register)
        return
    }
    if position < first {
        block_firsts[key] = position
    }
    var last = block_lasts[key]
    crash last
    if position > last {
        block_lasts[key] = position
    }
}

func note_a_live_in(register: Integer, block_index: Integer) {
    var key = key_of(register, block_index)
    live_in_keys[key] = true
    var entering = entering_registers[block_index]
    crash entering
    entering.append(register)
}

func note_a_live_out(register: Integer, block_index: Integer) {
    var key = key_of(register, block_index)
    var known = live_out_keys[key]
    assert not known
    live_out_keys[key] = true
    var leaving = leaving_registers[block_index]
    crash leaving
    leaving.append(register)
}

# ../../OPTIMIZATIONS.md#values-live-in-registers
func build_the_segments() {
    var register = 0
    while register < register_total {
        var made_starts = List<Integer>()
        var made_ends = List<Integer>()
        segment_starts.append(made_starts)
        segment_ends.append(made_ends)
        var blocks = List<Integer>()
        var block_starts = List<Integer>()
        var block_ends = List<Integer>()
        value_blocks.append(blocks)
        value_block_starts.append(block_starts)
        value_block_ends.append(block_ends)
        register = register + 1
    }
    var seen = List<Integer>()
    fill_with_numbers(seen, register_total, -1)
    var parameter = 0
    while parameter < function.parameter_count and parameter < register_total {
        add_a_segment(parameter, 0, 0)
        note_a_block_stretch(parameter, 0, 0, 0)
        parameter = parameter + 1
    }
    var layout_index = 0
    while layout_index < layout.count() {
        var block_index = layout[layout_index]
        crash block_index
        var entering = entering_registers[block_index]
        var leaving = leaving_registers[block_index]
        var occurring = occurring_registers[block_index]
        crash entering
        crash leaving
        crash occurring
        add_the_block_segments(entering, block_index, seen)
        add_the_block_segments(leaving, block_index, seen)
        add_the_block_segments(occurring, block_index, seen)
        layout_index = layout_index + 1
    }
}

func add_the_block_segments(registers: List<Integer>, block_index: Integer, seen: List<Integer>) {
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        crash register
        var mark = seen[register]
        if mark != block_index {
            seen[register] = block_index
            add_the_block_segment(register, block_index)
        }
        index = index + 1
    }
}

func add_the_block_segment(register: Integer, block_index: Integer) {
    var head = block_heads[block_index]
    var tail = block_tails[block_index]
    crash head
    crash tail
    var key = key_of(register, block_index)
    var start = head
    var end = tail
    var entered = live_in_keys[key]
    var left = live_out_keys[key]
    if not entered {
        var first = block_firsts[key]
        crash first
        start = first
    }
    if not left {
        var last = block_lasts[key]
        crash last
        end = last
    }
    if block_index == 0 and entered {
        start = 0
    }
    if end < start {
        end = start
    }
    add_a_segment(register, start, end)
    note_a_block_stretch(register, block_index, start, end)
}

func note_a_block_stretch(register: Integer, block_index: Integer, start: Integer, end: Integer) {
    var blocks = value_blocks[register]
    var block_starts = value_block_starts[register]
    var block_ends = value_block_ends[register]
    crash blocks
    crash block_starts
    crash block_ends
    blocks.append(block_index)
    block_starts.append(start)
    block_ends.append(end)
}

func add_a_segment(register: Integer, start: Integer, end: Integer) {
    var made_starts = segment_starts[register]
    var made_ends = segment_ends[register]
    crash made_starts
    crash made_ends
    add_to_stretches(made_starts, made_ends, start, end)
}

func overlaps(first: Integer, second: Integer): Boolean {
    var first_starts = segment_starts[first]
    var first_ends = segment_ends[first]
    var second_starts = segment_starts[second]
    var second_ends = segment_ends[second]
    crash first_starts
    crash first_ends
    crash second_starts
    crash second_ends
    return stretches_overlap(first_starts, first_ends, second_starts, second_ends)
}

func stretches_overlap(
    first_starts: List<Integer>,
    first_ends: List<Integer>,
    second_starts: List<Integer>,
    second_ends: List<Integer>,
): Boolean {
    var first_index = 0
    var second_index = 0
    while first_index < first_starts.count() and second_index < second_starts.count() {
        var first_start = first_starts[first_index]
        var first_end = first_ends[first_index]
        var second_start = second_starts[second_index]
        var second_end = second_ends[second_index]
        crash first_start
        crash first_end
        crash second_start
        crash second_end
        if first_start <= second_end and second_start <= first_end {
            return true
        }
        if first_end < second_end {
            first_index = first_index + 1
        } else {
            second_index = second_index + 1
        }
    }
    return false
}

func clobbered_in_a_segment(register: Integer): Boolean {
    var made_starts = segment_starts[register]
    var made_ends = segment_ends[register]
    crash made_starts
    crash made_ends
    var index = 0
    while index < made_starts.count() {
        var start = made_starts[index]
        var end = made_ends[index]
        crash start
        crash end
        if clobbered_between(start, end) {
            return true
        }
        index = index + 1
    }
    return false
}

func conflicts_on(physical: Integer, register: Integer): List<Integer> {
    var found = List<Integer>()
    var holding = assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        if overlaps(other, register) {
            found.append(other)
        }
        index = index + 1
    }
    return found
}

func is_free_for(physical: Integer, register: Integer): Boolean {
    var holding = assigned[physical]
    crash holding
    var index = 0
    while index < holding.count() {
        var other = holding[index]
        crash other
        if overlaps(other, register) {
            return false
        }
        index = index + 1
    }
    return true
}

func give(physical: Integer, register: Integer) {
    homes[register] = physical
    var holding = assigned[physical]
    crash holding
    holding.append(register)
    var ever_holding = every_holder[physical]
    crash ever_holding
    ever_holding.append(register)
}

func expire_the_assigned(position: Integer) {
    var physical = 0
    while physical < assigned.count() {
        var holding = assigned[physical]
        crash holding
        var index = 0
        while index < holding.count() {
            var other = holding[index]
            crash other
            var end = ends[other]
            crash end
            if end < position {
                holding.remove_at(index)
            } else {
                index = index + 1
            }
        }
        physical = physical + 1
    }
}

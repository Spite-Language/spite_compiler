var _subtract_from_rsp_operand = 236
var _writer_frame_size = 120
var _move_rcx_into_rax_operands = 200
var _r11_with_r11_operands = 219
var _test_opcode = 133
var _jump_short_if_equal_opcode = 116
var _jump_short_if_not_sign_opcode = 121
var _move_into_r11d_opcode = 187
var _move_immediate_opcode = 199
var _move_into_rcx_operand = 193
var _add_to_dl_operand = 194
var _decrement_r9_operand = 201
var _store_byte_opcode = 136
var _jump_short_if_not_equal_opcode = 117
var _back_to_the_next_digit_displacement = 237
var _store_immediate_byte_opcode = 198
var _subtract_r9_from_r8_operands = 200
var _add_to_rsp_operand = 196
var _return_opcode = 195
var state = EmitterState()
var encoder = Generators.X64.Encoder()
var fixups = Fixups(state)
var frames = Frames(state)
var opcodes = Opcodes()

func RuntimeRoutines(starting_state: EmitterState) {
    state = starting_state
    encoder = starting_state.encoder
    fixups = Fixups(starting_state)
    frames = Frames(starting_state)
    opcodes = Opcodes()
}

func emit_the_stop_routine() {
    state.text_writer = encoder.position()
    encoder.byte(72)
    encoder.byte(opcodes.arithmetic_with_small_immediate_opcode)
    encoder.byte(_subtract_from_rsp_operand)
    encoder.byte(_writer_frame_size)
    encoder.byte(72)
    encoder.byte(opcodes.move_from_register_opcode)
    encoder.byte(76)
    encoder.byte(36)
    encoder.byte(48)
    encoder.byte(72)
    encoder.byte(opcodes.move_from_register_opcode)
    encoder.byte(84)
    encoder.byte(36)
    encoder.byte(56)
    emit_the_writing_tail()
    state.number_writer = encoder.position()
    var routine = [
        72
        opcodes.arithmetic_with_small_immediate_opcode
        _subtract_from_rsp_operand
        _writer_frame_size
        72
        opcodes.move_from_register_opcode
        _move_rcx_into_rax_operands
        76
        opcodes.load_address_opcode
        76
        36
        96
        77
        49
        _r11_with_r11_operands
        72
        _test_opcode
        opcodes.rdx_with_rdx_operands
        _jump_short_if_equal_opcode
        14
        72
        _test_opcode
        opcodes.rax_with_rax_operands
        _jump_short_if_not_sign_opcode
        9
        72
        opcodes.unary_group_opcode
        opcodes.negate_rax_operand
        65
        _move_into_r11d_opcode
        1
        0
        0
        0
        72
        _move_immediate_opcode
        _move_into_rcx_operand
        10
        0
        0
        0
        49
        opcodes.rdx_with_rdx_operands
        72
        opcodes.unary_group_opcode
        opcodes.unsigned_divide_by_rcx_operand
        128
        _add_to_dl_operand
        48
        73
        opcodes.group_five_opcode
        _decrement_r9_operand
        65
        _store_byte_opcode
        17
        72
        _test_opcode
        opcodes.rax_with_rax_operands
        _jump_short_if_not_equal_opcode
        _back_to_the_next_digit_displacement
        77
        _test_opcode
        _r11_with_r11_operands
        _jump_short_if_equal_opcode
        7
        73
        opcodes.group_five_opcode
        _decrement_r9_operand
        65
        _store_immediate_byte_opcode
        1
        45
        76
        opcodes.load_address_opcode
        68
        36
        96
        77
        41
        _subtract_r9_from_r8_operands
        76
        opcodes.move_from_register_opcode
        76
        36
        48
        76
        opcodes.move_from_register_opcode
        68
        36
        56
    ]
    routine.each(fixups.emit_a_byte)
    emit_the_writing_tail()
    state.stop_routine = encoder.position()
    if state.program.gates_crashes {
        emit_the_gated_stop_start()
    } else {
        encoder.byte(72)
        encoder.byte(opcodes.arithmetic_with_small_immediate_opcode)
        encoder.byte(_subtract_from_rsp_operand)
        encoder.byte(40)
    }
    fixups.call_routine(state.text_writer)
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

# ../../OPTIMIZATIONS.md#the-first-crash-stops-every-thread
func emit_the_gated_stop_start() {
    var keeping = [
        72
        opcodes.arithmetic_with_small_immediate_opcode
        _subtract_from_rsp_operand
        56
        72
        opcodes.move_from_register_opcode
        76
        36
        32
        72
        opcodes.move_from_register_opcode
        84
        36
        40
    ]
    keeping.each(fixups.emit_a_byte)
    gate_the_crash()
    var restoring = [
        72
        opcodes.move_into_register_opcode
        76
        36
        32
        72
        opcodes.move_into_register_opcode
        84
        36
        40
    ]
    restoring.each(fixups.emit_a_byte)
}

func gate_the_crash() {
    if state.program.gates_crashes {
        var at = encoder.call_relative()
        var fixup = Generators.X64.Fixup(at, "_crash_gate", 0)
        state.call_fixups.append(fixup)
    }
}

func emit_the_writing_tail() {
    encoder.move_small_immediate(encoder.rcx, -12)
    fixups.call_import("GetStdHandle")
    encoder.move_register(encoder.rcx, encoder.rax)
    var tail = [
        72
        opcodes.move_into_register_opcode
        84
        36
        48
        76
        opcodes.move_into_register_opcode
        68
        36
        56
        76
        opcodes.load_address_opcode
        76
        36
        40
        72
        _move_immediate_opcode
        68
        36
        32
        0
        0
        0
        0
    ]
    tail.each(fixups.emit_a_byte)
    fixups.call_import("WriteFile")
    var leaving = [
        72
        opcodes.arithmetic_with_small_immediate_opcode
        _add_to_rsp_operand
        _writer_frame_size
        _return_opcode
    ]
    leaving.each(fixups.emit_a_byte)
}

func write_a_label(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    var bytes = state.program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    fixups.call_routine(state.text_writer)
}

func write_a_number(register: Integer, is_signed: Boolean) {
    var home = state.allocation.home_of(register)
    if state.allocation.is_a_volatile_home(home) {
        encoder.load_virtual(encoder.rcx, register)
    } else {
        frames.read_into(encoder.rcx, register)
    }
    var signed_flag = 0
    if is_signed {
        signed_flag = 1
    }
    encoder.move_small_immediate(encoder.rdx, signed_flag)
    fixups.call_routine(state.number_writer)
}

func stop_with_pieces(texts: List<String>, numbers: List<Integer>, signed_numbers: List<Integer>) {
    keep_the_numbers(numbers)
    gate_the_crash()
    var index = 0
    while index < texts.count() {
        var piece = texts[index]
        var label = label_of_text(piece)
        write_a_label(label)
        if index < numbers.count() {
            var number = numbers[index]
            var sign = signed_numbers[index]
            crash sign
            write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func keep_the_numbers(numbers: List<Integer>) {
    var index = 0
    while index < numbers.count() {
        var number = numbers[index]
        crash number
        var home = state.allocation.home_of(number)
        if state.allocation.is_a_volatile_home(home) {
            encoder.store_virtual(number, home)
        }
        index = index + 1
    }
}

func label_of_text(text: String): Integer {
    var bytes = text.to_buffer()
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    return label
}

func stop_with(text: String, line: Integer) {
    var message = "spite: {text} in {state.current_key} at line {line}\n"
    var bytes = message.to_buffer()
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    load_message(label)
}

func load_message(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    var bytes = state.program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    var call_at = encoder.call_relative()
    var stop_fixup = Generators.X64.Fixup(call_at, "", 0)
    state.stop_fixups.append(stop_fixup)
}

func check_memory() {
    encoder.test_rax()
    var not_zero = opcodes.jump_if_not_equal_code
    var allocated = encoder.jump_if(not_zero)
    stop_with("the program ran out of memory", 1)
    fixups.patch_here(allocated)
}

var file = Buffer(0)
var no_program = LowIntermediaryRepresentation.LoweredProgram()
var emitter = Emitter(no_program)
var code = Buffer(0)
var data = Buffer(0)
var imports = [
    "ExitProcess"
    "GetStdHandle"
    "WriteFile"
    "GetProcessHeap"
    "HeapAlloc"
    "HeapReAlloc"
    "HeapFree"
    "LoadLibraryA"
    "GetProcAddress"
    "CreateThread"
    "WaitForSingleObject"
    "CloseHandle"
    "AddVectoredExceptionHandler"
    "SetThreadStackGuarantee"
    "GetCurrentThreadId"
    "Sleep"
    "TlsAlloc"
    "lstrlenA"
]
var text_address = 4096
var data_address = 0
var image_base: Long = 5368709120
var section_alignment = 4096
var file_alignment = 512
var header_size = 512
var descriptors_size = 40
var lookup_offset = 0
var library_lookup_offset = 0
var address_table_offset = 0
var library_address_table_offset = 0
var address_tables_size = 0
var hint_offsets = List<Integer>()
var library_hint_offsets = List<Integer>()
var library_name_offset = 0
var c_library_name_offset = 0
var label_offsets = List<Integer>()
var slot_offsets = List<Integer>()
var name_offsets = List<Integer>()

func PortableExecutable(starting_emitter: Emitter, starting_code: Buffer) {
    emitter = starting_emitter
    code = starting_code
}

func written(): Buffer {
    var code_count_4 = code.count()
    var code_room = aligned(code_count_4, section_alignment)
    data_address = text_address + code_room
    emitter.import_fixups.each(add_an_import)
    lay_out_the_data()
    patch_the_code()
    write_the_headers()
    write_padded(code)
    write_padded(data)
    return file
}

func add_an_import(fixup: Fixup) {
    if not imports.contains(fixup.target) {
        imports.append(fixup.target)
    }
}

func aligned(size: Integer, alignment: Integer): Integer {
    return (size + alignment - 1) / alignment * alignment
}

func lay_out_the_data() {
    var library_imports = emitter.library_imports
    var imports_c = not library_imports.is_empty()
    descriptors_size = 40
    var library_table_size = 0
    if imports_c {
        descriptors_size = 60
        library_table_size = 8 * (library_imports.count() + 1)
    }
    lookup_offset = aligned(descriptors_size, 8)
    var table_size = 8 * (imports.count() + 1)
    library_lookup_offset = lookup_offset + table_size
    address_table_offset = library_lookup_offset + library_table_size
    library_address_table_offset = address_table_offset + table_size
    address_tables_size = table_size + library_table_size
    var hints_start = library_address_table_offset + library_table_size
    var offset = laid_out_hints(imports, hint_offsets, hints_start)
    offset = laid_out_hints(library_imports, library_hint_offsets, offset)
    library_name_offset = offset
    if imports_c {
        offset = aligned(offset + 13, 2)
        c_library_name_offset = offset
    }
    offset = aligned(offset + 13, 8)
    var index = 0
    while index < emitter.program.data.count() {
        var bytes = emitter.program.data[index]
        label_offsets.append(offset)
        var bytes_count = bytes.count()
        offset = aligned(offset + bytes_count, 8)
        index = index + 1
    }
    index = 0
    while index < emitter.foreign_names.count() {
        slot_offsets.append(offset)
        offset = offset + 16
        index = index + 1
    }
    index = 0
    while index < emitter.foreign_names.count() {
        var name = emitter.foreign_names[index]
        name_offsets.append(offset)
        offset = offset + name.length() + 1
        index = index + 1
    }
    fill_the_data(offset)
}

func laid_out_hints(names: List<String>, offsets: List<Integer>, start: Integer): Integer {
    var offset = start
    var index = 0
    while index < names.count() {
        var name = names[index]
        offsets.append(offset)
        var name_length = name.length()
        offset = aligned(offset + 2 + name_length + 1, 2)
        index = index + 1
    }
    return offset
}

func fill_the_data(size: Integer) {
    var index = 0
    while index < size {
        data.append(0)
        index = index + 1
    }
    var library_name_address = data_address + library_name_offset
    data.write_integer_little_endian_at(0, data_address + lookup_offset)
    data.write_integer_little_endian_at(12, library_name_address)
    data.write_integer_little_endian_at(16, data_address + address_table_offset)
    fill_the_hints(imports, hint_offsets, lookup_offset, address_table_offset)
    write_text_at(library_name_offset, "KERNEL32.dll")
    var library_imports = emitter.library_imports
    if not library_imports.is_empty() {
        var c_library_name_address = data_address + c_library_name_offset
        data.write_integer_little_endian_at(20, data_address + library_lookup_offset)
        data.write_integer_little_endian_at(32, c_library_name_address)
        data.write_integer_little_endian_at(36, data_address + library_address_table_offset)
        fill_the_hints(library_imports, library_hint_offsets, library_lookup_offset, library_address_table_offset)
        write_text_at(c_library_name_offset, "ucrtbase.dll")
    }
    index = 0
    while index < emitter.program.data.count() {
        var bytes = emitter.program.data[index]
        var label_offset = label_offsets[index]
        crash label_offset
        write_bytes_at(label_offset, bytes)
        index = index + 1
    }
    index = 0
    while index < emitter.foreign_names.count() {
        var name = emitter.foreign_names[index]
        var name_offset = name_offsets[index]
        crash name_offset
        write_text_at(name_offset, name)
        index = index + 1
    }
    if emitter.program.hot_reload {
        fill_the_slots()
    }
}

# ../../HOT_RELOAD.md#the-parts
func fill_the_slots() {
    var keys = emitter.slot_labels.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var label = emitter.slot_labels[key]
        var body = emitter.body_offsets[key]
        crash label
        crash body
        var label_offset = label_offsets[label]
        crash label_offset
        var address = code_address(body)
        data.write_long_little_endian_at(label_offset, address)
        index = index + 1
    }
}

func code_address(offset: Integer): Long {
    var base = image_base + text_address
    return base + offset
}

func label_address(label: Integer): Long {
    var label_offset = label_offsets[label]
    crash label_offset
    var base = image_base + data_address
    return base + label_offset
}

func import_address(name: String): Long {
    var place = imports.index_of(name)
    crash place
    var base = image_base + data_address
    return base + address_table_offset + 8 * place
}

func library_import_address(name: String): Long {
    var place = emitter.library_imports.index_of(name)
    crash place
    var base = image_base + data_address
    return base + library_address_table_offset + 8 * place
}

func fill_the_hints(names: List<String>, offsets: List<Integer>, lookup_at: Integer, table_at: Integer) {
    var index = 0
    while index < names.count() {
        var hint = offsets[index]
        var name = names[index]
        crash hint
        var hint_address: Long = data_address + hint
        data.write_long_little_endian_at(lookup_at + 8 * index, hint_address)
        data.write_long_little_endian_at(table_at + 8 * index, hint_address)
        write_text_at(hint + 2, name)
        index = index + 1
    }
}

func write_text_at(at: Integer, text: String) {
    var bytes = text.to_bytes()
    write_bytes_at(at, bytes)
}

func write_bytes_at(at: Integer, bytes: Buffer) {
    var index = 0
    while index < bytes.count() {
        data[at + index] = bytes[index]
        index = index + 1
    }
}

func patch_the_code() {
    emitter.import_fixups.each(fix_an_import)
    emitter.library_fixups.each(fix_a_library_import)
    emitter.data_fixups.each(fix_a_label)
    emitter.slot_fixups.each(fix_a_slot)
}

func relative(at: Integer, target: Integer): Integer {
    var next = text_address + at + 4
    return target - next
}

func fix_an_import(fixup: Fixup) {
    var place = imports.index_of(fixup.target)
    crash place
    var target = data_address + address_table_offset + 8 * place
    var distance = relative(fixup.at, target)
    code.write_integer_little_endian_at(fixup.at, distance)
}

func fix_a_library_import(fixup: Fixup) {
    var place = emitter.library_imports.index_of(fixup.target)
    crash place
    var target = data_address + library_address_table_offset + 8 * place
    var distance = relative(fixup.at, target)
    code.write_integer_little_endian_at(fixup.at, distance)
}

func fix_a_label(fixup: Fixup) {
    var label_offset = label_offsets[fixup.index]
    crash label_offset
    var distance = relative(fixup.at, data_address + label_offset)
    code.write_integer_little_endian_at(fixup.at, distance)
}

func fix_a_slot(fixup: Fixup) {
    var target = slot_offsets[fixup.index]
    if fixup.target == "name" {
        target = name_offsets[fixup.index]
    }
    crash target
    if fixup.target == "owner" {
        target = target + 8
    }
    var distance = relative(fixup.at, data_address + target)
    code.write_integer_little_endian_at(fixup.at, distance)
}

func write_padded(section: Buffer) {
    var index = 0
    while index < section.count() {
        var read = section[index]
        crash read
        file.append(read)
        index = index + 1
    }
    var file_count = file.count()
    var padded = aligned(file_count, file_alignment)
    while file.count() < padded {
        file.append(0)
    }
}

func write_the_headers() {
    word(23117)
    var index = 2
    while index < 60 {
        file.append(0)
        index = index + 1
    }
    dword(64)
    dword(17744)
    word(34404)
    word(2)
    dword(0)
    dword(0)
    dword(0)
    word(240)
    word(34)
    write_the_optional_header()
    var code_count_3 = code.count()
    write_a_section(".text", code_count_3, text_address, 1610612768)
    var data_count_3 = data.count()
    write_a_section(".data", data_count_3, data_address, 3221225536)
    while file.count() < header_size {
        file.append(0)
    }
}

func write_the_optional_header() {
    var code_count_2 = code.count()
    var code_size = aligned(code_count_2, file_alignment)
    var data_count_2 = data.count()
    var data_size = aligned(data_count_2, file_alignment)
    var data_count = data.count()
    var image_size = data_address + aligned(data_count, section_alignment)
    var entry = text_address + emitter.entry_offset()
    word(523)
    file.append(14)
    file.append(0)
    dword(code_size)
    dword(data_size)
    dword(0)
    dword(entry)
    dword(text_address)
    qword(image_base)
    dword(section_alignment)
    dword(file_alignment)
    word(6)
    word(0)
    word(0)
    word(0)
    word(6)
    word(0)
    dword(0)
    dword(image_size)
    dword(header_size)
    dword(0)
    word(3)
    word(33024)
    qword(67108864)
    qword(4096)
    qword(1048576)
    qword(4096)
    dword(0)
    dword(16)
    write_the_directories()
}

func write_the_directories() {
    var index = 0
    while index < 16 {
        if index == 1 {
            dword(data_address)
            dword(descriptors_size)
        } else if index == 12 {
            dword(data_address + address_table_offset)
            dword(address_tables_size)
        } else {
            dword(0)
            dword(0)
        }
        index = index + 1
    }
}

func write_a_section(name: String, size: Integer, address: Integer, characteristics: Long) {
    var bytes = name.to_bytes()
    var index = 0
    while index < 8 {
        var read = bytes[index]
        if read {
            file.append(read)
        } else {
            file.append(0)
        }
        index = index + 1
    }
    dword(size)
    dword(address)
    var raw_size = aligned(size, file_alignment)
    dword(raw_size)
    var raw_offset = raw_offset_of(address)
    dword(raw_offset)
    dword(0)
    dword(0)
    word(0)
    word(0)
    var low_half = characteristics % 65536
    var high_half = characteristics / 65536
    var to_integer_2 = low_half.to_integer()
    word(to_integer_2)
    var to_integer = high_half.to_integer()
    word(to_integer)
}

func raw_offset_of(address: Integer): Integer {
    if address == text_address {
        return header_size
    }
    var code_count = code.count()
    return header_size + aligned(code_count, file_alignment)
}

func word(value: Integer) {
    var low_byte = value % 256
    var high_byte = value / 256
    var low: Byte = low_byte.to_byte()
    var high: Byte = high_byte.to_byte()
    file.append(low)
    file.append(high)
}

func dword(value: Integer) {
    file.append_integer_little_endian(value)
}

func qword(value: Long) {
    file.append_long_little_endian(value)
}

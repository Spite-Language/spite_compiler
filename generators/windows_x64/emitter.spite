var program = LowIntermediaryRepresentation.LoweredProgram()
var encoder = Encoder()
var function_offsets = Dictionary<String, Integer>()
var block_offsets = List<Integer>()
var block_fixups = List<Fixup>()
var call_fixups = List<Fixup>()
var import_fixups = List<Fixup>()
var data_fixups = List<Fixup>()
var slot_fixups = List<Fixup>()
var stop_fixups = List<Fixup>()
var foreign_names = List<String>()
var library_imports = List<String>()
var library_fixups = List<Fixup>()
var stop_routine = 0
var text_writer = 0
var number_writer = 0
var current_key = ""
var current_is_resumable = false
var current_outgoing = 0
var current_header = 0
var current_answer_decimal_size = 0
var parameter_registers = List<Integer>()
var no_function = LowIntermediaryRepresentation.LowFunction("", 0)
var allocation = Allocation(no_function)
var current_block = 0
var addressed_base = 0
var addressed_displacement = 0
var cold_jumps = List<Integer>()
var cold_arithmetics = List<LowIntermediaryRepresentation.Instructions.Arithmetic>()
var cold_kinds = List<Integer>()
var cold_targets = List<Integer>()
var cold_sources = List<Integer>()
var cold_immediates = List<Boolean>()
var cold_blocks = List<Integer>()
var current_block_index = 0
var stub_jumps = List<Integer>()
var stub_froms = List<Integer>()
var stub_tos = List<Integer>()
var flags_condition = 0
var flags_register = -1
var flags_have_parity = false
var flags_unordered_is_true = false
var current_instructions = List<LowIntermediaryRepresentation.Instructions.Instruction>()
var instruction_position = 0
var skips_the_next = false
var frame_slots = 0
var decimal_save_base = 0
var room_slots = 0
var current_place = ""
var current_block_place = ""
var loop_heads = List<Boolean>()
var call_offsets = List<Integer>()
var call_text_numbers = List<Integer>()
var call_texts = List<String>()
var call_numbers = Dictionary<String, Integer>()
var call_frames = LowIntermediaryRepresentation.CallFrames()
var place_starts = List<Integer>()
var place_texts = List<String>()
var small_blocks = SmallBlocks(encoder, program, data_fixups, import_fixups)
var kernels = VectorKernels(encoder, program, data_fixups)
var current_ends_a_thread = false
var span_keys = List<String>()
var span_starts = List<Integer>()
var code_end = 0

func Emitter(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    program = starting_program
    small_blocks = SmallBlocks(encoder, program, data_fixups, import_fixups)
    kernels = VectorKernels(encoder, program, data_fixups)
    parameter_registers.append(encoder.rcx)
    parameter_registers.append(encoder.rdx)
    parameter_registers.append(encoder.r8)
    parameter_registers.append(encoder.r9)
}

func emitted(): Buffer {
    span_keys.append("_stop_and_small_blocks")
    span_starts.append(0)
    emit_the_stop_routine()
    small_blocks.emit_the_routines(stop_routine)
    if program.vector_loops > 0 {
        kernels.emit_the_detection()
    }
    program.lowered_functions.each(emit_function)
    code_end = encoder.position()
    if program.place_table >= 0 {
        write_the_places()
    }
    if program.call_table >= 0 {
        write_the_calls()
    }
    call_fixups.each(fix_a_call)
    stop_fixups.each(fix_a_stop)
    return encoder.code
}

func note_the_place(start: Integer, place: String) {
    assert not place.is_empty()
    var count = place_texts.count()
    if count > 0 {
        var last = place_texts[count - 1]
        crash last
        assert last != place
    }
    place_starts.append(start)
    place_texts.append(place)
}

func note_a_call_site(line: Integer, frames: List<String>) {
    assert program.call_table >= 0
    var lines = List<String>()
    var own = call_frames.frame_line(current_block_place, line)
    if not own.is_empty() {
        lines.append(own)
    }
    call_frames.add_every(lines, frames)
    var number = -1
    if not lines.is_empty() {
        var text = lines.join("\n")
        number = number_of_a_call_text(text)
    }
    var at = encoder.position()
    call_offsets.append(at)
    call_text_numbers.append(number)
}

func number_of_a_call_text(text: String): Integer {
    if call_numbers.contains(text) {
        var known = call_numbers[text]
        crash known
        return known
    }
    var number = call_texts.count()
    call_texts.append(text)
    call_numbers[text] = number
    return number
}

func write_the_calls() {
    var table = Buffer(0)
    var count: Long = call_offsets.count()
    table.append_long_little_endian(count)
    var index = 0
    while index < call_offsets.count() {
        var offset = call_offsets[index]
        var number = call_text_numbers[index]
        crash number
        var start: Long = offset
        var numbered: Long = number
        table.append_long_little_endian(start)
        table.append_long_little_endian(numbered)
        index = index + 1
    }
    var texts = Buffer(0)
    var text_count: Long = call_texts.count()
    texts.append_long_little_endian(text_count)
    var placed: Long = text_count * 8 + 8
    var text_index = 0
    while text_index < call_texts.count() {
        texts.append_long_little_endian(placed)
        var measured = call_texts[text_index]
        var measured_bytes = measured.to_bytes()
        var measured_length = measured_bytes.count()
        var padded = (measured_length + 7) / 8 * 8
        placed = placed + 8 + padded
        text_index = text_index + 1
    }
    text_index = 0
    while text_index < call_texts.count() {
        var text = call_texts[text_index]
        var bytes = text.to_bytes()
        var length: Long = bytes.count()
        texts.append_long_little_endian(length)
        var byte_index = 0
        while byte_index < bytes.count() {
            var written = bytes[byte_index]
            crash written
            texts.append(written)
            byte_index = byte_index + 1
        }
        while texts.count() % 8 != 0 {
            texts.append(0)
        }
        text_index = text_index + 1
    }
    var byte_index = 0
    while byte_index < texts.count() {
        var copied = texts[byte_index]
        crash copied
        table.append(copied)
        byte_index = byte_index + 1
    }
    program.data[program.call_table] = table
}

func write_the_places() {
    var table = Buffer(0)
    var count: Long = place_texts.count()
    table.append_long_little_endian(count)
    var placed_index = 0
    while placed_index < place_texts.count() {
        var place = place_texts[placed_index]
        var offset = place_starts[placed_index]
        crash offset
        var start: Long = offset
        table.append_long_little_endian(start)
        var bytes = place.to_bytes()
        var length: Long = bytes.count()
        table.append_long_little_endian(length)
        var byte_index = 0
        while byte_index < bytes.count() {
            var written = bytes[byte_index]
            crash written
            table.append(written)
            byte_index = byte_index + 1
        }
        while table.count() % 8 != 0 {
            table.append(0)
        }
        placed_index = placed_index + 1
    }
    program.data[program.place_table] = table
}

func emit_the_stop_routine() {
    text_writer = encoder.position()
    encoder.byte(72)
    encoder.byte(131)
    encoder.byte(236)
    encoder.byte(120)
    encoder.byte(72)
    encoder.byte(137)
    encoder.byte(76)
    encoder.byte(36)
    encoder.byte(48)
    encoder.byte(72)
    encoder.byte(137)
    encoder.byte(84)
    encoder.byte(36)
    encoder.byte(56)
    emit_the_writing_tail()
    number_writer = encoder.position()
    var routine = [
        72
        131
        236
        120
        72
        137
        200
        76
        141
        76
        36
        96
        77
        49
        219
        72
        133
        210
        116
        14
        72
        133
        192
        121
        9
        72
        247
        216
        65
        187
        1
        0
        0
        0
        72
        199
        193
        10
        0
        0
        0
        49
        210
        72
        247
        241
        128
        194
        48
        73
        255
        201
        65
        136
        17
        72
        133
        192
        117
        237
        77
        133
        219
        116
        7
        73
        255
        201
        65
        198
        1
        45
        76
        141
        68
        36
        96
        77
        41
        200
        76
        137
        76
        36
        48
        76
        137
        68
        36
        56
    ]
    routine.each(emit_a_byte)
    emit_the_writing_tail()
    stop_routine = encoder.position()
    encoder.byte(72)
    encoder.byte(131)
    encoder.byte(236)
    encoder.byte(40)
    call_routine(text_writer)
    encoder.move_small_immediate(encoder.rcx, 1)
    call_import("ExitProcess")
}

func emit_a_byte(value: Integer) {
    encoder.byte(value)
}

func emit_the_writing_tail() {
    encoder.move_small_immediate(encoder.rcx, -12)
    call_import("GetStdHandle")
    encoder.move_register(encoder.rcx, encoder.rax)
    var tail = [72, 139, 84, 36, 48, 76, 139, 68, 36, 56, 76, 141, 76, 36, 40, 72, 199, 68, 36, 32, 0, 0, 0, 0]
    tail.each(emit_a_byte)
    call_import("WriteFile")
    var leaving = [72, 131, 196, 120, 195]
    leaving.each(emit_a_byte)
}

func call_routine(routine: Integer) {
    var at = encoder.call_relative()
    encoder.patch_dword(at, routine - (at + 4))
}

func write_a_label(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Fixup(at, "", label)
    data_fixups.append(fixup)
    var bytes = program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    call_routine(text_writer)
}

func write_a_number(register: Integer, is_signed: Boolean) {
    var home = allocation.home_of(register)
    if allocation.is_a_volatile_home(home) {
        encoder.load_virtual(encoder.rcx, register)
    } else {
        read_into(encoder.rcx, register)
    }
    var signed_flag = 0
    if is_signed {
        signed_flag = 1
    }
    encoder.move_small_immediate(encoder.rdx, signed_flag)
    call_routine(number_writer)
}

func stop_with_pieces(texts: List<String>, numbers: List<Integer>, signed_numbers: List<Integer>) {
    keep_the_numbers(numbers)
    var index = 0
    while index < texts.count() {
        var piece = texts[index]
        var label = label_of_text(piece)
        write_a_label(label)
        if index < numbers.count() {
            var number = numbers[index]
            var sign = signed_numbers[index]
            crash sign
            write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    encoder.move_small_immediate(encoder.rcx, 1)
    call_import("ExitProcess")
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func keep_the_numbers(numbers: List<Integer>) {
    var index = 0
    while index < numbers.count() {
        var number = numbers[index]
        crash number
        var home = allocation.home_of(number)
        if allocation.is_a_volatile_home(home) {
            encoder.store_virtual(number, home)
        }
        index = index + 1
    }
}

func label_of_text(text: String): Integer {
    var bytes = text.to_bytes()
    program.data.append(bytes)
    return program.data.count() - 1
}

func article_of(name: String): String {
    var first = name.code_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func call_import(name: String) {
    var at = encoder.call_through_memory()
    var fixup = Fixup(at, name, 0)
    import_fixups.append(fixup)
}

func emit_function(function: LowIntermediaryRepresentation.LowFunction) {
    current_key = function.key
    encoder.align_to(16)
    function_offsets[function.key] = encoder.position()
    span_keys.append(function.key)
    var span_start = encoder.position()
    span_starts.append(span_start)
    current_place = function.place
    var start = encoder.position()
    var shown_place = function.place
    if shown_place.is_empty() {
        shown_place = "-\t-\t-"
    }
    note_the_place(start, shown_place)
    block_fixups = List<Fixup>()
    allocation = Allocation(function)
    allocation.allocate()
    if program.vector_loops > 0 {
        kernels.plan_the_saved(function, allocation)
    }
    current_block = 0
    var outgoing = 32 + 8 * most_arguments_of(function)
    current_is_resumable = function.is_resumable
    current_ends_a_thread = function.ends_a_thread
    current_answer_decimal_size = function.answer_decimal_size
    if function.is_resumable {
        current_outgoing = (outgoing + 15) / 16 * 16
        current_header = 0 - 48 - 8 * function.register_count
        encoder.resumable_prologue(0 - current_header, current_outgoing)
    } else {
        frame_slots = allocation.register_total
        if frame_slots < function.register_count {
            frame_slots = function.register_count
        }
        decimal_save_base = frame_slots
        frame_slots = frame_slots + 2 * allocation.saved_decimals.count()
        room_slots = rooms_of(function)
        var frame = 8 * (frame_slots + allocation.saved.count() + room_slots) + outgoing
        var rounded = (frame + 15) / 16 * 16
        encoder.prologue(rounded)
        save_the_kept_registers()
        if function.key == program.entry {
            kernels.call_the_detection()
        }
        allocation.current_block = 0
        take_the_parameters(function)
    }
    block_offsets = List<Integer>()
    var block_count = 0
    while block_count < function.blocks.count() {
        block_offsets.append(0)
        block_count = block_count + 1
    }
    find_the_loop_heads(function)
    var position = 0
    while position < allocation.layout.count() {
        current_block = position
        var block_index = allocation.layout[position]
        if loop_heads[block_index] == true {
            encoder.align_to(32)
        }
        emit_block(function, block_index)
        position = position + 1
    }
    var cold = encoder.position()
    note_the_place(cold, current_place)
    current_block = allocation.layout.count() + 1
    emit_the_cold_stops()
    emit_the_edge_stubs()
    block_fixups.each(fix_a_block)
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func emit_the_moves(from_block: Integer, to_block: Integer) {
    var entering = allocation.entering_registers[to_block]
    crash entering
    var index = 0
    while index < entering.count() {
        var register = entering[index]
        crash register
        var from_home = allocation.home_in(register, from_block)
        if allocation.differs_on_the_edge(register, from_block, to_block) and from_home >= 0 {
            encoder.store_virtual(register, from_home)
        }
        index = index + 1
    }
    index = 0
    while index < entering.count() {
        var register = entering[index]
        crash register
        var to_home = allocation.home_in(register, to_block)
        if allocation.differs_on_the_edge(register, from_block, to_block) and to_home >= 0 {
            encoder.load_virtual(to_home, register)
        }
        index = index + 1
    }
}

func moves_at_the_tail(to_block: Integer): Boolean {
    if allocation.moves_at_the_head(to_block) {
        return false
    }
    return allocation.moves_on_the_edge(current_block_index, to_block)
}

func go_to_block(block: Integer) {
    if moves_at_the_tail(block) {
        emit_the_moves(current_block_index, block)
    }
    jump_to_block(block)
}

func jump_to_block_if_through_moves(condition: Integer, block: Integer) {
    if not moves_at_the_tail(block) {
        jump_to_block_if(condition, block)
        return
    }
    var at = encoder.jump_if(condition)
    stub_jumps.append(at)
    stub_froms.append(current_block_index)
    stub_tos.append(block)
}

func emit_the_edge_stubs() {
    var index = 0
    while index < stub_jumps.count() {
        var at = stub_jumps[index]
        var from_block = stub_froms[index]
        var to_block = stub_tos[index]
        crash at
        crash from_block
        crash to_block
        patch_here(at)
        emit_the_moves(from_block, to_block)
        jump_to_block(to_block)
        index = index + 1
    }
    stub_jumps.clear()
    stub_froms.clear()
    stub_tos.clear()
}

func find_the_loop_heads(function: LowIntermediaryRepresentation.LowFunction) {
    loop_heads = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        loop_heads.append(false)
        index = index + 1
    }
    var position = 0
    while position < allocation.layout.count() {
        var block_index = allocation.layout[position]
        var block = function.blocks[block_index]
        crash block
        var last = block.instructions.last()
        if last {
            note_a_back_edge(last, position)
        }
        position = position + 1
    }
}

func note_a_back_edge(last: LowIntermediaryRepresentation.Instructions.Instruction, position: Integer) {
    if last == LowIntermediaryRepresentation.Instructions.Jump {
        note_a_head(last.block, position)
    }
    if last == LowIntermediaryRepresentation.Instructions.Branch {
        note_a_head(last.when_true, position)
        note_a_head(last.when_false, position)
    }
}

func note_a_head(target: Integer, position: Integer) {
    assert target >= 0 and target < allocation.layout_positions.count()
    var target_position = allocation.layout_positions[target]
    if target_position >= 0 and target_position <= position {
        loop_heads[target] = true
    }
}

func rooms_of(function: LowIntermediaryRepresentation.LowFunction): Integer {
    var slots = 0
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction == LowIntermediaryRepresentation.Instructions.FrameRoom {
                var taken = (instruction.size + 7) / 8
                instruction.slot = slots + taken - 1
                slots = slots + taken
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return slots
}

func save_the_kept_registers() {
    var index = 0
    while index < allocation.saved.count() {
        var register = allocation.saved[index]
        var displacement = encoder.slot_of(frame_slots + index)
        encoder.store_slot(displacement, register)
        index = index + 1
    }
    var decimal_index = 0
    while decimal_index < allocation.saved_decimals.count() {
        var decimal = allocation.saved_decimals[decimal_index]
        var decimal_displacement = encoder.slot_of(decimal_save_base + 2 * decimal_index + 1)
        encoder.save_xmm(decimal_displacement, decimal)
        decimal_index = decimal_index + 1
    }
}

func restore_the_kept_registers() {
    var index = 0
    while index < allocation.saved.count() {
        var register = allocation.saved[index]
        var displacement = encoder.slot_of(frame_slots + index)
        encoder.load_slot(register, displacement)
        index = index + 1
    }
    var decimal_index = 0
    while decimal_index < allocation.saved_decimals.count() {
        var decimal = allocation.saved_decimals[decimal_index]
        var decimal_displacement = encoder.slot_of(decimal_save_base + 2 * decimal_index + 1)
        encoder.load_xmm(decimal, decimal_displacement)
        decimal_index = decimal_index + 1
    }
}

func read_into(register: Integer, virtual: Integer) {
    if allocation.constant_of(virtual) {
        var value = allocation.value_of(virtual)
        encoder.move_small_immediate(register, value)
        return
    }
    var decimal = allocation.decimal_home_of(virtual)
    if decimal >= 0 {
        var size = allocation.decimal_size_of(virtual)
        encoder.register_from_xmm(register, decimal, size == 8)
        return
    }
    var home = allocation.home_of(virtual)
    if home >= 0 {
        if home != register {
            encoder.move_register(register, home)
        }
        return
    }
    encoder.load_virtual(register, virtual)
}

func write_from(virtual: Integer, register: Integer) {
    var decimal = allocation.decimal_home_of(virtual)
    if decimal >= 0 {
        var size = allocation.decimal_size_of(virtual)
        encoder.xmm_from_register(decimal, register, size == 8)
        return
    }
    var home = allocation.home_of(virtual)
    if home >= 0 {
        if home != register {
            encoder.move_register(home, register)
        }
        return
    }
    encoder.store_virtual(virtual, register)
}

func register_of(virtual: Integer, scratch: Integer): Integer {
    var home = allocation.home_of(virtual)
    if home >= 0 and not allocation.constant_of(virtual) {
        return home
    }
    read_into(scratch, virtual)
    return scratch
}

func small_constant(virtual: Integer): Boolean {
    if not allocation.constant_of(virtual) {
        return false
    }
    var value = allocation.value_of(virtual)
    return encoder.fits_in_32_bits(value)
}

func falls_into(block: Integer): Boolean {
    var position = allocation.layout_positions[block]
    crash position
    return position == current_block + 1
}

func jump_to_block(block: Integer) {
    assert not falls_into(block)
    var at = encoder.jump()
    var fixup = Fixup(at, "", block)
    block_fixups.append(fixup)
}

func jump_to_block_if(condition: Integer, block: Integer) {
    var at = encoder.jump_if(condition)
    var fixup = Fixup(at, "", block)
    block_fixups.append(fixup)
}

func inverted(condition: Integer): Integer {
    if condition % 2 == 0 {
        return condition + 1
    }
    return condition - 1
}

func most_arguments_of(function: LowIntermediaryRepresentation.LowFunction): Integer {
    var most = 0
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            var count = argument_count_of(instruction)
            if count > most {
                most = count
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return most
}

func argument_count_of(instruction: LowIntermediaryRepresentation.Instructions.Instruction?): Integer {
    if instruction == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.arguments.count()
    }
    if instruction == LowIntermediaryRepresentation.Instructions.CallAt {
        return instruction.arguments.count()
    }
    if instruction == LowIntermediaryRepresentation.Instructions.ImportCall {
        return instruction.arguments.count()
    }
    return 4
}

func take_the_parameters(function: LowIntermediaryRepresentation.LowFunction) {
    var index = 0
    while index < function.parameter_count {
        var decimal_size = decimal_size_of_parameter(function, index)
        if index < 4 and decimal_size > 0 {
            encoder.rax_from_decimal_register(index, decimal_size == 8)
            write_from(index, encoder.rax)
        } else if index < 4 {
            var register = parameter_registers[index]
            crash register
            write_from(index, register)
        } else {
            var stack_offset = 48 + 8 * (index - 4)
            encoder.load_slot(encoder.rax, stack_offset)
            write_from(index, encoder.rax)
        }
        index = index + 1
    }
}

func decimal_size_of_parameter(function: LowIntermediaryRepresentation.LowFunction, index: Integer): Integer {
    if index < function.parameter_decimal_sizes.count() {
        return function.parameter_decimal_sizes[index]
    }
    return 0
}

func emit_block(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var here = encoder.position()
    block_offsets[block_index] = here
    var wanted = block.place
    if wanted.is_empty() {
        wanted = current_place
    }
    note_the_place(here, wanted)
    current_block_place = wanted
    flags_register = -1
    current_block_index = block_index
    allocation.current_block = block_index
    if allocation.moves_at_the_head(block_index) {
        var coming = allocation.predecessors[block_index]
        crash coming
        var only = coming[0]
        crash only
        emit_the_moves(only, block_index)
    }
    current_instructions = block.instructions
    instruction_position = 0
    skips_the_next = false
    block.instructions.each(emit_instruction)
    var last = block.instructions.last()
    var ends = false
    if last {
        ends = allocation.ends_the_block(last)
    }
    var following = block_index + 1
    if not ends and following < function.blocks.count() {
        go_to_block(following)
    }
}

func emit_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    var position = instruction_position
    instruction_position = position + 1
    if skips_the_next {
        skips_the_next = false
        flags_register = -1
        return
    }
    var compares = instruction == LowIntermediaryRepresentation.Instructions.Compare
    var keeps_flags = keeps_the_flags(instruction)
    emit_an_instruction(instruction)
    if not compares and not keeps_flags {
        flags_register = -1
    }
}

func keeps_the_flags(instruction: LowIntermediaryRepresentation.Instructions.Instruction): Boolean {
    if instruction == LowIntermediaryRepresentation.Instructions.Copy {
        return not allocation.constant_of(instruction.source) and instruction.target != flags_register
    }
    return false
}

func emit_an_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: emit_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: emit_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: emit_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: emit_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: emit_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: emit_a_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: emit_decimal_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Load: emit_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: emit_store(instruction)
        LowIntermediaryRepresentation.Instructions.Call: emit_call(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: emit_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: emit_foreign_address(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: emit_data_address(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: emit_function_address(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: emit_allocate(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: emit_retain(instruction)
        LowIntermediaryRepresentation.Instructions.Free: emit_free(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: emit_resize(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: emit_copy_bytes(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: emit_open_library(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: emit_jump(instruction)
        LowIntermediaryRepresentation.Instructions.Branch: emit_branch(instruction)
        LowIntermediaryRepresentation.Instructions.Return: emit_return(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: emit_frame_address(instruction)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: emit_thread_identity(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: emit_frame_room(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: emit_start_thread(instruction)
        LowIntermediaryRepresentation.Instructions.JoinThread: emit_join_thread(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: emit_atomic_add(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: emit_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: emit_compare_exchange(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: emit_stop(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: emit_exit(instruction)
        LowIntermediaryRepresentation.Instructions.VectorLoop: kernels.emit(instruction, allocation)
        LowIntermediaryRepresentation.Instructions.Select: emit_select(instruction)
    }
}

# ../../OPTIMIZATIONS.md#an-if-that-only-adds-or-picks-a-value-has-no-branch
func emit_select(selecting: LowIntermediaryRepresentation.Instructions.Select) {
    var condition = register_of(selecting.condition, encoder.rcx)
    var chosen = register_of(selecting.when_true, encoder.rdx)
    read_into(encoder.rax, selecting.when_false)
    encoder.test_register(condition)
    encoder.move_if_not_zero(encoder.rax, chosen)
    write_from(selecting.target, encoder.rax)
}

func emit_constant(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    assert not allocation.constant_of(constant.target)
    var decimal = allocation.decimal_home_of(constant.target)
    if decimal >= 0 {
        encoder.move_small_immediate(encoder.rax, constant.number)
        write_from(constant.target, encoder.rax)
        return
    }
    var home = allocation.home_of(constant.target)
    if home >= 0 {
        encoder.move_small_immediate(home, constant.number)
        return
    }
    if encoder.fits_in_32_bits(constant.number) {
        var displacement = encoder.slot_of(constant.target)
        encoder.store_slot_immediate(displacement, constant.number)
        return
    }
    encoder.move_small_immediate(encoder.rax, constant.number)
    write_from(constant.target, encoder.rax)
}

func emit_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    var target_decimal = allocation.decimal_home_of(copy.target)
    var source_decimal = allocation.decimal_home_of(copy.source)
    if target_decimal >= 0 and source_decimal >= 0 {
        if target_decimal != source_decimal {
            encoder.move_xmm(target_decimal, source_decimal)
        }
        return
    }
    var home = allocation.home_of(copy.target)
    if home >= 0 {
        read_into(home, copy.source)
        return
    }
    var source = register_of(copy.source, encoder.rax)
    write_from(copy.target, source)
}

func emit_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert not allocation.is_elided_target(arithmetic.target)
    var divides = arithmetic.operator == 'divide' or arithmetic.operator == 'remainder'
    if divides {
        emit_division(arithmetic)
        return
    }
    assert not emitted_in_place(arithmetic)
    assert not emitted_narrow(arithmetic)
    var shifts = arithmetic.operator == 'shift_left' or arithmetic.operator == 'shift_right'
    var needs_rcx = shifts or arithmetic.operator == 'multiply' and is_wide_unsigned(arithmetic)
    var immediate = takes_an_immediate(arithmetic)
    var source = encoder.rcx
    if not immediate and needs_rcx {
        read_into(encoder.rcx, arithmetic.right)
    }
    if not immediate and not needs_rcx {
        source = register_of(arithmetic.right, encoder.rcx)
    }
    read_into(encoder.rax, arithmetic.left)
    if immediate {
        emit_with_an_immediate(arithmetic, encoder.rax)
    } else {
        emit_registers(arithmetic, encoder.rax, source)
    }
    emit_checked(arithmetic)
    write_from(arithmetic.target, encoder.rax)
}

func emitted_narrow(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    if not arithmetic.is_checked or arithmetic.width != 'bits_32' {
        return false
    }
    var adds = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    var multiplies = arithmetic.operator == 'multiply' and arithmetic.is_signed
    if not adds and not multiplies {
        return false
    }
    var immediate = small_constant(arithmetic.right)
    var source = encoder.rcx
    if not immediate {
        source = register_of(arithmetic.right, encoder.rcx)
    }
    read_into(encoder.rax, arithmetic.left)
    if immediate {
        var value = allocation.value_of(arithmetic.right)
        emit_narrow_with_an_immediate(arithmetic, value)
    } else {
        emit_narrow_registers(arithmetic, source)
    }
    var condition = 130
    if arithmetic.is_signed {
        condition = 128
    }
    defer_a_stop(condition, arithmetic, 0, 0, 0, false)
    var home = allocation.home_of(arithmetic.target)
    var widened = encoder.rax
    if home >= 0 {
        widened = home
    }
    if arithmetic.is_signed {
        encoder.sign_extend_double_word(widened, encoder.rax)
    } else if widened != encoder.rax {
        encoder.move_double_word(widened, encoder.rax)
    }
    if home < 0 {
        write_from(arithmetic.target, encoder.rax)
    }
    return true
}

func emit_narrow_with_an_immediate(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, value: Long) {
    switch arithmetic.operator {
        'add': encoder.operation_immediate_narrow(0, encoder.rax, value)
        'subtract': encoder.operation_immediate_narrow(5, encoder.rax, value)
        _: encoder.multiply_immediate_narrow(encoder.rax, encoder.rax, value)
    }
}

func emit_narrow_registers(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, source: Integer) {
    switch arithmetic.operator {
        'add': encoder.register_operation_narrow(1, encoder.rax, source)
        'subtract': encoder.register_operation_narrow(41, encoder.rax, source)
        _: encoder.multiply_registers_narrow(encoder.rax, source)
    }
}

func is_wide_unsigned(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    return arithmetic.width == 'bits_64' and not arithmetic.is_signed and arithmetic.is_checked
}

func takes_an_immediate(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    if not small_constant(arithmetic.right) {
        return false
    }
    switch arithmetic.operator {
        'add': return true
        'subtract': return true
        'bits_and': return true
        'bits_or': return true
        'bits_xor': return true
        'multiply': return not is_wide_unsigned(arithmetic)
        'shift_left': return not arithmetic.is_checked
        'shift_right': return not arithmetic.is_checked
        _: return false
    }
}

func emit_with_an_immediate(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, register: Integer) {
    var value = allocation.value_of(arithmetic.right)
    switch arithmetic.operator {
        'add': encoder.operation_immediate(0, register, value)
        'subtract': encoder.operation_immediate(5, register, value)
        'bits_and': encoder.operation_immediate(4, register, value)
        'bits_or': encoder.operation_immediate(1, register, value)
        'bits_xor': encoder.operation_immediate(6, register, value)
        'multiply': emit_multiply_by(arithmetic, register, value)
        'shift_left': emit_shift_by(4, register, value)
        _: emit_shift_right_by(arithmetic, register, value)
    }
}

func emit_registers(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
) {
    switch arithmetic.operator {
        'add': encoder.register_operation(1, target, source)
        'subtract': encoder.register_operation(41, target, source)
        'bits_and': encoder.register_operation(33, target, source)
        'bits_or': encoder.register_operation(9, target, source)
        'bits_xor': encoder.register_operation(49, target, source)
        'multiply': emit_multiply_registers(arithmetic, target, source)
        'shift_left': emit_shift_left_by_cl(target)
        _: emit_shift_right_by_cl(arithmetic, target)
    }
}

func emit_multiply_registers(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
) {
    if is_wide_unsigned(arithmetic) {
        crash target == encoder.rax and source == encoder.rcx
        encoder.multiply_unsigned_by_rcx()
        return
    }
    encoder.multiply_registers(target, source)
}

func emit_shift_left_by_cl(target: Integer) {
    crash target == encoder.rax
    encoder.shift_rax_left_by_cl()
}

func emit_shift_right_by_cl(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, target: Integer) {
    crash target == encoder.rax
    emit_shift_right(arithmetic.is_signed)
}

func emit_multiply_by(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    register: Integer,
    value: Long,
) {
    var shift = power_of_two(value)
    if not arithmetic.is_checked and shift > 0 {
        encoder.shift_immediate(4, register, shift)
        return
    }
    encoder.multiply_immediate(register, register, value)
}

func emit_shift_by(extension: Integer, register: Integer, value: Long) {
    var masked = value.bits_and(63)
    var count = masked.to_integer()
    encoder.shift_immediate(extension, register, count)
}

func emit_shift_right_by(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    register: Integer,
    value: Long,
) {
    if arithmetic.is_signed {
        emit_shift_by(7, register, value)
    } else {
        emit_shift_by(5, register, value)
    }
}

func power_of_two(value: Long): Integer {
    var shift = 1
    var power: Long = 2
    while shift <= 30 {
        if power == value {
            return shift
        }
        power = power * 2
        shift = shift + 1
    }
    return 0
}

func emitted_in_place(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    var target = allocation.home_of(arithmetic.target)
    var wide_enough = arithmetic.width == 'bits_64' or keeps_its_width(arithmetic)
    if target < 0 or not wide_enough {
        return false
    }
    var immediate = takes_an_immediate(arithmetic)
    var registered = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    registered = registered or arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    registered = registered or arithmetic.operator == 'bits_xor'
    var multiplies = arithmetic.operator == 'multiply' and not is_wide_unsigned(arithmetic)
    registered = registered or multiplies
    if not immediate and not registered {
        return false
    }
    var left_home = allocation.home_of(arithmetic.left)
    if allocation.constant_of(arithmetic.left) {
        left_home = -1
    }
    var right_home = allocation.home_of(arithmetic.right)
    if allocation.constant_of(arithmetic.right) {
        right_home = -1
    }
    if not immediate and right_home == target {
        return false
    }
    var overwrites_left = left_home == target
    var invertible = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    if arithmetic.is_checked and overwrites_left and not invertible {
        return false
    }
    var source = encoder.rcx
    if not immediate {
        source = register_of(arithmetic.right, encoder.rcx)
    }
    read_into(target, arithmetic.left)
    if immediate {
        emit_with_an_immediate(arithmetic, target)
    } else {
        emit_registers(arithmetic, target, source)
    }
    if not arithmetic.is_checked {
        return true
    }
    var condition = 128
    if is_wide_unsigned(arithmetic) {
        condition = 130
    }
    var kind = 0
    if overwrites_left {
        kind = 1
    }
    defer_a_stop(condition, arithmetic, kind, target, source, immediate)
    return true
}

# ../../OPTIMIZATIONS.md#an-unchecked-32-bit-sum-is-one-instruction
func keeps_its_width(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    if arithmetic.is_checked or arithmetic.width != 'bits_32' {
        return false
    }
    var bitwise = arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    bitwise = bitwise or arithmetic.operator == 'bits_xor'
    var sums = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    return bitwise and arithmetic.is_signed or sums and not arithmetic.wraps
}

func undo_in_place(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if immediate {
        var value = allocation.value_of(arithmetic.right)
        if arithmetic.operator == 'add' {
            encoder.operation_immediate(5, target, value)
        } else {
            encoder.operation_immediate(0, target, value)
        }
        return
    }
    if arithmetic.operator == 'add' {
        encoder.register_operation(41, target, source)
    } else {
        encoder.register_operation(1, target, source)
    }
}

func emit_checked(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var wide_unsigned = is_wide_unsigned(arithmetic)
    if not arithmetic.is_checked {
        wrap_to_the_width(arithmetic)
        return
    }
    if wide_unsigned {
        var carry = 130
        defer_a_stop(carry, arithmetic, 0, 0, 0, false)
        return
    }
    if arithmetic.width == 'bits_64' {
        var overflow = 128
        defer_a_stop(overflow, arithmetic, 0, 0, 0, false)
        return
    }
    encoder.fits_back(arithmetic.width, arithmetic.is_signed)
    encoder.compare_rdx_rax()
    var not_equal = 133
    defer_a_stop(not_equal, arithmetic, 0, 0, 0, false)
}

func defer_a_stop(
    condition: Integer,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    var at = encoder.jump_if(condition)
    cold_jumps.append(at)
    cold_arithmetics.append(arithmetic)
    cold_kinds.append(kind)
    cold_targets.append(target)
    cold_sources.append(source)
    cold_immediates.append(immediate)
    cold_blocks.append(current_block_index)
}

func emit_the_cold_stops() {
    var index = 0
    while index < cold_jumps.count() {
        var at = cold_jumps[index]
        var arithmetic = cold_arithmetics[index]
        var kind = cold_kinds[index]
        var target = cold_targets[index]
        var source = cold_sources[index]
        var immediate = cold_immediates[index] == true
        var cold_block = cold_blocks[index]
        crash cold_block
        allocation.current_block = cold_block
        crash arithmetic
        crash kind
        crash target
        crash source
        patch_here(at)
        emit_a_cold_stop(arithmetic, kind, target, source, immediate)
        index = index + 1
    }
    cold_jumps.clear()
    cold_arithmetics.clear()
    cold_kinds.clear()
    cold_targets.clear()
    cold_sources.clear()
    cold_immediates.clear()
    cold_blocks.clear()
}

func emit_a_cold_stop(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if kind == 2 {
        stop_dividing_by_zero(arithmetic)
        return
    }
    if kind == 1 {
        undo_in_place(arithmetic, target, source, immediate)
    }
    stop_not_fitting(arithmetic)
}

func stop_not_fitting(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var symbol = symbol_of(arithmetic.operator)
    var article = article_of(arithmetic.type_name)
    var texts = List<String>()
    texts.append("spite: '{arithmetic.shown}' does not fit in {article} {arithmetic.type_name} (")
    texts.append(" {symbol} ")
    var owner = owner_of(arithmetic)
    texts.append("), at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var numbers = List<Integer>()
    numbers.append(arithmetic.left)
    numbers.append(arithmetic.right)
    var sign = 0
    if arithmetic.is_signed {
        sign = 1
    }
    var signs = List<Integer>()
    signs.append(sign)
    signs.append(sign)
    stop_with_pieces(texts, numbers, signs)
}

func owner_of(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    if arithmetic.owner.is_empty() {
        return current_key
    }
    return arithmetic.owner
}

func symbol_of(operator: LowIntermediaryRepresentation.ArithmeticOperator): String {
    switch operator {
        'add': return "+"
        'subtract': return "-"
        'multiply': return "*"
        'divide': return "/"
        _: return "%"
    }
}

# ../../OPTIMIZATIONS.md#a-decimal-lives-in-a-decimal-register
func decimal_register_of(virtual: Integer, scratch: Integer, is_double: Boolean): Integer {
    var home = allocation.decimal_home_of(virtual)
    if home >= 0 {
        return home
    }
    read_into(encoder.rax, virtual)
    encoder.xmm_from_register(scratch, encoder.rax, is_double)
    return scratch
}

func decimal_into(xmm: Integer, virtual: Integer, is_double: Boolean) {
    var source = decimal_register_of(virtual, xmm, is_double)
    if source != xmm {
        encoder.move_xmm(xmm, source)
    }
}

func decimal_from(virtual: Integer, xmm: Integer, is_double: Boolean) {
    var home = allocation.decimal_home_of(virtual)
    if home >= 0 {
        if home != xmm {
            encoder.move_xmm(home, xmm)
        }
        return
    }
    encoder.register_from_xmm(encoder.rax, xmm, is_double)
    write_from(virtual, encoder.rax)
}

func decimal_code_of(operator: LowIntermediaryRepresentation.ArithmeticOperator): Integer {
    switch operator {
        'add': return 88
        'subtract': return 92
        'multiply': return 89
        'divide': return 94
        'remainder': return 0
        _: return 81
    }
}

func emit_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    var is_double = arithmetic.is_double
    var code = decimal_code_of(arithmetic.operator)
    if code == 0 {
        decimal_into(0, arithmetic.left, is_double)
        decimal_into(1, arithmetic.right, is_double)
        encoder.decimal_remainder(is_double)
        decimal_from(arithmetic.target, 0, is_double)
        return
    }
    var target = allocation.decimal_home_of(arithmetic.target)
    var right_home = allocation.decimal_home_of(arithmetic.right)
    var working = 0
    if target >= 0 and target != right_home {
        working = target
    }
    if code != 81 {
        decimal_into(working, arithmetic.left, is_double)
    }
    var source = decimal_register_of(arithmetic.right, 1, is_double)
    encoder.scalar_operation(code, working, source, is_double)
    decimal_from(arithmetic.target, working, is_double)
}

func emit_a_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    if allocation.is_fused(compare.target) {
        emit_fused_decimal_compare(compare)
    } else {
        emit_decimal_compare(compare)
    }
}

func emit_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var is_double = compare.is_double
    var left = decimal_register_of(compare.left, 0, is_double)
    var right = decimal_register_of(compare.right, 1, is_double)
    var above = 151
    var above_or_equal = 147
    switch compare.comparison {
        'less': emit_decimal_test(right, left, above, is_double)
        'less_or_equal': emit_decimal_test(right, left, above_or_equal, is_double)
        'greater': emit_decimal_test(left, right, above, is_double)
        'greater_or_equal': emit_decimal_test(left, right, above_or_equal, is_double)
        'equal': emit_decimal_equality(true, left, right, is_double)
        _: emit_decimal_equality(false, left, right, is_double)
    }
    encoder.zero_extend_al_into_rax()
    write_from(compare.target, encoder.rax)
}

func emit_fused_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var is_double = compare.is_double
    var left = decimal_register_of(compare.left, 0, is_double)
    var right = decimal_register_of(compare.right, 1, is_double)
    var above = 151
    var above_or_equal = 147
    var first = left
    var second = right
    var setting = above_or_equal
    if compare.comparison == 'less' or compare.comparison == 'greater' {
        setting = above
    }
    var swapped = compare.comparison == 'less' or compare.comparison == 'less_or_equal'
    if swapped {
        first = right
        second = left
    }
    flags_have_parity = false
    var equal = 148
    var not_equal = 149
    if compare.comparison == 'equal' {
        setting = equal
        flags_have_parity = true
        flags_unordered_is_true = false
    }
    if compare.comparison == 'not_equal' {
        setting = not_equal
        flags_have_parity = true
        flags_unordered_is_true = true
    }
    encoder.compare_xmm(first, second, is_double)
    flags_condition = setting
    flags_register = compare.target
}

func emit_decimal_test(first: Integer, second: Integer, setting: Integer, is_double: Boolean) {
    encoder.compare_xmm(first, second, is_double)
    encoder.set_low_byte(setting, 0)
}

func emit_decimal_equality(is_equal: Boolean, left: Integer, right: Integer, is_double: Boolean) {
    encoder.compare_xmm(left, right, is_double)
    var equal = 148
    var not_equal = 149
    var parity = 154
    var no_parity = 155
    if is_equal {
        encoder.set_low_byte(equal, 0)
        encoder.set_low_byte(no_parity, 1)
        encoder.and_al_cl()
    } else {
        encoder.set_low_byte(not_equal, 0)
        encoder.set_low_byte(parity, 1)
        encoder.or_al_cl()
    }
}

func emit_decimal_conversion(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    var from_double = conversion.from_decimal_size == 8
    var to_double = conversion.to_decimal_size == 8
    if conversion.from_decimal_size == 0 {
        read_into(encoder.rax, conversion.source)
        encoder.whole_into_decimal(to_double)
        decimal_from(conversion.target, 0, to_double)
    } else if conversion.to_decimal_size == 0 {
        decimal_into(0, conversion.source, from_double)
        encoder.decimal_into_whole(from_double)
        cut_to_the_width(conversion)
        write_from(conversion.target, encoder.rax)
    } else {
        decimal_into(0, conversion.source, from_double)
        resize_the_decimal(to_double)
        decimal_from(conversion.target, 0, to_double)
    }
}

func cut_to_the_width(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    assert conversion.whole_width != 'bits_64'
    encoder.fits_back(conversion.whole_width, conversion.whole_is_signed)
    encoder.move_rdx_into_rax()
}

func resize_the_decimal(to_double: Boolean) {
    if to_double {
        encoder.float_into_double()
    } else {
        encoder.double_into_float()
    }
}

func emit_multiply(wide_unsigned: Boolean) {
    if wide_unsigned {
        encoder.multiply_unsigned_by_rcx()
    } else {
        encoder.multiply_rax_rcx()
    }
}

func emit_shift_right(is_signed: Boolean) {
    if is_signed {
        encoder.shift_rax_right_keeping_the_sign_by_cl()
    } else {
        encoder.shift_rax_right_by_cl()
    }
}

func wrap_to_the_width(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert arithmetic.width != 'bits_64'
    encoder.fits_back(arithmetic.width, arithmetic.is_signed)
    encoder.move_rdx_into_rax()
}

func emit_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    assert not emitted_as_a_pair(arithmetic)
    read_into(encoder.rax, arithmetic.left)
    if allocation.constant_of(arithmetic.right) {
        var divisor = allocation.value_of(arithmetic.right)
        if divisor != 0 and divisor != -1 {
            emit_division_by(arithmetic, divisor)
            write_from(arithmetic.target, encoder.rax)
            return
        }
    }
    read_into(encoder.rcx, arithmetic.right)
    if arithmetic.is_checked {
        emit_checked_division(arithmetic)
    } else {
        emit_proven_division(arithmetic)
    }
    write_from(arithmetic.target, encoder.rax)
}

# ../../OPTIMIZATIONS.md#a-division-and-a-remainder-of-the-same-two-numbers-are-one-division
func emitted_as_a_pair(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    if instruction_position >= current_instructions.count() {
        return false
    }
    var following = current_instructions[instruction_position]
    crash following
    if following == LowIntermediaryRepresentation.Instructions.Arithmetic {
        return emitted_with(arithmetic, following)
    }
    return false
}

func emitted_with(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    if not pairs_with(arithmetic, following) {
        return false
    }
    read_into(encoder.rax, arithmetic.left)
    read_into(encoder.rcx, arithmetic.right)
    if arithmetic.is_checked {
        encoder.test_rcx()
        var zero = 132
        defer_a_stop(zero, arithmetic, 2, 0, 0, false)
    }
    var dividing = arithmetic
    if arithmetic.operator == 'remainder' {
        dividing = following
    }
    if arithmetic.is_checked and arithmetic.is_signed {
        divide_signed_into_both(dividing)
    } else if arithmetic.is_signed {
        divide_signed_by_rcx_into_both(arithmetic)
    } else {
        divide_unsigned_by_rcx_into_both(arithmetic)
    }
    var quotient = arithmetic.target
    var remainder = following.target
    if arithmetic.operator == 'remainder' {
        quotient = following.target
        remainder = arithmetic.target
    }
    write_from(quotient, encoder.rax)
    write_from(remainder, encoder.rdx)
    skips_the_next = true
    return true
}

func pairs_with(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    var divides = arithmetic.operator == 'divide' and following.operator == 'remainder'
    var takes_the_rest = arithmetic.operator == 'remainder' and following.operator == 'divide'
    if not divides and not takes_the_rest {
        return false
    }
    var same_numbers = arithmetic.left == following.left and arithmetic.right == following.right
    var same_kind = arithmetic.width == following.width and arithmetic.is_signed == following.is_signed
    if not same_numbers or not same_kind {
        return false
    }
    var keeps_its_operands = arithmetic.target != arithmetic.left and arithmetic.target != arithmetic.right
    if not keeps_its_operands or arithmetic.target == following.target {
        return false
    }
    if allocation.is_elided_target(following.target) or allocation.constant_of(arithmetic.right) {
        return false
    }
    return not allocation.constant_of(arithmetic.left)
}

func divide_signed_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var minus_one = [72, 131, 249, 255]
    minus_one.each(emit_a_byte)
    var not_minus_one = 133
    var dividing = encoder.jump_if(not_minus_one)
    negate_or_stop(arithmetic)
    encoder.clear_rdx()
    var done = encoder.jump()
    patch_here(dividing)
    divide_signed_by_rcx_into_both(arithmetic)
    patch_here(done)
}

func divide_signed_by_rcx_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
        return
    }
    var narrow = [153, 247, 249, 72, 99, 192, 72, 99, 210]
    narrow.each(emit_a_byte)
}

func divide_unsigned_by_rcx_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
        return
    }
    var narrow = [49, 210, 247, 241, 137, 192, 137, 210]
    narrow.each(emit_a_byte)
}

func emit_proven_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.is_signed {
        divide_signed_by_rcx(arithmetic)
    } else {
        divide_unsigned_by_rcx(arithmetic)
    }
}

func divide_signed_by_rcx(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
        if arithmetic.operator == 'remainder' {
            encoder.move_register(encoder.rax, encoder.rdx)
        }
        return
    }
    var narrow = [153, 247, 249]
    narrow.each(emit_a_byte)
    var widened = [72, 99, 192]
    if arithmetic.operator == 'remainder' {
        widened = [72, 99, 194]
    }
    widened.each(emit_a_byte)
}

func divide_unsigned_by_rcx(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
        if arithmetic.operator == 'remainder' {
            encoder.move_register(encoder.rax, encoder.rdx)
        }
        return
    }
    var narrow = [49, 210, 247, 241]
    narrow.each(emit_a_byte)
    var widened = [137, 192]
    if arithmetic.operator == 'remainder' {
        widened = [137, 208]
    }
    widened.each(emit_a_byte)
}

func emit_division_by(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var shift = power_of_two(divisor)
    if shift > 0 and arithmetic.is_signed {
        divide_signed_by_a_power(arithmetic, shift, divisor)
        return
    }
    if shift > 0 {
        divide_unsigned_by_a_power(arithmetic, shift, divisor)
        return
    }
    if arithmetic.is_signed and divisor > 2 and divisor < 2147483648 {
        divide_by_multiplying(arithmetic, divisor)
        return
    }
    if arithmetic.is_signed and divisor < -1 and divisor > -2147483648 {
        divide_by_a_negative(arithmetic, divisor)
        return
    }
    var narrow = arithmetic.width != 'bits_64'
    if not arithmetic.is_signed and narrow and divisor > 2 and divisor < 2147483648 {
        divide_unsigned_by_multiplying(arithmetic, divisor)
        return
    }
    if not arithmetic.is_signed and not narrow and divisor > 2 {
        divide_wide_unsigned_by_multiplying(arithmetic, divisor)
        return
    }
    if not arithmetic.is_signed and not narrow and divisor < -1 {
        divide_wide_unsigned_by_a_larger_half(arithmetic, divisor)
        return
    }
    encoder.move_small_immediate(encoder.rcx, divisor)
    if arithmetic.is_signed {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
    } else {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
    }
    if arithmetic.operator == 'remainder' {
        encoder.move_register(encoder.rax, encoder.rdx)
    }
}

func divide_by_a_negative(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var zero: Long = 0
    var size = zero - divisor
    var shift = power_of_two(size)
    if shift > 0 {
        divide_signed_by_a_power(arithmetic, shift, size)
    } else {
        divide_by_multiplying(arithmetic, size)
    }
    if arithmetic.operator == 'divide' {
        var negated = [72, 247, 216]
        negated.each(emit_a_byte)
    }
}

func divide_unsigned_by_multiplying(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var largest: Long = 9223372036854775807
    var multiplier = largest / divisor + 1
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, multiplier)
    encoder.multiply_unsigned_by_rcx()
    var shifted = [72, 15, 164, 194, 1]
    shifted.each(emit_a_byte)
    if arithmetic.operator == 'remainder' {
        encoder.multiply_immediate(encoder.rdx, encoder.rdx, divisor)
        encoder.move_register(encoder.rax, encoder.rcx)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.move_register(encoder.rax, encoder.rdx)
}

# ../../OPTIMIZATIONS.md#dividing-by-a-constant-is-a-multiplication
func divide_wide_unsigned_by_multiplying(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var magic = UnsignedMagic(divisor)
    if magic.is_a_power {
        divide_wide_unsigned_by_a_power(arithmetic, divisor, magic.shift)
        return
    }
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, magic.multiplier)
    encoder.multiply_unsigned_by_rcx()
    encoder.move_register(encoder.rax, encoder.rcx)
    encoder.register_operation(41, encoder.rax, encoder.rdx)
    encoder.shift_immediate(5, encoder.rax, 1)
    encoder.register_operation(1, encoder.rax, encoder.rdx)
    encoder.shift_immediate(5, encoder.rax, magic.shift)
    assert arithmetic.operator == 'remainder'
    encoder.move_small_immediate(encoder.rdx, divisor)
    encoder.multiply_registers(encoder.rax, encoder.rdx)
    encoder.register_operation(41, encoder.rcx, encoder.rax)
    encoder.move_register(encoder.rax, encoder.rcx)
}

func divide_wide_unsigned_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    divisor: Long,
    shift: Integer,
) {
    if arithmetic.operator == 'remainder' {
        encoder.move_small_immediate(encoder.rcx, divisor - 1)
        encoder.register_operation(33, encoder.rax, encoder.rcx)
    } else {
        encoder.shift_immediate(5, encoder.rax, shift)
    }
}

func divide_wide_unsigned_by_a_larger_half(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    encoder.move_small_immediate(encoder.rcx, divisor)
    var at_least = [49, 210, 72, 57, 200, 15, 147, 194]
    at_least.each(emit_a_byte)
    if arithmetic.operator == 'remainder' {
        var taken = [72, 247, 218, 72, 33, 202]
        taken.each(emit_a_byte)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
    } else {
        encoder.move_register(encoder.rax, encoder.rdx)
    }
}

func divide_by_multiplying(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var magic = Magic(divisor)
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, magic.multiplier)
    encoder.multiply_wide_by(encoder.rcx)
    if magic.multiplier < 0 {
        encoder.register_operation(1, encoder.rdx, encoder.rcx)
    }
    if magic.shift > 0 {
        encoder.shift_immediate(7, encoder.rdx, magic.shift)
    }
    encoder.move_register(encoder.rax, encoder.rcx)
    encoder.shift_immediate(5, encoder.rax, 63)
    encoder.register_operation(1, encoder.rdx, encoder.rax)
    if arithmetic.operator == 'remainder' {
        encoder.multiply_immediate(encoder.rdx, encoder.rdx, divisor)
        encoder.move_register(encoder.rax, encoder.rcx)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.move_register(encoder.rax, encoder.rdx)
}

func divide_unsigned_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    shift: Integer,
    divisor: Long,
) {
    if arithmetic.operator == 'remainder' {
        encoder.operation_immediate(4, encoder.rax, divisor - 1)
    } else {
        encoder.shift_immediate(5, encoder.rax, shift)
    }
}

func divide_signed_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    shift: Integer,
    divisor: Long,
) {
    encoder.move_register(encoder.rdx, encoder.rax)
    encoder.shift_immediate(7, encoder.rdx, 63)
    encoder.shift_immediate(5, encoder.rdx, 64 - shift)
    encoder.register_operation(1, encoder.rdx, encoder.rax)
    if arithmetic.operator == 'remainder' {
        var negated: Long = 0
        negated = negated - divisor
        encoder.operation_immediate(4, encoder.rdx, negated)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.shift_immediate(7, encoder.rdx, shift)
    encoder.move_register(encoder.rax, encoder.rdx)
}

func stop_dividing_by_zero(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var texts = List<String>()
    var owner = owner_of(arithmetic)
    texts.append("spite: '{arithmetic.shown}' divided by zero, at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var no_numbers = List<Integer>()
    var no_signs = List<Integer>()
    stop_with_pieces(texts, no_numbers, no_signs)
}

func emit_checked_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    encoder.test_rcx()
    var zero = 132
    defer_a_stop(zero, arithmetic, 2, 0, 0, false)
    if arithmetic.is_signed {
        divide_signed(arithmetic)
        return
    }
    divide_unsigned_by_rcx(arithmetic)
}

func divide_signed(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var minus_one = [72, 131, 249, 255]
    minus_one.each(emit_a_byte)
    var not_minus_one = 133
    var dividing = encoder.jump_if(not_minus_one)
    if arithmetic.operator == 'remainder' {
        var zeroed = [49, 192]
        zeroed.each(emit_a_byte)
    } else {
        negate_or_stop(arithmetic)
    }
    var done = encoder.jump()
    patch_here(dividing)
    divide_signed_by_rcx(arithmetic)
    patch_here(done)
}

func negate_or_stop(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var negated = [72, 247, 216]
    negated.each(emit_a_byte)
    if arithmetic.width == 'bits_64' {
        var no_overflow = 129
        var fits_wide = encoder.jump_if(no_overflow)
        stop_not_fitting(arithmetic)
        patch_here(fits_wide)
        return
    }
    encoder.fits_back(arithmetic.width, true)
    encoder.compare_rdx_rax()
    var equal = 132
    var fits = encoder.jump_if(equal)
    stop_not_fitting(arithmetic)
    patch_here(fits)
}

func stop_with(text: String, line: Integer) {
    var message = "spite: {text} in {current_key} at line {line}\n"
    var bytes = message.to_bytes()
    program.data.append(bytes)
    var label = program.data.count() - 1
    load_message(label)
}

func load_message(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Fixup(at, "", label)
    data_fixups.append(fixup)
    var bytes = program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    var call_at = encoder.call_relative()
    var stop_fixup = Fixup(call_at, "", 0)
    stop_fixups.append(stop_fixup)
}

func patch_here(at: Integer) {
    var here = encoder.position()
    encoder.patch_dword(at, here - (at + 4))
}

func emit_compare(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    var left = register_of(compare.left, encoder.rax)
    if small_constant(compare.right) {
        var value = allocation.value_of(compare.right)
        encoder.compare_with(left, value)
    } else {
        var right = register_of(compare.right, encoder.rcx)
        encoder.compare_registers(left, right)
    }
    var condition = condition_code(compare.comparison, compare.is_signed)
    flags_condition = condition
    flags_register = compare.target
    flags_have_parity = false
    assert not allocation.is_fused(compare.target)
    encoder.al_from_condition(condition)
    encoder.zero_extend_al_into_rax()
    write_from(compare.target, encoder.rax)
}

func condition_code(comparison: LowIntermediaryRepresentation.Comparison, is_signed: Boolean): Integer {
    if is_signed {
        return signed_code(comparison)
    }
    return unsigned_code(comparison)
}

func signed_code(comparison: LowIntermediaryRepresentation.Comparison): Integer {
    switch comparison {
        'equal': return 148
        'not_equal': return 149
        'less': return 156
        'less_or_equal': return 158
        'greater': return 159
        'greater_or_equal': return 157
    }
}

func unsigned_code(comparison: LowIntermediaryRepresentation.Comparison): Integer {
    switch comparison {
        'equal': return 148
        'not_equal': return 149
        'less': return 146
        'less_or_equal': return 150
        'greater': return 151
        'greater_or_equal': return 147
    }
}

func prepare_the_address(address: Integer, offset: Integer) {
    if not allocation.is_folded_address(address) {
        addressed_base = register_of(address, encoder.rax)
        addressed_displacement = offset
        return
    }
    var base = allocation.base_of(address)
    addressed_base = register_of(base, encoder.rax)
    addressed_displacement = offset + allocation.displacement_of(address)
    var index = allocation.index_of(address)
    if index >= 0 {
        var index_register = register_of(index, encoder.r11)
        var scale = allocation.scale_of(address)
        encoder.index_by(index_register, scale)
    }
}

func emit_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    prepare_the_address(loaded.address, loaded.offset)
    if loaded.is_swapped {
        encoder.load_from(encoder.rax, addressed_base, addressed_displacement, loaded.width, false)
        encoder.stop_indexing()
        encoder.swap_rax(loaded.width, loaded.is_signed)
        write_from(loaded.target, encoder.rax)
        return
    }
    var decimal = allocation.decimal_home_of(loaded.target)
    var decimal_size = allocation.decimal_size_of(loaded.target)
    var whole = loaded.width == 'bits_64' or decimal_size == 4 and loaded.width == 'bits_32'
    if decimal >= 0 and whole {
        encoder.load_decimal_from(decimal, addressed_base, addressed_displacement, decimal_size == 8)
        encoder.stop_indexing()
        return
    }
    var home = allocation.home_of(loaded.target)
    if home >= 0 {
        encoder.load_from(home, addressed_base, addressed_displacement, loaded.width, loaded.is_signed)
        encoder.stop_indexing()
        return
    }
    encoder.load_from(encoder.rax, addressed_base, addressed_displacement, loaded.width, loaded.is_signed)
    encoder.stop_indexing()
    write_from(loaded.target, encoder.rax)
}

func emit_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    var wide = stored.width == 'bits_64'
    var source = -1
    var immediate = false
    var value: Long = 0
    if allocation.constant_of(stored.source) and not stored.is_swapped {
        value = allocation.value_of(stored.source)
        immediate = not wide or encoder.fits_in_32_bits(value)
    }
    var decimal = allocation.decimal_home_of(stored.source)
    var decimal_size = allocation.decimal_size_of(stored.source)
    var whole = stored.width == 'bits_32' or decimal_size == 8 and stored.width == 'bits_64'
    if not immediate and not stored.is_swapped and decimal >= 0 and whole {
        prepare_the_address(stored.address, stored.offset)
        encoder.store_decimal_to(addressed_base, addressed_displacement, decimal, stored.width == 'bits_64')
        encoder.stop_indexing()
        return
    }
    if not immediate {
        source = register_of(stored.source, encoder.rcx)
    }
    if stored.is_swapped {
        if source != encoder.rcx {
            encoder.move_register(encoder.rcx, source)
        }
        encoder.swap_rcx(stored.width)
        source = encoder.rcx
    }
    prepare_the_address(stored.address, stored.offset)
    if immediate {
        encoder.store_immediate_to(addressed_base, addressed_displacement, value, stored.width)
    } else {
        encoder.store_to(addressed_base, addressed_displacement, source, stored.width)
    }
    encoder.stop_indexing()
}

func pass_arguments(arguments: List<Integer>) {
    var index = 4
    while index < arguments.count() {
        var argument = arguments[index]
        read_into(encoder.rax, argument)
        encoder.store_outgoing(index)
        index = index + 1
    }
    index = 0
    while index < arguments.count() and index < 4 {
        var argument = arguments[index]
        var register = parameter_registers[index]
        crash register
        read_into(register, argument)
        index = index + 1
    }
}

func emit_call(call: LowIntermediaryRepresentation.Instructions.Call) {
    pass_arguments(call.arguments)
    var at = encoder.call_relative()
    var fixup = Fixup(at, call.function, 0)
    call_fixups.append(fixup)
    if program.call_table >= 0 {
        note_a_call_site(call.line, call.frames)
    }
    if call.target >= 0 {
        write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        write_from(call.presence, encoder.rdx)
    }
}

func emit_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    pass_arguments(call.arguments)
    var index = 0
    while index < call.decimal_sizes.count() and index < 4 {
        var size = call.decimal_sizes[index]
        var register = parameter_registers[index]
        crash register
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    read_into(encoder.r11, call.address)
    encoder.call_r11()
    if program.call_table >= 0 {
        note_a_call_site(call.line, call.frames)
    }
    if call.answers_32_bits {
        encoder.sign_extend_eax_into_rax()
    }
    if call.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(call.answer_decimal_size == 8)
    }
    if call.target >= 0 {
        write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        write_from(call.presence, encoder.rdx)
    }
}

func emit_function_address(address: LowIntermediaryRepresentation.Instructions.FunctionAddress) {
    var at = encoder.load_address_of(encoder.rax)
    var fixup = Fixup(at, address.function, 0)
    call_fixups.append(fixup)
    write_from(address.target, encoder.rax)
}

func emit_foreign_address(found: LowIntermediaryRepresentation.Instructions.ForeignAddress) {
    var slot = foreign_names.count()
    foreign_names.append(found.name)
    var loaded = encoder.load_from_address(encoder.rax)
    var loaded_fixup = Fixup(loaded, "", slot)
    slot_fixups.append(loaded_fixup)
    encoder.test_rax()
    var not_zero = 133
    var known = encoder.jump_if(not_zero)
    read_into(encoder.rcx, found.library)
    var name_at = encoder.load_address_of(encoder.rdx)
    var name_fixup = Fixup(name_at, "name", slot)
    slot_fixups.append(name_fixup)
    call_import("GetProcAddress")
    encoder.test_rax()
    var found_it = encoder.jump_if(not_zero)
    stop_with("the foreign function '{found.name}' is not in its library", 1)
    patch_here(found_it)
    var stored = encoder.store_at_address(encoder.rax)
    var stored_fixup = Fixup(stored, "", slot)
    slot_fixups.append(stored_fixup)
    patch_here(known)
    write_from(found.target, encoder.rax)
}

func emit_data_address(address: LowIntermediaryRepresentation.Instructions.DataAddress) {
    var at = encoder.load_address_of(encoder.rax)
    var fixup = Fixup(at, "", address.label)
    data_fixups.append(fixup)
    write_from(address.target, encoder.rax)
}

func emit_allocate(allocate: LowIntermediaryRepresentation.Instructions.Allocate) {
    var size: Long = -1
    if allocation.constant_of(allocate.size) {
        size = allocation.value_of(allocate.size)
    }
    if small_blocks.inlines_size(size) {
        small_blocks.allocate_inline(size)
    } else {
        read_into(encoder.rcx, allocate.size)
        small_blocks.call_allocate()
    }
    check_memory()
    write_from(allocate.target, encoder.rax)
}

func emit_retain(retain: LowIntermediaryRepresentation.Instructions.Retain) {
    var object = register_of(retain.object, encoder.rax)
    encoder.test_register(object)
    var zero = 132
    var skip = encoder.jump_if(zero)
    if program.uses_threads and retain.is_atomic {
        encoder.byte(240)
    }
    encoder.increment_memory(object, 8)
    patch_here(skip)
}

func emit_free(freed: LowIntermediaryRepresentation.Instructions.Free) {
    read_into(encoder.rcx, freed.pointer)
    small_blocks.free_inline()
}

func emit_resize(resize: LowIntermediaryRepresentation.Instructions.Resize) {
    read_into(encoder.rcx, resize.pointer)
    read_into(encoder.rdx, resize.size)
    small_blocks.call_resize()
    check_memory()
    write_from(resize.target, encoder.rax)
}

func emit_copy_bytes(copying: LowIntermediaryRepresentation.Instructions.CopyBytes) {
    read_into(encoder.rax, copying.destination)
    read_into(encoder.rdx, copying.source)
    read_into(encoder.rcx, copying.count)
    var source_index = 6
    var destination_index = 7
    encoder.move_register(encoder.r8, source_index)
    encoder.move_register(encoder.r9, destination_index)
    encoder.move_register(destination_index, encoder.rax)
    encoder.move_register(source_index, encoder.rdx)
    encoder.move_register(encoder.r11, source_index)
    encoder.register_operation(1, encoder.r11, encoder.rcx)
    encoder.register_operation(57, destination_index, source_index)
    var below_or_equal = 134
    var forward_from_below = encoder.jump_if(below_or_equal)
    encoder.register_operation(57, destination_index, encoder.r11)
    var above_or_equal = 131
    var forward_from_beyond = encoder.jump_if(above_or_equal)
    copy_backward()
    var done = encoder.jump()
    patch_here(forward_from_below)
    patch_here(forward_from_beyond)
    repeat_byte_moves()
    patch_here(done)
    encoder.move_register(source_index, encoder.r8)
    encoder.move_register(destination_index, encoder.r9)
}

func copy_backward() {
    encoder.byte(72)
    encoder.byte(141)
    encoder.byte(116)
    encoder.byte(14)
    encoder.byte(255)
    encoder.byte(72)
    encoder.byte(141)
    encoder.byte(124)
    encoder.byte(15)
    encoder.byte(255)
    encoder.byte(253)
    repeat_byte_moves()
    encoder.byte(252)
}

func repeat_byte_moves() {
    encoder.byte(243)
    encoder.byte(164)
}

func check_memory() {
    encoder.test_rax()
    var not_zero = 133
    var allocated = encoder.jump_if(not_zero)
    stop_with("the program ran out of memory", 1)
    patch_here(allocated)
}

func emit_open_library(open: LowIntermediaryRepresentation.Instructions.OpenLibrary) {
    read_into(encoder.rcx, open.name)
    call_import("LoadLibraryA")
    encoder.test_rax()
    var not_zero = 133
    var opened = encoder.jump_if(not_zero)
    stop_naming_the_library(open.name)
    patch_here(opened)
    write_from(open.target, encoder.rax)
}

func stop_naming_the_library(name: Integer) {
    var before = label_of_text("spite: the library '")
    write_a_label(before)
    read_into(encoder.rcx, name)
    call_import("lstrlenA")
    encoder.move_register(encoder.rdx, encoder.rax)
    read_into(encoder.rcx, name)
    call_routine(text_writer)
    var after = label_of_text(
        "' could not be opened, in {current_key}: it is not there, or it is not a library this program can load\n",
    )
    write_a_label(after)
    encoder.move_small_immediate(encoder.rcx, 1)
    call_import("ExitProcess")
}

func emit_jump(jump: LowIntermediaryRepresentation.Instructions.Jump) {
    go_to_block(jump.block)
}

func jump_when_unordered(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    var parity = 138
    if flags_unordered_is_true {
        jump_to_block_if_through_moves(parity, branch.when_true)
    } else {
        jump_to_block_if_through_moves(parity, branch.when_false)
    }
}

func emit_branch(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    if allocation.constant_of(branch.condition) {
        var value = allocation.value_of(branch.condition)
        if value != 0 {
            go_to_block(branch.when_true)
        } else {
            go_to_block(branch.when_false)
        }
        return
    }
    var condition = 133
    var flagged = branch.condition == flags_register
    if allocation.is_fused(branch.condition) or flagged {
        condition = flags_condition - 16
    } else {
        var tested = register_of(branch.condition, encoder.rax)
        encoder.test_register(tested)
    }
    if branch.when_true == branch.when_false {
        go_to_block(branch.when_true)
        return
    }
    var on_the_flags = allocation.is_fused(branch.condition) or flagged
    if flags_have_parity and on_the_flags {
        jump_when_unordered(branch)
    }
    var true_moves = moves_at_the_tail(branch.when_true)
    var false_moves = moves_at_the_tail(branch.when_false)
    var stays_on_true = falls_into(branch.when_true)
    if true_moves and not false_moves {
        stays_on_true = true
    } else if false_moves and not true_moves {
        stays_on_true = false
    }
    if stays_on_true {
        var opposite = inverted(condition)
        jump_to_block_if_through_moves(opposite, branch.when_false)
        go_to_block(branch.when_true)
        return
    }
    jump_to_block_if_through_moves(condition, branch.when_true)
    go_to_block(branch.when_false)
}

func emit_return(returned: LowIntermediaryRepresentation.Instructions.Return) {
    if current_ends_a_thread {
        small_blocks.call_release()
    }
    if returned.source >= 0 {
        read_into(encoder.rax, returned.source)
    }
    if returned.presence >= 0 {
        read_into(encoder.rdx, returned.presence)
    }
    if current_answer_decimal_size > 0 and returned.source >= 0 {
        encoder.decimal_register_from(0, encoder.rax, current_answer_decimal_size == 8)
    }
    if not current_is_resumable {
        restore_the_kept_registers()
        encoder.epilogue()
        return
    }
    if returned.is_a_suspension {
        encoder.move_small_immediate(encoder.rax, 0)
        encoder.resumable_epilogue(current_outgoing)
        return
    }
    encoder.store_slot(current_header + 16, encoder.rax)
    encoder.store_slot(current_header + 24, encoder.rdx)
    encoder.move_small_immediate(encoder.rax, 1)
    encoder.store_slot(current_header + 8, encoder.rax)
    encoder.resumable_epilogue(current_outgoing)
}

func emit_start_thread(starting: LowIntermediaryRepresentation.Instructions.StartThread) {
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.store_outgoing(4)
    encoder.store_outgoing(5)
    encoder.move_small_immediate(encoder.rcx, 0)
    encoder.move_small_immediate(encoder.rdx, 0)
    var at = encoder.load_address_of(encoder.r8)
    var fixup = Fixup(at, starting.entry, 0)
    call_fixups.append(fixup)
    read_into(encoder.r9, starting.block)
    call_import("CreateThread")
    write_from(starting.target, encoder.rax)
}

func emit_compare_exchange(exchanging: LowIntermediaryRepresentation.Instructions.CompareExchange) {
    read_into(encoder.r11, exchanging.address)
    read_into(encoder.rax, exchanging.expected)
    read_into(encoder.rcx, exchanging.desired)
    if exchanging.width == 'bits_32' {
        encoder.locked_compare_exchange_double_word(exchanging.offset)
        widen_the_exchanged(exchanging.is_signed)
    } else {
        encoder.locked_compare_exchange(exchanging.offset)
    }
    write_from(exchanging.target, encoder.rax)
}

func widen_the_exchanged(is_signed: Boolean) {
    if is_signed {
        encoder.sign_extend_eax_into_rax()
    } else {
        encoder.zero_extend_eax_into_rax()
    }
}

func emit_import_call(calling: LowIntermediaryRepresentation.Instructions.ImportCall) {
    var stacked = 4
    while stacked < calling.arguments.count() {
        var passed = calling.arguments[stacked]
        read_into(encoder.rax, passed)
        encoder.store_outgoing(stacked)
        stacked = stacked + 1
    }
    var index = 0
    while index < calling.arguments.count() and index < 4 {
        var argument = calling.arguments[index]
        var register = parameter_registers[index]
        crash register
        read_into(register, argument)
        var size = decimal_size_at(calling.decimal_sizes, index)
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    if calling.library.is_empty() {
        call_import(calling.name)
    } else {
        crash calling.library == "ucrtbase.dll"
        call_library_import(calling.name)
    }
    if calling.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(calling.answer_decimal_size == 8)
    }
    if calling.target >= 0 {
        write_from(calling.target, encoder.rax)
    }
}

func decimal_size_at(sizes: List<Integer>, index: Integer): Integer {
    if index < sizes.count() {
        return sizes[index]
    }
    return 0
}

func call_library_import(name: String) {
    if not library_imports.contains(name) {
        library_imports.append(name)
    }
    var at = encoder.call_through_memory()
    var fixup = Fixup(at, name, 0)
    library_fixups.append(fixup)
}

func emit_join_thread(joining: LowIntermediaryRepresentation.Instructions.JoinThread) {
    read_into(encoder.rcx, joining.thread)
    encoder.move_small_immediate(encoder.rdx, 4294967295)
    call_import("WaitForSingleObject")
    read_into(encoder.rcx, joining.thread)
    call_import("CloseHandle")
}

func emit_atomic_add(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    read_into(encoder.rax, adding.address)
    encoder.move_small_immediate(encoder.rcx, adding.amount)
    encoder.locked_exchange_add(adding.offset)
    encoder.move_small_immediate(encoder.rax, adding.amount)
    encoder.add_rcx_into_rax()
    write_from(adding.target, encoder.rax)
}

func emit_thread_identity(asked: LowIntermediaryRepresentation.Instructions.ThreadIdentity) {
    encoder.thread_identity_into_rax()
    write_from(asked.target, encoder.rax)
}

func emit_frame_address(found: LowIntermediaryRepresentation.Instructions.FrameAddress) {
    var header = 0
    if current_is_resumable {
        header = current_header
    }
    encoder.slot_address(encoder.rax, header)
    write_from(found.target, encoder.rax)
}

func emit_frame_room(room: LowIntermediaryRepresentation.Instructions.FrameRoom) {
    crash not current_is_resumable
    var lowest = frame_slots + allocation.saved.count() + room.slot
    var displacement = encoder.slot_of(lowest)
    var written: Integer = 0
    while written < room.size {
        encoder.store_immediate_to(encoder.rbp, displacement + written, 0, 'bits_64')
        written = written + 8
    }
    var home = allocation.home_of(room.target)
    if home >= 0 {
        encoder.slot_address(home, displacement)
        return
    }
    encoder.slot_address(encoder.rax, displacement)
    write_from(room.target, encoder.rax)
}

func emit_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    if stop.numbers.is_empty() and not stop.continues {
        load_message(stop.label)
        return
    }
    keep_the_numbers(stop.numbers)
    var index = 0
    while index < stop.labels.count() {
        var label = stop.labels[index]
        write_a_label(label)
        if index < stop.numbers.count() {
            var number = stop.numbers[index]
            var sign = stop.signed_numbers[index]
            crash sign
            write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    assert not stop.continues
    encoder.move_small_immediate(encoder.rcx, 1)
    call_import("ExitProcess")
}

func emit_exit(exit: LowIntermediaryRepresentation.Instructions.Exit) {
    read_into(encoder.rcx, exit.code)
    call_import("ExitProcess")
}

func fix_a_block(fixup: Fixup) {
    var target = block_offsets[fixup.index]
    crash target
    encoder.patch_dword(fixup.at, target - (fixup.at + 4))
}

func fix_a_call(fixup: Fixup) {
    var target = function_offsets[fixup.target]
    if not target {
        var emittable = Validators.LowIntermediaryRepresentation.Emittable.Validator()
        emittable.refuse('missing_function', fixup.target)
    }
    crash target
    encoder.patch_dword(fixup.at, target - (fixup.at + 4))
}

func fix_a_stop(fixup: Fixup) {
    encoder.patch_dword(fixup.at, stop_routine - (fixup.at + 4))
}

func entry_offset(): Integer {
    var found = function_offsets[program.entry]
    crash found
    return found
}

func function_map(): String {
    var lines = List<String>()
    lines.append("# spite functions 1")
    var index = 0
    while index < span_keys.count() {
        var key = span_keys[index]
        var start = span_starts[index]
        crash start
        var end = code_end
        var following = span_starts[index + 1]
        if following {
            end = following
        }
        var start_text = hexadecimal_of(start)
        var end_text = hexadecimal_of(end)
        lines.append("{start_text}\t{end_text}\t{key}")
        index = index + 1
    }
    lines.append("")
    return lines.join("\n")
}

func hexadecimal_of(value: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = value
    var place = 0
    while place < 8 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

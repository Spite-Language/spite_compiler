    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var _arithmetic_with_small_immediate_opcode = 131
var _subtract_from_rsp_operand = 236
var _writer_frame_size = 120
var _move_from_register_opcode = 137
var _move_rcx_into_rax_operands = 200
var _r11_with_r11_operands = 219
var _test_opcode = 133
var _rdx_with_rdx_operands = 210
var _jump_short_if_equal_opcode = 116
var _rax_with_rax_operands = 192
var _jump_short_if_not_sign_opcode = 121
var _unary_group_opcode = 247
var _negate_rax_operand = 216
var _move_into_r11d_opcode = 187
var _move_immediate_opcode = 199
var _move_into_rcx_operand = 193
var _unsigned_divide_by_rcx_operand = 241
var _add_to_dl_operand = 194
var _group_five_opcode = 255
var _decrement_r9_operand = 201
var _store_byte_opcode = 136
var _jump_short_if_not_equal_opcode = 117
var _back_to_the_next_digit_displacement = 237
var _store_immediate_byte_opcode = 198
var _subtract_r9_from_r8_operands = 200
var _add_to_rsp_operand = 196
var _return_opcode = 195
var _jump_if_carry_code = 130
var _jump_if_not_equal_code = 133
var _set_if_above_code = 151
var _set_if_above_or_equal_code = 147
var _set_if_equal_code = 148
var _set_if_not_equal_code = 149
var _set_if_parity_code = 154
var _set_if_no_parity_code = 155
var _jump_if_equal_code = 132
var _compare_rcx_operand = 249
var _minus_one_byte = 255
var _sign_extend_eax_into_edx_opcode = 153
var _signed_divide_by_rcx_operand = 249
var _sign_extend_edx_into_rax_operands = 194
var _move_edx_into_eax_operands = 208
var _largest_long: Long = 9223372036854775807
var _shift_left_double_opcode = 164
var _shift_rdx_with_rax_operands = 194
var _compare_rax_with_rcx_operands = 200
var _set_dl_operand = 194
var _negate_rdx_operand = 218
var _and_rdx_with_rcx_operands = 202
var _jump_if_no_overflow_code = 129
var _set_if_less_code = 156
var _set_if_less_or_equal_code = 158
var _set_if_greater_code = 159
var _set_if_greater_or_equal_code = 157
var _set_if_below_code = 146
var _set_if_below_or_equal_code = 150
var _lock_prefix = 240
var _jump_if_below_or_equal_code = 134
var _jump_if_above_or_equal_code = 131
var _rsi_from_indexed_address_operand = 116
var _rdi_from_indexed_address_operand = 124
var _set_direction_opcode = 253
var _clear_direction_opcode = 252
var _repeat_prefix = 243
var _move_string_byte_opcode = 164
var _jump_if_parity_code = 138
var _wait_forever: Long = 4294967295
var _filled_word_pattern: Long = 2779096485
var state = EmitterState()
var encoder = Generators.X64.Encoder()
var edge_moves = EdgeMoves(state)
var fixups = Fixups(state)
var frames = Frames(state)
var opcodes = Opcodes()

func Emitter(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    encoder = state.encoder
    state.program = starting_program
    state.small_blocks = SmallBlocks(encoder, state.program, state.data_fixups, state.import_fixups)
    state.kernels = Generators.X64.VectorKernels(encoder, state.program, state.data_fixups)
    var windows_convention = Convention()
    state.convention = windows_convention.table()
    state.parameter_registers = state.convention.argument_registers
}

func emitted(): Buffer {
    state.span_keys.append("_stop_and_small_blocks")
    state.span_starts.append(0)
    emit_the_stop_routine()
    state.small_blocks.emit_the_routines(state.stop_routine)
    if state.program.vector_loops > 0 {
        state.kernels.emit_the_detection()
    }
    state.routines_end = encoder.position()
    state.program.lowered_functions.each(emit_function)
    state.code_end = encoder.position()
    if state.program.place_table >= 0 {
        write_the_places()
    }
    if state.program.call_table >= 0 {
        write_the_calls()
    }
    state.call_fixups.each(fixups.fix_a_call)
    state.stop_fixups.each(fixups.fix_a_stop)
    return encoder.code
}

func note_the_place(start: Integer, place: String) {
    fallback not place.is_empty()
    var count = state.place_texts.count()
    if count > 0 {
        var last = state.place_texts[count - 1]
        crash last
        fallback last != place
    }
    state.place_starts.append(start)
    state.place_texts.append(place)
}

func note_a_call_site(line: Integer, frames: List<String>) {
    fallback state.program.call_table >= 0
    var lines = List<String>()
    var own = state.call_frames.frame_line(state.current_block_place, line)
    if not own.is_empty() {
        lines.append(own)
    }
    state.call_frames.add_every(lines, frames)
    var number = -1
    if not lines.is_empty() {
        var text = lines.join("\n")
        number = number_of_a_call_text(text)
    }
    var at = encoder.position()
    state.call_offsets.append(at)
    state.call_text_numbers.append(number)
}

func number_of_a_call_text(text: String): Integer {
    if state.call_numbers.contains(text) {
        var known = state.call_numbers[text]
        crash known
        return known
    }
    var number = state.call_texts.count()
    state.call_texts.append(text)
    state.call_numbers[text] = number
    return number
}

func write_the_calls() {
    var table = Buffer(0)
    var count: Long = state.call_offsets.count()
    table.append_long_little_endian(count)
    var index = 0
    while index < state.call_offsets.count() {
        var offset = state.call_offsets[index]
        var number = state.call_text_numbers[index]
        crash number
        var start: Long = offset
        var numbered: Long = number
        table.append_long_little_endian(start)
        table.append_long_little_endian(numbered)
        index = index + 1
    }
    var texts = Buffer(0)
    var text_count: Long = state.call_texts.count()
    texts.append_long_little_endian(text_count)
    var placed: Long = text_count * 8 + 8
    var text_index = 0
    while text_index < state.call_texts.count() {
        texts.append_long_little_endian(placed)
        var measured = state.call_texts[text_index]
        var measured_bytes = measured.to_buffer()
        var measured_length = measured_bytes.count()
        var padded = (measured_length + 7) / 8 * 8
        placed = placed + 8 + padded
        text_index = text_index + 1
    }
    text_index = 0
    while text_index < state.call_texts.count() {
        var text = state.call_texts[text_index]
        var bytes = text.to_buffer()
        var length: Long = bytes.count()
        texts.append_long_little_endian(length)
        var byte_index = 0
        while byte_index < bytes.count() {
            var written = bytes[byte_index]
            crash written
            texts.append(written)
            byte_index = byte_index + 1
        }
        while texts.count() % 8 != 0 {
            texts.append(0)
        }
        text_index = text_index + 1
    }
    var byte_index = 0
    while byte_index < texts.count() {
        var copied = texts[byte_index]
        crash copied
        table.append(copied)
        byte_index = byte_index + 1
    }
    state.program.data[state.program.call_table] = table
}

# ../../HOT_RELOAD.md#crash-reports-inside-reloaded-code
func write_the_places() {
    var table = Buffer(0)
    var count: Long = state.place_texts.count() + 1
    table.append_long_little_endian(count)
    var no_reload: Long = 0
    table.append_long_little_endian(no_reload)
    var placed_index = 0
    while placed_index < state.place_texts.count() {
        var place = state.place_texts[placed_index]
        var offset = state.place_starts[placed_index]
        crash offset
        var start: Long = offset
        append_a_place(table, start, place)
        placed_index = placed_index + 1
    }
    var end: Long = state.code_end
    append_a_place(table, end, "-\t-\t-")
    state.program.data[state.program.place_table] = table
}

func append_a_place(table: Buffer, start: Long, place: String) {
    table.append_long_little_endian(start)
    var bytes = place.to_buffer()
    var length: Long = bytes.count()
    table.append_long_little_endian(length)
    var byte_index = 0
    while byte_index < bytes.count() {
        var written = bytes[byte_index]
        crash written
        table.append(written)
        byte_index = byte_index + 1
    }
    while table.count() % 8 != 0 {
        table.append(0)
    }
}

func emit_the_stop_routine() {
    state.text_writer = encoder.position()
    encoder.byte(72)
    encoder.byte(_arithmetic_with_small_immediate_opcode)
    encoder.byte(_subtract_from_rsp_operand)
    encoder.byte(_writer_frame_size)
    encoder.byte(72)
    encoder.byte(_move_from_register_opcode)
    encoder.byte(76)
    encoder.byte(36)
    encoder.byte(48)
    encoder.byte(72)
    encoder.byte(_move_from_register_opcode)
    encoder.byte(84)
    encoder.byte(36)
    encoder.byte(56)
    emit_the_writing_tail()
    state.number_writer = encoder.position()
    var routine = [
        72
        _arithmetic_with_small_immediate_opcode
        _subtract_from_rsp_operand
        _writer_frame_size
        72
        _move_from_register_opcode
        _move_rcx_into_rax_operands
        76
        opcodes.load_address_opcode
        76
        36
        96
        77
        49
        _r11_with_r11_operands
        72
        _test_opcode
        _rdx_with_rdx_operands
        _jump_short_if_equal_opcode
        14
        72
        _test_opcode
        _rax_with_rax_operands
        _jump_short_if_not_sign_opcode
        9
        72
        _unary_group_opcode
        _negate_rax_operand
        65
        _move_into_r11d_opcode
        1
        0
        0
        0
        72
        _move_immediate_opcode
        _move_into_rcx_operand
        10
        0
        0
        0
        49
        _rdx_with_rdx_operands
        72
        _unary_group_opcode
        _unsigned_divide_by_rcx_operand
        128
        _add_to_dl_operand
        48
        73
        _group_five_opcode
        _decrement_r9_operand
        65
        _store_byte_opcode
        17
        72
        _test_opcode
        _rax_with_rax_operands
        _jump_short_if_not_equal_opcode
        _back_to_the_next_digit_displacement
        77
        _test_opcode
        _r11_with_r11_operands
        _jump_short_if_equal_opcode
        7
        73
        _group_five_opcode
        _decrement_r9_operand
        65
        _store_immediate_byte_opcode
        1
        45
        76
        opcodes.load_address_opcode
        68
        36
        96
        77
        41
        _subtract_r9_from_r8_operands
        76
        _move_from_register_opcode
        76
        36
        48
        76
        _move_from_register_opcode
        68
        36
        56
    ]
    routine.each(fixups.emit_a_byte)
    emit_the_writing_tail()
    state.stop_routine = encoder.position()
    if state.program.gates_crashes {
        emit_the_gated_stop_start()
    } else {
        encoder.byte(72)
        encoder.byte(_arithmetic_with_small_immediate_opcode)
        encoder.byte(_subtract_from_rsp_operand)
        encoder.byte(40)
    }
    fixups.call_routine(state.text_writer)
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

# ../../OPTIMIZATIONS.md#the-first-crash-stops-every-thread
func emit_the_gated_stop_start() {
    var keeping = [
        72
        _arithmetic_with_small_immediate_opcode
        _subtract_from_rsp_operand
        56
        72
        _move_from_register_opcode
        76
        36
        32
        72
        _move_from_register_opcode
        84
        36
        40
    ]
    keeping.each(fixups.emit_a_byte)
    gate_the_crash()
    var restoring = [
        72
        opcodes.move_into_register_opcode
        76
        36
        32
        72
        opcodes.move_into_register_opcode
        84
        36
        40
    ]
    restoring.each(fixups.emit_a_byte)
}

func gate_the_crash() {
    if state.program.gates_crashes {
        var at = encoder.call_relative()
        var fixup = Generators.X64.Fixup(at, "_crash_gate", 0)
        state.call_fixups.append(fixup)
    }
}

func emit_the_writing_tail() {
    encoder.move_small_immediate(encoder.rcx, -12)
    fixups.call_import("GetStdHandle")
    encoder.move_register(encoder.rcx, encoder.rax)
    var tail = [
        72
        opcodes.move_into_register_opcode
        84
        36
        48
        76
        opcodes.move_into_register_opcode
        68
        36
        56
        76
        opcodes.load_address_opcode
        76
        36
        40
        72
        _move_immediate_opcode
        68
        36
        32
        0
        0
        0
        0
    ]
    tail.each(fixups.emit_a_byte)
    fixups.call_import("WriteFile")
    var leaving = [72, _arithmetic_with_small_immediate_opcode, _add_to_rsp_operand, _writer_frame_size, _return_opcode]
    leaving.each(fixups.emit_a_byte)
}

func write_a_label(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    var bytes = state.program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    fixups.call_routine(state.text_writer)
}

func write_a_number(register: Integer, is_signed: Boolean) {
    var home = state.allocation.home_of(register)
    if state.allocation.is_a_volatile_home(home) {
        encoder.load_virtual(encoder.rcx, register)
    } else {
        frames.read_into(encoder.rcx, register)
    }
    var signed_flag = 0
    if is_signed {
        signed_flag = 1
    }
    encoder.move_small_immediate(encoder.rdx, signed_flag)
    fixups.call_routine(state.number_writer)
}

func stop_with_pieces(texts: List<String>, numbers: List<Integer>, signed_numbers: List<Integer>) {
    keep_the_numbers(numbers)
    gate_the_crash()
    var index = 0
    while index < texts.count() {
        var piece = texts[index]
        var label = label_of_text(piece)
        write_a_label(label)
        if index < numbers.count() {
            var number = numbers[index]
            var sign = signed_numbers[index]
            crash sign
            write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

# ../../OPTIMIZATIONS.md#a-value-leaves-a-scratch-register-only-around-a-call
func keep_the_numbers(numbers: List<Integer>) {
    var index = 0
    while index < numbers.count() {
        var number = numbers[index]
        crash number
        var home = state.allocation.home_of(number)
        if state.allocation.is_a_volatile_home(home) {
            encoder.store_virtual(number, home)
        }
        index = index + 1
    }
}

func label_of_text(text: String): Integer {
    var bytes = text.to_buffer()
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    return label
}

func article_of(name: String): String {
    var first = name.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func emit_function(function: LowIntermediaryRepresentation.LowFunction) {
    state.current_key = function.key
    if state.program.hot_reload {
        encoder.align_to(32)
    } else {
        encoder.align_to(16)
    }
    state.function_offsets[function.key] = encoder.position()
    state.span_keys.append(function.key)
    var span_start = encoder.position()
    state.span_starts.append(span_start)
    state.current_place = function.place
    var start = encoder.position()
    var shown_place = function.place
    if shown_place.is_empty() {
        shown_place = "-\t-\t-"
    }
    note_the_place(start, shown_place)
    if state.program.hot_reload {
        jump_through_the_slot(function.key)
    }
    state.block_fixups = List<Generators.X64.Fixup>()
    state.allocation = Generators.X64.Allocation(function, state.convention)
    state.allocation.allocate()
    if state.program.vector_loops > 0 {
        state.kernels.plan_the_saved(function, state.allocation)
    }
    state.current_block = 0
    var outgoing = state.convention.shadow_space + 8 * most_arguments_of(function)
    state.current_is_resumable = function.is_resumable
    state.current_ends_a_thread = function.ends_a_thread
    state.current_answer_decimal_size = function.answer_decimal_size
    if function.is_resumable {
        state.current_outgoing = (outgoing + 15) / 16 * 16
        state.current_header = 0 - 48 - 8 * function.register_count
        frames.resumable_prologue(0 - state.current_header, state.current_outgoing)
    } else {
        state.frame_slots = state.allocation.register_total
        if state.frame_slots < function.register_count {
            state.frame_slots = function.register_count
        }
        state.decimal_save_base = state.frame_slots
        state.frame_slots = state.frame_slots + 2 * state.allocation.saved_decimals.count()
        state.room_slots = frames.rooms_of(function)
        var frame = 8 * (state.frame_slots + state.allocation.saved.count() + state.room_slots) + outgoing
        var rounded = (frame + 15) / 16 * 16
        encoder.prologue(rounded)
        frames.save_the_kept_registers()
        if function.key == state.program.entry {
            state.kernels.call_the_detection()
        }
        state.allocation.current_block = 0
        frames.take_the_parameters(function)
    }
    state.block_offsets = List<Integer>()
    var block_count = 0
    while block_count < function.blocks.count() {
        state.block_offsets.append(0)
        block_count = block_count + 1
    }
    find_the_loop_heads(function)
    var position = 0
    while position < state.allocation.layout.count() {
        state.current_block = position
        var block_index = state.allocation.layout[position]
        if state.loop_heads[block_index] == true {
            encoder.align_to(32)
        } else if follows_a_rotating_head(function, position, block_index) {
            encoder.align_to(16)
        }
        emit_block(function, block_index)
        position = position + 1
    }
    var cold = encoder.position()
    note_the_place(cold, state.current_place)
    state.current_block = state.allocation.layout.count() + 1
    emit_the_cold_stops()
    edge_moves.emit_the_edge_stubs()
    state.block_fixups.each(fixups.fix_a_block)
    state.function_ends[function.key] = encoder.position()
}

# ../../HOT_RELOAD.md#the-parts
func jump_through_the_slot(key: String) {
    var room = Buffer(0)
    var index = 0
    while index < 8 {
        room.append(0)
        index = index + 1
    }
    state.program.data.append(room)
    var label = state.program.data.count() - 1
    state.program.name_state(label, "slot.{key}")
    state.slot_labels[key] = label
    encoder.byte(_group_five_opcode)
    encoder.byte(37)
    var at = encoder.position()
    encoder.dword(0)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    state.body_offsets[key] = encoder.position()
}

func find_the_loop_heads(function: LowIntermediaryRepresentation.LowFunction) {
    state.loop_heads = List<Boolean>()
    var index = 0
    while index < function.blocks.count() {
        state.loop_heads.append(false)
        index = index + 1
    }
    var position = 0
    while position < state.allocation.layout.count() {
        var block_index = state.allocation.layout[position]
        var block = function.blocks[block_index]
        crash block
        var last = block.instructions.last()
        if last {
            note_a_back_edge(last, position)
        }
        position = position + 1
    }
}

func note_a_back_edge(last: Instruction, position: Integer) {
    if last.class == LowIntermediaryRepresentation.Instructions.Jump {
        note_a_head(last.block, position)
    }
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        note_a_head(last.when_true, position)
        note_a_head(last.when_false, position)
    }
}

func note_a_head(target: Integer, position: Integer) {
    fallback target >= 0 and target < state.allocation.layout_positions.count()
    var target_position = state.allocation.layout_positions[target]
    if target_position >= 0 and target_position <= position {
        state.loop_heads[target] = true
    }
}

func most_arguments_of(function: LowIntermediaryRepresentation.LowFunction): Integer {
    var most = 0
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            var count = argument_count_of(instruction)
            if count > most {
                most = count
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return most
}

func argument_count_of(instruction: Instruction?): Integer {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
        return instruction.arguments.count()
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.CallAt {
        return instruction.arguments.count()
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.ImportCall {
        return instruction.arguments.count()
    }
    return 4
}

func emit_block(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var here = encoder.position()
    state.block_offsets[block_index] = here
    var wanted = block.place
    if wanted.is_empty() {
        wanted = state.current_place
    }
    note_the_place(here, wanted)
    state.current_block_place = wanted
    state.flags_register = -1
    state.current_block_index = block_index
    state.allocation.current_block = block_index
    if state.allocation.moves_at_the_head(block_index) {
        var coming = state.allocation.predecessors[block_index]
        crash coming
        var only = coming[0]
        crash only
        edge_moves.emit_the_moves(only, block_index)
    }
    state.current_instructions = block.instructions
    state.instruction_position = 0
    state.skips_the_next = false
    block.instructions.each(emit_instruction)
    var last = block.instructions.last()
    var ends = false
    if last {
        ends = state.allocation.ends_the_block(last)
    }
    var following = block_index + 1
    if not ends and following < function.blocks.count() {
        edge_moves.go_to_block(following)
    }
}

func emit_instruction(instruction: Instruction) {
    var position = state.instruction_position
    state.instruction_position = position + 1
    if state.skips_the_next {
        state.skips_the_next = false
        state.flags_register = -1
        return
    }
    var compares = instruction.class == LowIntermediaryRepresentation.Instructions.Compare
    var keeps_flags = keeps_the_flags(instruction)
    emit_an_instruction(instruction)
    if not compares and not keeps_flags {
        state.flags_register = -1
    }
}

func keeps_the_flags(instruction: Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        return not state.allocation.constant_of(instruction.source) and instruction.target != state.flags_register
    }
    return false
}

func emit_an_instruction(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: emit_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: emit_copy(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: emit_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: emit_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: emit_decimal_arithmetic(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: emit_a_decimal_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: emit_decimal_conversion(instruction)
        LowIntermediaryRepresentation.Instructions.Load: emit_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: emit_store(instruction)
        LowIntermediaryRepresentation.Instructions.Call: emit_call(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: emit_call_at(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: emit_foreign_address(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: emit_data_address(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: emit_function_address(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: emit_allocate(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: emit_retain(instruction)
        LowIntermediaryRepresentation.Instructions.Free: emit_free(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: emit_resize(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: emit_copy_bytes(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: emit_open_library(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: emit_jump(instruction)
        LowIntermediaryRepresentation.Instructions.Branch: emit_branch(instruction)
        LowIntermediaryRepresentation.Instructions.Return: emit_return(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: emit_frame_address(instruction)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: emit_thread_identity(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: emit_frame_room(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: emit_start_thread(instruction)
        LowIntermediaryRepresentation.Instructions.JoinThread: emit_join_thread(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: emit_atomic_add(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: emit_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: emit_compare_exchange(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: emit_stop(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: emit_exit(instruction)
        LowIntermediaryRepresentation.Instructions.VectorLoop: state.kernels.emit(instruction, state.allocation)
        LowIntermediaryRepresentation.Instructions.Select: emit_select(instruction)
    }
}

# ../../OPTIMIZATIONS.md#an-if-that-only-adds-or-picks-a-value-has-no-branch
func emit_select(selecting: LowIntermediaryRepresentation.Instructions.Select) {
    var condition = frames.register_of(selecting.condition, encoder.rcx)
    var chosen = frames.register_of(selecting.when_true, encoder.rdx)
    frames.read_into(encoder.rax, selecting.when_false)
    encoder.test_register(condition)
    encoder.move_if_not_zero(encoder.rax, chosen)
    frames.write_from(selecting.target, encoder.rax)
}

func emit_constant(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    fallback not state.allocation.constant_of(constant.target)
    var decimal = state.allocation.decimal_home_of(constant.target)
    if decimal >= 0 {
        var size = state.allocation.decimal_size_of(constant.target)
        load_a_decimal_constant(decimal, constant.number, size == 8)
        return
    }
    var home = state.allocation.home_of(constant.target)
    if home >= 0 {
        encoder.move_small_immediate(home, constant.number)
        return
    }
    if encoder.fits_in_32_bits(constant.number) {
        var displacement = encoder.slot_of(constant.target)
        encoder.store_slot_immediate(displacement, constant.number)
        return
    }
    encoder.move_small_immediate(encoder.rax, constant.number)
    frames.write_from(constant.target, encoder.rax)
}

func emit_copy(copy: LowIntermediaryRepresentation.Instructions.Copy) {
    var target_decimal = state.allocation.decimal_home_of(copy.target)
    var source_decimal = state.allocation.decimal_home_of(copy.source)
    if target_decimal >= 0 and source_decimal >= 0 {
        if target_decimal != source_decimal {
            encoder.move_xmm(target_decimal, source_decimal)
        }
        return
    }
    var home = state.allocation.home_of(copy.target)
    if home >= 0 {
        frames.read_into(home, copy.source)
        return
    }
    var source = frames.register_of(copy.source, encoder.rax)
    frames.write_from(copy.target, source)
}

func emit_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    fallback not state.allocation.is_elided_target(arithmetic.target)
    var divides = arithmetic.operator == 'divide' or arithmetic.operator == 'remainder'
    if divides {
        emit_division(arithmetic)
        return
    }
    fallback not emitted_in_place(arithmetic)
    fallback not emitted_narrow(arithmetic)
    var shifts = arithmetic.operator == 'shift_left' or arithmetic.operator == 'shift_right'
    var needs_rcx = shifts or arithmetic.operator == 'multiply' and is_wide_unsigned(arithmetic)
    var immediate = takes_an_immediate(arithmetic)
    var source = encoder.rcx
    if not immediate and needs_rcx {
        frames.read_into(encoder.rcx, arithmetic.right)
    }
    if not immediate and not needs_rcx {
        source = frames.register_of(arithmetic.right, encoder.rcx)
    }
    frames.read_into(encoder.rax, arithmetic.left)
    if immediate {
        emit_with_an_immediate(arithmetic, encoder.rax)
    } else {
        emit_registers(arithmetic, encoder.rax, source)
    }
    emit_checked(arithmetic)
    frames.write_from(arithmetic.target, encoder.rax)
}

func emitted_narrow(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    fallback arithmetic.is_checked and arithmetic.width == 'bits_32'
    var adds = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    var multiplies = arithmetic.operator == 'multiply' and arithmetic.is_signed
    fallback adds or multiplies
    var immediate = frames.small_constant(arithmetic.right)
    var source = encoder.rcx
    if not immediate {
        source = frames.register_of(arithmetic.right, encoder.rcx)
    }
    var home = state.allocation.home_of(arithmetic.target)
    var working = narrow_working_register(arithmetic, home, source, immediate)
    var kind = 0
    var overwrites_left = state.allocation.home_of(arithmetic.left) == working
    if working != encoder.rax and overwrites_left and not state.allocation.constant_of(arithmetic.left) {
        kind = 3
    }
    frames.read_into(working, arithmetic.left)
    if immediate {
        var value = state.allocation.value_of(arithmetic.right)
        emit_narrow_with_an_immediate(arithmetic, working, value)
    } else {
        emit_narrow_registers(arithmetic, working, source)
    }
    var condition = _jump_if_carry_code
    if arithmetic.is_signed {
        condition = 128
    }
    defer_a_stop(condition, arithmetic, kind, working, source, immediate)
    if arithmetic.is_signed {
        encoder.sign_extend_double_word(working, working)
    }
    if working != encoder.rax {
        return true
    }
    if home >= 0 {
        encoder.move_register(home, encoder.rax)
    } else {
        frames.write_from(arithmetic.target, encoder.rax)
    }
    return true
}

func emit_narrow_with_an_immediate(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    working: Integer,
    value: Long,
) {
    switch arithmetic.operator {
        'add': encoder.operation_immediate_narrow(0, working, value)
        'subtract': encoder.operation_immediate_narrow(5, working, value)
        'multiply': encoder.multiply_immediate_narrow(working, working, value)
        'divide': encoder.multiply_immediate_narrow(working, working, value)
        'remainder': encoder.multiply_immediate_narrow(working, working, value)
        'bits_and': encoder.multiply_immediate_narrow(working, working, value)
        'bits_or': encoder.multiply_immediate_narrow(working, working, value)
        'bits_xor': encoder.multiply_immediate_narrow(working, working, value)
        'shift_left': encoder.multiply_immediate_narrow(working, working, value)
        'shift_right': encoder.multiply_immediate_narrow(working, working, value)
        'square_root': encoder.multiply_immediate_narrow(working, working, value)
    }
}

func emit_narrow_registers(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    working: Integer,
    source: Integer,
) {
    switch arithmetic.operator {
        'add': encoder.register_operation_narrow(1, working, source)
        'subtract': encoder.register_operation_narrow(41, working, source)
        'multiply': encoder.multiply_registers_narrow(working, source)
        'divide': encoder.multiply_registers_narrow(working, source)
        'remainder': encoder.multiply_registers_narrow(working, source)
        'bits_and': encoder.multiply_registers_narrow(working, source)
        'bits_or': encoder.multiply_registers_narrow(working, source)
        'bits_xor': encoder.multiply_registers_narrow(working, source)
        'shift_left': encoder.multiply_registers_narrow(working, source)
        'shift_right': encoder.multiply_registers_narrow(working, source)
        'square_root': encoder.multiply_registers_narrow(working, source)
    }
}

func undo_narrow_by(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, target: Integer, value: Long) {
    if arithmetic.operator == 'add' {
        encoder.operation_immediate_narrow(5, target, value)
    } else {
        encoder.operation_immediate_narrow(0, target, value)
    }
}

func undo_narrow_in_place(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if immediate {
        var value = state.allocation.value_of(arithmetic.right)
        undo_narrow_by(arithmetic, target, value)
    } else if arithmetic.operator == 'add' {
        encoder.register_operation_narrow(41, target, source)
    } else {
        encoder.register_operation_narrow(1, target, source)
    }
    if arithmetic.is_signed {
        encoder.sign_extend_double_word(target, target)
    }
}

# ../../OPTIMIZATIONS.md#a-checked-32-bit-sum-works-in-its-targets-register
func narrow_working_register(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    home: Integer,
    source: Integer,
    immediate: Boolean,
): Integer {
    if home < 0 or not immediate and source == home {
        return encoder.rax
    }
    var left_home = state.allocation.home_of(arithmetic.left)
    if state.allocation.constant_of(arithmetic.left) {
        left_home = -1
    }
    var invertible = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    if left_home == home and not invertible {
        return encoder.rax
    }
    return home
}

func is_wide_unsigned(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    return arithmetic.width == 'bits_64' and not arithmetic.is_signed and arithmetic.is_checked
}

func takes_an_immediate(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    fallback frames.small_constant(arithmetic.right)
    switch arithmetic.operator {
        'add': return true
        'subtract': return true
        'bits_and': return true
        'bits_or': return true
        'bits_xor': return true
        'multiply': return not is_wide_unsigned(arithmetic)
        'shift_left': return not arithmetic.is_checked
        'shift_right': return not arithmetic.is_checked
        'divide': return false
        'remainder': return false
        'square_root': return false
    }
}

func emit_with_an_immediate(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, register: Integer) {
    var value = state.allocation.value_of(arithmetic.right)
    switch arithmetic.operator {
        'add': encoder.operation_immediate(0, register, value)
        'subtract': encoder.operation_immediate(5, register, value)
        'bits_and': encoder.operation_immediate(4, register, value)
        'bits_or': encoder.operation_immediate(1, register, value)
        'bits_xor': encoder.operation_immediate(6, register, value)
        'multiply': emit_multiply_by(arithmetic, register, value)
        'shift_left': emit_shift_by(4, register, value)
        'divide': emit_shift_right_by(arithmetic, register, value)
        'remainder': emit_shift_right_by(arithmetic, register, value)
        'shift_right': emit_shift_right_by(arithmetic, register, value)
        'square_root': emit_shift_right_by(arithmetic, register, value)
    }
}

func emit_registers(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
) {
    switch arithmetic.operator {
        'add': encoder.register_operation(1, target, source)
        'subtract': encoder.register_operation(41, target, source)
        'bits_and': encoder.register_operation(33, target, source)
        'bits_or': encoder.register_operation(9, target, source)
        'bits_xor': encoder.register_operation(49, target, source)
        'multiply': emit_multiply_registers(arithmetic, target, source)
        'shift_left': emit_shift_left_by_cl(target)
        'divide': emit_shift_right_by_cl(arithmetic, target)
        'remainder': emit_shift_right_by_cl(arithmetic, target)
        'shift_right': emit_shift_right_by_cl(arithmetic, target)
        'square_root': emit_shift_right_by_cl(arithmetic, target)
    }
}

func emit_multiply_registers(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
) {
    if is_wide_unsigned(arithmetic) {
        crash target == encoder.rax and source == encoder.rcx
        encoder.multiply_unsigned_by_rcx()
        return
    }
    encoder.multiply_registers(target, source)
}

func emit_shift_left_by_cl(target: Integer) {
    crash target == encoder.rax
    encoder.shift_rax_left_by_cl()
}

func emit_shift_right_by_cl(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, target: Integer) {
    crash target == encoder.rax
    emit_shift_right(arithmetic.is_signed)
}

func emit_multiply_by(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    register: Integer,
    value: Long,
) {
    var shift = power_of_two(value)
    if not arithmetic.is_checked and shift > 0 {
        encoder.shift_immediate(4, register, shift)
        return
    }
    encoder.multiply_immediate(register, register, value)
}

func emit_shift_by(extension: Integer, register: Integer, value: Long) {
    var masked = value.bits_and(63)
    var count: Integer = masked
    encoder.shift_immediate(extension, register, count)
}

func emit_shift_right_by(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    register: Integer,
    value: Long,
) {
    if arithmetic.is_signed {
        emit_shift_by(7, register, value)
    } else {
        emit_shift_by(5, register, value)
    }
}

func power_of_two(value: Long): Integer {
    var shift = 1
    var power: Long = 2
    while shift <= 30 {
        if power == value {
            return shift
        }
        power = power * 2
        shift = shift + 1
    }
    return 0
}

func emitted_in_place(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    var target = state.allocation.home_of(arithmetic.target)
    var wide_enough = arithmetic.width == 'bits_64' or keeps_its_width(arithmetic)
    fallback target >= 0 and wide_enough
    var immediate = takes_an_immediate(arithmetic)
    var registered = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    registered = registered or arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    registered = registered or arithmetic.operator == 'bits_xor'
    var multiplies = arithmetic.operator == 'multiply' and not is_wide_unsigned(arithmetic)
    registered = registered or multiplies
    fallback immediate or registered
    var left_home = state.allocation.home_of(arithmetic.left)
    if state.allocation.constant_of(arithmetic.left) {
        left_home = -1
    }
    var right_home = state.allocation.home_of(arithmetic.right)
    if state.allocation.constant_of(arithmetic.right) {
        right_home = -1
    }
    fallback immediate or right_home != target
    var overwrites_left = left_home == target
    var invertible = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    fallback not arithmetic.is_checked or not overwrites_left or invertible
    var source = encoder.rcx
    if not immediate {
        source = frames.register_of(arithmetic.right, encoder.rcx)
    }
    frames.read_into(target, arithmetic.left)
    if immediate {
        emit_with_an_immediate(arithmetic, target)
    } else {
        emit_registers(arithmetic, target, source)
    }
    if not arithmetic.is_checked {
        return true
    }
    var condition = 128
    if is_wide_unsigned(arithmetic) {
        condition = _jump_if_carry_code
    }
    var kind = 0
    if overwrites_left {
        kind = 1
    }
    defer_a_stop(condition, arithmetic, kind, target, source, immediate)
    return true
}

# ../../OPTIMIZATIONS.md#an-unchecked-32-bit-sum-is-one-instruction
func keeps_its_width(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    fallback not arithmetic.is_checked and arithmetic.width == 'bits_32'
    var bitwise = arithmetic.operator == 'bits_and' or arithmetic.operator == 'bits_or'
    bitwise = bitwise or arithmetic.operator == 'bits_xor'
    var sums = arithmetic.operator == 'add' or arithmetic.operator == 'subtract'
    return bitwise and arithmetic.is_signed or sums and not arithmetic.wraps
}

func undo_in_place(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if immediate {
        var value = state.allocation.value_of(arithmetic.right)
        if arithmetic.operator == 'add' {
            encoder.operation_immediate(5, target, value)
        } else {
            encoder.operation_immediate(0, target, value)
        }
        return
    }
    if arithmetic.operator == 'add' {
        encoder.register_operation(41, target, source)
    } else {
        encoder.register_operation(1, target, source)
    }
}

func emit_checked(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var wide_unsigned = is_wide_unsigned(arithmetic)
    if not arithmetic.is_checked {
        wrap_to_the_width(arithmetic)
        return
    }
    if wide_unsigned {
        var carry = _jump_if_carry_code
        defer_a_stop(carry, arithmetic, 0, 0, 0, false)
        return
    }
    if arithmetic.width == 'bits_64' {
        var overflow = 128
        defer_a_stop(overflow, arithmetic, 0, 0, 0, false)
        return
    }
    encoder.fits_back(arithmetic.width, arithmetic.is_signed)
    encoder.compare_rdx_rax()
    var not_equal = _jump_if_not_equal_code
    defer_a_stop(not_equal, arithmetic, 0, 0, 0, false)
}

func defer_a_stop(
    condition: Integer,
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    var at = encoder.jump_if(condition)
    state.cold_jumps.append(at)
    state.cold_arithmetics.append(arithmetic)
    state.cold_kinds.append(kind)
    state.cold_targets.append(target)
    state.cold_sources.append(source)
    state.cold_immediates.append(immediate)
    state.cold_blocks.append(state.current_block_index)
}

func emit_the_cold_stops() {
    var index = 0
    while index < state.cold_jumps.count() {
        var at = state.cold_jumps[index]
        var arithmetic = state.cold_arithmetics[index]
        var kind = state.cold_kinds[index]
        var target = state.cold_targets[index]
        var source = state.cold_sources[index]
        var immediate = state.cold_immediates[index] == true
        var cold_block = state.cold_blocks[index]
        crash cold_block
        state.allocation.current_block = cold_block
        crash arithmetic
        crash kind
        crash target
        crash source
        fixups.patch_here(at)
        emit_a_cold_stop(arithmetic, kind, target, source, immediate)
        index = index + 1
    }
    state.cold_jumps.clear()
    state.cold_arithmetics.clear()
    state.cold_kinds.clear()
    state.cold_targets.clear()
    state.cold_sources.clear()
    state.cold_immediates.clear()
    state.cold_blocks.clear()
}

func emit_a_cold_stop(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    kind: Integer,
    target: Integer,
    source: Integer,
    immediate: Boolean,
) {
    if kind == 2 {
        stop_dividing_by_zero(arithmetic)
        return
    }
    if kind == 1 {
        undo_in_place(arithmetic, target, source, immediate)
    }
    if kind == 3 {
        undo_narrow_in_place(arithmetic, target, source, immediate)
    }
    stop_not_fitting(arithmetic)
}

func stop_not_fitting(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var symbol = symbol_of(arithmetic.operator)
    var article = article_of(arithmetic.type_name)
    var texts = List<String>()
    texts.append("spite: '{arithmetic.shown}' does not fit in {article} {arithmetic.type_name} (")
    texts.append(" {symbol} ")
    var owner = owner_of(arithmetic)
    texts.append("), at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var numbers = List<Integer>()
    numbers.append(arithmetic.left)
    numbers.append(arithmetic.right)
    var sign = 0
    if arithmetic.is_signed {
        sign = 1
    }
    var signs = List<Integer>()
    signs.append(sign)
    signs.append(sign)
    stop_with_pieces(texts, numbers, signs)
}

func owner_of(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    if arithmetic.owner.is_empty() {
        return state.current_key
    }
    return arithmetic.owner
}

func symbol_of(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator): String {
    switch operator {
        'add': return "+"
        'subtract': return "-"
        'multiply': return "*"
        'divide': return "/"
        'remainder': return "%"
        'bits_and': return "%"
        'bits_or': return "%"
        'bits_xor': return "%"
        'shift_left': return "%"
        'shift_right': return "%"
        'square_root': return "%"
    }
}

# ../../OPTIMIZATIONS.md#a-decimal-lives-in-a-decimal-register
func decimal_register_of(virtual: Integer, scratch: Integer, is_double: Boolean): Integer {
    var home = state.allocation.decimal_home_of(virtual)
    if home >= 0 {
        return home
    }
    if state.allocation.constant_of(virtual) {
        var value = state.allocation.value_of(virtual)
        load_a_decimal_constant(scratch, value, is_double)
        return scratch
    }
    var general = state.allocation.home_of(virtual)
    if general >= 0 {
        encoder.xmm_from_register(scratch, general, is_double)
        return scratch
    }
    var displacement = encoder.slot_of(virtual)
    encoder.load_decimal_from(scratch, encoder.rbp, displacement, is_double)
    return scratch
}

# ../../OPTIMIZATIONS.md#a-decimal-constant-is-read-from-the-programs-data
func load_a_decimal_constant(xmm: Integer, bits: Long, is_double: Boolean) {
    if bits == 0 {
        encoder.clear_xmm(xmm)
        return
    }
    var label = decimal_label_of(bits)
    var at = encoder.load_decimal_at_label(xmm, is_double)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
}

func decimal_label_of(bits: Long): Integer {
    var known = state.decimal_labels[bits]
    if known {
        return known
    }
    var bytes = Buffer(0)
    bytes.append_long_little_endian(bits)
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    state.decimal_labels[bits] = label
    return label
}

func decimal_into(xmm: Integer, virtual: Integer, is_double: Boolean) {
    var source = decimal_register_of(virtual, xmm, is_double)
    if source != xmm {
        encoder.move_xmm(xmm, source)
    }
}

func decimal_from(virtual: Integer, xmm: Integer, is_double: Boolean) {
    var home = state.allocation.decimal_home_of(virtual)
    if home >= 0 {
        if home != xmm {
            encoder.move_xmm(home, xmm)
        }
        return
    }
    var general = state.allocation.home_of(virtual)
    if general >= 0 {
        encoder.register_from_xmm(general, xmm, is_double)
        return
    }
    if is_double {
        var displacement = encoder.slot_of(virtual)
        encoder.store_decimal_to(encoder.rbp, displacement, xmm, true)
        return
    }
    encoder.register_from_xmm(encoder.rax, xmm, is_double)
    frames.write_from(virtual, encoder.rax)
}

func decimal_code_of(operator: LowIntermediaryRepresentation.Instructions.Arithmetic.Operator): Integer {
    switch operator {
        'add': return 88
        'subtract': return 92
        'multiply': return 89
        'divide': return 94
        'remainder': return 0
        'bits_and': return 81
        'bits_or': return 81
        'bits_xor': return 81
        'shift_left': return 81
        'shift_right': return 81
        'square_root': return 81
    }
}

func emit_decimal_arithmetic(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    var is_double = arithmetic.is_double
    var code = decimal_code_of(arithmetic.operator)
    if code == 0 {
        decimal_into(0, arithmetic.left, is_double)
        decimal_into(1, arithmetic.right, is_double)
        encoder.decimal_remainder(is_double)
        decimal_from(arithmetic.target, 0, is_double)
        return
    }
    var target = state.allocation.decimal_home_of(arithmetic.target)
    var right_home = state.allocation.decimal_home_of(arithmetic.right)
    var working = 0
    if target >= 0 and target != right_home {
        working = target
    }
    if code != 81 {
        decimal_into(working, arithmetic.left, is_double)
    }
    var source = decimal_register_of(arithmetic.right, 1, is_double)
    encoder.scalar_operation(code, working, source, is_double)
    decimal_from(arithmetic.target, working, is_double)
}

func emit_a_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    if state.allocation.is_fused(compare.target) {
        emit_fused_decimal_compare(compare)
    } else {
        emit_decimal_compare(compare)
    }
}

func emit_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var is_double = compare.is_double
    var left = decimal_register_of(compare.left, 0, is_double)
    var right = decimal_register_of(compare.right, 1, is_double)
    var above = _set_if_above_code
    var above_or_equal = _set_if_above_or_equal_code
    switch compare.comparison {
        'less': emit_decimal_test(right, left, above, is_double)
        'less_or_equal': emit_decimal_test(right, left, above_or_equal, is_double)
        'greater': emit_decimal_test(left, right, above, is_double)
        'greater_or_equal': emit_decimal_test(left, right, above_or_equal, is_double)
        'equal': emit_decimal_equality(true, left, right, is_double)
        'not_equal': emit_decimal_equality(false, left, right, is_double)
    }
    encoder.zero_extend_al_into_rax()
    frames.write_from(compare.target, encoder.rax)
}

func emit_fused_decimal_compare(compare: LowIntermediaryRepresentation.Instructions.Decimal.Compare) {
    var is_double = compare.is_double
    var left = decimal_register_of(compare.left, 0, is_double)
    var right = decimal_register_of(compare.right, 1, is_double)
    var above = _set_if_above_code
    var above_or_equal = _set_if_above_or_equal_code
    var first = left
    var second = right
    var setting = above_or_equal
    if compare.comparison == 'less' or compare.comparison == 'greater' {
        setting = above
    }
    var swapped = compare.comparison == 'less' or compare.comparison == 'less_or_equal'
    if swapped {
        first = right
        second = left
    }
    state.flags_have_parity = false
    var equal = _set_if_equal_code
    var not_equal = _set_if_not_equal_code
    if compare.comparison == 'equal' {
        setting = equal
        state.flags_have_parity = true
        state.flags_unordered_is_true = false
    }
    if compare.comparison == 'not_equal' {
        setting = not_equal
        state.flags_have_parity = true
        state.flags_unordered_is_true = true
    }
    encoder.compare_xmm(first, second, is_double)
    state.flags_condition = setting
    state.flags_register = compare.target
}

func emit_decimal_test(first: Integer, second: Integer, setting: Integer, is_double: Boolean) {
    encoder.compare_xmm(first, second, is_double)
    encoder.set_low_byte(setting, 0)
}

func emit_decimal_equality(is_equal: Boolean, left: Integer, right: Integer, is_double: Boolean) {
    encoder.compare_xmm(left, right, is_double)
    var equal = _set_if_equal_code
    var not_equal = _set_if_not_equal_code
    var parity = _set_if_parity_code
    var no_parity = _set_if_no_parity_code
    if is_equal {
        encoder.set_low_byte(equal, 0)
        encoder.set_low_byte(no_parity, 1)
        encoder.and_al_cl()
    } else {
        encoder.set_low_byte(not_equal, 0)
        encoder.set_low_byte(parity, 1)
        encoder.or_al_cl()
    }
}

func emit_decimal_conversion(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    var from_double = conversion.from_decimal_size == 8
    var to_double = conversion.to_decimal_size == 8
    if conversion.from_decimal_size == 0 {
        frames.read_into(encoder.rax, conversion.source)
        encoder.whole_into_decimal(to_double)
        decimal_from(conversion.target, 0, to_double)
    } else if conversion.to_decimal_size == 0 {
        decimal_into(0, conversion.source, from_double)
        encoder.decimal_into_whole(from_double)
        cut_to_the_width(conversion)
        frames.write_from(conversion.target, encoder.rax)
    } else {
        decimal_into(0, conversion.source, from_double)
        resize_the_decimal(to_double)
        decimal_from(conversion.target, 0, to_double)
    }
}

func cut_to_the_width(conversion: LowIntermediaryRepresentation.Instructions.Decimal.Conversion) {
    fallback conversion.whole_width != 'bits_64'
    encoder.fits_back(conversion.whole_width, conversion.whole_is_signed)
    encoder.move_rdx_into_rax()
}

func resize_the_decimal(to_double: Boolean) {
    if to_double {
        encoder.float_into_double()
    } else {
        encoder.double_into_float()
    }
}

func emit_multiply(wide_unsigned: Boolean) {
    if wide_unsigned {
        encoder.multiply_unsigned_by_rcx()
    } else {
        encoder.multiply_rax_rcx()
    }
}

func emit_shift_right(is_signed: Boolean) {
    if is_signed {
        encoder.shift_rax_right_keeping_the_sign_by_cl()
    } else {
        encoder.shift_rax_right_by_cl()
    }
}

func wrap_to_the_width(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    fallback arithmetic.width != 'bits_64'
    encoder.fits_back(arithmetic.width, arithmetic.is_signed)
    encoder.move_rdx_into_rax()
}

func emit_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    fallback not emitted_as_a_pair(arithmetic)
    frames.read_into(encoder.rax, arithmetic.left)
    if state.allocation.constant_of(arithmetic.right) {
        var divisor = state.allocation.value_of(arithmetic.right)
        if divisor != 0 and divisor != -1 {
            emit_division_by(arithmetic, divisor)
            frames.write_from(arithmetic.target, encoder.rax)
            return
        }
    }
    frames.read_into(encoder.rcx, arithmetic.right)
    if arithmetic.is_checked {
        emit_checked_division(arithmetic)
    } else {
        emit_proven_division(arithmetic)
    }
    frames.write_from(arithmetic.target, encoder.rax)
}

# ../../OPTIMIZATIONS.md#a-division-and-a-remainder-of-the-same-two-numbers-are-one-division
func emitted_as_a_pair(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    fallback state.instruction_position < state.current_instructions.count()
    var following = state.current_instructions[state.instruction_position]
    if following.class == LowIntermediaryRepresentation.Instructions.Arithmetic {
        return emitted_with(arithmetic, following)
    }
    return false
}

func emitted_with(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    fallback pairs_with(arithmetic, following)
    frames.read_into(encoder.rax, arithmetic.left)
    frames.read_into(encoder.rcx, arithmetic.right)
    if arithmetic.is_checked {
        encoder.test_rcx()
        var zero = _jump_if_equal_code
        defer_a_stop(zero, arithmetic, 2, 0, 0, false)
    }
    var dividing = arithmetic
    if arithmetic.operator == 'remainder' {
        dividing = following
    }
    if arithmetic.is_checked and arithmetic.is_signed {
        divide_signed_into_both(dividing)
    } else if arithmetic.is_signed {
        divide_signed_by_rcx_into_both(arithmetic)
    } else {
        divide_unsigned_by_rcx_into_both(arithmetic)
    }
    var quotient = arithmetic.target
    var remainder = following.target
    if arithmetic.operator == 'remainder' {
        quotient = following.target
        remainder = arithmetic.target
    }
    frames.write_from(quotient, encoder.rax)
    frames.write_from(remainder, encoder.rdx)
    state.skips_the_next = true
    return true
}

func pairs_with(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    following: LowIntermediaryRepresentation.Instructions.Arithmetic,
): Boolean {
    var divides = arithmetic.operator == 'divide' and following.operator == 'remainder'
    var takes_the_rest = arithmetic.operator == 'remainder' and following.operator == 'divide'
    fallback divides or takes_the_rest
    var same_numbers = arithmetic.left == following.left and arithmetic.right == following.right
    var same_kind = arithmetic.width == following.width and arithmetic.is_signed == following.is_signed
    fallback same_numbers and same_kind
    var keeps_its_operands = arithmetic.target != arithmetic.left and arithmetic.target != arithmetic.right
    fallback keeps_its_operands and arithmetic.target != following.target
    fallback not state.allocation.is_elided_target(following.target) and not state.allocation.constant_of(arithmetic.right)
    return not state.allocation.constant_of(arithmetic.left)
}

func divide_signed_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var minus_one = [72, _arithmetic_with_small_immediate_opcode, _compare_rcx_operand, _minus_one_byte]
    minus_one.each(fixups.emit_a_byte)
    var not_minus_one = _jump_if_not_equal_code
    var dividing = encoder.jump_if(not_minus_one)
    negate_or_stop(arithmetic)
    encoder.clear_rdx()
    var done = encoder.jump()
    fixups.patch_here(dividing)
    divide_signed_by_rcx_into_both(arithmetic)
    fixups.patch_here(done)
}

func divide_signed_by_rcx_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
        return
    }
    var narrow = [
        _sign_extend_eax_into_edx_opcode
        _unary_group_opcode
        _signed_divide_by_rcx_operand
        72
        99
        _rax_with_rax_operands
        72
        99
        _rdx_with_rdx_operands
    ]
    narrow.each(fixups.emit_a_byte)
}

func divide_unsigned_by_rcx_into_both(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
        return
    }
    var narrow = [
        49
        _rdx_with_rdx_operands
        _unary_group_opcode
        _unsigned_divide_by_rcx_operand
        _move_from_register_opcode
        _rax_with_rax_operands
        _move_from_register_opcode
        _rdx_with_rdx_operands
    ]
    narrow.each(fixups.emit_a_byte)
}

func emit_proven_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.is_signed {
        divide_signed_by_rcx(arithmetic)
    } else {
        divide_unsigned_by_rcx(arithmetic)
    }
}

func divide_signed_by_rcx(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
        if arithmetic.operator == 'remainder' {
            encoder.move_register(encoder.rax, encoder.rdx)
        }
        return
    }
    var narrow = [_sign_extend_eax_into_edx_opcode, _unary_group_opcode, _signed_divide_by_rcx_operand]
    narrow.each(fixups.emit_a_byte)
    var widened = [72, 99, _rax_with_rax_operands]
    if arithmetic.operator == 'remainder' {
        widened = [72, 99, _sign_extend_edx_into_rax_operands]
    }
    widened.each(fixups.emit_a_byte)
}

func divide_unsigned_by_rcx(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    if arithmetic.width != 'bits_32' {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
        if arithmetic.operator == 'remainder' {
            encoder.move_register(encoder.rax, encoder.rdx)
        }
        return
    }
    var narrow = [49, _rdx_with_rdx_operands, _unary_group_opcode, _unsigned_divide_by_rcx_operand]
    narrow.each(fixups.emit_a_byte)
    var widened = [_move_from_register_opcode, _rax_with_rax_operands]
    if arithmetic.operator == 'remainder' {
        widened = [_move_from_register_opcode, _move_edx_into_eax_operands]
    }
    widened.each(fixups.emit_a_byte)
}

func emit_division_by(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var shift = power_of_two(divisor)
    if shift > 0 and arithmetic.is_signed {
        divide_signed_by_a_power(arithmetic, shift, divisor)
        return
    }
    if shift > 0 {
        divide_unsigned_by_a_power(arithmetic, shift, divisor)
        return
    }
    if arithmetic.is_signed and divisor > 2 and divisor < 2147483648 {
        divide_by_multiplying(arithmetic, divisor)
        return
    }
    if arithmetic.is_signed and divisor < -1 and divisor > -2147483648 {
        divide_by_a_negative(arithmetic, divisor)
        return
    }
    var narrow = arithmetic.width != 'bits_64'
    if not arithmetic.is_signed and narrow and divisor > 2 and divisor < 2147483648 {
        divide_unsigned_by_multiplying(arithmetic, divisor)
        return
    }
    if not arithmetic.is_signed and not narrow and divisor > 2 {
        divide_wide_unsigned_by_multiplying(arithmetic, divisor)
        return
    }
    if not arithmetic.is_signed and not narrow and divisor < -1 {
        divide_wide_unsigned_by_a_larger_half(arithmetic, divisor)
        return
    }
    encoder.move_small_immediate(encoder.rcx, divisor)
    if arithmetic.is_signed {
        encoder.sign_extend_rax_into_rdx()
        encoder.divide_signed_by_rcx()
    } else {
        encoder.clear_rdx()
        encoder.divide_unsigned_by_rcx()
    }
    if arithmetic.operator == 'remainder' {
        encoder.move_register(encoder.rax, encoder.rdx)
    }
}

func divide_by_a_negative(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var zero: Long = 0
    var size = zero - divisor
    var shift = power_of_two(size)
    if shift > 0 {
        divide_signed_by_a_power(arithmetic, shift, size)
    } else {
        divide_by_multiplying(arithmetic, size)
    }
    if arithmetic.operator == 'divide' {
        var negated = [72, _unary_group_opcode, _negate_rax_operand]
        negated.each(fixups.emit_a_byte)
    }
}

func divide_unsigned_by_multiplying(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var largest: Long = _largest_long
    var multiplier = largest / divisor + 1
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, multiplier)
    encoder.multiply_unsigned_by_rcx()
    var shifted = [72, 15, _shift_left_double_opcode, _shift_rdx_with_rax_operands, 1]
    shifted.each(fixups.emit_a_byte)
    if arithmetic.operator == 'remainder' {
        encoder.multiply_immediate(encoder.rdx, encoder.rdx, divisor)
        encoder.move_register(encoder.rax, encoder.rcx)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.move_register(encoder.rax, encoder.rdx)
}

# ../../OPTIMIZATIONS.md#dividing-by-a-constant-is-a-multiplication
func divide_wide_unsigned_by_multiplying(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    divisor: Long,
) {
    var magic = Generators.X64.UnsignedMagic(divisor)
    if magic.is_a_power {
        divide_wide_unsigned_by_a_power(arithmetic, divisor, magic.shift)
        return
    }
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, magic.multiplier)
    encoder.multiply_unsigned_by_rcx()
    encoder.move_register(encoder.rax, encoder.rcx)
    encoder.register_operation(41, encoder.rax, encoder.rdx)
    encoder.shift_immediate(5, encoder.rax, 1)
    encoder.register_operation(1, encoder.rax, encoder.rdx)
    encoder.shift_immediate(5, encoder.rax, magic.shift)
    fallback arithmetic.operator == 'remainder'
    encoder.move_small_immediate(encoder.rdx, divisor)
    encoder.multiply_registers(encoder.rax, encoder.rdx)
    encoder.register_operation(41, encoder.rcx, encoder.rax)
    encoder.move_register(encoder.rax, encoder.rcx)
}

func divide_wide_unsigned_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    divisor: Long,
    shift: Integer,
) {
    if arithmetic.operator == 'remainder' {
        encoder.move_small_immediate(encoder.rcx, divisor - 1)
        encoder.register_operation(33, encoder.rax, encoder.rcx)
    } else {
        encoder.shift_immediate(5, encoder.rax, shift)
    }
}

func divide_wide_unsigned_by_a_larger_half(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    divisor: Long,
) {
    encoder.move_small_immediate(encoder.rcx, divisor)
    var at_least = [
        49
        _rdx_with_rdx_operands
        72
        57
        _compare_rax_with_rcx_operands
        15
        _set_if_above_or_equal_code
        _set_dl_operand
    ]
    at_least.each(fixups.emit_a_byte)
    if arithmetic.operator == 'remainder' {
        var taken = [72, _unary_group_opcode, _negate_rdx_operand, 72, 33, _and_rdx_with_rcx_operands]
        taken.each(fixups.emit_a_byte)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
    } else {
        encoder.move_register(encoder.rax, encoder.rdx)
    }
}

func divide_by_multiplying(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, divisor: Long) {
    var magic = Generators.X64.Magic(divisor)
    encoder.move_register(encoder.rcx, encoder.rax)
    encoder.move_small_immediate(encoder.rax, magic.multiplier)
    encoder.multiply_wide_by(encoder.rcx)
    if magic.multiplier < 0 {
        encoder.register_operation(1, encoder.rdx, encoder.rcx)
    }
    if magic.shift > 0 {
        encoder.shift_immediate(7, encoder.rdx, magic.shift)
    }
    encoder.move_register(encoder.rax, encoder.rcx)
    encoder.shift_immediate(5, encoder.rax, 63)
    encoder.register_operation(1, encoder.rdx, encoder.rax)
    if arithmetic.operator == 'remainder' {
        encoder.multiply_immediate(encoder.rdx, encoder.rdx, divisor)
        encoder.move_register(encoder.rax, encoder.rcx)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.move_register(encoder.rax, encoder.rdx)
}

func divide_unsigned_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    shift: Integer,
    divisor: Long,
) {
    if arithmetic.operator == 'remainder' {
        encoder.operation_immediate(4, encoder.rax, divisor - 1)
    } else {
        encoder.shift_immediate(5, encoder.rax, shift)
    }
}

func divide_signed_by_a_power(
    arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic,
    shift: Integer,
    divisor: Long,
) {
    encoder.move_register(encoder.rdx, encoder.rax)
    encoder.shift_immediate(7, encoder.rdx, 63)
    encoder.shift_immediate(5, encoder.rdx, 64 - shift)
    encoder.register_operation(1, encoder.rdx, encoder.rax)
    if arithmetic.operator == 'remainder' {
        var negated: Long = 0
        negated = negated - divisor
        encoder.operation_immediate(4, encoder.rdx, negated)
        encoder.register_operation(41, encoder.rax, encoder.rdx)
        return
    }
    encoder.shift_immediate(7, encoder.rdx, shift)
    encoder.move_register(encoder.rax, encoder.rdx)
}

func stop_dividing_by_zero(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var texts = List<String>()
    var owner = owner_of(arithmetic)
    texts.append("spite: '{arithmetic.shown}' divided by zero, at {arithmetic.path}:{arithmetic.line} in {owner}\n")
    var no_numbers = List<Integer>()
    var no_signs = List<Integer>()
    stop_with_pieces(texts, no_numbers, no_signs)
}

func emit_checked_division(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    encoder.test_rcx()
    var zero = _jump_if_equal_code
    defer_a_stop(zero, arithmetic, 2, 0, 0, false)
    if arithmetic.is_signed {
        divide_signed(arithmetic)
        return
    }
    divide_unsigned_by_rcx(arithmetic)
}

func divide_signed(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var minus_one = [72, _arithmetic_with_small_immediate_opcode, _compare_rcx_operand, _minus_one_byte]
    minus_one.each(fixups.emit_a_byte)
    var not_minus_one = _jump_if_not_equal_code
    var dividing = encoder.jump_if(not_minus_one)
    if arithmetic.operator == 'remainder' {
        var zeroed = [49, _rax_with_rax_operands]
        zeroed.each(fixups.emit_a_byte)
    } else {
        negate_or_stop(arithmetic)
    }
    var done = encoder.jump()
    fixups.patch_here(dividing)
    divide_signed_by_rcx(arithmetic)
    fixups.patch_here(done)
}

func negate_or_stop(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    var negated = [72, _unary_group_opcode, _negate_rax_operand]
    negated.each(fixups.emit_a_byte)
    if arithmetic.width == 'bits_64' {
        var no_overflow = _jump_if_no_overflow_code
        var fits_wide = encoder.jump_if(no_overflow)
        stop_not_fitting(arithmetic)
        fixups.patch_here(fits_wide)
        return
    }
    encoder.fits_back(arithmetic.width, true)
    encoder.compare_rdx_rax()
    var equal = _jump_if_equal_code
    var fits = encoder.jump_if(equal)
    stop_not_fitting(arithmetic)
    fixups.patch_here(fits)
}

func stop_with(text: String, line: Integer) {
    var message = "spite: {text} in {state.current_key} at line {line}\n"
    var bytes = message.to_buffer()
    state.program.data.append(bytes)
    var label = state.program.data.count() - 1
    state.program.constant_labels.append(label)
    load_message(label)
}

func load_message(label: Integer) {
    var at = encoder.load_address_of(encoder.rcx)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    var bytes = state.program.data[label]
    crash bytes
    var length = bytes.count()
    encoder.move_small_immediate(encoder.rdx, length)
    var call_at = encoder.call_relative()
    var stop_fixup = Generators.X64.Fixup(call_at, "", 0)
    state.stop_fixups.append(stop_fixup)
}

func emit_compare(compare: LowIntermediaryRepresentation.Instructions.Compare) {
    var left = frames.register_of(compare.left, encoder.rax)
    if frames.small_constant(compare.right) {
        var value = state.allocation.value_of(compare.right)
        encoder.compare_with(left, value)
    } else {
        var right = frames.register_of(compare.right, encoder.rcx)
        encoder.compare_registers(left, right)
    }
    var condition = condition_code(compare.comparison, compare.is_signed)
    state.flags_condition = condition
    state.flags_register = compare.target
    state.flags_have_parity = false
    fallback not state.allocation.is_fused(compare.target)
    encoder.al_from_condition(condition)
    encoder.zero_extend_al_into_rax()
    frames.write_from(compare.target, encoder.rax)
}

func condition_code(
    comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison,
    is_signed: Boolean,
): Integer {
    if is_signed {
        return signed_code(comparison)
    }
    return unsigned_code(comparison)
}

func signed_code(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison): Integer {
    switch comparison {
        'equal': return _set_if_equal_code
        'not_equal': return _set_if_not_equal_code
        'less': return _set_if_less_code
        'less_or_equal': return _set_if_less_or_equal_code
        'greater': return _set_if_greater_code
        'greater_or_equal': return _set_if_greater_or_equal_code
    }
}

func unsigned_code(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison): Integer {
    switch comparison {
        'equal': return _set_if_equal_code
        'not_equal': return _set_if_not_equal_code
        'less': return _set_if_below_code
        'less_or_equal': return _set_if_below_or_equal_code
        'greater': return _set_if_above_code
        'greater_or_equal': return _set_if_above_or_equal_code
    }
}

func emit_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    var reloaded = state.allocation.is_rematerialised(loaded.target)
    fallback not reloaded or state.allocation.home_of(loaded.target) >= 0
    var label = state.allocation.data_label_of(loaded.address)
    if label >= 0 {
        emit_a_data_load(loaded, label)
        return
    }
    frames.prepare_the_address(loaded.address, loaded.offset)
    if loaded.is_swapped {
        encoder.load_from(encoder.rax, state.addressed_base, state.addressed_displacement, loaded.width, false)
        encoder.stop_indexing()
        encoder.swap_rax(loaded.width, loaded.is_signed)
        frames.write_from(loaded.target, encoder.rax)
        return
    }
    var decimal = state.allocation.decimal_home_of(loaded.target)
    var decimal_size = state.allocation.decimal_size_of(loaded.target)
    var whole = loaded.width == 'bits_64' or decimal_size == 4 and loaded.width == 'bits_32'
    if decimal >= 0 and whole {
        encoder.load_decimal_from(decimal, state.addressed_base, state.addressed_displacement, decimal_size == 8)
        encoder.stop_indexing()
        return
    }
    var home = state.allocation.home_of(loaded.target)
    if home >= 0 {
        encoder.load_from(home, state.addressed_base, state.addressed_displacement, loaded.width, loaded.is_signed)
        encoder.stop_indexing()
        return
    }
    encoder.load_from(encoder.rax, state.addressed_base, state.addressed_displacement, loaded.width, loaded.is_signed)
    encoder.stop_indexing()
    frames.write_from(loaded.target, encoder.rax)
}

# ../../OPTIMIZATIONS.md#a-read-of-the-programs-data-is-one-instruction
func emit_a_data_load(loaded: LowIntermediaryRepresentation.Instructions.Load, label: Integer) {
    var decimal = state.allocation.decimal_home_of(loaded.target)
    if decimal >= 0 {
        var decimal_size = state.allocation.decimal_size_of(loaded.target)
        var decimal_at = encoder.load_decimal_at_label(decimal, decimal_size == 8)
        var decimal_fixup = Generators.X64.Fixup(decimal_at, "", label)
        state.data_fixups.append(decimal_fixup)
        return
    }
    var home = state.allocation.home_of(loaded.target)
    var register = encoder.rax
    if home >= 0 {
        register = home
    }
    var at = encoder.load_at_label(register)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    if home < 0 {
        frames.write_from(loaded.target, encoder.rax)
    }
}

func emit_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    var wide = stored.width == 'bits_64'
    var source = -1
    var immediate = false
    var value: Long = 0
    if state.allocation.constant_of(stored.source) and not stored.is_swapped {
        value = state.allocation.value_of(stored.source)
        immediate = not wide or encoder.fits_in_32_bits(value)
    }
    var decimal = state.allocation.decimal_home_of(stored.source)
    var decimal_size = state.allocation.decimal_size_of(stored.source)
    var whole = stored.width == 'bits_32' or decimal_size == 8 and stored.width == 'bits_64'
    if not immediate and not stored.is_swapped and decimal >= 0 and whole {
        frames.prepare_the_address(stored.address, stored.offset)
        encoder.store_decimal_to(state.addressed_base, state.addressed_displacement, decimal, stored.width == 'bits_64')
        encoder.stop_indexing()
        return
    }
    if not immediate {
        source = frames.register_of(stored.source, encoder.rcx)
    }
    if stored.is_swapped {
        if source != encoder.rcx {
            encoder.move_register(encoder.rcx, source)
        }
        encoder.swap_rcx(stored.width)
        source = encoder.rcx
    }
    frames.prepare_the_address(stored.address, stored.offset)
    if immediate {
        encoder.store_immediate_to(state.addressed_base, state.addressed_displacement, value, stored.width)
    } else {
        encoder.store_to(state.addressed_base, state.addressed_displacement, source, stored.width)
    }
    encoder.stop_indexing()
}

func emit_call(call: LowIntermediaryRepresentation.Instructions.Call) {
    frames.pass_arguments(call.arguments)
    var at = encoder.call_relative()
    var fixup = Generators.X64.Fixup(at, call.function, 0)
    state.call_fixups.append(fixup)
    if state.program.call_table >= 0 {
        note_a_call_site(call.line, call.frames)
    }
    if call.target >= 0 {
        frames.write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        frames.write_from(call.presence, encoder.rdx)
    }
}

func emit_call_at(call: LowIntermediaryRepresentation.Instructions.CallAt) {
    frames.pass_arguments(call.arguments)
    var index = 0
    while index < call.decimal_sizes.count() and index < 4 {
        var size = call.decimal_sizes[index]
        var register = state.parameter_registers[index]
        crash register
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    frames.read_into(encoder.r11, call.address)
    encoder.call_r11()
    if state.program.call_table >= 0 {
        note_a_call_site(call.line, call.frames)
    }
    if call.answers_32_bits {
        encoder.sign_extend_eax_into_rax()
    }
    if call.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(call.answer_decimal_size == 8)
    }
    if call.target >= 0 {
        frames.write_from(call.target, encoder.rax)
    }
    if call.presence >= 0 {
        frames.write_from(call.presence, encoder.rdx)
    }
}

func emit_function_address(address: LowIntermediaryRepresentation.Instructions.FunctionAddress) {
    var at = encoder.load_address_of(encoder.rax)
    var fixup = Generators.X64.Fixup(at, address.function, 0)
    state.call_fixups.append(fixup)
    frames.write_from(address.target, encoder.rax)
}

func emit_foreign_address(found: LowIntermediaryRepresentation.Instructions.ForeignAddress) {
    var slot = state.foreign_names.count()
    state.foreign_names.append(found.name)
    frames.read_into(encoder.rcx, found.library)
    var owner_loaded = encoder.load_from_address(encoder.rax)
    var owner_fixup = Generators.X64.Fixup(owner_loaded, "owner", slot)
    state.slot_fixups.append(owner_fixup)
    encoder.compare_rax_rcx()
    var not_equal = _jump_if_not_equal_code
    var not_zero = _jump_if_not_equal_code
    var looked_up = encoder.jump_if(not_equal)
    var loaded = encoder.load_from_address(encoder.rax)
    var loaded_fixup = Generators.X64.Fixup(loaded, "", slot)
    state.slot_fixups.append(loaded_fixup)
    var known = encoder.jump()
    fixups.patch_here(looked_up)
    var name_at = encoder.load_address_of(encoder.rdx)
    var name_fixup = Generators.X64.Fixup(name_at, "name", slot)
    state.slot_fixups.append(name_fixup)
    fixups.call_import("GetProcAddress")
    encoder.test_rax()
    var found_it = encoder.jump_if(not_zero)
    stop_with("the foreign function '{found.name}' is not in its library", 1)
    fixups.patch_here(found_it)
    keep_the_first_owner(found, slot)
    fixups.patch_here(known)
    frames.write_from(found.target, encoder.rax)
}

func keep_the_first_owner(found: LowIntermediaryRepresentation.Instructions.ForeignAddress, slot: Integer) {
    encoder.move_register(encoder.rdx, encoder.rax)
    var claimed_at = encoder.load_address_of(encoder.r11)
    var claimed_fixup = Generators.X64.Fixup(claimed_at, "owner", slot)
    state.slot_fixups.append(claimed_fixup)
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.move_small_immediate(encoder.rcx, -1)
    encoder.locked_compare_exchange(0)
    var not_zero = _jump_if_not_equal_code
    var taken = encoder.jump_if(not_zero)
    var stored = encoder.store_at_address(encoder.rdx)
    var stored_fixup = Generators.X64.Fixup(stored, "", slot)
    state.slot_fixups.append(stored_fixup)
    frames.read_into(encoder.rcx, found.library)
    var owned = encoder.store_at_address(encoder.rcx)
    var owned_fixup = Generators.X64.Fixup(owned, "owner", slot)
    state.slot_fixups.append(owned_fixup)
    fixups.patch_here(taken)
    encoder.move_register(encoder.rax, encoder.rdx)
}

func emit_data_address(address: LowIntermediaryRepresentation.Instructions.DataAddress) {
    fallback not state.allocation.is_elided_target(address.target)
    var at = encoder.load_address_of(encoder.rax)
    var fixup = Generators.X64.Fixup(at, "", address.label)
    state.data_fixups.append(fixup)
    frames.write_from(address.target, encoder.rax)
}

func emit_allocate(allocate: LowIntermediaryRepresentation.Instructions.Allocate) {
    var size: Long = -1
    if state.allocation.constant_of(allocate.size) {
        size = state.allocation.value_of(allocate.size)
    }
    if state.small_blocks.inlines_size(size) {
        state.small_blocks.allocate_inline(size)
    } else {
        frames.read_into(encoder.rcx, allocate.size)
        state.small_blocks.call_allocate()
    }
    check_memory()
    if state.program.fills_fresh_memory and (size < 0 or size > allocate.zeroed_bytes) {
        state.small_blocks.fill_the_fresh_bytes(allocate.zeroed_bytes)
    }
    state.small_blocks.name_the_allocation(allocate.class_id)
    frames.write_from(allocate.target, encoder.rax)
}

func emit_retain(retain: LowIntermediaryRepresentation.Instructions.Retain) {
    var object = frames.register_of(retain.object, encoder.rax)
    encoder.test_register(object)
    var zero = _jump_if_equal_code
    var skip = encoder.jump_if(zero)
    if state.program.uses_threads and retain.is_atomic {
        encoder.byte(_lock_prefix)
    }
    encoder.increment_memory(object, 8)
    fixups.patch_here(skip)
}

func emit_free(freed: LowIntermediaryRepresentation.Instructions.Free) {
    frames.read_into(encoder.rcx, freed.pointer)
    state.small_blocks.free_inline()
}

func emit_resize(resize: LowIntermediaryRepresentation.Instructions.Resize) {
    frames.read_into(encoder.rcx, resize.pointer)
    frames.read_into(encoder.rdx, resize.size)
    state.small_blocks.call_resize()
    check_memory()
    frames.write_from(resize.target, encoder.rax)
}

func emit_copy_bytes(copying: LowIntermediaryRepresentation.Instructions.CopyBytes) {
    frames.read_into(encoder.rax, copying.destination)
    frames.read_into(encoder.rdx, copying.source)
    frames.read_into(encoder.rcx, copying.count)
    var source_index = 6
    var destination_index = 7
    encoder.move_register(encoder.r8, source_index)
    encoder.move_register(encoder.r9, destination_index)
    encoder.move_register(destination_index, encoder.rax)
    encoder.move_register(source_index, encoder.rdx)
    if copying.goes_forwards {
        repeat_byte_moves()
        encoder.move_register(source_index, encoder.r8)
        encoder.move_register(destination_index, encoder.r9)
        return
    }
    encoder.move_register(encoder.r11, source_index)
    encoder.register_operation(1, encoder.r11, encoder.rcx)
    encoder.register_operation(57, destination_index, source_index)
    var below_or_equal = _jump_if_below_or_equal_code
    var forward_from_below = encoder.jump_if(below_or_equal)
    encoder.register_operation(57, destination_index, encoder.r11)
    var above_or_equal = _jump_if_above_or_equal_code
    var forward_from_beyond = encoder.jump_if(above_or_equal)
    copy_backward()
    var done = encoder.jump()
    fixups.patch_here(forward_from_below)
    fixups.patch_here(forward_from_beyond)
    repeat_byte_moves()
    fixups.patch_here(done)
    encoder.move_register(source_index, encoder.r8)
    encoder.move_register(destination_index, encoder.r9)
}

func copy_backward() {
    encoder.byte(72)
    encoder.byte(opcodes.load_address_opcode)
    encoder.byte(_rsi_from_indexed_address_operand)
    encoder.byte(14)
    encoder.byte(_minus_one_byte)
    encoder.byte(72)
    encoder.byte(opcodes.load_address_opcode)
    encoder.byte(_rdi_from_indexed_address_operand)
    encoder.byte(15)
    encoder.byte(_minus_one_byte)
    encoder.byte(_set_direction_opcode)
    repeat_byte_moves()
    encoder.byte(_clear_direction_opcode)
}

func repeat_byte_moves() {
    encoder.byte(_repeat_prefix)
    encoder.byte(_move_string_byte_opcode)
}

func check_memory() {
    encoder.test_rax()
    var not_zero = _jump_if_not_equal_code
    var allocated = encoder.jump_if(not_zero)
    stop_with("the program ran out of memory", 1)
    fixups.patch_here(allocated)
}

func emit_open_library(open: LowIntermediaryRepresentation.Instructions.OpenLibrary) {
    frames.read_into(encoder.rcx, open.name)
    fixups.call_import("LoadLibraryA")
    encoder.test_rax()
    var not_zero = _jump_if_not_equal_code
    var opened = encoder.jump_if(not_zero)
    stop_naming_the_library(open.name)
    fixups.patch_here(opened)
    frames.write_from(open.target, encoder.rax)
}

func stop_naming_the_library(name: Integer) {
    gate_the_crash()
    var before = label_of_text("spite: the library '")
    write_a_label(before)
    frames.read_into(encoder.rcx, name)
    fixups.call_import("lstrlenA")
    encoder.move_register(encoder.rdx, encoder.rax)
    frames.read_into(encoder.rcx, name)
    fixups.call_routine(state.text_writer)
    var after = label_of_text(
        "' could not be opened, in {state.current_key}: it is not there, or it is not a library this program can load\n",
    )
    write_a_label(after)
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

func emit_jump(jump: LowIntermediaryRepresentation.Instructions.Jump) {
    if rotates_into(jump.block) {
        emit_the_test_of(jump.block)
    } else {
        edge_moves.go_to_block(jump.block)
    }
}

# ../../OPTIMIZATIONS.md#a-loop-tests-its-condition-at-the-bottom
func rotates_into(head: Integer): Boolean {
    var head_position = state.allocation.layout_positions[head]
    crash head_position
    fallback head_position >= 0 and head_position <= state.current_block
    fallback state.loop_heads[head] == true and not edge_moves.moves_at_the_tail(head) and not state.allocation.moves_at_the_head(head)
    var block = state.allocation.function.blocks[head]
    crash block
    var count = block.instructions.count()
    fallback count >= 1 and count <= 4
    var last = block.instructions.last()
    crash last
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        return tests_and_leaves(head, last, block)
    }
    return false
}

func tests_and_leaves(
    head: Integer,
    branch: LowIntermediaryRepresentation.Instructions.Branch,
    block: LowIntermediaryRepresentation.LowBlock,
): Boolean {
    fallback branch.when_true != head and branch.when_false != head
    var true_moves = state.allocation.moves_on_the_edge(head, branch.when_true)
    var false_moves = state.allocation.moves_on_the_edge(head, branch.when_false)
    fallback not true_moves and not false_moves
    var index = 0
    while index + 1 < block.instructions.count() {
        var instruction = block.instructions[index]
        fallback repeats_freely(instruction)
        index = index + 1
    }
    return true
}

# ../../OPTIMIZATIONS.md#a-loop-tests-its-condition-at-the-bottom
func follows_a_rotating_head(
    function: LowIntermediaryRepresentation.LowFunction,
    position: Integer,
    block_index: Integer,
): Boolean {
    fallback position >= 1
    var previous = state.allocation.layout[position - 1]
    crash previous
    fallback state.loop_heads[previous] == true
    var head = function.blocks[previous]
    crash head
    var count = head.instructions.count()
    fallback count >= 1 and count <= 4
    var last = head.instructions.last()
    crash last
    if last.class == LowIntermediaryRepresentation.Instructions.Branch {
        var enters = last.when_true == block_index or last.when_false == block_index
        return enters and tests_freely(head)
    }
    return false
}

func tests_freely(head: LowIntermediaryRepresentation.LowBlock): Boolean {
    var index = 0
    while index + 1 < head.instructions.count() {
        var instruction = head.instructions[index]
        fallback repeats_freely(instruction)
        index = index + 1
    }
    return true
}

func repeats_freely(instruction: Instruction): Boolean {
    var compares = instruction.class == LowIntermediaryRepresentation.Instructions.Compare
    var decimal_compares = instruction.class == LowIntermediaryRepresentation.Instructions.Decimal.Compare
    var loads = instruction.class == LowIntermediaryRepresentation.Instructions.Load
    var copies = instruction.class == LowIntermediaryRepresentation.Instructions.Copy
    return compares or decimal_compares or loads or copies
}

func emit_the_test_of(head: Integer) {
    var block = state.allocation.function.blocks[head]
    crash block
    var latch = state.current_block_index
    var kept_instructions = state.current_instructions
    var kept_position = state.instruction_position
    state.current_block_index = head
    state.allocation.current_block = head
    state.flags_register = -1
    state.current_instructions = block.instructions
    state.instruction_position = 0
    block.instructions.each(emit_instruction)
    state.current_instructions = kept_instructions
    state.instruction_position = kept_position
    state.current_block_index = latch
    state.allocation.current_block = latch
    state.flags_register = -1
}

func jump_when_unordered(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    var parity = _jump_if_parity_code
    if state.flags_unordered_is_true {
        edge_moves.jump_to_block_if_through_moves(parity, branch.when_true)
    } else {
        edge_moves.jump_to_block_if_through_moves(parity, branch.when_false)
    }
}

func emit_branch(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    if state.allocation.constant_of(branch.condition) {
        var value = state.allocation.value_of(branch.condition)
        if value != 0 {
            edge_moves.go_to_block(branch.when_true)
        } else {
            edge_moves.go_to_block(branch.when_false)
        }
        return
    }
    var condition = _jump_if_not_equal_code
    var flagged = branch.condition == state.flags_register
    if state.allocation.is_fused(branch.condition) or flagged {
        condition = state.flags_condition - 16
    } else {
        var tested = frames.register_of(branch.condition, encoder.rax)
        encoder.test_register(tested)
    }
    if branch.when_true == branch.when_false {
        edge_moves.go_to_block(branch.when_true)
        return
    }
    var on_the_flags = state.allocation.is_fused(branch.condition) or flagged
    if state.flags_have_parity and on_the_flags {
        jump_when_unordered(branch)
    }
    var true_moves = edge_moves.moves_at_the_tail(branch.when_true)
    var false_moves = edge_moves.moves_at_the_tail(branch.when_false)
    var stays_on_true = edge_moves.falls_into(branch.when_true)
    if true_moves and not false_moves {
        stays_on_true = true
    } else if false_moves and not true_moves {
        stays_on_true = false
    }
    if stays_on_true {
        var opposite = edge_moves.inverted(condition)
        edge_moves.jump_to_block_if_through_moves(opposite, branch.when_false)
        edge_moves.go_to_block(branch.when_true)
        return
    }
    edge_moves.jump_to_block_if_through_moves(condition, branch.when_true)
    edge_moves.go_to_block(branch.when_false)
}

func emit_return(returned: LowIntermediaryRepresentation.Instructions.Return) {
    if state.current_ends_a_thread {
        state.small_blocks.call_release()
    }
    if returned.source >= 0 {
        frames.read_into(encoder.rax, returned.source)
    }
    if returned.presence >= 0 {
        frames.read_into(encoder.rdx, returned.presence)
    }
    if state.current_answer_decimal_size > 0 and returned.source >= 0 {
        encoder.decimal_register_from(0, encoder.rax, state.current_answer_decimal_size == 8)
    }
    if not state.current_is_resumable {
        frames.restore_the_kept_registers()
        encoder.epilogue()
        return
    }
    if returned.is_a_suspension {
        encoder.move_small_immediate(encoder.rax, 0)
        encoder.resumable_epilogue(state.current_outgoing)
        return
    }
    encoder.store_slot(state.current_header + 16, encoder.rax)
    encoder.store_slot(state.current_header + 24, encoder.rdx)
    encoder.move_small_immediate(encoder.rax, 1)
    encoder.store_slot(state.current_header + 8, encoder.rax)
    encoder.resumable_epilogue(state.current_outgoing)
}

func emit_start_thread(starting: LowIntermediaryRepresentation.Instructions.StartThread) {
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.store_outgoing(4)
    encoder.store_outgoing(5)
    encoder.move_small_immediate(encoder.rcx, 0)
    encoder.move_small_immediate(encoder.rdx, 0)
    var at = encoder.load_address_of(encoder.r8)
    var fixup = Generators.X64.Fixup(at, starting.entry, 0)
    state.call_fixups.append(fixup)
    frames.read_into(encoder.r9, starting.block)
    fixups.call_import("CreateThread")
    frames.write_from(starting.target, encoder.rax)
}

func emit_compare_exchange(exchanging: LowIntermediaryRepresentation.Instructions.CompareExchange) {
    frames.read_into(encoder.r11, exchanging.address)
    frames.read_into(encoder.rax, exchanging.expected)
    frames.read_into(encoder.rcx, exchanging.desired)
    if exchanging.width == 'bits_32' {
        encoder.locked_compare_exchange_double_word(exchanging.offset)
        widen_the_exchanged(exchanging.is_signed)
    } else {
        encoder.locked_compare_exchange(exchanging.offset)
    }
    frames.write_from(exchanging.target, encoder.rax)
}

func widen_the_exchanged(is_signed: Boolean) {
    if is_signed {
        encoder.sign_extend_eax_into_rax()
    } else {
        encoder.zero_extend_eax_into_rax()
    }
}

func emit_import_call(calling: LowIntermediaryRepresentation.Instructions.ImportCall) {
    var stacked = 4
    while stacked < calling.arguments.count() {
        var passed = calling.arguments[stacked]
        frames.read_into(encoder.rax, passed)
        encoder.store_outgoing(stacked)
        stacked = stacked + 1
    }
    var index = 0
    while index < calling.arguments.count() and index < 4 {
        var argument = calling.arguments[index]
        var register = state.parameter_registers[index]
        crash register
        frames.read_into(register, argument)
        var size = decimal_size_at(calling.decimal_sizes, index)
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    if calling.library.is_empty() {
        fixups.call_import(calling.name)
    } else {
        crash calling.library == "ucrtbase.dll"
        fixups.call_library_import(calling.name)
    }
    if calling.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(calling.answer_decimal_size == 8)
    }
    if calling.target >= 0 {
        frames.write_from(calling.target, encoder.rax)
    }
}

func decimal_size_at(sizes: List<Integer>, index: Integer): Integer {
    if index < sizes.count() {
        return sizes[index]
    }
    return 0
}

func emit_join_thread(joining: LowIntermediaryRepresentation.Instructions.JoinThread) {
    frames.read_into(encoder.rcx, joining.thread)
    encoder.move_small_immediate(encoder.rdx, _wait_forever)
    fixups.call_import("WaitForSingleObject")
    frames.read_into(encoder.rcx, joining.thread)
    fixups.call_import("CloseHandle")
}

func emit_atomic_add(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    frames.read_into(encoder.rax, adding.address)
    encoder.move_small_immediate(encoder.rcx, adding.amount)
    encoder.locked_exchange_add(adding.offset)
    encoder.move_small_immediate(encoder.rax, adding.amount)
    encoder.add_rcx_into_rax()
    frames.write_from(adding.target, encoder.rax)
}

func emit_thread_identity(asked: LowIntermediaryRepresentation.Instructions.ThreadIdentity) {
    frames.thread_identity_into_rax()
    frames.write_from(asked.target, encoder.rax)
}

func emit_frame_address(found: LowIntermediaryRepresentation.Instructions.FrameAddress) {
    var header = 0
    if state.current_is_resumable {
        header = state.current_header
    }
    encoder.slot_address(encoder.rax, header)
    frames.write_from(found.target, encoder.rax)
}

func emit_frame_room(room: LowIntermediaryRepresentation.Instructions.FrameRoom) {
    crash not state.current_is_resumable
    var lowest = state.frame_slots + state.allocation.saved.count() + room.slot
    var displacement = encoder.slot_of(lowest)
    var zeroed = room.size
    if state.program.fills_fresh_memory and room.zeroed_bytes >= 0 {
        zeroed = room.zeroed_bytes
    }
    var written: Integer = 0
    while written < room.size {
        if written < zeroed {
            encoder.store_immediate_to(encoder.rbp, displacement + written, 0, 'bits_64')
        } else {
            fill_a_word(displacement + written)
        }
        written = written + 8
    }
    var home = state.allocation.home_of(room.target)
    if home >= 0 {
        encoder.slot_address(home, displacement)
        return
    }
    encoder.slot_address(encoder.rax, displacement)
    frames.write_from(room.target, encoder.rax)
}

# ../../OPTIMIZATIONS.md#small-blocks-come-from-the-compilers-own-free-lists
func fill_a_word(displacement: Integer) {
    var filled: Long = _filled_word_pattern
    encoder.store_immediate_to(encoder.rbp, displacement, filled, 'bits_32')
    encoder.store_immediate_to(encoder.rbp, displacement + 4, filled, 'bits_32')
}

func emit_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    if stop.numbers.is_empty() and not stop.continues {
        load_message(stop.label)
        return
    }
    keep_the_numbers(stop.numbers)
    if not stop.continues {
        gate_the_crash()
    }
    var index = 0
    while index < stop.labels.count() {
        var label = stop.labels[index]
        write_a_label(label)
        if index < stop.numbers.count() {
            var number = stop.numbers[index]
            var sign = stop.signed_numbers[index]
            crash sign
            write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    fallback not stop.continues
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

func emit_exit(exit: LowIntermediaryRepresentation.Instructions.Exit) {
    frames.read_into(encoder.rcx, exit.code)
    fixups.call_import("ExitProcess")
}

func entry_offset(): Integer {
    var found = state.function_offsets[state.program.entry]
    crash found
    return found
}

func function_map(): String {
    var lines = List<String>()
    lines.append("# spite functions 1")
    var index = 0
    while index < state.span_keys.count() {
        var key = state.span_keys[index]
        var start = state.span_starts[index]
        crash start
        var end = state.code_end
        var following = state.span_starts[index + 1]
        if following {
            end = following
        }
        var start_text = hexadecimal_of(start)
        var end_text = hexadecimal_of(end)
        lines.append("{start_text}\t{end_text}\t{key}")
        index = index + 1
    }
    lines.append("")
    return lines.join("\n")
}

func hexadecimal_of(value: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = value
    var place = 0
    while place < 8 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        crash character
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

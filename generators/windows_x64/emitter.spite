union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var _jump_if_parity_code = 138
var _wait_forever: Long = 4294967295
var _filled_word_pattern: Long = 2779096485
var state = EmitterState()
var encoder = Generators.X64.Encoder()
var allocate_instruction = Generators.WindowsX64.Instructions.Allocate(state)
var arithmetic_instruction = Generators.WindowsX64.Instructions.Arithmetic(state)
var block_analysis = BlockAnalysis(state)
var call_instruction = Generators.WindowsX64.Instructions.Call(state)
var call_at_instruction = Generators.WindowsX64.Instructions.CallAt(state)
var cold_stops = ColdStops(state)
var compare_instruction = Generators.WindowsX64.Instructions.Compare(state)
var constant_instruction = Generators.WindowsX64.Instructions.Constant(state)
var copy_instruction = Generators.WindowsX64.Instructions.Copy(state)
var copy_bytes_instruction = Generators.WindowsX64.Instructions.CopyBytes(state)
var data_address_instruction = Generators.WindowsX64.Instructions.DataAddress(state)
var decimal_arithmetic_instruction = Generators.WindowsX64.Instructions.Decimal.Arithmetic(state)
var decimal_compare_instruction = Generators.WindowsX64.Instructions.Decimal.Compare(state)
var decimal_conversion_instruction = Generators.WindowsX64.Instructions.Decimal.Conversion(state)
var edge_moves = EdgeMoves(state)
var fixups = Fixups(state)
var foreign_address_instruction = Generators.WindowsX64.Instructions.ForeignAddress(state)
var frames = Frames(state)
var free_instruction = Generators.WindowsX64.Instructions.Free(state)
var function_address_instruction = Generators.WindowsX64.Instructions.FunctionAddress(state)
var load_instruction = Generators.WindowsX64.Instructions.Load(state)
var opcodes = Opcodes()
var places = Places(state)
var resize_instruction = Generators.WindowsX64.Instructions.Resize(state)
var retain_instruction = Generators.WindowsX64.Instructions.Retain(state)
var runtime_routines = RuntimeRoutines(state)
var select_instruction = Generators.WindowsX64.Instructions.Select(state)
var store_instruction = Generators.WindowsX64.Instructions.Store(state)

func Emitter(starting_program: LowIntermediaryRepresentation.LoweredProgram) {
    encoder = state.encoder
    state.program = starting_program
    state.small_blocks = SmallBlocks(encoder, state.program, state.data_fixups, state.import_fixups)
    state.kernels = Generators.X64.VectorKernels(encoder, state.program, state.data_fixups)
    var windows_convention = Convention()
    state.convention = windows_convention.table()
    state.parameter_registers = state.convention.argument_registers
}

func emitted(): Buffer {
    state.span_keys.append("_stop_and_small_blocks")
    state.span_starts.append(0)
    runtime_routines.emit_the_stop_routine()
    state.small_blocks.emit_the_routines(state.stop_routine)
    if state.program.vector_loops > 0 {
        state.kernels.emit_the_detection()
    }
    state.routines_end = encoder.position()
    state.program.lowered_functions.each(emit_function)
    state.code_end = encoder.position()
    if state.program.place_table >= 0 {
        places.write_the_places()
    }
    if state.program.call_table >= 0 {
        places.write_the_calls()
    }
    state.call_fixups.each(fixups.fix_a_call)
    state.stop_fixups.each(fixups.fix_a_stop)
    return encoder.code
}

func emit_function(function: LowIntermediaryRepresentation.LowFunction) {
    state.current_key = function.key
    if state.program.hot_reload {
        encoder.align_to(32)
    } else {
        encoder.align_to(16)
    }
    state.function_offsets[function.key] = encoder.position()
    state.span_keys.append(function.key)
    var span_start = encoder.position()
    state.span_starts.append(span_start)
    state.current_place = function.place
    var start = encoder.position()
    var shown_place = function.place
    if shown_place.is_empty() {
        shown_place = "-\t-\t-"
    }
    places.note_the_place(start, shown_place)
    if state.program.hot_reload {
        jump_through_the_slot(function.key)
    }
    state.block_fixups = List<Generators.X64.Fixup>()
    state.allocation = Generators.X64.Allocation(function, state.convention)
    state.allocation.allocate()
    if state.program.vector_loops > 0 {
        state.kernels.plan_the_saved(function, state.allocation)
    }
    state.current_block = 0
    var outgoing = state.convention.shadow_space + 8 * block_analysis.most_arguments_of(function)
    state.current_is_resumable = function.is_resumable
    state.current_ends_a_thread = function.ends_a_thread
    state.current_answer_decimal_size = function.answer_decimal_size
    if function.is_resumable {
        state.current_outgoing = (outgoing + 15) / 16 * 16
        state.current_header = 0 - 48 - 8 * function.register_count
        frames.resumable_prologue(0 - state.current_header, state.current_outgoing)
    } else {
        state.frame_slots = state.allocation.register_total
        if state.frame_slots < function.register_count {
            state.frame_slots = function.register_count
        }
        state.decimal_save_base = state.frame_slots
        state.frame_slots = state.frame_slots + 2 * state.allocation.saved_decimals.count()
        state.room_slots = frames.rooms_of(function)
        var frame = 8 * (state.frame_slots + state.allocation.saved.count() + state.room_slots) + outgoing
        var rounded = (frame + 15) / 16 * 16
        encoder.prologue(rounded)
        frames.save_the_kept_registers()
        if function.key == state.program.entry {
            state.kernels.call_the_detection()
        }
        state.allocation.current_block = 0
        frames.take_the_parameters(function)
    }
    state.block_offsets = List<Integer>()
    var block_count = 0
    while block_count < function.blocks.count() {
        state.block_offsets.append(0)
        block_count = block_count + 1
    }
    block_analysis.find_the_loop_heads(function)
    var position = 0
    while position < state.allocation.layout.count() {
        state.current_block = position
        var block_index = state.allocation.layout[position]
        if state.loop_heads[block_index] == true {
            encoder.align_to(32)
        } else if block_analysis.follows_a_rotating_head(function, position, block_index) {
            encoder.align_to(16)
        }
        emit_block(function, block_index)
        position = position + 1
    }
    var cold = encoder.position()
    places.note_the_place(cold, state.current_place)
    state.current_block = state.allocation.layout.count() + 1
    cold_stops.emit_the_cold_stops()
    edge_moves.emit_the_edge_stubs()
    state.block_fixups.each(fixups.fix_a_block)
    state.function_ends[function.key] = encoder.position()
}

# ../../HOT_RELOAD.md#the-parts
func jump_through_the_slot(key: String) {
    var room = Buffer(0)
    var index = 0
    while index < 8 {
        room.append(0)
        index = index + 1
    }
    state.program.data.append(room)
    var label = state.program.data.count() - 1
    state.program.name_state(label, "slot.{key}")
    state.slot_labels[key] = label
    encoder.byte(opcodes.group_five_opcode)
    encoder.byte(37)
    var at = encoder.position()
    encoder.dword(0)
    var fixup = Generators.X64.Fixup(at, "", label)
    state.data_fixups.append(fixup)
    state.body_offsets[key] = encoder.position()
}

func emit_block(function: LowIntermediaryRepresentation.LowFunction, block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var here = encoder.position()
    state.block_offsets[block_index] = here
    var wanted = block.place
    if wanted.is_empty() {
        wanted = state.current_place
    }
    places.note_the_place(here, wanted)
    state.current_block_place = wanted
    state.flags_register = -1
    state.current_block_index = block_index
    state.allocation.current_block = block_index
    if state.allocation.moves_at_the_head(block_index) {
        var coming = state.allocation.predecessors[block_index]
        crash coming
        var only = coming[0]
        crash only
        edge_moves.emit_the_moves(only, block_index)
    }
    state.current_instructions = block.instructions
    state.instruction_position = 0
    state.skips_the_next = false
    block.instructions.each(emit_instruction)
    var last = block.instructions.last()
    var ends = false
    if last {
        ends = state.allocation.ends_the_block(last)
    }
    var following = block_index + 1
    if not ends and following < function.blocks.count() {
        edge_moves.go_to_block(following)
    }
}

func emit_instruction(instruction: Instruction) {
    var position = state.instruction_position
    state.instruction_position = position + 1
    if state.skips_the_next {
        state.skips_the_next = false
        state.flags_register = -1
        return
    }
    var compares = instruction.class == LowIntermediaryRepresentation.Instructions.Compare
    var keeps_flags = keeps_the_flags(instruction)
    emit_an_instruction(instruction)
    if not compares and not keeps_flags {
        state.flags_register = -1
    }
}

func keeps_the_flags(instruction: Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        return not state.allocation.constant_of(instruction.source) and instruction.target != state.flags_register
    }
    return false
}

func emit_an_instruction(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: constant_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: copy_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: arithmetic_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: compare_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: decimal_arithmetic_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: decimal_compare_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: decimal_conversion_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Load: load_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Store: store_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Call: call_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: call_at_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: foreign_address_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.DataAddress: data_address_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: function_address_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Allocate: allocate_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: retain_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Free: free_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.Resize: resize_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.CopyBytes: copy_bytes_instruction.emit(instruction)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: emit_open_library(instruction)
        LowIntermediaryRepresentation.Instructions.Jump: emit_jump(instruction)
        LowIntermediaryRepresentation.Instructions.Branch: emit_branch(instruction)
        LowIntermediaryRepresentation.Instructions.Return: emit_return(instruction)
        LowIntermediaryRepresentation.Instructions.FrameAddress: emit_frame_address(instruction)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: emit_thread_identity(instruction)
        LowIntermediaryRepresentation.Instructions.FrameRoom: emit_frame_room(instruction)
        LowIntermediaryRepresentation.Instructions.StartThread: emit_start_thread(instruction)
        LowIntermediaryRepresentation.Instructions.JoinThread: emit_join_thread(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: emit_atomic_add(instruction)
        LowIntermediaryRepresentation.Instructions.ImportCall: emit_import_call(instruction)
        LowIntermediaryRepresentation.Instructions.CompareExchange: emit_compare_exchange(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: emit_stop(instruction)
        LowIntermediaryRepresentation.Instructions.Exit: emit_exit(instruction)
        LowIntermediaryRepresentation.Instructions.VectorLoop: state.kernels.emit(instruction, state.allocation)
        LowIntermediaryRepresentation.Instructions.Select: select_instruction.emit(instruction)
    }
}

func emit_open_library(open: LowIntermediaryRepresentation.Instructions.OpenLibrary) {
    frames.read_into(encoder.rcx, open.name)
    fixups.call_import("LoadLibraryA")
    encoder.test_rax()
    var not_zero = opcodes.jump_if_not_equal_code
    var opened = encoder.jump_if(not_zero)
    stop_naming_the_library(open.name)
    fixups.patch_here(opened)
    frames.write_from(open.target, encoder.rax)
}

func stop_naming_the_library(name: Integer) {
    runtime_routines.gate_the_crash()
    var before = runtime_routines.label_of_text("spite: the library '")
    runtime_routines.write_a_label(before)
    frames.read_into(encoder.rcx, name)
    fixups.call_import("lstrlenA")
    encoder.move_register(encoder.rdx, encoder.rax)
    frames.read_into(encoder.rcx, name)
    fixups.call_routine(state.text_writer)
    var after = runtime_routines.label_of_text(
        "' could not be opened, in {state.current_key}: it is not there, or it is not a library this program can load\n",
    )
    runtime_routines.write_a_label(after)
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

func emit_jump(jump: LowIntermediaryRepresentation.Instructions.Jump) {
    if block_analysis.rotates_into(jump.block) {
        emit_the_test_of(jump.block)
    } else {
        edge_moves.go_to_block(jump.block)
    }
}

func emit_the_test_of(head: Integer) {
    var block = state.allocation.function.blocks[head]
    crash block
    var latch = state.current_block_index
    var kept_instructions = state.current_instructions
    var kept_position = state.instruction_position
    state.current_block_index = head
    state.allocation.current_block = head
    state.flags_register = -1
    state.current_instructions = block.instructions
    state.instruction_position = 0
    block.instructions.each(emit_instruction)
    state.current_instructions = kept_instructions
    state.instruction_position = kept_position
    state.current_block_index = latch
    state.allocation.current_block = latch
    state.flags_register = -1
}

func jump_when_unordered(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    var parity = _jump_if_parity_code
    if state.flags_unordered_is_true {
        edge_moves.jump_to_block_if_through_moves(parity, branch.when_true)
    } else {
        edge_moves.jump_to_block_if_through_moves(parity, branch.when_false)
    }
}

func emit_branch(branch: LowIntermediaryRepresentation.Instructions.Branch) {
    if state.allocation.constant_of(branch.condition) {
        var value = state.allocation.value_of(branch.condition)
        if value != 0 {
            edge_moves.go_to_block(branch.when_true)
        } else {
            edge_moves.go_to_block(branch.when_false)
        }
        return
    }
    var condition = opcodes.jump_if_not_equal_code
    var flagged = branch.condition == state.flags_register
    if state.allocation.is_fused(branch.condition) or flagged {
        condition = state.flags_condition - 16
    } else {
        var tested = frames.register_of(branch.condition, encoder.rax)
        encoder.test_register(tested)
    }
    if branch.when_true == branch.when_false {
        edge_moves.go_to_block(branch.when_true)
        return
    }
    var on_the_flags = state.allocation.is_fused(branch.condition) or flagged
    if state.flags_have_parity and on_the_flags {
        jump_when_unordered(branch)
    }
    var true_moves = edge_moves.moves_at_the_tail(branch.when_true)
    var false_moves = edge_moves.moves_at_the_tail(branch.when_false)
    var stays_on_true = edge_moves.falls_into(branch.when_true)
    if true_moves and not false_moves {
        stays_on_true = true
    } else if false_moves and not true_moves {
        stays_on_true = false
    }
    if stays_on_true {
        var opposite = edge_moves.inverted(condition)
        edge_moves.jump_to_block_if_through_moves(opposite, branch.when_false)
        edge_moves.go_to_block(branch.when_true)
        return
    }
    edge_moves.jump_to_block_if_through_moves(condition, branch.when_true)
    edge_moves.go_to_block(branch.when_false)
}

func emit_return(returned: LowIntermediaryRepresentation.Instructions.Return) {
    if state.current_ends_a_thread {
        state.small_blocks.call_release()
    }
    if returned.source >= 0 {
        frames.read_into(encoder.rax, returned.source)
    }
    if returned.presence >= 0 {
        frames.read_into(encoder.rdx, returned.presence)
    }
    if state.current_answer_decimal_size > 0 and returned.source >= 0 {
        encoder.decimal_register_from(0, encoder.rax, state.current_answer_decimal_size == 8)
    }
    if not state.current_is_resumable {
        frames.restore_the_kept_registers()
        encoder.epilogue()
        return
    }
    if returned.is_a_suspension {
        encoder.move_small_immediate(encoder.rax, 0)
        encoder.resumable_epilogue(state.current_outgoing)
        return
    }
    encoder.store_slot(state.current_header + 16, encoder.rax)
    encoder.store_slot(state.current_header + 24, encoder.rdx)
    encoder.move_small_immediate(encoder.rax, 1)
    encoder.store_slot(state.current_header + 8, encoder.rax)
    encoder.resumable_epilogue(state.current_outgoing)
}

func emit_start_thread(starting: LowIntermediaryRepresentation.Instructions.StartThread) {
    encoder.move_small_immediate(encoder.rax, 0)
    encoder.store_outgoing(4)
    encoder.store_outgoing(5)
    encoder.move_small_immediate(encoder.rcx, 0)
    encoder.move_small_immediate(encoder.rdx, 0)
    var at = encoder.load_address_of(encoder.r8)
    var fixup = Generators.X64.Fixup(at, starting.entry, 0)
    state.call_fixups.append(fixup)
    frames.read_into(encoder.r9, starting.block)
    fixups.call_import("CreateThread")
    frames.write_from(starting.target, encoder.rax)
}

func emit_compare_exchange(exchanging: LowIntermediaryRepresentation.Instructions.CompareExchange) {
    frames.read_into(encoder.r11, exchanging.address)
    frames.read_into(encoder.rax, exchanging.expected)
    frames.read_into(encoder.rcx, exchanging.desired)
    if exchanging.width == 'bits_32' {
        encoder.locked_compare_exchange_double_word(exchanging.offset)
        widen_the_exchanged(exchanging.is_signed)
    } else {
        encoder.locked_compare_exchange(exchanging.offset)
    }
    frames.write_from(exchanging.target, encoder.rax)
}

func widen_the_exchanged(is_signed: Boolean) {
    if is_signed {
        encoder.sign_extend_eax_into_rax()
    } else {
        encoder.zero_extend_eax_into_rax()
    }
}

func emit_import_call(calling: LowIntermediaryRepresentation.Instructions.ImportCall) {
    var stacked = 4
    while stacked < calling.arguments.count() {
        var passed = calling.arguments[stacked]
        frames.read_into(encoder.rax, passed)
        encoder.store_outgoing(stacked)
        stacked = stacked + 1
    }
    var index = 0
    while index < calling.arguments.count() and index < 4 {
        var argument = calling.arguments[index]
        var register = state.parameter_registers[index]
        crash register
        frames.read_into(register, argument)
        var size = decimal_size_at(calling.decimal_sizes, index)
        if size > 0 {
            encoder.decimal_register_from(index, register, size == 8)
        }
        index = index + 1
    }
    if calling.library.is_empty() {
        fixups.call_import(calling.name)
    } else {
        crash calling.library == "ucrtbase.dll"
        fixups.call_library_import(calling.name)
    }
    if calling.answer_decimal_size > 0 {
        encoder.rax_from_the_first_decimal_register(calling.answer_decimal_size == 8)
    }
    if calling.target >= 0 {
        frames.write_from(calling.target, encoder.rax)
    }
}

func decimal_size_at(sizes: List<Integer>, index: Integer): Integer {
    if index < sizes.count() {
        return sizes[index]
    }
    return 0
}

func emit_join_thread(joining: LowIntermediaryRepresentation.Instructions.JoinThread) {
    frames.read_into(encoder.rcx, joining.thread)
    encoder.move_small_immediate(encoder.rdx, _wait_forever)
    fixups.call_import("WaitForSingleObject")
    frames.read_into(encoder.rcx, joining.thread)
    fixups.call_import("CloseHandle")
}

func emit_atomic_add(adding: LowIntermediaryRepresentation.Instructions.AtomicAdd) {
    frames.read_into(encoder.rax, adding.address)
    encoder.move_small_immediate(encoder.rcx, adding.amount)
    encoder.locked_exchange_add(adding.offset)
    encoder.move_small_immediate(encoder.rax, adding.amount)
    encoder.add_rcx_into_rax()
    frames.write_from(adding.target, encoder.rax)
}

func emit_thread_identity(asked: LowIntermediaryRepresentation.Instructions.ThreadIdentity) {
    frames.thread_identity_into_rax()
    frames.write_from(asked.target, encoder.rax)
}

func emit_frame_address(found: LowIntermediaryRepresentation.Instructions.FrameAddress) {
    var header = 0
    if state.current_is_resumable {
        header = state.current_header
    }
    encoder.slot_address(encoder.rax, header)
    frames.write_from(found.target, encoder.rax)
}

func emit_frame_room(room: LowIntermediaryRepresentation.Instructions.FrameRoom) {
    crash not state.current_is_resumable
    var lowest = state.frame_slots + state.allocation.saved.count() + room.slot
    var displacement = encoder.slot_of(lowest)
    var zeroed = room.size
    if state.program.fills_fresh_memory and room.zeroed_bytes >= 0 {
        zeroed = room.zeroed_bytes
    }
    var written: Integer = 0
    while written < room.size {
        if written < zeroed {
            encoder.store_immediate_to(encoder.rbp, displacement + written, 0, 'bits_64')
        } else {
            fill_a_word(displacement + written)
        }
        written = written + 8
    }
    var home = state.allocation.home_of(room.target)
    if home >= 0 {
        encoder.slot_address(home, displacement)
        return
    }
    encoder.slot_address(encoder.rax, displacement)
    frames.write_from(room.target, encoder.rax)
}

# ../../OPTIMIZATIONS.md#small-blocks-come-from-the-compilers-own-free-lists
func fill_a_word(displacement: Integer) {
    var filled: Long = _filled_word_pattern
    encoder.store_immediate_to(encoder.rbp, displacement, filled, 'bits_32')
    encoder.store_immediate_to(encoder.rbp, displacement + 4, filled, 'bits_32')
}

func emit_stop(stop: LowIntermediaryRepresentation.Instructions.Stop) {
    if stop.numbers.is_empty() and not stop.continues {
        runtime_routines.load_message(stop.label)
        return
    }
    runtime_routines.keep_the_numbers(stop.numbers)
    if not stop.continues {
        runtime_routines.gate_the_crash()
    }
    var index = 0
    while index < stop.labels.count() {
        var label = stop.labels[index]
        runtime_routines.write_a_label(label)
        if index < stop.numbers.count() {
            var number = stop.numbers[index]
            var sign = stop.signed_numbers[index]
            crash sign
            runtime_routines.write_a_number(number, sign == 1)
        }
        index = index + 1
    }
    fallback not stop.continues
    encoder.move_small_immediate(encoder.rcx, 1)
    fixups.call_import("ExitProcess")
}

func emit_exit(exit: LowIntermediaryRepresentation.Instructions.Exit) {
    frames.read_into(encoder.rcx, exit.code)
    fixups.call_import("ExitProcess")
}

func entry_offset(): Integer {
    var found = state.function_offsets[state.program.entry]
    crash found
    return found
}

func function_map(): String {
    var lines = List<String>()
    lines.append("# spite functions 1")
    var index = 0
    while index < state.span_keys.count() {
        var key = state.span_keys[index]
        var start = state.span_starts[index]
        crash start
        var end = state.code_end
        var following = state.span_starts[index + 1]
        if following {
            end = following
        }
        var start_text = hexadecimal_of(start)
        var end_text = hexadecimal_of(end)
        lines.append("{start_text}\t{end_text}\t{key}")
        index = index + 1
    }
    lines.append("")
    return lines.join("\n")
}

func hexadecimal_of(value: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = value
    var place = 0
    while place < 8 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        crash character
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

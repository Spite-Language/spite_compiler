var multiplier: Long = 0
var shift = 0
var halves: Long = 4294967296

func Magic(divisor: Long) {
    var quarter: Long = 4611686018427387904
    var below_quarter: Long = 4611686018427387903
    var quarter_rest = quarter % divisor
    var half_rest = quarter_rest * 2 % divisor
    var nearest = below_quarter - half_rest + quarter
    var first_quotient: Long = 1
    var first_rest = half_rest + 1
    var second_quotient = quarter / divisor * 2 + quarter_rest * 2 / divisor
    var second_rest = half_rest
    var high = second_quotient / halves
    var low = second_quotient % halves
    var power = 63
    var searching = true
    while searching {
        power = power + 1
        first_quotient = first_quotient * 2
        first_rest = first_rest * 2
        if first_rest >= nearest {
            first_quotient = first_quotient + 1
            first_rest = first_rest - nearest
        }
        low = low * 2
        high = high * 2 + low / halves
        low = low % halves
        second_rest = second_rest * 2
        if second_rest >= divisor {
            low = low + 1
            high = high + low / halves
            low = low % halves
            second_rest = second_rest - divisor
        }
        var delta = divisor - second_rest
        searching = first_quotient < delta or first_quotient == delta and first_rest == 0
    }
    low = low + 1
    high = high + low / halves
    low = low % halves
    if high >= 2147483648 {
        multiplier = (high - halves) * halves + low
    } else {
        multiplier = high * halves + low
    }
    shift = power - 64
}

# ../../HOT_RELOAD.md#the-manifest
var no_program = LowIntermediaryRepresentation.LoweredProgram()
var emitter = Emitter(no_program)
var no_code = Buffer(0)
var spans = FunctionSpans(emitter, no_code)
var writer = PortableExecutable(emitter, no_code)

func ReloadHostWriting(starting_spans: FunctionSpans, starting_writer: PortableExecutable) {
    spans = starting_spans
    emitter = starting_spans.emitter
    writer = starting_writer
}

func written(): Model.ReloadHost {
    var host = Model.ReloadHost()
    host.text_base = writer.code_address(0)
    host.routines = spans.routines_digest
    var index = 0
    while index < spans.keys.count() {
        var key = spans.keys[index]
        var start = spans.starts[index]
        crash start
        var stub = writer.code_address(start)
        var label = emitter.slot_labels[key]
        crash label
        var slot = writer.label_address(label)
        var digest = spans.digests[key]
        crash digest
        var owner = spans.owner_of(key)
        host.add_a_function(key, stub, slot, digest, owner)
        index = index + 1
    }
    add_the_states(host)
    add_the_imports(host)
    return host
}

func add_the_states(host: Model.ReloadHost) {
    var labels = emitter.program.state_names.keys()
    var index = 0
    while index < labels.count() {
        var label = labels[index]
        var name = emitter.program.state_names[label]
        crash name
        if not name.is_empty() {
            var address = writer.label_address(label)
            host.add_a_state(name, address)
        }
        index = index + 1
    }
}

func add_the_imports(host: Model.ReloadHost) {
    var index = 0
    while index < writer.imports.count() {
        var name = writer.imports[index]
        host.imports[name] = writer.import_address(name)
        index = index + 1
    }
    index = 0
    while index < emitter.library_imports.count() {
        var name = emitter.library_imports[index]
        host.library_imports[name] = writer.library_import_address(name)
        index = index + 1
    }
}

# ../../HOT_RELOAD.md#the-manifest

enum Kind {
    'call'
    'import'
    'library'
    'data'
    'foreign'
    'routine'
}

var at: Integer
var kind: Kind
var target: String
var index: Integer

func Reference(starting_at: Integer, starting_kind: Kind, starting_target: String, starting_index: Integer) {
    at = starting_at
    kind = starting_kind
    target = starting_target
    index = starting_index
}

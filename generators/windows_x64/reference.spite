var at = 0
var kind: ReferenceKind = 'call'
var target = ""
var index = 0

func Reference(starting_at: Integer, starting_kind: ReferenceKind, starting_target: String, starting_index: Integer) {
    at = starting_at
    kind = starting_kind
    target = starting_target
    index = starting_index
}

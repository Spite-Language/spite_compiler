# ../../ARCHITECTURE.md#the-unwind-tables

var _version = 1
var _version_with_handlers = 25
var _framed_prologue_length = 4
var _resumable_prologue_length = 15
var _pushed_frame_pointer = 80
var _frame_pointer_set = 3
var _frame_pointer_register = 5
var _small_allocation = 2
var _large_allocation = 1
var _largest_small_allocation = 128
var _slot_size = 8
var _entry_size = 12
var _routine_prologue_length = 4
var starts = List<Integer>()
var ends = List<Integer>()
var prologues = List<Integer>()
var allocations = List<Integer>()
var routine_starts = List<Integer>()
var routine_ends = List<Integer>()
var routine_rooms = List<Integer>()

func add_a_function(start: Integer, end: Integer, prologue: Integer, allocated: Integer) {
    starts.append(start)
    ends.append(end)
    prologues.append(prologue)
    allocations.append(allocated)
}

# ../../ARCHITECTURE.md#the-unwind-tables
func add_a_routine(start: Integer, end: Integer, room: Integer) {
    routine_starts.append(start)
    routine_ends.append(end)
    routine_rooms.append(room)
}

func entry_count(): Integer {
    var routines = routine_starts.count()
    return starts.count() + routines
}

func written(text_address: Integer, table_address: Integer, handler_address: Integer): Buffer {
    var entries = Buffer()
    var informations = Buffer()
    var placed = Dictionary<String, Integer>()
    var informations_address = table_address + _entry_size * entry_count()
    var routine = 0
    while routine < routine_starts.count() {
        var routine_start = routine_starts[routine]
        var routine_end = routine_ends[routine]
        var room = routine_rooms[routine]
        crash routine_start
        crash routine_end
        crash room
        var described = routine_information(room)
        var routine_at = placed_information(informations, placed, "routine {room}", described)
        add_an_entry(entries, text_address, routine_start, routine_end, informations_address + routine_at)
        routine = routine + 1
    }
    var index = 0
    while index < starts.count() {
        var start = starts[index]
        var end = ends[index]
        var prologue = prologues[index]
        var allocated = allocations[index]
        crash start
        crash end
        crash prologue
        crash allocated
        var information = function_information(prologue, allocated, handler_address)
        var key = "{prologue}\t{allocated}"
        var at = placed_information(informations, placed, key, information)
        add_an_entry(entries, text_address, start, end, informations_address + at)
        index = index + 1
    }
    var copied = 0
    while copied < informations.count() {
        var read = informations[copied]
        crash read
        entries.append(read)
        copied = copied + 1
    }
    return entries
}

func add_an_entry(entries: Buffer, text_address: Integer, start: Integer, end: Integer, information_address: Integer) {
    entries.append_integer_little_endian(text_address + start)
    entries.append_integer_little_endian(text_address + end)
    entries.append_integer_little_endian(information_address)
}

func placed_information(
    informations: Buffer,
    placed: Dictionary<String, Integer>,
    key: String,
    information: Buffer,
): Integer {
    if placed.contains(key) {
        var known = placed[key]
        crash known
        return known
    }
    var at = informations.count()
    var index = 0
    while index < information.count() {
        var read = information[index]
        crash read
        informations.append(read)
        index = index + 1
    }
    placed[key] = at
    return at
}

func routine_information(room: Integer): Buffer {
    var information = Buffer()
    var slots = room / _slot_size
    append_a_byte(information, _version)
    append_a_byte(information, _routine_prologue_length)
    append_a_byte(information, 1)
    append_a_byte(information, 0)
    append_a_byte(information, _routine_prologue_length)
    append_a_byte(information, _small_allocation + 16 * (slots - 1))
    append_a_byte(information, 0)
    append_a_byte(information, 0)
    return information
}

func function_information(prologue: Integer, allocated: Integer, handler_address: Integer): Buffer {
    var information = Buffer()
    var version = _version
    if handler_address > 0 {
        version = _version_with_handlers
    }
    if allocated == 0 {
        var framed_end = prologue + _framed_prologue_length
        append_a_byte(information, version)
        append_a_byte(information, framed_end)
        append_a_byte(information, 2)
        append_a_byte(information, _frame_pointer_register)
        append_a_byte(information, framed_end)
        append_a_byte(information, _frame_pointer_set)
        append_a_byte(information, prologue + 1)
        append_a_byte(information, _pushed_frame_pointer)
    } else {
        add_a_resumable_prologue(information, version, prologue, allocated)
    }
    if handler_address > 0 {
        information.append_integer_little_endian(handler_address)
    }
    return information
}

func add_a_resumable_prologue(information: Buffer, version: Integer, prologue: Integer, allocated: Integer) {
    var resumable_end = prologue + _resumable_prologue_length
    var slots = allocated / _slot_size
    append_a_byte(information, version)
    append_a_byte(information, resumable_end)
    if allocated <= _largest_small_allocation {
        append_a_byte(information, 2)
        append_a_byte(information, 0)
        append_a_byte(information, resumable_end)
        append_a_byte(information, _small_allocation + 16 * (slots - 1))
        append_a_byte(information, prologue + 1)
        append_a_byte(information, _pushed_frame_pointer)
        return
    }
    append_a_byte(information, 3)
    append_a_byte(information, 0)
    append_a_byte(information, resumable_end)
    append_a_byte(information, _large_allocation)
    append_a_byte(information, slots % 256)
    append_a_byte(information, slots / 256)
    append_a_byte(information, prologue + 1)
    append_a_byte(information, _pushed_frame_pointer)
    append_a_byte(information, 0)
    append_a_byte(information, 0)
}

func append_a_byte(buffer: Buffer, value: Integer) {
    var narrowed: Byte? = value
    crash narrowed
    buffer.append(narrowed)
}

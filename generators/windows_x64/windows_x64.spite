var low = LowIntermediaryRepresentation.LoweredProgram()
var function_map = ""
var reload_host = Model.ReloadHost()
var has_a_reload_host = false
var reload_answer = List<String>()
var reload_bytes = Buffer(0)
var reload_written = false

func WindowsX64(starting_low: LowIntermediaryRepresentation.LoweredProgram) {
    low = starting_low
}

func run(): Buffer {
    var emitter = Emitter(low)
    var code = emitter.emitted()
    var writer = PortableExecutable(emitter, code)
    var bytes = writer.written()
    function_map = emitter.function_map()
    if low.hot_reload {
        var spans = FunctionSpans(emitter, code)
        var host_writing = ReloadHostWriting(spans, writer)
        reload_host = host_writing.written()
        has_a_reload_host = true
    }
    return bytes
}

# ../../HOT_RELOAD.md#the-parts
func run_reload(running: Model.ReloadHost, address: Long) {
    var emitter = Emitter(low)
    var code = emitter.emitted()
    var spans = FunctionSpans(emitter, code)
    var library = ReloadLibrary(spans, running, address)
    reload_written = library.written()
    reload_answer = library.answer
    reload_bytes = library.bytes
    reload_host = library.host
    has_a_reload_host = true
}

func prologue(frame_size: Integer) {
    byte(85)
    byte(72)
    byte(137)
    byte(229)
    var remaining = frame_size
    while remaining > 4096 {
        lower_the_stack(4096)
        touch_the_stack()
        remaining = remaining - 4096
    }
    lower_the_stack(remaining)
}

func lower_the_stack(size: Integer) {
    byte(72)
    byte(129)
    byte(236)
    dword(size)
}

func touch_the_stack() {
    byte(72)
    byte(137)
    byte(4)
    byte(36)
}


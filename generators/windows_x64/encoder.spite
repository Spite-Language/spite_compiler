func decimal_registers_from_rax_and_rcx(is_double: Boolean) {
    byte(102)
    if is_double {
        byte(72)
    }
    byte(15)
    byte(110)
    byte(192)
    byte(102)
    if is_double {
        byte(72)
    }
    byte(15)
    byte(110)
    byte(201)
}


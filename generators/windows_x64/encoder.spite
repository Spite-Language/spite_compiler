func fits_back(width: LowIntermediaryRepresentation.Width, is_signed: Boolean) {
    switch width {
        'bits_32': fits_back_from_double_word(is_signed)
        'bits_16': fits_back_from_word(is_signed)
        'bits_8': fits_back_from_byte(is_signed)
        'bits_64': return
    }
}

func fits_back_from_double_word(is_signed: Boolean) {
    if is_signed {
        byte(72)
        byte(99)
        byte(208)
    } else {
        byte(137)

var code = Buffer()
var rax = 0
var rcx = 1
var rdx = 2
var rbp = 5
var r8 = 8
var r9 = 9
var r11 = 11
var indexing = -1
var scaling = 0

func byte(value: Integer) {
    var written: Byte = value.to_byte()
    code.append(written)
}

func dword(value: Integer) {
    code.append_integer(value)
}

func qword(value: Long) {
    code.append_long(value)
}

func position(): Integer {
    return code.count()
}

func patch_dword(at: Integer, value: Integer) {
    code.write_integer_at(at, value)
}

func rex(wide: Boolean, register: Integer, base: Integer) {
    var prefix = 64
    if wide {
        prefix = prefix + 8
    }
    if register >= 8 {
        prefix = prefix + 4
    }
    if base >= 8 {
        prefix = prefix + 1
    }
    byte(prefix)
}

func low_bits(register: Integer): Integer {
    return register % 8
}

func slot_operand(register: Integer, displacement: Integer) {
    var register_bits = low_bits(register) * 8
    byte(128 + register_bits + rbp)
    dword(displacement)
}

func load_slot(register: Integer, displacement: Integer) {
    rex(true, register, 0)
    byte(139)
    slot_operand(register, displacement)
}

func slot_of(virtual: Integer): Integer {
    return 0 - 8 * (virtual + 1)
}

func load_virtual(register: Integer, virtual: Integer) {
    var displacement = slot_of(virtual)
    load_slot(register, displacement)
}

func store_virtual(virtual: Integer, register: Integer) {
    var displacement = slot_of(virtual)
    store_slot(displacement, register)
}

func store_slot(displacement: Integer, register: Integer) {
    rex(true, register, 0)
    byte(137)
    slot_operand(register, displacement)
}

func move_immediate(register: Integer, value: Long) {
    rex(true, 0, register)
    var register_bits = low_bits(register)
    byte(184 + register_bits)
    qword(value)
}

func move_register(target: Integer, source: Integer) {
    rex(true, source, target)
    byte(137)
    var source_bits = low_bits(source) * 8
    var target_bits = low_bits(target)
    byte(192 + source_bits + target_bits)
}

func register_operation(opcode: Integer, target: Integer, source: Integer) {
    rex(true, source, target)
    byte(opcode)
    var source_bits = low_bits(source) * 8
    var target_bits = low_bits(target)
    byte(192 + source_bits + target_bits)
}


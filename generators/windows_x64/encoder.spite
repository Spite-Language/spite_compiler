func decimal_register_from(decimal_register: Integer, register: Integer, is_double: Boolean) {
    byte(102)
    var prefix = 64
    if is_double {
        prefix = prefix + 8
    }
    if register >= 8 {
        prefix = prefix + 1
    }
    if prefix != 64 {
        byte(prefix)
    }
    byte(15)
    byte(110)
    var low = low_bits(register)
    byte(192 + decimal_register * 8 + low)
}


func load_memory(width: LowIntermediaryRepresentation.Width, is_signed: Boolean, offset: Integer) {
    switch width {
        'bits_64': load_quad(offset)
        'bits_32': load_double_word(is_signed, offset)
        'bits_16': load_word(is_signed, offset)
        'bits_8': load_byte(is_signed, offset)
    }
}

func load_quad(offset: Integer) {
    byte(72)
    byte(139)
    byte(128)
    dword(offset)
}

func load_double_word(is_signed: Boolean, offset: Integer) {
    if is_signed {
        byte(72)
        byte(99)
    } else {
        byte(139)
    }
    byte(128)
    dword(offset)
}

func load_word(is_signed: Boolean, offset: Integer) {
    byte(72)
    byte(15)
    if is_signed {
        byte(191)
    } else {
        byte(183)
    }
    byte(128)
    dword(offset)
}

func load_byte(is_signed: Boolean, offset: Integer) {
    byte(72)
    byte(15)
    if is_signed {
        byte(190)
    } else {
        byte(182)
    }
    byte(128)
    dword(offset)
}

func store_memory(width: LowIntermediaryRepresentation.Width, offset: Integer) {
    switch width {
        'bits_64': store_quad(offset)
        'bits_32': store_double_word(offset)
        'bits_16': store_word(offset)
        'bits_8': store_byte(offset)
    }
}

func store_quad(offset: Integer) {

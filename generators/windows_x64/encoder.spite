func decimal_operation(operation_code: Integer, is_double: Boolean) {
    if is_double {
        byte(242)
    } else {
        byte(243)
    }
    byte(15)
    byte(operation_code)
    byte(193)
}

func decimal_remainder(is_double: Boolean) {
    var prefix = 243
    var rounding = 10
    if is_double {
        prefix = 242
        rounding = 11
    }
    byte(15)
    byte(40)
    byte(208)
    byte(prefix)
    byte(15)
    byte(94)
    byte(209)
    byte(102)
    byte(15)
    byte(58)
    byte(rounding)
    byte(210)
    byte(3)
    byte(prefix)
    byte(15)
    byte(89)
    byte(209)
    byte(prefix)
    byte(15)
    byte(92)
    byte(194)
}


var empty_names = List<String>()
var code = Buffer()
var data = Buffer()
var layout = Generators.WindowsX86.Layout(empty_names)

func Pe(starting_code: Buffer, starting_layout: Generators.WindowsX86.Layout) {
    code = starting_code
    layout = starting_layout
}

func with_data(starting_data: Buffer) {
    data = starting_data
}

func write(path: String) {
    var code_size = code.count()
    var data_size = data.count()
    var imports_size = layout.import_section_size()
    var sections = 2
    if data_size > 0 {
        sections = 3
    }
    var bytes = Buffer()
    append_dos_header(bytes)
    append_file_header(bytes, sections)
    append_optional_header(bytes, code_size, imports_size, data_size)
    append_section_headers(bytes, code_size, imports_size, data_size, sections)
    var alignment = layout.file_alignment()
    var header_room = alignment - bytes.count()
    append_zeros(bytes, header_room)
    append_imports(bytes)
    var imports_room = layout.raw_size(imports_size) - imports_size
    append_zeros(bytes, imports_room)
    if data_size > 0 {
        bytes.append_bytes(data, 0, data_size)
        var data_room = layout.raw_size(data_size) - data_size
        append_zeros(bytes, data_room)
    }
    bytes.append_bytes(code, 0, code_size)
    var code_room = layout.raw_size(code_size) - code_size
    append_zeros(bytes, code_room)
    var file = File(path)
    var written = file.write_bytes(bytes)
    assert written
}

func append_dos_header(bytes: Buffer) {
    bytes.append_unsigned_short(23117)
    append_zeros(bytes, 58)
    bytes.append_unsigned_integer(64)
}

func append_file_header(bytes: Buffer, sections: Integer) {
    var machine = layout.machine()
    bytes.append_unsigned_integer(17744)
    bytes.append_unsigned_short(machine)
    bytes.append_unsigned_short(sections)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_short(224)
    bytes.append_unsigned_short(258)
}

func append_optional_header(bytes: Buffer, code_size: Integer, imports_size: Integer, data_size: Integer) {
    var code_raw = layout.raw_size(code_size)
    var imports_raw = layout.raw_size(imports_size)
    var data_raw = layout.raw_size(data_size)
    var image_size = layout.image_size(code_size)
    var code_address = layout.code_address()
    var imports_address = layout.imports_address()
    var base = layout.image_base()
    var section = layout.section_size()
    var alignment = layout.file_alignment()
    var subsystem = layout.subsystem()
    bytes.append_unsigned_short(267)
    bytes.append(0)
    bytes.append(0)
    bytes.append_unsigned_integer(code_raw)
    bytes.append_unsigned_integer(imports_raw + data_raw)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(code_address)
    bytes.append_unsigned_integer(code_address)
    bytes.append_unsigned_integer(imports_address)
    bytes.append_unsigned_integer(base)
    bytes.append_unsigned_integer(section)
    bytes.append_unsigned_integer(alignment)
    bytes.append_unsigned_short(6)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_short(6)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(image_size)
    bytes.append_unsigned_integer(alignment)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_short(subsystem)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_integer(1048576)
    bytes.append_unsigned_integer(4096)
    bytes.append_unsigned_integer(1048576)
    bytes.append_unsigned_integer(4096)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(16)
    append_data_directories(bytes)
}

func append_data_directories(bytes: Buffer) {
    var imports_address = layout.imports_address()
    var descriptors = layout.descriptor_size()
    var index = 0
    while index < 16 {
        if index == 1 {
            bytes.append_unsigned_integer(imports_address)
            bytes.append_unsigned_integer(descriptors)
        } else {
            bytes.append_unsigned_integer(0)
            bytes.append_unsigned_integer(0)
        }
        index = index + 1
    }
}

func append_section_headers(
    bytes: Buffer,
    code_size: Integer,
    imports_size: Integer,
    data_size: Integer,
    sections: Integer,
) {
    var code_raw = layout.raw_size(code_size)
    var imports_raw = layout.raw_size(imports_size)
    var data_raw = layout.raw_size(data_size)
    var alignment = layout.file_alignment()
    var imports_place = alignment
    var data_place = imports_place + imports_raw
    var code_place = data_place + data_raw
    var code_address = layout.code_address()
    var imports_address = layout.imports_address()
    var data_address = layout.data_address()
    var code_flags = layout.code_flags()
    var data_flags = layout.data_flags()
    append_section_header(bytes, ".rdata", imports_size, imports_address, imports_raw, imports_place, data_flags)
    if sections > 2 {
        append_section_header(bytes, ".data", data_size, data_address, data_raw, data_place, data_flags)
    }
    append_section_header(bytes, ".text", code_size, code_address, code_raw, code_place, code_flags)
}

func append_section_header(
    bytes: Buffer,
    name: String,
    virtual_size: Integer,
    address: Integer,
    raw: Integer,
    place: Integer,
    flags: Long,
) {
    var name_length = name.length()
    var index = 0
    while index < name_length {
        var letter = name.code_at(index)
        bytes.append(letter)
        index = index + 1
    }
    var name_room = 8 - name_length
    append_zeros(bytes, name_room)
    bytes.append_unsigned_integer(virtual_size)
    bytes.append_unsigned_integer(address)
    bytes.append_unsigned_integer(raw)
    bytes.append_unsigned_integer(place)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_short(0)
    bytes.append_unsigned_integer(flags)
}

func append_imports(bytes: Buffer) {
    var imports_address = layout.imports_address()
    var lookup_table = imports_address + layout.lookup_table_offset()
    var library_address = imports_address + layout.library_name_offset()
    var slot_table = imports_address + layout.address_table_offset()
    bytes.append_unsigned_integer(lookup_table)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(0)
    bytes.append_unsigned_integer(library_address)
    bytes.append_unsigned_integer(slot_table)
    append_zeros(bytes, 20)
    append_import_tables(bytes)
    var index = 0
    while index < layout.import_names.count() {
        var name = layout.import_names[index]
        append_name(bytes, name)
        index = index + 1
    }
    var library_name = layout.library_name()
    append_text(bytes, library_name)
    bytes.append(0)
}

func append_import_tables(bytes: Buffer) {
    var slots = Buffer()
    var imports_address = layout.imports_address()
    var index = 0
    while index < layout.import_names.count() {
        var entry = imports_address + layout.name_entry_offset(index)
        slots.append_unsigned_integer(entry)
        index = index + 1
    }
    slots.append_unsigned_integer(0)
    var slot_count = slots.count()
    bytes.append_bytes(slots, 0, slot_count)
    bytes.append_bytes(slots, 0, slot_count)
}

func append_name(bytes: Buffer, name: String) {
    bytes.append_unsigned_short(0)
    append_text(bytes, name)
    bytes.append(0)
    var padding = layout.name_entry_size(name) - name.length() - 3
    append_zeros(bytes, padding)
}

func append_text(bytes: Buffer, text: String) {
    var index = 0
    while index < text.length() {
        var letter = text.code_at(index)
        bytes.append(letter)
        index = index + 1
    }
}

func append_zeros(bytes: Buffer, count: Integer) {
    var written = 0
    while written < count {
        bytes.append(0)
        written = written + 1
    }
}

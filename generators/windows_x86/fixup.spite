var at = 0
var target_index = 0
var callee = ""
var owner_class = ""

func Fixup(
    starting_at: Integer,
    starting_target_index: Integer,
    starting_callee: String,
    starting_owner_class: String,
) {
    at = starting_at
    target_index = starting_target_index
    callee = starting_callee
    owner_class = starting_owner_class
}

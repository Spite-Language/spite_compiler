var at = 0
var target_index = 0
var callee = ""
var owner = ""
var caller = ""

func Fixup(
    starting_at: Integer,
    starting_target_index: Integer,
    starting_callee: String,
    starting_owner: String,
    starting_caller: String,
) {
    at = starting_at
    target_index = starting_target_index
    callee = starting_callee
    owner = starting_owner
    caller = starting_caller
}

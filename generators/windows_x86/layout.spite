var import_names = List<String>()

func Layout(starting_names: List<String>) {
    import_names = starting_names
}

func image_base(): Integer {
    return 4194304
}

func section_size(): Integer {
    return 4096
}

func file_alignment(): Integer {
    return 512
}

func machine(): Integer {
    return 332
}

func subsystem(): Integer {
    return 3
}

func code_flags(): Long {
    return 1610612736
}

func data_flags(): Long {
    return 3221225536
}

func library_name(): String {
    return "kernel32.dll"
}

func code_address(): Integer {
    return section_size()
}

func imports_address(): Integer {
    return section_size() * 2
}

func descriptor_size(): Integer {
    return 40
}

func table_size(): Integer {
    return (import_names.count() + 1) * 4
}

func address_table_offset(): Integer {
    return descriptor_size()
}

func lookup_table_offset(): Integer {
    return descriptor_size() + table_size()
}

func name_table_offset(): Integer {
    return descriptor_size() + table_size() * 2
}

func name_entry_size(name: String): Integer {
    var size = 3 + name.length()
    return size + size % 2
}

func name_entry_offset(index: Integer): Integer {
    var offset = name_table_offset()
    var walked = 0
    while walked < import_names.count() {
        var name = import_names[walked]
        if walked < index {
            offset = offset + name_entry_size(name)
        }
        walked = walked + 1
    }
    return offset
}

func names_size(): Integer {
    var total = 0
    var index = 0
    while index < import_names.count() {
        var name = import_names[index]
        total = total + name_entry_size(name)
        index = index + 1
    }
    return total
}

func library_name_offset(): Integer {
    return name_table_offset() + names_size()
}

func import_section_size(): Integer {
    var length = library_name().length()
    return library_name_offset() + length + 1
}

func address_of_import(name: String): Integer {
    var index = import_names.index_of(name)
    crash index
    var slot = address_table_offset() + index * 4
    return image_base() + imports_address() + slot
}

func raw_size(size: Integer): Integer {
    var remainder = size % file_alignment()
    if remainder > 0 {
        return size + file_alignment() - remainder
    } else {
        return size
    }
}

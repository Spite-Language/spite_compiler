# ../../../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func refuse_outside_its_class(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    written: String,
    owners: List<String>,
    namings: List<String>,
) {
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var text = "'{written}' is declared by the class {classes} and belongs to it: outside that class, name it through the class, {named}"
    if owners.count() > 1 {
        text = "'{written}' is declared by the classes {classes} and belongs to each: outside them, name it through the class meant, {named}"
    }
    stop_with(path, line, class_shown, function_name, text)
}

# ../../../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func refuse_through_a_namespace(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    written: String,
    namespace_name: String,
    owners: List<String>,
    namings: List<String>,
) {
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var owned = "'{last_name}' is declared by the class {classes}"
    if owners.count() > 1 {
        owned = "'{last_name}' is declared by the classes {classes}"
    }
    var text = "'{written}' reaches '{last_name}' through the namespace '{namespace_name}', which holds only classes and namespaces: {owned}, so name it through the class, {named}"
    stop_with(path, line, class_shown, function_name, text)
}

# ../../../../spite_spec/specs/classes_and_files.md#files-are-classes
func refuse_a_copy_named_outside(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    written: String,
    kind: String,
    owners: List<String>,
) {
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    var classes = listed(owners, "and")
    var text = "'{written}' is a {kind} of the class {classes}, and a {kind} is never named outside the class that declares it: declare this class's own '{kind} {last_name}' with the same members, and write '{last_name}'"
    if owners.count() > 1 {
        text = "'{written}' is a {kind} of the classes {classes}, and a {kind} is never named outside the class that declares it: declare this class's own '{kind} {last_name}' with the members it needs, and write '{last_name}'"
    }
    stop_with(path, line, class_shown, function_name, text)
}

func listed(names: List<String>, joining_word: String): String {
    var quoted = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        quoted.append("'{name}'")
        index = index + 1
    }
    var last_quoted = quoted.remove_last()
    crash last_quoted
    if quoted.is_empty() {
        return last_quoted
    }
    var first_ones = quoted.join(", ")
    return "{first_ones} {joining_word} {last_quoted}"
}

func stop_with(path: String, line: Integer, class_shown: String, function_name: String, text: String) {
    var class_name = class_shown
    var opening = class_shown.index_of("<")
    if opening {
        var sliced = class_shown.slice(0, opening)
        crash sliced
        class_name = sliced
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

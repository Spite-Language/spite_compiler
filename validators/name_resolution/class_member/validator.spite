# ../../../../spite_documentation/packages.md
func check(
    written: String,
    owners: List<String>,
    namings: List<String>,
    namespace_name: String,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not owners.is_empty()
    if namespace_name.is_empty() {
        return mistake_outside_its_class(written, owners, namings, place)
    }
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    return mistake_through_a_namespace(written, last_name, namespace_name, owners, namings, place)
}

func mistake_outside_its_class(
    written: String,
    owners: List<String>,
    namings: List<String>,
    place: NameResolution.Place,
): Validators.Answer {
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var text = "'{written}' is declared by the class {classes} and belongs to it: outside that class, name it through the class, {named}"
    if owners.count() > 1 {
        text = "'{written}' is declared by the classes {classes} and belongs to each: outside them, name it through the class meant, {named}"
    }
    return mistake(place, text)
}

func mistake_through_a_namespace(
    written: String,
    last_name: String,
    namespace_name: String,
    owners: List<String>,
    namings: List<String>,
    place: NameResolution.Place,
): Validators.Answer {
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var owned = "'{last_name}' is declared by the class {classes}"
    if owners.count() > 1 {
        owned = "'{last_name}' is declared by the classes {classes}"
    }
    var text = "'{written}' reaches '{last_name}' through the namespace '{namespace_name}', which holds only classes and namespaces: {owned}, so name it through the class, {named}"
    return mistake(place, text)
}

# ../../../../spite_documentation/classes_and_files.md#what-a-file-holds
func check_a_copy_named_outside(
    written: String,
    kind: String,
    owner: Model.ClassModel,
    types: NameResolution.Types,
    symbols: Symbols.SymbolTable,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not types.is_named_by(owner)
    var owners = [owner.key]
    return check_a_copy(written, kind, owners, symbols, place)
}

# ../../../../spite_documentation/classes_and_files.md#what-a-file-holds
func check_a_copy(
    written: String,
    kind: String,
    owners: List<String>,
    symbols: Symbols.SymbolTable,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not kind.is_empty()
    fallback not symbols.generated_texts.contains(place.path)
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    var classes = listed(owners, "and")
    var text = "'{written}' is a {kind} of the class {classes}, and a {kind} is never named outside the class that declares it: declare this class's own '{kind} {last_name}' with the same members, and write '{last_name}'"
    if owners.count() > 1 {
        text = "'{written}' is a {kind} of the classes {classes}, and a {kind} is never named outside the class that declares it: declare this class's own '{kind} {last_name}' with the members it needs, and write '{last_name}'"
    }
    return mistake(place, text)
}

# ../../../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func check_a_plain_name(
    written: String,
    kind: String,
    owner: String,
    through: String,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not kind.is_empty()
    var text = "'{written}' is a {kind} of '{owner}', the entry class of this class's namespace, and only that class names it plainly: write '{through}.{written}'"
    return mistake(place, text)
}

func listed(names: List<String>, joining_word: String): String {
    var quoted = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        quoted.append("'{name}'")
        index = index + 1
    }
    var last_quoted = quoted.remove_last()
    crash last_quoted
    if quoted.is_empty() {
        return last_quoted
    }
    var first_ones = quoted.join(", ")
    return "{first_ones} {joining_word} {last_quoted}"
}

func mistake(place: NameResolution.Place, text: String): Validators.Answer {
    var class_name = place.class_name()
    var problem = Diagnostics.Problem(place.path, place.line, text)
    problem.class_name = class_name
    problem.function_name = place.known_function_name
    problem.is_among_the_attributes = place.known_function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

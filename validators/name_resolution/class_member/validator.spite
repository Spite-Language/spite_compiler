# ../../../../spite_documentation/packages.md
func check(
    written: String,
    owners: List<String>,
    namings: List<String>,
    namespace_name: String,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not owners.is_empty()
    if namespace_name.is_empty() {
        return mistake_outside_its_class(written, owners, namings, place)
    }
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    return mistake_through_a_namespace(written, last_name, namespace_name, owners, namings, place)
}

# ../../../../spite_documentation/values_and_types.md#enums
func check_an_entry_class_member(
    table: Symbols.SymbolTable,
    path: List<String>,
    from_namespace: String,
    file_path: String,
    place: NameResolution.Place,
): Validators.Answer {
    var full = full_form_of(table, path, from_namespace)
    fallback not full.is_empty()
    if table.may_fix_later(file_path) {
        var answer = Validators.Answer()
        answer.fix = shortest_form_of(full, table, from_namespace)
        return answer
    }
    var written = path.join(".")
    return mistake_of_a_full_form(written, full, place)
}

# ../../../../spite_documentation/values_and_types.md#enums
func check_an_entry_class_member_left(
    table: Symbols.SymbolTable,
    path: List<String>,
    from_namespace: String,
    place: NameResolution.Place,
): Validators.Answer {
    var full = full_form_of(table, path, from_namespace)
    fallback not full.is_empty()
    var written = path.join(".")
    return mistake_of_a_full_form(written, full, place)
}

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func shortest_form_of(full: String, table: Symbols.SymbolTable, from_namespace: String): String {
    var own_namespace = Validators.AbstractSyntaxTree.OwnNamespace.Validator()
    var path = full.split(".")
    var nothing_taken = List<String>()
    var shortened = own_namespace.check(path, table, from_namespace, nothing_taken)
    if shortened.is_fixable() {
        return shortened.fix
    }
    return full
}

func full_form_of(table: Symbols.SymbolTable, path: List<String>, from_namespace: String): String {
    fallback path.count() >= 2
    var written = path.join(".")
    fallback not table.find(written, from_namespace)
    var owner_path = path.copy()
    var last_name = owner_path.remove_last()
    crash last_name
    var owner_name = owner_path.join(".")
    var folder = namespace_folder_named(table, owner_name, from_namespace)
    fallback folder
    var namespace_name = folder.namespace
    var is_inside = from_namespace == namespace_name or from_namespace.starts_with("{namespace_name}.")
    fallback not is_inside
    var entry = "{namespace_name}.{folder.simple_name}"
    var reached = table.find(owner_name, from_namespace)
    fallback not reached or reached.namespace == entry
    fallback entry_declares(table, entry, last_name)
    return "{entry}.{last_name}"
}

func mistake_of_a_full_form(written: String, full: String, place: NameResolution.Place): Validators.Answer {
    var parts = full.split(".")
    var last_name = parts.remove_last()
    var entry_name = parts.remove_last()
    crash last_name and entry_name
    var namespace_name = parts.join(".")
    var entry = "{namespace_name}.{entry_name}"
    var owners = [entry]
    var namings = [full]
    return mistake_through_a_namespace(written, last_name, namespace_name, owners, namings, place)
}

func namespace_folder_named(
    table: Symbols.SymbolTable,
    written: String,
    from_namespace: String,
): Mapping.MappedFolder? {
    var names = Mapping.Names()
    var searched = from_namespace
    var keep_going = true
    while keep_going {
        var candidate = names.joined(searched, written)
        var folder = table.map.folder_named(candidate)
        if folder {
            return folder
        }
        keep_going = not searched.is_empty()
        searched = table.enclosing(searched)
    }
    return null
}

func entry_declares(table: Symbols.SymbolTable, entry: String, name: String): Boolean {
    var entry_file = table.map.class_named(entry)
    fallback entry_file
    var tree = table.files[entry_file.path]
    fallback tree
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declares(declaration, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func declares(declaration: SpiteCompiler.Declaration, name: String): Boolean {
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    return declaration.name == name
}

# ../../../../spite_documentation/values_and_types.md#enums
func written_through_its_class(written: String, fix: String): String {
    var parts = written.split(".")
    var last_name = parts.last()
    crash last_name
    var fixed_parts = fix.split(".")
    var member_name = fixed_parts.remove_last()
    var class_name = fixed_parts.remove_last()
    crash member_name and class_name
    var namespace_name = fixed_parts.join(".")
    return "'{written}' reaches '{last_name}' through the namespace '{namespace_name}', which holds only classes and namespaces; named it through its class, '{fix}'"
}

func mistake_outside_its_class(
    written: String,
    owners: List<String>,
    namings: List<String>,
    place: NameResolution.Place,
): Validators.Answer {
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var text = "'{written}' is declared by the class {classes} and belongs to it: outside that class, name it through the class, {named}"
    if owners.count() > 1 {
        text = "'{written}' is declared by the classes {classes} and belongs to each: outside them, name it through the class meant, {named}"
    }
    return mistake(place, text)
}

func mistake_through_a_namespace(
    written: String,
    last_name: String,
    namespace_name: String,
    owners: List<String>,
    namings: List<String>,
    place: NameResolution.Place,
): Validators.Answer {
    var classes = listed(owners, "and")
    var named = listed(namings, "or")
    var owned = "'{last_name}' is declared by the class {classes}"
    if owners.count() > 1 {
        owned = "'{last_name}' is declared by the classes {classes}"
    }
    var text = "'{written}' reaches '{last_name}' through the namespace '{namespace_name}', which holds only classes and namespaces: {owned}, so name it through the class, {named}"
    return mistake(place, text)
}

# ../../../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func check_a_plain_name(
    written: String,
    kind: String,
    owner: String,
    through: String,
    place: NameResolution.Place,
): Validators.Answer {
    fallback not kind.is_empty()
    var text = "'{written}' is a {kind} of '{owner}', the entry class of this class's namespace, and only that class names it plainly: write '{through}.{written}'"
    return mistake(place, text)
}

func listed(names: List<String>, joining_word: String): String {
    var quoted = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        quoted.append("'{name}'")
        index = index + 1
    }
    var last_quoted = quoted.remove_last()
    crash last_quoted
    if quoted.is_empty() {
        return last_quoted
    }
    var first_ones = quoted.join(", ")
    return "{first_ones} {joining_word} {last_quoted}"
}

func mistake(place: NameResolution.Place, text: String): Validators.Answer {
    var class_name = place.class_name()
    var problem = Diagnostics.Problem(place.path, place.line, text)
    problem.class_name = class_name
    problem.function_name = place.known_function_name
    problem.is_among_the_attributes = place.known_function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

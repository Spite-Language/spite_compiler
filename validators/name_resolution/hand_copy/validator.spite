var library = Validators.LibraryFile()
var attribute_names = List<String>()
var assigns_its_own = false

func check(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    simple_name: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    assert declaration.body and library.holds(file.path) and not library.holds(declaration.path)
    var taken = types_taken(declaration)
    assert taken.contains(simple_name)
    assert assigns_an_attribute(file, declaration)
    var answering = answering_operator(file, taken)
    assert answering
    refuse(simple_name, declaration, answering)
}

func types_taken(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): List<String> {
    var taken = List<String>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var name = written_name_of(parameter)
        taken.append(name)
        index = index + 1
    }
    return taken
}

func written_name_of(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter): String {
    var written = parameter.declared_type
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        var last = written.path.last()
        crash last
        return last
    }
    return ""
}

func assigns_an_attribute(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    attribute_names = List<String>()
    file.declarations.each(note_an_attribute)
    assigns_its_own = false
    var empty = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(empty)
    walk.read_function(declaration)
    walk.statements.each(note_an_assignment)
    return assigns_its_own
}

func note_an_attribute(declared: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declared == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        attribute_names.append(declared.name)
    }
}

func note_an_assignment(found: AbstractSyntaxTree.Walk.FoundStatement) {
    note_a_statement(found.statement)
}

func note_a_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement?) {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        note_a_target(statement.target)
    }
}

func note_a_target(target: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        assigns_its_own = assigns_its_own or attribute_names.contains(target.name)
    }
}

func answering_operator(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    taken: List<String>,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    var operators = ["sum", "subtract", "multiply", "divide", "remainder", "negate"]
    var index = 0
    while index < file.declarations.count() {
        var declared = file.declarations[index]
        var answering = operator_in(declared, operators, taken)
        if answering {
            return answering
        }
        index = index + 1
    }
    return null
}

func operator_in(
    declared: AbstractSyntaxTree.Shapes.Declarations.Declaration?,
    operators: List<String>,
    taken: List<String>,
): AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? {
    if declared == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        var is_an_operator = operators.contains(declared.name) and library.holds(declared.path)
        if is_an_operator and takes_the_same(declared, taken) {
            return declared
        }
    }
    return null
}

func takes_the_same(
    operator_function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    taken: List<String>,
): Boolean {
    var wanted = types_taken(operator_function)
    var index = 0
    while index < wanted.count() {
        var name = wanted[index]
        if not taken.contains(name) {
            return false
        }
        index = index + 1
    }
    return true
}

func symbol_of(name: String): String {
    switch name {
        "sum": return "+"
        "multiply": return "*"
        "divide": return "/"
        "remainder": return "%"
        _: return "-"
    }
}

func refuse(
    simple_name: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    answering: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    var symbol = symbol_of(answering.name)
    var count = declaration.parameters.count()
    var counted = "{count} {simple_name} values"
    var written = "target = target {symbol} other"
    if count == 1 {
        counted = "a {simple_name} value"
        var only = declaration.parameters[0]
        crash only
        written = "target = target {symbol} {only.name}"
    }
    if count == 2 {
        counted = "two {simple_name} values"
        var left = declaration.parameters[0]
        var right = declaration.parameters[1]
        crash left
        crash right
        written = "target = {left.name} {symbol} {right.name}"
    }
    var text = "'{simple_name}.{declaration.name}', added by this reopening, rewrites this {simple_name} from {counted}, which the library's '{symbol}' already answers: write '{written}' (the answer is built in target's place)"
    var failure = Validators.Failure()
    var problem = Diagnostics.Problem(declaration.path, declaration.line, text)
    failure.stop(problem)
}

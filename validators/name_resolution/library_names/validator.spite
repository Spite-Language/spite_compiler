var library_names = Symbols.LibraryNames()

func check(symbols: Symbols.SymbolTable): Validators.Answer {
    fallback symbols.map.loads_the_library() and loads_a_platform(symbols)
    var waits = library_names.all_waits()
    var index = 0
    while index < waits.count() {
        var wait_answer = check_a_name(symbols, waits[index], library_names.waiting_lists)
        if wait_answer.is_a_mistake() {
            return wait_answer
        }
        index = index + 1
    }
    var relied = library_names.relied_on.keys()
    index = 0
    while index < relied.count() {
        var name = relied[index]
        var relying = library_names.relied_on[name]
        crash relying
        var relied_answer = check_a_name(symbols, name, relying)
        if relied_answer.is_a_mistake() {
            return relied_answer
        }
        index = index + 1
    }
    return Validators.Answer()
}

func loads_a_platform(symbols: Symbols.SymbolTable): Boolean {
    var platforms = ["spite_standard_library/windows", "spite_standard_library/linux", "spite_standard_library/mac"]
    var loads = false
    var index = 0
    while index < symbols.library_folders.count() {
        var folder = symbols.library_folders[index]
        var written = folder.replace("\\", "/")
        var platform = 0
        while platform < platforms.count() {
            loads = loads or written.contains(platforms[platform])
            platform = platform + 1
        }
        index = index + 1
    }
    return loads
}

func check_a_name(symbols: Symbols.SymbolTable, name: String, relying: String): Validators.Answer {
    var parts = name.split(".")
    var member = parts.remove_last()
    crash member
    var owner = parts.join(".")
    var class_files = symbols.map.class_files_of(owner)
    if class_files.is_empty() {
        return missing_class_mistake(owner, member, relying)
    }
    var declared = false
    var index = 0
    while index < class_files.count() {
        var class_file = class_files[index]
        var text = symbols.text_of_the_class(class_file.path)
        declared = declared or declares(text, member)
        index = index + 1
    }
    var last = class_files.last()
    if last and not declared {
        return missing_member_mistake(last.path, owner, member, relying)
    }
    return Validators.Answer()
}

func declares(text: String, member: String): Boolean {
    var unix_text = text.replace("\r\n", "\n").replace("\r", "\n")
    var lines = unix_text.split("\n")
    var declared = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var is_a_function = line.starts_with("func {member}(")
        var is_an_attribute = line.starts_with("var {member} ") or line.starts_with("var {member}:")
        declared = declared or is_a_function or is_an_attribute
        index = index + 1
    }
    return declared
}

func missing_class_mistake(owner: String, member: String, relying: String): Validators.Answer {
    var text = "the compiler relies on the library's '{owner}.{member}' ({relying}), and the loaded library has no class '{owner}': a renamed or removed library class must be renamed in the compiler too"
    var problem = Diagnostics.Problem("", 0, text)
    problem.class_name = ""
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func missing_member_mistake(path: String, owner: String, member: String, relying: String): Validators.Answer {
    var text = "the compiler relies on the library's '{owner}.{member}' ({relying}), and '{owner}' declares no '{member}': a renamed or removed library function or attribute must be renamed in the compiler too"
    var problem = Diagnostics.Problem(path, 0, text)
    problem.class_name = owner
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

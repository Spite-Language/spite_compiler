var library_names = Symbols.LibraryNames()

# ../../../../spite_spec/specs/failure.md#the-library-the-compiler-relies-on
func check(symbols: Symbols.SymbolTable) {
    assert symbols.map.loads_the_library()
    var waits = library_names.all_waits()
    var index = 0
    while index < waits.count() {
        check_a_name(symbols, waits[index], library_names.waiting_lists)
        index = index + 1
    }
    var relied = library_names.relied_on.keys()
    index = 0
    while index < relied.count() {
        var name = relied[index]
        var relying = library_names.relied_on[name]
        crash relying
        check_a_name(symbols, name, relying)
        index = index + 1
    }
}

func check_a_name(symbols: Symbols.SymbolTable, name: String, relying: String) {
    var parts = name.split(".")
    var member = parts.remove_last()
    crash member
    var owner = parts.join(".")
    var class_files = symbols.map.class_files_of(owner)
    if class_files.is_empty() {
        refuse_a_missing_class(owner, member, relying)
    }
    var declared = false
    var index = 0
    while index < class_files.count() {
        var class_file = class_files[index]
        var text = symbols.text_of_the_class(class_file.path)
        declared = declared or declares(text, member)
        index = index + 1
    }
    var last = class_files.last()
    if last and not declared {
        refuse_a_missing_member(last.path, owner, member, relying)
    }
}

func declares(text: String, member: String): Boolean {
    var lines = text.split("\n")
    var declared = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var is_a_function = line.starts_with("func {member}(")
        var is_an_attribute = line.starts_with("var {member} ") or line.starts_with("var {member}:")
        declared = declared or is_a_function or is_an_attribute
        index = index + 1
    }
    return declared
}

func refuse_a_missing_class(owner: String, member: String, relying: String) {
    var text = "the compiler relies on the library's '{owner}.{member}' ({relying}), and the loaded library has no class '{owner}': a renamed or removed library class must be renamed in the compiler too"
    var failure = Validators.Failure()
    failure.stop_at("", 0, "", text)
}

func refuse_a_missing_member(path: String, owner: String, member: String, relying: String) {
    var text = "the compiler relies on the library's '{owner}.{member}' ({relying}), and '{owner}' declares no '{member}': a renamed or removed library function or attribute must be renamed in the compiler too"
    var failure = Validators.Failure()
    failure.stop_at(path, 0, owner, text)
}

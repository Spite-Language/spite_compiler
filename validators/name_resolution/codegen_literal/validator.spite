# ../../../../spite_spec/specs/metaprogramming.md#codegen-values-
func check(path: String, line: Integer, argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    fallback not argument.type_reference
    var text = "a codegen value is a type, and '{argument.text}' is a value: pass it to the constructor or set an attribute, and the compiler decides the branch where the value is known"
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

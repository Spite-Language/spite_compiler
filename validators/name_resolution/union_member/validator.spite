# ../../../../spite_documentation/values_and_types.md#unions
func check(member: Model.Type, written: String, union_name: String, place: NameResolution.Place): Validators.Answer {
    fallback member.kind == 'shape'
    var text = "'{written}' cannot be a member of union '{union_name}': a union lists classes, and '{written}' is a type, a shape a class fits; list the classes themselves, or type the parameter '{written}' where any class that fits will do, and a function taking one is copied for each class"
    var problem = Diagnostics.Problem(place.path, place.line, text)
    problem.class_name = place.class_name()
    problem.is_among_the_attributes = true
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

# ../../../../spite_documentation/standard_library.md#bytes-are-a-buffer

var no_list_of_bytes = "there is no List<Byte>: bytes are a Buffer, the one class that holds them and reads the numbers in them"

func check_a_written(written_class: String, given: List<Model.Type>, place: NameResolution.Place): Validators.Answer {
    fallback names_a_list_of_bytes(written_class, given)
    var text = "{no_list_of_bytes}: write 'Buffer(0)' and add each byte with 'append(byte)'"
    return mistake(place, text)
}

func check_a_binding(
    written_class: String,
    given: List<Model.Type>,
    generic_name: String,
    binder: Model.ClassModel,
    place: NameResolution.Place,
): Validators.Answer {
    fallback names_a_list_of_bytes(written_class, given)
    var library = Mapping.LibraryFile()
    fallback not library.holds(binder.file.path)
    var text = "'{binder.shown}' binds '{generic_name}' to Byte, so its List<{generic_name}> would be a List<Byte>, and {no_list_of_bytes}: keep the bytes in a 'Buffer(0)' instead"
    return mistake(place, text)
}

func names_a_list_of_bytes(written_class: String, given: List<Model.Type>): Boolean {
    fallback written_class == "List" and given.count() == 1
    var element = given[0]
    return is_a_byte(element)
}

func is_a_byte(element: Model.Type): Boolean {
    return element.kind == 'scalar' and element.name == "Byte" and not element.is_nullable
}

func mistake(place: NameResolution.Place, text: String): Validators.Answer {
    var class_name = place.class_name()
    var function_name = place.function_name()
    var problem = Diagnostics.Problem(place.path, place.line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

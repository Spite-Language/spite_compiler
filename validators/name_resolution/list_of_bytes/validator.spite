# ../../../../spite_documentation/standard_library.md#bytes-are-a-buffer

var no_list_of_bytes = "there is no List<Byte>: bytes are a Buffer, the one class that holds them and reads the numbers in them"

func check_a_written(written_class: String, given: List<Model.Type>, place: NameResolution.Place) {
    fallback names_a_list_of_bytes(written_class, given)
    var text = "{no_list_of_bytes}: write 'Buffer(0)' and add each byte with 'append(byte)'"
    stop(place, text)
}

func check_a_binding(
    written_class: String,
    given: List<Model.Type>,
    generic_name: String,
    binder: String,
    place: NameResolution.Place,
) {
    fallback names_a_list_of_bytes(written_class, given)
    var text = "'{binder}' binds '{generic_name}' to Byte, so its List<{generic_name}> would be a List<Byte>, and {no_list_of_bytes}: keep the bytes in a 'Buffer(0)' instead"
    stop(place, text)
}

func names_a_list_of_bytes(written_class: String, given: List<Model.Type>): Boolean {
    fallback written_class == "List" and given.count() == 1
    var element = given[0]
    return is_a_byte(element)
}

func is_a_byte(element: Model.Type): Boolean {
    return element.kind == 'scalar' and element.name == "Byte" and not element.is_nullable
}

func stop(place: NameResolution.Place, text: String) {
    var class_name = place.class_name()
    var function_name = place.function_name()
    var failure = Diagnostics.Failure()
    failure.stop_inside(place.path, place.line, class_name, function_name, text)
}

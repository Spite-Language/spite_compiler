func refuse_a_question(path: String, line: Integer, shown: String) {
    stop_with(
        path,
        line,
        "'{shown}(...)' is not a question a type answers while compiling: a type is named by 'argument_class(\"<function>\", <index>)'",
    )
}

func refuse_a_missing_function(path: String, line: Integer, class_name: String, function_name: String) {
    stop_with(
        path,
        line,
        "'{class_name}' has no function '{function_name}', so 'argument_class' has no parameter to name",
    )
}

func refuse_a_missing_parameter(
    path: String,
    line: Integer,
    class_name: String,
    function_name: String,
    place: Integer,
) {
    stop_with(
        path,
        line,
        "'{class_name}.{function_name}' has no parameter {place}, counted from 0, so 'argument_class' has none to name",
    )
}

func stop_with(path: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func refuse(path: String, line: Integer, type_name: String, member_name: String) {
    var text = "the type '{type_name}' has no member named '{member_name}'"
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

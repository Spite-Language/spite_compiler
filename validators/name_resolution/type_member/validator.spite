func check_a_question(
    question: String?,
    asked: List<String>,
    path: String,
    line: Integer,
    shown: String,
): Validators.Answer {
    fallback question != "argument_class" or asked.count() != 2
    var problem = Diagnostics.Problem(
        path,
        line,
        "'{shown}(...)' is not a question a type answers while compiling: a type is named by 'argument_class(\"<function>\", <index>)'",
    )
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func check_a_function(
    function: Model.FunctionModel?,
    path: String,
    line: Integer,
    asking_class: String,
    class_name: String,
    function_name: String,
    place: String,
): Validators.Answer {
    fallback not function
    return mistake(
        path,
        line,
        asking_class,
        "",
        "'argument_class(\"{function_name}\", {place})' names the class of a parameter of '{class_name}.{function_name}', and '{class_name}' has no function '{function_name}'",
    )
}

func check_a_parameter(
    parameter: Model.ParameterModel?,
    path: String,
    line: Integer,
    asking_class: String,
    class_name: String,
    function_name: String,
    place: Integer,
    count: Integer,
): Validators.Answer {
    fallback not parameter
    return mistake(
        path,
        line,
        asking_class,
        "",
        "'{class_name}.{function_name}' takes {count} arguments, so it has no parameter {place} for 'argument_class' to name: parameters are counted from 0",
    )
}

func mistake(
    path: String,
    line: Integer,
    asking_class: String,
    function_name: String,
    text: String,
): Validators.Answer {
    var opening = asking_class.index_of("<")
    var class_name = asking_class
    if opening {
        var sliced_class_name = asking_class.slice(0, opening)
        crash sliced_class_name
        class_name = sliced_class_name
    }
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func check_a_generic(
    member: Model.Type?,
    path: String,
    line: Integer,
    asking_class: String,
    function_name: String,
    written: String,
    type_name: String,
    member_name: String,
): Validators.Answer {
    fallback not member
    return mistake(
        path,
        line,
        asking_class,
        function_name,
        "'{type_name}' has no generic '{member_name}', so '{written}' names nothing: 'generics' holds a class for each 'generic' line of a generic class",
    )
}

func check(
    member: Model.Type?,
    path: String,
    line: Integer,
    asking_class: String,
    function_name: String,
    type_name: String,
    member_name: String,
): Validators.Answer {
    fallback not member
    var article = "a"
    var first = type_name.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        article = "an"
    }
    return mistake(
        path,
        line,
        asking_class,
        function_name,
        "{article} {type_name} has no codegen value named '${member_name}': List<$element_type>, Dictionary<$key_type, $value_type> and $value_type? name theirs, and a generic class names its own",
    )
}

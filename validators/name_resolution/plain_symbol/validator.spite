func check(
    path: String,
    line: Integer,
    class_name: String,
    function_name: String,
    parameter: String,
    is_plain: Boolean,
) {
    assert is_plain
    var text = "'{function_name}' is a template on {class_name}, whose own attributes are its buffer, so a plain 'Symbol' answers nothing: write '{parameter}: Symbol<$element_type>' to name a member of the element"
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

# ../../ARCHITECTURE.md#validators
func check(
    model: Model.ProgramModel,
    symbols: Symbols.SymbolTable,
    build: Model.ClassModel?,
    folder: String,
    flags: Dictionary<String, String>,
    written_flags: List<String>,
    bare_flags: List<String>,
) {
    var circles = Validators.NameResolution.SingletonCircle.Validator()
    var circles_answer = circles.check(model)
    circles_answer.tell()
    var environment = model.class_named("Environment")
    var known = Validators.CommandLine.KnownFlag.Validator()
    var known_answer = known.check(flags, written_flags, bare_flags, build)
    known_answer.tell()
    var settings_rules = Validators.NameResolution.Settings.Validator()
    var settings_rules_answer = settings_rules.check(folder, build, environment)
    settings_rules_answer.tell()
    var library_names = Validators.NameResolution.LibraryNames.Validator()
    var library_names_answer = library_names.check(symbols)
    library_names_answer.tell()
}

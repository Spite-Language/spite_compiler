func check(literal_type: String, path: String, line: Integer, class_name: String, name: String) {
    fallback literal_type.is_empty()
    var text = "the type of '{name}' is not written, and its value is not one the compiler reads before the functions: write it, 'var {name}: Type = ...'"
    var failure = Diagnostics.Failure()
    failure.stop_at(path, line, class_name, text)
}

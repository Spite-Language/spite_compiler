func check(literal_type: String, path: String, line: Integer, class_name: String, name: String): Validators.Answer {
    fallback literal_type.is_empty()
    var text = "the type of '{name}' is not written, and its value is not one the compiler reads before the functions: write it, 'var {name}: Type = ...'"
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

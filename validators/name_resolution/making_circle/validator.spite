# ../../../PROOFS.md#objects-that-make-each-other-in-a-circle-are-an-error

var no_folders = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(no_folders)
var program = Model.ProgramModel()
var making = List<String>()
var reached_through = List<Integer>()
var link_made = List<String>()
var link_paths = List<String>()
var link_lines = List<Integer>()
var link_functions = List<String>()
var made = List<String>()
var answer = Validators.Answer()

func check(starting_program: Model.ProgramModel, starting_symbols: Symbols.SymbolTable): Validators.Answer {
    program = starting_program
    symbols = starting_symbols
    answer = Validators.Answer()
    program.order.each(visit_a_class)
    return answer
}

func visit_a_class(model: Model.ClassModel) {
    visit(model, -1)
}

func visit(model: Model.ClassModel, through: Integer) {
    fallback not made.contains(model.key) and not making.contains(model.key)
    making.append(model.key)
    reached_through.append(through)
    var links = links_of(model)
    links.each(follow)
    crash making.remove_last()
    crash reached_through.remove_last()
    made.append(model.key)
}

# ../../../../spite_documentation/classes_and_files.md#objects-that-make-each-other-in-a-circle
func links_of(model: Model.ClassModel): List<Integer> {
    var links = List<Integer>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        add_a_default_link(model, attribute, links)
        index = index + 1
    }
    var constructor = constructor_of(model)
    if constructor {
        add_the_constructor_links(model, constructor, links)
    }
    return links
}

func add_a_default_link(model: Model.ClassModel, attribute: Model.AttributeModel, links: List<Integer>) {
    fallback attribute.declaration
    var value = attribute.declaration.value
    var made_class = class_made_into(attribute, value)
    fallback made_class
    var path = written_in(model, attribute.declaration.path)
    var link = new_link(made_class.key, path, attribute.declaration.line, "")
    links.append(link)
}

func new_link(made_key: String, path: String, line: Integer, function_name: String): Integer {
    link_made.append(made_key)
    link_paths.append(path)
    link_lines.append(line)
    link_functions.append(function_name)
    return link_made.count() - 1
}

# ../../../../spite_documentation/classes_and_files.md#objects-that-make-each-other-in-a-circle
func class_made_into(attribute: Model.AttributeModel, value: SpiteCompiler.Expression?): Model.ClassModel? {
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback attribute.attribute_type.kind == 'object'
    var made_class = program.class_named(attribute.attribute_type.name)
    fallback made_class and constructs(value, made_class)
    return made_class
}

# ../../../../spite_documentation/classes_and_files.md#objects-that-make-each-other-in-a-circle
func constructs(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, made_class: Model.ClassModel): Boolean {
    fallback not made_class.is_singleton
    var callee = call.callee
    var name = ""
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        name = callee.name
    }
    var simple = simple_name_of(made_class)
    fallback name == simple
    var conversion = made_class.read_conversion()
    return not conversion or call.arguments.count() != 1
}

func simple_name_of(model: Model.ClassModel): String {
    var namespace = model.file.namespace
    if namespace.is_empty() {
        namespace = model.key
    }
    var parts = namespace.split(".")
    var last = parts.last()
    crash last
    return last
}

func written_in(model: Model.ClassModel, path: String): String {
    if path.is_empty() {
        return model.file.path
    }
    return path
}

func constructor_of(model: Model.ClassModel): Model.FunctionModel? {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.is_a_constructor() and function.declaration {
            return function
        }
        index = index + 1
    }
    return null
}

# ../../../../spite_documentation/classes_and_files.md#objects-that-make-each-other-in-a-circle
func add_the_constructor_links(model: Model.ClassModel, constructor: Model.FunctionModel, links: List<Integer>) {
    crash constructor.declaration
    fallback constructor.declaration.body
    var path = written_in(model, constructor.declaration.path)
    var index = 0
    while index < constructor.declaration.body.statements.count() {
        var statement = constructor.declaration.body.statements[index]
        fallback runs_on_every_path(statement)
        var made_class = class_made_by(model, statement)
        if made_class {
            var line = line_of(statement)
            var link = new_link(made_class.key, path, line, constructor.name)
            links.append(link)
        }
        index = index + 1
    }
}

# ../../../../spite_documentation/classes_and_files.md#objects-that-make-each-other-in-a-circle
func runs_on_every_path(statement: SpiteCompiler.WrittenStatement?): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return true
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return true
    }
    return statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
}

func line_of(statement: SpiteCompiler.WrittenStatement?): Integer {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.line
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return statement.line
    }
    return 0
}

func class_made_by(model: Model.ClassModel, statement: SpiteCompiler.WrittenStatement?): Model.ClassModel? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return class_made_into_a_local(model, statement.value)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return class_made_into_an_attribute(model, statement)
    }
    return null
}

func class_made_into_an_attribute(
    model: Model.ClassModel,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
): Model.ClassModel? {
    var target = statement.target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var attribute = model.attribute_named(target.name)
    fallback attribute
    return class_made_into(attribute, statement.value)
}

func class_made_into_a_local(model: Model.ClassModel, value: SpiteCompiler.Expression?): Model.ClassModel? {
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    var path = path_of(value.callee)
    fallback not path.is_empty()
    var written = path.join(".")
    var found = symbols.find(written, model.file.namespace)
    fallback found
    var made_class = program.class_named(found.namespace)
    fallback made_class and constructs(value, made_class)
    return made_class
}

func path_of(expression: SpiteCompiler.Expression?): List<String> {
    var path = List<String>()
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        path.append(expression.name)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var outer = path_of(expression.target)
        if not outer.is_empty() {
            outer.append(expression.name)
        }
        return outer
    }
    return path
}

func follow(link: Integer) {
    var made_key = link_made[link]
    crash made_key
    var start = making.index_of(made_key)
    if start {
        add_a_circle(link, start)
    }
    var bound = program.class_named(made_key)
    crash bound
    visit(bound, link)
}

# ../../../PROOFS.md#objects-that-make-each-other-in-a-circle-are-an-error
func add_a_circle(closing: Integer, start: Integer) {
    var circle = List<Model.ClassModel>()
    var index = start
    while index < making.count() {
        var key = making[index]
        var link = program.class_named(key)
        crash link
        circle.append(link)
        index = index + 1
    }
    var opening = closing
    if start + 1 < making.count() {
        var reached = reached_through[start + 1]
        crash reached
        opening = reached
    }
    var first = circle[0]
    crash first
    add_a_mistake(first, opening, circle)
}

func add_a_mistake(model: Model.ClassModel, opening: Integer, circle: List<Model.ClassModel>) {
    var chain = "'{model.shown}'"
    var step = 1
    while step <= circle.count() {
        var at = step % circle.count()
        var link = circle[at]
        crash link
        var joined = ", which"
        if step == 1 {
            joined = ""
        }
        chain = "{chain}{joined} makes '{link.shown}'"
        step = step + 1
    }
    var text = "{chain}: objects that make each other in a circle never finish being made, so one of them has to be handed in through a constructor or made only where it is needed"
    var opening_bracket = model.shown.index_of("<")
    var class_name = model.shown
    if opening_bracket {
        var sliced_class_name = model.shown.slice(0, opening_bracket)
        crash sliced_class_name
        class_name = sliced_class_name
    }
    var path = link_paths[opening]
    var line = link_lines[opening]
    var function_name = link_functions[opening]
    crash path and line and function_name
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    answer.mistakes.append(problem)
}

func refuse_a_symbol(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    written: String,
    advice: String,
) {
    var text = "'{parameter}: Symbol<{written}>' is not a type: a parameter named by a word of its function's name makes the function a template, its type says what it ranges over, and the body says over which class: {advice}"
    stop(path, line, class_shown, function_name, text)
}

func refuse_a_written_owner(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    written_type: String,
    owner: String,
    advice: String,
) {
    var text = "'{parameter}: {written_type}<{owner}>' names its class, but a template's class comes from its body: {advice}"
    stop(path, line, class_shown, function_name, text)
}

func refuse_an_unused_attribute(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
) {
    var text = "'{function_name}' is a template over the attributes of a class, because '{parameter}' is a word of its name, but its body reads '{parameter}' on no value, so nothing says which class: read it as 'value[{parameter}]' on a value of the class it walks"
    stop(path, line, class_shown, function_name, text)
}

func refuse_an_unused_function(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
) {
    var text = "'{function_name}' is a template over functions, because '{parameter}' is a word of its name, but its body calls no function with '{parameter}' in its name, so nothing says which: call one as 'value.{parameter}_each(...)', where '{parameter}' stands for the part of the name that varies"
    stop(path, line, class_shown, function_name, text)
}

func refuse_an_unknown_value(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    value: String,
) {
    var text = "'{function_name}' uses '{parameter}' on '{value}', whose class is not known from its declaration, so nothing says which class it walks: use it on a parameter, an attribute or a local declared with its type, as in 'var {value}: Monster = ...'"
    stop(path, line, class_shown, function_name, text)
}

func refuse_no_common_attribute(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    first_class: String,
    second_class: String,
) {
    var text = "'{function_name}' reads '{parameter}' on a '{first_class}' and on a '{second_class}', which have no attribute in common, so it would walk nothing: read it only on values whose classes share the attributes it walks"
    stop(path, line, class_shown, function_name, text)
}

func refuse_an_unknown_argument_owner(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    called: String,
) {
    var text = "'{called}' walks the arguments of a function, but nothing here says which: spread it into a call, as in 'value.update_each({called}())', or call it inside a template over 'Spite.FunctionDeclaration', where it walks the arguments of that function"
    stop(path, line, class_shown, function_name, text)
}

func refuse_an_unmatched_hole(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    called: String,
    template: String,
    hole: String,
    parameter: String,
    walked: String,
    missing: String,
    matched: String,
) {
    var text = "'{called}' is '{template}' with '{hole}' for '{parameter}', but '{walked}' has no function '{missing}': {matched}"
    stop(path, line, class_shown, function_name, text)
}

func stop(path: String, line: Integer, class_shown: String, function_name: String, text: String) {
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening >= 0 {
        class_name = class_shown.slice(0, opening)
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

func check_a_range(
    parameter: String,
    written_type: String,
    owner: String,
    symbol_advice: String,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
) {
    if written_type == "Symbol" {
        var symbol_text = "'{parameter}: Symbol<{owner}>' is not a type: a parameter named by a word of its function's name makes the function a template, its type says what it ranges over, and the body says over which class: {symbol_advice}"
        stop(path, line, class_shown, function_name, symbol_text)
    }
    var ranges = ["Spite.AttributeDeclaration", "Spite.Attribute", "Spite.FunctionDeclaration", "Spite.Argument"]
    fallback ranges.contains(written_type)
    var advice = "write '{parameter}: Spite.AttributeDeclaration' and read it as 'value[{parameter}]' on a value of '{owner}'"
    if written_type == "Spite.FunctionDeclaration" {
        advice = "write '{parameter}: Spite.FunctionDeclaration' and call the function on a value of '{owner}', as in 'value.{parameter}_each(...)'"
    }
    if written_type == "Spite.Argument" {
        advice = "write '{parameter}: Spite.Argument' and spread its plural into a call of the function whose arguments it walks"
    }
    var text = "'{parameter}: {written_type}<{owner}>' names its class, but a template's class comes from its body: {advice}"
    stop(path, line, class_shown, function_name, text)
}

func check_an_attribute_owner(
    owner: Model.Type?,
    is_passed_on: Boolean,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    value: String,
) {
    fallback not owner and not is_passed_on
    var text = "'{function_name}' is a template over the attributes of a class, because '{parameter}' is a word of its name, but its body reads '{parameter}' on no value, so nothing says which class: read it as '{value}[{parameter}]' on a value of the class it walks"
    stop(path, line, class_shown, function_name, text)
}

func check_a_function_owner(
    owner: Model.Type?,
    is_passed_on: Boolean,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
) {
    fallback not owner and not is_passed_on
    var text = "'{function_name}' is a template over functions, because '{parameter}' is a word of its name, but its body calls no function with '{parameter}' in its name, so nothing says which: call one as 'value.{parameter}_each(...)', where '{parameter}' stands for the part of the name that varies"
    stop(path, line, class_shown, function_name, text)
}

func check_a_known_value(
    known: Model.Type?,
    target: Expression?,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
) {
    fallback not known
    crash target
    var printer = Printers.Spite.ExpressionPrinter(target)
    var value = printer.text()
    var text = "'{function_name}' uses '{parameter}' on '{value}', whose class is not known from its declaration, so nothing says which class it walks: use it on a parameter, an attribute or a local declared with its type, as in 'var {value}: Monster = ...'"
    stop(path, line, class_shown, function_name, text)
}

func check_a_common_attribute(
    common: List<String>,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    parameter: String,
    first_class: String,
    second_class: String,
) {
    fallback common.is_empty()
    var text = "'{function_name}' reads '{parameter}' on a '{first_class}' and on a '{second_class}', which have no attribute in common, so it would walk nothing: read it only on values whose classes share the attributes it walks"
    stop(path, line, class_shown, function_name, text)
}

func check_an_argument_owner(
    owner: Model.Type?,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    called: String,
) {
    fallback not owner
    var text = "'{called}' walks the arguments of a function, but nothing here says which: spread it into a call, as in 'value.update_each({called}())', or call it inside a template over 'Spite.FunctionDeclaration', where it walks the arguments of that function"
    stop(path, line, class_shown, function_name, text)
}

func check_a_matched_hole(
    place: Integer?,
    fitting: List<String>,
    function_part: String,
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    called: String,
    template: String,
    hole: String,
    parameter: String,
    walked: String,
    missing: String,
) {
    fallback not place
    var matched = "it has no function that fits '{function_part}'"
    if not fitting.is_empty() {
        var listed = fitting.join(", ")
        matched = "the functions there that fit '{function_part}' are {listed}"
    }
    var text = "'{called}' is '{template}' with '{hole}' for '{parameter}', but '{walked}' has no function '{missing}': {matched}"
    stop(path, line, class_shown, function_name, text)
}

func stop(path: String, line: Integer, class_shown: String, function_name: String, text: String) {
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening {
        var sliced_class_name = class_shown.slice(0, opening)
        crash sliced_class_name
        class_name = sliced_class_name
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

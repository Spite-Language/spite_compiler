func refuse(path: String, line: Integer, class_shown: String, written: String, suggestion: String) {
    var text = "unknown type '{written}'"
    if not suggestion.is_empty() {
        text = "unknown type '{written}': did you mean '{suggestion}'?"
    }
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening >= 0 {
        class_name = class_shown.slice(0, opening)
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, "", text)
}

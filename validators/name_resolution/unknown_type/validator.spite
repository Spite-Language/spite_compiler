# ../../../../spite_documentation/values_and_types.md#enums
func check_a_symbol(written: String, place: NameResolution.Place) {
    fallback written == "Symbol"
    var text = "there is no type 'Symbol': a name in single quotes is an enum value literal, so declare an enum that lists the names and use it, and text is a String"
    var function_name = place.function_name()
    stop(place, function_name, text)
}

func check_a_removed_form(
    written: String,
    symbols: Symbols.SymbolTable,
    namespace: String,
    place: NameResolution.Place,
) {
    fallback written == "Parallel" or written == "Concurrent"
    fallback not symbols.find(written, namespace)
    var function_name = place.function_name()
    var class_name = place.class_name()
    var removed = Validators.AbstractSyntaxTree.RemovedForms.Validator()
    removed.refuse(place.path, place.line, class_name, function_name, written)
}

func check_a_class_known_while_compiling(
    written: String,
    names_a_run_time_value: Boolean,
    place: NameResolution.Place,
) {
    fallback names_a_run_time_value
    var text = "'{written}' is not a class known while compiling, so it cannot be a type here"
    var function_name = place.function_name()
    stop(place, function_name, text)
}

func check(written: String, found: Mapping.ClassFile?, suggestion: String, place: NameResolution.Place) {
    fallback not found
    var text = "unknown type '{written}'"
    if not suggestion.is_empty() {
        text = "unknown type '{written}': did you mean '{suggestion}'?"
    }
    var function_name = place.function_name()
    stop(place, function_name, text)
}

func stop(place: NameResolution.Place, function_name: String, text: String) {
    var class_name = place.class_name()
    var failure = Diagnostics.Failure()
    failure.stop_inside(place.path, place.line, class_name, function_name, text)
}

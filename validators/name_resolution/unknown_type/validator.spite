func refuse(
    path: String,
    line: Integer,
    class_shown: String,
    function_name: String,
    written: String,
    suggestion: String,
) {
    var text = "unknown type '{written}'"
    if not suggestion.is_empty() {
        text = "unknown type '{written}': did you mean '{suggestion}'?"
    }
    var class_name = class_name_of(class_shown)
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

# ../../../../spite_spec/specs/values_and_types.md#enums-in-full
func refuse_a_symbol(path: String, line: Integer, class_shown: String, function_name: String) {
    var text = "there is no type 'Symbol': a name in single quotes is an enum value literal, so declare an enum that lists the names and use it, and text is a String"
    var class_name = class_name_of(class_shown)
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

func refuse_a_run_time_class(path: String, line: Integer, class_shown: String, function_name: String, written: String) {
    var text = "'{written}' is not a class known while compiling, so it cannot be a type here"
    var class_name = class_name_of(class_shown)
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

func class_name_of(class_shown: String): String {
    var opening = class_shown.index_of("<")
    if opening {
        var sliced = class_shown.slice(0, opening)
        crash sliced
        return sliced
    }
    return class_shown
}

# ../../../PROOFS.md#singletons-that-make-each-other-in-a-circle-are-an-error
var program = Model.ProgramModel()
var making = List<String>()
var reached_through = List<Model.AttributeModel>()
var made = List<String>()

func check(starting_program: Model.ProgramModel) {
    program = starting_program
    var entry = program.class_named(program.entry)
    crash entry
    visit_the_bindings(entry)
    program.order.each(visit_a_singleton)
}

func visit_a_singleton(model: Model.ClassModel) {
    assert model.is_singleton
    var nothing = Model.Type('nothing', "")
    var started = Model.AttributeModel("", "", nothing)
    visit(model, started)
}

func visit(model: Model.ClassModel, through: Model.AttributeModel) {
    assert not made.contains(model.key) and not making.contains(model.key)
    making.append(model.key)
    reached_through.append(through)
    visit_the_bindings(model)
    making.remove_last()
    reached_through.remove_last()
    made.append(model.key)
}

func visit_the_bindings(model: Model.ClassModel) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var bound = class_made_by(attribute)
        if bound {
            follow(attribute, bound)
        }
        index = index + 1
    }
}

# ../../../PROOFS.md#singletons-that-make-each-other-in-a-circle-are-an-error
func class_made_by(attribute: Model.AttributeModel): Model.ClassModel? {
    assert attribute.declaration
    assert is_a_construction(attribute.declaration.value)
    assert attribute.attribute_type.kind == 'object' and not attribute.attribute_type.is_nullable
    return program.class_named(attribute.attribute_type.name)
}

func is_a_construction(value: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return true
    }
    return false
}

func follow(attribute: Model.AttributeModel, bound: Model.ClassModel) {
    var start = making.index_of(bound.key)
    if start {
        refuse_a_circle(attribute, start)
    }
    visit(bound, attribute)
}

# ../../../PROOFS.md#singletons-that-make-each-other-in-a-circle-are-an-error
func refuse_a_circle(attribute: Model.AttributeModel, start: Integer) {
    var circle = List<Model.ClassModel>()
    var index = start
    while index < making.count() {
        var key = making[index]
        var link = program.class_named(key)
        crash link
        circle.append(link)
        index = index + 1
    }
    var told_from = -1
    index = 0
    while index < circle.count() {
        var link = circle[index]
        if link.is_singleton {
            told_from = index
        }
        index = index + 1
    }
    assert told_from >= 0
    var opening = circle[told_from]
    crash opening
    var closing = attribute
    if told_from + 1 < circle.count() {
        var reached = reached_through[start + told_from + 1]
        crash reached
        closing = reached
    }
    refuse(opening, closing, circle, told_from)
}

func refuse(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    circle: List<Model.ClassModel>,
    told_from: Integer,
) {
    var chain = "singleton '{model.shown}'"
    var step = 1
    while step <= circle.count() {
        var at = (told_from + step) % circle.count()
        var link = circle[at]
        crash link
        var verb = "makes"
        if link.is_singleton {
            verb = "binds"
        }
        var joined = ", which"
        if step == 1 {
            joined = ""
        }
        chain = "{chain}{joined} {verb} '{link.shown}'"
        step = step + 1
    }
    var text = "{chain}: singletons initialise each other in a circle, so one of them has to reach the other some other way, such as by binding it in the class that uses both"
    var line = 0
    if attribute.declaration {
        line = attribute.declaration.line
    }
    var opening = model.shown.index_of("<")
    var class_name = model.shown
    if opening {
        class_name = model.shown.slice(0, opening)
    }
    var failure = Validators.Failure()
    failure.stop_inside(model.file.path, line, class_name, "", text)
}

func check(path: String, line: Integer, written: String, parameter_count: Integer, argument_count: Integer) {
    assert parameter_count != argument_count
    var text = text_of(written, parameter_count, argument_count)
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(written: String, parameter_count: Integer, argument_count: Integer): String {
    if parameter_count == 0 {
        return "'{written}' is not a generic class, so it takes no type in '<>': write '{written}' alone"
    }
    if argument_count == 0 {
        return "the class '{written}' is generic and needs its type, as in '{written}<Integer>'"
    }
    return "the class '{written}' takes {parameter_count} types in '<>', and {argument_count} are written"
}

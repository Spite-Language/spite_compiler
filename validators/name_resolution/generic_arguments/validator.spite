func check(path: String, line: Integer, written: String, names: List<String>, argument_count: Integer) {
    var parameter_count = names.count()
    fallback parameter_count != argument_count
    var text = text_of(written, names, argument_count)
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(written: String, names: List<String>, argument_count: Integer): String {
    var parameter_count = names.count()
    if parameter_count == 0 {
        return "'{written}' is not a generic class, so it takes no type in '<>': write '{written}' alone"
    }
    var parts = written.split(".")
    var plain = parts.last()
    crash plain
    var listed = names.join(", ")
    if argument_count == 0 {
        return "'{plain}' takes {parameter_count} codegen value(s), in this order: {listed}. Write them between < and > before the arguments"
    }
    return "'{plain}' takes {parameter_count} codegen value(s), in this order: {listed}, but {argument_count} were given"
}

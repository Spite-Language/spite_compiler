# ../../../../spite_documentation/metaprogramming.md#member-templates
func check(
    class_shown: String,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    template_index: Integer,
): Validators.Answer {
    var parameter = declaration.parameters[template_index]
    crash parameter
    var words = declaration.name.split("_")
    fallback words.contains(parameter.name)
    fallback collects(declaration.result, parameter.name)
    var plural_words = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        if word == parameter.name {
            plural_words.append("{word}s")
        } else {
            plural_words.append(word)
        }
        index = index + 1
    }
    var called_plural = plural_words.join("_")
    var owner_name = class_shown
    var opening = class_shown.index_of("<")
    if opening {
        var sliced_owner_name = class_shown.slice(0, opening)
        crash sliced_owner_name
        owner_name = sliced_owner_name
    }
    var text = "'{declaration.name}' answers every '{parameter.name}', so it is written in the plural: '{called_plural}'"
    var problem = Diagnostics.Problem(declaration.path, declaration.line, text)
    problem.class_name = owner_name
    problem.function_name = declaration.name
    problem.is_among_the_attributes = declaration.name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func collects(result: SpiteCompiler.Type?, name: String): Boolean {
    if result.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        return is_a_list_of_its_class(result, name)
    }
    return false
}

func is_a_list_of_its_class(result: AbstractSyntaxTree.Shapes.Types.NamedType, name: String): Boolean {
    var written = result.path.join(".")
    fallback written == "List" and result.arguments.count() == 1
    var argument = result.arguments[0]
    var held = argument.type_reference
    if held.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var held_written = held.path.join(".")
        return held_written == "{name}.class"
    }
    return false
}

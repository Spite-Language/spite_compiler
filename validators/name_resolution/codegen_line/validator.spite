func check(path: String, line: Integer, class_shown: String, name: String, bound: Model.Type?): Validators.Answer {
    fallback not bound
    var text = "this class has no 'generic {name}' line, so '{name}' cannot be used as a type"
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening {
        var sliced_class_name = class_shown.slice(0, opening)
        crash sliced_class_name
        class_name = sliced_class_name
    }
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    problem.function_name = ""
    problem.is_among_the_attributes = true
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

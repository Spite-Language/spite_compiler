func check(path: String, line: Integer, class_shown: String, name: String, bound: Model.Type?) {
    assert not bound
    var text = "this class has no 'generic {name}' line, so '{name}' cannot be used as a type"
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening >= 0 {
        class_name = class_shown.slice(0, opening)
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, "", text)
}

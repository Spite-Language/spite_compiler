func check(path: String, line: Integer, class_shown: String, parameter: String, is_bound: Boolean) {
    assert is_bound
    var text = "'{parameter}: Spite.Attribute<...>' would be bound to one instance, and a template is made once for each member of the class, with the instance as its own argument: write '{parameter}: Spite.AttributeDeclaration<...>'"
    var opening = class_shown.index_of("<")
    var class_name = class_shown
    if opening >= 0 {
        class_name = class_shown.slice(0, opening)
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, "", text)
}

var literal_kinds = ["Boolean", "Integer", "String"]

func check(folder: String, build: Model.ClassModel?, environment: Model.ClassModel?): Validators.Answer {
    if build {
        var build_answer = check_the_build(folder, build)
        if build_answer.is_a_mistake() {
            return build_answer
        }
    }
    fallback environment
    return check_the_environment(folder, environment, build)
}

func check_the_build(folder: String, build: Model.ClassModel): Validators.Answer {
    var format = build.attribute_named("format")
    if format {
        return mistake_at(
            "{folder}/build.spite",
            format,
            "'Build.format' cannot be declared: every compile formats the program's own files first, and nothing turns that off: '--check' formats and checks a program without building it",
        )
    }
    var target_answer = check_a_supplied_field(
        folder,
        build,
        "target_operating_system",
        "'Build.target_operating_system' cannot be declared by a program: the standard library for the target system is loaded before the program, so the target is given to the compiler, --target-operating-system=linux (or windows, or mac), and is the system doing the compiling otherwise",
    )
    if target_answer.is_a_mistake() {
        return target_answer
    }
    var system_answer = check_a_supplied_field(
        folder,
        build,
        "operating_system",
        "'Build.operating_system' cannot be declared by a program: it is the system doing the compiling, which the compiler supplies. To write the program for another system, give --target-operating-system=linux (or windows, or mac)",
    )
    if system_answer.is_a_mistake() {
        return system_answer
    }
    return check_a_supplied_field(
        folder,
        build,
        "program",
        "'Build.program' cannot be declared by a program: the program is the folder the compiler runs in, 'cd folder' then 'spite', and Build.program is set from it",
    )
}

func check_a_supplied_field(folder: String, build: Model.ClassModel, name: String, text: String): Validators.Answer {
    var declared = build.attribute_named(name)
    fallback declared
    fallback is_the_programs(declared, folder)
    return mistake_at("{folder}/build.spite", declared, text)
}

# ../../../../spite_documentation/programs.md#compile-time-settings-build
func check_the_option(attribute: Model.AttributeModel): Validators.Answer {
    crash attribute.declaration
    fallback not is_a_plain_literal(attribute.declaration.value)
    return mistake_at(
        attribute.declaration.path,
        attribute,
        "'Build.{attribute.name}' is one of the compiler's options, which the compiler reads while compiling, before anything runs, so it is declared with only a literal: true or false, a whole number, or a text without holes, like 'var {attribute.name} = ...' in build.spite",
    )
}

func is_a_plain_literal(value: SpiteCompiler.Expression?): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return true
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return is_a_plain_text(value)
    }
    return false
}

func is_a_plain_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    fallback text.pieces.count() <= 1
    var piece = text.pieces.first()
    if not piece {
        return true
    }
    return not piece.hole
}

func is_the_programs(attribute: Model.AttributeModel, folder: String): Boolean {
    fallback attribute.declaration
    var declared_in = attribute.declaration.path.replace("\\", "/")
    var forward_folder = folder.replace("\\", "/")
    return declared_in == "{forward_folder}/build.spite"
}

func check_the_environment(folder: String, environment: Model.ClassModel, build: Model.ClassModel?): Validators.Answer {
    var index = 0
    while index < environment.declared_attributes.count() {
        var attribute = environment.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            var setting_answer = check_a_setting(folder, attribute, build)
            if setting_answer.is_a_mistake() {
                return setting_answer
            }
        }
        index = index + 1
    }
    return Validators.Answer()
}

func check_a_setting(folder: String, attribute: Model.AttributeModel, build: Model.ClassModel?): Validators.Answer {
    var where = "{folder}/environment.spite"
    if build {
        var flag = build.attribute_named(attribute.name)
        if flag and is_the_programs(flag, folder) {
            var upper = attribute.name.upper_case()
            var kebab = attribute.name.replace("_", "-")
            return mistake_at(
                where,
                attribute,
                "'Environment.{attribute.name}' and 'Build.{attribute.name}' are both '--{kebab}': the program's Build is given when it is compiled and its Environment when it runs, and both are read from {upper} in the environment too, so one of them needs another name",
            )
        }
    }
    crash attribute.declaration
    var is_literal = not attribute.declaration.declared_type and literal_kinds.contains(attribute.attribute_type.name)
    var is_an_enum = attribute.attribute_type.kind == 'enumeration' and is_a_plain_literal(attribute.declaration.value)
    fallback not is_literal and not is_an_enum
    var upper = attribute.name.upper_case()
    return mistake_at(
        where,
        attribute,
        "'Environment.{attribute.name}' is a setting, read from the program's command line (--{attribute.name}=value) or its environment ({upper}), so it is declared with only a literal default, and the literal is its type: 'var {attribute.name} = false' (Boolean), 'var {attribute.name} = 0' (Integer) or 'var {attribute.name} = \"\"' (String), or one value of an enum the Environment declares, its type written: 'var {attribute.name}: Kind = ...'",
    )
}

func mistake_at(path: String, attribute: Model.AttributeModel, text: String): Validators.Answer {
    var line = 0
    if attribute.declaration {
        line = attribute.declaration.line
    }
    var problem = Diagnostics.Problem(path, line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

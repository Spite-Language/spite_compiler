var literal_kinds = ["Boolean", "Integer", "String"]

func check(folder: String, build: Model.ClassModel?, environment: Model.ClassModel?) {
    if build {
        check_the_build(folder, build)
    }
    assert environment
    check_the_environment(folder, environment, build)
}

func check_the_build(folder: String, build: Model.ClassModel) {
    var format = build.attribute_named("format")
    if format {
        refuse_at(
            "{folder}/build.spite",
            format,
            "'Build.format' cannot be declared: every compile formats the program's own files first, and nothing turns that off: '--check' formats and checks a program without building it",
        )
    }
    var target = build.attribute_named("target_operating_system")
    assert target
    assert is_the_programs(target, folder)
    refuse_at(
        "{folder}/build.spite",
        target,
        "'Build.target_operating_system' cannot be declared by a program: the standard library for the target system is loaded before the program, so the target is given to the compiler, --target-operating-system=linux (or windows, or mac), and is the system doing the compiling otherwise",
    )
}

func is_the_programs(attribute: Model.AttributeModel, folder: String): Boolean {
    var file = File("{folder}/build.spite")
    var text = file.read()
    if not text {
        return false
    }
    return text.contains("var {attribute.name}")
}

func check_the_environment(folder: String, environment: Model.ClassModel, build: Model.ClassModel?) {
    var index = 0
    while index < environment.declared_attributes.count() {
        var attribute = environment.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            check_a_setting(folder, attribute, build)
        }
        index = index + 1
    }
}

func check_a_setting(folder: String, attribute: Model.AttributeModel, build: Model.ClassModel?) {
    var where = "{folder}/environment.spite"
    if build {
        var flag = build.attribute_named(attribute.name)
        if flag {
            var kebab = attribute.name.replace("_", "-")
            refuse_at(
                where,
                attribute,
                "'Environment.{attribute.name}' and 'Build.{attribute.name}' are both '--{kebab}' on the command line: a program's settings and the compiler's flags share one set of names, so one of them needs another name",
            )
        }
    }
    crash attribute.declaration
    var is_literal = not attribute.declaration.declared_type and literal_kinds.contains(attribute.attribute_type.name)
    assert not is_literal
    var upper = attribute.name.upper_case()
    refuse_at(
        where,
        attribute,
        "'Environment.{attribute.name}' is a setting, read from the program's command line (--{attribute.name}=value) or its environment ({upper}), so it is declared with only a literal default, and the literal is its type: 'var {attribute.name} = false' (Boolean), 'var {attribute.name} = 0' (Integer) or 'var {attribute.name} = \"\"' (String)",
    )
}

func refuse_at(path: String, attribute: Model.AttributeModel, text: String) {
    var line = 0
    if attribute.declaration {
        line = attribute.declaration.line
    }
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

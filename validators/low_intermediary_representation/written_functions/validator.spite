var written = Dictionary<String, Boolean>()

func check(program: LowIntermediaryRepresentation.LoweredProgram) {
    program.lowered_functions.each(note_a_written)
    program.lowered_functions.each(check_the_calls_of)
    if program.gates_crashes {
        check_a_target("_crash_gate", "")
    }
}

func note_a_written(function: LowIntermediaryRepresentation.LowFunction) {
    written[function.key] = true
}

func check_the_calls_of(function: LowIntermediaryRepresentation.LowFunction) {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Call {
                check_a_target(instruction.function, function.key)
            } else if instruction.class == LowIntermediaryRepresentation.Instructions.FunctionAddress {
                check_a_target(instruction.function, function.key)
            } else if instruction.class == LowIntermediaryRepresentation.Instructions.StartThread {
                check_a_target(instruction.entry, function.key)
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
}

func check_a_target(key: String, caller: String) {
    fallback written[key] != true
    var failure = Validators.Failure()
    failure.stop_at("", 0, caller, "the function '{key}' is called but was never written: this is a fault of the compiler")
}

func refuse(unwritable: Unwritable, detail: String) {
    var text = text_of(unwritable, detail)
    var problem = Diagnostics.Problem("", 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(unwritable: Unwritable, detail: String): String {
    switch unwritable {
        'instruction': return "the instruction '{detail}' cannot be written to machine code yet"
        'operation': return "the operation '{detail}' cannot be written to machine code yet"
        'whole_number': return "'{detail}' is not a whole number the machine code can hold: this is a fault of the compiler"
        'long_answer': return "the foreign function '{detail}' answers a Long, and that is not built yet"
        'double_answer': return "the foreign function '{detail}' answers a Double, and that is not built yet"
        'text_answer': return "the foreign function '{detail}' answers text, and that is not built yet"
        'jump_target': return "a jump in '{detail}' goes to an instruction that is not there: this is a fault of the compiler"
        'missing_function': return "the function '{detail}' is called but was never written: this is a fault of the compiler"
        'ambiguous_function': return "the call '{detail}' does not say which class it means, and more than one class has that function"
        'missing_entry': return "the entry function of '{detail}' was never written: this is a fault of the compiler"
        'defaulted_fresh_slot': return "'{detail}' assigns attributes it expects empty, but this object is made with their defaults: this is a fault of the compiler"
        'shared_part': return "'{detail}' holds its object inside it, but a value written into it is held elsewhere too: this is a fault of the compiler"
        'unhanded_call': return "a call of '{detail}' does not hand it the count it keeps: this is a fault of the compiler"
    }
}

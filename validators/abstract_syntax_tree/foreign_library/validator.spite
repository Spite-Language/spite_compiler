union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var naming_rules = ["identity", "windows", "camel_case"]

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(found, expression)
    }
}

func check_call(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    var is_a_library = false
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_a_library = callee.name == "DynamicLibrary"
    }
    fallback is_a_library and call.arguments.count() == 3
    var file_name = literal_text_of(call.arguments[0])
    var rule = call.arguments[1]
    var header = literal_text_of(call.arguments[2])
    var rule_is_a_symbol = false
    if rule.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        rule_is_a_symbol = rule.kind == 'symbol_literal'
    }
    if not file_name or not header or not rule_is_a_symbol {
        refuse(
            found,
            "DynamicLibrary(...) takes three literals the compiler reads while it compiles: the file, the naming rule ('identity', 'windows' or 'camel_case') and the header",
        )
    }
    crash file_name
    if not file_name.contains(".") {
        refuse(
            found,
            "'{file_name}' has no extension: name the library file exactly as it is on disk, like \"user32.dll\" or \"libc.so.6\" (a wrapper for another platform names that platform's file)",
        )
    }
    check_the_rule(found, rule)
}

func check_the_rule(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    rule: Expression?,
) {
    if rule.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        fallback not naming_rules.contains(rule.text)
        refuse(
            found,
            "'{rule.text}' is not a naming rule: a library's functions are named 'identity', 'windows' or 'camel_case'",
        )
    }
}

func literal_text_of(argument: Expression?): String? {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(argument)
    }
    return null
}

func plain_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() <= 1
    if literal.pieces.is_empty() {
        return ""
    }
    var piece = literal.pieces[0]
    fallback not piece.hole
    return piece.text
}

func refuse(found: AbstractSyntaxTree.Walk.Found.Expression, text: String) {
    var failure = Validators.Failure()
    failure.stop_inside(walk.file.path, found.line, class_name, found.function_name, text)
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk(empty_file)
var class_name = ""
var gathered = Validators.Answer()

func check(starting_walk: AbstractSyntaxTree.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    walk = starting_walk
    class_name = starting_class_name
    walk.expressions.each(check_found)
    return gathered
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(found, expression)
    }
}

func check_call(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    var is_a_library = false
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_a_library = callee.name == "DynamicLibrary"
    }
    fallback is_a_library
    var file_name: String? = null
    var header: String? = null
    var functions_are_written = false
    if call.arguments.count() == 3 {
        file_name = literal_text_of(call.arguments[0])
        header = literal_text_of(call.arguments[1])
        var functions = call.arguments[2]
        functions_are_written = functions.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    }
    if not file_name or not header or not functions_are_written {
        refuse(
            found,
            "DynamicLibrary(...) takes three literals the compiler reads while it compiles: the file, the header (\"\" for none) and the functions it declares, written as a dictionary like '\{\"length_of\": DynamicLibrary.FunctionDeclaration(\"strlen\", [DynamicLibrary.Argument(\"text\", String)], Integer)}'",
        )
        return
    }
    if not file_name.contains(".") {
        refuse(
            found,
            "'{file_name}' has no extension: name the library file exactly as it is on disk, like \"user32.dll\" or \"libc.so.6\" (a wrapper for another platform names that platform's file)",
        )
    }
}

func literal_text_of(argument: SpiteCompiler.Expression?): String? {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(argument)
    }
    return null
}

func plain_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() <= 1
    if literal.pieces.is_empty() {
        return ""
    }
    var piece = literal.pieces[0]
    fallback not piece.hole
    return piece.text
}

func refuse(found: AbstractSyntaxTree.Walk.Found.Expression, text: String) {
    var problem = Diagnostics.Problem(walk.file.path, found.line, text)
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_among_the_attributes = found.function_name.is_empty()
    gathered.mistakes.append(problem)
}

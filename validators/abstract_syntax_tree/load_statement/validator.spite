var path = ""
var class_name = ""

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    assert function.body
    function.body.statements.each(check_top_statement)
}

func check_top_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    if statement == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
        check_folder(statement)
        return
    }
    check_nested_statement(statement)
}

func check_nested_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: refuse_nested(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: check_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: check_nested_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: statement.cases.each(check_case)
        AbstractSyntaxTree.Shapes.Statements.Block: statement.statements.each(check_nested_statement)
        _: return
    }
}

func check_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    check_nested_block(statement.then_branch)
    check_nested_block(statement.else_branch)
}

func check_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    check_nested_block(switch_case.body)
}

func check_nested_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    assert block
    block.statements.each(check_nested_statement)
}

func check_folder(statement: AbstractSyntaxTree.Shapes.Statements.LoadStatement) {
    var folder = statement.folder
    if folder == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var pieces = folder.pieces
        var only = pieces[0]
        crash only
        var is_plain = pieces.count() == 1 and not only.hole
        assert not is_plain
    }
    refuse(
        statement.line,
        "a 'load' names its folder as plain text, as in 'load \"kingdom\"', with nothing computed in it",
    )
}

func refuse_nested(statement: AbstractSyntaxTree.Shapes.Statements.LoadStatement) {
    refuse(
        statement.line,
        "a 'load' inside an 'if', a 'while' or a 'switch' is not built yet: write it on its own line in the function",
    )
}

func refuse(line: Integer, text: String) {
    var failure = Validators.Failure()
    failure.stop_at(path, line, class_name, text)
}

var path = ""
var class_name = ""
var scalars = Model.Scalars()
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
    return gathered
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        check_union(declaration)
    }
}

func check_union(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    var seen = List<String>()
    var index = 0
    while index < declaration.member_names.count() {
        var member = declaration.member_names[index]
        if seen.contains(member) {
            var text = "'{declaration.name}' lists '{member}' twice: a union names each member once"
            var problem = Diagnostics.Problem(path, declaration.line, text)
            problem.class_name = class_name
            gathered.mistakes.append(problem)
        }
        seen.append(member)
        refuse_a_value(declaration, member)
        index = index + 1
    }
}

func refuse_a_value(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration, member: String) {
    var is_a_value = member == "String" or scalars.is_a_scalar(member)
    var opening = member.index_of("<")
    fallback is_a_value or opening
    var reason = "a {member} is a value"
    if member.starts_with("I") or member.starts_with("U") {
        reason = "an {member} is a value"
    }
    if opening {
        var generic_name = member.slice(0, opening)
        crash generic_name
        reason = "a switch could tell only that a value is a {generic_name}, not of what"
    }
    var text = "'{member}' cannot be a member of union '{declaration.name}': a union holds objects whose class a switch tests, and {reason}; make the member a class of your own that keeps it in an attribute"
    var problem = Diagnostics.Problem(path, declaration.line, text)
    problem.class_name = class_name
    problem.is_among_the_attributes = true
    gathered.mistakes.append(problem)
}

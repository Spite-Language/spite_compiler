union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var path = ""
var class_name = ""
var function_name = ""
var line = 0
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walked = AbstractSyntaxTree.Walk.Walk(empty_file)
var text_holes = List<String>()
var other_holes = List<String>()

# ../../../../spite_spec/specs/values_and_types.md
func check(
    walk: AbstractSyntaxTree.Walk.Walk,
    starting_class_name: String,
    built_text_holes: List<String>,
    built_other_holes: List<String>,
) {
    walked = walk
    path = walk.file.path
    class_name = starting_class_name
    text_holes = built_text_holes
    other_holes = built_other_holes
    walk.statements.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    function_name = found.function_name
    crash found.statement
    check_statement(found.statement)
}

func check_statement(statement: Statement) {
    line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: check_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: check_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: check_return(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_expression(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_expression(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: read_expression(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: read_expression(statement.condition)
        _: return
    }
}

func check_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var hole = hole_of(statement.value)
    if hole {
        var target = printed(statement.target)
        refuse(statement.value, "assign the value directly, '{target} = {hole}'")
    }
    read_expression(statement.target)
    read_expression(statement.value)
}

func check_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var hole = hole_of(statement.value)
    if hole {
        var declared = declared_type_of(statement)
        if declared == ": String" and holds_text(statement) {
            declared = ""
        }
        refuse(statement.value, "declare the value directly, 'var {statement.name}{declared} = {hole}'")
    }
    read_expression(statement.value)
}

func declared_type_of(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): String {
    if statement.declared_type {
        var types = Printers.Spite.TypePrinter(statement.declared_type)
        var written = types.text()
        return ": {written}"
    }
    return ": String"
}

func holds_text(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    var key = "{path}:{statement.line}:{statement.name}"
    fallback not other_holes.contains(key)
    if text_holes.contains(key) {
        return true
    }
    var hole = hole_expression_of(statement.value)
    if hole == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return names_text(hole.name)
    }
    return false
}

func hole_expression_of(
    value: Expression?,
): Expression? {
    if value == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var only = value.pieces[0]
        crash only
        return only.hole
    }
    return null
}

func names_text(name: String): Boolean {
    var index = 0
    while index < walked.statements.count() {
        var found = walked.statements[index]
        var answer = text_declared_by(found, name)
        if answer >= 0 {
            return answer == 1
        }
        index = index + 1
    }
    return parameter_names_text(name)
}

func text_declared_by(found: AbstractSyntaxTree.Walk.Found.Statement, name: String): Integer {
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return text_declared_in(statement, name, found.function_name)
    }
    return -1
}

func text_declared_in(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    name: String,
    owner: String,
): Integer {
    var is_it = owner == function_name and statement.name == name
    if not is_it {
        return -1
    }
    if is_text_declared(statement.declared_type, statement.value) {
        return 1
    }
    return 0
}

func parameter_names_text(name: String): Boolean {
    var function = walked.function_named(function_name)
    crash function
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return is_text_declared(parameter.declared_type, null)
        }
        index = index + 1
    }
    return false
}

func is_text_declared(
    declared: Type?,
    value: Expression?,
): Boolean {
    if declared {
        var types = Printers.Spite.TypePrinter(declared)
        var written = types.text()
        return written == "String"
    }
    return value == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
}

func check_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var hole = hole_of(statement.value)
    if hole {
        refuse(statement.value, "return the value directly, 'return {hole}'")
    }
    read_expression(statement.value)
}

func read_expression(expression: Expression?) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: read_call(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: read_index(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_binary(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read_other(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_other(expression.target)
        _: return
    }
}

func read_other(expression: Expression?) {
    var hole = hole_of(expression)
    if hole {
        refuse(expression, "write its text as '{hole}.to_string()'")
    }
    read_expression(expression)
}

func read_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var hole = hole_of(argument)
        if hole {
            var written_call = printed(call)
            var written_argument = printed(argument)
            var fixed = written_call.replace(written_argument, hole)
            refuse(argument, "pass the value directly, '{fixed}'")
        }
        read_expression(argument)
        index = index + 1
    }
    read_expression(call.callee)
}

func read_index(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    var hole = hole_of(index.index)
    if hole {
        var target = printed(index.target)
        refuse(index.index, "look it up by the value directly, '{target}[{hole}]'")
    }
    read_expression(index.target)
    read_expression(index.index)
}

func read_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var left_hole = hole_of(binary.left)
    var right_hole = hole_of(binary.right)
    if binary.operator == 'plus' and right_hole {
        var left = printed(binary.left)
        refuse(binary.right, "join the value directly, '{left} + {right_hole}'")
    }
    if left_hole {
        refuse(binary.left, "write its text as '{left_hole}.to_string()'")
    }
    if right_hole {
        refuse(binary.right, "write its text as '{right_hole}.to_string()'")
    }
    read_expression(binary.left)
    read_expression(binary.right)
}

func hole_of(expression: Expression?): String? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return lone_hole_of(expression)
    }
    return null
}

func lone_hole_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() == 1
    var only = literal.pieces[0]
    fallback only.text.is_empty()
    fallback only.hole
    return printed(only.hole)
}

func printed(expression: Expression?): String {
    crash expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    return printer.text()
}

func refuse(literal: Expression?, fix: String) {
    var written = printed(literal)
    var text = "'{written}' is a text of one value and nothing else: {fix}"
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

var path = ""
var class_name = ""
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    fallback file.declarations.count() == 1
    path = file.path
    class_name = starting_class_name
    var only = file.declarations[0]
    refuse(only)
    return gathered
}

func refuse(only: SpiteCompiler.Declaration) {
    switch only {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: refuse_an_enum(only)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: refuse_a_union(only)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: refuse_a_type(only)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return
    }
}

func refuse_an_enum(only: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    fallback only.name == class_name
    var shown = "'value'"
    if not only.values.is_empty() {
        var first = only.values[0]
        shown = "'{first.name}'"
    }
    var text = "'enum {only.name}' is a file of its own, and an enum belongs to the class that uses it: declare it inside that class ('Owner.{only.name}'), and outside it give a value by its short form ({shown})"
    var problem = Diagnostics.Problem(path, only.line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

func refuse_a_union(only: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    fallback only.name == class_name
    var text = "'union {only.name}' is a file of its own, and a union belongs to a class: declare it in the class that takes, holds or switches on it (when two classes of a namespace declare it, it moves to the namespace's entry class), and elsewhere pass the member value itself"
    var problem = Diagnostics.Problem(path, only.line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

func refuse_a_type(only: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    fallback only.name == class_name
    var text = "'type {only.name}' is a file of its own, and a type belongs to a class: declare it in the class that takes or holds it (when two classes of a namespace declare it, it moves to the namespace's entry class), and elsewhere pass the value that fits it"
    var problem = Diagnostics.Problem(path, only.line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

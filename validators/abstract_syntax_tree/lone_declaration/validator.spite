union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var path = ""
var class_name = ""

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    assert file.declarations.count() == 1
    path = file.path
    class_name = starting_class_name
    var only = file.declarations[0]
    refuse(only)
}

func refuse(only: Declaration) {
    switch only {
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: refuse_an_enum(only)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: refuse_a_union(only)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: refuse_a_type(only)
        _: return
    }
}

func refuse_an_enum(only: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    assert only.name == class_name
    var shown = "'value'"
    if not only.values.is_empty() {
        var first = only.values[0]
        shown = "'{first.name}'"
    }
    var text = "'enum {only.name}' is a file of its own, and an enum belongs to the class that uses it: declare it inside that class ('Owner.{only.name}'), and outside it give a value by its short form ({shown})"
    var failure = Validators.Failure()
    failure.stop_at(path, only.line, class_name, text)
}

func refuse_a_union(only: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    assert only.name == class_name
    var text = "'union {only.name}' is a file of its own, and a union belongs to the class that consumes it: declare it in each class that takes, holds or switches on it (two classes may each declare it), and elsewhere pass the member value itself"
    var failure = Validators.Failure()
    failure.stop_at(path, only.line, class_name, text)
}

func refuse_a_type(only: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    assert only.name == class_name
    var text = "'type {only.name}' is a file of its own, and a type belongs to the class that consumes it: declare it in each class that takes or holds it (two classes may each declare it), and elsewhere pass the value that fits it"
    var failure = Validators.Failure()
    failure.stop_at(path, only.line, class_name, text)
}

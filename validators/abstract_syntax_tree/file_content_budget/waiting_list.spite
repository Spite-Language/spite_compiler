var paths = [
    "spite_compiler/high_intermediary_representation/building/values.spite"
    "spite_compiler/low_intermediary_representation/lowering/function_lowering.spite"
    "spite_compiler/high_intermediary_representation/building/statements.spite"
    "spite_compiler/high_intermediary_representation/building/prompt/text.spite"
    "spite_compiler/generators/x64/allocation.spite"
    "spite_compiler/high_intermediary_representation/building/prompt/source.spite"
    "spite_compiler/high_intermediary_representation/building/reflection.spite"
    "spite_compiler/name_resolution/resolver.spite"
    "spite_compiler/low_optimization_passes/vector_loops/pass.spite"
    "text_escapes/text_escapes.spite"
]

func holds(path: String, entry_path: String): Boolean {
    var entry = entry_path.replace("\\", "/")
    var segments = entry.split("/")
    crash segments.remove_last()
    var folder = segments.join("/")
    var folder_name = segments.last()
    crash folder_name
    var written = path.replace("\\", "/")
    fallback written.starts_with("{folder}/")
    var start = folder.length() + 1
    var whole = written.length()
    var inside = written.slice(start, whole)
    crash inside
    return paths.contains("{folder_name}/{inside}")
}

var _budget: Integer = 1200
var counted = 0
var gathered = Validators.Answer()

# ../../../../spite_documentation/style.md#the-file-content-budget
func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    file.declarations.each(count_a_declaration)
    fallback counted > _budget
    var text = "this file holds {counted} statements, over its file content budget of {_budget}: clean it up until it is back within it, grouping state into an object and giving each concern a file of its own"
    var problem = Diagnostics.Problem(file.path, 0, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
    return gathered
}

func count_a_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: counted = counted + 1
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: count_a_block(declaration.body)
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return
    }
}

func count_a_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(count_a_statement)
}

func count_a_statement(statement: SpiteCompiler.WrittenStatement) {
    if statement.class != AbstractSyntaxTree.Shapes.Statements.Block {
        counted = counted + 1
    }
    count_what_it_holds(statement)
}

func count_what_it_holds(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.Block: count_a_block(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: count_the_branches(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: count_a_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func count_the_branches(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    count_a_block(statement.then_branch)
    count_a_block(statement.else_branch)
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var path = ""
var class_name = ""
var function_name = ""
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    path = walk.file.path
    class_name = starting_class_name
    function_name = ""
    walk.attribute_declarations.each(check_attribute)
    walk.statements.each(check_found)
}

func check_codegen(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    path = walk.file.path
    class_name = starting_class_name
    function_name = ""
    walk.attribute_declarations.each(check_codegen_attribute)
}

func check_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    fallback not names_a_codegen_type(attribute.declared_type)
    fallback not is_assigned_by_the_constructor(attribute.name)
    check_declared(attribute.name, attribute.declared_type, attribute.value, attribute.line, "attribute")
}

func check_codegen_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    fallback names_a_codegen_type(attribute.declared_type)
    fallback not is_assigned_by_the_constructor(attribute.name)
    check_declared(attribute.name, attribute.declared_type, attribute.value, attribute.line, "attribute")
}

func names_a_codegen_type(declared_type: Type?): Boolean {
    if declared_type.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var first = declared_type.path.first()
        crash first
        return first.starts_with("$")
    }
    return false
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        function_name = found.function_name
        check_variable(statement)
    }
}

func check_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    fallback not is_filled_by_a_walk(statement.name) and not is_a_walked_class(statement.declared_type)
    check_declared(statement.name, statement.declared_type, statement.value, statement.line, "variable")
}

func check_declared(
    name: String,
    declared_type: Type?,
    value: Expression?,
    line: Integer,
    what: String,
) {
    fallback declared_type
    fallback not declared_type.is_nullable
    var is_null = false
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_null = value.kind == 'keyword_null'
    }
    fallback is_null
    var printer = Printers.Spite.TypePrinter(declared_type)
    var written = printer.text()
    var default = default_of(written)
    var text = "the {what} '{name}' is declared '{written}', not '{written}?', so '= null' would make a default {written} rather than nothing: write 'var {name}: {written}? = null' for none yet, narrowed before use, or 'var {name} = {default}' for a default"
    if what == "attribute" {
        text = "{text}, or keep '= null' and assign it at the top of the constructor"
    }
    var failure = Validators.Failure()
    if function_name.is_empty() {
        failure.stop_at(path, line, class_name, text)
    }
    failure.stop_inside(path, line, class_name, function_name, text)
}

func is_assigned_by_the_constructor(name: String): Boolean {
    var segments = class_name.split(".")
    var last = segments.count() - 1
    var simple_name = segments[last]
    var index = 0
    while index < walk.function_declarations.count() {
        var function = walk.function_declarations[index]
        if function.name == simple_name and not function.result and function.body {
            return assigns_at_the_top(function.body, name)
        }
        index = index + 1
    }
    return false
}

func assigns_at_the_top(body: AbstractSyntaxTree.Shapes.Statements.Block, name: String): Boolean {
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
            var target = statement.target
            if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == name {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func is_a_walked_class(declared_type: Type?): Boolean {
    if declared_type.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var last = declared_type.path.last()
        return last == "class"
    }
    return false
}

func is_filled_by_a_walk(name: String): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if found.function_name == function_name {
            var expression = found.expression
            if fills(expression, name) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func fills(expression: Expression?, name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var target = expression.target
        if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            return target.name == name and expression.name == "attributes"
        }
        return false
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return walks_over(expression, name)
    }
    return false
}

func walks_over(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    var callee = call.callee
    var called = ""
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        called = callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        called = callee.name
    }
    fallback called.ends_with("_attributes")
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and argument.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func default_of(written: String): String {
    if written == "Integer" {
        return "0"
    } else if written == "Long" {
        return "0"
    } else if written == "Float" {
        return "0.0"
    } else if written == "Double" {
        return "0.0"
    } else if written == "Boolean" {
        return "false"
    } else if written == "String" {
        return "\"\""
    } else {
        return "{written}()"
    }
}

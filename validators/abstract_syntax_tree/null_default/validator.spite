var path = ""
var class_name = ""
var function_name = ""
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    path = walk.file.path
    class_name = starting_class_name
    function_name = ""
    walk.attribute_declarations.each(check_attribute)
    walk.statements.each(check_found)
}

func check_codegen(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    path = walk.file.path
    class_name = starting_class_name
    function_name = ""
    walk.attribute_declarations.each(check_codegen_attribute)
}

func check_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    fallback not names_a_codegen_type(attribute.declared_type)
    check_declared(attribute.name, attribute.declared_type, attribute.value, attribute.line, "attribute")
}

func check_codegen_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    fallback names_a_codegen_type(attribute.declared_type)
    check_declared(attribute.name, attribute.declared_type, attribute.value, attribute.line, "attribute")
}

func names_a_codegen_type(declared_type: SpiteCompiler.Type?): Boolean {
    if declared_type.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var first = declared_type.path.first()
        crash first
        return first.starts_with("$")
    }
    return false
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        function_name = found.function_name
        check_variable(statement)
    }
}

func check_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    check_declared(statement.name, statement.declared_type, statement.value, statement.line, "variable")
}

func check_declared(
    name: String,
    declared_type: SpiteCompiler.Type?,
    value: SpiteCompiler.Expression?,
    line: Integer,
    what: String,
) {
    fallback declared_type
    fallback not declared_type.is_nullable
    var is_null = false
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_null = value.kind == 'keyword_null'
    }
    fallback is_null
    var printer = Printers.Spite.TypePrinter(declared_type)
    var written = printer.text()
    var default = default_of(written)
    var text = "the {what} '{name}' is declared '{written}', not '{written}?', so '= null' would make a default {written} rather than nothing: write 'var {name}: {written}? = null' for none yet, narrowed before use, or 'var {name} = {default}' for a default"
    if written == "Anything" {
        text = "the {what} '{name}' is declared 'Anything', and an Anything never holds null: write 'var {name}: Anything? = null' only where none is a real answer (a real type says more), narrowed before use, or give it a value"
    }
    if what == "attribute" and written != "Anything" {
        text = "the attribute '{name}' is declared '{written}', not '{written}?', and an attribute always has a real default, even when its constructor sets it: write 'var {name}: {written} = {default}', or 'var {name}: {written}? = null' for none yet, narrowed before use"
    }
    var failure = Diagnostics.Failure()
    if function_name.is_empty() {
        failure.stop_at(path, line, class_name, text)
    }
    failure.stop_inside(path, line, class_name, function_name, text)
}

func default_of(written: String): String {
    if written == "Integer" {
        return "0"
    } else if written == "Long" {
        return "0"
    } else if written == "Float" {
        return "0.0"
    } else if written == "Double" {
        return "0.0"
    } else if written == "Boolean" {
        return "false"
    } else if written == "String" {
        return "\"\""
    } else {
        return "{written}()"
    }
}

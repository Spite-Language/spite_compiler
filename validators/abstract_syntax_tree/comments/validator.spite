var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var comment_line = 0
var is_inside = false
var advice = "a comment is one line holding only a link to a markdown section, like '# docs/memory.md#cycles', and only outside functions. Ask whether the note is needed: if a reader could work it out from the code, delete it; if it is lasting knowledge, write the section first and link to it; if it warns against a change, a test or a compile error pushes harder than prose"

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    walk.file.comments.each(check_comment)
}

func check_comment(comment: AbstractSyntaxTree.Shapes.Comment) {
    comment_line = comment.line
    is_inside = false
    walk.function_declarations.each(note_if_inside)
    if is_inside {
        refuse(
            "a comment may not appear inside a function or a declaration body: a line that needs explaining becomes a named function instead. {advice}",
        )
    }
    var is_a_link = not comment.text.contains(" ") and not comment.text.is_empty()
    if not is_a_link {
        refuse("this comment is not a link: {advice}")
    }
    var parts = comment.text.split("#")
    var linked = parts[0]
    crash linked
    if linked.ends_with(".spite") {
        check_a_supplier_link(linked)
        return
    }
    if not linked.ends_with(".md") {
        refuse("this comment is not a link: {advice}")
    }
    check_the_link(comment, linked, parts)
}

# ../../../../spite_documentation/compiler.md#inspect-merged-classes
func check_a_supplier_link(linked: String) {
    var folder = folder_of(walk.file.path)
    var printed = Validators.FinalClassesFolder()
    if not printed.holds(folder) {
        refuse(
            "this comment links to '{linked}', a .spite file, and only a file '--final-classes' wrote may link one, to name the file that supplied a declaration: anywhere else a comment links a markdown section",
        )
    }
    var supplier = File("{folder}/{linked}")
    if not supplier.exists() {
        refuse(
            "this comment links to '{linked}', which does not exist (the path is relative to the folder of the file the comment is in, like load)",
        )
    }
}

func note_if_inside(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    assert function.body
    var after_start = comment_line > function.line
    var before_end = comment_line < function.body.end_line
    if after_start and before_end {
        is_inside = true
    }
}

func check_the_link(comment: AbstractSyntaxTree.Shapes.Comment, linked: String, parts: List<String>) {
    var folder = folder_of(walk.file.path)
    var linked_file = File("{folder}/{linked}")
    var content = linked_file.read()
    if not content {
        refuse(
            "this comment links to '{linked}', which does not exist (the path is relative to the folder of the file the comment is in, like load)",
        )
    }
    crash content
    assert parts.count() > 1
    var anchor = parts[1]
    var anchors = anchors_of(content)
    assert not anchors.contains(anchor)
    refuse("this comment links to '{comment.text}', but that file has no heading with that anchor")
}

func anchors_of(content: String): List<String> {
    var anchors = List<String>()
    var lines = content.lines()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("#") {
            var anchor = anchor_of(line)
            anchors.append(anchor)
        }
        index = index + 1
    }
    return anchors
}

func anchor_of(heading: String): String {
    var text = heading
    while text.starts_with("#") {
        var text_length = text.length()
        text = text.slice(1, text_length)
    }
    var lowered = text.trim()
    lowered = lowered.lower_case()
    var anchor = ""
    var index = 0
    while index < lowered.length() {
        var letter = lowered.character_at(index)
        var kept = anchor_letter(letter)
        anchor = "{anchor}{kept}"
        index = index + 1
    }
    return anchor
}

func anchor_letter(letter: String): String {
    if letter == " " {
        return "-"
    }
    var allowed = "abcdefghijklmnopqrstuvwxyz0123456789-_"
    if allowed.contains(letter) {
        return letter
    }
    return ""
}

func folder_of(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    return segments.join("/")
}

func refuse(text: String) {
    var failure = Validators.Failure()
    failure.stop_at(walk.file.path, comment_line, class_name, text)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check(member: AbstractSyntaxTree.Shapes.Types.TypeMember): Validators.Answer {
    var answer = Validators.Answer()
    if not member.is_an_attribute {
        answer.fix = "write '{member.name}' as a member holding a 'Spite.Function'"
    }
    return answer
}

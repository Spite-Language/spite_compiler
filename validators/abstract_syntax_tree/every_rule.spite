# ../../ARCHITECTURE.md#validators
func check_the_spelling(
    path: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    unread: List<AbstractSyntaxTree.Tokens.Unreadable>,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
) {
    var found = List<Diagnostics.Problem>()
    var spelling = Validators.AbstractSyntaxTree.Spelling.Validator()
    spelling.check(path, tokens, unread, comments, found)
    end_the_reading_with(found)
}

# ../../ARCHITECTURE.md#validators
func check_the_syntax(
    path: String,
    namespace: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    unfit: List<AbstractSyntaxTree.Shapes.Unfit>,
    holes: List<AbstractSyntaxTree.Parser.Hole>,
) {
    var found = List<Diagnostics.Problem>()
    var no_comments = List<AbstractSyntaxTree.Shapes.Comment>()
    var spelling = Validators.AbstractSyntaxTree.Spelling.Validator()
    var syntax = Validators.AbstractSyntaxTree.Syntax.Validator()
    var index = 0
    while index < holes.count() {
        var hole = holes[index]
        spelling.check(path, hole.tokens, hole.unread, no_comments, found)
        index = index + 1
    }
    syntax.check(path, namespace, tokens, unfit, found)
    index = 0
    while index < holes.count() {
        var hole = holes[index]
        syntax.check(path, namespace, hole.tokens, hole.unfit, found)
        index = index + 1
    }
    end_the_reading_with(found)
}

func end_the_reading_with(found: List<Diagnostics.Problem>) {
    fallback not found.is_empty()
    var told = one_on_each_line(found)
    var failure = Diagnostics.Failure()
    failure.stop_every(told)
}

func one_on_each_line(found: List<Diagnostics.Problem>): List<Diagnostics.Problem> {
    var told = List<Diagnostics.Problem>()
    var index = 0
    while index < found.count() {
        var problem = found[index]
        tell_in_line_order(told, problem)
        index = index + 1
    }
    return told
}

func tell_in_line_order(told: List<Diagnostics.Problem>, problem: Diagnostics.Problem) {
    var place = told.count()
    while place > 0 and comes_after(told, place - 1, problem.line) {
        place = place - 1
    }
    if place > 0 {
        var before = told[place - 1]
        crash before
        fallback before.line != problem.line
    }
    told.insert(place, problem)
}

func comes_after(told: List<Diagnostics.Problem>, index: Integer, line: Integer): Boolean {
    var earlier = told[index]
    crash earlier
    return earlier.line > line
}

func check(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    class_name: String,
    symbols: Symbols.SymbolTable,
    links: Symbols.LinkedFiles,
): AbstractSyntaxTree.Walk.Walk {
    var budget = Validators.AbstractSyntaxTree.FileContentBudget.Validator()
    budget.check(file, class_name)
    var order = Validators.AbstractSyntaxTree.DeclarationOrder.Validator()
    order.check(file, class_name)
    var walk = AbstractSyntaxTree.Walk.Walk(file)
    var removed = Validators.AbstractSyntaxTree.RemovedForms.Validator()
    removed.check(walk, class_name)
    var after_return = Validators.AbstractSyntaxTree.AfterReturn.Validator()
    after_return.check(walk, class_name)
    var libraries = Validators.AbstractSyntaxTree.ForeignLibrary.Validator()
    libraries.check(walk, class_name)
    var singletons = Validators.AbstractSyntaxTree.Singletons.Validator()
    singletons.check(walk, class_name, symbols)
    var constructions = Validators.AbstractSyntaxTree.DroppedConstruction.Validator()
    constructions.check(walk, class_name)
    var internals = Validators.AbstractSyntaxTree.InternalUse.Validator()
    internals.check(walk)
    var shadowed = Validators.AbstractSyntaxTree.ShadowedFunction.Validator()
    shadowed.check(walk, class_name)
    var constructions = Validators.AbstractSyntaxTree.Constructions.Validator()
    constructions.check(file, class_name)
    var once = Validators.AbstractSyntaxTree.DeclaredOnce.Validator()
    once.check(file, class_name)
    var json_keys = Validators.AbstractSyntaxTree.JsonKeyFunction.Validator()
    json_keys.check(file, class_name)
    var lone_declarations = Validators.AbstractSyntaxTree.LoneDeclaration.Validator()
    lone_declarations.check(file, class_name)
    var enums = Validators.AbstractSyntaxTree.EnumValues.Validator()
    enums.check(file, class_name)
    var unions = Validators.AbstractSyntaxTree.UnionMembers.Validator()
    unions.check(file, class_name)
    var variadics = Validators.AbstractSyntaxTree.VariadicLast.Validator()
    variadics.check(file, class_name)
    var constructors = Validators.AbstractSyntaxTree.EmptyConstructor.Validator()
    constructors.check(file, class_name)
    var loads = Validators.AbstractSyntaxTree.LoadStatement.Validator()
    loads.check(file, class_name)
    var type_uses = Validators.AbstractSyntaxTree.TypeUse.Validator()
    type_uses.check(walk, class_name, symbols)
    var receivers = Validators.AbstractSyntaxTree.ComputedReceiver.Validator()
    receivers.check(walk, class_name)
    var nested = Validators.AbstractSyntaxTree.NestedIfElse.Validator()
    nested.check(walk, class_name)
    var guards = Validators.AbstractSyntaxTree.DefaultGuard.Validator()
    guards.check(walk, class_name)
    var chains = Validators.AbstractSyntaxTree.SwitchChain.Validator()
    chains.check(walk, class_name)
    var names = Validators.AbstractSyntaxTree.Names.Validator()
    names.check(walk, class_name)
    var switches = Validators.AbstractSyntaxTree.SwitchCases.Validator()
    switches.check(walk, class_name)
    var joined_text = Validators.AbstractSyntaxTree.JoinedText.Validator()
    joined_text.check(walk, class_name)
    var null_values = Validators.AbstractSyntaxTree.NullValue.Validator()
    null_values.check(walk, class_name)
    var null_defaults = Validators.AbstractSyntaxTree.NullDefault.Validator()
    null_defaults.check(walk, class_name)
    var without_defaults = Validators.AbstractSyntaxTree.AttributeWithoutDefault.Validator()
    without_defaults.check(walk, class_name)
    var returned_locals = Validators.AbstractSyntaxTree.ReturnedLocal.Validator()
    returned_locals.check(walk, class_name)
    var unchanged_loops = Validators.AbstractSyntaxTree.UnchangedLoop.Validator()
    unchanged_loops.check(walk, class_name)
    var repeated_calls = Validators.AbstractSyntaxTree.RepeatedBranchCall.Validator()
    repeated_calls.check(walk, class_name)
    var comments = Validators.AbstractSyntaxTree.Comments.Validator()
    comments.check(walk, class_name, links)
    var signatures = Validators.AbstractSyntaxTree.Signatures.Validator()
    signatures.check(walk, class_name)
    var only_answers = Validators.AbstractSyntaxTree.OnlyAnswersAMember.Validator()
    only_answers.check(walk, class_name)
    return walk
}

func check_the_lone_holes(
    walk: AbstractSyntaxTree.Walk.Walk,
    class_name: String,
    text_holes: List<String>,
    other_holes: List<String>,
) {
    var lone_holes = Validators.AbstractSyntaxTree.LoneHole.Validator()
    lone_holes.check(walk, class_name, text_holes, other_holes)
}

func check_the_numbers(walks: List<AbstractSyntaxTree.Walk.Walk>, class_names: List<String>) {
    var numbers = Validators.AbstractSyntaxTree.EsotericNumbers.Validator()
    numbers.check(walks, class_names)
}

func check_after_building(walk: AbstractSyntaxTree.Walk.Walk, class_name: String) {
    var call_arguments = Validators.AbstractSyntaxTree.CallArgument.Validator()
    call_arguments.check(walk, class_name)
    var unused = Validators.AbstractSyntaxTree.UnusedNames.Validator()
    unused.check(walk, class_name)
}

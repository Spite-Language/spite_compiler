# ../../ARCHITECTURE.md#validators
func check_the_spelling(
    path: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    unread: List<AbstractSyntaxTree.Tokens.Unreadable>,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
) {
    var found = List<Diagnostics.Problem>()
    var spelling = Spelling.Validator()
    spelling.check(path, tokens, unread, comments, found)
    end_the_reading_with(found)
}

# ../../ARCHITECTURE.md#validators
func check_the_syntax(
    path: String,
    namespace: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    unfit: List<AbstractSyntaxTree.Shapes.Unfit>,
    holes: List<AbstractSyntaxTree.Parser.Hole>,
) {
    var found = List<Diagnostics.Problem>()
    var no_comments = List<AbstractSyntaxTree.Shapes.Comment>()
    var spelling = Spelling.Validator()
    var syntax = Syntax.Validator()
    var index = 0
    while index < holes.count() {
        var hole = holes[index]
        spelling.check(path, hole.tokens, hole.unread, no_comments, found)
        index = index + 1
    }
    syntax.check(path, namespace, tokens, unfit, found)
    index = 0
    while index < holes.count() {
        var hole = holes[index]
        syntax.check(path, namespace, hole.tokens, hole.unfit, found)
        index = index + 1
    }
    end_the_reading_with(found)
}

# ../../../spite_documentation/markup.md#what-the-compiler-refuses
func check_the_markup(file: AbstractSyntaxTree.Shapes.SourceFile) {
    var markup = Markup.Validator()
    var answer = markup.check(file)
    end_the_reading_with(answer.mistakes)
}

# ../../../spite_documentation/style.md#the-file-content-budget
func check_the_budget(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String) {
    var budget = FileContentBudget.Validator()
    var answer = budget.check(file, class_name)
    end_the_reading_with(answer.mistakes)
}

func end_the_reading_with(found: List<Diagnostics.Problem>) {
    fallback not found.is_empty()
    var told = one_on_each_line(found)
    var failure = Diagnostics.Failure()
    failure.stop_every(told)
}

func one_on_each_line(found: List<Diagnostics.Problem>): List<Diagnostics.Problem> {
    var told = List<Diagnostics.Problem>()
    var index = 0
    while index < found.count() {
        var problem = found[index]
        tell_in_line_order(told, problem)
        index = index + 1
    }
    return told
}

func tell_in_line_order(told: List<Diagnostics.Problem>, problem: Diagnostics.Problem) {
    var place = told.count()
    while place > 0 and comes_after(told, place - 1, problem.line) {
        place = place - 1
    }
    if place > 0 {
        var before = told[place - 1]
        crash before
        fallback before.line != problem.line
    }
    told.insert(place, problem)
}

func comes_after(told: List<Diagnostics.Problem>, index: Integer, line: Integer): Boolean {
    var earlier = told[index]
    crash earlier
    return earlier.line > line
}

func check(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    class_name: String,
    symbols: Symbols.SymbolTable,
    links: Symbols.LinkedFiles,
): AbstractSyntaxTree.Walk {
    var order = DeclarationOrder.Validator()
    var answer = order.check(file, class_name)
    answer.tell()
    var walk = AbstractSyntaxTree.Walk(file)
    var removed = RemovedForms.Validator()
    answer = removed.check(walk, class_name)
    answer.tell()
    var after_return = AfterReturn.Validator()
    answer = after_return.check(walk, class_name)
    answer.tell()
    var libraries = ForeignLibrary.Validator()
    answer = libraries.check(walk, class_name)
    answer.tell()
    var rooms = RoomMaking.Validator()
    answer = rooms.check(walk, class_name)
    answer.tell()
    var singletons = Singletons.Validator()
    answer = singletons.check(walk, class_name, symbols)
    answer.tell()
    var constructions = DroppedConstruction.Validator()
    answer = constructions.check(walk, class_name)
    answer.tell()
    var internals = InternalUse.Validator()
    answer = internals.check(walk)
    answer.tell()
    var shadowed = ShadowedFunction.Validator()
    answer = shadowed.check(walk, class_name)
    answer.tell()
    var constructions = Constructions.Validator()
    answer = constructions.check(file, class_name)
    answer.tell()
    var once = DeclaredOnce.Validator()
    answer = once.check(file, class_name)
    answer.tell()
    var json_keys = JsonKeyFunction.Validator()
    answer = json_keys.check(file, class_name)
    answer.tell()
    var lone_declarations = LoneDeclaration.Validator()
    answer = lone_declarations.check(file, class_name)
    answer.tell()
    var enums = EnumValues.Validator()
    answer = enums.check(file, class_name)
    answer.tell()
    var unions = UnionMembers.Validator()
    answer = unions.check(file, class_name)
    answer.tell()
    var members = NoMembers.Validator()
    answer = members.check(file, class_name)
    answer.tell()
    var variadics = VariadicLast.Validator()
    answer = variadics.check(file, class_name)
    answer.tell()
    var constructors = EmptyConstructor.Validator()
    answer = constructors.check(file, class_name)
    answer.tell()
    var loads = LoadStatement.Validator()
    answer = loads.check(file, class_name)
    answer.tell()
    var type_uses = TypeUse.Validator()
    answer = type_uses.check(walk, class_name, symbols)
    answer.tell()
    var anything = AnythingNamed.Validator()
    answer = anything.check(walk, class_name)
    answer.tell()
    var receivers = ComputedReceiver.Validator()
    answer = receivers.check(walk, class_name)
    answer.tell()
    var nested = NestedIfElse.Validator()
    answer = nested.check(walk, class_name)
    answer.tell()
    var guards = DefaultGuard.Validator()
    answer = guards.check(walk, class_name)
    answer.tell()
    var chains = SwitchChain.Validator()
    answer = chains.check(walk, class_name)
    answer.tell()
    var names = Names.Validator()
    answer = names.check(walk, class_name)
    answer.tell()
    var switches = SwitchCases.Validator()
    answer = switches.check(walk, class_name)
    answer.tell()
    var joined_text = JoinedText.Validator()
    answer = joined_text.check(walk, class_name)
    answer.tell()
    var null_values = NullValue.Validator()
    answer = null_values.check(walk, class_name)
    answer.tell()
    var null_defaults = NullDefault.Validator()
    answer = null_defaults.check(walk, class_name)
    answer.tell()
    var held_nothing = HeldNothing.Validator()
    answer = held_nothing.check(walk, class_name)
    answer.tell()
    var without_defaults = AttributeWithoutDefault.Validator()
    answer = without_defaults.check(walk, class_name)
    answer.tell()
    var unchanged_loops = UnchangedLoop.Validator()
    answer = unchanged_loops.check(walk, class_name)
    answer.tell()
    var repeated_calls = RepeatedBranchCall.Validator()
    answer = repeated_calls.check(walk, class_name)
    answer.tell()
    var comments = Comments.Validator()
    answer = comments.check(walk, class_name, links, symbols)
    answer.tell()
    var signatures = Signatures.Validator()
    answer = signatures.check(walk, class_name)
    answer.tell()
    var only_answers = OnlyAnswersAMember.Validator()
    answer = only_answers.check(walk, class_name)
    answer.tell()
    return walk
}

func check_the_lone_holes(
    walk: AbstractSyntaxTree.Walk,
    class_name: String,
    text_holes: List<String>,
    other_holes: List<String>,
) {
    var lone_holes = LoneHole.Validator()
    var answer = lone_holes.check(walk, class_name, text_holes, other_holes)
    answer.tell()
}

func check_the_numbers(walks: List<AbstractSyntaxTree.Walk>, class_names: List<String>) {
    var numbers = EsotericNumbers.Validator()
    var answer = numbers.check(walks, class_names)
    answer.tell()
}

func check_after_building(
    walk: AbstractSyntaxTree.Walk,
    class_name: String,
    replacing: List<AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration>,
) {
    var call_arguments = CallArgument.Validator()
    var answer = call_arguments.check(walk, class_name)
    answer.tell()
    var unused = UnusedNames.Validator()
    answer = unused.check(walk, class_name, replacing)
    answer.tell()
}

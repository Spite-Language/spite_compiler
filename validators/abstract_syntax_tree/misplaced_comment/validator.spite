# ../../../../spite_documentation/style.md#comments-are-links
func check(file: AbstractSyntaxTree.Shapes.SourceFile, index: Integer): Validators.Answer {
    var answer = Validators.Answer()
    var place = file.misplaced_places[index]
    if place {
        answer.fix = "move the comment {place} to the top of the file"
    }
    return answer
}

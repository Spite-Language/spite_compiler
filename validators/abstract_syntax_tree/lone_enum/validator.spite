func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String) {
    assert file.declarations.count() == 1
    var only = file.declarations[0]
    assert only == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    assert only.name == class_name
    var shown = "'value'"
    if not only.values.is_empty() {
        var first = only.values[0]
        shown = "'{first.name}'"
    }
    var text = "'enum {only.name}' is a file of its own, and an enum belongs to the class that uses it: declare it inside that class ('Owner.{only.name}'), and outside it give a value by its short form ({shown})"
    var failure = Validators.Failure()
    failure.stop_at(file.path, only.line, class_name, text)
}

var path = ""
var class_name = ""
var function_names = List<String>()
var parameter_names = List<String>()

# ../../../../spite_spec/specs/style.md#a-function-that-only-answers-a-member
func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    function_names = walk.function_declarations.map_names()
    walk.function_declarations.each(check_function)
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    fallback function.body.statements.count() == 1
    parameter_names = function.parameters.map_names()
    var answer = answer_of(function.body.statements[0])
    if answer.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_read(function, answer)
    }
    if answer.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_a_call(function, answer)
    }
}

func answer_of(statement: SpiteCompiler.WrittenStatement?): SpiteCompiler.Expression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return statement.value
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        return statement.value
    }
    return null
}

func check_a_read(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    read: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback function.parameters.is_empty()
    var asked = asked_name_of(function.name)
    var is_a_getter = function.name.starts_with("get_")
    fallback is_a_getter or asked == read.name
    var written = written_path(read)
    fallback not written.is_empty()
    if asked == read.name {
        refuse_an_answer(function, written)
        return
    }
    var instance = instance_name()
    var text = "'{function.name}' only reads '{written}', an attribute of another object: remove it, and write '{instance}.{written}' where it is called"
    refuse(function, text)
}

func check_a_call(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var asked = asked_name_of(function.name)
    fallback asked == callee.name or function.name == callee.name
    fallback passes_its_own_parameters(call)
    var written = written_path(callee)
    fallback not written.is_empty()
    refuse_an_answer(function, written)
}

func passes_its_own_parameters(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    fallback call.generic_arguments.is_empty()
    fallback parameter_names.count() == call.arguments.count()
    var index = 0
    while index < parameter_names.count() {
        var argument = call.arguments[index]
        var parameter = parameter_names[index]
        fallback names_the_parameter(argument, parameter)
        index = index + 1
    }
    return true
}

func names_the_parameter(argument: SpiteCompiler.Expression?, name: String): Boolean {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return argument.name == name
    }
    return false
}

func asked_name_of(function_name: String): String {
    fallback function_name.starts_with("get_")
    var length = function_name.length()
    var asked = function_name.slice(4, length)
    crash asked
    return asked
}

func written_path(expression: SpiteCompiler.Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return path_of_a_member(expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return reachable_attribute(expression)
    }
    return ""
}

func path_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    fallback not member.name.starts_with("_")
    var before = written_path(member.target)
    fallback not before.is_empty()
    return "{before}.{member.name}"
}

func reachable_attribute(root: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    fallback not root.is_a_class_name and not parameter_names.contains(root.name)
    fallback root.name != "class" and not root.name.starts_with("$")
    if not root.name.starts_with("_") {
        return root.name
    }
    var length = root.name.length()
    var public = root.name.slice(1, length)
    crash public
    fallback function_names.contains("get_{public}")
    return public
}

func instance_name(): String {
    var names = Mapping.Names()
    var parts = class_name.split(".")
    var last = parts.last()
    crash last
    return names.snake_case_of(last)
}

func refuse_an_answer(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, written: String) {
    var instance = instance_name()
    var text = "'{function.name}' only answers '{written}': remove it, and write '{instance}.{written}' where it is called"
    refuse(function, text)
}

func refuse(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, text: String) {
    var failure = Diagnostics.Failure()
    failure.stop_inside(path, function.line, class_name, function.name, text)
}

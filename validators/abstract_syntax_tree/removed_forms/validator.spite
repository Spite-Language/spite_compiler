# ../../../../spite_spec/specs/concurrency.md#what-runs-at-once
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_names = List<String>()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    function_names = walk.function_declarations.map_names()
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(found, expression)
    }
}

func check_call(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var written = callee.name
    var is_removed = written == "Parallel" or written == "Concurrent"
    fallback is_removed and not function_names.contains(written)
    refuse(walk.file.path, found.line, class_name, found.function_name, written)
}

func refuse(path: String, line: Integer, refused_class: String, function_name: String, written: String) {
    var text = "'{written}' is not part of Spite: the compiler decides what runs at once, so call the function itself"
    var failure = Validators.Failure()
    failure.stop_inside(path, line, refused_class, function_name, text)
}

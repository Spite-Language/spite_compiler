var path = ""
var class_name = ""
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
    return gathered
}

func refuse_a_missing_body(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var library = Mapping.LibraryFile()
    fallback not library.holds(path)
    var printed = Outputs.FinalClassesFolder()
    var segments = path.replace("\\", "/").split("/")
    crash segments.remove_last()
    var folder = segments.join("/")
    fallback not printed.holds(folder)
    var text = "'{class_name}.{function.name}' has no body, and only a function whose body the compiler supplies is written without one: give it a body"
    var problem = Diagnostics.Problem(path, function.line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if not function.body {
        refuse_a_missing_body(function)
    }
    fallback function.body
    var is_constructor = function.is_a_constructor_of(class_name)
    if is_constructor and function.body.statements.is_empty() {
        var text = "'{class_name}' has an empty constructor: delete it, since a class without one is made from its defaults"
        var problem = Diagnostics.Problem(path, function.line, text)
        problem.class_name = class_name
        gathered.mistakes.append(problem)
    }
}

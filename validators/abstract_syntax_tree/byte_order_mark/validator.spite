var lexer = AbstractSyntaxTree.Lexer("", 1)

# ../../../../spite_documentation/style.md#what-the-formatter-rewrites
func check(text: String): Validators.Answer {
    var answer = Validators.Answer()
    if lexer.starts_with_a_byte_order_mark(text) {
        answer.fix = "remove the byte order mark at the start of the file"
    }
    return answer
}

var names = Validators.AbstractSyntaxTree.Names.Validator()
var dictated = AbstractSyntaxTree.UnusedNames.Dictated()
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var attribute_names = List<String>()

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_the_case(name: String): Validators.Answer {
    var answer = Validators.Answer()
    if not is_lowercase_past_the_underscore(name) {
        answer.fix = "write '{name}' in snake_case"
    }
    return answer
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_rename(
    starting_walk: AbstractSyntaxTree.Walk.Walk,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    right: String,
): Validators.Answer {
    walk = starting_walk
    attribute_names = walk.attribute_declarations.map_names()
    var answer = Validators.Answer()
    if is_free(function, name, right) {
        answer.fix = "rename '{name}' to '{right}'"
    }
    return answer
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_read_parameter(
    starting_walk: AbstractSyntaxTree.Walk.Walk,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
): Validators.Answer {
    walk = starting_walk
    attribute_names = walk.attribute_declarations.map_names()
    var answer = Validators.Answer()
    var key = function.declared_key()
    var is_ignored = name.starts_with("_") and not dictated.is_dictated(function, attribute_names)
    if is_ignored and is_read_in(key, name) {
        var bare = bare_of(name)
        answer = check_a_rename(walk, function, name, bare)
    }
    return answer
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_read_local(
    starting_walk: AbstractSyntaxTree.Walk.Walk,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    key: String,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    name: String,
): Validators.Answer {
    walk = starting_walk
    var answer = Validators.Answer()
    if name.starts_with("_") and is_read_while_declared(key, statement) {
        var bare = bare_of(name)
        answer = check_a_rename(walk, function, name, bare)
    }
    return answer
}

func is_read_in(key: String, name: String): Boolean {
    var reading = AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, key)
    return reading.reads.contains(name)
}

func is_read_while_declared(key: String, statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    var reading = AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, key)
    return reading.is_read_while_declared(statement)
}

func is_free(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    right: String,
): Boolean {
    fallback right.length() > 1 or names.is_an_axis(right)
    fallback right != "from" and not is_a_word_of_the_language(right)
    fallback not takes_a_declaration(function)
    fallback not attribute_names.contains(name) and not attribute_names.contains(right)
    var function_names = walk.function_declarations.map_names()
    fallback not function_names.contains(name) and not function_names.contains(right)
    return not is_mentioned_in(function, right)
}

func is_a_word_of_the_language(word: String): Boolean {
    var lexer = AbstractSyntaxTree.Lexer.Lexer(walk.file.path, "", 1)
    return lexer.keywords.contains(word)
}

func takes_a_declaration(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if dictated.describes_a_declaration(parameter.declared_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_mentioned_in(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    var parameter_names = function.parameters.map_names()
    if parameter_names.contains(name) {
        return true
    }
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(function)
    var inside = AbstractSyntaxTree.Walk.Walk(holder)
    var index = 0
    while index < inside.expressions.count() {
        var found = inside.expressions[index]
        crash found.expression
        if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and found.expression.name == name {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < inside.statements.count() {
        var found_statement = inside.statements[index]
        crash found_statement.statement
        if found_statement.statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and found_statement.statement.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func bare_of(name: String): String {
    fallback name.starts_with("_")
    var name_length = name.length()
    var sliced = name.slice(1, name_length)
    crash sliced
    return sliced
}

func is_lowercase_past_the_underscore(name: String): Boolean {
    if name.starts_with("_") {
        var bare = bare_of(name)
        return names.is_a_lowercase_name(bare)
    }
    return names.is_a_lowercase_name(name)
}

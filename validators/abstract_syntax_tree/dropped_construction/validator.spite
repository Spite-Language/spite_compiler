union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    walk.statements.each(check_statement)
}

func check_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    function_name = found.function_name
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        check_evaluation(statement)
    }
}

func check_evaluation(evaluation: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    var value = evaluation.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(evaluation, value)
    }
}

func check_call(
    evaluation: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var made_name = constructed_name(call)
    fallback not made_name.is_empty()
    fallback made_name != "Parallel" and made_name != "Concurrent"
    var printer = Printers.Spite.ExpressionPrinter(call)
    var written = printer.text()
    var text = "'{written}' makes a '{made_name}' and drops it: a constructed object must be kept and used, so a class whose construction is the whole point should be a function instead; turn '{made_name}' into a function of the class that needs it, or keep the object in a variable that is read"
    var failure = Validators.Failure()
    failure.stop_inside(walk.file.path, evaluation.line, class_name, function_name, text)
}

func constructed_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and callee.is_a_class_name {
        return callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.is_a_class_name and is_a_class_path(callee.target) {
        var printer = Printers.Spite.ExpressionPrinter(callee)
        return printer.text()
    }
    return ""
}

func is_a_class_path(written: Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.is_a_class_name
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return written.is_a_class_name and is_a_class_path(written.target)
    }
    return false
}

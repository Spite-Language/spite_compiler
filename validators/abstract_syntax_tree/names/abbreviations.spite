func full_word_of(word: String): String {
    switch word {
        "expr": return "expression"
        "stmt": return "statement"
        "param": return "parameter"
        "params": return "parameters"
        "arg": return "argument"
        "args": return "arguments"
        "idx": return "index"
        "ctx": return "context"
        "cfg": return "configuration"
        "conf": return "configuration"
        "tmp": return "temporary"
        "temp": return "temporary"
        "str": return "string"
        "num": return "number"
        "len": return "length"
        "btn": return "button"
        "msg": return "message"
        "req": return "request"
        "res": return "response"
        "resp": return "response"
        "err": return "error"
        "val": return "value"
        "obj": return "object"
        "fn": return "function"
        "ptr": return "pointer"
        "src": return "source"
        "dst": return "destination"
        "dest": return "destination"
        "dir": return "directory"
        "pos": return "position"
        "prev": return "previous"
        "cur": return "current"
        "curr": return "current"
        "max": return "maximum"
        "min": return "minimum"
        "init": return "initialize"
        "calc": return "calculate"
        "attr": return "attribute"
        "attrs": return "attributes"
        "elem": return "element"
        "char": return "character"
        "info": return "information"
        "spec": return "specification"
        "env": return "environment"
        "db": return "database"
        "auth": return "authentication"
        "impl": return "implementation"
        "util": return "utilities"
        "utils": return "utilities"
        "lib": return "library"
        "pkg": return "package"
        "cmd": return "command"
        "desc": return "description"
        "doc": return "documentation"
        "docs": return "documentation"
        "func": return "function"
        "var": return "variable"
        "int": return "integer"
        "bool": return "boolean"
        "cnt": return "count"
        "buf": return "buffer"
        "addr": return "address"
        "mgr": return "manager"
        "evt": return "event"
        "img": return "image"
        "hdr": return "header"
        "arr": return "array"
        "vec": return "vector"
        "dict": return "dictionary"
        "coord": return "coordinate"
        "coords": return "coordinates"
        "opt": return "option"
        "opts": return "options"
        "ext": return "extension"
        "seq": return "sequence"
        "sep": return "separator"
        "avg": return "average"
        "fmt": return "format"
        "proc": return "process"
        "tbl": return "table"
        "pwd": return "password"
        "usr": return "user"
        "repo": return "repository"
        "qty": return "quantity"
        "amt": return "amount"
        "cb": return "callback"
        "sz": return "size"
        "lst": return "list"
        "rect": return "rectangle"
        "dbg": return "debug"
        "ver": return "version"
        "lang": return "language"
        "nav": return "navigation"
        "wnd": return "window"
        "ctrl": return "control"
        "nums": return "numbers"
        "vals": return "values"
        "msgs": return "messages"
        "strs": return "strings"
        "ptrs": return "pointers"
        "bufs": return "buffers"
        "elems": return "elements"
        "objs": return "objects"
        "dirs": return "directories"
        "exprs": return "expressions"
        "stmts": return "statements"
        "errs": return "errors"
        "cmds": return "commands"
        "funcs": return "functions"

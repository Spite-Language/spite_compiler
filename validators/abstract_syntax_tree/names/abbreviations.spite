        "vars": return "variables"
        "btns": return "buttons"
        "imgs": return "images"
        "evts": return "events"
        "idxs": return "indices"
        _: return ""
    }
}

func windows_word_of(word: String): String {
    switch word {
        "position": return "pos"
        "rectangle": return "rect"
        "parameter": return "param"
        "pointer": return "ptr"
        _: return word
    }
}

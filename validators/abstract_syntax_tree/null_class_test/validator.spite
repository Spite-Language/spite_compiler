# ../../../../spite_documentation/values_and_types.md#null-is-the-one-null
func check(condition: SpiteCompiler.Expression?): Validators.Answer {
    var answer = Validators.Answer()
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression and tests_for_null(condition) {
        answer.fix = "the narrowing form"
    }
    return answer
}

func tests_for_null(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares and asks_the_class(binary.left)
    var right = binary.right
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var names = Model.LanguageNames()
        return right.name == names.null_class
    }
    return false
}

func asks_the_class(left: SpiteCompiler.Expression?): Boolean {
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback left.target
        return left.name == "class"
    }
    return false
}

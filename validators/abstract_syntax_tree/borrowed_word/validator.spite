var messages = {
    "for": "Spite has no 'for': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()', 'map_<member>()' and 'filter_<member>()'"
    "foreach": "Spite has no 'foreach': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()' and 'filter_<member>()'"
    "do": "Spite has no 'do': an 'if' on a value that may be null narrows it in place, 'if value \{ ... } else \{ ... }', and inside the block 'value' is the value itself"
    "elif": "Spite writes 'else if'"
    "let": "Spite has no 'let': a variable is declared 'var name = value'"
    "const": "Spite has no 'const': every variable is declared 'var name = value' and may be written again"
    "new": "there is no 'new' in Spite: a class is made by calling its own name, like 'Creature(\"rat\")'"
    "self": "Spite has no 'self': a class reads its own attributes and calls its own functions by name"
    "nil": "'nil' is not a value in Spite: write 'null'"
    "none": "'none' cannot name a variable, because Spite reads the word as a mistake anywhere it is used: the empty value is written 'null'"
    "undefined": "'undefined' is not a value in Spite: every function answers, or it answers 'T?' and is narrowed"
    "import": "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace"
    "require": "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace"
    "break": "Spite has no 'break': a loop stops in its own condition"
    "continue": "Spite has no 'continue': a loop goes on in its own condition"
    "fn": "a function is declared 'func', not 'fn'"
    "def": "a function is declared 'func', not 'def'"
    "struct": "there is no 'struct': a file is a class, so every class is already one object with its own fields"
    "interface": "there is no 'interface': a 'type' declares a shape a value matches"
    "match": "there is no 'match': a 'switch' covers every member of a union, every value of an enum or every case of a text or a number"
    "this": "a class reads its own attributes by name: write 'name', not 'this.name'"
}

var statement_words = [
    "interface"
    "struct"
    "def"
    "fn"
    "match"
    "import"
    "require"
    "for"
    "foreach"
    "do"
    "elif"
    "let"
    "const"
    "new"
]
var line_break = 10
var number_sign = 35
var quotation_mark = 34
var apostrophe = 39
var carriage_return = 13
var open_parenthesis = 40
var underscore = 95
var _open_brace_code = 123
var _lowercase_z_code = 122

func check(
    path: String,
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    index: Integer,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
    found: List<Diagnostics.Problem>,
) {
    var token = tokens[index]
    crash token
    var word = token.lexeme
    var message = messages[word]
    fallback message
    var previous: AbstractSyntaxTree.Tokens.Token? = null
    if index > 0 {
        previous = tokens[index - 1]
    }
    fallback not follows_a_dot(previous)
    var following_code = code_after(tokens, index, comments)
    fallback not reads_as_a_name(word, token.line, previous, following_code)
    var problem = Diagnostics.Problem(path, token.line, message)
    found.append(problem)
}

func code_after(
    tokens: List<AbstractSyntaxTree.Tokens.Token>,
    index: Integer,
    comments: List<AbstractSyntaxTree.Shapes.Comment>,
): Integer {
    var token = tokens[index]
    crash token
    var next = tokens[index + 1]
    crash next
    var shares_the_line = next.line == token.line and next.kind != 'end_of_file'
    if shares_the_line {
        return first_code_of(next)
    }
    if has_a_comment_on(comments, token.line) {
        return number_sign
    }
    return line_break
}

func first_code_of(token: AbstractSyntaxTree.Tokens.Token): Integer {
    if token.kind == 'text_literal' {
        return quotation_mark
    }
    if token.kind == 'symbol_literal' {
        return apostrophe
    }
    return token.lexeme.byte_at(0)
}

func has_a_comment_on(comments: List<AbstractSyntaxTree.Shapes.Comment>, line: Integer): Boolean {
    var index = 0
    while index < comments.count() {
        var comment = comments[index]
        if comment.line == line {
            return true
        }
        index = index + 1
    }
    return false
}

func reads_as_a_name(
    word: String,
    line: Integer,
    previous: AbstractSyntaxTree.Tokens.Token?,
    following_code: Integer,
): Boolean {
    if statement_words.contains(word) {
        var names_a_variable = follows_a_variable_keyword(previous)
        var stands_as_a_name = not starts_a_name(following_code) and not its_bracket_follows(word, following_code)
        return names_a_variable or stands_as_a_name
    }
    var is_a_loop_word = word == "break" or word == "continue"
    return is_a_loop_word and not stands_alone(line, previous, following_code)
}

func follows_a_dot(previous: AbstractSyntaxTree.Tokens.Token?): Boolean {
    fallback previous
    return previous.kind == 'dot'
}

func follows_a_variable_keyword(previous: AbstractSyntaxTree.Tokens.Token?): Boolean {
    fallback previous
    return previous.kind == 'keyword_variable'
}

func starts_a_name(code: Integer): Boolean {
    var is_lower = code >= 97 and code <= _lowercase_z_code
    var is_upper = code >= 65 and code <= 90
    return is_lower or is_upper or code == underscore
}

func its_bracket_follows(word: String, code: Integer): Boolean {
    var opens_a_block = code == _open_brace_code
    var opens_a_list = code == open_parenthesis
    var takes_a_block = word == "do" or word == "struct" or word == "interface"
    var takes_a_list = word == "for" or word == "foreach" or word == "match" or word == "fn" or word == "def"
    return opens_a_block and takes_a_block or opens_a_list and takes_a_list
}

func stands_alone(line: Integer, previous: AbstractSyntaxTree.Tokens.Token?, following_code: Integer): Boolean {
    var shares_the_line = false
    if previous {
        shares_the_line = previous.line == line
    }
    fallback not shares_the_line
    return following_code == -1 or following_code == line_break or following_code == carriage_return
}

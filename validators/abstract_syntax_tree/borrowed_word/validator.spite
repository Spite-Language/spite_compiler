var messages = {
    "for": "Spite has no 'for': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()', 'map_<member>()' and 'filter_<member>()'"
    "foreach": "Spite has no 'foreach': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()' and 'filter_<member>()'"
    "do": "Spite has no 'do': an 'if' on a value that may be null narrows it in place, 'if value \{ ... } else \{ ... }', and inside the block 'value' is the value itself"
    "elif": "Spite writes 'else if'"
    "let": "Spite has no 'let': a variable is declared 'var name = value'"
    "const": "Spite has no 'const': every variable is declared 'var name = value' and may be written again"
    "new": "there is no 'new' in Spite: a class is made by calling its own name, like 'Creature(\"rat\")'"
    "self": "Spite has no 'self': a class reads its own attributes and calls its own functions by name"
    "nil": "'nil' is not a value in Spite: write 'null'"
    "none": "'none' cannot name a variable, because Spite reads the word as a mistake anywhere it is used: the empty value is written 'null'"
    "undefined": "'undefined' is not a value in Spite: every function answers, or it answers 'T?' and is narrowed"
    "import": "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace"
    "require": "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace"
    "break": "Spite has no 'break': a loop stops in its own condition"
    "continue": "Spite has no 'continue': a loop goes on in its own condition"
    "fn": "a function is declared 'func', not 'fn'"
    "def": "a function is declared 'func', not 'def'"
    "struct": "there is no 'struct': a file is a class, so every class is already one object with its own fields"
    "interface": "there is no 'interface': a 'type' declares a shape a value matches"
    "match": "there is no 'match': a 'switch' covers every member of a union, every value of an enum or every case of a text or a number"
    "this": "a class reads its own attributes by name: write 'name', not 'this.name'"
}

func check(path: String, line: Integer, word: String) {
    var message = messages[word]
    fallback message
    refuse(path, line, message)
}

func refuse(path: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

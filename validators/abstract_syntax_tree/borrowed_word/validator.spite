func check(path: String, line: Integer, word: String) {
    switch word {
        "for": {
            refuse(
                path,
                line,
                "Spite has no 'for': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()', 'map_<member>()' and 'filter_<member>()'",
            )
        }
        "foreach": {
            refuse(
                path,
                line,
                "Spite has no 'foreach': Spite has only the 'while' loop. Write 'while', or the member templates 'each_<member>()' and 'filter_<member>()'",
            )
        }
        "do": {
            refuse(
                path,
                line,
                "Spite has no 'do': an 'if' on a value that may be null narrows it in place, 'if value \{ ... } else \{ ... }', and inside the block 'value' is the value itself",
            )
        }
        "elif": refuse(path, line, "Spite writes 'else if'")
        "let": refuse(path, line, "Spite has no 'let': a variable is declared 'var name = value'")
        "const": {
            refuse(
                path,
                line,
                "Spite has no 'const': every variable is declared 'var name = value' and may be written again",
            )
        }
        "new": {
            refuse(
                path,
                line,
                "there is no 'new' in Spite: a class is made by calling its own name, like 'Creature(\"rat\")'",
            )
        }
        "self": refuse(path, line, "Spite has no 'self': a class reads its own attributes and calls its own functions by name")
        "nil": refuse(path, line, "'nil' is not a value in Spite: write 'null'")
        "none": {
            refuse(
                path,
                line,
                "'none' cannot name a variable, because Spite reads the word as a mistake anywhere it is used: the empty value is written 'null'",
            )
        }
        "undefined": {
            refuse(
                path,
                line,
                "'undefined' is not a value in Spite: every function answers, or it answers 'T?' and is narrowed",
            )
        }
        "import": {
            refuse(
                path,
                line,
                "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace",
            )
        }
        "require": {
            refuse(
                path,
                line,
                "there are no imports: 'load \"folder\"' inside a function brings a folder into the program, and everything shares one namespace",
            )
        }
        "break": refuse(path, line, "Spite has no 'break': a loop stops in its own condition")
        "continue": refuse(path, line, "Spite has no 'continue': a loop goes on in its own condition")
        "fn": refuse(path, line, "a function is declared 'func', not 'fn'")
        "def": refuse(path, line, "a function is declared 'func', not 'def'")
        "struct": {
            refuse(
                path,
                line,
                "there is no 'struct': a file is a class, so every class is already one object with its own fields",
            )
        }
        "interface": refuse(path, line, "there is no 'interface': a 'type' declares a shape a value matches")
        "match": {
            refuse(
                path,
                line,
                "there is no 'match': a 'switch' covers every member of a union, every value of an enum or every case of a text or a number",
            )
        }
        "this": refuse(path, line, "a class reads its own attributes by name: write 'name', not 'this.name'")
        "Nullable": {
            refuse(
                path,
                line,
                "'Nullable<T>' was replaced by a '?' after the type: write 'Monster?' for a value that may be null",
            )
        }
        _: return
    }
}

func refuse(path: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

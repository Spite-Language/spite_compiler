enum Mistake {
    'unreadable'
    'unclosed_symbol'
    'unclosed_text'
    'unclosed_hole'
    'bare_codegen_mark'
    'number_separator'
    'number_exponent'
}

func refuse(path: String, line: Integer, mistake: Mistake, written: String) {
    var text = text_of(mistake, written)
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(mistake: Mistake, written: String): String {
    switch mistake {
        'unreadable': return unreadable_text(written)
        'unclosed_symbol': return "this symbol is never closed: write its closing \"'\""
        'unclosed_text': return "this text never closes: a text is written on one line, and a line break inside it is written as a backslash and n"
        'unclosed_hole': return unclosed_hole_text()
        'bare_codegen_mark': return "'$' is written before a name, as in '$name': what is replaced at code generation is a hole, never a value"
        'number_separator': return "'{written}' separates its digits wrongly: a '_' stands between two digits, one at a time, as in 1_000_000 or 0.000_01"
        'number_exponent': return exponent_text(written)
    }
}

func unreadable_text(written: String): String {
    if written == ";" {
        return "';' is not something Spite reads: a statement is one line"
    } else if written == "&" {
        return "Spite has no '&': bits are functions on the whole numbers, 'bits_and(mask)', and 'and' joins conditions"
    } else if written == "|" {
        return "Spite has no '|': bits are functions on the whole numbers, 'bits_or(mask)', and 'or' joins conditions"
    } else if written == "^" {
        return "Spite has no '^': bits are functions on the whole numbers, 'bits_exclusive_or(mask)'"
    } else if written == "~" {
        return "Spite has no '~': bits are functions on the whole numbers, 'bits_inverted()'"
    } else if written == "->" {
        return "Spite has no '->': there are no lambdas, so pass a function by name"
    } else if written == "**" {
        return "Spite has no '**': write 'base.power(exponent)'"
    } else if written == "//" {
        return "Spite has no '//': a comment is one line starting with '#' and holding a link to a heading"
    } else if written == "/*" {
        return "Spite has no '/* */': a comment is one line starting with '#' and holding a link to a heading"
    } else if written == "!" {
        return "Spite writes 'not' as a word"
    } else if written == "&&" {
        return "Spite writes 'and' and 'or' as words: there is no '&&' or '||'"
    } else if written == "||" {
        return "Spite writes 'and' and 'or' as words: there is no '&&' or '||'"
    } else if written == "&Type" {
        return "Spite has no '&Type': every class, list and text is passed by reference already, so write the type alone"
    } else if written == "++" {
        return "Spite has no '++': write 'count = count + 1'"
    } else if written == "--" {
        return "Spite has no '--': write 'count = count - 1'"
    } else {
        return unreadable_other(written)
    }
}

func unclosed_hole_text(): String {
    var first = "this '\{' inside text never closes"
    var second = "write the value between '\{' and '}', like \"hello \{name}\""
    var third = "or write a '\{' of its own as backslash \{"
    return "{first}: {second}, {third}"
}

func unreadable_other(written: String): String {
    var is_compound = written.length() == 2 and written.ends_with("=")
    if is_compound {
        var operator = written.slice(0, 1)
        crash operator
        return "Spite has no '{written}': write 'count = count {operator} value'"
    }
    return "'{written}' is not something Spite reads: write it in words"
}

func exponent_text(written: String): String {
    var plain = plain_digits(written)
    return "Spite writes no exponent in a number: write '{written}' as {plain}, its digits in full, separated by '_' where that helps reading, as in 1_000_000"
}

func plain_digits(written: String): String {
    var marker = written.index_of("e")
    if not marker {
        marker = written.index_of("E")
    }
    crash marker
    var length = written.length()
    var mantissa = written.slice(0, marker)
    crash mantissa
    var exponent_written = written.slice(marker + 1, length)
    crash exponent_written
    var unsigned_exponent = exponent_written.replace("+", "")
    var exponent_value: Integer? = unsigned_exponent
    crash exponent_value
    var whole = mantissa
    var fraction = ""
    var point = mantissa.index_of(".")
    if point {
        var mantissa_length = mantissa.length()
        var before = mantissa.slice(0, point)
        crash before
        var after = mantissa.slice(point + 1, mantissa_length)
        crash after
        whole = before
        fraction = after
    }
    var joined = "{whole}{fraction}"
    var digits = joined.replace("_", "")
    var whole_digits = whole.replace("_", "")
    var point_at = whole_digits.length() + exponent_value
    while point_at > digits.length() {
        digits = "{digits}0"
    }
    while point_at < 1 {
        digits = "0{digits}"
        point_at = point_at + 1
    }
    var digit_count = digits.length()
    var integer_part = digits.slice(0, point_at)
    crash integer_part
    var fraction_part = digits.slice(point_at, digit_count)
    crash fraction_part
    integer_part = without_leading_zeros(integer_part)
    fraction_part = without_trailing_zeros(fraction_part)
    var grouped = grouped_digits(integer_part)
    if fraction_part.is_empty() {
        return grouped
    }
    return "{grouped}.{fraction_part}"
}

func without_leading_zeros(digits: String): String {
    var kept = digits
    while kept.length() > 1 and kept.starts_with("0") {
        var kept_length = kept.length()
        var shorter = kept.slice(1, kept_length)
        crash shorter
        kept = shorter
    }
    return kept
}

func without_trailing_zeros(digits: String): String {
    var kept = digits
    while kept.ends_with("0") {
        var last = kept.length() - 1
        var shorter = kept.slice(0, last)
        crash shorter
        kept = shorter
    }
    return kept
}

func grouped_digits(digits: String): String {
    var grouped = ""
    var index = 0
    var count = digits.length()
    while index < count {
        var letter = digits[index]
        crash letter
        var left = count - index
        if index > 0 and left % 3 == 0 {
            grouped = "{grouped}_"
        }
        grouped = "{grouped}{letter}"
        index = index + 1
    }
    return grouped
}

func refuse(path: String, line: Integer, mistake: SpellingMistake, written: String) {
    var text = text_of(mistake, written)
    var problem = Diagnostics.Problem(path, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(mistake: SpellingMistake, written: String): String {
    switch mistake {
        'unreadable': return unreadable_text(written)
        'unclosed_symbol': return "this symbol is never closed: write its closing \"'\""
        'unclosed_text': return "this text never closes: a text is written on one line, and a line break inside it is written as a backslash and n"
        'escape': return escape_text()
        'bare_codegen_mark': return "'$' is written before a name, as in '$name': what is replaced at code generation is a hole, never a value"
    }
}

func unreadable_text(written: String): String {
    switch written {
        ";": return "';' is not something Spite reads: a statement is one line"
        "&": return "Spite has no '&': bits are functions on the whole numbers, 'bits_and(mask)', and 'and' joins conditions"
        "|": return "Spite has no '|': bits are functions on the whole numbers, 'bits_or(mask)', and 'or' joins conditions"
        "^": return "Spite has no '^': bits are functions on the whole numbers, 'bits_exclusive_or(mask)'"
        "~": return "Spite has no '~': bits are functions on the whole numbers, 'bits_inverted()'"
        "->": return "Spite has no '->': there are no lambdas, so pass a function by name"
        "**": return "Spite has no '**': write 'base.power(exponent)'"
        "//": return "Spite has no '//': a comment is one line starting with '#' and holding a link to a heading"
        "/*": return "Spite has no '/* */': a comment is one line starting with '#' and holding a link to a heading"
        "!": return "Spite writes 'not' as a word"
        "&&": return "Spite writes 'and' and 'or' as words: there is no '&&' or '||'"
        "||": return "Spite writes 'and' and 'or' as words: there is no '&&' or '||'"
        "&Type": return "Spite has no '&Type': every class, list and text is passed by reference already, so write the type alone"
        "++": return "Spite has no '++': write 'count = count + 1'"
        "--": return "Spite has no '--': write 'count = count - 1'"
        _: return unreadable_other(written)
    }
}

func escape_text(): String {
    var first = "this is not something Spite reads in a text"
    var second = "write a backslash and n, t or r for a line end, a tab or a return"
    var third = "and a backslash and the character for a quote or a brace"
    return "{first}: {second}, {third}"
}

func unreadable_other(written: String): String {
    var is_compound = written.length() == 2 and written.ends_with("=")
    if is_compound {
        var operator = written.slice(0, 1)
        return "Spite has no '{written}': write 'count = count {operator} value'"
    }
    return "'{written}' is not something Spite reads: write it in words"
}

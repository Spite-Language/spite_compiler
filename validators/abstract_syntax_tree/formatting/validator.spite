var path = ""

# ../../../../spite_spec/specs/style.md#formatting
func check(
    checked_path: String,
    printed: String,
    printed_again: String,
    written_comments: Integer,
    printed_comments: Integer,
) {
    path = checked_path
    if printed_comments < written_comments {
        refuse("it would drop a comment")
    }
    if printed_comments > written_comments {
        refuse("it would add a comment")
    }
    fallback printed != printed_again
    refuse("the file it prints does not print the same once read again")
}

func refuse(reason: String) {
    var text = "the formatter refuses it, and a program compiles only once formatted: {reason}"
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

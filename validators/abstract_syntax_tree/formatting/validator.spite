var path = ""

func check(
    checked_path: String,
    written: List<AbstractSyntaxTree.Tokens.Token>,
    written_comments: List<AbstractSyntaxTree.Shapes.Comment>,
    formatted: List<AbstractSyntaxTree.Tokens.Token>,
    formatted_comments: List<AbstractSyntaxTree.Shapes.Comment>,
) {
    path = checked_path
    check_the_tokens(written, formatted)
    check_the_comments(written, written_comments, formatted, formatted_comments)
}

func check_the_tokens(
    written: List<AbstractSyntaxTree.Tokens.Token>,
    formatted: List<AbstractSyntaxTree.Tokens.Token>,
) {
    var index = 0
    while index < written.count() {
        var before = written[index]
        var after = formatted[index]
        if not after {
            refuse("it would drop the code from line {before.line} on")
        }
        crash after
        var same = before.kind == after.kind and before.lexeme == after.lexeme
        if not same {
            refuse("it would change the code on line {before.line}")
        }
        if index > 0 {
            check_the_line_break(written, formatted, index)
        }
        index = index + 1
    }
    assert formatted.count() > written.count()
    refuse("it would add code after the end of the file")
}

func check_the_line_break(
    written: List<AbstractSyntaxTree.Tokens.Token>,
    formatted: List<AbstractSyntaxTree.Tokens.Token>,
    index: Integer,
) {
    var before = written[index]
    var before_previous = written[index - 1]
    var after = formatted[index]
    var after_previous = formatted[index - 1]
    crash before
    crash before_previous
    crash after
    crash after_previous
    assert before.kind != 'end_of_file'
    var shared_before = before.line == before_previous.line
    var shared_after = after.line == after_previous.line
    assert shared_before != shared_after
    refuse("it would move the code on line {before.line} to another line")
}

func check_the_comments(
    written: List<AbstractSyntaxTree.Tokens.Token>,
    written_comments: List<AbstractSyntaxTree.Shapes.Comment>,
    formatted: List<AbstractSyntaxTree.Tokens.Token>,
    formatted_comments: List<AbstractSyntaxTree.Shapes.Comment>,
) {
    var index = 0
    while index < written_comments.count() {
        var before = written_comments[index]
        var after = formatted_comments[index]
        if not after {
            refuse("it would drop the comment on line {before.line}")
        }
        crash after
        var counted_before = tokens_through(written, before.line)
        var counted_after = tokens_through(formatted, after.line)
        var trailing_before = shares_a_line(written, before.line)
        var trailing_after = shares_a_line(formatted, after.line)
        var same = before.text == after.text and counted_before == counted_after and trailing_before == trailing_after
        if not same {
            refuse("it would change or move the comment on line {before.line}")
        }
        index = index + 1
    }
    assert formatted_comments.count() > written_comments.count()
    refuse("it would add a comment")
}

func tokens_through(tokens: List<AbstractSyntaxTree.Tokens.Token>, line: Integer): Integer {
    var count = 0
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.line <= line and token.kind != 'end_of_file' {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func shares_a_line(tokens: List<AbstractSyntaxTree.Tokens.Token>, line: Integer): Boolean {
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.line == line and token.kind != 'end_of_file' {
            return true
        }
        index = index + 1
    }
    return false
}

func refuse(reason: String) {
    var text = "the formatter refuses it, and a program compiles only once formatted: {reason}"
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

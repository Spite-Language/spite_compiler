var console = Console()
var path = ""

# ../../../../spite_spec/specs/style.md#formatting
func check(
    checked_path: String,
    printed: String,
    printed_again: String,
    written_comments: Integer,
    printed_comments: Integer,
) {
    path = checked_path
    if printed_comments < written_comments {
        refuse("it would drop a comment")
    }
    if printed_comments > written_comments {
        refuse("it would add a comment")
    }
    fallback printed != printed_again
    refuse("the file it prints does not print the same once read again")
}

# ../../../../spite_spec/specs/style.md#formatting
func check_the_texts(
    checked_path: String,
    written: AbstractSyntaxTree.Shapes.SourceFile,
    read_again: AbstractSyntaxTree.Shapes.SourceFile,
) {
    var held = texts_of(written)
    var printed = texts_of(read_again)
    var lost = first_text_missing_from(held, printed)
    var gained = first_text_missing_from(printed, held)
    var kept = not lost and not gained
    fallback not kept
    var was = shown(lost)
    var now = shown(gained)
    console.error("the formatter would change a text in {checked_path}: it reads {was} and would print {now}")
    crash kept
}

func shown(text: String?): String {
    if text {
        return "'{text}'"
    }
    return "nothing"
}

func texts_of(tree: AbstractSyntaxTree.Shapes.SourceFile): List<String> {
    var walked = AbstractSyntaxTree.Walk.Walk(tree)
    var texts = List<String>()
    var index = 0
    while index < walked.expressions.count() {
        var found = walked.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = value_of(expression)
            texts.append(text)
        }
        index = index + 1
    }
    return texts
}

func value_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var values = List<String>()
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        var value = piece.value()
        values.append(value)
        if piece.hole {
            values.append("HOLE")
        }
        index = index + 1
    }
    return values.join("")
}

func first_text_missing_from(texts: List<String>, others: List<String>): String? {
    var left = others.copy()
    var index = 0
    while index < texts.count() {
        var text = texts[index]
        var at = left.index_of(text)
        if not at {
            return text
        }
        left.remove_at(at)
        index = index + 1
    }
    return null
}

func refuse(reason: String) {
    var text = "the formatter refuses it, and a program compiles only once formatted: {reason}"
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var highest = 0
var order = "the singleton line, generic lines, enums, unions, types, variables, the constructor, conversions, presets, then functions"

func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String) {
    highest = 0
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var rank = rank_of(declaration, class_name)
        if rank < highest {
            refuse(file, class_name, declaration.line, rank)
        }
        highest = rank
        index = index + 1
    }
}

# ../../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func misplaced(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Diagnostics.Problem> {
    var found = List<Diagnostics.Problem>()
    highest = 0
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var rank = rank_of(declaration, class_name)
        if rank < highest {
            var later = rank_name(rank)
            var earlier = rank_name(highest)
            var text = "{later} came after {earlier} here; moved it up, since a file is ordered: {order}"
            var problem = Diagnostics.Problem(file.path, declaration.line, text)
            problem.class_name = class_name
            problem.is_fix = true
            found.append(problem)
        } else {
            highest = rank
        }
        index = index + 1
    }
    return found
}

func ranks(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): List<Integer> {
    var found = List<Integer>()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var rank = rank_of(declaration, class_name)
        found.append(rank)
        index = index + 1
    }
    return found
}

func starts(file: AbstractSyntaxTree.Shapes.SourceFile): List<Integer> {
    var found = List<Integer>()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        found.append(declaration.line)
        index = index + 1
    }
    return found
}

func rank_of(declaration: Declaration, class_name: String): Integer {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return 0
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return 1
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return 2
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return 3
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return 4
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return 5
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return rank_of_function(declaration, class_name)
    }
}

func rank_of_function(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    class_name: String,
): Integer {
    if function.is_a_conversion() {
        return 7
    }
    if function.is_a_preset_of(class_name) {
        return 8
    }
    if function.is_a_constructor_of(class_name) {
        return 6
    }
    return 9
}

func refuse(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String, line: Integer, rank: Integer) {
    var later = rank_name(rank)
    var earlier = rank_name(highest)
    var text = "{later} comes after {earlier} here, but a file is ordered: {order}"
    var failure = Validators.Failure()
    failure.stop_at(file.path, line, class_name, text)
}

func rank_name(rank: Integer): String {
    if rank == 0 {
        return "the singleton line"
    } else if rank == 1 {
        return "a generic line"
    } else if rank == 2 {
        return "an enum"
    } else if rank == 3 {
        return "a union"
    } else if rank == 4 {
        return "a type"
    } else if rank == 5 {
        return "a variable"
    } else if rank == 6 {
        return "the constructor"
    } else if rank == 7 {
        return "a conversion"
    } else if rank == 8 {
        return "a preset"
    } else {
        return "a function"
    }
}

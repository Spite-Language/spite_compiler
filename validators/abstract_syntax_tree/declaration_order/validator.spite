var highest = 0
var order = "the singleton line, generic lines, enums, unions, types, variables with a default, variables without one, the constructor, conversions, presets, then functions"
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    highest = 0
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var rank = file.rank_of(declaration, class_name)
        if rank < highest {
            refuse(file, class_name, declaration.line, rank)
        }
        highest = rank
        index = index + 1
    }
    return gathered
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_place(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    class_name: String,
    declaration: SpiteCompiler.Declaration,
    highest_before: Integer,
): Validators.Answer {
    var answer = Validators.Answer()
    var rank = file.rank_of(declaration, class_name)
    if rank < highest_before {
        var later = rank_name(rank)
        answer.fix = "move {later} up"
    }
    return answer
}

func refuse(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String, line: Integer, rank: Integer) {
    var later = rank_name(rank)
    var earlier = rank_name(highest)
    var text = "{later} comes after {earlier} here, but a file is ordered: {order}"
    var problem = Diagnostics.Problem(file.path, line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

func rank_name(rank: Integer): String {
    if rank == 0 {
        return "the singleton line"
    } else if rank == 1 {
        return "a generic line"
    } else if rank == 2 {
        return "an enum"
    } else if rank == 3 {
        return "a union"
    } else if rank == 4 {
        return "a type"
    } else if rank == 5 {
        return "a variable"
    } else if rank == 6 {
        return "a variable without a default"
    } else if rank == 7 {
        return "the constructor"
    } else if rank == 8 {
        return "a conversion"
    } else if rank == 9 {
        return "a preset"
    } else {
        return "a function"
    }
}

func refuse(path: String, found: AbstractSyntaxTree.Tokens.Token, mistake: Mistake) {
    var text = text_of(mistake, found.lexeme)
    var problem = Diagnostics.Problem(path, found.line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func text_of(mistake: Mistake, found: String): String {
    switch mistake {
        'codegen_value_after_generic': return "expected a codegen value after 'generic', as in 'generic $name', and found '{found}'"
        'enum_name': return "an enum is named in PascalCase, and found '{found}'"
        'enum_value': return "an enum's values are symbols, as in 'knight', and found '{found}'"
        'union_name': return "a union is named in PascalCase, and found '{found}'"
        'union_member': return "a union's members are classes, as in 'Player', and found '{found}'"
        'type_name': return "a type is named in PascalCase, and found '{found}'"
        'type_member': return "a type's members are written 'name: Type' or 'name(Type, Type): Type', and found '{found}'"
        'shape_parameter_name': return shape_parameter_text()
        'class_name_after_dot': return "expected a class name after the dot and found '{found}'"
        'name_after_dot': return "expected a name after the dot and found '{found}'"
        'variable_name': return "expected the name of a variable and found '{found}'"
        'variable_default': return "every variable has a default value, so write '=' and the value"
        'function_name': return "a function is declared 'func name()', so a name follows 'func', and found '{found}'"
        'function_parentheses': return "a function takes its parameters in parentheses, as in 'func name(value: Type)'"
        'parameter_shape': return "a parameter is declared 'name: Type', and found '{found}'"
        'parameter_type': return "a parameter is declared 'name: Type', so write its type after the ':'"
        'opening_brace': return "expected an opening brace and found '{found}'"
        'closing_brace': return "this brace is never closed: write the closing brace that ends it"
        'parameters_closing_parenthesis': return "expected the closing parenthesis of the parameters and found '{found}'"
        'arguments_closing_parenthesis': return "expected the closing parenthesis of the arguments and found '{found}'"
        'group_closing_parenthesis': return "expected the closing parenthesis of the group and found '{found}'"
        'closing_bracket': return "expected the closing bracket and found '{found}'"
        'else_without_if': return "this 'else' follows no 'if': an 'else' comes right after the brace closing the branch it answers"
        'case_colon': return "a case is written 'value:' or 'Class:', so write the ':' after it"
        'key_colon': return "a written key is written 'key: value', so write the ':' after it"
        'statement_in_file': return "a file holds declarations and nothing else, so a statement cannot stand here"
        'left_over': return "'{found}' is left over after the end of the statement: a statement is one line"
        'shift_left': return "Spite has no '<<': bits are functions on the whole numbers, write 'value.shifted_left(count)'"
        'shift_right': return "Spite has no '>>': bits are functions on the whole numbers, write 'value.shifted_right(count)'"
        'question_mark': return question_mark_text()
        'value': return "expected a value and found '{found}'"
        'type': return "expected a type and found '{found}'"
        'return_type_colon': return "a function's answer is written after a ':', as in 'func total(): Integer', and found '{found}'"
        'load_function_name': return "'load' is a keyword and cannot name a function: give it a name that says what it loads, like 'load_texture'"
        'load_parentheses': return "'load' is a keyword, not a function: write it without parentheses, 'load \"level\"'"
        'load_as_value': return "'load' is a statement on a line of its own, like 'load \"folder\"': it is not a function, and it has no value"
        'class_keyword': return "there is no 'class' keyword: a file is a class, named after the file, and its attributes and functions are written at the top of that file"
        'declaration_equal': return "a declaration takes no '=': write 'enum Job \{' with one entry on each line"
        'declaration_comma': return "the entries of an enum or a union are one per line, not separated by commas: delete the ','"
        'this_member': return "a class reads its own attributes and calls its own functions by name: write 'name', not 'this.name'"
    }
}

func shape_parameter_text(): String {
    var first = "a shape names the types it needs, not the names they are given"
    return "{first}: write the type alone, since a class satisfies it whatever it calls its parameters"
}

func question_mark_text(): String {
    var first = "a question mark follows a type to write it as one that may be absent, as in 'Monster?'"
    return "{first}: it is not how Spite chooses between two values, so write an 'if' with an 'else'"
}

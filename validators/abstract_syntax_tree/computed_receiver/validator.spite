union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var path = ""
var class_name = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_callee(found, expression.callee)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        check_index(found, expression)
    }
}

func check_index(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    var inner = inner_read_of(read.index)
    assert inner
    crash read.target
    var inner_printer = Printers.Spite.ExpressionPrinter(inner)
    var inner_text = inner_printer.text()
    var target_printer = Printers.Spite.ExpressionPrinter(read.target)
    var target_text = target_printer.text()
    var text = "'{inner_text}' is read inside the index of '{target_text}': compute it first into a named 'var' and pass the name"
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func inner_read_of(
    expression: Expression?,
): AbstractSyntaxTree.Shapes.Expressions.IndexExpression? {
    assert expression
    return inner_read_in(expression)
}

func inner_read_in(
    expression: Expression,
): AbstractSyntaxTree.Shapes.Expressions.IndexExpression? {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return expression
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return inner_read_of(expression.target)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return inner_read_of(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return inner_read_of_either(expression)
        _: return null
    }
}

func inner_read_of_either(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.IndexExpression? {
    var on_the_left = inner_read_of(binary.left)
    if on_the_left {
        return on_the_left
    }
    return inner_read_of(binary.right)
}

func check_callee(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    callee: Expression?,
) {
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_receiver(found, callee)
    }
}

func check_receiver(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var is_a_binary = member.target == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    var is_a_unary = member.target == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    assert is_a_binary or is_a_unary
    assert not is_a_negative_literal(member.target)
    crash member.target
    var printer = Printers.Spite.ExpressionPrinter(member.target)
    var written = printer.text()
    var text = "'({written}).{member.name}(...)' calls a function on a value computed in place: name it first ('var named = {written}') and call 'named.{member.name}(...)', since only a name calls a function"
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func is_a_negative_literal(target: Expression?): Boolean {
    if target == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        var operand = target.operand
        var is_a_literal = operand == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
        return target.operator == 'minus' and is_a_literal
    }
    return false
}

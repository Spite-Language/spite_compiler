var path = ""
var class_name = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.FoundExpression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_callee(found, expression.callee)
    }
}

func check_callee(
    found: AbstractSyntaxTree.Walk.FoundExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_receiver(found, callee)
    }
}

func check_receiver(
    found: AbstractSyntaxTree.Walk.FoundExpression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var is_a_binary = member.target == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    var is_a_unary = member.target == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    assert is_a_binary or is_a_unary
    assert not is_a_negative_literal(member.target)
    crash member.target
    var printer = Printers.Spite.ExpressionPrinter(member.target)
    var written = printer.text()
    var text = "'({written}).{member.name}(...)' calls a function on a value computed in place: name it first ('var named = {written}') and call 'named.{member.name}(...)', since only a name calls a function"
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func is_a_negative_literal(target: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if target == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        var operand = target.operand
        var is_a_literal = operand == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
        return target.operator == 'minus' and is_a_literal
    }
    return false
}

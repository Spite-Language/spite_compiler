# ../../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func check(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    file: AbstractSyntaxTree.Shapes.SourceFile,
): Validators.Answer {
    var answer = Validators.Answer()
    var name = attribute_of(function)
    if not name.is_empty() and declares(file, name) and not takes_the_name(function, name) {
        answer.fix = name
    }
    return answer
}

func attribute_of(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    var names = Model.AccessorNames()
    var written = names.written_by(function.name)
    if not written.is_empty() and function.parameters.count() == 1 {
        return written
    }
    var read = names.read_by(function.name)
    if not read.is_empty() and function.parameters.is_empty() and function.result {
        return read
    }
    return ""
}

func declares(file: AbstractSyntaxTree.Shapes.SourceFile, name: String): Boolean {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and declaration.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func takes_the_name(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name {
            return true
        }
        index = index + 1
    }
    var holder = AbstractSyntaxTree.Shapes.SourceFile("", "")
    holder.declarations.append(function)
    var walk = AbstractSyntaxTree.Walk(holder)
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return true
        }
        statement_index = statement_index + 1
    }
    return false
}

# ../../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func holds_the_name(written: SpiteCompiler.Expression?, name: String): Boolean {
    fallback written
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return written.name == name
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return either_holds(written.left, written.right, name)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return holds_the_name(written.operand, name)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return a_call_holds(written, name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return holds_the_name(written.target, name)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return either_holds(written.target, written.index, name)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return an_item_holds(written.entries, name)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return an_item_holds(written.pairs, name)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return either_holds(written.key, written.value, name)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return a_hole_holds(written, name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
    }
}

func either_holds(left: SpiteCompiler.Expression?, right: SpiteCompiler.Expression?, name: String): Boolean {
    return holds_the_name(left, name) or holds_the_name(right, name)
}

func a_call_holds(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    return holds_the_name(call.callee, name) or an_item_holds(call.arguments, name)
}

func an_item_holds(items: List<SpiteCompiler.Expression>, name: String): Boolean {
    var index = 0
    while index < items.count() {
        var item = items[index]
        if holds_the_name(item, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func a_hole_holds(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral, name: String): Boolean {
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        if holds_the_name(piece.hole, name) {
            return true
        }
        index = index + 1
    }
    return false
}

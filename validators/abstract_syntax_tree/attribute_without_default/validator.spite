var class_name = ""
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var paths = AbstractSyntaxTree.Walk.ConstructorPaths(empty_file)
var gathered = Validators.Answer()
var built_elsewhere = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    class_name = starting_class_name
    paths = AbstractSyntaxTree.Walk.ConstructorPaths(walk.file)
    built_elsewhere = ""
    walk.attribute_declarations.each(gather_about)
    return gathered
}

# ../../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func check_the_merged(merged: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    class_name = starting_class_name
    paths = AbstractSyntaxTree.Walk.ConstructorPaths(merged)
    built_elsewhere = "the class is built by the constructor in another of its files, where "
    fallback not paths.made_in().is_empty()
    var index = 0
    while index < merged.declarations.count() {
        var declaration = merged.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            gather_about_the_merged(declaration)
        }
        index = index + 1
    }
    return gathered
}

func gather_about(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var answer = answer_for(attribute)
    gathered.take(answer)
}

func gather_about_the_merged(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var answer = answer_for(attribute)
    fallback answer.is_a_mistake()
    var made_in = paths.made_in()
    var is_told_by_its_file = attribute.path == made_in
    var reads_in_another_file = not paths.reading_path.is_empty() and paths.reading_path != made_in
    fallback not is_told_by_its_file or reads_in_another_file
    gathered.take(answer)
}

# ../../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func answer_for(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Validators.Answer {
    var answer = Validators.Answer()
    fallback not attribute.value
    var gap = paths.path_without(attribute.name)
    var advice = "give it a value on every path of the constructor, or write a default"
    if gap.is_empty() {
        gap = paths.read_before(attribute.name)
        advice = "give it its value before anything reads it, or write a default"
    }
    fallback not gap.is_empty()
    var where = ""
    if attribute.path != paths.made_in() {
        where = built_elsewhere
    }
    var text = "the attribute '{attribute.name}' has no default, so the constructor gives it its value, but {where}{gap}: {advice}"
    var problem = Diagnostics.Problem(attribute.path, attribute.line, text)
    problem.class_name = class_name
    answer.mistakes.append(problem)
    return answer
}

var class_name = ""
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var paths = AbstractSyntaxTree.Walk.ConstructorPaths(empty_file)
var gathered = Validators.Answer()

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    class_name = starting_class_name
    paths = AbstractSyntaxTree.Walk.ConstructorPaths(walk.file)
    walk.attribute_declarations.each(gather_about)
    return gathered
}

func gather_about(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var answer = answer_for(attribute)
    gathered.take(answer)
}

# ../../../../spite_documentation/classes_and_files.md#an-attribute-the-constructor-fills-has-no-default
func answer_for(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Validators.Answer {
    var answer = Validators.Answer()
    fallback not attribute.value
    var gap = paths.path_without(attribute.name)
    fallback not gap.is_empty()
    var text = "the attribute '{attribute.name}' has no default, so the constructor gives it its value, but {gap}: give it a value on every path of the constructor, or write a default"
    var problem = Diagnostics.Problem(attribute.path, attribute.line, text)
    problem.class_name = class_name
    answer.mistakes.append(problem)
    return answer
}

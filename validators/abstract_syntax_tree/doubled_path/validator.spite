var doubled_at = -1

# ../../../../spite_documentation/classes_and_files.md#a-folder-is-a-class
func check(written: List<String>, table: Symbols.SymbolTable, from_namespace: String): Validators.Answer {
    var answer = Validators.Answer()
    doubled_at = -1
    var index = 0
    while index < written.count() - 1 {
        if names_its_folder_twice(written, index, table, from_namespace) {
            doubled_at = index
            answer.fix = joined_without(written, index + 1)
            return answer
        }
        index = index + 1
    }
    return answer
}

# ../../../../spite_documentation/classes_and_files.md#a-folder-is-a-class
func shortened_text(written: String, fix: String): String {
    var parts = written.split(".")
    var twice = parts[doubled_at]
    crash twice
    return "'{written}' names '{twice}' twice, and a folder is its own class: wrote '{fix}'"
}

func names_its_folder_twice(
    written: List<String>,
    index: Integer,
    table: Symbols.SymbolTable,
    from_namespace: String,
): Boolean {
    var name = written[index]
    var next = written[index + 1]
    crash name and next
    fallback name == next
    var outer = joined_up_to(written, index + 1)
    var meant = table.entry_class_reached(outer, from_namespace)
    fallback meant
    fallback not table.map.has("{meant.namespace}.{name}")
    var found = table.find(outer, from_namespace)
    fallback found
    return found.namespace == meant.namespace
}

func joined_up_to(parts: List<String>, end: Integer): String {
    var taken = List<String>()
    var index = 0
    while index < end {
        var part = parts[index]
        crash part
        taken.append(part)
        index = index + 1
    }
    return taken.join(".")
}

func joined_without(parts: List<String>, left_out: Integer): String {
    var taken = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        if index != left_out {
            taken.append(part)
        }
        index = index + 1
    }
    return taken.join(".")
}

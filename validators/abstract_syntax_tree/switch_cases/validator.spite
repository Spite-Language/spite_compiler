var path = ""
var class_name = ""
var function_name = ""
var subject = ""
var case_names = List<String>()
var case_bodies = List<String>()
var rest_body = ""
var rest_seen = false

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.statements.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    function_name = found.function_name
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.SwitchStatement {
        check_switch(statement)
    }
}

func check_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    subject = printed_expression(statement.value)
    case_names = List<String>()
    case_bodies = List<String>()
    rest_body = ""
    rest_seen = false
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_case(statement, switch_case)
        index = index + 1
    }
    check_repeated_bodies(statement)
    check_a_single_case(statement)
}

func read_case(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase,
) {
    var name = printed_expression(switch_case.value)
    var body = printed_body(switch_case)
    crash switch_case.body
    var count = switch_case.body.statements.count()
    var library = Validators.LibraryFile()
    if count > 1 and not library.holds(path) {
        refuse(
            switch_case.line,
            "this case runs {count} statements: a case is one statement, so move them into a function named for what they do and call it here",
        )
    }
    if rest_seen {
        refuse(statement.line, "'_:' answers for every member without a case of its own, so it is the last case")
    }
    if name == "_" {
        rest_seen = true
        rest_body = body
        return
    }
    if case_names.contains(name) {
        var shown = quoted(name)
        refuse(statement.line, "this switch has two cases for {shown}: keep one")
    }
    case_names.append(name)
    case_bodies.append(body)
}

func check_repeated_bodies(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var index = 0
    while index < case_bodies.count() {
        var body = case_bodies[index]
        var name = case_names[index]
        crash name
        if rest_seen and body == rest_body {
            refuse(statement.line, "the case '{name}' does the same as '_:': remove it and let '_:' answer for it")
        }
        var earlier = case_bodies.index_of(body)
        crash earlier
        if not rest_seen and earlier != index {
            var first = case_names[earlier]
            crash first
            refuse(
                statement.line,
                "the cases '{first}' and '{name}' do the same thing: write it once, as the last case '_:'",
            )
        }
        index = index + 1
    }
}

func check_a_single_case(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    assert rest_seen and case_names.count() == 1
    var name = case_names[0]
    var body = case_bodies[0]
    crash body
    var asks_true = body == "return true" and rest_body == "return false"
    if asks_true {
        refuse(statement.line, "this switch only asks what '{subject}' is: write 'return {subject} == {name}'")
    }
    var both_return = body.starts_with("return") and rest_body.starts_with("return")
    assert both_return
    refuse(
        statement.line,
        "a switch with one case and '_:' is an if: write 'if {subject} == {name} \{ ... }', returning early, and then what '_:' does",
    )
}

func quoted(name: String): String {
    if name.starts_with("'") {
        return name
    }
    return "'{name}'"
}

func printed_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    crash expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    return printer.text()
}

func printed_body(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase): String {
    crash switch_case.body
    var only = switch_case.body.statements[0]
    if switch_case.body.statements.count() == 1 and only {
        var single = Printers.Spite.StatementPrinter(only)
        return single.text()
    }
    var printer = Printers.Spite.StatementPrinter(switch_case.body)
    return printer.text()
}

func refuse(line: Integer, text: String) {
    var failure = Validators.Failure()
    failure.stop_inside(path, line, class_name, function_name, text)
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var function_line = 0
var attribute_names = List<String>()
var reading = Validators.AbstractSyntaxTree.UnusedNames.Reads()
var dictated = Validators.AbstractSyntaxTree.UnusedNames.Dictated()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    attribute_names = walk.attribute_declarations.map_names()
    walk.function_declarations.each(check_function)
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    function_name = function.declared_key()
    function_line = function.line
    reading = Validators.AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, function_name)
    reading.declared.each(check_local)
    fallback not dictated.is_dictated(function, attribute_names)
    function.parameters.each(check_parameter)
}

func check_local(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var is_read = reading.is_read_while_declared(local)
    if local.name.starts_with("_") and is_read {
        refuse(
            local.line,
            "'{local.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read
    refuse(local.line, "'{local.name}' is never read: remove it")
}

func check_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var is_read = reading.reads.contains(parameter.name)
    var is_ignored = parameter.name.starts_with("_")
    if is_ignored and is_read {
        refuse(
            function_line,
            "'{parameter.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read and not is_ignored
    refuse(
        function_line,
        "the parameter '{parameter.name}' is never read: remove it, or name it '_{parameter.name}' if the signature needs it",
    )
}

func refuse(line: Integer, text: String) {
    var failure = Diagnostics.Failure()
    failure.stop_inside(walk.file.path, line, class_name, function_name, text)
}

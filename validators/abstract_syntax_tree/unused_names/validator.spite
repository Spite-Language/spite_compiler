union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var function_line = 0
var reads = List<String>()
var read_lines = List<Integer>()
var farthest_line = 2147483647
var declared = List<AbstractSyntaxTree.Shapes.Statements.VariableStatement>()
var attribute_names = List<String>()
var operator_names = [
    "sum"
    "subtract"
    "multiply"
    "divide"
    "remainder"
    "negate"
    "equals"
    "less_than"
    "greater_than"
    "get_at"
    "set_at"
    "get_attribute"
    "set_attribute"
    "run_callback"
]

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    attribute_names = walk.attribute_declarations.map_names()
    walk.function_declarations.each(check_function)
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    function_name = function.declared_key()
    function_line = function.line
    reads = List<String>()
    read_lines = List<Integer>()
    declared = List<AbstractSyntaxTree.Shapes.Statements.VariableStatement>()
    walk.expressions.each(read_expression)
    walk.statements.each(read_statement)
    declared.each(check_local)
    fallback not is_dictated(function)
    function.parameters.each(check_parameter)
}

func read_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback found.function_name == function_name
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        reads.append(expression.name)
        read_lines.append(found.line)
    }
}

func read_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.function_name == function_name
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        declared.append(statement)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        forget_a_written_name(statement)
    }
}

func forget_a_written_name(assignment: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = assignment.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        forget_one_read(target.name, assignment.line)
    }
}

func forget_one_read(name: String, line: Integer) {
    var index = 0
    while index < reads.count() {
        var read = reads[index]
        var read_line = read_lines[index]
        crash read_line
        if read == name and read_line == line {
            reads.remove_at(index)
            read_lines.remove_at(index)
            return
        }
        index = index + 1
    }
    var place = reads.index_of(name)
    fallback place
    reads.remove_at(place)
    read_lines.remove_at(place)
}

func is_read_while_declared(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    var until = next_declaration_line(local)
    var index = 0
    while index < reads.count() {
        var read = reads[index]
        var read_line = read_lines[index]
        crash read_line
        var is_in_reach = read_line > local.line and read_line <= until
        if read == local.name and is_in_reach {
            return true
        }
        index = index + 1
    }
    return false
}

func next_declaration_line(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Integer {
    var nearest = farthest_line
    var index = 0
    while index < declared.count() {
        var other = declared[index]
        var is_later = other.name == local.name and other.line > local.line
        if is_later and other.line < nearest {
            nearest = other.line
        }
        index = index + 1
    }
    return nearest
}

func check_local(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var is_read = is_read_while_declared(local)
    if local.name.starts_with("_") and is_read {
        refuse(
            local.line,
            "'{local.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read
    refuse(local.line, "'{local.name}' is never read: remove it")
}

func is_dictated(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    if operator_names.contains(function.name) {
        return true
    }
    if is_a_template(function) {
        return true
    }
    var is_a_setter = function.name.starts_with("set_") and function.parameters.count() == 1
    if is_a_setter {
        var name_length = function.name.length()
        var attribute = function.name.slice(4, name_length)
        crash attribute
        return attribute_names.contains(attribute)
    }
    return false
}

func is_a_template(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    var words = function.name.split("_")
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if is_a_word and describes_a_declaration(parameter.declared_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func describes_a_declaration(written: Type?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        var ranges = ["Spite.AttributeDeclaration", "Spite.FunctionDeclaration", "Spite.Argument"]
        return ranges.contains(path) or path == "Symbol"
    }
    return false
}

func check_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var is_read = reads.contains(parameter.name)
    var is_ignored = parameter.name.starts_with("_")
    if is_ignored and is_read {
        refuse(
            function_line,
            "'{parameter.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read and not is_ignored
    refuse(
        function_line,
        "the parameter '{parameter.name}' is never read: remove it, or name it '_{parameter.name}' if the signature needs it",
    )
}

func refuse(line: Integer, text: String) {
    var failure = Validators.Failure()
    failure.stop_inside(walk.file.path, line, class_name, function_name, text)
}

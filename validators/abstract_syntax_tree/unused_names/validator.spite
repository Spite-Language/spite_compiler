var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var function_line = 0
var attribute_names = List<String>()
var reading = AbstractSyntaxTree.UnusedNames.Reads()
var dictated = AbstractSyntaxTree.UnusedNames.Dictated()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    attribute_names = walk.attribute_declarations.map_names()
    walk.function_declarations.each(check_function)
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.body
    function_name = function.declared_key()
    function_line = function.line
    reading = AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, function_name)
    reading.declared.each(check_local)
    fallback not dictated.is_dictated(function, attribute_names)
    function.parameters.each(check_parameter)
}

func check_local(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var is_read = reading.is_read_while_declared(local)
    if local.name.starts_with("_") and is_read {
        refuse(
            local.line,
            "'{local.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read
    refuse(local.line, "'{local.name}' is never read: remove it")
}

func check_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var is_read = reading.reads.contains(parameter.name)
    var is_ignored = parameter.name.starts_with("_")
    if is_ignored and is_read {
        refuse(
            function_line,
            "'{parameter.name}' is read, so it must not start with an underscore: only a parameter the body ignores is named that way",
        )
    }
    fallback not is_read and not is_ignored
    refuse(
        function_line,
        "the parameter '{parameter.name}' is never read: remove it, or name it '_{parameter.name}' if the signature needs it",
    )
}

func refuse(line: Integer, text: String) {
    var failure = Diagnostics.Failure()
    failure.stop_inside(walk.file.path, line, class_name, function_name, text)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func read_a_function(
    starting_walk: AbstractSyntaxTree.Walk.Walk,
    starting_class_name: String,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    walk = starting_walk
    class_name = starting_class_name
    function_name = function.declared_key()
    reading = AbstractSyntaxTree.UnusedNames.Reads()
    reading.read_the_function(walk, function_name)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_removal(found: AbstractSyntaxTree.Walk.Found.Statement): Validators.Answer {
    var answer = Validators.Answer()
    if may_go(found) {
        answer.fix = "remove the local and every write to it"
    }
    return answer
}

func may_go(found: AbstractSyntaxTree.Walk.Found.Statement): Boolean {
    fallback found.function_name == function_name
    var statement = found.statement
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    fallback not reading.is_read_while_declared(statement)
    fallback reading.does_nothing(statement.value)
    return not is_written(statement.name) or every_write_may_go(statement.name)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func is_written(name: String): Boolean {
    return reading.assigned.contains(name)
}

func every_write_may_go(name: String): Boolean {
    var declared = 0
    var index = 0
    while index < reading.declared.count() {
        var local = reading.declared[index]
        if local.name == name {
            declared = declared + 1
        }
        index = index + 1
    }
    fallback declared == 1
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_a_write_of(found, name) {
            fallback write_may_go(found)
        }
        index = index + 1
    }
    return true
}

func write_may_go(found: AbstractSyntaxTree.Walk.Found.Statement): Boolean {
    var statement = found.statement
    crash found.holder
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    return reading.does_nothing(statement.value) and found.holder.statements.count() > 1
}

func is_a_write_of(found: AbstractSyntaxTree.Walk.Found.Statement, name: String): Boolean {
    var statement = found.statement
    fallback found.function_name == function_name
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    var target = statement.target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    return target.name == name
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func writes_of(name: String): List<AbstractSyntaxTree.Walk.Found.Statement> {
    var writes = List<AbstractSyntaxTree.Walk.Found.Statement>()
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_a_write_of(found, name) {
            writes.append(found)
        }
        index = index + 1
    }
    return writes
}

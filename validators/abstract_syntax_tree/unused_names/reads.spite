union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var function_name = ""
var reads = List<String>()
var read_lines = List<Integer>()
var farthest_line = 2147483647
var declared = List<AbstractSyntaxTree.Shapes.Statements.VariableStatement>()
var assigned = List<String>()

func read_the_function(walk: AbstractSyntaxTree.Walk.Walk, starting_function_name: String) {
    function_name = starting_function_name
    walk.expressions.each(read_expression)
    walk.statements.each(read_statement)
}

func read_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback found.function_name == function_name
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        reads.append(expression.name)
        read_lines.append(found.line)
    }
}

func read_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.function_name == function_name
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        declared.append(statement)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        forget_a_written_name(statement)
    }
}

func forget_a_written_name(assignment: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = assignment.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        assigned.append(target.name)
        forget_one_read(target.name, assignment.line)
    }
}

func forget_one_read(name: String, line: Integer) {
    var index = 0
    while index < reads.count() {
        var read = reads[index]
        var read_line = read_lines[index]
        crash read_line
        if read == name and read_line == line {
            reads.remove_at(index)
            read_lines.remove_at(index)
            return
        }
        index = index + 1
    }
    var place = reads.index_of(name)
    fallback place
    reads.remove_at(place)
    read_lines.remove_at(place)
}

func is_read_while_declared(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    var until = next_declaration_line(local)
    var index = 0
    while index < reads.count() {
        var read = reads[index]
        var read_line = read_lines[index]
        crash read_line
        var is_in_reach = read_line > local.line and read_line <= until
        if read == local.name and is_in_reach {
            return true
        }
        index = index + 1
    }
    return false
}

func next_declaration_line(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Integer {
    var nearest = farthest_line
    var index = 0
    while index < declared.count() {
        var other = declared[index]
        var is_later = other.name == local.name and other.line > local.line
        if is_later and other.line < nearest {
            nearest = other.line
        }
        index = index + 1
    }
    return nearest
}

func does_nothing(value: Expression?): Boolean {
    fallback value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return true
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return true
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return holds_no_hole(value)
    }
    return false
}

func holds_no_hole(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        fallback not piece.hole
        index = index + 1
    }
    return true
}

var gathered = Validators.Answer()

# ../../../../spite_documentation/markup.md#a-read-the-compiler-cannot-follow
func check(file: AbstractSyntaxTree.Shapes.SourceFile): Validators.Answer {
    gathered = Validators.Answer()
    var class_name = file.class_name()
    var index = 0
    while index < file.live_unfollowed.count() {
        var entry = file.live_unfollowed[index]
        var line = file.live_unfollowed_lines[index]
        var parts = entry.split("|")
        var brace = parts[0]
        var read = parts[1]
        crash line
        crash brace
        crash read
        var text = "'{brace}' reads '{read}', which the compiler cannot follow while compiling, so it runs again whenever an attribute of '{class_name}' is written"
        note(file, line, text)
        index = index + 1
    }
    index = 0
    while index < file.live_writes.count() {
        var entry = file.live_writes[index]
        var line = file.live_writes_lines[index]
        var parts = entry.split("|")
        var piece = parts[0]
        var written = parts[1]
        crash line
        crash piece
        crash written
        var text = "'{piece}' is live, so it runs again whenever what it reads is written, and a live piece only reads: it writes in '{written}'. Write it in a function a handler calls, and let the piece read what it wrote"
        var problem = Diagnostics.Problem(file.path, line, text)
        gathered.mistakes.append(problem)
        index = index + 1
    }
    return gathered
}

# ../../../../spite_documentation/markup.md#a-read-the-compiler-cannot-follow
func check_the_watched_classes(file: AbstractSyntaxTree.Shapes.SourceFile): Validators.Answer {
    gathered = Validators.Answer()
    var class_name = file.class_name()
    var index = 0
    while index < file.live_unheard.count() {
        var entry = file.live_unheard[index]
        var parts = entry.split("|")
        var root = parts[0]
        var written = parts[1]
        crash root
        crash written
        var text = "a brace of '{class_name}' reads through '{root}', and the compiler cannot hear a write to a '{written}': it does not run again when that object is written"
        if written.is_empty() {
            text = "a brace of '{class_name}' reads through '{root}', whose type is not written where the compiler can read it: it does not run again when that object is written"
        }
        note(file, 0, text)
        index = index + 1
    }
    return gathered
}

func note(file: AbstractSyntaxTree.Shapes.SourceFile, line: Integer, text: String) {
    var problem = Diagnostics.Problem(file.path, line, text)
    problem.is_note = true
    gathered.notes.append(problem)
}

var named_length = 0

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func check(
    written: List<String>,
    table: Symbols.SymbolTable,
    from_namespace: String,
    taken: List<String>,
): Validators.Answer {
    var answer = Validators.Answer()
    var found = class_named_by(written, table, from_namespace)
    fallback found
    var library = Mapping.LibraryFile()
    fallback not library.holds_the_class(found)
    var folders = from_namespace.split(".")
    if not table.is_a_folder_class(from_namespace) {
        var own_name = folders.remove_last()
        crash own_name
    }
    var dropped = named_length - 1
    while dropped >= 1 {
        var spelt = spells_the_namespace(written, dropped, folders)
        if spelt and names_the_same_class(written, dropped, table, from_namespace, taken, found) {
            var count = written.count()
            answer.fix = joined_between(written, dropped, count)
            return answer
        }
        dropped = dropped - 1
    }
    return answer
}

# ../../../../spite_documentation/packages.md#a-class-of-its-own-namespace-is-named-plainly
func shortened_text(written: String, fix: String): String {
    var whole = written.split(".")
    var kept = fix.split(".")
    var spelt = whole.count() - kept.count()
    var namespace = joined_between(whole, 0, spelt)
    return "'{written}' is written inside the class '{namespace}', where '{fix}' already names it; wrote '{fix}'"
}

func class_named_by(written: List<String>, table: Symbols.SymbolTable, from_namespace: String): Mapping.ClassFile? {
    named_length = written.count()
    while named_length >= 2 {
        var dotted = joined_between(written, 0, named_length)
        var found = table.find(dotted, from_namespace)
        if found {
            return found
        }
        named_length = named_length - 1
    }
    return null
}

func spells_the_namespace(written: List<String>, dropped: Integer, folders: List<String>): Boolean {
    fallback dropped <= folders.count()
    var start = folders.count() - dropped
    var index = 0
    while index < dropped {
        var part = written[index]
        var folder = folders[start + index]
        fallback part == folder
        index = index + 1
    }
    return true
}

func names_the_same_class(
    written: List<String>,
    dropped: Integer,
    table: Symbols.SymbolTable,
    from_namespace: String,
    taken: List<String>,
    found: Mapping.ClassFile,
): Boolean {
    var first = written[dropped]
    crash first
    fallback not taken.contains(first)
    var dotted = joined_between(written, dropped, named_length)
    var again = table.find(dotted, from_namespace)
    fallback again
    return again.path == found.path
}

func joined_between(parts: List<String>, start: Integer, end: Integer): String {
    var taken_parts = List<String>()
    var index = start
    while index < end {
        var part = parts[index]
        crash part
        taken_parts.append(part)
        index = index + 1
    }
    return taken_parts.join(".")
}

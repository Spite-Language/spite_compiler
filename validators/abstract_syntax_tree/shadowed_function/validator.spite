var path = ""
var class_name = ""
var function_names = List<String>()
var gathered = Validators.Answer()

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    var names = walk.function_declarations.map_names()
    return check_against(walk, starting_class_name, names)
}

func check_against(
    walk: AbstractSyntaxTree.Walk.Walk,
    starting_class_name: String,
    names: List<String>,
): Validators.Answer {
    gathered = Validators.Answer()
    path = walk.file.path
    class_name = starting_class_name
    function_names = names
    walk.attribute_declarations.each(check_attribute)
    walk.function_declarations.each(check_function)
    walk.statements.each(check_found)
    return gathered
}

func check_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    fallback function_names.contains(attribute.name)
    refuse("attribute", attribute.name, attribute.line, "")
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if function_names.contains(parameter.name) {
            refuse("parameter", parameter.name, function.line, function.name)
        }
        index = index + 1
    }
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_variable(statement, found.function_name)
    }
}

func check_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement, function_name: String) {
    fallback function_names.contains(statement.name)
    refuse("variable", statement.name, statement.line, function_name)
}

func refuse(what: String, name: String, line: Integer, function_name: String) {
    var text = "the {what} '{name}' has the name of a function of this class, and a function is a value passed by its name: give the {what} a name of its own"
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    gathered.mistakes.append(problem)
}

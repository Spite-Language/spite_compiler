var seen = List<String>()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String) {
    seen = List<String>()
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        var name = name_of(declaration)
        if seen.contains(name) {
            var text = "'{class_name}' declares '{name}' twice: a later file may reopen a class and replace a declaration, but one file declares each name once"
            var failure = Validators.Failure()
            failure.stop_at(file.path, declaration.line, class_name, text)
        }
        if not name.is_empty() {
            seen.append(name)
        }
        index = index + 1
    }
}

func name_of(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration): String {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return generic_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return enum_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return union_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return type_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return attribute_name(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return function_name(declaration)
    }
}

func generic_name(declaration: AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration): String {
    return declaration.name
}

func enum_name(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration): String {
    return declaration.name
}

func union_name(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration): String {
    return declaration.name
}

func type_name(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration): String {
    return declaration.name
}

func attribute_name(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): String {
    return declaration.name
}

func function_name(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    return declaration.name
}

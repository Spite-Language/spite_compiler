var class_name = ""
var path = ""
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    class_name = starting_class_name
    path = file.path
    file.declarations.each(check_declaration)
    return gathered
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    fallback function.is_a_constructor_of(class_name)
    fallback not function.parameters.is_empty()
    var text = "'{class_name}' is the entry constructor, and it takes no arguments: a program reads its run-time settings through Environment() and what its build decided through Build(), anywhere"
    var problem = Diagnostics.Problem(path, function.line, text)
    problem.class_name = class_name
    gathered.mistakes.append(problem)
}

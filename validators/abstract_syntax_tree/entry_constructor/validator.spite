var class_name = ""
var path = ""

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    class_name = starting_class_name
    path = file.path
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    assert function.name == class_name
    assert not function.parameters.is_empty()
    var text = "'{class_name}' is the entry constructor, and it takes no arguments: a program reads its run-time settings through Environment(), what its build decided through Build(), and the raw command line through Arguments(), anywhere"
    var failure = Validators.Failure()
    failure.stop_at(path, function.line, class_name, text)
}

var path = ""
var class_name = ""
var names = Mapping.Names()
var function_names = List<String>()

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    function_names = walk.function_declarations.map_names()
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.FoundExpression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_arguments(found, expression)
    }
}

func check_arguments(
    found: AbstractSyntaxTree.Walk.FoundExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    assert not is_a_spread(call)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var inner = first_call_in(argument)
        if inner {
            refuse(found, call, inner)
        }
        index = index + 1
    }
}

func is_a_spread(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    if call.arguments.count() != 1 {
        return false
    }
    var only = call.arguments[0]
    if only == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return walks_a_template(only)
    }
    return false
}

func walks_a_template(spreading: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = spreading.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = callee.name
        if function_names.contains(name) or not name.ends_with("s") {
            return false
        }
        var length = name.length()
        var singular = name.slice(0, length - 1)
        return function_names.contains(singular)
    }
    return false
}

func first_call_in(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return expression
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return first_call_in(expression.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return first_call_in_index(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return first_call_in_binary(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return first_call_in(expression.operand)
        _: return null
    }
}

func first_call_in_index(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    var in_target = first_call_in(index.target)
    if in_target {
        return in_target
    }
    return first_call_in(index.index)
}

func first_call_in_binary(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    var in_left = first_call_in(binary.left)
    if in_left {
        return in_left
    }
    return first_call_in(binary.right)
}

func refuse(
    found: AbstractSyntaxTree.Walk.FoundExpression,
    outer: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    inner: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    crash outer.callee
    var outer_printer = Printers.Spite.ExpressionPrinter(outer.callee)
    var outer_text = outer_printer.text()
    var inner_printer = Printers.Spite.ExpressionPrinter(inner)
    var inner_text = inner_printer.text()
    var text = "'{inner_text}' is called inside an argument of '{outer_text}': compute it first into a named 'var' and pass the name"
    var made_class = constructed_class(inner)
    if not made_class.is_empty() {
        var named = names.snake_case_of(made_class)
        text = "'{inner_text}' is constructed inside an argument of '{outer_text}': a constructor call is never an argument, so make it first on a line of its own, 'var {named} = {inner_text}', and pass '{named}'"
    }
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func constructed_class(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_name_of_identifier(callee)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return class_name_of_member(callee)
    }
    return ""
}

func class_name_of_identifier(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if identifier.is_a_class_name {
        return identifier.name
    }
    return ""
}

func class_name_of_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if member.is_a_class_name {
        return member.name
    }
    return ""
}

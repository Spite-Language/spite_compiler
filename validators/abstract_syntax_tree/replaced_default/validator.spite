var inference = NameResolution.Inference()
var reading = AbstractSyntaxTree.UnusedNames.Reads()

# ../../../../spite_documentation/classes_and_files.md#a-default-the-constructor-replaces-is-removed
func check(
    attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    file: AbstractSyntaxTree.Shapes.SourceFile,
    paths: AbstractSyntaxTree.Walk.ConstructorPaths,
): Validators.Answer {
    var answer = Validators.Answer()
    fallback makes_nothing_else(attribute.value)
    fallback not gives_null_to_a_plain_type(attribute)
    fallback paths.is_given_first(attribute.name)
    fallback not another_default_reads_it(attribute, file, paths)
    var written = type_of(attribute)
    fallback written
    answer.fix = "remove the default of '{attribute.name}', which the constructor always replaces"
    return answer
}

func type_of(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): SpiteCompiler.Type? {
    if attribute.declared_type {
        return attribute.declared_type
    }
    var constructed = inference.written_type_of(attribute.value)
    if constructed {
        return constructed
    }
    var literal = inference.literal_type_of(attribute.value)
    fallback not literal.is_empty()
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var path = [literal]
    return AbstractSyntaxTree.Shapes.Types.NamedType(path, no_arguments)
}

func makes_nothing_else(value: SpiteCompiler.Expression?): Boolean {
    fallback value
    fallback value.class != AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    if reading.does_nothing(value) {
        return true
    }
    return is_an_empty_collection(value)
}

# ../../../../spite_documentation/functions_and_operators.md#null-only-goes-where-a-t-is-wanted
func gives_null_to_a_plain_type(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): Boolean {
    fallback attribute.declared_type
    fallback not attribute.declared_type.is_nullable
    var value = attribute.value
    var is_null = false
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_null = value.kind == 'keyword_null'
    }
    return is_null
}

func is_an_empty_collection(value: SpiteCompiler.Expression): Boolean {
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback value.arguments.is_empty()
    var callee = value.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    return callee.name == "List" or callee.name == "Dictionary"
}

func another_default_reads_it(
    attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    file: AbstractSyntaxTree.Shapes.SourceFile,
    paths: AbstractSyntaxTree.Walk.ConstructorPaths,
): Boolean {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and paths.mentions(declaration.value, attribute.name) {
            return true
        }
        index = index + 1
    }
    return false
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var path = ""
var class_name = ""
var function_name = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.statements.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    function_name = found.function_name
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        check_chain(statement)
        check_an_if_of_one_if(statement)
    }
}

func check_an_if_of_one_if(outer: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var is_generated = path.contains("/.spite/")
    fallback not outer.else_branch and not is_generated
    crash outer.then_branch
    fallback outer.then_branch.statements.count() == 1
    var only = outer.then_branch.statements[0]
    switch only {
        AbstractSyntaxTree.Shapes.Statements.IfStatement: refuse_an_if_of_one_if(outer, only)
        _: return
    }
}

func refuse_an_if_of_one_if(
    outer: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    inner: AbstractSyntaxTree.Shapes.Statements.IfStatement,
) {
    fallback not inner.else_branch
    crash outer.condition
    crash inner.condition
    var joined = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(outer.condition, 'and', inner.condition)
    var printer = Printers.Spite.ExpressionPrinter(joined)
    var written = printer.text()
    var text = "this 'if' only contains another 'if' and neither has an 'else': write one condition, 'if {written}'"
    var failure = Validators.Failure()
    failure.stop_inside(path, outer.line, class_name, function_name, text)
}

func check_chain(chain: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    fallback chain.else_branch
    check_branch(chain.then_branch)
    if not chain.else_branch.is_an_else_if {
        check_branch(chain.else_branch)
    }
}

func check_branch(branch: AbstractSyntaxTree.Shapes.Statements.Block?) {
    crash branch
    branch.statements.each(check_branch_statement)
}

func check_branch_statement(statement: Statement) {
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        check_inner(statement)
    }
}

func check_inner(inner: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    fallback inner.else_branch
    var text = "this 'if'/'else' is inside a branch of another 'if'/'else': move it into a function named for what it decides, or, when both test which member of a union or which value of an enum a value is, use one 'switch'"
    var failure = Validators.Failure()
    failure.stop_inside(path, inner.line, class_name, function_name, text)
}

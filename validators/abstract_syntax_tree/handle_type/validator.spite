var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var function_names = List<String>()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    walk = starting_walk
    class_name = starting_class_name
    function_names = walk.function_declarations.map_names()
    walk.statements.each(check_statement)
}

func check_statement(found: AbstractSyntaxTree.Walk.FoundStatement) {
    function_name = found.function_name
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_local(statement)
    }
}

func check_local(local: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    assert local.declared_type
    var value = local.value
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_started(local, value)
    }
}

func check_started(
    local: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    var started = ""
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        started = callee.name
    }
    var is_a_handle = started == "Parallel" or started == "Concurrent"
    assert is_a_handle and not function_names.contains(started)
    var printer = Printers.Spite.ExpressionPrinter(call)
    var written = printer.text()
    var text = "the type of a '{started}' handle is never written: it is worked out from the function it runs, so write 'var {local.name} = {written}'"
    var failure = Validators.Failure()
    failure.stop_inside(walk.file.path, local.line, class_name, function_name, text)
}

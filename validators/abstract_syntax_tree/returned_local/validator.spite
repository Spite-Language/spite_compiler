var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var class_name = ""
var function_name = ""
var gathered = Validators.Answer()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    walk = starting_walk
    class_name = starting_class_name
    walk.blocks.each(check_block)
    return gathered
}

func check_block(found: AbstractSyntaxTree.Walk.Found.Block) {
    function_name = found.function_name
    crash found.block
    var statements = found.block.statements
    var index = 0
    while index + 1 < statements.count() {
        var declared = statements[index]
        var following = statements[index + 1]
        if declared.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
            check_pair(declared, following)
        }
        index = index + 1
    }
}

func check_pair(
    declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    following: SpiteCompiler.WrittenStatement?,
) {
    if following.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        check_return(declared, following)
    }
}

func check_return(
    declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    var value = returned.value
    var returns_the_name = false
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        returns_the_name = value.name == declared.name
    }
    fallback returns_the_name
    var function = walk.function_named(function_name)
    crash function
    crash function.result
    var types = Printers.Spite.TypePrinter(function.result)
    var result = types.text()
    if declared.declared_type {
        var declared_types = Printers.Spite.TypePrinter(declared.declared_type)
        var written = declared_types.text()
        fallback written == result
    }
    crash declared.value
    fallback not makes_a_default(declared)
    var printer = Printers.Spite.ExpressionPrinter(declared.value)
    var computed = printer.text()
    var text = "'{declared.name}' is declared only to be returned on the next line: write 'return {computed}', since 'return' already makes the value the function's {result}"
    var problem = Diagnostics.Problem(walk.file.path, declared.line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    gathered.mistakes.append(problem)
}

func makes_a_default(declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    fallback declared.declared_type
    fallback not declared.declared_type.is_nullable
    var value = declared.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return value.kind == 'keyword_null'
    }
    return false
}

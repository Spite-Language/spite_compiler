union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var path = ""
var class_name = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        check_binary(found, expression)
    }
}

func check_binary(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    assert binary.operator == 'plus'
    var left_is_text = is_written_text(binary.left)
    var right_is_text = is_written_text(binary.right)
    assert left_is_text or right_is_text
    var text = "text written down is not joined with '+': put the value inside it, like \"hello \{name}\". Two values are still joined with '+'"
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func is_written_text(expression: Expression?): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return has_written_words(expression)
    }
    return false
}

func has_written_words(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    var only = literal.pieces[0]
    crash only
    var is_one_value = literal.pieces.count() == 1 and only.text.is_empty() and only.hole
    return not is_one_value
}

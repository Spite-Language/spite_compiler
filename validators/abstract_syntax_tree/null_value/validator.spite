var path = ""
var class_name = ""
var gathered = Validators.Answer()

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    path = walk.file.path
    class_name = starting_class_name
    walk.expressions.each(check_found)
    return gathered
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        check_comparison(found, expression)
    }
}

func check_comparison(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares
    var left_is_null = is_null(binary.left)
    var right_is_null = is_null(binary.right)
    fallback left_is_null or right_is_null
    refuse(found)
}

func is_null(expression: SpiteCompiler.Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'keyword_null'
    }
    return false
}

func refuse(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var text = refusal_text()
    var problem = Diagnostics.Problem(path, found.line, text)
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_among_the_attributes = found.function_name.is_empty()
    gathered.mistakes.append(problem)
}

func refusal_text(): String {
    return "'null' is not a value to compare against or pass around: narrow the value instead, with 'if value \{ } else \{ }', 'fallback value', 'crash value' or 'switch value \{ <Type>: ... Null: ... }'"
}

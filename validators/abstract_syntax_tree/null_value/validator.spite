var path = ""
var class_name = ""

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.FoundExpression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        check_comparison(found, expression)
    }
}

func check_comparison(
    found: AbstractSyntaxTree.Walk.FoundExpression,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    assert compares
    var left_is_null = is_null(binary.left)
    var right_is_null = is_null(binary.right)
    assert left_is_null or right_is_null
    refuse(found)
}

func is_null(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'keyword_null'
    }
    return false
}

func refuse(found: AbstractSyntaxTree.Walk.FoundExpression) {
    var text = refusal_text()
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, text)
}

func refusal_text(): String {
    return "'null' is not a value to compare against or pass around: narrow the value instead, with 'if value \{ } else \{ }', 'assert value', 'crash value' or 'switch value \{ <Type>: ... Null: ... }'"
}

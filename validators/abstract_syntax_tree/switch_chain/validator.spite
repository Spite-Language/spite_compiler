union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var path = ""
var class_name = ""
var function_name = ""
var run = List<Link>()
var run_subject = ""
var subject = ""
var constants = List<String>()
var is_a_link = true
var shortest_chain = 3

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.blocks.each(check_block)
}

func check_block(found: AbstractSyntaxTree.Walk.Found.Block) {
    function_name = found.function_name
    crash found.block
    run = List<Link>()
    found.block.statements.each(check_statement)
    close_the_run("...")
}

func check_statement(statement: Statement) {
    var link = link_of_a_lone_if(statement)
    if link {
        add_to_the_run(link)
        return
    }
    var rest = rest_after(statement)
    close_the_run(rest)
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        check_an_else_if_chain(statement)
    }
}

func add_to_the_run(link: Link) {
    if link.subject != run_subject {
        close_the_run("...")
    }
    run_subject = link.subject
    run.append(link)
}

func close_the_run(rest: String) {
    if run.count() >= shortest_chain {
        refuse(run, rest)
    }
    run = List<Link>()
    run_subject = ""
}

func check_an_else_if_chain(first: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var chain = List<Link>()
    var chain_subject = ""
    var current: AbstractSyntaxTree.Shapes.Statements.IfStatement? = first
    var rest = ""
    while current {
        var link = link_of(current)
        fallback link
        if chain.is_empty() {
            chain_subject = link.subject
        }
        fallback link.subject == chain_subject
        chain.append(link)
        var else_branch = current.else_branch
        current = null
        if else_branch {
            current = next_link(else_branch)
            rest = rest_of_an_else(else_branch)
        }
    }
    fallback chain.count() >= shortest_chain
    refuse(chain, rest)
}

func next_link(
    else_branch: AbstractSyntaxTree.Shapes.Statements.Block,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    fallback else_branch.is_an_else_if
    var inner = else_branch.statements[0]
    if inner.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        return inner
    }
    return null
}

func rest_of_an_else(else_branch: AbstractSyntaxTree.Shapes.Statements.Block): String {
    fallback not else_branch.is_an_else_if
    if else_branch.statements.count() != 1 {
        return "..."
    }
    var only = else_branch.statements[0]
    return rest_after(only)
}

func rest_after(following: Statement?): String {
    if following.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return return_text(following)
    }
    return "..."
}

func link_of_a_lone_if(statement: Statement): Link? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        return lone_link(statement)
    }
    return null
}

func lone_link(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Link? {
    fallback not statement.else_branch
    return link_of(statement)
}

func link_of(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Link? {
    crash statement.then_branch
    fallback statement.then_branch.statements.count() == 1
    var only = statement.then_branch.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return link_returning(statement, only)
    }
    return null
}

func link_returning(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
): Link? {
    subject = ""
    constants = List<String>()
    is_a_link = true
    read_comparisons(statement.condition)
    fallback is_a_link and not constants.is_empty()
    var answer = return_text(returned)
    var cases = List<String>()
    var index = 0
    while index < constants.count() {
        cases.append("{constants[index]}: {answer}")
        index = index + 1
    }
    return Link(subject, cases, statement.line)
}

func read_comparisons(condition: Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_binary(condition)
    } else {
        is_a_link = false
    }
}

func read_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'or' {
        read_comparisons(binary.left)
        read_comparisons(binary.right)
        return
    }
    crash binary.left
    crash binary.right
    var is_a_comparison = binary.operator == 'equal_equal' and is_a_subject(binary.left)
    if not is_a_comparison or not is_a_constant(binary.right) {
        is_a_link = false
        return
    }
    read_comparison(binary.left, binary.right)
}

func read_comparison(
    left: Expression,
    right: Expression,
) {
    var subject_printer = Printers.Spite.ExpressionPrinter(left)
    var written_subject = subject_printer.text()
    if subject.is_empty() {
        subject = written_subject
    }
    if written_subject != subject {
        is_a_link = false
    }
    var constant_printer = Printers.Spite.ExpressionPrinter(right)
    var written_constant = constant_printer.text()
    constants.append(written_constant)
}

func is_a_subject(expression: Expression): Boolean {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return true
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return is_a_subject_member(expression)
        _: return false
    }
}

func is_a_subject_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    crash member.target
    return is_a_subject(member.target)
}

func is_a_constant(expression: Expression): Boolean {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return is_a_constant_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return is_a_plain_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return is_a_negative_number(expression)
        _: return false
    }
}

func is_a_constant_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Boolean {
    return literal.kind == 'integer_literal' or literal.kind == 'symbol_literal'
}

func is_a_plain_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): Boolean {
    var only = text.pieces[0]
    crash only
    return text.pieces.count() == 1 and not only.hole
}

func is_a_negative_number(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression): Boolean {
    var operand = unary.operand
    if operand.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return unary.operator == 'minus' and operand.kind == 'integer_literal'
    }
    return false
}

func return_text(returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement): String {
    if returned.value {
        var printer = Printers.Spite.ExpressionPrinter(returned.value)
        var written = printer.text()
        return "return {written}"
    }
    return "return"
}

func refuse(chain: List<Link>, rest: String) {
    var first = chain[0]
    crash first
    var written_cases = List<String>()
    var index = 0
    while index < chain.count() {
        var link = chain[index]
        var joined = link.cases.join("  ")
        written_cases.append(joined)
        index = index + 1
    }
    if not rest.is_empty() {
        written_cases.append("_: {rest}")
    }
    var cases = written_cases.join("  ")
    var text = "these {chain.count()} 'if's each compare '{first.subject}' with a value and return, which is what a 'switch' says: write 'switch {first.subject} \{ {cases} }'"
    var failure = Validators.Failure()
    failure.stop_inside(path, first.line, class_name, function_name, text)
}

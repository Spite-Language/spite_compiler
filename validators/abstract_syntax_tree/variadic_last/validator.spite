var path = ""
var class_name = ""
var gathered = Validators.Answer()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
    return gathered
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var last = function.parameters.count() - 1
    var index = 0
    while index < last {
        var parameter = function.parameters[index]
        if parameter.is_variadic {
            var text = "'...{parameter.name}' takes every argument from here on, so it is the last parameter: move it to the end"
            var problem = Diagnostics.Problem(path, function.line, text)
            problem.class_name = class_name
            problem.function_name = function.name
            gathered.mistakes.append(problem)
        }
        index = index + 1
    }
    var gathering = function.parameters.last()
    if gathering and gathering.is_variadic and not is_a_list(gathering.declared_type) {
        var text = "'...{gathering.name}' receives the arguments as a list: write '...{gathering.name}: List<Type>' with the type of each argument"
        var problem = Diagnostics.Problem(path, function.line, text)
        problem.class_name = class_name
        problem.function_name = function.name
        gathered.mistakes.append(problem)
    }
}

func is_a_list(declared_type: SpiteCompiler.Type?): Boolean {
    if not declared_type {
        return true
    }
    if declared_type.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        fallback declared_type.path.count() == 1
        var written = declared_type.path.first()
        crash written
        return written == "List"
    }
    return false
}

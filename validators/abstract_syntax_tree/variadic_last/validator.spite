union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var path = ""
var class_name = ""

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var last = function.parameters.count() - 1
    var index = 0
    while index < last {
        var parameter = function.parameters[index]
        if parameter.is_variadic {
            var text = "'...{parameter.name}' takes every argument from here on, so it is the last parameter: move it to the end"
            var problem = Diagnostics.Problem(path, function.line, text)
            problem.class_name = class_name
            problem.function_name = function.name
            var failure = Validators.Failure()
            failure.stop(problem)
        }
        index = index + 1
    }
}

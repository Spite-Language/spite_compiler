union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

func of(condition: Expression): Expression {
    switch condition {
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return opposite_of_binary(condition)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return opposite_of_unary(condition)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
    }
}

func opposite_of_unary(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
): Expression {
    crash unary.operand
    if unary.operator == 'not' {
        return unary.operand
    }
    return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', unary)
}

func opposite_of_binary(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Expression {
    crash binary.left
    crash binary.right
    var operator = binary.operator
    if operator == 'and' or operator == 'or' {
        var opposite_left = of(binary.left)
        var opposite_right = of(binary.right)
        var swapped = swapped_joiner(operator)
        return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(opposite_left, swapped, opposite_right)
    }
    var flipped = flipped_comparison(operator)
    if flipped == 'end_of_file' {
        return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', binary)
    }
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.left, flipped, binary.right)
}

func swapped_joiner(operator: AbstractSyntaxTree.Tokens.Token.Kind): AbstractSyntaxTree.Tokens.Token.Kind {
    if operator == 'and' {
        return 'or'
    }
    return 'and'
}

func flipped_comparison(operator: AbstractSyntaxTree.Tokens.Token.Kind): AbstractSyntaxTree.Tokens.Token.Kind {
    switch operator {
        'equal_equal': return 'not_equal'
        'not_equal': return 'equal_equal'
        'less': return 'greater_or_equal'
        'greater_or_equal': return 'less'
        'greater': return 'less_or_equal'
        'less_or_equal': return 'greater'
        'end_of_file': return 'end_of_file'
        'name': return 'end_of_file'
        'class_name': return 'end_of_file'
        'generic_name': return 'end_of_file'
        'integer_literal': return 'end_of_file'
        'decimal_literal': return 'end_of_file'
        'text_literal': return 'end_of_file'
        'symbol_literal': return 'end_of_file'
        'open_brace': return 'end_of_file'
        'close_brace': return 'end_of_file'
        'open_parenthesis': return 'end_of_file'
        'close_parenthesis': return 'end_of_file'
        'open_bracket': return 'end_of_file'
        'close_bracket': return 'end_of_file'
        'comma': return 'end_of_file'
        'dot': return 'end_of_file'
        'dots': return 'end_of_file'
        'colon': return 'end_of_file'
        'question': return 'end_of_file'
        'equals': return 'end_of_file'
        'plus': return 'end_of_file'
        'minus': return 'end_of_file'
        'star': return 'end_of_file'
        'slash': return 'end_of_file'
        'percent': return 'end_of_file'
        'and': return 'end_of_file'
        'or': return 'end_of_file'
        'not': return 'end_of_file'
        'keyword_function': return 'end_of_file'
        'keyword_variable': return 'end_of_file'
        'keyword_enum': return 'end_of_file'
        'keyword_union': return 'end_of_file'
        'keyword_type': return 'end_of_file'
        'keyword_return': return 'end_of_file'
        'keyword_if': return 'end_of_file'
        'keyword_else': return 'end_of_file'
        'keyword_while': return 'end_of_file'
        'keyword_switch': return 'end_of_file'
        'keyword_fallback': return 'end_of_file'
        'keyword_crash': return 'end_of_file'
        'keyword_load': return 'end_of_file'
        'keyword_this': return 'end_of_file'
        'keyword_null': return 'end_of_file'
        'keyword_true': return 'end_of_file'
        'keyword_false': return 'end_of_file'
        'keyword_generic': return 'end_of_file'
        'keyword_singleton': return 'end_of_file'
    }
}

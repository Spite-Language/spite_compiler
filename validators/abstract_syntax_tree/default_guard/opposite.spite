func of(condition: AbstractSyntaxTree.Shapes.Expressions.Expression): AbstractSyntaxTree.Shapes.Expressions.Expression {
    switch condition {
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return opposite_of_binary(condition)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return opposite_of_unary(condition)
        _: return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', condition)
    }
}

func opposite_of_unary(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.Expression {
    crash unary.operand
    if unary.operator == 'not' {
        return unary.operand
    }
    return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', unary)
}

func opposite_of_binary(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.Expression {
    crash binary.left
    crash binary.right
    var operator = binary.operator
    if operator == 'and' or operator == 'or' {
        var opposite_left = of(binary.left)
        var opposite_right = of(binary.right)
        var swapped = swapped_joiner(operator)
        return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(opposite_left, swapped, opposite_right)
    }
    var flipped = flipped_comparison(operator)
    if flipped == 'end_of_file' {
        return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', binary)
    }
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.left, flipped, binary.right)
}

func swapped_joiner(operator: AbstractSyntaxTree.Tokens.Token.Kind): AbstractSyntaxTree.Tokens.Token.Kind {
    if operator == 'and' {
        return 'or'
    }
    return 'and'
}

func flipped_comparison(operator: AbstractSyntaxTree.Tokens.Token.Kind): AbstractSyntaxTree.Tokens.Token.Kind {
    switch operator {
        'equal_equal': return 'not_equal'
        'not_equal': return 'equal_equal'
        'less': return 'greater_or_equal'
        'greater_or_equal': return 'less'
        'greater': return 'less_or_equal'
        'less_or_equal': return 'greater'
        _: return 'end_of_file'
    }
}

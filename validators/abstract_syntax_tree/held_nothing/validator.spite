var path = ""
var class_name = ""
var function_name = ""
var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var gathered = Validators.Answer()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    walk = starting_walk
    path = walk.file.path
    class_name = starting_class_name
    function_name = ""
    walk.attribute_declarations.each(check_attribute)
    walk.statements.each(check_found)
    return gathered
}

func check_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    check_declared(attribute.name, attribute.declared_type, attribute.line)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        function_name = found.function_name
        check_declared(statement.name, statement.declared_type, statement.line)
    }
}

# ../../../../spite_documentation/values_and_types.md#nothing
func check_declared(name: String, declared_type: SpiteCompiler.Type?, line: Integer) {
    fallback names_nothing(declared_type)
    var text = "'{name}' is declared 'Nothing', the union no value is ever of, so it could never hold anything: remove it, or give it the type of what it holds"
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    if not function_name.is_empty() {
        problem.function_name = function_name
    }
    gathered.mistakes.append(problem)
}

func names_nothing(declared_type: SpiteCompiler.Type?): Boolean {
    if declared_type.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        fallback declared_type.path.count() == 1 and declared_type.arguments.is_empty()
        var written = declared_type.path.first()
        crash written
        var names = Model.LanguageNames()
        return written == names.empty
    }
    return false
}

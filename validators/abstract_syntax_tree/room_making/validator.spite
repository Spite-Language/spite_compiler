var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk(empty_file)
var class_name = ""
var gathered = Validators.Answer()

# ../../../../spite_documentation/foreign_libraries.md#rooms
func check(starting_walk: AbstractSyntaxTree.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    walk = starting_walk
    class_name = starting_class_name
    var library = Mapping.LibraryFile()
    fallback not library.holds(walk.file.path)
    walk.expressions.each(check_found)
    return gathered
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(found, expression)
    }
}

func check_call(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    var makes_a_buffer = callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and callee.name == "Buffer"
    if makes_a_buffer and not call.arguments.is_empty() {
        refuse(
            found,
            "a Buffer is made with 'Buffer()': how much room it keeps is the compiler's. Room for C to write into is a room declared in its library's functions",
        )
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "take_written" {
        refuse(
            found,
            "'take_written' is gone: what C writes into a room is read back by the compiler, so declare the room in its library's functions and read the room 'call()' answers",
        )
    }
}

func refuse(found: AbstractSyntaxTree.Walk.Found.Expression, text: String) {
    var problem = Diagnostics.Problem(walk.file.path, found.line, text)
    problem.class_name = class_name
    problem.function_name = found.function_name
    problem.is_among_the_attributes = found.function_name.is_empty()
    gathered.mistakes.append(problem)
}

union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var path = ""
var class_name = ""
var names = List<String>()
var numbers = List<Long>()
var largest_integer: Long = 2147483647
var smallest_integer: Long = -2147483648

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    path = file.path
    class_name = starting_class_name
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration {
        check_enum(declaration)
    }
}

func check_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    names = List<String>()
    numbers = List<Long>()
    var counted: Long = 0
    var index = 0
    while index < declaration.values.count() {
        var value = declaration.values[index]
        if value.number {
            counted = written_number(declaration, value.number)
        }
        check_value(declaration, value.name, counted)
        counted = counted + 1
        index = index + 1
    }
}

func check_value(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration, name: String, number: Long) {
    if names.contains(name) {
        refuse(declaration, "'{declaration.name}' lists '{name}' twice: an enum names each value once")
    }
    if number > largest_integer or number < smallest_integer {
        refuse(
            declaration,
            "'{name}' would be number {number} of enum '{declaration.name}', which does not fit an Integer: an enum value's number is an Integer",
        )
    }
    var taken = numbers.index_of(number)
    if taken {
        var other = names[taken]
        crash other
        refuse(
            declaration,
            "'{other}' and '{name}' both have the number {number} in enum '{declaration.name}': a value's number is its identity, so give one of them another",
        )
    }
    names.append(name)
    numbers.append(number)
}

func written_number(
    declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration,
    written: Expression,
): Long {
    if written == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return whole_number_of(declaration, written.text)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return negative_number_of(declaration, written)
    }
    refuse(declaration, "an enum value's number is a whole number written out, as in ''admin' = 7'")
    return 0
}

func negative_number_of(
    declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration,
    negation: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
): Long {
    var operand = negation.operand
    if operand == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return negative_of(declaration, negation, operand)
    }
    refuse(declaration, "an enum value's number is a whole number written out, as in ''admin' = 7'")
    return 0
}

func negative_of(
    declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration,
    negation: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
): Long {
    if negation.operator != 'minus' {
        refuse(declaration, "an enum value's number is a whole number written out, as in ''admin' = 7'")
    }
    var positive = whole_number_of(declaration, literal.text)
    var zero: Long = 0
    return zero - positive
}

func whole_number_of(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration, text: String): Long {
    var number = text.to_long()
    if number {
        return number
    }
    refuse(declaration, "an enum value's number is a whole number written out, as in ''admin' = 7'")
    return 0
}

func refuse(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration, text: String) {
    var failure = Validators.Failure()
    failure.stop_at(path, declaration.line, class_name, text)
}

var path = ""
var class_name = ""
var can_end = false

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.statements.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        check_loop(found, statement)
    }
}

func check_loop(
    found: AbstractSyntaxTree.Walk.Found.Statement,
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
) {
    var condition = loop.condition
    var is_true = false
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_true = condition.kind == 'keyword_true'
    }
    assert is_true
    can_end = false
    read_block(loop.body)
    assert not can_end
    var text = "this 'while true' never ends: nothing inside it returns, asserts or crashes, and it calls nothing, so the program would spin here for good: leave it with a 'return' ('if done \{ return }'), or loop 'while' a condition"
    var failure = Validators.Failure()
    failure.stop_inside(path, loop.line, class_name, found.function_name, text)
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    assert block
    block.statements.each(read_statement)
}

func read_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: can_end = true
        AbstractSyntaxTree.Shapes.Statements.AssertStatement: can_end = true
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: can_end = true
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: statement.cases.each(read_case)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
        _: read_expression(statement.value)
    }
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    read_expression(statement.condition)
    read_block(statement.then_branch)
    read_block(statement.else_branch)
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    read_expression(statement.condition)
    read_block(statement.body)
}

func read_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    read_block(switch_case.body)
}

func read_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    assert expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: can_end = true
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_binary(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read_expression(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_expression(expression.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: read_index(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: expression.pieces.each(read_piece)
        _: return
    }
}

func read_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    read_expression(binary.left)
    read_expression(binary.right)
}

func read_index(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    read_expression(index.target)
    read_expression(index.index)
}

func read_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    read_expression(piece.hole)
}

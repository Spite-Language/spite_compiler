union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var path = ""
var class_name = ""
var function_name = ""
var branch_calls = List<String>()
var branch_names = List<String>()
var call_names = List<String>()
var reading = true

func check(walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String) {
    path = walk.file.path
    class_name = starting_class_name
    walk.statements.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Statement) {
    function_name = found.function_name
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        check_chain(statement)
    }
}

func check_chain(first: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var branches = List<AbstractSyntaxTree.Shapes.Statements.Block>()
    var current: AbstractSyntaxTree.Shapes.Statements.IfStatement? = first
    var has_a_last_else = false
    while current {
        crash current.then_branch
        branches.append(current.then_branch)
        var else_branch = current.else_branch
        current = null
        if else_branch {
            current = next_link(else_branch)
            has_a_last_else = not else_branch.is_an_else_if
            add_the_last_else(branches, else_branch)
        }
    }
    fallback has_a_last_else
    var shared = calls_of(branches[0])
    var index = 1
    while index < branches.count() {
        var others = calls_of(branches[index])
        shared = kept_in(shared, others)
        index = index + 1
    }
    fallback not shared.is_empty()
    var repeated = shared[0]
    var where = "every branch"
    if branches.count() == 2 {
        where = "both branches"
    }
    var text = "'{repeated}' is computed in {where}: compute it once before the 'if'"
    var failure = Validators.Failure()
    failure.stop_inside(path, first.line, class_name, function_name, text)
}

func add_the_last_else(
    branches: List<AbstractSyntaxTree.Shapes.Statements.Block>,
    else_branch: AbstractSyntaxTree.Shapes.Statements.Block,
) {
    if not else_branch.is_an_else_if {
        branches.append(else_branch)
    }
}

func next_link(
    else_branch: AbstractSyntaxTree.Shapes.Statements.Block,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    fallback else_branch.is_an_else_if
    var inner = else_branch.statements[0]
    if inner == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        return inner
    }
    return null
}

func calls_of(branch: AbstractSyntaxTree.Shapes.Statements.Block?): List<String> {
    branch_calls = List<String>()
    branch_names = List<String>()
    reading = true
    crash branch
    branch.statements.each(read_statement)
    return branch_calls
}

func read_statement(statement: Statement) {
    fallback reading
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read_held(statement.value)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: read_asserted(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_a_nested_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: stop_reading()
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: stop_reading()
        _: return
    }
}

func read_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    read_expression(statement.value)
    note_names(statement.target)
}

func read_asserted(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement) {
    read_expression(statement.condition)
    note_names(statement.condition)
}

func read_a_nested_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    read_expression(statement.condition)
    stop_reading()
}

func stop_reading() {
    reading = false
}

func note_names(expression: Expression?) {
    call_names = List<String>()
    read_names(expression)
    var index = 0
    while index < call_names.count() {
        var name = call_names[index]
        branch_names.append(name)
        index = index + 1
    }
}

func read_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    read_expression(statement.value)
    branch_names.append(statement.name)
}

func read_held(expression: Expression?) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        expression.arguments.each(read_present)
        note_the_receiver(expression)
        return
    }
    read_expression(expression)
}

func read_present(expression: Expression) {
    read_expression(expression)
}

func read_expression(expression: Expression?) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: read_call(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_binary(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read_expression(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_expression(expression.target)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: expression.pieces.each(read_piece)
        _: return
    }
}

func read_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    read_expression(binary.left)
    var joins = binary.operator == 'and' or binary.operator == 'or'
    if not joins {
        read_expression(binary.right)
    }
}

func read_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    read_expression(piece.hole)
}

func read_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    call_names = List<String>()
    read_names(call)
    var local = reads_a_branch_name()
    var counted = not local and not call.arguments.is_empty() and not is_a_construction(call)
    if counted {
        var printer = Printers.Spite.ExpressionPrinter(call)
        var written = printer.text()
        branch_calls.append(written)
    }
    call.arguments.each(read_present)
    note_the_receiver(call)
}

func is_a_construction(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = call.callee
    var name = ""
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = callee.name
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        name = callee.name
    }
    var initial = name.slice(0, 1)
    crash initial
    return not name.is_empty() and initial != initial.lower_case()
}

func note_the_receiver(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        note_names(callee.target)
    }
}

func read_names(expression: Expression?) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: call_names.append(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: read_call_names(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_binary_names(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read_names(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_names(expression.target)
        _: return
    }
}

func read_call_names(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    read_names(call.callee)
    call.arguments.each(read_present_names)
}

func read_present_names(expression: Expression) {
    read_names(expression)
}

func read_binary_names(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    read_names(binary.left)
    read_names(binary.right)
}

func kept_in(shared: List<String>, others: List<String>): List<String> {
    var kept = List<String>()
    var index = 0
    while index < shared.count() {
        var call = shared[index]
        if others.contains(call) {
            kept.append(call)
        }
        index = index + 1
    }
    return kept
}

func reads_a_branch_name(): Boolean {
    var index = 0
    while index < call_names.count() {
        var name = call_names[index]
        if branch_names.contains(name) {
            return true
        }
        index = index + 1
    }
    return false
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var standard_library = Mapping.StandardLibrary()
var class_name = ""
var line = 0
var function_name = ""
var holder = ""
var gathered = Validators.Answer()

func check(starting_walk: AbstractSyntaxTree.Walk.Walk, starting_class_name: String): Validators.Answer {
    gathered = Validators.Answer()
    fallback not standard_library.holds(starting_walk.file.path)
    walk = starting_walk
    class_name = starting_class_name
    walk.file.declarations.each(check_declaration)
    walk.function_declarations.each(check_function)
    walk.statements.each(check_found_statement)
    walk.expressions.each(check_found_expression)
    return gathered
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    line = declaration.line
    function_name = ""
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: check_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: check_union(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: check_type_declaration(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return
    }
}

func check_attribute(attribute: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    holder = "the attribute '{attribute.name}'"
    check_type(attribute.declared_type)
}

func check_union(declared: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    holder = "the union '{declared.name}'"
    var index = 0
    while index < declared.member_names.count() {
        var member = declared.member_names[index]
        var member_line = declared.member_lines[index]
        crash member_line
        line = member_line
        if member == "Anything" {
            refuse()
        }
        index = index + 1
    }
}

func check_type_declaration(declared: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    var index = 0
    while index < declared.members.count() {
        var member = declared.members[index]
        holder = "the member '{member.name}' of type '{declared.name}'"
        check_type(member.result)
        check_parameters(member.parameters)
        index = index + 1
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    line = function.line
    function_name = function.name
    check_parameters(function.parameters)
    holder = "the answer of '{function.name}'"
    check_type(function.result)
}

func check_parameters(parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>) {
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        holder = "the parameter '{parameter.name}'"
        check_type(parameter.declared_type)
        index = index + 1
    }
}

func check_found_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        line = statement.line
        function_name = found.function_name
        holder = "the local '{statement.name}'"
        check_type(statement.declared_type)
    }
}

func check_found_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    line = found.line
    function_name = found.function_name
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_call(expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_identifier(expression)
    }
}

func check_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    holder = "what is made here"
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder = "the '{callee.name}' made here"
    }
    check_arguments(call.generic_arguments)
}

func check_identifier(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression) {
    holder = "the '{identifier.name}' named here"
    check_arguments(identifier.generic_arguments)
    fallback identifier.name == "Anything"
    var text = "'Anything' is not part of Spite: every place names what it holds, so there is no union of every class; 'Spite.Class.instances' lists the classes of the program"
    note(text)
}

func check_type(declared: SpiteCompiler.Type?) {
    fallback declared
    fallback declared.class == AbstractSyntaxTree.Shapes.Types.NamedType
    check_arguments(declared.arguments)
    fallback declared.path.count() == 1
    var written = declared.path[0]
    if written == "Anything" {
        refuse()
    }
}

func check_arguments(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        if argument.is_type {
            check_type(argument.type_reference)
        }
        index = index + 1
    }
}

# ../../../../spite_documentation/values_and_types.md#every-place-names-what-it-holds
func refuse() {
    var text = "'Anything' is not a type: say what {holder} holds, with its class, a union of its classes, a 'type' of the functions and attributes it is used through (like a 'Component'), or a generic class's '$name'"
    note(text)
}

func note(text: String) {
    var problem = Diagnostics.Problem(walk.file.path, line, text)
    problem.class_name = class_name
    if not function_name.is_empty() {
        problem.function_name = function_name
    }
    problem.is_among_the_attributes = function_name.is_empty()
    gathered.mistakes.append(problem)
}

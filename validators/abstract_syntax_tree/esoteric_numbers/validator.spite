union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var path = ""
var class_name = ""
var decimal_preset_texts = List<String>()
var decimal_preset_names = List<String>()
var whole_preset_texts = List<String>()
var whole_preset_names = List<String>()
var preset_keys = List<String>()
var _least_digits = 3
var _least_fraction_digits = 2
var _zero_code = 48
var _five_code = 53

# ../../../../spite_spec/specs/values_and_types.md#named-numbers
func check(walks: List<AbstractSyntaxTree.Walk.Walk>, class_names: List<String>) {
    var index = 0
    while index < walks.count() {
        var walk = walks[index]
        var name = class_names[index]
        crash name
        collect_presets(walk, name)
        index = index + 1
    }
    index = 0
    while index < walks.count() {
        var walk = walks[index]
        var name = class_names[index]
        crash name
        check_walk(walk, name)
        index = index + 1
    }
}

func collect_presets(walk: AbstractSyntaxTree.Walk.Walk, name: String) {
    var shown = walk.file.namespace
    if shown.is_empty() {
        shown = name
    }
    var index = 0
    while index < walk.function_declarations.count() {
        var function = walk.function_declarations[index]
        if function.is_a_preset_of(name) {
            collect_a_preset(function, shown)
        }
        index = index + 1
    }
}

func collect_a_preset(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, shown: String) {
    fallback function.body and function.body.statements.count() == 1
    var only = function.body.statements[0]
    fallback only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    fallback only.value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    collect_a_literal(only.value, shown, function.name)
}

func collect_a_literal(
    value: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    shown: String,
    function_name: String,
) {
    var text = value.text.replace("_", "")
    var preset = "{shown}.{function_name}()"
    if value.kind == 'decimal_literal' {
        decimal_preset_texts.append(text)
        decimal_preset_names.append(preset)
    }
    if value.kind == 'integer_literal' {
        whole_preset_texts.append(text)
        whole_preset_names.append(preset)
    }
}

func check_walk(walk: AbstractSyntaxTree.Walk.Walk, name: String) {
    path = walk.file.path
    class_name = name
    preset_keys = List<String>()
    var index = 0
    while index < walk.function_declarations.count() {
        var function = walk.function_declarations[index]
        if function.is_a_preset_of(name) {
            var key = function.declared_key()
            preset_keys.append(key)
        }
        index = index + 1
    }
    walk.expressions.each(check_found)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback not preset_keys.contains(found.function_name)
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        check_literal(found, expression)
    }
}

func check_literal(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
) {
    var text = literal.text.replace("_", "")
    if literal.kind == 'decimal_literal' {
        check_decimal(found, text)
    }
    if literal.kind == 'integer_literal' and not found.function_name.is_empty() {
        check_whole(found, text)
    }
}

func check_decimal(found: AbstractSyntaxTree.Walk.Found.Expression, text: String) {
    var presets = matching(text, decimal_preset_texts, decimal_preset_names)
    fallback not presets.is_empty()
    var message = "the number {text} is {presets}: write {presets} instead of the number"
    refuse(found, message)
}

func check_whole(found: AbstractSyntaxTree.Walk.Found.Expression, text: String) {
    fallback is_esoteric(text)
    var message = "the number {text} does not say what it means: declare a private attribute that names it, like 'var _what_it_means = {text}', and write the name here"
    var presets = matching_whole(text)
    if not presets.is_empty() {
        message = "{message}, or write {presets} if it means that"
    }
    refuse(found, message)
}

func matching_whole(text: String): String {
    var found = List<String>()
    var index = 0
    while index < whole_preset_texts.count() {
        var name = whole_preset_names[index]
        crash name
        if whole_preset_texts[index] == text {
            found.append(name)
        }
        index = index + 1
    }
    return found.join(" or ")
}

func refuse(found: AbstractSyntaxTree.Walk.Found.Expression, message: String) {
    var failure = Validators.Failure()
    failure.stop_inside(path, found.line, class_name, found.function_name, message)
}

func is_esoteric(digits: String): Boolean {
    fallback digits.length() >= _least_digits
    fallback digits.replace("0", "") != "1"
    return not is_a_power_of_two(digits)
}

func is_a_power_of_two(digits: String): Boolean {
    var rest = digits
    while rest != "1" {
        fallback not rest.is_empty()
        var last_index = rest.length() - 1
        var last = rest.byte_at(last_index)
        var is_even = (last - _zero_code) % 2 == 0
        fallback is_even
        rest = halved(rest)
    }
    return true
}

func halved(digits: String): String {
    var result = ""
    var carry = 0
    var index = 0
    while index < digits.length() {
        var digit = digits.byte_at(index) - _zero_code
        var current = carry * 10 + digit
        var half = current / 2
        carry = current - half * 2
        if not result.is_empty() or half > 0 {
            result = "{result}{half}"
        }
        index = index + 1
    }
    return result
}

func matching(text: String, texts: List<String>, names: List<String>): String {
    var found = List<String>()
    var index = 0
    while index < texts.count() {
        var preset_text = texts[index]
        var name = names[index]
        crash name
        if agrees(text, preset_text) and not found.contains(name) {
            found.append(name)
        }
        index = index + 1
    }
    return found.join(" or ")
}

func agrees(written: String, preset: String): Boolean {
    var written_parts = written.split(".")
    var preset_parts = preset.split(".")
    fallback written_parts.count() == 2 and preset_parts.count() == 2
    var written_whole = written_parts[0]
    var preset_whole = preset_parts[0]
    var written_fraction = written_parts[1]
    var preset_fraction = preset_parts[1]
    fallback written_whole == preset_whole
    var places = written_fraction.length()
    fallback places >= _least_fraction_digits
    if places >= preset_fraction.length() {
        var preset_places = preset_fraction.length()
        var tail = written_fraction.slice(preset_places, places)
        crash tail
        return written_fraction.starts_with(preset_fraction) and tail.replace("0", "").is_empty()
    }
    var cut = preset_fraction.slice(0, places)
    crash cut
    if cut == written_fraction {
        return true
    }
    var next = preset_fraction.byte_at(places)
    fallback next >= _five_code
    return rounded_up(cut) == written_fraction
}

func rounded_up(digits: String): String {
    var result = ""
    var carry = 1
    var index = digits.length() - 1
    while index >= 0 {
        var digit = digits.byte_at(index) - _zero_code + carry
        carry = 0
        if digit == 10 {
            digit = 0
            carry = 1
        }
        result = "{digit}{result}"
        index = index - 1
    }
    return result
}

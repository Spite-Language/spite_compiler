union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var empty_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var walk = AbstractSyntaxTree.Walk.Walk(empty_file)
var line = 0

func check(starting_walk: AbstractSyntaxTree.Walk.Walk) {
    walk = starting_walk
    fallback not is_in_the_library()
    walk.expressions.each(check_found)
    walk.file.declarations.each(check_declaration)
    walk.function_declarations.each(check_function)
    walk.statements.each(check_found_statement)
}

func is_in_the_library(): Boolean {
    var library = Validators.LibraryFile()
    return library.holds(walk.file.path)
}

func check_found(found: AbstractSyntaxTree.Walk.Found.Expression) {
    var expression = found.expression
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_member(found, expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        line = found.line
        check_arguments(expression.generic_arguments)
    }
}

func check_member(
    found: AbstractSyntaxTree.Walk.Found.Expression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback member.is_a_class_name
    var printer = Printers.Spite.ExpressionPrinter(member)
    var written = printer.text()
    line = found.line
    check_written(written)
}

func check_declaration(declaration: Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        line = declaration.line
        check_type(declaration.declared_type)
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration {
        line = declaration.line
        declaration.members.each(check_type_member)
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration {
        line = declaration.line
        declaration.member_names.each(check_written)
    }
}

func check_type_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        check_type(parameter.declared_type)
        index = index + 1
    }
    check_type(member.result)
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    line = function.line
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        check_type(parameter.declared_type)
        index = index + 1
    }
    check_type(function.result)
}

func check_found_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    var statement = found.statement
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        line = statement.line
        check_type(statement.declared_type)
    }
}

func check_type(declared: Type?) {
    fallback declared
    if declared == AbstractSyntaxTree.Shapes.Types.NamedType {
        var written = declared.path.join(".")
        check_written(written)
        check_arguments(declared.arguments)
    }
}

func check_arguments(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        if argument.is_type {
            check_type(argument.type_reference)
        }
        index = index + 1
    }
}

func check_written(written: String) {
    var machinery = ["Spite.Fault", "Spite.Asserts", "Spite.CopyTable", "Spite.Prompt", "Spite.PromptPath"]
    var is_internal = written == "Spite.Internal" or written.starts_with("Spite.Internal.")
    fallback is_internal or machinery.contains(written)
    var text = "{written} is internal to Spite and cannot be used outside the standard library: read bytes with Buffer or BinaryReader, describe foreign data with a plain type, and leave threads to the compiler"
    var failure = Validators.Failure()
    var problem = Diagnostics.Problem(walk.file.path, line, text)
    failure.stop(problem)
}

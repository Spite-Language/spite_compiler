union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var path = ""
var class_name = ""
var sources = List<String>()

# ../../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    path = file.path
    var segments = starting_class_name.split(".")
    var simple = segments.last()
    crash simple
    class_name = simple
    sources = List<String>()
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        check_function(declaration)
    }
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var takes_values = not function.parameters.is_empty()
    if function.name == class_name and function.result and takes_values and not function.is_a_conversion() {
        refuse(function.line, "'{class_name}' answers a value and is named after its class, so it is a conversion: it takes one parameter named 'from', the value it converts, as in 'func {class_name}(from: String): {class_name}?'")
    }
    if function.is_a_conversion() {
        check_conversion(function)
    }
    if function.is_a_preset_of(class_name) {
        check_preset(function)
    }
}

func check_conversion(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var made = result_name(function)
    var made_name = made.replace("?", "")
    if made_name != function.name {
        refuse(function.line, "the conversion '{function.name}' answers '{made}', but a conversion answers the class it is named after, or its '?': write ': {function.name}' or ': {function.name}?'")
    }
    var key = function.declared_key()
    if sources.contains(key) {
        refuse(function.line, "'{class_name}' has two conversions from one type: a class has one conversion from each type, so delete one")
    }
    sources.append(key)
}

func check_preset(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var made = result_name(function)
    if made != class_name {
        refuse(function.line, "the preset '{function.name}' answers '{made}', but a preset answers exactly its class, '{class_name}', never null: name a special value of the class it is in")
    }
}

func result_name(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    crash function.result
    var printer = Printers.Spite.TypePrinter(function.result)
    return printer.text()
}

func refuse(line: Integer, text: String) {
    var failure = Validators.Failure()
    failure.stop_at(path, line, class_name, text)
}

union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var attribute_names = List<String>()

func check(file: AbstractSyntaxTree.Shapes.SourceFile, class_name: String) {
    attribute_names = List<String>()
    file.declarations.each(note_an_attribute)
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            check_function(file, class_name, declaration)
        }
        index = index + 1
    }
}

func note_an_attribute(declaration: Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        attribute_names.append(declaration.name)
    }
}

func check_function(
    file: AbstractSyntaxTree.Shapes.SourceFile,
    class_name: String,
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    fallback function.name.starts_with("json_key_")
    var name_length = function.name.length()
    var attribute = function.name.slice(9, name_length)
    crash attribute
    fallback attribute_names.contains(attribute)
    var text = "'{class_name}.{function.name}' would name the JSON key of '{attribute}', and JsonReader and JsonWriter do not read a function for it: a key that is not an attribute's name is given to the serializer in a map keyed by the attribute, '\{{class_name}.attributes['{attribute}']: \"...\"}'"
    var failure = Validators.Failure()
    failure.stop_inside(file.path, function.line, class_name, function.name, text)
}

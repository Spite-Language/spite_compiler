var class_name = ""
var path = ""
var refused = false

func check(file: AbstractSyntaxTree.Shapes.SourceFile, starting_class_name: String) {
    class_name = starting_class_name
    path = file.path
    file.declarations.each(check_declaration)
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    fallback not refused
    fallback declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    refused = true
    var text = "'{class_name}' is the entry class and declares 'generic {declaration.name}', but a generic class has no one object and the entry class is the one that runs: remove its 'generic' lines, and write what needs them in a class the entry class makes"
    var failure = Diagnostics.Failure()
    failure.stop_at(path, declaration.line, class_name, text)
}

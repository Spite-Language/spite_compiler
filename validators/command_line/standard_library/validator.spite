# ../../../../spite_documentation/compiler.md#where-the-standard-library-comes-from
func check(found: CommandLine.LibraryFolder): Validators.Answer {
    if found.is_given {
        return check_the_flag(found)
    }
    return check_the_installed(found)
}

func check_the_flag(found: CommandLine.LibraryFolder): Validators.Answer {
    if found.is_bare {
        return mistake(
            "'--standard-library-path' needs the folder that holds the standard library: --standard-library-path=<folder>, such as --standard-library-path=../spite_standard_library",
        )
    }
    if not found.exists {
        return mistake(
            "'--standard-library-path={found.written}' names no folder: give the folder that holds the standard library, with its 'common' and '{found.system}' folders, or leave the flag out to use the library installed with the compiler",
        )
    }
    fallback not found.missing.is_empty()
    return mistake(
        "'--standard-library-path={found.written}' names a folder that is not a standard library: a standard library holds a 'common' folder and one for each system, and it has no '{found.missing}' folder",
    )
}

func check_the_installed(found: CommandLine.LibraryFolder): Validators.Answer {
    if found.folder.is_empty() {
        return mistake(
            "the compiler found no standard library: it takes the 'spite_standard_library' folder nearest above its own executable ({found.executable}), and no folder above it holds one. Give --standard-library-path=<folder> to name it",
        )
    }
    fallback not found.missing.is_empty()
    return mistake(
        "the standard library installed with the compiler, '{found.folder}', is not a whole library: it has no '{found.missing}' folder. Give --standard-library-path=<folder> to name another",
    )
}

func mistake(text: String): Validators.Answer {
    var problem = Diagnostics.Problem("", 0, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

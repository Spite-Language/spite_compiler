var _largest_signed_32_bit: Long = 2147483647
var _smallest_signed_32_bit: Long = -2147483648

# ../../../HOT_RELOAD.md#the-manifest
func check_a_readable_manifest(path: String, text: String?) {
    fallback not text
    refuse("'{path}' cannot be read: a reload compiles against the manifest its --hot-reload build wrote beside it")
}

func check_a_manifest_line(kind: String, line: String) {
    var kinds = ["generation", "text", "routines", "function", "state", "import", "library", "class", "enum", "file"]
    fallback not kinds.contains(kind)
    refuse(
        "the reload manifest holds a line this compiler does not read, so another compiler wrote it: '{line}'. Build the program again with this compiler",
    )
}

func check_the_shared_routines(now: String, running: String) {
    fallback now != running
    refuse(
        "the routines every function shares (allocating, freeing, stopping) are compiled differently now, which a reload cannot swap under the running program: start the program again",
    )
}

func check_a_reach(distance: Long, key: String) {
    fallback distance < _smallest_signed_32_bit or distance > _largest_signed_32_bit
    refuse("the new code of '{key}' lands too far from the program to reach it")
}

func check_a_callee(placed: Integer?, caller: String, callee: String) {
    fallback not placed
    refuse("'{caller}' calls '{callee}', which neither the running program nor the new code has")
}

func check_an_import(found: Long?, name: String, key: String) {
    fallback not found
    refuse(
        "the new code of '{key}' calls '{name}' of the system, which the running program never imports: start the program again to take it",
    )
}

func check_named_data(constant_labels: List<Integer>, label: Integer, key: String) {
    fallback not constant_labels.contains(label)
    refuse(
        "the new code of '{key}' reaches data the compiler did not name, so the reload cannot tell whether the running program holds it already: start the program again",
    )
}

func check_named_state(name: String, key: String) {
    fallback name.is_empty()
    refuse(
        "the new code of '{key}' reaches state the compiler did not name, so it cannot be matched to the running program's: start the program again",
    )
}

func check_a_breakpoint_line(site: String, cut: Integer, line: Integer?) {
    fallback cut < 2 or not line
    refuse("'{site}' names no line of a file: a breakpoint is set as 'break hero.spite:12'")
}

func check_a_breakpoint_file(written: String, holders: List<String>?) {
    if not holders {
        refuse(
            "no file of the program ends in '{written}': a breakpoint names one of the program's own files, as in 'break hero.spite:12'",
        )
    }
    crash holders
    fallback holders.count() > 1
    var named = holders.join(", ")
    refuse("'{written}' names more than one file of the program ({named}): write more of the path")
}

func check_a_breakpoint_statement(site: String, placed_sites: List<String>) {
    fallback not placed_sites.contains(site)
    refuse(
        "no statement starts on '{site}': a breakpoint stops before a statement, so name the line a statement starts on",
    )
}

func check_literal_counts(before: Integer?, after: Integer?) {
    fallback before and after
    fallback before != after
    refuse(
        "the reload makes {after} object literals of the same attributes in one function where the running program has {before}, and the objects the program holds would take the class of another literal: start the program again, or give the new literal other attributes",
    )
}

func check_a_layout(model: Model.ClassModel, running: String, now: String) {
    fallback running != now
    var running_names = attribute_names(running)
    var new_names = attribute_names(now)
    var changes = List<String>()
    var index = 0
    while index < new_names.count() {
        var name = new_names[index]
        if not running_names.contains(name) {
            changes.append("{name} is new")
        }
        index = index + 1
    }
    index = 0
    while index < running_names.count() {
        var name = running_names[index]
        if not new_names.contains(name) {
            changes.append("{name} is gone")
        }
        index = index + 1
    }
    if changes.is_empty() {
        changes.append("its attributes moved to other places or took other types")
    }
    var joined = changes.join(", ")
    refuse(
        "the reload changes the attributes of {model.shown} ({joined}), and the objects the program holds keep the attributes they were made with: start the program again to take the new attributes",
    )
}

func attribute_names(described: String): List<String> {
    var names = List<String>()
    var parts = described.split(";")
    var attributes = parts[1]
    if not attributes or attributes.is_empty() {
        return names
    }
    var listed = attributes.split("|")
    var index = 0
    while index < listed.count() {
        var entry = listed[index]
        var colon = entry.index_of(":")
        if colon {
            var name = entry.slice(0, colon)
            crash name
            names.append(name)
        }
        index = index + 1
    }
    return names
}

func check_enum_values(model: Model.ClassModel, enum_name: String, running: String, now: String) {
    var running_numbers = enum_numbers(running)
    var new_numbers = enum_numbers(now)
    var running_values = running_numbers.keys()
    var new_values = new_numbers.keys()
    var running_names = running_values.join(",")
    var new_names = new_values.join(",")
    var keeps_the_order = new_names == running_names or new_names.starts_with("{running_names},")
    if keeps_the_order {
        check_enum_numbers(model, enum_name, running_numbers, new_numbers)
    } else {
        refuse(
            "the reload changes the values of {model.shown}.{enum_name} other than adding new ones last, and every value the program holds keeps the number it was made with: start the program again, or add the new values after the others",
        )
    }
}

func check_enum_numbers(
    model: Model.ClassModel,
    enum_name: String,
    running_numbers: Dictionary<String, String>,
    new_numbers: Dictionary<String, String>,
) {
    var names = running_numbers.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var before = running_numbers[name]
        var after = new_numbers[name]
        crash before
        if after and after != before {
            refuse(
                "the reload changes {model.shown}.{enum_name}'s '{name}' from {before} to {after}, and every value the program holds keeps the number it was made with: start the program again, or give '{name}' its number {before} back",
            )
            return
        }
        index = index + 1
    }
}

func enum_numbers(described: String): Dictionary<String, String> {
    var numbers = Dictionary<String, String>()
    var values = described.split(",")
    var index = 0
    while index < values.count() {
        var value = values[index]
        var equals = value.index_of("=")
        if equals {
            var name = value.slice(0, equals)
            var length = value.length()
            var number = value.slice(equals + 1, length)
            crash name
            crash number
            numbers[name] = number
        } else {
            numbers[value] = ""
        }
        index = index + 1
    }
    return numbers
}

# ../../../../spite_documentation/repl.md#how-it-works
func refuse(text: String) {
    var problem = Diagnostics.Problem("", 0, "the reload was refused, and the program keeps all of its code: {text}")
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

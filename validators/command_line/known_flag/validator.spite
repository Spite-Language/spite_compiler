var environment = Environment()
var operating_systems = ["windows", "linux", "mac"]
var smallest_port = 1
var largest_port = 65535
var removed_reasons = {
    "executable": "'spite --build' builds the executable without running it, and 'spite' builds it and runs it"
    "run": "'spite' builds the program and runs it, 'spite --check' only checks that it compiles, and 'spite --build' builds it without running it"
    "translation_units": "the compiler chooses how many C files it compiles a program from"
    "tune_for_this_machine": "a default or --hot-reload build is tuned for the machine that builds it, and an --optimized build, the one shipped, runs on any machine"
}

func check(
    flags: Dictionary<String, String>,
    written_flags: List<String>,
    bare_flags: List<String>,
    build: Model.ClassModel?,
): Validators.Answer {
    var seen = List<String>()
    var index = 0
    while index < written_flags.count() {
        var written = written_flags[index]
        var written_answer = check_a_written_flag(written, seen)
        if written_answer.is_a_mistake() {
            return written_answer
        }
        seen.append(written)
        index = index + 1
    }
    var names = flags.keys()
    var name_index = 0
    while name_index < names.count() {
        var name = names[name_index]
        var value = flags[name]
        crash value
        var is_supplied = name == "program" and not written_flags.contains("program")
        if not is_supplied {
            var flag_answer = check_one(name, value, bare_flags, build)
            if flag_answer.is_a_mistake() {
                return flag_answer
            }
        }
        name_index = name_index + 1
    }
    return check_the_outputs(flags)
}

# ../../../../spite_documentation/programs.md#compile-time-settings-build
func check_the_build_settings(flags: Dictionary<String, String>): Validators.Answer {
    var asks_both = flags["check"] == "true" and flags["build"] == "true"
    if asks_both {
        return mistake_of_both()
    }
    var reload_answer = check_the_reload_build(flags)
    if reload_answer.is_a_mistake() {
        return reload_answer
    }
    var port = flags["repl_port"]
    fallback port
    return check_the_port(port)
}

# ../../../../spite_documentation/repl.md#how-it-works
func check_the_reload_build(flags: Dictionary<String, String>): Validators.Answer {
    fallback flags.contains("reload_at") and flags["hot_reload"] != "true"
    return mistake(
        "'--reload-at' is given by a running --hot-reload program when it compiles a change, with the flags it was built with: build with --hot-reload, and the program reloads itself",
    )
}

func mistake_of_both(): Validators.Answer {
    return mistake(
        "'--check' only checks that the program compiles and '--build' builds its executable: give one of them",
    )
}

func check_a_written_flag(written: String, seen: List<String>): Validators.Answer {
    var separator_answer = check_separator(written)
    if separator_answer.is_a_mistake() {
        return separator_answer
    }
    var spelling_answer = check_spelling(written)
    if spelling_answer.is_a_mistake() {
        return spelling_answer
    }
    return check_once(written, seen)
}

func check_separator(written: String): Validators.Answer {
    fallback written.is_empty()
    return mistake(
        "'--' is not a separator: a program's Build flags are given beside the compiler's, kebab-case like them: spite --optimized --player-count=2",
    )
}

func check_the_outputs(flags: Dictionary<String, String>): Validators.Answer {
    var reload_answer = check_the_reload(flags)
    if reload_answer.is_a_mistake() {
        return reload_answer
    }
    fallback flags["check"] == "true"
    if flags["build"] == "true" {
        return mistake_of_both()
    }
    fallback flags["executable_path"]
    return mistake(
        "'--executable-path' says where the executable goes, and '--check' builds none: leave out --check to build it",
    )
}

# ../../../../spite_documentation/repl.md#how-it-works
func check_the_reload(flags: Dictionary<String, String>): Validators.Answer {
    fallback flags.contains("reload_at")
    var address = flags["reload_at"]
    crash address
    var read_address: Long? = address
    fallback not read_address or not flags.contains("executable_path")
    return mistake(
        "'--reload-at' takes the address the running program keeps for the new code, and --executable-path the program: the program gives both",
    )
}

func check_spelling(written: String): Validators.Answer {
    fallback written.contains("_")
    var kebab = written.replace("_", "-")
    return mistake(
        "'--{written}' is written '--{kebab}': flags and settings are kebab-case on the command line, and the field they set is '{written}'",
    )
}

func check_once(written: String, seen: List<String>): Validators.Answer {
    fallback seen.contains(written)
    return mistake("'--{written}' is given twice: a flag or a setting is given once")
}

func check_one(name: String, value: String, bare_flags: List<String>, build: Model.ClassModel?): Validators.Answer {
    var flag = name.replace("_", "-")
    var is_bare = bare_flags.contains(name)
    if name == "operating_system" {
        return mistake(
            "'--operating-system' cannot be given: Build.operating_system is the system doing the compiling (windows). To write the program for another system, give --target-operating-system=linux (or windows, or mac)",
        )
    }
    if name == "program" {
        return mistake(
            "'--program' cannot be given: the program is the folder the compiler runs in, 'cd folder' then 'spite', and Build.program is set from it",
        )
    }
    if name == "format" {
        return mistake(
            "'--format' is not a compiler option: every compile formats the program's own files first, and nothing turns that off: '--check' formats and checks a program without building it",
        )
    }
    if name == "optimization_report" and is_bare {
        return mistake(
            "'--optimization-report' needs the file to write: --optimization-report=<file>, such as --optimization-report=.spite/optimization.md",
        )
    }
    fallback not environment.is_the_compilers_own(name)
    if not build and environment.is_read_without_a_library(name) {
        return check_a_boolean_option(name, flag, value)
    }
    var attribute: Model.AttributeModel? = null
    if build {
        attribute = build.attribute_named(name)
    }
    if not attribute {
        return unknown_mistake(name, flag, build)
    }
    var value_answer = check_the_value(attribute, flag, value, bare_flags)
    if value_answer.is_a_mistake() {
        return value_answer
    }
    if name == "repl_port" {
        return check_the_port(value)
    }
    fallback name == "target_operating_system"
    return check_the_system(value)
}

# ../../../../spite_documentation/compiler.md#pass-settings-to-the-program
func check_a_boolean_option(name: String, flag: String, value: String): Validators.Answer {
    fallback value != "true" and value != "false"
    return mistake(
        "'--{flag}={value}' was given to the compiler, but 'Build.{name}' is a Boolean: --{flag}, --{flag}=true or --{flag}=false",
    )
}

func unknown_mistake(name: String, flag: String, build: Model.ClassModel?): Validators.Answer {
    var removed = removed_reasons[name]
    if removed {
        return mistake("'--{flag}' is not a compiler option: {removed}")
    }
    if not build {
        return mistake_without_a_library(name, flag)
    }
    var options = List<String>()
    var index = 0
    while index < build.declared_attributes.count() {
        var attribute = build.declared_attributes[index]
        options.append(attribute.name)
        index = index + 1
    }
    var listed = options.join(", ")
    return mistake(
        "'--{flag}' is not a compiler option, and this program's Build declares no '{name}' (it declares {listed}). To decide it when compiling, reopen Build in the program's build.spite with 'var {name} = ...'; to read it when the program runs, declare it in environment.spite with 'var {name} = ...' and give it to the program's executable",
    )
}

func mistake_without_a_library(name: String, flag: String): Validators.Answer {
    return mistake(
        "'--{flag}' is not a compiler option this program can take: it loads no standard library, so it has no Build, and only --debug-memory and --optimized are read without one. To decide '{name}' when compiling, load the standard library and reopen Build in the program's build.spite with 'var {name} = ...'",
    )
}

func check_the_value(
    attribute: Model.AttributeModel,
    flag: String,
    value: String,
    bare_flags: List<String>,
): Validators.Answer {
    var kind = attribute.attribute_type.name
    var is_bare = bare_flags.contains(attribute.name)
    if kind == "String" and is_bare {
        return mistake("'--{flag}' was given to the compiler, but 'Build.{attribute.name}' is a String: --{flag}=text")
    }
    if kind == "Boolean" and value != "true" and value != "false" {
        return mistake(
            "'--{flag}={value}' was given to the compiler, but 'Build.{attribute.name}' is a Boolean: --{flag}, --{flag}=true or --{flag}=false",
        )
    }
    fallback kind == "Integer"
    var number: Long? = value
    fallback not number
    return mistake(
        "'--{flag}={value}' was given to the compiler, but 'Build.{attribute.name}' is an Integer: a whole number, like --{flag}=3",
    )
}

# ../../../../spite_documentation/compiler.md#pass-settings-to-the-program
func check_the_variable(
    attribute: Model.AttributeModel,
    variable: String,
    value: String,
    place: String,
): Validators.Answer {
    var kind = attribute.attribute_type.name
    var given = "'{variable}={value}' in {place} sets 'Build.{attribute.name}'"
    if kind == "Boolean" and value != "true" and value != "false" {
        return mistake("{given}, which is a Boolean: {variable}=true or {variable}=false")
    }
    fallback kind == "Integer"
    var number: Long? = value
    fallback not number
    return mistake("{given}, which is an Integer: a whole number, like {variable}=3")
}

func check_the_type_of(name: String, declared: Spite.Class): Validators.Answer {
    fallback declared != Boolean and declared != String and declared != Integer
    return mistake(
        "the compiler's flag Environment.{name} is not a Boolean, a String or an Integer: Settings reads only those three, so it would be ignored",
    )
}

func check_the_port(value: String): Validators.Answer {
    var port: Long? = value
    crash port
    fallback port < smallest_port or port > largest_port
    return mistake("--repl-port takes a port number from 1 to 65535: spite --repl-port=4000")
}

func check_the_system(value: String): Validators.Answer {
    fallback not operating_systems.contains(value)
    return mistake(
        "'--target-operating-system={value}' names no operating system the library has a folder for: windows, linux or mac",
    )
}

func mistake(text: String): Validators.Answer {
    var problem = Diagnostics.Problem("", 0, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

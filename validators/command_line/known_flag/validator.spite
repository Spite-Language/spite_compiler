var operating_systems = ["windows", "linux", "mac"]
var compiler_flags = ["check", "build", "executable_path", "high_ir", "low_ir", "optimization_report", "reload_at", "connect", "command"]
var options_without_a_library = ["debug_memory", "optimized"]
var smallest_port = 1
var largest_port = 65535
var removed_reasons = {
    "executable": "'spite --build' builds the executable without running it, and 'spite' builds it and runs it"
    "run": "'spite' builds the program and runs it, 'spite --check' only checks that it compiles, and 'spite --build' builds it without running it"
    "translation_units": "the compiler chooses how many C files it compiles a program from"
    "tune_for_this_machine": "a default or --hot-reload build is tuned for the machine that builds it, and an --optimized build, the one shipped, runs on any machine"
}

func check(
    flags: Dictionary<String, String>,
    written_flags: List<String>,
    bare_flags: List<String>,
    build: Model.ClassModel?,
) {
    var seen = List<String>()
    var index = 0
    while index < written_flags.count() {
        var written = written_flags[index]
        check_separator(written)
        check_spelling(written)
        check_once(written, seen)
        seen.append(written)
        index = index + 1
    }
    var names = flags.keys()
    var name_index = 0
    while name_index < names.count() {
        var name = names[name_index]
        var value = flags[name]
        crash value
        var is_bare = bare_flags.contains(name)
        var is_supplied = name == "program" and not written_flags.contains("program")
        if not is_supplied {
            check_one(name, value, is_bare, build)
        }
        name_index = name_index + 1
    }
    check_the_outputs(flags)
}

# ../../../../spite_spec/specs/programs.md#build-settings-build
func check_the_build_settings(flags: Dictionary<String, String>) {
    var asks_both = flags["check"] == "true" and flags["build"] == "true"
    if asks_both {
        refuse_both()
    }
    check_the_reload_build(flags)
    var port = flags["repl_port"]
    fallback port
    check_the_port(port)
}

# ../../../../spite_spec/specs/repl.md#live-reload-in-detail
func check_the_reload_build(flags: Dictionary<String, String>) {
    fallback flags.contains("reload_at") and flags["hot_reload"] != "true"
    refuse(
        "'--reload-at' is given by a running --hot-reload program when it compiles a change, with the flags it was built with: build with --hot-reload, and the program reloads itself",
    )
}

func refuse_both() {
    refuse("'--check' only checks that the program compiles and '--build' builds its executable: give one of them")
}

func check_separator(written: String) {
    fallback written.is_empty()
    refuse(
        "'--' is not a separator: a program's Build flags are given beside the compiler's, kebab-case like them: spite --optimized --player-count=2",
    )
}

func check_the_outputs(flags: Dictionary<String, String>) {
    check_the_reload(flags)
    fallback flags["check"] == "true"
    if flags["build"] == "true" {
        refuse_both()
    }
    fallback flags["executable_path"]
    refuse(
        "'--executable-path' says where the executable goes, and '--check' builds none: leave out --check to build it",
    )
}

# ../../../../spite_spec/specs/repl.md#live-reload-in-detail
func check_the_reload(flags: Dictionary<String, String>) {
    fallback flags.contains("reload_at")
    var address = flags["reload_at"]
    crash address
    var read_address: Long? = address
    if not read_address or not flags.contains("executable_path") {
        refuse("'--reload-at' takes the address the running program keeps for the new code, and --executable-path the program: the program gives both")
    }
}

func check_spelling(written: String) {
    fallback written.contains("_")
    var kebab = written.replace("_", "-")
    refuse(
        "'--{written}' is written '--{kebab}': flags and settings are kebab-case on the command line, and the field they set is '{written}'",
    )
}

func check_once(written: String, seen: List<String>) {
    fallback seen.contains(written)
    refuse("'--{written}' is given twice: a flag or a setting is given once")
}

func check_one(
    name: String,
    value: String,
    is_bare: Boolean,
    build: Model.ClassModel?,
) {
    var flag = name.replace("_", "-")
    if name == "operating_system" {
        refuse(
            "'--operating-system' cannot be given: Build.operating_system is the system doing the compiling (windows). To write the program for another system, give --target-operating-system=linux (or windows, or mac)",
        )
    }
    if name == "program" {
        refuse(
            "'--program' cannot be given: the program is the folder the compiler runs in, 'cd folder' then 'spite', and Build.program is set from it",
        )
    }
    if name == "format" {
        refuse(
            "'--format' is not a compiler option: every compile formats the program's own files first, and nothing turns that off: '--check' formats and checks a program without building it",
        )
    }
    if name == "optimization_report" and is_bare {
        refuse(
            "'--optimization-report' needs the file to write: --optimization-report=<file>, such as --optimization-report=.spite/optimization.md",
        )
    }
    fallback not compiler_flags.contains(name)
    if not build and options_without_a_library.contains(name) {
        check_a_boolean_option(name, flag, value)
        return
    }
    var attribute: Model.AttributeModel? = null
    if build {
        attribute = build.attribute_named(name)
    }
    if not attribute {
        refuse_unknown(name, flag, build)
    }
    crash attribute
    check_the_value(attribute, flag, value, is_bare)
    if name == "repl_port" {
        check_the_port(value)
    }
    if name == "target_operating_system" {
        check_the_system(value)
    }
}

# ../../../../spite_spec/specs/compiler.md#flags-and-settings
func check_a_boolean_option(name: String, flag: String, value: String) {
    fallback value != "true" and value != "false"
    refuse(
        "'--{flag}={value}' was given to the compiler, but 'Build.{name}' is a Boolean: --{flag}, --{flag}=true or --{flag}=false",
    )
}

func refuse_unknown(name: String, flag: String, build: Model.ClassModel?) {
    var removed = removed_reasons[name]
    if removed {
        refuse("'--{flag}' is not a compiler option: {removed}")
    }
    if not build {
        refuse_without_a_library(name, flag)
    }
    var options = List<String>()
    if build {
        var index = 0
        while index < build.declared_attributes.count() {
            var attribute = build.declared_attributes[index]
            options.append(attribute.name)
            index = index + 1
        }
    }
    var listed = options.join(", ")
    refuse(
        "'--{flag}' is not a compiler option, and this program's Build declares no '{name}' (it declares {listed}). To decide it when compiling, reopen Build in the program's build.spite with 'var {name} = ...'; to read it when the program runs, declare it in environment.spite with 'var {name} = ...' and give it to the program's executable",
    )
}

func refuse_without_a_library(name: String, flag: String) {
    refuse(
        "'--{flag}' is not a compiler option this program can take: it loads no standard library, so it has no Build, and only --debug-memory and --optimized are read without one. To decide '{name}' when compiling, load the standard library and reopen Build in the program's build.spite with 'var {name} = ...'",
    )
}

func check_the_value(attribute: Model.AttributeModel, flag: String, value: String, is_bare: Boolean) {
    var kind = attribute.attribute_type.name
    if kind == "String" and is_bare {
        refuse("'--{flag}' was given to the compiler, but 'Build.{attribute.name}' is a String: --{flag}=text")
    }
    if kind == "Boolean" and value != "true" and value != "false" {
        refuse(
            "'--{flag}={value}' was given to the compiler, but 'Build.{attribute.name}' is a Boolean: --{flag}, --{flag}=true or --{flag}=false",
        )
    }
    if kind == "Integer" {
        var number: Long? = value
        if not number {
            refuse(
                "'--{flag}={value}' was given to the compiler, but 'Build.{attribute.name}' is an Integer: a whole number, like --{flag}=3",
            )
        }
    }
}

func check_the_port(value: String) {
    var port: Long? = value
    crash port
    fallback port < smallest_port or port > largest_port
    refuse("--repl-port takes a port number from 1 to 65535: spite --repl-port=4000")
}

func check_the_system(value: String) {
    fallback not operating_systems.contains(value)
    refuse(
        "'--target-operating-system={value}' names no operating system the library has a folder for: windows, linux or mac",
    )
}

func refuse(text: String) {
    var problem = Diagnostics.Problem("", 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

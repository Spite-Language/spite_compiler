func check(flags: Dictionary<String, String>, build: Model.ClassModel?) {
    var names = flags.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        check_one(name, build)
        index = index + 1
    }
}

func check_one(name: String, build: Model.ClassModel?) {
    assert name != "high_ir" and name != "low_ir"
    if build {
        assert not build.attribute_named(name)
    }
    var options = List<String>()
    if build {
        var index = 0
        while index < build.declared_attributes.count() {
            var attribute = build.declared_attributes[index]
            var kebab = attribute.name.replace("_", "-")
            options.append("--{kebab}")
            index = index + 1
        }
    }
    var listed = options.join(", ")
    var flag = name.replace("_", "-")
    refuse("'--{flag}' is not a compiler option: the options are {listed}")
}

func refuse(text: String) {
    var problem = Diagnostics.Problem("", 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

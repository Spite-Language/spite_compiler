var console = Console()
var program = Program()

# ../../../../spite_documentation/compiler.md#pass-settings-to-the-program
func check(name: String, is_given: Boolean, given_count: Integer, from_the_environment: String?) {
    fallback is_given and given_count == 0
    fallback not from_the_environment
    console.error(
        "error: this compiler was given --{name} but not handed its flags: build it with a compiler that fills Environment._flags",
    )
    program.exit(1)
}

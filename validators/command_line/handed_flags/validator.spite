var console = Console()
var program = Program()

# ../../../../spite_documentation/compiler.md#pass-settings-to-the-program
func check(setting: CommandLine.HandedSetting, given_count: Integer) {
    fallback setting.is_given and given_count == 0
    fallback not setting.from_the_environment
    console.error(
        "error: this compiler was given --{setting.name} but not handed its flags: build it with a compiler that fills Environment._flags",
    )
    program.exit(1)
}

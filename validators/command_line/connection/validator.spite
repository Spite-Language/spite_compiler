var console = Console()
var program = Program()

# ../../../../spite_documentation/repl.md#remote---repl-port
func check_the_listener(listening: CommandLine.Attempt) {
    fallback not listening.is_done
    stop("error: nothing is listening on {listening.place}")
}

func check_the_write(sending: CommandLine.Attempt) {
    fallback not sending.is_done
    stop_on_a_closed_connection()
}

func check_the_answer(answered: String?) {
    fallback not answered
    stop_on_a_closed_connection()
}

func stop_on_a_closed_connection() {
    stop("error: the program on the port closed the connection")
}

func stop(text: String) {
    console.error(text)
    program.exit(1)
}

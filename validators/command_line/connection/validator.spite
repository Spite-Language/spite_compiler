var console = Console()
var program = Program()

# ../../../../spite_documentation/repl.md#remote---repl-port
func check_the_listener(port: Integer, connected: Boolean) {
    fallback not connected
    stop("error: nothing is listening on 127.0.0.1:{port}")
}

func check_the_write(sent: Boolean) {
    fallback not sent
    stop_on_a_closed_connection()
}

func check_the_answer(answered: String?) {
    fallback not answered
    stop_on_a_closed_connection()
}

func stop_on_a_closed_connection() {
    stop("error: the program on the port closed the connection")
}

func stop(text: String) {
    console.error(text)
    program.exit(1)
}

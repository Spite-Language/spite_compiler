var console = Console()
var program = Program()
var _largest_port = 65535

# ../../../../spite_documentation/repl.md#remote---repl-port
func check(port: Integer) {
    fallback port < 1 or port > _largest_port
    console.error("error: --connect takes a port number from 1 to 65535: spite --connect=4000")
    program.exit(1)
}

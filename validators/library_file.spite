var folders = ["/library/common/", "/library/windows/", "/library/linux/", "/library/mac/"]

func holds(path: String): Boolean {
    var written = path.replace("\\", "/")
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if written.contains(folder) {
            return true
        }
        index = index + 1
    }
    return false
}

var program = Program()

func check(written: String, named_in: String, line: Integer) {
    var forward = written.replace("\\", "/")
    assert is_absolute(forward)
    var loading_folder = absolute_folder_of(named_in)
    var target = normalized(forward)
    var relative = relative_path(loading_folder, target)
    if relative.is_empty() {
        refuse(
            named_in,
            line,
            "'load \"{written}\"' names an absolute path, and a load is relative to the folder of the file it is written in: '{target}' is on another drive than '{loading_folder}', so move it beside the program and load it by a relative path",
        )
    }
    refuse(
        named_in,
        line,
        "'load \"{written}\"' names an absolute path, and a load is relative to the folder of the file it is written in: write 'load \"{relative}\"'",
    )
}

func is_absolute(forward: String): Boolean {
    if forward.starts_with("/") {
        return true
    }
    var segments = forward.split("/")
    var opening = segments[0]
    crash opening
    return is_a_drive(opening)
}

func is_a_drive(segment: String): Boolean {
    var letters = "abcdefghijklmnopqrstuvwxyz"
    var lowered = segment.lower_case()
    var is_two_long = segment.length() == 2
    var ends_with_colon = segment.ends_with(":")
    if not is_two_long or not ends_with_colon {
        return false
    }
    var letter = lowered[0]
    if not letter {
        return false
    }
    return letters.contains(letter)
}

func absolute_folder_of(path: String): String {
    var forward = path.replace("\\", "/")
    var segments = forward.split("/")
    segments.remove_last()
    var folder = segments.join("/")
    if is_absolute(folder) {
        return normalized(folder)
    }
    var working = program.working_directory()
    var forward_working = working.replace("\\", "/")
    var joined = "{forward_working}/{folder}"
    return normalized(joined)
}

func normalized(forward: String): String {
    var segments = forward.split("/")
    var kept = List<String>()
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        keep_a_segment(kept, segment, index)
        index = index + 1
    }
    return kept.join("/")
}

func keep_a_segment(kept: List<String>, segment: String, index: Integer) {
    if index == 0 {
        kept.append(segment)
        return
    }
    assert not segment.is_empty() and segment != "."
    if segment == ".." and kept.count() > 1 {
        kept.remove_last()
        return
    }
    kept.append(segment)
}

func relative_path(from_folder: String, target: String): String {
    var from_segments = from_folder.split("/")
    var target_segments = target.split("/")
    var shared = shared_count(from_segments, target_segments)
    if shared == 0 {
        return ""
    }
    var pieces = List<String>()
    var climbing = from_segments.count() - shared
    while climbing > 0 {
        pieces.append("..")
        climbing = climbing - 1
    }
    var index = shared
    while index < target_segments.count() {
        var piece = target_segments[index]
        pieces.append(piece)
        index = index + 1
    }
    if pieces.is_empty() {
        return "."
    }
    return pieces.join("/")
}

func shared_count(first_segments: List<String>, second_segments: List<String>): Integer {
    var index = 0
    while index < first_segments.count() and index < second_segments.count() {
        var first_segment = first_segments[index]
        var second_segment = second_segments[index]
        var first_lowered = first_segment.lower_case()
        var second_lowered = second_segment.lower_case()
        if first_lowered != second_lowered {
            return index
        }
        index = index + 1
    }
    return index
}

func refuse(where: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(where, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

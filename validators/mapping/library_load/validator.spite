var reader = Mapping.LoadReader()
var standard_library = Mapping.StandardLibrary()

# ../../../../spite_documentation/programs.md#the-standard-library-needs-no-load
func check(loaded: Mapping.LibraryLoad, loaded_from: String, line: Integer): Validators.Answer {
    var answer = Validators.Answer()
    if is_the_library_in_use(loaded.folder) {
        answer.fix = "remove the load"
        return answer
    }
    fallback not loaded.other_library.is_empty()
    var problem = Diagnostics.Problem(
        loaded_from,
        line,
        "'load \"{loaded.written}\"' loads the standard library at '{loaded.other_library}', and a program does not load the standard library: every program has one. To compile with that one, remove this load and give --standard-library-path={loaded.other_library}",
    )
    answer.mistakes.append(problem)
    return answer
}

# ../../../../spite_documentation/programs.md#the-standard-library-needs-no-load
func check_a_load(
    symbols: Symbols.SymbolTable,
    walk: AbstractSyntaxTree.Walk.Walk,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
): Validators.Answer {
    var answer = Validators.Answer()
    fallback not loaded.preloads
    fallback symbols.may_fix_later(walk.file.path) and not symbols.is_library_path(walk.file.path)
    var written = reader.text_of(loaded)
    fallback written and not written.contains("@")
    var from_folder = symbols.folder_of(walk.file.path)
    var joined: Path? = "{from_folder}/{written}"
    fallback joined
    var folder = joined.to_string()
    if is_the_library_in_use(folder) {
        answer.fix = "remove the load"
    }
    return answer
}

# ../../../../spite_documentation/programs.md#the-standard-library-needs-no-load
func check_the_constructor_left(walk: AbstractSyntaxTree.Walk.Walk): Validators.Answer {
    var answer = Validators.Answer()
    var class_name = walk.file.class_name()
    var index = 0
    while index < walk.file.declarations.count() {
        var declaration = walk.file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration and is_empty_constructor(declaration, class_name) {
            answer.fix = "remove the constructor the load leaves empty"
        }
        index = index + 1
    }
    return answer
}

func is_empty_constructor(
    function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    class_name: String,
): Boolean {
    fallback function.body and function.is_a_constructor_of(class_name)
    return function.body.statements.is_empty()
}

func is_the_library_in_use(folder: String): Boolean {
    return standard_library.holds(folder) or folder == standard_library.folder
}

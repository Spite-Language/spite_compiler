var library = Mapping.LibraryFile()
var reader = Mapping.LoadReader()

# ../../../../spite_documentation/programs.md#how-a-program-is-loaded
func check(symbols: Symbols.SymbolTable): Validators.Answer {
    fallback not symbols.map.loads_a_platform()
    var index = 0
    while index < symbols.load_folders.count() {
        var folder = symbols.load_folders[index]
        if symbols.map.is_the_library_common(folder) {
            return mistake_at(symbols, index)
        }
        index = index + 1
    }
    return Validators.Answer()
}

func mistake_at(symbols: Symbols.SymbolTable, index: Integer): Validators.Answer {
    var written = symbols.load_texts[index]
    var loaded_from = symbols.load_origins[index]
    var line = symbols.load_lines[index]
    crash written
    crash loaded_from
    crash line
    var platform = library.platform_beside(written)
    var problem = Diagnostics.Problem(
        loaded_from,
        line,
        "'load \"{written}\"' loads the library's 'common' folder alone, and a program loads its system's folder, which loads 'common' itself: write 'load \"{platform}\"'",
    )
    var answer = Validators.Answer()
    answer.mistake = problem
    return answer
}

# ../../../../spite_documentation/programs.md#how-a-program-is-loaded
func check_a_load(
    symbols: Symbols.SymbolTable,
    walk: AbstractSyntaxTree.Walk.Walk,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
): Validators.Answer {
    var answer = Validators.Answer()
    if may_load_the_platform(symbols, walk, loaded) {
        answer.fix = "load the system's folder in place of 'common'"
    }
    return answer
}

func may_load_the_platform(
    symbols: Symbols.SymbolTable,
    walk: AbstractSyntaxTree.Walk.Walk,
    loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement,
): Boolean {
    fallback not symbols.map.loads_a_platform() and symbols.may_fix_later(walk.file.path)
    var written = reader.text_of(loaded)
    fallback written and not written.contains("@")
    var from_folder = symbols.folder_of(walk.file.path)
    fallback symbols.map.is_the_library_common("{from_folder}/{written}")
    var platform = library.platform_beside(written)
    var platform_folder = "{from_folder}/{platform}"
    var index = 0
    while index < symbols.platforms_beside_common.count() {
        var finding = symbols.platforms_beside_common[index]
        if finding.place == platform_folder {
            return finding.is_done
        }
        index = index + 1
    }
    return false
}

var library = Mapping.LibraryFile()

# ../../../../spite_documentation/programs.md#how-a-program-is-loaded
func check(symbols: Symbols.SymbolTable) {
    fallback not symbols.map.loads_a_platform()
    var index = 0
    while index < symbols.load_folders.count() {
        var folder = symbols.load_folders[index]
        if symbols.map.is_the_library_common(folder) {
            refuse(symbols, index)
        }
        index = index + 1
    }
}

func refuse(symbols: Symbols.SymbolTable, index: Integer) {
    var written = symbols.load_texts[index]
    var loaded_from = symbols.load_origins[index]
    var line = symbols.load_lines[index]
    crash written
    crash loaded_from
    crash line
    var platform = library.platform_beside(written)
    var problem = Diagnostics.Problem(
        loaded_from,
        line,
        "'load \"{written}\"' loads the library's 'common' folder alone, and a program loads its system's folder, which loads 'common' itself: write 'load \"{platform}\"'",
    )
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

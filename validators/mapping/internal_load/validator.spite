var internal = Mapping.InternalFolder()

func check(path: String, loaded_from: String, line: Integer) {
    var is_internal = internal.is_the_folder(path)
    assert is_internal
    var text = "the folder '{path}' holds the compiler's own classes, which no program loads: the compiler reads them on its own when a program needs one"
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

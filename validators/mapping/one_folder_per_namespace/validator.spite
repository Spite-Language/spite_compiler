var map = Mapping.FolderMap()

func Validator(starting_map: Mapping.FolderMap) {
    map = starting_map
}

func check_load(path: String, namespace: String, loaded_from: String, line: Integer): Validators.Answer {
    var answer = Validators.Answer()
    var overlapping = map.root_overlapping(path, loaded_from)
    if overlapping {
        var overlap = mistake(
            loaded_from,
            line,
            "'{path}' and the loaded '{overlapping.path}' lie one inside the other, so their files would be loaded twice: load only the outer folder, whose subfolders are already its namespaces",
        )
        answer.take(overlap)
    }
    var second = check_namespace(path, namespace, loaded_from, line)
    answer.take(second)
    return answer
}

func check_namespace(path: String, namespace: String, loaded_from: String, line: Integer): Validators.Answer {
    var already = map.folder_named(namespace)
    fallback already
    fallback not map.packages.same_repository(already.path, path)
    return mistake_of_a_second(already.path, path, namespace, loaded_from, line)
}

func mistake_of_a_second(
    first: String,
    second: String,
    namespace: String,
    loaded_from: String,
    line: Integer,
): Validators.Answer {
    return mistake(
        loaded_from,
        line,
        "'{first}' and '{second}' both make the namespace '{namespace}', and a namespace comes from one folder: rename one of them",
    )
}

func mistake(loaded_from: String, line: Integer, text: String): Validators.Answer {
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

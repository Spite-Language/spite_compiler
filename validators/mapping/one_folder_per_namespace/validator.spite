var map = Mapping.FolderMap()

func Validator(starting_map: Mapping.FolderMap) {
    map = starting_map
}

func check_load(path: String, namespace: String, loaded_from: String, line: Integer) {
    var overlapping = map.root_overlapping(path, loaded_from)
    if overlapping {
        refuse(
            loaded_from,
            line,
            "'{path}' and the loaded '{overlapping.path}' lie one inside the other, so their files would be loaded twice: load only the outer folder, whose subfolders are already its namespaces",
        )
    }
    check_namespace(path, namespace, loaded_from, line)
}

func check_namespace(path: String, namespace: String, loaded_from: String, line: Integer) {
    var already = map.folder_named(namespace)
    assert already
    refuse_a_second(already.path, path, namespace, loaded_from, line)
}

func refuse_a_second(first: String, second: String, namespace: String, loaded_from: String, line: Integer) {
    refuse(
        loaded_from,
        line,
        "'{first}' and '{second}' both make the namespace '{namespace}', and a namespace comes from one folder: rename one of them",
    )
}

func refuse(loaded_from: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

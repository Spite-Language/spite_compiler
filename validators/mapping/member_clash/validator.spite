var answer = Validators.Answer()

# ../../../../spite_documentation/classes_and_files.md#a-folder-is-a-class
func check(map: Mapping.FolderMap, symbols: Symbols.SymbolTable): Validators.Answer {
    answer = Validators.Answer()
    var keys = map.folders_by_namespace.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if symbols.is_a_folder_class(key) {
            check_a_class(map, symbols, key)
        }
        index = index + 1
    }
    return answer
}

func check_a_class(map: Mapping.FolderMap, symbols: Symbols.SymbolTable, key: String) {
    var files = map.class_files_of(key)
    var index = 0
    while index < files.count() {
        var class_file = files[index]
        var tree = symbols.files[class_file.path]
        if tree {
            check_a_file(map, tree, key)
        }
        index = index + 1
    }
}

func check_a_file(map: Mapping.FolderMap, tree: AbstractSyntaxTree.Shapes.SourceFile, key: String) {
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        var kind = kind_of(declaration)
        if not kind.is_empty() {
            var name = name_of(declaration)
            var nested = map.class_named("{key}.{name}")
            if nested {
                var line = line_of(declaration)
                add_a_clash(tree, key, kind, name, nested, line)
            }
        }
        index = index + 1
    }
}

func add_a_clash(
    tree: AbstractSyntaxTree.Shapes.SourceFile,
    key: String,
    kind: String,
    name: String,
    nested: Mapping.ClassFile,
    line: Integer,
) {
    var text = "'{key}.{name}' is both the {kind} '{name}' this class declares and the class of '{nested.path}': a class holds one member of each name, so rename one of them"
    var problem = Diagnostics.Problem(tree.path, line, text)
    problem.class_name = key
    answer.mistakes.append(problem)
}

func kind_of(declaration: SpiteCompiler.Declaration): String {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return "enum"
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return "union"
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return "type"
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return ""
    }
}

func name_of(declaration: SpiteCompiler.Declaration): String {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return declaration.name
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return declaration.name
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return declaration.name
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return ""
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return ""
    }
}

func line_of(declaration: SpiteCompiler.Declaration): Integer {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return declaration.line
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return declaration.line
    }
}

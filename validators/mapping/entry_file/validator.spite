func check(folder: String, file_name: String, found: Mapping.ClassFile?): Validators.Answer {
    fallback not found
    var text = "'{folder}' holds no program: a program is a folder holding an entry file named after it, '{folder}/{file_name}.spite'"
    var problem = Diagnostics.Problem("", 0, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

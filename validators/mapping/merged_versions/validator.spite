var packages = Mapping.Packages()

# ../../../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func refuse(disagreement: Symbols.Disagreement) {
    var earlier_commit = commit_of(disagreement.earlier_path)
    var later_commit = commit_of(disagreement.later_path)
    var declaration = "{disagreement.class_name}.{disagreement.name}"
    var earlier = "{disagreement.earlier_path}:{disagreement.earlier_line}"
    var later = "{disagreement.later_path}:{disagreement.later_line}"
    var text = "'{declaration}' is declared one way by {earlier_commit} and another by {later_commit}, two commits of one repository this program loads as one library ({earlier} and {later}): pin commits that agree, or declare it in the program's own files, which win"
    var problem = Diagnostics.Problem(disagreement.later_path, disagreement.later_line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func commit_of(path: String): String {
    var package = packages.package_of(path)
    var segments = package.split("/")
    var commit = segments.last()
    crash commit
    var shortest = 7
    var short = commit.slice(0, shortest)
    crash short
    return short
}

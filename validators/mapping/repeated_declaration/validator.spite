# ../../../../spite_documentation/classes_and_files.md#a-union-or-type-two-classes-declare
func check(repeat: Symbols.RepeatedDeclaration) {
    fallback repeat.stays != 'moves'
    var first = repeat.trees[0]
    crash first
    var table_line = line_in(repeat)
    var classes = listed(repeat)
    var text = text_of(repeat, classes)
    var failure = Diagnostics.Failure()
    failure.stop_at(first.path, table_line, first.namespace, text)
}

func line_in(repeat: Symbols.RepeatedDeclaration): Integer {
    var first = repeat.declarations[0]
    crash first
    switch first {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return first.line
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return first.line
    }
}

func listed(repeat: Symbols.RepeatedDeclaration): String {
    var quoted = List<String>()
    var classes = repeat.class_names()
    var index = 0
    while index < classes.count() {
        var name = classes[index]
        quoted.append("'{name}'")
        index = index + 1
    }
    var last_quoted = quoted.remove_last()
    crash last_quoted
    var first_ones = quoted.join(", ")
    return "{first_ones} and {last_quoted}"
}

func text_of(repeat: Symbols.RepeatedDeclaration, classes: String): String {
    var repeated = "'{repeat.kind} {repeat.name}' is declared with the same content by {classes}"
    var entry = "their namespace's entry class '{repeat.entry_namespace}'"
    switch repeat.stays {
        'moves': return ""
        'not_written': return "{repeated}, in files the compiler does not write: move it to {entry} by hand, where a class of the namespace names it through that class"
        'two_contents': return "{repeated}, and it moves to {entry}, where a '{repeat.name}' with other content moves or lives too: a class holds one of a name and a fix cannot invent a good one, so rename one of them"
        'taken_name': return "{repeated}, and it moves to {entry}, where the name '{repeat.name}' already means a class: a dotted name means one thing, so rename it"
        'generic_entry': return "{repeated}, and it moves to {entry}, which is a generic class and cannot be named without its types: rename one copy, or make that class plain"
        'captured_name': return "{repeated}, and it moves to {entry}, which has no file yet, and a new class of that name would take the name '{repeat.entry_name}' from what its namespace reaches today: rename one copy, or rename the folder"
    }
}

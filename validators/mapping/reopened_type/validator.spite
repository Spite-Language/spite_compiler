func check(
    replaced: AbstractSyntaxTree.Shapes.Declarations.Declaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.Declaration,
    path: String,
) {
    if replaced == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        check_the_attribute(replaced, replacing, path)
    }
}

func check_the_attribute(
    replaced: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.Declaration,
    path: String,
) {
    if replacing == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        compare(replaced, replacing, path)
    }
}

func compare(
    replaced: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    path: String,
) {
    var library = Validators.LibraryFile()
    assert not library.holds(path)
    var both_written = replaced.declared_type and replacing.declared_type
    var neither_written = not replaced.declared_type and not replacing.declared_type
    assert both_written or neither_written
    var first = written_type_of(replaced)
    var second = written_type_of(replacing)
    assert not first.is_empty() and not second.is_empty() and first != second
    var first_article = article_of(first)
    var second_article = article_of(second)
    var text = "'{replacing.name}' is {first_article} {first} where the class first declares it, and this reopening makes it {second_article} {second}: a reopening replaces an attribute's default, never its type, so give the new attribute a name of its own"
    var problem = Diagnostics.Problem(path, replacing.line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func written_type_of(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): String {
    if declaration.declared_type {
        var printer = Printers.Spite.TypePrinter(declaration.declared_type)
        return printer.text()
    }
    return literal_type_of(declaration.value)
}

func literal_type_of(value: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if value == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return "String"
    }
    if value == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return kind_of_a_literal(value.kind)
    }
    return ""
}

func kind_of_a_literal(kind: AbstractSyntaxTree.Tokens.TokenKind): String {
    switch kind {
        'integer_literal': return "Integer"
        'decimal_literal': return "Float"
        'keyword_true': return "Boolean"
        'keyword_false': return "Boolean"
        _: return ""
    }
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

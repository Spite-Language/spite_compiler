union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var resolver = NameResolution.Resolver(no_table)
var program = Model.ProgramModel()
var class_key = ""

# ../../../../spite_spec/specs/classes_and_files.md
func check(
    replaced: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
    path: String,
    reopened_class: String,
    starting_resolver: NameResolution.Resolver,
) {
    var library = Validators.LibraryFile()
    assert not library.holds(path)
    resolver = starting_resolver
    program = starting_resolver.program
    class_key = reopened_class
    var first_written = type_written_for(replaced)
    var second_written = type_written_for(replacing)
    assert first_written and second_written
    var first = printed(first_written)
    var second = printed(second_written)
    assert first != second
    assert not are_the_same_type(first_written, second_written, replaced.line, replacing.line)
    var first_article = article_of(first)
    var second_article = article_of(second)
    var text = "'{replacing.name}' is {first_article} {first} where the class first declares it, and this reopening makes it {second_article} {second}: a reopening replaces an attribute's default, never its type, so give the new attribute a name of its own"
    var problem = Diagnostics.Problem(path, replacing.line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

func type_written_for(
    declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration,
): Type? {
    if declaration.declared_type {
        return declaration.declared_type
    }
    var inference = NameResolution.Inference()
    var inferred = inference.written_type_of(declaration.value)
    if inferred {
        return inferred
    }
    var literal = inference.literal_type_of(declaration.value)
    assert not literal.is_empty()
    var path = List<String>()
    path.append(literal)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return AbstractSyntaxTree.Shapes.Types.NamedType(path, no_arguments)
}

func printed(written: Type): String {
    var printer = Printers.Spite.TypePrinter(written)
    return printer.text()
}

func are_the_same_type(
    first: Type,
    second: Type,
    first_line: Integer,
    second_line: Integer,
): Boolean {
    var model = program.class_named(class_key)
    if not model {
        return false
    }
    var first_type = resolver.type_in(first, model, first_line)
    var second_type = resolver.type_in(second, model, second_line)
    return first_type.is_the_same_as(second_type)
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

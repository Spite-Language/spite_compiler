var loaded_from = ""
var line = 0
var written = ""
var place = GitPath()
var repository = ""
var commit = ""

func check(
    starting_written: String,
    folder: CommandLine.Attempt,
    starting_loaded_from: String,
    starting_line: Integer,
) {
    written = starting_written
    loaded_from = starting_loaded_from
    line = starting_line
    place.read(written)
    if not written.contains("@") {
        check_an_unpinned_load(folder)
        return
    }
    repository = place.repository
    commit = place.commit
    check_the_repository()
    check_the_commit()
    check_the_folder()
}

func check_for_git(version: Mapping.GitRun) {
    fallback version.code != 0
    refuse("'load \"{written}\"' fetches {repository} with git, and there is no 'git' on the PATH")
}

func check_a_missing_repository(finding: CommandLine.Attempt) {
    fallback not finding.is_done
    refuse("'load \"{written}\"' names the repository '{repository}', and there is no folder '{repository}'")
}

func check_a_folder_that_is_no_repository(asked: Mapping.GitRun) {
    fallback asked.code != 0
    refuse("'load \"{written}\"' names the folder '{repository}', which is not a git repository")
}

func check_a_folder_inside_a_repository(prefix: String) {
    fallback not prefix.is_empty()
    var length = prefix.length()
    var folder = prefix
    if prefix.ends_with("/") {
        var sliced_folder = prefix.slice(0, length - 1)
        crash sliced_folder
        folder = sliced_folder
    }
    refuse(
        "'load \"{written}\"' names '{repository}', which is the folder '{folder}' inside a repository: name the repository's own folder, and the folder inside it after the commit",
    )
}

func check_an_unclonable_url(fetching: Mapping.GitRun, url: String) {
    fallback fetching.code != 0
    var lines = fetching.said.split("\n")
    var first = lines.first()
    var told = ""
    if first {
        told = first.trim()
    }
    var message = "'load \"{written}\"' fetches {url} with git, and git could not clone or fetch it"
    if not told.is_empty() {
        message = "{message}: {told}"
    }
    refuse(message)
}

func check_a_kept_file(finding: CommandLine.Attempt, copy: String) {
    fallback not finding.is_done
    refuse_a_changed_copy(finding.place, copy)
}

func check_a_changed_file(file: String, listed: String, now: String?, copy: String) {
    fallback now != listed
    refuse_a_changed_copy(file, copy)
}

func check_an_added_file(name: String, kept: List<String>, copy: String) {
    fallback not kept.contains(name)
    refuse_a_changed_copy("{copy}/{name}", copy)
}

func refuse_a_changed_copy(file: String, copy: String) {
    refuse(
        "'{file}' is not what the commit {commit} of {repository} holds: a checkout is read-only, so a pinned commit never changes. Delete the folder '{copy}' to fetch it again",
    )
}

func check_a_missing_commit(found: String?) {
    fallback not found
    refuse("'load \"{written}\"' pins '{commit}', and {repository} has no commit {commit}")
}

func check_a_commit_named_otherwise(found: String) {
    fallback not found.starts_with(commit)
    refuse(
        "'load \"{written}\"' pins '{commit}', which names the commit {found}, not one starting with '{commit}': a branch or a tag moves, and a pin must not",
    )
}

# ../../../../spite_documentation/packages.md
func check_a_path_in_a_fetched_copy(origin: String) {
    fallback origin.is_empty()
    refuse(
        "'load \"{written}\"' is written in a package fetched from a URL, and names a repository by a path on this machine",
    )
}

func check_a_step_of_the_copy(code: Integer?, copy: String) {
    fallback code != 0
    refuse_an_unwritten_copy(copy)
}

func check_a_written_copy(writing: CommandLine.Attempt) {
    fallback not writing.is_done
    refuse_an_unwritten_copy(writing.place)
}

func check_the_lock(held: LockedFile?, copy: String) {
    fallback not held
    refuse_an_unwritten_copy(copy)
}

func check_the_folder_path(folder_path: Path?, folder: String) {
    fallback not folder_path
    refuse_an_unwritten_copy(folder)
}

func refuse_an_unwritten_copy(copy: String) {
    refuse("'load \"{written}\"' could not write the files of {repository}@{commit} into '{copy}'")
}

func check_an_unpinned_load(folder: CommandLine.Attempt) {
    fallback place.is_remote
    fallback not folder.is_done
    refuse(
        "'load \"{written}\"' names a repository without its commit, and a load from a repository is pinned: write its commit after the repository, like 'load \"{written}@a3f2c91\"'",
    )
}

func check_the_repository() {
    fallback not place.has_a_repository
    refuse(
        "'load \"{written}\"' names no repository: '{repository}' is neither a URL nor a path starting with ./, ../, / or a drive letter: write 'load \"github.com/example/engine@a3f2c91\"' or 'load \"../engine@a3f2c91\"'",
    )
}

func check_the_commit() {
    fallback not place.has_a_commit
    refuse("'load \"{written}\"' pins '{commit}', which is not a commit: a branch or a tag moves, and a pin must not")
}

func check_the_folder() {
    fallback not place.stays_inside
    refuse("'load \"{written}\"' names the folder '{place.folder}', which is not inside the repository")
}

func refuse(text: String) {
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

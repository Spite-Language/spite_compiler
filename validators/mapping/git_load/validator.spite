var loaded_from = ""
var line = 0
var written = ""
var url_openings = ["https://", "http://", "ssh://", "git://", "file://"]
var local_openings = ["./", "../", "/", "\\"]
var digits = "0123456789abcdef"
var shortest_commit = 7
var longest_commit = 40

func check(starting_written: String, folder: String, starting_loaded_from: String, starting_line: Integer) {
    written = starting_written
    loaded_from = starting_loaded_from
    line = starting_line
    var at_sign = last_at_sign()
    if at_sign < 0 {
        check_an_unpinned_load(folder)
        return
    }
    var written_length = written.length()
    var repository = written.slice(0, at_sign)
    var pinned = written.slice(at_sign + 1, written_length)
    var commit = pinned
    var inside = ""
    var slash = pinned.index_of("/")
    if slash >= 0 {
        var pinned_length = pinned.length()
        commit = pinned.slice(0, slash)
        inside = pinned.slice(slash + 1, pinned_length)
    }
    check_the_repository(repository)
    check_the_commit(commit)
    check_the_folder(inside)
    refuse(
        "'load \"{written}\"' loads the repository '{repository}' at the commit '{commit}', and this compiler does not fetch repositories yet: load a folder on this machine instead",
    )
}

func last_at_sign(): Integer {
    var found = -1
    var index = 0
    while index < written.length() {
        var character = written.character_at(index)
        if character == "@" {
            found = index
        }
        index = index + 1
    }
    return found
}

func check_an_unpinned_load(folder: String) {
    assert names_a_repository(written)
    var directory = Directory(folder)
    assert not directory.exists()
    refuse(
        "'load \"{written}\"' names a repository without its commit, and a load from a repository is pinned: write its commit after the repository, like 'load \"{written}@a3f2c91\"'",
    )
}

func check_the_repository(repository: String) {
    assert not is_local(repository) and not names_a_repository(repository)
    refuse(
        "'load \"{written}\"' names no repository: '{repository}' is neither a URL nor a path starting with ./, ../, / or a drive letter: write 'load \"github.com/example/engine@a3f2c91\"' or 'load \"../engine@a3f2c91\"'",
    )
}

func check_the_commit(commit: String) {
    assert not is_a_commit(commit)
    refuse("'load \"{written}\"' pins '{commit}', which is not a commit: a branch or a tag moves, and a pin must not")
}

func check_the_folder(inside: String) {
    var leaves = inside.starts_with("..") or inside.starts_with("/") or inside.starts_with("\\") or has_a_drive(inside)
    assert leaves
    refuse("'load \"{written}\"' names the folder '{inside}', which is not inside the repository")
}

func is_local(repository: String): Boolean {
    var index = 0
    while index < local_openings.count() {
        var opening = local_openings[index]
        if repository.starts_with(opening) {
            return true
        }
        index = index + 1
    }
    return has_a_drive(repository)
}

func has_a_drive(text: String): Boolean {
    if text.length() < 2 {
        return false
    }
    var second = text.character_at(1)
    return second == ":"
}

func names_a_repository(text: String): Boolean {
    var index = 0
    while index < url_openings.count() {
        var opening = url_openings[index]
        if text.starts_with(opening) {
            return true
        }
        index = index + 1
    }
    var segments = text.split("/")
    var first = segments[0]
    crash first
    return first.contains(".") and not first.starts_with(".")
}

func is_a_commit(commit: String): Boolean {
    var length = commit.length()
    if length < shortest_commit or length > longest_commit {
        return false
    }
    var index = 0
    while index < length {
        var character = commit.character_at(index)
        if not digits.contains(character) {
            return false
        }
        index = index + 1
    }
    return true
}

func refuse(text: String) {
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

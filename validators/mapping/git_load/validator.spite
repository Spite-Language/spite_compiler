var loaded_from = ""
var line = 0
var written = ""
var place = GitPath()
var repository = ""
var commit = ""

func check(
    starting_written: String,
    folder: CommandLine.Attempt,
    starting_loaded_from: String,
    starting_line: Integer,
): Validators.Answer {
    written = starting_written
    loaded_from = starting_loaded_from
    line = starting_line
    place.read(written)
    if not written.contains("@") {
        return check_an_unpinned_load(folder)
    }
    repository = place.repository
    commit = place.commit
    var answer = check_the_repository()
    var commit_answer = check_the_commit()
    answer.take(commit_answer)
    var folder_answer = check_the_folder()
    answer.take(folder_answer)
    return answer
}

func check_for_git(version: Mapping.GitRun): Validators.Answer {
    fallback version.code != 0
    return mistake("'load \"{written}\"' fetches {repository} with git, and there is no 'git' on the PATH")
}

func check_a_missing_repository(finding: CommandLine.Attempt): Validators.Answer {
    fallback not finding.is_done
    return mistake("'load \"{written}\"' names the repository '{repository}', and there is no folder '{repository}'")
}

func check_a_folder_that_is_no_repository(asked: Mapping.GitRun): Validators.Answer {
    fallback asked.code != 0
    return mistake("'load \"{written}\"' names the folder '{repository}', which is not a git repository")
}

func check_a_folder_inside_a_repository(prefix: String): Validators.Answer {
    fallback not prefix.is_empty()
    var length = prefix.length()
    var folder = prefix
    if prefix.ends_with("/") {
        var sliced_folder = prefix.slice(0, length - 1)
        crash sliced_folder
        folder = sliced_folder
    }
    return mistake(
        "'load \"{written}\"' names '{repository}', which is the folder '{folder}' inside a repository: name the repository's own folder, and the folder inside it after the commit",
    )
}

func check_an_unclonable_url(fetching: Mapping.GitRun, url: String): Validators.Answer {
    fallback fetching.code != 0
    var lines = fetching.said.split("\n")
    var first = lines.first()
    var told = ""
    if first {
        told = first.trim()
    }
    var message = "'load \"{written}\"' fetches {url} with git, and git could not clone or fetch it"
    if not told.is_empty() {
        message = "{message}: {told}"
    }
    return mistake(message)
}

func check_a_kept_file(finding: CommandLine.Attempt, copy: String): Validators.Answer {
    fallback not finding.is_done
    return changed_copy_mistake(finding.place, copy)
}

func check_a_changed_file(file: String, listed: String, now: String?, copy: String): Validators.Answer {
    fallback now != listed
    return changed_copy_mistake(file, copy)
}

func check_an_added_file(name: String, kept: List<String>, copy: String): Validators.Answer {
    fallback not kept.contains(name)
    return changed_copy_mistake("{copy}/{name}", copy)
}

func changed_copy_mistake(file: String, copy: String): Validators.Answer {
    return mistake(
        "'{file}' is not what the commit {commit} of {repository} holds: a checkout is read-only, so a pinned commit never changes. Delete the folder '{copy}' to fetch it again",
    )
}

func check_a_missing_commit(found: String?): Validators.Answer {
    fallback not found
    return mistake("'load \"{written}\"' pins '{commit}', and {repository} has no commit {commit}")
}

func check_a_commit_named_otherwise(found: String): Validators.Answer {
    fallback not found.starts_with(commit)
    return mistake(
        "'load \"{written}\"' pins '{commit}', which names the commit {found}, not one starting with '{commit}': a branch or a tag moves, and a pin must not",
    )
}

# ../../../../spite_documentation/packages.md
func check_a_path_in_a_fetched_copy(origin: String): Validators.Answer {
    fallback origin.is_empty()
    return mistake(
        "'load \"{written}\"' is written in a package fetched from a URL, and names a repository by a path on this machine",
    )
}

func check_a_step_of_the_copy(code: Integer?, copy: String): Validators.Answer {
    fallback code != 0
    return unwritten_copy_mistake(copy)
}

func check_a_written_copy(writing: CommandLine.Attempt): Validators.Answer {
    fallback not writing.is_done
    return unwritten_copy_mistake(writing.place)
}

func check_the_lock(held: LockedFile?, copy: String): Validators.Answer {
    fallback not held
    return unwritten_copy_mistake(copy)
}

func check_the_folder_path(folder_path: Path?, folder: String): Validators.Answer {
    fallback not folder_path
    return unwritten_copy_mistake(folder)
}

func unwritten_copy_mistake(copy: String): Validators.Answer {
    return mistake("'load \"{written}\"' could not write the files of {repository}@{commit} into '{copy}'")
}

func check_an_unpinned_load(folder: CommandLine.Attempt): Validators.Answer {
    fallback place.is_remote
    fallback not folder.is_done
    return mistake(
        "'load \"{written}\"' names a repository without its commit, and a load from a repository is pinned: write its commit after the repository, like 'load \"{written}@a3f2c91\"'",
    )
}

func check_the_repository(): Validators.Answer {
    fallback not place.has_a_repository
    return mistake(
        "'load \"{written}\"' names no repository: '{repository}' is neither a URL nor a path starting with ./, ../, / or a drive letter: write 'load \"github.com/example/engine@a3f2c91\"' or 'load \"../engine@a3f2c91\"'",
    )
}

func check_the_commit(): Validators.Answer {
    fallback not place.has_a_commit
    return mistake(
        "'load \"{written}\"' pins '{commit}', which is not a commit: a branch or a tag moves, and a pin must not",
    )
}

func check_the_folder(): Validators.Answer {
    fallback not place.stays_inside
    return mistake("'load \"{written}\"' names the folder '{place.folder}', which is not inside the repository")
}

func mistake(text: String): Validators.Answer {
    var problem = Diagnostics.Problem(loaded_from, line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

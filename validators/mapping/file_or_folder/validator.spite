func check(folder: Mapping.MappedFolder, simple_name: String): Validators.Answer {
    var same_file = folder.file_named(simple_name)
    var same_folder = folder.folder_named(simple_name)
    fallback same_file or same_folder
    var text = "'{simple_name}' is written twice in '{folder.path}', as two files or as a file and a folder, and a dotted name means one thing: rename one of them"
    var problem = Diagnostics.Problem(folder.path, 0, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func check_file(folder: Mapping.MappedFolder, simple_name: String, path: String, namespace: String): Validators.Answer {
    var answer = Validators.Answer()
    var same_folder = folder.folder_named(simple_name)
    if same_folder {
        var text = "'{namespace}' is this class and also the namespace of the folder '{same_folder.path}': a dotted name means one thing, so rename the file or the folder"
        var problem = Diagnostics.Problem(path, 0, text)
        answer.mistakes.append(problem)
    }
    var twice = check(folder, simple_name)
    answer.take(twice)
    return answer
}

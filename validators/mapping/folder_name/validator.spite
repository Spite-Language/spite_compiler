var names = Mapping.Names()

func check(path: String, folder_name: String, named_in: String, line: Integer) {
    var where = named_in
    if where.is_empty() {
        where = path
    }
    if folder_name == "spite" {
        refuse(where, line, "'spite' is reserved for the built-in Spite namespace: name the folder something else")
    }
    check_snake_case(where, folder_name, line)
}

func check_the_path(written: String, named_in: String, line: Integer) {
    var segments = written.replace("\\", "/").split("/")
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if names_a_folder(segment, index) {
            check_snake_case(named_in, segment, line)
        }
        index = index + 1
    }
}

func names_a_folder(segment: String, index: Integer): Boolean {
    var is_a_step = segment.is_empty() or segment == "." or segment == ".."
    var is_a_drive = index == 0 and segment.ends_with(":")
    return not is_a_step and not is_a_drive
}

func check_snake_case(where: String, folder_name: String, line: Integer) {
    assert not names.written_in_snake_case(folder_name)
    var renamed = names.snake_case_of(folder_name)
    refuse(
        where,
        line,
        "the folder '{folder_name}' is not named in snake_case: every folder is lowercase words joined by '_', so rename it '{renamed}'",
    )
}

func refuse(where: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(where, line, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

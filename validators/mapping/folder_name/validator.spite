var names = Mapping.Names()

func check(path: String, folder_name: String, named_in: String, line: Integer) {
    var where = named_in
    if where.is_empty() {
        where = path
    }
    if folder_name == "spite" {
        refuse(where, line, "'spite' is reserved for the built-in Spite namespace: name the folder something else")
    }
    check_snake_case(where, folder_name, line)
}

func check_the_path(written: String, named_in: String, line: Integer) {
    var segments = written.replace("\\", "/").split("/")
    var index = segments.count() - 1
    while index >= 0 {
        var segment = segments[index]
        crash segment
        if names_a_folder(segment) {
            check_snake_case(named_in, segment, line)
            return
        }
        index = index - 1
    }
}

func names_a_folder(segment: String): Boolean {
    var is_a_step = segment.is_empty() or segment == "." or segment == ".."
    return not is_a_step
}

func check_snake_case(where: String, folder_name: String, line: Integer) {
    var answer = check_the_spelling(where, folder_name, line)
    answer.tell()
}

# ../../../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func check_the_spelling(where: String, folder_name: String, line: Integer): Validators.Answer {
    var answer = Validators.Answer()
    if names.written_in_snake_case(folder_name) {
        return answer
    }
    var renamed = names.suggested_snake_case(folder_name)
    var rule = "the folder '{folder_name}' is not named in snake_case: every folder is lowercase words joined by '_'"
    var text = "{rule}, so give it a name that starts with a lowercase letter"
    if names.written_in_snake_case(renamed) {
        text = "{rule}, so rename it '{renamed}'"
    }
    answer.mistake = Diagnostics.Problem(where, line, text)
    return answer
}

func refuse(where: String, line: Integer, text: String) {
    var problem = Diagnostics.Problem(where, line, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

# ../../../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func refuse_a_reopening(path: String, namespace: String, listing: String) {
    var text = "'{namespace}' is a class only versions of a repository hold, and the package of this file pins none of them, so it cannot reopen one: {listing}"
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

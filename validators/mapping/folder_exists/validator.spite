func check(path: String, loaded_from: String, line: Integer) {
    var folder_path: Path? = path
    crash folder_path
    var directory = Directory(folder_path)
    fallback not directory.exists()
    var problem = Diagnostics.Problem(loaded_from, line, "the folder '{path}' does not exist")
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

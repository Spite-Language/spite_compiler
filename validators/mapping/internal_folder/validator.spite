func check(internal: Mapping.InternalFolder) {
    assert not internal.is_found()
    var text = "the compiler's own classes are not beside it: it looks for them in '{internal.beside}' and then in '{internal.above}', and neither folder exists, so put the 'internal' folder that comes with the compiler back beside it"
    var problem = Diagnostics.Problem("", 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

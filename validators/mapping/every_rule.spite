# ../../ARCHITECTURE.md#validators
func check(map: Mapping.FolderMap, entry: Mapping.ClassFile, symbols: Symbols.SymbolTable) {
    var misnamed = Validators.Mapping.MisnamedPath.Validator()
    var index = 0
    while index < map.misnamed.count() {
        var renaming = map.misnamed[index]
        var answer = misnamed.check(renaming, symbols)
        answer.tell()
        index = index + 1
    }
    var platform = Validators.Mapping.PlatformLoad.Validator()
    platform.check(symbols)
    var class_names = Validators.Mapping.ClassNames.Validator(map)
    class_names.check(entry, symbols)
    var repeated = Validators.Mapping.RepeatedDeclaration.Validator()
    symbols.repeated_declarations.each(repeated.check)
}

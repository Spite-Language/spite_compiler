var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var resolver = NameResolution.Resolver(no_table)
var library = Mapping.LibraryFile()
var standard_library = Mapping.StandardLibrary()
var class_key = ""

# ../../../../spite_documentation/classes_and_files.md#reopening-a-class
func check(
    replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    reopened_class: String,
    starting_resolver: NameResolution.Resolver,
): Validators.Answer {
    fallback not library.holds(replacing.path)
    resolver = starting_resolver
    class_key = reopened_class
    fallback not answers_alike(replaced, replacing)
    var first = answer_shown(replaced)
    var second = answer_shown(replacing)
    var declared = place_in_the_library(replaced)
    var text = "'{replacing.name}' answers {first} where the class first declares it{declared}, and this reopening makes it answer {second}: a reopening replaces a function's body, never what it answers, so give the new function a name of its own"
    var problem = Diagnostics.Problem(replacing.path, replacing.line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func answers_alike(
    replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    if not replaced.result or not replacing.result {
        return not replaced.result and not replacing.result
    }
    var first_printer = Printers.Spite.TypePrinter(replaced.result)
    var second_printer = Printers.Spite.TypePrinter(replacing.result)
    if first_printer.text() == second_printer.text() {
        return true
    }
    var program = resolver.state.program
    var model = program.class_named(class_key)
    fallback model
    var first_type = resolver.types.type_in(replaced.result, model, replaced.line)
    var second_type = resolver.types.type_in(replacing.result, model, replacing.line)
    return first_type.is_the_same_as(second_type)
}

func answer_shown(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    if not function.result {
        return "nothing"
    }
    var printer = Printers.Spite.TypePrinter(function.result)
    var shown = printer.text()
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an {shown}"
    }
    return "a {shown}"
}

func place_in_the_library(replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    fallback library.holds(replaced.path)
    var shown = standard_library.shown(replaced.path)
    return ", at {shown}:{replaced.line}"
}

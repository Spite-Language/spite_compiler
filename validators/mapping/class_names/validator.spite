var map = Mapping.FolderMap()
var library = Validators.LibraryFile()
var names = Mapping.Names()
var no_folders = Mapping.FolderMap()
var table = Symbols.SymbolTable(no_folders)

func Validator(starting_map: Mapping.FolderMap) {
    map = starting_map
}

func check(entry: Mapping.ClassFile, symbols: Symbols.SymbolTable) {
    table = symbols
    var every = map.every_class()
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        var is_unchosen = table.is_unchosen(class_file.path)
        if not is_unchosen and not library.holds(class_file.path) {
            check_a_class(class_file, entry)
        }
        index = index + 1
    }
    var namespaces = map.folders_by_namespace.keys()
    namespaces.each(check_a_folder)
    map.roots.each(check_the_prefixes_below)
}

func check_the_prefixes_below(root: Mapping.MappedFolder) {
    var folder_path = "{root.path}/"
    fallback not library.holds(folder_path)
    var index = 0
    while index < root.folders.count() {
        var inner = root.folders[index]
        var inner_name = folder_name_of(inner)
        check_the_prefixes(inner, "{inner_name}/")
        index = index + 1
    }
}

func check_the_prefixes(folder: Mapping.MappedFolder, relative: String) {
    var words = List<String>()
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var word = first_word_of(file.simple_name)
        if not words.contains(word) and not is_the_folders_own(folder, file) {
            words.append(word)
        }
        index = index + 1
    }
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        check_a_prefix(folder, relative, word)
        word_index = word_index + 1
    }
    var inner_index = 0
    while inner_index < folder.folders.count() {
        var inner = folder.folders[inner_index]
        var inner_name = folder_name_of(inner)
        check_the_prefixes(inner, "{relative}{inner_name}/")
        inner_index = inner_index + 1
    }
}

func check_a_prefix(folder: Mapping.MappedFolder, relative: String, word: String) {
    var sharing = List<Mapping.ClassFile>()
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var first = first_word_of(file.simple_name)
        if first == word and not is_the_folders_own(folder, file) {
            sharing.append(file)
        }
        index = index + 1
    }
    fallback sharing.count() >= 3
    var quoted = List<String>()
    var renamed = List<String>()
    var shown_index = 0
    while shown_index < 3 {
        var file = sharing[shown_index]
        crash file
        quoted.append("'{file.simple_name}'")
        var length = file.simple_name.length()
        var start = word.length()
        var rest = file.simple_name.slice(start, length)
        crash rest
        if not rest.is_empty() {
            renamed.append("'{rest}'")
        }
        shown_index = shown_index + 1
    }
    var last = quoted.remove_last()
    crash last
    var joined = quoted.join(", ")
    var named = "{joined} and {last}"
    var more = sharing.count() - 3
    if more > 0 {
        named = "{named} (and {more} more)"
    }
    var first_file = sharing.first()
    crash first_file
    var lowered = word.lower_case()
    var new_names = renamed.join(", ")
    refuse(
        first_file.path,
        "{named} in '{relative}' all start with '{word}': a word every name repeats is a namespace, so move them into the folder '{relative}{lowered}/' and name them {new_names}",
    )
}

func is_the_folders_own(folder: Mapping.MappedFolder, file: Mapping.ClassFile): Boolean {
    var segment = folder_name_of(folder)
    var own = names.of_folder(segment)
    return file.simple_name == own
}

func folder_name_of(folder: Mapping.MappedFolder): String {
    var parts = folder.path.split("/")
    var last = parts.last()
    crash last
    return last
}

func first_word_of(name: String): String {
    var length = name.length()
    var index = 1
    while index < length {
        var code = name.byte_at(index)
        var is_an_upper = code >= 65 and code <= 90
        if is_an_upper {
            var sliced = name.slice(0, index)
            crash sliced
            return sliced
        }
        index = index + 1
    }
    return name
}

func check_a_class(class_file: Mapping.ClassFile, entry: Mapping.ClassFile) {
    var is_another_entry = class_file.namespace == entry.namespace and class_file.path != entry.path
    if is_another_entry {
        refuse(
            class_file.path,
            "'{entry.namespace}' is the program's entry class ({entry.path}), so no other file may be a class of that name: rename this file, or the program's folder and its entry file",
        )
    }
    check_the_spite_namespace(class_file)
    check_the_library_names(class_file)
    check_hidden(class_file)
}

func check_the_spite_namespace(class_file: Mapping.ClassFile) {
    var versions = map.versions
    var namespace = versions.unversioned(class_file.namespace)
    if namespace.starts_with("Spite.Internal.") {
        refuse(
            class_file.path,
            "{namespace} is internal to Spite and cannot be used outside the standard library: read bytes with Buffer or BinaryReader, describe foreign data with a plain type, and leave threads to the compiler",
        )
    }
    fallback namespace.starts_with("Spite.")
    fallback not is_a_library_class(namespace)
    refuse(
        class_file.path,
        "'Spite' holds the standard library's own classes, so a file in a 'spite' folder may only reopen one of them: '{namespace}' is not one, and a new class of your own belongs in a namespace of your own",
    )
}

func check_the_library_names(class_file: Mapping.ClassFile) {
    var namespace = class_file.namespace
    fallback namespace.contains(".")
    var bare = class_file.simple_name
    fallback is_a_library_class(bare)
    refuse(
        class_file.path,
        "the class '{namespace}' is named like the standard library's class '{bare}': use '{bare}', reopening it to add what it lacks, or give this class a clearer name",
    )
}

# ../../../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func check_hidden(class_file: Mapping.ClassFile) {
    var versions = map.versions
    var unversioned = versions.unversioned(class_file.namespace)
    var version = ""
    if unversioned != class_file.namespace {
        var cut = class_file.namespace.length() - unversioned.length() - 1
        var sliced = class_file.namespace.slice(0, cut)
        crash sliced
        version = sliced
    }
    var segments = unversioned.split(".")
    var start = 1
    while start < segments.count() {
        var shorter = List<String>()
        var index = start
        while index < segments.count() {
            var segment = segments[index]
            shorter.append(segment)
            index = index + 1
        }
        var hidden_name = shorter.join(".")
        var hidden = map.class_named(hidden_name)
        if hidden {
            refuse_a_hidden(class_file, hidden, segments)
        }
        var hidden_in_version = map.class_named("{version}.{hidden_name}")
        if not version.is_empty() and hidden_in_version {
            refuse_a_hidden(class_file, hidden_in_version, segments)
        }
        start = start + 1
    }
}

func refuse_a_hidden(class_file: Mapping.ClassFile, hidden: Mapping.ClassFile, segments: List<String>) {
    var enclosing = List<String>()
    var index = 0
    while index < segments.count() - 1 {
        var segment = segments[index]
        enclosing.append(segment)
        index = index + 1
    }
    var inside = enclosing.join(".")
    refuse(
        class_file.path,
        "the class '{class_file.namespace}' hides the class '{hidden.namespace}' ({hidden.path}): inside '{inside}' the name '{hidden.namespace}' would mean this class, so give one of them a clearer name",
    )
}

func check_a_folder(namespace: String) {
    var folder = map.folders_by_namespace[namespace]
    crash folder
    fallback not map.is_a_root(folder.path)
    fallback not merges_a_library_folder(folder)
    fallback is_a_library_class(namespace)
    var stranger = folder.files.first()
    var place = folder.path
    if stranger {
        place = stranger.path
    }
    refuse(
        place,
        "'{namespace}' is a class of the standard library and also the namespace of the folder '{folder.path}': a dotted name means one thing, so rename the folder",
    )
}

func merges_a_library_folder(folder: Mapping.MappedFolder): Boolean {
    var index = 0
    while index < folder.paths.count() {
        var path = folder.paths[index]
        var folder_path = "{path}/"
        if library.holds(folder_path) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_library_class(namespace: String): Boolean {
    var files = map.class_files_of(namespace)
    var index = 0
    while index < files.count() {
        var file = files[index]
        if library.holds(file.path) {
            return true
        }
        index = index + 1
    }
    return false
}

func refuse(path: String, text: String) {
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

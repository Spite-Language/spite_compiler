var url_names = ["https", "http", "ssh", "git", "file"]

# ../../../../spite_documentation/programs.md#preloaded-files
func check(preloads: Symbols.Preloads, volume: Symbols.PreloadedVolume): Validators.Answer {
    var answer = Validators.Answer()
    var name = volume.name
    var preloaded = "'preload \"{volume.written}\"' makes the volume '{name}'"
    if name.length() == 1 {
        var drive = mistake(
            volume,
            "{preloaded}, and a single letter cannot name a volume, since '{name}://' is a drive on Windows: rename the folder",
        )
        answer.take(drive)
    }
    if url_names.contains(name) {
        var url = mistake(
            volume,
            "{preloaded}, and '{name}://' opens a URL, which a path never names: rename the folder",
        )
        answer.take(url)
    }
    var known = preloads.volume_named(name)
    if known {
        var known_folder = known.folder.lower_case()
        var folder = volume.folder.lower_case()
        if known_folder != folder {
            var second = mistake(
                volume,
                "'{known.folder}' and '{volume.folder}' both make the volume '{name}', and a volume comes from one folder: rename one of them",
            )
            answer.take(second)
        }
    }
    return answer
}

func mistake(volume: Symbols.PreloadedVolume, text: String): Validators.Answer {
    var problem = Diagnostics.Problem(volume.preloaded_from, volume.line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

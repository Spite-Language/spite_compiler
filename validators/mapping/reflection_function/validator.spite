var path = ""
var class_name = ""
var reflection_names = List<String>()
var reflection_classes = [
    "Spite.Argument"
    "Spite.Attribute"
    "Spite.AttributeDeclaration"
    "Spite.Call"
    "Spite.Class"
    "Spite.Enum"
    "Spite.EnumValue"
    "Spite.Function"
    "Spite.FunctionDeclaration"
    "Spite.Namespace"
    "Spite.Type"
    "Spite.Union"
]
var answer = Validators.Answer()

# ../../../../spite_documentation/packages.md#the-spite-namespace-is-reserved
func check(walk: AbstractSyntaxTree.Walk.Walk, reopened_class: String, library_names: List<String>): Validators.Answer {
    fallback reflection_classes.contains(reopened_class)
    path = walk.file.path
    class_name = reopened_class
    reflection_names = library_names
    answer = Validators.Answer()
    walk.function_declarations.each(check_function)
    return answer
}

func check_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var getter = "get_{function.name}"
    fallback reflection_names.contains(function.name) or reflection_names.contains(getter)
    var text = "'{function.name}' is a reflection function of {class_name}, and reflection functions cannot be replaced: a reopening may add functions of its own, so give this one a name the reflection class does not have"
    var problem = Diagnostics.Problem(path, function.line, text)
    problem.class_name = class_name
    problem.function_name = function.name
    problem.is_among_the_attributes = function.name.is_empty()
    answer.mistakes.append(problem)
}

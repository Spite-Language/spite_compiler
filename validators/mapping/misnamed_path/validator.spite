# ../../../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func check(misnamed: Mapping.Misnamed) {
    fallback not misnamed.is_renamed
    if misnamed.is_folder {
        var folder_name = Validators.Mapping.FolderName.Validator()
        folder_name.check_snake_case(misnamed.path, misnamed.written, 0)
        return
    }
    var file_name = Validators.Mapping.FileName.Validator()
    file_name.check(misnamed.path, misnamed.written)
}

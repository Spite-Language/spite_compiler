var file_name = Validators.Mapping.FileName.Validator()
var folder_name = Validators.Mapping.FolderName.Validator()

# ../../../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func check(misnamed: Mapping.Misnamed, table: Symbols.SymbolTable): Validators.Answer {
    var reach = Symbols.LoadReach(table, misnamed)
    if holds_only_files_to_fix(misnamed, table) and no_load_keeps_the_name(table, reach) {
        var written = misnamed.written_entry()
        var right = misnamed.right_entry()
        var fixable = Validators.Answer()
        fixable.fix = "rename '{written}' to '{right}'"
        return fixable
    }
    if misnamed.is_folder {
        return folder_name.check_the_spelling(misnamed.path, misnamed.written, 0)
    }
    return file_name.check_the_spelling(misnamed.path, misnamed.written)
}

func holds_only_files_to_fix(misnamed: Mapping.Misnamed, table: Symbols.SymbolTable): Boolean {
    var every = table.map.every_class()
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        var is_held = class_file.path == misnamed.path or table.map.inside(class_file.path, misnamed.path)
        fallback not is_held or table.may_move(class_file.path)
        index = index + 1
    }
    return true
}

func no_load_keeps_the_name(table: Symbols.SymbolTable, reach: Symbols.LoadReach): Boolean {
    var index = 0
    while index < table.walks.count() {
        var walk = table.walks[index]
        fallback no_load_of_the_walk_keeps_it(table, walk, reach)
        index = index + 1
    }
    return true
}

func no_load_of_the_walk_keeps_it(
    table: Symbols.SymbolTable,
    walk: AbstractSyntaxTree.Walk.Walk,
    reach: Symbols.LoadReach,
): Boolean {
    var may_change = table.may_fix_later(walk.file.path)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if found.statement and found.statement.class == AbstractSyntaxTree.Shapes.Statements.LoadStatement {
            fallback not reach.blocks(walk, found.statement)
            fallback may_change or not reach.names_it(walk, found.statement)
        }
        index = index + 1
    }
    return true
}

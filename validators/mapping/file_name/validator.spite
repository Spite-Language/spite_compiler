var names = Mapping.Names()

func check(path: String, base_name: String) {
    fallback not names.written_in_snake_case(base_name)
    var renamed = names.suggested_snake_case(base_name)
    var rule = "'{base_name}.spite' is not named in snake_case: every file is lowercase words joined by '_'"
    var text = "{rule}, so give it a name that starts with a lowercase letter"
    if names.written_in_snake_case(renamed) {
        text = "{rule}, so rename it '{renamed}.spite'"
    }
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Diagnostics.Failure()
    failure.stop(problem)
}

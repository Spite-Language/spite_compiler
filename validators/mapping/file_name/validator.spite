var names = Mapping.Names()

func check(path: String, base_name: String) {
    fallback not names.written_in_snake_case(base_name)
    var renamed = names.snake_case_of(base_name)
    var text = "'{base_name}.spite' is not named in snake_case: every file is lowercase words joined by '_', so rename it '{renamed}.spite'"
    var problem = Diagnostics.Problem(path, 0, text)
    var failure = Validators.Failure()
    failure.stop(problem)
}

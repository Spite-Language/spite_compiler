var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var resolver = NameResolution.Resolver(no_table)
var library = Mapping.LibraryFile()
var standard_library = Mapping.StandardLibrary()
var class_key = ""

# ../../../../spite_documentation/classes_and_files.md#reopening-a-class
func check(
    replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    reopened_class: String,
    starting_resolver: NameResolution.Resolver,
): Validators.Answer {
    fallback not library.holds(replacing.path)
    resolver = starting_resolver
    class_key = reopened_class
    fallback not parameters_alike(replaced, replacing)
    var first = parameters_shown(replaced)
    var second = parameters_shown(replacing)
    var declared = place_in_the_library(replaced)
    var advice = advice_for(replacing)
    var text = "'{replacing.name}' takes {first} where the class first declares it{declared}, and this reopening makes it take {second}: {advice}"
    var problem = Diagnostics.Problem(replacing.path, replacing.line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

# ../../../../spite_documentation/classes_and_files.md#reopening-a-class
func check_an_added(
    added: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    reopened_class: String,
    first_path: String,
): Validators.Answer {
    fallback not library.holds(added.path)
    class_key = reopened_class
    var class_name = class_name_of(reopened_class)
    fallback added.is_a_constructor_of(class_name) and not added.parameters.is_empty()
    var second = parameters_shown(added)
    var first_file = first_file_shown(first_path)
    var advice = advice_for(added)
    var text = "'{added.name}' takes nothing where the class first declares it, since its first file{first_file} writes no constructor and the compiler makes '{added.name}()', and this reopening makes it take {second}: {advice}"
    var problem = Diagnostics.Problem(added.path, added.line, text)
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

func first_file_shown(first_path: String): String {
    fallback library.holds(first_path)
    var shown = standard_library.shown(first_path)
    return ", {shown},"
}

func parameters_alike(
    replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    replacing: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
): Boolean {
    fallback replaced.parameters.count() == replacing.parameters.count()
    var index = 0
    while index < replaced.parameters.count() {
        var first = replaced.parameters[index]
        var second = replacing.parameters[index]
        crash first and second
        fallback parameter_alike(first, second, replaced.line, replacing.line)
        index = index + 1
    }
    return true
}

func parameter_alike(
    first: AbstractSyntaxTree.Shapes.Declarations.Parameter,
    second: AbstractSyntaxTree.Shapes.Declarations.Parameter,
    first_line: Integer,
    second_line: Integer,
): Boolean {
    var first_name = named_alike(first.name)
    var second_name = named_alike(second.name)
    fallback first_name == second_name and first.is_variadic == second.is_variadic
    crash first.declared_type and second.declared_type
    var first_printer = Printers.Spite.TypePrinter(first.declared_type)
    var second_printer = Printers.Spite.TypePrinter(second.declared_type)
    if first_printer.text() == second_printer.text() {
        return true
    }
    var program = resolver.state.program
    var model = program.class_named(class_key)
    fallback model
    var first_type = resolver.types.type_in(first.declared_type, model, first_line)
    var second_type = resolver.types.type_in(second.declared_type, model, second_line)
    return first_type.is_the_same_as(second_type)
}

# ../../../../spite_documentation/classes_and_files.md#reopening-a-class
func named_alike(name: String): String {
    if not name.starts_with("_") {
        return name
    }
    var name_length = name.length()
    var bare = name.slice(1, name_length)
    crash bare
    return bare
}

func parameters_shown(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    if function.parameters.is_empty() {
        return "nothing"
    }
    var printer = Printers.Spite.DeclarationPrinter(function)
    var shown = printer.parameters_text(function.parameters)
    return "({shown})"
}

func advice_for(replacing: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    var class_name = class_name_of(class_key)
    if replacing.is_a_constructor_of(class_name) {
        return "a reopening replaces a constructor's body, never what it takes, so build the class from another value with a conversion of its own, named '{replacing.name}' with one parameter named 'from'"
    }
    return "a reopening replaces a function's body, never what it takes, so give the new function a name of its own"
}

func class_name_of(key: String): String {
    var parts = key.split(".")
    var last = parts.last()
    crash last
    return last
}

func place_in_the_library(replaced: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    fallback library.holds(replaced.path)
    var shown = standard_library.shown(replaced.path)
    return ", at {shown}:{replaced.line}"
}

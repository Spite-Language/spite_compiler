var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()

# ../../../PROOFS.md#a-member-template-fits
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: Model.ClassModel,
    called: String,
    member: String,
    element_class: Model.ClassModel,
    member_type: Model.Type,
) {
    var element_shown = element_class.shown
    var library = Mapping.LibraryFile()
    fallback library.holds(owner.file.path) or owner.bound_types["$element_type"]
    var member_shown = context.shown(member_type)
    var prefix = ""
    var needs = ""
    var advice = ""
    var is_a_member_number = every_rule.is_a_number(member_shown)
    if called.starts_with("sum_") and not is_a_member_number {
        prefix = "sum_"
        needs = "to return a numeric type"
    }
    if called.starts_with("count_") and is_a_member_number {
        prefix = "count_"
        needs = "to return Boolean"
        advice = " (to add up a numeric member use 'sum_{member}')"
    }
    var attribute = element_class.attribute_named(member)
    if called.starts_with("each_") and attribute {
        prefix = "each_"
        needs = "to be a function"
        advice = ": reading an attribute and discarding it does nothing"
    }
    if called.starts_with("map_") and member_shown == "nothing" {
        stopped(
            context,
            "'{called}': the member '{member}' of '{element_shown}' returns nothing, but 'map_' needs it to return a value (to only call it for each element, write 'each_{member}()')",
        )
    }
    if called.starts_with("sort_by_") and member_shown == "Boolean" {
        prefix = "sort_by_"
        needs = "to return something ordered: a number or a String"
    }
    var test_prefix = test_prefix_of(called)
    if not test_prefix.is_empty() and member_shown != "Boolean" {
        prefix = test_prefix
        needs = "to return Boolean"
    }
    fallback not prefix.is_empty()
    var article = every_rule.article_of(member_shown)
    stopped(
        context,
        "'{called}': the member '{member}' of '{element_shown}' is {article} {member_shown}, but '{prefix}' needs it {needs}{advice}",
    )
}

func test_prefix_of(called: String): String {
    var prefixes = ["filter_", "any_", "all_"]
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        if called.starts_with(prefix) {
            return prefix
        }
        index = index + 1
    }
    return ""
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

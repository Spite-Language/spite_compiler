# ../../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    fitted_right: SpiteCompiler.Value,
    left_type: Model.Type,
    right_type: Model.Type,
    right_is_a_literal: Boolean,
    turned_operator: AbstractSyntaxTree.Tokens.Token.Kind,
    is_a_comparison: Boolean,
) {
    fallback left_type.name != "Float" or not right_is_a_literal
    fallback fitted_right.class == HighIntermediaryRepresentation.Values.Conversion
    var cuts = fitted_right.kind == 'narrow' or fitted_right.kind == 'narrow_decimal' or fitted_right.kind == 'to_whole'
    fallback cuts
    fallback not changes_only_its_sign(context, left_type, right_type)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    crash binary.left
    crash binary.right
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var left_text = left_printer.text()
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.right, turned_operator, binary.left)
    var turned_printer = Printers.Spite.ExpressionPrinter(turned)
    var turned_text = turned_printer.text()
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var left = left_type.name
    var right = right_type.name
    var right_article = typing.article_of(right)
    var left_article = typing.article_of(left)
    if is_a_comparison {
        stopped(
            context,
            "'{shown}' compares in {left}, since a comparison takes the left side's type, and the right side is {right_article} {right}, which would be cut to fit: write the {right} first ('{turned_text}'), or store the right side in {left_article} {left} first if it fits one",
        )
    }
    var operation = operation_name_of(binary.operator)
    var fix = "store the left side in {right_article} {right} first ('var wide: {right} = {left_text}')"
    if binary.operator == 'plus' or binary.operator == 'star' {
        fix = "write the {right} first ('{turned_text}')"
    }
    stopped(
        context,
        "'{shown}' is {operation} in {left}, since arithmetic takes the left side's type, and the right side is {right_article} {right}, which would be cut to fit: {fix}, or store the right side in {left_article} {left} first if it fits one",
    )
}

func changes_only_its_sign(
    context: HighIntermediaryRepresentation.Building.Context,
    left_type: Model.Type,
    right_type: Model.Type,
): Boolean {
    var both_scalars = left_type.kind == 'scalar' and right_type.kind == 'scalar'
    fallback both_scalars and not left_type.is_nullable and not right_type.is_nullable
    var left_scalar = context.scalars.of(left_type.name)
    var right_scalar = context.scalars.of(right_type.name)
    crash left_scalar
    crash right_scalar
    fallback is_a_whole_number(left_scalar) and is_a_whole_number(right_scalar)
    return left_scalar.size == right_scalar.size
}

func is_a_whole_number(scalar: Model.Scalar): Boolean {
    return not scalar.is_decimal and scalar.is_a_number
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func operation_name_of(kind: AbstractSyntaxTree.Tokens.Token.Kind): String {
    switch kind {
        'plus': return "an addition"
        'minus': return "a subtraction"
        'star': return "a multiplication"
        'slash': return "a division"
        'percent': return "a remainder"
        'end_of_file': return "a comparison"
        'name': return "a comparison"
        'class_name': return "a comparison"
        'generic_name': return "a comparison"
        'integer_literal': return "a comparison"
        'decimal_literal': return "a comparison"
        'text_literal': return "a comparison"
        'symbol_literal': return "a comparison"
        'open_brace': return "a comparison"
        'close_brace': return "a comparison"
        'open_parenthesis': return "a comparison"
        'close_parenthesis': return "a comparison"
        'open_bracket': return "a comparison"
        'close_bracket': return "a comparison"
        'comma': return "a comparison"
        'dot': return "a comparison"
        'dots': return "a comparison"
        'colon': return "a comparison"
        'question': return "a comparison"
        'equals': return "a comparison"
        'equal_equal': return "a comparison"
        'not_equal': return "a comparison"
        'less': return "a comparison"
        'greater': return "a comparison"
        'less_or_equal': return "a comparison"
        'greater_or_equal': return "a comparison"
        'and': return "a comparison"
        'or': return "a comparison"
        'not': return "a comparison"
        'keyword_function': return "a comparison"
        'keyword_variable': return "a comparison"
        'keyword_enum': return "a comparison"
        'keyword_union': return "a comparison"
        'keyword_type': return "a comparison"
        'keyword_return': return "a comparison"
        'keyword_if': return "a comparison"
        'keyword_else': return "a comparison"
        'keyword_while': return "a comparison"
        'keyword_switch': return "a comparison"
        'keyword_fallback': return "a comparison"
        'keyword_crash': return "a comparison"
        'keyword_load': return "a comparison"
        'keyword_this': return "a comparison"
        'keyword_null': return "a comparison"
        'keyword_true': return "a comparison"
        'keyword_false': return "a comparison"
        'keyword_generic': return "a comparison"
        'keyword_singleton': return "a comparison"
    }
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    name: String,
): Validators.Answer {
    fallback not model.attribute_named(name)
    var shown = model.shown
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{shown}' declares no attribute '{name}', so '{shown}.attributes[\"{name}\"]' names nothing: name one of the attributes it declares",
    )
}

func check(context: HighIntermediaryRepresentation.Building.Context, made_type: Model.Type) {
    fallback made_type.kind == 'shape' or made_type.kind == 'union'
    var segments = made_type.name.split(".")
    var shown = segments.last()
    crash shown
    if made_type.kind == 'shape' {
        stopped(
            context,
            "'{shown}' is a type, so it makes no object: it says what a value must have; make an object of a class that fits it",
        )
    }
    stopped(context, "'{shown}' is a union, so it makes no object: make an object of one of its members")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

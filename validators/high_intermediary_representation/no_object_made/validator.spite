func check(context: HighIntermediaryRepresentation.Building.Context, made_type: Model.Type): Validators.Answer {
    fallback made_type.kind == 'shape' or made_type.kind == 'union'
    var segments = made_type.name.split(".")
    var shown = segments.last()
    crash shown
    if made_type.kind == 'shape' {
        return mistake(
            context,
            "'{shown}' is a type, so it makes no object: it says what a value must have; make an object of a class that fits it",
        )
    }
    return mistake(context, "'{shown}' is a union, so it makes no object: make an object of one of its members")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
): Validators.Answer {
    var name = context.current_function.name
    if context.current_function.answer {
        fallback not statement.value
        var shown = context.shown(context.current_function.answer)
        return mistake(context, "'{name}' answers a {shown}, so 'return' needs a value")
    }
    fallback statement.value
    return mistake(context, "'{name}' answers nothing, so 'return' takes no value")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

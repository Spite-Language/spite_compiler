func check(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    var name = context.current_function.name
    var answer = context.current_function.answer
    if answer {
        fallback not statement.value
        var shown = context.shown(answer)
        stopped(context, "'{name}' answers a {shown}, so 'return' needs a value")
        return
    }
    fallback statement.value
    stopped(context, "'{name}' answers nothing, so 'return' takes no value")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

# ../../../../spite_documentation/values_and_types.md#a-number-that-may-not-fit-is-narrowed
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.NarrowingSite,
): Validators.Answer {
    var conversion = site.conversion
    crash conversion.converted
    fallback conversion.is_written_by_the_program and not is_written(conversion.converted)
    var given = conversion.converted.value_type
    var wanted = conversion.value_type
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var given_article = rules.article_of(given.name)
    var wanted_article = rules.article_of(wanted.name)
    var loses = conversion.kind == 'to_whole' or conversion.kind == 'narrow_decimal'
    if loses and not conversion.is_on_its_own_line {
        var lost = "loses its fraction"
        if conversion.kind == 'narrow_decimal' {
            lost = "loses precision"
        }
        return rules.mistake_at(
            context,
            site.line,
            "this value is {given_article} {given.name}, which {lost} in {wanted_article} {wanted.name}: write 'var converted: {wanted.name}? = value' on the line above, and narrow that",
        )
    }
    fallback not conversion.answers_null_when_it_does_not_fit
    fallback not conversion.is_proven_to_fit
    return rules.mistake_at(
        context,
        site.line,
        "this value is {given_article} {given.name}, which may not fit in {wanted_article} {wanted.name}: write 'var converted: {wanted.name}? = value' on its own line, which is null when it does not fit, and narrow that, or bound the value first with a condition ('if value <= largest \{ }')",
    )
}

func is_written(value: SpiteCompiler.Value): Boolean {
    var is_a_number = value.class == HighIntermediaryRepresentation.Values.WholeNumber
    return is_a_number or value.class == HighIntermediaryRepresentation.Values.DecimalNumber
}

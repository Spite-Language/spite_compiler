func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function_type: Model.Type,
    name: String,
): Validators.Answer {
    var is_described = name == "name" or name == "arguments" or name == "returns"
    var is_bound = name == "owner" or name == "declaration"
    fallback not is_described and not is_bound
    var shown = context.shown(function_type)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "'{shown}' has no attribute '{name}'")
}

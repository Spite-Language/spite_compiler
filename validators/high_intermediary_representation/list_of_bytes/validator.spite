# ../../../../spite_documentation/standard_library.md#bytes-are-a-buffer
func check_a_literal(context: HighIntermediaryRepresentation.Building.Context, element: Model.Type) {
    fallback element.kind == 'scalar' and element.name == "Byte" and not element.is_nullable
    var written_rule = Validators.NameResolution.ListOfBytes.Validator()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "these items are bytes, so this list would be a List<Byte>, and {written_rule.no_list_of_bytes}: write 'Buffer(0)' and add each byte with 'append(byte)'",
    )
}

func check_an_answer(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel) {
    fallback function.answer
    fallback function.answer.kind == 'object' and function.answer.name == "List_of_Byte"
    var written_rule = Validators.NameResolution.ListOfBytes.Validator()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{function.name}' would answer a List<Byte>, and {written_rule.no_list_of_bytes}: walk the list and append each byte to a 'Buffer(0)'",
    )
}

func check(context: HighIntermediaryRepresentation.Building.Context, owner: Model.ClassModel, name: String) {
    fallback name.starts_with("_")
    fallback is_a_written_file(context)
    fallback owner.file.path != context.current_class.file.path
    var length = name.length()
    var public_name = name.slice(1, length)
    crash public_name
    var reader = ""
    var is_read_outside = owner.function_named("get_{public_name}") or owner.function_named(public_name)
    if is_read_outside and owner.attribute_named(name) {
        reader = public_name
    }
    stopped(context, name, owner.shown, reader)
}

func check_a_type_member(
    context: HighIntermediaryRepresentation.Building.Context,
    shape_type: Model.Type,
    name: String,
) {
    fallback name.starts_with("_")
    fallback is_a_written_file(context)
    var segments = shape_type.name.split(".")
    var shown = segments.last()
    crash shown
    stopped(context, name, shown, "")
}

func is_a_written_file(context: HighIntermediaryRepresentation.Building.Context): Boolean {
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    return not context.resolver.state.symbols.generated_texts[path]
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, name: String, shown: String, reader: String) {
    var text = "'{name}' is private to '{shown}': a name starting with '_' is used only inside its own class"
    if not reader.is_empty() {
        text = "{text}, and '{reader}' reads it from outside"
    }
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

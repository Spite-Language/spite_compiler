var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
var scalars = Model.Scalars()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    described: Model.ClassModel?,
    name: String,
) {
    fallback not function
    fallback described
    fallback described.function_named(name) or described.attribute_named(name)
    var plain = every_rule.plain_class_name(described.shown)
    if scalars.is_a_scalar(described.key) {
        var number_class = Validators.HighIntermediaryRepresentation.NumberClass.Validator()
        var listed = number_class.presets_listed(described)
        stopped(
            context,
            "'{plain}.{name}()' calls a function of a value on the class: the class {plain} answers only its presets, {listed}, so call '{name}' on a value, like 'number.{name}()'",
        )
    }
    stopped(
        context,
        "'{plain}' is a class, not a value: write '{plain}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

var scalars = Model.Scalars()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
) {
    var written = class_path.join(".")
    var initial = written.slice(0, 1)
    crash initial
    var is_a_class_name = initial != initial.lower_case() and not scalars.is_a_scalar(written)
    var built_in = ["Spite.Function", "Symbol", "Parallel", "Concurrent"]
    var is_generic = not call.generic_arguments.is_empty() and not built_in.contains(written)
    fallback is_generic and is_a_class_name
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback not found
    if written == "Heap" {
        stopped(
            context,
            "there is no 'Heap<T>': a class, a list and a text are references already, so a class that holds one of its own kind declares an ordinary attribute, like 'var left: Expression? = null' ('Memory.Heap' is the allocator, for containers of your own)",
        )
    }
    stopped(
        context,
        "there is no generic class '{written}' here: a class name is looked up in this class's folder, each parent folder, then the whole program",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

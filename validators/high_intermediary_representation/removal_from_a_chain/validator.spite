func check(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Validators.Answer {
    fallback callee.name.starts_with("remove_where")
    var chain = callee.target
    fallback chain.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    return check_a_step(context, callee, chain)
}

func check_a_step(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    chain: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Validators.Answer {
    var step = chain.callee
    fallback step.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var copies = ["copy", "deep_copy", "keys", "values", "reversed"]
    var name = step.name
    var makes_a_new_one = name.starts_with("filter") or name.starts_with("map") or name.starts_with("sort")
    fallback makes_a_new_one or copies.contains(name)
    var printer = Printers.Spite.ExpressionPrinter(chain)
    var shown = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{callee.name}' removes from the collection it is called on, and '{shown}' makes a new one that nothing keeps: call it on the collection itself, with one test that says everything to remove",
    )
}

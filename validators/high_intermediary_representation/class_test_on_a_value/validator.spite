# ../../../../spite_documentation/values_and_types.md#unions
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    tested_type: Model.Type,
) {
    fallback tested_type.name != "Spite.Class"
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var left = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
    var right = right_printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{left} == {right}' tests what a value is, and a class is compared with a class: write '{left}.class == {right}'",
    )
}

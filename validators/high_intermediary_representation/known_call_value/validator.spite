func check(context: HighIntermediaryRepresentation.Building.Context, name: String): Validators.Answer {
    fallback context.known_calls[name]
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{name}' is a call known while compiling, which becomes the plain call itself and has no object to pass on: fill it with '{name}.arguments[\"name\"] = value' and run it with '{name}.call()'",
    )
}

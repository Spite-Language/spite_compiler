func refuse(
    context: HighIntermediaryRepresentation.Building.Context,
    serializer: String,
    written: String,
    problem: String,
) {
    var verb = "write"
    if serializer.ends_with("Reader") {
        verb = "read"
    }
    var handles = "{serializer} handles classes, lists, dictionaries, enums, Symbols, numbers, Boolean, String and 'T?'"
    var advice = "so keep what it sees to those, or give it a class of its own that holds only them"
    var failure = Validators.Failure()
    var path = context.path()
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var owner = typing.plain_class_name(context.current_class.shown)
    var text = "{serializer} cannot {verb} '{written}': {problem}. {handles}, {advice}"
    failure.stop_inside(path, context.line, owner, context.current_function.name, text)
}

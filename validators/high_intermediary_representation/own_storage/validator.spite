# ../../../../spite_documentation/functions_and_operators.md#settergetter-interception
func check(context: HighIntermediaryRepresentation.Building.Context, name: String): Validators.Answer {
    var accessors = HighIntermediaryRepresentation.Building.Accessors()
    var function = context.current_function
    fallback accessors.is_its_own_accessor(function, name)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{name}' inside '{function.name}' would run '{function.name}' again: its own accessor reaches the storage as 'attributes[\"{name}\"].value'",
    )
}

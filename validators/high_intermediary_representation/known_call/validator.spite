func check_the_instance(
    context: HighIntermediaryRepresentation.Building.Context,
    instance_type: Model.Type,
    written: SpiteCompiler.Expression,
    declared: Model.FunctionModel,
): Validators.Answer {
    var owner = context.program.class_named(declared.owner)
    crash owner
    var is_its_own = instance_type.kind == 'object' and instance_type.name == declared.owner
    fallback not is_its_own or instance_type.is_nullable
    var printer = Printers.Spite.ExpressionPrinter(written)
    var shown = printer.text()
    var shown_type = context.shown(instance_type)
    return mistake(
        context,
        "'{shown}' is a '{shown_type}', and '{declared.name}' is declared by '{owner.shown}': a call runs a declaration on an instance of its own class",
    )
}

func check_an_argument_name(
    context: HighIntermediaryRepresentation.Building.Context,
    argument_name: String?,
    call_name: String,
): Validators.Answer {
    fallback not argument_name
    return mistake(
        context,
        "'{call_name}.arguments' is filled by the argument's name, written as a literal: '{call_name}.arguments[\"name\"] = value'",
    )
}

func check_a_parameter(
    context: HighIntermediaryRepresentation.Building.Context,
    parameter: Model.ParameterModel?,
    call_name: String,
    argument: String,
    function_name: String,
): Validators.Answer {
    fallback not parameter
    return mistake(
        context,
        "'{function_name}' has no argument '{argument}', so '{call_name}.arguments[\"{argument}\"]' fills nothing",
    )
}

func check_a_refill(
    context: HighIntermediaryRepresentation.Building.Context,
    filled: String?,
    call_name: String,
    argument: String,
): Validators.Answer {
    fallback filled
    return mistake(
        context,
        "'{call_name}.arguments[\"{argument}\"]' is already set: a call fills each argument once, before '{call_name}.call()' runs it",
    )
}

func check_a_run(
    context: HighIntermediaryRepresentation.Building.Context,
    arguments: List<SpiteCompiler.Expression>,
    call_name: String,
): Validators.Answer {
    fallback not arguments.is_empty()
    return mistake(
        context,
        "'{call_name}.call()' takes no arguments: set each one with '{call_name}.arguments[\"name\"] = value' before it",
    )
}

func check_a_filled_argument(
    context: HighIntermediaryRepresentation.Building.Context,
    filled: String?,
    call_name: String,
    argument: String,
    function_name: String,
): Validators.Answer {
    fallback not filled
    return mistake(
        context,
        "'{call_name}' leaves the argument '{argument}' of '{function_name}' unfilled: set '{call_name}.arguments[\"{argument}\"]' before 'call()'",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

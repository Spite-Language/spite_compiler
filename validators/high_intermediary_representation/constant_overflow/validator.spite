var _largest_integer: Long = 2147483647

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    made: HighIntermediaryRepresentation.Values.MachineOperation,
    folded: Long?,
) {
    var is_an_integer = made.value_type.kind == 'scalar' and made.value_type.name == "Integer"
    fallback is_an_integer and not made.value_type.is_nullable
    fallback folded
    var smallest: Long = -2147483648
    var largest: Long = _largest_integer
    fallback folded < smallest or folded > largest
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{made.shown}' is {folded}, which does not fit in an Integer, the type its arithmetic is done in, so it would wrap: write the number itself, {folded}, which is a Long",
    )
}

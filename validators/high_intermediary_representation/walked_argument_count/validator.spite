func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel) {
    var walks_functions = function.binds_a_function_declaration and not function.bound_class.is_empty()
    fallback not walks_functions or function.bound_function.is_empty()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{function.bound_parameter}.argument_count()' is how many arguments the function a walk over functions stands for takes, so it is asked with no name in a template over functions, such as 'run_phase_each(phase: Spite.FunctionDeclaration)'",
    )
}

func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel) {
    var binding = function.binding_or_empty()
    var bound_pattern = binding.pattern_or_empty()
    var walks_functions = bound_pattern.binds_a_function_declaration and not bound_pattern.class_key.is_empty()
    fallback not walks_functions or bound_pattern.function.is_empty()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{function.bound_parameter()}.argument_count()' is how many arguments the function a walk over functions stands for takes, so it is asked with no name in a template over functions, such as 'run_phase_each(phase: Spite.FunctionDeclaration)'",
    )
}

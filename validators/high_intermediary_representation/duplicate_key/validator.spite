func check(context: HighIntermediaryRepresentation.Building.Context, key: String, written_keys: List<String>) {
    fallback not key.is_empty() and written_keys.contains(key)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "{key} is written twice in this dictionary: keep one entry for each key")
}

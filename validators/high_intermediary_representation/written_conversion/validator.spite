func check(context: HighIntermediaryRepresentation.Building.Context, found: Model.Type?): Validators.Answer {
    fallback found
    var shown = context.shown(found)
    return mistake(
        context,
        "a conversion is never called by name: the compiler applies it where a value meets the class it makes, so cast by assignment: 'var converted: {shown}? = value'",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

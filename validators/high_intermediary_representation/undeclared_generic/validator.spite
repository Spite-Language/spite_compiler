func check(context: HighIntermediaryRepresentation.Building.Context, bound: Model.Type?, name: String) {
    fallback not bound
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var owner = rules.plain_class_name(context.current_class.shown)
    var parts = owner.split(".")
    var plain = parts.last()
    crash plain
    var length = name.length()
    var setting = name.slice(1, length)
    crash setting
    rules.stop(
        context,
        "'{plain}' has no 'generic {name}' line, and '$' is for generics only: a program's settings are fields of Environment, so read 'Environment().{setting}', or declare 'generic {name}' at the top of the file",
    )
}

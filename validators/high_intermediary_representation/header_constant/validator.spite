func check_a_header(context: HighIntermediaryRepresentation.Building.Context, name: String, header: String) {
    fallback header.is_empty()
    stopped(
        context,
        "'{name}' is a constant, and a constant comes from the library's header: name it as DynamicLibrary's third argument",
    )
}

func check_a_found_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    exists: Boolean,
) {
    fallback not exists
    refuse_an_unread_header(context, name, header)
}

func check_a_read_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    text: String?,
) {
    fallback not text
    refuse_an_unread_header(context, name, header)
}

func check_a_definition(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    found: String,
) {
    fallback found.is_empty()
    var upper = name.upper_case()
    stopped(context, "'{name}' is read as the constant '{upper}', and the header '{header}' has no '#define {upper}'")
}

func check_a_number(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    written: String,
    number: Long?,
) {
    fallback not number
    stopped(
        context,
        "'{name}' is '{written}' in the header '{header}', which is not a whole number written in decimal: only such a constant can be read",
    )
}

func refuse_an_unread_header(context: HighIntermediaryRepresentation.Building.Context, name: String, header: String) {
    stopped(
        context,
        "'{name}' is a constant of the header '{header}', which is not a file the compiler can read: name the header by its path from the folder the compiler runs in",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

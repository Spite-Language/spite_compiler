func check_a_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
): Validators.Answer {
    fallback header.is_empty()
    return mistake(
        context,
        "'{name}' is a constant, and a constant comes from the library's header: name it as DynamicLibrary's third argument",
    )
}

func check_a_found_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    finding: CommandLine.Attempt,
): Validators.Answer {
    fallback not finding.is_done
    return an_unread_header(context, name, finding.place)
}

func check_a_read_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    text: String?,
): Validators.Answer {
    fallback not text
    return an_unread_header(context, name, header)
}

func check_a_definition(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    found: String,
): Validators.Answer {
    fallback found.is_empty()
    var upper = name.upper_case()
    return mistake(
        context,
        "'{name}' is read as the constant '{upper}', and the header '{header}' has no '#define {upper}'",
    )
}

func check_a_number(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    written: String,
    number: Long?,
): Validators.Answer {
    fallback not number
    return mistake(
        context,
        "'{name}' is '{written}' in the header '{header}', which is not a whole number written in decimal: only such a constant can be read",
    )
}

func an_unread_header(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
): Validators.Answer {
    return mistake(
        context,
        "'{name}' is a constant of the header '{header}', which is not a file the compiler can read: name the header by its path from the folder the compiler runs in",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

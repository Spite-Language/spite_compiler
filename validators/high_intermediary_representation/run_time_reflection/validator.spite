func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel) {
    fallback function.reflected_answer_index >= 0 and function.bound_parameter.is_empty()
    stopped(
        context,
        "'{function.name}' answers a type read from a reflection object, so it is compiled once for each object the compiler can identify, and this call hands it one known only at run time: pass a class, attribute, function or argument named in the code, or walked from one",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

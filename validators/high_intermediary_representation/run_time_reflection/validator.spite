func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel): Validators.Answer {
    fallback function.reflects_its_answer() and function.bound_parameter().is_empty()
    return mistake(
        context,
        "'{function.name}' answers a type read from a reflection object, so it is compiled once for each object the compiler can identify, and this call hands it one known only at run time: pass a class, attribute, function or argument named in the code, or walked from one",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    type_name: String,
): Validators.Answer {
    var parsed: Double? = written
    crash parsed
    var doubled = parsed + parsed
    var is_too_large = parsed > 1.0 and doubled == parsed
    var largest_written = "1.7976931348623157e+308"
    if type_name == "Float" {
        var largest_float: Double = 340282346638528859811704183484516925440.0
        is_too_large = parsed > largest_float
        largest_written = "3.4028235e+38"
    }
    fallback is_too_large
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(type_name)
    var wider = "write a smaller number"
    if type_name == "Float" {
        wider = "declare it a Double, which holds up to 1.7976931348623157e+308, or write a smaller number"
    }
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "{written} does not fit in {article} {type_name}, whose largest number is {largest_written}: {wider}",
    )
}

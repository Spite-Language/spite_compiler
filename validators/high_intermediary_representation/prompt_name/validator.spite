func check(program: Model.ProgramModel, key: String): Validators.Answer {
    var model = program.class_named(key)
    fallback model
    var text = "the program declares a class '{key}', the name a --repl build gives the class it adds to answer the prompt: rename the program's class"
    var problem = Diagnostics.Problem(model.file.path, 1, text)
    problem.class_name = key
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

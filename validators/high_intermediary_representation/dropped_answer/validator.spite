var rules = Validators.HighIntermediaryRepresentation.EveryRule()

# ../../../../spite_documentation/failure.md#an-answer-is-used
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    value: SpiteCompiler.Value,
) {
    var answer = value.value_type
    fallback not answer.is_nothing()
    fallback not is_kept_by_its_maker(value)
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var shown = printer.text()
    refuse(context, shown, answer)
}

func is_kept_by_its_maker(value: SpiteCompiler.Value): Boolean {
    var is_made = value.class == HighIntermediaryRepresentation.Values.MakeObject
    return is_made or value.class == HighIntermediaryRepresentation.Values.ForeignCall
}

# ../../../../spite_documentation/failure.md#an-answer-is-used
func refuse(context: HighIntermediaryRepresentation.Building.Context, written: String, answer: Model.Type) {
    var shown = context.shown(answer)
    var article = rules.article_of(shown)
    if answer.is_nullable or shown == "Boolean" {
        rules.stop(
            context,
            "'{written}' answers {article} '{shown}' and drops it: an answer must be used, at least with 'fallback {written}' to carry on without it or 'crash {written}' when that is a bug",
        )
    }
    rules.stop(
        context,
        "'{written}' answers {article} '{shown}' and drops it: an answer must be used, so keep it in a variable that is read, pass it, return it or compare it",
    )
}

# ../../../../spite_documentation/failure.md#an-answer-is-used
func check_a_walk(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    owner: Model.ClassModel,
    function: Model.FunctionModel,
    answer: Model.Type,
    walks: HighIntermediaryRepresentation.Building.DroppingWalks,
) {
    fallback not answer.is_nothing()
    fallback walks.drops_each_answer(owner, function)
    var member = function.bound_member
    var printer = Printers.Spite.ExpressionPrinter(call)
    var written = printer.text()
    var shown = context.shown(answer)
    var article = rules.article_of(shown)
    rules.stop(
        context,
        "'{written}' runs '{member}', which answers {article} '{shown}', and drops each answer: an answer must be used, so keep the answers with a 'map_' over '{member}', or walk a member that answers nothing",
    )
}

var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

# ../../../../spite_spec/specs/failure.md#an-answer-is-used
func refuse(context: HighIntermediaryRepresentation.Building.Context, written: String, answer: Model.Type) {
    var shown = context.shown(answer)
    var article = typing.article_of(shown)
    if answer.is_nullable or shown == "Boolean" {
        typing.stop(
            context,
            "'{written}' answers {article} '{shown}' and drops it: an answer must be used, at least with 'assert {written}' to carry on without it or 'crash {written}' when that is a bug",
        )
    }
    typing.stop(
        context,
        "'{written}' answers {article} '{shown}' and drops it: an answer must be used, so keep it in a variable that is read, pass it, return it or compare it",
    )
}

var endings = HighIntermediaryRepresentation.Building.Endings()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    body: HighIntermediaryRepresentation.Statements.Block,
    end_line: Integer,
): Validators.Answer {
    fallback context.current_function.answer
    var answer: Model.Type = context.current_function.answer
    fallback not endings.always_leaves(body)
    var shown = context.shown(answer)
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(shown)
    var got = "{article} {shown}"
    if answer.is_nullable {
        got = "a null"
    }
    var steps = List<String>()
    note_the_path(body, steps)
    var name = context.current_function.name
    var place = ""
    var instance = context.current_class.shown
    if instance.contains("<") {
        place = " in {instance}"
    }
    var text = "'{name}' answers {article} {shown}, but{place} it reaches its end without a 'return', so a caller would get {got} nobody wrote: end it with 'return <value>', or with 'crash' if it cannot get there"
    if not steps.is_empty() {
        var path = steps.join(", then ")
        text = "'{name}' answers {article} {shown}, but{place} {path} it reaches its end without a 'return', so a caller would get {got} nobody wrote: end that path with 'return <value>', or with 'crash' if it cannot happen"
    }
    var line = context.line
    if end_line > 0 {
        line = end_line
    }
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake_at(context, line, text)
}

func note_the_path(block: HighIntermediaryRepresentation.Statements.Block, steps: List<String>) {
    var branch = noted_up_to_a_branch(block, steps)
    fallback branch
    note_the_branch(branch, steps)
}

func noted_up_to_a_branch(
    block: HighIntermediaryRepresentation.Statements.Block,
    steps: List<String>,
): HighIntermediaryRepresentation.Statements.If? {
    if block.case_written != "" {
        steps.append("in the case {block.case_written} of the 'switch' at line {block.switch_line}")
    }
    var last = block.statements.last()
    fallback last
    switch last {
        HighIntermediaryRepresentation.Statements.If: return last
        HighIntermediaryRepresentation.Statements.While: steps.append("when the 'while' at line {last.line} ends")
        HighIntermediaryRepresentation.Statements.Block: note_the_path(last, steps)
        HighIntermediaryRepresentation.Statements.Declare: return null
        HighIntermediaryRepresentation.Statements.Assign: return null
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return null
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return null
        HighIntermediaryRepresentation.Statements.Evaluate: return null
        HighIntermediaryRepresentation.Statements.Return: return null
        HighIntermediaryRepresentation.Statements.Stop: return null
    }
    return null
}

# ../../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func note_the_branch(branch: HighIntermediaryRepresentation.Statements.If, steps: List<String>) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        var then_leaves = endings.always_leaves(current.then_branch)
        var written = current.written_condition
        if not current.else_branch {
            note_a_branch_without_else(current, steps)
            return
        }
        var else_branch: HighIntermediaryRepresentation.Statements.Block = current.else_branch
        if not then_leaves {
            note_a_step(written, "true", current.line, steps)
            note_the_path(current.then_branch, steps)
            return
        }
        note_a_step(written, "false", current.line, steps)
        link = noted_up_to_a_branch(else_branch, steps)
    }
}

func note_a_branch_without_else(branch: HighIntermediaryRepresentation.Statements.If, steps: List<String>) {
    var written = branch.written_condition
    if written != "" {
        steps.append("when '{written}' is false (line {branch.line}, an 'if' with no 'else')")
        return
    }
    var then_leaves = endings.always_leaves(branch.then_branch)
    if not then_leaves {
        note_the_path(branch.then_branch, steps)
    }
}

func note_a_step(written: String, answer: String, line: Integer, steps: List<String>) {
    if written != "" {
        steps.append("when '{written}' is {answer} (line {line})")
    }
}

# ../../../../spite_documentation/values_and_types.md#unions
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    united: Model.UnionModel,
    member: Model.Type,
    fitting_members: List<Model.Type>,
): Validators.Answer {
    var names_a_codegen_value = false
    var right = binary.right
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_a_codegen_value = right.name.starts_with("$")
    }
    var bound = context.current_class.bound_types.keys()
    fallback not names_a_codegen_value and bound.is_empty()
    fallback member.kind != 'shape'
    var held_names = united.members.map_names()
    fallback not held_names.contains(member.name)
    fallback fitting_members.is_empty()
    var listed = listed_members(context, united)
    var printer = Printers.Spite.ExpressionPrinter(binary.left)
    var tested = printer.text()
    var member_shown = context.shown(member)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{tested}' is a '{united.name}', which holds only {listed}, so it is never a '{member_shown}': test for one of those, or add '{member_shown}' to the union",
    )
}

# ../../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func check_a_satisfaction(
    context: HighIntermediaryRepresentation.Building.Context,
    class_read: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    united: Model.UnionModel,
    wanted: Model.Type,
    fitting_members: List<Model.Type>,
): Validators.Answer {
    var bound = context.current_class.bound_types.keys()
    fallback bound.is_empty() and fitting_members.is_empty()
    var listed = listed_members(context, united)
    var printer = Printers.Spite.ExpressionPrinter(class_read.target)
    var value_text = printer.text()
    var wanted_shown = context.shown(wanted)
    var wanted_parts = wanted_shown.split(".")
    var type_name = wanted_parts.last()
    crash type_name
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{value_text}' is a '{united.name}', which holds only {listed}, and none of them fits the type '{type_name}', so it never fits it: ask for a type one of them fits",
    )
}

func listed_members(context: HighIntermediaryRepresentation.Building.Context, united: Model.UnionModel): String {
    var names = List<String>()
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var shown = context.shown(held)
        names.append(shown)
        index = index + 1
    }
    return names.join(", ")
}

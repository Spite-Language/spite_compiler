# ../../../../spite_documentation/metaprogramming.md#member-templates
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    written: String,
    member: String,
    plural: String,
    spelled_plural: String,
) {
    fallback written != member and written != plural and written != spelled_plural
    var called_plural = called.replace(written, plural)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "'{called}' answers every '{member}', so it is written in the plural: '{called_plural}'")
}

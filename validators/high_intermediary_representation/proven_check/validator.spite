# ../../../PROOFS.md#proving-what-is-proven-is-an-error
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    if site.kind == "proven check" {
        refuse_a_narrowed_check(context, site)
    }
    if site.kind == "proven read" {
        refuse_a_proven_read(context, site)
    }
    if site.kind == "plain value" {
        refuse_a_check_of_a_plain_value(context, site)
    }
    if site.kind == "proven value" {
        refuse_a_proven_check(context, site.written, "the proof that every value it can hold is present")
    }
    if site.kind == "copy" {
        refuse_a_copy(context, site)
    }
    if site.kind == "repeated check" {
        refuse_a_repeated_check(context, site)
    }
    if site.kind == "proven divisor" {
        refuse_a_proven_divisor(context, site)
    }
    if site.kind == "always holds" {
        stopped(context, "'{site.keyword} {site.written}' is decided while compiling and always holds here: remove it")
    }
    if site.kind == "answered class test" {
        refuse_an_answered_class_test(context, site)
    }
    if site.kind == "decided condition" {
        refuse_a_decided_condition(context, site)
    }
}

func refuse_a_narrowed_check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    crash site.check
    refuse_a_proven_check(context, site.written, site.check)
}

func refuse_a_proven_check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    narrowed_by: String,
) {
    stopped(context, "'{written}' is already narrowed by {narrowed_by}: remove this check")
}

func refuse_a_proven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    crash site.check
    stopped(
        context,
        "'{site.written}' is already proven by {site.check}, so this '{site.keyword}' proves nothing: remove it",
    )
}

func refuse_a_check_of_a_plain_value(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var shown = context.shown(site.checked_type)
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(shown)
    stopped(
        context,
        "this value cannot be null here (it is {article} {shown}), so '{site.keyword}' on it proves nothing: remove the check",
    )
}

# ../../../../spite_documentation/metaprogramming.md#walking-a-programs-structure
func refuse_a_copy(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    crash site.source
    stopped(
        context,
        "'{site.written}' only copies '{site.source}' so it can be narrowed: narrow '{site.source}' itself ('fallback {site.source}') and use it directly",
    )
}

func refuse_a_repeated_check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    crash site.check
    stopped(
        context,
        "'{site.written}' was already checked on line {site.check}, and nothing between could change it: remove this check",
    )
}

func refuse_a_proven_divisor(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    crash site.check
    stopped(context, "'{site.written}' is already proven by {site.check}: remove this check")
}

# ../../../PROOFS.md#proving-what-is-proven-is-an-error
func refuse_an_answered_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var shown = context.shown(site.checked_type)
    if site.check {
        stopped(context, "'{site.written}' is already a {shown}, narrowed by {site.check}: remove this test")
    }
    crash site.source
    if shown == site.source {
        stopped(context, "'{site.written}' is a {shown} here, so this test is decided while compiling: remove it")
    }
    stopped(
        context,
        "'{site.written}' is a {shown} here, so it is never {site.source} and this test is decided while compiling: remove it",
    )
}

# ../../../../spite_documentation/failure.md#nothing-fails-silently
func refuse_a_decided_condition(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    var keyword = site.keyword
    var known = "'{keyword} {site.written}' is decided while compiling and is always false here"
    if site.holds {
        known = "'{keyword} {site.written}' is decided while compiling and is always true here"
    }
    if site.source {
        known = "{known}, since {site.source}"
    }
    if keyword == "if" and site.holds {
        stopped(context, "{known}, so it tells a reader nothing: remove the 'if' and keep the code it runs")
    }
    if keyword == "if" {
        stopped(context, "{known}, so the code it guards never runs: remove it, keeping its 'else' if it has one")
    }
    if keyword == "while" and site.holds {
        stopped(
            context,
            "{known}: a loop ends by its condition, so loop 'while' what its leaving paths change, a 'running' local they set to false or the loop's real exit test",
        )
    }
    if keyword == "while" {
        stopped(context, "{known}, so the loop never runs: remove it")
    }
    stopped(context, "{known}, so the function always answers nothing from here: remove it with the code after it")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

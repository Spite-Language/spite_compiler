func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel?, name: String) {
    fallback not function
    var namespace = context.current_class.file.namespace
    var class_file = context.resolver.state.symbols.find(name, namespace)
    if class_file {
        var unknown_name = Validators.HighIntermediaryRepresentation.UnknownName.Validator()
        unknown_name.refuse(context, name)
    }
    stopped(context, "this class has no function '{name}'")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    name: String,
): Validators.Answer {
    fallback not function
    var namespace = context.current_class.file.namespace
    var class_file = context.resolver.state.symbols.find(name, namespace)
    if class_file {
        var unknown_name = Validators.HighIntermediaryRepresentation.UnknownName.Validator()
        return unknown_name.refuse(context, name)
    }
    var plain = plain_function_of_a_plural(context.current_class, name)
    if plain {
        return mistake_of_a_plain_function(context, plain, name)
    }
    return mistake(context, "this class has no function '{name}'")
}

func plain_function_of_a_plural(owner: Model.ClassModel, name: String): Model.FunctionModel? {
    var index = 0
    while index < owner.declared_functions.count() {
        var function = owner.declared_functions[index]
        var is_its_plural = name == "{function.name}s" or name == function.name.pluralize()
        if is_its_plural and range_parameter_index(function) >= 0 {
            return function
        }
        index = index + 1
    }
    return null
}

func range_parameter_index(function: Model.FunctionModel): Integer {
    if not function.declaration {
        return -1
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var words = function.name.split("_")
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var is_a_word = words.contains(parameter.name) or words.contains("{parameter.name}s")
        if not is_a_word and is_a_range(parameter.declared_type) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_a_range(written: SpiteCompiler.Type?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        var ranges = ["Spite.AttributeDeclaration", "Spite.FunctionDeclaration", "Spite.Argument"]
        return ranges.contains(path)
    }
    return false
}

func mistake_of_a_plain_function(
    context: HighIntermediaryRepresentation.Building.Context,
    plain: Model.FunctionModel,
    name: String,
): Validators.Answer {
    crash plain.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = plain.declaration
    var parameter_index = range_parameter_index(plain)
    var parameter = declaration.parameters[parameter_index]
    crash parameter
    var words = plain.name.split("_")
    crash words.remove_last()
    words.append(parameter.name)
    var template_name = words.join("_")
    var template_plural = template_name.pluralize()
    return mistake(
        context,
        "this class has no function '{name}': '{plain.name}' exists but is not a template, because its parameter '{parameter.name}' is not a word of its name: name it '{template_name}' and call '{template_plural}'",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

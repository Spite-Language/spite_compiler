func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    name: String,
): Validators.Answer {
    fallback not function
    var namespace = context.current_class.file.namespace
    var class_file = context.resolver.state.symbols.find(name, namespace)
    if class_file {
        var unknown_name = Validators.HighIntermediaryRepresentation.UnknownName.Validator()
        return unknown_name.refuse(context, name)
    }
    return mistake(context, "this class has no function '{name}'")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

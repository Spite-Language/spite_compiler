func check_a_dictionary_key(context: HighIntermediaryRepresentation.Building.Context, key: Model.Type) {
    if key.kind == 'union' {
        var union_shown = context.shown(key)
        var union_name = plain_name_of(union_shown)
        stopped(
            context,
            "a Dictionary cannot be keyed by '{union_name}': a key is a number, a Boolean, a String, an enum value or an object of a class",
        )
    }
    fallback key.kind == 'object' and not key.is_nullable and key.name != "String"
    fallback context.has_a_class(key)
    var keyed = context.class_of(key)
    fallback keyed.function_named("equals")
    var shown = context.shown(key)
    stopped(
        context,
        "a Dictionary keyed by '{shown}' finds each key by identity, one object one key, but '{shown}' declares 'equals', so an equal '{shown}' would not be found: key the dictionary by what 'equals' compares, a number or a String",
    )
}

func check_a_written_form(
    context: HighIntermediaryRepresentation.Building.Context,
    format_class: String,
    shown: String,
    reason: String,
) {
    fallback not reason.is_empty()
    var verb = "write"
    if format_class.ends_with("Reader") {
        verb = "read"
    }
    var handles = "{format_class} handles classes, lists, dictionaries, enums, numbers, Boolean, String and 'T?'"
    var advice = "so keep what it sees to those, or give it a class of its own that holds only them"
    stopped(context, "{format_class} cannot {verb} '{shown}': {reason}. {handles}, {advice}")
}

func check_a_nullable_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    shape: String,
    owner: String,
    generic_name: String,
) {
    fallback given.is_nullable
    var shown = context.shown(given)
    stopped(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it may be null, and null has none of what the type needs, so give a type that cannot be null",
    )
}

func check_a_filled_member(
    context: HighIntermediaryRepresentation.Building.Context,
    is_filled: Boolean,
    given: Model.Type,
    shape: String,
    owner: String,
    generic_name: String,
    member: String,
) {
    fallback not is_filled
    var shown = context.shown(given)
    stopped(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it has no function '{member}'",
    )
}

func plain_name_of(shown: String): String {
    if shown.contains("<") {
        return shown
    }
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

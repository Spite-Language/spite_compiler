func check(
    context: HighIntermediaryRepresentation.Building.Context,
    value: SpiteCompiler.Value,
    wanted: Model.Type,
): Validators.Answer {
    var walking = context.current_function
    fallback not walking.bound_parameter().is_empty()
    fallback wanted.kind == 'object' and wanted.name.starts_with("Spite.")
    fallback value.class == HighIntermediaryRepresentation.Values.TextConstant
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{walking.bound_parameter()}' is a reflection object known while compiling, so this function is compiled once for it, and it has no run-time value to pass on here",
    )
}

# ../../../../spite_documentation/control_flow.md#return-converts-to-the-functions-type
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
    built: List<SpiteCompiler.Statement>,
): Validators.Answer {
    var index = context.block_index
    fallback index > 0
    var before = context.block_statements[index - 1]
    if before.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        var carried = carried_value_of(built, before.line)
        return check_a_pair(context, before, returned, carried)
    }
    return Validators.Answer()
}

func check_a_pair(
    context: HighIntermediaryRepresentation.Building.Context,
    declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
    carried: SpiteCompiler.Value?,
): Validators.Answer {
    var value = returned.value
    var returns_the_name = false
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        returns_the_name = value.name == declared.name
    }
    fallback returns_the_name
    fallback context.current_function.declaration
    fallback context.current_function.declaration.result
    var types = Printers.Spite.TypePrinter(context.current_function.declaration.result)
    var result = types.text()
    if declared.declared_type {
        var declared_types = Printers.Spite.TypePrinter(declared.declared_type)
        var written = declared_types.text()
        fallback written == result
    }
    fallback declared.value
    fallback not makes_a_default(declared)
    fallback not loses_on_its_own_line(carried)
    var printer = Printers.Spite.ExpressionPrinter(declared.value)
    var computed = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake_at(
        context,
        declared.line,
        "'{declared.name}' is declared only to be returned on the next line: write 'return {computed}', since 'return' already makes the value the function's {result}",
    )
}

func makes_a_default(declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    fallback declared.declared_type
    fallback not declared.declared_type.is_nullable
    var value = declared.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return value.kind == 'keyword_null'
    }
    return false
}

# ../../../../spite_documentation/values_and_types.md#a-number-that-may-not-fit-is-narrowed
func loses_on_its_own_line(carried: SpiteCompiler.Value?): Boolean {
    if carried.class == HighIntermediaryRepresentation.Values.Conversion {
        return carried.kind == 'to_whole' or carried.kind == 'narrow_decimal'
    }
    return false
}

func carried_value_of(built: List<SpiteCompiler.Statement>, line: Integer): SpiteCompiler.Value? {
    var index = built.count() - 1
    while index >= 0 {
        var statement = built[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Declare and statement.line == line {
            return statement.value
        }
        index = index - 1
    }
    return null
}

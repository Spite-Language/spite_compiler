func check_a_caller_function(
    context: HighIntermediaryRepresentation.Building.Context,
    member: String,
    element_type: Model.Type?,
    caller_function: Model.FunctionModel?,
    element_shown: String,
    written: String,
    called: String,
): Validators.Answer {
    fallback member.is_empty() and element_type
    fallback caller_function
    fallback caller_function.parameters.count() == 1
    var parts = called.split(written)
    var prefix = parts.first()
    crash prefix
    var length = prefix.length()
    var form = prefix
    if prefix.ends_with("_") {
        var sliced_form = prefix.slice(0, length - 1)
        crash sliced_form
        form = sliced_form
    }
    return mistake(
        context,
        "'{element_shown}' has no attribute or zero argument function '{written}' for '{called}': a template reads a member of each element, never a function of this class, so pass this class's '{written}' instead: '{form}({written})'",
    )
}

func check_a_member_and_a_value(
    context: HighIntermediaryRepresentation.Building.Context,
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    element_type: Model.Type?,
    called: String,
    member: String,
    templates: HighIntermediaryRepresentation.Building.Templates,
): Validators.Answer {
    var questions = HighIntermediaryRepresentation.Building.Questions(context, templates.values)
    fallback questions.asks_a_question(template) and element_type
    var element_shown = element_class.shown
    var holders = templates.enum_members_listing(element_class, member)
    var holder = holders.first()
    fallback holder
    return mistake(
        context,
        "'{called}' could read the member '{member}' of '{element_shown}' or compare '{holder}' with '{member}', a value of its enum: rename the member '{member}'",
    )
}

func check_an_enum_value(
    context: HighIntermediaryRepresentation.Building.Context,
    holders: List<String>,
    element_type: Model.Type?,
    called: String,
    written: String,
    element_shown: String,
): Validators.Answer {
    if holders.count() > 1 {
        var first = holders[0]
        var second = holders[1]
        return mistake(
            context,
            "'{called}' could read '{first}' or '{second}', whose enums both list '{written}': write the comparison as a Boolean member of {element_shown}, or pass a function",
        )
    }
    fallback holders.is_empty() and element_type
    return mistake(
        context,
        "'{element_shown}' has no attribute or zero argument function '{written}' for '{called}', and no enum of its members lists '{written}'",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: SpiteCompiler.Value,
    name: String,
) {
    fallback left.value_type.kind == 'shape' and not left.value_type.is_nullable
    var shape = context.program.shape_keyed(left.value_type.name)
    crash shape
    fallback not shape.member_named(name)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var symbol = printer.operator_text(binary.operator)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{symbol}' on a value read as '{shape.name}' needs the class that fits the type, which is not known while compiling: take the value through a codegen value the type constrains, 'generic $value_type: {shape.name}'",
    )
}

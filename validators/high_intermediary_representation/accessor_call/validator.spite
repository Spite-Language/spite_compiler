func check(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
): Validators.Answer {
    var is_a_setter = callee.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = callee.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration
    var length = callee.name.length()
    var attribute_name = callee.name.slice(4, length)
    crash attribute_name
    fallback function.parameters.count() == call.arguments.count()
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{attribute_name}"
    if attribute_name == "this" {
        written = receiver_text
    }
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        return mistake_of(context, callee.name, "writing", attribute_name, "{written} = {assigned_text}")
    }
    return mistake_of(context, callee.name, "reading", attribute_name, written)
}

func check_a_written_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Validators.Answer {
    var is_a_read = callee.name == "get_attribute" and call.arguments.count() == 1
    var is_a_write = callee.name == "set_attribute" and call.arguments.count() == 2
    fallback is_a_read or is_a_write
    var named = call.arguments[0]
    if named.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return check_a_named_attribute(context, callee, call, named)
    }
    return Validators.Answer()
}

func check_a_named_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    named: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
): Validators.Answer {
    fallback named.kind == 'symbol_literal'
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{named.text}"
    if callee.name == "set_attribute" {
        var assigned = call.arguments[1]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        return mistake_of(context, callee.name, "writing", named.text, "{written} = {assigned_text}")
    }
    return mistake_of(context, callee.name, "reading", named.text, written)
}

func check_a_bare_call(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
): Validators.Answer {
    var is_a_setter = function.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = function.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration and context.current_function.name != function.name
    var path = context.path()
    var library = Mapping.LibraryFile()
    fallback not context.resolver.state.symbols.generated_texts[path] and not library.holds(path)
    var length = function.name.length()
    var attribute_name = function.name.slice(4, length)
    crash attribute_name
    fallback attribute_name != "this"
    fallback not context.current_class.attribute_named(attribute_name)
    var local = context.scope.internal_name_of(attribute_name)
    fallback not local
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        return mistake_of(context, function.name, "writing", attribute_name, "{attribute_name} = {assigned_text}")
    }
    return mistake_of(context, function.name, "reading", attribute_name, attribute_name)
}

func mistake_of(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    access: String,
    attribute_name: String,
    written: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "'{called_name}' is what {access} '{attribute_name}' calls: write '{written}'")
}

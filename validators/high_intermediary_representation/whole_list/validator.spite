func check(
    context: HighIntermediaryRepresentation.Building.Context,
    whole: Model.Type,
    list_type: Model.Type,
): Validators.Answer {
    fallback whole.name == list_type.name
    var shown = context.shown(list_type)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "this call passes a whole {shown}, but the last parameter is written with '...', so it takes the values one by one: pass the elements themselves, separated by commas",
    )
}

var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()

func check_a_nullable_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback given.answer and wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback given_answer.is_nullable and not wanted_answer.is_nullable
    var present = given_answer.present()
    fallback present.is_the_same_as(wanted_answer)
    var called_name = called_name_of(shown)
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    var article = every_rule.article_of(given_shown)
    var needed = wanted_shown
    var reason = ""
    if called_name.starts_with("sort_by") {
        needed = "something ordered, a number or a String"
        reason = ", and a value that may be null has no place in the order"
    }
    stopped(
        context,
        "'{called_name}({argument_text})': '{argument_text}' returns {article} {given_shown}, but '{called_name}' needs it to return {needed}{reason}: pass a function of your own that narrows it and returns the plain value",
    )
}

# ../../../PROOFS.md#a-member-template-fits
func check_a_passed_value(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
    owner: Model.ClassModel?,
) {
    fallback walks_the_function(context, owner)
    fallback given.kind != 'function' and wanted.kind == 'function' and argument
    var called_name = called_name_of(shown)
    fallback called_name == "each"
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    stopped(
        context,
        "'each' takes a function to call with each element, such as 'each(say_hello)' or 'each(greeter.say_hello)', and '{argument_text}' is not one",
    )
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
    owner: Model.ClassModel?,
    values: HighIntermediaryRepresentation.Building.Values,
) {
    fallback walks_the_function(context, owner)
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback not values.same_signature(given, wanted)
    var called_name = called_name_of(shown)
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    if given.parameters.count() != wanted.parameters.count() {
        check_a_count(context, called_name, argument_text, given, wanted)
    }
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        if not given_parameter.is_the_same_as(wanted_parameter) {
            var given_shown = context.shown(given_parameter)
            var wanted_shown = context.shown(wanted_parameter)
            stopped(
                context,
                "'{called_name}' calls '{argument_text}' with each '{wanted_shown}', but '{argument_text}' takes '{given_shown}'",
            )
        }
        index = index + 1
    }
    if given.answer and wanted.answer {
        check_another_answer(context, called_name, argument_text, given, wanted)
    }
    fallback wanted.answer and not given.answer
    var wanted_answer: Model.Type = wanted.answer
    var answer_shown = context.shown(wanted_answer)
    stopped(
        context,
        "'{called_name}({argument_text})': '{argument_text}' returns nothing, but '{called_name}' needs it to return {answer_shown}",
    )
}

func check_another_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    argument_text: String,
    given: Model.Type,
    wanted: Model.Type,
) {
    crash given.answer
    crash wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback not given_answer.is_the_same_as(wanted_answer)
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    var article = every_rule.article_of(given_shown)
    stopped(
        context,
        "'{called_name}({argument_text})': '{argument_text}' is {article} {given_shown}, but '{called_name}' needs it to return {wanted_shown}",
    )
}

func check_a_count(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    argument_text: String,
    given: Model.Type,
    wanted: Model.Type,
) {
    var takes = given.parameters.count()
    var gives = wanted.parameters.count()
    fallback gives != takes
    if gives == 1 {
        var only = wanted.parameters[0]
        crash only
        var only_shown = context.shown(only)
        stopped(
            context,
            "'{called_name}' calls '{argument_text}' with each '{only_shown}' as its only argument, but '{argument_text}' takes {takes}",
        )
    }
    stopped(
        context,
        "'{called_name}' calls '{argument_text}' with {gives} arguments, but '{argument_text}' takes {takes}",
    )
}

func called_name_of(shown: String): String {
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    return called_name
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func walks_the_function(context: HighIntermediaryRepresentation.Building.Context, owner: Model.ClassModel?): Boolean {
    fallback owner
    return context.resolver.state.symbols.is_library_path(owner.file.path)
}

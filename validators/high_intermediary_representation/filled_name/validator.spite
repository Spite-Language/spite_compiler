var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: Model.ClassModel,
    written: String,
    filled: String,
    word: String,
): Validators.Answer {
    fallback written != filled
    var written_function = owner.function_named(written)
    var filled_function = owner.function_named(filled)
    fallback written_function and filled_function
    var shown = generic_constraint.plain_name_of(owner.shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{written}' names two functions of '{shown}' here: the template fills '{word}' and calls '{filled}', and '{written}' is a function of its own: rename that function or the template's parameter '{word}'",
    )
}

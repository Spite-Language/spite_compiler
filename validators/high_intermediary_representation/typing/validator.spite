func refuse_missing_read_member(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    name: String,
    verb: String,
    hint: String,
) {
    var article = article_of(shown)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), so '{name}' cannot be {verb} it yet: {narrowing}",
    )
}

func refuse_missing_read_needed(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    wanted: String,
    hint: String,
) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), but {wanted_article} {wanted} is needed: {narrowing}",
    )
}

func narrowing_lines(path: String, hint: String): String {
    return "narrow it first with 'crash {path}', 'fallback {path}' or 'if {path} \{ }'{hint}"
}

func check_member_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    owner: String,
    member_shown: String,
    is_a_function: Boolean,
) {
    var prefix = ""
    var needs = ""
    var advice = ""
    var is_a_member_number = is_a_number(member_shown)
    if called.starts_with("sum_") and not is_a_member_number {
        prefix = "sum_"
        needs = "to return a numeric type"
    }
    if called.starts_with("count_") and is_a_member_number {
        prefix = "count_"
        needs = "to return Boolean"
        advice = " (to add up a numeric member use 'sum_{member}')"
    }
    if called.starts_with("each_") and not is_a_function {
        prefix = "each_"
        needs = "to be a function"
        advice = ": reading an attribute and discarding it does nothing"
    }
    if called.starts_with("map_") and member_shown == "nothing" {
        refuse_a_map_of_nothing(context, called, member, owner)
    }
    if called.starts_with("sort_by_") and member_shown == "Boolean" {
        prefix = "sort_by_"
        needs = "to return something ordered: a number or a String"
    }
    var test_prefix = test_prefix_of(called)
    if not test_prefix.is_empty() and member_shown != "Boolean" {
        prefix = test_prefix
        needs = "to return Boolean"
    }
    fallback not prefix.is_empty()
    var article = article_of(member_shown)
    stop(
        context,
        "'{called}': the member '{member}' of '{owner}' is {article} {member_shown}, but '{prefix}' needs it {needs}{advice}",
    )
}

# ../../../PROOFS.md#a-member-template-fits
func refuse_a_map_of_nothing(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    owner: String,
) {
    stop(
        context,
        "'{called}': the member '{member}' of '{owner}' returns nothing, but 'map_' needs it to return a value (to only call it for each element, write 'each_{member}()')",
    )
}

func test_prefix_of(called: String): String {
    var prefixes = ["filter_", "any_", "all_"]
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        if called.starts_with(prefix) {
            return prefix
        }
        index = index + 1
    }
    return ""
}

func refuse_walked_kind(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: String,
    attribute: String,
    shown: String,
    walks_declarations: Boolean,
) {
    if walks_declarations {
        stop(
            context,
            "'{walker}' takes a 'Spite.Attribute', an attribute bound to an instance, and '{attribute}' here is a declaration of '{shown}', which has no value: declare the parameter 'Spite.AttributeDeclaration', or walk an instance's attributes",
        )
    }
    stop(
        context,
        "'{walker}' takes a 'Spite.AttributeDeclaration', the declaration of an attribute, and '{attribute}' here is an attribute bound to an instance of '{shown}': declare the parameter 'Spite.Attribute', or walk the class's attributes",
    )
}

func refuse_a_template_walk(context: HighIntermediaryRepresentation.Building.Context, listed: String, name: String) {
    stop(
        context,
        "this 'while' walks every element of '{listed}' only to call '{name}' on each: write '{listed}.each_{name}()'",
    )
}


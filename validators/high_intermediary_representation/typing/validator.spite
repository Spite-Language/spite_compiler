func refuse_mismatch(context: HighIntermediaryRepresentation.Building.Context, given: String, wanted: String) {
    var given_article = article_of(given)
    var wanted_article = article_of(wanted)
    stop(context, "{given_article} {given} cannot be used where {wanted_article} {wanted} is needed")
}

# ../../../../spite_spec/specs/values_and_types.md#unions-in-full
func refuse_a_union_member_missing(
    context: HighIntermediaryRepresentation.Building.Context,
    given: String,
    wanted: String,
    missing: List<String>,
) {
    fallback not missing.is_empty()
    var listed = missing.join("', '")
    var member_word = "is a member"
    if missing.count() > 1 {
        member_word = "are members"
    }
    stop(
        context,
        "a {given} cannot be used where a {wanted} is needed: '{listed}' {member_word} of {given} and not of {wanted}, and a union fits another only when every member of it is a member of the other: add '{listed}' to {wanted}, or pass the member value itself",
    )
}

# ../../../../spite_spec/specs/values_and_types.md#unions-in-full
func refuse_a_smaller_union_inside(
    context: HighIntermediaryRepresentation.Building.Context,
    given: String,
    wanted: String,
    inside: String,
    wanted_inside: String,
) {
    stop(
        context,
        "a {given} cannot be used where a {wanted} is needed: {inside} has fewer members than {wanted_inside}, and the receiver could put in it a member {inside} lacks: declare {inside} with the same members as {wanted_inside}, or make a {wanted}",
    )
}

# ../../../../spite_spec/specs/values_and_types.md#casting
func refuse_a_missing_conversion(
    context: HighIntermediaryRepresentation.Building.Context,
    given: String,
    wanted: String,
) {
    var given_article = article_of(given)
    var wanted_article = article_of(wanted)
    var segments = wanted.split(".")
    var made = segments.last()
    crash made
    stop(
        context,
        "{given_article} {given} cannot be used where {wanted_article} {wanted} is needed: a value is cast to the class a place wants through that class's conversion, and {wanted} declares no '{made}(from: {given})'",
    )
}

func refuse_a_specialised_value(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is a reflection object known while compiling, so this function is compiled once for it, and it has no run-time value to pass on here",
    )
}


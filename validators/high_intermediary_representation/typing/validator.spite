func refuse_mismatch(context: HighIntermediaryRepresentation.Building.Context, given: String, wanted: String) {
    stop(context, "a {given} cannot be used where a {wanted} is needed")
}

func refuse_maybe_null(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    var article = article_of(shown)
    stop(
        context,
        "this value may be null (it is {article} {shown}): narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
    )
}

func refuse_maybe_null_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    var article = article_of(shown)
    stop(
        context,
        "this value may be null (it is {article} {shown}), so '{name}' cannot be read from it yet: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
    )
}

func refuse_maybe_null_needed(context: HighIntermediaryRepresentation.Building.Context, shown: String, wanted: String) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    stop(
        context,
        "this value may be null (it is {article} {shown}), but {wanted_article} {wanted} is needed: narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
    )
}

func refuse_missing_read_member(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    name: String,
    verb: String,
    hint: String,
) {
    var article = article_of(shown)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), so '{name}' cannot be {verb} it yet: {narrowing}",
    )
}

func refuse_missing_read_needed(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    wanted: String,
    hint: String,
) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), but {wanted_article} {wanted} is needed: {narrowing}",
    )
}

func narrowing_lines(path: String, hint: String): String {
    return "narrow it first with 'crash {path}', 'assert {path}' or 'if {path} \{ }'{hint}"
}

func check_member_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    owner: String,
    member_shown: String,
    is_a_function: Boolean,
) {
    var prefix = ""
    var needs = ""
    var advice = ""
    var is_a_member_number = is_a_number(member_shown)
    if called.starts_with("sum_") and not is_a_member_number {
        prefix = "sum_"
        needs = "to return a numeric type"
    }
    if called.starts_with("count_") and is_a_member_number {
        prefix = "count_"
        needs = "to return Boolean"
        advice = " (to add up a numeric member use 'sum_{member}')"
    }
    if called.starts_with("each_") and not is_a_function {
        prefix = "each_"
        needs = "to be a function"
        advice = ": reading an attribute and discarding it does nothing"
    }
    assert not prefix.is_empty()
    var article = article_of(member_shown)
    stop(
        context,
        "'{called}': the member '{member}' of '{owner}' is {article} {member_shown}, but '{prefix}' needs it {needs}{advice}",
    )
}

func refuse_walked_kind(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: String,
    attribute: String,
    shown: String,
    walks_declarations: Boolean,
) {
    if walks_declarations {
        stop(
            context,
            "'{walker}' takes a 'Spite.Attribute', an attribute bound to an instance, and '{attribute}' here is a declaration of '{shown}', which has no value: declare the parameter 'Spite.AttributeDeclaration', or walk an instance's attributes",
        )
    }
    stop(
        context,
        "'{walker}' takes a 'Spite.AttributeDeclaration', the declaration of an attribute, and '{attribute}' here is an attribute bound to an instance of '{shown}': declare the parameter 'Spite.Attribute', or walk the class's attributes",
    )
}

func refuse_a_template_walk(context: HighIntermediaryRepresentation.Building.Context, listed: String, name: String) {
    stop(
        context,
        "this 'while' walks every element of '{listed}' only to call '{name}' on each: write '{listed}.each_{name}()'",
    )
}

func refuse_a_function_walk(context: HighIntermediaryRepresentation.Building.Context, listed: String, name: String) {
    stop(
        context,
        "this 'while' walks every element of '{listed}' only to call '{name}' with each: write '{listed}.each({name})'",
    )
}

func refuse_singular_template(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    called_plural: String,
) {
    stop(context, "'{called}' answers every '{member}', so it is written in the plural: '{called_plural}'")
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func refuse_null_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "'null' has no type here: it is written only where a type that may be null is expected, like 'var target: Monster? = null'",
    )
}

func refuse_symbol_without_an_enum(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is a symbol, and nothing here says which enum it belongs to: write it where an enum is expected",
    )
}

func refuse_not_a_value(context: HighIntermediaryRepresentation.Building.Context, name: String, enum_name: String) {
    stop(context, "'{name}' is not a value of the enum '{enum_name}'")
}

func refuse_unknown_name(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    var scalars = Model.Scalars()
    if name == "_memory" and scalars.is_a_scalar(namespace) {
        stop(
            context,
            "'_memory' is the memory {namespace} is kept in, and the compiler keeps the value itself there: write 'this'",
        )
    }
    var class_file = context.resolver.symbols.find(name, namespace)
    if class_file {
        stop(
            context,
            "'{name}' is a class, not a value: write '{name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    }
    stop(context, "'{name}' is not a local, an attribute or a function of '{context.current_class.shown}'")
}

func refuse_unknown_function(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    var class_file = context.resolver.symbols.find(name, namespace)
    if class_file {
        refuse_unknown_name(context, name)
    }
    stop(context, "this class has no function '{name}'")
}

func refuse_two_enum_members(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    first: String,
    second: String,
    value: String,
    shown: String,
) {
    stop(
        context,
        "'{called}' could read '{first}' or '{second}', whose enums both list '{value}': write the comparison as a Boolean member of {shown}, or pass a function",
    )
}

func refuse_unknown_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    var advice = advice_for_member(shown, name)
    if not advice.is_empty() {
        stop(context, advice)
    }
    var article = article_of(shown)
    stop(context, "{article} {shown} has no attribute or function '{name}'")
}

func advice_for_member(shown: String, name: String): String {
    if is_a_number(shown) {
        return number_advice(shown, name)
    }
    if shown == "String" and (name == "upper" or name == "lower") {
        return "text has no '{name}()': write '{name}_case()', which names what it does without abbreviating"
    }
    if shown.starts_with("List<") {
        return list_advice(name)
    }
    if shown.starts_with("Vector<") and name == "each" {
        var shown_length = shown.length()
        var element = shown.slice(7, shown_length)
        if element != "String>" {
            return "'each' passes each item to a function, and an item of a Vector is borrowed from it, never passed on: give the item's class a function and call it with a member template, such as 'each_<function>()'"
        }
        return "'each' passes each item to a function, which a Vector never does: keep the values in a 'List<{element}' to pass them on"
    }
    if shown.starts_with("Items<") and name == "each" {
        return "'each' passes each item to a function, which Items never does, whichever storage it chose: give the item's class a function and call it with a member template, such as 'each_<function>()'"
    }
    return ""
}

func is_a_number(shown: String): Boolean {
    var numbers = [
        "Tiny"
        "Short"
        "Integer"
        "Long"
        "UnsignedTiny"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
    ]
    return numbers.contains(shown)
}

func number_advice(shown: String, name: String): String {
    if name == "text" {
        return "{shown} turns into text with 'to_string()', a cast like 'to_integer()': write 'to_string()'"
    }
    var bitwise = [
        "shifted_left"
        "shifted_right"
        "bits_and"
        "bits_or"
        "bits_exclusive_or"
        "bits_inverted"
        "set_bit_count"
        "leading_zero_count"
        "trailing_zero_count"
    ]
    if bitwise.contains(name) {
        var article = article_of(shown)
        return "{article} {shown} has no function '{name}': the bitwise functions are on the whole numbers, Tiny to UnsignedLong. Cast it first, like 'var whole: Long = value'"
    }
    var is_decimal = shown == "Float" or shown == "Double"
    if not is_decimal {
        return ""
    }
    var spelling = maths_spelling(name)
    if spelling.is_empty() {
        return ""
    }
    return "{shown} has no function '{name}': Spite spells it '{spelling}', since no name is abbreviated"
}

func maths_spelling(name: String): String {
    var others = [
        "sqrt"
        "sin"
        "cos"
        "tan"
        "asin"
        "acos"
        "atan"
        "atan2"
        "pow"
        "exp"
        "log"
        "log2"
        "log10"
        "ln"
        "ceil"
        "trunc"
        "abs"
        "fabs"
        "min"
        "max"
        "is_nan"
        "isnan"
        "is_infinity"
        "isinf"
        "isfinite"
    ]
    var spellings = [
        "square_root"
        "sine"
        "cosine"
        "tangent"
        "arc_sine"
        "arc_cosine"
        "arc_tangent"
        "arc_tangent_over"
        "power"
        "exponential"
        "logarithm"
        "logarithm_base_2"
        "logarithm_base_10"
        "logarithm"
        "ceiling"
        "truncate"
        "absolute"
        "absolute"
        "minimum"
        "maximum"
        "is_not_a_number"
        "is_not_a_number"
        "is_infinite"
        "is_infinite"
        "is_finite"
    ]
    var index = 0
    while index < others.count() {
        if others[index] == name {
            crash spellings[index]
            return spellings[index]
        }
        index = index + 1
    }
    return ""
}

func list_advice(name: String): String {
    switch name {
        "map": return "there is no 'map(function)': collect a member of each element with 'map_<member>()', and a value computed from each element by giving the element's class a read-only attribute (a 'get_<name>()' with no setter) and writing 'map_<name>()'"
        "add": return "List has no method 'add', which does not say where: write 'append' to add at the end, or 'prepend' at the start"
        "pop": return "List has no method 'pop': write 'remove_last()', or 'remove_first()' to take from the start"
        _: return ""
    }
}

func refuse_read_only(context: HighIntermediaryRepresentation.Building.Context, owner: String, name: String) {
    var segments = owner.split(".")
    var last = segments.count() - 1
    var simple_name = segments[last]
    crash simple_name
    stop(context, "'{name}' is read-only: '{simple_name}' answers it through get_{name}() and has no set_{name}(value)")
}

func refuse_not_a_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
) {
    stop(context, "'{shown}' does not fit type '{shape}': it has no function '{member}'")
}

func refuse_cut_operand(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    operation: String,
    left: String,
    right: String,
) {
    stop(
        context,
        "'{shown}' is {operation} in {left}, since arithmetic takes the left side's type, and the right side is a {right}, which would be cut to fit: store the left side in a {right} first ('var wide: {right} = ...'), or store the right side in a {left} first if it fits one",
    )
}

func refuse_an_accessor_call(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    access: String,
    attribute_name: String,
    written: String,
) {
    stop(context, "'{called_name}' is what {access} '{attribute_name}' calls: write '{written}'")
}

func refuse_an_unknown_generic_class(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "there is no generic class '{written}' here: a name is looked up in this class's own namespace, its folder, each parent folder, then the whole program",
    )
}

func refuse_a_nullable_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    argument_text: String,
    given_shown: String,
    wanted_shown: String,
) {
    var article = article_of(given_shown)
    var needed = wanted_shown
    var reason = ""
    if called_name.starts_with("sort_by") {
        needed = "something ordered, a number or a String"
        reason = ", and a value that may be null has no place in the order"
    }
    stop(
        context,
        "'{called_name}({argument_text})': '{argument_text}' returns {article} {given_shown}, but '{called_name}' needs it to return {needed}{reason}: pass a function of your own that narrows it and returns the plain value",
    )
}

func refuse_a_removal_from_a_chain(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    shown: String,
) {
    stop(
        context,
        "'{name}' removes from the collection it is called on, and '{shown}' makes a new one that nothing keeps: call it on the collection itself, with one test that says everything to remove",
    )
}

func refuse_a_wider_bitwise_operand(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    receiver_text: String,
    receiver_name: String,
    operand_text: String,
    operand_name: String,
) {
    var receiver_article = article_of(receiver_name)
    var operand_article = article_of(operand_name)
    stop(
        context,
        "'{shown}' works in {receiver_article} {receiver_name}, since a bitwise function takes its receiver's type, and '{operand_text}' is {operand_article} {operand_name}, which would be cut to fit: store the receiver in {operand_article} {operand_name} first ('var wide: {operand_name} = {receiver_text}'), or store '{operand_text}' in {receiver_article} {receiver_name} first if it fits one",
    )
}

func refuse_an_unwritten_question(
    context: HighIntermediaryRepresentation.Building.Context,
    asked: String,
    question: String,
    example: String,
) {
    stop(
        context,
        "'{asked}.{question}(...)' is decided while compiling, so the name it asks for is written as a literal: '{asked}.{question}(\"{example}\")', or a pattern such as \"<phase>_each\"",
    )
}

func refuse_an_unwritten_parameter(context: HighIntermediaryRepresentation.Building.Context, asked: String) {
    stop(
        context,
        "'{asked}.function_writes_parameter(...)' is decided while compiling, so it takes the function's name as text and the parameter's number, counted from 0, as a literal: '{asked}.function_writes_parameter(\"last_each\", 1)'",
    )
}

func refuse_a_missing_parameter(
    context: HighIntermediaryRepresentation.Building.Context,
    asked: String,
    count: Integer,
    place: Integer,
) {
    stop(
        context,
        "'{asked}' takes {count} arguments, so it has no parameter {place} to ask about: 'function_writes_parameter' counts parameters from 0",
    )
}

func refuse_function_value_member(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    name: String,
) {
    stop(context, "'{shown}' has no attribute '{name}'")
}

func refuse_an_unnamed_function_value(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'.{name}' of a function value is read where the compiler knows its function: name the function in a 'var' that is never assigned again, as in 'var shout = shouter.shout', and read 'shout.{name}'",
    )
}

func refuse_function_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    stop(context, "'{shown}' has no attribute '{name}'")
}

func refuse_constant_on_value(context: HighIntermediaryRepresentation.Building.Context, owner: String, name: String) {
    stop(context, "'{name}' is a constant of the class {owner}, not of a value: write '{owner}.{name}'")
}

func refuse_constant_without_a_header(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is a constant, and a constant comes from the library's header: name it as DynamicLibrary's third argument",
    )
}

func refuse_an_unread_header(context: HighIntermediaryRepresentation.Building.Context, name: String, header: String) {
    stop(
        context,
        "'{name}' is a constant of the header '{header}', which is not a file the compiler can read: name the header by its path from the folder the compiler runs in",
    )
}

func refuse_an_unknown_constant(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
) {
    var upper = name.upper_case()
    stop(context, "'{name}' is read as the constant '{upper}', and the header '{header}' has no '#define {upper}'")
}

func refuse_an_unread_constant(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    header: String,
    written: String,
) {
    stop(
        context,
        "'{name}' is '{written}' in the header '{header}', which is not a whole number written in decimal: only such a constant can be read",
    )
}

func refuse_constant_assigned(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(context, "'{written}' is a constant, and a constant is get-only: nothing can assign it")
}

func refuse_cast_by_name(context: HighIntermediaryRepresentation.Building.Context, written: String, name: String) {
    var names = Mapping.Names()
    var name_length = name.length()
    var source_name = name.slice(5, name_length)
    var source = names.class_name_of(source_name)
    var article = article_of(source)
    var reader = names.snake_case_of(written)
    stop(
        context,
        "there is no '{written}.{name}()': a conversion belongs to the value converted, so write 'value.to_{reader}()' on {article} {source}, or cast by assignment: 'var converted: {written} = value'",
    )
}

func refuse_copy_to_narrow(context: HighIntermediaryRepresentation.Building.Context, name: String, source: String) {
    stop(
        context,
        "'{name}' only copies '{source}' so it can be narrowed: narrow '{source}' itself ('assert {source}') and use it directly",
    )
}

func refuse_proven_check(context: HighIntermediaryRepresentation.Building.Context, written: String, check: String) {
    stop(context, "'{written}' is already narrowed by {check}: remove this check")
}

func refuse_proven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    check: String,
    keyword: String,
) {
    stop(context, "'{written}' is already proven by {check}, so this '{keyword}' proves nothing: remove it")
}

func refuse_undone_loop_proof(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "assigning to '{written}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
    )
}

func refuse_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    item: String,
    listed: String,
    value: String,
) {
    stop(
        context,
        "'{name}' was read from '{item}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{listed}' still holds the old item. Write '{item} = {value}' to replace the item, or give the new value a 'var' of its own",
    )
}

func refuse_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    attribute: String,
    article: String,
    shown: String,
) {
    stop(
        context,
        "'{name}.{attribute}' is written here and '{name}' is never read after it: '{name}' is {article} '{shown}' only this function holds, so the write is lost when it is let go. Use what was written, return '{name}', keep it in an attribute or a list, or drop the write",
    )
}

func refuse_parallel_reach(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    function_name: String,
    owner: String,
    name: String,
    shown: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "'{written}' runs '{function_name}' on another thread, so it may reach only the attributes of its own '{owner}' that hold values, its locals and singletons: '{name}' holds {article} {shown}, which another thread may share. Give the work what it needs as numbers or text of its own, or make an object for the work alone that nothing else holds or touches after 'Parallel(...)'",
    )
}

func refuse_shared_value_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    name: String,
    owner: String,
) {
    stop(
        context,
        "'{written}' writes '{name}' of this '{owner}' on another thread while this thread may write it too, so one write would be lost: move the work into a class of its own and hand a new one over ('var worker = Worker(...)' then 'Parallel(worker.work)'), answer the value from the work and read the task's result, or keep it in a singleton, which is made safe for threads",
    )
}

func refuse_handed_over_use(
    context: HighIntermediaryRepresentation.Building.Context,
    holder: String,
    written: String,
    kept: String,
    owner: String,
) {
    stop(
        context,
        "'{holder}' was handed to '{written}', which {kept} on another thread, so it is not used after that line: make another '{owner}' for what follows, or read the task's result",
    )
}

func refuse_weak_across_threads(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    shown: String,
) {
    stop(
        context,
        "'{written}' runs on another thread, and what it runs reaches '{shown}', which is a Weak or is held by one: a Weak is kept in one table that is not shared between threads, so a Weak and the objects it holds stay on the program's own thread. Hold the object itself in the work, or keep the Weak out of what the Parallel reaches",
    )
}

func refuse_a_weak_value(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Weak holds an object of a class without counting it, and '{shown}' is kept by value, so there is nothing to hold weakly: keep the value itself, or hold weakly the object it belongs to",
    )
}

func refuse_unstepped_poll(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "this loop reads '{name}.finished' and calls nothing, so nothing steps '{name}' between two reads and it never finishes: read its value instead ('var done: T = {name}' waits for it), or call something that waits in the loop",
    )
}

func refuse_parallel_each_reach(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    owner: String,
    name: String,
    shown: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "'{called}' runs '{member}' on many elements at once, so it may reach only its own '{owner}' attributes that hold values, and its locals: '{name}' holds {article} '{shown}', which another element may share. Copy what the pass needs into a number or text attribute first, or write 'each_{member}' to run it on one thread",
    )
}

func refuse_terminal_if(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "this 'if' is the last thing the function does and has no 'else', so it only checks that '{written}' is there: write 'assert {written}' and let the rest of the function run unindented",
    )
}

func refuse_constraint(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    owner: String,
    generic_name: String,
    member: String,
) {
    stop(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it has no function '{member}'",
    )
}

func refuse_whole_list(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "this call passes a whole {shown}, but the last parameter is written with '...', so it takes the values one by one: pass the elements themselves, separated by commas",
    )
}

func refuse_unsized_type(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "'{written}.size' is the size of the C struct a type is at a foreign call, and only a type whose attributes are all numbers is one",
    )
}

func refuse_maybe_boolean(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "this is a Boolean? used by a condition, which would only test that it is there, not that it is true: prove it is there first ('crash index < flags.count()' proves 'flags[index]') or switch over it",
    )
}

func refuse_folded_crash(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    var shown = context.current_class.shown
    var place = ""
    if shown.contains("<") {
        place = " in {shown}"
    }
    stop(
        context,
        "'crash {written}' always halts{place}: its condition is decided while compiling and is false, so the program would stop here every time this function runs: call it only where the condition holds, or change what the condition asks",
    )
}

func refuse_vector_item(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    attribute: String,
    attribute_shown: String,
) {
    var article = article_of(attribute_shown)
    stop(
        context,
        "'{shown}' cannot be an item of a Vector: its attribute '{attribute}' is {article} {attribute_shown}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{shown}' in a 'List<{shown}>', or keep '{attribute}' somewhere else)",
    )
}

func refuse_equal_keys(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Dictionary keyed by '{shown}' finds each key by identity, one object one key, but '{shown}' declares 'equals', so an equal '{shown}' would not be found: key the dictionary by what 'equals' compares, a number or a String",
    )
}

func refuse_no_members(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "a {shown} has no attributes or functions to reach with '.'")
}

func refuse_not_callable(context: HighIntermediaryRepresentation.Building.Context, name: String, shown: String) {
    stop(context, "'{name}' is a {shown}, not a function, so it cannot be called")
}

func refuse_argument_count(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
) {
    stop(context, "'{shown}' takes {wanted} arguments, and {given} are given")
}

func refuse_list_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "this list's type cannot be read from its first item: declare it, 'var items: List<Item> = [...]'")
}

func refuse_not_indexed(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "a {shown} is not indexed with [ ]: only a class that declares 'get_at' is")
}

func refuse_not_a_condition(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a condition is a Boolean, and this is a {shown}: compare it with something, like 'count > 0' or 'name != \"\"'",
    )
}

func refuse_missing_answer(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "'{context.current_function.name}' answers a {shown}, so 'return' needs a value")
}

func refuse_answer_from_nothing(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "'{context.current_function.name}' answers nothing, so 'return' takes no value")
}

func refuse_not_assignable(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "only a local, an attribute or an index is assigned with '='")
}

func refuse_default_answer(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "this 'assert' would answer a default {shown} that a caller cannot tell from a real one: make the result '{shown}?', or 'crash' if this is a developer mistake",
    )
}

func refuse_unused_answer(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "a line on its own is a call that answers nothing, and this answers a value: use it, or call something that answers nothing",
    )
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var failure = Validators.Failure()
    var path = context.path()
    var owner = plain_class_name(context.current_class.shown)
    failure.stop_inside(path, context.line, owner, context.current_function.name, text)
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if opening < 0 {
        return shown
    }
    return shown.slice(0, opening)
}

func refuse_text_given(
    context: HighIntermediaryRepresentation.Building.Context,
    shown_given: String,
    shown_wanted: String,
    is_an_enum: Boolean,
) {
    assert shown_given == "String"
    var segments = shown_wanted.split(".")
    var last = segments.count() - 1
    var label = segments[last]
    crash label
    var names = Mapping.Names()
    var reading = names.snake_case_of(label)
    var article = article_of(label)
    if is_an_enum {
        stop(
            context,
            "text is not {article} {label} until it is read as one, and text that names none of its values has none to give: read it with 'to_{reading}()', which answers '{label}?', null when the text names none of its values, and narrow it, or declare the value '{label}?'",
        )
    }
    assert is_a_number(shown_wanted)
    stop(
        context,
        "text is not {article} {label} until it is read as one, and text that is not a number has none to give: read it with 'to_{reading}()', which answers '{label}?', null when the text is not a number that fits, and narrow it, or declare the value '{label}?'",
    )
}

func refuse_symbol_for_text(context: HighIntermediaryRepresentation.Building.Context, name: String, wanted: String) {
    assert wanted == "String"
    stop(
        context,
        "'{name}' in single quotes is a symbol, and text is wanted here: text is always written in double quotes, so write \"{name}\"",
    )
}

func refuse_literal_range(
    context: HighIntermediaryRepresentation.Building.Context,
    number: Long,
    type_name: String,
    size: Integer,
    is_signed: Boolean,
) {
    assert size < 8
    var values: Long = 1
    var remaining = size * 8
    while remaining > 0 {
        values = values * 2
        remaining = remaining - 1
    }
    var lowest: Long = 0
    var highest = values - 1
    if is_signed {
        highest = values / 2 - 1
        lowest = lowest - values / 2
    }
    var largest_written = highest
    if is_signed {
        largest_written = highest + 1
    }
    assert number > largest_written
    var article = article_of(type_name)
    stop(
        context,
        "{number} does not fit in {article} {type_name}, whose numbers run from {lowest} to {highest}: store it in a wider type, or use a number that fits",
    )
}

func refuse_division_by_zero(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "'{shown}' divides by zero, which always halts the program: a whole number cannot be divided by zero, so divide by something else, or leave the step out",
    )
}

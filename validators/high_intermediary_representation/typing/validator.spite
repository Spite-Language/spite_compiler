    )
}

func refuse_a_nullable_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    argument_text: String,
    given_shown: String,
    wanted_shown: String,
) {
    var article = article_of(given_shown)
    var needed = wanted_shown
    var reason = ""
    if called_name.starts_with("sort_by") {
        needed = "something ordered, a number or a String"
        reason = ", and a value that may be null has no place in the order"
    }
    stop(
        context,
        "'{called_name}({argument_text})': '{argument_text}' returns {article} {given_shown}, but '{called_name}' needs it to return {needed}{reason}: pass a function of your own that narrows it and returns the plain value",
    )
}


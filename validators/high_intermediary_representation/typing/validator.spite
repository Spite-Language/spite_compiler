func is_a_number(shown: String): Boolean {
    var numbers = [
        "Tiny"
        "Short"
        "Integer"
        "Long"
        "UnsignedTiny"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
    ]
    return numbers.contains(shown)
}

func refuse_read_only(context: HighIntermediaryRepresentation.Building.Context, owner: String, name: String) {
    var segments = owner.split(".")
    var last = segments.count() - 1
    var simple_name = segments[last]
    crash simple_name
    stop(context, "'{name}' is read-only: '{simple_name}' answers it through get_{name}() and has no set_{name}(value)")
}


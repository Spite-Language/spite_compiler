        context,
        "'{called}' could collect every '{singular}', whose plural is '{written}', or the member '{plural}' itself: rename one of the two members so that each template names one",
    )
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func refuse_null_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "'null' has no type here: it is written only where a type that may be null is expected, like 'var target: Monster? = null'",
    )
}

func refuse_symbol_without_an_enum(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is an enum value literal, and no enum is expected here: declare the enum it belongs to and write it where that enum is expected",
    )
}

func refuse_not_a_value(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    enum_name: String,
    values: List<String>,
) {
    var quoted = List<String>()
    var index = 0
    while index < values.count() {
        var value = values[index]
        quoted.append("'{value}'")
        index = index + 1
    }
    var listed = quoted.join(", ")
    stop(context, "'{name}' is not a value of the enum '{enum_name}', whose values are {listed}")
}

func refuse_unknown_name(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    var scalars = Model.Scalars()
    if name == "_memory" and scalars.is_a_scalar(namespace) {
        stop(
            context,
            "'_memory' is the memory {namespace} is kept in, and the compiler keeps the value itself there: write 'this'",
        )
    }
    var class_file = context.resolver.symbols.find(name, namespace)
    if class_file {
        stop(
            context,
            "'{name}' is a class, not a value: write '{name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    }
    stop(context, "'{name}' is not a local, an attribute or a function of '{context.current_class.shown}'")
}

func refuse_unknown_function(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    var class_file = context.resolver.symbols.find(name, namespace)
    if class_file {
        refuse_unknown_name(context, name)
    }
    stop(context, "this class has no function '{name}'")
}

func refuse_a_test_to_collect(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    shown: String,
) {
    stop(
        context,
        "'{called}': the member '{member}' of '{shown}' is a Boolean, but 'map_' needs it to be a value to collect, not a test: write 'filter_{member}()' to keep the elements it is true for, 'count_{member}()' to count them, or 'any_{member}()' or 'all_{member}()' to ask whether any or all of them pass",
    )
}

func refuse_a_caller_function(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    member: String,
    called: String,
) {
    var parts = called.split(member)
    var prefix = parts.first()
    crash prefix
    var length = prefix.length()
    var form = prefix
    if prefix.ends_with("_") {
        var sliced_form = prefix.slice(0, length - 1)
        crash sliced_form
        form = sliced_form
    }
    stop(
        context,
        "'{shown}' has no attribute or zero argument function '{member}' for '{called}': a template reads a member of each element, never a function of this class, so pass this class's '{member}' instead: '{form}({member})'",
    )
}


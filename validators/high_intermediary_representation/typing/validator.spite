    shown: String,
    member: String,
) {
    if shown == member {
        stop(context, "'{tested}' is a {shown} here, so this test is decided while compiling: remove it")
    }
    stop(
        context,
        "'{tested}' is a {shown} here, so it is never {member} and this test is decided while compiling: remove it",
    )
}

func refuse_proven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    check: String,
    keyword: String,
) {
    stop(context, "'{written}' is already proven by {check}, so this '{keyword}' proves nothing: remove it")
}

func refuse_undone_loop_proof(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "assigning to '{written}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
    )
}

func refuse_a_replaced_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    item: String,
    owner: String,
    answered_by: String,
    writer: String,
    attribute: String,
) {
    var replacing = "a function of '{owner}' that writes '{item}'"
    if not writer.is_empty() {
        replacing = "'{owner}.{writer}', which writes '{attribute}'"
    }
    stop(
        context,
        "'{name}' holds '{item}' of '{owner}', answered by '{answered_by}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{owner}' still holds the old item. Replace it through {replacing}, or give the new value a 'var' of its own",
    )
}

func refuse_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    item: String,
    listed: String,
    value: String,
) {
    stop(
        context,
        "'{name}' was read from '{item}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{listed}' still holds the old item. Write '{item} = {value}' to replace the item, or give the new value a 'var' of its own",
    )
}

func refuse_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    attribute: String,
    article: String,
    shown: String,
) {
    stop(
        context,
        "'{name}.{attribute}' is written here and '{name}' is never read after it: '{name}' is {article} '{shown}' only this function holds, so the write is lost when it is let go. Use what was written, return '{name}', keep it in an attribute or a list, or drop the write",
    )
}

func refuse_parallel_reach(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    function_name: String,
    owner: String,
    name: String,
    shown: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "'{written}' runs '{function_name}' on another thread, so it may reach only the attributes of its own '{owner}' that hold values, its locals and singletons: '{name}' holds {article} {shown}, which another thread may share. Give the work what it needs as numbers or text of its own, or make an object for the work alone that nothing else holds or touches after 'Parallel(...)'",
    )
}

func refuse_shared_value_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    name: String,
    owner: String,
) {
    stop(
        context,
        "'{written}' writes '{name}' of this '{owner}' on another thread while this thread may write it too, so one write would be lost: move the work into a class of its own and hand a new one over ('var worker = Worker(...)' then 'Parallel(worker.work)'), answer the value from the work and read the task's result, or keep it in a singleton, which is made safe for threads",
    )
}

func refuse_handed_over_use(
    context: HighIntermediaryRepresentation.Building.Context,
    holder: String,
    written: String,
    kept: String,
    owner: String,
) {
    stop(
        context,
        "'{holder}' was handed to '{written}', which {kept} on another thread, so it is not used after that line: make another '{owner}' for what follows, or read the task's result",
    )
}

func refuse_unstepped_poll(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "this loop reads '{name}.finished' and calls nothing, so nothing steps '{name}' between two reads and it never finishes: read its value instead ('var done: T = {name}' waits for it), or call something that waits in the loop",
    )
}

func refuse_terminal_if(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "this 'if' is the last thing the function does and has no 'else', so it only checks that '{written}' is there: write 'fallback {written}' and let the rest of the function run unindented",
    )
}

func refuse_a_nullable_constraint(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    owner: String,
    generic_name: String,
) {
    stop(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it may be null, and null has none of what the type needs, so give a type that cannot be null",
    )
}

func refuse_constraint(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    owner: String,
    generic_name: String,
    member: String,
) {
    stop(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it has no function '{member}'",
    )
}

func refuse_whole_list(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "this call passes a whole {shown}, but the last parameter is written with '...', so it takes the values one by one: pass the elements themselves, separated by commas",
    )
}

func refuse_unsized_type(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "'{written}.size' is the size of the C struct a type is at a foreign call, and only a type whose attributes are all numbers is one",
    )
}

func refuse_maybe_boolean(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "this is a Boolean? used by a condition, which would only test that it is there, not that it is true: prove it is there first ('crash index < flags.count()' proves 'flags[index]') or switch over it",
    )
}

func refuse_folded_crash(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    refuse_folded_crash_because(context, written, "")
}

func refuse_folded_crash_because(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    reasons: String,
) {
    var shown = context.current_class.shown
    var place = ""
    if shown.contains("<") {
        place = " in {shown}"
    }
    var because = ""
    if not reasons.is_empty() {
        because = "; {reasons}"
    }
    stop(
        context,
        "'crash {written}' always halts{place}: its condition is decided while compiling and is false, so the program would stop here every time this function runs: call it only where the condition holds, or change what the condition asks{because}",
    )
}

func refuse_a_drop_by_name(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "'drop' runs on its own when the last reference to a '{shown}' goes, and is never called by name: let go of the reference instead, by assigning another value or leaving the block",
    )
}

func refuse_a_union_key(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Dictionary cannot be keyed by '{shown}': a key is a number, a Boolean, a String, an enum value or an object of a class",
    )
}

func refuse_an_unwritable_form(
    context: HighIntermediaryRepresentation.Building.Context,
    format_class: String,
    verb: String,
    shown: String,
    reason: String,
) {
    var handles = "{format_class} handles classes, lists, dictionaries, enums, Symbols, numbers, Boolean, String and 'T?'"
    var advice = "so keep what it sees to those, or give it a class of its own that holds only them"
    stop(context, "{format_class} cannot {verb} '{shown}': {reason}. {handles}, {advice}")
}

func refuse_a_duplicate_key(context: HighIntermediaryRepresentation.Building.Context, key: String) {
    stop(context, "{key} is written twice in this dictionary: keep one entry for each key")
}

func refuse_a_vector_collection(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Vector holds each item inline, so an item is a number, a Boolean, an enum, a String or a class made only of those, and a {shown} is not: keep it in a 'List<{shown}>'",
    )
}

func refuse_a_vector_drop(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "'{shown}' cannot be an item of a Vector: it has a 'drop()', and an item inline in a Vector is never an object of its own to drop (keep '{shown}' in a 'List<{shown}>')",
    )
}

func refuse_a_vector_this(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    function_name: String,
) {
    stop(
        context,
        "'{shown}.{function_name}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead",
    )
}

func refuse_vector_item(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    attribute: String,
    attribute_shown: String,
) {
    var article = article_of(attribute_shown)
    stop(
        context,
        "'{shown}' cannot be an item of a Vector: its attribute '{attribute}' is {article} {attribute_shown}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{shown}' in a 'List<{shown}>', or keep '{attribute}' somewhere else)",
    )
}

func refuse_equal_keys(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Dictionary keyed by '{shown}' finds each key by identity, one object one key, but '{shown}' declares 'equals', so an equal '{shown}' would not be found: key the dictionary by what 'equals' compares, a number or a String",
    )
}

func refuse_no_members(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "a {shown} has no attributes or functions to reach with '.'")
}

func refuse_not_callable(context: HighIntermediaryRepresentation.Building.Context, name: String, shown: String) {
    stop(context, "'{name}' is a {shown}, not a function, so it cannot be called")
}

func refuse_an_old_position_form(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
) {
    fallback shown.starts_with("Buffer.read_") and wanted == 0 and given == 1
    var length = shown.length()
    var name = shown.slice(7, length)
    crash name
    stop(
        context,
        "'{name}' reads at the buffer's position and takes nothing: write '{name}_at(position)' to read anywhere else",
    )
}

func refuse_a_comparison_of_objects(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    element: String,
) {
    stop(
        context,
        "List has no method '{name}' for a list of '{element}': it compares with '==', which an object of a class is not compared by: ask with 'any(f)' or 'find_by_<member>'",
    )
}

func refuse_argument_count(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
) {
    refuse_an_old_position_form(context, shown, wanted, given)
    stop(context, "'{shown}' takes {wanted} arguments, and {given} are given")
}

func refuse_list_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "this list's type cannot be read from its first item: declare it, 'var items: List<Item> = [...]'")
}

func refuse_not_indexed(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    doing: String,
    needed: String,
) {
    stop(context, "{doing} a '{shown}' needs it to define '{needed}'")
}

func refuse_a_missing_operator(
    context: HighIntermediaryRepresentation.Building.Context,
    operator_text: String,
    shown: String,
    needed: String,
) {
    stop(context, "{operator_text} on a '{shown}' needs it to define '{needed}'")
}

func refuse_not_a_condition(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a condition is a Boolean, and this is a {shown}: compare it with something, like 'count > 0' or 'name != \"\"'",
    )
}

func refuse_missing_answer(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "'{context.current_function.name}' answers a {shown}, so 'return' needs a value")
}

func refuse_answer_from_nothing(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "'{context.current_function.name}' answers nothing, so 'return' takes no value")
}

func refuse_not_assignable(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "only a local, an attribute or an index is assigned with '='")
}

func refuse_a_fallback_without_an_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    reason: String,
    condition_text: String,
) {
    var last_way = "'crash {condition_text}'"
    if condition_text.is_empty() {
        last_way = "'crash'"
    }
    stop(
        context,
        "'fallback' returns what the answer type builds with no arguments, and a {shown} has none ({reason}): make the result '{shown}?' so the fallback returns null, or write {last_way} if this is a developer mistake",
    )
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    if not context.site_judges.is_empty() {
        context.judge_what_is_recorded()
    }
    var failure = Validators.Failure()
    var path = context.path()
    var owner = plain_class_name(context.current_class.shown)
    var function_name = shown_function_name(context.current_function)
    failure.stop_inside(path, context.line, owner, function_name, text)
}

func shown_function_name(function: Model.FunctionModel): String {
    if function.declaration and function.is_a_walk_copy {
        return function.declaration.name
    }
    return function.name
}

func refuse_a_declaration_value(
    context: HighIntermediaryRepresentation.Building.Context,
    parameter: String,
    instance: String,
) {
    stop(
        context,
        "'{parameter}.value' reads an attribute of an instance, and '{parameter}' describes a declaration: walk the instance's own attributes, '{instance}.attributes', or read '{instance}.attributes[{parameter}]'",
    )
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if not opening {
        return shown
    }
    var sliced = shown.slice(0, opening)
    crash sliced
    return sliced
}

func refuse_text_given(
    context: HighIntermediaryRepresentation.Building.Context,
    shown_given: String,
    shown_wanted: String,
    is_an_enum: Boolean,
    conversion: String,
) {
    fallback shown_given == "String"
    var segments = shown_wanted.split(".")
    var last = segments.count() - 1
    var label = segments[last]
    crash label
    var article = article_of(label)
    if is_an_enum {
        stop(
            context,
            "text is not {article} {label} until it is read as one, and text that names none of its values has none to give: declare the value '{label}?', which reads the text and is null when it names none of its values, and narrow it",
        )
    }
    fallback is_a_number(shown_wanted)
    stop(
        context,
        "text is not {article} {label} until it is read as one, and text that is not a number has none to give: declare the value '{label}?', which reads the text through '{conversion}' and is null when the text is not a number that fits, and narrow it",
    )
}

func refuse_symbol_for_text(context: HighIntermediaryRepresentation.Building.Context, name: String, wanted: String) {
    fallback wanted == "String"
    stop(
        context,
        "'{name}' in single quotes is an enum value literal, and text is wanted here: text is always written in double quotes, so write \"{name}\"",
    )
}

func refuse_literal_range(
    context: HighIntermediaryRepresentation.Building.Context,
    number: Long,
    type_name: String,
    size: Integer,
    is_signed: Boolean,
) {
    fallback size < 8
    var values: Long = 1
    var remaining = size * 8
    while remaining > 0 {
        values = values * 2
        remaining = remaining - 1
    }
    var lowest: Long = 0
    var highest = values - 1
    if is_signed {
        highest = values / 2 - 1
        lowest = lowest - values / 2
    }
    var largest_written = highest
    if is_signed {
        largest_written = highest + 1
    }
    fallback number > largest_written
    var article = article_of(type_name)
    stop(
        context,
        "{number} does not fit in {article} {type_name}, whose numbers run from {lowest} to {highest}: store it in a wider type, or use a number that fits",
    )
}

func refuse_a_constant_overflow(context: HighIntermediaryRepresentation.Building.Context, shown: String, folded: Long) {
    stop(
        context,
        "'{shown}' is {folded}, which does not fit in an Integer, the type its arithmetic is done in, so it would wrap: write the number itself, {folded}, which is a Long",
    )
}

func refuse_a_decimal_too_large(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    type_name: String,
    largest: String,
) {
    var article = article_of(type_name)
    var wider = "write a smaller number"
    if type_name == "Float" {
        wider = "declare it a Double, which holds up to 1.7976931348623157e+308, or write a smaller number"
    }
    stop(context, "{written} does not fit in {article} {type_name}, whose largest number is {largest}: {wider}")
}

func refuse_a_build_write(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'build.{name}' is a setting decided while compiling, which the program reads as a constant, so it cannot be written: set it on the command line, '--{name}=...', or in the program's 'build.spite'",
    )
}

func refuse_a_literal_too_large(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "{written} does not fit in any whole number: a Long holds up to 9223372036854775807, so write a smaller number, or keep it as text",
    )
}

func refuse_an_operator_on_a_shape(
    context: HighIntermediaryRepresentation.Building.Context,
    symbol: String,
    shape_name: String,
) {
    stop(
        context,
        "'{symbol}' on a value read as '{shape_name}' needs the class that fits the type, which is not known while compiling: take the value through a codegen value the type constrains, 'generic $value_type: {shape_name}'",
    )
}

func refuse_division_by_zero(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "'{shown}' divides by zero, which always halts the program: a whole number cannot be divided by zero, so divide by something else, or leave the step out",
    )
}

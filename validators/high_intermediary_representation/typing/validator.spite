func refuse_an_unknown_generic_name(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    name: String,
    bound: List<String>,
) {
    if bound.is_empty() {
        stop(
            context,
            "'{shown}' is not generic, so '{shown}.generics[\"{name}\"]' names nothing: 'generics' holds a class for each 'generic' line of a generic class",
        )
    }
    var names = List<String>()
    var index = 0
    while index < bound.count() {
        var written = bound[index]
        var written_length = written.length()
        var bare = written.slice(1, written_length)
        crash bare
        names.append("'{bare}'")
        index = index + 1
    }
    var listed = names.join(", ")
    stop(
        context,
        "'{shown}' has no generic '{name}', so '{shown}.generics[\"{name}\"]' names nothing: name one of its generics, {listed}",
    )
}


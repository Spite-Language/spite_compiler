    )
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func refuse_unknown_name(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    if name == "_memory" and scalars.is_a_scalar(namespace) {
        stop(
            context,
            "'_memory' is the memory {namespace} is kept in, and the compiler keeps the value itself there: write 'this'",
        )
    }
    var class_file = context.resolver.state.symbols.find(name, namespace)
    if class_file {
        stop(
            context,
            "'{name}' is a class, not a value: write '{name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    }
    stop(context, "'{name}' is not a local, an attribute or a function of '{context.current_class.shown}'")
}

func refuse_a_test_to_collect(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    shown: String,
) {
    stop(
        context,
        "'{called}': the member '{member}' of '{shown}' is a Boolean, but 'map_' needs it to be a value to collect, not a test: write 'filter_{member}()' to keep the elements it is true for, 'count_{member}()' to count them, or 'any_{member}()' or 'all_{member}()' to ask whether any or all of them pass",
    )
}

func refuse_a_caller_function(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    member: String,
    called: String,
) {
    var parts = called.split(member)
    var prefix = parts.first()
    crash prefix
    var length = prefix.length()
    var form = prefix
    if prefix.ends_with("_") {
        var sliced_form = prefix.slice(0, length - 1)
        crash sliced_form
        form = sliced_form
    }
    stop(
        context,
        "'{shown}' has no attribute or zero argument function '{member}' for '{called}': a template reads a member of each element, never a function of this class, so pass this class's '{member}' instead: '{form}({member})'",
    )
}


func narrowing_lines(path: String, hint: String): String {
    return "narrow it first with 'crash {path}', 'fallback {path}' or 'if {path} \{ }'{hint}"
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func is_a_number(shown: String): Boolean {
    var numbers = [
        "Tiny"
        "Short"
        "Integer"
        "Long"
        "UnsignedTiny"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
    ]
    return numbers.contains(shown)
}

# ../../../../spite_documentation/metaprogramming.md#walking-a-programs-structure
func refuse_copy_to_narrow(context: HighIntermediaryRepresentation.Building.Context, name: String, source: String) {
    stop(
        context,
        "'{name}' only copies '{source}' so it can be narrowed: narrow '{source}' itself ('fallback {source}') and use it directly",
    )
}

func refuse_a_check_of_a_plain_value(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    keyword: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "this value cannot be null here (it is {article} {shown}), so '{keyword}' on it proves nothing: remove the check",
    )
}

func refuse_proven_check(context: HighIntermediaryRepresentation.Building.Context, written: String, check: String) {
    stop(context, "'{written}' is already narrowed by {check}: remove this check")
}

func refuse_a_repeated_check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    earlier_line: String,
) {
    stop(
        context,
        "'{written}' was already checked on line {earlier_line}, and nothing between could change it: remove this check",
    )
}

func refuse_a_proven_divisor(context: HighIntermediaryRepresentation.Building.Context, written: String, check: String) {
    stop(context, "'{written}' is already proven by {check}: remove this check")
}

func refuse_a_check_that_always_holds(
    context: HighIntermediaryRepresentation.Building.Context,
    keyword: String,
    written: String,
) {
    stop(context, "'{keyword} {written}' is decided while compiling and always holds here: remove it")
}

# ../../../../spite_documentation/failure.md#nothing-fails-silently
func refuse_a_decided_condition(
    context: HighIntermediaryRepresentation.Building.Context,
    keyword: String,
    written: String,
    holds: Boolean,
    reason: String?,
) {
    var known = "'{keyword} {written}' is decided while compiling and is always false here"
    if holds {
        known = "'{keyword} {written}' is decided while compiling and is always true here"
    }
    if reason {
        known = "{known}, since {reason}"
    }
    if keyword == "if" and holds {
        stop(context, "{known}, so it tells a reader nothing: remove the 'if' and keep the code it runs")
    }
    if keyword == "if" {
        stop(context, "{known}, so the code it guards never runs: remove it, keeping its 'else' if it has one")
    }
    if keyword == "while" and holds {
        stop(
            context,
            "{known}: a loop ends by its condition, so loop 'while' what its leaving paths change, a 'running' local they set to false or the loop's real exit test",
        )
    }
    if keyword == "while" {
        stop(context, "{known}, so the loop never runs: remove it")
    }
    stop(context, "{known}, so the function always answers nothing from here: remove it with the code after it")
}

func refuse_a_narrowed_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    tested: String,
    shown: String,
    check: String,
) {
    stop(context, "'{tested}' is already a {shown}, narrowed by {check}: remove this test")
}

func refuse_a_decided_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    tested: String,
    shown: String,
    member: String,
) {
    if shown == member {
        stop(context, "'{tested}' is a {shown} here, so this test is decided while compiling: remove it")
    }
    stop(
        context,
        "'{tested}' is a {shown} here, so it is never {member} and this test is decided while compiling: remove it",
    )
}

func refuse_proven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    check: String,
    keyword: String,
) {
    stop(context, "'{written}' is already proven by {check}, so this '{keyword}' proves nothing: remove it")
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func shown_function_name(function: Model.FunctionModel): String {
    if function.declaration and function.is_a_walk_copy {
        return function.declaration.name
    }
    return function.name
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if not opening {
        return shown
    }
    var sliced = shown.slice(0, opening)
    crash sliced
    return sliced
}

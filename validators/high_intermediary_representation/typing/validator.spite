func refuse_a_private_name(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    shown: String,
    reader: String,
) {
    var text = "'{name}' is private to '{shown}': a name starting with '_' is used only inside its own class"
    if not reader.is_empty() {
        text = "{text}, and '{reader}' reads it from outside"
    }
    stop(context, text)
}

func refuse_an_operator_call(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    operator: String,
    receiver: String,
    arguments: List<String>,
) {
    var written = operator_call_written(name, operator, receiver, arguments)
    var text = "'{name}' is what '{operator}' calls: write '{written}'"
    var first = arguments.first()
    if name == "equals" and first {
        text = "{text}, or '{receiver} != {first}' for 'not {receiver}.equals({first})'"
    }
    stop(context, text)
}

func operator_call_written(name: String, operator: String, receiver: String, arguments: List<String>): String {
    var first = arguments.first()
    if not first {
        return "{operator}{receiver}"
    }
    if name == "get_at" {
        return "{receiver}[{first}]"
    }
    if name == "set_at" {
        var second = arguments.last()
        crash second
        return "{receiver}[{first}] = {second}"
    }
    return "{receiver} {operator} {first}"
}

func refuse_an_accessor_call(
    context: HighIntermediaryRepresentation.Building.Context,
    called_name: String,
    access: String,
    attribute_name: String,
    written: String,
) {
    stop(context, "'{called_name}' is what {access} '{attribute_name}' calls: write '{written}'")
}

func refuse_an_unknown_generic_class(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    if written == "Heap" {
        stop(
            context,
            "there is no 'Heap<T>': a class, a list and a text are references already, so a class that holds one of its own kind declares an ordinary attribute, like 'var left: Expression? = null' ('Memory.Heap' is the allocator, for containers of your own)",
        )
    }
    stop(
        context,
        "there is no generic class '{written}' here: a class name is looked up in this class's folder, each parent folder, then the whole program",
    )
}


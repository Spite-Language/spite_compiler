func refuse_cut_operand(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    operation: String,
    left: String,
    right: String,
    left_text: String,
    turned_text: String,
    order_free: Boolean,
) {
    var right_article = article_of(right)
    var left_article = article_of(left)
    var fix = "store the left side in {right_article} {right} first ('var wide: {right} = {left_text}')"
    if order_free {
        fix = "write the {right} first ('{turned_text}')"
    }
    stop(
        context,
        "'{shown}' is {operation} in {left}, since arithmetic takes the left side's type, and the right side is {right_article} {right}, which would be cut to fit: {fix}, or store the right side in {left_article} {left} first if it fits one",
    )
}

func refuse_cut_comparison(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    left: String,
    right: String,
    turned_text: String,
) {
    var right_article = article_of(right)
    var left_article = article_of(left)
    stop(
        context,
        "'{shown}' compares in {left}, since a comparison takes the left side's type, and the right side is {right_article} {right}, which would be cut to fit: write the {right} first ('{turned_text}'), or store the right side in {left_article} {left} first if it fits one",
    )
}

func refuse_a_class_as_a_value(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is a class, not a value: write '{name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
    )
}

func refuse_a_value_function_on_a_number_class(
    context: HighIntermediaryRepresentation.Building.Context,
    class_name: String,
    function_name: String,
    constants: String,
) {
    stop(
        context,
        "'{class_name}.{function_name}()' calls a function of a value on the class: the class {class_name} answers only its presets, {constants}, so call '{function_name}' on a value, like 'number.{function_name}()'",
    )
}

func refuse_a_class_function_value(
    context: HighIntermediaryRepresentation.Building.Context,
    class_name: String,
    function_name: String,
    instance: String,
    template: String,
) {
    stop(
        context,
        "'{class_name}.{function_name}' is not a function: '{class_name}' is the class's 'Spite.Class' object, which has no '{function_name}' (the function itself is '{class_name}.functions['{function_name}']'). A function value belongs to an instance: pass '{instance}.{function_name}', or ask each element of a list through its member template, such as '{template}'",
    )
}

func refuse_an_undeclared_generic(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var owner = plain_class_name(context.current_class.shown)
    var parts = owner.split(".")
    var plain = parts.last()
    crash plain
    var length = name.length()
    var setting = name.slice(1, length)
    crash setting
    stop(
        context,
        "'{plain}' has no 'generic {name}' line, and '$' is for generics only: a program's settings are fields of Environment, so read 'Environment().{setting}', or declare 'generic {name}' at the top of the file",
    )
}


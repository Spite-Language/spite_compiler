func refuse_cast_by_name(context: HighIntermediaryRepresentation.Building.Context, written: String, name: String) {
    var names = Mapping.Names()
    var name_length = name.length()
    var source_name = name.slice(5, name_length)
    crash source_name
    var source = names.class_name_of(source_name)
    stop(
        context,
        "there is no '{written}.{name}()': a conversion is written in the class it makes, 'func {written}(from: {source}): {written}?', and the compiler applies it, so cast by assignment: 'var converted: {written}? = value'",
    )
}


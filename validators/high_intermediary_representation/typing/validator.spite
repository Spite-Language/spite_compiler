func refuse_mismatch(context: HighIntermediaryRepresentation.Building.Context, given: String, wanted: String) {
    stop(context, "a {given} cannot be used where a {wanted} is needed")
}

func refuse_maybe_null(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "this value may be null (it is a {shown}): narrow it first with 'if value \{ }', 'assert value' or 'crash value'",
    )
}

func refuse_null_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "'null' has no type here: it is written only where a type that may be null is expected, like 'var target: Monster? = null'",
    )
}

func refuse_symbol_without_an_enum(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(
        context,
        "'{name}' is a symbol, and nothing here says which enum it belongs to: write it where an enum is expected",
    )
}

func refuse_not_a_value(context: HighIntermediaryRepresentation.Building.Context, name: String, enum_name: String) {
    stop(context, "'{name}' is not a value of the enum '{enum_name}'")
}

func refuse_unknown_name(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    stop(context, "'{name}' is not a local, an attribute or a function of '{context.current_class.shown}'")
}

func refuse_unknown_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    stop(context, "a {shown} has no attribute or function '{name}'")
}

func refuse_not_a_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
) {
    stop(context, "'{shown}' does not fit type '{shape}': it has no function '{member}'")
}

func refuse_no_members(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "a {shown} has no attributes or functions to reach with '.'")
}

func refuse_not_callable(context: HighIntermediaryRepresentation.Building.Context, name: String, shown: String) {
    stop(context, "'{name}' is a {shown}, not a function, so it cannot be called")
}

func refuse_argument_count(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
) {
    stop(context, "'{shown}' takes {wanted} arguments, and {given} are given")
}

func refuse_list_without_a_type(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "this list's type cannot be read from its first item: declare it, 'var items: List<Item> = [...]'")
}

func refuse_not_indexed(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "a {shown} is not indexed with [ ]: only a class that declares 'get_at' is")
}

func refuse_not_a_condition(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a condition is a Boolean, and this is a {shown}: compare it with something, like 'count > 0' or 'name != \"\"'",
    )
}

func refuse_missing_answer(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(context, "'{context.current_function.name}' answers a {shown}, so 'return' needs a value")
}

func refuse_answer_from_nothing(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "'{context.current_function.name}' answers nothing, so 'return' takes no value")
}

func refuse_not_assignable(context: HighIntermediaryRepresentation.Building.Context) {
    stop(context, "only a local, an attribute or an index is assigned with '='")
}

func refuse_default_answer(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "this 'assert' would answer a default {shown} that a caller cannot tell from a real one: make the result '{shown}?', or 'crash' if this is a developer mistake",
    )
}

func refuse_unused_answer(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "a line on its own is a call that answers nothing, and this answers a value: use it, or call something that answers nothing",
    )
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var failure = Validators.Failure()
    var path = context.path()
    failure.stop_inside(path, context.line, context.current_class.shown, context.current_function.name, text)
}

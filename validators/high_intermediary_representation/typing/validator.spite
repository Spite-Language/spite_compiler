var fixes = Fixes.Fixes()

func refuse_maybe_null(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    var article = article_of(shown)
    stop(
        context,
        "this value may be null (it is {article} {shown}): narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func refuse_maybe_null_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    var article = article_of(shown)
    stop(
        context,
        "this value may be null (it is {article} {shown}), so '{name}' cannot be read from it yet: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func refuse_maybe_null_operand(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    symbol: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "this value may be null (it is {article} {shown}), so '{symbol}' cannot use it yet: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func refuse_maybe_null_needed(context: HighIntermediaryRepresentation.Building.Context, shown: String, wanted: String) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    stop(
        context,
        "this value may be null (it is {article} {shown}), but {wanted_article} {wanted} is needed: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func refuse_missing_read_member(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    name: String,
    verb: String,
    hint: String,
) {
    var article = article_of(shown)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), so '{name}' cannot be {verb} it yet: {narrowing}",
    )
}

func refuse_missing_read_needed(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    wanted: String,
    hint: String,
) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    var narrowing = narrowing_lines(path, hint)
    stop(
        context,
        "'{path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), but {wanted_article} {wanted} is needed: {narrowing}",
    )
}

func narrowing_lines(path: String, hint: String): String {
    return "narrow it first with 'crash {path}', 'fallback {path}' or 'if {path} \{ }'{hint}"
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func is_a_number(shown: String): Boolean {
    var numbers = [
        "Tiny"
        "Short"
        "Integer"
        "Long"
        "UnsignedTiny"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
    ]
    return numbers.contains(shown)
}

func refuse_function_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    stop(context, "'{shown}' has no attribute '{name}'")
}

func refuse_a_switch_on_open_values(context: HighIntermediaryRepresentation.Building.Context, subject: String) {
    stop(
        context,
        "'switch {subject}' chooses among values with no closed set, so no case list is ever whole: switch on an enum's values or a union's members, or write the choice as 'if' tests",
    )
}

# ../../../../spite_documentation/metaprogramming.md#walking-a-programs-structure
func refuse_copy_to_narrow(context: HighIntermediaryRepresentation.Building.Context, name: String, source: String) {
    stop(
        context,
        "'{name}' only copies '{source}' so it can be narrowed: narrow '{source}' itself ('fallback {source}') and use it directly",
    )
}

func refuse_a_check_of_a_plain_value(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    keyword: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "this value cannot be null here (it is {article} {shown}), so '{keyword}' on it proves nothing: remove the check",
    )
}

func refuse_proven_check(context: HighIntermediaryRepresentation.Building.Context, written: String, check: String) {
    stop(context, "'{written}' is already narrowed by {check}: remove this check")
}

func refuse_a_repeated_check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    earlier_line: String,
) {
    stop(
        context,
        "'{written}' was already checked on line {earlier_line}, and nothing between could change it: remove this check",
    )
}

func refuse_a_proven_divisor(context: HighIntermediaryRepresentation.Building.Context, written: String, check: String) {
    stop(context, "'{written}' is already proven by {check}: remove this check")
}

func refuse_a_check_that_always_holds(
    context: HighIntermediaryRepresentation.Building.Context,
    keyword: String,
    written: String,
) {
    stop(context, "'{keyword} {written}' is decided while compiling and always holds here: remove it")
}

# ../../../../spite_documentation/failure.md#nothing-fails-silently
func refuse_a_decided_condition(
    context: HighIntermediaryRepresentation.Building.Context,
    keyword: String,
    written: String,
    holds: Boolean,
    reason: String?,
) {
    var known = "'{keyword} {written}' is decided while compiling and is always false here"
    if holds {
        known = "'{keyword} {written}' is decided while compiling and is always true here"
    }
    if reason {
        known = "{known}, since {reason}"
    }
    if keyword == "if" and holds {
        stop(context, "{known}, so it tells a reader nothing: remove the 'if' and keep the code it runs")
    }
    if keyword == "if" {
        stop(context, "{known}, so the code it guards never runs: remove it, keeping its 'else' if it has one")
    }
    if keyword == "while" and holds {
        stop(
            context,
            "{known}: a loop ends by its condition, so loop 'while' what its leaving paths change, a 'running' local they set to false or the loop's real exit test",
        )
    }
    if keyword == "while" {
        stop(context, "{known}, so the loop never runs: remove it")
    }
    stop(context, "{known}, so the function always answers nothing from here: remove it with the code after it")
}

func refuse_a_narrowed_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    tested: String,
    shown: String,
    check: String,
) {
    stop(context, "'{tested}' is already a {shown}, narrowed by {check}: remove this test")
}

func refuse_a_decided_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    tested: String,
    shown: String,
    member: String,
) {
    if shown == member {
        stop(context, "'{tested}' is a {shown} here, so this test is decided while compiling: remove it")
    }
    stop(
        context,
        "'{tested}' is a {shown} here, so it is never {member} and this test is decided while compiling: remove it",
    )
}

func refuse_proven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    check: String,
    keyword: String,
) {
    stop(context, "'{written}' is already proven by {check}, so this '{keyword}' proves nothing: remove it")
}

func refuse_undone_loop_proof(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    fixes.a_narrowing_was_taken_back()
    stop(
        context,
        "assigning to '{written}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
    )
}

func refuse_a_replaced_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    item: String,
    owner: String,
    answered_by: String,
    writer: String,
    attribute: String,
) {
    var replacing = "a function of '{owner}' that writes '{item}'"
    if not writer.is_empty() {
        replacing = "'{owner}.{writer}', which writes '{attribute}'"
    }
    stop(
        context,
        "'{name}' holds '{item}' of '{owner}', answered by '{answered_by}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{owner}' still holds the old item. Replace it through {replacing}, or give the new value a 'var' of its own",
    )
}

func refuse_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    item: String,
    listed: String,
    value: String,
) {
    stop(
        context,
        "'{name}' was read from '{item}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{listed}' still holds the old item. Write '{item} = {value}' to replace the item, or give the new value a 'var' of its own",
    )
}

func refuse_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    attribute: String,
    article: String,
    shown: String,
) {
    stop(
        context,
        "'{name}.{attribute}' is written here and '{name}' is never read after it: '{name}' is {article} '{shown}' only this function holds, so the write is lost when it is let go. Use what was written, return '{name}', keep it in an attribute or a list, or drop the write",
    )
}

func refuse_terminal_if(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "this 'if' is the last thing the function does and has no 'else', so it only checks that '{written}' is there: write 'fallback {written}' and let the rest of the function run unindented",
    )
}

func refuse_a_nullable_constraint(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    owner: String,
    generic_name: String,
) {
    stop(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it may be null, and null has none of what the type needs, so give a type that cannot be null",
    )
}

func refuse_constraint(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    owner: String,
    generic_name: String,
    member: String,
) {
    stop(
        context,
        "'{shown}' does not fit type '{shape}', which '{owner}' requires of {generic_name}: it has no function '{member}'",
    )
}

func refuse_maybe_boolean(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "this is a Boolean? used by a condition, which would only test that it is there, not that it is true: prove it is there first ('crash index < flags.count()' proves 'flags[index]') or switch over it",
    )
}

func refuse_a_union_key(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Dictionary cannot be keyed by '{shown}': a key is a number, a Boolean, a String, an enum value or an object of a class",
    )
}

func refuse_an_unwritable_form(
    context: HighIntermediaryRepresentation.Building.Context,
    format_class: String,
    verb: String,
    shown: String,
    reason: String,
) {
    var handles = "{format_class} handles classes, lists, dictionaries, enums, numbers, Boolean, String and 'T?'"
    var advice = "so keep what it sees to those, or give it a class of its own that holds only them"
    stop(context, "{format_class} cannot {verb} '{shown}': {reason}. {handles}, {advice}")
}

func refuse_a_vector_collection(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Vector holds each item inline, so an item is a number, a Boolean, an enum, a String or a class made only of those, and a {shown} is not: keep it in a 'List<{shown}>'",
    )
}

func refuse_a_vector_drop(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "'{shown}' cannot be an item of a Vector: it has a 'drop()', and an item inline in a Vector is never an object of its own to drop (keep '{shown}' in a 'List<{shown}>')",
    )
}

func refuse_a_vector_this(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    function_name: String,
) {
    stop(
        context,
        "'{shown}.{function_name}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead",
    )
}

func refuse_vector_item(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    attribute: String,
    attribute_shown: String,
) {
    var article = article_of(attribute_shown)
    stop(
        context,
        "'{shown}' cannot be an item of a Vector: its attribute '{attribute}' is {article} {attribute_shown}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{shown}' in a 'List<{shown}>', or keep '{attribute}' somewhere else)",
    )
}

func refuse_equal_keys(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a Dictionary keyed by '{shown}' finds each key by identity, one object one key, but '{shown}' declares 'equals', so an equal '{shown}' would not be found: key the dictionary by what 'equals' compares, a number or a String",
    )
}

func refuse_a_fallback_without_an_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    reason: String,
    condition_text: String,
) {
    var last_way = "'crash {condition_text}'"
    if condition_text.is_empty() {
        last_way = "'crash'"
    }
    stop(
        context,
        "'fallback' returns what the answer type builds with no arguments, and a {shown} has none ({reason}): make the result '{shown}?' so the fallback returns null, or write {last_way} if this is a developer mistake",
    )
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func shown_function_name(function: Model.FunctionModel): String {
    if function.declaration and function.is_a_walk_copy {
        return function.declaration.name
    }
    return function.name
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if not opening {
        return shown
    }
    var sliced = shown.slice(0, opening)
    crash sliced
    return sliced
}

# ../../../PROOFS.md#narrowing-a-t
func check_a_maybe_boolean(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.PresenceSite,
) {
    var tested = site.value_type
    fallback tested.kind == 'scalar' and tested.name == "Boolean"
    stopped(
        context,
        "this is a Boolean? used by a condition, which would only test that it is there, not that it is true: prove it is there first ('crash index < flags.count()' proves 'flags[index]') or switch over it",
    )
}

func check_a_null_that_cannot_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.PresenceSite,
) {
    var shape = context.program.shape_keyed(site.wanted.name)
    crash shape
    var index = 0
    var answered = true
    while index < shape.members.count() {
        var member = shape.members[index]
        if not is_answered_by_null(member) {
            answered = false
        }
        index = index + 1
    }
    fallback not answered and shape.name != "Anything"
    check_an_unproven_fit(context, site)
    var shown = context.shown(site.value_type)
    refuse_a_needed_value(context, shown, shape.name)
}

func is_answered_by_null(member: Model.FunctionModel): Boolean {
    var names_it = member.name == "to_string" or member.name == "to_debug"
    return names_it and member.parameters.is_empty() and not member.is_an_attribute
}

func check_an_unproven_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.PresenceSite,
) {
    var wanted = site.wanted
    var present = wanted.present()
    var shown_wanted = context.shown(present)
    if wanted.kind == 'shape' {
        var shape = context.program.shape_keyed(wanted.name)
        crash shape
        shown_wanted = shape.name
    }
    var shown = context.shown(site.value_type)
    if site.value.class == HighIntermediaryRepresentation.Values.Call and site.value.index_path != "" {
        var article = article_of(shown)
        var wanted_article = article_of(shown_wanted)
        var narrowing = narrowing_lines(site.value.index_path, site.value.index_hint)
        stopped(
            context,
            "'{site.value.index_path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), but {wanted_article} {shown_wanted} is needed: {narrowing}",
        )
    }
    refuse_a_needed_value(context, shown, shown_wanted)
}

func check_an_unproven_read(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.PresenceSite,
    verb: String,
) {
    if site.value.class == HighIntermediaryRepresentation.Values.Call {
        check_an_unproven_call_read(context, site.value, site.name, verb)
    }
}

func check_an_unproven_call_read(
    context: HighIntermediaryRepresentation.Building.Context,
    read: HighIntermediaryRepresentation.Values.Call,
    name: String,
    verb: String,
) {
    fallback read.index_path != ""
    var shown = context.shown(read.value_type)
    var article = article_of(shown)
    var narrowing = narrowing_lines(read.index_path, read.index_hint)
    stopped(
        context,
        "'{read.index_path}' may be missing, since every '[ ]' answers a 'T?' (this one is {article} {shown}), so '{name}' cannot be {verb} it yet: {narrowing}",
    )
}

func check_a_member(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    var article = article_of(shown)
    stopped(
        context,
        "this value may be null (it is {article} {shown}), so '{name}' cannot be read from it yet: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func check_an_operand(context: HighIntermediaryRepresentation.Building.Context, shown: String, symbol: String) {
    var article = article_of(shown)
    stopped(
        context,
        "this value may be null (it is {article} {shown}), so '{symbol}' cannot use it yet: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func check_a_present_value(context: HighIntermediaryRepresentation.Building.Context, value_type: Model.Type) {
    fallback value_type.is_nullable
    var shown = context.shown(value_type)
    var article = article_of(shown)
    stopped(
        context,
        "this value may be null (it is {article} {shown}): narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func refuse_a_needed_value(context: HighIntermediaryRepresentation.Building.Context, shown: String, wanted: String) {
    var article = article_of(shown)
    var wanted_article = article_of(wanted)
    stopped(
        context,
        "this value may be null (it is {article} {shown}), but {wanted_article} {wanted} is needed: narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
    )
}

func narrowing_lines(path: String, hint: String): String {
    return "narrow it first with 'crash {path}', 'fallback {path}' or 'if {path} \{ }'{hint}"
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

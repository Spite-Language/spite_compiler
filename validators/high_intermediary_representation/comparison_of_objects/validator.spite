var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    receiver_type: Model.Type,
    owner: Model.ClassModel,
    name: String,
) {
    fallback name == "contains" or name == "index_of"
    var shown = context.shown(receiver_type)
    fallback shown.starts_with("List<")
    var element_type = owner.bound_types["$element_type"]
    crash element_type
    var is_an_object = element_type.kind == 'object' and element_type.name != "String"
    fallback is_an_object or element_type.kind == 'union'
    var element_shown = context.shown(element_type)
    var element = generic_constraint.plain_name_of(element_shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "List has no method '{name}' for a list of '{element}': it compares with '==', which an object of a class is not compared by: ask with 'any(f)' or 'find_by_<member>'",
    )
}

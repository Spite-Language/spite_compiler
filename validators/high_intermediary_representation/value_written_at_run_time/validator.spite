# ../../../../spite_documentation/reflection.md#known-only-at-run-time
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    targets: List<HighIntermediaryRepresentation.Building.WriteTarget>,
): Validators.Answer {
    fallback not targets.is_empty() and not is_taken(given, targets)
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var given_shown = context.shown(given)
    var given_article = every_rule.article_of(given_shown)
    if targets.count() == 1 {
        var target = targets[0]
        var wanted = target.held.present()
        var wanted_shown = context.shown(wanted)
        var article = every_rule.article_of(wanted_shown)
        return mistake(
            context,
            "set_value() gives '{target.shown}' {given_article} {given_shown}, which is not {article} {wanted_shown} and which no conversion of {wanted_shown} takes, so it cannot be cast the way an assignment would cast it",
        )
    }
    var listed = held_list(context, targets)
    return mistake(
        context,
        "set_value() gives {given_article} {given_shown} to an attribute known only at run time, and none of the attributes it can write takes one the way an assignment would cast it: {listed}",
    )
}

# ../../../../spite_documentation/reflection.md#known-only-at-run-time
func check_a_null(
    context: HighIntermediaryRepresentation.Building.Context,
    given: SpiteCompiler.Value,
    targets: List<HighIntermediaryRepresentation.Building.WriteTarget>,
): Validators.Answer {
    var is_the_literal = given.class == HighIntermediaryRepresentation.Values.NullConstant
    fallback is_the_literal and not targets.is_empty() and not takes_null(targets)
    if targets.count() == 1 {
        var target = targets[0]
        return mistake(context, "set_value() gives '{target.shown}' null, and it is not nullable")
    }
    var names = List<String>()
    var index = 0
    while index < targets.count() {
        var listed = targets[index]
        names.append("'{listed.shown}'")
        index = index + 1
    }
    var joined = names.join(", ")
    return mistake(
        context,
        "set_value() gives null to an attribute known only at run time, and none of the attributes it can write is nullable: {joined}",
    )
}

func is_taken(given: Model.Type, targets: List<HighIntermediaryRepresentation.Building.WriteTarget>): Boolean {
    var index = 0
    while index < targets.count() {
        var target = targets[index]
        if holds_the_class(target.takes, given) {
            return true
        }
        index = index + 1
    }
    return false
}

func holds_the_class(takes: List<Model.Type>, given: Model.Type): Boolean {
    var index = 0
    while index < takes.count() {
        var taken = takes[index]
        if taken.is_the_same_as(given) {
            return true
        }
        index = index + 1
    }
    return false
}

func takes_null(targets: List<HighIntermediaryRepresentation.Building.WriteTarget>): Boolean {
    var index = 0
    while index < targets.count() {
        var target = targets[index]
        if target.held.is_nullable {
            return true
        }
        index = index + 1
    }
    return false
}

func held_list(
    context: HighIntermediaryRepresentation.Building.Context,
    targets: List<HighIntermediaryRepresentation.Building.WriteTarget>,
): String {
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var parts = List<String>()
    var index = 0
    while index < targets.count() {
        var target = targets[index]
        var wanted = target.held.present()
        var wanted_shown = context.shown(wanted)
        var article = every_rule.article_of(wanted_shown)
        parts.append("'{target.shown}' holds {article} {wanted_shown}")
        index = index + 1
    }
    return parts.join(", ")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

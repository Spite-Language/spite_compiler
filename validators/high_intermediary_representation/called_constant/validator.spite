func check(
    context: HighIntermediaryRepresentation.Building.Context,
    preset: Model.FunctionModel?,
    written: String,
    name: String,
) {
    fallback preset
    var spelled = name.pascal_case()
    refuse(context, "{written}.{name}", "{written}.{spelled}()")
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, named: String, preset: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{named}' is the preset '{preset}': a special value of a class is a preset, named in PascalCase and called on the class",
    )
}

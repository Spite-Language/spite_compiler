func check(
    context: HighIntermediaryRepresentation.Building.Context,
    getter: Model.FunctionModel?,
    class_name: String,
    name: String,
    constants: String,
) {
    fallback not getter
    refuse(context, class_name, name, constants)
}

func refuse(
    context: HighIntermediaryRepresentation.Building.Context,
    class_name: String,
    name: String,
    constants: String,
) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "the class {class_name} answers only its presets, {constants}, and '{name}' is not one of them")
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    getter: Model.FunctionModel?,
    class_name: String,
    name: String,
    constants: String,
): Validators.Answer {
    fallback not getter
    return refuse(context, class_name, name, constants)
}

func refuse(
    context: HighIntermediaryRepresentation.Building.Context,
    class_name: String,
    name: String,
    constants: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "the class {class_name} answers only its presets, {constants}, and '{name}' is not one of them",
    )
}

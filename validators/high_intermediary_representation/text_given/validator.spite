func check(context: HighIntermediaryRepresentation.Building.Context, given: Model.Type, wanted: Model.Type) {
    var shown_given = context.shown(given)
    fallback shown_given == "String"
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var shown_wanted = context.shown(wanted)
    var segments = shown_wanted.split(".")
    var last = segments.count() - 1
    var label = segments[last]
    crash label
    var article = typing.article_of(label)
    if wanted.kind == 'enumeration' {
        stopped(
            context,
            "text is not {article} {label} until it is read as one, and text that names none of its values has none to give: declare the value '{label}?', which reads the text and is null when it names none of its values, and narrow it",
        )
    }
    fallback typing.is_a_number(shown_wanted)
    var conversion = conversion_name_of(wanted)
    stopped(
        context,
        "text is not {article} {label} until it is read as one, and text that is not a number has none to give: declare the value '{label}?', which reads the text through '{conversion}' and is null when the text is not a number that fits, and narrow it",
    )
}

func conversion_name_of(wanted: Model.Type): String {
    var segments = wanted.name.split(".")
    var last = segments.last()
    crash last
    return "{last}(from: String)"
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

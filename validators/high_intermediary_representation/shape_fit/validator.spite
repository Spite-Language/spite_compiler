func check_an_enum_member(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    values: HighIntermediaryRepresentation.Building.Values,
) {
    var is_a_copy = values.is_a_copy_name(member)
    fallback member != "_attribute_list" and member != "to_string" and member != "to_debug" and not is_a_copy
    no_function(context, shown, shape, member)
}

func check_a_class(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    shown: String,
    shape: Model.ShapeModel,
) {
    fallback not context.has_a_class(given)
    var first = shape.members[0]
    crash first
    no_function(context, shown, shape.name, first.name)
}

func check_a_function(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    function: Model.FunctionModel?,
) {
    fallback not function
    no_function(context, shown, shape, member)
}

func check_an_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    attribute: Model.AttributeModel?,
) {
    fallback not attribute
    stopped(context, "'{shown}' does not fit type '{shape}': it has no attribute '{member}'")
}

func check_an_assigned_member(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    attribute: Model.AttributeModel?,
) {
    fallback not attribute
    stopped(
        context,
        "'{shown}' does not fit type '{shape}': this program assigns '{member}' through the type, and only an attribute holding a function can be assigned, so '{shown}' needs one",
    )
}

func check_a_held_function(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    held: Model.Type,
) {
    fallback held.is_nullable
    var found_shown = shown_with_an_article(context, held)
    mistyped(
        context,
        shown,
        shape,
        "attribute '{member}' is {found_shown}, which may hold no function, and the type needs one",
    )
}

func check_an_attribute_type(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    found: Model.Type,
    needed: Model.Type,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
) {
    fallback not fitting.fits_the_needed_type(found, needed)
    var found_shown = shown_with_an_article(context, found)
    var wanted_shown = shown_with_an_article(context, needed)
    mistyped(context, shown, shape, "attribute '{member}' is {found_shown}, but the type needs {wanted_shown}")
}

func check_an_argument_count(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    found_count: Integer,
    wanted_count: Integer,
) {
    fallback found_count != wanted_count
    mistyped(context, shown, shape, "its '{member}' takes {found_count} argument(s), but the type needs {wanted_count}")
}

func check_an_argument_type(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    place: Integer,
    found: Model.Type,
    needed: Model.Type,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
) {
    fallback not fitting.fits_the_needed_type(found, needed)
    var found_shown = shown_with_an_article(context, found)
    var wanted_shown = shown_with_an_article(context, needed)
    mistyped(
        context,
        shown,
        shape,
        "argument {place} of its '{member}' is {found_shown}, but the type needs {wanted_shown}",
    )
}

func check_an_answer_type(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
    found: Model.Type,
    needed: Model.Type,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
) {
    fallback not fitting.fits_the_needed_type(found, needed)
    var returned = shown_with_an_article(context, found)
    var wanted_shown = shown_with_an_article(context, needed)
    mistyped(context, shown, shape, "its '{member}' returns {returned}, but the type needs {wanted_shown}")
}

func shown_with_an_article(context: HighIntermediaryRepresentation.Building.Context, of_type: Model.Type): String {
    if of_type.kind == 'nothing' {
        return "Nothing"
    }
    var name = context.shown(of_type)
    var first_letter = name.slice(0, 1)
    crash first_letter
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

func no_function(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    member: String,
) {
    stopped(context, "'{shown}' does not fit type '{shape}': it has no function '{member}'")
}

func mistyped(context: HighIntermediaryRepresentation.Building.Context, shown: String, shape: String, problem: String) {
    stopped(context, "'{shown}' does not fit type '{shape}': {problem}")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

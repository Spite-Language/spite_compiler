func check_a_paradox(
    fact: HighIntermediaryRepresentation.Values.Function.Fact,
    function: Model.FunctionModel,
    before: HighIntermediaryRepresentation.Building.Facts,
    everything: HighIntermediaryRepresentation.Building.Facts,
): Validators.Answer {
    var answer = Validators.Answer()
    var key = function.key()
    var earlier = before.waits(key)
    var found = everything.waits(key)
    fallback earlier != found
    var segments = function.owner.split(".")
    var last = segments.last()
    crash last
    var simple = last
    var opening = last.index_of("<")
    if opening and opening > 0 {
        var sliced_simple = last.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    var asked = "{simple}.{function.name}"
    var problem = Diagnostics.Problem(
        fact.path,
        fact.line,
        "whether '{asked}' can wait was answered {earlier} here, before the functions that ask 'function_waits' were compiled, and it is {found} once they are: it reaches one of them, or a function value made in one, so its answer would decide itself, so ask from a function that '{asked}' does not reach",
    )
    problem.class_name = fact.owner_shown
    problem.function_name = fact.function_name
    problem.is_among_the_attributes = fact.function_name.is_empty()
    answer.mistakes.append(problem)
    return answer
}

func check(context: HighIntermediaryRepresentation.Building.Context, function: Model.FunctionModel) {
    fallback not function.walked_object and not function.walked_declarations_of.is_empty()
    var parts = function.walked_declarations_of.split(".")
    var last = parts.last()
    crash last
    var names = Mapping.Names()
    var instance = names.snake_case_of(last)
    var parameter = function.bound_parameter
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{parameter}.value' reads an attribute of an instance, and '{parameter}' describes a declaration: walk the instance's own attributes, '{instance}.attributes', or read '{instance}.attributes[{parameter}]'",
    )
}

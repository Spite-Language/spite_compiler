func check(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    converted: SpiteCompiler.Value?,
): Validators.Answer {
    fallback not converted
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    return mismatched(context, shown_given, shown_wanted)
}

func check_a_signature(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
): Validators.Answer {
    fallback not values.same_signature(given, wanted)
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    return mismatched(context, shown_given, shown_wanted)
}

# ../../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func check_a_conversion(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
): Validators.Answer {
    fallback fitting.can_be_converted(given, wanted)
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var given_article = every_rule.article_of(shown_given)
    var wanted_article = every_rule.article_of(shown_wanted)
    var segments = shown_wanted.split(".")
    var made = segments.last()
    crash made
    return mistake(
        context,
        "{given_article} {shown_given} cannot be used where {wanted_article} {shown_wanted} is needed: a value is cast to the class a place wants through that class's conversion, and {shown_wanted} declares no '{made}(from: {shown_given})'",
    )
}

func check_a_comparison(
    context: HighIntermediaryRepresentation.Building.Context,
    left_type: Model.Type,
    right_type: Model.Type,
): Validators.Answer {
    var both_kinds = left_type.kind == 'object' and right_type.kind == 'object'
    var both_classes = both_kinds and context.has_a_class(left_type) and context.has_a_class(right_type)
    var either_nullable = left_type.is_nullable or right_type.is_nullable
    var across = both_classes and not either_nullable and left_type.name != right_type.name
    fallback across and equals_takes_its_own_class(context, left_type)
    var given = context.shown(left_type)
    var wanted = context.shown(right_type)
    return mismatched(context, given, wanted)
}

func equals_takes_its_own_class(
    context: HighIntermediaryRepresentation.Building.Context,
    left_type: Model.Type,
): Boolean {
    var owner = context.class_of(left_type)
    var equals = owner.function_named("equals")
    crash equals
    var parameter = equals.parameters[0]
    crash parameter
    return parameter.parameter_type.name == left_type.name
}

func mismatched(
    context: HighIntermediaryRepresentation.Building.Context,
    given: String,
    wanted: String,
): Validators.Answer {
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var given_article = every_rule.article_of(given)
    var wanted_article = every_rule.article_of(wanted)
    return mistake(context, "{given_article} {given} cannot be used where {wanted_article} {wanted} is needed")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

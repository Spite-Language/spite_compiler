func check(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    converted: SpiteCompiler.Value?,
) {
    fallback not converted
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    refuse(context, shown_given, shown_wanted)
}

func check_a_signature(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    is_the_same_signature: Boolean,
) {
    fallback not is_the_same_signature
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    refuse(context, shown_given, shown_wanted)
}

# ../../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func check_a_conversion(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    is_convertible: Boolean,
) {
    fallback is_convertible
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var given_article = typing.article_of(shown_given)
    var wanted_article = typing.article_of(shown_wanted)
    var segments = shown_wanted.split(".")
    var made = segments.last()
    crash made
    stopped(
        context,
        "{given_article} {shown_given} cannot be used where {wanted_article} {shown_wanted} is needed: a value is cast to the class a place wants through that class's conversion, and {shown_wanted} declares no '{made}(from: {shown_given})'",
    )
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, given: String, wanted: String) {
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var given_article = typing.article_of(given)
    var wanted_article = typing.article_of(wanted)
    stopped(context, "{given_article} {given} cannot be used where {wanted_article} {wanted} is needed")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

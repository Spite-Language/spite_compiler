# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    owner: Model.ClassModel,
): Validators.Answer {
    var held = owner.bound_types["$value_type"]
    fallback held
    fallback held.is_a_bound_attribute()
    var printer = Printers.Spite.ExpressionPrinter(written)
    var shown = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{shown}' is a Spite.Attribute, and an instance's attributes are never replaced: write its field through it, '{shown}.value = ...'",
    )
}

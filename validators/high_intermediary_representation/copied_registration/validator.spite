var registration = "ForeignCallback"
var walked = List<String>()
var holder = ""
var held = ""
var through = ""

# ../../../../spite_documentation/foreign_libraries.md#for-as-long-as-the-program-keeps-it-foreigncallback
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
    owner: Model.ClassModel,
    copy_name: String,
): Validators.Answer {
    var is_deep = copy_name != "copy"
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()
    var copying = "a copy"
    var doing = "share"
    var reason = "C calls back the one object that registered it"
    if is_deep {
        copying = "a deep copy"
        doing = "copy"
        reason = "C was given only the one it holds"
    }
    if owner.key == registration {
        return rules.mistake(
            context,
            "{copying} of a ForeignCallback would {doing} its C registration: {reason}, so keep the one ForeignCallback and make another for another registration",
        )
    }
    fallback holds_one(context, fitting, owner, is_deep)
    var shown = generic_constraint.plain_name_of(owner.shown)
    var shown_holder = generic_constraint.plain_name_of(holder)
    var place = "'{held}'"
    if holder != owner.shown {
        place = "'{shown_holder}.{held}', which it reaches through '{through}'"
    }
    return rules.mistake(
        context,
        "{copying} of {shown} would {doing} the C registration in {place}: {reason}, so make another {shown} instead of copying this one",
    )
}

# ../../../../spite_documentation/foreign_libraries.md#for-as-long-as-the-program-keeps-it-foreigncallback
func holds_one(
    context: HighIntermediaryRepresentation.Building.Context,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
    model: Model.ClassModel,
    is_deep: Boolean,
): Boolean {
    fallback not walked.contains(model.key)
    walked.append(model.key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if reaches(context, fitting, attribute.attribute_type, is_deep) {
            if holder.is_empty() {
                holder = model.shown
                held = attribute.name
            }
            through = attribute.name
            return true
        }
        index = index + 1
    }
    return false
}

func reaches(
    context: HighIntermediaryRepresentation.Building.Context,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
    held_type: Model.Type,
    is_deep: Boolean,
): Boolean {
    if held_type.kind == 'union' {
        var united = fitting.union_model_of(held_type)
        return any_reaches(context, fitting, united.members, is_deep)
    }
    if held_type.kind == 'shape' {
        fallback is_deep
        var fillers = context.program.fillers_of(held_type.name)
        return any_reaches(context, fitting, fillers, is_deep)
    }
    fallback held_type.kind == 'object' and held_type.name != "String"
    if held_type.name == registration {
        return true
    }
    var model = context.program.class_named(held_type.name)
    fallback model
    fallback not model.is_singleton
    var bound = model.bound_types.values()
    if any_reaches(context, fitting, bound, is_deep) {
        return true
    }
    fallback is_deep and not copies_itself(model)
    return holds_one(context, fitting, model, is_deep)
}

func any_reaches(
    context: HighIntermediaryRepresentation.Building.Context,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
    held_types: List<Model.Type>,
    is_deep: Boolean,
): Boolean {
    var index = 0
    while index < held_types.count() {
        var held_type = held_types[index]
        if reaches(context, fitting, held_type, is_deep) {
            return true
        }
        index = index + 1
    }
    return false
}

func copies_itself(model: Model.ClassModel): Boolean {
    var declared = model.function_named("deep_copy")
    fallback declared
    return not declared.is_synthetic
}

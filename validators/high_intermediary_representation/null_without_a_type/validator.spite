func check(context: HighIntermediaryRepresentation.Building.Context, made: SpiteCompiler.Value?): Validators.Answer {
    fallback not made
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'null' has no type here: it is written only where a type that may be null is expected, like 'var target: Monster? = null'",
    )
}

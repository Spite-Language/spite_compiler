func check(
    context: HighIntermediaryRepresentation.Building.Context,
    operand_type: Model.Type,
    function: Model.FunctionModel?,
    template: Model.FunctionModel?,
    operator_text: String,
    needed: String,
) {
    fallback not function
    fallback not template
    var shown = context.shown(operand_type)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "{operator_text} on a '{shown}' needs it to define '{needed}'")
}

func check_the_count(
    context: HighIntermediaryRepresentation.Building.Context,
    operand_type: Model.Type,
    function: Model.FunctionModel?,
    operator_text: String,
    needed: String,
    wanted_count: Integer,
) {
    fallback function
    var given_count = function.parameters.count()
    fallback given_count != wanted_count
    var shown = context.shown(operand_type)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "{operator_text} on a '{shown}' needs it to define '{needed}', and its '{function.name}' takes {given_count} arguments",
    )
}

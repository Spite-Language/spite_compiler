func check_a_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    line: Integer,
    name: String,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    value: SpiteCompiler.Expression?,
    earlier: AbstractSyntaxTree.Walk.Walk,
) {
    fallback not earlier.assigns(name)
    crash read.target
    crash value
    var item_printer = Printers.Spite.ExpressionPrinter(read)
    var item = item_printer.text()
    var list_printer = Printers.Spite.ExpressionPrinter(read.target)
    var listed = list_printer.text()
    var value_printer = Printers.Spite.ExpressionPrinter(value)
    var value_text = value_printer.text()
    stopped_at(
        context,
        line,
        "'{name}' was read from '{item}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{listed}' still holds the old item. Write '{item} = {value_text}' to replace the item, or give the new value a 'var' of its own",
    )
}

func check_a_replaced_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    line: Integer,
    name: String,
    item: String,
    owner: String,
    answered_by: String,
    writer: String,
    attribute: String,
    after: AbstractSyntaxTree.Walk.Walk,
    between: AbstractSyntaxTree.Walk.Walk,
) {
    fallback not after.names(name)
    fallback not between.assigns(name)
    var replacing = "a function of '{owner}' that writes '{item}'"
    if not writer.is_empty() {
        replacing = "'{owner}.{writer}', which writes '{attribute}'"
    }
    stopped_at(
        context,
        line,
        "'{name}' holds '{item}' of '{owner}', answered by '{answered_by}', so assigning it here changes only '{name}', and nothing reads '{name}' after: '{owner}' still holds the old item. Replace it through {replacing}, or give the new value a 'var' of its own",
    )
}

func check_a_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    line: Integer,
    name: String,
    attribute: String,
    shown: String,
    is_let_go: Boolean,
) {
    fallback not is_let_go
    var article = article_of(shown)
    stopped_at(
        context,
        line,
        "'{name}.{attribute}' is written here and '{name}' is never read after it: '{name}' is {article} '{shown}' only this function holds, so the write is lost when it is let go. Use what was written, return '{name}', keep it in an attribute or a list, or drop the write",
    )
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func stopped_at(context: HighIntermediaryRepresentation.Building.Context, line: Integer, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop_at(context, line, text)
}

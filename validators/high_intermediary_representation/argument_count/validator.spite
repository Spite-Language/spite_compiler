func check(context: HighIntermediaryRepresentation.Building.Context, shown: String, wanted: Integer, given: Integer) {
    fallback given != wanted
    refuse(context, shown, wanted, given)
}

func check_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
    is_variadic: Boolean,
) {
    fallback is_wrong(wanted, given, is_variadic)
    refuse(context, shown, wanted, given)
}

func check_a_value_call(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: SpiteCompiler.Expression?,
    wanted: Integer,
    given: Integer,
    is_variadic: Boolean,
) {
    fallback is_wrong(wanted, given, is_variadic)
    var printer = Printers.Spite.ExpressionPrinter(callee)
    var shown = printer.text()
    refuse(context, shown, wanted, given)
}

func check_a_method(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: String,
    name: String,
    wanted: Integer,
    given: Integer,
) {
    fallback given != wanted
    refuse(context, "{owner}.{name}", wanted, given)
}

func is_wrong(wanted: Integer, given: Integer, is_variadic: Boolean): Boolean {
    if is_variadic {
        return given < wanted - 1
    }
    return given != wanted
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, shown: String, wanted: Integer, given: Integer) {
    if shown.starts_with("Buffer.read_") and wanted == 0 and given == 1 {
        var length = shown.length()
        var name = shown.slice(7, length)
        crash name
        stopped(
            context,
            "'{name}' reads at the buffer's position and takes nothing: write '{name}_at(position)' to read anywhere else",
        )
    }
    stopped(context, "'{shown}' takes {wanted} arguments, and {given} are given")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

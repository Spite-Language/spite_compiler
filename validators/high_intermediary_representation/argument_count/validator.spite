func check(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
): Validators.Answer {
    fallback given != wanted
    return refuse(context, shown, wanted, given)
}

func check_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    parameters: List<Model.ParameterModel>,
    written: List<SpiteCompiler.Expression>,
): Validators.Answer {
    var wanted = parameters.count()
    var given = written.count()
    var last = parameters.last()
    var is_variadic = false
    if last {
        is_variadic = last.is_variadic
    }
    fallback is_wrong(wanted, given, is_variadic)
    return refuse(context, shown, wanted, given)
}

func check_a_value_call(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    local_type: Model.Type,
): Validators.Answer {
    var signature = local_type.signature_or_empty()
    var wanted = signature.parameters.count()
    var given = call.arguments.count()
    fallback is_wrong(wanted, given, signature.is_variadic)
    var printer = Printers.Spite.ExpressionPrinter(call.callee)
    var shown = printer.text()
    return refuse(context, shown, wanted, given)
}

func check_a_method(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: String,
    name: String,
    wanted: Integer,
    given: Integer,
): Validators.Answer {
    fallback given != wanted
    return refuse(context, "{owner}.{name}", wanted, given)
}

func is_wrong(wanted: Integer, given: Integer, is_variadic: Boolean): Boolean {
    if is_variadic {
        return given < wanted - 1
    }
    return given != wanted
}

func refuse(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
): Validators.Answer {
    if shown.starts_with("Buffer.read_") and wanted == 0 and given == 1 {
        var length = shown.length()
        var name = shown.slice(7, length)
        crash name
        return mistake(
            context,
            "'{name}' reads at the buffer's position and takes nothing: write '{name}_at(position)' to read anywhere else",
        )
    }
    return mistake(context, "'{shown}' takes {wanted} arguments, and {given} are given")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

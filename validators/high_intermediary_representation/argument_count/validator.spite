var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    wanted: Integer,
    given: Integer,
    is_variadic: Boolean,
) {
    fallback is_wrong(wanted, given, is_variadic)
    typing.refuse_argument_count(context, shown, wanted, given)
}

func check_a_value_call(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: SpiteCompiler.Expression?,
    wanted: Integer,
    given: Integer,
    is_variadic: Boolean,
) {
    fallback is_wrong(wanted, given, is_variadic)
    var printer = Printers.Spite.ExpressionPrinter(callee)
    var shown = printer.text()
    typing.refuse_argument_count(context, shown, wanted, given)
}

func check_a_method(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: String,
    name: String,
    wanted: Integer,
    given: Integer,
) {
    fallback given != wanted
    typing.refuse_argument_count(context, "{owner}.{name}", wanted, given)
}

func is_wrong(wanted: Integer, given: Integer, is_variadic: Boolean): Boolean {
    if is_variadic {
        return given < wanted - 1
    }
    return given != wanted
}

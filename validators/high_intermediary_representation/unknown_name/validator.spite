var scalars = Model.Scalars()

func check_a_read(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    fallback not context.scope.internal_name_of(name)
    fallback not context.current_class.attribute_named(name)
    fallback not context.current_class.function_named(name)
    refuse(context, name)
}

func check_an_assigned(
    context: HighIntermediaryRepresentation.Building.Context,
    attribute: Model.AttributeModel?,
    name: String,
) {
    fallback not attribute
    refuse(context, name)
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var namespace = context.current_class.file.namespace
    if name == "_memory" and scalars.is_a_scalar(namespace) {
        stopped(
            context,
            "'_memory' is the memory {namespace} is kept in, and the compiler keeps the value itself there: write 'this'",
        )
    }
    var class_file = context.resolver.state.symbols.find(name, namespace)
    if class_file {
        stopped(
            context,
            "'{name}' is a class, not a value: write '{name}()' to make one, and give it a name with 'var ... = '; for the class itself, pass it where a 'Spite.Class' is wanted",
        )
    }
    stopped(context, "'{name}' is not a local, an attribute or a function of '{context.current_class.shown}'")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

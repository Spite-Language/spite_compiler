var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check_the_count(context: HighIntermediaryRepresentation.Building.Context, count: Integer): Validators.Answer {
    fallback count != 1
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'is_same_instance' takes one value, the object asked about, as in 'first.is_same_instance(second)', and was given {count}",
    )
}

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    receiver_type: Model.Type,
    argument_type: Model.Type,
): Validators.Answer {
    var present = argument_type.present()
    var is_an_instance = receiver_type.kind == 'object' and receiver_type.name != "String"
    var is_the_same_class = is_an_instance and present.is_the_same_as(receiver_type)
    fallback not is_the_same_class
    var receiver_shown = context.shown(receiver_type)
    var receiver_name = generic_constraint.plain_name_of(receiver_shown)
    var argument_shown = context.shown(argument_type)
    var argument_name = generic_constraint.plain_name_of(argument_shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    if not is_an_instance {
        return rules.mistake(
            context,
            "'is_same_instance' asks whether two names hold the very same object, and a '{receiver_name}' is a value, not an object: compare it with '=='",
        )
    }
    return rules.mistake(
        context,
        "'is_same_instance' asks whether two names hold the very same object, so both are one class, and a '{argument_name}' is never the same object as a '{receiver_name}'",
    )
}

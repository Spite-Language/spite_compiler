var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check_the_count(context: HighIntermediaryRepresentation.Building.Context, count: Integer): Validators.Answer {
    fallback count != 1
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'is_same_instance' takes one value, the object asked about, as in 'first.is_same_instance(second)', and was given {count}",
    )
}

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    receiver_type: Model.Type,
    argument_type: Model.Type,
): Validators.Answer {
    var present = argument_type.present()
    var is_an_instance = receiver_type.kind == 'object' and receiver_type.name != "String"
    var is_the_same_class = is_an_instance and present.is_the_same_as(receiver_type)
    fallback not is_the_same_class
    var receiver_shown = context.shown(receiver_type)
    var receiver_name = generic_constraint.plain_name_of(receiver_shown)
    var argument_shown = context.shown(argument_type)
    var argument_name = generic_constraint.plain_name_of(argument_shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    if not is_an_instance {
        return rules.mistake(
            context,
            "'is_same_instance' asks whether two names hold the very same object, and a '{receiver_name}' is a value, not an object: compare it with '=='",
        )
    }
    return rules.mistake(
        context,
        "'is_same_instance' asks whether two names hold the very same object, so both are one class, and a '{argument_name}' is never the same object as a '{receiver_name}'",
    )
}

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check_the_name(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Validators.Answer {
    var path = context.path()
    fallback not context.resolver.state.symbols.generated_texts[path]
    fallback call.arguments.count() == 1
    crash callee.target
    var receiver_printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = receiver_printer.text()
    var argument = call.arguments[0]
    var argument_printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = argument_printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'is_same_instance' is what '===' calls: write '{receiver_text} === {argument_text}', or '{receiver_text} !== {argument_text}' for 'not {receiver_text}.is_same_instance({argument_text})'",
    )
}

# ../../../../spite_documentation/functions_and_operators.md#the-same-instance
func check_the_operands(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left_type: Model.Type,
    right_type: Model.Type,
    left_held: List<Model.Type>,
    right_held: List<Model.Type>,
): Validators.Answer {
    var symbol = "==="
    if binary.operator == 'not_equal_equal' {
        symbol = "!=="
    }
    var left_value = first_value_of(left_held)
    if left_value {
        return refuse_a_value(context, symbol, left_value)
    }
    var right_value = first_value_of(right_held)
    if right_value {
        return refuse_a_value(context, symbol, right_value)
    }
    fallback not context.current_function.typed_copy
    fallback not may_be_the_same(left_held, right_held)
    var left_present = left_type.present()
    var left_name = plain_name(context, left_present)
    var right_present = right_type.present()
    var right_name = plain_name(context, right_present)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{symbol}' asks whether two names hold the very same object, and a '{right_name}' is never the same object as a '{left_name}'",
    )
}

func refuse_a_value(
    context: HighIntermediaryRepresentation.Building.Context,
    symbol: String,
    value_type: Model.Type,
): Validators.Answer {
    var value_name = plain_name(context, value_type)
    var equality = "=="
    if symbol == "!==" {
        equality = "!="
    }
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{symbol}' asks whether two names hold the very same object, and a '{value_name}' is a value, not an object: compare it with '{equality}'",
    )
}

func plain_name(context: HighIntermediaryRepresentation.Building.Context, named: Model.Type): String {
    var shown = context.shown(named)
    return generic_constraint.plain_name_of(shown)
}

func first_value_of(held: List<Model.Type>): Model.Type? {
    var index = 0
    while index < held.count() {
        var member = held[index]
        if not is_an_object(member) {
            return member
        }
        index = index + 1
    }
    return null
}

func is_an_object(member: Model.Type): Boolean {
    if member.kind == 'shape' {
        return true
    }
    return member.kind == 'object' and member.name != "String"
}

func may_be_the_same(left_held: List<Model.Type>, right_held: List<Model.Type>): Boolean {
    var index = 0
    while index < left_held.count() {
        var member = left_held[index]
        if member.kind == 'shape' or holds_the_same(right_held, member) {
            return true
        }
        index = index + 1
    }
    return false
}

func holds_the_same(held: List<Model.Type>, wanted: Model.Type): Boolean {
    var index = 0
    while index < held.count() {
        var member = held[index]
        if member.kind == 'shape' or member.is_the_same_as(wanted) {
            return true
        }
        index = index + 1
    }
    return false
}

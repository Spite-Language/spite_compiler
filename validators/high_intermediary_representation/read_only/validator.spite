func check_a_getter(
    context: HighIntermediaryRepresentation.Building.Context,
    attribute: Model.AttributeModel?,
    getter: Model.FunctionModel?,
    owner: String,
    name: String,
): Validators.Answer {
    fallback not attribute and getter
    return refused(context, owner, name)
}

func check_a_member(
    context: HighIntermediaryRepresentation.Building.Context,
    member: Model.FunctionModel,
    shown: String,
    name: String,
): Validators.Answer {
    fallback not member.is_an_attribute and not member.is_a_function_member
    return refused(context, shown, name)
}

func refused(context: HighIntermediaryRepresentation.Building.Context, owner: String, name: String): Validators.Answer {
    var segments = owner.split(".")
    var last = segments.count() - 1
    var simple_name = segments[last]
    crash simple_name
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{name}' is read-only: '{simple_name}' answers it through get_{name}() and has no set_{name}(value)",
    )
}

func refuse_a_read_past_a_call(read: HighIntermediaryRepresentation.NarrowedRead, called: String, call_line: Integer) {
    var failure = Validators.Failure()
    failure.stop_inside(
        read.path,
        read.line,
        read.owner,
        read.function_name,
        "'{read.shown}' was proven before line {call_line}, where {called} may assign '{read.attribute.name}' again, so this read would use what the call left there, unproven: prove '{read.shown}' again after that line",
    )
}

func refuse_a_call_in_the_loop(read: HighIntermediaryRepresentation.NarrowedRead, called: String, call_line: Integer) {
    var failure = Validators.Failure()
    failure.stop_inside(
        read.path,
        call_line,
        read.owner,
        read.function_name,
        "{called} inside this loop may change '{read.attribute.name}', which undoes what was proven about '{read.shown}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

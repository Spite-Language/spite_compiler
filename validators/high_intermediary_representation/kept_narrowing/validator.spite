var fixes = Fixes.Fixes()

func check(
    read: HighIntermediaryRepresentation.NarrowedRead,
    changed: String,
    called: String,
    call_line: Integer,
    is_read_past_the_call: Boolean,
) {
    fixes.a_narrowing_was_taken_back()
    var failure = Diagnostics.Failure()
    if is_read_past_the_call {
        failure.stop_inside(
            read.path,
            read.line,
            read.owner,
            read.function_name,
            "'{read.shown}' was proven before line {call_line}, where {called} may assign '{changed}' again, so this read would use what the call left there, unproven: prove '{read.shown}' again after that line",
        )
        return
    }
    failure.stop_inside(
        read.path,
        call_line,
        read.owner,
        read.function_name,
        "{called} inside this loop may change '{changed}', which undoes what was proven about '{read.shown}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

# ../../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func check_a_shrink(
    read: HighIntermediaryRepresentation.NarrowedRead,
    called: String,
    call_line: Integer,
    is_read_past_the_call: Boolean,
) {
    fixes.a_narrowing_was_taken_back()
    var failure = Diagnostics.Failure()
    if is_read_past_the_call {
        failure.stop_inside(
            read.path,
            read.line,
            read.owner,
            read.function_name,
            "'{read.shown}' was proven before line {call_line}, where {called} may shrink what it reads, so this read may fall outside it: prove '{read.shown}' again after that line",
        )
        return
    }
    failure.stop_inside(
        read.path,
        call_line,
        read.owner,
        read.function_name,
        "{called} inside this loop may shrink what it reads, which undoes what was proven about '{read.shown}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

# ../../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func check_a_write(
    read: HighIntermediaryRepresentation.NarrowedRead,
    changed: String,
    write_line: Integer,
    is_read_past_the_write: Boolean,
) {
    fixes.a_narrowing_was_taken_back()
    var failure = Diagnostics.Failure()
    if is_read_past_the_write {
        failure.stop_inside(
            read.path,
            read.line,
            read.owner,
            read.function_name,
            "'{read.shown}' was proven before line {write_line}, where a write through another object may assign '{changed}' again, so this read would use what that write left there, unproven: prove '{read.shown}' again after that line",
        )
        return
    }
    failure.stop_inside(
        read.path,
        write_line,
        read.owner,
        read.function_name,
        "this write through another object inside this loop may change '{changed}', which undoes what was proven about '{read.shown}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

# ../../../PROOFS.md#a-getter-narrows-while-it-only-reads
func check_a_getter_with_an_effect(read: HighIntermediaryRepresentation.NarrowedRead, has_an_effect: Boolean) {
    fallback has_an_effect
    fixes.a_narrowing_was_taken_back()
    var failure = Diagnostics.Failure()
    failure.stop_inside(
        read.path,
        read.line,
        read.owner,
        read.function_name,
        "'{read.shown}' calls '{read.getter_name}' again here, and '{read.getter_name}' may change what it answers, so the check before proves nothing about this read: hold it once with 'var held = {read.shown}' and narrow 'held'",
    )
}

# ../../../PROOFS.md#a-getter-narrows-while-it-only-reads
func check_a_getter_change(
    read: HighIntermediaryRepresentation.NarrowedRead,
    changer: String,
    changed: String,
    line: Integer,
    is_read_past_the_change: Boolean,
) {
    fixes.a_narrowing_was_taken_back()
    var failure = Diagnostics.Failure()
    if is_read_past_the_change {
        failure.stop_inside(
            read.path,
            read.line,
            read.owner,
            read.function_name,
            "'{read.shown}' was proven before line {line}, where {changer} may assign '{changed}', which '{read.getter_name}' reads, so this read would call it again unproven: prove '{read.shown}' again after that line",
        )
        return
    }
    failure.stop_inside(
        read.path,
        line,
        read.owner,
        read.function_name,
        "{changer} inside this loop may assign '{changed}', which '{read.getter_name}' reads, which undoes what was proven about '{read.shown}' before the loop, and the next pass would read it unproven: prove it inside the loop instead",
    )
}

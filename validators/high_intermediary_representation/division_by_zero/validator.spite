func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    divides_decimals: Boolean,
    folded_divisor: Long?,
) {
    fallback operator == 'divide' or operator == 'remainder'
    fallback not divides_decimals
    fallback folded_divisor
    fallback folded_divisor == 0
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{shown}' divides by zero, which always halts the program: a whole number cannot be divided by zero, so divide by something else, or leave the step out",
    )
}

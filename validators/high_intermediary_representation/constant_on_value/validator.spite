func check(
    context: HighIntermediaryRepresentation.Building.Context,
    preset: Model.FunctionModel?,
    owner: String,
    name: String,
): Validators.Answer {
    fallback preset
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "'{name}' is a preset of the class {owner}, not of a value: write '{owner}.{name}()'")
}

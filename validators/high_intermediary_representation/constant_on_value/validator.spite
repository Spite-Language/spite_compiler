func check(
    context: HighIntermediaryRepresentation.Building.Context,
    preset: Model.FunctionModel?,
    owner: String,
    name: String,
) {
    fallback preset
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "'{name}' is a preset of the class {owner}, not of a value: write '{owner}.{name}()'")
}

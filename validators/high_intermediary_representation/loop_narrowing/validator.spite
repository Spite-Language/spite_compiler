# ../../../PROOFS.md#assigning-undoes-a-proof
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.CheckSite,
) {
    fallback site.has_a_loop and not site.is_still_narrowed
    if site.kind == "undone in the loop" {
        fallback site.is_narrowed_outside and site.is_read_in_the_loop
    }
    stopped(
        context,
        "assigning to '{site.written}' inside this loop undoes a narrowing made before the loop, and the next pass would read it unproven: narrow it inside the loop instead",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

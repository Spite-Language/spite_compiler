var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var scalars = Model.Scalars()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: SpiteCompiler.Value,
) {
    var bitwise = ["bits_and", "bits_or", "bits_exclusive_or"]
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback bitwise.contains(callee.name) and call.arguments.count() == 1 and not library.holds(path)
    if made.class == HighIntermediaryRepresentation.Values.Call {
        check_a_call(context, callee, call, made)
    }
}

func check_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: HighIntermediaryRepresentation.Values.Call,
) {
    var operand = made.arguments[0]
    fallback made.receiver and operand
    fallback made.receiver.value_type.kind == 'scalar'
    if operand.class == HighIntermediaryRepresentation.Values.Conversion {
        check_a_cut_operand(context, callee, call, made.receiver, operand)
    }
}

func check_a_cut_operand(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    receiver: SpiteCompiler.Value,
    operand: HighIntermediaryRepresentation.Values.Conversion,
) {
    var cuts = operand.kind == 'narrow' or operand.kind == 'narrow_decimal' or operand.kind == 'to_whole'
    var written = call.arguments[0]
    fallback cuts and operand.converted and callee.target and written
    var receiver_scalar = scalars.of(receiver.value_type.name)
    var given_scalar = scalars.of(operand.converted.value_type.name)
    fallback receiver_scalar and given_scalar
    fallback given_scalar.size > receiver_scalar.size or given_scalar.is_decimal
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    var shown = call_printer.text()
    var receiver_printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = receiver_printer.text()
    var operand_printer = Printers.Spite.ExpressionPrinter(written)
    var operand_text = operand_printer.text()
    var receiver_name = receiver.value_type.name
    var operand_name = operand.converted.value_type.name
    var receiver_article = typing.article_of(receiver_name)
    var operand_article = typing.article_of(operand_name)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{shown}' works in {receiver_article} {receiver_name}, since a bitwise function takes its receiver's type, and '{operand_text}' is {operand_article} {operand_name}, which would be cut to fit: store the receiver in {operand_article} {operand_name} first ('var wide: {operand_name} = {receiver_text}'), or store '{operand_text}' in {receiver_article} {receiver_name} first if it fits one",
    )
}

func check(context: HighIntermediaryRepresentation.Building.Context, known: Model.FunctionModel?, name: String) {
    fallback not known
    refused(context, name)
}

func check_an_owner(context: HighIntermediaryRepresentation.Building.Context, known: Model.FunctionModel) {
    fallback known.is_synthetic
    refused(context, "owner")
}

func refused(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'.{name}' of a function value is read where the compiler knows its function: name the function in a 'var' that is never assigned again, as in 'var shout = shouter.shout', and read 'shout.{name}'",
    )
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    known: Model.FunctionModel?,
    name: String,
): Validators.Answer {
    fallback not known
    return refused(context, name)
}

func check_an_owner(
    context: HighIntermediaryRepresentation.Building.Context,
    known: Model.FunctionModel,
): Validators.Answer {
    fallback known.is_synthetic
    return refused(context, "owner")
}

func refused(context: HighIntermediaryRepresentation.Building.Context, name: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'.{name}' of a function value is read where the compiler knows its function: name the function in a 'var' that is never assigned again, as in 'var shout = shouter.shout', and read 'shout.{name}'",
    )
}

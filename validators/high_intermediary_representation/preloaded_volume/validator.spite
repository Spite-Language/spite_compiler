# ../../../../spite_documentation/programs.md#preloaded-files
func check_a_volume(
    context: HighIntermediaryRepresentation.Building.Context,
    arguments: List<SpiteCompiler.Value>,
): Validators.Answer {
    var name_value = arguments.first()
    fallback name_value
    fallback name_value.class == HighIntermediaryRepresentation.Values.TextConstant
    var name = name_value.text
    var preloads = context.resolver.state.symbols.preloads
    var volume = preloads.volume_named(name)
    fallback not volume
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'Volume(\"{name}\")' names a volume nothing preloads: a volume is the last folder of what a 'preload' names, like 'preload \"assets/{name}\"'",
    )
}

# ../../../../spite_documentation/programs.md#preloaded-files
func check_the_reads(preloads: Symbols.Preloads, made: List<String>): Validators.Answer {
    var answer = Validators.Answer()
    var index = 0
    while index < preloads.volumes.count() {
        var volume = preloads.volumes[index]
        var made_as = volume.name.to_debug()
        if not made.contains(made_as) {
            var problem = Diagnostics.Problem(
                volume.preloaded_from,
                volume.line,
                "'preload \"{volume.written}\"' makes the volume '{volume.name}', and no 'Volume(\"{volume.name}\")' reads it: read it through 'var {volume.name} = Volume(\"{volume.name}\")' beside the attributes, or remove the preload",
            )
            answer.mistakes.append(problem)
        }
        index = index + 1
    }
    return answer
}

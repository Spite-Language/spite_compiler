# ../../ARCHITECTURE.md#validators
func check_an_evaluation(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    value: SpiteCompiler.Value,
) {
    var dropped = Validators.HighIntermediaryRepresentation.DroppedAnswer.Validator()
    dropped.check(context, written, value)
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    if not context.site_judges.is_empty() {
        context.judge_what_is_recorded()
    }
    finish(context, context.line, text)
}

func stop_at(context: HighIntermediaryRepresentation.Building.Context, line: Integer, text: String) {
    if not context.site_judges.is_empty() {
        context.judge_what_is_recorded()
    }
    finish(context, line, text)
}

func finish(context: HighIntermediaryRepresentation.Building.Context, line: Integer, text: String) {
    var path = context.path()
    var owner = plain_class_name(context.current_class.shown)
    var function_name = shown_function_name(context.current_function)
    var failure = Diagnostics.Failure()
    failure.stop_inside(path, line, owner, function_name, text)
}

# ../../ARCHITECTURE.md#validators
func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var path = context.path()
    var function_name = shown_function_name(context.current_function)
    var problem = Diagnostics.Problem(path, context.line, text)
    problem.class_name = plain_class_name(context.current_class.shown)
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistake = problem
    return answer
}

# ../../ARCHITECTURE.md#validators
func tell(context: HighIntermediaryRepresentation.Building.Context, answer: Validators.Answer) {
    fallback answer.mistake
    if not context.site_judges.is_empty() {
        context.judge_what_is_recorded()
    }
    answer.tell()
}

func shown_function_name(function: Model.FunctionModel): String {
    if function.declaration and function.is_a_walk_copy() {
        return function.declaration.name
    }
    return function.name
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if not opening {
        return shown
    }
    var sliced = shown.slice(0, opening)
    crash sliced
    return sliced
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func is_a_number(shown: String): Boolean {
    var numbers = [
        "Tiny"
        "Short"
        "Integer"
        "Long"
        "UnsignedTiny"
        "UnsignedShort"
        "UnsignedInteger"
        "UnsignedLong"
        "Float"
        "Double"
    ]
    return numbers.contains(shown)
}

func check(is_owned: Boolean, path: String, line: Integer, class_name: String, attribute: String) {
    fallback not is_owned
    var failure = Validators.Failure()
    failure.stop_at(
        path,
        line,
        class_name,
        "'{attribute}' holds its object inside it, but a value written into it is held elsewhere too: this is a fault of the compiler",
    )
}

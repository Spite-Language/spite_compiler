func check(context: HighIntermediaryRepresentation.Building.Context, value_type: Model.Type) {
    fallback not context.is_boolean(value_type)
    var shown = context.shown(value_type)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "a condition is a Boolean, and this is a {shown}: compare it with something, like 'count > 0' or 'name != \"\"'",
    )
}

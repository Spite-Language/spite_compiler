# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    instance_class: String,
    declaration_class: String,
    instance: String,
    declaration: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    if instance_class.is_empty() {
        return rules.mistake(
            context,
            "'{instance}.attributes[{declaration}]' indexes an instance whose class is known only while running with a declaration, so the compiler cannot check that the declaration is one of its class's own: index by its name, '{instance}.attributes[{declaration}.name]'",
        )
    }
    if declaration_class.is_empty() {
        return rules.mistake(
            context,
            "'{instance}.attributes[{declaration}]' indexes a {instance_class} with a declaration the compiler cannot tie to a class, so it cannot check that the declaration is one of {instance_class}'s own: keep it in a 'var' given once, from '{instance_class}.attributes[...]', or index by its name, '{instance}.attributes[{declaration}.name]'",
        )
    }
    fallback instance_class != declaration_class
    return rules.mistake(
        context,
        "'{declaration}' is a declaration of {declaration_class}, and '{instance}' is a {instance_class}: an instance is indexed only by a declaration of its own class",
    )
}

# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check_a_bound_member(
    context: HighIntermediaryRepresentation.Building.Context,
    attribute: Model.AttributeModel?,
    is_a_function: Boolean,
    instance_class: String,
    instance: String,
    declaration: String,
    member: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    if is_a_function {
        return rules.mistake(
            context,
            "'{instance}.attributes[{declaration}]' stands for '{member}', a function of {instance_class}, and a function has no Spite.Attribute: read '{instance}.attributes[{declaration}].value', which calls it",
        )
    }
    fallback not attribute
    return check(context, "", "", instance, declaration)
}

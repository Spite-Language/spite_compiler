# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    instance_class: String,
    declaration_class: String,
    instance: String,
    declaration: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var indexed = indexed_text(instance, declaration)
    var by_name = indexed_text(instance, "{declaration}.name")
    if instance_class.is_empty() {
        return rules.mistake(
            context,
            "'{indexed}' indexes an instance whose class is known only while running with a declaration, so the compiler cannot check that the declaration is one of its class's own: index by its name, '{by_name}'",
        )
    }
    if declaration_class.is_empty() {
        return rules.mistake(
            context,
            "'{indexed}' indexes a {instance_class} with a declaration the compiler cannot tie to a class, so it cannot check that the declaration is one of {instance_class}'s own: keep it in a 'var' given once, from '{instance_class}.attributes[...]', or index by its name, '{by_name}'",
        )
    }
    fallback instance_class != declaration_class
    if instance.is_empty() {
        return rules.mistake(
            context,
            "'{declaration}' is a declaration of {declaration_class}, and '{indexed}' indexes this {instance_class}: an instance is indexed only by a declaration of its own class",
        )
    }
    return rules.mistake(
        context,
        "'{declaration}' is a declaration of {declaration_class}, and '{instance}' is a {instance_class}: an instance is indexed only by a declaration of its own class",
    )
}

# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check_a_bound_member(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel?,
    instance: String,
    declaration: String,
    member: String,
): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    if not model {
        return check(context, "", "", instance, declaration)
    }
    fallback not model.attribute_named(member)
    var indexed = indexed_text(instance, declaration)
    if model.function_named(member) {
        return rules.mistake(
            context,
            "'{indexed}' stands for '{member}', a function of {model.shown}, and a function has no Spite.Attribute: read '{indexed}.value', which calls it",
        )
    }
    return check(context, "", "", instance, declaration)
}

func indexed_text(instance: String, key: String): String {
    if instance.is_empty() {
        return "attributes[{key}]"
    }
    return "{instance}.attributes[{key}]"
}

# ../../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func check_an_untied_declaration(
    context: HighIntermediaryRepresentation.Building.Context,
    instance_class: String,
    instance: String,
    declaration: String,
): Validators.Answer {
    var untied = ""
    return check(context, instance_class, untied, instance, declaration)
}

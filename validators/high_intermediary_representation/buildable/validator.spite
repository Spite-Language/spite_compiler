func check_a_callee(callee: SpiteCompiler.Expression?, path: String, line: Integer, class_name: String) {
    fallback callee.class != AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback callee.class != AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback callee.class != AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    var text = "this line uses a part of the language this compiler does not build yet"
    var failure = Diagnostics.Failure()
    failure.stop_at(path, line, class_name, text)
}

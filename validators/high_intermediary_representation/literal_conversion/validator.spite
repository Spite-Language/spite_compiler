# ../../../PROOFS.md#a-literal-that-converts-is-a-t
func check_a_site(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.LiteralSite,
) {
    fallback site.does_not_convert
    stopped(context, "the literal {site.shown_literal} does not convert: '{site.shown_conversion}' answers null for it")
}

func check_an_enum_name(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    name: String,
    enumeration: Model.EnumModel,
) {
    fallback not enumeration.values.contains(name)
    stopped(context, "the literal {literal} does not convert: {enumeration.name} has no value of that name")
}

func check_an_enum_number(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    number: Long,
    enumeration: Model.EnumModel,
) {
    fallback not enumeration.numbers.contains(number)
    stopped(context, "the literal {literal} does not convert: {enumeration.name} has no value of that number")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

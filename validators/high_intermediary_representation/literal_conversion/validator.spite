# ../../../PROOFS.md#a-literal-that-converts-is-a-t
func check_a_site(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.LiteralSite,
): Validators.Answer {
    var volume_answer = check_a_volume_path(context, site)
    if volume_answer.is_a_mistake() {
        return volume_answer
    }
    fallback site.does_not_convert
    return mistake(
        context,
        "the literal {site.shown_literal} does not convert: '{site.shown_conversion}' answers null for it",
    )
}

# ../../../../spite_documentation/programs.md#preloaded-files
func check_a_volume_path(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.LiteralSite,
): Validators.Answer {
    fallback site.call.function.owner == "Path"
    var given = site.call.arguments.first()
    fallback given
    fallback given.class == HighIntermediaryRepresentation.Values.TextConstant
    var text = given.text
    var at = text.index_of("://")
    fallback at
    fallback at > 1
    var name = text.slice(0, at)
    fallback name
    var plain = not name.contains("/") and not name.contains("\\") and not name.contains(":")
    fallback plain
    var preloads = context.resolver.state.symbols.preloads
    fallback not preloads.volume_named(name)
    return mistake(
        context,
        "the literal {site.shown_literal} names the volume '{name}', and nothing preloads it: a volume is the last folder of what a 'preload' names",
    )
}

func check_an_enum_name(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    name: String,
    enumeration: Model.EnumModel,
): Validators.Answer {
    fallback not enumeration.values.contains(name)
    return mistake(context, "the literal {literal} does not convert: {enumeration.name} has no value of that name")
}

func check_an_enum_number(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    number: Long,
    enumeration: Model.EnumModel,
): Validators.Answer {
    fallback not enumeration.numbers.contains(number)
    return mistake(context, "the literal {literal} does not convert: {enumeration.name} has no value of that number")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

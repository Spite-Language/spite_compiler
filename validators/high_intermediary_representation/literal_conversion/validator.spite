# ../../../PROOFS.md#a-literal-that-converts-is-a-t
func check_a_site(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.LiteralSite,
): Validators.Answer {
    fallback site.does_not_convert
    return mistake(
        context,
        "the literal {site.shown_literal} does not convert: '{site.shown_conversion}' answers null for it",
    )
}

func check_an_enum_name(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    name: String,
    enumeration: Model.EnumModel,
): Validators.Answer {
    fallback not enumeration.values.contains(name)
    return mistake(context, "the literal {literal} does not convert: {enumeration.name} has no value of that name")
}

func check_an_enum_number(
    context: HighIntermediaryRepresentation.Building.Context,
    literal: String,
    number: Long,
    enumeration: Model.EnumModel,
): Validators.Answer {
    fallback not enumeration.numbers.contains(number)
    return mistake(context, "the literal {literal} does not convert: {enumeration.name} has no value of that number")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

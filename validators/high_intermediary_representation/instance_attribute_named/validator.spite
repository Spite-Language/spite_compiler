# ../../../../spite_documentation/reflection.md#known-only-at-run-time
func check_a_name(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    name: String,
    indexed: String,
): Validators.Answer {
    fallback not model.attribute_named(name) or name.starts_with("_")
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "'{indexed}' names '{name}', and {model.shown} has no attribute '{name}'")
}

# ../../../../spite_documentation/reflection.md#known-only-at-run-time
func check_a_listing(context: HighIntermediaryRepresentation.Building.Context, listed: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{listed}' lists an instance's attributes as a value, so which attribute each item is would be known only while running, and its value would have no one type: walk them, '{listed}.each(visit)' with 'visit' taking the 'Spite.Attribute<...>' it reads, index one by a name written in the code, '{listed}[\"health\"]', or by a declaration kept in a 'var', and list their names through the class, as 'Monster.attributes.keys()'",
    )
}

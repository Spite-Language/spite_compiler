var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func choice_of(source: HighIntermediaryRepresentation.Building.Borrow.Source): String {
    if source.is_items {
        return "'{source.element}' fits a Vector, so the items of '{source.written}' are borrowed: "
    }
    return ""
}

func refuse_a_read_past_a_resize(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    resizer: String,
) {
    var choice = choice_of(source)
    var again = "read '{source.written}[index]' again after that line"
    if source.is_lent {
        again = "ask for the item again after that line"
    }
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}', and '{resizer}' on line {context.line} may move the items of '{source.written}', so '{name}' is not read after it: {again}, or keep '{name}.copy()', an independent object",
    )
}

func refuse_a_row_read_past_a_resize(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    resizer: String,
) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from '{source.written}', and '{resizer}' on line {context.line} may move the items of '{source.written}', so '{name}' is not read after it: make the row again after that line",
    )
}

func refuse_a_kept_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    attribute: String,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}' and cannot be kept in the attribute '{attribute}': keep '{name}.copy()', an independent object",
    )
}

func refuse_a_listed_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}' and cannot be put in a list: a list keeps '{name}.copy()', an independent object",
    )
}

func refuse_a_returned_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    var choice = choice_of(source)
    var lent = ""
    if source.is_lent {
        lent = "; a function lends its caller an item only by reading it from a singleton's Items or Vector itself, never one that was lent to it"
    }
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}' and cannot be returned: return '{name}.copy()', an independent object{lent}",
    )
}

func refuse_a_function_value(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    member: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}.{member}' would keep '{name}', which is borrowed from '{source.written}', in a function value: make it from a copy, 'var kept = {name}.copy()' and then 'kept.{member}'",
    )
}

func refuse_a_second_name(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    alias: String,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}', and a borrowed item has one name: use '{name}' itself instead of '{alias}', or keep '{name}.copy()', an independent object",
    )
}

func refuse_an_assigned_item(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}' and is not assigned again: read another item with a new 'var', such as 'var next = {source.written}[index]'",
    )
}

func refuse_an_unkept_collection(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    collection: String,
) {
    typing.stop(
        context,
        "'{name}' would be borrowed from '{collection}', which nothing keeps, so it is let go at the end of this line and the item with it: keep it in a 'var' first and borrow from that",
    )
}

func refuse_a_resizing_lend(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    called: String,
    resizer: String,
) {
    var choice = choice_of(source)
    typing.stop(
        context,
        "{choice}'{name}' is borrowed from '{source.written}' and lent to '{called}' for its call, and '{resizer}' on line {context.line} may move the items of '{source.written}': a function lent a borrowed item may not append to or remove from the collection it is borrowed from, directly or through what it calls; change the size of '{source.written}' before or after the call",
    )
}

func refuse_a_resizing_row_call(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    resizer: String,
) {
    typing.stop(
        context,
        "'{name}' borrows items from '{source.written}' for the call it is passed to, and '{resizer}' on line {context.line} may move the items of '{source.written}': a function that is handed a row may not append to or remove from the vectors it borrows from, directly or through what it calls",
    )
}

func refuse_a_kept_row(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    sources: String,
    attribute: String,
) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call and cannot be kept in the attribute '{attribute}': keep the values it needs, or a 'copy()' of one of its items",
    )
}

func refuse_a_listed_row(context: HighIntermediaryRepresentation.Building.Context, name: String, sources: String) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call and cannot be put in a list: a list keeps a 'copy()' of one of its items",
    )
}

func refuse_a_returned_row(context: HighIntermediaryRepresentation.Building.Context, name: String, sources: String) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call and cannot be returned: return the values the caller needs, or a 'copy()' of one of its items",
    )
}

func refuse_a_second_row_name(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    sources: String,
    alias: String,
) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call, and a row has one name: use '{name}' itself instead of '{alias}'",
    )
}

func refuse_an_assigned_row(context: HighIntermediaryRepresentation.Building.Context, name: String, sources: String) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call and is not assigned again: make each row with a new 'var'",
    )
}

func lent_opening(lent: HighIntermediaryRepresentation.Building.LentParameter): String {
    return "'{lent.name}' is lent to '{lent.function_name}' for one call, by the call on line {lent.call_line} of '{lent.caller}': it is the caller's item, read and written in place"
}

func refuse_a_lent_alias(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    alias: String,
) {
    var opening = lent_opening(lent)
    typing.stop(context, "{opening}, and a lent item has one name: use '{lent.name}' itself instead of '{alias}'")
}

func refuse_a_lent_kept(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    attribute: String,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, so '{lent.function_name}' does not keep it in the attribute '{attribute}': keep the values it needs, or have the caller pass something '{lent.function_name}' may keep",
    )
}

func refuse_a_lent_listing(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, so '{lent.function_name}' does not put it in a list, which would keep it: keep the values it needs",
    )
}

func refuse_a_lent_return(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
) {
    var opening = lent_opening(lent)
    typing.stop(context, "{opening}, so '{lent.function_name}' does not return it: return the values the caller needs")
}

func refuse_a_lent_function_value(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    member: String,
) {
    typing.stop(
        context,
        "'{lent.name}.{member}' would keep '{lent.name}' in a function value, and '{lent.name}' is lent to '{lent.function_name}' for one call, so '{lent.function_name}' does not keep it: call '{lent.name}.{member}()' directly, or keep the values it needs",
    )
}

# ../../../PROOFS.md#an-item-lent-to-a-call
func refuse_an_unfollowed_pass_on(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    called: String,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, and '{called}' is not a function the compiler follows while compiling (a function value, or a function of a value whose class is known only while the program runs), so '{lent.function_name}' does not pass it on to it: pass the attributes it needs",
    )
}

func refuse_a_library_pass_on(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    called: String,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, and '{called}' is a library function, which is never lent an item, so '{lent.function_name}' does not pass it on to it: pass the attributes it needs",
    )
}

func refuse_a_gathered_pass_on(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    called: String,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, and '{called}' gathers it into the list of its variadic arguments, which holds its own values and is never lent an item: pass the attributes it needs",
    )
}

func refuse_a_union_pass_on(
    context: HighIntermediaryRepresentation.Building.Context,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    called: String,
) {
    var opening = lent_opening(lent)
    typing.stop(
        context,
        "{opening}, and '{called}' takes it as a union, which holds its own values and is never lent an item: pass the attributes it needs, or give '{called}' a parameter of the item's own class",
    )
}

func refuse_a_library_lend(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    called: String,
) {
    typing.stop(
        context,
        "'{name}' is borrowed from '{source.written}', and '{called}' is a library function, which is never lent an item: pass the attributes it needs, or '{name}.copy()' where a snapshot is what it wants",
    )
}

func refuse_an_unfollowed_lend(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    called: String,
) {
    typing.stop(
        context,
        "'{name}' is borrowed from '{source.written}', and '{called}' is not a function the compiler follows while compiling (a function value, or a function of a value whose class is known only while the program runs), so it is never lent an item: pass the attributes it needs, or '{name}.copy()' where a snapshot is what it wants",
    )
}

func refuse_a_gathered_lend(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    called: String,
) {
    typing.stop(
        context,
        "'{name}' is borrowed from '{source.written}', and '{called}' gathers it into the list of its variadic arguments, which holds its own values and is never lent an item: pass the attributes it needs, or '{name}.copy()' where a snapshot is what it wants",
    )
}

func refuse_a_union_lend(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    called: String,
) {
    typing.stop(
        context,
        "'{name}' is borrowed from '{source.written}', and '{called}' takes it as a union, which holds its own values and is never lent an item: pass the attributes it needs, or give '{called}' a parameter of the item's own class",
    )
}

func refuse_an_assigned_row_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    sources: String,
    attribute: String,
) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call, so '{name}.{attribute}' is not assigned: write the item's attributes, such as '{name}.{attribute}.<attribute> = ...'",
    )
}

func refuse_a_row_passed_to_a_value(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    sources: String,
) {
    typing.stop(
        context,
        "'{name}' holds items borrowed from {sources} for this call and is passed only to a function called by name whose parameter is a 'type', which borrows it for that call: pass the attributes the function needs",
    )
}

func refuse_a_kept_value_in_a_row(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    key: String,
    shown: String,
) {
    var article = typing.article_of(shown)
    typing.stop(
        context,
        "'{name}' borrows items from a Vector, so each of its attributes is a borrowed item or a plain value: '{key}' holds {article} {shown}, which the row would have to keep",
    )
}

func refuse_a_reused_name(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    typing.stop(
        context,
        "'{name}' already names a value earlier in this block, and an item borrowed from '{source.written}' is given a name of its own: call it something new, such as 'var {name}_item = ...'",
    )
}

func refuse_a_lending_function_value(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    typing.stop(
        context,
        "'{called}' lends its caller an item of '{source.written}', which only a call written by name can borrow: a function value's caller would let go of an item it does not own, so '{called}' is not made a function value; call '{called}(...)' by name where the item is wanted",
    )
}

func refuse_another_lent_return(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
    other: String,
) {
    typing.stop(
        context,
        "'{called}' lends its caller an item of '{source.written}', which the caller writes in place and never lets go, so each of its returns is an item of '{source.written}' or null: '{other}' is neither, so return null for 'none', with a '?' result, or make it a function of its own",
    )
}

func refuse_a_lending_fit(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    shape: String,
    called: String,
    source: HighIntermediaryRepresentation.Building.Borrow.Source,
) {
    typing.stop(
        context,
        "'{shown}' does not fit type '{shape}': its '{called}' lends its caller an item of '{source.written}', which only a call written by name can borrow: a call through the type would let go of an item it does not own",
    )
}

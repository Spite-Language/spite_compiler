func check(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: Model.ClassModel,
    attribute: Model.AttributeModel?,
    name: String,
): Validators.Answer {
    fallback owner.key == "Build" and attribute
    var file_path = context.path()
    fallback not file_path.contains("/.spite/")
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'build.{name}' is a setting decided while compiling, which the program reads as a constant, so it cannot be written: set it on the command line, '--{name}=...', or in the program's 'build.spite'",
    )
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: Model.ClassModel,
    template_name: String,
    made_name: String,
    member: String,
    member_owner: Model.Type,
): Validators.Answer {
    var existing = owner.function_named(made_name)
    fallback existing
    var binding = existing.binding_or_empty()
    var is_written = binding.member.is_empty() and not existing.is_a_member_template()
    fallback is_written and existing.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = existing.declaration
    var kind = "member"
    if member_owner.kind == 'object' {
        kind = "attribute"
    }
    var member_shown = context.shown(member_owner)
    var opening = owner.shown.index_of("<")
    var owner_name = owner.shown
    if opening {
        var sliced_owner_name = owner.shown.slice(0, opening)
        crash sliced_owner_name
        owner_name = sliced_owner_name
    }
    var text = "the template '{template_name}' makes '{made_name}' for the {kind} '{member}' of '{member_shown}', which is already a function of '{owner_name}': rename the function or the template"
    var problem = Diagnostics.Problem(owner.file.path, declaration.line, text)
    problem.class_name = owner_name
    problem.function_name = made_name
    problem.is_among_the_attributes = made_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

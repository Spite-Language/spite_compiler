func refuse(
    path: String,
    line: Integer,
    owner_shown: String,
    template_name: String,
    made_name: String,
    kind: String,
    member: String,
    member_shown: String,
) {
    var opening = owner_shown.index_of("<")
    var owner_name = owner_shown
    if opening {
        owner_name = owner_shown.slice(0, opening)
    }
    var text = "the template '{template_name}' makes '{made_name}' for the {kind} '{member}' of '{member_shown}', which is already a function of '{owner_name}': rename the function or the template"
    var failure = Validators.Failure()
    failure.stop_inside(path, line, owner_name, made_name, text)
}

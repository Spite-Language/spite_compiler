func check_a_member(
    context: HighIntermediaryRepresentation.Building.Context,
    member: Model.FunctionModel,
    path: List<String>,
): Validators.Answer {
    crash member.answer
    fallback not member.is_an_attribute or member.answer.kind != 'scalar'
    var written = path.join(".")
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{written}.size' is the size of the C struct a type is at a foreign call, and only a type whose attributes are all numbers is one",
    )
}

var generic_constraint = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    owner: Model.ClassModel,
    function: Model.FunctionModel,
): Validators.Answer {
    fallback function.name == "drop" and function.parameters.is_empty() and not function.answer
    var shown = generic_constraint.plain_name_of(owner.shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'drop' runs on its own when the last reference to a '{shown}' goes, and is never called by name: let go of the reference instead, by assigning another value or leaving the block",
    )
}

# ../../../../spite_documentation/metaprogramming.md#walking-a-programs-structure
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    class_path: List<String>,
    described_class: Model.Type,
): Validators.Answer {
    fallback described_class.kind == 'shape'
    var written = class_path.join(".")
    var shown = context.shown(described_class)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{written}.attributes' walks the attributes of a class, and '{written}' is '{shown}', a type, whose members are not attributes: walk a class, or read each of the type's members by its name",
    )
}

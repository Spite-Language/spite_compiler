func check_a_held_collection(
    context: HighIntermediaryRepresentation.Building.Context,
    element: Model.Type,
    held: Model.ClassModel,
) {
    var collections = ["List", "Dictionary", "Vector", "Items"]
    fallback collections.contains(held.file.namespace)
    var shown = context.shown(element)
    stopped(
        context,
        "a Vector holds each item inline, so an item is a number, a Boolean, an enum, a String or a class made only of those, and a {shown} is not: keep it in a 'List<{shown}>'",
    )
}

func check_a_dropped_item(
    context: HighIntermediaryRepresentation.Building.Context,
    element: Model.Type,
    held: Model.ClassModel,
) {
    fallback held.function_named("drop")
    var shown = context.shown(element)
    stopped(
        context,
        "'{shown}' cannot be an item of a Vector: it has a 'drop()', and an item inline in a Vector is never an object of its own to drop (keep '{shown}' in a 'List<{shown}>')",
    )
}

func check_this_as_a_value(
    context: HighIntermediaryRepresentation.Building.Context,
    element: Model.Type,
    escaping: String,
) {
    fallback not escaping.is_empty()
    var shown = context.shown(element)
    stopped(
        context,
        "'{shown}.{escaping}' uses 'this' as a value, and an item of a Vector is borrowed from the Vector, never an object to keep or to pass on: read and write its attributes instead",
    )
}

func check_an_item(
    context: HighIntermediaryRepresentation.Building.Context,
    element: Model.Type,
    attribute: Model.AttributeModel,
    constraints: HighIntermediaryRepresentation.Building.Constraints,
) {
    fallback not constraints.is_kept_inline(attribute.attribute_type)
    var shown = context.shown(element)
    var attribute_shown = context.shown(attribute.attribute_type)
    var article = "a"
    var first = attribute_shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        article = "an"
    }
    stopped(
        context,
        "'{shown}' cannot be an item of a Vector: its attribute '{attribute.name}' is {article} {attribute_shown}, and a Vector holds each item inline, so every attribute is a number, a Boolean, an enum or a String (keep '{shown}' in a 'List<{shown}>', or keep '{attribute.name}' somewhere else)",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

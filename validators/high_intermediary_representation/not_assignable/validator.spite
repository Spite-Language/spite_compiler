func check(context: HighIntermediaryRepresentation.Building.Context, target: SpiteCompiler.Expression) {
    var is_a_local = target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var is_an_attribute = target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var is_an_index = target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback not is_a_local and not is_an_attribute and not is_an_index
    stopped(context)
}

func check_a_field_name(context: HighIntermediaryRepresentation.Building.Context, name: String) {
    fallback name.is_empty()
    stopped(context)
}

func stopped(context: HighIntermediaryRepresentation.Building.Context) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "only a local, an attribute or an index is assigned with '='")
}

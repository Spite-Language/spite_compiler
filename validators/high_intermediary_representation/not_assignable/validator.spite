func check(
    context: HighIntermediaryRepresentation.Building.Context,
    target: SpiteCompiler.Expression,
): Validators.Answer {
    var is_a_local = target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var is_an_attribute = target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var is_an_index = target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback not is_a_local and not is_an_attribute and not is_an_index
    return mistake(context)
}

func check_a_field_name(context: HighIntermediaryRepresentation.Building.Context, name: String): Validators.Answer {
    fallback name.is_empty()
    return mistake(context)
}

func mistake(context: HighIntermediaryRepresentation.Building.Context): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "only a local, an attribute or an index is assigned with '='")
}

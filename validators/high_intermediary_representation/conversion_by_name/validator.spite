# ../../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made_type: Model.Type,
    expected: Model.Type?,
    shown: String,
) {
    fallback not shown.is_empty()
    var argument = call.arguments[0]
    var printer = Printers.Spite.ExpressionPrinter(call)
    var call_text = printer.text()
    var argument_printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = argument_printer.text()
    if expected {
        var wanted = expected.present()
        if is_the_same_type(context, wanted, made_type) {
            stopped(
                context,
                "'{call_text}' is what writing '{argument_text}' here already does: the compiler casts a value to the class its place wants, so write '{argument_text}'",
            )
        }
    }
    stopped(
        context,
        "'{call_text}' calls a conversion by name, and the compiler applies a conversion only where a value meets the class it makes: give '{argument_text}' a place that wants it, as in 'var converted: {shown} = {argument_text}'",
    )
}

func is_the_same_type(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
): Boolean {
    var given_type = context.resolver.same_members.same_member_type(given)
    var wanted_type = context.resolver.same_members.same_member_type(wanted)
    return given_type.is_the_same_as(wanted_type)
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

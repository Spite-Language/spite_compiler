func check_a_test_to_collect(
    context: HighIntermediaryRepresentation.Building.Context,
    template_name: String,
    singular_type: Model.Type?,
    called: String,
    written: String,
    element_shown: String,
): Validators.Answer {
    fallback template_name.starts_with("map_")
    fallback singular_type
    fallback context.is_boolean(singular_type)
    return mistake_of_a_mapped_test(context, called, written, element_shown)
}

func check_a_mapped_test(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    member_type: Model.Type?,
    element_shown: String,
): Validators.Answer {
    fallback called.starts_with("map_") and not member.is_empty()
    crash member_type
    fallback context.is_boolean(member_type)
    var shown_member = member
    if member.starts_with("get_") {
        var length = member.length()
        var sliced_shown_member = member.slice(4, length)
        crash sliced_shown_member
        shown_member = sliced_shown_member
    }
    var parts = element_shown.split(".")
    var element_name = parts.last()
    crash element_name
    return mistake_of_a_mapped_test(context, called, shown_member, element_name)
}

func check_a_shared_plural(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    written: String,
    inflected: String,
    singular_member: String,
): Validators.Answer {
    fallback not inflected.is_empty() and not singular_member.is_empty() and inflected != singular_member
    return mistake(
        context,
        "'{called}' could collect every '{inflected}', whose plural is '{written}', or the member '{singular_member}' itself: rename one of the two members so that each template names one",
    )
}

func check_a_singular(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    written: String,
    inflected: String,
    singular_member: String,
    plural: String,
): Validators.Answer {
    fallback inflected.is_empty()
    fallback not singular_member.is_empty()
    fallback plural != written and not written.ends_with("s")
    var called_plural = called.replace(written, plural)
    return mistake(context, "'{called}' answers every '{written}', so it is written in the plural: '{called_plural}'")
}

func mistake_of_a_mapped_test(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    member: String,
    element: String,
): Validators.Answer {
    return mistake(
        context,
        "'{called}': the member '{member}' of '{element}' is a Boolean, but 'map_' needs it to be a value to collect, not a test: write 'filter_{member}()' to keep the elements it is true for, 'count_{member}()' to count them, or 'any_{member}()' or 'all_{member}()' to ask whether any or all of them pass",
    )
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

func check_the_first(context: HighIntermediaryRepresentation.Building.Context, first: SpiteCompiler.Expression?) {
    fallback not first
    refused(context)
}

func check_the_element(context: HighIntermediaryRepresentation.Building.Context, element: Model.Type) {
    fallback element.kind == 'nothing'
    refused(context)
}

func refused(context: HighIntermediaryRepresentation.Building.Context) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "this list's type cannot be read from its first item: declare it, 'var items: List<Item> = [...]'",
    )
}

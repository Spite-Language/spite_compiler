func check_the_first(
    context: HighIntermediaryRepresentation.Building.Context,
    first: SpiteCompiler.Expression?,
): Validators.Answer {
    fallback not first
    return refused(context)
}

func check_the_element(
    context: HighIntermediaryRepresentation.Building.Context,
    element: Model.Type,
): Validators.Answer {
    fallback element.kind == 'nothing'
    return refused(context)
}

func refused(context: HighIntermediaryRepresentation.Building.Context): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "this list's type cannot be read from its first item: declare it, 'var items: List<Item> = [...]'",
    )
}

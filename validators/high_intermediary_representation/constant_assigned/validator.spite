var scalars = Model.Scalars()

func check(context: HighIntermediaryRepresentation.Building.Context, class_path: List<String>, name: String) {
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "'{written}.{name}' is a constant, and a constant is get-only: nothing can assign it")
}

var scalars = Model.Scalars()

func check_a_preset(
    context: HighIntermediaryRepresentation.Building.Context,
    preset: Model.FunctionModel?,
    described: Model.Type,
    number: Model.ClassModel,
    written: String,
    name: String,
) {
    fallback not preset and described.kind == 'scalar'
    var constants = presets_listed(number)
    var number_preset = Validators.HighIntermediaryRepresentation.NumberPreset.Validator()
    number_preset.refuse(context, written, name, constants)
}

func check_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    class_path: List<String>,
    receiver_type: Model.Type,
    name: String,
) {
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    var reflection_model = context.class_of(receiver_type)
    fallback not reflection_model.function_named(name)
    var number = number_class_of(context, class_path)
    var constants = presets_listed(number)
    var names = Mapping.Names()
    var spelled = names.class_name_of(name)
    if number.preset_named(spelled) {
        var called_constant = Validators.HighIntermediaryRepresentation.CalledConstant.Validator()
        called_constant.refuse(context, "{written}.{name}", "{written}.{spelled}()")
    }
    var function = number.function_named(name)
    if function {
        refuse_a_value_function(context, written, name, constants)
    }
    var number_preset = Validators.HighIntermediaryRepresentation.NumberPreset.Validator()
    number_preset.refuse(context, written, name, constants)
}

func number_class_of(
    context: HighIntermediaryRepresentation.Building.Context,
    class_path: List<String>,
): Model.ClassModel {
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.types.class_type_in(
        class_path,
        no_type_arguments,
        context.current_class,
        context.line,
    )
    return context.class_of(described)
}

func presets_listed(number: Model.ClassModel): String {
    var names = List<String>()
    var index = 0
    while index < number.declared_functions.count() {
        var function = number.declared_functions[index]
        if function.is_a_preset {
            names.append("{function.name}()")
        }
        index = index + 1
    }
    var last = names.remove_last()
    crash last
    if names.is_empty() {
        return last
    }
    var listed = names.join(", ")
    return "{listed} and {last}"
}

func refuse_a_value_function(
    context: HighIntermediaryRepresentation.Building.Context,
    class_name: String,
    name: String,
    constants: String,
) {
    var listed = constants.split(", ")
    var first_listed = listed[0]
    crash first_listed
    var first_words = first_listed.split(" and ")
    var first = first_words[0]
    crash first
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'{class_name}.{name}()' calls a function of a value on the class: the class {class_name} answers only its presets, {constants}, so call '{name}' on a {class_name}, like 'value.{name}()', or call one of its presets, like '{class_name}.{first}'",
    )
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    held_type: Model.Type,
    name: String,
): Validators.Answer {
    fallback held_type.kind != 'function'
    var shown = context.shown(held_type)
    return mistake(context, "'{name}' is a {shown}, not a function, so it cannot be called")
}

func check_an_indexed_value(
    context: HighIntermediaryRepresentation.Building.Context,
    held_type: Model.Type,
    callee: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Validators.Answer {
    fallback held_type.kind != 'function'
    var printer = Printers.Spite.ExpressionPrinter(callee)
    var written = printer.text()
    return check(context, held_type, written)
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

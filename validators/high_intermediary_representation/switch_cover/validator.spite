func check_the_rest(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    is_an_enum: Boolean,
    every: List<String>,
    written: List<String>,
) {
    fallback written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback missing.is_empty()
    var text = "every member of '{shown}' already has a case, so '_:' answers for nothing: remove it"
    if is_an_enum {
        text = "every value of '{shown}' already has a case, so '_:' answers for nothing: remove it"
    }
    stopped(context, text)
}

func refuse_a_class_case(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    class_name: String,
    first: String,
) {
    var article = article_of(shown)
    stopped(
        context,
        "'{class_name}' is a class, and a case of a switch over {article} {shown} is one of its values, like '{first}', never a class",
    )
}

func refuse_a_value_case(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    value_text: String,
    member: String,
) {
    stopped(
        context,
        "{value_text} is a value, and a case of a switch over the union '{shown}' is one of its members, a class like '{member}', never a value",
    )
}

func refuse_no_rest(context: HighIntermediaryRepresentation.Building.Context, path: String, shown: String) {
    var article = article_of(shown)
    stopped(
        context,
        "this switch over '{path}' has no '_:': {article} {shown} has more values than a switch can list, so its last case is '_:', for every value without a case of its own",
    )
}

func article_of(shown: String): String {
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    return typing.article_of(shown)
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    typing.stop(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    subject: String,
    is_an_enum: Boolean,
    every: List<String>,
    written: List<String>,
) {
    fallback not written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback not missing.is_empty()
    var listed = missing.join(", ")
    var text = "this switch over '{subject}' has no case for {listed}: a switch over a union covers every member, so a member added later cannot be forgotten; add the cases"
    if is_an_enum {
        text = "this switch over '{subject}' has no case for {listed}: a switch over an enum covers every value, so a value added later cannot be forgotten; add the cases"
    }
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    typing.stop(context, text)
}

func check_the_nullable(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    every: List<String>,
    written: List<String>,
) {
    fallback not written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback not missing.is_empty()
    var listed = missing.join(", ")
    var article = article_of(shown)
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    typing.stop(
        context,
        "this switch over '{path}' has no case for {listed}: '{path}' is {article} {shown}, and a switch over a 'T?' covers its value and null, so a null cannot be forgotten; add the cases",
    )
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    subject: String,
    is_an_enum: Boolean,
    every: List<String>,
    written: List<String>,
) {
    assert not written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    assert not missing.is_empty()
    var listed = missing.join(", ")
    var text = "this switch over '{subject}' has no case for {listed}: a switch over a union covers every member, so a member added later cannot be forgotten; add the cases, or end with '_:' for the rest"
    if is_an_enum {
        text = "this switch over '{subject}' has no case for {listed}: a switch over an enum covers every value, so a value added later cannot be forgotten; add the cases, or end with '_:' for the rest"
    }
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    typing.stop(context, text)
}

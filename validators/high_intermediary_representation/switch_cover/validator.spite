func check_the_rest(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.SwitchSite,
) {
    fallback site.written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < site.every.count() {
        var name = site.every[index]
        if not site.written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback missing.is_empty()
    var text = "every member of '{site.shown}' already has a case, so '_:' answers for nothing: remove it"
    if site.is_an_enum {
        text = "every value of '{site.shown}' already has a case, so '_:' answers for nothing: remove it"
    }
    stopped(context, text)
}

func check_a_case_kind(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    class_path: List<String>,
    subject_type: Model.Type,
    first_value: String,
    first_member: String,
) {
    var shown = context.shown(subject_type)
    var is_an_enum = subject_type.kind == 'enumeration'
    var is_a_class = not class_path.is_empty() and not is_the_rest_case(written)
    if is_an_enum and is_a_class {
        var class_name = class_path.join(".")
        var article = article_of(shown)
        stopped(
            context,
            "'{class_name}' is a class, and a case of a switch over {article} {shown} is one of its values, like '{first_value}', never a class",
        )
    }
    var is_a_value = written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    is_a_value = is_a_value or written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    fallback not is_an_enum and is_a_value
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var value_text = printer.text()
    stopped(
        context,
        "{value_text} is a value, and a case of a switch over the union '{shown}' is one of its members, a class like '{first_member}', never a value",
    )
}

func check_a_written_value(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    shown: String,
    example: String,
) {
    fallback written
    fallback not is_the_rest_case(written)
    fallback written.class != AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    var printer = Printers.Spite.ExpressionPrinter(written)
    var value_text = printer.text()
    var form = "an expression"
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        form = "a name"
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        form = "a call"
    }
    var parts = shown.split(".")
    var plain = parts.last()
    crash plain
    var article = article_of(plain)
    stopped(
        context,
        "'{value_text}' is {form}, and a case of a switch over {article} {plain} is one of its values written out, like {example}: to choose by what '{value_text}' holds, compare with an 'if'",
    )
}

func is_the_rest_case(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == "_"
    }
    return false
}

func check_a_rest_case(
    context: HighIntermediaryRepresentation.Building.Context,
    subject_type: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
    last_case: SpiteCompiler.Expression?,
    path: String,
    line: Integer,
) {
    fallback not subject_type.is_nullable
    var is_a_whole_number = subject_type.kind == 'scalar' and values.is_a_whole_number(subject_type)
    var is_a_text = subject_type.kind == 'object' and subject_type.name == "String"
    fallback is_a_whole_number or is_a_text
    fallback not is_the_rest_case(last_case)
    var shown = context.shown(subject_type)
    var article = article_of(shown)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop_at(
        context,
        line,
        "this switch over '{path}' has no '_:': {article} {shown} has more values than a switch can list, so its last case is '_:', for every value without a case of its own",
    )
}

func check_closed_values(
    context: HighIntermediaryRepresentation.Building.Context,
    subject_type: Model.Type,
    path: String,
    line: Integer,
) {
    var present = subject_type.present()
    var is_closed = present.kind == 'enumeration' or present.kind == 'union'
    fallback not is_closed and not subject_type.is_nullable
    var is_a_class = present.kind == 'object' and present.name == "Spite.Class"
    var is_generated = context.path().contains("/.spite/")
    fallback not context.is_a_truth_value(present) and not is_a_class and not is_generated
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop_at(
        context,
        line,
        "'switch {path}' chooses among values with no closed set, so no case list is ever whole: switch on an enum's values or a union's members, or write the choice as 'if' tests",
    )
}

func article_of(shown: String): String {
    var first = shown.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.SwitchSite,
) {
    fallback not site.written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < site.every.count() {
        var name = site.every[index]
        if not site.written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback not missing.is_empty()
    var listed = missing.join(", ")
    var text = "this switch over '{site.subject}' has no case for {listed}: a switch over a union covers every member, so a member added later cannot be forgotten; add the cases"
    if site.is_an_enum {
        text = "this switch over '{site.subject}' has no case for {listed}: a switch over an enum covers every value, so a value added later cannot be forgotten; add the cases"
    }
    stopped(context, text)
}

func check_a_boolean(
    context: HighIntermediaryRepresentation.Building.Context,
    subject: String,
    every: List<String>,
    written: List<String>,
) {
    fallback not written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback not missing.is_empty()
    var listed = missing.join(", ")
    stopped(
        context,
        "this switch over '{subject}' has no case for {listed}: a switch over a Boolean covers true and false, so neither can be forgotten; add the cases, or write an 'if'",
    )
}

func check_the_nullable(
    context: HighIntermediaryRepresentation.Building.Context,
    path: String,
    shown: String,
    every: List<String>,
    written: List<String>,
) {
    fallback not written.contains("_")
    var missing = List<String>()
    var index = 0
    while index < every.count() {
        var name = every[index]
        if not written.contains(name) {
            missing.append(name)
        }
        index = index + 1
    }
    fallback not missing.is_empty()
    var listed = missing.join(", ")
    var article = article_of(shown)
    stopped(
        context,
        "this switch over '{path}' has no case for {listed}: '{path}' is {article} {shown}, and a switch over a 'T?' covers its value and null, so a null cannot be forgotten; add the cases",
    )
}

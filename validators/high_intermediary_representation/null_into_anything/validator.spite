# ../../../../spite_documentation/functions_and_operators.md#anything-never-holds-null
func check(context: HighIntermediaryRepresentation.Building.Context, expected: Model.Type?) {
    fallback expected
    fallback expected.kind == 'shape' and expected.name == "Anything"
    fallback not expected.is_nullable
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "'null' is given where an Anything is needed, and an Anything never holds null: write 'Anything?' only where none is a real answer (a real type says more), otherwise give it a value",
    )
}

func check(context: HighIntermediaryRepresentation.Building.Context, value_type: Model.Type): Validators.Answer {
    fallback not context.has_a_class(value_type)
    var shown = context.shown(value_type)
    if shown.ends_with("?") {
        return mistake(
            context,
            "this value may be null (it is a {shown}): narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
        )
    }
    return mistake(context, "a {shown} has no attributes or functions to reach with '.'")
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

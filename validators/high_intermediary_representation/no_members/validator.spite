func check(context: HighIntermediaryRepresentation.Building.Context, value_type: Model.Type) {
    fallback not context.has_a_class(value_type)
    var shown = context.shown(value_type)
    if shown.ends_with("?") {
        stopped(
            context,
            "this value may be null (it is a {shown}): narrow it first with 'if value \{ }', 'fallback value' or 'crash value'",
        )
        return
    }
    stopped(context, "a {shown} has no attributes or functions to reach with '.'")
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func check(context: HighIntermediaryRepresentation.Building.Context, number: Long, scalar: Model.Scalar?) {
    fallback scalar
    fallback scalar.size < 8
    var values: Long = 1
    var remaining = scalar.size * 8
    while remaining > 0 {
        values = values * 2
        remaining = remaining - 1
    }
    var lowest: Long = 0
    var highest = values - 1
    if scalar.is_signed {
        highest = values / 2 - 1
        lowest = lowest - values / 2
    }
    var largest_written = highest
    if scalar.is_signed {
        largest_written = highest + 1
    }
    fallback number > largest_written
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(scalar.name)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(
        context,
        "{number} does not fit in {article} {scalar.name}, whose numbers run from {lowest} to {highest}: store it in a wider type, or use a number that fits",
    )
}

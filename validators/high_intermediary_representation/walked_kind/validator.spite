func check_a_class_walk(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: Model.FunctionModel,
    described: Model.Type,
    described_class: Model.Type,
): Validators.Answer {
    fallback described.name == "Spite.Attribute"
    return refuse_a_walk_of_declarations(context, walker, described_class)
}

func check_a_named_walk(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: Model.FunctionModel,
    walked: Model.Type,
): Validators.Answer {
    var is_an_instance = walked.kind == 'object' and not walked.is_nullable
    fallback is_an_instance and walked.name != "Spite.Class"
    var model = context.class_of(walked)
    fallback not model.attribute_named("attributes")
    return refuse_a_walk_of_attributes(context, walker, walked)
}

func refuse_a_walk_of_declarations(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: Model.FunctionModel,
    described_class: Model.Type,
): Validators.Answer {
    var model = context.class_of(described_class)
    var first = model.declared_attributes[0]
    fallback first
    var shown = context.shown(described_class)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{walker.name}' takes a 'Spite.Attribute', an attribute bound to an instance, and '{first.name}' here is a declaration of '{shown}', which has no value: declare the parameter 'Spite.AttributeDeclaration', or walk an instance's attributes",
    )
}

func refuse_a_walk_of_attributes(
    context: HighIntermediaryRepresentation.Building.Context,
    walker: Model.FunctionModel,
    described_class: Model.Type,
): Validators.Answer {
    var model = context.class_of(described_class)
    var first = model.declared_attributes[0]
    fallback first
    var shown = context.shown(described_class)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{walker.name}' takes a 'Spite.AttributeDeclaration', the declaration of an attribute, and '{first.name}' here is an attribute bound to an instance of '{shown}': declare the parameter 'Spite.Attribute', or walk the class's attributes",
    )
}

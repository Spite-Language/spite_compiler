# ../../../../spite_documentation/reflection.md#whether-a-class-satisfies-a-type
func check_a_written_type(
    context: HighIntermediaryRepresentation.Building.Context,
    wanted: Model.Type?,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: SpiteCompiler.Expression,
): Validators.Answer {
    fallback not wanted
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var written_printer = Printers.Spite.ExpressionPrinter(written)
    var shown = written_printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{asked}.satisfies_type({shown})' is answered while compiling, so it takes the name of a type, a union or a class written in the code, like '{asked}.satisfies_type(Number)', and '{shown}' is not one",
    )
}

# ../../../../spite_documentation/reflection.md#whether-a-class-satisfies-a-type
func check_a_class_known_while_compiling(
    context: HighIntermediaryRepresentation.Building.Context,
    owner_key: String,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Validators.Answer {
    fallback owner_key == "Spite.Class" and callee.name == "satisfies_type"
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{asked}.satisfies_type(...)' is answered while compiling, and '{asked}' is a class known only at run time: ask it of a class named in the code or walked from one",
    )
}

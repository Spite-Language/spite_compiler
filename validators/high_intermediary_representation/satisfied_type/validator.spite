# ../../../../spite_documentation/reflection.md#whether-a-class-satisfies-a-type
func check_a_written_type(
    context: HighIntermediaryRepresentation.Building.Context,
    wanted: Model.Type?,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: SpiteCompiler.Expression,
): Validators.Answer {
    fallback not wanted
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var written_printer = Printers.Spite.ExpressionPrinter(written)
    var shown = written_printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{asked}.satisfies_type({shown})' is answered while compiling, so it takes the name of a type, a union or a class written in the code, like '{asked}.satisfies_type(Number)', and '{shown}' is not one",
    )
}

# ../../../../spite_documentation/reflection.md#whether-a-class-satisfies-a-type
func check_a_class_known_while_compiling(
    context: HighIntermediaryRepresentation.Building.Context,
    owner_key: String,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Validators.Answer {
    fallback callee.name == "satisfies_type"
    if owner_key == "Spite.Union" {
        return a_union_known_only_at_run_time(context, callee)
    }
    fallback owner_key == "Spite.Class"
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var wanted = call.arguments.first()
    if asked.ends_with(".class") and wanted {
        var wanted_printer = Printers.Spite.ExpressionPrinter(wanted)
        var shown = wanted_printer.text()
        return rules.mistake(
            context,
            "'{asked}.satisfies_type(...)' asks of a class known only at run time, which is answered for the class of a named value: hold the value in a local first and ask 'held.class.satisfies_type({shown})', which narrows 'held' to that type inside an 'if'",
        )
    }
    return rules.mistake(
        context,
        "'{asked}.satisfies_type(...)' is answered while compiling, and '{asked}' is a class known only at run time: ask it of a class named in the code or walked from one",
    )
}

# ../../../../spite_documentation/reflection.md#whether-a-union-satisfies-a-type
func a_union_known_only_at_run_time(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Validators.Answer {
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{asked}.satisfies_type(...)' is answered while compiling, and '{asked}' is a union known only at run time: ask it of a union named in the code ('Pet.satisfies_type(Named)'), read with a written name ('Shop.unions[\"Pet\"]') or bound to a codegen value ('$item_type')",
    )
}

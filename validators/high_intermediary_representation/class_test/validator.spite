# ../../../../spite_documentation/values_and_types.md#unions
func check_a_tested_class(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    tested: String,
    member: Model.Type,
    operator: AbstractSyntaxTree.Tokens.Token.Kind,
): Validators.Answer {
    var is_a_union = member.kind == 'union'
    fallback is_a_union or member.kind == 'shape'
    var full_name = context.shown(member)
    var described_names = HighIntermediaryRepresentation.Building.DescribedNames()
    var shown = described_names.simple_name_of(full_name)
    var kind = "a type"
    if is_a_union {
        kind = "a union"
    }
    var named = "'{written}' is {kind}"
    if written.starts_with("$") {
        named = "'{written}' is a type here, bound to '{shown}', {kind}"
    }
    var asked = asked_form(tested, written, operator)
    var instead = "ask whether the class fits it with '{asked}'"
    if is_a_union {
        instead = "test for one of the classes it holds, or ask whether the class is one of them with '{asked}'"
    }
    return mistake(context, "{named}, not a class, so '{tested}' is never equal to it: {instead}")
}

# ../../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func check_a_type_compared(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
): Validators.Answer {
    var is_a_union = member.kind == 'union'
    fallback is_a_union or member.kind == 'shape'
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class"
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    fallback operators.is_a_value_path(left.target)
    var right = binary.right
    fallback not values.names_the_walked_class(right)
    return fixable_where_written(context, binary)
}

# ../../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func check_an_unbuilt_class_test(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type?,
): Validators.Answer {
    fallback member and compares_a_class_unbuilt(binary, member)
    var sites = HighIntermediaryRepresentation.Building.FixableSite()
    var tree = sites.tree_of_known_code(context)
    if tree {
        return fixable_where_written(context, binary)
    }
    return unbuilt_mistake(context, binary, member)
}

# ../../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func check_an_unbuilt_class_test_in_an_argument(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type?,
): Validators.Answer {
    fallback member and compares_a_class_unbuilt(binary, member)
    return unbuilt_mistake(context, binary, member)
}

func compares_a_class_unbuilt(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type,
): Boolean {
    var is_a_type = member.kind == 'union' or member.kind == 'shape'
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    return is_a_type and compares and asks_a_class_unbuilt(binary.left)
}

func unbuilt_mistake(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type,
): Validators.Answer {
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var tested = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
    var written = right_printer.text()
    return check_a_tested_class(context, written, tested, member, binary.operator)
}

func asks_a_class_unbuilt(left: SpiteCompiler.Expression?): Boolean {
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return left.name.starts_with("$")
    }
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    if left.name == "class" {
        return names_a_value(left.target)
    }
    return asks_a_class_unbuilt(left.target)
}

func names_a_value(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var names = Mapping.Names()
        var first = written.name.byte_at(0)
        var is_a_name = not written.name.starts_with("$") and not names.is_upper_letter(first)
        return is_a_name and not written.is_a_class_name
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return not written.is_a_class_name and names_a_value(written.target)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return names_a_value(written.target)
    }
    return false
}

func fixable_where_written(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Validators.Answer {
    var sites = HighIntermediaryRepresentation.Building.FixableSite()
    var tree = sites.tree_of_known_code(context)
    fallback tree
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var tested = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
    var written = right_printer.text()
    var asked = asked_form(tested, written, binary.operator)
    var fixable = Validators.Answer()
    fixable.fix = "write '{asked}'"
    return fixable
}

# ../../../../spite_documentation/metaprogramming.md#asking-what-a-generic-was-given
func check_a_known_class_compared(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    values: HighIntermediaryRepresentation.Building.Values,
): Validators.Answer {
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    var left = binary.left
    var codegen_path = operators.codegen_path_of(left)
    var asks_a_walked_class = false
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class" {
        var target = left.target
        var function = context.current_function
        var binding = function.binding_or_empty()
        var is_bound = not function.bound_parameter().is_empty()
        if binding.member_type and is_bound and target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            asks_a_walked_class = target.name == function.bound_parameter()
        }
    }
    fallback asks_a_walked_class or not codegen_path.is_empty()
    var described = operators.type_compared_by(binary.right)
    fallback described
    var sites = HighIntermediaryRepresentation.Building.FixableSite()
    var tree = sites.tree_of_known_code(context)
    fallback tree
    var left_printer = Printers.Spite.ExpressionPrinter(left)
    var tested = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
    var written = right_printer.text()
    var asked = asked_form(tested, written, binary.operator)
    var fixable = Validators.Answer()
    fixable.fix = "write '{asked}'"
    return fixable
}

func asked_form(tested: String, written: String, operator: AbstractSyntaxTree.Tokens.Token.Kind): String {
    if operator == 'not_equal' {
        return "not {tested}.satisfies_type({written})"
    }
    return "{tested}.satisfies_type({written})"
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

# ../../../../spite_documentation/values_and_types.md#unions
func check_a_tested_class(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    tested: String,
    member: Model.Type,
) {
    var is_a_union = member.kind == 'union'
    fallback is_a_union or member.kind == 'shape'
    var full_name = context.shown(member)
    var parts = full_name.split(".")
    var shown = parts.last()
    crash shown
    var kind = "a type"
    var instead = "test for a class that fits it"
    if is_a_union {
        kind = "a union"
        instead = "test for one of the classes it holds"
    }
    var named = "'{written}' is {kind}"
    if written.starts_with("$") {
        named = "'{written}' is a type here, bound to '{shown}', {kind}"
    }
    stopped(
        context,
        "{named}, so it cannot be used as a value: '{tested}' is always one class, so the test could never be true: {instead}",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

# ../../../../spite_documentation/values_and_types.md#unions
func check_a_tested_class(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    tested: String,
    member: Model.Type,
    operator: AbstractSyntaxTree.Tokens.Token.Kind,
): Validators.Answer {
    var is_a_union = member.kind == 'union'
    fallback is_a_union or member.kind == 'shape'
    var full_name = context.shown(member)
    var parts = full_name.split(".")
    var shown = parts.last()
    crash shown
    var kind = "a type"
    if is_a_union {
        kind = "a union"
    }
    var named = "'{written}' is {kind}"
    if written.starts_with("$") {
        named = "'{written}' is a type here, bound to '{shown}', {kind}"
    }
    var asked = asked_form(tested, written, operator)
    var instead = "ask whether the class fits it with '{asked}'"
    if is_a_union {
        instead = "test for one of the classes it holds, or ask whether the class is one of them with '{asked}'"
    }
    return mistake(
        context,
        "{named}, not a class, so '{tested}' is never equal to it: {instead}",
    )
}

# ../../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func check_a_type_compared(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    member: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
): Validators.Answer {
    var is_a_union = member.kind == 'union'
    fallback is_a_union or member.kind == 'shape'
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class"
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    fallback operators.is_a_value_path(left.target)
    var right = binary.right
    var names_a_codegen_value = false
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_a_codegen_value = right.name.starts_with("$")
    }
    fallback not names_a_codegen_value
    var sites = HighIntermediaryRepresentation.Building.FixableSite()
    var tree = sites.tree_of(context)
    fallback tree
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var tested = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(right)
    var written = right_printer.text()
    var asked = asked_form(tested, written, binary.operator)
    var fixable = Validators.Answer()
    fixable.fix = "write '{asked}'"
    return fixable
}

func asked_form(tested: String, written: String, operator: AbstractSyntaxTree.Tokens.Token.Kind): String {
    if operator == 'not_equal' {
        return "not {tested}.satisfies_type({written})"
    }
    return "{tested}.satisfies_type({written})"
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

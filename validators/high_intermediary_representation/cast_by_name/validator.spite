var scalars = Model.Scalars()

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Validators.Answer {
    fallback callee.name.starts_with("from_")
    var inference = NameResolution.Inference()
    var class_path = inference.class_path_of(callee.target)
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    var names = Mapping.Names()
    var name = callee.name
    var name_length = name.length()
    var source_name = name.slice(5, name_length)
    crash source_name
    var source = names.class_name_of(source_name)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "there is no '{written}.{name}()': a conversion is written in the class it makes, 'func {written}(from: {source}): {written}?', and the compiler applies it, so cast by assignment: 'var converted: {written}? = value'",
    )
}

func check_a_function(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Validators.Answer {
    fallback not function
    return check(context, callee)
}

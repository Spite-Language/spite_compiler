# ../../../../spite_documentation/functions_and_operators.md#a-comparison-is-a-call-on-its-left-side
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left_type: Model.Type,
    right_type: Model.Type,
    values: HighIntermediaryRepresentation.Building.Values,
): Validators.Answer {
    var left = left_type.present()
    var right = right_type.present()
    var operators = HighIntermediaryRepresentation.Building.Operators(context, values)
    fallback operators.is_a_comparison(binary.operator)
    var numbers = context.is_a_number(left) and context.is_a_number(right)
    var into_a_class = takes_a_class(context, left) and holds_a_class(right)
    fallback numbers or into_a_class
    if numbers {
        var is_a_whole_literal = operators.is_a_literal_tree(binary.right) and values.is_a_whole_number(right)
        fallback not is_a_whole_literal
        fallback not fits_without_a_cut(context, values, right, left)
        fallback fits_without_a_cut(context, values, left, right)
    } else {
        fallback swapped_fits_the_held(context, values, left, right)
    }
    crash binary.left
    crash binary.right
    var turned_operator = operators.turned_around(binary.operator)
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.right, turned_operator, binary.left)
    var turned_printer = Printers.Spite.ExpressionPrinter(turned)
    var turned_text = turned_printer.text()
    var sites = HighIntermediaryRepresentation.Building.FixableSite()
    var tree = sites.tree_of(context)
    var either_reads_plainly = reads_plainly(binary.left) or reads_plainly(binary.right)
    if tree and either_reads_plainly {
        var fixable = Validators.Answer()
        fixable.fix = "swap the sides to '{turned_text}'"
        return fixable
    }
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var right_article = every_rule.article_of(right.name)
    var left_article = every_rule.article_of(left.name)
    var shown_left = context.shown(left)
    var shown_right = context.shown(right)
    if into_a_class {
        return every_rule.mistake(
            context,
            "this value is {right_article} {shown_right}, which may hold another class than {left_article} {shown_left}: narrow it to {left_article} {shown_left} on its own line first, or swap the sides ('{turned_text}')",
        )
    }
    if values.is_a_decimal_type(right) and values.is_a_whole_number(left) {
        return every_rule.mistake(
            context,
            "this value is {right_article} {shown_right}, which loses its fraction in {left_article} {shown_left}: write 'var converted: {shown_left}? = value' on the line above, and narrow that, or swap the sides ('{turned_text}')",
        )
    }
    if values.is_a_decimal_type(right) and values.is_a_decimal_type(left) {
        return every_rule.mistake(
            context,
            "this value is {right_article} {shown_right}, which loses precision in {left_article} {shown_left}: write 'var converted: {shown_left}? = value' on the line above, and narrow that, or swap the sides ('{turned_text}')",
        )
    }
    return every_rule.mistake(
        context,
        "this value is {right_article} {shown_right}, which may not fit in {left_article} {shown_left}: write 'var converted: {shown_left}? = value' on its own line, which is null when it does not fit, and narrow that, or swap the sides ('{turned_text}')",
    )
}

# ../../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func fits_without_a_cut(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    given: Model.Type,
    wanted: Model.Type,
): Boolean {
    var fitting = HighIntermediaryRepresentation.Building.Fitting(context, values)
    if given.is_the_same_as(wanted) or fitting.is_wider(wanted, given) {
        return true
    }
    return values.is_a_whole_number(given) and values.is_a_decimal_type(wanted)
}

func takes_a_class(context: HighIntermediaryRepresentation.Building.Context, left: Model.Type): Boolean {
    fallback left.kind == 'object' and left.name != "Spite.Class"
    return context.has_a_class(left)
}

func holds_a_class(right: Model.Type): Boolean {
    return right.kind == 'shape' or right.kind == 'union'
}

# ../../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func swapped_fits_the_held(
    context: HighIntermediaryRepresentation.Building.Context,
    values: HighIntermediaryRepresentation.Building.Values,
    left: Model.Type,
    right: Model.Type,
): Boolean {
    if right.kind == 'union' {
        return values.is_a_member_of(left, right)
    }
    var fitting = HighIntermediaryRepresentation.Building.Fitting(context, values)
    return right.is_anything() or fitting.satisfies(left, right)
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func reads_plainly(expression: SpiteCompiler.Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return reads_plainly(expression.target)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return reads_plainly(expression.operand)
    }
    var is_a_literal = expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    return is_a_literal or expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
}

func check(context: HighIntermediaryRepresentation.Building.Context, name: String, expected: Model.Type?) {
    if expected {
        fallback expected.kind != 'enumeration'
        if expected.name == "String" {
            stopped(
                context,
                "'{name}' in single quotes is an enum value literal, and text is wanted here: text is always written in double quotes, so write \"{name}\"",
            )
        }
    }
    stopped(
        context,
        "'{name}' is an enum value literal, and no enum is expected here: declare the enum it belongs to and write it where that enum is expected",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

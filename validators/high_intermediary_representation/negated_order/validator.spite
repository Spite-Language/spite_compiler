var sites = HighIntermediaryRepresentation.Building.FixableSite()
var opposite = AbstractSyntaxTree.DefaultGuard.Opposite()

# ../../../../spite_documentation/failure.md#an-if-that-only-returns-what-a-fallback-returns-is-a-fallback
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    guard: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
    built: SpiteCompiler.Value,
): Validators.Answer {
    fallback built.class != HighIntermediaryRepresentation.Values.WholeNumber
    var tree = sites.tree_of(context)
    fallback tree and not sites.is_fixed_already(context, guard.line)
    var negated = guard.condition
    fallback negated.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    crash negated.operand
    fallback every_order_is_total(context, negated.operand)
    var turned = opposite.flipped(negated.operand)
    var printer = Printers.Spite.ExpressionPrinter(turned)
    var asserted = printer.text()
    var answer = Validators.Answer()
    answer.fix = "write 'fallback {asserted}'"
    return answer
}

func every_order_is_total(
    context: HighIntermediaryRepresentation.Building.Context,
    condition: SpiteCompiler.Expression?,
): Boolean {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return binary_orders_are_total(context, condition)
    }
    return true
}

func binary_orders_are_total(
    context: HighIntermediaryRepresentation.Building.Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Boolean {
    var operator = binary.operator
    if operator == 'and' or operator == 'or' {
        var on_the_left = every_order_is_total(context, binary.left)
        var on_the_right = every_order_is_total(context, binary.right)
        return on_the_left and on_the_right
    }
    if not opposite.is_an_order(operator) {
        return true
    }
    var path = context.path()
    return context.orders.holds_a_total_order(path, binary)
}

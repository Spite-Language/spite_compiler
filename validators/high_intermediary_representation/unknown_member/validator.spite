var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func check_a_function(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    shown: String,
    name: String,
) {
    fallback not function
    refuse(context, shown, name)
}

func check_a_member(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    receiver_type: Model.Type,
    name: String,
) {
    fallback not function
    var shown = context.shown(receiver_type)
    refuse(context, shown, name)
}

func check_an_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    attribute: Model.AttributeModel?,
    value_type: Model.Type,
    name: String,
) {
    fallback not attribute
    var shown = context.shown(value_type)
    refuse(context, shown, name)
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, shown: String, name: String) {
    var advice = advice_for_member(shown, name)
    if not advice.is_empty() {
        stopped(context, advice)
    }
    var article = typing.article_of(shown)
    stopped(context, "{article} {shown} has no attribute or function '{name}'")
}

func advice_for_member(shown: String, name: String): String {
    if typing.is_a_number(shown) {
        return number_advice(shown, name)
    }
    if shown == "Spite.Class" and name == "source_folder" {
        return "a class has no one folder, since a reopening may live anywhere a program loads: ask its '.source_files', every file that declares or reopens it, and its namespace's '.source_directories'"
    }
    var through_the_declaration = [
        "arguments"
        "returns"
        "is_resumable"
        "returned_literal"
        "reads"
        "writes"
        "source_file"
        "argument_count"
        "name_fits"
    ]
    if shown == "Spite.Function" and through_the_declaration.contains(name) {
        return "a Spite.Function has no '{name}' of its own: write 'function.declaration.{name}'"
    }
    if (shown == "Spite.Attribute" or shown == "Spite.AttributeDeclaration") and name == "is_singleton" {
        return "{shown} has no 'is_singleton' of its own: write 'attribute.class.is_singleton'"
    }
    if shown == "String" and (name == "upper" or name == "lower") {
        return "text has no '{name}()': write '{name}_case()', which names what it does without abbreviating"
    }
    if shown.starts_with("List<") and is_a_byte_function(name) {
        return "List has no method '{name}': bytes are a Buffer, which has it: make them with 'Buffer()'"
    }
    if shown.starts_with("List<") {
        return list_advice(name)
    }
    if shown == "Buffer" and name.starts_with("write_") and not name.ends_with("_at") {
        var length = name.length()
        var rest = name.slice(6, length)
        crash rest
        return "Buffer has no method '{name}': write '{name}_at(position, value)', or 'append_{rest}(value)' to add at the end"
    }
    if shown.starts_with("Dictionary<") and name.starts_with("remove_where") {
        return "a Dictionary has no '{name}': its templates work on a copy of its values, so removing from it would change nothing: walk 'keys()' and call 'remove(key)' for each key to remove"
    }
    if shown.starts_with("Vector<") and name == "each" {
        var shown_length = shown.length()
        var element = shown.slice(7, shown_length)
        crash element
        if element != "String>" {
            return "'each' passes each item to a function, and an item of a Vector is borrowed from it, never passed on: give the item's class a function and call it with a member template, such as 'each_<function>()'"
        }
        return "'each' passes each item to a function, which a Vector never does: keep the values in a 'List<{element}' to pass them on"
    }
    if shown.starts_with("Items<") and name == "each" {
        return "'each' passes each item to a function, which Items never does, whichever storage it chose: give the item's class a function and call it with a member template, such as 'each_<function>()'"
    }
    return ""
}

func is_a_byte_function(name: String): Boolean {
    var whole_names = ["append_buffer", "read_buffer_at", "read_as_string", "read_string_at"]
    if whole_names.contains(name) {
        return true
    }
    var prefixes = ["read_", "append_", "write_"]
    var rest = ""
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        if name.starts_with(prefix) {
            var length = name.length()
            var prefix_length = prefix.length()
            var sliced_rest = name.slice(prefix_length, length)
            crash sliced_rest
            rest = sliced_rest
        }
        index = index + 1
    }
    fallback not name.starts_with("read_") or name.ends_with("_at")
    rest = without_suffix(rest, "_at")
    rest = without_suffix(rest, "_little_endian")
    rest = without_suffix(rest, "_big_endian")
    var numbers = [
        "byte"
        "tiny"
        "short"
        "integer"
        "long"
        "unsigned_tiny"
        "unsigned_short"
        "unsigned_integer"
        "unsigned_long"
        "float"
        "double"
    ]
    return numbers.contains(rest)
}

func without_suffix(text: String, suffix: String): String {
    if not text.ends_with(suffix) {
        return text
    }
    var length = text.length()
    var suffix_length = suffix.length()
    var sliced = text.slice(0, length - suffix_length)
    crash sliced
    return sliced
}

func number_advice(shown: String, name: String): String {
    if name == "text" {
        return "{shown} turns into text with 'to_string()', a cast like 'to_integer()': write 'to_string()'"
    }
    var bitwise = [
        "shifted_left"
        "shifted_right"
        "bits_and"
        "bits_or"
        "bits_exclusive_or"
        "bits_inverted"
        "set_bit_count"
        "leading_zero_count"
        "trailing_zero_count"
    ]
    if bitwise.contains(name) {
        var article = typing.article_of(shown)
        return "{article} {shown} has no function '{name}': the bitwise functions are on the whole numbers, Tiny to UnsignedLong. Cast it first, like 'var whole: Long = value'"
    }
    var is_decimal = shown == "Float" or shown == "Double"
    var whole_spellings = ["abs", "min", "max"]
    fallback is_decimal or whole_spellings.contains(name)
    var spelling = maths_spelling(name)
    fallback not spelling.is_empty()
    return "{shown} has no function '{name}': Spite spells it '{spelling}', since no name is abbreviated"
}

func maths_spelling(name: String): String {
    var others = [
        "sqrt"
        "sin"
        "cos"
        "tan"
        "asin"
        "acos"
        "atan"
        "atan2"
        "pow"
        "exp"
        "log"
        "log2"
        "log10"
        "ln"
        "ceil"
        "trunc"
        "abs"
        "fabs"
        "min"
        "max"
        "is_nan"
        "isnan"
        "is_infinity"
        "isinf"
        "isfinite"
    ]
    var spellings = [
        "square_root"
        "sine"
        "cosine"
        "tangent"
        "arc_sine"
        "arc_cosine"
        "arc_tangent"
        "arc_tangent_over"
        "power"
        "exponential"
        "logarithm"
        "logarithm_base_2"
        "logarithm_base_10"
        "logarithm"
        "ceiling"
        "truncate"
        "absolute"
        "absolute"
        "minimum"
        "maximum"
        "is_not_a_number"
        "is_not_a_number"
        "is_infinite"
        "is_infinite"
        "is_finite"
    ]
    var index = 0
    while index < others.count() {
        if others[index] == name {
            crash spellings[index]
            return spellings[index]
        }
        index = index + 1
    }
    return ""
}

func list_advice(name: String): String {
    if name == "map" {
        return "there is no 'map(function)': collect a member of each element with 'map_<member>()', and a value computed from each element by giving the element's class a read-only attribute (a 'get_<name>()' with no setter) and writing 'map_<name>()'"
    } else if name == "add" {
        return "List has no method 'add', which does not say where: write 'append' to add at the end, or 'prepend' at the start"
    } else if name == "pop" {
        return "List has no method 'pop': write 'remove_last()', or 'remove_first()' to take from the start"
    } else {
        return ""
    }
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

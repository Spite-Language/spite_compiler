var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
var chain = List<String>()
var visited = List<String>()
var why = "a default may only read attributes already given a value, directly or through the functions it calls"

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check(model: Model.ClassModel, attribute: Model.AttributeModel, names: List<String>, reads: List<List<String>>) {
    chain = List<String>()
    visited = List<String>()
    fallback reaches(attribute.name, attribute.name, names, reads)
    var text = wording(attribute.name)
    stop_at(model, attribute, text)
}

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check_the_moves(model: Model.ClassModel, moves: HighIntermediaryRepresentation.Building.DefaultMoves) {
    var index = 0
    while index < moves.placed.count() {
        var name = moves.placed[index]
        var placer = moves.placers[index]
        crash name and placer
        var at = moves.names.index_of(name)
        crash at
        var later = index + 1
        while later < moves.placed.count() {
            var after = moves.placed[later]
            var after_at = moves.names.index_of(after)
            crash after_at
            if after_at < at {
                check_a_move(model, moves, placer, name, at, after_at)
            }
            later = later + 1
        }
        index = index + 1
    }
}

func check_a_move(
    model: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
    placer: String,
    name: String,
    at: Integer,
    after_at: Integer,
) {
    var home = moves.homes[at]
    var after_home = moves.homes[after_at]
    crash home and after_home
    var told = told_below(moves.names, moves.reads, placer, name)
    if home.is_empty() or home != after_home {
        var text = "{told} in another file of the class: {why}, and the compiler moves a declaration only inside its own file, so give '{placer}' a default that does not read '{name}' and set it in the constructor"
        stop_on(model, placer, text)
    }
    fallback not moves.rewritable_homes.contains(home)
    stop_on(model, placer, "{told} in a file the compiler never rewrites: {why}, so declare '{name}' above '{placer}'")
}

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check_no_read_below(model: Model.ClassModel, names: List<String>, reads: List<List<String>>) {
    var reader = first_reader_of_a_later(names, reads)
    fallback not reader.is_empty()
    var read = first_later_read(names, reads, reader)
    var told = told_below(names, reads, reader, read)
    stop_on(model, reader, "{told}: {why}, so declare '{read}' above '{reader}'")
}

func told_below(names: List<String>, reads: List<List<String>>, reader: String, read: String): String {
    var at = names.index_of(reader)
    crash at
    var read_names = reads[at]
    crash read_names
    if read_names.contains(read) {
        return "the default of '{reader}' reads '{read}', declared below it"
    }
    return "the default of '{reader}' reads '{read}' through other defaults, declared below it"
}

func stop_on(model: Model.ClassModel, name: String, text: String) {
    var attribute = model.attribute_named(name)
    crash attribute
    stop_at(model, attribute, text)
}

func first_reader_of_a_later(names: List<String>, reads: List<List<String>>): String {
    var index = 0
    while index < names.count() {
        var name = names[index]
        var later = first_later_read(names, reads, name)
        if not later.is_empty() {
            return name
        }
        index = index + 1
    }
    return ""
}

func first_later_read(names: List<String>, reads: List<List<String>>, reader: String): String {
    var at = names.index_of(reader)
    fallback at
    var read_names = reads[at]
    crash read_names
    var index = 0
    while index < read_names.count() {
        var read = read_names[index]
        var position = names.index_of(read)
        if position and position > at {
            return read
        }
        index = index + 1
    }
    return ""
}

func stop_at(model: Model.ClassModel, attribute: Model.AttributeModel, text: String) {
    crash attribute.declaration
    var owner = every_rule.plain_class_name(model.shown)
    var failure = Diagnostics.Failure()
    failure.stop_at(attribute.declaration.path, attribute.declaration.line, owner, text)
}

func reaches(start: String, wanted: String, names: List<String>, reads: List<List<String>>): Boolean {
    var position = names.index_of(start)
    fallback position
    var read = reads[position]
    crash read
    var index = 0
    while index < read.count() {
        var name = read[index]
        if name == wanted {
            chain.append(name)
            return true
        }
        if not visited.contains(name) {
            visited.append(name)
            if reaches(name, wanted, names, reads) {
                chain.prepend(name)
                return true
            }
        }
        index = index + 1
    }
    return false
}

func wording(name: String): String {
    if chain.count() == 1 {
        return "the default of '{name}' reads '{name}' itself: {why}, and '{name}' has none until its default is done: give it a default that does not read it"
    }
    var first = chain[0]
    crash first
    var told = "the default of '{name}' reads '{first}'"
    var index = 1
    while index < chain.count() {
        var next = chain[index]
        told = "{told}, whose default reads '{next}'"
        index = index + 1
    }
    return "{told}: {why}, so none of them can come first: give one of them a default that reads none of the others"
}

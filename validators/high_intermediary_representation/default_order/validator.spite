var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
var chain = List<String>()
var visited = List<String>()
var why = "a default may only read or write attributes already given a value, directly or through the functions it calls"

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    names: List<String>,
    reads: List<List<String>>,
    writes: List<List<String>>,
) {
    chain = List<String>()
    visited = List<String>()
    fallback reaches(attribute.name, attribute.name, names, reads)
    var text = wording(attribute.name, names, writes)
    stop_at(model, attribute, text)
}

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check_the_moves(
    model: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
): Validators.Answer {
    var index = 0
    while index < moves.placed.count() {
        var name = moves.placed[index]
        var placer = moves.placers[index]
        crash name and placer
        var at = moves.names.index_of(name)
        crash at
        var later = index + 1
        while later < moves.placed.count() {
            var after = moves.placed[later]
            var after_at = moves.names.index_of(after)
            crash after_at
            if after_at < at {
                var answer = answer_for_a_move(model, moves, placer, name, at, after_at)
                if answer.mistake {
                    return answer
                }
            }
            later = later + 1
        }
        index = index + 1
    }
    var fixable = Validators.Answer()
    fixable.fix = "move each attribute above the defaults that use it"
    return fixable
}

func answer_for_a_move(
    model: Model.ClassModel,
    moves: HighIntermediaryRepresentation.Building.DefaultMoves,
    placer: String,
    name: String,
    at: Integer,
    after_at: Integer,
): Validators.Answer {
    var home = moves.homes[at]
    var after_home = moves.homes[after_at]
    crash home and after_home
    var how = moves.how_it_is_used(placer, name)
    var is_direct = moves.directly_uses(placer, name)
    var told = told_below(is_direct, how, placer, name)
    if home.is_empty() or home != after_home {
        var verb = plain_verb(how)
        var text = "{told} in another file of the class: {why}, and the compiler moves a declaration only inside its own file, so give '{placer}' a default that does not {verb} '{name}' and set it in the constructor"
        return mistake_on(model, placer, text)
    }
    fallback not moves.rewritable_homes.contains(home)
    return mistake_on(
        model,
        placer,
        "{told} in a file the compiler never rewrites: {why}, so declare '{name}' above '{placer}'",
    )
}

# ../../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func check_no_read_below(
    model: Model.ClassModel,
    names: List<String>,
    reads: List<List<String>>,
    writes: List<List<String>>,
) {
    var reader = first_reader_of_a_later(names, reads)
    fallback not reader.is_empty()
    var read = first_later_read(names, reads, reader)
    var how = how_it_uses(names, writes, reader, read)
    var told = told_below(true, how, reader, read)
    stop_on(model, reader, "{told}: {why}, so declare '{read}' above '{reader}'")
}

func told_below(is_direct: Boolean, how: String, user: String, used: String): String {
    if is_direct {
        return "the default of '{user}' {how} '{used}', declared below it"
    }
    return "the default of '{user}' {how} '{used}' through other defaults, declared below it"
}

func how_it_uses(names: List<String>, writes: List<List<String>>, user: String, used: String): String {
    var at = names.index_of(user)
    crash at
    var written_names = writes[at]
    crash written_names
    if written_names.contains(used) {
        return "writes"
    }
    return "reads"
}

func plain_verb(how: String): String {
    if how == "writes" {
        return "write"
    }
    return "read"
}

func mistake_on(model: Model.ClassModel, name: String, text: String): Validators.Answer {
    var attribute = model.attribute_named(name)
    crash attribute
    crash attribute.declaration
    var owner = every_rule.plain_class_name(model.shown)
    var problem = Diagnostics.Problem(attribute.declaration.path, attribute.declaration.line, text)
    problem.class_name = owner
    var answer = Validators.Answer()
    answer.mistake = problem
    return answer
}

func stop_on(model: Model.ClassModel, name: String, text: String) {
    var attribute = model.attribute_named(name)
    crash attribute
    stop_at(model, attribute, text)
}

func first_reader_of_a_later(names: List<String>, reads: List<List<String>>): String {
    var index = 0
    while index < names.count() {
        var name = names[index]
        var later = first_later_read(names, reads, name)
        if not later.is_empty() {
            return name
        }
        index = index + 1
    }
    return ""
}

func first_later_read(names: List<String>, reads: List<List<String>>, reader: String): String {
    var at = names.index_of(reader)
    fallback at
    var read_names = reads[at]
    crash read_names
    var index = 0
    while index < read_names.count() {
        var read = read_names[index]
        var position = names.index_of(read)
        if position and position > at {
            return read
        }
        index = index + 1
    }
    return ""
}

func stop_at(model: Model.ClassModel, attribute: Model.AttributeModel, text: String) {
    crash attribute.declaration
    var owner = every_rule.plain_class_name(model.shown)
    var failure = Diagnostics.Failure()
    failure.stop_at(attribute.declaration.path, attribute.declaration.line, owner, text)
}

func reaches(start: String, wanted: String, names: List<String>, reads: List<List<String>>): Boolean {
    var position = names.index_of(start)
    fallback position
    var read = reads[position]
    crash read
    var index = 0
    while index < read.count() {
        var name = read[index]
        if name == wanted {
            chain.append(name)
            return true
        }
        if not visited.contains(name) {
            visited.append(name)
            if reaches(name, wanted, names, reads) {
                chain.prepend(name)
                return true
            }
        }
        index = index + 1
    }
    return false
}

func wording(name: String, names: List<String>, writes: List<List<String>>): String {
    var first = chain[0]
    crash first
    var how = how_it_uses(names, writes, name, first)
    if chain.count() == 1 {
        var verb = plain_verb(how)
        return "the default of '{name}' {how} '{name}' itself: {why}, and '{name}' has none until its default is done: give it a default that does not {verb} it"
    }
    var told = "the default of '{name}' {how} '{first}'"
    var user = first
    var index = 1
    while index < chain.count() {
        var next = chain[index]
        var next_how = how_it_uses(names, writes, user, next)
        told = "{told}, whose default {next_how} '{next}'"
        user = next
        index = index + 1
    }
    return "{told}: {why}, so none of them can come first: give one of them a default that reads or writes none of the others"
}

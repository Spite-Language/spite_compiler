func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    parameter_count: Integer,
    indexed: Model.Type,
    doing: String,
    needed: String,
) {
    if not function {
        refused(context, indexed, doing, needed)
    }
    crash function
    fallback function.parameters.count() != parameter_count
    refused(context, indexed, doing, needed)
}

func refused(
    context: HighIntermediaryRepresentation.Building.Context,
    indexed: Model.Type,
    doing: String,
    needed: String,
) {
    var shown = context.shown(indexed)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, "{doing} a '{shown}' needs it to define '{needed}'")
}

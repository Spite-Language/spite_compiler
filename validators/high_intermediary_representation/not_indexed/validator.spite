var get_at_parameters = 1
var set_at_parameters = 2

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    indexed: Model.Type,
): Validators.Answer {
    return check_a_member(context, function, get_at_parameters, indexed, "indexing", "get_at(index)")
}

func check_a_write(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    indexed: Model.Type,
): Validators.Answer {
    return check_a_member(
        context,
        function,
        set_at_parameters,
        indexed,
        "assigning through an index on",
        "set_at(index, value)",
    )
}

func check_a_member(
    context: HighIntermediaryRepresentation.Building.Context,
    function: Model.FunctionModel?,
    parameter_count: Integer,
    indexed: Model.Type,
    doing: String,
    needed: String,
): Validators.Answer {
    if not function {
        return refused(context, indexed, doing, needed)
    }
    fallback function.parameters.count() != parameter_count
    return refused(context, indexed, doing, needed)
}

func refused(
    context: HighIntermediaryRepresentation.Building.Context,
    indexed: Model.Type,
    doing: String,
    needed: String,
): Validators.Answer {
    var shown = context.shown(indexed)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "{doing} a '{shown}' needs it to define '{needed}'")
}

func check(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    condition: SpiteCompiler.Value,
) {
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber {
        fallback condition.number == 0
        crash written
        var printer = Printers.Spite.ExpressionPrinter(written)
        var shown = printer.text()
        refuse(context, shown, "")
    }
}

func check_a_build_field(context: HighIntermediaryRepresentation.Building.Context, written: SpiteCompiler.Expression?) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_build_member(context, written)
    }
}

func check_a_build_member(
    context: HighIntermediaryRepresentation.Building.Context,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var target = member.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var holder = context.current_class.attribute_named(target.name)
        var settings = context.program.class_named("Build")
        fallback holder and settings and not context.scope.internal_name_of(target.name)
        fallback holder.attribute_type.kind == 'object' and holder.attribute_type.name == "Build"
        var field = settings.attribute_named(member.name)
        fallback field
        fallback context.is_a_truth_value(field.attribute_type)
        fallback not build_field_holds(context, field)
        var printer = Printers.Spite.ExpressionPrinter(member)
        var shown = printer.text()
        refuse(context, shown, "")
    }
}

func build_field_holds(context: HighIntermediaryRepresentation.Building.Context, field: Model.AttributeModel): Boolean {
    var given = context.build_value_given(field.name)
    if given {
        return given == "true"
    }
    if not field.declaration {
        return true
    }
    var value = field.declaration.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return value.kind != 'keyword_false'
    }
    return true
}

func check_a_branch(
    context: HighIntermediaryRepresentation.Building.Context,
    branch: HighIntermediaryRepresentation.Statements.If,
    decided: Integer,
    reasons: List<String>,
) {
    fallback decided == 1 and not branch.crashes_unless.is_empty()
    var said = reasons.join("; ")
    var text = text_of(context, branch.crashes_unless, said)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop_at(context, branch.line, text)
}

func refuse(context: HighIntermediaryRepresentation.Building.Context, written: String, reasons: String) {
    var text = text_of(context, written, reasons)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

func text_of(context: HighIntermediaryRepresentation.Building.Context, written: String, reasons: String): String {
    var shown = context.current_class.shown
    var place = ""
    if shown.contains("<") {
        place = " in {shown}"
    }
    var because = ""
    if not reasons.is_empty() {
        because = "; {reasons}"
    }
    return "'crash {written}' always halts{place}: its condition is decided while compiling and is false, so the program would stop here every time this function runs: call it only where the condition holds, or change what the condition asks{because}"
}

func refuse_a_crossing(context: HighIntermediaryRepresentation.Building.Context, shown: String) {
    stop(
        context,
        "a {shown} cannot cross into C: a foreign function takes numbers, Boolean, enum values, text and a type whose attributes are all numbers",
    )
}

func refuse_a_call_through_a_parameter(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "a foreign function is called through the attribute or variable that holds its DynamicLibrary(...), so the compiler knows which library to bind it in",
    )
}

func refuse_a_callback_parameter(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    parameter: String,
    shown: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "'{written}' is called by C, which passes numbers and addresses: '{parameter}' is {article} {shown}, so take it as a number, a Boolean or a Memory.Address (text C passes is read with 'terminated_text()')",
    )
}

func refuse_a_callback_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    shown: String,
) {
    var article = article_of(shown)
    stop(
        context,
        "'{written}' is called by C, which takes back a number, a Boolean or nothing: it returns {article} {shown}",
    )
}

func refuse_an_unnamed_callback(context: HighIntermediaryRepresentation.Building.Context) {
    stop(
        context,
        "ForeignCallback(...) takes a function named directly, like 'mixer.voice_ended', and where C passes it back its context: 'no_context', 'context_first' or 'context_last'",
    )
}

func refuse_an_unknown_place(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    stop(
        context,
        "'{written}' is not where C passes a callback its context: write 'no_context', 'context_first' or 'context_last'",
    )
}

func refuse_a_contextless_owner(
    context: HighIntermediaryRepresentation.Building.Context,
    function_name: String,
    owner: String,
) {
    stop(
        context,
        "'ForeignCallback({function_name}, 'no_context')' gives C no context to find its '{owner}' by, so '{function_name}' must belong to a singleton: move it into a singleton that tells them apart by what C passes, or hand C the context with 'context_first' or 'context_last'",
    )
}

func refuse_a_shared_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    function_name: String,
    reaching: String,
    owner: String,
    attribute: String,
    shown: String,
) {
    var reached = "'{attribute}' holds a {shown}"
    if reaching != function_name {
        reached = "'{attribute}', which it reaches through '{reaching}', holds a {shown}"
    }
    stop(
        context,
        "'{written}' may be called by C on a thread of its own, so '{function_name}' may reach only the attributes of its own '{owner}' that hold values, its locals and singletons: {reached}, which another thread may share. Keep it in a singleton the callback calls, which is made safe for threads, or give the callback numbers and text of its own",
    )
}

func article_of(shown: String): String {
    var first = shown.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var failure = Validators.Failure()
    var path = context.path()
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var owner = typing.plain_class_name(context.current_class.shown)
    failure.stop_inside(path, context.line, owner, context.current_function.name, text)
}

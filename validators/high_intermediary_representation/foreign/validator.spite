func check_a_crossing(
    context: HighIntermediaryRepresentation.Building.Context,
    crossing: Model.Type,
): Validators.Answer {
    fallback not crosses(context, crossing)
    var full_name = context.shown(crossing)
    var shown = plain_name(full_name)
    return mistake(
        context,
        "a {shown} cannot cross into C: a foreign function takes numbers, Boolean, enum values, text and a type whose attributes are all numbers",
    )
}

func crosses(context: HighIntermediaryRepresentation.Building.Context, crossing: Model.Type): Boolean {
    var kind = crossing.kind
    if kind == 'scalar' or kind == 'enumeration' {
        return true
    }
    if kind == 'shape' {
        return shape_holds_numbers(context, crossing)
    }
    fallback kind == 'object'
    if crossing.name == "String" or crossing.name == "Buffer" {
        return true
    }
    return holds_numbers(context, crossing)
}

func shape_holds_numbers(context: HighIntermediaryRepresentation.Building.Context, crossing: Model.Type): Boolean {
    var shape = context.program.shape_keyed(crossing.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        var is_a_number = member.answer.kind == 'scalar' and not member.answer.is_nullable
        fallback not member.is_an_attribute or is_a_number
        index = index + 1
    }
    return true
}

func holds_numbers(context: HighIntermediaryRepresentation.Building.Context, crossing: Model.Type): Boolean {
    fallback context.has_a_class(crossing)
    var model = context.class_of(crossing)
    fallback model.function_named("_read_value")
    var element = model.bound_types["$element_type"]
    fallback element
    return element.kind == 'scalar' and not element.is_nullable
}

func check_a_struct_size(
    context: HighIntermediaryRepresentation.Building.Context,
    c_name: String,
    header: String,
    c_struct: String,
    c_size: Integer,
    shown: String,
    spite_size: Integer,
): Validators.Answer {
    fallback spite_size != c_size
    var article = article_of(shown)
    return mistake(
        context,
        "'{c_name}' takes a '{c_struct}', which '{header}' declares as {c_size} bytes, but {article} {shown} is {spite_size} bytes as a C struct: give '{shown}' the fields of '{c_struct}', in its order and at its widths",
    )
}

func check_a_library_holder(
    context: HighIntermediaryRepresentation.Building.Context,
    library: SpiteCompiler.Value,
): Validators.Answer {
    fallback library.class == HighIntermediaryRepresentation.Values.LocalRead
    var parameter = context.current_function.parameters.find_by_name(library.name)
    fallback parameter
    return mistake(
        context,
        "a foreign function is called through the attribute or variable that holds its DynamicLibrary(...), so the compiler knows which library to bind it in",
    )
}

func check_a_callback(
    context: HighIntermediaryRepresentation.Building.Context,
    function_type: Model.Type,
    written: String,
    names: List<String>,
): Validators.Answer {
    var signature = function_type.signature_or_empty()
    var index = 0
    while index < signature.parameters.count() {
        var parameter = signature.parameters[index]
        var name = names[index]
        crash name
        if not is_a_c_number(parameter) {
            var shown = context.shown(parameter)
            return a_callback_parameter(context, written, name, shown)
        }
        index = index + 1
    }
    fallback signature.answer
    return check_a_callback_answer(context, signature.answer, written)
}

func is_a_c_number(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' and not of_type.is_nullable
}

func a_callback_parameter(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    parameter: String,
    shown: String,
): Validators.Answer {
    var article = article_of(shown)
    return mistake(
        context,
        "'{written}' is called by C, which passes numbers and addresses: '{parameter}' is {article} {shown}, so take it as a number or a Boolean: a callback cannot take text yet, so text or a struct C passes is taken as its address, a Long, which it can keep or hand back to C",
    )
}

func check_a_callback_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    answer: Model.Type,
    written: String,
): Validators.Answer {
    fallback not answer.is_nothing()
    fallback not is_a_c_number(answer)
    var shown = context.shown(answer)
    var article = article_of(shown)
    return mistake(
        context,
        "'{written}' is called by C, which takes back a number, a Boolean or nothing: it returns {article} {shown}",
    )
}

func check_a_void_answer_read(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    declared: HighIntermediaryRepresentation.Building.HeaderAnswer,
): Validators.Answer {
    fallback not call.answer_is_dropped and declared.is_void
    return mistake(
        context,
        "'{declared.c_name}' answers nothing, since '{declared.header}' declares it 'void', so it has no answer to read: call it on a line of its own",
    )
}

func check_two_arguments(context: HighIntermediaryRepresentation.Building.Context, count: Integer): Validators.Answer {
    fallback count != 2
    return an_unnamed_callback(context)
}

func check_a_written_place(
    context: HighIntermediaryRepresentation.Building.Context,
    place: String?,
): Validators.Answer {
    if not place {
        return an_unnamed_callback(context)
    }
    var is_known = place == "no_context" or place == "context_first" or place == "context_last"
    fallback not is_known
    return mistake(
        context,
        "'{place}' is not where C passes a callback its context: write 'no_context', 'context_first' or 'context_last'",
    )
}

func check_a_named_function(
    context: HighIntermediaryRepresentation.Building.Context,
    value: SpiteCompiler.Value,
): Validators.Answer {
    fallback value.class != HighIntermediaryRepresentation.Values.Function.Value
    return an_unnamed_callback(context)
}

func an_unnamed_callback(context: HighIntermediaryRepresentation.Building.Context): Validators.Answer {
    return mistake(
        context,
        "ForeignCallback(...) takes a function named directly, like 'mixer.voice_ended', and where C passes it back its context: 'no_context', 'context_first' or 'context_last'",
    )
}

func check_a_context(
    context: HighIntermediaryRepresentation.Building.Context,
    place: String,
    owner_model: Model.ClassModel,
    function_name: String,
): Validators.Answer {
    fallback place == "no_context" and not owner_model.is_singleton
    var owner = plain_name(owner_model.shown)
    return mistake(
        context,
        "'ForeignCallback({function_name}, 'no_context')' gives C no context to find its '{owner}' by, so '{function_name}' must belong to a singleton: move it into a singleton that tells them apart by what C passes, or hand C the context with 'context_first' or 'context_last'",
    )
}

func check_a_reached_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    written: String,
    function_name: String,
    reaching: String,
    owner_model: Model.ClassModel,
    found: Model.AttributeModel?,
): Validators.Answer {
    fallback found
    fallback not holds_a_value(context, found.attribute_type)
    var owner = plain_name(owner_model.shown)
    var shown = context.shown(found.attribute_type)
    var attribute = found.name
    var reached = "'{attribute}' holds a {shown}"
    if reaching != function_name {
        reached = "'{attribute}', which it reaches through '{reaching}', holds a {shown}"
    }
    return mistake(
        context,
        "'{written}' may be called by C on a thread of its own, so '{function_name}' may reach only the attributes of its own '{owner}' that hold values, its locals and singletons: {reached}, which another thread may share. Keep it in a singleton the callback calls, which is made safe for threads, or give the callback numbers and text of its own",
    )
}

func holds_a_value(context: HighIntermediaryRepresentation.Building.Context, held: Model.Type): Boolean {
    var kind = held.kind
    if kind == 'scalar' or kind == 'enumeration' {
        return true
    }
    fallback kind == 'object'
    if held.name == "String" {
        return true
    }
    fallback context.has_a_class(held)
    var model = context.class_of(held)
    return model.is_singleton
}

func plain_name(shown: String): String {
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

func article_of(shown: String): String {
    var first = shown.byte_at(0)
    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85
    if is_a_vowel {
        return "an"
    }
    return "a"
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var path = context.path()
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var function_name = context.current_function.name
    var problem = Diagnostics.Problem(path, context.line, text)
    problem.class_name = every_rule.plain_class_name(context.current_class.shown)
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    var answer = Validators.Answer()
    answer.mistakes.append(problem)
    return answer
}

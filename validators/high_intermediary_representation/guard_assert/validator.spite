var sites = HighIntermediaryRepresentation.Building.FixableSite()

# ../../../PROOFS.md#a-fallback-answers-what-its-answer-type-builds-with-no-arguments
func check_a_default(
    context: HighIntermediaryRepresentation.Building.Context,
    crashes: HighIntermediaryRepresentation.Building.Crashes,
    answer: Model.Type,
    shown: String,
    condition_text: String,
): Validators.Answer {
    fallback not answer.is_nullable
    var full_name = context.shown(answer)
    fallback not crashes.is_a_collection(answer, full_name)
    fallback not crashes.is_built_with_no_arguments(answer)
    var reason = reason_it_is_not_built(context, answer)
    var last_way = "'crash {condition_text}'"
    if condition_text.is_empty() {
        last_way = "'crash'"
    }
    return mistake(
        context,
        "'fallback' returns what the answer type builds with no arguments, and a {shown} has none ({reason}): make the result '{shown}?' so the fallback returns null, or write {last_way} if this is a developer mistake",
    )
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func check_a_terminal_if(
    context: HighIntermediaryRepresentation.Building.Context,
    site: HighIntermediaryRepresentation.Building.GuardSite,
    written: String,
): Validators.Answer {
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var tree = sites.tree_of(context)
    var is_fixable_here = false
    if tree {
        crash context.current_function.declaration
        var class_name = every_rule.plain_class_name(context.current_class.shown)
        is_fixable_here = not context.current_function.declaration.is_a_constructor_of(class_name)
    }
    if is_fixable_here and sites.is_fixed_already(context, site.statement_line) {
        return Validators.Answer()
    }
    var statement = terminal_if_of(site)
    if is_fixable_here and statement {
        crash statement.then_branch
        var kept = statement.then_branch.statements
        if not sites.moves_a_name_onto_another(context, statement, kept) {
            var fixable = Validators.Answer()
            fixable.fix = "write 'fallback {written}' and move the code it runs left"
            return fixable
        }
    }
    var path = context.path()
    var library = Mapping.LibraryFile()
    fallback not library.holds(path)
    return every_rule.mistake(
        context,
        "this 'if' is the last thing the function does and has no 'else', so it only checks that '{written}' is there: write 'fallback {written}' and let the rest of the function run unindented",
    )
}

# ../../../../spite_documentation/style.md#the-compiler-fixes-what-has-one-fix
func terminal_if_of(
    site: HighIntermediaryRepresentation.Building.GuardSite,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    var index = 0
    while index < site.block.count() {
        var statement = site.block[index]
        if statement.line == site.statement_line and statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
            return statement
        }
        index = index + 1
    }
    return null
}

func reason_it_is_not_built(context: HighIntermediaryRepresentation.Building.Context, answer: Model.Type): String {
    if answer.kind == 'enumeration' {
        return "an enum is never built, so it has no value to fall back to"
    }
    if answer.kind == 'object' and context.has_a_class(answer) {
        return reason_an_object_is_not_built(context, answer)
    }
    return "it is never built, so it has no value to fall back to"
}

func reason_an_object_is_not_built(
    context: HighIntermediaryRepresentation.Building.Context,
    answer: Model.Type,
): String {
    var model = context.class_of(answer)
    if model.is_singleton {
        return "it is a singleton, never built by a call"
    }
    return "its constructor takes arguments"
}

func mistake(context: HighIntermediaryRepresentation.Building.Context, text: String): Validators.Answer {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, text)
}

func check(context: HighIntermediaryRepresentation.Building.Context, model: Model.ClassModel, name: String) {
    fallback not model.bound_types["${name}"]
    var shown = model.shown
    var bound = model.bound_types.keys()
    if bound.is_empty() {
        stopped(
            context,
            "'{shown}' is not generic, so '{shown}.generics[\"{name}\"]' names nothing: 'generics' holds a class for each 'generic' line of a generic class",
        )
    }
    var names = List<String>()
    var index = 0
    while index < bound.count() {
        var written = bound[index]
        var written_length = written.length()
        var bare = written.slice(1, written_length)
        crash bare
        names.append("'{bare}'")
        index = index + 1
    }
    var listed = names.join(", ")
    stopped(
        context,
        "'{shown}' has no generic '{name}', so '{shown}.generics[\"{name}\"]' names nothing: name one of its generics, {listed}",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

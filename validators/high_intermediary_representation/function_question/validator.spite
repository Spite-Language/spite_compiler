var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()

func check_a_written_pattern(
    context: HighIntermediaryRepresentation.Building.Context,
    pattern: String?,
    asked: String,
    question: String,
) {
    fallback not pattern
    if question == "function_writes_parameter" {
        stop_an_unwritten_parameter(context, asked)
    }
    var example = "run_each"
    if question != "has_function" {
        example = "update_each"
    }
    stopped(
        context,
        "'{asked}.{question}(...)' is decided while compiling, so the name it asks for is written as a literal: '{asked}.{question}(\"{example}\")', or a pattern such as \"<phase>_each\"",
    )
}

func check_a_counted_function(
    context: HighIntermediaryRepresentation.Building.Context,
    found: Model.FunctionModel?,
    asked: String,
    pattern: String,
) {
    fallback not found
    stopped(
        context,
        "'{asked}' has no function named '{pattern}', so 'argument_count' has nothing to count: name a function it has, or ask '{asked}.has_function(\"{pattern}\")' first and count only where it answers true",
    )
}

# ../../../PROOFS.md#how-many-arguments-a-function-takes
func check_the_counts(
    context: HighIntermediaryRepresentation.Building.Context,
    matching: List<Model.FunctionModel>,
    counted: Integer,
    asked: String,
    pattern: String,
) {
    var listed = List<String>()
    var agree = true
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var function_count = function.parameters.count()
        if function_count != counted {
            agree = false
        }
        listed.append("'{function.name}' {function_count}")
        index = index + 1
    }
    fallback not agree
    var found = matching.first()
    crash found
    var owner = every_rule.plain_class_name(found.owner)
    var counts = listed.join(", ")
    stopped(
        context,
        "'{asked}.argument_count(\"{pattern}\")' has no one answer: the functions of '{owner}' that fit it take different numbers of arguments ({counts}), so ask 'phase.argument_count()' in a template over them, where each is walked on its own",
    )
}

func check_a_parameter_place(context: HighIntermediaryRepresentation.Building.Context, place: Integer, asked: String) {
    fallback place < 0
    stop_an_unwritten_parameter(context, asked)
}

func check_a_parameter(
    context: HighIntermediaryRepresentation.Building.Context,
    owner_name: String,
    function: Model.FunctionModel,
    place: Integer,
) {
    var count = function.parameters.count()
    fallback place >= count
    var asked = "{owner_name}.{function.name}"
    stopped(
        context,
        "'{asked}' takes {count} arguments, so it has no parameter {place} to ask about: 'function_writes_parameter' counts parameters from 0",
    )
}

func stop_an_unwritten_parameter(context: HighIntermediaryRepresentation.Building.Context, asked: String) {
    stopped(
        context,
        "'{asked}.function_writes_parameter(...)' is decided while compiling, so it takes the function's name as text and the parameter's number, counted from 0, as a literal: '{asked}.function_writes_parameter(\"last_each\", 1)'",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

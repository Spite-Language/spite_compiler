func check(
    context: HighIntermediaryRepresentation.Building.Context,
    name: String,
    made: Model.EnumModel,
    place: Integer?,
): Validators.Answer {
    fallback not place
    var quoted = List<String>()
    var index = 0
    while index < made.values.count() {
        var value = made.values[index]
        quoted.append("'{value}'")
        index = index + 1
    }
    var listed = quoted.join(", ")
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(context, "'{name}' is not a value of the enum '{made.name}', whose values are {listed}")
}

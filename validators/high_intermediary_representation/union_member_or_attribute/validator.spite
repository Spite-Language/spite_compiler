# ../../../../spite_documentation/metaprogramming.md#member-templates
func check(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    united: Model.UnionModel,
    member: Model.Type,
    candidates: List<String>,
): Validators.Answer {
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        if every_member_has(context, united, candidate) {
            return refuse(context, called, united, member, candidate)
        }
        index = index + 1
    }
    return Validators.Answer()
}

func every_member_has(
    context: HighIntermediaryRepresentation.Building.Context,
    united: Model.UnionModel,
    wanted: String,
): Boolean {
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fallback context.has_a_class(held)
        var model = context.class_of(held)
        var getter = "get_{wanted}"
        var has_it = model.attribute_named(wanted) or model.function_named(getter)
        fallback has_it
        index = index + 1
    }
    return true
}

func refuse(
    context: HighIntermediaryRepresentation.Building.Context,
    called: String,
    united: Model.UnionModel,
    member: Model.Type,
    attribute: String,
): Validators.Answer {
    var member_parts = member.name.split(".")
    var member_name = member_parts.last()
    crash member_name
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "'{called}' could keep the '{member_name}' members of '{united.name}' or ask each member its '{attribute}': a member class and an attribute every member has share that name, so rename one of them",
    )
}

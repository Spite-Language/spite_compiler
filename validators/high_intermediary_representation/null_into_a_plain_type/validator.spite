# ../../../../spite_documentation/functions_and_operators.md#null-only-goes-where-a-t-is-wanted
func check(context: HighIntermediaryRepresentation.Building.Context, expected: Model.Type?) {
    fallback expected
    fallback expected.kind != 'nothing'
    fallback not expected.is_nullable
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var shown = context.shown(expected)
    if expected.kind == 'shape' or expected.kind == 'enumeration' {
        shown = last_name_of(shown)
    }
    var article = rules.article_of(shown)
    var text = "'null' is given where {article} {shown} is needed, and {article} {shown} never holds null: write '{shown}?' where none is a real answer, otherwise give it a real {shown}"
    if expected.kind == 'shape' and expected.name == "Anything" {
        text = "'null' is given where an Anything is needed, and an Anything never holds null: write 'Anything?' only where none is a real answer (a real type says more), otherwise give it a value"
    }
    rules.stop(context, text)
}

func last_name_of(shown: String): String {
    var names = shown.split(".")
    var last = names.last()
    crash last
    return last
}

# ../../../../spite_documentation/reflection.md#spiteattribute
func check(context: HighIntermediaryRepresentation.Building.Context, setter: Model.FunctionModel): Validators.Answer {
    fallback setter.name == "set_value" and setter.owner.starts_with("Spite.Attribute_of_")
    var owner = context.program.class_named(setter.owner)
    fallback owner
    var held = owner.bound_types["$value"]
    fallback held
    fallback held.kind == 'union' or held.kind == 'shape'
    var shown = context.shown(held)
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    return rules.mistake(
        context,
        "a 'Spite.Attribute<{shown}>' is read through '{shown}', which several classes fit, so its value is not written through it: write the attribute through a 'Spite.Attribute' of its own class, as 'Spite.Attribute<Integer>' for an Integer attribute",
    )
}

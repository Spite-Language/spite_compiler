# ../../../../spite_documentation/values_and_types.md#unions
func check_the_members(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    missing: List<String>,
) {
    fallback not missing.is_empty()
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var listed = missing.join("', '")
    var member_word = "is a member"
    if missing.count() > 1 {
        member_word = "are members"
    }
    stopped(
        context,
        "a {shown_given} cannot be used where a {shown_wanted} is needed: '{listed}' {member_word} of {shown_given} and not of {shown_wanted}, and a union fits another only when every member of it is a member of the other: add '{listed}' to {shown_wanted}, or pass the member value itself",
    )
}

# ../../../../spite_documentation/values_and_types.md#unions
func check_a_union_inside(
    context: HighIntermediaryRepresentation.Building.Context,
    given: Model.Type,
    wanted: Model.Type,
    inside: Model.Type,
    wanted_inside: Model.Type,
    fitting: HighIntermediaryRepresentation.Building.Fitting,
) {
    var both_unions = inside.kind == 'union' and wanted_inside.kind == 'union' and not inside.is_nullable
    fallback both_unions and fitting.is_a_part_of(inside, wanted_inside)
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var shown_inside = context.shown(inside)
    var shown_wanted_inside = context.shown(wanted_inside)
    stopped(
        context,
        "a {shown_given} cannot be used where a {shown_wanted} is needed: {shown_inside} has fewer members than {shown_wanted_inside}, and the receiver could put in it a member {shown_inside} lacks: declare {shown_inside} with the same members as {shown_wanted_inside}, or make a {shown_wanted}",
    )
}

func stopped(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.stop(context, text)
}

# ../../../../spite_documentation/json.md#how-it-is-written
func check_a_late_map(context: HighIntermediaryRepresentation.Building.Context, place: String, shown_place: String) {
    fallback context.folded_key_reads.contains(place)
    stop(
        context,
        "'{shown_place}' is set here after the compiler already compiled a serializer that reads it without a map: set it before the serializer is first used, in the same function that makes it",
    )
}

func check_an_empty_map(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    shown_place: String,
) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        fallback not is_an_empty_map(written)
    }
    refuse_a_map_not_written_out(context, shown_place)
}

func is_an_empty_map(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name == "Dictionary" and call.arguments.is_empty()
    }
    return false
}

func check_an_entry(
    context: HighIntermediaryRepresentation.Building.Context,
    pair: SpiteCompiler.Expression?,
    shown_place: String,
) {
    fallback pair.class != AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
    refuse_a_map_not_written_out(context, shown_place)
}

func check_an_attribute_key(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    shown_place: String,
) {
    fallback written.class != AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    refuse_a_map_not_written_out(context, shown_place)
}

func check_an_attributes_read(
    context: HighIntermediaryRepresentation.Building.Context,
    listed: SpiteCompiler.Expression?,
    name: String,
    shown_place: String,
) {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name != "attributes" or name.is_empty()
    }
    refuse_a_map_not_written_out(context, shown_place)
}

func check_a_key_text(
    context: HighIntermediaryRepresentation.Building.Context,
    written: SpiteCompiler.Expression?,
    shown_place: String,
) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var piece = written.pieces[0]
        var is_plain = written.pieces.count() == 1 and piece and not piece.hole
        fallback not is_plain
    }
    refuse_a_map_not_written_out(context, shown_place)
}

func refuse_a_map_not_written_out(context: HighIntermediaryRepresentation.Building.Context, place: String) {
    stop(
        context,
        "'{place}' maps attributes to keys, and the compiler folds that map into the code: write it out where it is set, like '\{Order.attributes[\"buy_price\"]: \"price\"}', with each key a literal text",
    )
}

func check_a_keyed_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    attribute: Model.AttributeModel?,
    shown: String,
    name: String,
) {
    var is_public = not name.starts_with("_")
    if not attribute or not is_public {
        refuse_an_unknown_attribute(context, shown, name)
    }
    crash attribute
    fallback context.has_a_class(attribute.attribute_type)
    var held = context.class_of(attribute.attribute_type)
    fallback held.is_singleton
    refuse_an_unknown_attribute(context, shown, name)
}

func refuse_an_unknown_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    shown: String,
    name: String,
) {
    stop(
        context,
        "'{shown}' has no attribute '{name}' to give a key: name one of its public attributes that holds a value, like '{shown}.attributes[\"{name}\"]'",
    )
}

func check_one_map(
    context: HighIntermediaryRepresentation.Building.Context,
    known: String,
    canonical: String,
    has_its_table: Boolean,
    place: String,
) {
    fallback known != canonical and not has_its_table
    stop(
        context,
        "'{place}' is given two different maps: the compiler folds the one map into the code every such serializer is compiled to, so give every one the same map, or make a class of its own for the other keys",
    )
}

func check_a_changed_map(
    context: HighIntermediaryRepresentation.Building.Context,
    is_read_live: Boolean,
    place: String,
) {
    fallback not is_read_live
    stop(
        context,
        "'{place}' is folded into the code while compiling, so it is set whole with a written-out map and never changed one key at a time",
    )
}

func check_a_held_map(context: HighIntermediaryRepresentation.Building.Context, is_read_live: Boolean, place: String) {
    fallback not is_read_live
    stop(
        context,
        "'{place}' is folded into the code while compiling, so it is read where it is: a local holding it could change it one key at a time, and the code would keep the keys it was compiled with",
    )
}

func check_a_passed_map(
    context: HighIntermediaryRepresentation.Building.Context,
    is_read_live: Boolean,
    place: String,
    called: String,
) {
    fallback not is_read_live
    stop(
        context,
        "'{place}' is folded into the code while compiling, so it is read where it is: '{called}' could change it one key at a time, and the code would keep the keys it was compiled with",
    )
}

func stop(context: HighIntermediaryRepresentation.Building.Context, text: String) {
    var failure = Diagnostics.Failure()
    var path = context.path()
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var owner = every_rule.plain_class_name(context.current_class.shown)
    failure.stop_inside(path, context.line, owner, context.current_function.name, text)
}

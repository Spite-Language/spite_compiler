# ../ARCHITECTURE.md#validators

var fix = ""
var mistakes = List<Diagnostics.Problem>()

func is_fine(): Boolean {
    return fix.is_empty() and mistakes.is_empty()
}

func is_fixable(): Boolean {
    return not fix.is_empty()
}

func is_a_mistake(): Boolean {
    return not mistakes.is_empty()
}

func take(other: Validators.Answer) {
    other.mistakes.each(mistakes.append)
}

# ../ARCHITECTURE.md#validators
func tell() {
    var failure = Diagnostics.Failure()
    mistakes.each(failure.stop)
}

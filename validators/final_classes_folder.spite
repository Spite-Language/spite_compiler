# ../../spite_documentation/compiler.md#inspect-merged-classes
func holds(folder: String): Boolean {
    var segments = folder.replace("\\", "/").split("/")
    while not segments.is_empty() {
        var above = segments.join("/")
        var marker = File("{above}/.final-classes")
        if marker.exists() {
            return true
        }
        segments.remove_last()
    }
    var here = File(".final-classes")
    return here.exists()
}

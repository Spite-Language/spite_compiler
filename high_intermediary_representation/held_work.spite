# ../PROOFS.md#whether-a-function-waits
var program = Model.ProgramModel()
var counts_only_a_concurrent = false

func HeldWork(starting_program: Model.ProgramModel) {
    program = starting_program
}

func holds(of_type: Model.Type): Boolean {
    var visited = List<String>()
    return holds_through(of_type, visited)
}

func holds_through(of_type: Model.Type, visited: List<String>): Boolean {
    if of_type.kind == 'handle' {
        return not counts_only_a_concurrent or of_type.name == "Concurrent"
    }
    fallback of_type.kind == 'object' and not visited.contains(of_type.name)
    visited.append(of_type.name)
    var held = program.class_named(of_type.name)
    fallback held
    fallback not held.is_singleton
    var element = held.bound_types["$element_type"]
    if element {
        return holds_through(element, visited)
    }
    var index = 0
    while index < held.declared_attributes.count() {
        var attribute = held.declared_attributes[index]
        if holds_through(attribute.attribute_type, visited) {
            return true
        }
        index = index + 1
    }
    return false
}

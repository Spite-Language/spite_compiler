var model = Model.ProgramModel()
var waits: Waits? = null
var owner = ""
var resumable = false
var takes_atomics = false
var counter = ""
var held = ""
var locks_a_call = false
var refused = false
var steps = 0
var held_calls = List<String>()

func CoarseLoops(starting_model: Model.ProgramModel, starting_waits: Waits?) {
    model = starting_model
    waits = starting_waits
}

func singleton_held_by(loop: HighIntermediaryRepresentation.Statements.While): String {
    if not waits or resumable {
        return ""
    }
    if not is_counted(loop) {
        return ""
    }
    held = ""
    held_calls = List<String>()
    locks_a_call = false
    refused = false
    steps = 0
    read_a_block(loop.body)
    if refused or held.is_empty() or not locks_a_call or steps != 1 {
        return ""
    }
    if held == owner {
        return ""
    }
    return held
}

func is_counted(loop: HighIntermediaryRepresentation.Statements.While): Boolean {
    var condition = loop.condition
    if condition == HighIntermediaryRepresentation.Values.MachineOperation {
        return counts_up(condition, loop.body)
    }
    return false
}

func counts_up(
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    body: HighIntermediaryRepresentation.Statements.Block,
): Boolean {
    if condition.operator != 'less' and condition.operator != 'less_or_equal' {
        return false
    }
    var left = condition.left
    if left == HighIntermediaryRepresentation.Values.LocalRead {
        counter = left.name
        return steps_last(body)
    }
    return false
}

func steps_last(body: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var last = body.statements.last()
    if last == HighIntermediaryRepresentation.Statements.Assign.Assign {
        return is_a_step(last)
    }
    return false
}

func is_a_step(assign: HighIntermediaryRepresentation.Statements.Assign.Assign): Boolean {
    var value = assign.value
    if assign.name != counter {
        return false
    }
    if value == HighIntermediaryRepresentation.Values.MachineOperation {
        return adds_to_the_counter(value)
    }
    return false
}

func adds_to_the_counter(operation: HighIntermediaryRepresentation.Values.MachineOperation): Boolean {
    var left = operation.left
    var right = operation.right
    if operation.operator != 'add' {
        return false
    }
    var reads_the_counter = false
    if left == HighIntermediaryRepresentation.Values.LocalRead {
        reads_the_counter = left.name == counter
    }
    if right == HighIntermediaryRepresentation.Values.WholeNumber {
        return reads_the_counter and right.number > 0
    }
    return false
}

func refuse() {
    refused = true
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_an_assign(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        _: refuse()
    }
}

func read_a_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    if not is_plain(declare.declared_type) and not is_a_plain_object(declare.declared_type) {
        refuse()
    }
    read_a_value(declare.value)
}

func read_an_assign(assign: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    if assign.name == counter {
        steps = steps + 1
    }
    crash assign.value
    var value_type = assign.value.value_type
    if not is_plain(value_type) and not is_a_plain_object(value_type) {
        refuse()
    }
    read_a_value(assign.value)
}

func read_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    if evaluated.waited {
        refuse()
    }
    read_a_value(evaluated.value)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    read_a_value(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    if stop.then {
        refuse()
    }
    stop.shown.each(read_a_present)
}

func is_plain(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'nothing'
}

# ../OPTIMIZATIONS.md#a-counted-loop-of-calls-to-one-singleton-takes-its-lock-once
func is_a_plain_object(of_type: Model.Type): Boolean {
    if of_type.kind != 'object' {
        return false
    }
    var class_model = model.class_named(of_type.name)
    if not class_model {
        return false
    }
    if class_model.is_singleton {
        return false
    }
    var dropping = class_model.function_named("drop")
    if dropping {
        return false
    }
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        if not is_plain(attribute.attribute_type) {
            return false
        }
        index = index + 1
    }
    return true
}

func read_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    read_a_value(value)
}

func read_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    read_a_value(first)
    read_a_value(second)
}

func read_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.AttributeRead: read_an_attribute(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: read_a_value(value.negated)
        HighIntermediaryRepresentation.Values.PresenceTest: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.Conversion: read_a_conversion(value)
        HighIntermediaryRepresentation.Values.MakeObject: read_a_making(value)
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        _: refuse()
    }
}

func read_an_attribute(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    var on_itself = read.object == HighIntermediaryRepresentation.Values.ThisRead
    assert not on_itself
    if is_plain(read.value_type) {
        read_a_value(read.object)
    } else {
        refuse()
    }
}

func read_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    var kind = conversion.kind
    var moves_work = kind == 'join' or kind == 'into_handle' or kind == 'into_shape' or kind == 'into_union'
    if moves_work {
        refuse()
    }
    read_a_value(conversion.converted)
}

func read_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    if not made_model {
        refuse()
        return
    }
    if not made_model.is_singleton or not made.arguments.is_empty() {
        refuse()
    }
}

func is_a_plain_helper(
    call: HighIntermediaryRepresentation.Values.Call,
    owner_model: Model.ClassModel,
    answers_plainly: Boolean,
): Boolean {
    crash waits
    if owner_model.is_singleton or not answers_plainly {
        return false
    }
    if not call.function.has_a_body() or not call.number_positions.is_empty() {
        return false
    }
    var key = call.function.key()
    return waits.is_a_plain_leaf(key)
}

func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    crash waits
    var key = call.function.key()
    var owner_key = call.function.owner
    var owner_model = model.class_named(owner_key)
    if not owner_model {
        refuse()
        return
    }
    var answers_plainly = is_plain(call.value_type) or is_a_plain_object(call.value_type)
    if is_a_plain_helper(call, owner_model, answers_plainly) {
        read_a_value(call.receiver)
        call.arguments.each(read_a_present)
        return
    }
    if not owner_model.is_singleton or not answers_plainly {
        refuse()
        return
    }
    if not call.function.has_a_body() or not call.number_positions.is_empty() {
        refuse()
        return
    }
    var guarded = waits.is_locked(key) or takes_atomics and waits.is_atomic(owner_key)
    if guarded or waits.is_atomic(owner_key) {
        var one_singleton = held.is_empty() or held == owner_key
        if not one_singleton {
            refuse()
            return
        }
        held = owner_key
    }
    if guarded {
        locks_a_call = true
        held_calls.append(key)
    }
    if not waits.can_hold_for_a_loop(key, held) {
        refuse()
    }
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

func only_reads(assignments: Assignments): Boolean {
    crash waits
    var class_keys = List<String>()
    var names = List<String>()
    gather_the_state(held, class_keys, names)
    var index = 0
    while index < held_calls.count() {
        var key = held_calls[index]
        crash key
        if not assignments.writes_none_of(key, class_keys, names) or not waits.locks_only_itself(key) {
            return false
        }
        index = index + 1
    }
    return not held_calls.is_empty()
}

func gather_the_state(class_key: String, class_keys: List<String>, names: List<String>) {
    assert not class_keys.contains(class_key)
    class_keys.append(class_key)
    var class_model = model.class_named(class_key)
    assert class_model
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        names.append(attribute.name)
        gather_a_type(attribute.attribute_type, class_keys, names)
        index = index + 1
    }
    var bound = class_model.bound_types.values()
    var bound_index = 0
    while bound_index < bound.count() {
        var bound_type = bound[bound_index]
        crash bound_type
        gather_a_type(bound_type, class_keys, names)
        bound_index = bound_index + 1
    }
}

func gather_a_type(of_type: Model.Type, class_keys: List<String>, names: List<String>) {
    if of_type.kind == 'object' {
        gather_the_state(of_type.name, class_keys, names)
    }
}

var model = Model.ProgramModel()
var owner = ""
var resumable = false
var takes_atomics = false
var counter = ""
var held = ""
var locks_a_call = false
var refused = false
var steps = 0
var held_calls = List<String>()
var waits: Waits?

func CoarseLoops(starting_model: Model.ProgramModel, starting_waits: Waits?) {
    model = starting_model
    waits = starting_waits
}

func singleton_held_by(loop: Statements.While): String {
    fallback waits and not resumable
    fallback is_counted(loop)
    held = ""
    held_calls = List<String>()
    locks_a_call = false
    refused = false
    steps = 0
    read_a_block(loop.body)
    fallback not refused and not held.is_empty() and locks_a_call and steps == 1
    fallback held != owner
    return held
}

func is_counted(loop: Statements.While): Boolean {
    var condition = loop.condition
    if condition.class == Values.MachineOperation {
        return counts_up(condition, loop.body)
    }
    return false
}

func counts_up(condition: Values.MachineOperation, body: Statements.Block): Boolean {
    fallback condition.operator == 'less' or condition.operator == 'less_or_equal'
    var left = condition.left
    if left.class == Values.LocalRead {
        counter = left.name
        return steps_last(body)
    }
    return false
}

func steps_last(body: Statements.Block): Boolean {
    var last = body.statements.last()
    if last.class == Statements.Assign.Assign {
        return is_a_step(last)
    }
    return false
}

func is_a_step(assign: Statements.Assign.Assign): Boolean {
    var value = assign.value
    fallback assign.name == counter
    if value.class == Values.MachineOperation {
        return adds_to_the_counter(value)
    }
    return false
}

func adds_to_the_counter(operation: Values.MachineOperation): Boolean {
    var left = operation.left
    var right = operation.right
    fallback operation.operator == 'add'
    var reads_the_counter = false
    if left.class == Values.LocalRead {
        reads_the_counter = left.name == counter
    }
    if right.class == Values.WholeNumber {
        return reads_the_counter and right.number > 0
    }
    return false
}

func rule_out() {
    refused = true
}

func read_a_block(block: Statements.Block?) {
    fallback block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        Statements.Declare: read_a_declare(statement)
        Statements.Assign.Assign: read_an_assign(statement)
        Statements.Evaluate: read_an_evaluation(statement)
        Statements.If: read_an_if(statement)
        Statements.Block: read_a_block(statement)
        Statements.Stop: read_a_stop(statement)
        Statements.Assign.Attribute: rule_out()
        Statements.Assign.ThroughShape: rule_out()
        Statements.While: rule_out()
        Statements.Return: rule_out()
    }
}

func read_a_declare(declare: Statements.Declare) {
    if not is_plain(declare.declared_type) and not is_a_plain_object(declare.declared_type) {
        rule_out()
    }
    read_a_value(declare.value)
}

func read_an_assign(assign: Statements.Assign.Assign) {
    if assign.name == counter {
        steps = steps + 1
    }
    crash assign.value
    var value_type = assign.value.value_type
    if not is_plain(value_type) and not is_a_plain_object(value_type) {
        rule_out()
    }
    read_a_value(assign.value)
}

func read_an_evaluation(evaluated: Statements.Evaluate) {
    if evaluated.waited {
        rule_out()
    }
    read_a_value(evaluated.value)
}

func read_an_if(branch: Statements.If) {
    read_a_value(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_stop(stop: Statements.Stop) {
    if stop.then {
        rule_out()
    }
    stop.shown.each(read_a_present)
}

func is_plain(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'nothing'
}

# ../OPTIMIZATIONS.md#a-counted-loop-of-calls-to-one-singleton-takes-its-lock-once
func is_a_plain_object(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object'
    var class_model = model.class_named(of_type.name)
    fallback class_model
    fallback not class_model.is_singleton
    var dropping = class_model.function_named("drop")
    fallback not dropping
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        fallback is_plain(attribute.attribute_type)
        index = index + 1
    }
    return true
}

func read_a_present(value: SpiteCompiler.Value) {
    read_a_value(value)
}

func read_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    read_a_value(first)
    read_a_value(second)
}

func read_a_value(value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        Values.WholeNumber: return
        Values.DecimalNumber: return
        Values.LocalRead: return
        Values.ThisRead: return
        Values.NullConstant: return
        Values.AttributeRead: read_an_attribute(value)
        Values.MachineOperation: read_both(value.left, value.right)
        Values.Negation: read_a_value(value.negated)
        Values.PresenceTest: read_a_value(value.tested)
        Values.Conversion: read_a_conversion(value)
        Values.MakeObject: read_a_making(value)
        Values.Call: read_a_call(value)
        Values.TextConstant: rule_out()
        Values.ForeignCall: rule_out()
        Values.Class.Membership: rule_out()
        Values.Function.Value: rule_out()
        Values.Function.ValueCall: rule_out()
        Values.NumberRoom: rule_out()
        Values.ShapeCall: rule_out()
        Values.EnumText: rule_out()
        Values.EnumFromText: rule_out()
        Values.Class.Object: rule_out()
        Values.Class.OfValue: rule_out()
        Values.Function.Fact: rule_out()
    }
}

func read_an_attribute(read: Values.AttributeRead) {
    var on_itself = read.object.class == Values.ThisRead
    fallback not on_itself
    if is_plain(read.value_type) {
        read_a_value(read.object)
    } else {
        rule_out()
    }
}

func read_a_conversion(conversion: Values.Conversion) {
    var kind = conversion.kind
    var moves_work = kind == 'join' or kind == 'into_handle' or kind == 'into_shape' or kind == 'into_union'
    if moves_work {
        rule_out()
    }
    read_a_value(conversion.converted)
}

func read_a_making(made: Values.MakeObject) {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    if not made_model {
        rule_out()
        return
    }
    if not made_model.is_singleton or not made.arguments.is_empty() {
        rule_out()
    }
}

func is_a_plain_helper(call: Values.Call, owner_model: Model.ClassModel, answers_plainly: Boolean): Boolean {
    crash waits
    fallback not owner_model.is_singleton and answers_plainly
    fallback call.function.has_a_body()
    var key = call.function.key()
    return waits.is_a_plain_leaf(key)
}

func read_a_call(call: Values.Call) {
    crash waits
    var key = call.function.key()
    var owner_key = call.function.owner
    var owner_model = model.class_named(owner_key)
    if not owner_model {
        rule_out()
        return
    }
    var answers_plainly = is_plain(call.value_type) or is_a_plain_object(call.value_type)
    if is_a_plain_helper(call, owner_model, answers_plainly) {
        read_a_value(call.receiver)
        call.arguments.each(read_a_present)
        return
    }
    if not owner_model.is_singleton or not answers_plainly {
        rule_out()
        return
    }
    if not call.function.has_a_body() {
        rule_out()
        return
    }
    var guarded = waits.is_locked(key) or takes_atomics and waits.is_atomic(owner_key)
    if guarded or waits.is_atomic(owner_key) {
        var one_singleton = held.is_empty() or held == owner_key
        if not one_singleton {
            rule_out()
            return
        }
        held = owner_key
    }
    if guarded {
        locks_a_call = true
        held_calls.append(key)
    }
    if not waits.can_hold_for_a_loop(key, held) {
        rule_out()
    }
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

func only_reads(assignments: Assignments): Boolean {
    crash waits
    var class_keys = List<String>()
    var names = List<String>()
    gather_the_state(held, class_keys, names)
    var index = 0
    while index < held_calls.count() {
        var key = held_calls[index]
        fallback assignments.writes_none_of(key, class_keys, names) and waits.locks_only_itself(key)
        index = index + 1
    }
    return not held_calls.is_empty()
}

func gather_the_state(class_key: String, class_keys: List<String>, names: List<String>) {
    fallback not class_keys.contains(class_key)
    class_keys.append(class_key)
    var class_model = model.class_named(class_key)
    fallback class_model
    var index = 0
    while index < class_model.declared_attributes.count() {
        var attribute = class_model.declared_attributes[index]
        names.append(attribute.name)
        gather_a_type(attribute.attribute_type, class_keys, names)
        index = index + 1
    }
    var bound = class_model.bound_types.values()
    var bound_index = 0
    while bound_index < bound.count() {
        var bound_type = bound[bound_index]
        gather_a_type(bound_type, class_keys, names)
        bound_index = bound_index + 1
    }
}

func gather_a_type(of_type: Model.Type, class_keys: List<String>, names: List<String>) {
    if of_type.kind == 'object' {
        gather_the_state(of_type.name, class_keys, names)
    }
}

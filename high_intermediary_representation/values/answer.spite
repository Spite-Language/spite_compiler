var callee = ""
var owner = ""
var count = 0
var arguments = List<HighIntermediaryRepresentation.Values.Value>()

func Answer(
    starting_callee: String,
    starting_owner: String,
    starting_arguments: List<HighIntermediaryRepresentation.Values.Value>,
) {
    callee = starting_callee
    owner = starting_owner
    count = starting_arguments.count()
    arguments = starting_arguments
}

func given_count(): Integer {
    return count
}

var value_type = Model.Type('nothing', "")
var library: SpiteCompiler.Value?
var function_name: String
var arguments: List<SpiteCompiler.Value>

func ForeignCall(
    starting_type: Model.Type,
    starting_library: SpiteCompiler.Value,
    starting_function_name: String,
    starting_arguments: List<SpiteCompiler.Value>,
) {
    value_type = starting_type
    library = starting_library
    function_name = starting_function_name
    arguments = starting_arguments
}

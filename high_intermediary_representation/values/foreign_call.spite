var name = ""
var receiver: HighIntermediaryRepresentation.Values.Value? = null
var arguments = List<HighIntermediaryRepresentation.Values.Value>()

func ForeignCall(
    starting_name: String,
    starting_receiver: HighIntermediaryRepresentation.Values.Value,
    starting_arguments: List<HighIntermediaryRepresentation.Values.Value>,
) {
    name = starting_name
    receiver = starting_receiver
    arguments = starting_arguments
}

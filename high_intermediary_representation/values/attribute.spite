var object: HighIntermediaryRepresentation.Values.Value? = null
var class_name = ""
var name = ""

func Attribute(
    starting_object: HighIntermediaryRepresentation.Values.Value,
    starting_class_name: String,
    starting_name: String,
) {
    object = starting_object
    class_name = starting_class_name
    name = starting_name
}

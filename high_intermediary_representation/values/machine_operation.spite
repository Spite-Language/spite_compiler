var value_type = Model.Type('nothing', "")
var operator: Operator = 'add'
var left: Value? = null
var right: Value? = null

func MachineOperation(
    starting_type: Model.Type,
    starting_operator: Operator,
    starting_left: Value,
    starting_right: Value,
) {
    value_type = starting_type
    operator = starting_operator
    left = starting_left
    right = starting_right
}

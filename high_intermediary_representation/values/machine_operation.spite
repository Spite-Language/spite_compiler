enum Operator {
    'add'
    'subtract'
    'multiply'
    'divide'
    'remainder'
    'equal'
    'not_equal'
    'less'
    'less_or_equal'
    'greater'
    'greater_or_equal'
    'and'
    'or'
}

var shown = ""
var shown_left = ""
var shown_right = ""
var value_type = Model.Type('nothing', "")
var operator: Operator = 'add'
var left: Value? = null
var right: Value? = null
var are_ranges_studied = false
var is_left_ranged = false
var left_lowest: Long = 0
var left_highest: Long = 0
var is_right_ranged = false
var right_lowest: Long = 0
var right_highest: Long = 0
var is_proven_to_fit = false
var is_divisor_proven = false
var is_folded = false
var folded_number: Long = 0

func MachineOperation(
    starting_type: Model.Type,
    starting_operator: Operator,
    starting_left: Value,
    starting_right: Value,
) {
    value_type = starting_type
    operator = starting_operator
    left = starting_left
    right = starting_right
}

var value_type = Model.Type('object', "String")
var stays_fresh = false
var lives_in_data = false
var text: String
var is_written: Boolean

func TextConstant(starting_text: String, starting_value_type: Model.Type, starting_is_written: Boolean) {
    text = starting_text
    value_type = starting_value_type
    is_written = starting_is_written
}

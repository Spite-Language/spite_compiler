var text = ""

func WholeNumber(starting_text: String) {
    text = starting_text
}

func value(): Long {
    var read = text.to_long()
    if read {
        return read
    } else {
        return 0
    }
}

func from(given: Long): WholeNumber {
    var written = given.to_string()
    return WholeNumber(written)
}

func is_zero(): Boolean {
    return value() == 0
}

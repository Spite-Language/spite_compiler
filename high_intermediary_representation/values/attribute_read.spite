var value_type = Model.Type('nothing', "")
var object: Value? = null
var no_type = Model.Type('nothing', "")
var attribute = Model.AttributeModel("", "", no_type)

func AttributeRead(starting_object: Value, starting_attribute: Model.AttributeModel) {
    object = starting_object
    attribute = starting_attribute
    value_type = starting_attribute.attribute_type
}

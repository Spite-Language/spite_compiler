var value_type = Model.Type('nothing', "")
var no_type = Model.Type('nothing', "")
var attribute = Model.AttributeModel("", "", no_type, null, false)
var object: SpiteCompiler.Value?

func AttributeRead(starting_object: SpiteCompiler.Value, starting_attribute: Model.AttributeModel) {
    object = starting_object
    attribute = starting_attribute
    value_type = starting_attribute.attribute_type
}

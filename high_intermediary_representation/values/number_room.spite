var value_type = Model.Type('nothing', "")
var made: SpiteCompiler.Value? = null
var number: SpiteCompiler.Value? = null
var width = 0

func NumberRoom(starting_made: SpiteCompiler.Value, starting_number: SpiteCompiler.Value, starting_width: Integer) {
    made = starting_made
    number = starting_number
    width = starting_width
    value_type = starting_made.value_type
}

var value_type = Model.Type('object', "Spite.Class")
var described: Value? = null
var candidates = List<String>()

func OfValue(starting_type: Model.Type, starting_described: Value, starting_candidates: List<String>) {
    value_type = starting_type
    described = starting_described
    candidates = starting_candidates
}

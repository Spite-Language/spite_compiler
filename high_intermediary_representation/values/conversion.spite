enum Kind {
    'present'
    'nullable'
    'into_union'
    'out_of_union'
    'widen'
    'narrow'
    'into_shape'
    'proven'
    'to_decimal'
    'to_whole'
    'narrow_decimal'
    'join'
    'into_handle'
    'unbox'
    'address'
}

var shown = ""
var value_type = Model.Type('nothing', "")
var kind: Kind = 'present'
var converted: SpiteCompiler.Value? = null

func Conversion(starting_type: Model.Type, starting_kind: Kind, starting_converted: SpiteCompiler.Value) {
    value_type = starting_type
    kind = starting_kind
    converted = starting_converted
}

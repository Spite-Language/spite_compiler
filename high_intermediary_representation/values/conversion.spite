enum Kind {
    'present'
    'nullable'
    'into_union'
    'out_of_union'
    'widen'
    'narrow'
    'into_shape'
    'proven'
    'to_decimal'
    'to_whole'
    'narrow_decimal'
    'zero_when_null'
    'join'
    'into_handle'
    'unbox'
    'address'
}

var value_type = Model.Type('nothing', "")
var answers_null_when_it_does_not_fit = false
var is_proven_to_fit = false
var is_on_its_own_line = false
var is_written_by_the_program = false
var shown: String
var kind: Kind
var converted: SpiteCompiler.Value?

func Conversion(
    starting_type: Model.Type,
    starting_kind: Kind,
    starting_converted: SpiteCompiler.Value,
    starting_shown: String,
) {
    value_type = starting_type
    kind = starting_kind
    converted = starting_converted
    shown = starting_shown
}

# ../../PROOFS.md#a-quiet-value-changes-nothing-handed-in-and-never-halts
func never_halts(): Boolean {
    var carried = kind == 'nullable' or kind == 'into_union' or kind == 'into_shape' or kind == 'widen'
    if carried or kind == 'to_decimal' or kind == 'address' {
        return true
    }
    fallback converted
    if kind == 'proven' {
        var is_a_read_of_an_item = converted.class == HighIntermediaryRepresentation.Values.Call
        return not converted.value_type.is_nullable and not is_a_read_of_an_item
    }
    if kind == 'present' {
        return converted.class != HighIntermediaryRepresentation.Values.AttributeRead
    }
    return false
}

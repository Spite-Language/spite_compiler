var left: HighIntermediaryRepresentation.Values.Value? = null
var operator = ""
var right: HighIntermediaryRepresentation.Values.Value? = null

func Operation(
    starting_left: HighIntermediaryRepresentation.Values.Value,
    starting_operator: String,
    starting_right: HighIntermediaryRepresentation.Values.Value,
) {
    left = starting_left
    operator = starting_operator
    right = starting_right
}

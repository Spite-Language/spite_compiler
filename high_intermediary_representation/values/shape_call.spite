var value_type = Model.Type('nothing', "")
var shape = Model.ShapeModel("", "")
var member = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var shown = ""
var receiver: SpiteCompiler.Value?
var arguments: List<SpiteCompiler.Value>

func ShapeCall(
    starting_shape: Model.ShapeModel,
    starting_member: Model.FunctionModel,
    starting_receiver: SpiteCompiler.Value,
    starting_arguments: List<SpiteCompiler.Value>,
) {
    shape = starting_shape
    member = starting_member
    receiver = starting_receiver
    arguments = starting_arguments
    if starting_member.answer {
        value_type = starting_member.answer
    } else {
        value_type = Model.Type('nothing', "")
    }
}

var value_type = Model.Type('nothing', "")
var function = Model.FunctionModel("", "")
var receiver: SpiteCompiler.Value? = null
var arguments = List<SpiteCompiler.Value>()
var index_path = ""
var index_hint = ""
var is_a_join = false
var missing_key = ""
var known_positions = List<Integer>()
var known_regions = List<String>()
var known_values = List<Long>()
var is_a_present_literal = false
var literal_answer: SpiteCompiler.Value? = null

func Call(
    starting_function: Model.FunctionModel,
    starting_receiver: SpiteCompiler.Value?,
    starting_arguments: List<SpiteCompiler.Value>,
) {
    function = starting_function
    receiver = starting_receiver
    arguments = starting_arguments
    if starting_function.answer {
        value_type = starting_function.answer
    } else {
        value_type = Model.Type('nothing', "")
    }
}

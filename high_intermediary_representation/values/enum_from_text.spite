var value_type = Model.Type('nothing', "")
var enumeration = Model.EnumModel("", "")
var text: Value? = null

func EnumFromText(starting_type: Model.Type, starting_enumeration: Model.EnumModel, starting_text: Value) {
    value_type = starting_type
    enumeration = starting_enumeration
    text = starting_text
}

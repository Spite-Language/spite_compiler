var value_type = Model.Type('scalar', "Boolean")
var question = ""
var asked_functions = List<Model.FunctionModel>()
var slot = ""
var parameter_index = -1
var answer = false
var is_answered = false
var is_asked_in_code = false
var asking_key = ""
var path = ""
var line = 0
var owner_shown = ""
var function_name = ""
var found_place = ""

func FunctionFact(starting_type: Model.Type, starting_question: String, starting_functions: List<Model.FunctionModel>) {
    value_type = starting_type
    question = starting_question
    asked_functions = starting_functions
}

func answered(holds: Boolean) {
    answer = holds
    is_answered = true
}

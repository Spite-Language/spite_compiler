var value_type = Model.Type('scalar', "Boolean")
var parameter_index = -1
var answer = false
var is_answered = false
var found_place = ""
var question: String
var asked_functions: List<Model.FunctionModel>
var slot: String
var is_asked_in_code: Boolean
var asking_key: String
var path: String
var line: Integer
var owner_shown: String
var function_name: String

func Fact(
    starting_type: Model.Type,
    starting_question: String,
    starting_functions: List<Model.FunctionModel>,
    starting_slot: String,
    starting_is_asked_in_code: Boolean,
    starting_asking_key: String,
    starting_path: String,
    starting_line: Integer,
    starting_owner_shown: String,
    starting_function_name: String,
) {
    value_type = starting_type
    question = starting_question
    asked_functions = starting_functions
    slot = starting_slot
    is_asked_in_code = starting_is_asked_in_code
    asking_key = starting_asking_key
    path = starting_path
    line = starting_line
    owner_shown = starting_owner_shown
    function_name = starting_function_name
}

func answered(holds: Boolean) {
    answer = holds
    is_answered = true
}

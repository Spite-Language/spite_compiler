var value_type = Model.Type('nothing', "")
var called: SpiteCompiler.Value?
var arguments: List<SpiteCompiler.Value>

func ValueCall(
    starting_called: SpiteCompiler.Value,
    starting_arguments: List<SpiteCompiler.Value>,
    starting_value_type: Model.Type,
) {
    called = starting_called
    arguments = starting_arguments
    value_type = starting_value_type
}

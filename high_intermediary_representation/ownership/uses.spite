var many = 1000

# ../../OPTIMIZATIONS.md#who-holds-an-object-is-decided-while-compiling
func in_value(value: HighIntermediaryRepresentation.Values.Value?, name: String): Integer {
    if not value {
        return 0
    }
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return read_of(value.name, name)
        HighIntermediaryRepresentation.Values.AttributeRead: return in_value(value.object, name)
        HighIntermediaryRepresentation.Values.Call: return in_a_call(value, name)
        HighIntermediaryRepresentation.Values.MakeObject: return in_values(value.arguments, name)
        HighIntermediaryRepresentation.Values.MachineOperation: return in_both(value.left, value.right, name)
        HighIntermediaryRepresentation.Values.Negation: return in_value(value.negated, name)
        HighIntermediaryRepresentation.Values.ForeignCall: return in_a_foreign_call(value, name)
        HighIntermediaryRepresentation.Values.Class.Test: return in_a_class_test(value, name)
        HighIntermediaryRepresentation.Values.PresenceTest: return in_a_presence_test(value, name)
        HighIntermediaryRepresentation.Values.Conversion: return in_value(value.converted, name)
        HighIntermediaryRepresentation.Values.Function.Value: return in_value(value.receiver, name)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return in_a_value_call(value, name)
        HighIntermediaryRepresentation.Values.NumberRoom: return in_both(value.made, value.number, name)
        HighIntermediaryRepresentation.Values.ShapeCall: return in_a_shape_call(value, name)
        HighIntermediaryRepresentation.Values.EnumText: return in_value(value.number, name)
        HighIntermediaryRepresentation.Values.EnumFromText: return in_value(value.text, name)
        HighIntermediaryRepresentation.Values.Class.OfValue: return in_value(value.described, name)
        HighIntermediaryRepresentation.Values.Function.Fact: return many
        _: return 0
    }
}

func in_a_class_test(test: HighIntermediaryRepresentation.Values.Class.Test, name: String): Integer {
    return in_value(test.tested, name)
}

func in_a_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest, name: String): Integer {
    return in_value(test.tested, name)
}

func read_of(read: String, name: String): Integer {
    if read == name {
        return 1
    }
    return 0
}

func in_both(
    left: HighIntermediaryRepresentation.Values.Value?,
    right: HighIntermediaryRepresentation.Values.Value?,
    name: String,
): Integer {
    var on_the_left = in_value(left, name)
    var on_the_right = in_value(right, name)
    return on_the_left + on_the_right
}

func in_values(values: List<HighIntermediaryRepresentation.Values.Value>, name: String): Integer {
    var found = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        found = found + in_value(value, name)
        index = index + 1
    }
    return found
}

func in_a_call(call: HighIntermediaryRepresentation.Values.Call, name: String): Integer {
    var on_the_receiver = in_value(call.receiver, name)
    var in_the_arguments = in_values(call.arguments, name)
    return on_the_receiver + in_the_arguments
}

func in_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall, name: String): Integer {
    var on_the_library = in_value(call.library, name)
    var in_the_arguments = in_values(call.arguments, name)
    return on_the_library + in_the_arguments
}

func in_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall, name: String): Integer {
    var on_the_called = in_value(call.called, name)
    var in_the_arguments = in_values(call.arguments, name)
    return on_the_called + in_the_arguments
}

func in_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall, name: String): Integer {
    var on_the_receiver = in_value(call.receiver, name)
    var in_the_arguments = in_values(call.arguments, name)
    return on_the_receiver + in_the_arguments
}

func in_statement(statement: HighIntermediaryRepresentation.Statements.Statement, name: String): Integer {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return in_a_declare(statement, name)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return in_an_assign(statement, name)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return in_an_attribute_write(statement, name)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return in_a_shape_write(statement, name)
        HighIntermediaryRepresentation.Statements.Evaluate: return in_both(statement.value, statement.waited, name)
        HighIntermediaryRepresentation.Statements.If: return in_an_if(statement, name)
        HighIntermediaryRepresentation.Statements.While: return in_a_while(statement, name)
        HighIntermediaryRepresentation.Statements.Return: return in_value(statement.value, name)
        HighIntermediaryRepresentation.Statements.Stop: return in_a_stop(statement, name)
        HighIntermediaryRepresentation.Statements.Block: return in_block(statement, name)
    }
}

func in_a_declare(declare: HighIntermediaryRepresentation.Statements.Declare, name: String): Integer {
    if declare.hides == name or declare.name == name {
        return many
    }
    return in_value(declare.value, name)
}

func in_an_assign(assign: HighIntermediaryRepresentation.Statements.Assign.Assign, name: String): Integer {
    if assign.name == name {
        return many
    }
    return in_value(assign.value, name)
}

func in_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute, name: String): Integer {
    return in_both(written.object, written.value, name)
}

func in_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape, name: String): Integer {
    return in_both(written.object, written.value, name)
}

func in_an_if(branch: HighIntermediaryRepresentation.Statements.If, name: String): Integer {
    var found = in_both(branch.condition, branch.decided_condition, name)
    found = found + in_block(branch.then_branch, name)
    found = found + in_block(branch.else_branch, name)
    return found
}

func in_a_while(loop: HighIntermediaryRepresentation.Statements.While, name: String): Integer {
    var in_the_condition = in_value(loop.condition, name)
    var in_the_body = in_block(loop.body, name)
    return in_the_condition + in_the_body
}

func in_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop, name: String): Integer {
    var in_the_shown = in_values(stop.shown, name)
    var in_the_then = in_value(stop.then, name)
    return in_the_shown + in_the_then
}

func in_block(block: HighIntermediaryRepresentation.Statements.Block?, name: String): Integer {
    if not block {
        return 0
    }
    return in_statements_from(block.statements, 0, name)
}

func in_statements_from(
    statements: List<HighIntermediaryRepresentation.Statements.Statement>,
    first: Integer,
    name: String,
): Integer {
    var found = 0
    var index = first
    while index < statements.count() {
        var statement = statements[index]
        found = found + in_statement(statement, name)
        index = index + 1
    }
    return found
}

func names_this(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if not value {
        return false
    }
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return false
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return names_this(value.object)
        HighIntermediaryRepresentation.Values.Conversion: return names_this(value.converted)
        HighIntermediaryRepresentation.Values.MakeObject: return any_names_this(value.arguments)
        HighIntermediaryRepresentation.Values.MachineOperation: return names_this_in_both(value.left, value.right)
        _: return true
    }
}

func names_this_in_both(
    left: HighIntermediaryRepresentation.Values.Value?,
    right: HighIntermediaryRepresentation.Values.Value?,
): Boolean {
    if names_this(left) {
        return true
    }
    return names_this(right)
}

func any_names_this(values: List<HighIntermediaryRepresentation.Values.Value>): Boolean {
    return values.any(names_this_present)
}

func names_this_present(value: HighIntermediaryRepresentation.Values.Value): Boolean {
    return names_this(value)
}

func is_the_local(value: HighIntermediaryRepresentation.Values.Value?, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name == name
    }
    return false
}

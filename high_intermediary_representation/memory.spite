# contract.md#the-memory-of-a-value
var buffer_class = "Buffer"
var read_name = "_read_byte_at"
var write_name = "_write_byte_at"

func is_a_primitive(class_name: String, function_name: String): Boolean {
    if class_name != buffer_class {
        return false
    }
    return function_name == read_name or function_name == write_name
}

func reads_a_byte(class_name: String, function_name: String): Boolean {
    if class_name != buffer_class {
        return false
    }
    return function_name == read_name
}

func writes_a_byte(class_name: String, function_name: String): Boolean {
    if class_name != buffer_class {
        return false
    }
    return function_name == write_name
}

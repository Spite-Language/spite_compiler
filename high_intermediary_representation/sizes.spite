var sizes = Dictionary<String, Integer>()
var blocks = Dictionary<String, Integer>()

func Sizes() {
    sizes["Boolean"] = 1
    sizes["Byte"] = 1
    sizes["Tiny"] = 1
    sizes["Short"] = 2
    sizes["UnsignedShort"] = 2
    sizes["Integer"] = 4
    sizes["UnsignedInteger"] = 4
    sizes["Float"] = 4
    sizes["Long"] = 8
    sizes["UnsignedLong"] = 8
    sizes["Double"] = 8
}

func size_of(type_name: String): Integer {
    var known = sizes[type_name]
    if known {
        return known
    } else {
        return the_size_of_an_object()
    }
}

func is_a_built_in(type_name: String): Boolean {
    var known = sizes[type_name]
    if known {
        return true
    } else {
        return false
    }
}

func the_size_of_an_object(): Integer {
    return 4
}

func alignment_of(type_name: String): Integer {
    var size = size_of(type_name)
    if size == 1 {
        return 1
    } else {
        return 4
    }
}

func block_size_of(size: Integer): Integer {
    var remainder = size % 4
    if remainder > 0 {
        return size + 4 - remainder
    } else {
        return size
    }
}

func note_a_block(class_name: String, size: Integer) {
    blocks[class_name] = size
}

func block_of(class_name: String): Integer {
    var known = blocks[class_name]
    if known {
        return known
    } else {
        return 0
    }
}

var object: HighIntermediaryRepresentation.Values.Value? = null
var offset: HighIntermediaryRepresentation.Values.Value? = null
var value: HighIntermediaryRepresentation.Values.Value? = null

func BufferWrite(
    starting_object: HighIntermediaryRepresentation.Values.Value,
    starting_offset: HighIntermediaryRepresentation.Values.Value,
    starting_value: HighIntermediaryRepresentation.Values.Value,
) {
    object = starting_object
    offset = starting_offset
    value = starting_value
}

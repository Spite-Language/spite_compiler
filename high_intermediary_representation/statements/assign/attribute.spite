var object: SpiteCompiler.Value? = null
var no_type = Model.Type('nothing', "")
var attribute = Model.AttributeModel("", "", no_type, null, false)
var value: SpiteCompiler.Value? = null
var line = 0
var is_to_a_fresh_object = false

func Attribute(
    starting_object: SpiteCompiler.Value,
    starting_attribute: Model.AttributeModel,
    starting_value: SpiteCompiler.Value,
    starting_line: Integer,
) {
    object = starting_object
    attribute = starting_attribute
    value = starting_value
    line = starting_line
}

var shape = Model.ShapeModel("", "")
var object: SpiteCompiler.Value?
var member: String
var value: SpiteCompiler.Value?
var line: Integer

func ThroughShape(
    starting_object: SpiteCompiler.Value,
    starting_shape: Model.ShapeModel,
    starting_member: String,
    starting_value: SpiteCompiler.Value,
    starting_line: Integer,
) {
    object = starting_object
    shape = starting_shape
    member = starting_member
    value = starting_value
    line = starting_line
}

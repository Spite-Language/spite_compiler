var declared_type = Model.Type('nothing', "")
var frame_items = 0
var shares_the_original = false
var is_quiet_work = false
var stands_apart_from_the_run_before = false
var quiet_work_may_halt = false
var name: String
var value: SpiteCompiler.Value?
var line: Integer
var hides: String

func Declare(
    starting_name: String,
    starting_type: Model.Type,
    starting_value: SpiteCompiler.Value,
    starting_line: Integer,
    starting_hides: String,
) {
    name = starting_name
    declared_type = starting_type
    value = starting_value
    line = starting_line
    hides = starting_hides
}

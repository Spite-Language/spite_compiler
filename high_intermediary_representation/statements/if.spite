var condition: SpiteCompiler.Value? = null
var then_branch = Block()
var else_branch: Block? = null
var line = 0
var written_condition = ""
var crashes_unless = ""
var decided_condition: SpiteCompiler.Value? = null

func If(
    starting_condition: SpiteCompiler.Value,
    starting_then: Block,
    starting_else: Block?,
    starting_line: Integer,
    starting_written_condition: String,
) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
    line = starting_line
    written_condition = starting_written_condition
}

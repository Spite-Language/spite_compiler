var condition: HighIntermediaryRepresentation.Values.Value? = null
var then_branch: HighIntermediaryRepresentation.Statements.Block? = null
var else_branch: HighIntermediaryRepresentation.Statements.Block? = null

func If(
    starting_condition: HighIntermediaryRepresentation.Values.Value,
    starting_then: HighIntermediaryRepresentation.Statements.Block,
    starting_else: HighIntermediaryRepresentation.Statements.Block?,
) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
}

var condition: HighIntermediaryRepresentation.Values.Value? = null
var then_branch = Block()
var else_branch: Block? = null
var line = 0
var written_condition = ""
var crashes_unless = ""
var decided_condition: HighIntermediaryRepresentation.Values.Value? = null

func If(starting_condition: HighIntermediaryRepresentation.Values.Value, starting_then: Block, starting_else: Block?) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
}

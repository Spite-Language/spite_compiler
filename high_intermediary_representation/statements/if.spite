var then_branch = Block(0)
var crashes_unless = ""
var decided_condition: SpiteCompiler.Value? = null
var condition: SpiteCompiler.Value?
var else_branch: Block?
var line: Integer
var written_condition: String

func If(
    starting_condition: SpiteCompiler.Value,
    starting_then: Block,
    starting_else: Block?,
    starting_line: Integer,
    starting_written_condition: String,
) {
    condition = starting_condition
    then_branch = starting_then
    else_branch = starting_else
    line = starting_line
    written_condition = starting_written_condition
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func else_if(): If? {
    fallback else_branch
    fallback else_branch.statements.count() == 1
    var only = else_branch.statements[0]
    fallback only.class == If
    return only
}

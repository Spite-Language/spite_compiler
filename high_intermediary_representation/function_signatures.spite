func signature_of(function_type: Model.Type): String {
    var shown = List<String>()
    var index = 0
    while index < function_type.parameters.count() {
        var parameter = function_type.parameters[index]
        var parameter_shown = type_shown(parameter)
        shown.append(parameter_shown)
        index = index + 1
    }
    var answer = "nothing"
    if function_type.answer {
        answer = type_shown(function_type.answer)
    }
    var listed = shown.join(",")
    return "({listed})->{answer}"
}

func type_shown(shown_type: Model.Type): String {
    var mark = ""
    if shown_type.is_nullable {
        mark = "?"
    }
    return "{shown_type.kind}:{shown_type.name}{mark}"
}

type SiteJudge {
    judge_what_is_recorded(HighIntermediaryRepresentation.Building.Context)
}

var model = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var resolver = NameResolution.Resolver(no_table)
var build_flags = Dictionary<String, String>()
var site_judges = List<SiteJudge>()

func HighIntermediaryRepresentation(
    starting_model: Model.ProgramModel,
    starting_resolver: NameResolution.Resolver,
    starting_flags: Dictionary<String, String>,
) {
    model = starting_model
    resolver = starting_resolver
    build_flags = starting_flags
}

func run(): HighProgram {
    var builder = Builder(model, resolver)
    builder.context.build_flags = build_flags
    builder.context.site_judges = site_judges
    return builder.build()
}

# ../PROOFS.md#what-the-builder-records-for-the-proofs
func judge_the_sites_with(judge: SiteJudge) {
    site_judges.append(judge)
}

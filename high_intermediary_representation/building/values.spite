var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var scalars = Model.Scalars()
var machinery_names = ["_buffer", "_length", "item_count", "handle", "address", "context", "_function", "_cell"]
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var temporary_count = 0
var build_defaults_read = 0
var spread_into: Model.FunctionModel? = null
var members_being_compared = List<String>()

func Values(starting_context: Context) {
    context = starting_context
}

func value_of(expression: SpiteCompiler.Expression?, expected: Model.Type?): SpiteCompiler.Value {
    var operators = Operators(context, this)
    var literals = Literals(context, this)
    var collections = Collections(context, this)
    var reads = Reads(context, this)
    crash expression
    var known = known_constants()
    var folded = known.folded(expression)
    if folded {
        return folded
    }
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return reads.named_or_described(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return literals.literal_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return literals.text_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return reads.member_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return call_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return collections.index_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return operators.binary_value_expecting(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return operators.unary_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return collections.list_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return collections.dictionary_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return unbuilt()
    }
}

# ../../../spite_spec/specs/reflection.md#known-while-compiling
func known_constants(): Folded.Constants {
    var known = context.constants
    if known {
        known.values = this
        return known
    }
    var made = Folded.Constants(context, this)
    context.constants = made
    return made
}

func same_signature(given: Model.Type, wanted: Model.Type): Boolean {
    fallback given.parameters.count() == wanted.parameters.count()
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        fallback is_the_same_type(given_parameter, wanted_parameter)
        index = index + 1
    }
    if not given.answer {
        return not wanted.answer
    }
    fallback wanted.answer
    return is_the_same_type(given.answer, wanted.answer)
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func is_the_same_type(given: Model.Type, wanted: Model.Type): Boolean {
    var given_type = context.resolver.same_members.same_member_type(given)
    var wanted_type = context.resolver.same_members.same_member_type(wanted)
    return given_type.is_the_same_as(wanted_type)
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func enum_named_by_its_path(snake: String): Model.Type? {
    var words = snake.split("_")
    var owner_words = List<String>()
    var last_owner_word = words.count() - 1
    var index = 0
    while index < last_owner_word {
        var word = words[index]
        owner_words.append(word)
        var enum_words = List<String>()
        var rest = index + 1
        while rest < words.count() {
            var enum_word = words[rest]
            enum_words.append(enum_word)
            rest = rest + 1
        }
        var owner_snake = owner_words.join("_")
        var enum_snake = enum_words.join("_")
        var owner_name = pascal_case_of(owner_snake)
        var enum_name = pascal_case_of(enum_snake)
        var path = [owner_name, enum_name]
        var found = context.resolver.types.declared_type_in(path, context.current_class)
        if found and found.kind == 'enumeration' {
            return found
        }
        index = index + 1
    }
    return null
}

func refuse_a_written_conversion(wanted: Model.Type) {
    var shown = context.shown(wanted)
    typing.refuse_a_written_conversion(context, shown)
}

func unused_receiver_of(made_type: Model.Type): SpiteCompiler.Value {
    if made_type.kind == 'scalar' {
        return HighIntermediaryRepresentation.Values.WholeNumber(made_type, 0)
    }
    var made = context.class_of(made_type)
    context.need_defaults(made.key)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, null, no_arguments)
}

func preset_called(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Value? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return preset_of(call, callee)
    }
    return null
}

func preset_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback call.arguments.is_empty()
    var first = member.name.slice(0, 1)
    crash first
    fallback first != first.lower_case()
    var class_path = class_path_of(member.target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var namespace = context.current_class.file.namespace
    var made_class = context.resolver.state.symbols.find("{written}.{member.name}", namespace)
    fallback not made_class
    var found = context.resolver.state.symbols.find(written, namespace)
    fallback found or scalars.is_a_scalar(written)
    var type_arguments = type_arguments_of(member.target)
    refuse_arguments_on_a_plain_name(class_path, type_arguments)
    var described = context.resolver.types.class_type_in(
        class_path,
        type_arguments,
        context.current_class,
        context.line,
    )
    fallback described.kind == 'object' or described.kind == 'scalar'
    var model = context.class_of(described)
    var preset = model.preset_named(member.name)
    if not preset and described.kind == 'scalar' {
        var constants = constants_of(model)
        typing.refuse_an_unknown_number_constant(context, written, member.name, constants)
    }
    fallback preset
    context.need(preset)
    var receiver = unused_receiver_of(described)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(preset, receiver, no_arguments)
}

func described_function(value: SpiteCompiler.Value): Model.FunctionModel? {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.function
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return context.function_locals[value.name]
    }
    return null
}

func enum_text(value: SpiteCompiler.Value): SpiteCompiler.Value {
    var literals = Literals(context, this)
    literals.need_text_constants()
    var made = enum_model_of(value.value_type)
    var string_type = context.text()
    return HighIntermediaryRepresentation.Values.EnumText(string_type, made, value)
}

func is_a_member_of(given: Model.Type, wanted: Model.Type): Boolean {
    var fitting = Fitting(context, this)
    var union_type = wanted.present()
    var made = fitting.union_model_of(union_type)
    var index = 0
    while index < made.members.count() {
        var member = made.members[index]
        if member.is_the_same_as(given) {
            return true
        }
        index = index + 1
    }
    return false
}

func are_whole_numbers(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    var neither_nullable = not wanted.is_nullable and not given.is_nullable
    fallback both_scalars and neither_nullable
    return is_a_whole_number(wanted) and is_a_whole_number(given)
}

func is_a_whole_number(of_type: Model.Type): Boolean {
    var scalar = scalars.of(of_type.name)
    crash scalar
    return not scalar.is_decimal and scalar.is_a_number
}

func is_a_decimal_type(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func enum_model_of(enum_type: Model.Type): Model.EnumModel {
    var parts = enum_type.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func boolean_constant(holds: Boolean): SpiteCompiler.Value {
    var number = 0
    if holds {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func is_held_in_a_box(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration'
}

func bound_type_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "has_function" and call.arguments.count() == 1
    var target = callee.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return bound_has_function(target.name, call)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_class_has_function(target, call)
    }
    return null
}

func member_class_has_function(
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    var function = context.current_function
    fallback target.name == "class" and function.bound_member_type
    var described = target.target
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and described.name == function.bound_parameter {
        return has_function_answer(function.bound_member_type, call)
    }
    return null
}

func bound_has_function(
    bound_name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    fallback bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    fallback bound
    return has_function_answer(bound, call)
}

func has_function_answer(
    bound: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    var asked = call.arguments[0]
    var function_name = ""
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        function_name = constant_text_of(asked)
    }
    fallback not function_name.is_empty()
    var answer = 0
    if context.has_a_class(bound) {
        var model = context.class_of(bound)
        if model.function_named(function_name) {
            answer = 1
        }
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, answer)
}

func constant_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    crash literal.pieces.count() == 1
    var piece = literal.pieces[0]
    crash not piece.hole
    return piece.value()
}

func bound_class_made(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    var function = context.current_function
    fallback callee.name == "class" and call.arguments.is_empty() and function.bound_member_type
    var target = callee.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == function.bound_parameter {
        return literals.default_of_a_type(function.bound_member_type)
    }
    return null
}

func walked_classes_or_values(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    fallback callee.name == "each" and call.arguments.count() == 1
    var listed = callee.target
    var argument = call.arguments[0]
    fallback listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var own = literals.this_value()
        return walked_listing(listed, context.current_class, argument.name, own)
    }
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_listing_by(listed, argument)
    }
    return null
}

# ../../../spite_documentation/metaprogramming.md#walking-a-folder-or-an-enum
func walked_listing_by(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    walker_written: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var operators = Operators(context, this)
    var lists_values = listed.name == "values" or listed.name == "classes"
    fallback lists_values
    var path = tested_class_path_of(listed.target)
    fallback not path.is_empty()
    var holder_path = class_path_of(walker_written.target)
    fallback holder_path.is_empty()
    var holder = value_of(walker_written.target, null)
    var holder_type = holder.value_type
    fallback holder_type.kind == 'object' and not holder_type.is_nullable and context.has_a_class(holder_type)
    var holder_model = context.class_of(holder_type)
    var walker = holder_model.function_named(walker_written.name)
    fallback walker
    var held = operators.held_once(holder)
    return walked_listing(listed, holder_model, walker_written.name, held)
}

func walked_listing(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    owner: Model.ClassModel,
    walker_name: String,
    receiver: SpiteCompiler.Value,
): SpiteCompiler.Value? {
    var lists_values = listed.name == "values" or listed.name == "classes"
    fallback lists_values
    var walker = owner.function_named(walker_name)
    fallback walker
    fallback walker.template_index < 0 and walker.parameters.count() == 1
    var path = tested_class_path_of(listed.target)
    fallback not path.is_empty()
    if listed.name == "values" {
        return walked_values(walker, path, receiver)
    }
    return walked_classes(walker, path, owner, receiver)
}

func walked_values(
    walker: Model.FunctionModel,
    path: List<String>,
    receiver: SpiteCompiler.Value,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    var declared = declared_enum_of(path)
    fallback declared
    fallback declared.kind == 'enumeration'
    var parameter = walker.parameters[0]
    crash parameter
    var taken = parameter.parameter_type
    fallback taken.kind == 'enumeration' and taken.name == declared.name and not taken.is_nullable
    var enumeration = enum_model_of(declared)
    context.need(walker)
    var index = 0
    while index < enumeration.values.count() {
        var value_name = enumeration.values[index]
        var value = literals.enum_value(value_name, declared)
        var arguments = List<SpiteCompiler.Value>()
        arguments.append(value)
        var walk_call = HighIntermediaryRepresentation.Values.Call(walker, receiver, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walked_classes(
    walker: Model.FunctionModel,
    path: List<String>,
    owner: Model.ClassModel,
    receiver: SpiteCompiler.Value,
): SpiteCompiler.Value? {
    var namespace = path.join(".")
    var folder = context.resolver.state.symbols.namespace_folder(namespace)
    fallback folder
    var parameter = walker.parameters[0]
    crash parameter
    fallback parameter.parameter_type.name == "Spite.Class"
    var names = classes_of_a_namespace(namespace)
    var index = 0
    while index < names.count() {
        var shown = names[index]
        var made = class_walk_copy(walker, shown, index, owner)
        context.need(made)
        var arguments = List<SpiteCompiler.Value>()
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, receiver, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func class_walk_copy(
    walker: Model.FunctionModel,
    shown: String,
    index: Integer,
    owner: Model.ClassModel,
): Model.FunctionModel {
    var owner_name = shown.replace(".", "_")
    var called_name = "{walker.name}_over_{owner_name}"
    var known = owner.function_named(called_name)
    if known {
        return known
    }
    var model = context.resolver.monomorphiser.class_model_named(shown)
    crash model
    var member_type = Model.Type('object', model.key)
    var described_names = DescribedNames()
    var simple = described_names.simple_name_of(model.shown)
    walker.template_index = 0
    var made = context.resolver.reading.specialized(walker, called_name, simple, member_type, false, owner)
    walker.template_index = -1
    made.is_a_walk_copy = true
    made.bound_member_index = index
    made.binds_a_class = true
    owner.declared_functions.append(made)
    return made
}

func walked_attributes(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "each" and call.arguments.count() == 1
    var listed = callee.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_attributes_of(call, listed)
    }
    return null
}

func walked_attributes_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback listed.name == "attributes"
    var argument = call.arguments[0]
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return walked_by(listed, argument.name)
    }
    return null
}

func walked_by(listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, name: String): SpiteCompiler.Value? {
    var operators = Operators(context, this)
    var walker = context.current_class.function_named(name)
    fallback walker
    fallback walker.parameters.count() == 1 and walker.template_index < 0
    var parameter = walker.parameters[0]
    var described = parameter.parameter_type
    var is_described = described.name == "Spite.Attribute" or described.name == "Spite.AttributeDeclaration"
    fallback is_described and described.kind == 'object' and not described.is_nullable
    var class_path = tested_class_path_of(listed.target)
    if not class_path.is_empty() {
        var type_arguments = type_arguments_of(listed.target)
        var described_class = context.resolver.types.class_type_in(
            class_path,
            type_arguments,
            context.current_class,
            context.line,
        )
        if described.name == "Spite.Attribute" {
            refuse_a_walked_kind(walker, described_class, true)
        }
        refuse_a_walk_over_a_type(class_path, described_class)
        return walked_over_the_attributes(walker, described_class, null)
    }
    if described.name != "Spite.Attribute" {
        refuse_an_instance_walk(walker, listed.target)
        return null
    }
    var object = value_of(listed.target, null)
    fallback object.value_type.kind == 'object' and not object.value_type.is_nullable
    var model = context.class_of(object.value_type)
    fallback not model.attribute_named("attributes")
    var held = operators.held_once(object)
    return walked_over_the_attributes(walker, object.value_type, held)
}

func refuse_an_instance_walk(walker: Model.FunctionModel, target: SpiteCompiler.Expression?) {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        refuse_a_named_walk(walker, target)
    }
}

func refuse_a_named_walk(
    walker: Model.FunctionModel,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var is_a_value = not target.is_a_class_name and not target.name.starts_with("$")
    fallback is_a_value
    var object = value_of(target, null)
    var is_an_instance = object.value_type.kind == 'object' and not object.value_type.is_nullable
    fallback is_an_instance and object.value_type.name != "Spite.Class"
    var model = context.class_of(object.value_type)
    fallback not model.attribute_named("attributes")
    refuse_a_walked_kind(walker, object.value_type, false)
}

func refuse_a_walked_kind(walker: Model.FunctionModel, described_class: Model.Type, walks_declarations: Boolean) {
    var model = context.class_of(described_class)
    var first = model.declared_attributes[0]
    fallback first
    var shown = context.shown(described_class)
    typing.refuse_walked_kind(context, walker.name, first.name, shown, walks_declarations)
}

# ../../../spite_spec/specs/metaprogramming.md#walks
func refuse_a_list_over_a_type(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback member.name == "attributes"
    var class_path = tested_class_path_of(member.target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback written.starts_with("$") or found
    var type_arguments = type_arguments_of(member.target)
    var described_class = context.resolver.types.class_type_in(
        class_path,
        type_arguments,
        context.current_class,
        context.line,
    )
    refuse_a_walk_over_a_type(class_path, described_class)
}

# ../../../spite_spec/specs/metaprogramming.md#walks
func refuse_a_walk_over_a_type(class_path: List<String>, described_class: Model.Type) {
    fallback described_class.kind == 'shape'
    var written = class_path.join(".")
    var shown = context.shown(described_class)
    typing.refuse_a_walk_over_a_type(context, written, shown)
}

func walked_over_the_attributes(
    walker: Model.FunctionModel,
    described_class: Model.Type,
    object: SpiteCompiler.Value?,
): SpiteCompiler.Value {
    var literals = Literals(context, this)
    var model = context.class_of(described_class)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = walk_specialized(walker, attribute, index, described_class, object)
        context.need(made)
        var arguments = List<SpiteCompiler.Value>()
        if object {
            arguments.append(object)
        }
        var own = literals.this_value()
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, own, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walk_specialized(
    walker: Model.FunctionModel,
    attribute: Model.AttributeModel,
    index: Integer,
    described_class: Model.Type,
    object: SpiteCompiler.Value?,
): Model.FunctionModel {
    var owner_name = described_class.name.replace(".", "_")
    var called_name = "{walker.name}_over_{owner_name}_{attribute.name}"
    var known = context.current_class.function_named(called_name)
    if known {
        return known
    }
    walker.template_index = 0
    var made = context.resolver.reading.specialized(
        walker,
        called_name,
        attribute.name,
        attribute.attribute_type,
        false,
        context.current_class,
    )
    walker.template_index = -1
    made.is_a_walk_copy = true
    made.bound_member_index = index
    if not object {
        made.walked_declarations_of = described_class.name
    }
    if object {
        made.walked_object = described_class
        var hidden = Model.ParameterModel("_walked", described_class, false)
        made.parameters.append(hidden)
    }
    context.current_class.declared_functions.append(made)
    return made
}

func described_text(written: String): SpiteCompiler.Value {
    var literals = Literals(context, this)
    literals.need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func camel_case_of(written: String): String {
    var pascal = pascal_case_of(written)
    var first = pascal.slice(0, 1)
    crash first
    var length = pascal.length()
    var rest = pascal.slice(1, length)
    crash rest
    var lowered = first.lower_case()
    return "{lowered}{rest}"
}

func pascal_case_of(written: String): String {
    var words = written.split("_")
    var pieces = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var length = word.length()
        var raised = ""
        var rest = ""
        if length > 0 {
            var first = word.slice(0, 1)
            crash first
            raised = first.upper_case()
            var tail = word.slice(1, length)
            crash tail
            rest = tail
        }
        pieces.append("{raised}{rest}")
        index = index + 1
    }
    return pieces.join("")
}

func enum_value_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var fitting = Fitting(context, this)
    fallback callee.name == "find_by_name" and call.arguments.count() == 1
    var listed = callee.target
    var lists_the_values = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        lists_the_values = listed.name == "values"
    }
    fallback lists_the_values
    var path = enum_path_of(listed)
    fallback not path.is_empty()
    var declared = context.resolver.types.declared_type_in(path, context.current_class)
    fallback declared
    fallback declared.kind == 'enumeration'
    var argument = call.arguments[0]
    var maybe = declared.nullable()
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and argument.kind == 'symbol_literal' {
        var named = fitting.fitted_value_of(argument, declared)
        return HighIntermediaryRepresentation.Values.Conversion(maybe, 'nullable', named)
    }
    var text = context.text()
    var written = fitting.fitted_value_of(argument, text)
    return fitting.fitted(written, maybe)
}

func enum_path_of(listed: SpiteCompiler.Expression?): List<String> {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return class_path_of(listed.target)
    }
    return List<String>()
}

func declared_enum_of(path: List<String>): Model.Type? {
    var first = path[0]
    crash first
    if first.starts_with("$") and path.count() == 1 {
        return context.current_class.bound_types[first]
    }
    return context.resolver.types.declared_type_in(path, context.current_class)
}

func reflected_object_of(target: SpiteCompiler.Expression?): SpiteCompiler.Value? {
    var class_path = class_path_of(target)
    fallback not class_path.is_empty()
    var type_arguments = type_arguments_of(target)
    refuse_arguments_on_a_plain_name(class_path, type_arguments)
    var written = class_path.join(".")
    var reflection = Reflection(context, this)
    var folder = context.resolver.state.symbols.namespace_folder(written)
    if folder {
        return reflection.class_objects.namespace_object(folder.namespace)
    }
    var declared_enum = context.resolver.types.declared_type_in(class_path, context.current_class)
    if declared_enum and declared_enum.kind == 'enumeration' {
        return reflection.class_objects.enum_object(declared_enum.name)
    }
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback found or scalars.is_a_scalar(written)
    var described = context.resolver.types.class_type_in(
        class_path,
        type_arguments,
        context.current_class,
        context.line,
    )
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    fallback is_a_class
    return reflection.class_objects.class_object(described.name)
}

# ../../../spite_spec/specs/reflection.md#reaching-a-class
func refuse_arguments_on_a_plain_name(
    class_path: List<String>,
    type_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
) {
    fallback not type_arguments.is_empty()
    var written = class_path.join(".")
    var declared = context.resolver.types.declared_type_in(class_path, context.current_class)
    var folder = context.resolver.state.symbols.namespace_folder(written)
    fallback declared or folder or scalars.is_a_scalar(written)
    var no_generics = List<String>()
    var count = type_arguments.count()
    var rule = Validators.NameResolution.GenericArguments.Validator()
    rule.check(context.current_class.file.path, context.line, written, no_generics, count)
}

func refuse_a_call_on_a_number_class(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    receiver: SpiteCompiler.Value,
) {
    var class_path = class_path_of(callee.target)
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    var reflection_model = context.class_of(receiver.value_type)
    fallback not reflection_model.function_named(callee.name)
    var number = number_class_of(class_path)
    var constants = constants_of(number)
    var spelled = pascal_case_of(callee.name)
    if number.preset_named(spelled) {
        typing.refuse_a_called_constant(context, "{written}.{callee.name}", "{written}.{spelled}()")
    }
    var function = number.function_named(callee.name)
    if function {
        typing.refuse_a_value_function_on_a_class(context, written, callee.name, constants)
    }
    typing.refuse_an_unknown_number_constant(context, written, callee.name, constants)
}

func number_class_of(class_path: List<String>): Model.ClassModel {
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.types.class_type_in(
        class_path,
        no_type_arguments,
        context.current_class,
        context.line,
    )
    return context.class_of(described)
}

func constants_of(number: Model.ClassModel): String {
    var names = List<String>()
    var index = 0
    while index < number.declared_functions.count() {
        var function = number.declared_functions[index]
        if function.is_a_preset {
            names.append("{function.name}()")
        }
        index = index + 1
    }
    var last = names.remove_last()
    crash last
    if names.is_empty() {
        return last
    }
    var listed = names.join(", ")
    return "{listed} and {last}"
}

func reflected_receiver(target: SpiteCompiler.Expression?): SpiteCompiler.Value? {
    return reflected_object_of(target)
}

func called_on_a_class(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value {
    var owner = context.class_of(receiver.value_type)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function {
        refuse_a_call_on_a_class_object(receiver, name)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    return called(function, receiver, written)
}

func refuse_a_call_on_a_class_object(receiver: SpiteCompiler.Value, name: String) {
    if receiver.class == HighIntermediaryRepresentation.Values.Class.Object {
        refuse_a_class_object_call(receiver, name)
    }
}

func refuse_a_class_object_call(object: HighIntermediaryRepresentation.Values.Class.Object, name: String) {
    var described = context.program.class_named(object.described)
    fallback described
    fallback described.function_named(name) or described.attribute_named(name)
    var plain = typing.plain_class_name(described.shown)
    if scalars.is_a_scalar(described.key) {
        refuse_a_value_function_on_a_number_class(described, plain, name)
    }
    typing.refuse_a_class_as_a_value(context, plain)
}

func refuse_a_value_function_on_a_number_class(described: Model.ClassModel, plain: String, name: String) {
    var listed = constants_of(described)
    typing.refuse_a_value_function_on_a_number_class(context, plain, name, listed)
}

func has_its_own_class(target: SpiteCompiler.Value): Boolean {
    if target.value_type.kind == 'union' and not target.value_type.is_nullable {
        return every_member_reads_its_class(target.value_type)
    }
    fallback context.has_a_class(target.value_type)
    var owner = context.class_of(target.value_type)
    if owner.attribute_named("class") {
        return true
    }
    if owner.function_named("get_class") {
        return true
    }
    return false
}

func present_class_of(value: SpiteCompiler.Value): Model.ClassModel {
    var value_type = value.value_type
    if value_type.is_nullable {
        note_a_maybe_null_type(value_type)
    }
    if not context.has_a_class(value_type) {
        var shown_type = context.shown(value_type)
        typing.refuse_no_members(context, shown_type)
    }
    return context.class_of(value_type)
}

func call_value(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    expected: Model.Type?,
): SpiteCompiler.Value {
    var maker = call.callee
    if maker.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and maker.name.starts_with("$") {
        return made_from_a_bound_type(call, maker.name)
    }
    var preset = preset_called(call)
    if preset {
        return preset
    }
    var class_path = class_path_of(call.callee)
    if not class_path.is_empty() {
        return constructed(call, class_path, expected)
    }
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return own_call(call, callee.name)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_call(call, callee)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return indexed_function_call(call, callee)
    }
    return unbuilt()
}

# ../../../spite_spec/specs/values_and_types.md#casting
func refuse_a_conversion_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made_type: Model.Type,
    expected: Model.Type?,
) {
    fallback call.arguments.count() == 1 and may_be_converted(made_type)
    var argument = call.arguments[0]
    var given = value_of(argument, null)
    var shown = conversion_answer_shown(made_type, given.value_type)
    fallback not shown.is_empty()
    var printer = Printers.Spite.ExpressionPrinter(call)
    var call_text = printer.text()
    var argument_printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = argument_printer.text()
    if expected {
        var wanted = expected.present()
        if is_the_same_type(wanted, made_type) {
            typing.refuse_a_cast_the_place_makes(context, call_text, argument_text)
        }
    }
    typing.refuse_a_conversion_by_name(context, call_text, argument_text, shown)
}

func conversion_answer_shown(made_type: Model.Type, given_type: Model.Type): String {
    var shown = context.shown(made_type)
    var from_text = given_type.kind == 'object' and given_type.name == "String"
    if made_type.kind == 'enumeration' {
        return "{shown}?"
    }
    if made_type.kind == 'scalar' {
        if from_text {
            return "{shown}?"
        }
        return shown
    }
    var made = context.class_of(made_type)
    var conversion = made.conversion_from(given_type)
    fallback conversion
    if conversion.answer and conversion.answer.is_nullable {
        return "{shown}?"
    }
    return shown
}

func may_be_converted(made_type: Model.Type): Boolean {
    if made_type.kind == 'enumeration' or made_type.kind == 'scalar' {
        return true
    }
    fallback made_type.kind == 'object'
    var made = context.class_of(made_type)
    var constructor = constructor_of(made)
    fallback not constructor or constructor.parameters.count() != 1
    var conversion = made.read_conversion()
    fallback conversion
    return true
}

func indexed_function_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): SpiteCompiler.Value {
    var held = value_of(callee, null)
    if held.value_type.is_nullable {
        var wanted = held.value_type.present()
        note_a_maybe_null("fit", held, "", wanted)
        held = as_present(held)
    }
    var held_type = held.value_type
    if held_type.kind != 'function' {
        var printer = Printers.Spite.ExpressionPrinter(callee)
        var written = printer.text()
        var shown = context.shown(held_type)
        typing.refuse_not_callable(context, written, shown)
    }
    return call_through_a_value(held, held_type, call)
}

func made_from_a_bound_type(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value {
    var literals = Literals(context, this)
    var bound = context.current_class.bound_types[name]
    if not bound {
        typing.refuse_unknown_name(context, name)
    }
    crash bound
    var made_type = bound.present()
    if made_type.is_nothing() and call.arguments.is_empty() {
        return HighIntermediaryRepresentation.Values.NullConstant(made_type)
    }
    var is_a_value = made_type.kind == 'shape' or made_type.kind == 'enumeration'
    var is_plain = made_type.kind == 'scalar' or made_type.name == "String" or is_a_value
    if is_plain and call.arguments.is_empty() {
        var plain = literals.default_of_a_type(made_type)
        crash plain
        return plain
    }
    refuse_making_what_makes_nothing(made_type)
    var made = context.class_of(made_type)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    if constructor and call.arguments.is_empty() and reads_into_defaults(constructor) {
        var no_arguments = List<SpiteCompiler.Value>()
        return HighIntermediaryRepresentation.Values.MakeObject(made_type, null, no_arguments)
    }
    var arguments = List<SpiteCompiler.Value>()
    if constructor {
        context.need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func reads_into_defaults(constructor: Model.FunctionModel): Boolean {
    fallback not constructor.parameters.is_empty()
    var library = Mapping.LibraryFile()
    var path = context.current_class.file.path.replace("\\", "/")
    fallback library.holds(path) and context.current_function.name == "_placeholder"
    return path.ends_with("/json_reader.spite")
}

func need_the_scheduler(handle_type: Model.Type) {
    fallback handle_type.kind == 'handle'
    context.makes_work = true
    var found = context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = context.resolver.monomorphiser.class_model_named("Spite.Fault")
    crash fault
    var walking = fault.function_named("frames")
    crash walking
    context.need(walking)
}

func work_call(handle: SpiteCompiler.Value, name: String): SpiteCompiler.Value {
    var work_type = Model.Type('object', handle.value_type.carrier)
    var work_model = context.class_of(work_type)
    var function = work_model.function_named(name)
    crash function
    if name == "to_debug" {
        need_the_work_text(work_model)
    }
    var no_values = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(function, handle, no_values)
}

func result_of_handle(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if value.value_type.kind != 'handle' {
        return value
    }
    crash value.value_type.answer
    var answer: Model.Type = value.value_type.answer
    need_the_settling(value.value_type)
    return HighIntermediaryRepresentation.Values.Conversion(answer, 'join', value)
}

func need_the_settling(handle: Model.Type) {
    fallback handle.kind == 'handle'
    context.makes_work = true
}

func need_the_work_text(work_model: Model.ClassModel) {
    fallback not context.work_texts.contains(work_model.key)
    context.work_texts.append(work_model.key)
    var debugging = Debugging(context, this)
    debugging.work_to_debug(work_model)
}

func refuse_a_cast_by_name(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var class_path = class_path_of(callee.target)
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    typing.refuse_cast_by_name(context, written, callee.name)
}

func class_path_of(expression: SpiteCompiler.Expression?): List<String> {
    var inference = NameResolution.Inference()
    return inference.class_path_of(expression)
}

func tested_class_path_of(expression: SpiteCompiler.Expression?): List<String> {
    var path = List<String>()
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name.starts_with("$") {
        path.append(expression.name)
        return path
    }
    return class_path_of(expression)
}

func refuse_an_unknown_generic_class(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
) {
    var written = class_path.join(".")
    var initial = written.slice(0, 1)
    crash initial
    var is_a_class_name = initial != initial.lower_case() and not scalars.is_a_scalar(written)
    var built_in = ["Spite.Function", "Symbol", "Parallel", "Concurrent"]
    var is_generic = not call.generic_arguments.is_empty() and not built_in.contains(written)
    fallback is_generic and is_a_class_name
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback not found
    typing.refuse_an_unknown_generic_class(context, written)
}

func constructed(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
    expected: Model.Type?,
): SpiteCompiler.Value {
    refuse_an_unknown_generic_class(call, class_path)
    var inferred = inferred_type_of(call, class_path)
    var made_type = inferred
    if not made_type {
        made_type = context.resolver.types.class_type_in(
            class_path,
            call.generic_arguments,
            context.current_class,
            context.line,
        )
    }
    crash made_type
    return constructed_as(call, made_type, class_path, expected)
}

func refuse_making_what_makes_nothing(made_type: Model.Type) {
    var segments = made_type.name.split(".")
    var shown = segments.last()
    crash shown
    if made_type.kind == 'shape' {
        typing.refuse_a_made_type(context, shown)
    }
    if made_type.kind == 'union' {
        typing.refuse_a_made_union(context, shown)
    }
}

func constructed_as(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made_type: Model.Type,
    class_path: List<String>,
    expected: Model.Type?,
): SpiteCompiler.Value {
    refuse_making_what_makes_nothing(made_type)
    refuse_a_conversion_by_name(call, made_type, expected)
    var made = context.class_of(made_type)
    var constraints = Constraints(context, this)
    constraints.check(made)
    check_a_serialized_class(class_path, made)
    context.need_defaults(made.key)
    var handed_over = ""
    if made.key == "ForeignCallback" {
        var crossing = ForeignCrossing(context, this)
        handed_over = crossing.handover_place(call)
    }
    var constructor = constructor_of(made)
    var arguments = List<SpiteCompiler.Value>()
    if constructor and not handed_over.is_empty() {
        context.need(constructor)
        var handing = ForeignCrossing(context, this)
        arguments = handing.handover_arguments(call, constructor)
    } else if constructor {
        context.need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    } else {
        var no_parameters = List<Model.ParameterModel>()
        arguments = arguments_for(made.shown, no_parameters, call.arguments, false)
    }
    var making = HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
    making.foreign_place = handed_over
    if made.is_singleton {
        context.note_a_singleton_made(made.key, arguments)
    }
    return making
}

func check_a_serialized_class(class_path: List<String>, made: Model.ClassModel) {
    var last = class_path.last()
    crash last
    if class_path.count() == 1 {
        var serializer = Validators.HighIntermediaryRepresentation.Serializer.Validator(context)
        serializer.check(last, made)
    }
}

func inferred_type_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
): Model.Type? {
    fallback call.generic_arguments.is_empty()
    var written = class_path.join(".")
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback found
    var file = context.resolver.state.symbols.file_for(found.path)
    fallback file
    fallback context.resolver.monomorphiser.is_a_template(file)
    var argument_types = List<Model.Type>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var argument_type = inferred_argument_type(argument)
        argument_types.append(argument_type)
        index = index + 1
    }
    return context.resolver.monomorphiser.inferred_instance(
        class_path,
        context.current_class,
        context.line,
        argument_types,
    )
}

func inferred_argument_type(argument: SpiteCompiler.Expression?): Model.Type {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and argument.kind == 'keyword_null' {
        return Model.Type('nothing', "")
    }
    var value = value_of(argument, null)
    return value.value_type
}

func constructor_of(made: Model.ClassModel): Model.FunctionModel? {
    var index = 0
    while index < made.declared_functions.count() {
        var function = made.declared_functions[index]
        if function.is_constructor {
            return function
        }
        index = index + 1
    }
    return null
}

func enum_read_from(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var given = receiver.value_type
    var reads_text = given.kind == 'object' and given.name == "String" and not given.is_nullable
    fallback reads_text and written.is_empty() and name.starts_with("to_")
    var length = name.length()
    var enum_words = name.slice(3, length)
    crash enum_words
    var enum_type = enum_named_by_its_path(enum_words)
    fallback enum_type
    refuse_a_written_conversion(enum_type)
    return null
}

func class_form_call(
    receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var element = owner.bound_types["$element_type"]
    fallback element and written.is_empty()
    fallback element.kind == 'union' and not element.is_nullable
    var forms = ["filter", "count", "any", "all", "remove_where"]
    var index = 0
    while index < forms.count() {
        var form = forms[index]
        var prefix = "{form}_"
        if name.starts_with(prefix) {
            var prefix_length = prefix.length()
            var name_length = name.length()
            var written_class = name.slice(prefix_length, name_length)
            crash written_class
            var member = union_member_class(element, written_class)
            if member {
                var making = PassedForms(context, this)
                var made = making.class_form(owner, form, member)
                crash made
                var no_values = List<SpiteCompiler.Value>()
                return HighIntermediaryRepresentation.Values.Call(made, receiver, no_values)
            }
        }
        index = index + 1
    }
    return null
}

func union_member_class(element: Model.Type, written: String): Model.Type? {
    var fitting = Fitting(context, this)
    var candidates = singular_candidates(written, true)
    var united = fitting.union_model_of(element)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var pascal = pascal_case_of(candidate)
        var member_index = 0
        while member_index < united.members.count() {
            var held = united.members[member_index]
            var parts = held.name.split(".")
            var last = parts.count() - 1
            var simple = parts[last]
            if simple == pascal {
                return held
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
    return null
}

func passed_form(
    receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var is_a_form = name == "count" or name == "sum"
    fallback is_a_form and written.count() == 1 and owner.bound_types["$element_type"]
    if name == "count" {
        var counting = owner.function_named("count_where")
        crash counting
        return called(counting, receiver, written)
    }
    var measure = value_of(written[0], null)
    fallback measure.value_type.kind == 'function'
    fallback measure.value_type.answer
    fallback measure.value_type.answer.name != "Integer"
    var forms = PassedForms(context, this)
    var summing = forms.sum_for(owner, measure.value_type)
    fallback summing
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(measure)
    return HighIntermediaryRepresentation.Values.Call(summing, receiver, arguments)
}

func made_copy(owner: Model.ClassModel, name: String, argument_count: Integer): Model.FunctionModel? {
    if name == "_deep_copy_in" {
        return made_copy_in(owner, argument_count)
    }
    var asks_a_copy = name == "copy" or name == "deep_copy"
    fallback asks_a_copy and argument_count == 0 and not owner.is_singleton
    var copying = Copying(context, this)
    return copying.copy_of(owner, name == "deep_copy")
}

func made_copy_in(owner: Model.ClassModel, argument_count: Integer): Model.FunctionModel? {
    fallback argument_count == 1 and not owner.is_singleton
    var copying = Copying(context, this)
    return copying.copy_in_of(owner)
}

func own_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): SpiteCompiler.Value {
    var literals = Literals(context, this)
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return function_value_call(call, name)
    }
    var walked_class = made_from_the_walked_class(call, name)
    if walked_class {
        return walked_class
    }
    var rebound = rebound_template_call(call, name)
    if rebound {
        return rebound
    }
    var function = context.current_class.function_named(name)
    if not function and holds_a_function_value(name) {
        var held_value = value_of(call.callee, null)
        return value_call_of(held_value, call.arguments)
    }
    var calls_a_held_class = holds_a_class_object(name) and call.arguments.is_empty()
    if not function and calls_a_held_class {
        var described_value = value_of(call.callee, null)
        return made_from_a_held_class(described_value)
    }
    if not function {
        function = member_template_of(context.current_class, name)
    }
    if not function {
        var walked = walk_of(context.current_class, name, call.arguments)
        if walked {
            return walked
        }
    }
    if not function and name == "_deep_copied" and call.arguments.count() == 1 {
        var copied_value = value_of(call.arguments[0], null)
        var copying = Copying(context, this)
        return copying.deep_copied(copied_value)
    }
    if not function {
        typing.refuse_unknown_function(context, name)
    }
    crash function
    var walking = KnownWalks(context, this)
    var known_answer = walking.call_with_a_known(function, call)
    if known_answer {
        return known_answer
    }
    var passed_on = passed_on_template(function, call)
    if passed_on {
        return passed_on
    }
    refuse_a_bare_operator_call(call, function)
    var own = literals.this_value()
    var made = called(function, own, call.arguments)
    refuse_a_bare_accessor_call(call, function)
    return made
}

# ../../../spite_documentation/reflection.md#known-while-compiling
func made_from_the_walked_class(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value? {
    var walking = context.current_function
    fallback walking.binds_a_class and name == walking.bound_parameter
    crash walking.bound_member_type
    var walked_type: Model.Type = walking.bound_member_type
    var class_path = walked_type.name.split(".")
    return constructed_as(call, walked_type, class_path, null)
}

func passed_on_template(
    function: Model.FunctionModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    var current = context.current_function
    var is_walked = not current.bound_pattern.is_empty() or function.reflected_answer_index >= 0
    var is_bound = not current.bound_parameter.is_empty() and is_walked
    fallback is_bound and function.template_index < 0
    var symbol_index = passed_symbol_index(function, call)
    fallback symbol_index >= 0
    var specialised_name = "{function.name}_for_{current.bound_function}"
    var made = context.current_class.function_named(specialised_name)
    if not made {
        made = specialised_for_the_pattern(function, symbol_index, specialised_name)
    }
    crash made
    var passed = List<SpiteCompiler.Expression>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if index != symbol_index {
            passed.append(argument)
        }
        index = index + 1
    }
    var own = literals.this_value()
    return called(made, own, passed)
}

func passed_symbol_index(
    function: Model.FunctionModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Integer {
    if not function.declaration {
        return -1
    }
    var found = -1
    var index = 0
    while index < function.declaration.parameters.count() {
        var parameter = function.declaration.parameters[index]
        var argument = call.arguments[index]
        if passes_the_symbol(parameter, argument) {
            found = index
        }
        index = index + 1
    }
    return found
}

func passes_the_symbol(
    parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter,
    argument: SpiteCompiler.Expression?,
): Boolean {
    fallback argument
    fallback context.resolver.types.is_a_declaration_type(parameter.declared_type)
    return names_the_member(argument, context.current_function.bound_parameter)
}

func specialised_for_the_pattern(
    function: Model.FunctionModel,
    symbol_index: Integer,
    specialised_name: String,
): Model.FunctionModel {
    var current = context.current_function
    crash current.bound_member_type
    var member_type: Model.Type = current.bound_member_type
    var template = Model.FunctionModel(function.name, function.owner)
    template.declaration = function.declaration
    template.template_index = symbol_index
    var made = context.resolver.reading.specialized(
        template,
        specialised_name,
        current.bound_member,
        member_type,
        current.bound_member_is_a_function,
        context.current_class,
    )
    made.bound_member_index = current.bound_member_index
    made.bound_pattern = current.bound_pattern
    made.bound_function = current.bound_function
    made.bound_class = current.bound_class
    made.binds_a_function_declaration = current.binds_a_function_declaration
    context.current_class.declared_functions.append(made)
    return made
}

func rebound_template_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    var parameter = context.current_function.bound_parameter
    fallback not parameter.is_empty()
    var words = name.split("_")
    fallback words.contains(parameter)
    var passed = List<SpiteCompiler.Expression>()
    var found = false
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if names_the_member(argument, parameter) {
            found = true
        } else {
            passed.append(argument)
        }
        index = index + 1
    }
    fallback found
    var renamed = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word == parameter {
            renamed.append(context.current_function.bound_member)
        } else {
            renamed.append(word)
        }
        word_index = word_index + 1
    }
    var called_name = renamed.join("_")
    var function = member_template_of(context.current_class, called_name)
    fallback function
    var own = literals.this_value()
    return called(function, own, passed)
}

func names_the_member(argument: SpiteCompiler.Expression, name: String): Boolean {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return argument.name == name
    }
    return false
}

func function_value_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value {
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var local_type = context.scope.type_of(internal_name)
    crash local_type
    if is_a_class_object(local_type) and call.arguments.is_empty() {
        var described = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
        return made_from_a_held_class(described)
    }
    if local_type.kind != 'function' {
        var shown = context.shown(local_type)
        typing.refuse_not_callable(context, name, shown)
    }
    var called_value = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    return call_through_a_value(called_value, local_type, call)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func made_from_a_held_class(described: SpiteCompiler.Value): SpiteCompiler.Value {
    var held = described
    if held.value_type.is_nullable {
        note_a_maybe_null("held", held, "", held.value_type)
        held = as_present(held)
    }
    var reflection = Reflection(context, this)
    var making = reflection.making.made_anew()
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(making, held, no_arguments)
}

func is_a_class_object(value_type: Model.Type): Boolean {
    return value_type.kind == 'object' and value_type.name == "Spite.Class"
}

func holds_a_class_object(name: String): Boolean {
    var held = context.current_class.attribute_named(name)
    fallback held
    return is_a_class_object(held.attribute_type)
}

func made_from_a_member_class(
    receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
): SpiteCompiler.Value? {
    var getter = owner.function_named("get_{name}")
    if getter and getter.parameters.is_empty() and getter.answer {
        var answer_type: Model.Type = getter.answer
        fallback is_a_class_object(answer_type)
        var no_arguments = List<SpiteCompiler.Expression>()
        var got = called(getter, receiver, no_arguments)
        return made_from_a_held_class(got)
    }
    var attribute = owner.attribute_named(name)
    fallback attribute
    fallback is_a_class_object(attribute.attribute_type)
    var attribute_read = HighIntermediaryRepresentation.Values.AttributeRead(receiver, attribute)
    return made_from_a_held_class(attribute_read)
}

func attribute_function_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    attribute: Model.AttributeModel,
): SpiteCompiler.Value {
    var literals = Literals(context, this)
    var reads = Reads(context, this)
    var own = literals.this_value()
    var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var held = reads.narrowed(read, attribute.name)
    if held.value_type.is_nullable {
        note_a_maybe_null("held", held, "", held.value_type)
        held = as_present(held)
    }
    var held_type = held.value_type
    return call_through_a_value(held, held_type, call)
}

func call_through_a_value(
    called_value: SpiteCompiler.Value,
    local_type: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value {
    var fitting = Fitting(context, this)
    var collections = Collections(context, this)
    refuse_a_value_call_of_another_count(local_type, call)
    var arguments = List<SpiteCompiler.Value>()
    var fixed_count = call.arguments.count()
    if local_type.is_variadic {
        fixed_count = local_type.parameters.count() - 1
    }
    var index = 0
    while index < fixed_count {
        var argument = call.arguments[index]
        var wanted = local_type.parameters[index]
        crash wanted
        var value = fitting.fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    if local_type.is_variadic {
        var listed_type = local_type.parameters.last()
        crash listed_type
        var gathered = collections.gathered_list(listed_type, call.arguments, fixed_count)
        arguments.append(gathered)
    }
    var made = HighIntermediaryRepresentation.Values.Function.ValueCall(called_value, arguments)
    if local_type.answer {
        made.value_type = local_type.answer
    }
    return made
}

func refuse_a_value_call_of_another_count(
    local_type: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var wanted_count = local_type.parameters.count()
    var given_count = call.arguments.count()
    var is_wrong = given_count != wanted_count
    if local_type.is_variadic {
        is_wrong = given_count < wanted_count - 1
    }
    fallback is_wrong
    var printer = Printers.Spite.ExpressionPrinter(call.callee)
    var shown = printer.text()
    typing.refuse_argument_count(context, shown, wanted_count, given_count)
}

func member_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value {
    var collections = Collections(context, this)
    var known = KnownCalls(context, this)
    var known_run = known.ran_by(call, callee)
    if known_run {
        return known_run
    }
    var walked = walked_attributes(call, callee)
    if walked {
        return walked
    }
    var known_walks = KnownWalks(context, this)
    var unrolled = known_walks.unrolled(call, callee)
    if unrolled {
        return unrolled
    }
    var listing_walk = walked_classes_or_values(call, callee)
    if listing_walk {
        return listing_walk
    }
    var walks_known = known_constants()
    var known_list_walk = walks_known.walked(call, callee)
    if known_list_walk {
        return known_list_walk
    }
    var declared_walks = DeclaredWalks(context, this)
    var declared_walk = declared_walks.unrolled(call, callee)
    if declared_walk {
        return declared_walk
    }
    var named_value = enum_value_by_name(call, callee)
    if named_value {
        return named_value
    }
    var question = reflection_question(call, callee)
    if question {
        return question
    }
    var counted = pattern_argument_count(call, callee)
    if counted {
        return counted
    }
    var fitting = vector_fit_question(call, callee)
    if fitting {
        return fitting
    }
    var any_fitting = any_attribute_fit_question(call, callee)
    if any_fitting {
        return any_fitting
    }
    var asked = bound_type_question(call, callee)
    if asked {
        return asked
    }
    var made_default = bound_class_made(call, callee)
    if made_default {
        return made_default
    }
    if callee.name == "count" and call.arguments.is_empty() {
        var folded_count = folded_function_count(callee.target)
        if folded_count {
            return folded_count
        }
    }
    if callee.name.starts_with("from_") {
        refuse_a_cast_by_name(callee)
    }
    if callee.name.starts_with("remove_where") {
        refuse_a_removal_from_a_chain(callee)
    }
    var class_receiver = reflected_receiver(callee.target)
    if class_receiver {
        refuse_a_call_on_a_number_class(callee, class_receiver)
        return called_on_a_class(class_receiver, callee.name, call.arguments)
    }
    var written_receiver = value_of(callee.target, null)
    if written_receiver.value_type.kind == 'handle' and callee.name == "finished_value" {
        return work_call(written_receiver, "finished_value")
    }
    var receiver = result_of_handle(written_receiver)
    var remakes_its_class = callee.name == "class" and call.arguments.is_empty()
    if remakes_its_class and not has_its_own_class(receiver) {
        var reflection = Reflection(context, this)
        var class_read = reflection.making.class_of_value(receiver)
        return made_from_a_held_class(class_read)
    }
    var answered_text = folded_text_question(receiver, callee.name, call.arguments)
    if answered_text {
        return answered_text
    }
    if receiver.value_type.kind == 'function' and callee.name == "call_function" {
        return value_call_of(receiver, call.arguments)
    }
    if receiver.value_type.kind == 'shape' {
        var typed = context.program.shape_keyed(receiver.value_type.name)
        crash typed
        refuse_an_operator_call_through_a_shape(callee, call, typed)
        refuse_a_private_member_of_a_type(receiver.value_type, callee.name)
        return shape_call(receiver, callee.name, call.arguments)
    }
    if receiver.value_type.kind == 'union' {
        var through = union_shape_of(receiver.value_type, callee.name)
        refuse_an_operator_call_through_a_shape(callee, call, through)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', receiver)
        refuse_a_private_member_of_a_type(shaped.value_type, callee.name)
        return shape_call(shaped, callee.name, call.arguments)
    }
    var is_an_enum = receiver.value_type.kind == 'enumeration' and not receiver.value_type.is_nullable
    if is_an_enum and callee.name == "to_string" and call.arguments.is_empty() {
        return enum_text(receiver)
    }
    if is_an_enum and callee.name == "to_debug" and call.arguments.is_empty() {
        var debugging = Debugging(context, this)
        return debugging.debug_text_of(receiver)
    }
    if is_an_enum and callee.name == "to_integer" and call.arguments.is_empty() {
        var integer = context.scalar_type("Integer")
        return HighIntermediaryRepresentation.Values.Conversion(integer, 'widen', receiver)
    }
    var read_enum = enum_read_from(receiver, callee.name, call.arguments)
    if read_enum {
        return read_enum
    }
    if receiver.value_type.is_nullable {
        note_a_maybe_null("call", receiver, callee.name, receiver.value_type)
        receiver = as_present(receiver)
    }
    var owner = present_class_of(receiver)
    var renewing = context.renews_the_lists and callee.name == "clear" and call.arguments.count() == 1
    if renewing {
        context.renews_the_lists = false
        var forms = HeldOnceForms(context, this)
        var renewer = forms.renew_lists_of(owner)
        return called(renewer, receiver, call.arguments)
    }
    refuse_a_private_name(owner, callee.name)
    refuse_a_written_attribute_call(callee, call)
    var found_value = enum_value_found(owner, callee, call.arguments)
    if found_value {
        return found_value
    }
    var passed = passed_form(receiver, owner, callee.name, call.arguments)
    if passed {
        return passed
    }
    var filtered_by_class = class_form_call(receiver, owner, callee.name, call.arguments)
    if filtered_by_class {
        return filtered_by_class
    }
    var function = owner.function_named(callee.name)
    var stands_for = context.current_function.bound_function
    var names_the_pattern = callee.name == context.current_function.bound_pattern and not stands_for.is_empty()
    if not function and names_the_pattern {
        function = owner.function_named(stands_for)
    }
    if function and callee.name == "deep_copy" and call.arguments.is_empty() {
        var sharing = Copying(context, this)
        var shared = sharing.shared_table_copy_of(owner)
        if shared {
            function = shared
        }
    }
    if not function {
        function = member_template_of(owner, callee.name)
    }
    if not function {
        var through_values = dictionary_template(receiver, owner, callee.name, call.arguments)
        if through_values {
            return through_values
        }
    }
    if not function and callee.name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var written_count = call.arguments.count()
    if not function {
        function = made_copy(owner, callee.name, written_count)
    }
    if not function and owner.key == "DynamicLibrary" {
        return collections.foreign_call(receiver, callee.name, call.arguments, call.answer_is_dropped)
    }
    if not function and callee.name.starts_with("from_") {
        refuse_a_cast_by_name(callee)
    }
    if not function {
        var walked_on = walk_on(owner, receiver, callee.name, call.arguments)
        if walked_on {
            return walked_on
        }
    }
    if not function {
        var read_as_an_enum = text_read_as_an_enum(receiver, owner, callee.name, written_count)
        if read_as_an_enum {
            return read_as_an_enum
        }
    }
    if not function {
        var numbered_enum = number_read_as_an_enum(receiver, owner, callee.name, written_count)
        if numbered_enum {
            return numbered_enum
        }
    }
    if not function and call.arguments.is_empty() {
        var made_of_a_class = made_from_a_member_class(receiver, owner, callee.name)
        if made_of_a_class {
            return made_of_a_class
        }
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, callee.name)
    }
    crash function
    var folded_keys = Folded.Keys(context, this)
    folded_keys.check_a_changing_call(receiver, callee.name)
    refuse_a_comparison_of_objects(receiver, owner, callee.name)
    refuse_a_drop_by_name(owner, function)
    var dropping = DroppingWalks(context)
    dropping.check_a_walk(call, owner, function)
    refuse_an_operator_call(callee, call, function, receiver)
    var specialised = specialised_for_a_constant(function, receiver, call.arguments)
    if specialised {
        return specialised
    }
    refuse_an_accessor_call(callee, call, function)
    var made = called(function, receiver, call.arguments)
    refuse_a_wider_bitwise_operand(callee, call, made)
    var width_reads = WidthReads(context)
    return width_reads.proven(made, owner, call, callee)
}

func refuse_a_drop_by_name(owner: Model.ClassModel, function: Model.FunctionModel) {
    fallback function.name == "drop" and function.parameters.is_empty() and not function.answer
    var shown = plain_name_of(owner.shown)
    typing.refuse_a_drop_by_name(context, shown)
}

func refuse_a_comparison_of_objects(receiver: SpiteCompiler.Value, owner: Model.ClassModel, name: String) {
    fallback name == "contains" or name == "index_of"
    var shown = context.shown(receiver.value_type)
    fallback shown.starts_with("List<")
    var element_type = owner.bound_types["$element_type"]
    crash element_type
    var is_an_object = element_type.kind == 'object' and element_type.name != "String"
    fallback is_an_object or element_type.kind == 'union'
    var element_shown = context.shown(element_type)
    var element_name = plain_name_of(element_shown)
    typing.refuse_a_comparison_of_objects(context, name, element_name)
}

func plain_name_of(shown: String): String {
    if shown.contains("<") {
        return shown
    }
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

func refuse_an_accessor_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
) {
    var is_a_setter = callee.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = callee.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration
    var length = callee.name.length()
    var attribute_name = callee.name.slice(4, length)
    crash attribute_name
    fallback function.parameters.count() == call.arguments.count()
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{attribute_name}"
    if attribute_name == "this" {
        written = receiver_text
    }
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(context, callee.name, "writing", attribute_name, "{written} = {assigned_text}")
    }
    typing.refuse_an_accessor_call(context, callee.name, "reading", attribute_name, written)
}

func refuse_a_private_name(owner: Model.ClassModel, name: String) {
    fallback name.starts_with("_")
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    fallback not context.resolver.state.symbols.generated_texts[path]
    fallback owner.file.path != context.current_class.file.path
    var length = name.length()
    var public_name = name.slice(1, length)
    crash public_name
    var reader = ""
    var is_read_outside = owner.function_named("get_{public_name}") or owner.function_named(public_name)
    if is_read_outside and owner.attribute_named(name) {
        reader = public_name
    }
    typing.refuse_a_private_name(context, name, owner.shown, reader)
}

func refuse_a_private_member_of_a_type(shape_type: Model.Type, name: String) {
    fallback name.starts_with("_")
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    fallback not context.resolver.state.symbols.generated_texts[path]
    var segments = shape_type.name.split(".")
    var shown = segments.last()
    crash shown
    typing.refuse_a_private_name(context, name, shown, "")
}

func refuse_a_written_attribute_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var is_a_read = callee.name == "get_attribute" and call.arguments.count() == 1
    var is_a_write = callee.name == "set_attribute" and call.arguments.count() == 2
    fallback is_a_read or is_a_write
    var named = call.arguments[0]
    if named.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        refuse_a_named_attribute_call(callee, call, named)
    }
}

func refuse_a_named_attribute_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    named: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
) {
    fallback named.kind == 'symbol_literal'
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{named.text}"
    if callee.name == "set_attribute" {
        var assigned = call.arguments[1]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(context, callee.name, "writing", named.text, "{written} = {assigned_text}")
    }
    typing.refuse_an_accessor_call(context, callee.name, "reading", named.text, written)
}

func refuse_an_operator_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
    receiver: SpiteCompiler.Value,
) {
    var receiver_kind = receiver.value_type.kind
    fallback receiver_kind == 'object' or receiver_kind == 'scalar'
    var owner = present_class_of(receiver)
    var is_its_own = owner.key == context.current_class.key and context.current_function.name == callee.name
    fallback not is_its_own
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    refuse_an_operator_by_name(call, callee.name, function, receiver_text, receiver_kind == 'scalar')
}

func refuse_an_operator_call_through_a_shape(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    shape: Model.ShapeModel,
) {
    var member = shape.member_named(callee.name)
    fallback member and context.current_function.name != callee.name
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    refuse_an_operator_by_name(call, callee.name, member, receiver_text, false)
}

func refuse_a_bare_operator_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
) {
    var indexes = function.name == "get_at" or function.name == "set_at"
    fallback context.current_function.name != function.name and not indexes
    var is_a_number = scalars.is_a_scalar(context.current_class.key)
    refuse_an_operator_by_name(call, function.name, function, "this", is_a_number)
}

func refuse_a_bare_accessor_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
) {
    var is_a_setter = function.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = function.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration and context.current_function.name != function.name
    var path = context.path()
    var library = Mapping.LibraryFile()
    fallback not context.resolver.state.symbols.generated_texts[path] and not library.holds(path)
    var length = function.name.length()
    var attribute_name = function.name.slice(4, length)
    crash attribute_name
    fallback attribute_name != "this"
    fallback not context.current_class.attribute_named(attribute_name)
    var local = context.scope.internal_name_of(attribute_name)
    fallback not local
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(
            context,
            function.name,
            "writing",
            attribute_name,
            "{attribute_name} = {assigned_text}",
        )
    }
    typing.refuse_an_accessor_call(context, function.name, "reading", attribute_name, attribute_name)
}

func refuse_an_operator_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
    function: Model.FunctionModel,
    receiver_text: String,
    is_on_a_number: Boolean,
) {
    var path = context.path()
    fallback not context.resolver.state.symbols.generated_texts[path]
    var written_count = call.arguments.count()
    fallback function.name == name and function.parameters.count() == written_count
    var operator = operator_written(name, written_count)
    fallback not operator.is_empty()
    var first_parameter = function.parameters.first()
    if first_parameter {
        var parameter_kind = first_parameter.parameter_type.kind
        fallback parameter_kind != 'function'
        fallback name != "equals" or parameter_kind == 'object' or is_on_a_number
    }
    var written_arguments = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var argument_printer = Printers.Spite.ExpressionPrinter(argument)
        var argument_text = argument_printer.text()
        written_arguments.append(argument_text)
        index = index + 1
    }
    typing.refuse_an_operator_call(context, name, operator, receiver_text, written_arguments)
}

func operator_written(name: String, written_count: Integer): String {
    var binary = ["sum", "subtract", "multiply", "divide", "remainder", "equals", "less_than", "greater_than"]
    var operators = ["+", "-", "*", "/", "%", "==", "<", ">"]
    var position = binary.index_of(name)
    if position and written_count == 1 {
        var found = operators[position]
        crash found
        return found
    }
    var is_a_negation = name == "negate" and written_count == 0
    if is_a_negation {
        return "-"
    }
    var is_a_read = name == "get_at" and written_count == 1
    if is_a_read {
        return "[]"
    }
    var is_a_write = name == "set_at" and written_count == 2
    if is_a_write {
        return "[] ="
    }
    return ""
}

func refuse_a_removal_from_a_chain(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var chain = callee.target
    if chain.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        refuse_a_removal_from_a_step(callee, chain)
    }
}

func refuse_a_removal_from_a_step(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    chain: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var step = chain.callee
    if step.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var copies = ["copy", "deep_copy", "keys", "values", "reversed"]
        var name = step.name
        var makes_a_new_one = name.starts_with("filter") or name.starts_with("map") or name.starts_with("sort")
        fallback makes_a_new_one or copies.contains(name)
        var printer = Printers.Spite.ExpressionPrinter(chain)
        var shown = printer.text()
        typing.refuse_a_removal_from_a_chain(context, callee.name, shown)
    }
}

func refuse_a_wider_bitwise_operand(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: SpiteCompiler.Value,
) {
    var bitwise = ["bits_and", "bits_or", "bits_exclusive_or"]
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback bitwise.contains(callee.name) and call.arguments.count() == 1 and not library.holds(path)
    if made.class == HighIntermediaryRepresentation.Values.Call {
        refuse_a_wider_bitwise_call(callee, call, made)
    }
}

func refuse_a_wider_bitwise_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: HighIntermediaryRepresentation.Values.Call,
) {
    var operand = made.arguments[0]
    fallback made.receiver and operand
    fallback made.receiver.value_type.kind == 'scalar'
    if operand.class == HighIntermediaryRepresentation.Values.Conversion {
        refuse_a_cut_bitwise_operand(callee, call, made.receiver, operand)
    }
}

func refuse_a_cut_bitwise_operand(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    receiver: SpiteCompiler.Value,
    operand: HighIntermediaryRepresentation.Values.Conversion,
) {
    var cuts = operand.kind == 'narrow' or operand.kind == 'narrow_decimal' or operand.kind == 'to_whole'
    var written = call.arguments[0]
    fallback cuts and operand.converted and callee.target and written
    var receiver_scalar = scalars.of(receiver.value_type.name)
    var given_scalar = scalars.of(operand.converted.value_type.name)
    fallback receiver_scalar and given_scalar
    fallback given_scalar.size > receiver_scalar.size or given_scalar.is_decimal
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    var shown = call_printer.text()
    var receiver_printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = receiver_printer.text()
    var operand_printer = Printers.Spite.ExpressionPrinter(written)
    var operand_text = operand_printer.text()
    var receiver_name = receiver.value_type.name
    var given_name = operand.converted.value_type.name
    typing.refuse_a_wider_bitwise_operand(context, shown, receiver_text, receiver_name, operand_text, given_name)
}

func specialised_for_a_constant(
    function: Model.FunctionModel,
    receiver: SpiteCompiler.Value,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    fallback function.declaration and function.template_index < 0 and function.bound_member.is_empty()
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var place = -1
    var index = 0
    while index < declaration.parameters.count() and index < written.count() {
        var parameter = declaration.parameters[index]
        var argument = written[index]
        if takes_an_attribute(parameter) and not constant_attribute_name(argument).is_empty() {
            place = index
        }
        index = index + 1
    }
    fallback place >= 0
    var picked = written[place]
    var attribute_name = constant_attribute_name(picked)
    var described = constant_attribute_owner(picked)
    var described_model = context.program.class_named(described)
    crash described_model
    var attribute = described_model.attribute_named(attribute_name)
    crash attribute
    var owner = context.program.class_named(function.owner)
    crash owner
    var specialised_name = "{function.name}_for_{attribute_name}"
    var made = owner.function_named(specialised_name)
    if not made {
        made = specialised_for_an_attribute(function, owner, place, specialised_name, described_model, attribute)
    }
    crash made
    var passed = List<SpiteCompiler.Expression>()
    var passed_index = 0
    while passed_index < written.count() {
        var argument = written[passed_index]
        if passed_index != place {
            passed.append(argument)
        }
        passed_index = passed_index + 1
    }
    return called(made, receiver, passed)
}

func specialised_for_an_attribute(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    place: Integer,
    specialised_name: String,
    described_model: Model.ClassModel,
    attribute: Model.AttributeModel,
): Model.FunctionModel {
    var template = Model.FunctionModel(function.name, function.owner)
    template.declaration = function.declaration
    template.template_index = place
    var made = context.resolver.reading.specialized(
        template,
        specialised_name,
        attribute.name,
        attribute.attribute_type,
        false,
        owner,
    )
    made.bound_member_index = attribute_place_of(described_model, attribute.name)
    owner.declared_functions.append(made)
    return made
}

func attribute_place_of(model: Model.ClassModel, name: String): Integer {
    var index = 0
    var found_place = -1
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.name == name {
            found_place = index
        }
        index = index + 1
    }
    crash found_place >= 0
    return found_place
}

func takes_an_attribute(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter): Boolean {
    var written = parameter.declared_type
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        return path == "Spite.AttributeDeclaration" and written.arguments.is_empty()
    }
    return false
}

func constant_attribute_name(written: SpiteCompiler.Expression?): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return constant_index_name(written)
    }
    return ""
}

func constant_index_name(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var listed = index.target
    var named = index.index
    var lists_attributes = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        lists_attributes = listed.name == "attributes" and not constant_attribute_owner_of(listed.target).is_empty()
    }
    fallback lists_attributes
    var key = key_name_of(named)
    if key {
        return key
    }
    return ""
}

func constant_attribute_owner(written: SpiteCompiler.Expression?): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return constant_listed_owner(written.target)
    }
    return ""
}

func constant_listed_owner(listed: SpiteCompiler.Expression?): String {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return constant_attribute_owner_of(listed.target)
    }
    return ""
}

func constant_attribute_owner_of(target: SpiteCompiler.Expression?): String {
    var path = class_path_of(target)
    fallback not path.is_empty()
    var described = constant_class_of(target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    return model.key
}

func text_read_as_an_enum(
    _receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
    written_count: Integer,
): SpiteCompiler.Value? {
    fallback owner.key == "String" and name.starts_with("to_") and written_count == 0
    var name_length = name.length()
    var snake = name.slice(3, name_length)
    crash snake
    var found = enum_named_by_its_path(snake)
    fallback found
    refuse_a_written_conversion(found)
    return null
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func number_read_as_an_enum(
    _receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
    written_count: Integer,
): SpiteCompiler.Value? {
    var whole = ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
    fallback whole.contains(owner.key) and name.starts_with("to_") and written_count == 0
    var name_length = name.length()
    var snake = name.slice(3, name_length)
    crash snake
    var found = enum_named_by_its_path(snake)
    fallback found
    refuse_a_written_conversion(found)
    return null
}

func enum_value_found(
    owner: Model.ClassModel,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    fallback callee.name == "find_by_name" and written.count() == 1
    var listed = callee.target
    var lists_every_value = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var path = class_path_of(listed.target)
        lists_every_value = listed.name == "values" and not path.is_empty()
    }
    fallback lists_every_value
    var element = owner.bound_types["$element_type"]
    fallback element
    fallback element.kind == 'enumeration' and not element.is_nullable
    var asked = written[0]
    var symbol: String? = null
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        symbol = literals.symbol_literal_text(asked)
    }
    fallback symbol
    var maybe = element.nullable()
    var enumeration = enum_model_of(element)
    if not enumeration.values.contains(symbol) {
        return HighIntermediaryRepresentation.Values.NullConstant(maybe)
    }
    var found = literals.enum_value(symbol, element)
    return HighIntermediaryRepresentation.Values.Conversion(maybe, 'nullable', found)
}

func folded_text_question(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var asks = name == "starts_with" or name == "ends_with"
    fallback asks and written.count() == 1
    var known = known_text_of(receiver)
    fallback known
    var argument = written[0]
    var piece: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        piece = plain_text_of(argument)
    }
    fallback piece
    var holds = known.ends_with(piece)
    if name == "starts_with" {
        holds = known.starts_with(piece)
    }
    return boolean_constant(holds)
}

func known_text_of(value: SpiteCompiler.Value): String? {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return context.text_locals[value.name]
    }
    return null
}

func member_template_of(owner: Model.ClassModel, name: String): Model.FunctionModel? {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        if template.is_a_member_template {
            var made = specialized_for(owner, template, name)
            if made {
                return made
            }
        }
        index = index + 1
    }
    return null
}

func dictionary_template(
    receiver: SpiteCompiler.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    fallback owner.bound_types["$value_type"]
    var values_function = owner.function_named("values")
    fallback values_function
    var no_written = List<SpiteCompiler.Expression>()
    var listed = called(values_function, receiver, no_written)
    var list_model = present_class_of(listed)
    var template = member_template_of(list_model, name)
    fallback template
    return called(template, listed, written)
}

func specialized_for(owner: Model.ClassModel, template: Model.FunctionModel, name: String): Model.FunctionModel? {
    var match = template_match(template, name)
    fallback match
    var member_owner = owner_of_a_template(template, owner, name)
    fallback member_owner
    var written_owner: Model.Type = member_owner
    var owner_type = bound_parameters(template, written_owner)
    var is_rebound = owner_type.name != written_owner.name
    var known_name = name
    if is_rebound and owner_type.kind == 'parameters' {
        known_name = "{name}_in_{context.current_function.bound_function}"
    }
    var known = owner.function_named(known_name)
    if known and is_rebound {
        return known
    }
    var made = specialized_by_kind(owner, template, owner_type, name, match)
    if made and is_rebound and owner_type.kind == 'parameters' {
        made.name = known_name
        made.bound_pattern = context.current_function.bound_pattern
        made.bound_function = context.current_function.bound_function
    }
    return made
}

func bound_parameters(template: Model.FunctionModel, owner_type: Model.Type): Model.Type {
    if owner_type.kind != 'parameters' {
        return owner_type
    }
    var parts = owner_type.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var words = function_part.split("_")
    if words.contains(word) {
        return Model.Type('pattern', owner_type.name)
    }
    var function = context.current_function
    var is_bound = function.bound_pattern == function_part and not function.bound_function.is_empty()
    if is_bound {
        return Model.Type('parameters', "{class_key}|{function.bound_function}")
    }
    return owner_type
}

func replaced_word(text: String, word: String, replacement: String): String {
    var words = text.split("_")
    var renamed = List<String>()
    var index = 0
    while index < words.count() {
        var each_word = words[index]
        if each_word == word {
            renamed.append(replacement)
        } else {
            renamed.append(each_word)
        }
        index = index + 1
    }
    return renamed.join("_")
}

func pattern_names(template: Model.FunctionModel, pattern: Model.Type): List<String> {
    var names = List<String>()
    var parts = pattern.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var walked_class = context.program.class_named(class_key)
    crash walked_class
    var index = 0
    while index < walked_class.declared_functions.count() {
        var function = walked_class.declared_functions[index]
        var hole = hole_of(function, function_part, word)
        if not hole.is_empty() and not names.contains(hole) {
            names.append(hole)
        }
        index = index + 1
    }
    return names
}

func hole_of(function: Model.FunctionModel, function_part: String, word: String): String {
    var is_written = function.declaration and function.bound_member.is_empty() and not function.is_a_member_template
    fallback is_written and not function.is_synthetic and not function.is_a_walk_copy
    return hole_in(function.name, function_part, word)
}

func hole_in(name: String, function_part: String, word: String): String {
    var words = function_part.split("_")
    var place = words.index_of(word)
    fallback place
    var before = List<String>()
    var after = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var each_word = words[word_index]
        if word_index < place {
            before.append(each_word)
        }
        if word_index > place {
            after.append(each_word)
        }
        word_index = word_index + 1
    }
    var prefix = before.join("_")
    if not prefix.is_empty() {
        prefix = "{prefix}_"
    }
    var suffix = after.join("_")
    if not suffix.is_empty() {
        suffix = "_{suffix}"
    }
    var fixed_length = prefix.length() + suffix.length()
    var fits = name.starts_with(prefix) and name.ends_with(suffix) and name.length() > fixed_length
    fallback fits
    var prefix_length = prefix.length()
    var middle_end = name.length() - suffix.length()
    var sliced = name.slice(prefix_length, middle_end)
    crash sliced
    return sliced
}

func specialized_over_a_pattern(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    pattern: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var match_parts = match.split("|")
    var written = match_parts[0]
    crash written
    var parts = pattern.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var holes = pattern_names(template, pattern)
    var place = holes.index_of(written)
    var bound_function = replaced_word(function_part, word, written)
    var walked_class = context.program.class_named(class_key)
    crash walked_class
    fallback place or not walks_by_the_name(template, name)
    var fitting = fitting_names(word, function_part, holes)
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_a_matched_hole(
        place,
        fitting,
        function_part,
        context.current_class.file.path,
        context.line,
        context.current_class.shown,
        context.current_function.name,
        name,
        template.name,
        written,
        word,
        walked_class.shown,
        bound_function,
    )
    crash place
    var symbol = context.resolver.types.walked_name_type()
    var made = context.resolver.reading.specialized(template, name, written, symbol, false, owner)
    made.bound_member_index = place
    made.bound_pattern = function_part
    made.bound_function = bound_function
    made.bound_class = class_key
    made.binds_a_function_declaration = true
    owner.declared_functions.append(made)
    return made
}

func fitting_names(word: String, function_part: String, holes: List<String>): List<String> {
    var fitting = List<String>()
    var index = 0
    while index < holes.count() {
        var hole = holes[index]
        var fitted_name = replaced_word(function_part, word, hole)
        fitting.append("'{fitted_name}'")
        index = index + 1
    }
    return fitting
}

func specialized_over_a_handle(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    name: String,
    match: String,
): Model.FunctionModel? {
    var asks_if_finished = match == "finished" or match == "is_finished"
    fallback asks_if_finished
    var boolean = context.boolean()
    var made = context.resolver.reading.specialized(template, name, "finished", boolean, false, owner)
    owner.declared_functions.append(made)
    return made
}

func specialized_by_kind(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    switch owner_type.kind {
        'pattern': return specialized_over_a_pattern(owner, template, owner_type, name, match)
        'handle': return specialized_over_a_handle(owner, template, name, match)
        'shape': return specialized_over_a_shape(owner, template, owner_type, name, match)
        'namespace': return specialized_over_a_namespace(owner, template, name, match)
        'parameters': return specialized_over_parameters(owner, template, owner_type, name, match)
        'union': return specialized_over_a_union(owner, template, owner_type, name, match)
        'enumeration': return specialized_over_values(owner, template, owner_type, name, match)
        'nothing': return specialized_over_a_class(owner, template, owner_type, name, match)
        'scalar': return specialized_over_a_class(owner, template, owner_type, name, match)
        'object': return specialized_over_a_class(owner, template, owner_type, name, match)
        'function': return specialized_over_a_class(owner, template, owner_type, name, match)
    }
}

func specialized_over_a_class(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var reads = Reads(context, this)
    fallback context.has_a_class(owner_type) and not owner_type.is_nullable
    var element_class = context.class_of(owner_type)
    var match_parts = match.split("|")
    var written = match_parts[0]
    crash written
    var is_plural = match_parts.count() > 1
    if is_plural {
        refuse_a_test_to_collect(template, element_class, name, written)
        refuse_a_singular(element_class, name, written)
    }
    var member = reads.member_of(element_class, written, is_plural)
    if member.is_empty() {
        member = reads.member_of(element_class, "is_{written}", is_plural)
    }
    if member.is_empty() and not is_plural {
        var chained = specialized_through_a_function(owner, template, element_class, name, written)
        if chained {
            return chained
        }
    }
    if member.is_empty() and asks_a_question(template) {
        return specialized_over_an_enum_value(owner, template, element_class, name, written)
    }
    if member.is_empty() and owner.bound_types["$element_type"] {
        refuse_a_caller_function(element_class, name, written)
    }
    fallback not member.is_empty()
    if asks_a_question(template) and owner.bound_types["$element_type"] {
        refuse_a_member_and_a_value(element_class, name, member)
    }
    var attribute = element_class.attribute_named(member)
    var member_type = context.boolean()
    var is_a_function = true
    var member_index = 0
    if attribute {
        member_type = attribute.attribute_type
        is_a_function = false
        member_index = attribute_index_of(element_class, member)
    } else {
        var function = element_class.function_named(member)
        crash function
        member_type = answer_or_nothing(function)
    }
    var library = Mapping.LibraryFile()
    if library.holds(owner.file.path) or owner.bound_types["$element_type"] {
        var member_shown = context.shown(member_type)
        typing.check_member_fit(context, name, member, element_class.shown, member_shown, is_a_function)
    }
    var made = context.resolver.reading.specialized(template, name, member, member_type, is_a_function, owner)
    made.bound_member_index = member_index
    owner.declared_functions.append(made)
    return made
}

func refuse_a_test_to_collect(
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
) {
    fallback template.name.starts_with("map_")
    var singular = member_named(element_class, written)
    fallback not singular.is_empty()
    var member_type = member_type_named(element_class, singular)
    fallback context.is_boolean(member_type)
    typing.refuse_a_test_to_collect(context, name, written, element_class.shown)
}

func refuse_a_caller_function(element_class: Model.ClassModel, name: String, written: String) {
    var function = context.current_class.function_named(written)
    fallback function
    fallback function.parameters.count() == 1
    typing.refuse_a_caller_function(context, element_class.shown, written, name)
}

func refuse_a_member_and_a_value(element_class: Model.ClassModel, name: String, member: String) {
    var candidates = enum_members_of(element_class)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(element_class, candidate)
        var enumeration = enum_model_of(enum_type)
        if enumeration.values.contains(member) {
            typing.refuse_a_member_and_a_value(context, name, member, element_class.shown, candidate)
        }
        index = index + 1
    }
}

func member_type_named(element_class: Model.ClassModel, member: String): Model.Type {
    var attribute = element_class.attribute_named(member)
    if attribute {
        return attribute.attribute_type
    }
    var function = element_class.function_named(member)
    crash function
    return answer_or_nothing(function)
}

func asks_a_question(template: Model.FunctionModel): Boolean {
    var asking = List<String>()
    asking.append("filter_")
    asking.append("count_")
    asking.append("any_")
    asking.append("all_")
    asking.append("remove_where_")
    var index = 0
    while index < asking.count() {
        var prefix = asking[index]
        if template.name.starts_with(prefix) {
            return true
        }
        index = index + 1
    }
    return false
}

func enum_members_of(element_class: Model.ClassModel): List<String> {
    var names = List<String>()
    var index = 0
    while index < element_class.declared_attributes.count() {
        var attribute = element_class.declared_attributes[index]
        var held = attribute.attribute_type
        if held.kind == 'enumeration' and not held.is_nullable {
            names.append(attribute.name)
        }
        index = index + 1
    }
    var function_index = 0
    while function_index < element_class.declared_functions.count() {
        var function = element_class.declared_functions[function_index]
        var answer = answer_or_nothing(function)
        var answers_an_enum = answer.kind == 'enumeration' and not answer.is_nullable
        var is_plain = function.parameters.is_empty() and not function.is_a_member_template
        if answers_an_enum and is_plain {
            names.append(function.name)
        }
        function_index = function_index + 1
    }
    return names
}

func enum_type_of_member(element_class: Model.ClassModel, member: String): Model.Type {
    var attribute = element_class.attribute_named(member)
    if attribute {
        return attribute.attribute_type
    }
    var function = element_class.function_named(member)
    crash function
    return answer_or_nothing(function)
}

func specialized_over_an_enum_value(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
): Model.FunctionModel? {
    var candidates = enum_members_of(element_class)
    var chosen = ""
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(element_class, candidate)
        var enumeration = enum_model_of(enum_type)
        if enumeration.values.contains(written) {
            if not chosen.is_empty() {
                typing.refuse_two_enum_members(context, name, chosen, candidate, written, element_class.shown)
            }
            chosen = candidate
        }
        index = index + 1
    }
    if chosen.is_empty() and owner.bound_types["$element_type"] {
        typing.refuse_no_member_for_a_template(context, element_class.shown, written, name)
    }
    fallback not chosen.is_empty()
    var chosen_type = enum_type_of_member(element_class, chosen)
    var is_a_function = not element_class.attribute_named(chosen)
    var boolean = context.boolean()
    var made = context.resolver.reading.specialized(template, name, chosen, boolean, is_a_function, owner)
    made.bound_member_index = member_index_of(element_class, chosen)
    compare_with_the_value(made, chosen_type, written)
    owner.declared_functions.append(made)
    return made
}

func compare_with_the_value(made: Model.FunctionModel, enum_type: Model.Type, written: String) {
    var enumeration = enum_model_of(enum_type)
    var place = enumeration.values.index_of(written)
    crash place
    var number = enumeration.numbers[place]
    crash number
    made.compared_value = enum_type
    made.compared_number = number
}

func specialized_over_a_shape(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var shape = context.program.shape_keyed(owner_type.name)
    crash shape
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var member = shape.member_named(candidate)
        if member {
            var member_type = answer_or_nothing(member)
            var made = context.resolver.reading.specialized(template, name, candidate, member_type, false, owner)
            made.bound_shape = shape.key
            made.bound_member_index = shape_member_index(shape, candidate)
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func shape_member_index(shape: Model.ShapeModel, name: String): Integer {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.name == name {
            return index
        }
        index = index + 1
    }
    return 0
}

func specialized_over_a_union(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var answered = union_member_name(owner_type, candidate)
        if not answered.is_empty() {
            var shape = union_shape_of(owner_type, answered)
            var member = shape.members[0]
            crash member
            var member_type = answer_or_nothing(member)
            var made = context.resolver.reading.specialized(template, name, answered, member_type, false, owner)
            made.bound_shape = shape.key
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    fallback not is_plural
    var chained = union_through_a_function(owner, template, owner_type, name, written)
    if chained {
        return chained
    }
    fallback asks_a_question(template)
    return union_enum_value(owner, template, owner_type, name, written)
}

func split_words(written: String, start: Integer, end: Integer): String {
    var words = written.split("_")
    var kept = List<String>()
    var index = start
    while index < end {
        var word = words[index]
        crash word
        kept.append(word)
        index = index + 1
    }
    return kept.join("_")
}

func specialized_through_a_function(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
): Model.FunctionModel? {
    var word_count = written.split("_").count()
    var split = 1
    while split < word_count {
        var member_name = split_words(written, 0, split)
        var function_name = split_words(written, split, word_count)
        var member = member_named(element_class, member_name)
        if not member.is_empty() {
            var member_type = enum_type_of_member(element_class, member)
            var chained = chained_specialization(owner, template, member_type, member, function_name, name)
            if chained {
                chained.bound_member_is_a_function = not element_class.attribute_named(member)
                chained.bound_member_index = member_index_of(element_class, member)
                return chained
            }
        }
        split = split + 1
    }
    return null
}

func union_through_a_function(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    written: String,
): Model.FunctionModel? {
    var word_count = written.split("_").count()
    var split = 1
    while split < word_count {
        var member_name = split_words(written, 0, split)
        var function_name = split_words(written, split, word_count)
        var answered = union_member_name(owner_type, member_name)
        if not answered.is_empty() {
            var shape = union_shape_of(owner_type, answered)
            var member = shape.members[0]
            crash member
            var member_type = answer_or_nothing(member)
            var chained = chained_specialization(owner, template, member_type, answered, function_name, name)
            if chained {
                chained.bound_shape = shape.key
                return chained
            }
        }
        split = split + 1
    }
    return null
}

func chained_specialization(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    member_type: Model.Type,
    member: String,
    function_name: String,
    name: String,
): Model.FunctionModel? {
    fallback context.has_a_class(member_type) and not member_type.is_nullable
    var through_class = context.class_of(member_type)
    var function = through_class.function_named(function_name)
    fallback function
    var answer = answer_or_nothing(function)
    var made = context.resolver.reading.specialized(template, name, member, answer, false, owner)
    made.chained_function = function_name
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var chained = Model.ParameterModel("_chained_{parameter.name}", parameter.parameter_type, false)
        made.parameters.append(chained)
        index = index + 1
    }
    owner.declared_functions.append(made)
    return made
}

func union_enum_value(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    written: String,
): Model.FunctionModel? {
    var fitting = Fitting(context, this)
    var united = fitting.union_model_of(owner_type)
    var first_member = united.members[0]
    fallback first_member
    fallback context.has_a_class(first_member)
    var first_class = context.class_of(first_member)
    var candidates = enum_members_of(first_class)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(first_class, candidate)
        var enumeration = enum_model_of(enum_type)
        var read_name = candidate
        if read_name.starts_with("get_") {
            var length = read_name.length()
            var sliced_read_name = read_name.slice(4, length)
            crash sliced_read_name
            read_name = sliced_read_name
        }
        var answered = union_member_name(owner_type, read_name)
        var fits = enumeration.values.contains(written) and not answered.is_empty()
        if fits {
            var shape = union_shape_of(owner_type, answered)
            var boolean = context.boolean()
            var made = context.resolver.reading.specialized(template, name, answered, boolean, false, owner)
            made.bound_shape = shape.key
            compare_with_the_value(made, enum_type, written)
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func union_member_name(union_type: Model.Type, wanted: String): String {
    var fitting = Fitting(context, this)
    var united = fitting.union_model_of(union_type)
    if every_member_has(united, wanted) {
        return wanted
    }
    var getter = "get_{wanted}"
    if every_member_has(united, getter) {
        return getter
    }
    return ""
}

func every_member_has(united: Model.UnionModel, wanted: String): Boolean {
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fallback context.has_a_class(held)
        var model = context.class_of(held)
        var has_it = model.attribute_named(wanted) or model.function_named(wanted)
        var getter_name = "get_{wanted}"
        has_it = has_it or model.function_named(getter_name)
        fallback has_it
        index = index + 1
    }
    return true
}

func singular_candidates(written: String, is_plural: Boolean): List<String> {
    var candidates = List<String>()
    if not is_plural {
        candidates.append(written)
        return candidates
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        crash stem
        candidates.append("{stem}y")
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        crash without_s
        candidates.append(without_s)
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        crash without_es
        candidates.append(without_es)
    }
    candidates.append(written)
    return candidates
}

func specialized_over_a_namespace(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var model = context.resolver.monomorphiser.class_model_named(written)
    fallback model
    var member_type = Model.Type('object', model.key)
    var made = context.resolver.reading.specialized(template, name, model.shown, member_type, false, owner)
    owner.declared_functions.append(made)
    return made
}

func specialized_over_values(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var enumeration = enum_model_of(owner_type)
    var index = enumeration.values.index_of(written)
    fallback index
    var made = context.resolver.reading.specialized(template, name, written, owner_type, false, owner)
    made.bound_member_index = index
    owner.declared_functions.append(made)
    return made
}

func specialized_over_parameters(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var walked = context.resolver.owners.function_of_parameters(owner_type)
    fallback walked
    var index = 0
    while index < walked.parameters.count() {
        var parameter = walked.parameters[index]
        if parameter.name == written {
            var made = context.resolver.reading.specialized(
                template,
                name,
                written,
                parameter.parameter_type,
                false,
                owner,
            )
            made.bound_member_index = index
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func template_match(template: Model.FunctionModel, name: String): String? {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    var place = words.index_of(parameter.name)
    var is_plural = false
    if not place {
        place = words.index_of("{parameter.name}s")
        is_plural = true
    }
    crash place
    var before = List<String>()
    var after = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word_index < place {
            before.append(word)
        }
        if word_index > place {
            after.append(word)
        }
        word_index = word_index + 1
    }
    var prefix = before.join("_")
    if not prefix.is_empty() {
        prefix = "{prefix}_"
    }
    var suffix = after.join("_")
    if not suffix.is_empty() {
        suffix = "_{suffix}"
    }
    var fits = name.starts_with(prefix) and name.ends_with(suffix)
    var fixed_length = prefix.length() + suffix.length()
    fallback fits and name.length() > fixed_length
    var prefix_length = prefix.length()
    var middle_end = name.length() - suffix.length()
    var written = name.slice(prefix_length, middle_end)
    crash written
    if is_plural {
        return "{written}|plural"
    }
    return written
}

func walk_of(owner: Model.ClassModel, name: String, written: List<SpiteCompiler.Expression>): SpiteCompiler.Value? {
    var literals = Literals(context, this)
    var own = literals.this_value()
    return walk_on(owner, own, name, written)
}

func walk_on(
    owner: Model.ClassModel,
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var operators = Operators(context, this)
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and walks_by_the_name(template, name) {
            var held = receiver
            var is_its_own = receiver.class == HighIntermediaryRepresentation.Values.ThisRead
            if not is_its_own {
                held = operators.held_once(receiver)
            }
            return walked_over(owner, held, template, written)
        }
        index = index + 1
    }
    return null
}

func walks_by_the_name(template: Model.FunctionModel, name: String): Boolean {
    if "{template.name}s" == name {
        return true
    }
    var word = walked_word(template)
    var plurals = List<String>()
    plurals.append("{word}s")
    plurals.append("{word}es")
    if word.ends_with("y") {
        var length = word.length()
        var stem = word.slice(0, length - 1)
        crash stem
        plurals.append("{stem}ies")
    }
    var index = 0
    while index < plurals.count() {
        var plural = plurals[index]
        var walked_name = replaced_word(template.name, word, plural)
        if walked_name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func template_takes_a_plural(template: Model.FunctionModel): Boolean {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    return not words.contains(parameter.name)
}

func walked_over(
    owner: Model.ClassModel,
    receiver: SpiteCompiler.Value,
    template: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value {
    var plural_name = "{template.name}s"
    var written_owner = owner_of_a_template(template, owner, plural_name)
    crash written_owner
    var member_owner = bound_parameters(template, written_owner)
    var names = walked_names(member_owner)
    if member_owner.kind == 'pattern' {
        names = pattern_names(template, member_owner)
    }
    if not template.narrowed_names.is_empty() {
        names = template.narrowed_names
    }
    var index = 0
    while index < names.count() {
        var member = names[index]
        var word = walked_word(template)
        var called_name = replaced_word(template.name, word, member)
        var clash = Validators.HighIntermediaryRepresentation.TemplateClash.Validator()
        clash.check(context, owner, template.name, called_name, member, member_owner)
        var function = member_template_of(owner, called_name)
        crash function
        var made = called(function, receiver, written)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(made)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walked_word(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return parameter.name
}

func walked_names(member_owner: Model.Type): List<String> {
    var names = List<String>()
    if member_owner.kind == 'namespace' {
        return classes_of_a_namespace(member_owner.name)
    }
    if member_owner.kind == 'parameters' {
        return parameters_of(member_owner)
    }
    if member_owner.kind == 'enumeration' {
        var enumeration = enum_model_of(member_owner)
        return enumeration.values
    }
    var is_walked = member_owner.kind == 'object' or member_owner.kind == 'shape'
    if member_owner.is_nullable or not is_walked {
        return names
    }
    if member_owner.kind == 'shape' {
        var shape = context.program.shape_keyed(member_owner.name)
        crash shape
        var shape_index = 0
        while shape_index < shape.members.count() {
            var member = shape.members[shape_index]
            if member.is_an_attribute {
                names.append(member.name)
            }
            shape_index = shape_index + 1
        }
        return names
    }
    var model = context.class_of(member_owner)
    if model.bound_types["$element_type"] or model.bound_types["$value_type"] {
        return names
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        names.append(attribute.name)
        index = index + 1
    }
    return names
}

func parameters_of(owner: Model.Type): List<String> {
    var walked = context.resolver.owners.function_of_parameters(owner)
    crash walked
    return walked.parameters.map_names()
}

func classes_of_a_namespace(namespace: String): List<String> {
    var names = List<String>()
    add_the_classes_of(namespace, names)
    var folders = context.resolver.state.symbols.namespace_folders()
    var folder_index = 0
    while folder_index < folders.count() {
        var each_folder = folders[folder_index]
        if each_folder.namespace.ends_with(".{namespace}") {
            add_the_classes_of(each_folder.namespace, names)
        }
        folder_index = folder_index + 1
    }
    return names
}

func add_the_classes_of(namespace: String, names: List<String>) {
    var folder = context.resolver.state.symbols.namespace_folder(namespace)
    fallback folder
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var model = context.resolver.monomorphiser.class_model_named(file.namespace)
        if model {
            names.append(model.shown)
        }
        index = index + 1
    }
}

func member_index_of(model: Model.ClassModel, name: String): Integer {
    if model.attribute_named(name) {
        return attribute_index_of(model, name)
    }
    return 0
}

func attribute_index_of(model: Model.ClassModel, name: String): Integer {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.name == name {
            return index
        }
        index = index + 1
    }
    crash
}

func answer_or_nothing(function: Model.FunctionModel): Model.Type {
    if function.answer {
        return function.answer
    }
    return Model.Type('nothing', "")
}

func refuse_a_singular(element_class: Model.ClassModel, name: String, written: String) {
    var inflected = member_by_plural(element_class, written)
    var singular_member = member_named(element_class, written)
    refuse_a_mapped_test(element_class, name, inflected)
    refuse_a_mapped_test(element_class, name, singular_member)
    refuse_a_shared_plural(name, written, inflected, singular_member)
    fallback inflected.is_empty()
    var singular = member_named(element_class, written)
    fallback not singular.is_empty()
    var plural = plural_of(written)
    fallback plural != written and not written.ends_with("s")
    var called_plural = name.replace(written, plural)
    typing.refuse_singular_template(context, name, written, called_plural)
}

func refuse_a_mapped_test(element_class: Model.ClassModel, name: String, member: String) {
    fallback name.starts_with("map_") and not member.is_empty()
    var member_type = enum_type_of_member(element_class, member)
    fallback context.is_boolean(member_type)
    var shown_member = member
    if member.starts_with("get_") {
        var length = member.length()
        var sliced_shown_member = member.slice(4, length)
        crash sliced_shown_member
        shown_member = sliced_shown_member
    }
    var parts = element_class.shown.split(".")
    var element_name = parts.last()
    crash element_name
    typing.refuse_a_mapped_test(context, name, shown_member, element_name)
}

func refuse_a_shared_plural(name: String, written: String, inflected: String, singular_member: String) {
    fallback not inflected.is_empty() and not singular_member.is_empty() and inflected != singular_member
    typing.refuse_a_shared_plural(context, name, inflected, singular_member, written)
}

func member_by_plural(element_class: Model.ClassModel, written: String): String {
    var names = element_class.declared_attributes.map_names()
    var function_index = 0
    while function_index < element_class.declared_functions.count() {
        var function = element_class.declared_functions[function_index]
        var is_plain = function.parameters.is_empty() and not function.is_a_member_template
        if is_plain and function.name.starts_with("get_") {
            var length = function.name.length()
            var getter_name = function.name.slice(4, length)
            crash getter_name
            names.append(getter_name)
        } else if is_plain {
            names.append(function.name)
        }
        function_index = function_index + 1
    }
    var name_index = 0
    while name_index < names.count() {
        var name = names[name_index]
        var plural = plural_of(name)
        if plural == written {
            return member_named(element_class, name)
        }
        name_index = name_index + 1
    }
    return ""
}

func plural_of(word: String): String {
    var words = word.split("_")
    var last_word = words.remove_last()
    crash last_word
    var head = words.join("_")
    if not head.is_empty() {
        head = "{head}_"
    }
    var text_class = context.resolver.monomorphiser.class_model_named("String")
    if not text_class {
        return word.pluralize()
    }
    if inflection_lists(text_class, "uncountables", last_word) {
        return word
    }
    var irregular = irregular_plural(text_class, last_word)
    if not irregular.is_empty() {
        return "{head}{irregular}"
    }
    if is_in_the_compilers_tables(last_word) {
        var by_the_rules = plural_by_the_rules(last_word)
        return "{head}{by_the_rules}"
    }
    return word.pluralize()
}

func is_in_the_compilers_tables(word: String): Boolean {
    var own_irregulars = word.irregulars
    var plural = own_irregulars[word]
    if plural {
        return true
    }
    var plurals = own_irregulars.values()
    if plurals.contains(word) {
        return true
    }
    var own_uncountables = word.uncountables
    return own_uncountables.contains(word)
}

func plural_by_the_rules(word: String): String {
    var marked = "q{word}"
    var plural = marked.pluralize()
    var length = plural.length()
    var sliced = plural.slice(1, length)
    crash sliced
    return sliced
}

func inflection_lists(text_class: Model.ClassModel, name: String, word: String): Boolean {
    var listed = inflection_table(text_class, name)
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return lists_the_word(listed, word)
    }
    return false
}

func inflection_table(text_class: Model.ClassModel, name: String): SpiteCompiler.Expression? {
    var attribute = text_class.attribute_named(name)
    if attribute {
        crash attribute.declaration
        return attribute.declaration.value
    }
    var function = text_class.function_named(name)
    fallback function
    crash function.declaration
    crash function.declaration.body
    var last = function.declaration.body.statements.last()
    if last.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return last.value
    }
    return null
}

func lists_the_word(listed: AbstractSyntaxTree.Shapes.Expressions.ListLiteral, word: String): Boolean {
    var index = 0
    while index < listed.entries.count() {
        var entry = listed.entries[index]
        if entry.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = constant_text_of(entry)
            if text == word {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func irregular_plural(text_class: Model.ClassModel, word: String): String {
    var table = inflection_table(text_class, "irregulars")
    if table.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        return plural_in_the_table(table, word)
    }
    return ""
}

func plural_in_the_table(table: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral, word: String): String {
    var index = 0
    while index < table.pairs.count() {
        var pair = table.pairs[index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var answered = entry_plural(pair, word)
            if not answered.is_empty() {
                return answered
            }
        }
        index = index + 1
    }
    return ""
}

func entry_plural(pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral, word: String): String {
    var key = pair.key
    if key.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var singular = constant_text_of(key)
        return plural_of_an_entry(singular, pair.value, word)
    }
    return ""
}

func plural_of_an_entry(singular: String, value: SpiteCompiler.Expression?, word: String): String {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var plural = constant_text_of(value)
        var names_it = singular == word or plural == word
        if names_it {
            return plural
        }
    }
    return ""
}

func member_named(element_class: Model.ClassModel, wanted: String): String {
    if element_class.attribute_named(wanted) {
        return wanted
    }
    var function = element_class.function_named(wanted)
    var getter = element_class.function_named("get_{wanted}")
    if not function and getter {
        return "get_{wanted}"
    }
    fallback function
    fallback function.parameters.is_empty()
    return wanted
}

func chained_call(read: SpiteCompiler.Value, function: Model.FunctionModel): SpiteCompiler.Value {
    var through = present_class_of(read)
    var called_function = through.function_named(function.chained_function)
    crash called_function
    context.need(called_function)
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name.starts_with("_chained_") {
            var internal_name = context.scope.internal_name_of(parameter.name)
            crash internal_name
            var passed = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, internal_name)
            arguments.append(passed)
        }
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(called_function, read, arguments)
}

func union_shape_of(union_type: Model.Type, name: String): Model.ShapeModel {
    var fitting = Fitting(context, this)
    var shown = context.shown(union_type)
    if union_type.is_nullable {
        note_a_maybe_null_type(union_type)
    }
    var united = fitting.union_model_of(union_type)
    var key = "{united.key}|{name}"
    var known = context.program.shape_keyed(key)
    if known {
        return known
    }
    if is_a_copy_name(name) {
        return union_copy_shape(union_type, united, key, name)
    }
    var made = Model.ShapeModel(key, united.name)
    var fillers = context.program.fillers_of(key)
    var member: Model.FunctionModel? = null
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var model = context.class_of(held)
        var answered = member_answered_by(model, name, shown)
        if not member {
            member = answered
        }
        fillers.append(held)
        index = index + 1
    }
    crash member
    made.members.append(member)
    context.program.shapes[key] = made
    return made
}

func union_copy_shape(union_type: Model.Type, united: Model.UnionModel, key: String, name: String): Model.ShapeModel {
    var made = Model.ShapeModel(key, united.name)
    var copying = Model.FunctionModel(name, key)
    copying.answer = union_type.present()
    if name == "_deep_copy_in" {
        var copies = Copying(context, this)
        var table_model = copies.copy_table()
        var table_type = table_model.type_of_an_instance()
        var parameter = Model.ParameterModel("table", table_type, false)
        copying.parameters.append(parameter)
    }
    made.members.append(copying)
    context.program.shapes[key] = made
    var fillers = context.program.fillers_of(key)
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fillers.append(held)
        need_a_copy(held, name, made)
        index = index + 1
    }
    return made
}

func is_a_copy_name(name: String): Boolean {
    return name == "copy" or name == "deep_copy" or name == "_deep_copy_in"
}

func copy_member_of(shape: Model.ShapeModel, answer: Model.Type, name: String): Model.FunctionModel {
    var known = shape.member_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, shape.key)
    made.answer = answer
    if name == "_deep_copy_in" {
        var copies = Copying(context, this)
        var table_model = copies.copy_table()
        var table_type = table_model.type_of_an_instance()
        var parameter = Model.ParameterModel("table", table_type, false)
        made.parameters.append(parameter)
    }
    shape.members.append(made)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        need_a_copy(filler, name, shape)
        index = index + 1
    }
    return made
}

func need_a_copy(filler: Model.Type, name: String, shape: Model.ShapeModel) {
    var is_copied = filler.kind == 'object' and filler.name != "String" and not filler.is_a_walked_name
    fallback is_copied
    var model = context.class_of(filler)
    fallback not model.is_singleton
    var function = model.function_named(name)
    if not function {
        var given_count = 0
        if name == "_deep_copy_in" {
            given_count = 1
        }
        function = made_copy(model, name, given_count)
    }
    if not function {
        typing.refuse_not_a_fit(context, model.shown, shape.name, name)
    }
    crash function
    context.need(function)
}

func union_method_call(
    receiver: SpiteCompiler.Value,
    name: String,
    arguments: List<SpiteCompiler.Value>,
): SpiteCompiler.Value {
    var through = union_shape_of(receiver.value_type, name)
    var as_shape = Model.Type('shape', through.key)
    var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', receiver)
    return shape_method_call(shaped, name, arguments)
}

func member_answered_by(model: Model.ClassModel, name: String, shown: String): Model.FunctionModel {
    var attribute = model.attribute_named(name)
    if attribute {
        var read = Model.FunctionModel(name, model.key)
        read.is_an_attribute = true
        read.answer = attribute.attribute_type
        return read
    }
    var function = model.function_named(name)
    if function {
        context.need(function)
        return function
    }
    var getter = model.function_named("get_{name}")
    if not getter {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash getter
    context.need(getter)
    var through_the_getter = Model.FunctionModel(name, model.key)
    through_the_getter.is_an_attribute = true
    through_the_getter.answer = getter.answer
    return through_the_getter
}

func shape_call(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value {
    var shown = context.shown(receiver.value_type)
    if receiver.value_type.is_nullable {
        note_a_maybe_null_type(receiver.value_type)
    }
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var member = shape.member_named(name)
    if not member and is_a_copy_name(name) and written.is_empty() {
        var own_type = receiver.value_type.present()
        member = copy_member_of(shape, own_type, name)
    }
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    var arguments = arguments_for(shown, member.parameters, written, false)
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func called(
    function: Model.FunctionModel,
    receiver: SpiteCompiler.Value,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value {
    var schema = schema_of(function)
    if schema {
        return schema
    }
    if function.reflected_answer_index >= 0 and function.bound_parameter.is_empty() {
        typing.refuse_a_run_time_reflection_for_a_type(context, function.name)
    }
    var arguments = fitted_arguments(function, written)
    var with_known_functions = with_the_functions_passed(function, arguments)
    context.need(with_known_functions)
    copy_an_inline_item(with_known_functions, arguments)
    return HighIntermediaryRepresentation.Values.Call(with_known_functions, receiver, arguments)
}

func with_the_functions_passed(
    function: Model.FunctionModel,
    arguments: List<SpiteCompiler.Value>,
): Model.FunctionModel {
    if not function.declaration or function.known_parameter_functions.count() > 0 {
        return function
    }
    var described_names = described_function_parameters(function)
    if described_names.is_empty() {
        return function
    }
    var known = Dictionary<String, Model.FunctionModel>()
    var pieces = List<String>()
    var index = 0
    while index < function.parameters.count() and index < arguments.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        var described = described_argument_function(argument)
        if described and described_names.contains(parameter.name) {
            known[parameter.name] = described
            var owner_name = described.owner.replace(".", "_")
            pieces.append("{owner_name}_{described.name}")
        }
        index = index + 1
    }
    if pieces.is_empty() {
        return function
    }
    var joined = pieces.join("_and_")
    var copy_name = "{function.name}_for_{joined}"
    var copy_key = "{function.owner}.{copy_name}"
    var made = context.known_function_copies[copy_key]
    if made {
        return made
    }
    var copied = Model.FunctionModel(copy_name, function.owner)
    copied.declaration = function.declaration
    copied.parameters = function.parameters
    copied.answer = function.answer
    copied.known_parameter_functions = known
    context.known_function_copies[copy_key] = copied
    return copied
}

func described_argument_function(argument: SpiteCompiler.Value?): Model.FunctionModel? {
    fallback argument
    return described_function(argument)
}

func described_function_parameters(function: Model.FunctionModel): List<String> {
    var function_key = function.key()
    var known_names = context.described_parameters[function_key]
    if known_names {
        return known_names
    }
    var found_names = read_described_parameters(function)
    context.described_parameters[function_key] = found_names
    return found_names
}

func read_described_parameters(function: Model.FunctionModel): List<String> {
    var described_names = List<String>()
    crash function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return described_names
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var described_name = described_parameter_of(found.expression, function)
        if not described_name.is_empty() and not described_names.contains(described_name) {
            described_names.append(described_name)
        }
        index = index + 1
    }
    return described_names
}

func described_parameter_of(expression: SpiteCompiler.Expression?, function: Model.FunctionModel): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return described_target_of(expression.target, expression.name, function)
    }
    return ""
}

func described_target_of(
    target: SpiteCompiler.Expression?,
    member_name: String,
    function: Model.FunctionModel,
): String {
    var asks = member_name == "name" or member_name == "arguments"
    fallback asks
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return function_parameter_named(target.name, function)
    }
    return ""
}

func function_parameter_named(name: String, function: Model.FunctionModel): String {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name and parameter.parameter_type.kind == 'function' {
            return name
        }
        index = index + 1
    }
    return ""
}

func copy_an_inline_item(function: Model.FunctionModel, arguments: List<SpiteCompiler.Value>) {
    fallback function.name == "_write_value" and arguments.count() == 2
    var owner = context.program.class_named(function.owner)
    fallback owner
    var holds_inline = owner.key.starts_with("Vector_of_") or owner.key.starts_with("Items_of_")
    fallback holds_inline
    var element = owner.bound_types["$element_type"]
    fallback element
    var is_an_object = element.kind == 'object' and element.name != "String" and not element.is_nullable
    fallback is_an_object
    var by_reference = owner.key.starts_with("Items_of_") and not fits_a_vector(element)
    fallback not by_reference
    var model = context.class_of(element)
    fallback not model.is_singleton
    var copying = model.function_named("copy")
    if not copying {
        copying = made_copy(model, "copy", 0)
    }
    crash copying
    context.need(copying)
    var item = arguments[1]
    var no_arguments = List<SpiteCompiler.Value>()
    var copied = HighIntermediaryRepresentation.Values.Call(copying, item, no_arguments)
    arguments[1] = copied
}

func schema_of(function: Model.FunctionModel): SpiteCompiler.Value? {
    fallback function.name == "schema" and not function.has_a_body()
    var owner = context.program.class_named(function.owner)
    fallback owner
    var is_binary = owner.key.starts_with("BinaryWriter_of_") or owner.key.starts_with("BinaryReader_of_")
    fallback is_binary
    var described = owner.bound_types["$value_type"]
    fallback described
    var schema = Schema(context)
    var hashed = schema.hash_of(described)
    var long = context.scalar_type("Long")
    return HighIntermediaryRepresentation.Values.WholeNumber(long, hashed)
}

func method_call(
    receiver: SpiteCompiler.Value,
    name: String,
    arguments: List<SpiteCompiler.Value>,
): SpiteCompiler.Value {
    var fitting = Fitting(context, this)
    if receiver.value_type.kind == 'shape' {
        return shape_method_call(receiver, name, arguments)
    }
    if receiver.value_type.kind == 'union' and not receiver.value_type.is_nullable {
        return union_method_call(receiver, name, arguments)
    }
    var owner = present_class_of(receiver)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function and name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var given_count = arguments.count()
    if not function {
        function = made_copy(owner, name, given_count)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    if given_count != function.parameters.count() {
        var called_name = "{owner.shown}.{name}"
        var wanted_count = function.parameters.count()
        typing.refuse_argument_count(context, called_name, wanted_count, given_count)
    }
    context.need(function)
    var given = List<SpiteCompiler.Value>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var parameter = function.parameters[index]
        crash parameter
        var fitted_argument = fitting.fitted(argument, parameter.parameter_type)
        given.append(fitted_argument)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(function, receiver, given)
}

func shape_method_call(
    receiver: SpiteCompiler.Value,
    name: String,
    arguments: List<SpiteCompiler.Value>,
): SpiteCompiler.Value {
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var shown = context.shown(receiver.value_type)
    var member = shape.member_named(name)
    var is_copied_in = name == "_deep_copy_in" and arguments.count() == 1
    if not member and is_a_copy_name(name) and (arguments.is_empty() or is_copied_in) {
        var own_type = receiver.value_type.present()
        member = copy_member_of(shape, own_type, name)
    }
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func fitted_arguments(
    function: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value> {
    var spread = spread_arguments(function, written)
    if spread {
        return spread
    }
    var shown = "{function.owner}.{function.name}"
    var owner = context.program.class_named(function.owner)
    var walks_the_function = false
    if owner {
        walks_the_function = context.resolver.state.symbols.is_library_path(owner.file.path)
    }
    return arguments_for(shown, function.parameters, written, walks_the_function)
}

func spread_arguments(
    function: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    fallback written.count() == 1
    var only = written[0]
    if only.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return spread_of(function, only)
    }
    return null
}

func spread_of(
    function: Model.FunctionModel,
    spreading: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<SpiteCompiler.Value>? {
    var callee = spreading.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return spread_by(function, callee.name, spreading.arguments)
    }
    return null
}

func spread_by(
    function: Model.FunctionModel,
    name: String,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    var owner = context.current_class
    fallback not owner.function_named(name)
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and walks_by_the_name(template, name) {
            return spread_over(function, owner, template, written)
        }
        index = index + 1
    }
    return null
}

func spread_over(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    var literals = Literals(context, this)
    var fitting = Fitting(context, this)
    var outer_spread = spread_into
    spread_into = function
    var plural_name = "{template.name}s"
    var member_owner = owner_of_a_template(template, owner, plural_name)
    if not member_owner or member_owner.kind != 'parameters' {
        spread_into = outer_spread
        return null
    }
    var arguments = List<SpiteCompiler.Value>()
    var word = walked_word(template)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var called_name = template.name.replace(word, parameter.name)
        var made = member_template_of(owner, called_name)
        crash made
        var own = literals.this_value()
        var answered = called(made, own, written)
        var fitted_answer = fitting.fitted(answered, parameter.parameter_type)
        arguments.append(fitted_answer)
        index = index + 1
    }
    spread_into = outer_spread
    return arguments
}

func owner_of_a_template(template: Model.FunctionModel, owner: Model.ClassModel, called_name: String): Model.Type? {
    var range = context.resolver.owners.range_of_a_template(template)
    if range != "Spite.Argument" {
        return context.resolver.owners.template_owner_of(template, owner)
    }
    var found = argument_owner()
    var rule = Validators.NameResolution.TemplateRange.Validator()
    rule.check_an_argument_owner(
        found,
        context.current_class.file.path,
        context.line,
        context.current_class.shown,
        context.current_function.name,
        called_name,
    )
    return found
}

func argument_owner(): Model.Type? {
    var current = context.current_function
    if spread_into {
        var into: Model.FunctionModel = spread_into
        return parameters_of_a_call(into, current)
    }
    var is_bound = not current.bound_pattern.is_empty() and not current.bound_class.is_empty()
    if is_bound {
        return Model.Type('parameters', "{current.bound_class}|{current.bound_pattern}")
    }
    return null
}

func parameters_of_a_call(into: Model.FunctionModel, current: Model.FunctionModel): Model.Type {
    var is_the_pattern = into.name == current.bound_function and not current.bound_pattern.is_empty()
    if is_the_pattern {
        return Model.Type('parameters', "{into.owner}|{current.bound_pattern}")
    }
    return Model.Type('parameters', "{into.owner}|{into.name}")
}

func arguments_for(
    shown: String,
    parameters: List<Model.ParameterModel>,
    written: List<SpiteCompiler.Expression>,
    walks_the_function: Boolean,
): List<SpiteCompiler.Value> {
    var fitting = Fitting(context, this)
    var collections = Collections(context, this)
    var arguments = List<SpiteCompiler.Value>()
    var last = parameters.last()
    var is_variadic = false
    if last {
        is_variadic = last.is_variadic
    }
    var fixed_count = parameters.count()
    if is_variadic {
        fixed_count = fixed_count - 1
    }
    var count_is_wrong = written.count() != parameters.count()
    if is_variadic {
        count_is_wrong = written.count() < fixed_count
    }
    if count_is_wrong {
        var given_count = written.count()
        var wanted_count = parameters.count()
        typing.refuse_argument_count(context, shown, wanted_count, given_count)
    }
    var index = 0
    while index < fixed_count {
        var argument = written[index]
        var parameter = parameters[index]
        crash parameter
        var given = value_of(argument, parameter.parameter_type)
        refuse_a_nullable_answer(shown, argument, given.value_type, parameter.parameter_type)
        if walks_the_function {
            refuse_a_passed_value(shown, argument, given.value_type, parameter.parameter_type)
            refuse_a_passed_function(shown, argument, given.value_type, parameter.parameter_type)
        }
        var value = fitting.fitted(given, parameter.parameter_type)
        var folded_keys = Folded.Keys(context, this)
        folded_keys.check_a_passed_map(value, shown)
        arguments.append(value)
        index = index + 1
    }
    if is_variadic {
        crash last
        var gathered = collections.gathered_list(last.parameter_type, written, fixed_count)
        arguments.append(gathered)
    }
    return arguments
}

func refuse_a_nullable_answer(
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback given.answer and wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback given_answer.is_nullable and not wanted_answer.is_nullable
    var present = given_answer.present()
    fallback present.is_the_same_as(wanted_answer)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    typing.refuse_a_nullable_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_function(
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback not same_signature(given, wanted)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    if given.parameters.count() != wanted.parameters.count() {
        refuse_a_passed_count(called_name, argument_text, given, wanted)
    }
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        if not given_parameter.is_the_same_as(wanted_parameter) {
            var given_shown = context.shown(given_parameter)
            var wanted_shown = context.shown(wanted_parameter)
            typing.refuse_a_passed_type(context, called_name, argument_text, wanted_shown, given_shown)
        }
        index = index + 1
    }
    if given.answer and wanted.answer {
        refuse_another_answer(called_name, argument_text, given, wanted)
    }
    fallback wanted.answer and not given.answer
    var wanted_answer: Model.Type = wanted.answer
    var answer_shown = context.shown(wanted_answer)
    typing.refuse_a_passed_nothing(context, called_name, argument_text, answer_shown)
}

# ../../PROOFS.md#a-member-template-fits
func refuse_a_passed_value(shown: String, argument: SpiteCompiler.Expression?, given: Model.Type, wanted: Model.Type) {
    fallback given.kind != 'function' and wanted.kind == 'function' and argument
    var parts = shown.split(".")
    var called_name = parts.last()
    fallback called_name == "each"
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    typing.refuse_an_each_of_a_value(context, argument_text)
}

func refuse_another_answer(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    crash given.answer
    crash wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback not given_answer.is_the_same_as(wanted_answer)
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    typing.refuse_another_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_count(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    var takes = given.parameters.count()
    var gives = wanted.parameters.count()
    if gives == 1 {
        var only = wanted.parameters[0]
        crash only
        var only_shown = context.shown(only)
        typing.refuse_a_passed_single(context, called_name, argument_text, only_shown, takes)
    }
    typing.refuse_a_passed_count(context, called_name, argument_text, gives, takes)
}

# ../../HOT_RELOAD.md#a-reload-is-refused-when
func stable_object_key(model: Model.ClassModel): String {
    var digest = Model.Digest()
    var function_key = context.current_function.key()
    digest.add_text(context.current_class.key)
    digest.add_text(function_key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        digest.add_text(attribute.name)
        digest.add_text(attribute.attribute_type.name)
        if attribute.attribute_type.is_nullable {
            digest.add_text("?")
        }
        index = index + 1
    }
    var layout = digest.digest_text()
    var ordinal = 1
    var seen = context.object_ordinals[layout]
    if seen {
        ordinal = seen + 1
    }
    context.object_ordinals[layout] = ordinal
    var key = "Object_{layout}_{ordinal}"
    model.key = key
    var renamed = 0
    while renamed < model.declared_attributes.count() {
        var attribute = model.declared_attributes[renamed]
        attribute.owner = key
        renamed = renamed + 1
    }
    return key
}

# ../../PROOFS.md#narrowing-a-t
func note_a_maybe_null(kind: String, value: SpiteCompiler.Value, name: String, wanted: Model.Type) {
    var site = PresenceSite(kind, context, value.value_type)
    site.value = value
    site.name = name
    site.wanted = wanted
    context.note_a_presence_site(site)
}

func note_a_maybe_null_type(maybe: Model.Type) {
    var site = PresenceSite("value", context, maybe)
    context.note_a_presence_site(site)
}

func as_present(value: SpiteCompiler.Value): SpiteCompiler.Value {
    var present = value.value_type.present()
    return HighIntermediaryRepresentation.Values.Conversion(present, 'proven', value)
}

func is_a_number_literal(expression: SpiteCompiler.Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'integer_literal' or expression.kind == 'decimal_literal'
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return is_a_number_literal(expression.operand)
    }
    return false
}

func article_for(name: String): String {
    var first = name.slice(0, 1)
    crash first
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func type_arguments_of(written: SpiteCompiler.Expression?): List<AbstractSyntaxTree.Shapes.Types.GenericArgument> {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.generic_arguments
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return written.generic_arguments
    }
    return List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
}

func unbuilt(): SpiteCompiler.Value {
    var buildable = Validators.HighIntermediaryRepresentation.Buildable.Validator()
    var path = context.path()
    buildable.check_an_unbuilt_line(path, context.line, context.current_class.key)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func holds_a_function_value(name: String): Boolean {
    var held = context.current_class.attribute_named(name)
    fallback held
    return held.attribute_type.kind == 'function'
}

func value_call_of(invoked: SpiteCompiler.Value, written: List<SpiteCompiler.Expression>): SpiteCompiler.Value {
    var fitting = Fitting(context, this)
    var callee = invoked
    if invoked.value_type.is_nullable {
        note_a_maybe_null("held", invoked, "", invoked.value_type)
        callee = as_present(invoked)
    }
    var called_type = callee.value_type
    if written.count() != called_type.parameters.count() {
        var shown_type = context.shown(called_type)
        var wanted_count = called_type.parameters.count()
        var given_count = written.count()
        typing.refuse_argument_count(context, shown_type, wanted_count, given_count)
    }
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var wanted = called_type.parameters[index]
        crash wanted
        var value = fitting.fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    var made = HighIntermediaryRepresentation.Values.Function.ValueCall(callee, arguments)
    if called_type.answer {
        made.value_type = called_type.answer
    }
    return made
}

func vector_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "fits_vector" and call.arguments.is_empty()
    var asked = known_class_asked(callee.target)
    fallback asked
    var is_plain = asked.kind == 'scalar' or asked.kind == 'enumeration'
    var fits = is_plain or fits_a_vector(asked)
    return boolean_constant(fits)
}

func any_attribute_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "any_attribute_fits_vector"
    var asked = known_class_asked(callee.target)
    fallback asked
    var skipped = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var path = class_path_of(written)
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var skipped_type = context.resolver.types.class_type_in(path, no_arguments, context.current_class, context.line)
        skipped.append(skipped_type.name)
        index = index + 1
    }
    var holds = any_attribute_fits(asked, skipped)
    return boolean_constant(holds)
}

func any_attribute_fits(asked: Model.Type, skipped: List<String>): Boolean {
    if asked.kind == 'shape' and not asked.is_nullable {
        return any_member_fits(asked, skipped)
    }
    fallback context.has_a_class(asked) and not asked.is_nullable
    var model = context.class_of(asked)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type
        var counts = not skipped.contains(held.name) and fits_a_vector(held)
        if counts {
            return true
        }
        index = index + 1
    }
    return false
}

func any_member_fits(asked: Model.Type, skipped: List<String>): Boolean {
    var shape = context.program.shape_keyed(asked.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute and member.answer {
            var counts = not skipped.contains(member.answer.name) and fits_a_vector(member.answer)
            if counts {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func known_class_asked(asked: SpiteCompiler.Expression?): Model.Type? {
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback asked.name.starts_with("$")
        return context.current_class.bound_types[asked.name]
    }
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_class_asked(asked)
    }
    return null
}

func walked_class_asked(asked: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Model.Type? {
    var function = context.current_function
    var described = asked.target
    var names_the_walked = false
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == "class" and described.name == function.bound_parameter
    }
    fallback names_the_walked
    return function.bound_member_type
}

func fits_a_vector(element: Model.Type): Boolean {
    var constraints = Constraints(context, this)
    return constraints.fits_a_vector(element)
}

func pattern_argument_count(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var function = context.current_function
    fallback callee.name == "argument_count" and call.arguments.is_empty() and not function.bound_parameter.is_empty()
    var asked = callee.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter
    }
    fallback names_the_walked
    var walks_functions = function.binds_a_function_declaration and not function.bound_class.is_empty()
    if not walks_functions or function.bound_function.is_empty() {
        typing.refuse_an_argument_count_outside_a_walk(context, function.bound_parameter)
    }
    var walked_class = context.program.class_named(function.bound_class)
    crash walked_class
    var bound = walked_class.function_named(function.bound_function)
    crash bound
    var integer = context.scalar_type("Integer")
    var counted = bound.parameters.count()
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted)
}

func reflection_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var question = callee.name
    var lists = question == "has_function" or question == "argument_count" or question == "function_waits"
    fallback lists or question == "function_writes_parameter"
    var described = constant_class_of(callee.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var pattern = written_pattern_of(call)
    if not pattern {
        refuse_an_unwritten_question(asked, question)
    }
    crash pattern
    var bound_pattern = pattern_of_the_walk(pattern)
    var matching = matching_functions(model, bound_pattern)
    var has_one = not matching.is_empty()
    if question == "has_function" {
        return boolean_constant(has_one)
    } else if question == "argument_count" {
        return counted_arguments(matching, asked, pattern)
    } else if question == "function_waits" {
        return waits_question(matching)
    } else {
        return writes_question(call, asked, matching)
    }
}

func pattern_of_the_walk(pattern: String): String {
    var function = context.current_function
    if function.bound_function.is_empty() or function.bound_pattern.is_empty() {
        return pattern
    }
    var opened = pattern.replace("<", "")
    var unwrapped = opened.replace(">", "")
    if unwrapped == function.bound_pattern {
        return function.bound_function
    }
    return pattern
}

func refuse_an_unwritten_question(asked: String, question: String) {
    if question == "function_writes_parameter" {
        typing.refuse_an_unwritten_parameter(context, asked)
    }
    var example = "run_each"
    if question != "has_function" {
        example = "update_each"
    }
    typing.refuse_an_unwritten_question(context, asked, question, example)
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String? {
    fallback not call.arguments.is_empty()
    var written = call.arguments[0]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(written)
    }
    return null
}

func folded_function_count(target: SpiteCompiler.Expression?): SpiteCompiler.Value? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return folded_filtered_count(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listed_count(target, "", "")
    }
    return null
}

func folded_filtered_count(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Value? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_name_filter(call, callee)
    }
    return null
}

func folded_name_filter(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var is_a_suffix = callee.name == "filter_name_ends_with"
    var is_a_prefix = callee.name == "filter_name_starts_with"
    fallback is_a_suffix or is_a_prefix
    fallback call.arguments.count() == 1
    var argument = call.arguments[0]
    var text: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        text = plain_text_of(argument)
    }
    fallback text
    var listing = callee.target
    if listing.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listing_by_a_name(listing, text, is_a_suffix)
    }
    return null
}

func folded_listing_by_a_name(
    listing: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    text: String,
    is_a_suffix: Boolean,
): SpiteCompiler.Value? {
    if is_a_suffix {
        return folded_listed_count(listing, "", text)
    }
    return folded_listed_count(listing, text, "")
}

func folded_listed_count(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    prefix: String,
    suffix: String,
): SpiteCompiler.Value? {
    fallback member.name == "functions"
    var key = constant_class_of(member.target)
    fallback key
    var model = context.program.class_named(key)
    fallback model
    var reflection = Reflection(context, this)
    var count = 0
    var index = 0
    var has_a_stand_in = model.key != context.program.entry
    while has_a_stand_in and index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_named = declared.name.starts_with(prefix) and declared.name.ends_with(suffix)
        if is_named and not declared.is_synthetic and reflection.declarations.is_listed(declared) {
            count = count + 1
        }
        index = index + 1
    }
    var integer = context.scalar_type("Integer")
    var number: Long = count
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func plain_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    return piece.value()
}

func constant_class_of(target: SpiteCompiler.Expression?): String? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return constant_class_named(target.name, target.generic_arguments)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return constant_class_of_a_member(target)
    }
    return null
}

func constant_class_named(name: String, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): String? {
    fallback not context.scope.internal_name_of(name)
    var function = context.current_function
    if function.binds_a_class and name == function.bound_parameter {
        crash function.bound_member_type
        return function.bound_member_type.name
    }
    if name.starts_with("$") {
        return bound_class_named(name)
    }
    if name == "class" {
        fallback not context.current_class.attribute_named("class")
        return context.current_class.key
    }
    var path = List<String>()
    path.append(name)
    return class_key_of_path(path, arguments)
}

func bound_class_named(name: String): String? {
    var bound = context.current_class.bound_types[name]
    fallback bound
    fallback not bound.is_nullable
    fallback context.has_a_class(bound)
    return bound.name
}

func constant_class_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String? {
    var function = context.current_function
    var target = member.target
    var names_the_walked = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = target.name == function.bound_parameter and not function.bound_parameter.is_empty()
    }
    if names_the_walked and member.name == "class" {
        fallback function.bound_member_type
        var walked: Model.Type = function.bound_member_type
        fallback context.has_a_class(walked) and not walked.is_nullable
        return walked.name
    }
    var path = class_path_of(member)
    return class_key_of_path(path, member.generic_arguments)
}

func class_key_of_path(path: List<String>, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): String? {
    fallback not path.is_empty()
    var written = path.join(".")
    fallback not context.resolver.state.symbols.namespace_folder(written)
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback found or scalars.is_a_scalar(written)
    var described = context.resolver.types.class_type_in(path, arguments, context.current_class, context.line)
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    fallback is_a_class and context.has_a_class(described)
    return described.name
}

func matching_functions(model: Model.ClassModel, pattern: String): List<Model.FunctionModel> {
    var fitting = Fitting(context, this)
    var found = List<Model.FunctionModel>()
    var listing = Reflection(context, this)
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var fits = fitting.fits_the_pattern(declared.name, pattern)
        if fits and listing.declarations.is_listed(declared) {
            found.append(declared)
        }
        index = index + 1
    }
    return found
}

func counted_arguments(matching: List<Model.FunctionModel>, asked: String, pattern: String): SpiteCompiler.Value {
    var integer = context.scalar_type("Integer")
    var found = matching.first()
    if not found {
        typing.refuse_a_missing_counted_function(context, asked, pattern)
    }
    crash found
    var counted = found.parameters.count()
    refuse_disagreeing_counts(matching, counted, asked, pattern)
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted)
}

# ../../PROOFS.md#how-many-arguments-a-function-takes
func refuse_disagreeing_counts(matching: List<Model.FunctionModel>, counted: Integer, asked: String, pattern: String) {
    var listed = List<String>()
    var agree = true
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var function_count = function.parameters.count()
        if function_count != counted {
            agree = false
        }
        listed.append("'{function.name}' {function_count}")
        index = index + 1
    }
    fallback not agree
    var found = matching.first()
    crash found
    var owner = typing.plain_class_name(found.owner)
    var counts = listed.join(", ")
    typing.refuse_disagreeing_counts(context, asked, pattern, owner, counts)
}

func waits_question(matching: List<Model.FunctionModel>): SpiteCompiler.Value {
    var listing = Reflection(context, this)
    var buildable = matching.filter(listing.declarations.can_be_built)
    if buildable.is_empty() {
        return boolean_constant(false)
    }
    return asked_fact("waits", buildable)
}

func writes_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    asked: String,
    matching: List<Model.FunctionModel>,
): SpiteCompiler.Value {
    var place = parameter_place_of(call)
    if place < 0 {
        typing.refuse_an_unwritten_parameter(context, asked)
    }
    if matching.is_empty() {
        return boolean_constant(false)
    }
    var listing = Reflection(context, this)
    var cannot_tell = false
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var parameter_count = function.parameters.count()
        if place >= parameter_count {
            var owner_name = base_name_of(function.owner)
            typing.refuse_a_missing_parameter(context, "{owner_name}.{function.name}", parameter_count, place)
        }
        if not listing.declarations.can_be_built(function) {
            cannot_tell = true
        }
        index = index + 1
    }
    if cannot_tell {
        return boolean_constant(true)
    }
    var made = asked_fact("writes", matching)
    made.parameter_index = place
    return made
}

func parameter_place_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Integer {
    if call.arguments.count() != 2 {
        return -1
    }
    var written = call.arguments[1]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_place_of(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_place_of(written)
    }
    return -1
}

func walked_place_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Integer {
    var function = context.current_function
    var asked = member.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter and member.name == "index"
    }
    if not names_the_walked or function.bound_member.is_empty() {
        return -1
    }
    return function.bound_member_index
}

func literal_place_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    if literal.kind != 'integer_literal' {
        return -1
    }
    var place: Integer? = literal.text
    if not place {
        return -1
    }
    return place
}

func asked_fact(
    question: String,
    functions: List<Model.FunctionModel>,
): HighIntermediaryRepresentation.Values.Function.Fact {
    var boolean = context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, question, functions)
    made.is_asked_in_code = true
    made.asking_key = context.current_function.key()
    made.path = context.path()
    made.line = context.line
    made.owner_shown = base_name_of(context.current_class.shown)
    made.function_name = context.current_function.name
    context.facts_asked.append(made)
    functions.each(context.need)
    return made
}

func base_name_of(shown: String): String {
    var opening = shown.index_of("<")
    if opening and opening > 0 {
        var sliced = shown.slice(0, opening)
        crash sliced
        return sliced
    }
    return shown
}

func every_member_reads_its_class(union_type: Model.Type): Boolean {
    var fitting = Fitting(context, this)
    var united = fitting.union_model_of(union_type)
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fallback context.has_a_class(held)
        var model = context.class_of(held)
        fallback model.attribute_named("class") or model.function_named("get_class")
        index = index + 1
    }
    return true
}

func key_name_of(written: SpiteCompiler.Expression?): String? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(written)
    }
    return null
}

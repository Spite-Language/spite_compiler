var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var scalars = Model.Scalars()
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var temporary_count = 0

func Values(starting_context: Context) {
    context = starting_context
}

func value_of(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return named_or_described(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return literal_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return text_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return member_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return call_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return binary_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return unary_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return list_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return dictionary_value(expression, expected)
        _: return unbuilt()
    }
}

func refuse_another_signature(given: Model.Type, wanted: Model.Type) {
    assert not same_signature(given, wanted)
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var wants_an_enum = wanted.kind == 'enumeration'
    typing.refuse_text_given(context, shown_given, shown_wanted, wants_an_enum)
    typing.refuse_mismatch(context, shown_given, shown_wanted)
}

func same_signature(given: Model.Type, wanted: Model.Type): Boolean {
    if given.parameters.count() != wanted.parameters.count() {
        return false
    }
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        if not given_parameter.is_the_same_as(wanted_parameter) {
            return false
        }
        index = index + 1
    }
    if not given.answer {
        return not wanted.answer
    }
    if not wanted.answer {
        return false
    }
    return given.answer.is_the_same_as(wanted.answer)
}

func named_or_described(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    if expected and identifier.is_a_class_name {
        if expected.kind == 'object' and expected.name == "Spite.Class" {
            return class_named_as_a_value(identifier)
        }
    }
    return name_value(identifier)
}

func class_named_as_a_value(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value {
    var path = List<String>()
    path.append(identifier.name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var reflection = Reflection(context, this)
    return reflection.class_object(described.name)
}

func fitted_value_of(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    wanted: Model.Type,
): HighIntermediaryRepresentation.Values.Value {
    var value = value_of(expression, wanted)
    return fitted(value, wanted)
}

func fitted(
    value: HighIntermediaryRepresentation.Values.Value,
    wanted: Model.Type,
): HighIntermediaryRepresentation.Values.Value {
    if value.value_type.kind == 'handle' and wanted.kind != 'handle' {
        var result = result_of_handle(value)
        return fitted(result, wanted)
    }
    var given = value.value_type
    if given.kind == 'function' and wanted.kind == 'function' {
        refuse_another_signature(given, wanted)
    }
    if given.is_the_same_as(wanted) {
        return value
    }
    var cast_to_text = cast_text_of(value, wanted)
    if cast_to_text {
        return fitted(cast_to_text, wanted)
    }
    var same_base = given.kind == wanted.kind and given.name == wanted.name
    if same_base and wanted.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'nullable', value)
    }
    if same_base and given.is_nullable {
        var shown = context.shown(given)
        typing.refuse_maybe_null(context, shown)
    }
    if wanted.is_nullable and not given.is_nullable and wanted.kind == 'scalar' and given.kind == 'scalar' {
        var present = wanted.present()
        var fitted_present = fitted(value, present)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'nullable', fitted_present)
    }
    if wanted.kind == 'union' and is_a_member_of(given, wanted) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_union', value)
    }
    var reads_text = given.name == "String" and given.kind == 'object' and not given.is_nullable and wanted.is_nullable
    if reads_text and wanted.kind == 'scalar' {
        return number_read_from_text(value, wanted)
    }
    if reads_text and wanted.kind == 'enumeration' {
        var enumeration = enum_model_of(wanted)
        need_text_constants()
        var string_model = context.class_of(given)
        var equals = string_model.function_named("equals")
        crash equals
        need(equals)
        return HighIntermediaryRepresentation.Values.EnumFromText(wanted, enumeration, value)
    }
    if wanted.kind == 'shape' and given.kind == 'shape' and given.name != wanted.name {
        refill_a_shape(given, wanted)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_shape', value)
    }
    if wanted.kind == 'shape' and given.kind != 'shape' {
        var present = given.present()
        filled_shape(present, wanted)
        if given.is_nullable {
            need_text_constants()
            var text_type = context.text()
            filled_shape(text_type, wanted)
        }
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_shape', value)
    }
    if is_wider(wanted, given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'widen', value)
    }
    if are_whole_numbers(wanted, given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'narrow', value)
    }
    if are_numbers(wanted, given) {
        return decimal_conversion(given, wanted, value)
    }
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var wants_an_enum = wanted.kind == 'enumeration'
    typing.refuse_text_given(context, shown_given, shown_wanted, wants_an_enum)
    typing.refuse_mismatch(context, shown_given, shown_wanted)
    return value
}

func number_read_from_text(
    value: HighIntermediaryRepresentation.Values.Value,
    wanted: Model.Type,
): HighIntermediaryRepresentation.Values.Value {
    var names = Mapping.Names()
    var reader = names.snake_case_of(wanted.name)
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var read = method_call(value, "to_{reader}", no_arguments)
    return fitted(read, wanted)
}

func refill_a_shape(given: Model.Type, wanted: Model.Type) {
    var link = "{given.name}>{wanted.name}"
    if not context.shape_links.contains(link) {
        context.shape_links.append(link)
    }
    var fillers = context.program.fillers_of(given.name)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        filled_shape(filler, wanted)
        index = index + 1
    }
}

func filled_shape(given: Model.Type, wanted: Model.Type) {
    if given.kind == 'union' {
        fill_with_the_members(given, wanted)
        return
    }
    var shape = context.program.shape_keyed(wanted.name)
    crash shape
    var shown = context.shown(given)
    if given.kind == 'enumeration' {
        fits_as_an_enum(shape, shown)
    } else {
        fits_as_a_class(shape, given, shown)
    }
    var fillers = context.program.fillers_of(shape.key)
    var known = false
    var index = 0
    while index < fillers.count() {
        var filling = fillers[index]
        if filling.name == given.name {
            known = true
        }
        index = index + 1
    }
    if not known {
        var present = given.present()
        fillers.append(present)
    }
}

func fill_with_the_members(given: Model.Type, wanted: Model.Type) {
    var united = union_model_of(given)
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        filled_shape(member, wanted)
        index = index + 1
    }
}

func fits_as_an_enum(shape: Model.ShapeModel, shown: String) {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.name == "_attribute_list" {
            var reflection = Reflection(context, this)
            reflection.no_attributes()
        } else if member.name != "to_string" and member.name != "to_debug" {
            typing.refuse_not_a_fit(context, shown, shape.name, member.name)
        }
        index = index + 1
    }
    need_text_constants()
    var text_type = context.text()
    var text_model = context.class_of(text_type)
    var joining = text_model.function_named("sum")
    crash joining
    need(joining)
}

func fits_as_a_class(shape: Model.ShapeModel, given: Model.Type, shown: String) {
    if not context.has_a_class(given) {
        var first = shape.members[0]
        crash first
        typing.refuse_not_a_fit(context, shown, shape.name, first.name)
    }
    var filler = context.class_of(given)
    debugged_when_asked(filler, shape)
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            var attribute = filler.attribute_named(member.name)
            if not attribute {
                typing.refuse_not_a_fit(context, shown, shape.name, member.name)
            }
        } else {
            need_a_filling_function(filler, member, shown, shape)
        }
        index = index + 1
    }
}

func debugged_when_asked(filler: Model.ClassModel, shape: Model.ShapeModel) {
    assert shape.member_named("to_debug")
    assert not filler.function_named("to_debug")
    var debugging = Debugging(context, this)
    debugging.to_debug_of(filler)
}

func need_a_filling_function(
    filler: Model.ClassModel,
    member: Model.FunctionModel,
    shown: String,
    shape: Model.ShapeModel,
) {
    if member.name == "_attribute_list" {
        var reflection = Reflection(context, this)
        reflection.attribute_list_of(filler)
    }
    var function = filler.function_named(member.name)
    var is_open = shape.key == "Anything" or shape.key == "Number"
    if not function and is_open and member.name == "to_string" {
        function = filler.function_named("to_debug")
    }
    if not function {
        typing.refuse_not_a_fit(context, shown, shape.name, member.name)
    }
    crash function
    need(function)
}

func enum_text(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    need_text_constants()
    var made = enum_model_of(value.value_type)
    var string_type = context.text()
    return HighIntermediaryRepresentation.Values.EnumText(string_type, made, value)
}

func is_a_member_of(given: Model.Type, wanted: Model.Type): Boolean {
    var union_type = wanted.present()
    var made = union_model_of(union_type)
    var index = 0
    while index < made.members.count() {
        var member = made.members[index]
        if member.is_the_same_as(given) {
            return true
        }
        index = index + 1
    }
    return false
}

func union_model_of(union_type: Model.Type): Model.UnionModel {
    var parts = union_type.name.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var owner_length = owner_key.length()
    var name_length = union_type.name.length()
    var simple = union_type.name.slice(owner_length + 1, name_length)
    var made = owner.union_named(simple)
    crash made
    return made
}

func is_wider(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    if not both_scalars {
        return false
    }
    var wanted_scalar = scalars.of(wanted.name)
    var given_scalar = scalars.of(given.name)
    crash wanted_scalar
    crash given_scalar
    var same_family = wanted_scalar.is_decimal == given_scalar.is_decimal
    var keeps_the_sign = wanted_scalar.is_signed or not given_scalar.is_signed
    var grows = wanted_scalar.size > given_scalar.size and given.name != "Boolean"
    return same_family and grows and keeps_the_sign
}

func are_whole_numbers(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    var neither_nullable = not wanted.is_nullable and not given.is_nullable
    if not both_scalars or not neither_nullable {
        return false
    }
    return is_a_whole_number(wanted) and is_a_whole_number(given)
}

func are_numbers(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    var neither_nullable = not wanted.is_nullable and not given.is_nullable
    if not both_scalars or not neither_nullable {
        return false
    }
    return wanted.name != "Boolean" and given.name != "Boolean"
}

func decimal_conversion(
    given: Model.Type,
    wanted: Model.Type,
    value: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if is_a_whole_number(given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'to_decimal', value)
    }
    if is_a_whole_number(wanted) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'to_whole', value)
    }
    return HighIntermediaryRepresentation.Values.Conversion(wanted, 'narrow_decimal', value)
}

func is_a_whole_number(of_type: Model.Type): Boolean {
    var scalar = scalars.of(of_type.name)
    crash scalar
    return not scalar.is_decimal and of_type.name != "Boolean"
}

func literal_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    switch literal.kind {
        'integer_literal': return whole_number_value(literal.text, expected)
        'decimal_literal': return decimal_value(literal.text, expected)
        'keyword_true': return boolean_value(1)
        'keyword_false': return boolean_value(0)
        'keyword_null': return null_value(expected)
        'symbol_literal': return symbol_value(literal.text, expected)
        'keyword_this': return this_value()
        _: return unbuilt()
    }
}

func whole_number_value(written: String, expected: Model.Type?): HighIntermediaryRepresentation.Values.Value {
    var number = written.to_long()
    crash number
    var number_type = context.scalar_type("Integer")
    if expected {
        var wanted = expected.present()
        if is_a_decimal_type(wanted) {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, written)
        }
        if context.is_a_number(wanted) {
            number_type = wanted
            refuse_a_literal_out_of_range(number, wanted)
        }
    }
    var largest_integer: Long = 2147483647
    if number > largest_integer and number_type.name == "Integer" {
        number_type = context.scalar_type("Long")
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(number_type, number)
}

func refuse_a_literal_out_of_range(number: Long, number_type: Model.Type) {
    var scalar = scalars.of(number_type.name)
    assert scalar
    typing.refuse_literal_range(context, number, scalar.name, scalar.size, scalar.is_signed)
}

func is_a_decimal_type(of_type: Model.Type): Boolean {
    if of_type.kind != 'scalar' {
        return false
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_value(written: String, expected: Model.Type?): HighIntermediaryRepresentation.Values.Value {
    var decimal_type = context.scalar_type("Float")
    if expected {
        if expected.name == "Double" {
            decimal_type = context.scalar_type("Double")
        }
    }
    return HighIntermediaryRepresentation.Values.DecimalNumber(decimal_type, written)
}

func boolean_value(number: Long): HighIntermediaryRepresentation.Values.Value {
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func null_value(expected: Model.Type?): HighIntermediaryRepresentation.Values.Value {
    if expected {
        if expected.is_nullable {
            return HighIntermediaryRepresentation.Values.NullConstant(expected)
        }
        var made = default_of_a_type(expected)
        if made {
            return made
        }
    }
    typing.refuse_null_without_a_type(context)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func default_of_a_type(wanted: Model.Type): HighIntermediaryRepresentation.Values.Value? {
    if wanted.kind == 'object' and wanted.name == "String" {
        return described_text("")
    }
    if wanted.kind == 'scalar' {
        var is_a_decimal = wanted.name == "Float" or wanted.name == "Double"
        if is_a_decimal {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, "0.0")
        }
        return HighIntermediaryRepresentation.Values.WholeNumber(wanted, 0)
    }
    if wanted.kind == 'shape' {
        return default_of_a_shape(wanted)
    }
    assert wanted.kind == 'object'
    var made = context.class_of(wanted)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    if constructor {
        if not constructor.parameters.is_empty() {
            return HighIntermediaryRepresentation.Values.MakeObject(wanted, null, arguments)
        }
        need(constructor)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(wanted, constructor, arguments)
}

func default_of_a_shape(wanted: Model.Type): HighIntermediaryRepresentation.Values.Value? {
    var shape = context.program.shape_keyed(wanted.name)
    assert shape
    context.object_count = context.object_count + 1
    var key = "Object{context.object_count}"
    var model = Model.ClassModel(key, "Object", context.current_class.file)
    var defaults = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            crash member.answer
            var field_type: Model.Type = member.answer
            var field = default_of_a_type(field_type)
            crash field
            var attribute = Model.AttributeModel(member.name, key, field_type)
            model.declared_attributes.append(attribute)
            defaults.append(field)
        }
        index = index + 1
    }
    context.program.add(model)
    context.need_defaults(key)
    var object_type = Model.Type('object', key)
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(object_type, null, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", object_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object_type, made)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(object_type, name)
    var field_index = 0
    while field_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[field_index]
        var value = defaults[field_index]
        crash value
        var assigned = HighIntermediaryRepresentation.Statements.AssignAttribute(local, attribute, value)
        assigned.line = context.line
        context.pending.append(assigned)
        field_index = field_index + 1
    }
    return fitted(local, wanted)
}

func symbol_value(name: String, expected: Model.Type?): HighIntermediaryRepresentation.Values.Value {
    if expected {
        if expected.kind == 'enumeration' {
            return enum_value(name, expected)
        }
        if expected.is_symbol {
            need_text_constants()
            var made = HighIntermediaryRepresentation.Values.TextConstant(name)
            made.value_type = expected.present()
            return made
        }
        typing.refuse_symbol_for_text(context, name, expected.name)
    }
    typing.refuse_symbol_without_an_enum(context, name)
    return unbuilt()
}

func enum_value(name: String, expected: Model.Type): HighIntermediaryRepresentation.Values.Value {
    var made = enum_model_of(expected)
    var place = made.values.index_of(name)
    if not place {
        typing.refuse_not_a_value(context, name, made.name)
    }
    crash place
    var number = made.numbers[place]
    crash number
    var present = expected.present()
    return HighIntermediaryRepresentation.Values.WholeNumber(present, number)
}

func enum_model_of(enum_type: Model.Type): Model.EnumModel {
    var parts = enum_type.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func this_value(): HighIntermediaryRepresentation.Values.Value {
    var key = context.current_class.key
    if scalars.of(key) {
        var number = context.scalar_type(key)
        return HighIntermediaryRepresentation.Values.ThisRead(number)
    }
    var own = context.current_class.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.ThisRead(own)
}

func text_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral,
): HighIntermediaryRepresentation.Values.Value {
    var joined: HighIntermediaryRepresentation.Values.Value? = null
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        if not piece.text.is_empty() or literal.pieces.count() == 1 {
            need_text_constants()
            var written = unescaped(piece.text)
            var constant = HighIntermediaryRepresentation.Values.TextConstant(written)
            joined = joined_with(joined, constant)
        }
        if piece.hole {
            var hole = hole_text_of(piece.hole)
            joined = joined_with(joined, hole)
        }
        index = index + 1
    }
    crash joined
    return joined
}

func unescaped(written: String): String {
    var pieces = List<String>()
    var index = 0
    while index < written.length() {
        var code = written.code_at(index)
        if code == 92 and index + 1 < written.length() {
            var piece = escaped_text_of(written, index + 1)
            pieces.append(piece)
            index = index + 2
        } else {
            var letter = written.character_at(index)
            pieces.append(letter)
            index = index + 1
        }
    }
    return pieces.join("")
}

func escaped_text_of(written: String, at: Integer): String {
    var escaped = written.code_at(at)
    switch escaped {
        110: return "\n"
        116: return "\t"
        114: return "\r"
        _: return written.character_at(at)
    }
}

func need_text_constants() {
    var path = List<String>()
    path.append("String")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var string_type = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var string_model = context.class_of(string_type)
    context.need_defaults(string_model.key)
    var append_code = string_model.function_named("append_code")
    crash append_code
    need(append_code)
}

func hole_text_of(hole: AbstractSyntaxTree.Shapes.Expressions.Expression): HighIntermediaryRepresentation.Values.Value {
    var written_value = value_of(hole, null)
    var value = result_of_handle(written_value)
    var string_type = context.text()
    if value.value_type.is_the_same_as(string_type) {
        return value
    }
    if value.value_type.kind == 'enumeration' and not value.value_type.is_nullable {
        return enum_text(value)
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return method_call(value, "to_string", no_arguments)
}

func cast_text_of(
    value: HighIntermediaryRepresentation.Values.Value,
    wanted: Model.Type,
): HighIntermediaryRepresentation.Values.Value? {
    var given = value.value_type
    var wants_text = wanted.kind == 'object' and wanted.name == "String"
    assert wants_text and not given.is_nullable and given.name != "String"
    if given.kind == 'enumeration' {
        return enum_text(value)
    }
    var has_text = given.kind == 'scalar' or given.kind == 'object'
    assert has_text
    var model = context.class_of(given)
    assert model.function_named("to_string")
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return method_call(value, "to_string", no_arguments)
}

func joined_with(
    joined: HighIntermediaryRepresentation.Values.Value?,
    next: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if not joined {
        return next
    }
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(next)
    return method_call(joined, "sum", arguments)
}

func name_value(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value {
    var internal_name = context.scope.internal_name_of(identifier.name)
    if internal_name {
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var declared_type = context.scope.types[internal_name]
        crash declared_type
        var narrows_a_handle = declared_type.kind == 'handle' and local_type.kind != 'handle'
        if narrows_a_handle {
            var handle_read = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            var joined_read = result_of_handle(handle_read)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'present', joined_read)
        }
        var is_boxed = declared_type.kind == 'shape' and is_held_in_a_box(local_type)
        if is_boxed {
            var boxed = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'unbox', boxed)
        }
        return HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    }
    var attribute = context.current_class.attribute_named(identifier.name)
    if attribute {
        var own = this_value()
        if own.value_type.kind == 'scalar' {
            return number_room(own, attribute)
        }
        var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
        return narrowed(read, "this.{identifier.name}")
    }
    var function = context.current_class.function_named(identifier.name)
    if function {
        return function_value(function)
    }
    var reflection = Reflection(context, this)
    if identifier.name == "class" {
        return reflection.class_object(context.current_class.key)
    }
    if identifier.name == "namespace" {
        var own_namespace = reflection.namespace_of(context.current_class.key)
        return reflection.namespace_object(own_namespace)
    }
    if identifier.name.starts_with("$") {
        var bound = context.current_class.bound_types[identifier.name]
        crash bound
        if not bound.constant.is_empty() {
            return constant_of(bound)
        }
        return reflection.class_object(bound.name)
    }
    typing.refuse_unknown_name(context, identifier.name)
    return unbuilt()
}

func constant_of(bound: Model.Type): HighIntermediaryRepresentation.Values.Value {
    var plain = Model.Type(bound.kind, bound.name)
    switch bound.name {
        "Boolean": return boolean_constant(bound.constant == "true")
        "String": return text_constant_of(bound.constant)
        "Float": return HighIntermediaryRepresentation.Values.DecimalNumber(plain, bound.constant)
        _: return whole_constant(plain, bound.constant)
    }
}

func text_constant_of(written: String): HighIntermediaryRepresentation.Values.Value {
    var length = written.length()
    var inside = written.slice(1, length - 1)
    return described_text(inside)
}

func boolean_constant(holds: Boolean): HighIntermediaryRepresentation.Values.Value {
    var number = 0
    if holds {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func whole_constant(plain: Model.Type, written: String): HighIntermediaryRepresentation.Values.Value {
    var number = written.to_long()
    crash number
    return HighIntermediaryRepresentation.Values.WholeNumber(plain, number)
}

func function_value(function: Model.FunctionModel): HighIntermediaryRepresentation.Values.Value {
    need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    var own = this_value()
    return HighIntermediaryRepresentation.Values.FunctionValue(function_type, function, own)
}

func bound_function_value(
    function: Model.FunctionModel,
    receiver: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    return HighIntermediaryRepresentation.Values.FunctionValue(function_type, function, receiver)
}

func number_room(
    number: HighIntermediaryRepresentation.Values.Value,
    attribute: Model.AttributeModel,
): HighIntermediaryRepresentation.Values.Value {
    var scalar = scalars.of(number.value_type.name)
    crash scalar
    var room_type = attribute.attribute_type
    var room_model = context.class_of(room_type)
    context.need_defaults(room_model.key)
    var constructor = constructor_of(room_model)
    crash constructor
    need(constructor)
    var integer = context.scalar_type("Integer")
    var size = HighIntermediaryRepresentation.Values.WholeNumber(integer, scalar.size)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(size)
    var made = HighIntermediaryRepresentation.Values.MakeObject(room_type, constructor, arguments)
    return HighIntermediaryRepresentation.Values.NumberRoom(made, number, scalar.size)
}

func is_held_in_a_box(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration'
}

func narrowed(
    value: HighIntermediaryRepresentation.Values.Value,
    path: String,
): HighIntermediaryRepresentation.Values.Value {
    var narrowed_type = context.scope.narrowed_type_of(path)
    if narrowed_type {
        var is_boxed = value.value_type.kind == 'shape' and is_held_in_a_box(narrowed_type)
        if is_boxed {
            return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'unbox', value)
        }
        return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'present', value)
    }
    return value
}

func member_value(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value {
    var named_namespace = namespace_named(member)
    if named_namespace {
        return named_namespace
    }
    var described_member = bound_parameter_member(member)
    if described_member {
        return described_member
    }
    var reflected = reflected_member(member)
    if reflected {
        return reflected
    }
    var written_target = value_of(member.target, null)
    if written_target.value_type.kind == 'handle' {
        return handle_member(written_target, member.name)
    }
    var target = written_target
    var is_a_function = target.value_type.kind == 'function' and not target.value_type.is_nullable
    if is_a_function and member.name != "class" {
        var shown_function = context.shown(target.value_type)
        typing.refuse_function_member(context, shown_function, member.name)
    }
    if member.name == "class" and not has_its_own_class(target) {
        var reflection = Reflection(context, this)
        return reflection.class_of_value(target)
    }
    if target.value_type.kind == 'shape' {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        if member.name == "attributes" {
            listing_attributes(target.value_type)
            return shape_call(target, "_attribute_list", no_arguments)
        }
        var shape_function = shape_function_value(target, member.name)
        if shape_function {
            return shape_function
        }
        return shape_call(target, member.name, no_arguments)
    }
    if target.value_type.kind == 'union' {
        var through = union_shape_of(target.value_type, member.name)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', target)
        var none_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        return shape_call(shaped, member.name, none_written)
    }
    if target.value_type.is_nullable {
        var shown_maybe = context.shown(target.value_type)
        typing.refuse_maybe_null_member(context, shown_maybe, member.name)
    }
    var owner = present_class_of(target)
    var attribute = owner.attribute_named(member.name)
    var getter = owner.function_named("get_{member.name}")
    if getter and target.value_type.kind == 'scalar' {
        typing.refuse_constant_on_value(context, owner.shown, member.name)
    }
    var is_outside = owner.key != context.current_class.key
    if not getter and is_outside {
        getter = member_template_of(owner, "get_{member.name}")
    }
    var reads_through_a_getter = is_outside or not attribute
    if reads_through_a_getter and getter {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        var read = called(getter, target, no_arguments)
        var getter_printer = Printers.Spite.ExpressionPrinter(member)
        var getter_path = getter_printer.text()
        var narrowed_type = context.scope.narrowed_type_of(getter_path)
        if narrowed_type {
            var proven = HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'proven', read)
            proven.shown = getter_path
            return proven
        }
        return read
    }
    if not attribute and owner.key == "Arguments" {
        return named_argument(target, owner, member.name)
    }
    var lists_its_attributes = not attribute and member.name == "attributes"
    if lists_its_attributes and target.value_type.kind == 'object' {
        var reflection = Reflection(context, this)
        return reflection.attributes_of_an_object(target, owner)
    }
    var can_be_bound = target.value_type.kind == 'object' or target.value_type.kind == 'scalar'
    if not attribute and can_be_bound and not target.value_type.is_nullable {
        var named_function = owner.function_named(member.name)
        if named_function {
            return bound_function_value(named_function, target)
        }
    }
    if not attribute {
        var shown = context.shown(target.value_type)
        typing.refuse_unknown_member(context, shown, member.name)
    }
    crash attribute
    if target.value_type.kind == 'scalar' {
        return number_room(target, attribute)
    }
    var read = HighIntermediaryRepresentation.Values.AttributeRead(target, attribute)
    var printer = Printers.Spite.ExpressionPrinter(member)
    var path = printer.text()
    return narrowed(read, path)
}

func bound_parameter_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var function = context.current_function
    assert not function.bound_parameter.is_empty()
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return described_by_the_parameter(target, member.name, function)
    }
    return null
}

func described_by_the_parameter(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    asked: String,
    function: Model.FunctionModel,
): HighIntermediaryRepresentation.Values.Value? {
    assert target.name == function.bound_parameter
    var integer = context.scalar_type("Integer")
    var camel = camel_case_of(function.bound_member)
    var pascal = pascal_case_of(function.bound_member)
    switch asked {
        "name": return described_text(function.bound_member)
        "camel_case_name": return described_text(camel)
        "pascal_case_name": return described_text(pascal)
        "index": return HighIntermediaryRepresentation.Values.WholeNumber(integer, function.bound_member_index)
        "class": return bound_class_object(function)
        "value": return walked_value(function)
        _: return null
    }
}

func walked_value(function: Model.FunctionModel): HighIntermediaryRepresentation.Values.Value? {
    if function.bound_member_type and not function.walked_object {
        if function.bound_member_type.kind == 'enumeration' {
            return enum_value(function.bound_member, function.bound_member_type)
        }
    }
    assert function.walked_object
    var object = walked_object_read(function)
    var model = context.class_of(function.walked_object)
    var attribute = model.attribute_named(function.bound_member)
    crash attribute
    return HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
}

func walked_object_read(function: Model.FunctionModel): HighIntermediaryRepresentation.Values.Value {
    crash function.walked_object
    var internal_name = context.scope.internal_name_of("_walked")
    crash internal_name
    return HighIntermediaryRepresentation.Values.LocalRead(function.walked_object, internal_name)
}

func bound_type_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert callee.name == "has_function" and call.arguments.count() == 1
    var target = callee.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return bound_has_function(target.name, call)
    }
    return null
}

func bound_has_function(
    bound_name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    assert bound
    var asked = call.arguments[0]
    var function_name = ""
    if asked == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        function_name = constant_text_of(asked)
    }
    assert not function_name.is_empty()
    var answer = 0
    if context.has_a_class(bound) {
        var model = context.class_of(bound)
        if model.function_named(function_name) {
            answer = 1
        }
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, answer)
}

func constant_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    crash literal.pieces.count() == 1
    var piece = literal.pieces[0]
    crash not piece.hole
    return unescaped(piece.text)
}

func bound_class_made(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var function = context.current_function
    assert callee.name == "class" and call.arguments.is_empty() and function.bound_member_type
    var target = callee.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if target.name == function.bound_parameter {
            return default_of_a_type(function.bound_member_type)
        }
    }
    return null
}

func walked_attributes(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert callee.name == "each" and call.arguments.count() == 1
    var listed = callee.target
    if listed == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_attributes_of(call, listed)
    }
    return null
}

func walked_attributes_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert listed.name == "attributes"
    var argument = call.arguments[0]
    if argument == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return walked_by(listed, argument.name)
    }
    return null
}

func walked_by(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    var walker = context.current_class.function_named(name)
    assert walker
    assert walker.parameters.count() == 1 and walker.template_index < 0
    var parameter = walker.parameters[0]
    var described = parameter.parameter_type
    var is_described = described.name == "Spite.Attribute" or described.name == "Spite.AttributeDeclaration"
    assert is_described and described.kind == 'object' and not described.is_nullable
    var class_path = class_path_of(listed.target)
    if not class_path.is_empty() {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var described_class = context.resolver.class_type_in(
            class_path,
            no_arguments,
            context.current_class,
            context.line,
        )
        return walked_over_the_attributes(walker, described_class, null)
    }
    assert described.name == "Spite.Attribute"
    var object = value_of(listed.target, null)
    assert object.value_type.kind == 'object' and not object.value_type.is_nullable
    var model = context.class_of(object.value_type)
    assert not model.attribute_named("attributes")
    var held = held_once(object)
    return walked_over_the_attributes(walker, object.value_type, held)
}

func walked_over_the_attributes(
    walker: Model.FunctionModel,
    described_class: Model.Type,
    object: HighIntermediaryRepresentation.Values.Value?,
): HighIntermediaryRepresentation.Values.Value {
    var model = context.class_of(described_class)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = walk_specialized(walker, attribute, index, described_class, object)
        need(made)
        var arguments = List<HighIntermediaryRepresentation.Values.Value>()
        if object {
            arguments.append(object)
        }
        var own = this_value()
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, own, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walk_specialized(
    walker: Model.FunctionModel,
    attribute: Model.AttributeModel,
    index: Integer,
    described_class: Model.Type,
    object: HighIntermediaryRepresentation.Values.Value?,
): Model.FunctionModel {
    var owner_name = described_class.name.replace(".", "_")
    var called_name = "{walker.name}_over_{owner_name}_{attribute.name}"
    var known = context.current_class.function_named(called_name)
    if known {
        return known
    }
    walker.template_index = 0
    var made = context.resolver.specialized(
        walker,
        called_name,
        attribute.name,
        attribute.attribute_type,
        false,
        context.current_class,
    )
    walker.template_index = -1
    made.bound_member_index = index
    if object {
        made.walked_object = described_class
        var hidden = Model.ParameterModel("_walked", described_class, false)
        made.parameters.append(hidden)
    }
    context.current_class.declared_functions.append(made)
    return made
}

func bound_class_object(function: Model.FunctionModel): HighIntermediaryRepresentation.Values.Value {
    crash function.bound_member_type
    var reflection = Reflection(context, this)
    return reflection.class_object(function.bound_member_type.name)
}

func described_text(written: String): HighIntermediaryRepresentation.Values.Value {
    need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func camel_case_of(written: String): String {
    var pascal = pascal_case_of(written)
    var first = pascal.slice(0, 1)
    var length = pascal.length()
    var rest = pascal.slice(1, length)
    var lowered = first.lower_case()
    return "{lowered}{rest}"
}

func pascal_case_of(written: String): String {
    var words = written.split("_")
    var pieces = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var length = word.length()
        var first = word.slice(0, 1)
        var rest = word.slice(1, length)
        var raised = first.upper_case()
        pieces.append("{raised}{rest}")
        index = index + 1
    }
    return pieces.join("")
}

func namespace_named(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    var path = class_path_of(expression)
    assert not path.is_empty()
    var written = path.join(".")
    var folder = context.resolver.symbols.namespace_folder(written)
    assert folder
    var reflection = Reflection(context, this)
    return reflection.namespace_object(folder.namespace)
}

func reflected_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var class_path = class_path_of(member.target)
    assert not class_path.is_empty()
    var written = class_path.join(".")
    var reflection = Reflection(context, this)
    if written == "Spite.Class" and member.name == "instances" {
        return reflection.every_class()
    }
    if written == "Spite.Namespace" and member.name == "instances" {
        return reflection.every_namespace()
    }
    if member.name == "size" {
        var sized = shape_size_of(class_path)
        if sized {
            return sized
        }
    }
    var described_path = class_path_of(member.target)
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    if found or scalars.is_a_scalar(written) {
        var number_constant = class_constant(described_path, no_type_arguments, member.name)
        if number_constant {
            return number_constant
        }
    }
    var object = reflected_object_of(member.target)
    assert object
    var reflection_model = context.class_of(object.value_type)
    var getter = reflection_model.function_named("get_{member.name}")
    assert getter
    var no_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    return called(getter, object, no_written)
}

func shape_size_of(path: List<String>): HighIntermediaryRepresentation.Values.Value? {
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    assert described.kind == 'shape'
    var shape = context.program.shape_keyed(described.name)
    crash shape
    var offset = 0
    var widest = 1
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        var width = width_in_a_type(member.answer)
        if width > widest {
            widest = width
        }
        var past = offset % width
        if past > 0 {
            offset = offset + width - past
        }
        offset = offset + width
        index = index + 1
    }
    var tail = offset % widest
    if tail > 0 {
        offset = offset + widest - tail
    }
    var integer = context.scalar_type("Integer")
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, offset)
}

func width_in_a_type(held: Model.Type): Integer {
    var scalar = scalars.of(held.name)
    if held.kind == 'scalar' and scalar {
        return scalar.size
    }
    return 8
}

func class_constant(
    path: List<String>,
    no_type_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    var described = context.resolver.class_type_in(path, no_type_arguments, context.current_class, context.line)
    assert described.kind == 'scalar'
    var model = context.class_of(described)
    var getter = model.function_named("get_{name}")
    assert getter
    var receiver = HighIntermediaryRepresentation.Values.WholeNumber(described, 0)
    var no_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    return called(getter, receiver, no_written)
}

func reflected_object_of(
    target: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    var class_path = class_path_of(target)
    assert not class_path.is_empty()
    var written = class_path.join(".")
    var reflection = Reflection(context, this)
    var folder = context.resolver.symbols.namespace_folder(written)
    if folder {
        return reflection.namespace_object(folder.namespace)
    }
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    assert found or scalars.is_a_scalar(written)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    assert is_a_class
    return reflection.class_object(described.name)
}

func reflected_receiver(
    target: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    return reflected_object_of(target)
}

func called_on_a_class(
    receiver: HighIntermediaryRepresentation.Values.Value,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var owner = context.class_of(receiver.value_type)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    return called(function, receiver, written)
}

func has_its_own_class(target: HighIntermediaryRepresentation.Values.Value): Boolean {
    if not context.has_a_class(target.value_type) {
        return false
    }
    var owner = context.class_of(target.value_type)
    if owner.attribute_named("class") {
        return true
    }
    if owner.function_named("get_class") {
        return true
    }
    return false
}

func named_argument(
    target: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    var named = owner.function_named("named")
    crash named
    need(named)
    need_text_constants()
    var flag = name.replace("_", "-")
    var text = HighIntermediaryRepresentation.Values.TextConstant(flag)
    text.value_type = context.text()
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(text)
    return HighIntermediaryRepresentation.Values.Call(named, target, arguments)
}

func present_class_of(value: HighIntermediaryRepresentation.Values.Value): Model.ClassModel {
    var value_type = value.value_type
    if value_type.is_nullable {
        var shown = context.shown(value_type)
        typing.refuse_maybe_null(context, shown)
    }
    if not context.has_a_class(value_type) {
        var shown_type = context.shown(value_type)
        typing.refuse_no_members(context, shown_type)
    }
    return context.class_of(value_type)
}

func call_value(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value {
    var maker = call.callee
    if maker == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if is_a_handle_maker(maker.name) and call.arguments.count() == 1 {
            return handle_value(maker.name, call)
        }
        if maker.name.starts_with("$") {
            return made_from_a_bound_type(call, maker.name)
        }
    }
    var class_path = class_path_of(call.callee)
    if not class_path.is_empty() {
        return constructed(call, class_path)
    }
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if is_a_handle_maker(callee.name) and call.arguments.count() == 1 {
            return handle_value(callee.name, call)
        }
        return own_call(call, callee.name)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_call(call, callee)
    }
    return unbuilt()
}

func made_from_a_bound_type(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    var bound = context.current_class.bound_types[name]
    if not bound {
        typing.refuse_unknown_name(context, name)
    }
    crash bound
    var made_type = bound.present()
    var is_plain = made_type.kind == 'scalar' or made_type.name == "String"
    if is_plain and call.arguments.is_empty() {
        var plain = default_of_a_type(made_type)
        crash plain
        return plain
    }
    var made = context.class_of(made_type)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    if constructor {
        need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func is_a_handle_maker(name: String): Boolean {
    var is_named = name == "Parallel" or name == "Concurrent"
    if context.current_class.function_named(name) {
        return false
    }
    return is_named
}

func handle_value(
    name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value {
    var work = call.arguments[0]
    var done = work_of(work)
    var handle_type = context.resolver.handle_of(name, done.value_type)
    need_the_scheduler(handle_type)
    return HighIntermediaryRepresentation.Values.Conversion(handle_type, 'into_handle', done)
}

func need_the_scheduler(handle_type: Model.Type) {
    context.makes_work = true
    var work_type = Model.Type('object', handle_type.carrier)
    var work_model = context.class_of(work_type)
    context.need_defaults(work_model.key)
    need_every_function(work_model)
    var running = context.resolver.class_model_named("Spite.Internal.Running")
    crash running
    context.need_defaults(running.key)
    need_every_function(running)
    var scheduler = context.resolver.class_model_named("Spite.Internal.Scheduler")
    crash scheduler
    context.need_defaults(scheduler.key)
    need_every_function(scheduler)
}

func need_every_function(model: Model.ClassModel) {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.has_a_body() {
            need(function)
        }
        index = index + 1
    }
}

func work_call(
    handle: HighIntermediaryRepresentation.Values.Value,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    var work_type = Model.Type('object', handle.value_type.carrier)
    var work_model = context.class_of(work_type)
    var function = work_model.function_named(name)
    crash function
    need(function)
    var no_values = List<HighIntermediaryRepresentation.Values.Value>()
    return HighIntermediaryRepresentation.Values.Call(function, handle, no_values)
}

func work_of(work: AbstractSyntaxTree.Shapes.Expressions.Expression?): HighIntermediaryRepresentation.Values.Value {
    var no_arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    if work == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return work_named(work, no_arguments)
    }
    if work == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var receiver = value_of(work.target, null)
        if receiver.value_type.kind == 'shape' {
            var through = shape_function_value(receiver, work.name)
            crash through
            var nothing_passed = List<HighIntermediaryRepresentation.Values.Value>()
            var called_through = HighIntermediaryRepresentation.Values.FunctionValueCall(through, nothing_passed)
            if through.value_type.answer {
                called_through.value_type = through.value_type.answer
            }
            return called_through
        }
        var owner = present_class_of(receiver)
        var function = owner.function_named(work.name)
        if not function {
            var shown = context.shown(receiver.value_type)
            typing.refuse_unknown_member(context, shown, work.name)
        }
        crash function
        return called(function, receiver, no_arguments)
    }
    var value = value_of(work, null)
    var runs_a_call = work == AbstractSyntaxTree.Shapes.Expressions.CallExpression and value.value_type.kind != 'function'
    if runs_a_call {
        return value
    }
    var no_values = List<HighIntermediaryRepresentation.Values.Value>()
    return HighIntermediaryRepresentation.Values.FunctionValueCall(value, no_values)
}

func work_named(
    work: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    no_arguments: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var internal_name = context.scope.internal_name_of(work.name)
    if internal_name {
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var local = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
        var no_values = List<HighIntermediaryRepresentation.Values.Value>()
        var made = HighIntermediaryRepresentation.Values.FunctionValueCall(local, no_values)
        if local_type.answer {
            made.value_type = local_type.answer
        }
        return made
    }
    var function = context.current_class.function_named(work.name)
    if not function {
        typing.refuse_unknown_name(context, work.name)
    }
    crash function
    var own = this_value()
    return called(function, own, no_arguments)
}

func result_of_handle(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    if value.value_type.kind != 'handle' {
        return value
    }
    crash value.value_type.answer
    var answer: Model.Type = value.value_type.answer
    return HighIntermediaryRepresentation.Values.Conversion(answer, 'join', value)
}

func refuse_a_cast_by_name(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var class_path = class_path_of(callee.target)
    var written = class_path.join(".")
    assert scalars.is_a_scalar(written)
    typing.refuse_cast_by_name(context, written, callee.name)
}

func class_path_of(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): List<String> {
    var inference = NameResolution.Inference()
    return inference.class_path_of(expression)
}

func tested_class_path_of(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): List<String> {
    var path = List<String>()
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if expression.name.starts_with("$") {
            path.append(expression.name)
            return path
        }
    }
    return class_path_of(expression)
}

func constructed(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
): HighIntermediaryRepresentation.Values.Value {
    var inferred = inferred_type_of(call, class_path)
    var made_type = inferred
    if not made_type {
        made_type = context.resolver.class_type_in(
            class_path,
            call.generic_arguments,
            context.current_class,
            context.line,
        )
    }
    crash made_type
    var made = context.class_of(made_type)
    var constraints = Constraints(context, this)
    constraints.check(made)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    if constructor {
        need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    } else {
        var no_parameters = List<Model.ParameterModel>()
        arguments = arguments_for(made.shown, no_parameters, call.arguments)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func inferred_type_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
): Model.Type? {
    assert call.generic_arguments.is_empty()
    var written = class_path.join(".")
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    assert found
    var file = context.resolver.symbols.file_for(found.path)
    assert file
    assert context.resolver.is_a_template(file)
    var argument_types = List<Model.Type>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var value = value_of(argument, null)
        argument_types.append(value.value_type)
        index = index + 1
    }
    return context.resolver.inferred_instance(class_path, context.current_class, context.line, argument_types)
}

func constructor_of(made: Model.ClassModel): Model.FunctionModel? {
    var index = 0
    while index < made.declared_functions.count() {
        var function = made.declared_functions[index]
        if function.is_constructor {
            return function
        }
        index = index + 1
    }
    return null
}

func enum_read_from(
    receiver: HighIntermediaryRepresentation.Values.Value,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value? {
    var given = receiver.value_type
    var reads_text = given.kind == 'object' and given.name == "String" and not given.is_nullable
    assert reads_text and written.is_empty() and name.starts_with("to_")
    var length = name.length()
    var enum_words = name.slice(3, length)
    var enum_name = pascal_case_of(enum_words)
    var enumeration = context.current_class.enum_named(enum_name)
    assert enumeration
    var enum_type = Model.Type('enumeration', enumeration.key)
    var wanted = enum_type.nullable()
    return fitted(receiver, wanted)
}

func class_form_call(
    receiver: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value? {
    var element = owner.bound_types["$element_type"]
    assert element and written.is_empty()
    assert element.kind == 'union' and not element.is_nullable
    var forms = ["filter", "count", "any", "all", "remove_where"]
    var index = 0
    while index < forms.count() {
        var form = forms[index]
        var prefix = "{form}_"
        if name.starts_with(prefix) {
            var prefix_length = prefix.length()
            var name_length = name.length()
            var written_class = name.slice(prefix_length, name_length)
            var member = union_member_class(element, written_class)
            if member {
                var making = PassedForms(context, this)
                var made = making.class_form(owner, form, member)
                crash made
                var no_values = List<HighIntermediaryRepresentation.Values.Value>()
                return HighIntermediaryRepresentation.Values.Call(made, receiver, no_values)
            }
        }
        index = index + 1
    }
    return null
}

func union_member_class(element: Model.Type, written: String): Model.Type? {
    var candidates = singular_candidates(written, true)
    var united = union_model_of(element)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var pascal = pascal_case_of(candidate)
        var member_index = 0
        while member_index < united.members.count() {
            var held = united.members[member_index]
            var parts = held.name.split(".")
            var last = parts.count() - 1
            var simple = parts[last]
            if simple == pascal {
                return held
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
    return null
}

func passed_form(
    receiver: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value? {
    var is_a_form = name == "count" or name == "sum"
    assert is_a_form and written.count() == 1 and owner.bound_types["$element_type"]
    if name == "count" {
        var counting = owner.function_named("count_where")
        crash counting
        return called(counting, receiver, written)
    }
    var measure = value_of(written[0], null)
    assert measure.value_type.kind == 'function'
    assert measure.value_type.answer
    assert measure.value_type.answer.name != "Integer"
    var forms = PassedForms(context, this)
    var summing = forms.sum_for(owner, measure.value_type)
    assert summing
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(measure)
    return HighIntermediaryRepresentation.Values.Call(summing, receiver, arguments)
}

func made_copy(owner: Model.ClassModel, name: String, argument_count: Integer): Model.FunctionModel? {
    var asks_a_copy = name == "copy" or name == "deep_copy"
    assert asks_a_copy and argument_count == 0 and not owner.is_singleton
    var copying = Copying(context, this)
    return copying.copy_of(owner, name == "deep_copy")
}

func own_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return function_value_call(call, name)
    }
    var rebound = rebound_template_call(call, name)
    if rebound {
        return rebound
    }
    var function = context.current_class.function_named(name)
    if not function {
        function = member_template_of(context.current_class, name)
    }
    if not function {
        var walked = walk_of(context.current_class, name, call.arguments)
        if walked {
            return walked
        }
    }
    if not function and name == "_deep_copied" and call.arguments.count() == 1 {
        var copied_value = value_of(call.arguments[0], null)
        var copying = Copying(context, this)
        return copying.deep_copied(copied_value)
    }
    if not function {
        typing.refuse_unknown_function(context, name)
    }
    crash function
    var own = this_value()
    return called(function, own, call.arguments)
}

func rebound_template_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    var parameter = context.current_function.bound_parameter
    assert not parameter.is_empty()
    var words = name.split("_")
    assert words.contains(parameter)
    var passed = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    var found = false
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if names_the_member(argument, parameter) {
            found = true
        } else {
            passed.append(argument)
        }
        index = index + 1
    }
    assert found
    var renamed = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word == parameter {
            renamed.append(context.current_function.bound_member)
        } else {
            renamed.append(word)
        }
        word_index = word_index + 1
    }
    var called_name = renamed.join("_")
    var function = member_template_of(context.current_class, called_name)
    assert function
    var own = this_value()
    return called(function, own, passed)
}

func names_the_member(argument: AbstractSyntaxTree.Shapes.Expressions.Expression, name: String): Boolean {
    if argument == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return argument.name == name
    }
    return false
}

func function_value_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var local_type = context.scope.type_of(internal_name)
    crash local_type
    if local_type.kind != 'function' {
        var shown = context.shown(local_type)
        typing.refuse_not_callable(context, name, shown)
    }
    var called_value = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var wanted = local_type.parameters[index]
        crash wanted
        var value = fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    var made = HighIntermediaryRepresentation.Values.FunctionValueCall(called_value, arguments)
    if local_type.answer {
        made.value_type = local_type.answer
    }
    return made
}

func member_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value {
    var walked = walked_attributes(call, callee)
    if walked {
        return walked
    }
    var asked = bound_type_question(call, callee)
    if asked {
        return asked
    }
    var made_default = bound_class_made(call, callee)
    if made_default {
        return made_default
    }
    var class_receiver = reflected_receiver(callee.target)
    if class_receiver {
        return called_on_a_class(class_receiver, callee.name, call.arguments)
    }
    var written_receiver = value_of(callee.target, null)
    if written_receiver.value_type.kind == 'handle' and callee.name == "finished_value" {
        return work_call(written_receiver, "finished_value")
    }
    var receiver = result_of_handle(written_receiver)
    if receiver.value_type.kind == 'shape' {
        return shape_call(receiver, callee.name, call.arguments)
    }
    if receiver.value_type.kind == 'union' {
        var through = union_shape_of(receiver.value_type, callee.name)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', receiver)
        return shape_call(shaped, callee.name, call.arguments)
    }
    var is_an_enum = receiver.value_type.kind == 'enumeration' and not receiver.value_type.is_nullable
    if is_an_enum and callee.name == "to_string" and call.arguments.is_empty() {
        return enum_text(receiver)
    }
    if is_an_enum and callee.name == "to_debug" and call.arguments.is_empty() {
        var debugging = Debugging(context, this)
        return debugging.debug_text_of(receiver)
    }
    var read_enum = enum_read_from(receiver, callee.name, call.arguments)
    if read_enum {
        return read_enum
    }
    var owner = present_class_of(receiver)
    var passed = passed_form(receiver, owner, callee.name, call.arguments)
    if passed {
        return passed
    }
    var filtered_by_class = class_form_call(receiver, owner, callee.name, call.arguments)
    if filtered_by_class {
        return filtered_by_class
    }
    var function = owner.function_named(callee.name)
    if not function {
        function = member_template_of(owner, callee.name)
    }
    if not function {
        var through_values = dictionary_template(receiver, owner, callee.name, call.arguments)
        if through_values {
            return through_values
        }
    }
    if not function and callee.name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var written_count = call.arguments.count()
    if not function {
        function = made_copy(owner, callee.name, written_count)
    }
    if not function and owner.key == "DynamicLibrary" {
        return foreign_call(receiver, callee.name, call.arguments)
    }
    if not function and callee.name.starts_with("from_") {
        refuse_a_cast_by_name(callee)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, callee.name)
    }
    crash function
    return called(function, receiver, call.arguments)
}

func member_template_of(owner: Model.ClassModel, name: String): Model.FunctionModel? {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        if template.is_a_member_template {
            var made = specialized_for(owner, template, name)
            if made {
                return made
            }
        }
        index = index + 1
    }
    return null
}

func dictionary_template(
    receiver: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value? {
    assert owner.bound_types["$value_type"]
    var values_function = owner.function_named("values")
    assert values_function
    var no_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    var listed = called(values_function, receiver, no_written)
    var list_model = present_class_of(listed)
    var template = member_template_of(list_model, name)
    assert template
    return called(template, listed, written)
}

func specialized_for(owner: Model.ClassModel, template: Model.FunctionModel, name: String): Model.FunctionModel? {
    var member_owner = context.resolver.template_owner_of(template, owner)
    assert member_owner
    var owner_type: Model.Type = member_owner
    var match = template_match(template, name)
    assert match
    switch owner_type.kind {
        'shape': return specialized_over_a_shape(owner, template, owner_type, name, match)
        'namespace': return specialized_over_a_namespace(owner, template, name, match)
        'parameters': return specialized_over_parameters(owner, template, owner_type, name, match)
        'union': return specialized_over_a_union(owner, template, owner_type, name, match)
        'enumeration': return specialized_over_values(owner, template, owner_type, name, match)
        _: return specialized_over_a_class(owner, template, owner_type, name, match)
    }
}

func specialized_over_a_class(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    assert context.has_a_class(owner_type) and not owner_type.is_nullable
    var element_class = context.class_of(owner_type)
    var match_parts = match.split("|")
    var written = match_parts[0]
    crash written
    var is_plural = match_parts.count() > 1
    var member = member_of(element_class, written, is_plural)
    if member.is_empty() {
        member = member_of(element_class, "is_{written}", is_plural)
    }
    assert not member.is_empty()
    var attribute = element_class.attribute_named(member)
    var member_type = context.boolean()
    var is_a_function = true
    var member_index = 0
    if attribute {
        member_type = attribute.attribute_type
        is_a_function = false
        member_index = attribute_index_of(element_class, member)
    } else {
        var function = element_class.function_named(member)
        crash function
        member_type = answer_or_nothing(function)
    }
    var made = context.resolver.specialized(template, name, member, member_type, is_a_function, owner)
    made.bound_member_index = member_index
    owner.declared_functions.append(made)
    return made
}

func specialized_over_a_shape(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var shape = context.program.shape_keyed(owner_type.name)
    crash shape
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var member = shape.member_named(candidate)
        if member {
            var member_type = answer_or_nothing(member)
            var made = context.resolver.specialized(template, name, candidate, member_type, false, owner)
            made.bound_shape = shape.key
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func specialized_over_a_union(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var answered = union_member_name(owner_type, candidate)
        if not answered.is_empty() {
            var shape = union_shape_of(owner_type, answered)
            var member = shape.members[0]
            crash member
            var member_type = answer_or_nothing(member)
            var made = context.resolver.specialized(template, name, answered, member_type, false, owner)
            made.bound_shape = shape.key
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func union_member_name(union_type: Model.Type, wanted: String): String {
    var united = union_model_of(union_type)
    if every_member_has(united, wanted) {
        return wanted
    }
    var getter = "get_{wanted}"
    if every_member_has(united, getter) {
        return getter
    }
    return ""
}

func every_member_has(united: Model.UnionModel, wanted: String): Boolean {
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        if not context.has_a_class(held) {
            return false
        }
        var model = context.class_of(held)
        var has_it = model.attribute_named(wanted) or model.function_named(wanted)
        if not has_it {
            return false
        }
        index = index + 1
    }
    return true
}

func singular_candidates(written: String, is_plural: Boolean): List<String> {
    var candidates = List<String>()
    if not is_plural {
        candidates.append(written)
        return candidates
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        candidates.append("{stem}y")
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        candidates.append(without_s)
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        candidates.append(without_es)
    }
    candidates.append(written)
    return candidates
}

func specialized_over_a_namespace(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var model = context.resolver.class_model_named(written)
    assert model
    var member_type = Model.Type('object', model.key)
    var made = context.resolver.specialized(template, name, model.shown, member_type, false, owner)
    owner.declared_functions.append(made)
    return made
}

func specialized_over_values(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var enumeration = enum_model_of(owner_type)
    var index = enumeration.values.index_of(written)
    assert index
    var made = context.resolver.specialized(template, name, written, owner_type, false, owner)
    made.bound_member_index = index
    owner.declared_functions.append(made)
    return made
}

func specialized_over_parameters(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var walked = context.resolver.function_of_parameters(owner_type)
    assert walked
    var index = 0
    while index < walked.parameters.count() {
        var parameter = walked.parameters[index]
        if parameter.name == written {
            var made = context.resolver.specialized(template, name, written, parameter.parameter_type, false, owner)
            made.bound_member_index = index
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func template_match(template: Model.FunctionModel, name: String): String? {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    var place = words.index_of(parameter.name)
    var is_plural = false
    if not place {
        place = words.index_of("{parameter.name}s")
        is_plural = true
    }
    crash place
    var before = List<String>()
    var after = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word_index < place {
            before.append(word)
        }
        if word_index > place {
            after.append(word)
        }
        word_index = word_index + 1
    }
    var prefix = before.join("_")
    if not prefix.is_empty() {
        prefix = "{prefix}_"
    }
    var suffix = after.join("_")
    if not suffix.is_empty() {
        suffix = "_{suffix}"
    }
    var fits = name.starts_with(prefix) and name.ends_with(suffix)
    var fixed_length = prefix.length() + suffix.length()
    assert fits and name.length() > fixed_length
    var prefix_length = prefix.length()
    var middle_end = name.length() - suffix.length()
    var written = name.slice(prefix_length, middle_end)
    if is_plural {
        return "{written}|plural"
    }
    return written
}

func walk_of(
    owner: Model.ClassModel,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value? {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and "{template.name}s" == name {
            return walked_over(owner, template, written)
        }
        index = index + 1
    }
    return null
}

func template_takes_a_plural(template: Model.FunctionModel): Boolean {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    return not words.contains(parameter.name)
}

func walked_over(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var member_owner = context.resolver.template_owner_of(template, owner)
    crash member_owner
    var names = walked_names(member_owner)
    var index = 0
    while index < names.count() {
        var member = names[index]
        var word = walked_word(template)
        var called_name = template.name.replace(word, member)
        var function = member_template_of(owner, called_name)
        crash function
        var own = this_value()
        var made = called(function, own, written)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(made)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walked_word(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return parameter.name
}

func walked_names(member_owner: Model.Type): List<String> {
    var names = List<String>()
    if member_owner.kind == 'namespace' {
        return classes_of_a_namespace(member_owner.name)
    }
    if member_owner.kind == 'parameters' {
        return parameters_of(member_owner)
    }
    if member_owner.kind == 'enumeration' {
        var enumeration = enum_model_of(member_owner)
        return enumeration.values
    }
    var is_walked = member_owner.kind == 'object' or member_owner.kind == 'shape'
    if member_owner.is_nullable or not is_walked {
        return names
    }
    if member_owner.kind == 'shape' {
        var shape = context.program.shape_keyed(member_owner.name)
        crash shape
        var shape_index = 0
        while shape_index < shape.members.count() {
            var member = shape.members[shape_index]
            if member.is_an_attribute {
                names.append(member.name)
            }
            shape_index = shape_index + 1
        }
        return names
    }
    var model = context.class_of(member_owner)
    if model.bound_types["$element_type"] or model.bound_types["$value_type"] {
        return names
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        names.append(attribute.name)
        index = index + 1
    }
    return names
}

func parameters_of(owner: Model.Type): List<String> {
    var walked = context.resolver.function_of_parameters(owner)
    crash walked
    return walked.parameters.map_names()
}

func classes_of_a_namespace(namespace: String): List<String> {
    var names = List<String>()
    var folder = context.resolver.symbols.namespace_folder(namespace)
    crash folder
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var model = context.resolver.class_model_named(file.namespace)
        if model {
            names.append(model.shown)
        }
        index = index + 1
    }
    return names
}

func attribute_index_of(model: Model.ClassModel, name: String): Integer {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.name == name {
            return index
        }
        index = index + 1
    }
    crash
}

func answer_or_nothing(function: Model.FunctionModel): Model.Type {
    if function.answer {
        return function.answer
    }
    return Model.Type('nothing', "")
}

func member_of(element_class: Model.ClassModel, written: String, is_plural: Boolean): String {
    if not is_plural {
        return member_named(element_class, written)
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        var found = member_named(element_class, "{stem}y")
        if not found.is_empty() {
            return found
        }
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        var found_without_s = member_named(element_class, without_s)
        if not found_without_s.is_empty() {
            return found_without_s
        }
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        var found_without_es = member_named(element_class, without_es)
        if not found_without_es.is_empty() {
            return found_without_es
        }
    }
    return member_named(element_class, written)
}

func member_named(element_class: Model.ClassModel, wanted: String): String {
    if element_class.attribute_named(wanted) {
        return wanted
    }
    var function = element_class.function_named(wanted)
    var getter = element_class.function_named("get_{wanted}")
    if not function and getter {
        return "get_{wanted}"
    }
    if not function {
        return ""
    }
    if not function.parameters.is_empty() {
        return ""
    }
    return wanted
}

func bound_member_read(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var function = context.current_function
    assert function.bound_member_type
    var target = index.target
    if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return bound_attribute_read(index, target, function)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return own_bound_read(target, function)
    }
    return null
}

func own_bound_read(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): HighIntermediaryRepresentation.Values.Value? {
    assert target.name == "attributes"
    var item = this_value()
    return bound_member_of(item, function)
}

func bound_attribute_read(
    _index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
): HighIntermediaryRepresentation.Values.Value? {
    assert target.name == "attributes"
    var item = value_of(target.target, null)
    return bound_member_of(item, function)
}

func bound_member_of(
    item: HighIntermediaryRepresentation.Values.Value,
    function: Model.FunctionModel,
): HighIntermediaryRepresentation.Values.Value {
    if item.value_type.kind == 'shape' {
        var no_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        return shape_call(item, function.bound_member, no_written)
    }
    if item.value_type.kind == 'union' and not function.bound_shape.is_empty() {
        var as_shape = Model.Type('shape', function.bound_shape)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', item)
        var none_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        return shape_call(shaped, function.bound_member, none_written)
    }
    var owner = present_class_of(item)
    if function.bound_member_is_a_function {
        var called_function = owner.function_named(function.bound_member)
        crash called_function
        var no_arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        return called(called_function, item, no_arguments)
    }
    var attribute = owner.attribute_named(function.bound_member)
    crash attribute
    if item.value_type.kind == 'scalar' {
        return number_room(item, attribute)
    }
    return HighIntermediaryRepresentation.Values.AttributeRead(item, attribute)
}

func handle_member(
    handle: HighIntermediaryRepresentation.Values.Value,
    name: String,
): HighIntermediaryRepresentation.Values.Value {
    if name == "finished" {
        return work_call(handle, "get_finished")
    }
    var result = result_of_handle(handle)
    var no_written = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    var owner = present_class_of(result)
    var attribute = owner.attribute_named(name)
    if attribute {
        return HighIntermediaryRepresentation.Values.AttributeRead(result, attribute)
    }
    var getter = owner.function_named("get_{name}")
    if not getter {
        var shown = context.shown(result.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash getter
    return called(getter, result, no_written)
}

func union_shape_of(union_type: Model.Type, name: String): Model.ShapeModel {
    var shown = context.shown(union_type)
    if union_type.is_nullable {
        typing.refuse_maybe_null(context, shown)
    }
    var united = union_model_of(union_type)
    var key = "{united.key}|{name}"
    var known = context.program.shape_keyed(key)
    if known {
        return known
    }
    var made = Model.ShapeModel(key, united.name)
    var fillers = context.program.fillers_of(key)
    var member: Model.FunctionModel? = null
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var model = context.class_of(held)
        var answered = member_answered_by(model, name, shown)
        if not member {
            member = answered
        }
        fillers.append(held)
        index = index + 1
    }
    crash member
    made.members.append(member)
    context.program.shapes[key] = made
    return made
}

func member_answered_by(model: Model.ClassModel, name: String, shown: String): Model.FunctionModel {
    var attribute = model.attribute_named(name)
    if attribute {
        var read = Model.FunctionModel(name, model.key)
        read.is_an_attribute = true
        read.answer = attribute.attribute_type
        return read
    }
    var function = model.function_named(name)
    if not function {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    need(function)
    return function
}

func listing_attributes(shape_type: Model.Type) {
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    assert not shape.member_named("_attribute_list")
    var reflection = Reflection(context, this)
    var attribute_type = reflection.reflection_type("Spite.Attribute")
    var list_type = context.resolver.list_type_of(attribute_type)
    var member = Model.FunctionModel("_attribute_list", shape.key)
    member.answer = list_type
    shape.members.append(member)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if context.has_a_class(filler) {
            var model = context.class_of(filler)
            reflection.attribute_list_of(model)
        } else {
            reflection.no_attributes()
        }
        index = index + 1
    }
}

func shape_function_value(
    target: HighIntermediaryRepresentation.Values.Value,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    var shape = context.program.shape_keyed(target.value_type.name)
    crash shape
    var member = shape.member_named(name)
    assert member
    assert not member.is_an_attribute
    var owner = context.current_class
    var key = target.value_type.name.replace(".", "_")
    var synthetic_name = "_{name}_through_{key}"
    var made = owner.function_named(synthetic_name)
    if not made {
        made = through_the_shape(owner, synthetic_name, target.value_type, member)
    }
    crash made
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = made.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = made.answer
    return HighIntermediaryRepresentation.Values.FunctionValue(function_type, made, target)
}

func through_the_shape(
    owner: Model.ClassModel,
    synthetic_name: String,
    shape_type: Model.Type,
    member: Model.FunctionModel,
): Model.FunctionModel {
    var made = Model.FunctionModel(synthetic_name, owner.key)
    made.is_synthetic = true
    made.answer = member.answer
    made.parameters = member.parameters
    owner.declared_functions.append(made)
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    var own = HighIntermediaryRepresentation.Values.ThisRead(shape_type)
    var passed = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        var read = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, parameter.name)
        passed.append(read)
        index = index + 1
    }
    var through = HighIntermediaryRepresentation.Values.ShapeCall(shape, member, own, passed)
    var body = HighIntermediaryRepresentation.Statements.Block()
    if member.answer {
        var answered = HighIntermediaryRepresentation.Statements.Return(through)
        body.statements.append(answered)
    } else {
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(through)
        body.statements.append(evaluated)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func shape_call(
    receiver: HighIntermediaryRepresentation.Values.Value,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var shown = context.shown(receiver.value_type)
    if receiver.value_type.is_nullable {
        typing.refuse_maybe_null(context, shown)
    }
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var member = shape.member_named(name)
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    var arguments = arguments_for(shown, member.parameters, written)
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func called(
    function: Model.FunctionModel,
    receiver: HighIntermediaryRepresentation.Values.Value,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    if takes_numbers(function) and written.count() == function.parameters.count() {
        return number_call(function, receiver, written)
    }
    need(function)
    var arguments = fitted_arguments(function, written)
    return HighIntermediaryRepresentation.Values.Call(function, receiver, arguments)
}

func takes_numbers(function: Model.FunctionModel): Boolean {
    if not function.has_a_body() or not function.number_copy_of.is_empty() {
        return false
    }
    if not function.declaration {
        return false
    }
    return writes_a_number(function.declaration)
}

func writes_a_number(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if is_written_number(parameter.declared_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_written_number(written: AbstractSyntaxTree.Shapes.Types.Type?): Boolean {
    if written == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        return path == "Number"
    }
    return false
}

func is_the_number_shape(of_type: Model.Type): Boolean {
    return of_type.kind == 'shape' and of_type.name == "Number" and not of_type.is_nullable
}

func number_call(
    function: Model.FunctionModel,
    receiver: HighIntermediaryRepresentation.Values.Value,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var type_names = List<String>()
    var positions = List<Integer>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = written[index]
        if is_the_number_shape(parameter.parameter_type) {
            add_a_number(argument, parameter, index, arguments, type_names, positions)
        } else {
            var fitted_argument = fitted_value_of(argument, parameter.parameter_type)
            type_names.append(parameter.parameter_type.name)
            arguments.append(fitted_argument)
        }
        index = index + 1
    }
    if positions.is_empty() {
        var copy = number_copy(function, type_names)
        return HighIntermediaryRepresentation.Values.Call(copy, receiver, arguments)
    }
    var dispatched = HighIntermediaryRepresentation.Values.Call(function, receiver, arguments)
    dispatched.number_positions = positions
    dispatched.number_types = type_names
    context.number_dispatches.append(dispatched)
    copies_for(dispatched)
    return dispatched
}

func add_a_number(
    argument: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    parameter: Model.ParameterModel,
    index: Integer,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
    type_names: List<String>,
    positions: List<Integer>,
) {
    var given = value_of(argument, null)
    var given_type = given.value_type
    if given_type.kind == 'scalar' and not given_type.is_nullable {
        type_names.append(given_type.name)
        arguments.append(given)
        return
    }
    var shaped = fitted(given, parameter.parameter_type)
    type_names.append("")
    positions.append(index)
    arguments.append(shaped)
}

func copies_for(dispatched: HighIntermediaryRepresentation.Values.Call) {
    var chosen = List<String>()
    dispatched.number_types.each(chosen.append)
    copies_from(dispatched, chosen, 0)
}

func copies_from(
    dispatched: HighIntermediaryRepresentation.Values.Call,
    chosen: List<String>,
    position_index: Integer,
) {
    if position_index == dispatched.number_positions.count() {
        number_copy(dispatched.function, chosen)
        return
    }
    var position = dispatched.number_positions[position_index]
    crash position
    var fillers = context.program.fillers_of("Number")
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var picked = List<String>()
        chosen.each(picked.append)
        picked[position] = filler.name
        copies_from(dispatched, picked, position_index + 1)
        index = index + 1
    }
}

func number_copy(function: Model.FunctionModel, type_names: List<String>): Model.FunctionModel {
    var owner = context.program.class_named(function.owner)
    crash owner
    var name = function.number_copy_name(type_names)
    var known = owner.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, function.owner)
    made.declaration = function.declaration
    made.answer = function.answer
    made.number_copy_of = function.name
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.parameter_type
        if is_the_number_shape(parameter_type) {
            var type_name = type_names[index]
            crash type_name
            parameter_type = Model.Type('scalar', type_name)
        }
        var copied = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
        made.parameters.append(copied)
        index = index + 1
    }
    owner.declared_functions.append(made)
    need(made)
    return made
}

func method_call(
    receiver: HighIntermediaryRepresentation.Values.Value,
    name: String,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
): HighIntermediaryRepresentation.Values.Value {
    if receiver.value_type.kind == 'shape' {
        return shape_method_call(receiver, name, arguments)
    }
    var owner = present_class_of(receiver)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function and name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var given_count = arguments.count()
    if not function {
        function = made_copy(owner, name, given_count)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    need(function)
    var given = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var parameter = function.parameters[index]
        crash parameter
        var fitted_argument = fitted(argument, parameter.parameter_type)
        given.append(fitted_argument)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(function, receiver, given)
}

func shape_method_call(
    receiver: HighIntermediaryRepresentation.Values.Value,
    name: String,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
): HighIntermediaryRepresentation.Values.Value {
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var member = shape.member_named(name)
    if not member {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func fitted_arguments(
    function: Model.FunctionModel,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value> {
    var spread = spread_arguments(function, written)
    if spread {
        return spread
    }
    var shown = "{function.owner}.{function.name}"
    return arguments_for(shown, function.parameters, written)
}

func spread_arguments(
    function: Model.FunctionModel,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value>? {
    assert written.count() == 1
    var only = written[0]
    if only == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return spread_of(function, only)
    }
    return null
}

func spread_of(
    function: Model.FunctionModel,
    spreading: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<HighIntermediaryRepresentation.Values.Value>? {
    var callee = spreading.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return spread_by(function, callee.name, spreading.arguments)
    }
    return null
}

func spread_by(
    function: Model.FunctionModel,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value>? {
    var owner = context.current_class
    assert not owner.function_named(name)
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and "{template.name}s" == name {
            return spread_over(function, owner, template, written)
        }
        index = index + 1
    }
    return null
}

func spread_over(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value>? {
    var member_owner = context.resolver.template_owner_of(template, owner)
    assert member_owner
    assert member_owner.kind == 'parameters'
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var word = walked_word(template)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var called_name = template.name.replace(word, parameter.name)
        var made = member_template_of(owner, called_name)
        crash made
        var own = this_value()
        var answered = called(made, own, written)
        var fitted_answer = fitted(answered, parameter.parameter_type)
        arguments.append(fitted_answer)
        index = index + 1
    }
    return arguments
}

func arguments_for(
    shown: String,
    parameters: List<Model.ParameterModel>,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value> {
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var last = parameters.last()
    var is_variadic = false
    if last {
        is_variadic = last.is_variadic
    }
    var fixed_count = parameters.count()
    if is_variadic {
        fixed_count = fixed_count - 1
    }
    var count_is_wrong = written.count() != parameters.count()
    if is_variadic {
        count_is_wrong = written.count() < fixed_count
    }
    if count_is_wrong {
        var given_count = written.count()
        var wanted_count = parameters.count()
        typing.refuse_argument_count(context, shown, wanted_count, given_count)
    }
    var index = 0
    while index < fixed_count {
        var argument = written[index]
        var parameter = parameters[index]
        crash parameter
        var value = fitted_value_of(argument, parameter.parameter_type)
        arguments.append(value)
        index = index + 1
    }
    if is_variadic {
        crash last
        var gathered = gathered_list(last.parameter_type, written, fixed_count)
        arguments.append(gathered)
    }
    return arguments
}

func gathered_list(
    list_type: Model.Type,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
    start: Integer,
): HighIntermediaryRepresentation.Values.Value {
    var list_model = context.class_of(list_type)
    var element_type = list_model.bound_types["$element_type"]
    crash element_type
    if written.count() == start + 1 {
        refuse_a_whole_list(list_type, element_type, written[start])
    }
    var temporary = new_list(list_type)
    var index = start
    while index < written.count() {
        var entry = written[index]
        var value = fitted_value_of(entry, element_type)
        append_to(temporary, value)
        index = index + 1
    }
    return temporary
}

func refuse_a_whole_list(
    list_type: Model.Type,
    element_type: Model.Type,
    entry: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var is_a_path = entry == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or entry == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    assert is_a_path and not element_type.name.starts_with("List")
    var whole = value_of(entry, null)
    assert whole.value_type.name == list_type.name
    var shown = context.shown(list_type)
    typing.refuse_whole_list(context, shown)
}

func made_list(list_type: Model.Type): HighIntermediaryRepresentation.Values.Value {
    var list_model = context.class_of(list_type)
    context.need_defaults(list_model.key)
    var constructor = constructor_of(list_model)
    if constructor {
        need(constructor)
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(list_type, constructor, no_arguments)
}

func new_list(list_type: Model.Type): HighIntermediaryRepresentation.Values.Value {
    var list_model = context.class_of(list_type)
    context.need_defaults(list_model.key)
    var constructor = constructor_of(list_model)
    if constructor {
        need(constructor)
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(list_type, constructor, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", list_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, list_type, made)
    declared.line = context.line
    context.pending.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(list_type, name)
}

func append_to(list: HighIntermediaryRepresentation.Values.Value, value: HighIntermediaryRepresentation.Values.Value) {
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(value)
    var appended = method_call(list, "append", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(appended)
    evaluated.line = context.line
    context.pending.append(evaluated)
}

func list_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    var list_type = list_type_for(literal, expected)
    var no_start = 0
    return gathered_list(list_type, literal.entries, no_start)
}

func dictionary_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    if not expected {
        return object_literal(literal, null)
    }
    if expected.kind == 'shape' {
        return object_literal(literal, expected)
    }
    var dictionary_type = expected.present()
    var dictionary_model = context.class_of(dictionary_type)
    var key_type = dictionary_model.bound_types["$key_type"]
    var value_type = dictionary_model.bound_types["$value_type"]
    crash key_type
    crash value_type
    var temporary = new_list(dictionary_type)
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        if pair == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            store_an_entry(temporary, pair, key_type, value_type)
        }
        index = index + 1
    }
    return temporary
}

func store_an_entry(
    temporary: HighIntermediaryRepresentation.Values.Value,
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
    key_type: Model.Type,
    value_type: Model.Type,
) {
    var key = fitted_value_of(pair.key, key_type)
    var value = fitted_value_of(pair.value, value_type)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(key)
    arguments.append(value)
    var stored = method_call(temporary, "set_at", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(stored)
    evaluated.line = context.line
    context.pending.append(evaluated)
}

func object_literal(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    context.object_count = context.object_count + 1
    var key = "Object{context.object_count}"
    var model = Model.ClassModel(key, "Object", context.current_class.file)
    var shape: Model.ShapeModel? = null
    if expected {
        shape = context.program.shape_keyed(expected.name)
    }
    var values = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        if pair == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var field = field_of(pair, shape, model)
            values.append(field)
        }
        index = index + 1
    }
    context.program.add(model)
    context.need_defaults(key)
    var object_type = Model.Type('object', key)
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(object_type, null, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", object_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object_type, made)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(object_type, name)
    var field_index = 0
    while field_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[field_index]
        var value = values[field_index]
        crash value
        var assigned = HighIntermediaryRepresentation.Statements.AssignAttribute(local, attribute, value)
        assigned.line = context.line
        context.pending.append(assigned)
        field_index = field_index + 1
    }
    return local
}

func field_of(
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
    shape: Model.ShapeModel?,
    model: Model.ClassModel,
): HighIntermediaryRepresentation.Values.Value {
    var written = pair.key
    var name = ""
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = written.name
    }
    if name.is_empty() {
        typing.refuse_not_assignable(context)
    }
    var field_type: Model.Type? = null
    if shape {
        var member = shape.member_named(name)
        if not member {
            typing.refuse_unknown_member(context, shape.name, name)
        }
        crash member
        field_type = member.answer
    }
    var value = value_of(pair.value, field_type)
    var attribute_type = value.value_type
    if field_type {
        value = fitted(value, field_type)
        attribute_type = field_type
    }
    var attribute = Model.AttributeModel(name, model.key, attribute_type)
    model.declared_attributes.append(attribute)
    return value
}

func list_type_for(literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral, expected: Model.Type?): Model.Type {
    if expected {
        return expected.present()
    }
    var inference = NameResolution.Inference()
    var written = inference.list_type_of(literal)
    if written {
        return context.resolver.type_in(written, context.current_class, context.line)
    }
    var first = literal.entries.first()
    if not first {
        typing.refuse_list_without_a_type(context)
    }
    var first_value = value_of(first, null)
    var element = first_value.value_type
    if element.kind == 'nothing' {
        typing.refuse_list_without_a_type(context)
    }
    return context.resolver.list_type_of(element)
}

func foreign_call(
    library: HighIntermediaryRepresentation.Values.Value,
    name: String,
    written: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): HighIntermediaryRepresentation.Values.Value {
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var value = value_of(argument, null)
        arguments.append(value)
        index = index + 1
    }
    var answer = context.scalar_type("Integer")
    var c_name = name
    if name.ends_with("_as_long") {
        answer = context.scalar_type("Long")
        var long_length = name.length() - 8
        c_name = name.slice(0, long_length)
    }
    if name.ends_with("_as_double") {
        answer = context.scalar_type("Double")
        var double_length = name.length() - 10
        c_name = name.slice(0, double_length)
    }
    if name.ends_with("_as_float") {
        answer = context.scalar_type("Float")
        var float_length = name.length() - 9
        c_name = name.slice(0, float_length)
    }
    return HighIntermediaryRepresentation.Values.ForeignCall(answer, library, c_name, arguments)
}

func index_value(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): HighIntermediaryRepresentation.Values.Value {
    var bound = bound_member_read(index)
    if bound {
        return bound
    }
    var target = value_of(index.target, null)
    var owner = present_class_of(target)
    var named = name_index_of(index.index)
    if named and owner.bound_types["$element_type"] {
        var finder = member_template_of(owner, "find_by_name")
        crash finder
        need(finder)
        var finder_arguments = List<HighIntermediaryRepresentation.Values.Value>()
        finder_arguments.append(named)
        return HighIntermediaryRepresentation.Values.Call(finder, target, finder_arguments)
    }
    var function = owner.function_named("get_at")
    if not function {
        var shown = context.shown(target.value_type)
        typing.refuse_not_indexed(context, shown)
    }
    crash function
    need(function)
    var parameter = function.parameters[0]
    crash parameter
    var position = fitted_value_of(index.index, parameter.parameter_type)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(position)
    var read = HighIntermediaryRepresentation.Values.Call(function, target, arguments)
    var printer = Printers.Spite.ExpressionPrinter(index)
    var path = printer.text()
    var narrowed_type = context.scope.narrowed_type_of(path)
    if narrowed_type {
        var proven = HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'proven', read)
        proven.shown = path
        return proven
    }
    return read
}

func name_index_of(
    written: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    if written == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return symbol_name_of(written)
    }
    return null
}

func symbol_name_of(
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert literal.kind == 'symbol_literal'
    need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(literal.text)
    made.value_type = context.text()
    return made
}

func binary_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value {
    if binary.operator == 'and' or binary.operator == 'or' {
        return logic_value(binary)
    }
    var folded = codegen_test(binary)
    if folded {
        return folded
    }
    if is_a_class_test(binary) {
        return class_test_value(binary)
    }
    var operands = operands_of(binary)
    var left = operands[0]
    var right = operands[1]
    crash left
    crash right
    var operator = operator_of(binary.operator)
    var asks_if_equal = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    if asks_if_equal and compares_a_maybe(left, right) {
        var equal_maybe = maybe_equal(left, right)
        if binary.operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(equal_maybe)
        }
        return equal_maybe
    }
    var compares_a_shape = left.value_type.kind == 'shape' and right.value_type.kind != 'shape'
    var asks_equality = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    if compares_a_shape and asks_equality {
        var same = shape_equal(left, right)
        if binary.operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(same)
        }
        return same
    }
    if is_machine_comparable(left.value_type) {
        var fitted_right = fitted(right, left.value_type)
        refuse_a_cut(binary, fitted_right, left.value_type, right.value_type)
        refuse_a_division_by_zero(binary, operator, left, fitted_right)
        var answer = answer_type_of(operator, left.value_type)
        var made = HighIntermediaryRepresentation.Values.MachineOperation(answer, operator, left, fitted_right)
        var printer = Printers.Spite.ExpressionPrinter(binary)
        made.shown = printer.text()
        return made
    }
    return operator_call(operator, left, right)
}

func refuse_a_division_by_zero(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.Operator,
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
) {
    assert operator == 'divide' or operator == 'remainder'
    assert not is_a_decimal_type(left.value_type)
    if right == HighIntermediaryRepresentation.Values.WholeNumber {
        refuse_a_zero(binary, right.number)
    }
}

func refuse_a_zero(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, number: Long) {
    assert number == 0
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    typing.refuse_division_by_zero(context, shown)
}

func codegen_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var left = binary.left
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return codegen_test_of(binary, left)
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return bound_class_test(binary, left)
    }
    return null
}

func bound_class_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var function = context.current_function
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    assert compares and left.name == "class" and function.bound_member_type
    var target = left.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if target.name == function.bound_parameter {
            return decided_class_test(binary, function.bound_member_type)
        }
    }
    return null
}

func decided_class_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    bound: Model.Type,
): HighIntermediaryRepresentation.Values.Value? {
    var path = tested_class_path_of(binary.right)
    assert not path.is_empty()
    var written = path.join(".")
    var answer = bound_is(bound, written)
    if binary.operator == 'not_equal' {
        answer = not answer
    }
    var number = 0
    if answer {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func codegen_test_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value? {
    assert left.name.starts_with("$")
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    assert compares
    var bound = context.current_class.bound_types[left.name]
    assert bound
    var path = class_path_of(binary.right)
    assert not path.is_empty()
    var written = path.join(".")
    var answer = bound_is(bound, written)
    if binary.operator == 'not_equal' {
        answer = not answer
    }
    var number = 0
    if answer {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func bound_is(bound: Model.Type, written: String): Boolean {
    switch written {
        "Null": return bound.is_nullable
        "Number": return bound.kind == 'scalar' and bound.name != "Boolean" and not bound.is_nullable
        "List": return bound.name.starts_with("List_of_") and not bound.is_nullable
        "Dictionary": return bound.name.starts_with("Dictionary_of_") and not bound.is_nullable
        "Symbol": return bound.is_symbol and not bound.is_nullable
        _: return is_the_class(bound, written)
    }
}

func is_the_class(bound: Model.Type, written: String): Boolean {
    if bound.is_nullable or bound.is_symbol {
        return false
    }
    var path = written.split(".")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    return described.name == bound.name and described.kind == bound.kind
}

func compares_a_maybe(
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): Boolean {
    var left_type = left.value_type
    var right_type = right.value_type
    if left_type.kind == 'shape' or right_type.kind == 'shape' {
        return false
    }
    if left_type.kind == 'nothing' or right_type.kind == 'nothing' {
        return false
    }
    return left_type.is_nullable or right_type.is_nullable
}

func maybe_equal(
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    if not left.value_type.is_nullable {
        return maybe_equal(right, left)
    }
    var boolean = context.boolean()
    var held_left = held_once(left)
    var present_type = left.value_type.present()
    var present_left = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', held_left)
    var left_is_there = HighIntermediaryRepresentation.Values.PresenceTest(held_left)
    if not right.value_type.is_nullable {
        var fitted_right = fitted(right, present_type)
        var equal = present_equal(present_left, fitted_right)
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', left_is_there, equal)
    }
    var held_right = held_once(right)
    var right_present_type = right.value_type.present()
    var present_right = HighIntermediaryRepresentation.Values.Conversion(right_present_type, 'present', held_right)
    var right_is_there = HighIntermediaryRepresentation.Values.PresenceTest(held_right)
    var fitted_present_right = fitted(present_right, present_type)
    var both_equal = present_equal(present_left, fitted_present_right)
    var both_there = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'and',
        left_is_there,
        right_is_there,
    )
    var there_and_equal = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', both_there, both_equal)
    var left_missing = HighIntermediaryRepresentation.Values.Negation(left_is_there)
    var right_missing = HighIntermediaryRepresentation.Values.Negation(right_is_there)
    var both_missing = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'and',
        left_missing,
        right_missing,
    )
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', both_missing, there_and_equal)
}

func held_once(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    var is_a_plain_read = value == HighIntermediaryRepresentation.Values.LocalRead
    is_a_plain_read = is_a_plain_read or value == HighIntermediaryRepresentation.Values.AttributeRead
    if is_a_plain_read {
        return value
    }
    temporary_count = temporary_count + 1
    var name = context.scope.declare("compared_{temporary_count}", value.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value)
    declared.line = context.line
    context.pending.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, name)
}

func present_equal(
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    var boolean = context.boolean()
    if is_machine_comparable(left.value_type) or compares_identity(left) {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
    }
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(right)
    return method_call(left, "equals", arguments)
}

func shape_equal(
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    var boolean = context.boolean()
    var right_type = right.value_type.present()
    if right_type.kind == 'object' and right_type.name == "Spite.Class" {
        var reflection = Reflection(context, this)
        var class_of_left = reflection.class_of_value(left)
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', class_of_left, right)
    }
    if not is_held_in_a_box(right_type) {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
    }
    var tested = HighIntermediaryRepresentation.Values.ClassTest(left, right_type)
    var unboxed = HighIntermediaryRepresentation.Values.Conversion(right_type, 'unbox', left)
    var equal = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', unboxed, right)
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', tested, equal)
}

func operands_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): List<HighIntermediaryRepresentation.Values.Value> {
    var operands = List<HighIntermediaryRepresentation.Values.Value>()
    if is_a_number_literal(binary.left) and not is_a_number_literal(binary.right) {
        var right_value = value_of(binary.right, null)
        var right_first = result_of_handle(right_value)
        var left_after = value_of(binary.left, right_first.value_type)
        operands.append(left_after)
        operands.append(right_first)
        return operands
    }
    var left_value = value_of(binary.left, null)
    var left = result_of_handle(left_value)
    var right_value = value_of(binary.right, left.value_type)
    var right = result_of_handle(right_value)
    operands.append(left)
    operands.append(right)
    return operands
}

func is_a_number_literal(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'integer_literal' or expression.kind == 'decimal_literal'
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return is_a_number_literal(expression.operand)
    }
    return false
}

func refuse_a_cut(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    fitted_right: HighIntermediaryRepresentation.Values.Value,
    left_type: Model.Type,
    right_type: Model.Type,
) {
    if fitted_right == HighIntermediaryRepresentation.Values.Conversion {
        refuse_a_cut_conversion(binary, fitted_right, left_type, right_type)
    }
}

func refuse_a_cut_conversion(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    left_type: Model.Type,
    right_type: Model.Type,
) {
    var cuts = conversion.kind == 'narrow' or conversion.kind == 'narrow_decimal' or conversion.kind == 'to_whole'
    assert cuts
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var function = context.current_function
    if not function.number_copy_of.is_empty() {
        var left_article = article_for(left_type.name)
        var right_article = article_for(right_type.name)
        var path = context.path()
        var message = "spite: '{shown}' works in {left_article} {left_type.name}, the class of its left side, and its right side is {right_article} {right_type.name}, which would be cut to fit, at {path}:{context.line} in {function.owner}.{function.number_copy_of}"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = context.line
        context.pending.append(stopped)
        return
    }
    var operation = operation_name_of(binary.operator)
    typing.refuse_cut_operand(context, shown, operation, left_type.name, right_type.name)
}

func article_for(name: String): String {
    var first = name.slice(0, 1)
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first) {
        return "an"
    }
    return "a"
}

func operation_name_of(kind: AbstractSyntaxTree.Tokens.TokenKind): String {
    switch kind {
        'plus': return "an addition"
        'minus': return "a subtraction"
        'star': return "a multiplication"
        'slash': return "a division"
        'percent': return "a remainder"
        _: return "a comparison"
    }
}

func is_machine_comparable(left_type: Model.Type): Boolean {
    var is_a_scalar = left_type.kind == 'scalar' and not left_type.is_nullable
    var is_an_enum = left_type.kind == 'enumeration' and not left_type.is_nullable
    return is_a_scalar or is_an_enum
}

func answer_type_of(operator: HighIntermediaryRepresentation.Values.Operator, left_type: Model.Type): Model.Type {
    switch operator {
        'add': return left_type
        'subtract': return left_type
        'multiply': return left_type
        'divide': return left_type
        'remainder': return left_type
        _: return context.boolean()
    }
}

func operator_of(kind: AbstractSyntaxTree.Tokens.TokenKind): HighIntermediaryRepresentation.Values.Operator {
    switch kind {
        'plus': return 'add'
        'minus': return 'subtract'
        'star': return 'multiply'
        'slash': return 'divide'
        'percent': return 'remainder'
        'equal_equal': return 'equal'
        'not_equal': return 'not_equal'
        'less': return 'less'
        'less_or_equal': return 'less_or_equal'
        'greater': return 'greater'
        'greater_or_equal': return 'greater_or_equal'
        'and': return 'and'
        _: return 'or'
    }
}

func operator_call(
    operator: HighIntermediaryRepresentation.Values.Operator,
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    var asks_equality = operator == 'equal' or operator == 'not_equal'
    if asks_equality and compares_identity(left) {
        var boolean = context.boolean()
        var same = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
        if operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(same)
        }
        return same
    }
    var name = operator_function_name(operator)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(right)
    var answered = method_call(left, name, arguments)
    var negated = operator == 'not_equal' or operator == 'less_or_equal' or operator == 'greater_or_equal'
    if negated {
        return HighIntermediaryRepresentation.Values.Negation(answered)
    }
    return answered
}

func compares_identity(left: HighIntermediaryRepresentation.Values.Value): Boolean {
    var left_type = left.value_type
    if left_type.kind != 'object' or left_type.is_nullable {
        return false
    }
    var model = context.class_of(left_type)
    var equals = model.function_named("equals")
    if not equals {
        return true
    }
    var parameter = equals.parameters[0]
    if not parameter {
        return true
    }
    return parameter.parameter_type.kind != 'object'
}

func operator_function_name(operator: HighIntermediaryRepresentation.Values.Operator): String {
    switch operator {
        'add': return "sum"
        'subtract': return "subtract"
        'multiply': return "multiply"
        'divide': return "divide"
        'remainder': return "remainder"
        'equal': return "equals"
        'not_equal': return "equals"
        'less': return "less_than"
        'greater': return "greater_than"
        'less_or_equal': return "greater_than"
        'greater_or_equal': return "less_than"
        _: return ""
    }
}

func is_a_class_test(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    var right = tested_class_path_of(binary.right)
    return compares and not right.is_empty()
}

func class_test_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value {
    var tested = value_of(binary.left, null)
    var path = tested_class_path_of(binary.right)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var member = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    if tested.value_type.name == "Spite.Class" {
        return same_class(binary, tested, member)
    }
    var test = HighIntermediaryRepresentation.Values.ClassTest(tested, member)
    if binary.operator == 'not_equal' {
        return HighIntermediaryRepresentation.Values.Negation(test)
    }
    return test
}

func same_class(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    tested: HighIntermediaryRepresentation.Values.Value,
    member: Model.Type,
): HighIntermediaryRepresentation.Values.Value {
    var reflection = Reflection(context, this)
    var object = reflection.class_object(member.name)
    var boolean = context.boolean()
    var compared = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', tested, object)
    if binary.operator == 'not_equal' {
        return HighIntermediaryRepresentation.Values.Negation(compared)
    }
    return compared
}

func logic_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value {
    var boolean = context.boolean()
    var left = condition_of(binary.left)
    var right = right_condition_of(binary)
    var operator = operator_of(binary.operator)
    var folded = folded_logic(left, right, operator)
    if folded {
        return folded
    }
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, operator, left, right)
}

func right_condition_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value {
    var facts = Statements(context)
    if binary.operator == 'and' {
        facts.read_facts(binary.left)
    } else {
        facts.facts_paths = List<String>()
        facts.facts_types = List<Model.Type>()
        facts.read_a_negated_fact(binary.left)
    }
    context.scope.enter()
    facts.narrow_all(facts.facts_paths, facts.facts_types)
    var right = condition_of(binary.right)
    context.scope.leave()
    return right
}

func folded_logic(
    left: HighIntermediaryRepresentation.Values.Value,
    right: HighIntermediaryRepresentation.Values.Value,
    operator: HighIntermediaryRepresentation.Values.Operator,
): HighIntermediaryRepresentation.Values.Value? {
    if left == HighIntermediaryRepresentation.Values.WholeNumber {
        return folded_with_a_left(left, right, operator)
    }
    return null
}

func folded_with_a_left(
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: HighIntermediaryRepresentation.Values.Value,
    operator: HighIntermediaryRepresentation.Values.Operator,
): HighIntermediaryRepresentation.Values.Value? {
    var left_holds = left.number != 0
    if operator == 'and' and not left_holds {
        return left
    }
    if operator == 'or' and left_holds {
        return left
    }
    return right
}

func with_its_links(
    condition: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): AbstractSyntaxTree.Shapes.Expressions.Expression? {
    if condition == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return linked_member(condition)
    }
    return condition
}

func linked_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): AbstractSyntaxTree.Shapes.Expressions.Expression {
    var prefixes = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    var rooted = collect_prefixes(member.target, prefixes)
    if not rooted {
        return member
    }
    var outer_pending = context.pending
    context.pending = List<HighIntermediaryRepresentation.Statements.Statement>()
    context.scope.enter()
    var chosen = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        var probed = value_of(prefix, null)
        if probed.value_type.is_nullable {
            chosen.append(prefix)
            var printer = Printers.Spite.ExpressionPrinter(prefix)
            var path = printer.text()
            var present = probed.value_type.present()
            context.scope.narrow(path, present)
        }
        index = index + 1
    }
    context.scope.leave()
    context.pending = outer_pending
    if chosen.is_empty() {
        return member
    }
    var joined = chosen[0]
    var joined_index = 1
    while joined_index < chosen.count() {
        var next = chosen[joined_index]
        joined = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(joined, 'and', next)
        joined_index = joined_index + 1
    }
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(joined, 'and', member)
}

func collect_prefixes(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    into: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var rooted = collect_prefixes(expression.target, into)
        into.append(expression)
        return rooted
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if expression.is_a_class_name or expression.name.starts_with("$") {
            return false
        }
        into.append(expression)
        return true
    }
    return false
}

func condition_of(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value {
    var written_value = value_of(expression, null)
    var is_a_maybe_handle = written_value.value_type.kind == 'handle' and written_value.value_type.is_nullable
    if is_a_maybe_handle {
        return HighIntermediaryRepresentation.Values.PresenceTest(written_value)
    }
    var value = result_of_handle(written_value)
    var present_type = value.value_type.present()
    if value.value_type.is_nullable and context.is_boolean(present_type) {
        var held = held_once(value)
        var there = HighIntermediaryRepresentation.Values.PresenceTest(held)
        var flag = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', held)
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', there, flag)
    }
    if value.value_type.is_nullable {
        return HighIntermediaryRepresentation.Values.PresenceTest(value)
    }
    if value == HighIntermediaryRepresentation.Values.Conversion {
        var checked = proven_check_of(value)
        if checked {
            return checked
        }
    }
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        if context.proven_locals.contains(value.name) {
            var boolean = context.boolean()
            return HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
        }
    }
    if not context.is_boolean(value.value_type) {
        var shown = context.shown(value.value_type)
        typing.refuse_not_a_condition(context, shown)
    }
    return value
}

func proven_check_of(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
): HighIntermediaryRepresentation.Values.Value? {
    assert conversion.kind == 'proven' and not context.is_boolean(conversion.value_type)
    crash conversion.converted
    return HighIntermediaryRepresentation.Values.PresenceTest(conversion.converted)
}

func unary_value(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
    expected: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    if unary.operator == 'not' {
        var negated = condition_of(unary.operand)
        if negated == HighIntermediaryRepresentation.Values.WholeNumber {
            var flipped = 1
            if negated.number != 0 {
                flipped = 0
            }
            var boolean = context.boolean()
            return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flipped)
        }
        return HighIntermediaryRepresentation.Values.Negation(negated)
    }
    var operand = value_of(unary.operand, expected)
    if operand.value_type.kind == 'object' {
        var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
        return method_call(operand, "negate", no_arguments)
    }
    if operand == HighIntermediaryRepresentation.Values.WholeNumber {
        var zero: Long = 0
        return HighIntermediaryRepresentation.Values.WholeNumber(operand.value_type, zero - operand.number)
    }
    var zero_value: HighIntermediaryRepresentation.Values.Value = HighIntermediaryRepresentation.Values.WholeNumber(
        operand.value_type,
        0,
    )
    if is_a_decimal_type(operand.value_type) {
        zero_value = HighIntermediaryRepresentation.Values.DecimalNumber(operand.value_type, "-0.0")
    }
    var made = HighIntermediaryRepresentation.Values.MachineOperation(
        operand.value_type,
        'subtract',
        zero_value,
        operand,
    )
    var printer = Printers.Spite.ExpressionPrinter(unary.operand)
    var negated = printer.text()
    made.shown = "0 - {negated}"
    return made
}

func need(function: Model.FunctionModel) {
    context.need(function)
}

func unbuilt(): HighIntermediaryRepresentation.Values.Value {
    var buildable = Validators.HighIntermediaryRepresentation.Buildable.Validator()
    var path = context.path()
    buildable.refuse(path, context.line, context.current_class.key)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

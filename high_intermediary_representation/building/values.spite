# ../../OPTIMIZATIONS.md#operators-on-a-number-find-its-class-while-the-program-runs
func number_dispatch(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
): Value {
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var number_type = left.value_type
    var answer_type = answer_type_of(operator, number_type)
    var held_left = held_operand(left)
    var held_right = held_operand(right)
    var start = number_start(answer_type)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("number_{temporary_count}", answer_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, answer_type, start)
    declared.line = context.line
    context.pending.append(declared)
    var path = context.path()
    var function = context.current_function
    var place = "at {path}:{context.line} in {function.owner}.{function.name}"
    var other = "spite: '{shown}' reaches a Number of a class that is not a number class, whose operators are not chosen while the program runs, {place}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(other)
    var chain = HighIntermediaryRepresentation.Statements.Block()
    chain.statements.append(stopped)
    var names = number_class_names()
    var index = names.count() - 1
    while index >= 0 {
        var class_name = names[index]
        crash class_name
        var left_class = context.scalar_type(class_name)
        var tested = HighIntermediaryRepresentation.Values.Class.Membership(held_left, left_class)
        var unboxed = HighIntermediaryRepresentation.Values.Conversion(left_class, 'unbox', held_left)
        var branch = number_branch(operator, unboxed, held_right, name, answer_type, shown, place)
        var otherwise = chain
        chain = HighIntermediaryRepresentation.Statements.Block()
        var test = HighIntermediaryRepresentation.Statements.If(tested, branch, otherwise)
        chain.statements.append(test)
        index = index - 1
    }
    var first = chain.statements[0]
    crash first
    context.pending.append(first)
    return HighIntermediaryRepresentation.Values.LocalRead(answer_type, name)
}

func number_conversion_call(
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value? {
    fallback is_the_number_shape(receiver.value_type) and written.is_empty()
    if name != "to_long" and name != "to_double" {
        return number_function_call(receiver, name)
    }
    var answer_type = context.scalar_type("Long")
    if name == "to_double" {
        answer_type = context.scalar_type("Double")
    }
    var held = held_operand(receiver)
    var start = default_of_a_type(answer_type)
    crash start
    temporary_count = temporary_count + 1
    var local_name = context.scope.declare("number_{temporary_count}", answer_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(local_name, answer_type, start)
    declared.line = context.line
    context.pending.append(declared)
    var path = context.path()
    var function = context.current_function
    var other = "spite: '{name}()' reaches a Number of a class that is not a number class, whose functions are not chosen while the program runs, at {path}:{context.line} in {function.owner}.{function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(other)
    var chain = HighIntermediaryRepresentation.Statements.Block()
    chain.statements.append(stopped)
    var names = number_class_names()
    var index = names.count() - 1
    while index >= 0 {
        var class_name = names[index]
        crash class_name
        var held_class = context.scalar_type(class_name)
        var tested = HighIntermediaryRepresentation.Values.Class.Membership(held, held_class)
        var unboxed = HighIntermediaryRepresentation.Values.Conversion(held_class, 'unbox', held)
        var converted = fitted(unboxed, answer_type)
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(local_name, converted)
        assigned.line = context.line
        var branch = HighIntermediaryRepresentation.Statements.Block()
        branch.statements.append(assigned)
        var otherwise = chain
        chain = HighIntermediaryRepresentation.Statements.Block()
        var test = HighIntermediaryRepresentation.Statements.If(tested, branch, otherwise)
        chain.statements.append(test)
        index = index - 1
    }
    var first = chain.statements[0]
    crash first
    context.pending.append(first)
    return HighIntermediaryRepresentation.Values.LocalRead(answer_type, local_name)
}

# ../../OPTIMIZATIONS.md#operators-on-a-number-find-its-class-while-the-program-runs
func number_function_call(
    receiver: Value,
    name: String,
): Value? {
    var answer_type = number_function_answer(receiver.value_type, name)
    fallback answer_type
    var held = held_operand(receiver)
    var start = default_of_a_type(answer_type)
    if is_the_number_shape(answer_type) {
        start = number_start(answer_type)
    }
    crash start
    temporary_count = temporary_count + 1
    var local_name = context.scope.declare("number_{temporary_count}", answer_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(local_name, answer_type, start)
    declared.line = context.line
    context.pending.append(declared)
    var path = context.path()
    var function = context.current_function
    var other = "spite: '{name}()' reaches a Number of a class that is not a number class, whose functions are not chosen while the program runs, at {path}:{context.line} in {function.owner}.{function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(other)
    var chain = HighIntermediaryRepresentation.Statements.Block()
    chain.statements.append(stopped)
    var names = number_class_names()
    var index = names.count() - 1
    while index >= 0 {
        var class_name = names[index]
        crash class_name
        var held_class = context.scalar_type(class_name)
        var tested = HighIntermediaryRepresentation.Values.Class.Membership(held, held_class)
        var unboxed = HighIntermediaryRepresentation.Values.Conversion(held_class, 'unbox', held)
        var no_arguments = List<Value>()
        var answered = method_call(unboxed, name, no_arguments)
        var converted = fitted(answered, answer_type)
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(local_name, converted)
        assigned.line = context.line
        var branch = HighIntermediaryRepresentation.Statements.Block()
        branch.statements.append(assigned)
        var otherwise = chain
        chain = HighIntermediaryRepresentation.Statements.Block()
        var test = HighIntermediaryRepresentation.Statements.If(tested, branch, otherwise)
        chain.statements.append(test)
        index = index - 1
    }
    var first = chain.statements[0]
    crash first
    context.pending.append(first)
    return HighIntermediaryRepresentation.Values.LocalRead(answer_type, local_name)
}

func number_function_answer(number_type: Model.Type, name: String): Model.Type? {
    var shared: Model.Type? = null
    var is_its_own = true
    var is_shared = true
    var names = number_class_names()
    var index = 0
    while index < names.count() {
        var class_name = names[index]
        var held_class = context.scalar_type(class_name)
        var model = context.class_of(held_class)
        var function = model.function_named(name)
        fallback function
        fallback function.parameters.is_empty()
        fallback function.answer
        var answer: Model.Type = function.answer
        if not answer.is_the_same_as(held_class) {
            is_its_own = false
        }
        if shared {
            if not answer.is_the_same_as(shared) {
                is_shared = false
            }
        } else {
            shared = answer
        }
        index = index + 1
    }
    if is_its_own {
        return number_type
    }
    fallback is_shared
    return shared
}

func number_start(answer_type: Model.Type): Value {
    if answer_type.kind == 'scalar' {
        return HighIntermediaryRepresentation.Values.WholeNumber(answer_type, 0)
    }
    var integer = context.scalar_type("Integer")
    var zero = HighIntermediaryRepresentation.Values.WholeNumber(integer, 0)
    return fitted(zero, answer_type)
}

func held_operand(value: Value): Value {
    var is_plain = value.class == HighIntermediaryRepresentation.Values.LocalRead or value.class == HighIntermediaryRepresentation.Values.WholeNumber
    if is_plain or value.class == HighIntermediaryRepresentation.Values.DecimalNumber {
        return value
    }
    temporary_count = temporary_count + 1
    var name = context.scope.declare("operand_{temporary_count}", value.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value)
    declared.line = context.line
    context.pending.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, name)
}

func number_class_names(): List<String> {
    return ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong", "Float", "Double"]
}

func number_branch(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
    name: String,
    answer_type: Model.Type,
    shown: String,
    place: String,
): HighIntermediaryRepresentation.Statements.Block {
    var branch = HighIntermediaryRepresentation.Statements.Block()
    if not is_the_number_shape(right.value_type) {
        var made = number_operation(operator, left, right, name, answer_type, shown, place)
        branch.statements.append(made)
        return branch
    }
    var other = "spite: '{shown}' reaches a Number of a class that is not a number class on its right side, whose operators are not chosen while the program runs, {place}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(other)
    var chain = HighIntermediaryRepresentation.Statements.Block()
    chain.statements.append(stopped)
    var names = number_class_names()
    var index = names.count() - 1
    while index >= 0 {
        var class_name = names[index]
        crash class_name
        var right_class = context.scalar_type(class_name)
        var tested = HighIntermediaryRepresentation.Values.Class.Membership(right, right_class)
        var unboxed = HighIntermediaryRepresentation.Values.Conversion(right_class, 'unbox', right)
        var made_right = number_operation(operator, left, unboxed, name, answer_type, shown, place)
        var inner = HighIntermediaryRepresentation.Statements.Block()
        inner.statements.append(made_right)
        var otherwise = chain
        chain = HighIntermediaryRepresentation.Statements.Block()
        var test = HighIntermediaryRepresentation.Statements.If(tested, inner, otherwise)
        chain.statements.append(test)
        index = index - 1
    }
    return chain
}

func number_operation(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
    name: String,
    answer_type: Model.Type,
    shown: String,
    place: String,
): Statement {
    var left_type = left.value_type
    var right_type = right.value_type
    var fitted_right = right
    if left_type.name != right_type.name {
        fitted_right = fitted(right, left_type)
    }
    var cuts = false
    if fitted_right.class == HighIntermediaryRepresentation.Values.Conversion {
        var kind = fitted_right.kind
        cuts = kind == 'narrow' or kind == 'narrow_decimal' or kind == 'to_whole'
    }
    if cuts {
        var left_article = article_for(left_type.name)
        var right_article = article_for(right_type.name)
        var message = "spite: '{shown}' works in {left_article} {left_type.name}, the class of its left side, and its right side is {right_article} {right_type.name}, which would be cut to fit, {place}"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = context.line
        return stopped
    }
    var operation_type = answer_type_of(operator, left_type)
    var made = HighIntermediaryRepresentation.Values.MachineOperation(operation_type, operator, left, fitted_right)
    made.shown = shown
    var answered = fitted(made, answer_type)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(name, answered)
    assigned.line = context.line
    return assigned
}

func operator_call(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
): Value {
    var asks_equality = operator == 'equal' or operator == 'not_equal'
    if asks_equality and compares_identity(left) {
        var boolean = context.boolean()
        var same = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
        if operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(same)
        }
        return same
    }
    var name = operator_function_name(operator)
    refuse_a_missing_operator(left, name, "this operator", "{name}(other)")
    if asks_equality {
        refuse_a_comparison_across_classes(left, right)
    }
    var arguments = List<Value>()
    arguments.append(right)
    var answered = method_call(left, name, arguments)
    var negated = operator == 'not_equal' or operator == 'less_or_equal' or operator == 'greater_or_equal'
    if negated {
        return HighIntermediaryRepresentation.Values.Negation(answered)
    }
    return answered
}

func refuse_a_missing_operator(
    operand: Value,
    name: String,
    operator_text: String,
    needed: String,
) {
    var operand_type = operand.value_type
    var is_a_class = operand_type.kind == 'object' and not operand_type.is_nullable
    fallback is_a_class and context.has_a_class(operand_type)
    var owner = context.class_of(operand_type)
    fallback not owner.function_named(name)
    fallback not member_template_of(owner, name)
    var shown = context.shown(operand_type)
    typing.refuse_a_missing_operator(context, operator_text, shown, needed)
}

func compares_identity(left: Value): Boolean {
    var left_type = left.value_type
    if left_type.kind == 'union' and not left_type.is_nullable {
        return union_compares_identity(left_type)
    }
    fallback left_type.kind == 'object' and not left_type.is_nullable
    return class_compares_identity(left_type)
}

func union_compares_identity(union_type: Model.Type): Boolean {
    var united = union_model_of(union_type)
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var is_a_reference = held.kind == 'object' and held.name != "String" and not held.is_nullable
        fallback is_a_reference
        fallback class_compares_identity(held)
        index = index + 1
    }
    return true
}

func class_compares_identity(left_type: Model.Type): Boolean {
    var model = context.class_of(left_type)
    var equals = model.function_named("equals")
    if not equals {
        return true
    }
    var parameter = equals.parameters[0]
    if not parameter {
        return true
    }
    return parameter.parameter_type.kind != 'object'
}

func refuse_a_comparison_across_classes(
    left: Value,
    right: Value,
) {
    var left_type = left.value_type
    var right_type = right.value_type
    var both_kinds = left_type.kind == 'object' and right_type.kind == 'object'
    var both_classes = both_kinds and context.has_a_class(left_type) and context.has_a_class(right_type)
    var either_nullable = left_type.is_nullable or right_type.is_nullable
    var across = both_classes and not either_nullable and left_type.name != right_type.name
    if across and equals_takes_its_own_class(left_type) {
        var given = context.shown(left_type)
        var wanted = context.shown(right_type)
        typing.refuse_mismatch(context, given, wanted)
    }
}

func equals_takes_its_own_class(left_type: Model.Type): Boolean {
    var owner = context.class_of(left_type)
    var equals = owner.function_named("equals")
    crash equals
    var parameter = equals.parameters[0]
    crash parameter
    return parameter.parameter_type.name == left_type.name
}

func operator_function_name(operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator): String {
    switch operator {
        'add': return "sum"
        'subtract': return "subtract"
        'multiply': return "multiply"
        'divide': return "divide"
        'remainder': return "remainder"
        'equal': return "equals"
        'not_equal': return "equals"
        'less': return "less_than"
        'greater': return "greater_than"
        'less_or_equal': return "greater_than"
        'greater_or_equal': return "less_than"
        'and': return ""
        'or': return ""
    }
}

func is_a_class_test(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    var right = tested_class_path_of(binary.right)
    return compares and not right.is_empty()
}

func class_test_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value {
    var tested = class_tested_value(binary)
    var path = tested_class_path_of(binary.right)
    var type_arguments = tested_type_arguments(binary.right)
    var member = context.resolver.class_type_in(path, type_arguments, context.current_class, context.line)
    if tested.value_type.name == "Spite.Class" {
        return same_class(binary, tested, member)
    }
    refuse_a_test_for_no_member(binary, tested, member)
    note_an_answered_class_test(binary, tested, member)
    var test = HighIntermediaryRepresentation.Values.Class.Membership(tested, member)
    if binary.operator == 'not_equal' {
        return HighIntermediaryRepresentation.Values.Negation(test)
    }
    return test
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_an_answered_class_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    tested: Value,
    member: Model.Type,
) {
    var tested_type = tested.value_type
    var is_one_class = tested_type.kind == 'object' and not tested_type.is_nullable and context.has_a_class(tested_type)
    fallback binary.operator == 'equal_equal' and is_one_class
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    var path = context.path()
    var library = Validators.LibraryFile()
    var is_generated = path.contains("/.spite/") or library.holds(path)
    fallback not is_a_walk and not is_generic and not is_generated
    var tested_written = binary.left
    var asked = class_tested_of_a_test(binary)
    if asked {
        tested_written = asked
    }
    crash tested_written
    var printer = Printers.Spite.ExpressionPrinter(tested_written)
    var written = printer.text()
    var fact_path = written
    if tested_written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var internal_name = context.scope.internal_name_of(tested_written.name)
        fact_path = "this.{tested_written.name}"
        if internal_name {
            fact_path = internal_name
        }
    }
    var site = HighIntermediaryRepresentation.Building.CheckSite("answered class test", context)
    site.written = written
    site.checked_type = tested_type
    site.check = context.scope.check_of(fact_path)
    site.source = context.shown(member)
    context.note_a_check_site(site)
}

func refuse_a_test_for_no_member(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    tested: Value,
    member: Model.Type,
) {
    fallback tested.value_type.kind == 'union'
    var names_a_codegen_value = false
    var right = binary.right
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_a_codegen_value = right.name.starts_with("$")
    }
    var bound = context.current_class.bound_types.keys()
    fallback not names_a_codegen_value and bound.is_empty()
    var united = union_model_of(tested.value_type)
    var held_names = united.members.map_names()
    fallback not held_names.contains(member.name)
    var names = List<String>()
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var shown = context.shown(held)
        names.append(shown)
        index = index + 1
    }
    var listed = names.join(", ")
    var printer = Printers.Spite.ExpressionPrinter(binary.left)
    var tested_text = printer.text()
    var member_shown = context.shown(member)
    typing.refuse_a_test_for_no_member(context, tested_text, member_shown, united.name, listed)
}

func tested_type_arguments(
    written: Expression?,
): List<AbstractSyntaxTree.Shapes.Types.GenericArgument> {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.generic_arguments
    }
    return List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func refuse_a_class_test_on_a_value(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var left = left_printer.text()
    var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
    var right = right_printer.text()
    typing.refuse_a_class_test_on_a_value(context, left, right)
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func class_asked_of(left: Expression?): Value? {
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class"
    fallback is_a_value_path(left.target)
    var target = value_of(left.target, null)
    fallback not declares_its_class(target.value_type)
    return target
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func class_tested_of_a_test(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Expression? {
    fallback is_a_class_test(binary)
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class"
    var asked = class_asked_of(left)
    fallback asked
    return left.target
}

func class_tested_value(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Value {
    var asked = class_asked_of(binary.left)
    if asked {
        return asked
    }
    var tested = value_of(binary.left, null)
    if tested.value_type.name != "Spite.Class" {
        refuse_a_class_test_on_a_value(binary)
    }
    return tested
}

func declares_its_class(of_type: Model.Type): Boolean {
    var present = of_type.present()
    fallback context.has_a_class(present)
    var model = context.class_of(present)
    var getter = model.function_named("get_class")
    var attribute = model.attribute_named("class")
    return getter or attribute
}

func same_class(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    tested: Value,
    member: Model.Type,
): Value {
    var reflection = Reflection(context, this)
    var object = reflection.class_object(member.name)
    var boolean = context.boolean()
    var compared = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', tested, object)
    if binary.operator == 'not_equal' {
        return HighIntermediaryRepresentation.Values.Negation(compared)
    }
    return compared
}

func logic_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value {
    var boolean = context.boolean()
    var left = condition_of(binary.left)
    if left.class == HighIntermediaryRepresentation.Values.WholeNumber {
        var decides_an_and = binary.operator == 'and' and left.number == 0
        var decides_an_or = binary.operator == 'or' and left.number != 0
        if decides_an_and or decides_an_or {
            context.note_a_folded_branch()
            return left
        }
    }
    var outer_pending = context.pending
    context.pending = List<Statement>()
    var right = right_condition_of(binary)
    var right_work = context.pending
    context.pending = outer_pending
    if not right_work.is_empty() {
        return logic_in_order(binary, left, right, right_work)
    }
    var operator = operator_of(binary.operator)
    var folded = folded_logic(left, right, operator)
    if folded {
        return folded
    }
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, operator, left, right)
}

# ../../ARCHITECTURE.md#work-a-condition-needs-runs-where-the-condition-reaches-it
func logic_in_order(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: Value,
    right: Value,
    right_work: List<Statement>,
): Value {
    var boolean = context.boolean()
    temporary_count = temporary_count + 1
    var name = context.scope.declare("logic_{temporary_count}", boolean)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, boolean, left)
    declared.line = context.line
    context.pending.append(declared)
    var deciding = HighIntermediaryRepresentation.Statements.Block()
    var index = 0
    while index < right_work.count() {
        var work = right_work[index]
        deciding.statements.append(work)
        index = index + 1
    }
    var decided = HighIntermediaryRepresentation.Statements.Assign.Assign(name, right)
    decided.line = context.line
    deciding.statements.append(decided)
    var held = HighIntermediaryRepresentation.Values.LocalRead(boolean, name)
    var tested: Value = held
    if binary.operator == 'or' {
        tested = HighIntermediaryRepresentation.Values.Negation(held)
    }
    var branch = HighIntermediaryRepresentation.Statements.If(tested, deciding, null)
    branch.line = context.line
    context.pending.append(branch)
    return HighIntermediaryRepresentation.Values.LocalRead(boolean, name)
}

func right_condition_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value {
    var facts = Statements(context)
    if binary.operator == 'and' {
        facts.read_facts(binary.left)
    } else {
        facts.facts_paths = List<String>()
        facts.facts_types = List<Model.Type>()
        facts.read_a_negated_fact(binary.left)
    }
    context.scope.enter()
    facts.narrow_all(facts.facts_paths, facts.facts_types)
    var right = condition_of(binary.right)
    context.scope.leave()
    return right
}

func folded_logic(
    left: Value,
    right: Value,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): Value? {
    if left.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return folded_with_a_left(left, right, operator)
    }
    if right.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return folded_with_a_right(left, right, operator)
    }
    return null
}

# ../../PROOFS.md#conditions-decided-while-compiling
func folded_with_a_right(
    left: Value,
    right: HighIntermediaryRepresentation.Values.WholeNumber,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): Value? {
    var right_holds = right.number != 0
    var decides = operator == 'and' and not right_holds or operator == 'or' and right_holds
    fallback decides
    if not is_a_quiet_condition(left) {
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(left)
        evaluated.line = context.line
        context.pending.append(evaluated)
    }
    return right
}

func is_a_quiet_condition(value: Value?): Boolean {
    if not value {
        return true
    }
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_a_quiet_condition(value.object)
        HighIntermediaryRepresentation.Values.PresenceTest: return is_a_quiet_condition(value.tested)
        HighIntermediaryRepresentation.Values.Negation: return is_a_quiet_condition(value.negated)
        HighIntermediaryRepresentation.Values.MachineOperation: return is_a_quiet_test(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.Conversion: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func is_a_quiet_test(test: HighIntermediaryRepresentation.Values.MachineOperation): Boolean {
    var answers = test.value_type
    var is_a_test = answers.kind == 'scalar' and answers.name == "Boolean"
    return is_a_test and are_quiet_conditions(test.left, test.right)
}

func are_quiet_conditions(
    left: Value?,
    right: Value?,
): Boolean {
    return is_a_quiet_condition(left) and is_a_quiet_condition(right)
}

func folded_with_a_left(
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: Value,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): Value? {
    var left_holds = left.number != 0
    if operator == 'and' and not left_holds {
        return left
    }
    if operator == 'or' and left_holds {
        return left
    }
    return right
}

func reads_the_bound_member(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    fallback context.current_function.bound_member_type
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return listed.name == "attributes"
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return listed.name == "attributes"
    }
    return false
}

func with_its_links(
    condition: Expression?,
): Expression? {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return linked_member(condition.target, condition)
    }
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        if reads_the_bound_member(condition) {
            return condition
        }
        return linked_member(condition.target, condition)
    }
    return condition
}

func linked_member(
    target: Expression?,
    member: Expression,
): Expression {
    var prefixes = List<Expression>()
    var rooted = collect_prefixes(target, prefixes)
    if not rooted {
        return member
    }
    var outer_pending = context.pending
    context.pending = List<Statement>()
    context.scope.enter()
    var chosen = List<Expression>()
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        var probed = value_of(prefix, null)
        if probed.value_type.is_nullable {
            chosen.append(prefix)
            var printer = Printers.Spite.ExpressionPrinter(prefix)
            var path = printer.text()
            var present = probed.value_type.present()
            context.scope.narrow(path, present)
        }
        index = index + 1
    }
    context.scope.leave()
    context.pending = outer_pending
    if chosen.is_empty() {
        return member
    }
    var joined = chosen[0]
    var joined_index = 1
    while joined_index < chosen.count() {
        var next = chosen[joined_index]
        joined = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(joined, 'and', next)
        joined_index = joined_index + 1
    }
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(joined, 'and', member)
}

func collect_prefixes(
    expression: Expression?,
    into: List<Expression>,
): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var rooted = collect_prefixes(expression.target, into)
        into.append(expression)
        return rooted
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback not expression.is_a_class_name and not expression.name.starts_with("$")
        into.append(expression)
        return true
    }
    return false
}

func condition_of(
    expression: Expression?,
): Value {
    var written_value = value_of(expression, null)
    var is_a_maybe_handle = written_value.value_type.kind == 'handle' and written_value.value_type.is_nullable
    if is_a_maybe_handle {
        return HighIntermediaryRepresentation.Values.PresenceTest(written_value)
    }
    var value = result_of_handle(written_value)
    if value.class == HighIntermediaryRepresentation.Values.LocalRead and context.null_locals.contains(value.name) {
        return boolean_constant(false)
    }
    var present_type = value.value_type.present()
    if value.value_type.is_nullable and context.is_boolean(present_type) {
        var held = held_once(value)
        var there = HighIntermediaryRepresentation.Values.PresenceTest(held)
        var flag = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', held)
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', there, flag)
    }
    if value.value_type.is_nullable {
        return HighIntermediaryRepresentation.Values.PresenceTest(value)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        var checked = proven_check_of(value)
        if checked {
            return checked
        }
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead and context.proven_locals.contains(value.name) {
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
    }
    if not context.is_boolean(value.value_type) {
        var shown = context.shown(value.value_type)
        typing.refuse_not_a_condition(context, shown)
    }
    return value
}

func proven_check_of(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
): Value? {
    fallback conversion.kind == 'proven' and not context.is_boolean(conversion.value_type)
    crash conversion.converted
    return HighIntermediaryRepresentation.Values.PresenceTest(conversion.converted)
}

func unary_value(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
    expected: Model.Type?,
): Value {
    if unary.operator == 'not' {
        var negated = condition_of(unary.operand)
        if negated.class == HighIntermediaryRepresentation.Values.WholeNumber {
            var flipped = 1
            if negated.number != 0 {
                flipped = 0
            }
            var boolean = context.boolean()
            return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flipped)
        }
        return HighIntermediaryRepresentation.Values.Negation(negated)
    }
    var operand = value_of(unary.operand, expected)
    if operand.value_type.kind == 'object' {
        refuse_a_missing_operator(operand, "negate", "'-'", "negate()")
        var no_arguments = List<Value>()
        return method_call(operand, "negate", no_arguments)
    }
    if operand.class == HighIntermediaryRepresentation.Values.WholeNumber {
        var zero: Long = 0
        return HighIntermediaryRepresentation.Values.WholeNumber(operand.value_type, zero - operand.number)
    }
    var zero_value: Value = HighIntermediaryRepresentation.Values.WholeNumber(
        operand.value_type,
        0,
    )
    if is_a_decimal_type(operand.value_type) {
        zero_value = HighIntermediaryRepresentation.Values.DecimalNumber(operand.value_type, "-0.0")
    }
    var made = HighIntermediaryRepresentation.Values.MachineOperation(
        operand.value_type,
        'subtract',
        zero_value,
        operand,
    )
    crash unary.operand
    var printer = Printers.Spite.ExpressionPrinter(unary.operand)
    var negated = printer.text()
    made.shown = "0 - {negated}"
    return made
}

func need(function: Model.FunctionModel) {
    context.need(function)
}

func unbuilt(): Value {
    var buildable = Validators.HighIntermediaryRepresentation.Buildable.Validator()
    var path = context.path()
    buildable.refuse(path, context.line, context.current_class.key)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func holds_a_function_value(name: String): Boolean {
    var held = context.current_class.attribute_named(name)
    fallback held
    return held.attribute_type.kind == 'function'
}

func value_call_of(
    invoked: Value,
    written: List<Expression>,
): Value {
    var callee = invoked
    if invoked.value_type.is_nullable {
        note_a_maybe_null("held", invoked, "", invoked.value_type)
        callee = as_present(invoked)
    }
    var called_type = callee.value_type
    if written.count() != called_type.parameters.count() {
        var shown_type = context.shown(called_type)
        var wanted_count = called_type.parameters.count()
        var given_count = written.count()
        typing.refuse_argument_count(context, shown_type, wanted_count, given_count)
    }
    var arguments = List<Value>()
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var wanted = called_type.parameters[index]
        crash wanted
        var value = fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    var made = HighIntermediaryRepresentation.Values.Function.ValueCall(callee, arguments)
    if called_type.answer {
        made.value_type = called_type.answer
    }
    return made
}

func vector_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "fits_vector" and call.arguments.is_empty()
    var asked = known_class_asked(callee.target)
    fallback asked
    var is_plain = asked.kind == 'scalar' or asked.kind == 'enumeration'
    var fits = is_plain or fits_a_vector(asked)
    return boolean_constant(fits)
}

func any_attribute_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "any_attribute_fits_vector"
    var asked = known_class_asked(callee.target)
    fallback asked
    var skipped = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var path = class_path_of(written)
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var skipped_type = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
        skipped.append(skipped_type.name)
        index = index + 1
    }
    var holds = any_attribute_fits(asked, skipped)
    return boolean_constant(holds)
}

func any_attribute_fits(asked: Model.Type, skipped: List<String>): Boolean {
    if asked.kind == 'shape' and not asked.is_nullable {
        return any_member_fits(asked, skipped)
    }
    fallback context.has_a_class(asked) and not asked.is_nullable
    var model = context.class_of(asked)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type
        var counts = not skipped.contains(held.name) and fits_a_vector(held)
        if counts {
            return true
        }
        index = index + 1
    }
    return false
}

func any_member_fits(asked: Model.Type, skipped: List<String>): Boolean {
    var shape = context.program.shape_keyed(asked.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute and member.answer {
            var counts = not skipped.contains(member.answer.name) and fits_a_vector(member.answer)
            if counts {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func known_class_asked(asked: Expression?): Model.Type? {
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback asked.name.starts_with("$")
        return context.current_class.bound_types[asked.name]
    }
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_class_asked(asked)
    }
    return null
}

func walked_class_asked(asked: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Model.Type? {
    var function = context.current_function
    var described = asked.target
    var names_the_walked = false
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == "class" and described.name == function.bound_parameter
    }
    fallback names_the_walked
    return function.bound_member_type
}

func fits_a_vector(element: Model.Type): Boolean {
    var constraints = Constraints(context, this)
    return constraints.fits_a_vector(element)
}

func pattern_argument_count(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var function = context.current_function
    fallback callee.name == "argument_count" and call.arguments.is_empty() and not function.bound_parameter.is_empty()
    var asked = callee.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter
    }
    fallback names_the_walked
    var walks_functions = function.binds_a_function_declaration and not function.bound_class.is_empty()
    if not walks_functions or function.bound_function.is_empty() {
        typing.refuse_an_argument_count_outside_a_walk(context, function.bound_parameter)
    }
    var walked_class = context.program.class_named(function.bound_class)
    crash walked_class
    var bound = walked_class.function_named(function.bound_function)
    crash bound
    var integer = context.scalar_type("Integer")
    var counted = bound.parameters.count()
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted)
}

func reflection_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var question = callee.name
    var lists = question == "has_function" or question == "argument_count" or question == "function_waits"
    fallback lists or question == "function_writes_parameter"
    var described = constant_class_of(callee.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var pattern = written_pattern_of(call)
    if not pattern {
        refuse_an_unwritten_question(asked, question)
    }
    crash pattern
    var bound_pattern = pattern_of_the_walk(pattern)
    var matching = matching_functions(model, bound_pattern)
    var has_one = not matching.is_empty()
    if question == "has_function" {
        return boolean_constant(has_one)
    } else if question == "argument_count" {
        return counted_arguments(matching, asked, pattern)
    } else if question == "function_waits" {
        return waits_question(matching)
    } else {
        return writes_question(call, asked, matching)
    }
}

func pattern_of_the_walk(pattern: String): String {
    var function = context.current_function
    if function.bound_function.is_empty() or function.bound_pattern.is_empty() {
        return pattern
    }
    var opened = pattern.replace("<", "")
    var unwrapped = opened.replace(">", "")
    if unwrapped == function.bound_pattern {
        return function.bound_function
    }
    return pattern
}

func refuse_an_unwritten_question(asked: String, question: String) {
    if question == "function_writes_parameter" {
        typing.refuse_an_unwritten_parameter(context, asked)
    }
    var example = "run_each"
    if question != "has_function" {
        example = "update_each"
    }
    typing.refuse_an_unwritten_question(context, asked, question, example)
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String? {
    fallback not call.arguments.is_empty()
    var written = call.arguments[0]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(written)
    }
    return null
}

func folded_function_count(
    target: Expression?,
): Value? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return folded_filtered_count(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listed_count(target, "", "")
    }
    return null
}

func folded_filtered_count(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_name_filter(call, callee)
    }
    return null
}

func folded_name_filter(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var is_a_suffix = callee.name == "filter_name_ends_with"
    var is_a_prefix = callee.name == "filter_name_starts_with"
    fallback is_a_suffix or is_a_prefix
    fallback call.arguments.count() == 1
    var argument = call.arguments[0]
    var text: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        text = plain_text_of(argument)
    }
    fallback text
    var listing = callee.target
    if listing.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listing_by_a_name(listing, text, is_a_suffix)
    }
    return null
}

func folded_listing_by_a_name(
    listing: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    text: String,
    is_a_suffix: Boolean,
): Value? {
    if is_a_suffix {
        return folded_listed_count(listing, "", text)
    }
    return folded_listed_count(listing, text, "")
}

func folded_listed_count(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    prefix: String,
    suffix: String,
): Value? {
    fallback member.name == "functions"
    var key = constant_class_of(member.target)
    fallback key
    var model = context.program.class_named(key)
    fallback model
    var reflection = Reflection(context, this)
    var count = 0
    var index = 0
    var has_a_stand_in = model.key != context.program.entry
    while has_a_stand_in and index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_named = declared.name.starts_with(prefix) and declared.name.ends_with(suffix)
        if is_named and not declared.is_synthetic and reflection.is_listed(declared) {
            count = count + 1
        }
        index = index + 1
    }
    var integer = context.scalar_type("Integer")
    var number: Long = count
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func plain_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    return unescaped(piece.text)
}

func constant_class_of(target: Expression?): String? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return constant_class_named(target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return constant_class_of_a_member(target)
    }
    return null
}

func constant_class_named(name: String): String? {
    fallback not context.scope.internal_name_of(name)
    var function = context.current_function
    if function.binds_a_class and name == function.bound_parameter {
        crash function.bound_member_type
        return function.bound_member_type.name
    }
    if name.starts_with("$") {
        return bound_class_named(name)
    }
    if name == "class" {
        fallback not context.current_class.attribute_named("class")
        return context.current_class.key
    }
    var path = List<String>()
    path.append(name)
    return class_key_of_path(path)
}

func bound_class_named(name: String): String? {
    var bound = context.current_class.bound_types[name]
    fallback bound
    fallback bound.constant.is_empty() and not bound.is_nullable
    fallback context.has_a_class(bound)
    return bound.name
}

func constant_class_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String? {
    var function = context.current_function
    var target = member.target
    var names_the_walked = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = target.name == function.bound_parameter and not function.bound_parameter.is_empty()
    }
    if names_the_walked and member.name == "class" {
        fallback function.bound_member_type
        var walked: Model.Type = function.bound_member_type
        fallback context.has_a_class(walked) and not walked.is_nullable
        return walked.name
    }
    var path = class_path_of(member)
    return class_key_of_path(path)
}

func class_key_of_path(path: List<String>): String? {
    fallback not path.is_empty()
    var written = path.join(".")
    fallback not context.resolver.symbols.namespace_folder(written)
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    fallback found or scalars.is_a_scalar(written)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    fallback is_a_class and context.has_a_class(described)
    return described.name
}

func matching_functions(model: Model.ClassModel, pattern: String): List<Model.FunctionModel> {
    var found = List<Model.FunctionModel>()
    var listing = Reflection(context, this)
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var fits = fits_the_pattern(declared.name, pattern)
        if fits and listing.is_listed(declared) {
            found.append(declared)
        }
        index = index + 1
    }
    return found
}

func fits_the_pattern(name: String, pattern: String): Boolean {
    var opening = pattern.index_of("<")
    var closing = pattern.index_of(">")
    if not opening or not closing or closing < opening {
        return name == pattern
    }
    var pattern_length = pattern.length()
    var prefix = pattern.slice(0, opening)
    crash prefix
    var suffix = pattern.slice(closing + 1, pattern_length)
    crash suffix
    var prefix_length = prefix.length()
    var suffix_length = suffix.length()
    var name_length = name.length()
    var long_enough = name_length > prefix_length + suffix_length
    return long_enough and name.starts_with(prefix) and name.ends_with(suffix)
}

func counted_arguments(
    matching: List<Model.FunctionModel>,
    asked: String,
    pattern: String,
): Value {
    var integer = context.scalar_type("Integer")
    var found = matching.first()
    if not found {
        typing.refuse_a_missing_counted_function(context, asked, pattern)
    }
    crash found
    var counted = found.parameters.count()
    refuse_disagreeing_counts(matching, counted, asked, pattern)
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted)
}

# ../../PROOFS.md#how-many-arguments-a-function-takes
func refuse_disagreeing_counts(matching: List<Model.FunctionModel>, counted: Integer, asked: String, pattern: String) {
    var listed = List<String>()
    var agree = true
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var function_count = function.parameters.count()
        if function_count != counted {
            agree = false
        }
        listed.append("'{function.name}' {function_count}")
        index = index + 1
    }
    fallback not agree
    var found = matching.first()
    crash found
    var owner = typing.plain_class_name(found.owner)
    var counts = listed.join(", ")
    typing.refuse_disagreeing_counts(context, asked, pattern, owner, counts)
}

func waits_question(matching: List<Model.FunctionModel>): Value {
    var listing = Reflection(context, this)
    var buildable = matching.filter(listing.can_be_built)
    if buildable.is_empty() {
        return boolean_constant(false)
    }
    return asked_fact("waits", buildable)
}

func writes_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    asked: String,
    matching: List<Model.FunctionModel>,
): Value {
    var place = parameter_place_of(call)
    if place < 0 {
        typing.refuse_an_unwritten_parameter(context, asked)
    }
    if matching.is_empty() {
        return boolean_constant(false)
    }
    var listing = Reflection(context, this)
    var cannot_tell = false
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var parameter_count = function.parameters.count()
        if place >= parameter_count {
            var owner_name = base_name_of(function.owner)
            typing.refuse_a_missing_parameter(context, "{owner_name}.{function.name}", parameter_count, place)
        }
        if not listing.can_be_built(function) {
            cannot_tell = true
        }
        index = index + 1
    }
    if cannot_tell {
        return boolean_constant(true)
    }
    var made = asked_fact("writes", matching)
    made.parameter_index = place
    return made
}

func parameter_place_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Integer {
    if call.arguments.count() != 2 {
        return -1
    }
    var written = call.arguments[1]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_place_of(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_place_of(written)
    }
    return -1
}

func walked_place_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Integer {
    var function = context.current_function
    var asked = member.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter and member.name == "index"
    }
    if not names_the_walked or function.bound_member.is_empty() {
        return -1
    }
    return function.bound_member_index
}

func literal_place_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    if literal.kind != 'integer_literal' {
        return -1
    }
    var place: Integer? = literal.text
    if not place {
        return -1
    }
    return place
}

func asked_fact(
    question: String,
    functions: List<Model.FunctionModel>,
): HighIntermediaryRepresentation.Values.Function.Fact {
    var boolean = context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, question, functions)
    made.is_asked_in_code = true
    made.asking_key = context.current_function.key()
    made.path = context.path()
    made.line = context.line
    made.owner_shown = base_name_of(context.current_class.shown)
    made.function_name = context.current_function.name
    context.facts_asked.append(made)
    functions.each(need)
    return made
}

func base_name_of(shown: String): String {
    var opening = shown.index_of("<")
    if opening and opening > 0 {
        var sliced = shown.slice(0, opening)
        crash sliced
        return sliced
    }
    return shown
}

func dotted_class(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var path = class_path_of(member)
    fallback path.count() > 1
    var written = path.join(".")
    fallback not context.resolver.symbols.namespace_folder(written)
    fallback context.resolver.symbols.find(written, context.current_class.file.namespace)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    fallback described.kind == 'object'
    var reflection = Reflection(context, this)
    return reflection.class_object(described.name)
}

func function_value_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    target: Value,
): Value {
    var function_type = target.value_type
    var shown = context.shown(function_type)
    var is_described = member.name == "name" or member.name == "arguments" or member.name == "returns"
    if not is_described and member.name != "owner" {
        typing.refuse_function_value_member(context, shown, member.name)
    }
    if member.name == "returns" {
        return returned_class_of(function_type)
    }
    var known = known_function_of(member.target, target)
    if not known {
        typing.refuse_an_unnamed_function_value(context, member.name)
    }
    crash known
    if member.name == "owner" {
        return owner_of_a_function_value(target, known)
    }
    if member.name == "name" {
        return described_text(known.name)
    }
    var reflection = Reflection(context, this)
    return reflection.arguments_of(known)
}

func owner_of_a_function_value(
    target: Value,
    known: Model.FunctionModel,
): Value {
    if target.class == HighIntermediaryRepresentation.Values.Function.Value {
        crash target.receiver
        return target.receiver
    }
    if known.is_synthetic {
        typing.refuse_an_unnamed_function_value(context, "owner")
    }
    var owner = context.program.class_named(known.owner)
    crash owner
    var owner_type = owner.type_of_an_instance()
    var receiver = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type)
    return HighIntermediaryRepresentation.Values.AttributeRead(target, receiver)
}

func returned_class_of(function_type: Model.Type): Value {
    var reflection = Reflection(context, this)
    if not function_type.answer {
        return reflection.class_object("Nothing")
    }
    var answer: Model.Type = function_type.answer
    var described = reflection.class_object_of_type(answer)
    crash described
    return described
}

func known_function_of(
    written: Expression?,
    value: Value,
): Model.FunctionModel? {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.function
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return known_local_function(written.name)
    }
    return null
}

func known_local_function(name: String): Model.FunctionModel? {
    var internal_name = context.scope.internal_name_of(name)
    fallback internal_name
    return context.function_locals[internal_name]
}

func is_assigned_again(name: String): Boolean {
    if not context.current_function.declaration {
        return true
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(context.current_function.declaration)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if assigns_the_name(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func assigns_the_name(statement: WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.target, name)
    }
    return false
}

func is_the_name(written: Expression?, name: String): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

func union_member_name_of(union_type: Model.Type, name: String): String {
    var united = union_model_of(union_type)
    var held = united.members.first()
    if not held {
        return name
    }
    if not context.has_a_class(held) {
        return name
    }
    var model = context.class_of(held)
    if model.attribute_named(name) {
        return name
    }
    if model.function_named(name) {
        return name
    }
    if model.function_named("get_{name}") {
        return "get_{name}"
    }
    return name
}

func every_member_reads_its_class(union_type: Model.Type): Boolean {
    var united = union_model_of(union_type)
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fallback context.has_a_class(held)
        var model = context.class_of(held)
        fallback model.attribute_named("class") or model.function_named("get_class")
        index = index + 1
    }
    return true
}

func absent_function(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value? {
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return absent_function_of(listed, index.index)
    }
    return null
}

func absent_function_of(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: Expression?,
): Value? {
    fallback listed.name == "functions"
    var name = key_name_of(written)
    fallback name
    var described = constant_class_of(listed.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    var matching = matching_functions(model, name)
    fallback matching.is_empty() or model.key == context.program.entry
    var reflection = Reflection(context, this)
    var function_type = reflection.reflection_type("Spite.Function")
    var maybe = function_type.nullable()
    return HighIntermediaryRepresentation.Values.NullConstant(maybe)
}

func key_name_of(written: Expression?): String? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return plain_text_of(written)
    }
    return null
}

func symbol_text_of(written: Expression?): String? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return symbol_literal_text(written)
    }
    return null
}

func symbol_literal_text(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String? {
    fallback literal.kind == 'symbol_literal'
    return literal.text
}

    switch operator {
        'plus': return false
        'minus': return false
        'star': return false
        'slash': return false
        'percent': return false
        'end_of_file': return true
        'name': return true
        'class_name': return true
        'generic_name': return true
        'integer_literal': return true
        'decimal_literal': return true
        'text_literal': return true

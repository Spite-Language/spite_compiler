    switch operator {
        'add': return left_type
        'subtract': return left_type
        'multiply': return left_type
        'divide': return left_type
        'remainder': return left_type
        'equal': return context.boolean()
        'not_equal': return context.boolean()
        'less': return context.boolean()
        'less_or_equal': return context.boolean()
        'greater': return context.boolean()
        'greater_or_equal': return context.boolean()
        'and': return context.boolean()
        'or': return context.boolean()
    }
}


}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var scalars = Model.Scalars()
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var temporary_count = 0
var build_defaults_read = 0
var spread_into: Model.FunctionModel? = null
var members_being_compared = List<String>()

func Values(starting_context: Context) {
    context = starting_context
}

func value_of(
    expression: Expression?,
    expected: Model.Type?,
): Value {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return named_or_described(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return literal_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return text_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return member_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return call_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_value(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return binary_value_expecting(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return unary_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return list_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return dictionary_value(expression, expected)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return unbuilt()
    }
}

func refuse_another_signature(given: Model.Type, wanted: Model.Type) {
    fallback not same_signature(given, wanted)
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var wants_an_enum = wanted.kind == 'enumeration'
    var conversion = conversion_name_of(wanted)
    typing.refuse_text_given(context, shown_given, shown_wanted, wants_an_enum, conversion)
    typing.refuse_mismatch(context, shown_given, shown_wanted)
}

func same_signature(given: Model.Type, wanted: Model.Type): Boolean {
    fallback given.parameters.count() == wanted.parameters.count()
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        fallback is_the_same_type(given_parameter, wanted_parameter)
        index = index + 1
    }
    if not given.answer {
        return not wanted.answer
    }
    fallback wanted.answer
    return is_the_same_type(given.answer, wanted.answer)
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func is_the_same_type(given: Model.Type, wanted: Model.Type): Boolean {
    var given_type = context.resolver.same_member_type(given)
    var wanted_type = context.resolver.same_member_type(wanted)
    return given_type.is_the_same_as(wanted_type)
}

func same_member_copy(
    value: Value,
    wanted: Model.Type,
): Value? {
    var given = value.value_type
    fallback given.kind == 'union' and wanted.kind == 'union'
    var given_present = given.present()
    var wanted_present = wanted.present()
    fallback is_the_same_type(given_present, wanted_present)
    if given.is_nullable and not wanted.is_nullable {
        note_a_maybe_null("fit", value, "", wanted)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'proven', value)
    }
    if wanted.is_nullable and not given.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'nullable', value)
    }
    return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_union', value)
}

func named_or_described(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    expected: Model.Type?,
): Value {
    if expected and identifier.is_a_class_name and expected.kind == 'object' and expected.name == "Spite.Class" {
        return class_named_as_a_value(identifier)
    }
    return name_value(identifier)
}

func class_named_as_a_value(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Value {
    var path = List<String>()
    path.append(identifier.name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var reflection = Reflection(context, this)
    return reflection.class_object(described.name)
}

func fitted_value_of(
    expression: Expression?,
    wanted: Model.Type,
): Value {
    var value = value_of(expression, wanted)
    return fitted(value, wanted)
}

func fitted(
    value: Value,
    wanted: Model.Type,
): Value {
    if value.value_type.kind == 'handle' and wanted.kind != 'handle' {
        var debugged = handle_debugged(value, wanted)
        if debugged {
            return debugged
        }
        var result = result_of_handle(value)
        return fitted(result, wanted)
    }
    var given = value.value_type
    if given.kind == 'function' and wanted.kind == 'function' {
        refuse_another_signature(given, wanted)
    }
    if given.is_the_same_as(wanted) {
        return value
    }
    var copied = same_member_copy(value, wanted)
    if copied {
        return copied
    }
    var cast_to_text = cast_text_of(value, wanted)
    if cast_to_text {
        return fitted(cast_to_text, wanted)
    }
    var same_base = given.kind == wanted.kind and given.name == wanted.name
    if same_base and wanted.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'nullable', value)
    }
    if same_base and given.is_nullable {
        note_a_maybe_null("fit", value, "", wanted)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'proven', value)
    }
    if wanted.is_nullable and not given.is_nullable and wanted.kind == 'scalar' and given.kind == 'scalar' {
        var present = wanted.present()
        var fitted_present = fitted(value, present)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'nullable', fitted_present)
    }
    if wanted.kind == 'union' and is_a_member_of(given, wanted) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_union', value)
    }
    var unions = wanted.kind == 'union' and given.kind == 'union' and not given.is_nullable
    if unions and is_a_part_of(given, wanted) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_union', value)
    }
    if wanted.kind == 'shape' and given.kind == 'shape' and given.name != wanted.name {
        refill_a_shape(given, wanted)
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_shape', value)
    }
    if wanted.kind == 'shape' and given.kind != 'shape' {
        if given.is_nullable {
            note_a_maybe_null("shape", value, "", wanted)
        }
        var present = given.present()
        filled_shape(present, wanted)
        if given.is_nullable {
            var absent_type = absent_stand_in()
            filled_shape(absent_type, wanted)
        }
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'into_shape', value)
    }
    if is_the_number_shape(given) and wanted.kind == 'scalar' {
        return number_shape_cast(value, wanted)
    }
    if is_wider(wanted, given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'widen', value)
    }
    if are_whole_numbers(wanted, given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'narrow', value)
    }
    if are_numbers(wanted, given) {
        return decimal_conversion(given, wanted, value)
    }
    var wants_its_reflection = given.kind == 'function' and wanted.kind == 'object' and wanted.name == "Spite.Function"
    if wants_its_reflection {
        var described = described_function(value)
        var receiver = receiver_of_a_function(value)
        if described and receiver {
            var reflection = Reflection(context, this)
            var made = reflection.function_object_in_place(described, receiver)
            return fitted(made, wanted)
        }
        if described {
            var reflected = reflected_function(described)
            return fitted(reflected, wanted)
        }
    }
    refuse_a_walked_name_passed_on(value, wanted)
    var converted = converted_by_its_class(value, wanted)
    if converted {
        return converted
    }
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var wants_an_enum = wanted.kind == 'enumeration'
    var conversion = conversion_name_of(wanted)
    typing.refuse_text_given(context, shown_given, shown_wanted, wants_an_enum, conversion)
    refuse_a_union_member_missing(value, wanted)
    refuse_a_smaller_union_inside(given, wanted)
    refuse_a_missing_conversion(value, wanted)
    typing.refuse_mismatch(context, shown_given, shown_wanted)
    return value
}

func can_be_converted(given: Model.Type, wanted: Model.Type): Boolean {
    var given_kind = given.kind == 'object' or given.kind == 'scalar' or given.kind == 'enumeration'
    var wanted_kind = wanted.kind == 'object' or wanted.kind == 'scalar' or wanted.kind == 'enumeration'
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    var is_generic = shown_given.contains("<") or shown_wanted.contains("<")
    var is_internal = given.name.starts_with("Spite.") or wanted.name.starts_with("Spite.")
    return given_kind and wanted_kind and not given.is_nullable and not is_generic and not is_internal
}

func conversion_name_of(wanted: Model.Type): String {
    var segments = wanted.name.split(".")
    var last = segments.last()
    crash last
    return "{last}(from: String)"
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func enum_named_by_its_path(snake: String): Model.Type? {
    var words = snake.split("_")
    var owner_words = List<String>()
    var last_owner_word = words.count() - 1
    var index = 0
    while index < last_owner_word {
        var word = words[index]
        owner_words.append(word)
        var enum_words = List<String>()
        var rest = index + 1
        while rest < words.count() {
            var enum_word = words[rest]
            enum_words.append(enum_word)
            rest = rest + 1
        }
        var owner_snake = owner_words.join("_")
        var enum_snake = enum_words.join("_")
        var owner_name = pascal_case_of(owner_snake)
        var enum_name = pascal_case_of(enum_snake)
        var path = [owner_name, enum_name]
        var found = context.resolver.declared_type_in(path, context.current_class)
        if found and found.kind == 'enumeration' {
            return found
        }
        index = index + 1
    }
    return null
}

# ../../../spite_spec/specs/values_and_types.md#casting
func converted_by_its_class(
    value: Value,
    wanted: Model.Type,
): Value? {
    var given = value.value_type
    fallback can_be_converted(given, wanted)
    var through_a_conversion = converted_by_a_conversion(value, wanted)
    if through_a_conversion {
        return through_a_conversion
    }
    var reads_text = given.kind == 'object' and given.name == "String"
    var read_in_place = wanted.kind == 'scalar' or wanted.kind == 'enumeration'
    fallback not reads_text or not read_in_place or wanted.is_nullable
    if reads_text and wanted.kind == 'enumeration' {
        return text_read_into_an_enum(value, wanted)
    }
    if given.kind == 'enumeration' and wanted.kind == 'scalar' and wanted.name == "Integer" {
        var integer = context.scalar_type("Integer")
        var widened = HighIntermediaryRepresentation.Values.Conversion(integer, 'widen', value)
        return fitted(widened, wanted)
    }
    fallback given.kind != 'enumeration'
    var owner = context.class_of(given)
    var whole = ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
    if wanted.kind == 'enumeration' and whole.contains(owner.key) {
        var present_enum = wanted.present()
        var numbered = number_read_into_an_enum(value, present_enum)
        return fitted(numbered, wanted)
    }
    return null
}

func refuse_a_written_conversion(wanted: Model.Type) {
    var shown = context.shown(wanted)
    typing.refuse_a_written_conversion(context, shown)
}

# ../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func converted_by_a_conversion(value: Value, wanted: Model.Type): Value? {
    if wanted.kind == 'enumeration' {
        return converted_by_its_owner(value, wanted)
    }
    fallback wanted.kind == 'object' or wanted.kind == 'scalar'
    var target_type = wanted.present()
    var target = context.class_of(target_type)
    var conversion = target.conversion_from(value.value_type)
    fallback conversion
    var reads_text = value.value_type.kind == 'object' and value.value_type.name == "String"
    var may_fail = conversion.answer and conversion.answer.is_nullable
    fallback not reads_text or not may_fail or wanted.is_nullable or wanted.kind != 'scalar'
    need(conversion)
    var receiver = unused_receiver_of(target_type)
    var given = List<Value>()
    given.append(value)
    var called_conversion = HighIntermediaryRepresentation.Values.Call(conversion, receiver, given)
    return fitted(called_conversion, wanted)
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func converted_by_its_owner(value: Value, wanted: Model.Type): Value? {
    var segments = wanted.name.split(".")
    var last = segments.count() - 1
    segments.remove_at(last)
    var owner_key = segments.join(".")
    var owner = context.program.class_named(owner_key)
    fallback owner
    var made_type = wanted.present()
    var conversion = owner.conversion_into(made_type.name, value.value_type)
    fallback conversion
    need(conversion)
    var receiver = this_value()
    if context.current_class.key != owner.key {
        var owner_type = owner.type_of_an_instance()
        receiver = unused_receiver_of(owner_type)
    }
    var given = List<Value>()
    given.append(value)
    var called_conversion = HighIntermediaryRepresentation.Values.Call(conversion, receiver, given)
    return fitted(called_conversion, wanted)
}

func unused_receiver_of(made_type: Model.Type): Value {
    if made_type.kind == 'scalar' {
        return HighIntermediaryRepresentation.Values.WholeNumber(made_type, 0)
    }
    var made = context.class_of(made_type)
    context.need_defaults(made.key)
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, null, no_arguments)
}

func preset_called(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Value? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return preset_of(call, callee)
    }
    return null
}

func preset_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback call.arguments.is_empty()
    var first = member.name.slice(0, 1)
    crash first
    fallback first != first.lower_case()
    var class_path = class_path_of(member.target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var namespace = context.current_class.file.namespace
    var made_class = context.resolver.symbols.find("{written}.{member.name}", namespace)
    fallback not made_class
    var found = context.resolver.symbols.find(written, namespace)
    fallback found or scalars.is_a_scalar(written)
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(class_path, no_type_arguments, context.current_class, context.line)
    fallback described.kind == 'object' or described.kind == 'scalar'
    var model = context.class_of(described)
    var preset = model.preset_named(member.name)
    if not preset and described.kind == 'scalar' {
        var constants = constants_of(model)
        typing.refuse_an_unknown_number_constant(context, written, member.name, constants)
    }
    fallback preset
    need(preset)
    var receiver = unused_receiver_of(described)
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.Call(preset, receiver, no_arguments)
}

func text_read_into_an_enum(
    value: Value,
    wanted: Model.Type,
): Value {
    var enumeration = enum_model_of(wanted)
    need_text_constants()
    var string_model = context.class_of(value.value_type)
    var equals = string_model.function_named("equals")
    crash equals
    need(equals)
    return HighIntermediaryRepresentation.Values.EnumFromText(wanted, enumeration, value)
}

func refuse_a_missing_conversion(value: Value, wanted: Model.Type) {
    var given = value.value_type
    fallback can_be_converted(given, wanted)
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    typing.refuse_a_missing_conversion(context, shown_given, shown_wanted)
}

func refuse_a_walked_name_passed_on(value: Value, wanted: Model.Type) {
    var walking = context.current_function
    fallback not walking.bound_parameter.is_empty()
    fallback wanted.kind == 'object' and wanted.name.starts_with("Spite.")
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        typing.refuse_a_specialised_value(context, walking.bound_parameter)
    }
}

func described_function(value: Value): Model.FunctionModel? {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.function
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return context.function_locals[value.name]
    }
    return null
}

func receiver_of_a_function(
    value: Value,
): Value? {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.receiver
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        var named = context.function_locals[value.name]
        var held = context.function_receivers[value.name]
        if named and held {
            var held_type = context.scope.types[held]
            crash held_type
            return HighIntermediaryRepresentation.Values.LocalRead(held_type, held)
        }
        if named and named.owner == context.current_class.key {
            return this_value()
        }
    }
    return null
}

func reflected_function(described: Model.FunctionModel): Value {
    var reflection = Reflection(context, this)
    var class_value = reflection.class_object(described.owner)
    var no_arguments = List<Value>()
    var functions = method_call(class_value, "get_functions", no_arguments)
    var listing = present_class_of(functions)
    var finder = listing.function_named("get_at")
    crash finder
    need(finder)
    need_text_constants()
    var named = HighIntermediaryRepresentation.Values.TextConstant(described.name)
    named.value_type = context.text()
    var finder_arguments = List<Value>()
    finder_arguments.append(named)
    var found = HighIntermediaryRepresentation.Values.Call(finder, functions, finder_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("reflected_{temporary_count}", found.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, found.value_type, found)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(found.value_type, name)
    var there = HighIntermediaryRepresentation.Values.PresenceTest(local)
    var missing = HighIntermediaryRepresentation.Values.Negation(there)
    var file_path = context.path()
    var function = context.current_function
    var message = "spite: '{described.owner}.{described.name}' has no Spite.Function to describe it, at {file_path}:{context.line} in {function.owner}.{function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = context.line
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements.append(stopped)
    var checked = HighIntermediaryRepresentation.Statements.If(missing, failed, null)
    checked.line = context.line
    context.pending.append(checked)
    var present_type = found.value_type.present()
    return HighIntermediaryRepresentation.Values.Conversion(present_type, 'proven', local)
}

func refill_a_shape(given: Model.Type, wanted: Model.Type) {
    var link = "{given.name}>{wanted.name}"
    if not context.shape_links.contains(link) {
        context.shape_links.append(link)
    }
    var fillers = context.program.fillers_of(given.name)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        filled_shape(filler, wanted)
        index = index + 1
    }
}

func filled_shape(given: Model.Type, wanted: Model.Type) {
    if given.kind == 'union' {
        fill_with_the_members(given, wanted)
        return
    }
    var shape = context.program.shape_keyed(wanted.name)
    crash shape
    var shown = context.shown(given)
    if given.kind == 'enumeration' or given.is_a_walked_name {
        fits_as_an_enum(shape, shown)
    } else {
        fits_as_a_class(shape, given, shown)
    }
    var fillers = context.program.fillers_of(shape.key)
    var known = false
    var index = 0
    while index < fillers.count() {
        var filling = fillers[index]
        if filling.name == given.name and filling.is_a_walked_name == given.is_a_walked_name {
            known = true
        }
        index = index + 1
    }
    if not known {
        var present = given.present()
        fillers.append(present)
    }
}

func fill_with_the_members(given: Model.Type, wanted: Model.Type) {
    var united = union_model_of(given)
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        filled_shape(member, wanted)
        index = index + 1
    }
}

func fits_as_an_enum(shape: Model.ShapeModel, shown: String) {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.name == "_attribute_list" {
            var reflection = Reflection(context, this)
            reflection.make_no_attributes()
        } else if member.name != "to_string" and member.name != "to_debug" {
            typing.refuse_not_a_fit(context, shown, shape.name, member.name)
        }
        index = index + 1
    }
    need_text_constants()
    var text_type = context.text()
    var text_model = context.class_of(text_type)
    var joining = text_model.function_named("sum")
    crash joining
    need(joining)
}

func fits_as_a_class(shape: Model.ShapeModel, given: Model.Type, shown: String) {
    if not context.has_a_class(given) {
        var first = shape.members[0]
        crash first
        typing.refuse_not_a_fit(context, shown, shape.name, first.name)
    }
    var filler = context.class_of(given)
    debugged_when_asked(filler, shape)
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            var attribute = filler.attribute_named(member.name)
            if not attribute {
                typing.refuse_a_missing_attribute(context, shown, shape.name, member.name)
            }
            crash attribute
            refuse_a_mistyped_attribute(attribute, member, given, shape, shown)
        } else {
            need_a_filling_function(filler, member, shown, shape)
        }
        index = index + 1
    }
}

func debugged_when_asked(filler: Model.ClassModel, shape: Model.ShapeModel) {
    fallback shape.member_named("to_debug")
    fallback not filler.function_named("to_debug")
    var debugging = Debugging(context, this)
    debugging.make_to_debug_of(filler)
}

func need_a_filling_function(
    filler: Model.ClassModel,
    member: Model.FunctionModel,
    shown: String,
    shape: Model.ShapeModel,
) {
    if member.name == "_attribute_list" {
        var reflection = Reflection(context, this)
        reflection.make_attribute_list_of(filler)
    }
    var function = filler.function_named(member.name)
    if not function and is_a_copy_name(member.name) {
        var given_count = 0
        if member.name == "_deep_copy_in" {
            given_count = 1
        }
        function = made_copy(filler, member.name, given_count)
    }
    var is_open = shape.key == "Anything" or shape.key == "Number"
    if not function and is_open and member.name == "to_string" {
        function = filler.function_named("to_debug")
    }
    if not function {
        typing.refuse_not_a_fit(context, shown, shape.name, member.name)
    }
    crash function
    refuse_a_mistyped_function(function, member, filler, shape, shown)
    need(function)
}

# ../../PROOFS.md#a-value-fits-a-type
func is_a_written_member(member: Model.FunctionModel, shape: Model.ShapeModel): Boolean {
    var is_open = shape.key == "Anything" or shape.key == "Number"
    fallback not is_open and not member.name.starts_with("_") and not is_a_copy_name(member.name)
    return member.name != "to_debug"
}

func refuse_a_mistyped_attribute(
    attribute: Model.AttributeModel,
    member: Model.FunctionModel,
    given: Model.Type,
    shape: Model.ShapeModel,
    shown: String,
) {
    fallback is_a_written_member(member, shape)
    fallback member.answer
    var wanted: Model.Type = member.answer
    var found = attribute.attribute_type
    if not fits_the_member_type(found, wanted, given, shape) {
        var found_shown = shown_with_an_article(found)
        var wanted_in_the_shape = own_type_in_the_shape(wanted, given, shape)
        var wanted_shown = shown_with_an_article(wanted_in_the_shape)
        typing.refuse_a_mistyped_fit(
            context,
            shown,
            shape.name,
            "attribute '{member.name}' is {found_shown}, but the type needs {wanted_shown}",
        )
    }
}

func refuse_a_mistyped_function(
    function: Model.FunctionModel,
    member: Model.FunctionModel,
    filler: Model.ClassModel,
    shape: Model.ShapeModel,
    shown: String,
) {
    fallback is_a_written_member(member, shape)
    var given = Model.Type('object', filler.key)
    var wanted_count = member.parameters.count()
    var found_count = function.parameters.count()
    if found_count != wanted_count {
        typing.refuse_a_mistyped_fit(
            context,
            shown,
            shape.name,
            "its '{member.name}' takes {found_count} argument(s), but the type needs {wanted_count}",
        )
    }
    var index = 0
    while index < wanted_count {
        var wanted_parameter = member.parameters[index]
        var found_parameter = function.parameters[index]
        crash found_parameter
        var found_type = found_parameter.parameter_type
        var wanted_type = wanted_parameter.parameter_type
        if not fits_the_member_type(found_type, wanted_type, given, shape) {
            var place = index + 1
            var found_shown = shown_with_an_article(found_type)
            var wanted_in_the_shape = own_type_in_the_shape(wanted_type, given, shape)
            var wanted_shown = shown_with_an_article(wanted_in_the_shape)
            typing.refuse_a_mistyped_fit(
                context,
                shown,
                shape.name,
                "argument {place} of its '{member.name}' is {found_shown}, but the type needs {wanted_shown}",
            )
        }
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    var wanted_answer = nothing
    if member.answer {
        wanted_answer = member.answer
    }
    var found_answer = nothing
    if function.answer {
        found_answer = function.answer
    }
    if not fits_the_member_type(found_answer, wanted_answer, given, shape) {
        var returned = shown_with_an_article(found_answer)
        var wanted_in_the_shape = own_type_in_the_shape(wanted_answer, given, shape)
        var needed = shown_with_an_article(wanted_in_the_shape)
        typing.refuse_a_mistyped_fit(
            context,
            shown,
            shape.name,
            "its '{member.name}' returns {returned}, but the type needs {needed}",
        )
    }
}

func own_type_in_the_shape(wanted: Model.Type, given: Model.Type, shape: Model.ShapeModel): Model.Type {
    var own_shape = Model.Type('shape', shape.key)
    var own_type = context.resolver.same_member_type(own_shape)
    if wanted.kind == 'shape' and wanted.name == own_type.name {
        if wanted.is_nullable {
            return given.nullable()
        }
        return given.present()
    }
    return wanted
}

func fits_the_member_type(
    found: Model.Type,
    wanted: Model.Type,
    given: Model.Type,
    shape: Model.ShapeModel,
): Boolean {
    var needed = own_type_in_the_shape(wanted, given, shape)
    var is_open = needed.kind == 'shape' or needed.kind == 'union' or needed.kind == 'function'
    if is_open or found.kind == 'shape' or found.kind == 'union' or found.kind == 'function' {
        return fits_an_open_type(found, needed)
    }
    return found.is_the_same_as(needed)
}

# ../../PROOFS.md#a-value-fits-a-type
func fits_an_open_type(found: Model.Type, needed: Model.Type): Boolean {
    var found_present = found.present()
    var needed_present = needed.present()
    if is_the_same_type(found_present, needed_present) {
        return needed.kind != 'function' or fits_a_function_type(found, needed)
    }
    switch needed.kind {
        'union': return is_a_member_of_the_union(found, needed)
        'shape': return has_the_shape_members(found, needed)
        'nothing': return false
        'scalar': return false
        'object': return false
        'enumeration': return false
        'function': return false
        'handle': return false
        'namespace': return false
        'parameters': return false
        'pattern': return false
    }
}

func fits_a_function_type(found: Model.Type, needed: Model.Type): Boolean {
    fallback found.parameters.count() == needed.parameters.count()
    var index = 0
    while index < needed.parameters.count() {
        var found_parameter = found.parameters[index]
        var needed_parameter = needed.parameters[index]
        crash found_parameter
        fallback is_the_same_type(found_parameter, needed_parameter)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    var found_answer = nothing
    if found.answer {
        found_answer = found.answer
    }
    var needed_answer = nothing
    if needed.answer {
        needed_answer = needed.answer
    }
    return is_the_same_type(found_answer, needed_answer)
}

func is_a_member_of_the_union(found: Model.Type, needed: Model.Type): Boolean {
    fallback found.kind == 'object'
    var united = union_model_of(needed)
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        if member.name == found.name {
            return true
        }
        index = index + 1
    }
    return false
}

func has_the_shape_members(found: Model.Type, needed: Model.Type): Boolean {
    if needed.name == "Anything" or needed.name == "Number" {
        return true
    }
    var shape = context.program.shape_keyed(needed.name)
    if not shape {
        return true
    }
    if found.kind == 'union' {
        var united = union_model_of(found)
        var index = 0
        while index < united.members.count() {
            var member = united.members[index]
            fallback has_the_members(member, shape)
            index = index + 1
        }
        return true
    }
    return has_the_members(found, shape)
}

func has_the_members(found: Model.Type, shape: Model.ShapeModel): Boolean {
    fallback found.kind == 'object' and context.has_a_class(found)
    var model = context.class_of(found)
    var pair = "{found.name}|{shape.key}"
    if members_being_compared.contains(pair) {
        return true
    }
    members_being_compared.append(pair)
    var answer = has_each_member(found, model, shape)
    crash members_being_compared.remove_last()
    return answer
}

# ../../PROOFS.md#a-value-fits-a-type
func has_each_member(found: Model.Type, model: Model.ClassModel, shape: Model.ShapeModel): Boolean {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        fallback not is_a_written_member(member, shape) or has_the_member(found, model, member, shape)
        index = index + 1
    }
    return true
}

func has_the_member(
    found: Model.Type,
    model: Model.ClassModel,
    member: Model.FunctionModel,
    shape: Model.ShapeModel,
): Boolean {
    var attribute = model.attribute_named(member.name)
    if attribute and member.is_an_attribute {
        if member.answer {
            return fits_the_member_type(attribute.attribute_type, member.answer, found, shape)
        }
        return true
    }
    var function = model.function_named(member.name)
    if function and not member.is_an_attribute {
        return has_the_function_types(found, function, member, shape)
    }
    if attribute or function {
        return true
    }
    return false
}

func has_the_function_types(
    found: Model.Type,
    function: Model.FunctionModel,
    member: Model.FunctionModel,
    shape: Model.ShapeModel,
): Boolean {
    fallback function.parameters.count() == member.parameters.count()
    var index = 0
    while index < member.parameters.count() {
        var wanted_parameter = member.parameters[index]
        var found_parameter = function.parameters[index]
        crash found_parameter
        fallback fits_the_member_type(found_parameter.parameter_type, wanted_parameter.parameter_type, found, shape)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    var wanted_answer = nothing
    if member.answer {
        wanted_answer = member.answer
    }
    var found_answer = nothing
    if function.answer {
        found_answer = function.answer
    }
    return fits_the_member_type(found_answer, wanted_answer, found, shape)
}

func shown_with_an_article(of_type: Model.Type): String {
    if of_type.kind == 'nothing' {
        return "Nothing"
    }
    var name = context.shown(of_type)
    var first_letter = name.slice(0, 1)
    crash first_letter
    var vowels = ["A", "E", "I", "O", "U"]
    if vowels.contains(first_letter) {
        return "an {name}"
    }
    return "a {name}"
}

func enum_text(value: Value): Value {
    need_text_constants()
    var made = enum_model_of(value.value_type)
    var string_type = context.text()
    return HighIntermediaryRepresentation.Values.EnumText(string_type, made, value)
}

func is_a_member_of(given: Model.Type, wanted: Model.Type): Boolean {
    var union_type = wanted.present()
    var made = union_model_of(union_type)
    var index = 0
    while index < made.members.count() {
        var member = made.members[index]
        if member.is_the_same_as(given) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_part_of(given: Model.Type, wanted: Model.Type): Boolean {
    var part = union_model_of(given)
    var index = 0
    while index < part.members.count() {
        var member = part.members[index]
        fallback is_a_member_of(member, wanted)
        index = index + 1
    }
    return true
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func refuse_a_union_member_missing(value: Value, wanted: Model.Type) {
    var given = value.value_type
    fallback given.kind == 'union' and wanted.kind == 'union' and not given.is_nullable
    var part = union_model_of(given)
    var missing = List<String>()
    var index = 0
    while index < part.members.count() {
        var member = part.members[index]
        if not is_a_member_of(member, wanted) {
            var shown_member = context.shown(member)
            missing.append(shown_member)
        }
        index = index + 1
    }
    var shown_given = context.shown(given)
    var shown_wanted = context.shown(wanted)
    typing.refuse_a_union_member_missing(context, shown_given, shown_wanted, missing)
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func refuse_a_smaller_union_inside(given: Model.Type, wanted: Model.Type) {
    fallback given.kind == 'object' and wanted.kind == 'object' and not given.is_nullable
    var given_model = context.program.class_named(given.name)
    var wanted_model = context.program.class_named(wanted.name)
    fallback given_model and wanted_model
    fallback given_model.file.path == wanted_model.file.path
    var names = given_model.bound_types.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var inside = given_model.bound_types[name]
        var wanted_inside = wanted_model.bound_types[name]
        crash inside
        crash wanted_inside
        var both_unions = inside.kind == 'union' and wanted_inside.kind == 'union' and not inside.is_nullable
        if both_unions and is_a_part_of(inside, wanted_inside) {
            var shown_given = context.shown(given)
            var shown_wanted = context.shown(wanted)
            var shown_inside = context.shown(inside)
            var shown_wanted_inside = context.shown(wanted_inside)
            typing.refuse_a_smaller_union_inside(context, shown_given, shown_wanted, shown_inside, shown_wanted_inside)
        }
        index = index + 1
    }
}

func union_model_of(union_type: Model.Type): Model.UnionModel {
    var parts = union_type.name.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var owner_length = owner_key.length()
    var name_length = union_type.name.length()
    var simple = union_type.name.slice(owner_length + 1, name_length)
    crash simple
    var made = owner.union_named(simple)
    crash made
    return made
}

func is_wider(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    fallback both_scalars
    var wanted_scalar = scalars.of(wanted.name)
    var given_scalar = scalars.of(given.name)
    crash wanted_scalar
    crash given_scalar
    var same_family = wanted_scalar.is_decimal == given_scalar.is_decimal
    var keeps_the_sign = wanted_scalar.is_signed or not given_scalar.is_signed
    var grows = wanted_scalar.size > given_scalar.size and given.name != "Boolean"
    return same_family and grows and keeps_the_sign
}

func are_whole_numbers(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    var neither_nullable = not wanted.is_nullable and not given.is_nullable
    fallback both_scalars and neither_nullable
    return is_a_whole_number(wanted) and is_a_whole_number(given)
}

func are_numbers(wanted: Model.Type, given: Model.Type): Boolean {
    var both_scalars = wanted.kind == 'scalar' and given.kind == 'scalar'
    var neither_nullable = not wanted.is_nullable and not given.is_nullable
    fallback both_scalars and neither_nullable
    return wanted.name != "Boolean" and given.name != "Boolean"
}

func decimal_conversion(
    given: Model.Type,
    wanted: Model.Type,
    value: Value,
): Value {
    if is_a_whole_number(given) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'to_decimal', value)
    }
    if is_a_whole_number(wanted) {
        return HighIntermediaryRepresentation.Values.Conversion(wanted, 'to_whole', value)
    }
    return HighIntermediaryRepresentation.Values.Conversion(wanted, 'narrow_decimal', value)
}

func is_a_whole_number(of_type: Model.Type): Boolean {
    var scalar = scalars.of(of_type.name)
    crash scalar
    return not scalar.is_decimal and of_type.name != "Boolean"
}

func literal_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    expected: Model.Type?,
): Value {
    switch literal.kind {
        'integer_literal': return whole_number_value(literal.text, expected)
        'decimal_literal': return decimal_value(literal.text, expected)
        'keyword_true': return boolean_value(1)
        'keyword_false': return boolean_value(0)
        'keyword_null': return null_value(expected)
        'symbol_literal': return symbol_value(literal.text, expected)
        'keyword_this': return this_value()
        'end_of_file': return unbuilt()
        'name': return unbuilt()
        'class_name': return unbuilt()
        'generic_name': return unbuilt()
        'text_literal': return unbuilt()
        'open_brace': return unbuilt()
        'close_brace': return unbuilt()
        'open_parenthesis': return unbuilt()
        'close_parenthesis': return unbuilt()
        'open_bracket': return unbuilt()
        'close_bracket': return unbuilt()
        'comma': return unbuilt()
        'dot': return unbuilt()
        'dots': return unbuilt()
        'colon': return unbuilt()
        'question': return unbuilt()
        'equals': return unbuilt()
        'plus': return unbuilt()
        'minus': return unbuilt()
        'star': return unbuilt()
        'slash': return unbuilt()
        'percent': return unbuilt()
        'equal_equal': return unbuilt()
        'not_equal': return unbuilt()
        'less': return unbuilt()
        'greater': return unbuilt()
        'less_or_equal': return unbuilt()
        'greater_or_equal': return unbuilt()
        'and': return unbuilt()
        'or': return unbuilt()
        'not': return unbuilt()
        'keyword_function': return unbuilt()
        'keyword_variable': return unbuilt()
        'keyword_enum': return unbuilt()
        'keyword_union': return unbuilt()
        'keyword_type': return unbuilt()
        'keyword_return': return unbuilt()
        'keyword_if': return unbuilt()
        'keyword_else': return unbuilt()
        'keyword_while': return unbuilt()
        'keyword_switch': return unbuilt()
        'keyword_fallback': return unbuilt()
        'keyword_crash': return unbuilt()
        'keyword_load': return unbuilt()
        'keyword_generic': return unbuilt()
        'keyword_singleton': return unbuilt()
    }
}

func whole_number_value(written: String, expected: Model.Type?): Value {
    var number: Long? = written
    if not number {
        typing.refuse_a_literal_too_large(context, written)
    }
    crash number
    var number_type = context.scalar_type("Integer")
    if expected {
        var wanted = expected.present()
        if is_a_decimal_type(wanted) {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, written)
        }
        if context.is_a_number(wanted) {
            number_type = wanted
            refuse_a_literal_out_of_range(number, wanted)
        }
    }
    var largest_integer: Long = 2147483647
    if number > largest_integer and number_type.name == "Integer" {
        number_type = context.scalar_type("Long")
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(number_type, number)
}

func refuse_a_literal_out_of_range(number: Long, number_type: Model.Type) {
    var scalar = scalars.of(number_type.name)
    fallback scalar
    typing.refuse_literal_range(context, number, scalar.name, scalar.size, scalar.is_signed)
}

func is_a_decimal_type(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.is_decimal
}

func decimal_value(written: String, expected: Model.Type?): Value {
    var decimal_type = context.scalar_type("Float")
    if expected and expected.name == "Double" {
        decimal_type = context.scalar_type("Double")
    }
    refuse_a_decimal_too_large(written, decimal_type.name)
    return HighIntermediaryRepresentation.Values.DecimalNumber(decimal_type, written)
}

func refuse_a_decimal_too_large(written: String, type_name: String) {
    var parsed: Double? = written
    crash parsed
    var doubled = parsed + parsed
    var is_too_large = parsed > 1.0 and doubled == parsed
    var largest_written = "1.7976931348623157e+308"
    if type_name == "Float" {
        var largest_float: Double = 340282346638528859811704183484516925440.0
        is_too_large = parsed > largest_float
        largest_written = "3.4028235e+38"
    }
    fallback is_too_large
    typing.refuse_a_decimal_too_large(context, written, type_name, largest_written)
}

func boolean_value(number: Long): Value {
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func null_value(expected: Model.Type?): Value {
    if expected {
        if expected.is_nullable {
            return HighIntermediaryRepresentation.Values.NullConstant(expected)
        }
        var made = default_of_a_type(expected)
        if made {
            return made
        }
    }
    typing.refuse_null_without_a_type(context)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func default_of_a_type(wanted: Model.Type): Value? {
    if wanted.kind == 'object' and wanted.name == "String" {
        return described_text("")
    }
    if wanted.kind == 'scalar' {
        var is_a_decimal = wanted.name == "Float" or wanted.name == "Double"
        if is_a_decimal {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, "0.0")
        }
        return HighIntermediaryRepresentation.Values.WholeNumber(wanted, 0)
    }
    if wanted.kind == 'shape' {
        return default_of_a_shape(wanted)
    }
    if wanted.kind == 'enumeration' {
        return first_enum_value(wanted)
    }
    fallback wanted.kind == 'object'
    var made = context.class_of(wanted)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    var arguments = List<Value>()
    if constructor {
        if not constructor.parameters.is_empty() {
            return HighIntermediaryRepresentation.Values.MakeObject(wanted, null, arguments)
        }
        need(constructor)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(wanted, constructor, arguments)
}

func default_of_a_shape(wanted: Model.Type): Value? {
    var shape = context.program.shape_keyed(wanted.name)
    fallback shape
    context.object_count = context.object_count + 1
    var key = "Object{context.object_count}"
    var model = Model.ClassModel(key, "Object", context.current_class.file)
    var defaults = List<Value>()
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            crash member.answer
            var field_type: Model.Type = member.answer
            var field = default_of_a_type(field_type)
            crash field
            var attribute = Model.AttributeModel(member.name, key, field_type)
            model.declared_attributes.append(attribute)
            defaults.append(field)
        }
        index = index + 1
    }
    key = stable_object_key(model)
    context.program.add(model)
    context.need_defaults(key)
    var object_type = Model.Type('object', key)
    var no_arguments = List<Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(object_type, null, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", object_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object_type, made)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(object_type, name)
    var field_index = 0
    while field_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[field_index]
        var value = defaults[field_index]
        crash value
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Attribute(local, attribute, value)
        assigned.line = context.line
        context.pending.append(assigned)
        field_index = field_index + 1
    }
    return fitted(local, wanted)
}

func symbol_value(name: String, expected: Model.Type?): Value {
    if expected {
        if expected.kind == 'enumeration' {
            return enum_value(name, expected)
        }
        typing.refuse_symbol_for_text(context, name, expected.name)
    }
    typing.refuse_symbol_without_an_enum(context, name)
    return unbuilt()
}

func enum_value(name: String, expected: Model.Type): Value {
    var made = enum_model_of(expected)
    var place = made.values.index_of(name)
    if not place {
        typing.refuse_not_a_value(context, name, made.name, made.values)
    }
    crash place
    var number = made.numbers[place]
    crash number
    var present = expected.present()
    return HighIntermediaryRepresentation.Values.WholeNumber(present, number)
}

func first_enum_value(enum_type: Model.Type): Value {
    var made = enum_model_of(enum_type)
    var first_name = made.values.first()
    crash first_name
    return enum_value(first_name, enum_type)
}

func enum_model_of(enum_type: Model.Type): Model.EnumModel {
    var parts = enum_type.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    return made
}

func this_value(): Value {
    var key = context.current_class.key
    if scalars.of(key) {
        var number = context.scalar_type(key)
        return HighIntermediaryRepresentation.Values.ThisRead(number)
    }
    var own = context.current_class.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.ThisRead(own)
}

func text_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral,
): Value {
    var joined: Value? = null
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        if not piece.text.is_empty() or literal.pieces.count() == 1 {
            need_text_constants()
            var written = unescaped(piece.text)
            var constant = HighIntermediaryRepresentation.Values.TextConstant(written)
            joined = joined_with(joined, constant)
        }
        if piece.hole {
            var hole = hole_text_of(piece.hole)
            joined = joined_with(joined, hole)
        }
        index = index + 1
    }
    crash joined
    return joined
}

func unescaped(written: String): String {
    var pieces = List<String>()
    var index = 0
    while index < written.length() {
        var code = written.byte_at(index)
        if code == 92 and index + 1 < written.length() {
            var piece = escaped_text_of(written, index + 1)
            pieces.append(piece)
            index = index + 1 + piece.length()
        } else {
            var letter = written[index]
            crash letter
            pieces.append(letter)
            index = index + letter.length()
        }
    }
    return pieces.join("")
}

func escaped_text_of(written: String, at: Integer): String {
    var escaped = written.byte_at(at)
    if escaped == 110 {
        return "\n"
    } else if escaped == 116 {
        return "\t"
    } else if escaped == 114 {
        return "\r"
    } else {
        return letter_at(written, at)
    }
}

func letter_at(written: String, at: Integer): String {
    var letter = written[at]
    crash letter
    return letter
}

func need_text_constants() {
    var path = List<String>()
    path.append("String")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var string_type = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var string_model = context.class_of(string_type)
    context.need_defaults(string_model.key)
    var append_code = string_model.function_named("append_code")
    crash append_code
    need(append_code)
    var making_room = string_model.function_named("_make_room_for")
    crash making_room
    need(making_room)
}

func hole_text_of(hole: Expression): Value {
    var written_value = value_of(hole, null)
    var value = result_of_handle(written_value)
    var string_type = context.text()
    context.hole_is_text = value.value_type.is_the_same_as(string_type)
    if context.hole_is_text {
        return value
    }
    if value.value_type.kind == 'enumeration' and not value.value_type.is_nullable {
        return enum_text(value)
    }
    var no_arguments = List<Value>()
    return method_call(value, "to_string", no_arguments)
}

func cast_text_of(
    value: Value,
    wanted: Model.Type,
): Value? {
    var given = value.value_type
    var wants_text = wanted.kind == 'object' and wanted.name == "String"
    fallback wants_text and not given.is_nullable and given.name != "String"
    if given.kind == 'enumeration' {
        return enum_text(value)
    }
    var has_text = given.kind == 'scalar' or given.kind == 'object'
    fallback has_text
    var model = context.class_of(given)
    fallback model.function_named("to_string")
    var no_arguments = List<Value>()
    return method_call(value, "to_string", no_arguments)
}

func joined_with(
    joined: Value?,
    next: Value,
): Value {
    if not joined {
        return next
    }
    var arguments = List<Value>()
    arguments.append(next)
    var summed = method_call(joined, "sum", arguments)
    if summed.class == HighIntermediaryRepresentation.Values.Call {
        summed.is_a_join = true
        need_the_join_in_one_piece()
    }
    return summed
}

func need_the_join_in_one_piece() {
    var string_type = context.text()
    var string_model = context.class_of(string_type)
    var appending = string_model.function_named("_append_text")
    crash appending
    need(appending)
    var making_room = string_model.function_named("_make_room_for")
    crash making_room
    need(making_room)
}

func name_value(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Value {
    var internal_name = context.scope.internal_name_of(identifier.name)
    if internal_name {
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var declared_type = context.scope.types[internal_name]
        crash declared_type
        if declared_type.is_nullable and not local_type.is_nullable {
            note_a_loop_read(internal_name)
        }
        var narrows_a_handle = declared_type.kind == 'handle' and local_type.kind != 'handle'
        if narrows_a_handle {
            var handle_read = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            var joined_read = result_of_handle(handle_read)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'present', joined_read)
        }
        var is_boxed = declared_type.kind == 'shape' and is_held_in_a_box(local_type)
        if is_boxed {
            var boxed = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'unbox', boxed)
        }
        return HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    }
    var attribute = context.current_class.attribute_named(identifier.name)
    if attribute {
        var own = this_value()
        if own.value_type.kind == 'scalar' {
            return number_room(own, attribute)
        }
        var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
        return narrowed(read, "this.{identifier.name}")
    }
    var function = context.current_class.function_named(identifier.name)
    if function {
        return function_value(function)
    }
    var walking = context.current_function
    var names_the_walked = identifier.name == walking.bound_parameter and not walking.bound_parameter.is_empty()
    if names_the_walked {
        return walked_name_value(walking)
    }
    var reflection = Reflection(context, this)
    if identifier.name == "class" {
        return reflection.class_object(context.current_class.key)
    }
    if identifier.name == "namespace" {
        var own_namespace = reflection.namespace_of(context.current_class.key)
        var found_namespace = reflection.namespace_object(own_namespace)
        if found_namespace.value_type.is_nullable {
            return found_namespace
        }
        var maybe_type = found_namespace.value_type.nullable()
        var maybe = HighIntermediaryRepresentation.Values.Conversion(maybe_type, 'nullable', found_namespace)
        return narrowed(maybe, "this.namespace")
    }
    if identifier.name.starts_with("$") {
        var bound = context.current_class.bound_types[identifier.name]
        if not bound {
            typing.refuse_an_undeclared_generic(context, identifier.name)
        }
        crash bound
        if not bound.constant.is_empty() {
            return constant_of(bound)
        }
        return reflection.class_object(bound.name)
    }
    var getter = context.current_class.function_named("get_{identifier.name}")
    if getter and getter.parameters.is_empty() and getter.answer {
        return own_getter_read(getter)
    }
    var folder = context.resolver.symbols.namespace_folder(identifier.name)
    if folder {
        return reflection.namespace_object(folder.namespace)
    }
    var known = KnownCalls(context, this)
    known.refuse_a_value_read(identifier.name)
    typing.refuse_unknown_name(context, identifier.name)
    return unbuilt()
}

func own_getter_read(getter: Model.FunctionModel): Value {
    var no_written = List<Expression>()
    var own = this_value()
    return called(getter, own, no_written)
}

func walked_name_value(walking: Model.FunctionModel): Value {
    if walking.binds_a_class {
        return bound_class_object(walking)
    }
    need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(walking.bound_member)
    made.value_type = context.resolver.walked_name_type()
    return made
}

func constant_of(bound: Model.Type): Value {
    var plain = Model.Type(bound.kind, bound.name)
    if bound.name == "Boolean" {
        return boolean_constant(bound.constant == "true")
    } else if bound.name == "String" {
        return text_constant_of(bound.constant)
    } else if bound.name == "Float" {
        return HighIntermediaryRepresentation.Values.DecimalNumber(plain, bound.constant)
    } else {
        return whole_constant(plain, bound.constant)
    }
}

func text_constant_of(written: String): Value {
    var length = written.length()
    var inside = written.slice(1, length - 1)
    crash inside
    return described_text(inside)
}

func boolean_constant(holds: Boolean): Value {
    var number = 0
    if holds {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func whole_constant(plain: Model.Type, written: String): Value {
    var number: Long? = written
    crash number
    return HighIntermediaryRepresentation.Values.WholeNumber(plain, number)
}

func function_value(function: Model.FunctionModel): Value {
    need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    var last = function.parameters.last()
    if last {
        function_type.is_variadic = last.is_variadic
    }
    var own = this_value()
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, function, own)
}

func bound_function_value(
    function: Model.FunctionModel,
    receiver: Value,
): Value {
    need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, function, receiver)
}

func number_room(
    number: Value,
    attribute: Model.AttributeModel,
): Value {
    var scalar = scalars.of(number.value_type.name)
    crash scalar
    var room_type = attribute.attribute_type
    var room_model = context.class_of(room_type)
    context.need_defaults(room_model.key)
    var constructor = constructor_of(room_model)
    crash constructor
    need(constructor)
    var integer = context.scalar_type("Integer")
    var size = HighIntermediaryRepresentation.Values.WholeNumber(integer, scalar.size)
    var arguments = List<Value>()
    arguments.append(size)
    var made = HighIntermediaryRepresentation.Values.MakeObject(room_type, constructor, arguments)
    return HighIntermediaryRepresentation.Values.NumberRoom(made, number, scalar.size)
}

func is_held_in_a_box(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' or of_type.kind == 'enumeration'
}

func narrowed(
    value: Value,
    path: String,
): Value {
    var narrowed_type = context.scope.narrowed_type_of(path)
    if narrowed_type {
        note_a_loop_read(path)
        note_a_narrowed_read(value, path)
        var is_boxed = value.value_type.kind == 'shape' and is_held_in_a_box(narrowed_type)
        if is_boxed {
            return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'unbox', value)
        }
        return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'present', value)
    }
    return value
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func note_a_narrowed_read(value: Value, path: String) {
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    var start = context.scope.stamp_of(path)
    var end = context.logged_calls.count()
    fallback start < end or not context.loop_bases.is_empty()
    var read = HighIntermediaryRepresentation.NarrowedRead(path, value.attribute)
    read.calls = context.logged_calls
    read.call_lines = context.logged_lines
    read.start = start
    read.end = end
    read.loop_end = end
    read.line = context.line
    read.path = context.path()
    read.owner = typing.plain_class_name(context.current_class.shown)
    read.function_name = typing.shown_function_name(context.current_function)
    context.narrowed_reads.append(read)
}

func note_a_loop_read(path: String) {
    fallback not context.loop_bases.is_empty()
    fallback not context.loop_reads.contains(path)
    context.loop_reads.append(path)
}

func member_value(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value {
    var named_namespace = namespace_named(member)
    if named_namespace {
        return named_namespace
    }
    var dotted = dotted_class(member)
    if dotted {
        return dotted
    }
    var described_member = bound_parameter_member(member)
    if described_member {
        return described_member
    }
    refuse_a_list_over_a_type(member)
    var folded_flag = folded_class_flag(member)
    if folded_flag {
        return folded_flag
    }
    var generic_values = generic_enum_values(member)
    if generic_values {
        return generic_values
    }
    var reflected = reflected_member(member)
    if reflected {
        return reflected
    }
    var bound_singleton = bound_singleton_question(member)
    if bound_singleton {
        return bound_singleton
    }
    refuse_a_class_function_value(member)
    var written_target = value_of(member.target, null)
    if written_target.value_type.kind == 'handle' {
        return handle_member(written_target, member.name)
    }
    var target = written_target
    var folded_setting = folded_build_read(target, member.name)
    if folded_setting {
        return folded_setting
    }
    if target.value_type.kind == 'function' {
        return function_value_member(member, target)
    }
    var names_a_symbol = target.value_type.is_a_walked_name and not target.value_type.is_nullable
    if names_a_symbol and member.name == "name" {
        return target
    }
    if member.name == "class" and not has_its_own_class(target) {
        var reflection = Reflection(context, this)
        if target.value_type.kind == 'enumeration' {
            reflection.refuse_a_maybe_enum(target)
            return reflection.enum_object(target.value_type.name)
        }
        return reflection.class_of_value(target)
    }
    if target.value_type.kind == 'shape' {
        var no_arguments = List<Expression>()
        if member.name == "attributes" {
            listing_attributes(target.value_type)
            return shape_call(target, "_attribute_list", no_arguments)
        }
        var shape_function = shape_function_value(target, member.name)
        if shape_function {
            return shape_function
        }
        return shape_call(target, member.name, no_arguments)
    }
    if target.value_type.kind == 'union' {
        var read_name = union_member_name_of(target.value_type, member.name)
        var through = union_shape_of(target.value_type, read_name)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', target)
        var none_written = List<Expression>()
        return shape_call(shaped, read_name, none_written)
    }
    if target.value_type.is_nullable {
        note_a_maybe_null("member", target, member.name, target.value_type)
        target = as_present(target)
    }
    var owner = present_class_of(target)
    refuse_a_private_name(owner, member.name)
    var attribute = owner.attribute_named(member.name)
    var getter = owner.function_named("get_{member.name}")
    var spelled_preset = pascal_case_of(member.name)
    if owner.preset_named(spelled_preset) {
        typing.refuse_constant_on_value(context, owner.shown, spelled_preset)
    }
    var is_outside = owner.key != context.current_class.key
    if not getter and is_outside {
        getter = member_template_of(owner, "get_{member.name}")
    }
    var reads_through_a_getter = is_outside or not attribute
    if reads_through_a_getter and getter {
        var no_arguments = List<Expression>()
        var read = called(getter, target, no_arguments)
        var getter_printer = Printers.Spite.ExpressionPrinter(member)
        var getter_path = getter_printer.text()
        var narrowed_type = context.scope.narrowed_type_of(getter_path)
        if narrowed_type {
            var proven = HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'proven', read)
            proven.shown = getter_path
            return proven
        }
        return read
    }
    var lists_its_attributes = not attribute and member.name == "attributes"
    var is_stored_inline = target.value_type.kind == 'scalar' or target.value_type.name == "String"
    if lists_its_attributes and is_stored_inline and not target.value_type.is_nullable {
        var inline_reflection = Reflection(context, this)
        return inline_reflection.no_attribute_list()
    }
    if lists_its_attributes and target.value_type.kind == 'object' {
        var reflection = Reflection(context, this)
        return reflection.attributes_of_an_object(target, owner)
    }
    var lists_its_functions = not attribute and member.name == "functions"
    if lists_its_functions and target.value_type.kind == 'object' {
        var listing = Reflection(context, this)
        var listed = listing.function_list_of(owner)
        var no_values = List<Value>()
        return HighIntermediaryRepresentation.Values.Call(listed, target, no_values)
    }
    var can_be_bound = target.value_type.kind == 'object' or target.value_type.kind == 'scalar'
    if not attribute and can_be_bound and not target.value_type.is_nullable {
        var named_function = owner.function_named(member.name)
        if named_function {
            return bound_function_value(named_function, target)
        }
    }
    if not attribute and owner.key == "DynamicLibrary" {
        var constants = ForeignConstants(context, this)
        return constants.constant_of(target, member.name)
    }
    if not attribute {
        var shown = context.shown(target.value_type)
        typing.refuse_unknown_member(context, shown, member.name)
    }
    crash attribute
    if target.value_type.kind == 'scalar' {
        return number_room(target, attribute)
    }
    var read = HighIntermediaryRepresentation.Values.AttributeRead(target, attribute)
    var printer = Printers.Spite.ExpressionPrinter(member)
    var path = printer.text()
    return narrowed(read, path)
}

func bound_parameter_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var function = context.current_function
    fallback not function.bound_parameter.is_empty()
    var target = member.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return described_by_the_parameter(target, member.name, function)
    }
    return null
}

func described_by_the_parameter(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    asked: String,
    function: Model.FunctionModel,
): Value? {
    fallback target.name == function.bound_parameter
    if function.binds_a_function_declaration {
        return described_function_declaration(asked, function)
    }
    var integer = context.scalar_type("Integer")
    var camel = camel_case_of(function.bound_member)
    var pascal = pascal_case_of(function.bound_member)
    if asked == "name" {
        return described_text(function.bound_member)
    } else if asked == "camel_case_name" {
        return described_text(camel)
    } else if asked == "pascal_case_name" {
        return described_text(pascal)
    } else if asked == "index" {
        return HighIntermediaryRepresentation.Values.WholeNumber(integer, function.bound_member_index)
    } else if asked == "class" {
        return bound_class_object(function)
    } else if asked == "value" {
        return walked_value(function)
    } else if asked == "owner" and function.walked_object {
        return walked_object_read(function)
    } else {
        return null
    }
}

func described_function_declaration(
    asked: String,
    function: Model.FunctionModel,
): Value? {
    var integer = context.scalar_type("Integer")
    if asked == "name" {
        return described_text(function.bound_function)
    } else if asked == "hole" {
        return walked_name_value(function)
    } else if asked == "index" {
        return HighIntermediaryRepresentation.Values.WholeNumber(integer, function.bound_member_index)
    } else {
        return null
    }
}

func walked_value(function: Model.FunctionModel): Value? {
    if function.bound_member_type and not function.walked_object and function.bound_member_type.kind == 'enumeration' {
        return enum_value(function.bound_member, function.bound_member_type)
    }
    if not function.walked_object and not function.walked_declarations_of.is_empty() {
        refuse_a_declaration_value(function)
    }
    fallback function.walked_object
    var object = walked_object_read(function)
    var model = context.class_of(function.walked_object)
    var attribute = model.attribute_named(function.bound_member)
    crash attribute
    return HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
}

func refuse_a_declaration_value(function: Model.FunctionModel) {
    var parts = function.walked_declarations_of.split(".")
    var last = parts.last()
    crash last
    var names = Mapping.Names()
    var instance = names.snake_case_of(last)
    typing.refuse_a_declaration_value(context, function.bound_parameter, instance)
}

func walked_object_read(function: Model.FunctionModel): Value {
    crash function.walked_object
    var internal_name = context.scope.internal_name_of("_walked")
    crash internal_name
    return HighIntermediaryRepresentation.Values.LocalRead(function.walked_object, internal_name)
}

func bound_type_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "has_function" and call.arguments.count() == 1
    var target = callee.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return bound_has_function(target.name, call)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_class_has_function(target, call)
    }
    return null
}

func member_class_has_function(
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value? {
    var function = context.current_function
    fallback target.name == "class" and function.bound_member_type
    var described = target.target
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and described.name == function.bound_parameter {
        return has_function_answer(function.bound_member_type, call)
    }
    return null
}

func bound_has_function(
    bound_name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value? {
    fallback bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    fallback bound
    return has_function_answer(bound, call)
}

func has_function_answer(
    bound: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value? {
    var asked = call.arguments[0]
    var function_name = ""
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        function_name = constant_text_of(asked)
    }
    fallback not function_name.is_empty()
    var answer = 0
    if context.has_a_class(bound) {
        var model = context.class_of(bound)
        if model.function_named(function_name) {
            answer = 1
        }
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, answer)
}

func constant_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    crash literal.pieces.count() == 1
    var piece = literal.pieces[0]
    crash not piece.hole
    return unescaped(piece.text)
}

func bound_class_made(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var function = context.current_function
    fallback callee.name == "class" and call.arguments.is_empty() and function.bound_member_type
    var target = callee.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == function.bound_parameter {
        return default_of_a_type(function.bound_member_type)
    }
    return null
}

func walked_classes_or_values(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "each" and call.arguments.count() == 1
    var listed = callee.target
    var argument = call.arguments[0]
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return walked_listing(listed, argument.name)
    }
    return null
}

func walked_listing(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    walker_name: String,
): Value? {
    var lists_values = listed.name == "values" or listed.name == "classes"
    fallback lists_values
    var walker = context.current_class.function_named(walker_name)
    fallback walker
    fallback walker.template_index < 0 and walker.parameters.count() == 1
    var path = tested_class_path_of(listed.target)
    fallback not path.is_empty()
    if listed.name == "values" {
        return walked_values(walker, path)
    }
    return walked_classes(walker, path)
}

func walked_values(walker: Model.FunctionModel, path: List<String>): Value? {
    var declared = declared_enum_of(path)
    fallback declared
    fallback declared.kind == 'enumeration'
    var enumeration = enum_model_of(declared)
    need(walker)
    var index = 0
    while index < enumeration.values.count() {
        var value_name = enumeration.values[index]
        var value = enum_value(value_name, declared)
        var arguments = List<Value>()
        arguments.append(value)
        var own = this_value()
        var walk_call = HighIntermediaryRepresentation.Values.Call(walker, own, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walked_classes(walker: Model.FunctionModel, path: List<String>): Value? {
    var namespace = path.join(".")
    var folder = context.resolver.symbols.namespace_folder(namespace)
    fallback folder
    var parameter = walker.parameters[0]
    crash parameter
    fallback parameter.parameter_type.name == "Spite.Class"
    var names = classes_of_a_namespace(namespace)
    var index = 0
    while index < names.count() {
        var shown = names[index]
        var made = class_walk_copy(walker, shown, index)
        need(made)
        var arguments = List<Value>()
        var own = this_value()
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, own, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func class_walk_copy(walker: Model.FunctionModel, shown: String, index: Integer): Model.FunctionModel {
    var owner_name = shown.replace(".", "_")
    var called_name = "{walker.name}_over_{owner_name}"
    var known = context.current_class.function_named(called_name)
    if known {
        return known
    }
    var model = context.resolver.class_model_named(shown)
    crash model
    var member_type = Model.Type('object', model.key)
    walker.template_index = 0
    var made = context.resolver.specialized(walker, called_name, shown, member_type, false, context.current_class)
    walker.template_index = -1
    made.is_a_walk_copy = true
    made.bound_member_index = index
    made.binds_a_class = true
    context.current_class.declared_functions.append(made)
    return made
}

func walked_attributes(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "each" and call.arguments.count() == 1
    var listed = callee.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_attributes_of(call, listed)
    }
    return null
}

func walked_attributes_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback listed.name == "attributes"
    var argument = call.arguments[0]
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return walked_by(listed, argument.name)
    }
    return null
}

func walked_by(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
): Value? {
    var walker = context.current_class.function_named(name)
    fallback walker
    fallback walker.parameters.count() == 1 and walker.template_index < 0
    var parameter = walker.parameters[0]
    var described = parameter.parameter_type
    var is_described = described.name == "Spite.Attribute" or described.name == "Spite.AttributeDeclaration"
    fallback is_described and described.kind == 'object' and not described.is_nullable
    var class_path = tested_class_path_of(listed.target)
    if not class_path.is_empty() {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var described_class = context.resolver.class_type_in(
            class_path,
            no_arguments,
            context.current_class,
            context.line,
        )
        if described.name == "Spite.Attribute" {
            refuse_a_walked_kind(walker, described_class, true)
        }
        refuse_a_walk_over_a_type(class_path, described_class)
        return walked_over_the_attributes(walker, described_class, null)
    }
    if described.name != "Spite.Attribute" {
        refuse_an_instance_walk(walker, listed.target)
        return null
    }
    var object = value_of(listed.target, null)
    fallback object.value_type.kind == 'object' and not object.value_type.is_nullable
    var model = context.class_of(object.value_type)
    fallback not model.attribute_named("attributes")
    var held = held_once(object)
    return walked_over_the_attributes(walker, object.value_type, held)
}

func refuse_an_instance_walk(walker: Model.FunctionModel, target: Expression?) {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        refuse_a_named_walk(walker, target)
    }
}

func refuse_a_named_walk(
    walker: Model.FunctionModel,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var is_a_value = not target.is_a_class_name and not target.name.starts_with("$")
    fallback is_a_value
    var object = value_of(target, null)
    var is_an_instance = object.value_type.kind == 'object' and not object.value_type.is_nullable
    fallback is_an_instance and object.value_type.name != "Spite.Class"
    var model = context.class_of(object.value_type)
    fallback not model.attribute_named("attributes")
    refuse_a_walked_kind(walker, object.value_type, false)
}

func refuse_a_walked_kind(walker: Model.FunctionModel, described_class: Model.Type, walks_declarations: Boolean) {
    var model = context.class_of(described_class)
    var first = model.declared_attributes[0]
    fallback first
    var shown = context.shown(described_class)
    typing.refuse_walked_kind(context, walker.name, first.name, shown, walks_declarations)
}

# ../../../spite_spec/specs/metaprogramming.md#walks
func refuse_a_list_over_a_type(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback member.name == "attributes"
    var class_path = tested_class_path_of(member.target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    fallback written.starts_with("$") or found
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described_class = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
    refuse_a_walk_over_a_type(class_path, described_class)
}

# ../../../spite_spec/specs/metaprogramming.md#walks
func refuse_a_walk_over_a_type(class_path: List<String>, described_class: Model.Type) {
    fallback described_class.kind == 'shape'
    var written = class_path.join(".")
    var shown = context.shown(described_class)
    typing.refuse_a_walk_over_a_type(context, written, shown)
}

func walked_over_the_attributes(
    walker: Model.FunctionModel,
    described_class: Model.Type,
    object: Value?,
): Value {
    var model = context.class_of(described_class)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = walk_specialized(walker, attribute, index, described_class, object)
        need(made)
        var arguments = List<Value>()
        if object {
            arguments.append(object)
        }
        var own = this_value()
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, own, arguments)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func walk_specialized(
    walker: Model.FunctionModel,
    attribute: Model.AttributeModel,
    index: Integer,
    described_class: Model.Type,
    object: Value?,
): Model.FunctionModel {
    var owner_name = described_class.name.replace(".", "_")
    var called_name = "{walker.name}_over_{owner_name}_{attribute.name}"
    var known = context.current_class.function_named(called_name)
    if known {
        return known
    }
    walker.template_index = 0
    var made = context.resolver.specialized(
        walker,
        called_name,
        attribute.name,
        attribute.attribute_type,
        false,
        context.current_class,
    )
    walker.template_index = -1
    made.is_a_walk_copy = true
    made.bound_member_index = index
    if not object {
        made.walked_declarations_of = described_class.name
    }
    if object {
        made.walked_object = described_class
        var hidden = Model.ParameterModel("_walked", described_class, false)
        made.parameters.append(hidden)
    }
    context.current_class.declared_functions.append(made)
    return made
}

func bound_singleton_question(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var function = context.current_function
    fallback member.name == "is_singleton" and function.bound_member_type
    var asked = member.target
    var names_the_class = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var described = asked.target
        if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            names_the_class = asked.name == "class" and described.name == function.bound_parameter
        }
    }
    fallback names_the_class
    var bound: Model.Type = function.bound_member_type
    var model = context.program.class_named(bound.name)
    if not model or bound.is_nullable {
        return boolean_constant(false)
    }
    return boolean_constant(model.is_singleton)
}

func bound_class_object(function: Model.FunctionModel): Value {
    crash function.bound_member_type
    var reflection = Reflection(context, this)
    if function.bound_member_type.is_nullable {
        return reflection.class_object("{function.bound_member_type.name}?")
    }
    return reflection.class_object(function.bound_member_type.name)
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func folded_build_read(target: Value, name: String): Value? {
    var held = target.value_type
    fallback held.kind == 'object' and held.name == "Build" and not held.is_nullable
    var flags = context.build_flags
    var is_live = flags["hot_reload"] == "true" or flags["repl"] == "true" or flags["development"] == "true"
    fallback not is_live or is_a_library_option(name)
    context.folded_build_reads = context.folded_build_reads + 1
    return folded_setting_named(name)
}

# ../../../spite_spec/specs/programs.md#build-settings-build
func is_a_library_option(name: String): Boolean {
    var library = Validators.LibraryFile()
    var path = context.path()
    fallback library.holds(path)
    var symbols = context.resolver.symbols
    var paths = symbols.files.keys()
    var index = 0
    while index < paths.count() {
        var source_path = paths[index]
        var source = symbols.files[source_path]
        crash source
        var is_the_library_build = source.namespace == "Build" and library.holds(source_path)
        if is_the_library_build and declares_a_field(source, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func declares_a_field(source: AbstractSyntaxTree.Shapes.SourceFile, name: String): Boolean {
    var index = 0
    while index < source.declarations.count() {
        var declaration = source.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and declaration.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func folded_setting_named(name: String): Value? {
    var settings = context.program.class_named("Build")
    fallback settings
    var field = settings.attribute_named(name)
    fallback field
    var field_type = field.attribute_type
    fallback field_type.kind == 'scalar' or field_type.kind == 'object' and field_type.name == "String"
    var given = context.build_value_given(name)
    if given {
        return build_value_of(given, field_type)
    }
    fallback field.declaration
    var written = field.declaration.value
    return build_default_of(written, field_type)
}

func build_value_of(given: String, field_type: Model.Type): Value? {
    if field_type.name == "String" {
        return described_text(given)
    }
    if field_type.name == "Boolean" {
        var flag = 0
        if given == "true" {
            flag = 1
        }
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag)
    }
    var scalar = scalars.of(field_type.name)
    fallback scalar
    if scalar.is_decimal {
        return HighIntermediaryRepresentation.Values.DecimalNumber(field_type, given)
    }
    var number: Long? = given
    fallback number
    return HighIntermediaryRepresentation.Values.WholeNumber(field_type, number)
}

func build_default_of(
    written: Expression?,
    field_type: Model.Type,
): Value? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        fallback field_type.name == "String" and written.pieces.count() <= 1
        var piece = written.pieces.first()
        if not piece {
            return described_text("")
        }
        fallback not piece.hole
        return described_text(piece.text)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return build_literal_of(written, field_type)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return build_field_default_of(written.name, field_type)
    }
    fallback is_a_constant_default(written)
    return fitted_value_of(written, field_type)
}

func build_field_default_of(name: String, field_type: Model.Type): Value? {
    var settings = context.program.class_named("Build")
    fallback settings and build_defaults_read < 16
    var other = settings.attribute_named(name)
    fallback other and other.attribute_type.name == field_type.name
    build_defaults_read = build_defaults_read + 1
    var folded = folded_setting_named(name)
    build_defaults_read = build_defaults_read - 1
    return folded
}

func build_literal_of(
    written: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    field_type: Model.Type,
): Value? {
    if written.kind == 'keyword_true' {
        return build_value_of("true", field_type)
    }
    if written.kind == 'keyword_false' {
        return build_value_of("false", field_type)
    }
    fallback written.kind == 'integer_literal' or written.kind == 'decimal_literal'
    return fitted_value_of(written, field_type)
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func is_a_constant_default(written: Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return written.kind == 'integer_literal' or written.kind == 'decimal_literal'
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return written.operator == 'minus' and is_a_constant_default(written.operand)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var is_arithmetic = not is_a_comparison(written.operator)
        return is_arithmetic and is_a_constant_default(written.left) and is_a_constant_default(written.right)
    }
    return false
}

func described_text(written: String): Value {
    need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func camel_case_of(written: String): String {
    var pascal = pascal_case_of(written)
    var first = pascal.slice(0, 1)
    crash first
    var length = pascal.length()
    var rest = pascal.slice(1, length)
    crash rest
    var lowered = first.lower_case()
    return "{lowered}{rest}"
}

func pascal_case_of(written: String): String {
    var words = written.split("_")
    var pieces = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var length = word.length()
        var raised = ""
        var rest = ""
        if length > 0 {
            var first = word.slice(0, 1)
            crash first
            raised = first.upper_case()
            var tail = word.slice(1, length)
            crash tail
            rest = tail
        }
        pieces.append("{raised}{rest}")
        index = index + 1
    }
    return pieces.join("")
}

func namespace_named(
    expression: Expression?,
): Value? {
    var path = class_path_of(expression)
    fallback not path.is_empty()
    var written = path.join(".")
    var folder = context.resolver.symbols.namespace_folder(written)
    fallback folder
    var reflection = Reflection(context, this)
    return reflection.namespace_object(folder.namespace)
}

# ../../OPTIMIZATIONS.md#a-question-on-a-codegen-type-folds
func folded_class_flag(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var asks_a_flag = member.name == "is_fixed_size" or member.name == "is_singleton" or member.name == "is_made_plainly"
    var target = member.target
    var bound_name = ""
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        bound_name = target.name
    }
    fallback asks_a_flag and bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    fallback bound
    fallback bound.kind == 'object' and not bound.is_nullable and context.has_a_class(bound)
    var model = context.class_of(bound)
    var holds = model.is_singleton
    if member.name == "is_fixed_size" {
        var reflection = Reflection(context, this)
        holds = reflection.is_fixed_size(model)
    }
    if member.name == "is_made_plainly" {
        holds = model.is_made_plainly()
    }
    var flag = 0
    if holds {
        flag = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag)
}

func generic_enum_values(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback member.name == "values"
    var path = tested_class_path_of(member.target)
    fallback path.count() == 1
    var first = path[0]
    fallback first.starts_with("$")
    return enum_values_of(path)
}

func reflected_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var class_path = class_path_of(member.target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var reflection = Reflection(context, this)
    if written == "Spite.Class" and member.name == "instances" {
        return reflection.every_class()
    }
    if written == "Spite.Namespace" and member.name == "instances" {
        return reflection.every_namespace()
    }
    if member.name == "size" {
        var sized = shape_size_of(class_path)
        if sized {
            return sized
        }
    }
    if member.name == "values" {
        var listed_values = enum_values_of(class_path)
        if listed_values {
            return listed_values
        }
    }
    var described_path = class_path_of(member.target)
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    if found or scalars.is_a_scalar(written) {
        refuse_a_preset_read(described_path, no_type_arguments, member.name)
    }
    var object = reflected_object_of(member.target)
    fallback object
    var reflection_model = context.class_of(object.value_type)
    var getter = reflection_model.function_named("get_{member.name}")
    if not getter and scalars.is_a_scalar(written) {
        var number = number_class_of(described_path)
        var constants = constants_of(number)
        typing.refuse_an_unknown_number_constant(context, written, member.name, constants)
    }
    fallback getter
    var no_written = List<Expression>()
    var read = called(getter, object, no_written)
    var printer = Printers.Spite.ExpressionPrinter(member)
    var path = printer.text()
    return narrowed(read, path)
}

func enum_value_at(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value? {
    var listed = index.target
    var written = index.index
    var lists_the_values = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        lists_the_values = listed.name == "values"
    }
    fallback lists_the_values
    var place = -1
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        place = literal_place_of(written)
    }
    fallback place >= 0
    var path = enum_path_of(listed)
    fallback not path.is_empty()
    var declared = context.resolver.declared_type_in(path, context.current_class)
    fallback declared
    fallback declared.kind == 'enumeration'
    var enumeration = enum_model_of(declared)
    var named = enumeration.values[place]
    var maybe = declared.nullable()
    if not named {
        return HighIntermediaryRepresentation.Values.NullConstant(maybe)
    }
    var found = enum_value(named, declared)
    return HighIntermediaryRepresentation.Values.Conversion(maybe, 'nullable', found)
}

func enum_value_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "find_by_name" and call.arguments.count() == 1
    var listed = callee.target
    var lists_the_values = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        lists_the_values = listed.name == "values"
    }
    fallback lists_the_values
    var path = enum_path_of(listed)
    fallback not path.is_empty()
    var declared = context.resolver.declared_type_in(path, context.current_class)
    fallback declared
    fallback declared.kind == 'enumeration'
    var argument = call.arguments[0]
    var maybe = declared.nullable()
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and argument.kind == 'symbol_literal' {
        var named = fitted_value_of(argument, declared)
        return HighIntermediaryRepresentation.Values.Conversion(maybe, 'nullable', named)
    }
    var text = context.text()
    var written = fitted_value_of(argument, text)
    return fitted(written, maybe)
}

func enum_path_of(listed: Expression?): List<String> {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return class_path_of(listed.target)
    }
    return List<String>()
}

func enum_values_of(path: List<String>): Value? {
    var declared = declared_enum_of(path)
    fallback declared
    fallback declared.kind == 'enumeration'
    var enumeration = enum_model_of(declared)
    var list_type = context.resolver.list_type_of(declared)
    var listed = new_list(list_type)
    var index = 0
    while index < enumeration.numbers.count() {
        var number = enumeration.numbers[index]
        var value = HighIntermediaryRepresentation.Values.WholeNumber(declared, number)
        append_to(listed, value)
        index = index + 1
    }
    return listed
}

func declared_enum_of(path: List<String>): Model.Type? {
    var first = path[0]
    crash first
    if first.starts_with("$") and path.count() == 1 {
        return context.current_class.bound_types[first]
    }
    return context.resolver.declared_type_in(path, context.current_class)
}

func shape_size_of(path: List<String>): Value? {
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    fallback described.kind == 'shape'
    var shape = context.program.shape_keyed(described.name)
    crash shape
    var offset = 0
    var widest = 1
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        if not member.is_an_attribute or member.answer.kind != 'scalar' {
            var written = path.join(".")
            typing.refuse_unsized_type(context, written)
        }
        var width = width_in_a_type(member.answer)
        if width > widest {
            widest = width
        }
        var past = offset % width
        if past > 0 {
            offset = offset + width - past
        }
        offset = offset + width
        index = index + 1
    }
    var tail = offset % widest
    if tail > 0 {
        offset = offset + widest - tail
    }
    var integer = context.scalar_type("Integer")
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, offset)
}

func width_in_a_type(held: Model.Type): Integer {
    var scalar = scalars.of(held.name)
    if held.kind == 'scalar' and scalar {
        return scalar.size
    }
    return 8
}

func refuse_a_preset_read(
    path: List<String>,
    no_type_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    name: String,
) {
    var described = context.resolver.class_type_in(path, no_type_arguments, context.current_class, context.line)
    fallback described.kind == 'scalar' or described.kind == 'object'
    var model = context.class_of(described)
    var spelled = pascal_case_of(name)
    fallback model.preset_named(spelled)
    var written = path.join(".")
    typing.refuse_a_called_constant(context, "{written}.{name}", "{written}.{spelled}()")
}

func reflected_object_of(
    target: Expression?,
): Value? {
    var class_path = class_path_of(target)
    fallback not class_path.is_empty()
    var written = class_path.join(".")
    var reflection = Reflection(context, this)
    var folder = context.resolver.symbols.namespace_folder(written)
    if folder {
        return reflection.namespace_object(folder.namespace)
    }
    var declared_enum = context.resolver.declared_type_in(class_path, context.current_class)
    if declared_enum and declared_enum.kind == 'enumeration' {
        return reflection.enum_object(declared_enum.name)
    }
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    fallback found or scalars.is_a_scalar(written)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    fallback is_a_class
    return reflection.class_object(described.name)
}

func refuse_a_call_on_a_number_class(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    receiver: Value,
) {
    var class_path = class_path_of(callee.target)
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    var reflection_model = context.class_of(receiver.value_type)
    fallback not reflection_model.function_named(callee.name)
    var number = number_class_of(class_path)
    var constants = constants_of(number)
    var spelled = pascal_case_of(callee.name)
    if number.preset_named(spelled) {
        typing.refuse_a_called_constant(context, "{written}.{callee.name}", "{written}.{spelled}()")
    }
    var function = number.function_named(callee.name)
    if function {
        typing.refuse_a_value_function_on_a_class(context, written, callee.name, constants)
    }
    typing.refuse_an_unknown_number_constant(context, written, callee.name, constants)
}

func number_class_of(class_path: List<String>): Model.ClassModel {
    var no_type_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(class_path, no_type_arguments, context.current_class, context.line)
    return context.class_of(described)
}

func constants_of(number: Model.ClassModel): String {
    var names = List<String>()
    var index = 0
    while index < number.declared_functions.count() {
        var function = number.declared_functions[index]
        if function.is_a_preset {
            names.append("{function.name}()")
        }
        index = index + 1
    }
    var last = names.remove_last()
    crash last
    if names.is_empty() {
        return last
    }
    var listed = names.join(", ")
    return "{listed} and {last}"
}

func reflected_receiver(
    target: Expression?,
): Value? {
    return reflected_object_of(target)
}

func called_on_a_class(
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value {
    var owner = context.class_of(receiver.value_type)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function {
        refuse_a_call_on_a_class_object(receiver, name)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    return called(function, receiver, written)
}

func refuse_a_call_on_a_class_object(receiver: Value, name: String) {
    if receiver.class == HighIntermediaryRepresentation.Values.Class.Object {
        refuse_a_class_object_call(receiver, name)
    }
}

func refuse_a_class_object_call(object: HighIntermediaryRepresentation.Values.Class.Object, name: String) {
    var described = context.program.class_named(object.described)
    fallback described
    fallback described.function_named(name) or described.attribute_named(name)
    var plain = typing.plain_class_name(described.shown)
    if scalars.is_a_scalar(described.key) {
        refuse_a_value_function_on_a_number_class(described, plain, name)
    }
    typing.refuse_a_class_as_a_value(context, plain)
}

func refuse_a_value_function_on_a_number_class(described: Model.ClassModel, plain: String, name: String) {
    var listed = constants_of(described)
    typing.refuse_a_value_function_on_a_number_class(context, plain, name, listed)
}

func refuse_a_class_function_value(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var target = member.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        refuse_a_function_of_a_named_class(member, target)
    }
}

func refuse_a_function_of_a_named_class(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    fallback target.is_a_class_name
    fallback not context.scope.internal_name_of(target.name)
    var found = context.resolver.symbols.find(target.name, context.current_class.file.namespace)
    fallback found
    var class_path = List<String>()
    class_path.append(target.name)
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
    fallback described.kind == 'object' and context.has_a_class(described)
    var model = context.class_of(described)
    var function = model.function_named(member.name)
    fallback function
    var names = Mapping.Names()
    var instance = names.snake_case_of(found.simple_name)
    var answer = answer_or_nothing(function)
    var template = "each_{member.name}()"
    if context.is_boolean(answer) {
        template = "filter_{member.name}()"
    }
    typing.refuse_a_class_function_value(context, target.name, member.name, instance, template)
}

func has_its_own_class(target: Value): Boolean {
    if target.value_type.kind == 'union' and not target.value_type.is_nullable {
        return every_member_reads_its_class(target.value_type)
    }
    fallback context.has_a_class(target.value_type)
    var owner = context.class_of(target.value_type)
    if owner.attribute_named("class") {
        return true
    }
    if owner.function_named("get_class") {
        return true
    }
    return false
}

func present_class_of(value: Value): Model.ClassModel {
    var value_type = value.value_type
    if value_type.is_nullable {
        note_a_maybe_null_type(value_type)
    }
    if not context.has_a_class(value_type) {
        var shown_type = context.shown(value_type)
        typing.refuse_no_members(context, shown_type)
    }
    return context.class_of(value_type)
}

func call_value(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    expected: Model.Type?,
): Value {
    var maker = call.callee
    if maker.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if is_a_handle_maker(maker.name) and call.arguments.count() == 1 {
            return handle_value(maker.name, call)
        }
        if maker.name.starts_with("$") {
            return made_from_a_bound_type(call, maker.name)
        }
    }
    var preset = preset_called(call)
    if preset {
        return preset
    }
    var class_path = class_path_of(call.callee)
    if not class_path.is_empty() {
        return constructed(call, class_path, expected)
    }
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if is_a_handle_maker(callee.name) and call.arguments.count() == 1 {
            return handle_value(callee.name, call)
        }
        return own_call(call, callee.name)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_call(call, callee)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return indexed_function_call(call, callee)
    }
    return unbuilt()
}

# ../../../spite_spec/specs/values_and_types.md#casting
func refuse_a_conversion_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made_type: Model.Type,
    expected: Model.Type?,
) {
    fallback call.arguments.count() == 1 and may_be_converted(made_type)
    var argument = call.arguments[0]
    var given = value_of(argument, null)
    var shown = conversion_answer_shown(made_type, given.value_type)
    fallback not shown.is_empty()
    var printer = Printers.Spite.ExpressionPrinter(call)
    var call_text = printer.text()
    var argument_printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = argument_printer.text()
    if expected {
        var wanted = expected.present()
        if is_the_same_type(wanted, made_type) {
            typing.refuse_a_cast_the_place_makes(context, call_text, argument_text)
        }
    }
    typing.refuse_a_conversion_by_name(context, call_text, argument_text, shown)
}

func conversion_answer_shown(made_type: Model.Type, given_type: Model.Type): String {
    var shown = context.shown(made_type)
    var from_text = given_type.kind == 'object' and given_type.name == "String"
    if made_type.kind == 'enumeration' {
        return "{shown}?"
    }
    if made_type.kind == 'scalar' {
        if from_text {
            return "{shown}?"
        }
        return shown
    }
    var made = context.class_of(made_type)
    var conversion = made.conversion_from(given_type)
    fallback conversion
    if conversion.answer and conversion.answer.is_nullable {
        return "{shown}?"
    }
    return shown
}

func may_be_converted(made_type: Model.Type): Boolean {
    if made_type.kind == 'enumeration' or made_type.kind == 'scalar' {
        return true
    }
    fallback made_type.kind == 'object'
    var made = context.class_of(made_type)
    var constructor = constructor_of(made)
    fallback not constructor or constructor.parameters.count() != 1
    var conversion = made.read_conversion()
    fallback conversion
    return true
}

func indexed_function_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value {
    var held = value_of(callee, null)
    if held.value_type.is_nullable {
        var wanted = held.value_type.present()
        note_a_maybe_null("fit", held, "", wanted)
        held = as_present(held)
    }
    var held_type = held.value_type
    if held_type.kind != 'function' {
        var printer = Printers.Spite.ExpressionPrinter(callee)
        var written = printer.text()
        var shown = context.shown(held_type)
        typing.refuse_not_callable(context, written, shown)
    }
    return call_through_a_value(held, held_type, call)
}

func made_from_a_bound_type(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): Value {
    var bound = context.current_class.bound_types[name]
    if not bound {
        typing.refuse_unknown_name(context, name)
    }
    crash bound
    var made_type = bound.present()
    if made_type.is_nothing() and call.arguments.is_empty() {
        return HighIntermediaryRepresentation.Values.NullConstant(made_type)
    }
    var is_a_value = made_type.kind == 'shape' or made_type.kind == 'enumeration'
    var is_plain = made_type.kind == 'scalar' or made_type.name == "String" or is_a_value
    if is_plain and call.arguments.is_empty() {
        var plain = default_of_a_type(made_type)
        crash plain
        return plain
    }
    var made = context.class_of(made_type)
    context.need_defaults(made.key)
    var constructor = constructor_of(made)
    if constructor and call.arguments.is_empty() and reads_into_defaults(constructor) {
        var no_arguments = List<Value>()
        return HighIntermediaryRepresentation.Values.MakeObject(made_type, null, no_arguments)
    }
    var arguments = List<Value>()
    if constructor {
        need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func reads_into_defaults(constructor: Model.FunctionModel): Boolean {
    fallback not constructor.parameters.is_empty()
    var library = Validators.LibraryFile()
    var path = context.current_class.file.path.replace("\\", "/")
    fallback library.holds(path) and context.current_function.name == "_placeholder"
    return path.ends_with("/json_reader.spite")
}

func is_a_handle_maker(name: String): Boolean {
    var is_named = name == "Parallel" or name == "Concurrent"
    fallback not context.current_class.function_named(name)
    return is_named
}

func handle_value(
    name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value {
    var work = call.arguments[0]
    if name == "Parallel" {
        var site = ParallelSite(context)
        site.work = work
        context.note_a_parallel_site(site)
    }
    var done = work_of(work)
    var handle_type = context.resolver.handle_of(name, done.value_type)
    need_the_scheduler(handle_type)
    return HighIntermediaryRepresentation.Values.Conversion(handle_type, 'into_handle', done)
}

func need_the_scheduler(handle_type: Model.Type) {
    fallback handle_type.kind == 'handle'
    context.makes_work = true
    var found = context.resolver.symbols.find("Spite.Fault", "")
    fallback found
    var fault = context.resolver.class_model_named("Spite.Fault")
    crash fault
    var walking = fault.function_named("frames")
    crash walking
    need(walking)
}

func work_call(
    handle: Value,
    name: String,
): Value {
    var work_type = Model.Type('object', handle.value_type.carrier)
    var work_model = context.class_of(work_type)
    var function = work_model.function_named(name)
    crash function
    if name == "to_debug" {
        need_the_work_text(work_model)
    }
    var no_values = List<Value>()
    return HighIntermediaryRepresentation.Values.Call(function, handle, no_values)
}

func work_of(work: Expression?): Value {
    var no_arguments = List<Expression>()
    if work.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return work_named(work, no_arguments)
    }
    if work.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var receiver = value_of(work.target, null)
        if receiver.value_type.kind == 'shape' {
            var through = shape_function_value(receiver, work.name)
            crash through
            var nothing_passed = List<Value>()
            var called_through = HighIntermediaryRepresentation.Values.Function.ValueCall(through, nothing_passed)
            if through.value_type.answer {
                called_through.value_type = through.value_type.answer
            }
            return called_through
        }
        var owner = present_class_of(receiver)
        var function = owner.function_named(work.name)
        if not function {
            var shown = context.shown(receiver.value_type)
            typing.refuse_unknown_member(context, shown, work.name)
        }
        crash function
        return called(function, receiver, no_arguments)
    }
    var value = value_of(work, null)
    var runs_a_call = work.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression and value.value_type.kind != 'function'
    if runs_a_call {
        return value
    }
    var no_values = List<Value>()
    return HighIntermediaryRepresentation.Values.Function.ValueCall(value, no_values)
}

func work_named(
    work: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    no_arguments: List<Expression>,
): Value {
    var internal_name = context.scope.internal_name_of(work.name)
    if internal_name {
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var local = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
        var no_values = List<Value>()
        var made = HighIntermediaryRepresentation.Values.Function.ValueCall(local, no_values)
        if local_type.answer {
            made.value_type = local_type.answer
        }
        return made
    }
    var function = context.current_class.function_named(work.name)
    if not function {
        typing.refuse_unknown_name(context, work.name)
    }
    crash function
    var own = this_value()
    return called(function, own, no_arguments)
}

func handle_debugged(
    value: Value,
    wanted: Model.Type,
): Value? {
    fallback wanted.kind == 'shape'
    var shape = context.program.shape_keyed(wanted.name)
    fallback shape
    fallback shape.members.count() == 1
    var member = shape.members[0]
    fallback member.name == "to_debug"
    var carrier_type = Model.Type('object', value.value_type.carrier)
    var carrier = context.class_of(carrier_type)
    need_the_work_text(carrier)
    var carried = HighIntermediaryRepresentation.Values.Conversion(carrier_type, 'proven', value)
    return fitted(carried, wanted)
}

func result_of_handle(value: Value): Value {
    if value.value_type.kind != 'handle' {
        return value
    }
    crash value.value_type.answer
    var answer: Model.Type = value.value_type.answer
    need_the_settling(value.value_type)
    return HighIntermediaryRepresentation.Values.Conversion(answer, 'join', value)
}

func need_the_settling(handle: Model.Type) {
    fallback handle.kind == 'handle'
    context.makes_work = true
}

func need_the_work_text(work_model: Model.ClassModel) {
    fallback not context.work_texts.contains(work_model.key)
    context.work_texts.append(work_model.key)
    var debugging = Debugging(context, this)
    debugging.work_to_debug(work_model)
}

func refuse_a_cast_by_name(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var class_path = class_path_of(callee.target)
    var written = class_path.join(".")
    fallback scalars.is_a_scalar(written)
    typing.refuse_cast_by_name(context, written, callee.name)
}

func class_path_of(expression: Expression?): List<String> {
    var inference = NameResolution.Inference()
    return inference.class_path_of(expression)
}

func tested_class_path_of(expression: Expression?): List<String> {
    var path = List<String>()
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name.starts_with("$") {
        path.append(expression.name)
        return path
    }
    return class_path_of(expression)
}

func refuse_an_unknown_generic_class(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
) {
    var written = class_path.join(".")
    var initial = written.slice(0, 1)
    crash initial
    var is_a_class_name = initial != initial.lower_case() and not scalars.is_a_scalar(written)
    var built_in = ["Spite.Function", "Symbol", "Parallel", "Concurrent"]
    var is_generic = not call.generic_arguments.is_empty() and not built_in.contains(written)
    fallback is_generic and is_a_class_name
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    fallback not found
    typing.refuse_an_unknown_generic_class(context, written)
}

func constructed(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
    expected: Model.Type?,
): Value {
    refuse_an_unknown_generic_class(call, class_path)
    var inferred = inferred_type_of(call, class_path)
    var made_type = inferred
    if not made_type {
        made_type = context.resolver.class_type_in(
            class_path,
            call.generic_arguments,
            context.current_class,
            context.line,
        )
    }
    crash made_type
    refuse_a_conversion_by_name(call, made_type, expected)
    var made = context.class_of(made_type)
    var constraints = Constraints(context, this)
    constraints.check(made)
    refuse_an_unserializable(class_path, made)
    context.need_defaults(made.key)
    var handed_over = ""
    if made.key == "ForeignCallback" {
        var crossing = ForeignCrossing(context, this)
        handed_over = crossing.handover_place(call)
    }
    var constructor = constructor_of(made)
    var arguments = List<Value>()
    if constructor and not handed_over.is_empty() {
        need(constructor)
        var handing = ForeignCrossing(context, this)
        arguments = handing.handover_arguments(call, constructor)
    } else if constructor {
        need(constructor)
        arguments = fitted_arguments(constructor, call.arguments)
    } else {
        var no_parameters = List<Model.ParameterModel>()
        arguments = arguments_for(made.shown, no_parameters, call.arguments, false)
    }
    var making = HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
    making.foreign_place = handed_over
    if made.is_singleton {
        context.note_a_singleton_made(made.key, arguments)
    }
    return making
}

func refuse_an_unserializable(class_path: List<String>, made: Model.ClassModel) {
    var last = class_path.last()
    crash last
    if class_path.count() == 1 {
        var serializable = Serializable(context)
        serializable.check(last, made)
    }
}

func inferred_type_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_path: List<String>,
): Model.Type? {
    fallback call.generic_arguments.is_empty()
    var written = class_path.join(".")
    var found = context.resolver.symbols.find(written, context.current_class.file.namespace)
    fallback found
    var file = context.resolver.symbols.file_for(found.path)
    fallback file
    fallback context.resolver.is_a_template(file)
    var argument_types = List<Model.Type>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var argument_type = inferred_argument_type(argument)
        argument_types.append(argument_type)
        index = index + 1
    }
    return context.resolver.inferred_instance(class_path, context.current_class, context.line, argument_types)
}

func inferred_argument_type(argument: Expression?): Model.Type {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and argument.kind == 'keyword_null' {
        return Model.Type('nothing', "")
    }
    var value = value_of(argument, null)
    return value.value_type
}

func constructor_of(made: Model.ClassModel): Model.FunctionModel? {
    var index = 0
    while index < made.declared_functions.count() {
        var function = made.declared_functions[index]
        if function.is_constructor {
            return function
        }
        index = index + 1
    }
    return null
}

func enum_read_from(
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value? {
    var given = receiver.value_type
    var reads_text = given.kind == 'object' and given.name == "String" and not given.is_nullable
    fallback reads_text and written.is_empty() and name.starts_with("to_")
    var length = name.length()
    var enum_words = name.slice(3, length)
    crash enum_words
    var enum_type = enum_named_by_its_path(enum_words)
    fallback enum_type
    refuse_a_written_conversion(enum_type)
    return null
}

func class_form_call(
    receiver: Value,
    owner: Model.ClassModel,
    name: String,
    written: List<Expression>,
): Value? {
    var element = owner.bound_types["$element_type"]
    fallback element and written.is_empty()
    fallback element.kind == 'union' and not element.is_nullable
    var forms = ["filter", "count", "any", "all", "remove_where"]
    var index = 0
    while index < forms.count() {
        var form = forms[index]
        var prefix = "{form}_"
        if name.starts_with(prefix) {
            var prefix_length = prefix.length()
            var name_length = name.length()
            var written_class = name.slice(prefix_length, name_length)
            crash written_class
            var member = union_member_class(element, written_class)
            if member {
                var making = PassedForms(context, this)
                var made = making.class_form(owner, form, member)
                crash made
                var no_values = List<Value>()
                return HighIntermediaryRepresentation.Values.Call(made, receiver, no_values)
            }
        }
        index = index + 1
    }
    return null
}

func union_member_class(element: Model.Type, written: String): Model.Type? {
    var candidates = singular_candidates(written, true)
    var united = union_model_of(element)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var pascal = pascal_case_of(candidate)
        var member_index = 0
        while member_index < united.members.count() {
            var held = united.members[member_index]
            var parts = held.name.split(".")
            var last = parts.count() - 1
            var simple = parts[last]
            if simple == pascal {
                return held
            }
            member_index = member_index + 1
        }
        index = index + 1
    }
    return null
}

func passed_form(
    receiver: Value,
    owner: Model.ClassModel,
    name: String,
    written: List<Expression>,
): Value? {
    var is_a_form = name == "count" or name == "sum"
    fallback is_a_form and written.count() == 1 and owner.bound_types["$element_type"]
    if name == "count" {
        var counting = owner.function_named("count_where")
        crash counting
        return called(counting, receiver, written)
    }
    var measure = value_of(written[0], null)
    fallback measure.value_type.kind == 'function'
    fallback measure.value_type.answer
    fallback measure.value_type.answer.name != "Integer"
    var forms = PassedForms(context, this)
    var summing = forms.sum_for(owner, measure.value_type)
    fallback summing
    var arguments = List<Value>()
    arguments.append(measure)
    return HighIntermediaryRepresentation.Values.Call(summing, receiver, arguments)
}

func made_copy(owner: Model.ClassModel, name: String, argument_count: Integer): Model.FunctionModel? {
    if name == "_deep_copy_in" {
        return made_copy_in(owner, argument_count)
    }
    var asks_a_copy = name == "copy" or name == "deep_copy"
    fallback asks_a_copy and argument_count == 0 and not owner.is_singleton
    var copying = Copying(context, this)
    return copying.copy_of(owner, name == "deep_copy")
}

func made_copy_in(owner: Model.ClassModel, argument_count: Integer): Model.FunctionModel? {
    fallback argument_count == 1 and not owner.is_singleton
    var copying = Copying(context, this)
    return copying.copy_in_of(owner)
}

func own_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): Value {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return function_value_call(call, name)
    }
    var rebound = rebound_template_call(call, name)
    if rebound {
        return rebound
    }
    var function = context.current_class.function_named(name)
    if not function and holds_a_function_value(name) {
        var held_value = value_of(call.callee, null)
        return value_call_of(held_value, call.arguments)
    }
    var calls_a_held_class = holds_a_class_object(name) and call.arguments.is_empty()
    if not function and calls_a_held_class {
        var described_value = value_of(call.callee, null)
        return made_from_a_held_class(described_value)
    }
    if not function {
        function = member_template_of(context.current_class, name)
    }
    if not function {
        var walked = walk_of(context.current_class, name, call.arguments)
        if walked {
            return walked
        }
    }
    if not function and name == "_deep_copied" and call.arguments.count() == 1 {
        var copied_value = value_of(call.arguments[0], null)
        var copying = Copying(context, this)
        return copying.deep_copied(copied_value)
    }
    if not function and name == "_deep_copied_in" and call.arguments.count() == 2 {
        var copied_in_value = value_of(call.arguments[0], null)
        var table_value = value_of(call.arguments[1], null)
        var copying_in = Copying(context, this)
        return copying_in.deep_copied_in(copied_in_value, table_value)
    }
    if not function {
        typing.refuse_unknown_function(context, name)
    }
    crash function
    var walking = KnownWalks(context, this)
    var known_answer = walking.call_with_a_known(function, call)
    if known_answer {
        return known_answer
    }
    var passed_on = passed_on_template(function, call)
    if passed_on {
        return passed_on
    }
    refuse_a_bare_operator_call(call, function)
    var own = this_value()
    var made = called(function, own, call.arguments)
    refuse_a_bare_accessor_call(call, function)
    return made
}

func passed_on_template(
    function: Model.FunctionModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value? {
    var current = context.current_function
    var is_walked = not current.bound_pattern.is_empty() or function.reflected_answer_index >= 0
    var is_bound = not current.bound_parameter.is_empty() and is_walked
    fallback is_bound and function.template_index < 0
    var symbol_index = passed_symbol_index(function, call)
    fallback symbol_index >= 0
    var specialised_name = "{function.name}_for_{current.bound_function}"
    var made = context.current_class.function_named(specialised_name)
    if not made {
        made = specialised_for_the_pattern(function, symbol_index, specialised_name)
    }
    crash made
    var passed = List<Expression>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if index != symbol_index {
            passed.append(argument)
        }
        index = index + 1
    }
    var own = this_value()
    return called(made, own, passed)
}

func passed_symbol_index(
    function: Model.FunctionModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Integer {
    if not function.declaration {
        return -1
    }
    var found = -1
    var index = 0
    while index < function.declaration.parameters.count() {
        var parameter = function.declaration.parameters[index]
        var argument = call.arguments[index]
        if passes_the_symbol(parameter, argument) {
            found = index
        }
        index = index + 1
    }
    return found
}

func passes_the_symbol(
    parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter,
    argument: Expression?,
): Boolean {
    fallback argument
    fallback context.resolver.is_a_declaration_type(parameter.declared_type)
    return names_the_member(argument, context.current_function.bound_parameter)
}

func specialised_for_the_pattern(
    function: Model.FunctionModel,
    symbol_index: Integer,
    specialised_name: String,
): Model.FunctionModel {
    var current = context.current_function
    crash current.bound_member_type
    var member_type: Model.Type = current.bound_member_type
    var template = Model.FunctionModel(function.name, function.owner)
    template.declaration = function.declaration
    template.template_index = symbol_index
    var made = context.resolver.specialized(
        template,
        specialised_name,
        current.bound_member,
        member_type,
        current.bound_member_is_a_function,
        context.current_class,
    )
    made.bound_member_index = current.bound_member_index
    made.bound_pattern = current.bound_pattern
    made.bound_function = current.bound_function
    made.bound_class = current.bound_class
    made.binds_a_function_declaration = current.binds_a_function_declaration
    context.current_class.declared_functions.append(made)
    return made
}

func rebound_template_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): Value? {
    var parameter = context.current_function.bound_parameter
    fallback not parameter.is_empty()
    var words = name.split("_")
    fallback words.contains(parameter)
    var passed = List<Expression>()
    var found = false
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if names_the_member(argument, parameter) {
            found = true
        } else {
            passed.append(argument)
        }
        index = index + 1
    }
    fallback found
    var renamed = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word == parameter {
            renamed.append(context.current_function.bound_member)
        } else {
            renamed.append(word)
        }
        word_index = word_index + 1
    }
    var called_name = renamed.join("_")
    var function = member_template_of(context.current_class, called_name)
    fallback function
    var own = this_value()
    return called(function, own, passed)
}

func names_the_member(argument: Expression, name: String): Boolean {
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return argument.name == name
    }
    return false
}

func function_value_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): Value {
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var local_type = context.scope.type_of(internal_name)
    crash local_type
    if is_a_class_object(local_type) and call.arguments.is_empty() {
        var described = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
        return made_from_a_held_class(described)
    }
    if local_type.kind != 'function' {
        var shown = context.shown(local_type)
        typing.refuse_not_callable(context, name, shown)
    }
    var called_value = HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    return call_through_a_value(called_value, local_type, call)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func made_from_a_held_class(
    described: Value,
): Value {
    var held = described
    if held.value_type.is_nullable {
        note_a_maybe_null("held", held, "", held.value_type)
        held = as_present(held)
    }
    var reflection = Reflection(context, this)
    var making = reflection.made_anew()
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.Call(making, held, no_arguments)
}

func is_a_class_object(value_type: Model.Type): Boolean {
    return value_type.kind == 'object' and value_type.name == "Spite.Class"
}

func holds_a_class_object(name: String): Boolean {
    var held = context.current_class.attribute_named(name)
    fallback held
    return is_a_class_object(held.attribute_type)
}

func made_from_a_member_class(
    receiver: Value,
    owner: Model.ClassModel,
    name: String,
): Value? {
    var getter = owner.function_named("get_{name}")
    if getter and getter.parameters.is_empty() and getter.answer {
        var answer_type: Model.Type = getter.answer
        fallback is_a_class_object(answer_type)
        var no_arguments = List<Expression>()
        var got = called(getter, receiver, no_arguments)
        return made_from_a_held_class(got)
    }
    var attribute = owner.attribute_named(name)
    fallback attribute
    fallback is_a_class_object(attribute.attribute_type)
    var attribute_read = HighIntermediaryRepresentation.Values.AttributeRead(receiver, attribute)
    return made_from_a_held_class(attribute_read)
}

func attribute_function_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    attribute: Model.AttributeModel,
): Value {
    var own = this_value()
    var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var held = narrowed(read, attribute.name)
    if held.value_type.is_nullable {
        note_a_maybe_null("held", held, "", held.value_type)
        held = as_present(held)
    }
    var held_type = held.value_type
    return call_through_a_value(held, held_type, call)
}

func call_through_a_value(
    called_value: Value,
    local_type: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Value {
    var arguments = List<Value>()
    var fixed_count = call.arguments.count()
    if local_type.is_variadic {
        fixed_count = local_type.parameters.count() - 1
    }
    var index = 0
    while index < fixed_count {
        var argument = call.arguments[index]
        var wanted = local_type.parameters[index]
        crash wanted
        var value = fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    if local_type.is_variadic {
        var listed_type = local_type.parameters.last()
        crash listed_type
        var gathered = gathered_list(listed_type, call.arguments, fixed_count)
        arguments.append(gathered)
    }
    var made = HighIntermediaryRepresentation.Values.Function.ValueCall(called_value, arguments)
    if local_type.answer {
        made.value_type = local_type.answer
    }
    return made
}

func member_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value {
    var known = KnownCalls(context, this)
    var known_run = known.ran_by(call, callee)
    if known_run {
        return known_run
    }
    var walked = walked_attributes(call, callee)
    if walked {
        return walked
    }
    var known_walks = KnownWalks(context, this)
    var unrolled = known_walks.unrolled(call, callee)
    if unrolled {
        return unrolled
    }
    var listing_walk = walked_classes_or_values(call, callee)
    if listing_walk {
        return listing_walk
    }
    var named_value = enum_value_by_name(call, callee)
    if named_value {
        return named_value
    }
    var question = reflection_question(call, callee)
    if question {
        return question
    }
    var counted = pattern_argument_count(call, callee)
    if counted {
        return counted
    }
    var fitting = vector_fit_question(call, callee)
    if fitting {
        return fitting
    }
    var any_fitting = any_attribute_fit_question(call, callee)
    if any_fitting {
        return any_fitting
    }
    var asked = bound_type_question(call, callee)
    if asked {
        return asked
    }
    var made_default = bound_class_made(call, callee)
    if made_default {
        return made_default
    }
    if callee.name == "count" and call.arguments.is_empty() {
        var folded_count = folded_function_count(callee.target)
        if folded_count {
            return folded_count
        }
    }
    if callee.name.starts_with("from_") {
        refuse_a_cast_by_name(callee)
    }
    if callee.name.starts_with("remove_where") {
        refuse_a_removal_from_a_chain(callee)
    }
    var class_receiver = reflected_receiver(callee.target)
    if class_receiver {
        refuse_a_call_on_a_number_class(callee, class_receiver)
        return called_on_a_class(class_receiver, callee.name, call.arguments)
    }
    var written_receiver = value_of(callee.target, null)
    if written_receiver.value_type.kind == 'handle' and callee.name == "finished_value" {
        return work_call(written_receiver, "finished_value")
    }
    var receiver = result_of_handle(written_receiver)
    var remakes_its_class = callee.name == "class" and call.arguments.is_empty()
    if remakes_its_class and not has_its_own_class(receiver) {
        var reflection = Reflection(context, this)
        var class_read = reflection.class_of_value(receiver)
        return made_from_a_held_class(class_read)
    }
    var answered_text = folded_text_question(receiver, callee.name, call.arguments)
    if answered_text {
        return answered_text
    }
    if receiver.value_type.kind == 'function' and callee.name == "call_function" {
        return value_call_of(receiver, call.arguments)
    }
    var converted_number = number_conversion_call(receiver, callee.name, call.arguments)
    if converted_number {
        return converted_number
    }
    if receiver.value_type.kind == 'shape' {
        var typed = context.program.shape_keyed(receiver.value_type.name)
        crash typed
        refuse_an_operator_call_through_a_shape(callee, call, typed)
        return shape_call(receiver, callee.name, call.arguments)
    }
    if receiver.value_type.kind == 'union' {
        var through = union_shape_of(receiver.value_type, callee.name)
        refuse_an_operator_call_through_a_shape(callee, call, through)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', receiver)
        return shape_call(shaped, callee.name, call.arguments)
    }
    var is_an_enum = receiver.value_type.kind == 'enumeration' and not receiver.value_type.is_nullable
    if is_an_enum and callee.name == "to_string" and call.arguments.is_empty() {
        return enum_text(receiver)
    }
    if is_an_enum and callee.name == "to_debug" and call.arguments.is_empty() {
        var debugging = Debugging(context, this)
        return debugging.debug_text_of(receiver)
    }
    if is_an_enum and callee.name == "to_integer" and call.arguments.is_empty() {
        var integer = context.scalar_type("Integer")
        return HighIntermediaryRepresentation.Values.Conversion(integer, 'widen', receiver)
    }
    var read_enum = enum_read_from(receiver, callee.name, call.arguments)
    if read_enum {
        return read_enum
    }
    if receiver.value_type.is_nullable {
        note_a_maybe_null("call", receiver, callee.name, receiver.value_type)
        receiver = as_present(receiver)
    }
    var owner = present_class_of(receiver)
    var renewing = context.renews_the_lists and callee.name == "clear" and call.arguments.count() == 1
    if renewing {
        context.renews_the_lists = false
        var renewer = owner.function_named("_renew_lists")
        crash renewer
        return called(renewer, receiver, call.arguments)
    }
    refuse_a_private_name(owner, callee.name)
    refuse_a_written_attribute_call(callee, call)
    var found_value = enum_value_found(owner, callee, call.arguments)
    if found_value {
        return found_value
    }
    var passed = passed_form(receiver, owner, callee.name, call.arguments)
    if passed {
        return passed
    }
    var filtered_by_class = class_form_call(receiver, owner, callee.name, call.arguments)
    if filtered_by_class {
        return filtered_by_class
    }
    var function = owner.function_named(callee.name)
    var stands_for = context.current_function.bound_function
    var names_the_pattern = callee.name == context.current_function.bound_pattern and not stands_for.is_empty()
    if not function and names_the_pattern {
        function = owner.function_named(stands_for)
    }
    if function and callee.name == "deep_copy" and call.arguments.is_empty() {
        var sharing = Copying(context, this)
        var shared = sharing.shared_table_copy_of(owner)
        if shared {
            function = shared
        }
    }
    if not function {
        function = member_template_of(owner, callee.name)
    }
    if not function {
        var through_values = dictionary_template(receiver, owner, callee.name, call.arguments)
        if through_values {
            return through_values
        }
    }
    if not function and callee.name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var written_count = call.arguments.count()
    if not function {
        function = made_copy(owner, callee.name, written_count)
    }
    if not function and owner.key == "DynamicLibrary" {
        return foreign_call(receiver, callee.name, call.arguments)
    }
    if not function and callee.name.starts_with("from_") {
        refuse_a_cast_by_name(callee)
    }
    if not function {
        var walked_on = walk_on(owner, receiver, callee.name, call.arguments)
        if walked_on {
            return walked_on
        }
    }
    if not function {
        var read_as_an_enum = text_read_as_an_enum(receiver, owner, callee.name, written_count)
        if read_as_an_enum {
            return read_as_an_enum
        }
    }
    if not function {
        var numbered_enum = number_read_as_an_enum(receiver, owner, callee.name, written_count)
        if numbered_enum {
            return numbered_enum
        }
    }
    if not function and call.arguments.is_empty() {
        var made_of_a_class = made_from_a_member_class(receiver, owner, callee.name)
        if made_of_a_class {
            return made_of_a_class
        }
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, callee.name)
    }
    crash function
    var folded_keys = Folded.Keys(context, this)
    folded_keys.refuse_a_changing_call(receiver, callee.name)
    refuse_a_comparison_of_objects(receiver, owner, callee.name)
    refuse_a_drop_by_name(owner, function)
    var dropping = DroppingWalks(context)
    dropping.refuse(call, owner, function)
    refuse_an_operator_call(callee, call, function, receiver)
    var specialised = specialised_for_a_constant(function, receiver, call.arguments)
    if specialised {
        return specialised
    }
    refuse_an_accessor_call(callee, call, function)
    var made = called(function, receiver, call.arguments)
    refuse_a_wider_bitwise_operand(callee, call, made)
    var width_reads = WidthReads(context)
    return width_reads.proven(made, owner, call, callee)
}

func refuse_a_drop_by_name(owner: Model.ClassModel, function: Model.FunctionModel) {
    fallback function.name == "drop" and function.parameters.is_empty() and not function.answer
    var shown = plain_name_of(owner.shown)
    typing.refuse_a_drop_by_name(context, shown)
}

func refuse_a_comparison_of_objects(
    receiver: Value,
    owner: Model.ClassModel,
    name: String,
) {
    fallback name == "contains" or name == "index_of"
    var shown = context.shown(receiver.value_type)
    fallback shown.starts_with("List<")
    var element_type = owner.bound_types["$element_type"]
    crash element_type
    var is_an_object = element_type.kind == 'object' and element_type.name != "String"
    fallback is_an_object or element_type.kind == 'union'
    var element_shown = context.shown(element_type)
    var element_name = plain_name_of(element_shown)
    typing.refuse_a_comparison_of_objects(context, name, element_name)
}

func plain_name_of(shown: String): String {
    if shown.contains("<") {
        return shown
    }
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

func refuse_an_accessor_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
) {
    var is_a_setter = callee.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = callee.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration
    var length = callee.name.length()
    var attribute_name = callee.name.slice(4, length)
    crash attribute_name
    fallback function.parameters.count() == call.arguments.count()
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{attribute_name}"
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(context, callee.name, "writing", attribute_name, "{written} = {assigned_text}")
    }
    typing.refuse_an_accessor_call(context, callee.name, "reading", attribute_name, written)
}

func refuse_a_private_name(owner: Model.ClassModel, name: String) {
    fallback name.starts_with("_")
    var library = Validators.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    fallback not context.resolver.symbols.generated_texts[path]
    fallback owner.file.path != context.current_class.file.path
    var length = name.length()
    var public_name = name.slice(1, length)
    crash public_name
    var reader = ""
    var is_read_outside = owner.function_named("get_{public_name}") or owner.function_named(public_name)
    if is_read_outside and owner.attribute_named(name) {
        reader = public_name
    }
    typing.refuse_a_private_name(context, name, owner.shown, reader)
}

func refuse_a_written_attribute_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var is_a_read = callee.name == "get_attribute" and call.arguments.count() == 1
    var is_a_write = callee.name == "set_attribute" and call.arguments.count() == 2
    fallback is_a_read or is_a_write
    var named = call.arguments[0]
    if named.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        refuse_a_named_attribute_call(callee, call, named)
    }
}

func refuse_a_named_attribute_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    named: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
) {
    fallback named.kind == 'symbol_literal'
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    var written = "{receiver_text}.{named.text}"
    if callee.name == "set_attribute" {
        var assigned = call.arguments[1]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(context, callee.name, "writing", named.text, "{written} = {assigned_text}")
    }
    typing.refuse_an_accessor_call(context, callee.name, "reading", named.text, written)
}

func refuse_an_operator_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
    receiver: Value,
) {
    var receiver_kind = receiver.value_type.kind
    fallback receiver_kind == 'object' or receiver_kind == 'scalar'
    var owner = present_class_of(receiver)
    var is_its_own = owner.key == context.current_class.key and context.current_function.name == callee.name
    fallback not is_its_own
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    refuse_an_operator_by_name(call, callee.name, function, receiver_text, receiver_kind == 'scalar')
}

func refuse_an_operator_call_through_a_shape(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    shape: Model.ShapeModel,
) {
    var member = shape.member_named(callee.name)
    fallback member and context.current_function.name != callee.name
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = printer.text()
    refuse_an_operator_by_name(call, callee.name, member, receiver_text, false)
}

func refuse_a_bare_operator_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, function: Model.FunctionModel) {
    var indexes = function.name == "get_at" or function.name == "set_at"
    fallback context.current_function.name != function.name and not indexes
    var is_a_number = scalars.is_a_scalar(context.current_class.key)
    refuse_an_operator_by_name(call, function.name, function, "this", is_a_number)
}

func refuse_a_bare_accessor_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, function: Model.FunctionModel) {
    var is_a_setter = function.name.starts_with("set_") and call.arguments.count() == 1
    var is_a_getter = function.name.starts_with("get_") and call.arguments.is_empty() and function.answer
    var is_an_accessor = is_a_setter or is_a_getter
    fallback is_an_accessor and function.declaration and context.current_function.name != function.name
    var path = context.path()
    var library = Validators.LibraryFile()
    fallback not context.resolver.symbols.generated_texts[path] and not library.holds(path)
    var length = function.name.length()
    var attribute_name = function.name.slice(4, length)
    crash attribute_name
    fallback not context.current_class.attribute_named(attribute_name)
    var local = context.scope.internal_name_of(attribute_name)
    fallback not local
    if is_a_setter {
        var assigned = call.arguments[0]
        crash assigned
        var assigned_printer = Printers.Spite.ExpressionPrinter(assigned)
        var assigned_text = assigned_printer.text()
        typing.refuse_an_accessor_call(context, function.name, "writing", attribute_name, "{attribute_name} = {assigned_text}")
    }
    typing.refuse_an_accessor_call(context, function.name, "reading", attribute_name, attribute_name)
}

func refuse_an_operator_by_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
    function: Model.FunctionModel,
    receiver_text: String,
    is_on_a_number: Boolean,
) {
    var path = context.path()
    fallback not context.resolver.symbols.generated_texts[path]
    var written_count = call.arguments.count()
    fallback function.name == name and function.parameters.count() == written_count
    var operator = operator_written(name, written_count)
    fallback not operator.is_empty()
    var first_parameter = function.parameters.first()
    if first_parameter {
        var parameter_kind = first_parameter.parameter_type.kind
        fallback parameter_kind != 'function'
        fallback name != "equals" or parameter_kind == 'object' or is_on_a_number
    }
    var written_arguments = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var argument_printer = Printers.Spite.ExpressionPrinter(argument)
        var argument_text = argument_printer.text()
        written_arguments.append(argument_text)
        index = index + 1
    }
    typing.refuse_an_operator_call(context, name, operator, receiver_text, written_arguments)
}

func operator_written(name: String, written_count: Integer): String {
    var binary = ["sum", "subtract", "multiply", "divide", "remainder", "equals", "less_than", "greater_than"]
    var operators = ["+", "-", "*", "/", "%", "==", "<", ">"]
    var position = binary.index_of(name)
    if position and written_count == 1 {
        var found = operators[position]
        crash found
        return found
    }
    var is_a_negation = name == "negate" and written_count == 0
    if is_a_negation {
        return "-"
    }
    var is_a_read = name == "get_at" and written_count == 1
    if is_a_read {
        return "[]"
    }
    var is_a_write = name == "set_at" and written_count == 2
    if is_a_write {
        return "[] ="
    }
    return ""
}

func refuse_a_removal_from_a_chain(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var chain = callee.target
    if chain.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        refuse_a_removal_from_a_step(callee, chain)
    }
}

func refuse_a_removal_from_a_step(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    chain: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var step = chain.callee
    if step.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var copies = ["copy", "deep_copy", "keys", "values", "reversed"]
        var name = step.name
        var makes_a_new_one = name.starts_with("filter") or name.starts_with("map") or name.starts_with("sort")
        fallback makes_a_new_one or copies.contains(name)
        var printer = Printers.Spite.ExpressionPrinter(chain)
        var shown = printer.text()
        typing.refuse_a_removal_from_a_chain(context, callee.name, shown)
    }
}

func refuse_a_wider_bitwise_operand(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: Value,
) {
    var bitwise = ["bits_and", "bits_or", "bits_exclusive_or"]
    var library = Validators.LibraryFile()
    var path = context.path()
    fallback bitwise.contains(callee.name) and call.arguments.count() == 1 and not library.holds(path)
    if made.class == HighIntermediaryRepresentation.Values.Call {
        refuse_a_wider_bitwise_call(callee, call, made)
    }
}

func refuse_a_wider_bitwise_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    made: HighIntermediaryRepresentation.Values.Call,
) {
    var operand = made.arguments[0]
    fallback made.receiver and operand
    fallback made.receiver.value_type.kind == 'scalar'
    if operand.class == HighIntermediaryRepresentation.Values.Conversion {
        refuse_a_cut_bitwise_operand(callee, call, made.receiver, operand)
    }
}

func refuse_a_cut_bitwise_operand(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    receiver: Value,
    operand: HighIntermediaryRepresentation.Values.Conversion,
) {
    var cuts = operand.kind == 'narrow' or operand.kind == 'narrow_decimal' or operand.kind == 'to_whole'
    var written = call.arguments[0]
    fallback cuts and operand.converted and callee.target and written
    var receiver_scalar = scalars.of(receiver.value_type.name)
    var given_scalar = scalars.of(operand.converted.value_type.name)
    fallback receiver_scalar and given_scalar
    fallback given_scalar.size > receiver_scalar.size or given_scalar.is_decimal
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    var shown = call_printer.text()
    var receiver_printer = Printers.Spite.ExpressionPrinter(callee.target)
    var receiver_text = receiver_printer.text()
    var operand_printer = Printers.Spite.ExpressionPrinter(written)
    var operand_text = operand_printer.text()
    var receiver_name = receiver.value_type.name
    var given_name = operand.converted.value_type.name
    typing.refuse_a_wider_bitwise_operand(context, shown, receiver_text, receiver_name, operand_text, given_name)
}

func specialised_for_a_constant(
    function: Model.FunctionModel,
    receiver: Value,
    written: List<Expression>,
): Value? {
    fallback function.declaration and function.template_index < 0 and function.bound_member.is_empty()
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var place = -1
    var index = 0
    while index < declaration.parameters.count() and index < written.count() {
        var parameter = declaration.parameters[index]
        var argument = written[index]
        if takes_an_attribute(parameter) and not constant_attribute_name(argument).is_empty() {
            place = index
        }
        index = index + 1
    }
    fallback place >= 0
    var picked = written[place]
    var attribute_name = constant_attribute_name(picked)
    var described = constant_attribute_owner(picked)
    var described_model = context.program.class_named(described)
    crash described_model
    var attribute = described_model.attribute_named(attribute_name)
    crash attribute
    var owner = context.program.class_named(function.owner)
    crash owner
    var specialised_name = "{function.name}_for_{attribute_name}"
    var made = owner.function_named(specialised_name)
    if not made {
        made = specialised_for_an_attribute(function, owner, place, specialised_name, described_model, attribute)
    }
    crash made
    var passed = List<Expression>()
    var passed_index = 0
    while passed_index < written.count() {
        var argument = written[passed_index]
        if passed_index != place {
            passed.append(argument)
        }
        passed_index = passed_index + 1
    }
    return called(made, receiver, passed)
}

func specialised_for_an_attribute(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    place: Integer,
    specialised_name: String,
    described_model: Model.ClassModel,
    attribute: Model.AttributeModel,
): Model.FunctionModel {
    var template = Model.FunctionModel(function.name, function.owner)
    template.declaration = function.declaration
    template.template_index = place
    var made = context.resolver.specialized(
        template,
        specialised_name,
        attribute.name,
        attribute.attribute_type,
        false,
        owner,
    )
    made.bound_member_index = attribute_place_of(described_model, attribute.name)
    owner.declared_functions.append(made)
    return made
}

func attribute_place_of(model: Model.ClassModel, name: String): Integer {
    var index = 0
    var found_place = -1
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.name == name {
            found_place = index
        }
        index = index + 1
    }
    crash found_place >= 0
    return found_place
}

func takes_an_attribute(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter): Boolean {
    var written = parameter.declared_type
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        return path == "Spite.AttributeDeclaration" and written.arguments.is_empty()
    }
    return false
}

func constant_attribute_name(written: Expression?): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return constant_index_name(written)
    }
    return ""
}

func constant_index_name(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var listed = index.target
    var named = index.index
    var lists_attributes = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        lists_attributes = listed.name == "attributes" and not constant_attribute_owner_of(listed.target).is_empty()
    }
    fallback lists_attributes
    var key = key_name_of(named)
    if key {
        return key
    }
    return ""
}

func constant_attribute_owner(written: Expression?): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return constant_listed_owner(written.target)
    }
    return ""
}

func constant_listed_owner(listed: Expression?): String {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return constant_attribute_owner_of(listed.target)
    }
    return ""
}

func constant_attribute_owner_of(target: Expression?): String {
    var path = class_path_of(target)
    fallback not path.is_empty()
    var described = constant_class_of(target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    return model.key
}

func text_read_as_an_enum(
    _receiver: Value,
    owner: Model.ClassModel,
    name: String,
    written_count: Integer,
): Value? {
    fallback owner.key == "String" and name.starts_with("to_") and written_count == 0
    var name_length = name.length()
    var snake = name.slice(3, name_length)
    crash snake
    var found = enum_named_by_its_path(snake)
    fallback found
    refuse_a_written_conversion(found)
    return null
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func number_read_as_an_enum(
    _receiver: Value,
    owner: Model.ClassModel,
    name: String,
    written_count: Integer,
): Value? {
    var whole = ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
    fallback whole.contains(owner.key) and name.starts_with("to_") and written_count == 0
    var name_length = name.length()
    var snake = name.slice(3, name_length)
    crash snake
    var found = enum_named_by_its_path(snake)
    fallback found
    refuse_a_written_conversion(found)
    return null
}

# ../../../spite_spec/specs/values_and_types.md#enums-in-full
func number_read_into_an_enum(
    receiver: Value,
    found: Model.Type,
): Value {
    var wanted = found.nullable()
    var held = held_operand(receiver)
    var nothing = HighIntermediaryRepresentation.Values.NullConstant(wanted)
    temporary_count = temporary_count + 1
    var local_name = context.scope.declare("numbered_{temporary_count}", wanted)
    var declared = HighIntermediaryRepresentation.Statements.Declare(local_name, wanted, nothing)
    declared.line = context.line
    context.pending.append(declared)
    var enumeration = enum_model_of(found)
    var boolean = context.boolean()
    var index = 0
    while index < enumeration.values.count() {
        var value_name = enumeration.values[index]
        var number = enumeration.numbers[index]
        crash number
        var compared = HighIntermediaryRepresentation.Values.WholeNumber(held.value_type, number)
        var tested = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', held, compared)
        var value = enum_value(value_name, found)
        var fitted_value = fitted(value, wanted)
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(local_name, fitted_value)
        assigned.line = context.line
        var branch = HighIntermediaryRepresentation.Statements.Block()
        branch.statements.append(assigned)
        var test = HighIntermediaryRepresentation.Statements.If(tested, branch, null)
        test.line = context.line
        context.pending.append(test)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.LocalRead(wanted, local_name)
}

func enum_value_found(
    owner: Model.ClassModel,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: List<Expression>,
): Value? {
    fallback callee.name == "find_by_name" and written.count() == 1
    var listed = callee.target
    var lists_every_value = false
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var path = class_path_of(listed.target)
        lists_every_value = listed.name == "values" and not path.is_empty()
    }
    fallback lists_every_value
    var element = owner.bound_types["$element_type"]
    fallback element
    fallback element.kind == 'enumeration' and not element.is_nullable
    var asked = written[0]
    var symbol: String? = null
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        symbol = symbol_literal_text(asked)
    }
    fallback symbol
    var maybe = element.nullable()
    var enumeration = enum_model_of(element)
    if not enumeration.values.contains(symbol) {
        return HighIntermediaryRepresentation.Values.NullConstant(maybe)
    }
    var found = enum_value(symbol, element)
    return HighIntermediaryRepresentation.Values.Conversion(maybe, 'nullable', found)
}

func folded_text_question(
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value? {
    var asks = name == "starts_with" or name == "ends_with"
    fallback asks and written.count() == 1
    var known = known_text_of(receiver)
    fallback known
    var argument = written[0]
    var piece: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        piece = plain_text_of(argument)
    }
    fallback piece
    var holds = known.ends_with(piece)
    if name == "starts_with" {
        holds = known.starts_with(piece)
    }
    return boolean_constant(holds)
}

func known_text_of(value: Value): String? {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return context.text_locals[value.name]
    }
    return null
}

func member_template_of(owner: Model.ClassModel, name: String): Model.FunctionModel? {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        if template.is_a_member_template {
            var made = specialized_for(owner, template, name)
            if made {
                return made
            }
        }
        index = index + 1
    }
    return null
}

func dictionary_template(
    receiver: Value,
    owner: Model.ClassModel,
    name: String,
    written: List<Expression>,
): Value? {
    fallback owner.bound_types["$value_type"]
    var values_function = owner.function_named("values")
    fallback values_function
    var no_written = List<Expression>()
    var listed = called(values_function, receiver, no_written)
    var list_model = present_class_of(listed)
    var template = member_template_of(list_model, name)
    fallback template
    return called(template, listed, written)
}

func specialized_for(owner: Model.ClassModel, template: Model.FunctionModel, name: String): Model.FunctionModel? {
    var match = template_match(template, name)
    fallback match
    var member_owner = owner_of_a_template(template, owner, name)
    fallback member_owner
    var written_owner: Model.Type = member_owner
    var owner_type = bound_parameters(template, written_owner)
    var is_rebound = owner_type.name != written_owner.name
    var known_name = name
    if is_rebound and owner_type.kind == 'parameters' {
        known_name = "{name}_in_{context.current_function.bound_function}"
    }
    var known = owner.function_named(known_name)
    if known and is_rebound {
        return known
    }
    var made = specialized_by_kind(owner, template, owner_type, name, match)
    if made and is_rebound and owner_type.kind == 'parameters' {
        made.name = known_name
        made.bound_pattern = context.current_function.bound_pattern
        made.bound_function = context.current_function.bound_function
    }
    return made
}

func bound_parameters(template: Model.FunctionModel, owner_type: Model.Type): Model.Type {
    if owner_type.kind != 'parameters' {
        return owner_type
    }
    var parts = owner_type.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var words = function_part.split("_")
    if words.contains(word) {
        return Model.Type('pattern', owner_type.name)
    }
    var function = context.current_function
    var is_bound = function.bound_pattern == function_part and not function.bound_function.is_empty()
    if is_bound {
        return Model.Type('parameters', "{class_key}|{function.bound_function}")
    }
    return owner_type
}

func replaced_word(text: String, word: String, replacement: String): String {
    var words = text.split("_")
    var renamed = List<String>()
    var index = 0
    while index < words.count() {
        var each_word = words[index]
        if each_word == word {
            renamed.append(replacement)
        } else {
            renamed.append(each_word)
        }
        index = index + 1
    }
    return renamed.join("_")
}

func pattern_names(template: Model.FunctionModel, pattern: Model.Type): List<String> {
    var names = List<String>()
    var parts = pattern.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var walked_class = context.program.class_named(class_key)
    crash walked_class
    var index = 0
    while index < walked_class.declared_functions.count() {
        var function = walked_class.declared_functions[index]
        var hole = hole_of(function, function_part, word)
        if not hole.is_empty() and not names.contains(hole) {
            names.append(hole)
        }
        index = index + 1
    }
    return names
}

func hole_of(function: Model.FunctionModel, function_part: String, word: String): String {
    var is_written = function.declaration and function.bound_member.is_empty() and not function.is_a_member_template
    fallback is_written and not function.is_synthetic and not function.is_a_walk_copy
    return hole_in(function.name, function_part, word)
}

func hole_in(name: String, function_part: String, word: String): String {
    var words = function_part.split("_")
    var place = words.index_of(word)
    fallback place
    var before = List<String>()
    var after = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var each_word = words[word_index]
        if word_index < place {
            before.append(each_word)
        }
        if word_index > place {
            after.append(each_word)
        }
        word_index = word_index + 1
    }
    var prefix = before.join("_")
    if not prefix.is_empty() {
        prefix = "{prefix}_"
    }
    var suffix = after.join("_")
    if not suffix.is_empty() {
        suffix = "_{suffix}"
    }
    var fixed_length = prefix.length() + suffix.length()
    var fits = name.starts_with(prefix) and name.ends_with(suffix) and name.length() > fixed_length
    fallback fits
    var prefix_length = prefix.length()
    var middle_end = name.length() - suffix.length()
    var sliced = name.slice(prefix_length, middle_end)
    crash sliced
    return sliced
}

func specialized_over_a_pattern(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    pattern: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var match_parts = match.split("|")
    var written = match_parts[0]
    crash written
    var parts = pattern.name.split("|")
    var class_key = parts[0]
    var function_part = parts[1]
    crash class_key
    crash function_part
    var word = walked_word(template)
    var holes = pattern_names(template, pattern)
    var place = holes.index_of(written)
    var bound_function = replaced_word(function_part, word, written)
    var walked_class = context.program.class_named(class_key)
    crash walked_class
    fallback place or not walks_by_the_name(template, name)
    if not place {
        refuse_an_unmatched_hole(template, name, written, word, walked_class, bound_function, function_part, holes)
    }
    crash place
    var symbol = context.resolver.walked_name_type()
    var made = context.resolver.specialized(template, name, written, symbol, false, owner)
    made.bound_member_index = place
    made.bound_pattern = function_part
    made.bound_function = bound_function
    made.bound_class = class_key
    made.binds_a_function_declaration = true
    owner.declared_functions.append(made)
    return made
}

func refuse_an_unmatched_hole(
    template: Model.FunctionModel,
    name: String,
    written: String,
    word: String,
    walked_class: Model.ClassModel,
    missing: String,
    function_part: String,
    holes: List<String>,
) {
    var fitting = List<String>()
    var index = 0
    while index < holes.count() {
        var hole = holes[index]
        var fitted_name = replaced_word(function_part, word, hole)
        fitting.append("'{fitted_name}'")
        index = index + 1
    }
    var matched = "it has no function that fits '{function_part}'"
    if not fitting.is_empty() {
        var listed = fitting.join(", ")
        matched = "the functions there that fit '{function_part}' are {listed}"
    }
    var refusal = Validators.NameResolution.TemplateRange.Validator()
    refusal.refuse_an_unmatched_hole(
        context.current_class.file.path,
        context.line,
        context.current_class.shown,
        context.current_function.name,
        name,
        template.name,
        written,
        word,
        walked_class.shown,
        missing,
        matched,
    )
}

func specialized_over_a_handle(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    name: String,
    match: String,
): Model.FunctionModel? {
    var asks_if_finished = match == "finished" or match == "is_finished"
    fallback asks_if_finished
    var boolean = context.boolean()
    var made = context.resolver.specialized(template, name, "finished", boolean, false, owner)
    owner.declared_functions.append(made)
    return made
}

func specialized_by_kind(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    switch owner_type.kind {
        'pattern': return specialized_over_a_pattern(owner, template, owner_type, name, match)
        'handle': return specialized_over_a_handle(owner, template, name, match)
        'shape': return specialized_over_a_shape(owner, template, owner_type, name, match)
        'namespace': return specialized_over_a_namespace(owner, template, name, match)
        'parameters': return specialized_over_parameters(owner, template, owner_type, name, match)
        'union': return specialized_over_a_union(owner, template, owner_type, name, match)
        'enumeration': return specialized_over_values(owner, template, owner_type, name, match)
        'nothing': return specialized_over_a_class(owner, template, owner_type, name, match)
        'scalar': return specialized_over_a_class(owner, template, owner_type, name, match)
        'object': return specialized_over_a_class(owner, template, owner_type, name, match)
        'function': return specialized_over_a_class(owner, template, owner_type, name, match)
    }
}

func specialized_over_a_class(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    fallback context.has_a_class(owner_type) and not owner_type.is_nullable
    var element_class = context.class_of(owner_type)
    var match_parts = match.split("|")
    var written = match_parts[0]
    crash written
    var is_plural = match_parts.count() > 1
    if is_plural {
        refuse_a_test_to_collect(template, element_class, name, written)
        refuse_a_singular(element_class, name, written)
    }
    var member = member_of(element_class, written, is_plural)
    if member.is_empty() {
        member = member_of(element_class, "is_{written}", is_plural)
    }
    if member.is_empty() and not is_plural {
        var chained = specialized_through_a_function(owner, template, element_class, name, written)
        if chained {
            return chained
        }
    }
    if member.is_empty() and asks_a_question(template) {
        return specialized_over_an_enum_value(owner, template, element_class, name, written)
    }
    if member.is_empty() and owner.bound_types["$element_type"] {
        refuse_a_caller_function(element_class, name, written)
    }
    fallback not member.is_empty()
    if asks_a_question(template) and owner.bound_types["$element_type"] {
        refuse_a_member_and_a_value(element_class, name, member)
    }
    var attribute = element_class.attribute_named(member)
    var member_type = context.boolean()
    var is_a_function = true
    var member_index = 0
    if attribute {
        member_type = attribute.attribute_type
        is_a_function = false
        member_index = attribute_index_of(element_class, member)
    } else {
        var function = element_class.function_named(member)
        crash function
        member_type = answer_or_nothing(function)
    }
    var library = Validators.LibraryFile()
    if library.holds(owner.file.path) or owner.bound_types["$element_type"] {
        var member_shown = context.shown(member_type)
        typing.check_member_fit(context, name, member, element_class.shown, member_shown, is_a_function)
    }
    var made = context.resolver.specialized(template, name, member, member_type, is_a_function, owner)
    made.bound_member_index = member_index
    owner.declared_functions.append(made)
    return made
}

func refuse_a_test_to_collect(
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
) {
    fallback template.name.starts_with("map_")
    var singular = member_named(element_class, written)
    fallback not singular.is_empty()
    var member_type = member_type_named(element_class, singular)
    fallback context.is_boolean(member_type)
    typing.refuse_a_test_to_collect(context, name, written, element_class.shown)
}

func refuse_a_caller_function(element_class: Model.ClassModel, name: String, written: String) {
    var function = context.current_class.function_named(written)
    fallback function
    fallback function.parameters.count() == 1
    typing.refuse_a_caller_function(context, element_class.shown, written, name)
}

func refuse_a_member_and_a_value(element_class: Model.ClassModel, name: String, member: String) {
    var candidates = enum_members_of(element_class)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(element_class, candidate)
        var enumeration = enum_model_of(enum_type)
        if enumeration.values.contains(member) {
            typing.refuse_a_member_and_a_value(context, name, member, element_class.shown, candidate)
        }
        index = index + 1
    }
}

func member_type_named(element_class: Model.ClassModel, member: String): Model.Type {
    var attribute = element_class.attribute_named(member)
    if attribute {
        return attribute.attribute_type
    }
    var function = element_class.function_named(member)
    crash function
    return answer_or_nothing(function)
}

func asks_a_question(template: Model.FunctionModel): Boolean {
    var asking = List<String>()
    asking.append("filter_")
    asking.append("count_")
    asking.append("any_")
    asking.append("all_")
    asking.append("remove_where_")
    var index = 0
    while index < asking.count() {
        var prefix = asking[index]
        if template.name.starts_with(prefix) {
            return true
        }
        index = index + 1
    }
    return false
}

func enum_members_of(element_class: Model.ClassModel): List<String> {
    var names = List<String>()
    var index = 0
    while index < element_class.declared_attributes.count() {
        var attribute = element_class.declared_attributes[index]
        var held = attribute.attribute_type
        if held.kind == 'enumeration' and not held.is_nullable {
            names.append(attribute.name)
        }
        index = index + 1
    }
    var function_index = 0
    while function_index < element_class.declared_functions.count() {
        var function = element_class.declared_functions[function_index]
        var answer = answer_or_nothing(function)
        var answers_an_enum = answer.kind == 'enumeration' and not answer.is_nullable
        var is_plain = function.parameters.is_empty() and not function.is_a_member_template
        if answers_an_enum and is_plain {
            names.append(function.name)
        }
        function_index = function_index + 1
    }
    return names
}

func enum_type_of_member(element_class: Model.ClassModel, member: String): Model.Type {
    var attribute = element_class.attribute_named(member)
    if attribute {
        return attribute.attribute_type
    }
    var function = element_class.function_named(member)
    crash function
    return answer_or_nothing(function)
}

func specialized_over_an_enum_value(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
): Model.FunctionModel? {
    var candidates = enum_members_of(element_class)
    var chosen = ""
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(element_class, candidate)
        var enumeration = enum_model_of(enum_type)
        if enumeration.values.contains(written) {
            if not chosen.is_empty() {
                typing.refuse_two_enum_members(context, name, chosen, candidate, written, element_class.shown)
            }
            chosen = candidate
        }
        index = index + 1
    }
    if chosen.is_empty() and owner.bound_types["$element_type"] {
        typing.refuse_no_member_for_a_template(context, element_class.shown, written, name)
    }
    fallback not chosen.is_empty()
    var chosen_type = enum_type_of_member(element_class, chosen)
    var is_a_function = not element_class.attribute_named(chosen)
    var boolean = context.boolean()
    var made = context.resolver.specialized(template, name, chosen, boolean, is_a_function, owner)
    made.bound_member_index = member_index_of(element_class, chosen)
    compare_with_the_value(made, chosen_type, written)
    owner.declared_functions.append(made)
    return made
}

func compare_with_the_value(made: Model.FunctionModel, enum_type: Model.Type, written: String) {
    var enumeration = enum_model_of(enum_type)
    var place = enumeration.values.index_of(written)
    crash place
    var number = enumeration.numbers[place]
    crash number
    made.compared_value = enum_type
    made.compared_number = number
}

func specialized_over_a_shape(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var shape = context.program.shape_keyed(owner_type.name)
    crash shape
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var member = shape.member_named(candidate)
        if member {
            var member_type = answer_or_nothing(member)
            var made = context.resolver.specialized(template, name, candidate, member_type, false, owner)
            made.bound_shape = shape.key
            made.bound_member_index = shape_member_index(shape, candidate)
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func shape_member_index(shape: Model.ShapeModel, name: String): Integer {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.name == name {
            return index
        }
        index = index + 1
    }
    return 0
}

func specialized_over_a_union(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var is_plural = parts.count() > 1
    var candidates = singular_candidates(written, is_plural)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var answered = union_member_name(owner_type, candidate)
        if not answered.is_empty() {
            var shape = union_shape_of(owner_type, answered)
            var member = shape.members[0]
            crash member
            var member_type = answer_or_nothing(member)
            var made = context.resolver.specialized(template, name, answered, member_type, false, owner)
            made.bound_shape = shape.key
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    fallback not is_plural
    var chained = union_through_a_function(owner, template, owner_type, name, written)
    if chained {
        return chained
    }
    fallback asks_a_question(template)
    return union_enum_value(owner, template, owner_type, name, written)
}

func split_words(written: String, start: Integer, end: Integer): String {
    var words = written.split("_")
    var kept = List<String>()
    var index = start
    while index < end {
        var word = words[index]
        crash word
        kept.append(word)
        index = index + 1
    }
    return kept.join("_")
}

func specialized_through_a_function(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    element_class: Model.ClassModel,
    name: String,
    written: String,
): Model.FunctionModel? {
    var word_count = written.split("_").count()
    var split = 1
    while split < word_count {
        var member_name = split_words(written, 0, split)
        var function_name = split_words(written, split, word_count)
        var member = member_named(element_class, member_name)
        if not member.is_empty() {
            var member_type = enum_type_of_member(element_class, member)
            var chained = chained_specialization(owner, template, member_type, member, function_name, name)
            if chained {
                chained.bound_member_is_a_function = not element_class.attribute_named(member)
                chained.bound_member_index = member_index_of(element_class, member)
                return chained
            }
        }
        split = split + 1
    }
    return null
}

func union_through_a_function(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    written: String,
): Model.FunctionModel? {
    var word_count = written.split("_").count()
    var split = 1
    while split < word_count {
        var member_name = split_words(written, 0, split)
        var function_name = split_words(written, split, word_count)
        var answered = union_member_name(owner_type, member_name)
        if not answered.is_empty() {
            var shape = union_shape_of(owner_type, answered)
            var member = shape.members[0]
            crash member
            var member_type = answer_or_nothing(member)
            var chained = chained_specialization(owner, template, member_type, answered, function_name, name)
            if chained {
                chained.bound_shape = shape.key
                return chained
            }
        }
        split = split + 1
    }
    return null
}

func chained_specialization(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    member_type: Model.Type,
    member: String,
    function_name: String,
    name: String,
): Model.FunctionModel? {
    fallback context.has_a_class(member_type) and not member_type.is_nullable
    var through_class = context.class_of(member_type)
    var function = through_class.function_named(function_name)
    fallback function
    var answer = answer_or_nothing(function)
    var made = context.resolver.specialized(template, name, member, answer, false, owner)
    made.chained_function = function_name
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var chained = Model.ParameterModel("_chained_{parameter.name}", parameter.parameter_type, false)
        made.parameters.append(chained)
        index = index + 1
    }
    owner.declared_functions.append(made)
    return made
}

func union_enum_value(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    written: String,
): Model.FunctionModel? {
    var united = union_model_of(owner_type)
    var first_member = united.members[0]
    fallback first_member
    fallback context.has_a_class(first_member)
    var first_class = context.class_of(first_member)
    var candidates = enum_members_of(first_class)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var enum_type = enum_type_of_member(first_class, candidate)
        var enumeration = enum_model_of(enum_type)
        var read_name = candidate
        if read_name.starts_with("get_") {
            var length = read_name.length()
            var sliced_read_name = read_name.slice(4, length)
            crash sliced_read_name
            read_name = sliced_read_name
        }
        var answered = union_member_name(owner_type, read_name)
        var fits = enumeration.values.contains(written) and not answered.is_empty()
        if fits {
            var shape = union_shape_of(owner_type, answered)
            var boolean = context.boolean()
            var made = context.resolver.specialized(template, name, answered, boolean, false, owner)
            made.bound_shape = shape.key
            compare_with_the_value(made, enum_type, written)
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func union_member_name(union_type: Model.Type, wanted: String): String {
    var united = union_model_of(union_type)
    if every_member_has(united, wanted) {
        return wanted
    }
    var getter = "get_{wanted}"
    if every_member_has(united, getter) {
        return getter
    }
    return ""
}

func every_member_has(united: Model.UnionModel, wanted: String): Boolean {
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fallback context.has_a_class(held)
        var model = context.class_of(held)
        var has_it = model.attribute_named(wanted) or model.function_named(wanted)
        var getter_name = "get_{wanted}"
        has_it = has_it or model.function_named(getter_name)
        fallback has_it
        index = index + 1
    }
    return true
}

func singular_candidates(written: String, is_plural: Boolean): List<String> {
    var candidates = List<String>()
    if not is_plural {
        candidates.append(written)
        return candidates
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        crash stem
        candidates.append("{stem}y")
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        crash without_s
        candidates.append(without_s)
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        crash without_es
        candidates.append(without_es)
    }
    candidates.append(written)
    return candidates
}

func specialized_over_a_namespace(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var model = context.resolver.class_model_named(written)
    fallback model
    var member_type = Model.Type('object', model.key)
    var made = context.resolver.specialized(template, name, model.shown, member_type, false, owner)
    owner.declared_functions.append(made)
    return made
}

func specialized_over_values(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var enumeration = enum_model_of(owner_type)
    var index = enumeration.values.index_of(written)
    fallback index
    var made = context.resolver.specialized(template, name, written, owner_type, false, owner)
    made.bound_member_index = index
    owner.declared_functions.append(made)
    return made
}

func specialized_over_parameters(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    owner_type: Model.Type,
    name: String,
    match: String,
): Model.FunctionModel? {
    var parts = match.split("|")
    var written = parts[0]
    crash written
    var walked = context.resolver.function_of_parameters(owner_type)
    fallback walked
    var index = 0
    while index < walked.parameters.count() {
        var parameter = walked.parameters[index]
        if parameter.name == written {
            var made = context.resolver.specialized(template, name, written, parameter.parameter_type, false, owner)
            made.bound_member_index = index
            owner.declared_functions.append(made)
            return made
        }
        index = index + 1
    }
    return null
}

func template_match(template: Model.FunctionModel, name: String): String? {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    var place = words.index_of(parameter.name)
    var is_plural = false
    if not place {
        place = words.index_of("{parameter.name}s")
        is_plural = true
    }
    crash place
    var before = List<String>()
    var after = List<String>()
    var word_index = 0
    while word_index < words.count() {
        var word = words[word_index]
        if word_index < place {
            before.append(word)
        }
        if word_index > place {
            after.append(word)
        }
        word_index = word_index + 1
    }
    var prefix = before.join("_")
    if not prefix.is_empty() {
        prefix = "{prefix}_"
    }
    var suffix = after.join("_")
    if not suffix.is_empty() {
        suffix = "_{suffix}"
    }
    var fits = name.starts_with(prefix) and name.ends_with(suffix)
    var fixed_length = prefix.length() + suffix.length()
    fallback fits and name.length() > fixed_length
    var prefix_length = prefix.length()
    var middle_end = name.length() - suffix.length()
    var written = name.slice(prefix_length, middle_end)
    crash written
    if is_plural {
        return "{written}|plural"
    }
    return written
}

func walk_of(
    owner: Model.ClassModel,
    name: String,
    written: List<Expression>,
): Value? {
    var own = this_value()
    return walk_on(owner, own, name, written)
}

func walk_on(
    owner: Model.ClassModel,
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value? {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and walks_by_the_name(template, name) {
            var held = receiver
            var is_its_own = receiver.class == HighIntermediaryRepresentation.Values.ThisRead
            if not is_its_own {
                held = held_once(receiver)
            }
            return walked_over(owner, held, template, written)
        }
        index = index + 1
    }
    return null
}

func walks_by_the_name(template: Model.FunctionModel, name: String): Boolean {
    if "{template.name}s" == name {
        return true
    }
    var word = walked_word(template)
    var plurals = List<String>()
    plurals.append("{word}s")
    plurals.append("{word}es")
    if word.ends_with("y") {
        var length = word.length()
        var stem = word.slice(0, length - 1)
        crash stem
        plurals.append("{stem}ies")
    }
    var index = 0
    while index < plurals.count() {
        var plural = plurals[index]
        var walked_name = replaced_word(template.name, word, plural)
        if walked_name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func template_takes_a_plural(template: Model.FunctionModel): Boolean {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    var words = template.name.split("_")
    return not words.contains(parameter.name)
}

func walked_over(
    owner: Model.ClassModel,
    receiver: Value,
    template: Model.FunctionModel,
    written: List<Expression>,
): Value {
    var plural_name = "{template.name}s"
    var written_owner = owner_of_a_template(template, owner, plural_name)
    crash written_owner
    var member_owner = bound_parameters(template, written_owner)
    var names = walked_names(member_owner)
    if member_owner.kind == 'pattern' {
        names = pattern_names(template, member_owner)
    }
    if not template.narrowed_names.is_empty() {
        names = template.narrowed_names
    }
    var index = 0
    while index < names.count() {
        var member = names[index]
        var word = walked_word(template)
        var called_name = replaced_word(template.name, word, member)
        refuse_a_made_clash(owner, template, called_name, member, member_owner)
        var function = member_template_of(owner, called_name)
        crash function
        var made = called(function, receiver, written)
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(made)
        evaluated.line = context.line
        context.pending.append(evaluated)
        index = index + 1
    }
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func refuse_a_made_clash(
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    called_name: String,
    member: String,
    member_owner: Model.Type,
) {
    var existing = owner.function_named(called_name)
    fallback existing
    var is_written = existing.bound_member.is_empty() and not existing.is_a_member_template
    fallback is_written and existing.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = existing.declaration
    var kind = "member"
    if member_owner.kind == 'object' {
        kind = "attribute"
    }
    var member_shown = context.shown(member_owner)
    var refusal = Validators.HighIntermediaryRepresentation.TemplateClash.Validator()
    refusal.refuse(
        owner.file.path,
        declaration.line,
        owner.shown,
        template.name,
        called_name,
        kind,
        member,
        member_shown,
    )
}

func walked_word(template: Model.FunctionModel): String {
    crash template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    var parameter = declaration.parameters[template.template_index]
    crash parameter
    return parameter.name
}

func walked_names(member_owner: Model.Type): List<String> {
    var names = List<String>()
    if member_owner.kind == 'namespace' {
        return classes_of_a_namespace(member_owner.name)
    }
    if member_owner.kind == 'parameters' {
        return parameters_of(member_owner)
    }
    if member_owner.kind == 'enumeration' {
        var enumeration = enum_model_of(member_owner)
        return enumeration.values
    }
    var is_walked = member_owner.kind == 'object' or member_owner.kind == 'shape'
    if member_owner.is_nullable or not is_walked {
        return names
    }
    if member_owner.kind == 'shape' {
        var shape = context.program.shape_keyed(member_owner.name)
        crash shape
        var shape_index = 0
        while shape_index < shape.members.count() {
            var member = shape.members[shape_index]
            if member.is_an_attribute {
                names.append(member.name)
            }
            shape_index = shape_index + 1
        }
        return names
    }
    var model = context.class_of(member_owner)
    if model.bound_types["$element_type"] or model.bound_types["$value_type"] {
        return names
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        names.append(attribute.name)
        index = index + 1
    }
    return names
}

func parameters_of(owner: Model.Type): List<String> {
    var walked = context.resolver.function_of_parameters(owner)
    crash walked
    return walked.parameters.map_names()
}

func classes_of_a_namespace(namespace: String): List<String> {
    var names = List<String>()
    add_the_classes_of(namespace, names)
    var folders = context.resolver.symbols.namespace_folders()
    var folder_index = 0
    while folder_index < folders.count() {
        var each_folder = folders[folder_index]
        if each_folder.namespace.ends_with(".{namespace}") {
            add_the_classes_of(each_folder.namespace, names)
        }
        folder_index = folder_index + 1
    }
    return names
}

func add_the_classes_of(namespace: String, names: List<String>) {
    var folder = context.resolver.symbols.namespace_folder(namespace)
    fallback folder
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var model = context.resolver.class_model_named(file.namespace)
        if model {
            names.append(model.shown)
        }
        index = index + 1
    }
}

func member_index_of(model: Model.ClassModel, name: String): Integer {
    if model.attribute_named(name) {
        return attribute_index_of(model, name)
    }
    return 0
}

func attribute_index_of(model: Model.ClassModel, name: String): Integer {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.name == name {
            return index
        }
        index = index + 1
    }
    crash
}

func answer_or_nothing(function: Model.FunctionModel): Model.Type {
    if function.answer {
        return function.answer
    }
    return Model.Type('nothing', "")
}

func member_of(element_class: Model.ClassModel, written: String, is_plural: Boolean): String {
    if not is_plural {
        return member_named(element_class, written)
    }
    var inflected = member_by_plural(element_class, written)
    if not inflected.is_empty() {
        return inflected
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        crash stem
        var found = member_named(element_class, "{stem}y")
        if not found.is_empty() {
            return found
        }
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        crash without_s
        var found_without_s = member_named(element_class, without_s)
        if not found_without_s.is_empty() {
            return found_without_s
        }
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        crash without_es
        var found_without_es = member_named(element_class, without_es)
        if not found_without_es.is_empty() {
            return found_without_es
        }
    }
    return member_named(element_class, written)
}

func refuse_a_singular(element_class: Model.ClassModel, name: String, written: String) {
    var inflected = member_by_plural(element_class, written)
    var singular_member = member_named(element_class, written)
    refuse_a_mapped_test(element_class, name, inflected)
    refuse_a_mapped_test(element_class, name, singular_member)
    refuse_a_shared_plural(name, written, inflected, singular_member)
    fallback inflected.is_empty()
    var singular = member_named(element_class, written)
    fallback not singular.is_empty()
    var plural = plural_of(written)
    fallback plural != written and not written.ends_with("s")
    var called_plural = name.replace(written, plural)
    typing.refuse_singular_template(context, name, written, called_plural)
}

func refuse_a_mapped_test(element_class: Model.ClassModel, name: String, member: String) {
    fallback name.starts_with("map_") and not member.is_empty()
    var member_type = enum_type_of_member(element_class, member)
    fallback context.is_boolean(member_type)
    var shown_member = member
    if member.starts_with("get_") {
        var length = member.length()
        var sliced_shown_member = member.slice(4, length)
        crash sliced_shown_member
        shown_member = sliced_shown_member
    }
    var parts = element_class.shown.split(".")
    var element_name = parts.last()
    crash element_name
    typing.refuse_a_mapped_test(context, name, shown_member, element_name)
}

func refuse_a_shared_plural(name: String, written: String, inflected: String, singular_member: String) {
    fallback not inflected.is_empty() and not singular_member.is_empty() and inflected != singular_member
    typing.refuse_a_shared_plural(context, name, inflected, singular_member, written)
}

func member_by_plural(element_class: Model.ClassModel, written: String): String {
    var names = element_class.declared_attributes.map_names()
    var function_index = 0
    while function_index < element_class.declared_functions.count() {
        var function = element_class.declared_functions[function_index]
        var is_plain = function.parameters.is_empty() and not function.is_a_member_template
        if is_plain and function.name.starts_with("get_") {
            var length = function.name.length()
            var getter_name = function.name.slice(4, length)
            crash getter_name
            names.append(getter_name)
        } else if is_plain {
            names.append(function.name)
        }
        function_index = function_index + 1
    }
    var name_index = 0
    while name_index < names.count() {
        var name = names[name_index]
        var plural = plural_of(name)
        if plural == written {
            return member_named(element_class, name)
        }
        name_index = name_index + 1
    }
    return ""
}

func plural_of(word: String): String {
    var words = word.split("_")
    var last_word = words.remove_last()
    crash last_word
    var head = words.join("_")
    if not head.is_empty() {
        head = "{head}_"
    }
    var text_class = context.resolver.class_model_named("String")
    if not text_class {
        return word.pluralize()
    }
    if inflection_lists(text_class, "uncountables", last_word) {
        return word
    }
    var irregular = irregular_plural(text_class, last_word)
    if not irregular.is_empty() {
        return "{head}{irregular}"
    }
    if is_in_the_compilers_tables(last_word) {
        var by_the_rules = plural_by_the_rules(last_word)
        return "{head}{by_the_rules}"
    }
    return word.pluralize()
}

func is_in_the_compilers_tables(word: String): Boolean {
    var own_irregulars = word.irregulars
    var plural = own_irregulars[word]
    if plural {
        return true
    }
    var plurals = own_irregulars.values()
    if plurals.contains(word) {
        return true
    }
    var own_uncountables = word.uncountables
    return own_uncountables.contains(word)
}

func plural_by_the_rules(word: String): String {
    var marked = "q{word}"
    var plural = marked.pluralize()
    var length = plural.length()
    var sliced = plural.slice(1, length)
    crash sliced
    return sliced
}

func inflection_lists(text_class: Model.ClassModel, name: String, word: String): Boolean {
    var listed = inflection_table(text_class, name)
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return lists_the_word(listed, word)
    }
    return false
}

func inflection_table(text_class: Model.ClassModel, name: String): Expression? {
    var attribute = text_class.attribute_named(name)
    if attribute {
        crash attribute.declaration
        return attribute.declaration.value
    }
    var function = text_class.function_named(name)
    fallback function
    crash function.declaration
    crash function.declaration.body
    var last = function.declaration.body.statements.last()
    if last.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return last.value
    }
    return null
}

func lists_the_word(listed: AbstractSyntaxTree.Shapes.Expressions.ListLiteral, word: String): Boolean {
    var index = 0
    while index < listed.entries.count() {
        var entry = listed.entries[index]
        if entry.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
            var text = constant_text_of(entry)
            if text == word {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func irregular_plural(text_class: Model.ClassModel, word: String): String {
    var table = inflection_table(text_class, "irregulars")
    if table.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        return plural_in_the_table(table, word)
    }
    return ""
}

func plural_in_the_table(table: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral, word: String): String {
    var index = 0
    while index < table.pairs.count() {
        var pair = table.pairs[index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var answered = entry_plural(pair, word)
            if not answered.is_empty() {
                return answered
            }
        }
        index = index + 1
    }
    return ""
}

func entry_plural(pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral, word: String): String {
    var key = pair.key
    if key.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var singular = constant_text_of(key)
        return plural_of_an_entry(singular, pair.value, word)
    }
    return ""
}

func plural_of_an_entry(
    singular: String,
    value: Expression?,
    word: String,
): String {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var plural = constant_text_of(value)
        var names_it = singular == word or plural == word
        if names_it {
            return plural
        }
    }
    return ""
}

func member_named(element_class: Model.ClassModel, wanted: String): String {
    if element_class.attribute_named(wanted) {
        return wanted
    }
    var function = element_class.function_named(wanted)
    var getter = element_class.function_named("get_{wanted}")
    if not function and getter {
        return "get_{wanted}"
    }
    fallback function
    fallback function.parameters.is_empty()
    return wanted
}

func bound_member_read(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value? {
    var function = context.current_function
    fallback function.bound_member_type
    var target = index.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return bound_attribute_read(index, target, function)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return own_bound_read(target, function)
    }
    return null
}

func own_bound_read(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): Value? {
    fallback target.name == "attributes"
    var item = this_value()
    return bound_member_of(item, function)
}

func bound_attribute_read(
    _index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
): Value? {
    fallback target.name == "attributes"
    var item = value_of(target.target, null)
    return bound_member_of(item, function)
}

func bound_member_of(
    item: Value,
    function: Model.FunctionModel,
): Value {
    var read = bound_member_value(item, function)
    if not function.chained_function.is_empty() {
        read = chained_call(read, function)
    }
    if not function.compared_value {
        return read
    }
    var value = HighIntermediaryRepresentation.Values.WholeNumber(function.compared_value, function.compared_number)
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', read, value)
}

func chained_call(
    read: Value,
    function: Model.FunctionModel,
): Value {
    var through = present_class_of(read)
    var called_function = through.function_named(function.chained_function)
    crash called_function
    need(called_function)
    var arguments = List<Value>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name.starts_with("_chained_") {
            var internal_name = context.scope.internal_name_of(parameter.name)
            crash internal_name
            var passed = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, internal_name)
            arguments.append(passed)
        }
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(called_function, read, arguments)
}

func bound_member_value(
    item: Value,
    function: Model.FunctionModel,
): Value {
    if item.value_type.kind == 'handle' {
        return handle_member(item, function.bound_member)
    }
    if item.value_type.kind == 'shape' {
        var no_written = List<Expression>()
        return shape_call(item, function.bound_member, no_written)
    }
    if item.value_type.kind == 'union' and not function.bound_shape.is_empty() {
        var as_shape = Model.Type('shape', function.bound_shape)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', item)
        var none_written = List<Expression>()
        return shape_call(shaped, function.bound_member, none_written)
    }
    var owner = present_class_of(item)
    if function.bound_member_is_a_function {
        var called_function = owner.function_named(function.bound_member)
        crash called_function
        var no_arguments = List<Expression>()
        return called(called_function, item, no_arguments)
    }
    var attribute = owner.attribute_named(function.bound_member)
    crash attribute
    if item.value_type.kind == 'scalar' {
        return number_room(item, attribute)
    }
    return HighIntermediaryRepresentation.Values.AttributeRead(item, attribute)
}

func handle_member(
    handle: Value,
    name: String,
): Value {
    if name == "finished" {
        return work_call(handle, "get_finished")
    }
    var result = result_of_handle(handle)
    var no_written = List<Expression>()
    var owner = present_class_of(result)
    var attribute = owner.attribute_named(name)
    if attribute {
        return HighIntermediaryRepresentation.Values.AttributeRead(result, attribute)
    }
    var getter = owner.function_named("get_{name}")
    if not getter {
        var shown = context.shown(result.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash getter
    return called(getter, result, no_written)
}

func union_shape_of(union_type: Model.Type, name: String): Model.ShapeModel {
    var shown = context.shown(union_type)
    if union_type.is_nullable {
        note_a_maybe_null_type(union_type)
    }
    var united = union_model_of(union_type)
    var key = "{united.key}|{name}"
    var known = context.program.shape_keyed(key)
    if known {
        return known
    }
    if is_a_copy_name(name) {
        return union_copy_shape(union_type, united, key, name, shown)
    }
    var made = Model.ShapeModel(key, united.name)
    var fillers = context.program.fillers_of(key)
    var member: Model.FunctionModel? = null
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        var model = context.class_of(held)
        var answered = member_answered_by(model, name, shown)
        if not member {
            member = answered
        }
        fillers.append(held)
        index = index + 1
    }
    crash member
    made.members.append(member)
    context.program.shapes[key] = made
    return made
}

func union_copy_shape(
    union_type: Model.Type,
    united: Model.UnionModel,
    key: String,
    name: String,
    shown: String,
): Model.ShapeModel {
    var made = Model.ShapeModel(key, united.name)
    var copying = Model.FunctionModel(name, key)
    copying.answer = union_type.present()
    if name == "_deep_copy_in" {
        var copies = Copying(context, this)
        var table_model = copies.copy_table()
        var table_type = table_model.type_of_an_instance()
        var parameter = Model.ParameterModel("table", table_type, false)
        copying.parameters.append(parameter)
    }
    made.members.append(copying)
    context.program.shapes[key] = made
    var fillers = context.program.fillers_of(key)
    var index = 0
    while index < united.members.count() {
        var held = united.members[index]
        fillers.append(held)
        need_a_copy(held, name, shown, made)
        index = index + 1
    }
    return made
}

func is_a_copy_name(name: String): Boolean {
    return name == "copy" or name == "deep_copy" or name == "_deep_copy_in"
}

func copy_member_of(shape: Model.ShapeModel, answer: Model.Type, name: String, shown: String): Model.FunctionModel {
    var known = shape.member_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, shape.key)
    made.answer = answer
    if name == "_deep_copy_in" {
        var copies = Copying(context, this)
        var table_model = copies.copy_table()
        var table_type = table_model.type_of_an_instance()
        var parameter = Model.ParameterModel("table", table_type, false)
        made.parameters.append(parameter)
    }
    shape.members.append(made)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        need_a_copy(filler, name, shown, shape)
        index = index + 1
    }
    return made
}

func need_a_copy(filler: Model.Type, name: String, shown: String, shape: Model.ShapeModel) {
    var is_copied = filler.kind == 'object' and filler.name != "String" and not filler.is_a_walked_name
    if not is_copied {
        typing.refuse_not_a_fit(context, shown, shape.name, name)
    }
    var model = context.class_of(filler)
    var function = model.function_named(name)
    if not function {
        var given_count = 0
        if name == "_deep_copy_in" {
            given_count = 1
        }
        function = made_copy(model, name, given_count)
    }
    if not function {
        typing.refuse_not_a_fit(context, model.shown, shape.name, name)
    }
    crash function
    need(function)
}

func union_method_call(
    receiver: Value,
    name: String,
    arguments: List<Value>,
): Value {
    var through = union_shape_of(receiver.value_type, name)
    var as_shape = Model.Type('shape', through.key)
    var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', receiver)
    return shape_method_call(shaped, name, arguments)
}

func member_answered_by(model: Model.ClassModel, name: String, shown: String): Model.FunctionModel {
    var attribute = model.attribute_named(name)
    if attribute {
        var read = Model.FunctionModel(name, model.key)
        read.is_an_attribute = true
        read.answer = attribute.attribute_type
        return read
    }
    var function = model.function_named(name)
    if function {
        need(function)
        return function
    }
    var getter = model.function_named("get_{name}")
    if not getter {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash getter
    need(getter)
    var through_the_getter = Model.FunctionModel(name, model.key)
    through_the_getter.is_an_attribute = true
    through_the_getter.answer = getter.answer
    return through_the_getter
}

func listing_attributes(shape_type: Model.Type) {
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    fallback not shape.member_named("_attribute_list")
    var reflection = Reflection(context, this)
    var attribute_type = reflection.reflection_type("Spite.Attribute")
    var list_type = context.resolver.text_dictionary_type_of(attribute_type)
    var member = Model.FunctionModel("_attribute_list", shape.key)
    member.answer = list_type
    shape.members.append(member)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if context.has_a_class(filler) {
            var model = context.class_of(filler)
            reflection.make_attribute_list_of(model)
        } else {
            reflection.make_no_attributes()
        }
        index = index + 1
    }
}

func shape_function_value(
    target: Value,
    name: String,
): Value? {
    var shape = context.program.shape_keyed(target.value_type.name)
    crash shape
    var member = shape.member_named(name)
    fallback member
    fallback not member.is_an_attribute
    var owner = context.current_class
    var key = target.value_type.name.replace(".", "_")
    var synthetic_name = "_{name}_through_{key}"
    var made = owner.function_named(synthetic_name)
    if not made {
        made = through_the_shape(owner, synthetic_name, target.value_type, member)
    }
    crash made
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = made.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = made.answer
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, made, target)
}

func through_the_shape(
    owner: Model.ClassModel,
    synthetic_name: String,
    shape_type: Model.Type,
    member: Model.FunctionModel,
): Model.FunctionModel {
    var made = Model.FunctionModel(synthetic_name, owner.key)
    made.is_synthetic = true
    made.answer = member.answer
    made.parameters = member.parameters
    owner.declared_functions.append(made)
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    var own = HighIntermediaryRepresentation.Values.ThisRead(shape_type)
    var passed = List<Value>()
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        var read = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, parameter.name)
        passed.append(read)
        index = index + 1
    }
    var through = HighIntermediaryRepresentation.Values.ShapeCall(shape, member, own, passed)
    var body = HighIntermediaryRepresentation.Statements.Block()
    if member.answer {
        var answered = HighIntermediaryRepresentation.Statements.Return(through)
        body.statements.append(answered)
    } else {
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(through)
        body.statements.append(evaluated)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func shape_call(
    receiver: Value,
    name: String,
    written: List<Expression>,
): Value {
    var shown = context.shown(receiver.value_type)
    if receiver.value_type.is_nullable {
        note_a_maybe_null_type(receiver.value_type)
    }
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var member = shape.member_named(name)
    if not member and is_a_copy_name(name) and written.is_empty() {
        var own_type = receiver.value_type.present()
        member = copy_member_of(shape, own_type, name, shown)
    }
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    var arguments = arguments_for(shown, member.parameters, written, false)
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func called(
    function: Model.FunctionModel,
    receiver: Value,
    written: List<Expression>,
): Value {
    if takes_numbers(function) and written.count() == function.parameters.count() {
        return number_call(function, receiver, written)
    }
    var schema = schema_of(function)
    if schema {
        return schema
    }
    if function.reflected_answer_index >= 0 and function.bound_parameter.is_empty() {
        typing.refuse_a_run_time_reflection_for_a_type(context, function.name)
    }
    var arguments = fitted_arguments(function, written)
    var with_known_functions = with_the_functions_passed(function, arguments)
    need(with_known_functions)
    copy_an_inline_item(with_known_functions, arguments)
    return HighIntermediaryRepresentation.Values.Call(with_known_functions, receiver, arguments)
}

func with_the_functions_passed(
    function: Model.FunctionModel,
    arguments: List<Value>,
): Model.FunctionModel {
    if not function.declaration or function.known_parameter_functions.count() > 0 {
        return function
    }
    var described_names = described_function_parameters(function)
    if described_names.is_empty() {
        return function
    }
    var known = Dictionary<String, Model.FunctionModel>()
    var pieces = List<String>()
    var index = 0
    while index < function.parameters.count() and index < arguments.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        var described = described_argument_function(argument)
        if described and described_names.contains(parameter.name) {
            known[parameter.name] = described
            var owner_name = described.owner.replace(".", "_")
            pieces.append("{owner_name}_{described.name}")
        }
        index = index + 1
    }
    if pieces.is_empty() {
        return function
    }
    var joined = pieces.join("_and_")
    var copy_name = "{function.name}_for_{joined}"
    var copy_key = "{function.owner}.{copy_name}"
    var made = context.known_function_copies[copy_key]
    if made {
        return made
    }
    var copied = Model.FunctionModel(copy_name, function.owner)
    copied.declaration = function.declaration
    copied.parameters = function.parameters
    copied.answer = function.answer
    copied.known_parameter_functions = known
    context.known_function_copies[copy_key] = copied
    return copied
}

func described_argument_function(argument: Value?): Model.FunctionModel? {
    fallback argument
    return described_function(argument)
}

func described_function_parameters(function: Model.FunctionModel): List<String> {
    var function_key = function.key()
    var known_names = context.described_parameters[function_key]
    if known_names {
        return known_names
    }
    var found_names = read_described_parameters(function)
    context.described_parameters[function_key] = found_names
    return found_names
}

func read_described_parameters(function: Model.FunctionModel): List<String> {
    var described_names = List<String>()
    crash function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return described_names
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var described_name = described_parameter_of(found.expression, function)
        if not described_name.is_empty() and not described_names.contains(described_name) {
            described_names.append(described_name)
        }
        index = index + 1
    }
    return described_names
}

func described_parameter_of(
    expression: Expression?,
    function: Model.FunctionModel,
): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return described_target_of(expression.target, expression.name, function)
    }
    return ""
}

func described_target_of(
    target: Expression?,
    member_name: String,
    function: Model.FunctionModel,
): String {
    var asks = member_name == "name" or member_name == "arguments"
    fallback asks
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return function_parameter_named(target.name, function)
    }
    return ""
}

func function_parameter_named(name: String, function: Model.FunctionModel): String {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        if parameter.name == name and parameter.parameter_type.kind == 'function' {
            return name
        }
        index = index + 1
    }
    return ""
}

func copy_an_inline_item(function: Model.FunctionModel, arguments: List<Value>) {
    fallback function.name == "_write_value" and arguments.count() == 2
    var owner = context.program.class_named(function.owner)
    fallback owner
    var holds_inline = owner.key.starts_with("Vector_of_") or owner.key.starts_with("Items_of_")
    fallback holds_inline
    var element = owner.bound_types["$element_type"]
    fallback element
    var is_an_object = element.kind == 'object' and element.name != "String" and not element.is_nullable
    fallback is_an_object
    var by_reference = owner.key.starts_with("Items_of_") and not fits_a_vector(element)
    fallback not by_reference
    var model = context.class_of(element)
    fallback not model.is_singleton
    var copying = model.function_named("copy")
    if not copying {
        copying = made_copy(model, "copy", 0)
    }
    crash copying
    need(copying)
    var item = arguments[1]
    var no_arguments = List<Value>()
    var copied = HighIntermediaryRepresentation.Values.Call(copying, item, no_arguments)
    arguments[1] = copied
}

func schema_of(function: Model.FunctionModel): Value? {
    fallback function.name == "schema" and not function.has_a_body()
    var owner = context.program.class_named(function.owner)
    fallback owner
    var is_binary = owner.key.starts_with("BinaryWriter_of_") or owner.key.starts_with("BinaryReader_of_")
    fallback is_binary
    var described = owner.bound_types["$value_type"]
    fallback described
    var schema = Schema(context)
    var hashed = schema.hash_of(described)
    var long = context.scalar_type("Long")
    return HighIntermediaryRepresentation.Values.WholeNumber(long, hashed)
}

func takes_numbers(function: Model.FunctionModel): Boolean {
    fallback function.has_a_body() and function.number_copy_of.is_empty()
    fallback function.declaration
    return writes_a_number(function.declaration)
}

func writes_a_number(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Boolean {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        if is_written_number(parameter.declared_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_written_number(written: Type?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Types.NamedType {
        var path = written.path.join(".")
        return path == "Number"
    }
    return false
}

# ../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func number_shape_cast(value: Value, wanted: Model.Type): Value {
    var present = wanted.present()
    var names = Mapping.Names()
    var reader = names.snake_case_of(present.name)
    var name = "_as_{reader}"
    need_a_number_cast(name, present)
    var no_arguments = List<Value>()
    var cast = shape_method_call(value, name, no_arguments)
    return fitted(cast, wanted)
}

func need_a_number_cast_in(filler: Model.Type, name: String, shape: Model.ShapeModel) {
    var model = context.class_of(filler)
    var function = model.function_named(name)
    if not function {
        typing.refuse_not_a_fit(context, model.shown, shape.name, name)
    }
    crash function
    need(function)
}

func need_a_number_cast(name: String, answer: Model.Type) {
    var shape = context.program.shape_keyed("Number")
    crash shape
    fallback not shape.member_named(name)
    var member = Model.FunctionModel(name, shape.key)
    member.answer = answer
    shape.members.append(member)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        need_a_number_cast_in(filler, name, shape)
        index = index + 1
    }
}

func is_the_number_shape(of_type: Model.Type): Boolean {
    return of_type.kind == 'shape' and of_type.name == "Number" and not of_type.is_nullable
}

func number_call(
    function: Model.FunctionModel,
    receiver: Value,
    written: List<Expression>,
): Value {
    var arguments = List<Value>()
    var type_names = List<String>()
    var positions = List<Integer>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = written[index]
        if is_the_number_shape(parameter.parameter_type) {
            add_a_number(argument, parameter, index, arguments, type_names, positions)
        } else {
            var fitted_argument = fitted_value_of(argument, parameter.parameter_type)
            type_names.append(parameter.parameter_type.name)
            arguments.append(fitted_argument)
        }
        index = index + 1
    }
    if positions.is_empty() {
        var copy = number_copy(function, type_names)
        return HighIntermediaryRepresentation.Values.Call(copy, receiver, arguments)
    }
    var dispatched = HighIntermediaryRepresentation.Values.Call(function, receiver, arguments)
    dispatched.number_positions = positions
    dispatched.number_types = type_names
    context.number_dispatches.append(dispatched)
    copies_for(dispatched)
    return dispatched
}

func add_a_number(
    argument: Expression?,
    parameter: Model.ParameterModel,
    index: Integer,
    arguments: List<Value>,
    type_names: List<String>,
    positions: List<Integer>,
) {
    var given = value_of(argument, null)
    var given_type = given.value_type
    if given_type.kind == 'scalar' and not given_type.is_nullable {
        type_names.append(given_type.name)
        arguments.append(given)
        return
    }
    var shaped = fitted(given, parameter.parameter_type)
    type_names.append("")
    positions.append(index)
    arguments.append(shaped)
}

func copies_for(dispatched: HighIntermediaryRepresentation.Values.Call) {
    var chosen = List<String>()
    dispatched.number_types.each(chosen.append)
    copies_from(dispatched, chosen, 0)
}

func copies_from(
    dispatched: HighIntermediaryRepresentation.Values.Call,
    chosen: List<String>,
    position_index: Integer,
) {
    if position_index == dispatched.number_positions.count() {
        make_number_copy(dispatched.function, chosen)
        return
    }
    var position = dispatched.number_positions[position_index]
    crash position
    var fillers = context.program.fillers_of("Number")
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var picked = List<String>()
        chosen.each(picked.append)
        picked[position] = filler.name
        copies_from(dispatched, picked, position_index + 1)
        index = index + 1
    }
}

func number_copy(function: Model.FunctionModel, type_names: List<String>): Model.FunctionModel {
    make_number_copy(function, type_names)
    var owner = context.program.class_named(function.owner)
    crash owner
    var name = function.number_copy_name(type_names)
    var made = owner.function_named(name)
    crash made
    return made
}

func make_number_copy(function: Model.FunctionModel, type_names: List<String>) {
    var owner = context.program.class_named(function.owner)
    crash owner
    var name = function.number_copy_name(type_names)
    fallback not owner.function_named(name)
    var made = Model.FunctionModel(name, function.owner)
    made.declaration = function.declaration
    made.answer = function.answer
    made.number_copy_of = function.name
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var parameter_type = parameter.parameter_type
        if is_the_number_shape(parameter_type) {
            var type_name = type_names[index]
            crash type_name
            parameter_type = Model.Type('scalar', type_name)
        }
        var copied = Model.ParameterModel(parameter.name, parameter_type, parameter.is_variadic)
        made.parameters.append(copied)
        index = index + 1
    }
    owner.declared_functions.append(made)
    need(made)
}

func method_call(
    receiver: Value,
    name: String,
    arguments: List<Value>,
): Value {
    if receiver.value_type.kind == 'shape' {
        return shape_method_call(receiver, name, arguments)
    }
    if receiver.value_type.kind == 'union' and not receiver.value_type.is_nullable {
        return union_method_call(receiver, name, arguments)
    }
    var owner = present_class_of(receiver)
    var function = owner.function_named(name)
    if not function {
        function = member_template_of(owner, name)
    }
    if not function and name == "to_debug" {
        var debugging = Debugging(context, this)
        function = debugging.to_debug_of(owner)
    }
    var given_count = arguments.count()
    if not function {
        function = made_copy(owner, name, given_count)
    }
    if not function {
        var shown = context.shown(receiver.value_type)
        typing.refuse_unknown_member(context, shown, name)
    }
    crash function
    need(function)
    var given = List<Value>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var parameter = function.parameters[index]
        crash parameter
        var fitted_argument = fitted(argument, parameter.parameter_type)
        given.append(fitted_argument)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.Call(function, receiver, given)
}

func shape_method_call(
    receiver: Value,
    name: String,
    arguments: List<Value>,
): Value {
    var shape = context.program.shape_keyed(receiver.value_type.name)
    crash shape
    var shown = context.shown(receiver.value_type)
    var member = shape.member_named(name)
    var is_copied_in = name == "_deep_copy_in" and arguments.count() == 1
    if not member and is_a_copy_name(name) and (arguments.is_empty() or is_copied_in) {
        var own_type = receiver.value_type.present()
        member = copy_member_of(shape, own_type, name, shown)
    }
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    return HighIntermediaryRepresentation.Values.ShapeCall(shape, member, receiver, arguments)
}

func fitted_arguments(
    function: Model.FunctionModel,
    written: List<Expression>,
): List<Value> {
    var spread = spread_arguments(function, written)
    if spread {
        return spread
    }
    var shown = "{function.owner}.{function.name}"
    var owner = context.program.class_named(function.owner)
    var walks_the_function = false
    if owner {
        walks_the_function = context.resolver.symbols.is_library_path(owner.file.path)
    }
    return arguments_for(shown, function.parameters, written, walks_the_function)
}

func spread_arguments(
    function: Model.FunctionModel,
    written: List<Expression>,
): List<Value>? {
    fallback written.count() == 1
    var only = written[0]
    if only.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return spread_of(function, only)
    }
    return null
}

func spread_of(
    function: Model.FunctionModel,
    spreading: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<Value>? {
    var callee = spreading.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return spread_by(function, callee.name, spreading.arguments)
    }
    return null
}

func spread_by(
    function: Model.FunctionModel,
    name: String,
    written: List<Expression>,
): List<Value>? {
    var owner = context.current_class
    fallback not owner.function_named(name)
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not template_takes_a_plural(template)
        if is_singular and walks_by_the_name(template, name) {
            return spread_over(function, owner, template, written)
        }
        index = index + 1
    }
    return null
}

func spread_over(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    written: List<Expression>,
): List<Value>? {
    var outer_spread = spread_into
    spread_into = function
    var plural_name = "{template.name}s"
    var member_owner = owner_of_a_template(template, owner, plural_name)
    if not member_owner or member_owner.kind != 'parameters' {
        spread_into = outer_spread
        return null
    }
    var arguments = List<Value>()
    var word = walked_word(template)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var called_name = template.name.replace(word, parameter.name)
        var made = member_template_of(owner, called_name)
        crash made
        var own = this_value()
        var answered = called(made, own, written)
        var fitted_answer = fitted(answered, parameter.parameter_type)
        arguments.append(fitted_answer)
        index = index + 1
    }
    spread_into = outer_spread
    return arguments
}

func owner_of_a_template(template: Model.FunctionModel, owner: Model.ClassModel, called_name: String): Model.Type? {
    var range = context.resolver.range_of_a_template(template)
    if range != "Spite.Argument" {
        return context.resolver.template_owner_of(template, owner)
    }
    var found = argument_owner()
    if not found {
        var refusal = Validators.NameResolution.TemplateRange.Validator()
        refusal.refuse_an_unknown_argument_owner(
            context.current_class.file.path,
            context.line,
            context.current_class.shown,
            context.current_function.name,
            called_name,
        )
    }
    return found
}

func argument_owner(): Model.Type? {
    var current = context.current_function
    if spread_into {
        var into: Model.FunctionModel = spread_into
        return parameters_of_a_call(into, current)
    }
    var is_bound = not current.bound_pattern.is_empty() and not current.bound_class.is_empty()
    if is_bound {
        return Model.Type('parameters', "{current.bound_class}|{current.bound_pattern}")
    }
    return null
}

func parameters_of_a_call(into: Model.FunctionModel, current: Model.FunctionModel): Model.Type {
    var is_the_pattern = into.name == current.bound_function and not current.bound_pattern.is_empty()
    if is_the_pattern {
        return Model.Type('parameters', "{into.owner}|{current.bound_pattern}")
    }
    return Model.Type('parameters', "{into.owner}|{into.name}")
}

func arguments_for(
    shown: String,
    parameters: List<Model.ParameterModel>,
    written: List<Expression>,
    walks_the_function: Boolean,
): List<Value> {
    var arguments = List<Value>()
    var last = parameters.last()
    var is_variadic = false
    if last {
        is_variadic = last.is_variadic
    }
    var fixed_count = parameters.count()
    if is_variadic {
        fixed_count = fixed_count - 1
    }
    var count_is_wrong = written.count() != parameters.count()
    if is_variadic {
        count_is_wrong = written.count() < fixed_count
    }
    if count_is_wrong {
        var given_count = written.count()
        var wanted_count = parameters.count()
        typing.refuse_argument_count(context, shown, wanted_count, given_count)
    }
    var index = 0
    while index < fixed_count {
        var argument = written[index]
        var parameter = parameters[index]
        crash parameter
        var given = value_of(argument, parameter.parameter_type)
        refuse_a_nullable_answer(shown, argument, given.value_type, parameter.parameter_type)
        if walks_the_function {
            refuse_a_passed_value(shown, argument, given.value_type, parameter.parameter_type)
            refuse_a_passed_function(shown, argument, given.value_type, parameter.parameter_type)
        }
        var value = fitted(given, parameter.parameter_type)
        var folded_keys = Folded.Keys(context, this)
        folded_keys.refuse_a_passed_map(value, shown)
        arguments.append(value)
        index = index + 1
    }
    if is_variadic {
        crash last
        var gathered = gathered_list(last.parameter_type, written, fixed_count)
        arguments.append(gathered)
    }
    return arguments
}

func refuse_a_nullable_answer(
    shown: String,
    argument: Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback given.answer and wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback given_answer.is_nullable and not wanted_answer.is_nullable
    var present = given_answer.present()
    fallback present.is_the_same_as(wanted_answer)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    typing.refuse_a_nullable_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_function(
    shown: String,
    argument: Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback not same_signature(given, wanted)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    if given.parameters.count() != wanted.parameters.count() {
        refuse_a_passed_count(called_name, argument_text, given, wanted)
    }
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        if not given_parameter.is_the_same_as(wanted_parameter) {
            var given_shown = context.shown(given_parameter)
            var wanted_shown = context.shown(wanted_parameter)
            typing.refuse_a_passed_type(context, called_name, argument_text, wanted_shown, given_shown)
        }
        index = index + 1
    }
    if given.answer and wanted.answer {
        refuse_another_answer(called_name, argument_text, given, wanted)
    }
    fallback wanted.answer and not given.answer
    var wanted_answer: Model.Type = wanted.answer
    var answer_shown = context.shown(wanted_answer)
    typing.refuse_a_passed_nothing(context, called_name, argument_text, answer_shown)
}

# ../../PROOFS.md#a-member-template-fits
func refuse_a_passed_value(
    shown: String,
    argument: Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind != 'function' and wanted.kind == 'function' and argument
    var parts = shown.split(".")
    var called_name = parts.last()
    fallback called_name == "each"
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    typing.refuse_an_each_of_a_value(context, argument_text)
}

func refuse_another_answer(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    crash given.answer
    crash wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback not given_answer.is_the_same_as(wanted_answer)
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    typing.refuse_another_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_count(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    var takes = given.parameters.count()
    var gives = wanted.parameters.count()
    if gives == 1 {
        var only = wanted.parameters[0]
        crash only
        var only_shown = context.shown(only)
        typing.refuse_a_passed_single(context, called_name, argument_text, only_shown, takes)
    }
    typing.refuse_a_passed_count(context, called_name, argument_text, gives, takes)
}

func gathered_list(
    list_type: Model.Type,
    written: List<Expression>,
    start: Integer,
): Value {
    var list_model = context.class_of(list_type)
    var element_type = list_model.bound_types["$element_type"]
    crash element_type
    if written.count() == start + 1 {
        refuse_a_whole_list(list_type, element_type, written[start])
    }
    var temporary = new_list(list_type)
    var index = start
    while index < written.count() {
        var entry = written[index]
        var value = fitted_value_of(entry, element_type)
        append_to(temporary, value)
        index = index + 1
    }
    return temporary
}

func refuse_a_whole_list(
    list_type: Model.Type,
    element_type: Model.Type,
    entry: Expression?,
) {
    var is_a_path = entry.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or entry.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback is_a_path and not element_type.name.starts_with("List")
    var whole = value_of(entry, null)
    fallback whole.value_type.name == list_type.name
    var shown = context.shown(list_type)
    typing.refuse_whole_list(context, shown)
}

func made_list(list_type: Model.Type): Value {
    var list_model = context.class_of(list_type)
    context.need_defaults(list_model.key)
    var constructor = constructor_of(list_model)
    if constructor {
        need(constructor)
    }
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(list_type, constructor, no_arguments)
}

func new_list(list_type: Model.Type): Value {
    var list_model = context.class_of(list_type)
    context.need_defaults(list_model.key)
    var constructor = constructor_of(list_model)
    if constructor {
        need(constructor)
    }
    var no_arguments = List<Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(list_type, constructor, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", list_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, list_type, made)
    declared.line = context.line
    context.pending.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(list_type, name)
}

func append_to(list: Value, value: Value) {
    var arguments = List<Value>()
    arguments.append(value)
    var appended = method_call(list, "append", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(appended)
    evaluated.line = context.line
    context.pending.append(evaluated)
}

func list_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral,
    expected: Model.Type?,
): Value {
    var list_type = list_type_for(literal, expected)
    var no_start = 0
    return gathered_list(list_type, literal.entries, no_start)
}

func dictionary_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    expected: Model.Type?,
): Value {
    if not expected {
        var inferred = dictionary_type_by_its_keys(literal)
        if inferred {
            return dictionary_value(literal, inferred)
        }
        return object_literal(literal, null)
    }
    if expected.kind == 'shape' {
        return object_literal(literal, expected)
    }
    var dictionary_type = expected.present()
    var dictionary_model = context.class_of(dictionary_type)
    var key_type = dictionary_model.bound_types["$key_type"]
    var value_type = dictionary_model.bound_types["$value_type"]
    crash key_type
    crash value_type
    refuse_a_duplicate_key(literal)
    var temporary = new_list(dictionary_type)
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            store_an_entry(temporary, pair, key_type, value_type)
        }
        index = index + 1
    }
    return temporary
}

func refuse_a_duplicate_key(literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral) {
    var written_keys = List<String>()
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        var key_text = literal_key_text(pair)
        if not key_text.is_empty() and written_keys.contains(key_text) {
            typing.refuse_a_duplicate_key(context, key_text)
        }
        written_keys.append(key_text)
        index = index + 1
    }
}

func literal_key_text(pair: Expression): String {
    if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        return written_key_text(pair.key)
    }
    return ""
}

func written_key_text(key: Expression?): String {
    var is_constant = key.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral or key.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    fallback is_constant
    crash key
    var printer = Printers.Spite.ExpressionPrinter(key)
    return printer.text()
}

func dictionary_type_by_its_keys(literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral): Model.Type? {
    var first = literal.pairs.first()
    fallback first
    var names_fields = true
    if first.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        names_fields = first.key.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    }
    fallback not names_fields
    var inference = NameResolution.Inference()
    var written = inference.dictionary_type_of(literal)
    fallback written
    return context.resolver.type_in(written, context.current_class, context.line)
}

func store_an_entry(
    temporary: Value,
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
    key_type: Model.Type,
    value_type: Model.Type,
) {
    var folded_keys = Folded.Keys(context, this)
    var key = folded_keys.attribute_key(pair.key, key_type)
    if not key {
        key = fitted_value_of(pair.key, key_type)
    }
    crash key
    var value = fitted_value_of(pair.value, value_type)
    var arguments = List<Value>()
    arguments.append(key)
    arguments.append(value)
    var stored = method_call(temporary, "set_at", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(stored)
    evaluated.line = context.line
    context.pending.append(evaluated)
}

func object_literal(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    expected: Model.Type?,
): Value {
    context.object_count = context.object_count + 1
    var key = "Object{context.object_count}"
    var model = Model.ClassModel(key, "Object", context.current_class.file)
    var shape: Model.ShapeModel? = null
    if expected {
        shape = context.program.shape_keyed(expected.name)
    }
    var values = List<Value>()
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var field = field_of(pair, shape, model)
            values.append(field)
        }
        index = index + 1
    }
    key = stable_object_key(model)
    context.program.add(model)
    context.need_defaults(key)
    var object_type = Model.Type('object', key)
    var no_arguments = List<Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(object_type, null, no_arguments)
    temporary_count = temporary_count + 1
    var name = context.scope.declare("made_{temporary_count}", object_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object_type, made)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(object_type, name)
    var field_index = 0
    while field_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[field_index]
        var value = values[field_index]
        crash value
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Attribute(local, attribute, value)
        assigned.line = context.line
        context.pending.append(assigned)
        field_index = field_index + 1
    }
    return local
}

# ../../HOT_RELOAD.md#a-reload-is-refused-when
func stable_object_key(model: Model.ClassModel): String {
    var digest = Model.Digest()
    var function_key = context.current_function.key()
    digest.add_text(context.current_class.key)
    digest.add_text(function_key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        digest.add_text(attribute.name)
        digest.add_text(attribute.attribute_type.name)
        if attribute.attribute_type.is_nullable {
            digest.add_text("?")
        }
        index = index + 1
    }
    var layout = digest.digest_text()
    var ordinal = 1
    var seen = context.object_ordinals[layout]
    if seen {
        ordinal = seen + 1
    }
    context.object_ordinals[layout] = ordinal
    var key = "Object_{layout}_{ordinal}"
    model.key = key
    var renamed = 0
    while renamed < model.declared_attributes.count() {
        var attribute = model.declared_attributes[renamed]
        attribute.owner = key
        renamed = renamed + 1
    }
    return key
}

func field_of(
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
    shape: Model.ShapeModel?,
    model: Model.ClassModel,
): Value {
    var written = pair.key
    var name = ""
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = written.name
    }
    if name.is_empty() {
        typing.refuse_not_assignable(context)
    }
    var field_type: Model.Type? = null
    if shape {
        var member = shape.member_named(name)
        if not member {
            typing.refuse_unknown_member(context, shape.name, name)
        }
        crash member
        field_type = member.answer
    }
    var value = value_of(pair.value, field_type)
    var attribute_type = value.value_type
    if field_type {
        value = fitted(value, field_type)
        attribute_type = field_type
    }
    var attribute = Model.AttributeModel(name, model.key, attribute_type)
    model.declared_attributes.append(attribute)
    return value
}

func list_type_for(literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral, expected: Model.Type?): Model.Type {
    if expected {
        return expected.present()
    }
    var inference = NameResolution.Inference()
    var written = inference.list_type_of(literal)
    if written {
        return context.resolver.type_in(written, context.current_class, context.line)
    }
    var first = literal.entries.first()
    if not first {
        typing.refuse_list_without_a_type(context)
    }
    var first_value = value_of(first, null)
    var element = first_value.value_type
    if element.kind == 'nothing' {
        typing.refuse_list_without_a_type(context)
    }
    return context.resolver.list_type_of(element)
}

func foreign_call(
    library: Value,
    name: String,
    written: List<Expression>,
): Value {
    refuse_a_library_parameter(library)
    var answer = context.scalar_type("Integer")
    var c_name = name
    if name.ends_with("_as_long") {
        answer = context.scalar_type("Long")
        var long_length = name.length() - 8
        var sliced_c_name = name.slice(0, long_length)
        crash sliced_c_name
        c_name = sliced_c_name
    }
    if name.ends_with("_as_double") {
        answer = context.scalar_type("Double")
        var double_length = name.length() - 10
        var sliced_c_name = name.slice(0, double_length)
        crash sliced_c_name
        c_name = sliced_c_name
    }
    if name.ends_with("_as_float") {
        answer = context.scalar_type("Float")
        var float_length = name.length() - 9
        var sliced_c_name = name.slice(0, float_length)
        crash sliced_c_name
        c_name = sliced_c_name
    }
    if name.ends_with("_as_text") {
        answer = context.text()
        var text_length = name.length() - 8
        var sliced_c_name = name.slice(0, text_length)
        crash sliced_c_name
        c_name = sliced_c_name
    }
    var constants = ForeignConstants(context, this)
    var named = constants.c_name_of(library, c_name)
    var declared = constants.declared_parameters(library, named)
    var arguments = List<Value>()
    var crossing = ForeignCrossing(context, this)
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var wanted = declared_scalar(declared, index)
        var value = value_of(argument, wanted)
        if wanted {
            value = fitted(value, wanted)
        }
        crossing.check_an_argument(value)
        if value.value_type.kind == 'shape' {
            value = held_once(value)
        }
        arguments.append(value)
        index = index + 1
    }
    note_a_foreign_name(library, named)
    return HighIntermediaryRepresentation.Values.ForeignCall(answer, library, named, arguments)
}

func declared_scalar(declared: List<String>, index: Integer): Model.Type? {
    fallback index < declared.count()
    var scalar_name = declared[index]
    fallback not scalar_name.is_empty()
    return context.scalar_type(scalar_name)
}

func note_a_foreign_name(library: Value, named: String) {
    if library.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var names = library.attribute.foreign_names
        if not names.contains(named) {
            names.append(named)
        }
    }
}

func refuse_a_library_parameter(library: Value) {
    if library.class == HighIntermediaryRepresentation.Values.LocalRead {
        var parameter = context.current_function.parameters.find_by_name(library.name)
        if parameter {
            var foreign = Validators.HighIntermediaryRepresentation.Foreign.Validator()
            foreign.refuse_a_call_through_a_parameter(context)
        }
    }
}

func index_value(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value {
    var folded_keys = Folded.Keys(context, this)
    var folded_key = folded_keys.folded_read(index)
    if folded_key {
        return folded_key
    }
    var bound = bound_member_read(index)
    if bound {
        return bound
    }
    var absent = absent_function(index)
    if absent {
        return absent
    }
    var listed_value = enum_value_at(index)
    if listed_value {
        return listed_value
    }
    var declared_name = checked_attribute_name(index)
    var target = value_of(index.target, null)
    var owner = present_class_of(target)
    var named = name_index_of(index.index)
    if named and lists_reflection(owner) {
        var finder = member_template_of(owner, "find_by_name")
        crash finder
        need(finder)
        var finder_arguments = List<Value>()
        finder_arguments.append(named)
        var found = HighIntermediaryRepresentation.Values.Call(finder, target, finder_arguments)
        return proven_by_its_path(found, index)
    }
    var function = owner.function_named("get_at")
    if not function {
        var shown = context.shown(target.value_type)
        typing.refuse_not_indexed(context, shown, "indexing", "get_at(index)")
    }
    crash function
    need(function)
    var parameter = function.parameters[0]
    crash parameter
    var position = named_key_of(owner, index.index)
    if not position {
        position = fitted_value_of(index.index, parameter.parameter_type)
    }
    crash position
    var arguments = List<Value>()
    arguments.append(position)
    var read = HighIntermediaryRepresentation.Values.Call(function, target, arguments)
    var shown_path = path_of_an_index(index)
    read.index_path = shown_path
    read.index_hint = index_hint_of(owner, index)
    var unchecked = context.scope.narrowed_type_of(shown_path)
    var checks_a_literal = is_a_reflection_list(owner) and is_a_number_literal(index.index)
    if checks_a_literal and not unchecked {
        return checked_item(read, shown_path)
    }
    if not declared_name.is_empty() and read.value_type.is_nullable {
        var declared_type = read.value_type.present()
        var declared = HighIntermediaryRepresentation.Values.Conversion(declared_type, 'proven', read)
        declared.shown = shown_path
        return declared
    }
    return proven_by_its_path(read, index)
}

func checked_attribute_name(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var listed = index.target
    var name = key_name_of(index.index)
    fallback name
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return checked_in_the_listing(listed, name)
    }
    return ""
}

func checked_in_the_listing(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
): String {
    fallback listed.name == "attributes"
    var described = constant_class_of(listed.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    if not model.attribute_named(name) {
        typing.refuse_an_unknown_attribute_name(context, model.shown, name)
    }
    return name
}

func index_hint_of(owner: Model.ClassModel, index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    fallback is_a_counted_collection(owner)
    crash index.target
    crash index.index
    var target_printer = Printers.Spite.ExpressionPrinter(index.target)
    var target_text = target_printer.text()
    var index_printer = Printers.Spite.ExpressionPrinter(index.index)
    var index_text = index_printer.text()
    if is_a_number_literal(index.index) {
        return ", or prove the count first, 'crash {target_text}.count() > {index_text}'"
    }
    return ", or read it where a bound proves it, inside 'while {index_text} < {target_text}.count()'"
}

func is_a_counted_collection(owner: Model.ClassModel): Boolean {
    var library = Validators.LibraryFile()
    fallback library.holds(owner.file.path)
    return not owner.shown.starts_with("Dictionary<") and owner.shown != "String"
}

# ../../PROOFS.md#narrowing-a-t
func note_a_maybe_null(
    kind: String,
    value: Value,
    name: String,
    wanted: Model.Type,
) {
    var site = PresenceSite(kind, context, value.value_type)
    site.value = value
    site.name = name
    site.wanted = wanted
    context.note_a_presence_site(site)
}

func note_a_maybe_null_type(maybe: Model.Type) {
    var site = PresenceSite("value", context, maybe)
    context.note_a_presence_site(site)
}

func as_present(value: Value): Value {
    var present = value.value_type.present()
    return HighIntermediaryRepresentation.Values.Conversion(present, 'proven', value)
}

func absent_stand_in(): Model.Type {
    var key = "Spite.Absent"
    var made = Model.Type('object', key)
    if context.program.has(key) {
        return made
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var absent = Model.ClassModel(key, key, no_file)
    context.program.add(absent)
    need_text_constants()
    answer_null(absent, "to_string")
    answer_null(absent, "to_debug")
    return made
}

func answer_null(absent: Model.ClassModel, name: String) {
    var function = Model.FunctionModel(name, absent.key)
    function.is_synthetic = true
    var text = context.text()
    function.answer = text
    absent.declared_functions.append(function)
    var null_text = HighIntermediaryRepresentation.Values.TextConstant("null")
    null_text.value_type = text
    var answered = HighIntermediaryRepresentation.Statements.Return(null_text)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements.append(answered)
    var built = HighIntermediaryRepresentation.HighFunction(function, body)
    context.synthetic_functions.append(built)
}

func lists_reflection(owner: Model.ClassModel): Boolean {
    var element = owner.bound_types["$element_type"]
    fallback element
    fallback not owner.bound_types["$key_type"]
    return element.kind == 'object' and element.name.starts_with("Spite.") and not element.is_nullable
}

func named_key_of(
    owner: Model.ClassModel,
    written: Expression?,
): Value? {
    var held = owner.bound_types["$value_type"]
    fallback held
    var key = owner.bound_types["$key_type"]
    fallback key
    var holds_reflection = held.kind == 'object' and held.name.starts_with("Spite.") and not held.is_nullable
    fallback holds_reflection and key.name == "String"
    return name_index_of(written)
}

func path_of_an_index(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var printer = Printers.Spite.ExpressionPrinter(index)
    return printer.text()
}

func proven_by_its_path(
    read: Value,
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Value {
    var printer = Printers.Spite.ExpressionPrinter(index)
    var path = printer.text()
    var narrowed_type = context.scope.narrowed_type_of(path)
    if narrowed_type {
        var proven = HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'proven', read)
        proven.shown = path
        return proven
    }
    return read
}

func is_a_reflection_list(owner: Model.ClassModel): Boolean {
    var element = owner.bound_types["$element_type"]
    fallback element
    return element.kind == 'object' and element.name.starts_with("Spite.") and not element.is_nullable
}

func checked_item(
    read: Value,
    path: String,
): Value {
    temporary_count = temporary_count + 1
    var name = context.scope.declare("item_{temporary_count}", read.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, read.value_type, read)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(read.value_type, name)
    var there = HighIntermediaryRepresentation.Values.PresenceTest(local)
    var missing = HighIntermediaryRepresentation.Values.Negation(there)
    var function = context.current_function
    var file_path = context.path()
    var message = "spite: '{path}' is past the end of its list, at {file_path}:{context.line} in {function.owner}.{function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = context.line
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements.append(stopped)
    var checked = HighIntermediaryRepresentation.Statements.If(missing, failed, null)
    checked.line = context.line
    context.pending.append(checked)
    var present_type = read.value_type.present()
    return HighIntermediaryRepresentation.Values.Conversion(present_type, 'proven', local)
}

func name_index_of(
    written: Expression?,
): Value? {
    var name = key_name_of(written)
    fallback name
    need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(name)
    made.value_type = context.text()
    return made
}

func binary_value_expecting(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    expected: Model.Type?,
): Value {
    if not is_a_decimal_constant(binary) {
        return binary_value(binary)
    }
    var computed = double_constant(binary)
    var wants_a_double = false
    if expected {
        wants_a_double = expected.name == "Double"
    }
    if wants_a_double {
        return computed
    }
    var float_type = context.scalar_type("Float")
    return HighIntermediaryRepresentation.Values.Conversion(float_type, 'narrow_decimal', computed)
}

func is_a_decimal_constant(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var arithmetic = is_decimal_arithmetic(binary.operator)
    return arithmetic and is_a_literal_tree(binary.left) and is_a_literal_tree(binary.right) and holds_a_decimal(binary)
}

func is_decimal_arithmetic(kind: AbstractSyntaxTree.Tokens.Token.Kind): Boolean {
    return kind == 'plus' or kind == 'minus' or kind == 'star' or kind == 'slash'
}

func is_a_literal_tree(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return is_a_decimal_constant(expression)
    }
    return is_a_number_literal(expression)
}

func holds_a_decimal(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'decimal_literal'
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return holds_a_decimal(expression.operand)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return holds_either_decimal(expression)
    }
    return false
}

func holds_either_decimal(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    return holds_a_decimal(binary.left) or holds_a_decimal(binary.right)
}

func double_constant(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value {
    var double_type = context.scalar_type("Double")
    var left = constant_operand(binary.left, double_type)
    var right = constant_operand(binary.right, double_type)
    var operator = operator_of(binary.operator)
    var made = HighIntermediaryRepresentation.Values.MachineOperation(double_type, operator, left, right)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    made.shown = printer.text()
    return made
}

func constant_operand(
    expression: Expression?,
    double_type: Model.Type,
): Value {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return double_constant(expression)
    }
    return value_of(expression, double_type)
}

func refuse_an_operator_on_a_shape(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
) {
    fallback left.value_type.kind == 'shape' and not left.value_type.is_nullable
    var shape = context.program.shape_keyed(left.value_type.name)
    crash shape
    var name = operator_function_name(operator)
    fallback not shape.member_named(name)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var symbol = printer.operator_text(binary.operator)
    typing.refuse_an_operator_on_a_shape(context, symbol, shape.name)
}

func comparison_through_a_maybe(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value? {
    var asks_equality = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback asks_equality
    var link = maybe_link_of(binary.left)
    if not link {
        link = maybe_link_of(binary.right)
    }
    fallback link
    crash binary.left
    crash binary.right
    var equal = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.left, 'equal_equal', binary.right)
    var guarded = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(link, 'and', equal)
    if binary.operator == 'equal_equal' {
        return value_of(guarded, null)
    }
    var negated = AbstractSyntaxTree.Shapes.Expressions.UnaryExpression('not', guarded)
    return value_of(negated, null)
}

func maybe_link_of(
    expression: Expression?,
): Expression? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return maybe_target_of(expression)
    }
    return null
}

func maybe_target_of(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Expression? {
    fallback not member.is_a_class_name and is_a_value_path(member.target)
    crash member.target
    var target_value = value_of(member.target, null)
    fallback target_value.value_type.is_nullable
    return member.target
}

func is_a_value_path(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var is_known = context.scope.internal_name_of(expression.name)
        var is_an_attribute = context.current_class.attribute_named(expression.name)
        return is_known or is_an_attribute
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return not expression.is_a_class_name and is_a_value_path(expression.target)
    }
    return false
}

func binary_value(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value {
    if binary.operator == 'and' or binary.operator == 'or' {
        return logic_value(binary)
    }
    var folded = codegen_test(binary)
    if folded {
        return folded
    }
    if is_a_class_test(binary) {
        return class_test_value(binary)
    }
    var linked = comparison_through_a_maybe(binary)
    if linked {
        return linked
    }
    var operands = operands_of(binary)
    var left = operands[0]
    var right = operands[1]
    crash left
    crash right
    var operator = operator_of(binary.operator)
    var asks_if_equal = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    if asks_if_equal and compares_a_maybe(left, right) {
        var equal_maybe = maybe_equal(left, right)
        if binary.operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(equal_maybe)
        }
        return equal_maybe
    }
    var compares_a_shape = left.value_type.kind == 'shape' and right.value_type.kind != 'shape'
    var asks_equality = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    if compares_a_shape and asks_equality {
        var same = shape_equal(left, right)
        if binary.operator == 'not_equal' {
            return HighIntermediaryRepresentation.Values.Negation(same)
        }
        return same
    }
    if is_a_maybe_operand(binary, left) {
        var symbol = operator_symbol_of(binary)
        note_a_maybe_null("operand", left, symbol, left.value_type)
        left = as_present(left)
    }
    if is_machine_comparable(left.value_type) {
        var fitted_right = fitted(right, left.value_type)
        refuse_a_cut(binary, fitted_right, left.value_type, right.value_type)
        refuse_a_division_by_zero(binary, operator, left, fitted_right)
        var decided = decided_comparison(binary, operator, left, fitted_right)
        if decided {
            return decided
        }
        var answer = answer_type_of(operator, left.value_type)
        var made = HighIntermediaryRepresentation.Values.MachineOperation(answer, operator, left, fitted_right)
        var printer = Printers.Spite.ExpressionPrinter(binary)
        made.shown = printer.text()
        var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
        made.shown_left = left_printer.text()
        var right_printer = Printers.Spite.ExpressionPrinter(binary.right)
        made.shown_right = right_printer.text()
        refuse_a_constant_overflow(made)
        return made
    }
    if is_the_number_shape(left.value_type) {
        return number_dispatch(binary, operator, left, right)
    }
    refuse_an_operator_on_a_shape(binary, operator, left)
    var answered = operator_call(operator, left, right)
    var printed = Printers.Spite.ExpressionPrinter(binary)
    var shown = printed.text()
    show_the_operation(answered, shown)
    return answered
}

func decided_comparison(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
): Value? {
    var asks_left = binary.left.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    var asks_right = binary.right.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback asks_left or asks_right
    if left.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return decided_with_a_left(operator, left, right)
    }
    return null
}

func decided_with_a_left(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: HighIntermediaryRepresentation.Values.WholeNumber,
    right: Value,
): Value? {
    if right.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return compared_numbers(operator, left.number, right.number)
    }
    return null
}

func compared_numbers(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left_number: Long,
    right_number: Long,
): Value? {
    switch operator {
        'equal': return boolean_constant(left_number == right_number)
        'not_equal': return boolean_constant(left_number != right_number)
        'less': return boolean_constant(left_number < right_number)
        'less_or_equal': return boolean_constant(left_number <= right_number)
        'greater': return boolean_constant(left_number > right_number)
        'greater_or_equal': return boolean_constant(left_number >= right_number)
        'add': return null
        'subtract': return null
        'multiply': return null
        'divide': return null
        'remainder': return null
        'and': return null
        'or': return null
    }
}

func show_the_operation(answered: Value, shown: String) {
    if answered.class == HighIntermediaryRepresentation.Values.ShapeCall {
        answered.shown = shown
    }
    if answered.class == HighIntermediaryRepresentation.Values.Negation {
        crash answered.negated
        show_the_operation(answered.negated, shown)
    }
}

func refuse_a_division_by_zero(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Value,
    right: Value,
) {
    fallback operator == 'divide' or operator == 'remainder'
    fallback not is_a_decimal_type(left.value_type)
    var folded = folded_whole(right)
    fallback folded
    refuse_a_zero(binary, folded)
}

func folded_whole(value: Value?): Long? {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number
    }
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return folded_operation(value)
    }
    return null
}

func folded_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Long? {
    var left = folded_whole(operation.left)
    var right = folded_whole(operation.right)
    fallback left
    fallback right
    switch operation.operator {
        'add': return left + right
        'subtract': return left - right
        'multiply': return left * right
        'divide': return null
        'remainder': return null
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func refuse_a_constant_overflow(made: HighIntermediaryRepresentation.Values.MachineOperation) {
    var is_an_integer = made.value_type.kind == 'scalar' and made.value_type.name == "Integer"
    fallback is_an_integer and not made.value_type.is_nullable
    var folded = folded_operation(made)
    fallback folded
    var smallest: Long = -2147483648
    var largest: Long = 2147483647
    fallback folded < smallest or folded > largest
    typing.refuse_a_constant_overflow(context, made.shown, folded)
}

func refuse_a_zero(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, number: Long) {
    fallback number == 0
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    typing.refuse_division_by_zero(context, shown)
}

func codegen_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Value? {
    var left = binary.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return codegen_test_of(binary, left)
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var codegen_path = codegen_path_of(left)
        if not codegen_path.is_empty() {
            return codegen_member_test(binary, codegen_path)
        }
        return bound_class_test(binary, left)
    }
    return null
}

func codegen_path_of(expression: Expression?): List<String> {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var started = List<String>()
        if expression.name.starts_with("$") {
            started.append(expression.name)
        }
        return started
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var path = codegen_path_of(expression.target)
        if not path.is_empty() {
            path.append(expression.name)
        }
        return path
    }
    return List<String>()
}

func codegen_member_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    codegen_path: List<String>,
): Value? {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares
    var first = codegen_path[0]
    crash first
    var found = context.current_class.bound_types[first]
    fallback found
    var bound: Model.Type = found
    var index = 1
    while index < codegen_path.count() {
        var member = codegen_path[index]
        bound = codegen_member_of(bound, member)
        index = index + 1
    }
    var path = class_path_of(binary.right)
    fallback not path.is_empty()
    var written = path.join(".")
    var answer = bound_is(bound, written)
    if binary.operator == 'not_equal' {
        answer = not answer
    }
    var number = 0
    if answer {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func codegen_member_of(bound: Model.Type, member: String): Model.Type {
    if member == "value_type" and bound.is_nullable {
        return bound.present()
    }
    var shown = context.shown(bound)
    var inner: Model.Type? = null
    if context.has_a_class(bound) and not bound.is_nullable {
        var model = context.class_of(bound)
        inner = model.bound_types["${member}"]
    }
    if not inner {
        var member_rule = Validators.NameResolution.TypeMember.Validator()
        var path = context.path()
        member_rule.refuse(
            path,
            context.line,
            context.current_class.shown,
            context.current_function.name,
            shown,
            member,
        )
    }
    crash inner
    return inner
}

func bound_class_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    var function = context.current_function
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares and left.name == "class" and function.bound_member_type
    var target = left.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == function.bound_parameter {
        return decided_class_test(binary, function.bound_member_type)
    }
    return null
}

func decided_class_test(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    bound: Model.Type,
): Value? {
    var path = tested_class_path_of(binary.right)
    fallback not path.is_empty()
    var written = path.join(".")
    var answer = bound_is(bound, written)
    if binary.operator == 'not_equal' {
        answer = not answer
    }
    var number = 0
    if answer {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func codegen_test_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    left: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Value? {
    fallback left.name.starts_with("$")
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares
    var bound = context.current_class.bound_types[left.name]
    fallback bound
    var path = class_path_of(binary.right)
    fallback not path.is_empty()
    var written = path.join(".")
    var answer = bound_is(bound, written)
    if binary.operator == 'not_equal' {
        answer = not answer
    }
    var number = 0
    if answer {
        number = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func bound_is(bound: Model.Type, written: String): Boolean {
    if written == "Null" {
        return bound.is_nullable
    } else if written == "Number" {
        return bound.kind == 'scalar' and bound.name != "Boolean" and not bound.is_nullable
    } else if written == "List" {
        return bound.name.starts_with("List_of_") and not bound.is_nullable
    } else if written == "Dictionary" {
        return bound.name.starts_with("Dictionary_of_") and not bound.is_nullable
    } else if written == "Enum" {
        return bound.kind == 'enumeration' and not bound.is_nullable
    } else if written == "Nothing" {
        return bound.kind == 'nothing'
    } else {
        return is_the_class(bound, written)
    }
}

func is_the_class(bound: Model.Type, written: String): Boolean {
    fallback not bound.is_nullable and not bound.is_a_walked_name
    var path = written.split(".")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    if described.kind == 'union' and bound.kind != 'union' {
        return is_a_member_of(bound, described)
    }
    if described.kind == 'shape' and bound.kind != 'shape' {
        return fits_the_shape(bound, described)
    }
    return described.name == bound.name and described.kind == bound.kind
}

func fits_the_shape(bound: Model.Type, described: Model.Type): Boolean {
    var shape = context.program.shape_keyed(described.name)
    crash shape
    fallback context.has_a_class(bound)
    var filler = context.class_of(bound)
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        var filling_function = filler.function_named(member.name)
        var filling_attribute = filler.attribute_named(member.name)
        var is_filled = filling_function and not member.is_an_attribute
        is_filled = is_filled or filling_attribute and member.is_an_attribute
        fallback is_filled
        index = index + 1
    }
    return true
}

func compares_a_maybe(
    left: Value,
    right: Value,
): Boolean {
    var left_type = left.value_type
    var right_type = right.value_type
    fallback left_type.kind != 'shape' and right_type.kind != 'shape'
    fallback left_type.kind != 'nothing' and right_type.kind != 'nothing'
    return left_type.is_nullable or right_type.is_nullable
}

func maybe_equal(
    left: Value,
    right: Value,
): Value {
    if not left.value_type.is_nullable {
        return maybe_equal(right, left)
    }
    var boolean = context.boolean()
    var held_left = held_once(left)
    var present_type = left.value_type.present()
    var present_left = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', held_left)
    var left_is_there = HighIntermediaryRepresentation.Values.PresenceTest(held_left)
    if not right.value_type.is_nullable {
        var fitted_right = fitted(right, present_type)
        var equal = present_equal(present_left, fitted_right)
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', left_is_there, equal)
    }
    var held_right = held_once(right)
    var right_present_type = right.value_type.present()
    var present_right = HighIntermediaryRepresentation.Values.Conversion(right_present_type, 'present', held_right)
    var right_is_there = HighIntermediaryRepresentation.Values.PresenceTest(held_right)
    var fitted_present_right = fitted(present_right, present_type)
    var both_equal = present_equal(present_left, fitted_present_right)
    var both_there = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'and',
        left_is_there,
        right_is_there,
    )
    var there_and_equal = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', both_there, both_equal)
    var left_missing = HighIntermediaryRepresentation.Values.Negation(left_is_there)
    var right_missing = HighIntermediaryRepresentation.Values.Negation(right_is_there)
    var both_missing = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'and',
        left_missing,
        right_missing,
    )
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', both_missing, there_and_equal)
}

func held_once(value: Value): Value {
    var is_a_plain_read = value.class == HighIntermediaryRepresentation.Values.LocalRead
    is_a_plain_read = is_a_plain_read or value.class == HighIntermediaryRepresentation.Values.AttributeRead
    if is_a_plain_read {
        return value
    }
    temporary_count = temporary_count + 1
    var name = context.scope.declare("compared_{temporary_count}", value.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value)
    declared.line = context.line
    context.pending.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(value.value_type, name)
}

func present_equal(
    left: Value,
    right: Value,
): Value {
    var boolean = context.boolean()
    if is_machine_comparable(left.value_type) or compares_identity(left) {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
    }
    var arguments = List<Value>()
    arguments.append(right)
    return method_call(left, "equals", arguments)
}

func shape_equal(
    left: Value,
    right: Value,
): Value {
    var boolean = context.boolean()
    var right_type = right.value_type.present()
    if right_type.kind == 'object' and right_type.name == "Spite.Class" {
        var reflection = Reflection(context, this)
        var class_of_left = reflection.class_of_value(left)
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', class_of_left, right)
    }
    if not is_held_in_a_box(right_type) {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right)
    }
    var tested = HighIntermediaryRepresentation.Values.Class.Membership(left, right_type)
    var unboxed = HighIntermediaryRepresentation.Values.Conversion(right_type, 'unbox', left)
    var equal = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', unboxed, right)
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', tested, equal)
}

func operands_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): List<Value> {
    var operands = List<Value>()
    if is_a_literal_tree(binary.left) and not is_a_literal_tree(binary.right) {
        var right_value = value_of(binary.right, null)
        var right_first = result_of_handle(right_value)
        var left_after = value_of(binary.left, right_first.value_type)
        operands.append(left_after)
        operands.append(right_first)
        return operands
    }
    var left_value = value_of(binary.left, null)
    var left = result_of_handle(left_value)
    var right_value = value_of(binary.right, left.value_type)
    var right = result_of_handle(right_value)
    operands.append(left)
    operands.append(right)
    return operands
}

func is_a_number_literal(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'integer_literal' or expression.kind == 'decimal_literal'
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return is_a_number_literal(expression.operand)
    }
    return false
}

func refuse_a_cut(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    fitted_right: Value,
    left_type: Model.Type,
    right_type: Model.Type,
) {
    fallback left_type.name != "Float" or not is_a_literal_tree(binary.right)
    if fitted_right.class == HighIntermediaryRepresentation.Values.Conversion {
        refuse_a_cut_conversion(binary, fitted_right, left_type, right_type)
    }
}

func refuse_a_cut_conversion(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    left_type: Model.Type,
    right_type: Model.Type,
) {
    var cuts = conversion.kind == 'narrow' or conversion.kind == 'narrow_decimal' or conversion.kind == 'to_whole'
    fallback cuts
    fallback not changes_only_its_sign(left_type, right_type)
    var printer = Printers.Spite.ExpressionPrinter(binary)
    var shown = printer.text()
    var function = context.current_function
    if not function.number_copy_of.is_empty() {
        var left_article = article_for(left_type.name)
        var right_article = article_for(right_type.name)
        var path = context.path()
        var message = "spite: '{shown}' works in {left_article} {left_type.name}, the class of its left side, and its right side is {right_article} {right_type.name}, which would be cut to fit, at {path}:{context.line} in {function.owner}.{function.number_copy_of}"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = context.line
        context.pending.append(stopped)
        return
    }
    crash binary.left
    crash binary.right
    var left_printer = Printers.Spite.ExpressionPrinter(binary.left)
    var left_text = left_printer.text()
    var turned_operator = turned_around(binary.operator)
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.right, turned_operator, binary.left)
    var turned_printer = Printers.Spite.ExpressionPrinter(turned)
    var turned_text = turned_printer.text()
    if is_a_comparison(binary.operator) {
        typing.refuse_cut_comparison(context, shown, left_type.name, right_type.name, turned_text)
    }
    var operation = operation_name_of(binary.operator)
    var order_free = binary.operator == 'plus' or binary.operator == 'star'
    typing.refuse_cut_operand(
        context,
        shown,
        operation,
        left_type.name,
        right_type.name,
        left_text,
        turned_text,
        order_free,
    )
}

func is_a_maybe_operand(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operand: Value,
): Boolean {
    var operand_type = operand.value_type
    var asks_if_equal = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    var reads_an_index = binary.left.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    return operand_type.is_nullable and operand_type.kind == 'scalar' and not asks_if_equal and not reads_an_index
}

func operator_symbol_of(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var printer = Printers.Spite.ExpressionPrinter(binary)
    return printer.operator_text(binary.operator)
}

func changes_only_its_sign(left_type: Model.Type, right_type: Model.Type): Boolean {
    fallback are_whole_numbers(left_type, right_type)
    var left_scalar = scalars.of(left_type.name)
    var right_scalar = scalars.of(right_type.name)
    crash left_scalar
    crash right_scalar
    return left_scalar.size == right_scalar.size
}


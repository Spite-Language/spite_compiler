# ../../PROOFS.md#what-the-builder-records-for-the-proofs
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var entered_key = ""

func FunctionEntry(starting_context: Context) {
    context = starting_context
}

func enter(owner: Model.ClassModel, function: Model.FunctionModel, line: Integer) {
    context.line = line
    var key = "{owner.key}.{function.key()}"
    assert key != entered_key
    leave()
    entered_key = key
    context.current_class = owner
    context.current_function = function
    context.resolver.building_function_name = function.name
    bind_its_member(function)
}

func bind_its_member(function: Model.FunctionModel) {
    assert function.bound_member_type and function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var member_type: Model.Type = function.bound_member_type
    context.resolver.bind_member(declaration, function.template_index, member_type)
}

func leave() {
    assert not entered_key.is_empty()
    entered_key = ""
    context.resolver.unbind_member()
}

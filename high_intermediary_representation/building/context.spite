func Context(starting_program: Model.ProgramModel, starting_resolver: NameResolution.Resolver) {
    program = starting_program
    resolver = starting_resolver
}

# ../../PROOFS.md#unused-is-an-error
func note_a_folded_branch() {
    var folded = current_function.key()
    if not folded_functions.contains(folded) {
        folded_functions.append(folded)
    }
}

# ../../PROOFS.md#what-the-builder-records-for-the-proofs
func note_a_site(kind: String, index: Integer) {
    var recorded = RecordedSite(kind, index)
    recorded_sites.append(recorded)
}

func note_a_statement_site(site: StatementSite) {
    statement_sites.append(site)
    var index = statement_sites.count() - 1
    note_a_site("statement", index)
}

func note_a_presence_site(site: PresenceSite) {
    presence_sites.append(site)
    var index = presence_sites.count() - 1
    note_a_site("presence", index)
}

func note_a_check_site(site: CheckSite) {
    check_sites.append(site)
    var index = check_sites.count() - 1
    note_a_site("check", index)
}

func note_a_loop_site(site: CheckSite) {
    site.loop_depth = loop_bases.count()
    site.logged_at = logged_calls.count()
    loop_sites.append(site)
    var index = loop_sites.count() - 1
    note_a_site("loop", index)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func note_the_loop_writes_left_behind(log_start: Integer) {
    var depth = loop_bases.count()
    var index = loop_sites.count() - 1
    while index >= first_loop_site {
        var site = loop_sites[index]
        crash site
        fallback site.logged_at >= log_start
        if site.loop_depth == depth {
            site.is_still_narrowed = true
        }
        index = index - 1
    }
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func innermost_loop_start(): Integer {
    var start = loop_log_starts.last()
    if start {
        return start
    }
    return 0
}

func note_a_guard_site(site: GuardSite) {
    guard_sites.append(site)
    var index = guard_sites.count() - 1
    note_a_site("guard", index)
}

func note_a_literal_site(site: LiteralSite) {
    literal_sites.append(site)
    var index = literal_sites.count() - 1
    note_a_site("literal", index)
}

# ../../PROOFS.md#what-the-builder-records-for-the-proofs
func judge_what_is_recorded() {
    fallback not site_judges.is_empty()
    var judges = site_judges
    site_judges = List<SpiteCompiler.SiteJudge>()
    var owner = current_class
    var function = current_function
    var at = line
    var statements = block_statements
    var index = block_index
    var judge = judges[0]
    crash judge
    judge.judge_what_is_recorded(this)
    current_class = owner
    current_function = function
    line = at
    block_statements = statements
    block_index = index
}

# ../../../spite_spec/specs/programs.md#build-settings-build
func build_value_given(name: String): String? {
    fallback not environment.is_output(name)
    return build_flags[name]
}

func need(function: Model.FunctionModel) {
    var key = function.key()
    fallback not queued.contains(key)
    queued.append(key)
    waiting.append(function)
}

func class_of(of_type: Model.Type): Model.ClassModel {
    var found = program.class_named(of_type.name)
    crash found
    return found
}

func has_a_class(of_type: Model.Type): Boolean {
    var is_a_class = of_type.kind == 'object' or of_type.kind == 'scalar'
    return is_a_class and program.has(of_type.name)
}

func shown(of_type: Model.Type): String {
    var name = of_type.name
    if not of_type.written_name.is_empty() {
        name = of_type.written_name
    }
    if has_a_class(of_type) {
        var model = class_of(of_type)
        name = model.shown
    }
    if of_type.kind == 'nothing' {
        name = "nothing"
    }
    if of_type.kind == 'function' {
        name = function_shown(of_type)
    }
    if of_type.is_nullable {
        return "{name}?"
    }
    return name
}

func function_shown(of_type: Model.Type): String {
    var pieces = List<String>()
    var index = 0
    while index < of_type.parameters.count() {
        var parameter = of_type.parameters[index]
        var piece = shown(parameter)
        pieces.append(piece)
        index = index + 1
    }
    if of_type.answer {
        var answer_piece = shown(of_type.answer)
        pieces.append(answer_piece)
    } else {
        pieces.append("Nothing")
    }
    var joined = pieces.join(", ")
    return "Spite.Function<{joined}>"
}

func path(): String {
    if current_function.declaration {
        return path_of(current_function.declaration)
    }
    return current_class.file.path
}

func path_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    if declaration.path.is_empty() {
        return current_class.file.path
    }
    return declaration.path
}

func scalar_type(name: String): Model.Type {
    return Model.Type('scalar', name)
}

func boolean(): Model.Type {
    return Model.Type('scalar', "Boolean")
}

func text(): Model.Type {
    return Model.Type('object', "String")
}

func is_boolean(of_type: Model.Type): Boolean {
    fallback not of_type.is_nullable
    return is_a_truth_value(of_type)
}

# ../../../spite_spec/specs/values_and_types.md#a-number-states-its-range
func is_a_truth_value(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar'
    var scalar = scalars.of(of_type.name)
    fallback scalar
    return not scalar.is_a_number
}

func is_a_number(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar' and not of_type.is_nullable
    var scalar = scalars.of(of_type.name)
    fallback scalar
    return scalar.is_a_number
}

func need_defaults(class_key: String) {
    fallback not made_classes.contains(class_key)
    made_classes.append(class_key)
    var model = program.class_named(class_key)
    fallback model
    var dropping = model.function_named("drop")
    fallback dropping
    need(dropping)
}

# ../../../spite_spec/specs/repl.md#command-language
func note_a_singleton_made(class_key: String, arguments: List<SpiteCompiler.Value>) {
    var written = List<String>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var literal = literal_text_of(argument)
        fallback not literal.is_empty()
        written.append(literal)
        index = index + 1
    }
    var joined = written.join(", ")
    var known = singleton_arguments[class_key]
    if not known {
        var started = List<String>()
        started.append(joined)
        singleton_arguments[class_key] = started
        return
    }
    if not known.contains(joined) {
        known.append(joined)
    }
}

func literal_text_of(value: SpiteCompiler.Value): String {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number.to_string()
    }
    if value.class == HighIntermediaryRepresentation.Values.DecimalNumber {
        return value.written
    }
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text.to_debug()
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        return literal_text_of(value.converted)
    }
    return ""
}

# ../../../spite_spec/specs/values_and_types.md#named-numbers
func written_privates_of(class_key: String): List<String> {
    var known = written_privates[class_key]
    if known {
        return known
    }
    var found = List<String>()
    var model = program.class_named(class_key)
    crash model
    var walk = AbstractSyntaxTree.Walk.Walk(model.file)
    var index = 0
    while index < walk.statements.count() {
        var found_statement = walk.statements[index]
        var statement = found_statement.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
            var name = assigned_private(statement.target)
            if not name.is_empty() {
                found.append(name)
            }
        }
        index = index + 1
    }
    written_privates[class_key] = found
    return found
}

func assigned_private(target: SpiteCompiler.Expression?): String {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return target.name
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return target.name
    }
    return ""
}

var program = Model.ProgramModel()
var no_symbols = Mapping.FolderMap()
var empty_table = Symbols.SymbolTable(no_symbols)
var resolver = NameResolution.Resolver(empty_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var current_class = Model.ClassModel("", "", no_file)
var current_function = Model.FunctionModel("", "")
var scope = Scope()
var pending = List<HighIntermediaryRepresentation.Statements.Statement>()
var waiting = List<Model.FunctionModel>()
var queued = List<String>()
var line = 0
var made_classes = List<String>()
var synthetic_functions = List<HighIntermediaryRepresentation.HighFunction>()
var reflected = List<String>()
var object_count = 0
var proven_locals = List<String>()
var build_flags = Dictionary<String, String>()
var counted_lists = Dictionary<String, AbstractSyntaxTree.Shapes.Expressions.Expression>()

func Context(starting_program: Model.ProgramModel, starting_resolver: NameResolution.Resolver) {
    program = starting_program
    resolver = starting_resolver
}

func need(function: Model.FunctionModel) {
    var key = function.key()
    assert not queued.contains(key)
    queued.append(key)
    waiting.append(function)
}

func class_of(of_type: Model.Type): Model.ClassModel {
    var found = program.class_named(of_type.name)
    crash found
    return found
}

func has_a_class(of_type: Model.Type): Boolean {
    var is_a_class = of_type.kind == 'object' or of_type.kind == 'scalar'
    return is_a_class and program.has(of_type.name)
}

func shown(of_type: Model.Type): String {
    var name = of_type.name
    if has_a_class(of_type) {
        var model = class_of(of_type)
        name = model.shown
    }
    if of_type.kind == 'nothing' {
        name = "nothing"
    }
    if of_type.is_nullable {
        return "{name}?"
    }
    return name
}

func path(): String {
    return current_class.file.path
}

func scalar_type(name: String): Model.Type {
    return Model.Type('scalar', name)
}

func boolean(): Model.Type {
    return Model.Type('scalar', "Boolean")
}

func text(): Model.Type {
    return Model.Type('object', "String")
}

func is_boolean(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' and of_type.name == "Boolean" and not of_type.is_nullable
}

func is_a_number(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' and of_type.name != "Boolean" and not of_type.is_nullable
}

func need_defaults(class_key: String) {
    assert not made_classes.contains(class_key)
    made_classes.append(class_key)
    var model = program.class_named(class_key)
    assert model
    var dropping = model.function_named("drop")
    assert dropping
    need(dropping)
}

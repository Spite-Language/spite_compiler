var program = Model.ProgramModel()
var no_symbols = Mapping.FolderMap()
var empty_table = Symbols.SymbolTable(no_symbols)
var resolver = NameResolution.Resolver(empty_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var current_class = Model.ClassModel("", "", no_file)
var current_function = Model.FunctionModel("", "")
var scope = Scope()
var pending = List<HighIntermediaryRepresentation.Statements.Statement>()
var waiting = List<Model.FunctionModel>()
var queued = List<String>()
var line = 0
var made_classes = List<String>()
var synthetic_functions = List<HighIntermediaryRepresentation.HighFunction>()
var reflected = List<String>()
var object_count = 0
var shape_links = List<String>()
var number_dispatches = List<HighIntermediaryRepresentation.Values.Call>()
var makes_work = false
var site_ordinals = Dictionary<String, Integer>()
var proven_locals = List<String>()
var index_locals = List<String>()
var loop_bases = List<Integer>()
var loop_reads = List<String>()
var block_statements = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
var block_index = 0
var build_flags = Dictionary<String, String>()
var counted_lists = Dictionary<String, AbstractSyntaxTree.Shapes.Expressions.Expression>()
var unfilled = List<String>()
var filled = List<String>()
var filled_counts = List<Integer>()
var fills = List<HighIntermediaryRepresentation.HighFunction>()
var fill_features = ""
var facts_asked = List<HighIntermediaryRepresentation.Values.FunctionFact>()
var shape_classes = List<HighIntermediaryRepresentation.Values.ClassOfValue>()
var known_function_copies = Dictionary<String, Model.FunctionModel>()
var described_parameters = Dictionary<String, List<String>>()
var function_locals = Dictionary<String, Model.FunctionModel>()
var null_locals = List<String>()
var text_locals = Dictionary<String, String>()
var known_declarations = Dictionary<String, Model.FunctionModel>()
var known_calls = Dictionary<String, Model.FunctionModel>()
var known_call_instances = Dictionary<String, String>()
var known_call_types = Dictionary<String, Model.Type>()
var known_call_arguments = Dictionary<String, String>()
var folded_dictionaries = Dictionary<String, AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral>()
var symbol_table = Model.EnumModel("Spite.SymbolTable", "Symbol")

func Context(starting_program: Model.ProgramModel, starting_resolver: NameResolution.Resolver) {
    program = starting_program
    resolver = starting_resolver
}

func need(function: Model.FunctionModel) {
    var key = function.key()
    assert not queued.contains(key)
    queued.append(key)
    waiting.append(function)
}

func class_of(of_type: Model.Type): Model.ClassModel {
    var found = program.class_named(of_type.name)
    crash found
    return found
}

func has_a_class(of_type: Model.Type): Boolean {
    var is_a_class = of_type.kind == 'object' or of_type.kind == 'scalar'
    return is_a_class and program.has(of_type.name)
}

func shown(of_type: Model.Type): String {
    var name = of_type.name
    if has_a_class(of_type) {
        var model = class_of(of_type)
        name = model.shown
    }
    if of_type.kind == 'nothing' {
        name = "nothing"
    }
    if of_type.kind == 'function' {
        name = function_shown(of_type)
    }
    if of_type.is_nullable {
        return "{name}?"
    }
    return name
}

func function_shown(of_type: Model.Type): String {
    var pieces = List<String>()
    var index = 0
    while index < of_type.parameters.count() {
        var parameter = of_type.parameters[index]
        var piece = shown(parameter)
        pieces.append(piece)
        index = index + 1
    }
    if of_type.answer {
        var answer_piece = shown(of_type.answer)
        pieces.append(answer_piece)
    } else {
        pieces.append("Nothing")
    }
    var joined = pieces.join(", ")
    return "Spite.Function<{joined}>"
}

func path(): String {
    if current_function.declaration {
        return path_of(current_function.declaration)
    }
    return current_class.file.path
}

func path_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    if declaration.path.is_empty() {
        return current_class.file.path
    }
    return declaration.path
}

func scalar_type(name: String): Model.Type {
    return Model.Type('scalar', name)
}

func boolean(): Model.Type {
    return Model.Type('scalar', "Boolean")
}

func text(): Model.Type {
    return Model.Type('object', "String")
}

func is_boolean(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' and of_type.name == "Boolean" and not of_type.is_nullable
}

func is_a_number(of_type: Model.Type): Boolean {
    return of_type.kind == 'scalar' and of_type.name != "Boolean" and not of_type.is_nullable
}

func need_defaults(class_key: String) {
    assert not made_classes.contains(class_key)
    made_classes.append(class_key)
    var model = program.class_named(class_key)
    assert model
    var dropping = model.function_named("drop")
    assert dropping
    need(dropping)
}

func note_a_symbol(name: String) {
    assert not symbol_table.values.contains(name)
    symbol_table.values.append(name)
    var number = symbol_table.numbers.count()
    symbol_table.numbers.append(number)
}

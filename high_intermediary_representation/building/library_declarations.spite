var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var rule = Validators.HighIntermediaryRepresentation.Foreign.Validator()

func LibraryDeclarations(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/foreign_libraries.md#declaring-a-foreign-function
func made_from(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    written: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Statement? {
    var named = written.arguments[0]
    crash named
    fallback named.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    var listed = named.target
    fallback listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback listed.name == "functions"
    crash listed.target
    var key = values.known_key_name_of(named.index)
    fallback key
    var line = context.line
    var library = values.value_of(listed.target, null)
    context.line = line
    fallback library.value_type.name == "DynamicLibrary"
    var made = library_made_for(library, listed.target)
    var entry = entry_named(made, key)
    var printer = Printers.Spite.ExpressionPrinter(listed.target)
    var holder_text = printer.text()
    var found_answer = rule.check_a_declared_function(context, entry, key, holder_text)
    context.tell(found_answer)
    fallback entry
    var declared = declared_function(key, entry)
    fallback declared
    var symbol = symbol_of(entry)
    var hidden = context.scope.declare("{statement.name}_library", library.value_type)
    context.known_calls[statement.name] = declared
    context.known_call_instances[statement.name] = hidden
    context.known_call_types[statement.name] = library.value_type
    context.known_foreign_symbols[statement.name] = symbol
    context.known_foreign_holders[statement.name] = listed.target
    return HighIntermediaryRepresentation.Statements.Declare(hidden, library.value_type, library, statement.line, "")
}

func library_made_for(
    library: SpiteCompiler.Value,
    holder: SpiteCompiler.Expression,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if library.class == HighIntermediaryRepresentation.Values.AttributeRead {
        fallback library.attribute.declaration
        return library_made_by(library.attribute.declaration.value)
    }
    fallback holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback context.current_function.declaration
    fallback context.current_function.declaration.body
    var index = 0
    while index < context.current_function.declaration.body.statements.count() {
        var statement = context.current_function.declaration.body.statements[index]
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == holder.name {
            return library_made_by(statement.value)
        }
        index = index + 1
    }
    return null
}

func library_made_by(written: SpiteCompiler.Expression?): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    fallback written
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    return written
}

func entry_named(
    made: AbstractSyntaxTree.Shapes.Expressions.CallExpression?,
    key: String,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    fallback made
    var index = 0
    while index < made.arguments.count() {
        var argument = made.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
            return entry_in(argument, key)
        }
        index = index + 1
    }
    return null
}

func entry_in(
    listed: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    key: String,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    var index = 0
    while index < listed.pairs.count() {
        var pair = listed.pairs[index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var written_key = values.key_name_of(pair.key)
            if written_key == key {
                return declaration_made_by(pair.value)
            }
        }
        index = index + 1
    }
    return null
}

func declaration_made_by(written: SpiteCompiler.Expression?): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    fallback written
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    var path = values.class_path_of(written.callee)
    var joined = path.join(".")
    fallback joined == "DynamicLibrary.FunctionDeclaration" and written.arguments.count() == 3
    return written
}

func symbol_of(entry: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var symbol = values.key_name_of(entry.arguments[0])
    if symbol {
        return symbol
    }
    return ""
}

func declared_function(key: String, entry: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.FunctionModel? {
    var answer_written = entry.arguments[2]
    var answer = type_written_as(answer_written)
    fallback answer
    var declared = Model.FunctionModel(
        key,
        "DynamicLibrary",
        answer,
        null,
        null,
        null,
        null,
        null,
        true,
        true,
        false,
        false,
    )
    var listed = entry.arguments[1]
    fallback listed
    fallback listed.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    var index = 0
    while index < listed.entries.count() {
        var argument = listed.entries[index]
        var parameter = parameter_written_as(argument)
        fallback parameter
        declared.parameters.append(parameter)
        index = index + 1
    }
    return declared
}

func parameter_written_as(written: SpiteCompiler.Expression?): Model.ParameterModel? {
    fallback written
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback written.arguments.count() == 2
    var name = values.key_name_of(written.arguments[0])
    fallback name
    var parameter_type = type_written_as(written.arguments[1])
    fallback parameter_type
    return Model.ParameterModel(name, parameter_type, false)
}

func type_written_as(written: SpiteCompiler.Expression?): Model.Type? {
    fallback written
    var path = values.class_path_of(written)
    fallback not path.is_empty()
    var arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        arguments = written.generic_arguments
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        arguments = written.generic_arguments
    }
    var named = AbstractSyntaxTree.Shapes.Types.NamedType(path, arguments)
    return context.resolver.types.type_in(named, context.current_class, context.line)
}

func ran_named(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, call_name: String): SpiteCompiler.Value? {
    var symbol = context.known_foreign_symbols[call_name]
    fallback symbol
    var declared = context.known_calls[call_name]
    crash declared
    var holder = context.known_foreign_holders[call_name]
    crash holder
    var known_call = Validators.HighIntermediaryRepresentation.KnownCall.Validator()
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var key = "{call_name}.{parameter.name}"
        var filled = context.known_call_arguments[key]
        var filled_answer = known_call.check_a_filled_argument(
            context,
            filled,
            call_name,
            parameter.name,
            declared.name,
        )
        context.tell(filled_answer)
        crash filled
        var value = context.known_foreign_fills[key]
        crash value
        arguments.append(value)
        index = index + 1
    }
    var line = context.line
    var library = values.value_of(holder, null)
    context.line = line
    var collections = Collections(context, values)
    return collections.declared_foreign_call(library, symbol, arguments, declared.answer, call)
}

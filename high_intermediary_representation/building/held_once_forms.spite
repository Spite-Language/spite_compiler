union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../OPTIMIZATIONS.md#text-appended-to-itself-grows-in-place
# ../../OPTIMIZATIONS.md#a-list-of-lists-cleared-and-filled-with-new-lists-keeps-their-room
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func HeldOnceForms(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func is_a_list(model: Model.ClassModel): Boolean {
    var reader = model.function_named("_read_value")
    fallback reader
    var shrinker = model.function_named("_shrink_to")
    fallback shrinker
    var length = model.attribute_named("_length")
    fallback length
    var element = model.bound_types["$element_type"]
    fallback element
    return true
}

func intrinsic(owner: Model.ClassModel, name: String, answer: Model.Type): Model.FunctionModel {
    var known = owner.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, owner.key)
    made.answer = answer
    owner.declared_functions.append(made)
    return made
}

func needed(owner: Model.ClassModel, name: String): Model.FunctionModel {
    var function = owner.function_named(name)
    crash function
    values.need(function)
    return function
}

func ready_to_grow_of(text: Model.ClassModel): Model.FunctionModel {
    var name = "_ready_to_grow"
    var known = text.function_named(name)
    if known {
        values.need(known)
        return known
    }
    var own_type = text.type_of_an_instance()
    var integer = context.scalar_type("Integer")
    var boolean = context.boolean()
    var made = Model.FunctionModel(name, text.key)
    made.is_synthetic = true
    made.answer = own_type
    text.declared_functions.append(made)
    var asking = intrinsic(text, "_is_held_once", boolean)
    var appending = needed(text, "_append_text")
    var room = text.attribute_named("_buffer")
    crash room
    var length = text.attribute_named("_length")
    crash length
    var room_model = context.class_of(room.attribute_type)
    var reserving = needed(room_model, "_reserve")
    var body = HighIntermediaryRepresentation.Statements.Block()
    var no_values = List<Value>()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var held = HighIntermediaryRepresentation.Values.Call(asking, own, no_values)
    var kept = HighIntermediaryRepresentation.Statements.Block()
    var same = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var answered_same = HighIntermediaryRepresentation.Statements.Return(same)
    kept.statements.append(answered_same)
    var keeping = HighIntermediaryRepresentation.Statements.If(held, kept, null)
    body.statements.append(keeping)
    var making = values.made_list(own_type)
    var grown_declared = HighIntermediaryRepresentation.Statements.Declare("grown", own_type, making)
    body.statements.append(grown_declared)
    var grown = HighIntermediaryRepresentation.Values.LocalRead(own_type, "grown")
    var grown_room = HighIntermediaryRepresentation.Values.AttributeRead(grown, room)
    var counted = HighIntermediaryRepresentation.Values.AttributeRead(own, length)
    var two = HighIntermediaryRepresentation.Values.WholeNumber(integer, 2)
    var doubled = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'multiply', counted, two)
    var wanted = List<Value>()
    wanted.append(doubled)
    var reserved = HighIntermediaryRepresentation.Values.Call(reserving, grown_room, wanted)
    var reserving_room = HighIntermediaryRepresentation.Statements.Evaluate(reserved)
    body.statements.append(reserving_room)
    var copied_from = List<Value>()
    var this_text = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    copied_from.append(this_text)
    var receiving = HighIntermediaryRepresentation.Values.LocalRead(own_type, "grown")
    var copied = HighIntermediaryRepresentation.Values.Call(appending, receiving, copied_from)
    var copying = HighIntermediaryRepresentation.Statements.Evaluate(copied)
    body.statements.append(copying)
    var answered = HighIntermediaryRepresentation.Values.LocalRead(own_type, "grown")
    var answering = HighIntermediaryRepresentation.Statements.Return(answered)
    body.statements.append(answering)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func renew_lists_of(listing: Model.ClassModel): Model.FunctionModel {
    var name = "_renew_lists"
    var known = listing.function_named(name)
    if known {
        return known
    }
    var element_type = listing.bound_types["$element_type"]
    crash element_type
    var item_model = context.class_of(element_type)
    var integer = context.scalar_type("Integer")
    var boolean = context.boolean()
    var made = Model.FunctionModel(name, listing.key)
    made.is_synthetic = true
    var wanted_parameter = Model.ParameterModel("wanted", integer, false)
    made.parameters.append(wanted_parameter)
    listing.declared_functions.append(made)
    var asking = intrinsic(listing, "_item_held_once", boolean)
    var reader = needed(listing, "_read_value")
    var writer = needed(listing, "_write_value")
    var shrinker = needed(listing, "_shrink_to")
    var appending = needed(listing, "append")
    var clearing = needed(item_model, "clear")
    var length = listing.attribute_named("_length")
    crash length
    var own_type = listing.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var start = HighIntermediaryRepresentation.Values.WholeNumber(integer, 0)
    var index_declared = HighIntermediaryRepresentation.Statements.Declare("index", integer, start)
    body.statements.append(index_declared)
    var index = HighIntermediaryRepresentation.Values.LocalRead(integer, "index")
    var wanted = HighIntermediaryRepresentation.Values.LocalRead(integer, "wanted")
    var held_count = HighIntermediaryRepresentation.Values.AttributeRead(own, length)
    var inside = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'less', index, held_count)
    var short_of = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'less', index, wanted)
    var reusing = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', inside, short_of)
    var reuse_body = HighIntermediaryRepresentation.Statements.Block()
    var asked_at = List<Value>()
    asked_at.append(index)
    var held = HighIntermediaryRepresentation.Values.Call(asking, own, asked_at)
    var positions = List<Value>()
    positions.append(index)
    var kept_block = HighIntermediaryRepresentation.Statements.Block()
    var item = HighIntermediaryRepresentation.Values.Call(reader, own, positions)
    var kept_declared = HighIntermediaryRepresentation.Statements.Declare("kept", element_type, item)
    kept_block.statements.append(kept_declared)
    var kept = HighIntermediaryRepresentation.Values.LocalRead(element_type, "kept")
    var no_values = List<Value>()
    var cleared = HighIntermediaryRepresentation.Values.Call(clearing, kept, no_values)
    var clearing_kept = HighIntermediaryRepresentation.Statements.Evaluate(cleared)
    kept_block.statements.append(clearing_kept)
    var fresh_block = HighIntermediaryRepresentation.Statements.Block()
    var fresh = values.made_list(element_type)
    var fresh_declared = HighIntermediaryRepresentation.Statements.Declare("fresh", element_type, fresh)
    fresh_block.statements.append(fresh_declared)
    var fresh_read = HighIntermediaryRepresentation.Values.LocalRead(element_type, "fresh")
    var written = List<Value>()
    written.append(index)
    written.append(fresh_read)
    var writing = HighIntermediaryRepresentation.Values.Call(writer, own, written)
    var writing_fresh = HighIntermediaryRepresentation.Statements.Evaluate(writing)
    fresh_block.statements.append(writing_fresh)
    var choosing = HighIntermediaryRepresentation.Statements.If(held, kept_block, fresh_block)
    reuse_body.statements.append(choosing)
    step(reuse_body, index, integer)
    var reuse_loop = HighIntermediaryRepresentation.Statements.While(reusing, reuse_body)
    body.statements.append(reuse_loop)
    var shrunk_to = List<Value>()
    shrunk_to.append(index)
    var shrinking = HighIntermediaryRepresentation.Values.Call(shrinker, own, shrunk_to)
    var shrinking_rest = HighIntermediaryRepresentation.Statements.Evaluate(shrinking)
    body.statements.append(shrinking_rest)
    var adding = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'less', index, wanted)
    var add_body = HighIntermediaryRepresentation.Statements.Block()
    var making = values.made_list(element_type)
    var made_declared = HighIntermediaryRepresentation.Statements.Declare("made", element_type, making)
    add_body.statements.append(made_declared)
    var made_read = HighIntermediaryRepresentation.Values.LocalRead(element_type, "made")
    var appended_values = List<Value>()
    appended_values.append(made_read)
    var appended = HighIntermediaryRepresentation.Values.Call(appending, own, appended_values)
    var appending_made = HighIntermediaryRepresentation.Statements.Evaluate(appended)
    add_body.statements.append(appending_made)
    step(add_body, index, integer)
    var add_loop = HighIntermediaryRepresentation.Statements.While(adding, add_body)
    body.statements.append(add_loop)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func step(block: HighIntermediaryRepresentation.Statements.Block, index: Value, integer: Model.Type) {
    var one = HighIntermediaryRepresentation.Values.WholeNumber(integer, 1)
    var stepped = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'add', index, one)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign("index", stepped)
    block.statements.append(assigned)
}

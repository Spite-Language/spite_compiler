var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var renamed_types = Dictionary<String, String>()
var header_text = ""

func ForeignConstants(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func constant_of(target: SpiteCompiler.Value, name: String): SpiteCompiler.Value {
    var literals = Literals(values.context, values)
    var rule = Validators.HighIntermediaryRepresentation.HeaderConstant.Validator()
    var header = header_of(target)
    var rule_answer = rule.check_a_header(context, name, header)
    context.tell(rule_answer)
    var header_path: Path? = header
    crash header_path
    var file = File(header_path)
    var exists = file.exists()
    var finding = CommandLine.Attempt(header, exists)
    rule_answer = rule.check_a_found_header(context, name, finding)
    context.tell(rule_answer)
    var text = file.read_as_string()
    rule_answer = rule.check_a_read_header(context, name, header, text)
    context.tell(rule_answer)
    crash text
    var lines = text.split("\n")
    var found = ""
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var defined = defined_value(line, name)
        if not defined.is_empty() {
            found = defined
        }
        index = index + 1
    }
    rule_answer = rule.check_a_definition(context, name, header, found)
    context.tell(rule_answer)
    var number_text = plain_number_of(found)
    var number: Long? = number_text
    rule_answer = rule.check_a_number(context, name, header, found, number)
    context.tell(rule_answer)
    return literals.whole_number_value(number_text, null)
}

func declared_parameters(target: SpiteCompiler.Value, c_name: String): List<String> {
    var inside = prototype_of(target, c_name)
    fallback not inside.is_empty()
    return scalars_of_parameters(inside)
}

func struct_parameters(target: SpiteCompiler.Value, c_name: String): HeaderStructs {
    var structs = HeaderStructs(this)
    var inside = prototype_of(target, c_name)
    if not inside.is_empty() {
        structs.read(header_text)
        structs.name_the_parameters(inside)
    }
    return structs
}

func prototype_of(target: SpiteCompiler.Value, c_name: String): String {
    header_text = ""
    var header = header_of(target)
    var header_path: Path? = header
    fallback header_path
    var file = File(header_path)
    fallback file.exists()
    var text = file.read_as_string()
    crash text
    header_text = text
    var statements = statements_of(text)
    note_the_renamed_types(statements)
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        var inside = parameters_of_a_prototype(statement, c_name)
        if not inside.is_empty() {
            return inside
        }
        index = index + 1
    }
    return ""
}

func declared_answer(
    target: SpiteCompiler.Value,
    c_name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HeaderAnswer {
    var header = header_of(target)
    var declares_void = false
    if not call.answer_is_dropped {
        declares_void = answers_nothing(target, c_name)
    }
    return HeaderAnswer(c_name, header, declares_void)
}

func answers_nothing(target: SpiteCompiler.Value, c_name: String): Boolean {
    var header = header_of(target)
    var header_path: Path? = header
    fallback header_path
    var file = File(header_path)
    fallback file.exists()
    var text = file.read_as_string()
    crash text
    var statements = statements_of(text)
    note_the_renamed_types(statements)
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        if answers_void(statement, c_name) {
            return true
        }
        index = index + 1
    }
    return false
}

func answers_void(statement: String, c_name: String): Boolean {
    var spaced = " {statement}".replace("*", " * ").replace("(", " (")
    var opening = spaced.index_of(" {c_name} (")
    fallback opening
    var before = spaced.slice(0, opening)
    crash before
    var words = words_of(before)
    var answer = answer_word_of(words)
    return is_void(answer, 0)
}

func answer_word_of(words: List<String>): String {
    while not words.is_empty() {
        var word = words.remove_last()
        crash word
        if not is_a_calling_convention(word) {
            return word
        }
    }
    return ""
}

func is_a_calling_convention(word: String): Boolean {
    fallback not renamed_types.contains(word) and word != "*"
    return word.starts_with("__") or word == word.upper_case()
}

func is_void(c_type: String, depth: Integer): Boolean {
    if c_type == "void" {
        return true
    }
    fallback depth <= 16
    var renamed = renamed_types[c_type]
    fallback renamed
    return is_void(renamed, depth + 1)
}

func statements_of(text: String): List<String> {
    var flat = text.replace("\r", " ").replace("\n", " ").replace("\t", " ")
    var pieces = flat.split(";")
    var statements = List<String>()
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var trimmed = piece.trim()
        statements.append(trimmed)
        index = index + 1
    }
    return statements
}

func note_the_renamed_types(statements: List<String>) {
    renamed_types = Dictionary<String, String>()
    statements.each(note_a_renamed_type)
}

func note_a_renamed_type(statement: String) {
    var words = words_of(statement)
    var at = words.index_of("typedef")
    fallback at and words.count() >= at + 3
    var name = words.remove_last()
    crash name
    fallback not name.contains("(") and not name.contains("*") and not statement.contains("\{")
    var removed = 0
    while removed <= at {
        words.remove_at(0)
        removed = removed + 1
    }
    var written = words.join(" ")
    renamed_types[name] = written
}

func words_of(piece: String): List<String> {
    var words = piece.split(" ")
    var kept = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        if not word.is_empty() and word != "const" {
            kept.append(word)
        }
        index = index + 1
    }
    return kept
}

func parameters_of_a_prototype(statement: String, c_name: String): String {
    var spaced = " {statement}".replace("*", " * ").replace("(", " (")
    var opening = spaced.index_of(" {c_name} (")
    fallback opening
    var start = opening + c_name.length() + 3
    var closing = spaced.length() - 1
    while closing > start and spaced.byte_at(closing) == 32 {
        closing = closing - 1
    }
    fallback closing > start and spaced.slice(closing, closing + 1) == ")"
    var inside = spaced.slice(start, closing)
    crash inside
    fallback not inside.contains("(") and not inside.contains(")")
    return inside
}

func scalars_of_parameters(inside: String): List<String> {
    var scalars = List<String>()
    var pieces = inside.split(",")
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var spite_name = scalar_of_a_parameter(piece)
        scalars.append(spite_name)
        index = index + 1
    }
    return scalars
}

func scalar_of_a_parameter(piece: String): String {
    fallback not piece.contains("*")
    var kept = words_of(piece)
    if kept.count() > 1 {
        var last_index = kept.count() - 1
        kept.remove_at(last_index)
    }
    var c_type = kept.join(" ")
    return scalar_of_a_named_type(c_type, 0)
}

func scalar_of_a_named_type(c_type: String, depth: Integer): String {
    var known = scalar_of_a_c_type(c_type)
    if not known.is_empty() or depth > 16 {
        return known
    }
    var renamed = renamed_types[c_type]
    fallback renamed and not renamed.contains("*")
    return scalar_of_a_named_type(renamed, depth + 1)
}

func width_of_a_named_type(c_type: String, depth: Integer): Integer {
    var scalar_name = scalar_of_a_named_type(c_type, 0)
    var scalar = values.scalars.of(scalar_name)
    if scalar {
        return scalar.size
    }
    fallback depth <= 16
    var renamed = renamed_types[c_type]
    fallback renamed
    if renamed.ends_with("*") {
        return 8
    }
    return width_of_a_named_type(renamed, depth + 1)
}

func scalar_of_a_c_type(c_type: String): String {
    if c_type == "float" {
        return "Float"
    } else if c_type == "double" {
        return "Double"
    } else if c_type == "char" {
        return "Tiny"
    } else if c_type == "signed char" {
        return "Tiny"
    } else if c_type == "unsigned char" {
        return "Byte"
    } else if c_type == "short" {
        return "Short"
    } else if c_type == "unsigned short" {
        return "UnsignedShort"
    } else if c_type == "int" {
        return "Integer"
    } else if c_type == "long" {
        return "Integer"
    } else if c_type == "unsigned" {
        return "UnsignedInteger"
    } else if c_type == "unsigned int" {
        return "UnsignedInteger"
    } else if c_type == "unsigned long" {
        return "UnsignedInteger"
    } else if c_type == "long long" {
        return "Long"
    } else if c_type == "unsigned long long" {
        return "UnsignedLong"
    } else if c_type == "int8_t" {
        return "Tiny"
    } else if c_type == "uint8_t" {
        return "Byte"
    } else if c_type == "int16_t" {
        return "Short"
    } else if c_type == "uint16_t" {
        return "UnsignedShort"
    } else if c_type == "int32_t" {
        return "Integer"
    } else if c_type == "uint32_t" {
        return "UnsignedInteger"
    } else if c_type == "int64_t" {
        return "Long"
    } else if c_type == "uint64_t" {
        return "UnsignedLong"
    } else {
        return ""
    }
}

func header_of(target: SpiteCompiler.Value): String {
    if target.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return header_of_an_attribute(target.attribute)
    }
    return ""
}

func header_of_an_attribute(attribute: Model.AttributeModel): String {
    fallback attribute.declaration
    var made = attribute.declaration.value
    if made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return header_argument_of(made)
    }
    return ""
}

func naming_of(target: SpiteCompiler.Value): String {
    if target.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return naming_of_an_attribute(target.attribute)
    }
    return "identity"
}

func naming_of_an_attribute(attribute: Model.AttributeModel): String {
    if not attribute.declaration {
        return "identity"
    }
    var made = attribute.declaration.value
    if made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return naming_argument_of(made)
    }
    return "identity"
}

func naming_argument_of(made: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    if made.arguments.count() != 3 {
        return "identity"
    }
    var written = made.arguments[1]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return written.text.replace("'", "")
    }
    return "identity"
}

func c_name_of(target: SpiteCompiler.Value, name: String): String {
    var naming = naming_of(target)
    if naming == "camel_case" {
        return name.camel_case()
    }
    if naming == "windows" {
        var shortened = windows_words_of(name)
        return shortened.pascal_case()
    }
    return name
}

func windows_words_of(name: String): String {
    var abbreviations = AbstractSyntaxTree.Names.Abbreviations()
    var words = name.split("_")
    var shortened = List<String>()
    var index = 0
    while index < words.count() {
        var word = words[index]
        var shortened_word = abbreviations.windows_word_of(word)
        shortened.append(shortened_word)
        index = index + 1
    }
    return shortened.join("_")
}

func header_argument_of(made: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    fallback made.arguments.count() == 3
    var written = made.arguments[2]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return literal_text_of(written)
    }
    return ""
}

func literal_text_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    return piece.text
}

func defined_value(line: String, name: String): String {
    var spaced = line.replace("\t", " ")
    var trimmed = spaced.trim()
    fallback trimmed.starts_with("#define ")
    var parts = trimmed.split(" ")
    var words = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        if not part.is_empty() {
            words.append(part)
        }
        index = index + 1
    }
    fallback words.count() == 3
    var defined_name = words[1]
    var lowered = defined_name.lower_case()
    fallback lowered == name
    return words[2]
}

func plain_number_of(written: String): String {
    var opened = written.replace("(", "")
    var closed = opened.replace(")", "")
    var plain = closed
    var walking = true
    while walking and not plain.is_empty() {
        var length = plain.length()
        var last = length - 1
        var ending = plain.slice(last, length)
        crash ending
        var is_a_suffix = ending == "u" or ending == "U" or ending == "l" or ending == "L"
        if is_a_suffix {
            var sliced_plain = plain.slice(0, last)
            crash sliced_plain
            plain = sliced_plain
        } else {
            walking = false
        }
    }
    return plain
}

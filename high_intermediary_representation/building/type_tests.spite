var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func TypeTests(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func class_test(tested: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value {
    fill_with_what_fits(tested.value_type, wanted)
    if values.is_held_in_a_box(tested.value_type) {
        return class_test_in_place(tested, wanted)
    }
    return HighIntermediaryRepresentation.Values.Class.Membership(tested, wanted)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func satisfaction(
    tested: SpiteCompiler.Value,
    wanted: Model.Type,
    class_read: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value {
    judge_a_union_none_fits(tested.value_type, wanted, class_read)
    var tested_type = tested.value_type
    var is_one_class = tested_type.kind == 'object' or tested_type.kind == 'scalar'
    is_one_class = is_one_class and not tested_type.is_nullable and context.has_a_class(tested_type)
    if is_one_class and context.current_function.typed_copy {
        var fitting = Fitting(context, values)
        var operators = Operators(context, values)
        operators.run_what_a_fold_drops(tested)
        var holds = fitting.satisfies(tested_type, wanted)
        return values.boolean_constant(holds)
    }
    if every_member_fits(tested_type, wanted) {
        fill_with_what_fits(tested_type, wanted)
        var operators = Operators(context, values)
        operators.run_what_a_fold_drops(tested)
        return values.boolean_constant(true)
    }
    return class_test(tested, wanted)
}

# ../../../spite_documentation/reflection.md#whether-a-union-satisfies-a-type
func every_member_fits(tested_type: Model.Type, wanted: Model.Type): Boolean {
    var asks_a_type = wanted.kind == 'shape' or wanted.kind == 'union'
    fallback tested_type.kind == 'union' and not tested_type.is_nullable and asks_a_type
    var questions = Questions(context, values)
    return questions.satisfied_by(tested_type, wanted)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func note_a_satisfied_type(
    asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    paths: List<String>,
    types: List<Model.Type>,
) {
    var calls = InnerCalls()
    var tested_written = value_asked_to_fit(asked)
    fallback tested_written and not calls.holds_a_call(tested_written)
    var wanted = type_it_may_be_narrowed_to(asked)
    fallback wanted
    var printer = Printers.Spite.ExpressionPrinter(tested_written)
    var path = printer.text()
    if tested_written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        path = "this.{tested_written.name}"
        var internal_name = context.scope.internal_name_of(tested_written.name)
        if internal_name {
            path = internal_name
        }
    }
    paths.append(path)
    types.append(wanted)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func value_asked_to_fit(asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Expression? {
    var callee = asked.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback callee.name == "satisfies_type" and asked.arguments.count() == 1
    var class_read = callee.target
    fallback class_read.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and class_read.name == "class"
    var operators = Operators(context, values)
    fallback operators.class_asked_of(class_read)
    return class_read.target
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func type_it_may_be_narrowed_to(asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var questions = Questions(context, values)
    var argument = asked.arguments.first()
    crash argument
    var wanted = questions.written_type_of(argument)
    fallback wanted
    var narrows_to_it = wanted.kind == 'shape' or wanted.kind == 'object' or wanted.kind == 'scalar'
    fallback narrows_to_it and wanted.name != "Number"
    return wanted
}

func judge_a_union_none_fits(
    tested_type: Model.Type,
    wanted: Model.Type,
    class_read: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var present = tested_type.present()
    fallback present.kind == 'union' and wanted.kind == 'shape'
    var fitting = Fitting(context, values)
    var united = fitting.union_model_of(present)
    var fitting_members = members_fitting(present, wanted)
    var rule = Validators.HighIntermediaryRepresentation.TestForNoMember.Validator()
    var rule_answer = rule.check_a_satisfaction(context, class_read, united, wanted, fitting_members)
    context.tell(rule_answer)
}

# ../../../spite_documentation/values_and_types.md#numbers-are-classes
func class_test_in_place(tested: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value {
    var present = tested.value_type.present()
    var fits = fits_in_place(present, wanted)
    if fits and tested.value_type.is_nullable {
        return HighIntermediaryRepresentation.Values.PresenceTest(tested)
    }
    var operators = Operators(context, values)
    operators.run_what_a_fold_drops(tested)
    return values.boolean_constant(fits)
}

func fits_in_place(present: Model.Type, wanted: Model.Type): Boolean {
    var fitting = Fitting(context, values)
    if wanted.kind == 'shape' {
        return fitting.has_the_shape_members(present, wanted)
    }
    if wanted.kind == 'union' {
        return values.is_a_member_of(present, wanted)
    }
    return wanted.is_the_same_as(present)
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func fill_with_what_fits(tested_type: Model.Type, wanted: Model.Type) {
    fallback wanted.kind == 'shape'
    var fitting = Fitting(context, values)
    var present = tested_type.present()
    if present.kind == 'shape' {
        fitting.fill_with_the_fitting(present, wanted)
        return
    }
    if present.kind == 'union' {
        fill_with_the_fitting_members(present, wanted)
        return
    }
    fallback present.kind == 'object' or present.kind == 'scalar'
    fallback fitting.has_the_shape_members(present, wanted)
    fitting.filled_shape(present, wanted)
}

func fill_with_the_fitting_members(union_type: Model.Type, wanted: Model.Type) {
    var fitting = Fitting(context, values)
    var fitting_members = members_fitting(union_type, wanted)
    var index = 0
    while index < fitting_members.count() {
        var member = fitting_members[index]
        fitting.filled_shape(member, wanted)
        index = index + 1
    }
}

# ../../../spite_documentation/control_flow.md#a-value-narrowed-by-a-type-it-may-fit
func members_fitting(union_type: Model.Type, wanted: Model.Type): List<Model.Type> {
    var found = List<Model.Type>()
    if wanted.kind != 'shape' {
        return found
    }
    var fitting = Fitting(context, values)
    var united = fitting.union_model_of(union_type)
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        if fitting.has_the_shape_members(member, wanted) {
            found.append(member)
        }
        index = index + 1
    }
    return found
}

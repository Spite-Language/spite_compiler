union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union WrittenStatement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var built = List<Statement>()
var facts_paths = List<String>()
var facts_types = List<Model.Type>()
var facts_checks = List<String>()
var endings = Endings()
var next_is_a_loop = false
var template_walks = TemplateWalks()
var rest_is_folded_away = false
var enclosing_blocks = List<EnclosingBlock>()
var at_function_root = false
var last_site_identity = ""
var shown_parts = List<ShownPart>()
var shown_texts = List<String>()
var reads_before = false
var reported_count = 0
var report_name = ""
var report_types = List<String>()
var shown_count = 0
var missing_conjuncts = List<Expression>()
var missing_links = List<Expression>()
var last_check = ""
var last_check_at = -1
var last_check_line = 0
var last_check_block = ""

func Statements(starting_context: Context) {
    context = starting_context
    values = Values(starting_context)
}

func block_of(written: AbstractSyntaxTree.Shapes.Statements.Block?): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    build_all(written.statements)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    made.line = written.line
    built = outer
    return made
}

func function_body_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
): HighIntermediaryRepresentation.Statements.Block {
    var outer_blocks = enclosing_blocks
    enclosing_blocks = List<EnclosingBlock>()
    at_function_root = true
    var made = block_of(written)
    enclosing_blocks = outer_blocks
    return made
}

func build_all(written: List<WrittenStatement>) {
    rest_is_folded_away = false
    var outer_statements = context.block_statements
    var outer_index = context.block_index
    var pushed = not at_function_root
    at_function_root = false
    if pushed {
        var enclosing = EnclosingBlock(outer_statements, outer_index)
        enclosing_blocks.append(enclosing)
    }
    context.block_statements = written
    note_a_block("enter", written)
    var library = Validators.LibraryFile()
    var path = context.path()
    var is_the_program = not library.holds(path)
    var index = 0
    while index < written.count() and not rest_is_folded_away {
        var statement = written[index]
        context.block_index = index
        if is_the_program {
            note_a_statement(written, index)
        }
        build(statement)
        context.block_statements = written
        index = index + 1
    }
    note_a_block("leave", written)
    if pushed {
        crash enclosing_blocks.remove_last()
    }
    context.block_statements = outer_statements
    context.block_index = outer_index
    rest_is_folded_away = false
}

# ../../PROOFS.md#what-the-builder-records-for-the-proofs
func note_a_block(kind: String, written: List<WrittenStatement>) {
    var site = StatementSite(kind, written, 0)
    site.is_a_loop = next_is_a_loop
    next_is_a_loop = false
    context.note_a_statement_site(site)
}

func note_a_statement(written: List<WrittenStatement>, index: Integer) {
    var site = StatementSite("statement", written, index)
    site.owner = context.current_class
    site.function = context.current_function
    site.line = context.line
    site.enclosing = enclosing_blocks.copy()
    site.view = context.scope.view()
    context.note_a_statement_site(site)
}

func narrowed_block_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    paths: List<String>,
    types: List<Model.Type>,
    check: String,
): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    narrow_all(paths, types)
    note_one_check(paths, check)
    build_all(written.statements)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    made.line = written.line
    built = outer
    return made
}

func loop_body_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    paths: List<String>,
    types: List<Model.Type>,
    notes: List<String>,
): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    narrow_all(paths, types)
    note_the_loop_checks(paths, notes)
    next_is_a_loop = true
    build_all(written.statements)
    refuse_what_the_loop_left_undone()
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    made.line = written.line
    built = outer
    return made
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_one_check(paths: List<String>, check: String) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        if not path.contains("[") {
            context.scope.note_the_check(path, check)
        }
        index = index + 1
    }
}

func note_the_loop_checks(paths: List<String>, notes: List<String>) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var note = notes[index]
        if note and note != "" {
            context.scope.note_the_check(path, note)
        }
        index = index + 1
    }
}

func narrow_all(paths: List<String>, types: List<Model.Type>) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var narrowed_type = types[index]
        crash narrowed_type
        context.scope.narrow(path, narrowed_type)
        index = index + 1
    }
}

func add(statement: Statement) {
    context.pending.each(add_pending)
    context.pending = List<Statement>()
    log_the_calls_of(statement)
    built.append(statement)
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func log_the_calls_of(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: log_a_value(statement.value, statement.line)
        HighIntermediaryRepresentation.Statements.Assign.Assign: log_a_value(statement.value, statement.line)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: log_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: log_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: log_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.Return: log_a_value(statement.value, statement.line)
        HighIntermediaryRepresentation.Statements.Stop: log_a_value(statement.then, statement.line)
        _: return
    }
}

func log_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    log_a_value(written.object, written.line)
    log_a_value(written.value, written.line)
}

func log_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    log_a_value(written.object, written.line)
    log_a_value(written.value, written.line)
}

func log_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    log_a_value(evaluated.value, evaluated.line)
    log_a_value(evaluated.waited, evaluated.line)
}

func log_a_value(value: Value?, line: Integer) {
    fallback value
    context.logged_calls.append(value)
    var at = line
    if at == 0 {
        at = context.line
    }
    context.logged_lines.append(at)
    context.scope.stamp = context.logged_calls.count()
}

func extend_the_reads_over_the_loop(log_start: Integer, reads_start: Integer) {
    var index = reads_start
    while index < context.narrowed_reads.count() {
        var read = context.narrowed_reads[index]
        if read.start < log_start {
            read.loop_end = context.logged_calls.count()
        }
        index = index + 1
    }
}

func flush_the_pending() {
    context.pending.each(add_pending)
    context.pending = List<Statement>()
}

func add_pending(statement: Statement) {
    log_the_calls_of(statement)
    built.append(statement)
}

func build(statement: WrittenStatement) {
    context.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: build_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: build_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: build_evaluation(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: build_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: build_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: build_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: build_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: build_fallback(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: build_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: build_inner_block(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func build_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var known = KnownCalls(context, values)
    var known_call = known.made_by(statement)
    if known_call {
        add(known_call)
        return
    }
    known.remember_a_declaration(statement)
    var declared: Model.Type? = null
    if statement.declared_type {
        declared = context.resolver.type_in(statement.declared_type, context.current_class, statement.line)
    }
    var value = values.value_of(statement.value, declared)
    note_a_lone_hole(statement)
    var local_type = value.value_type
    if declared {
        value = values.fitted(value, declared)
        local_type = declared
    }
    var folded_keys = Folded.Keys(context, values)
    folded_keys.refuse_a_held_map(value)
    var hidden = context.scope.hidden_by(statement.name)
    var name = context.scope.declare_written(statement.name, local_type)
    var made = HighIntermediaryRepresentation.Statements.Declare(name, local_type, value)
    made.line = statement.line
    made.hides = hidden
    add(made)
    forget_what_the_call_writes(statement.value)
    forget_what_a_receiver_call_shrinks(value)
    note_a_counted_list(name, statement.value)
    var known_walks = KnownWalks(context, values)
    known_walks.note_a_function_list(name, statement.name, statement.value)
    note_a_function_local(name, statement.name, value)
    note_a_function_receiver(name, statement.name, value)
    note_a_plain_local(name, statement, local_type)
    note_a_null_local(name, statement.name, value)
    note_a_text_local(name, statement.name, value)
    note_a_copy(statement, name, local_type)
    if value == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'proven' {
        context.proven_locals.append(name)
    }
    note_an_index_local(name, value)
}

# ../../../spite_spec/specs/values_and_types.md
func note_a_lone_hole(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var written = statement.value
    fallback written == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    fallback written.pieces.count() == 1
    var only = written.pieces[0]
    fallback only.text.is_empty() and only.hole
    var path = context.path()
    var key = "{path}:{statement.line}:{statement.name}"
    if context.hole_is_text {
        context.text_holes.append(key)
    } else {
        context.other_holes.append(key)
    }
}

func forget_an_index_local(name: String) {
    var kept = List<String>()
    var index = 0
    while index < context.index_locals.count() {
        var local = context.index_locals[index]
        if local != name {
            kept.append(local)
        }
        index = index + 1
    }
    context.index_locals = kept
}

func note_an_index_local(name: String, value: Value) {
    if value == HighIntermediaryRepresentation.Values.Call and value.index_path != "" and value.value_type.is_nullable {
        context.index_locals.append(name)
    }
}

func note_a_function_local(name: String, written_name: String, value: Value) {
    if value == HighIntermediaryRepresentation.Values.Function.Value {
        note_a_named_function(name, written_name, value.function)
    }
}

func note_a_null_local(name: String, written_name: String, value: Value) {
    var is_null = value == HighIntermediaryRepresentation.Values.NullConstant
    if is_null and not values.is_assigned_again(written_name) {
        context.null_locals.append(name)
    }
}

func note_a_text_local(name: String, written_name: String, value: Value) {
    if value == HighIntermediaryRepresentation.Values.TextConstant and not values.is_assigned_again(written_name) {
        context.text_locals[name] = value.text
    }
}

func note_a_named_function(name: String, written_name: String, function: Model.FunctionModel) {
    fallback not values.is_assigned_again(written_name)
    context.function_locals[name] = function
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func note_a_function_receiver(name: String, written_name: String, value: Value) {
    fallback value == HighIntermediaryRepresentation.Values.Function.Value and not values.is_assigned_again(written_name)
    fallback value.receiver
    hold_a_function_receiver(name, value.receiver)
}

func hold_a_function_receiver(name: String, receiver: Value) {
    var is_plain = receiver == HighIntermediaryRepresentation.Values.LocalRead
    fallback is_plain or receiver == HighIntermediaryRepresentation.Values.AttributeRead
    var receiver_type = receiver.value_type
    fallback receiver_type.kind == 'object' and not receiver_type.is_nullable
    var held = context.scope.declare("{name}_receiver", receiver_type)
    var made = HighIntermediaryRepresentation.Statements.Declare(held, receiver_type, receiver)
    made.line = context.line
    add(made)
    context.function_receivers[name] = held
}

func note_a_copy(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    internal_name: String,
    local_type: Model.Type,
) {
    fallback local_type.is_nullable and is_a_bare_path(statement.value)
    fallback not (statement.declared_type and context.current_class.shown.contains("<"))
    var path = context.path()
    var library = Validators.LibraryFile()
    fallback not library.holds(path)
    crash statement.value
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var source = printer.text()
    fallback not source.contains("[")
    fallback context.current_function.declaration
    var assigned = AssignedPaths()
    var targets = assigned.of(context.current_function.declaration)
    fallback not targets.contains(statement.name)
    var index = 0
    while index < targets.count() {
        var target = targets[index]
        fallback not (target == source or target.starts_with("{source}.") or target.starts_with("{source}["))
        fallback not (source.starts_with("{target}.") or source.starts_with("{target}["))
        index = index + 1
    }
    context.scope.note_a_copy(internal_name, statement.name, source, statement.line)
}

func is_a_bare_path(written: Expression?): Boolean {
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return true
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return true
    }
    return false
}

func last_line_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration?): Integer {
    crash declaration
    crash declaration.body
    var last = declaration.body.statements.last()
    crash last
    return last.line
}

func note_a_maybe_boolean(
    condition: Expression?,
    linked: Expression?,
) {
    fallback is_a_bare_path(condition)
    context.scope.enter()
    if linked == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_facts(linked.left)
        narrow_all(facts_paths, facts_types)
    }
    var written_value = values.value_of(condition, null)
    context.scope.leave()
    var value = values.result_of_handle(written_value)
    var tested = value.value_type
    var site = PresenceSite("boolean", context, tested)
    site.value = value
    context.note_a_presence_site(site)
}

func refuse_a_false_build_field(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    var written = statement.condition
    if written == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refuse_a_false_build_member(written)
    }
}

func refuse_a_false_build_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var holder = context.current_class.attribute_named(target.name)
        var settings = context.program.class_named("Build")
        fallback holder and settings and not context.scope.internal_name_of(target.name)
        fallback holder.attribute_type.kind == 'object' and holder.attribute_type.name == "Build"
        var field = settings.attribute_named(member.name)
        fallback field
        fallback field.attribute_type.kind == 'scalar' and field.attribute_type.name == "Boolean"
        fallback not build_field_holds(field)
        var printer = Printers.Spite.ExpressionPrinter(member)
        var shown = printer.text()
        typing.refuse_folded_crash(context, shown)
    }
}

func build_field_holds(field: Model.AttributeModel): Boolean {
    var given = context.build_value_given(field.name)
    if given {
        return given == "true"
    }
    if not field.declaration {
        return true
    }
    var value = field.declaration.value
    if value == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return value.kind != 'keyword_false'
    }
    return true
}

func refuse_a_folded_crash(
    statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement,
    condition: Value,
) {
    if condition == HighIntermediaryRepresentation.Values.WholeNumber {
        fallback condition.number == 0
        crash statement.condition
        var printer = Printers.Spite.ExpressionPrinter(statement.condition)
        var written = printer.text()
        typing.refuse_folded_crash(context, written)
    }
}

func folded_unheld_crash(
    statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement,
): Value {
    var pending_before = context.pending.count()
    var unheld = values.condition_of(statement.condition)
    refuse_a_folded_crash(statement, unheld)
    while context.pending.count() > pending_before {
        crash context.pending.remove_last()
    }
    return HighIntermediaryRepresentation.Values.Negation(unheld)
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func note_a_narrowed_copy(fact_path: String) {
    var source = context.scope.copied_sources[fact_path]
    fallback source
    var written_name = context.scope.copied_names[fact_path]
    var line = context.scope.copied_lines[fact_path]
    crash written_name
    crash line
    var site = CheckSite("copy", context)
    site.source = source
    site.written = written_name
    site.line = line
    context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_tested_copy(condition: Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and condition.operator == 'not' {
        note_a_loop_copy(condition.operand)
    }
}

func note_a_loop_copy(condition: Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var fact_path = identifier_path(condition.name)
        note_a_narrowed_copy(fact_path)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_read_check(condition: Expression?, keyword: String) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        var written = printer.text()
        var site = CheckSite("proven read", context)
        site.written = written
        site.check = context.scope.check_of(written)
        site.keyword = keyword
        var since = 0
        var innermost = context.loop_bases.last()
        if innermost {
            since = innermost
        }
        var called_since = context.scope.stamp_of(written) < context.logged_calls.count()
        var is_a_loop_proof = false
        if site.check {
            is_a_loop_proof = site.check.starts_with("the loop condition ")
        }
        site.is_narrowed_outside = context.scope.frame_of(written) < since or called_since and not is_a_loop_proof
        context.note_a_check_site(site)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func checking_text(keyword: String, condition: Expression?, line: Integer): String {
    var tested = condition
    if tested == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        tested = tested.operand
    }
    var is_joined = false
    if tested == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        is_joined = tested.operator == 'and' or tested.operator == 'or'
    }
    if is_joined {
        return "the '{keyword}' on line {line}"
    }
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    return "'{keyword} {written}' on line {line}"
}

func notes_with(paths: List<String>, notes: List<String>, check: String): List<String> {
    var noted = List<String>()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var note = notes[index]
        if note and note != "" {
            noted.append(note)
        } else if path.contains("[") {
            noted.append("")
        } else {
            noted.append(check)
        }
        index = index + 1
    }
    return noted
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_condition(condition: Expression?) {
    var tested = condition
    if tested == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        tested = tested.operand
    }
    fallback is_a_bare_path(tested)
    crash tested
    var printer = Printers.Spite.ExpressionPrinter(tested)
    var written = printer.text()
    var fact_path = path_of(tested, written)
    var since = 0
    var innermost = context.loop_bases.last()
    if innermost {
        since = innermost
    }
    fallback context.scope.frame_of(fact_path) >= since
    var narrowed_type = context.scope.narrowed_type_of(fact_path)
    fallback narrowed_type
    var is_a_boolean = narrowed_type.kind == 'scalar' and narrowed_type.name == "Boolean"
    fallback not narrowed_type.is_nullable and not is_a_boolean
    var check = context.scope.check_of(fact_path)
    fallback check
    var site = CheckSite("proven check", context)
    site.written = written
    site.check = check
    context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_repeated_check(condition: Expression?, line: Integer) {
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var function = context.current_function
    var depth = context.scope.narrowed.count()
    var opening_line = 0
    var opening = context.block_statements.first()
    if opening {
        opening_line = opening.line
    }
    var statement_total = context.block_statements.count()
    var block = "{function.owner}.{function.name}|{depth}|{statement_total}|{opening_line}"
    var follows = context.block_index == last_check_at + 1 and block == last_check_block and written == last_check
    var earlier_line = last_check_line
    last_check = written
    last_check_at = context.block_index
    last_check_line = line
    last_check_block = block
    fallback follows and not holds_a_call(condition)
    var site = CheckSite("repeated check", context)
    site.written = written
    site.check = earlier_line
    context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_divisor(condition: Expression?, line: Integer) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_proven_nonzero(condition, line)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_nonzero(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, line: Integer) {
    var is_a_divisor_test = condition.operator == 'not_equal' or condition.operator == 'greater'
    var zero = condition.right
    var is_zero = false
    if zero == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_zero = zero.kind == 'integer_literal' and zero.text == "0"
    }
    var tested = condition.left
    var name = ""
    if tested == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = tested.name
    }
    fallback is_a_divisor_test and is_zero and not name.is_empty()
    var internal_name = context.scope.internal_name_of(name)
    fallback internal_name
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var nonzero = "~[{name}]"
    var positive = "~>[{name}]"
    var proof = proof_inside_the_loop(nonzero)
    if condition.operator == 'greater' {
        proof = proof_inside_the_loop(positive)
    }
    var integer = context.scalar_type("Integer")
    context.scope.narrow(nonzero, integer)
    context.scope.note_the_check(nonzero, "'{written}' on line {line}")
    if condition.operator == 'greater' {
        context.scope.narrow(positive, integer)
        context.scope.note_the_check(positive, "'{written}' on line {line}")
    }
    fallback proof
    var site = CheckSite("proven divisor", context)
    site.written = written
    site.check = proof
    context.note_a_check_site(site)
}

func proof_inside_the_loop(path: String): String? {
    var since = 0
    var innermost = context.loop_bases.last()
    if innermost {
        since = innermost
    }
    fallback context.scope.frame_of(path) >= since
    return context.scope.check_of(path)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_check_that_always_holds(
    condition: Value,
    keyword: String,
    written: Expression?,
) {
    var holds = false
    if condition == HighIntermediaryRepresentation.Values.WholeNumber {
        holds = condition.number != 0
    }
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    fallback holds and not is_a_walk and not is_generic
    var path = context.path()
    var library = Validators.LibraryFile()
    fallback not path.contains("/.spite/") and not library.holds(path)
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var written_text = printer.text()
    fallback holds_a_call(written) or written_text.contains("Build.") or not is_a_bare_path(written)
    var site = CheckSite("always holds", context)
    site.written = written_text
    site.keyword = keyword
    context.note_a_check_site(site)
}

# ../../PROOFS.md#a-condition-known-while-compiling-is-an-error
func note_a_decided_condition(
    condition: Value,
    keyword: String,
    written: Expression?,
    build_reads_before: Integer,
) {
    var decided = decided_number_of(condition)
    fallback decided
    var holds = decided.number != 0
    var is_a_check = keyword == "fallback" or keyword == "crash"
    fallback not is_a_check or not holds
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    var reads_a_setting = context.folded_build_reads > build_reads_before
    fallback not is_a_walk and not is_generic and not reads_a_setting
    var path = context.path()
    fallback not path.contains("/.spite/")
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var site = CheckSite("decided condition", context)
    site.written = printer.text()
    site.keyword = keyword
    site.holds = holds
    site.source = known_presence_of(written, holds)
    context.note_a_check_site(site)
}

func decided_number_of(
    condition: Value,
): HighIntermediaryRepresentation.Values.WholeNumber? {
    if condition == HighIntermediaryRepresentation.Values.WholeNumber {
        return condition
    }
    fallback condition == HighIntermediaryRepresentation.Values.MachineOperation
    var left = condition.left
    var right = condition.right
    fallback left == HighIntermediaryRepresentation.Values.WholeNumber
    fallback right == HighIntermediaryRepresentation.Values.WholeNumber
    var compared = values.compared_numbers(condition.operator, left.number, right.number)
    if compared == HighIntermediaryRepresentation.Values.WholeNumber {
        return compared
    }
    return null
}

func known_presence_of(written: Expression, holds: Boolean): String? {
    var tested = written
    var names_a_present_value = holds
    if tested == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        crash tested.operand
        tested = tested.operand
        names_a_present_value = not holds
    }
    fallback is_a_bare_path(tested)
    var printer = Printers.Spite.ExpressionPrinter(tested)
    var name = printer.text()
    if names_a_present_value {
        return "'{name}' is proven present here"
    }
    return "'{name}' is known to be null here"
}

func note_a_proven_check(condition: Expression?) {
    fallback is_a_bare_path(condition)
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var fact_path = path_of(condition, written)
    var site = CheckSite("proven check", context)
    site.written = written
    site.check = context.scope.check_of(fact_path)
    context.note_a_check_site(site)
}

func note_the_checks(keyword: String, condition: Expression?, line: Integer) {
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var read_proof = "'{written}'"
    if condition == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        read_proof = "an earlier check"
    }
    var index = 0
    while index < facts_paths.count() {
        var path = facts_paths[index]
        if path.contains("[") {
            context.scope.note_the_check(path, read_proof)
        } else {
            context.scope.note_the_check(path, "'{keyword} {written}' on line {line}")
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-fallback-answers-what-its-answer-type-builds-with-no-arguments
func note_a_terminal_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var site = GuardSite("terminal if", context)
    site.condition = statement.condition
    site.statement_line = statement.line
    if statement.else_branch {
        site.has_an_else = true
    }
    site.proves_something = facts_paths.count() > 0
    context.note_a_guard_site(site)
}

func note_a_counted_list(name: String, written: Expression?) {
    if written == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_count_call(name, written)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        note_a_literal_list(name, written)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_lowered_count(name, written)
    }
}

func note_a_lowered_count(name: String, lowered: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var right = lowered.right
    var takes_a_literal = right == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    fallback lowered.operator == 'minus' and takes_a_literal
    var counted = lowered.left
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_count_call(name, counted)
    }
}

func note_a_literal_list(name: String, literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral) {
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var listed_type = context.scope.type_of(internal_name)
    crash listed_type
    fallback context.has_a_class(listed_type) and not listed_type.is_nullable
    var listing = context.class_of(listed_type)
    var element = listing.bound_types["$element_type"]
    fallback element
    fallback not element.is_nullable
    var index = 0
    while index < literal.entries.count() {
        context.scope.narrow("{name}[{index}]", element)
        index = index + 1
    }
}

func note_a_count_call(name: String, counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        note_a_count_member(name, counted, callee)
    }
}

func note_a_count_member(
    name: String,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    crash callee.target
    context.counted_lists[name] = callee.target
}

func build_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    assign_to(statement, statement.target)
}

func assign_to(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: Expression,
) {
    var known = KnownCalls(context, values)
    var filled = known.fill_of(statement)
    if filled {
        add(filled)
        return
    }
    switch target {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: assign_a_name(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: assign_a_member(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: assign_an_index(statement, target)
        _: typing.refuse_not_assignable(context)
    }
}

func assign_a_name(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var known = KnownCalls(context, values)
    known.forget_a_declaration(target.name)
    var internal_name = context.scope.internal_name_of(target.name)
    if internal_name {
        var declared_type = context.scope.types[internal_name]
        crash declared_type
        var value = values.fitted_value_of(statement.value, declared_type)
        var was_narrowed = context.scope.narrowed_type_of(internal_name)
        if was_narrowed and may_be_null(value) {
            note_an_undone_loop_proof(statement, internal_name)
        }
        if declared_type.is_nullable and is_present(value) {
            var present = declared_type.present()
            context.scope.keep_present(internal_name, target.name, present)
        } else {
            context.scope.forget(internal_name)
            context.scope.forget_mentions(target.name)
        }
        context.counted_lists.remove_at(internal_name)
        var windows = Windows(context, values)
        windows.forget_a_name(target.name)
        windows.forget_an_area_name(target.name)
        forget_an_index_local(internal_name)
        var appending = Appending(context, values)
        if appending.pieces_appended_to(internal_name, declared_type, value) {
            var appended = appending.statements_of(internal_name, declared_type, statement.line)
            appended.each(add)
            return
        }
        var made = HighIntermediaryRepresentation.Statements.Assign.Assign(internal_name, value)
        made.line = statement.line
        add(made)
        return
    }
    var attribute = context.current_class.attribute_named(target.name)
    var setter = context.current_class.function_named("set_{target.name}")
    if not attribute and setter and setter.parameters.count() == 1 {
        var own_object = values.this_value()
        context.scope.forget("this.{target.name}")
        set_through(statement, own_object, setter)
        return
    }
    if not attribute {
        typing.refuse_unknown_name(context, target.name)
    }
    crash attribute
    var own = values.this_value()
    context.scope.forget(target.name)
    assign_an_attribute(statement, own, attribute, "this.{target.name}")
}

func assign_a_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback not assigns_a_walked_value(statement, target)
    refuse_a_constant(target)
    var object = values.value_of(target.target, null)
    if object.value_type.kind == 'shape' and not object.value_type.is_nullable {
        assign_through_a_shape(statement, object, target.name)
        return
    }
    var owner = values.present_class_of(object)
    var attribute = owner.attribute_named(target.name)
    var is_outside = owner.key != context.current_class.key
    var file_path = context.path()
    var is_generated = file_path.contains("/.spite/")
    if owner.key == "Build" and attribute and not is_generated {
        typing.refuse_a_build_write(context, target.name)
    }
    var setter = owner.function_named("set_{target.name}")
    if not setter and is_outside {
        setter = values.member_template_of(owner, "set_{target.name}")
    }
    var writes_through_a_setter = is_outside or not attribute
    if writes_through_a_setter and setter {
        var set_printer = Printers.Spite.ExpressionPrinter(target)
        var set_path = set_printer.text()
        context.scope.forget(set_path)
        set_through(statement, object, setter)
        return
    }
    var getter = owner.function_named("get_{target.name}")
    if not attribute and getter {
        typing.refuse_read_only(context, owner.shown, target.name)
    }
    if not attribute {
        var shown = context.shown(object.value_type)
        typing.refuse_unknown_member(context, shown, target.name)
    }
    crash attribute
    var printer = Printers.Spite.ExpressionPrinter(target)
    var path = printer.text()
    assign_an_attribute(statement, object, attribute, path)
}

func refuse_a_constant(target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var class_path = values.class_path_of(target.target)
    var written = class_path.join(".")
    fallback values.scalars.is_a_scalar(written)
    typing.refuse_constant_assigned(context, "{written}.{target.name}")
}

func assign_through_a_shape(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: Value,
    name: String,
) {
    var shape = context.program.shape_keyed(object.value_type.name)
    crash shape
    var member = shape.member_named(name)
    var shown = context.shown(object.value_type)
    if not member {
        typing.refuse_unknown_member(context, shown, name)
    }
    crash member
    if not member.is_an_attribute {
        typing.refuse_read_only(context, shown, name)
    }
    crash member.answer
    var value = values.fitted_value_of(statement.value, member.answer)
    var made = HighIntermediaryRepresentation.Statements.Assign.ThroughShape(object, shape, name, value)
    made.line = statement.line
    add(made)
}

func assigns_a_walked_value(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Boolean {
    var function = context.current_function
    fallback function.walked_object and target.name == "value"
    var described = target.target
    if described == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return assigned_through_the_walk(statement, described, function)
    }
    return false
}

func assigned_through_the_walk(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    described: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): Boolean {
    fallback described.name == function.bound_parameter
    var read = values.walked_value(function)
    if read == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

# ../../../spite_spec/specs/json.md#json-is-reflection-not-a-library
func held_for_the_table(
    object: Value,
): Value {
    if object == HighIntermediaryRepresentation.Values.LocalRead {
        return object
    }
    if object == HighIntermediaryRepresentation.Values.ThisRead {
        return object
    }
    values.temporary_count = values.temporary_count + 1
    var name = context.scope.declare("keyed_{values.temporary_count}", object.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object.value_type, object)
    declared.line = context.line
    add(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(object.value_type, name)
}

func add_the_table(object: Value, attribute: Model.AttributeModel) {
    var folded_keys = Folded.Keys(context, values)
    var filling = folded_keys.filled_table(object, attribute)
    filling.each(add)
}

func assign_an_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: Value,
    attribute: Model.AttributeModel,
    path: String,
) {
    var folded_keys = Folded.Keys(context, values)
    var fills_a_table = false
    if folded_keys.is_a_key_map(attribute.attribute_type) {
        fills_a_table = folded_keys.record(statement.value, attribute)
    }
    var value = values.fitted_value_of(statement.value, attribute.attribute_type)
    var target = object
    if fills_a_table {
        value = folded_keys.copied(value, attribute)
        target = held_for_the_table(object)
    }
    var was_narrowed = context.scope.narrowed_type_of(path)
    if was_narrowed and may_be_null(value) {
        note_an_undone_loop_check(statement, path)
    }
    context.scope.forget(path)
    forget_the_printed_path(path)
    var made = HighIntermediaryRepresentation.Statements.Assign.Attribute(target, attribute, value)
    made.line = statement.line
    add(made)
    if fills_a_table {
        add_the_table(target, attribute)
    }
    fallback was_narrowed
    narrow_a_present_assignment(value, attribute, path)
}

func forget_the_printed_path(path: String) {
    fallback path.starts_with("this.")
    var length = path.length()
    var printed = path.slice(5, length)
    crash printed
    context.scope.forget(printed)
}

func may_be_null(value: Value): Boolean {
    if value == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'nullable' {
        crash value.converted
        return value.converted.value_type.is_nullable
    }
    return value.value_type.is_nullable
}

# ../../PROOFS.md#assigning-undoes-a-proof
func note_an_undone_loop_check(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, path: String) {
    var site = CheckSite("undone in the loop", context)
    var base = context.loop_bases.last()
    if base {
        var frame = context.scope.frame_of(path)
        site.has_a_loop = true
        site.is_narrowed_outside = frame >= 0 and frame < base
    }
    site.is_read_in_the_loop = context.loop_reads.contains(path)
    crash statement.target
    var printer = Printers.Spite.ExpressionPrinter(statement.target)
    site.written = printer.text()
    context.note_a_loop_site(site)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func note_an_undone_loop_proof(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, path: String) {
    var base = context.loop_bases.last()
    fallback base
    var frame = context.scope.frame_of(path)
    fallback frame >= 0 and frame < base
    fallback context.loop_reads.contains(path)
    crash statement.target
    var printer = Printers.Spite.ExpressionPrinter(statement.target)
    context.undone_paths.append(path)
    context.undone_lines.append(statement.line)
    var written = printer.text()
    context.undone_texts.append(written)
    var depth = context.loop_bases.count()
    context.undone_depths.append(depth)
}

func refuse_what_the_loop_left_undone() {
    var depth = context.loop_bases.count()
    var index = context.undone_paths.count() - 1
    while index >= 0 {
        var undone_depth = context.undone_depths[index]
        crash undone_depth
        if undone_depth == depth {
            note_an_undone_path(index)
            context.undone_paths.remove_at(index)
            context.undone_lines.remove_at(index)
            context.undone_texts.remove_at(index)
            context.undone_depths.remove_at(index)
        }
        index = index - 1
    }
}

func note_an_undone_path(index: Integer) {
    var path = context.undone_paths[index]
    crash path
    var line = context.undone_lines[index]
    var written = context.undone_texts[index]
    crash line
    crash written
    var site = CheckSite("left undone", context)
    if context.scope.narrowed_type_of(path) {
        site.is_still_narrowed = true
    }
    site.has_a_loop = true
    site.written = written
    site.line = line
    context.note_a_loop_site(site)
}

func is_present(value: Value): Boolean {
    if not value.value_type.is_nullable {
        return true
    }
    if value == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        return not value.converted.value_type.is_nullable
    }
    return false
}

func narrow_a_present_assignment(
    value: Value,
    attribute: Model.AttributeModel,
    path: String,
) {
    fallback attribute.attribute_type.is_nullable
    if value == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        if not value.converted.value_type.is_nullable {
            var present = attribute.attribute_type.present()
            context.scope.narrow(path, present)
        }
    }
}

func set_through(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: Value,
    setter: Model.FunctionModel,
) {
    context.need(setter)
    var parameter = setter.parameters[0]
    crash parameter
    var value = values.fitted_value_of(statement.value, parameter.parameter_type)
    var arguments = List<Value>()
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(setter, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

func assign_a_bound_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Boolean {
    var function = context.current_function
    fallback function.bound_member_type
    if not function.bound_shape.is_empty() {
        return assign_through_the_shape(statement, target, function)
    }
    var read = values.bound_member_read(target)
    if read == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

func assign_through_the_shape(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    function: Model.FunctionModel,
): Boolean {
    var attributes = target.target
    if attributes == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        assign_a_shape_member(statement, attributes, function)
        return true
    }
    return false
}

func assign_a_shape_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    attributes: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
) {
    var object = values.value_of(attributes.target, null)
    var shape = context.program.shape_keyed(function.bound_shape)
    crash shape
    crash function.bound_member_type
    var value = values.fitted_value_of(statement.value, function.bound_member_type)
    var made = HighIntermediaryRepresentation.Statements.Assign.ThroughShape(object, shape, function.bound_member, value)
    made.line = statement.line
    add(made)
}

func assign_the_bound_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
) {
    crash read.object
    var value = values.fitted_value_of(statement.value, read.attribute.attribute_type)
    var made = HighIntermediaryRepresentation.Statements.Assign.Attribute(read.object, read.attribute, value)
    made.line = statement.line
    add(made)
}

func assign_an_index(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    fallback not assign_a_bound_member(statement, target)
    var object = values.value_of(target.target, null)
    var folded_keys = Folded.Keys(context, values)
    folded_keys.refuse_a_change(object)
    var owner = values.present_class_of(object)
    var function = owner.function_named("set_at")
    if not function {
        var shown = context.shown(object.value_type)
        typing.refuse_not_indexed(context, shown, "assigning through an index on", "set_at(index, value)")
    }
    crash function
    context.need(function)
    var index_parameter = function.parameters[0]
    var value_parameter = function.parameters[1]
    crash index_parameter
    crash value_parameter
    var position = values.fitted_value_of(target.index, index_parameter.parameter_type)
    var value = values.fitted_value_of(statement.value, value_parameter.parameter_type)
    forget_the_stored_items(target, value)
    refuse_a_refilled_argument(target, object, position, statement.line)
    var arguments = List<Value>()
    arguments.append(position)
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(function, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func refuse_a_refilled_argument(
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    object: Value,
    position: Value,
    line: Integer,
) {
    fallback object == HighIntermediaryRepresentation.Values.Call
    fallback object.function.name == "get_arguments" and object.function.owner == "Spite.Call"
    fallback position == HighIntermediaryRepresentation.Values.TextConstant
    var owner = values.present_class_of(object)
    var containing = owner.function_named("contains")
    crash containing
    context.need(containing)
    var asked = List<Value>()
    asked.append(position)
    var arguments = HighIntermediaryRepresentation.Values.Call(object.function, object.receiver, object.arguments)
    var filled = HighIntermediaryRepresentation.Values.Call(containing, arguments, asked)
    crash target.target
    var call_name = "call"
    var written = target.target
    if written == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash written.target
        var printer = Printers.Spite.ExpressionPrinter(written.target)
        call_name = printer.text()
    }
    var message = "spite: '{call_name}.arguments['{position.text}']' is already set: a call fills each argument once, before '{call_name}.call()' runs it"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = line
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(filled, stopping, null)
    add(branch)
}

func refuse_a_dropped_answer(
    statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement,
    value: Value,
) {
    fallback not value.value_type.is_nothing()
    fallback value != HighIntermediaryRepresentation.Values.MakeObject
    fallback value != HighIntermediaryRepresentation.Values.ForeignCall
    fallback not context.current_function.is_a_walk_copy
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var written = printer.text()
    var dropped = Validators.HighIntermediaryRepresentation.DroppedAnswer.Validator()
    dropped.refuse(context, written, value.value_type)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func forget_the_stored_items(
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    value: Value,
) {
    crash target.target
    var printer = Printers.Spite.ExpressionPrinter(target.target)
    var listed = printer.text()
    if may_be_null(value) {
        context.scope.forget_reads_of(listed)
        return
    }
    context.scope.forget_below_the_items(listed)
}

func build_evaluation(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    if statement.shows_the_locals {
        note_the_locals(statement.line)
    }
    var renewing = renewed_by_a_loop(context.block_statements, context.block_index)
    if renewing {
        forget_what_the_call_writes(statement.value)
        return
    }
    var value = values.value_of(statement.value, null)
    refuse_a_dropped_answer(statement, value)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(value)
    made.line = statement.line
    add(made)
    forget_what_the_call_writes(statement.value)
    forget_what_a_receiver_call_shrinks(value)
}

# ../../../spite_spec/specs/repl.md#command-language
func note_the_locals(line: Integer) {
    var noting = BreakpointLocals(context)
    var texts = noting.statements_on(line)
    var path = context.path()
    var index = 0
    while index < texts.count() {
        var written = texts[index]
        var lexer = AbstractSyntaxTree.Lexer.Lexer(path, written, line)
        var made_tokens = lexer.tokens_of()
        var parser = AbstractSyntaxTree.Parser.Parser(path, "", made_tokens)
        var parsed = parser.statement()
        build(parsed)
        index = index + 1
    }
    context.line = line
}

func forget_what_the_call_writes(written: Expression?) {
    if written == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        forget_after_a_call(written)
    }
}

func forget_after_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        forget_after_an_own_call(callee.name)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        forget_after_a_shrinking_call(callee)
    }
}

func forget_after_a_shrinking_call(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var shrunk = ShrunkLists()
    fallback shrunk.is_shrinking(callee.name)
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var listed = printer.text()
    context.scope.forget_reads_of(listed)
    var windows = Windows(context, values)
    windows.forget_a_list(listed)
    windows.forget_an_area_list(listed)
    var counts = context.counted_lists.keys()
    var index = 0
    while index < counts.count() {
        var count_name = counts[index]
        forget_a_count_of(count_name, listed)
        index = index + 1
    }
}

func forget_a_count_of(count_name: String, listed: String) {
    var counted = context.counted_lists[count_name]
    crash counted
    var printer = Printers.Spite.ExpressionPrinter(counted)
    if printer.text() == listed {
        context.counted_lists.remove_at(count_name)
    }
}

func forget_what_a_receiver_call_shrinks(value: Value) {
    if value == HighIntermediaryRepresentation.Values.Call {
        forget_after_a_receiver_call(value)
    }
}

func forget_after_a_receiver_call(call: HighIntermediaryRepresentation.Values.Call) {
    var receiver = call.receiver
    var is_reached = receiver == HighIntermediaryRepresentation.Values.Call
    is_reached = is_reached or receiver == HighIntermediaryRepresentation.Values.Conversion
    fallback is_reached
    var owner = context.program.class_named(call.function.owner)
    fallback owner
    var library = Validators.LibraryFile()
    fallback not library.holds(owner.file.path)
    var shrunk = ShrunkLists()
    if shrunk.through_reads(owner, call.function) {
        context.scope.forget_every_read()
    }
}

func forget_after_an_own_call(called: String) {
    var function = context.current_class.function_named(called)
    fallback function
    fallback function.declaration
    var reader = WrittenAttributes()
    var names = reader.of(function.declaration)
    var index = 0
    while index < names.count() {
        var name = names[index]
        if not context.scope.internal_name_of(name) {
            context.scope.forget_mentions(name)
        }
        index = index + 1
    }
}

func build_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if not context.current_function.answer {
        if statement.value {
            typing.refuse_answer_from_nothing(context)
        }
        var nothing = HighIntermediaryRepresentation.Statements.Return(null)
        nothing.line = statement.line
        add(nothing)
        return
    }
    var answer: Model.Type = context.current_function.answer
    if not statement.value {
        var shown = context.shown(answer)
        typing.refuse_missing_answer(context, shown)
    }
    var value = values.fitted_value_of(statement.value, answer)
    var made = HighIntermediaryRepresentation.Statements.Return(value)
    made.line = statement.line
    add(made)
}

func build_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var written = statement.condition
    crash statement.condition
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    var written_condition = printer.text()
    note_a_proven_condition(written)
    statement.condition = values.with_its_links(statement.condition)
    note_a_maybe_boolean(written, statement.condition)
    var build_reads_before = context.folded_build_reads
    var condition = values.condition_of(statement.condition)
    note_a_check_of_a_proven_value(written, condition, "if")
    note_a_decided_condition(condition, "if", written, build_reads_before)
    flush_the_pending()
    if condition == HighIntermediaryRepresentation.Values.WholeNumber {
        build_a_decided_if(statement, condition.number != 0)
        return
    }
    log_a_value(condition, statement.line)
    read_facts(statement.condition)
    note_a_tested_copy(written)
    note_a_terminal_if(statement)
    var paths = facts_paths
    var types = facts_types
    var check = checking_text("if", written, statement.line)
    var then_branch = narrowed_block_of(statement.then_branch, paths, types, check)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if statement.else_branch {
        else_branch = block_of(statement.else_branch)
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, then_branch, else_branch)
    made.line = statement.line
    made.written_condition = written_condition
    add(made)
    if not statement.else_branch and always_leaves(then_branch) {
        facts_paths = List<String>()
        facts_types = List<Model.Type>()
        read_a_negated_fact(statement.condition)
        narrow_all(facts_paths, facts_types)
        note_the_leaving_if(written_condition, statement.line)
        var windows = Windows(context, values)
        windows.note_a_leaving_guard(statement.condition)
    }
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func note_a_check_of_a_proven_value(
    written: Expression?,
    condition: Value,
    keyword: String,
) {
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    fallback not is_a_walk and not is_generic
    var tested_written = written
    var tested_condition = condition
    if tested_written == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested_written.operator == 'not' {
        tested_written = tested_written.operand
        if tested_condition == HighIntermediaryRepresentation.Values.Negation {
            crash tested_condition.negated
            tested_condition = tested_condition.negated
        }
    }
    fallback is_a_bare_path(tested_written)
    fallback tested_condition == HighIntermediaryRepresentation.Values.PresenceTest
    crash tested_condition.tested
    var tested = tested_condition.tested
    var is_a_name = tested == HighIntermediaryRepresentation.Values.LocalRead
    is_a_name = is_a_name or tested == HighIntermediaryRepresentation.Values.AttributeRead
    fallback is_a_name and tested.value_type.is_nullable
    crash tested_written
    var printer = Printers.Spite.ExpressionPrinter(tested_written)
    var site = CheckSite("proven value", context)
    site.written = printer.text()
    site.keyword = keyword
    site.tested = tested
    context.note_a_check_site(site)
}

func note_a_check_of_a_plain_value(condition: Expression?, keyword: String) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        note_a_check_of_a_plain_name(condition, keyword)
    }
}

func note_a_check_of_a_plain_name(
    condition: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    keyword: String,
) {
    var is_a_member = is_a_parameter(condition.name) or context.current_class.attribute_named(condition.name)
    var local_name = context.scope.internal_name_of(condition.name)
    if local_name and not is_a_member {
        note_a_check_of_a_plain_local(local_name, keyword)
        return
    }
    var is_declared_plainly = is_a_parameter(condition.name) or context.current_class.attribute_named(condition.name)
    fallback is_declared_plainly
    var written_value = values.value_of(condition, null)
    var site = CheckSite("plain value", context)
    site.is_converted = written_value == HighIntermediaryRepresentation.Values.Conversion
    site.checked_type = written_value.value_type
    site.keyword = keyword
    context.note_a_check_site(site)
}

func note_a_plain_local(
    name: String,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    local_type: Model.Type,
) {
    fallback not local_type.is_nullable
    var function = context.current_function
    var is_a_walk = not function.bound_parameter.is_empty() or not function.bound_member.is_empty()
    var is_generic = not context.current_class.bound_types.is_empty()
    var written = statement.value
    var is_made = false
    if written == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        is_made = names_a_class(written.callee)
    }
    var is_the_same_everywhere = not is_a_walk and not is_generic
    fallback statement.declared_type or is_made or is_the_same_everywhere
    context.plain_locals.append(name)
}

func names_a_class(callee: Expression?): Boolean {
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var first = callee.name.byte_at(0)
        return first >= 65 and first <= 90
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.is_a_class_name
    }
    return false
}

func note_a_check_of_a_plain_local(local_name: String, keyword: String) {
    fallback context.plain_locals.contains(local_name)
    var declared_type = context.scope.types[local_name]
    fallback declared_type
    var site = CheckSite("plain value", context)
    site.checked_type = declared_type
    site.keyword = keyword
    context.note_a_check_site(site)
}

func is_a_parameter(name: String): Boolean {
    var index = 0
    while index < context.current_function.parameters.count() {
        var parameter = context.current_function.parameters[index]
        if parameter.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_leaving_if(written_condition: String, line: Integer) {
    var index = 0
    while index < facts_paths.count() {
        var path = facts_paths[index]
        context.scope.note_the_check(path, "the 'if {written_condition}' on line {line}, which leaves")
        index = index + 1
    }
}

func always_leaves(block: HighIntermediaryRepresentation.Statements.Block): Boolean {
    return endings.always_leaves(block)
}

func read_a_negated_fact(condition: Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_negated_unary(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_negated_binary(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_an_empty_question(condition)
    }
}

func read_a_negated_unary(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    fallback unary.operator == 'not'
    read_a_fact(unary.operand)
}

func read_a_negated_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'or' {
        read_a_negated_fact(binary.left)
        context.scope.enter()
        narrow_all(facts_paths, facts_types)
        read_a_negated_fact(binary.right)
        context.scope.leave()
        return
    }
    var left = binary.left
    if left == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_negated_count(binary, left)
        return
    }
    if binary.operator == 'greater' {
        read_a_bound_at_most(binary)
        return
    }
    fallback binary.operator == 'greater_or_equal'
    var counted = binary.right
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(binary, counted)
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func read_a_bound_at_most(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var sum = binary.left
    if sum == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression and binary.right {
        read_a_sum_at_most(sum, binary.right)
    }
}

func read_a_sum_at_most(
    sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: Expression,
) {
    var name = added_name_of(sum)
    var reach = added_reach_of(sum)
    fallback not name.is_empty() and reach > 0
    crash sum.left
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(sum.left, 'less', counted)
    if reach > 1 {
        var lowered_text: String = reach - 1
        var lowered = AbstractSyntaxTree.Shapes.Expressions.LiteralExpression('integer_literal', lowered_text)
        var index = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(sum.left, 'plus', lowered)
        turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(index, 'less', counted)
    }
    read_a_binary_bound(turned)
}

func read_a_negated_count(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var opposite: AbstractSyntaxTree.Tokens.Token.Kind = 'equal_equal'
    switch binary.operator {
        'not_equal': opposite = 'equal_equal'
        'less': opposite = 'greater_or_equal'
        'less_or_equal': opposite = 'greater'
        'equal_equal': opposite = 'not_equal'
        _: return
    }
    crash binary.right
    var negated = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(counted, opposite, binary.right)
    read_a_count_fact(negated, counted)
}

func build_a_decided_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement, holds: Boolean) {
    context.note_a_folded_branch()
    if holds {
        var taken = block_of(statement.then_branch)
        add(taken)
        rest_is_folded_away = endings.always_leaves(taken)
        return
    }
    fallback statement.else_branch
    var other = block_of(statement.else_branch)
    add(other)
    rest_is_folded_away = endings.always_leaves(other)
}

func build_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    fallback not renewed_the_lists(statement)
    template_walks.check(context, statement)
    refuse_an_unstepped_poll(statement)
    note_a_loop_copy(statement.condition)
    note_a_maybe_boolean(statement.condition, statement.condition)
    var base = context.scope.narrowed.count()
    context.loop_bases.append(base)
    var log_start = context.logged_calls.count()
    var reads_start = context.narrowed_reads.count()
    var written_condition = statement.condition
    var build_reads_before = context.folded_build_reads
    var condition = values.condition_of(statement.condition)
    note_a_check_of_a_proven_value(written_condition, condition, "while")
    note_a_decided_condition(condition, "while", written_condition, build_reads_before)
    var condition_work = context.pending
    flush_the_pending()
    log_a_value(condition, statement.line)
    facts_paths = List<String>()
    facts_types = List<Model.Type>()
    facts_checks = List<String>()
    read_a_bound(statement.condition)
    read_a_present_path(statement.condition)
    var paths = facts_paths
    var types = facts_types
    var notes = facts_checks
    var check = checking_text("while", statement.condition, statement.line)
    var noted = notes_with(paths, notes, check)
    var body = loop_body_of(statement.body, paths, types, noted)
    redo_the_condition_work(condition_work, body)
    extend_the_reads_over_the_loop(log_start, reads_start)
    crash context.loop_bases.remove_last()
    if context.loop_bases.is_empty() {
        context.loop_reads = List<String>()
    }
    var made = HighIntermediaryRepresentation.Statements.While(condition, body)
    made.line = statement.line
    add(made)
}

func called_alone(
    statement: WrittenStatement,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var plain = value.arguments.is_empty() and value.generic_arguments.is_empty()
            if plain {
                return value
            }
        }
    }
    return null
}

# ../../OPTIMIZATIONS.md#a-list-of-lists-cleared-and-filled-with-new-lists-keeps-their-room
func renewed_by_a_loop(
    written: List<WrittenStatement>,
    clear_index: Integer,
): AbstractSyntaxTree.Shapes.Statements.WhileStatement? {
    var clearing = written[clear_index]
    fallback clearing
    var list_name = cleared_list_of(clearing)
    fallback not list_name.is_empty()
    var next_index = clear_index + 1
    var declared = ""
    var between = written[next_index]
    if between and between == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        fallback not between.declared_type and is_a_fixed_bound(between.value)
        declared = between.name
        next_index = next_index + 1
    }
    var looping = written[next_index]
    if looping and looping == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        var refilled = refills_with_new_lists(looping, list_name, declared)
        if refilled {
            return looping
        }
    }
    return null
}

func cleared_list_of(statement: WrittenStatement): String {
    var cleared = called_alone(statement)
    fallback cleared
    var callee = cleared.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "clear" {
        return name_of(callee.target)
    }
    return ""
}

func refills_with_new_lists(
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    list_name: String,
    declared: String,
): Boolean {
    var condition = loop.condition
    fallback loop.body
    fallback loop.body.statements.count() == 3
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var counter = name_of(condition.left)
        fallback condition.operator == 'less' and not counter.is_empty() and counter != list_name
        fallback is_a_fixed_bound(condition.right)
        fallback counter == declared or counts_whole_numbers(counter)
        return refills_in(loop.body, list_name, counter)
    }
    return false
}

func refills_in(body: AbstractSyntaxTree.Shapes.Statements.Block, list_name: String, counter: String): Boolean {
    var making = body.statements[0]
    var appending = body.statements[1]
    var stepping = body.statements[2]
    crash making
    crash appending
    crash stepping
    fallback steps_by_one(stepping, counter)
    if making == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        var made_name = making.name
        fallback not making.declared_type and made_name != list_name and made_name != counter
        fallback appends_the_made(appending, list_name, made_name)
        return makes_an_empty_item_of(making.value, list_name)
    }
    return false
}

func appends_the_made(
    statement: WrittenStatement,
    list_name: String,
    made_name: String,
): Boolean {
    var appended = called_with_one(statement)
    fallback appended
    var callee = appended.callee
    var passed = appended.arguments.first()
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var on_the_list = callee.name == "append" and name_of(callee.target) == list_name
        return on_the_list and name_of(passed) == made_name
    }
    return false
}

func called_with_one(
    statement: WrittenStatement,
): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var one = value.arguments.count() == 1 and value.generic_arguments.is_empty()
            if one {
                return value
            }
        }
    }
    return null
}

func makes_an_empty_item_of(made: Expression?, list_name: String): Boolean {
    if made == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        fallback made.arguments.is_empty() and not made.generic_arguments.is_empty()
        var item_type = renewed_item_type_of(list_name)
        fallback item_type
        var path = values.class_path_of(made.callee)
        fallback not path.is_empty()
        var made_type = context.resolver.class_type_in(path, made.generic_arguments, context.current_class, context.line)
        return made_type.kind == 'object' and made_type.name == item_type.name
    }
    return false
}

func renewed_item_type_of(list_name: String): Model.Type? {
    var list_type = type_of_a_name(list_name)
    fallback list_type
    fallback list_type.kind == 'object' and not list_type.is_nullable and context.has_a_class(list_type)
    var list_class = context.class_of(list_type)
    var renewing = list_class.function_named("_renew_lists")
    var item_type = list_class.bound_types["$element_type"]
    fallback renewing and item_type
    fallback item_type.kind == 'object' and not item_type.is_nullable and context.has_a_class(item_type)
    var item_class = context.class_of(item_type)
    var item_renewing = item_class.function_named("_renew_lists")
    if item_renewing {
        return item_type
    }
    return null
}

func renewed_the_lists(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement): Boolean {
    var clear_index = context.block_index - 1
    var before = context.block_statements[clear_index]
    if before and before == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        clear_index = clear_index - 1
    }
    fallback clear_index >= 0
    var renewed = renewed_by_a_loop(context.block_statements, clear_index)
    fallback renewed and renewed.line == statement.line
    var clearing = context.block_statements[clear_index]
    crash clearing
    var list_name = cleared_list_of(clearing)
    var condition = statement.condition
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        crash condition.right
        build_the_renewal(statement, condition, list_name, condition.right)
        return true
    }
    return false
}

func build_the_renewal(
    statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    list_name: String,
    bound: Expression,
) {
    var counter = name_of(condition.left)
    var counted = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var wanted = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(bound, 'minus', counted)
    var renewing_arguments = List<Expression>()
    renewing_arguments.append(wanted)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var renewed_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var renewing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(renewed_list, "clear")
    var renewing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(renewing_callee, no_generics, renewing_arguments)
    var renewal = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(renewing)
    renewal.line = statement.line
    var finished_counter = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var finishing = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(finished_counter, bound)
    finishing.line = statement.line
    var inside = List<WrittenStatement>()
    inside.append(renewal)
    inside.append(finishing)
    var then_block = AbstractSyntaxTree.Shapes.Statements.Block(inside)
    then_block.line = statement.line
    then_block.end_line = statement.line
    var cleared_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var clearing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(cleared_list, "clear")
    var no_arguments = List<Expression>()
    var clearing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(clearing_callee, no_generics, no_arguments)
    var cleared = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(clearing)
    cleared.line = statement.line
    var otherwise = List<WrittenStatement>()
    otherwise.append(cleared)
    var else_block = AbstractSyntaxTree.Shapes.Statements.Block(otherwise)
    else_block.line = statement.line
    else_block.end_line = statement.line
    var once = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, then_block, else_block)
    once.line = statement.line
    context.renews_the_lists = true
    build(once)
    context.renews_the_lists = false
}

func name_of(expression: Expression?): String {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name
    }
    return ""
}

func counts_whole_numbers(counter: String): Boolean {
    var counter_type = type_of_a_name(counter)
    fallback counter_type
    return counter_type.kind == 'scalar' and counter_type.name == "Integer" and not counter_type.is_nullable
}

func is_a_fixed_bound(bound: Expression?): Boolean {
    if bound == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return bound.kind == 'integer_literal'
    }
    return false
}

func steps_by_one(statement: WrittenStatement, counter: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target_name = name_of(statement.target)
        return target_name == counter and adds_one_to(statement.value, counter)
    }
    return false
}

func adds_one_to(value: Expression?, counter: String): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var added_to = name_of(value.left)
        return added_to == counter and value.operator == 'plus' and is_one(value.right)
    }
    return false
}

func is_one(step: Expression?): Boolean {
    if step == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return step.kind == 'integer_literal' and step.text == "1"
    }
    return false
}

func type_of_a_name(name: String): Model.Type? {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return context.scope.type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func redo_the_condition_work(
    work: List<Statement>,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    var index = 0
    while index < work.count() {
        var done = work[index]
        redo_a_step(done, body)
        index = index + 1
    }
}

func redo_a_step(
    done: Statement,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    if done == HighIntermediaryRepresentation.Statements.Declare {
        redo_a_declaration(done, body)
        return
    }
    fallback done == HighIntermediaryRepresentation.Statements.If
    redo_a_decision(done, body)
}

func redo_a_decision(
    done: HighIntermediaryRepresentation.Statements.If,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    crash done.condition
    var deciding = HighIntermediaryRepresentation.Statements.Block()
    var index = 0
    while index < done.then_branch.statements.count() {
        var step = done.then_branch.statements[index]
        if step == HighIntermediaryRepresentation.Statements.Assign.Assign {
            crash step.value
            var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(step.name, step.value)
            assigned.line = step.line
            deciding.statements.append(assigned)
        } else {
            redo_a_step(step, deciding)
        }
        index = index + 1
    }
    var again = HighIntermediaryRepresentation.Statements.If(done.condition, deciding, null)
    again.line = done.line
    body.statements.append(again)
}

func redo_a_declaration(
    done: HighIntermediaryRepresentation.Statements.Declare,
    body: HighIntermediaryRepresentation.Statements.Block,
) {
    crash done.value
    var again = HighIntermediaryRepresentation.Statements.Assign.Assign(done.name, done.value)
    again.line = done.line
    body.statements.append(again)
}

func refuse_an_unstepped_poll(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var whole = AbstractSyntaxTree.Walk.Walk(no_file)
    whole.read_expression(statement.condition)
    whole.read_block(statement.body)
    var index = 0
    while index < whole.expressions.count() {
        var found = whole.expressions[index]
        fallback not is_a_call(found.expression)
        index = index + 1
    }
    var tested = AbstractSyntaxTree.Walk.Walk(no_file)
    tested.read_expression(statement.condition)
    var tested_index = 0
    while tested_index < tested.expressions.count() {
        var found_test = tested.expressions[tested_index]
        refuse_a_polled_handle(found_test.expression)
        tested_index = tested_index + 1
    }
}

func is_a_call(expression: Expression?): Boolean {
    return expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression
}

func refuse_a_polled_handle(expression: Expression?) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refuse_a_polled_member(expression)
    }
}

func refuse_a_polled_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback member.name == "finished"
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        refuse_a_polled_name(target.name)
    }
}

func refuse_a_polled_name(name: String) {
    var internal_name = context.scope.internal_name_of(name)
    fallback internal_name
    var polled_type = context.scope.type_of(internal_name)
    fallback polled_type
    fallback polled_type.kind == 'handle' and polled_type.name == "Concurrent"
    typing.refuse_unstepped_poll(context, name)
}

func read_a_present_path(condition: Expression?) {
    var is_a_path = condition == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback is_a_path
    read_a_fact(condition)
}

func read_a_bound(condition: Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_bound(condition)
    }
}

func read_a_binary_bound(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if condition.operator == 'and' {
        read_a_bound(condition.left)
        read_a_bound(condition.right)
        return
    }
    if condition.operator == 'less_or_equal' {
        read_a_bound_at_most(condition)
        return
    }
    var left = condition.left
    var counts = condition.operator == 'equal_equal' or condition.operator == 'greater_or_equal'
    counts = counts or condition.operator == 'greater' or condition.operator == 'not_equal'
    if counts and left == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count_fact(condition, left)
        return
    }
    var counted = condition.right
    fallback condition.operator == 'less'
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
    if counted == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_windowed_counter(condition)
        read_a_counted_local(condition, counted)
    }
    if counted == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_lowered_count(condition, counted)
    }
}

# ../../PROOFS.md#an-index-offset-by-a-base-is-proven-by-one-guard
func read_a_windowed_counter(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var windows = Windows(context, values)
    windows.read_a_counter(condition)
    var index = 0
    while index < windows.proven_paths.count() {
        var path = windows.proven_paths[index]
        var present = windows.proven_types[index]
        crash present
        facts_paths.append(path)
        facts_types.append(present)
        note_a_loop_check(condition)
        index = index + 1
    }
}

func read_a_lowered_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    lowered: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    fallback lowered.operator == 'minus'
    var counted = lowered.left
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
}

func read_a_counted_local(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var internal_name = context.scope.internal_name_of(counted.name)
    fallback internal_name
    var listed = context.counted_lists[internal_name]
    fallback listed
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var list_value = values.value_of(listed, null)
    fallback context.has_a_class(list_value.value_type) and not list_value.value_type.is_nullable
    var owner = context.class_of(list_value.value_type)
    fallback values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(listed)
    var list_text = printer.text()
    facts_paths.append("{list_text}[{index_name}]")
    facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        facts_paths.append("{list_text}[{index_name} + {offset}]")
        facts_types.append(present)
        offset = offset + 1
    }
}

func note_a_loop_check(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    while facts_checks.count() < facts_paths.count() - 1 {
        facts_checks.append("")
    }
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    facts_checks.append("the loop condition '{written}'")
}

func holds_maybes(listing: Model.ClassModel): Boolean {
    var item_type = listing.bound_types["$element_type"]
    if item_type {
        return item_type.is_nullable
    }
    return false
}

func read_a_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_list(condition, counted, callee)
    }
}

func read_a_counted_list(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var listed = values.value_of(callee.target, null)
    fallback context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    fallback values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var element: Model.Type = reader.answer
    var present = element.present()
    facts_paths.append("{list_text}[{index_name}]")
    facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        facts_paths.append("{list_text}[{index_name} + {offset}]")
        facts_types.append(present)
        offset = offset + 1
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func whole_index_of(left: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    fallback not holds_a_call(left)
    var printer = Printers.Spite.ExpressionPrinter(left)
    return printer.text()
}

func added_name_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var left = sum.left
    fallback sum.operator == 'plus'
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return left.name
    }
    return ""
}

func added_reach_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    var right = sum.right
    if right == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(right)
    }
    return 0
}

func literal_reach_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    var number = literal.text.to_integer()
    fallback literal.kind == 'integer_literal' and number
    return number
}

func build_inner_block(statement: AbstractSyntaxTree.Shapes.Statements.Block) {
    var made = block_of(statement)
    add(made)
}

func build_fallback(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement) {
    note_a_proven_check(statement.condition)
    note_a_proven_read_check(statement.condition, "fallback")
    note_a_check_of_a_plain_value(statement.condition, "fallback")
    note_a_repeated_check(statement.condition, statement.line)
    note_a_proven_divisor(statement.condition, statement.line)
    var written_condition = statement.condition
    statement.condition = values.with_its_links(statement.condition)
    var build_reads_before = context.folded_build_reads
    var condition = values.condition_of(statement.condition)
    note_a_check_that_always_holds(condition, "fallback", written_condition)
    note_a_check_of_a_proven_value(written_condition, condition, "fallback")
    note_a_decided_condition(condition, "fallback", written_condition, build_reads_before)
    var failed = HighIntermediaryRepresentation.Statements.Block()
    var noting = noted_failure(statement)
    if noting {
        failed.statements.append(noting)
    }
    var leaving = default_return(written_condition)
    failed.statements.append(leaving)
    if condition == HighIntermediaryRepresentation.Values.WholeNumber and condition.number == 0 {
        context.note_a_folded_branch()
        failed.line = statement.line
        add(failed)
        rest_is_folded_away = true
        return
    }
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    add(made)
    var operands = operands_of(statement.condition)
    read_facts(statement.condition)
    if noting {
        var kind = "fallback-predicate"
        if not facts_paths.is_empty() {
            kind = "fallback-narrowing"
        }
        note_a_crash_site(last_site_identity, statement.line, statement.column, kind, statement.condition, operands)
    }
    narrow_all(facts_paths, facts_types)
    note_the_checks("fallback", statement.condition, statement.line)
    var windows = Windows(context, values)
    windows.note_a_guard(statement.condition)
}

func operands_of(condition: Expression?): String {
    var names = List<String>()
    gather_the_names(condition, names)
    var described = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
        var read = values.value_of(identifier, null)
        var shown = context.shown(read.value_type)
        described.append("{name}:{shown}")
        index = index + 1
    }
    return described.join(" ")
}

func note_a_crash_site(
    identity: String,
    line: Integer,
    column: Integer,
    kind: String,
    condition: Expression?,
    operands: String,
) {
    var source = ""
    if condition {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        source = printer.text()
    }
    var owner = context.current_function.owner
    var shown_owner = last_part_of(owner)
    var function_name = context.current_function.name
    var written_path = context.path()
    var path = written_path.replace("\\", "/")
    var site = "{identity}\t{path}\t{line}\t{column}\t{shown_owner}\t{function_name}\t{kind}\t{source}\t{operands}"
    context.crash_sites.append(site)
}

func noted_failure(
    statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
): Statement? {
    var symbols = context.resolver.symbols
    var path = context.path()
    fallback not symbols.is_library_path(path)
    var ring = assert_ring()
    fallback ring
    var failing = ring.function_named("failed")
    crash failing
    values.need(failing)
    var site = site_line(statement.condition, statement.line, "spite.fallback")
    var answered = answered_by_a_fallback()
    var site_text = values.described_text("{site}\treturned={answered}")
    var streams = 0
    var asked = context.build_flags["trace_fallbacks"]
    if asked == "true" {
        streams = 1
    }
    var boolean = context.boolean()
    var streaming = HighIntermediaryRepresentation.Values.WholeNumber(boolean, streams)
    var passed = List<Value>()
    passed.append(site_text)
    passed.append(streaming)
    var fetched = ring_object(ring)
    var called = HighIntermediaryRepresentation.Values.Call(failing, fetched, passed)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(called)
    evaluated.line = statement.line
    return evaluated
}

func answered_by_a_fallback(): String {
    var answered = "nothing"
    if context.current_function.answer {
        answered = answered_by(context.current_function.answer)
    }
    return answered
}

func answered_by(answer: Model.Type): String {
    var shown = context.shown(answer)
    if not answer.is_nullable and is_a_collection(answer, shown) {
        return "empty"
    }
    return "null"
}

func assert_ring(): Model.ClassModel? {
    fallback context.resolver.symbols.program_asserts
    var found = context.resolver.symbols.find("Spite.Asserts", "")
    fallback found
    var ring = context.resolver.class_model_named("Spite.Asserts")
    fallback ring
    context.need_defaults(ring.key)
    return ring
}

func ring_object(ring: Model.ClassModel): Value {
    var ring_type = ring.type_of_an_instance()
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(ring_type, null, no_arguments)
}

func site_line(condition: Expression?, line: Integer, kind: String): String {
    var function_name = context.current_function.name
    var identity = identity_of_a_site(condition, "")
    last_site_identity = identity
    var owner = context.current_function.owner
    var asked = context.build_flags["optimized"]
    if asked == "true" {
        return "{kind}\t{identity}"
    }
    var shown_owner = last_part_of(owner)
    return "{kind}\t{identity}\t{context.path()}:{line}\t{shown_owner}\t{function_name}"
}

func identity_of_a_site(condition: Expression?, counted_as: String): String {
    var owner = context.current_function.owner
    var function_name = context.current_function.name
    var source = ""
    if condition {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        source = printer.text()
    }
    var place_key = "{owner}.{function_name}{counted_as}"
    var ordinal = 0
    var known = context.site_ordinals[place_key]
    if known {
        ordinal = known
    }
    context.site_ordinals[place_key] = ordinal + 1
    var hashed = "{owner}|{function_name}|{ordinal}|{source}"
    if not counted_as.is_empty() {
        hashed = "{counted_as}|{hashed}"
    }
    return site_identity(hashed)
}

func last_part_of(owner: String): String {
    var parts = owner.split(".")
    var last_index = parts.count() - 1
    var last = parts[last_index]
    crash last
    return last
}

func site_identity(written: String): String {
    var high = 0
    var low = 0
    var index = 0
    while index < written.length() {
        var code = written.byte_at(index)
        var mixed_high = high * 31 + code
        high = mixed_high % 65521
        var mixed_low = low * 131 + code
        low = mixed_low % 65519
        index = index + 1
    }
    var high_digits = four_hexadecimal_digits(high)
    var low_digits = four_hexadecimal_digits(low)
    return "{high_digits}{low_digits}"
}

func four_hexadecimal_digits(number: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = number
    var place = 0
    while place < 4 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        crash character
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

func default_return(
    written_condition: Expression?,
): Statement {
    if not context.current_function.answer {
        return HighIntermediaryRepresentation.Statements.Return(null)
    }
    var answer: Model.Type = context.current_function.answer
    if answer.is_nullable {
        var nothing = HighIntermediaryRepresentation.Values.NullConstant(answer)
        return HighIntermediaryRepresentation.Statements.Return(nothing)
    }
    var full_name = context.shown(answer)
    var is_built_empty = is_built_with_no_arguments(answer)
    if is_a_collection(answer, full_name) or is_built_empty {
        var empty = values.default_of_a_type(answer)
        return HighIntermediaryRepresentation.Statements.Return(empty)
    }
    var site = GuardSite("default", context)
    site.condition = written_condition
    context.note_a_guard_site(site)
    return HighIntermediaryRepresentation.Statements.Return(null)
}

func is_built_with_no_arguments(answer: Model.Type): Boolean {
    if answer.kind == 'scalar' {
        return true
    }
    fallback answer.kind == 'object'
    if answer.name == "String" {
        return true
    }
    fallback context.has_a_class(answer)
    var model = context.class_of(answer)
    fallback not model.is_singleton
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        fallback not function.is_constructor or function.parameters.count() <= 0
        index = index + 1
    }
    return true
}

func is_a_collection(answer: Model.Type, shown: String): Boolean {
    fallback answer.kind == 'object'
    var collections = ["List<", "Dictionary<", "Vector<", "Items<"]
    var index = 0
    while index < collections.count() {
        var opening = collections[index]
        if shown.starts_with(opening) {
            return true
        }
        index = index + 1
    }
    return false
}

func build_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    var message = "spite: the program stopped at {context.path()}:{statement.line} in {context.current_function.owner}.{context.current_function.name}"
    shown_parts = List<ShownPart>()
    shown_texts = List<String>()
    reads_before = false
    if always_stops(statement.condition) {
        var always = identity_of_a_site(null, "|crash")
        note_a_crash_site(always, statement.line, statement.column, "crash", null, "")
        var nothing_mentioned = List<String>()
        var stopping = report_of(message, null, nothing_mentioned, statement.line)
        stopping.each(add)
        return
    }
    note_a_proven_check(statement.condition)
    note_a_proven_read_check(statement.condition, "crash")
    note_a_check_of_a_plain_value(statement.condition, "crash")
    note_a_repeated_check(statement.condition, statement.line)
    note_a_proven_divisor(statement.condition, statement.line)
    refuse_a_false_build_field(statement)
    var identity = identity_of_a_site(statement.condition, "|crash")
    var written = statement.condition
    crash written
    context.line = statement.line
    var held_before = reported_count
    var rewritten = held_for_the_report(written, 2, 0, true)
    var mentioned = List<String>()
    gather_every_name(written, mentioned)
    statement.condition = values.with_its_links(statement.condition)
    var linked = statement.condition
    var unheld: Value? = null
    if reported_count > held_before {
        unheld = folded_unheld_crash(statement)
        linked = values.with_its_links(rewritten)
    }
    var condition = values.condition_of(linked)
    refuse_a_folded_crash(statement, condition)
    note_a_check_that_always_holds(condition, "crash", written)
    note_a_check_of_a_proven_value(written, condition, "crash")
    flush_the_pending()
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements = report_of(message, written, mentioned, statement.line)
    var operands = report_types.join(" ")
    note_a_crash_site(identity, statement.line, statement.column, "crash", written, operands)
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    made.crashes_unless = printer.text()
    made.decided_condition = unheld
    add(made)
    read_facts(statement.condition)
    narrow_all(facts_paths, facts_types)
    note_the_checks("crash", statement.condition, statement.line)
    var windows = Windows(context, values)
    windows.note_a_guard(statement.condition)
}

func crash_report(): Value? {
    var ring = assert_ring()
    fallback ring
    var reporting = ring.function_named("report")
    crash reporting
    values.need(reporting)
    var no_arguments = List<Value>()
    var fetched = ring_object(ring)
    return HighIntermediaryRepresentation.Values.Call(reporting, fetched, no_arguments)
}

func report_of(
    message: String,
    condition: Expression?,
    mentioned: List<String>,
    line: Integer,
): List<Statement> {
    var outer = built
    built = List<Statement>()
    report_types = List<String>()
    shown_count = 0
    var fault = fault_class()
    if fault {
        context.scope.enter()
        write_the_report(message, condition, mentioned, line)
        context.scope.leave()
    } else {
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = line
        add(stopped)
    }
    var made = built
    built = outer
    return made
}

func write_the_report(
    message: String,
    condition: Expression?,
    mentioned: List<String>,
    line: Integer,
) {
    var text = context.text()
    report_name = context.scope.declare("___report", text)
    var empty = values.described_text("")
    var declared = HighIntermediaryRepresentation.Statements.Declare(report_name, text, empty)
    declared.line = line
    add(declared)
    var is_a_narrowing = false
    if condition {
        is_a_narrowing = reports_what_is_missing(condition)
    }
    if not is_a_narrowing {
        shown_parts.each(show_a_part)
        show_the_values_in_scope(mentioned)
    }
    var head = values.described_text(message)
    var body = HighIntermediaryRepresentation.Values.LocalRead(text, report_name)
    var crashed_arguments = List<Value>()
    crashed_arguments.append(head)
    crashed_arguments.append(body)
    var crashed = fault_call("crashed", crashed_arguments)
    evaluate_at(crashed, line)
    if context.resolver.symbols.program_asserts {
        var ring_report = crash_report()
        crash ring_report
        evaluate_at(ring_report, line)
    }
    var no_arguments = List<Value>()
    var walked = fault_call("frames", no_arguments)
    evaluate_at(walked, line)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("")
    stopped.line = line
    add(stopped)
}

func evaluate_at(value: Value, line: Integer) {
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(value)
    evaluated.line = line
    add(evaluated)
}

func fault_class(): Model.ClassModel? {
    var found = context.resolver.symbols.find("Spite.Fault", "")
    fallback found
    var fault = context.resolver.class_model_named("Spite.Fault")
    fallback fault
    context.need_defaults(fault.key)
    return fault
}

func fault_call(
    name: String,
    arguments: List<Value>,
): Value {
    var fault = fault_class()
    crash fault
    var function = fault.function_named(name)
    crash function
    values.need(function)
    var made = ring_object(fault)
    return HighIntermediaryRepresentation.Values.Call(function, made, arguments)
}

func held_for_the_report(
    expression: Expression,
    mode: Integer,
    at_failure: Integer,
    is_whole: Boolean,
): Expression {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return held_name(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return held_member(expression, mode)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return held_index(expression, mode)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return held_call(expression, mode, is_whole)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return held_binary(expression, mode, at_failure)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return held_unary(expression, mode, at_failure, is_whole)
        _: return expression
    }
}

func held_name(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Expression {
    if is_a_value_name(identifier.name) {
        note_a_shown_part(identifier.name, identifier)
        var local = context.scope.internal_name_of(identifier.name)
        if not local {
            reads_before = true
        }
    }
    return identifier
}

func held_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    mode: Integer,
): Expression {
    if mode >= 1 and is_a_value_path(member) {
        var printer = Printers.Spite.ExpressionPrinter(member)
        var printed = printer.text()
        note_a_shown_part(printed, member)
        reads_before = true
        return member
    }
    crash member.target
    var target = held_for_the_report(member.target, mode, -1, false)
    reads_before = true
    var made = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, member.name)
    made.is_a_class_name = member.is_a_class_name
    return made
}

func held_index(
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    mode: Integer,
): Expression {
    if mode >= 1 and is_a_value_path(read) {
        var printer = Printers.Spite.ExpressionPrinter(read)
        var printed = printer.text()
        note_a_shown_part(printed, read)
        reads_before = true
        return read
    }
    crash read.target
    crash read.index
    var target = held_for_the_report(read.target, mode, -1, false)
    var index = held_for_the_report(read.index, mode, -1, false)
    reads_before = true
    return AbstractSyntaxTree.Shapes.Expressions.IndexExpression(target, index)
}

func held_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    mode: Integer,
    is_whole: Boolean,
): Expression {
    var before = reads_before
    var printer = Printers.Spite.ExpressionPrinter(call)
    var printed = printer.text()
    var placeholder = ShownPart(printed, null)
    if not shown_texts.contains(printed) and not is_whole {
        shown_parts.append(placeholder)
        shown_texts.append(printed)
    }
    crash call.callee
    var held_callee = held_callee_of(call.callee, mode)
    var arguments = List<Expression>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var held_argument = held_for_the_report(argument, mode, -1, false)
        arguments.append(held_argument)
        index = index + 1
    }
    var rebuilt = AbstractSyntaxTree.Shapes.Expressions.CallExpression(held_callee, call.generic_arguments, arguments)
    if mode >= 1 and is_a_read_call(call) {
        placeholder.value = rebuilt
        reads_before = true
        return rebuilt
    }
    if mode == 2 and not is_whole and not before {
        var held = held_answer_of(rebuilt)
        placeholder.value = held
        return held
    }
    reads_before = true
    return rebuilt
}

func held_callee_of(
    callee: Expression,
    mode: Integer,
): Expression {
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash callee.target
        var target = held_for_the_report(callee.target, mode, -1, false)
        var made = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, callee.name)
        made.is_a_class_name = callee.is_a_class_name
        return made
    }
    return callee
}

func held_answer_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Expression {
    var value = values.value_of(call, null)
    reported_count = reported_count + 1
    var hidden = "___reported_{reported_count}"
    var name = context.scope.declare(hidden, value.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value)
    declared.line = context.line
    add(declared)
    return AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(hidden)
}

func held_binary(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    mode: Integer,
    at_failure: Integer,
): Expression {
    crash binary.left
    crash binary.right
    var is_logical = binary.operator == 'and' or binary.operator == 'or'
    var both_true = binary.operator == 'and' and at_failure == 1
    var both_false = binary.operator == 'or' and at_failure == 0
    var sides_known = both_true or both_false
    var side_failure = -1
    var right_mode = mode
    if sides_known {
        side_failure = at_failure
        right_mode = lower_of(mode, 1)
    } else if is_logical {
        right_mode = 0
    }
    var left = held_for_the_report(binary.left, mode, side_failure, false)
    var right = held_for_the_report(binary.right, right_mode, side_failure, false)
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(left, binary.operator, right)
}

func lower_of(first_mode: Integer, second_mode: Integer): Integer {
    if first_mode < second_mode {
        return first_mode
    }
    return second_mode
}

func held_unary(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
    mode: Integer,
    at_failure: Integer,
    is_whole: Boolean,
): Expression {
    crash unary.operand
    var failure = -1
    var is_a_not = unary.operator == 'not'
    if is_a_not and at_failure >= 0 {
        failure = 1 - at_failure
    }
    var operand = held_for_the_report(unary.operand, mode, failure, is_whole and is_a_not)
    return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression(unary.operator, operand)
}

func note_a_shown_part(text: String, value: Expression) {
    fallback not shown_texts.contains(text)
    var part = ShownPart(text, value)
    shown_parts.append(part)
    shown_texts.append(text)
}

func is_a_value_name(name: String): Boolean {
    var local = context.scope.internal_name_of(name)
    if local {
        return true
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return true
    }
    return false
}

func is_a_value_path(expression: Expression?): Boolean {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return is_a_value_name(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return is_a_value_member(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return is_a_value_read(expression)
        _: return false
    }
}

func is_a_value_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    fallback not member.is_a_class_name
    return is_a_value_path(member.target)
}

func is_a_value_read(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    fallback not holds_a_call(read.index)
    return is_a_value_path(read.target)
}

func is_a_read_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    crash call.callee
    return call.arguments.is_empty() and is_a_read_callee(call.callee)
}

func is_a_read_callee(callee: Expression): Boolean {
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_a_read_of(callee)
    }
    return false
}

func is_a_read_of(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    var reads = ["count", "length", "is_empty"]
    var target = callee.target
    var is_plain = target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_plain = is_plain or target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback reads.contains(callee.name) and is_plain and is_a_value_path(target)
    var read = values.value_of(target, null)
    var shown = context.shown(read.value_type)
    return is_a_collection(read.value_type, shown) or shown == "String"
}

func gather_every_name(expression: Expression?, names: List<String>) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: names.append(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: gather_every_name(expression.target, names)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: gather_both_reads(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: gather_every_call_name(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: gather_both_sides(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: gather_every_name(expression.operand, names)
        _: return
    }
}

func gather_both_reads(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, names: List<String>) {
    gather_every_name(read.target, names)
    gather_every_name(read.index, names)
}

func gather_both_sides(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, names: List<String>) {
    gather_every_name(binary.left, names)
    gather_every_name(binary.right, names)
}

func gather_every_call_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, names: List<String>) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        gather_every_name(callee.target, names)
    }
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        gather_every_name(argument, names)
        index = index + 1
    }
}

func show_a_part(part: ShownPart) {
    fallback part.value
    var value = values.value_of(part.value, null)
    var shown = context.shown(value.value_type)
    report_types.append("{part.text}:{shown}")
    show_a_value(part.text, part.value, value, true)
}

func show_a_value(
    text: String,
    written: Expression,
    value: Value,
    objects_too: Boolean,
) {
    var present = value.value_type.present()
    var shows = can_be_shown(present, objects_too)
    var is_nullable = value.value_type.is_nullable
    if not is_nullable and shows {
        shown_count = shown_count + 1
        append_a_value(text, value)
    }
    if is_nullable and value.value_type.kind != 'handle' {
        shown_count = shown_count + 1
        flush_the_pending()
        var then_branch = shown_when_present(text, written, present, shows)
        var else_branch = block_of_the_missing(written, text)
        var tested = HighIntermediaryRepresentation.Values.PresenceTest(value)
        var made = HighIntermediaryRepresentation.Statements.If(tested, then_branch, else_branch)
        made.line = context.line
        add(made)
    }
}

func shown_when_present(
    text: String,
    written: Expression,
    present: Model.Type,
    shows: Boolean,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    var printer = Printers.Spite.ExpressionPrinter(written)
    var printed = printer.text()
    var path = path_of(written, printed)
    context.scope.narrow(path, present)
    if shows {
        var narrowed = values.value_of(written, null)
        append_a_value(text, narrowed)
    }
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    built = outer
    return made
}

func append_a_value(text: String, value: Value) {
    var shown = text_of_a_shown(value)
    var named = values.described_text(", {text}=")
    var joined = values.joined_with(named, shown)
    append_to_the_report(joined)
}

func append_to_the_report(piece: Value) {
    var text = context.text()
    var current = HighIntermediaryRepresentation.Values.LocalRead(text, report_name)
    var joined = values.joined_with(current, piece)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(report_name, joined)
    assigned.line = context.line
    add(assigned)
}

func can_be_shown(present: Model.Type, objects_too: Boolean): Boolean {
    fallback not present.is_symbol and present.constant.is_empty()
    if present.kind == 'scalar' {
        return not present.name.contains("Address")
    }
    if present.kind == 'enumeration' {
        return true
    }
    fallback present.kind == 'object'
    var text = context.text()
    if present.is_the_same_as(text) {
        return true
    }
    fallback objects_too and context.has_a_class(present)
    var model = context.class_of(present)
    var shown = model.function_named("to_string")
    if shown {
        return shown.parameters.is_empty()
    }
    return false
}

func text_of_a_shown(value: Value): Value {
    var text = context.text()
    var no_arguments = List<Value>()
    if value.value_type.is_the_same_as(text) {
        return cut_text(value)
    }
    if value.value_type.kind == 'enumeration' {
        return values.enum_text(value)
    }
    var written = values.method_call(value, "to_string", no_arguments)
    if value.value_type.kind == 'scalar' {
        return written
    }
    return cut_text(written)
}

func cut_text(value: Value): Value {
    var arguments = List<Value>()
    arguments.append(value)
    return fault_call("cut", arguments)
}

func block_of_the_missing(
    written: Expression,
    printed: String,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    append_the_missing(written, printed)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    built = outer
    return made
}

func append_the_missing(written: Expression, printed: String) {
    if written == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        append_a_missing_item(written, printed)
    } else {
        var missing = values.described_text(", {printed} is null")
        append_to_the_report(missing)
    }
}

func index_type_of(target: Value): Model.Type? {
    fallback context.has_a_class(target.value_type)
    var model = context.class_of(target.value_type)
    var reading = model.function_named("get_at")
    fallback reading
    var first = reading.parameters.first()
    fallback first
    return first.parameter_type
}

func append_a_missing_item(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, printed: String) {
    crash read.target
    crash read.index
    var target = values.value_of(read.target, null)
    var shown_target = context.shown(target.value_type)
    var key_type = index_type_of(target)
    var index_value = values.value_of(read.index, key_type)
    var shows_the_index = can_be_shown(index_value.value_type, true) and not index_value.value_type.is_nullable
    var is_listed = shown_target.starts_with("List<") or shown_target.starts_with("Vector<") or shown_target.starts_with("Items<")
    if is_listed and shows_the_index {
        var no_arguments = List<Value>()
        var counted = values.method_call(target, "count", no_arguments)
        var counted_text = text_of_a_shown(counted)
        var index_text = text_of_a_shown(index_value)
        var opening = values.described_text(", {printed} is missing: index ")
        var middle = values.described_text(", count ")
        var with_index = values.joined_with(opening, index_text)
        var with_middle = values.joined_with(with_index, middle)
        var whole = values.joined_with(with_middle, counted_text)
        append_to_the_report(whole)
    } else if shows_the_index {
        append_a_missing_key(printed, index_value)
    } else {
        var missing = values.described_text(", {printed} is missing")
        append_to_the_report(missing)
    }
}

func append_a_missing_key(printed: String, key: Value) {
    var key_text = text_of_a_shown(key)
    var text = context.text()
    var quote = ""
    if key.value_type.is_the_same_as(text) {
        quote = "\""
    }
    var opening = values.described_text(", {printed} is missing: key {quote}")
    var closing = values.described_text(quote)
    var with_key = values.joined_with(opening, key_text)
    var whole = values.joined_with(with_key, closing)
    append_to_the_report(whole)
}

func reports_what_is_missing(condition: Expression): Boolean {
    missing_conjuncts = List<Expression>()
    gather_the_conjuncts(condition)
    var index = 0
    while index < missing_conjuncts.count() {
        var conjunct = missing_conjuncts[index]
        fallback is_a_narrowed_path(conjunct)
        index = index + 1
    }
    missing_links = List<Expression>()
    missing_conjuncts.each(gather_the_links)
    report_the_links(0)
    return true
}

func is_a_narrowed_path(written: Expression): Boolean {
    fallback is_a_value_path(written)
    var kept = context.pending
    context.pending = List<Statement>()
    missing_links = List<Expression>()
    gather_the_links(written)
    context.scope.enter()
    var found = false
    var index = 0
    while index < missing_links.count() {
        var link = missing_links[index]
        var value = values.value_of(link, null)
        if value.value_type.is_nullable {
            found = true
            narrow_a_link(link, value.value_type)
        }
        index = index + 1
    }
    context.scope.leave()
    context.pending = kept
    return found
}

func narrow_a_link(link: Expression, link_type: Model.Type) {
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var path = path_of(link, printed)
    var present = link_type.present()
    context.scope.narrow(path, present)
}

func gather_the_conjuncts(written: Expression) {
    if written == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        gather_a_binary_conjunct(written)
    } else {
        missing_conjuncts.append(written)
    }
}

func gather_a_binary_conjunct(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        crash binary.left
        crash binary.right
        gather_the_conjuncts(binary.left)
        gather_the_conjuncts(binary.right)
    } else {
        missing_conjuncts.append(binary)
    }
}

func gather_the_links(written: Expression) {
    if written == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash written.target
        gather_the_links(written.target)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        crash written.target
        gather_the_links(written.target)
    }
    missing_links.append(written)
}

func report_the_links(index: Integer) {
    if index >= missing_links.count() {
        missing_conjuncts.each(show_a_present_conjunct)
    } else {
        var link = missing_links[index]
        crash link
        report_a_link(link, index)
    }
}

func report_a_link(link: Expression, index: Integer) {
    var value = values.value_of(link, null)
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var shown = context.shown(value.value_type)
    report_types.append("{printed}:{shown}")
    if not value.value_type.is_nullable {
        report_the_links(index + 1)
    } else {
        flush_the_pending()
        var present = value.value_type.present()
        var rest = narrowed_rest(link, present, index + 1)
        var missing = block_of_the_missing(link, printed)
        var tested = HighIntermediaryRepresentation.Values.PresenceTest(value)
        var made = HighIntermediaryRepresentation.Statements.If(tested, rest, missing)
        made.line = context.line
        add(made)
    }
}

func narrowed_rest(
    link: Expression,
    present: Model.Type,
    next_index: Integer,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = built
    built = List<Statement>()
    context.scope.enter()
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var path = path_of(link, printed)
    context.scope.narrow(path, present)
    report_the_links(next_index)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    built = outer
    return made
}

func show_a_present_conjunct(conjunct: Expression) {
    var value = values.value_of(conjunct, null)
    var shows = can_be_shown(value.value_type, true)
    if shows and not value.value_type.is_nullable {
        var printer = Printers.Spite.ExpressionPrinter(conjunct)
        var printed = printer.text()
        append_a_value(printed, value)
    }
}

func show_the_values_in_scope(mentioned: List<String>) {
    var path = context.path()
    var forward = path.replace("\\", "/")
    if not forward.contains("/.spite/build/spite/") {
        show_the_scope(mentioned)
    }
}

func show_the_scope(mentioned: List<String>) {
    var names = context.scope.visible_written_names()
    var index = 0
    while index < names.count() {
        var name = names[index]
        if shown_count < 12 and not mentioned.contains(name) {
            show_a_named_value(name)
        }
        index = index + 1
    }
    var own = values.this_value()
    if own.value_type.kind == 'object' {
        show_the_attributes(mentioned, names)
    }
}

func show_the_attributes(mentioned: List<String>, names: List<String>) {
    var library = Validators.LibraryFile()
    var path = context.path()
    var in_the_library = library.holds(path)
    var attributes = context.current_class.declared_attributes
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        var is_hidden = shown_count >= 12 or mentioned.contains(attribute.name) or names.contains(attribute.name)
        is_hidden = is_hidden or in_the_library and attribute.name.starts_with("_")
        var present = attribute.attribute_type.present()
        if not is_hidden and can_be_shown(present, false) {
            show_a_named_value(attribute.name)
        }
        attribute_index = attribute_index + 1
    }
}

func show_a_named_value(name: String) {
    var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var present = local_type.present()
        fallback can_be_shown(present, false)
    }
    var value = values.value_of(identifier, null)
    show_a_value(name, identifier, value, false)
}

func gather_the_names(expression: Expression?, names: List<String>) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: note_a_shown_name(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: gather_both(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: gather_the_names(expression.operand, names)
        _: return
    }
}

func gather_both(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, names: List<String>) {
    gather_the_names(binary.left, names)
    gather_the_names(binary.right, names)
}

func note_a_shown_name(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression, names: List<String>) {
    var is_known = context.scope.internal_name_of(identifier.name)
    fallback is_known and not names.contains(identifier.name)
    names.append(identifier.name)
}

func always_stops(condition: Expression?): Boolean {
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return condition.kind == 'keyword_false'
    }
    return not condition
}

func build_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var subject = values.value_of(statement.value, null)
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var path = printer.text()
    if subject.value_type.is_nullable {
        note_a_loop_copy(statement.value)
    }
    check_the_case_kinds(statement, subject.value_type)
    if is_closed(subject.value_type) {
        check_the_cover(statement, subject.value_type, path)
    }
    check_the_rest_of_values(statement, subject.value_type, path)
    context.line = statement.line
    var narrowed_path = path_of(statement.value, path)
    var is_computed = statement.value == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    if is_computed {
        subject = values.held_once(subject)
        flush_the_pending()
    }
    var chain = switch_chain(statement, subject, narrowed_path, 0)
    crash chain
    if subject.value_type.is_nullable {
        check_the_nullable_cover(statement, subject.value_type, path)
    }
    add(chain)
}

func switch_chain(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject: Value,
    path: String,
    index: Integer,
): Statement? {
    var switch_case = statement.cases[index]
    fallback switch_case
    var written = switch_case.value
    var paths = List<String>()
    var types = List<Model.Type>()
    var is_the_rest = false
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_the_rest = written.name == "_"
    }
    var is_a_union = subject.value_type.kind == 'union' and not subject.value_type.is_nullable
    if is_the_rest and is_a_union {
        var rest_type = rest_of_the_union(statement, subject.value_type, index)
        paths.append(path)
        types.append(rest_type)
        var rest_body = narrowed_block_of(switch_case.body, paths, types, "the 'switch' on line {statement.line}")
        name_the_case(rest_body, written, statement.line)
        return rest_body
    }
    if is_the_rest {
        var other_body = block_of(switch_case.body)
        name_the_case(other_body, written, statement.line)
        return other_body
    }
    context.line = statement.line
    if not subject.value_type.is_nullable {
        context.line = switch_case.line
    }
    var condition = case_condition(subject, written, path, paths, types)
    var body = narrowed_block_of(switch_case.body, paths, types, "the 'switch' on line {statement.line}")
    name_the_case(body, written, statement.line)
    var is_the_last = index == statement.cases.count() - 1
    if is_the_last and is_closed(subject.value_type) {
        return body
    }
    var rest = switch_chain(statement, subject, path, index + 1)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if rest {
        var wrapped = HighIntermediaryRepresentation.Statements.Block()
        wrapped.statements.append(rest)
        else_branch = wrapped
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, body, else_branch)
    made.line = statement.line
    return made
}

func name_the_case(
    body: HighIntermediaryRepresentation.Statements.Block,
    written: Expression?,
    line: Integer,
) {
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    body.case_written = printer.text()
    body.switch_line = line
}

func rest_of_the_union(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    union_type: Model.Type,
    rest_index: Integer,
): Model.Type {
    var covered = List<String>()
    var index = 0
    while index < rest_index {
        var switch_case = statement.cases[index]
        crash switch_case
        var class_path = values.class_path_of(switch_case.value)
        if not class_path.is_empty() {
            var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
            var member = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
            covered.append(member.name)
        }
        index = index + 1
    }
    var united = values.union_model_of(union_type)
    var left = List<Model.Type>()
    var left_names = List<String>()
    var member_index = 0
    while member_index < united.members.count() {
        var held = united.members[member_index]
        if not covered.contains(held.name) {
            left.append(held)
            var segments = held.name.split(".")
            var simple = segments.last()
            crash simple
            left_names.append(simple)
        }
        member_index = member_index + 1
    }
    if left.count() != 1 {
        return rest_union(united, left, left_names)
    }
    return left[0]
}

func rest_union(united: Model.UnionModel, left: List<Model.Type>, left_names: List<String>): Model.Type {
    var parts = united.key.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var joined = left_names.join("_or_")
    var simple = "{united.name}_of_{joined}"
    var known = owner.union_named(simple)
    if not known {
        var made = Model.UnionModel("{owner_key}.{simple}", simple)
        made.members = left
        owner.unions.append(made)
    }
    return Model.Type('union', "{owner_key}.{simple}")
}

func check_the_cover(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var written = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var printer = Printers.Spite.ExpressionPrinter(switch_case.value)
        var text = printer.text()
        var segments = text.split(".")
        var last = segments.count() - 1
        var simple = segments[last]
        crash simple
        written.append(simple)
        index = index + 1
    }
    var every = List<String>()
    var is_an_enum = subject_type.kind == 'enumeration'
    var subject = path
    if is_an_enum {
        var enumeration = values.enum_model_of(subject_type)
        var value_index = 0
        while value_index < enumeration.values.count() {
            var value = enumeration.values[value_index]
            every.append("'{value}'")
            value_index = value_index + 1
        }
    } else {
        var united = values.union_model_of(subject_type)
        subject = united.name
        var member_index = 0
        while member_index < united.members.count() {
            var member = united.members[member_index]
            var member_segments = member.name.split(".")
            var member_last = member_segments.count() - 1
            var member_name = member_segments[member_last]
            crash member_name
            every.append(member_name)
            member_index = member_index + 1
        }
    }
    var shown_whole = context.shown(subject_type)
    var shown_segments = shown_whole.split(".")
    var shown = shown_segments.last()
    crash shown
    if subject_type.kind == 'union' {
        subject = shown
    }
    var rest_line = rest_line_of(statement, is_an_enum)
    var site = SwitchSite(context.current_class, context.current_function, statement.line, rest_line)
    site.shown = shown
    site.subject = subject
    site.is_an_enum = is_an_enum
    site.every = every
    site.written = written
    context.switch_sites.append(site)
}

func check_the_nullable_cover(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var present = subject_type.present()
    var is_a_union = present.kind == 'union'
    var is_an_object = present.kind == 'object'
    fallback is_a_union or is_an_object
    var written = written_cases_of(statement)
    var every = List<String>()
    if is_a_union {
        var united = values.union_model_of(present)
        var member_index = 0
        while member_index < united.members.count() {
            var member = united.members[member_index]
            var member_segments = member.name.split(".")
            var member_name = member_segments.last()
            crash member_name
            every.append(member_name)
            member_index = member_index + 1
        }
    } else {
        var present_segments = present.name.split(".")
        var present_name = present_segments.last()
        crash present_name
        every.append(present_name)
    }
    every.append("Null")
    var shown_whole = context.shown(subject_type)
    var shown_segments = shown_whole.split(".")
    var shown = shown_segments.last()
    crash shown
    var rest_line = rest_line_of(statement, false)
    var site = SwitchSite(context.current_class, context.current_function, statement.line, rest_line)
    site.shown = shown
    site.subject = path
    site.is_nullable = true
    site.every = every
    site.written = written
    context.switch_sites.append(site)
}

func written_cases_of(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement): List<String> {
    var written = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var printer = Printers.Spite.ExpressionPrinter(switch_case.value)
        var text = printer.text()
        var segments = text.split(".")
        var simple = segments.last()
        crash simple
        written.append(simple)
        index = index + 1
    }
    return written
}

func rest_line_of(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, is_an_enum: Boolean): Integer {
    var last = statement.cases.count() - 1
    var place = last
    if not is_an_enum and last > 0 {
        place = last - 1
    }
    var switch_case = statement.cases[place]
    crash switch_case
    return switch_case.line
}

func check_the_case_kinds(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, subject_type: Model.Type) {
    fallback not subject_type.is_nullable
    var is_an_enum = subject_type.kind == 'enumeration'
    var is_a_union = subject_type.kind == 'union'
    fallback is_an_enum or is_a_union
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        context.line = switch_case.line
        check_a_case_kind(switch_case.value, subject_type, is_an_enum)
        index = index + 1
    }
}

func check_a_case_kind(
    written: Expression?,
    subject_type: Model.Type,
    is_an_enum: Boolean,
) {
    var shown = context.shown(subject_type)
    var class_path = values.class_path_of(written)
    var is_a_class = not class_path.is_empty() and not is_the_rest_case(written)
    var is_a_value = written == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    is_a_value = is_a_value or written == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    var cases = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    if is_an_enum and is_a_class {
        var enumeration = values.enum_model_of(subject_type)
        var first = enumeration.values[0]
        crash first
        var class_name = class_path.join(".")
        cases.refuse_a_class_case(context, shown, class_name, first)
    }
    fallback not is_an_enum and is_a_value
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var value_text = printer.text()
    var united = values.union_model_of(subject_type)
    var member = united.members[0]
    crash member
    var member_segments = member.name.split(".")
    var member_name = member_segments.last()
    crash member_name
    cases.refuse_a_value_case(context, shown, value_text, member_name)
}

func reads_through_a_call(written: Expression?): Boolean {
    if written {
        return path_reads_through_a_call(written)
    }
    return false
}

func path_reads_through_a_call(written: Expression): Boolean {
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return reads_through_a_call(written.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_reads_through_a_call(written)
        _: return false
    }
}

func index_reads_through_a_call(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    if holds_a_call(read.index) {
        return true
    }
    return reads_through_a_call(read.target)
}

func holds_a_call(written: Expression?): Boolean {
    if written {
        return expression_holds_a_call(written)
    }
    return false
}

func expression_holds_a_call(written: Expression): Boolean {
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return true
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return holds_a_call(written.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return either_index_holds_a_call(written)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return holds_a_call(written.operand)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return either_side_holds_a_call(written)
        _: return false
    }
}

func either_index_holds_a_call(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    if holds_a_call(read.target) {
        return true
    }
    return holds_a_call(read.index)
}

func either_side_holds_a_call(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    if holds_a_call(binary.left) {
        return true
    }
    return holds_a_call(binary.right)
}

func is_the_rest_case(written: Expression?): Boolean {
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == "_"
    }
    return false
}

func check_the_rest_of_values(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    fallback not subject_type.is_nullable
    var is_a_whole_number = subject_type.kind == 'scalar' and values.is_a_whole_number(subject_type)
    var is_a_text = subject_type.kind == 'object' and subject_type.name == "String"
    fallback is_a_whole_number or is_a_text
    var last = statement.cases.last()
    crash last
    fallback not is_the_rest_case(last.value)
    context.line = statement.line
    var shown = context.shown(subject_type)
    var cases = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    cases.refuse_no_rest(context, path, shown)
}

func is_closed(subject_type: Model.Type): Boolean {
    fallback not subject_type.is_nullable
    return subject_type.kind == 'enumeration' or subject_type.kind == 'union'
}

func case_condition(
    subject: Value,
    written: Expression?,
    path: String,
    paths: List<String>,
    types: List<Model.Type>,
): Value {
    var class_path = values.class_path_of(written)
    var is_nullable = subject.value_type.is_nullable
    if is_nullable and is_the_null_case(class_path) {
        var there = HighIntermediaryRepresentation.Values.PresenceTest(subject)
        return HighIntermediaryRepresentation.Values.Negation(there)
    }
    if not class_path.is_empty() {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
        paths.append(path)
        types.append(member)
        var present = subject.value_type.present()
        if is_nullable and member.is_the_same_as(present) {
            return HighIntermediaryRepresentation.Values.PresenceTest(subject)
        }
        return HighIntermediaryRepresentation.Values.Class.Test(subject, member)
    }
    var expected = subject.value_type
    var constant = values.value_of(written, expected)
    if values.is_machine_comparable(expected) {
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', subject, constant)
    }
    var arguments = List<Value>()
    arguments.append(constant)
    return values.method_call(subject, "equals", arguments)
}

func is_the_null_case(class_path: List<String>): Boolean {
    fallback class_path.count() == 1
    var only = class_path[0]
    return only == "Null"
}

func read_facts(condition: Expression?) {
    facts_paths = List<String>()
    facts_types = List<Model.Type>()
    read_a_fact(condition)
}

func read_a_fact(condition: Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_fact(condition)
        return
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_not_empty(condition)
        return
    }
    var is_a_path = condition == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback is_a_path
    fallback not reads_through_a_call(condition)
    crash condition
    var written_value = values.value_of(condition, null)
    var value = values.result_of_handle(written_value)
    fallback value.value_type.is_nullable
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var path = printer.text()
    var present = value.value_type.present()
    var fact_path = path_of(condition, path)
    note_a_narrowed_copy(fact_path)
    facts_paths.append(fact_path)
    facts_types.append(present)
}

func read_a_binary_fact(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        read_a_fact(binary.left)
        context.scope.enter()
        narrow_all(facts_paths, facts_types)
        read_a_fact(binary.right)
        context.scope.leave()
        return
    }
    if binary.operator == 'less' {
        read_a_bound(binary)
        return
    }
    if binary.operator == 'less_or_equal' {
        read_a_bound_at_most(binary)
        return
    }
    var counted = binary.left
    var counts = binary.operator == 'equal_equal' or binary.operator == 'greater_or_equal' or binary.operator == 'greater'
    counts = counts or binary.operator == 'not_equal'
    if counts and counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count_fact(binary, counted)
        return
    }
    fallback binary.operator == 'equal_equal'
    var codegen_path = values.codegen_path_of(binary.left)
    fallback codegen_path.is_empty()
    var class_path = values.tested_class_path_of(binary.right)
    fallback not class_path.is_empty()
    var type_arguments = values.tested_type_arguments(binary.right)
    var member = context.resolver.class_type_in(class_path, type_arguments, context.current_class, context.line)
    crash binary.left
    var printer = Printers.Spite.ExpressionPrinter(binary.left)
    var path = printer.text()
    var fact_path = path_of(binary.left, path)
    facts_paths.append(fact_path)
    facts_types.append(member)
}

func read_a_not_empty(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    fallback unary.operator == 'not'
    var asked = unary.operand
    if asked == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_an_empty_question(asked)
    }
}

func read_an_empty_question(asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = asked.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_an_empty_member(asked, callee)
    }
}

func read_an_empty_member(
    asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback asked.arguments.is_empty() and callee.name == "is_empty"
    var listed = values.value_of(callee.target, null)
    fallback context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    fallback values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    facts_paths.append("{list_text}[0]")
    facts_types.append(present)
}

func read_a_count_fact(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_member(binary, counted, callee)
    }
}

func read_a_counted_member(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    var known = count_limit_of(binary.right)
    if known < 0 {
        read_a_turned_bound(binary, counted)
        return
    }
    if known > 64 {
        known = 64
    }
    if binary.operator == 'greater' {
        known = known + 1
    }
    if binary.operator == 'not_equal' {
        fallback known == 0
        known = 1
    }
    fallback known > 0
    var listed = values.value_of(callee.target, null)
    fallback context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    fallback values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var index = 0
    while index < known {
        facts_paths.append("{list_text}[{index}]")
        facts_types.append(present)
        index = index + 1
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func count_limit_of(limit: Expression?): Integer {
    if limit == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(limit)
    }
    return -1
}

func read_a_turned_bound(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    fallback binary.operator == 'greater'
    crash binary.right
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.right, 'less', counted)
    read_a_binary_bound(turned)
}

func path_of(written: Expression?, printed: String): String {
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return identifier_path(written.name)
    }
    return printed
}

func identifier_path(name: String): String {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return internal_name
    }
    return "this.{name}"
}

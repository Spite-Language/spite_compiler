var state = StatementsState()
var _high_sum_modulus = 65521
var _low_sum_multiplier = 131
var _low_sum_modulus = 65519

func Statements(starting_state: StatementsState) {
    state = starting_state
}

func block_of(written: AbstractSyntaxTree.Shapes.Statements.Block?): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    build_all(written.statements)
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    made.line = written.line
    state.built = outer
    return made
}

func function_body_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
): HighIntermediaryRepresentation.Statements.Block {
    var outer_blocks = state.enclosing_blocks
    state.enclosing_blocks = List<EnclosingBlock>()
    state.at_function_root = true
    var made = block_of(written)
    state.enclosing_blocks = outer_blocks
    return made
}

func build_all(written: List<SpiteCompiler.WrittenStatement>) {
    state.rest_is_folded_away = false
    var outer_statements = state.context.block_statements
    var outer_index = state.context.block_index
    var pushed = not state.at_function_root
    state.at_function_root = false
    if pushed {
        var enclosing = EnclosingBlock(outer_statements, outer_index)
        state.enclosing_blocks.append(enclosing)
    }
    state.context.block_statements = written
    note_a_block("enter", written)
    var library = Mapping.LibraryFile()
    var path = state.context.path()
    var is_the_program = not library.holds(path)
    var index = 0
    while index < written.count() and not state.rest_is_folded_away {
        var statement = written[index]
        state.context.block_index = index
        if is_the_program {
            note_a_statement(written, index)
        }
        build(statement)
        state.context.block_statements = written
        index = index + 1
    }
    note_a_block("leave", written)
    if pushed {
        crash state.enclosing_blocks.remove_last()
    }
    state.context.block_statements = outer_statements
    state.context.block_index = outer_index
    state.rest_is_folded_away = false
}

# ../../PROOFS.md#what-the-builder-records-for-the-proofs
func note_a_block(kind: String, written: List<SpiteCompiler.WrittenStatement>) {
    var site = StatementSite(kind, written, 0)
    state.context.note_a_statement_site(site)
}

func note_a_statement(written: List<SpiteCompiler.WrittenStatement>, index: Integer) {
    var site = StatementSite("statement", written, index)
    site.owner = state.context.current_class
    site.function = state.context.current_function
    site.line = state.context.line
    site.enclosing = state.enclosing_blocks.copy()
    site.view = state.context.scope.view()
    state.context.note_a_statement_site(site)
}

func narrowed_block_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    paths: List<String>,
    types: List<Model.Type>,
    check: String,
): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    narrow_all(paths, types)
    note_one_check(paths, check)
    build_all(written.statements)
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    made.line = written.line
    state.built = outer
    return made
}

func loop_body_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    paths: List<String>,
    types: List<Model.Type>,
    notes: List<String>,
): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    narrow_all(paths, types)
    note_the_loop_checks(paths, notes)
    build_all(written.statements)
    note_what_the_loop_left_undone()
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    made.line = written.line
    state.built = outer
    return made
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_one_check(paths: List<String>, check: String) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        if not path.contains("[") {
            state.context.scope.note_the_check(path, check)
        }
        index = index + 1
    }
}

func note_the_loop_checks(paths: List<String>, notes: List<String>) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var note = notes[index]
        if note and note != "" {
            state.context.scope.note_the_check(path, note)
        }
        index = index + 1
    }
}

func narrow_all(paths: List<String>, types: List<Model.Type>) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var narrowed_type = types[index]
        crash narrowed_type
        state.context.scope.narrow(path, narrowed_type)
        index = index + 1
    }
}

func add(statement: SpiteCompiler.Statement) {
    state.context.pending.each(add_pending)
    state.context.pending = List<SpiteCompiler.Statement>()
    log_the_calls_of(statement)
    state.built.append(statement)
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func log_the_calls_of(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: log_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: log_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: log_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: log_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: log_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.Return: log_a_value(statement.value, statement.line)
        HighIntermediaryRepresentation.Statements.Stop: log_a_value(statement.then, statement.line)
        HighIntermediaryRepresentation.Statements.If: return
        HighIntermediaryRepresentation.Statements.While: return
        HighIntermediaryRepresentation.Statements.Block: return
    }
}

func log_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    var made = declared.value
    if made.class == HighIntermediaryRepresentation.Values.MakeObject {
        state.context.scope.fresh_locals.append(declared.name)
    }
    log_a_value(declared.value, declared.line)
}

func log_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    var place = state.context.scope.fresh_locals.index_of(assigned.name)
    if place {
        state.context.scope.fresh_locals.remove_at(place)
    }
    log_a_value(assigned.value, assigned.line)
}

func log_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var object = written.object
    var is_fresh = false
    if object.class == HighIntermediaryRepresentation.Values.LocalRead {
        is_fresh = state.context.scope.fresh_locals.contains(object.name)
    }
    if not is_fresh {
        var at = state.context.logged_calls.count()
        state.context.logged_writes[at] = written
    }
    log_a_value(written.object, written.line)
    log_a_value(written.value, written.line)
}

func log_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    var at = state.context.logged_calls.count()
    state.context.logged_writes[at] = written
    log_a_value(written.object, written.line)
    log_a_value(written.value, written.line)
}

func log_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    log_a_value(evaluated.value, evaluated.line)
    log_a_value(evaluated.waited, evaluated.line)
}

func log_a_value(value: SpiteCompiler.Value?, line: Integer) {
    fallback value
    state.context.logged_calls.append(value)
    var at = line
    if at == 0 {
        at = state.context.line
    }
    state.context.logged_lines.append(at)
    state.context.scope.stamp = state.context.logged_calls.count()
}

func extend_the_reads_over_the_loop(log_start: Integer, reads_start: Integer) {
    var index = reads_start
    while index < state.context.narrowed_reads.count() {
        var read = state.context.narrowed_reads[index]
        if read.start < log_start {
            read.loop_end = state.context.logged_calls.count()
        }
        index = index + 1
    }
}

func flush_the_pending() {
    state.context.pending.each(add_pending)
    state.context.pending = List<SpiteCompiler.Statement>()
}

func add_pending(statement: SpiteCompiler.Statement) {
    log_the_calls_of(statement)
    state.built.append(statement)
}

func build(statement: SpiteCompiler.WrittenStatement) {
    state.context.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: build_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: build_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: build_evaluation(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: build_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: build_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: build_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: build_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: build_fallback(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: build_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: build_inner_block(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func build_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var constants = state.values.known_constants()
    var constant = constants.known_local(statement)
    if constant and constants.has_no_value_to_hold(constant) {
        constants.declare_a_known_local(statement.name, constant)
        return
    }
    var known = KnownCalls(state.context, state.values)
    var known_call = known.made_by(statement)
    if known_call {
        add(known_call)
        return
    }
    known.remember_a_declaration(statement)
    var declared: Model.Type? = null
    if statement.declared_type {
        declared = state.context.resolver.types.type_in(
            statement.declared_type,
            state.context.current_class,
            statement.line,
        )
    }
    var value = state.values.value_of(statement.value, declared)
    note_a_lone_hole(statement)
    var local_type = value.value_type
    var given_type = value.value_type.present()
    if declared {
        value = state.values.fitted(value, declared)
        local_type = declared
    }
    var folded_keys = Folded.Keys(state.context, state.values)
    folded_keys.check_a_held_map(value)
    var hidden = state.context.scope.hidden_by(statement.name)
    var name = state.context.scope.declare_written(statement.name, local_type)
    var made = HighIntermediaryRepresentation.Statements.Declare(name, local_type, value)
    made.line = statement.line
    made.hides = hidden
    add(made)
    if constant {
        state.context.known_locals[name] = constant
    }
    forget_what_the_call_writes(statement.value)
    forget_what_a_receiver_call_shrinks(value)
    note_a_counted_list(name, statement.value)
    var known_walks = KnownWalks(state.context, state.values)
    known_walks.note_a_function_list(name, statement.name, statement.value)
    note_a_function_local(name, statement.name, value)
    note_a_function_receiver(name, statement.name, value)
    note_a_plain_local(name, statement, local_type)
    note_a_null_local(name, statement.name, value)
    note_a_text_local(name, statement.name, value)
    var kept_type = local_type.present()
    if given_type.is_the_same_as(kept_type) {
        note_a_copy(statement, name, local_type, value)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'proven' {
        state.context.proven_locals.append(name)
    }
    note_an_index_local(name, value)
}

# ../../../spite_spec/specs/values_and_types.md
func note_a_lone_hole(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var written = statement.value
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    fallback written.pieces.count() == 1
    var only = written.pieces[0]
    fallback only.text.is_empty() and only.hole
    var path = state.context.path()
    var key = "{path}:{statement.line}:{statement.name}"
    if state.context.hole_is_text {
        state.context.text_holes.append(key)
    } else {
        state.context.other_holes.append(key)
    }
}

func forget_an_index_local(name: String) {
    var kept = List<String>()
    var index = 0
    while index < state.context.index_locals.count() {
        var local = state.context.index_locals[index]
        if local != name {
            kept.append(local)
        }
        index = index + 1
    }
    state.context.index_locals = kept
}

func note_an_index_local(name: String, value: SpiteCompiler.Value) {
    if value.class == HighIntermediaryRepresentation.Values.Call and value.index_path != "" and value.value_type.is_nullable {
        state.context.index_locals.append(name)
    }
}

func note_a_function_local(name: String, written_name: String, value: SpiteCompiler.Value) {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        note_a_named_function(name, written_name, value.function)
    }
}

func note_a_null_local(name: String, written_name: String, value: SpiteCompiler.Value) {
    var is_null = value.class == HighIntermediaryRepresentation.Values.NullConstant
    if is_null and not state.values.is_assigned_again(written_name) {
        state.context.null_locals.append(name)
    }
}

func note_a_text_local(name: String, written_name: String, value: SpiteCompiler.Value) {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant and not state.values.is_assigned_again(written_name) {
        state.context.text_locals[name] = value.text
    }
}

func note_a_named_function(name: String, written_name: String, function: Model.FunctionModel) {
    fallback not state.values.is_assigned_again(written_name)
    state.context.function_locals[name] = function
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func note_a_function_receiver(name: String, written_name: String, value: SpiteCompiler.Value) {
    fallback value.class == HighIntermediaryRepresentation.Values.Function.Value and not state.values.is_assigned_again(written_name)
    fallback value.receiver
    hold_a_function_receiver(name, value.receiver)
}

func hold_a_function_receiver(name: String, receiver: SpiteCompiler.Value) {
    var is_plain = receiver.class == HighIntermediaryRepresentation.Values.LocalRead
    fallback is_plain or receiver.class == HighIntermediaryRepresentation.Values.AttributeRead
    var receiver_type = receiver.value_type
    fallback receiver_type.kind == 'object' and not receiver_type.is_nullable
    var held = state.context.scope.declare("{name}_receiver", receiver_type)
    var made = HighIntermediaryRepresentation.Statements.Declare(held, receiver_type, receiver)
    made.line = state.context.line
    add(made)
    state.context.function_receivers[name] = held
}

func note_a_copy(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    internal_name: String,
    local_type: Model.Type,
    value: SpiteCompiler.Value,
) {
    fallback local_type.is_nullable and is_a_bare_path(statement.value)
    fallback not (statement.declared_type and state.context.current_class.shown.contains("<"))
    var path = state.context.path()
    var library = Mapping.LibraryFile()
    fallback not library.holds(path)
    crash statement.value
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var source = printer.text()
    fallback not source.contains("[")
    fallback state.context.current_function.declaration
    var assigned = AssignedPaths()
    var targets = assigned.of(state.context.current_function.declaration)
    fallback not targets.contains(statement.name)
    var index = 0
    while index < targets.count() {
        var target = targets[index]
        fallback not (target == source or target.starts_with("{source}.") or target.starts_with("{source}["))
        fallback not (source.starts_with("{target}.") or source.starts_with("{target}["))
        index = index + 1
    }
    state.context.scope.note_a_copy(internal_name, statement.name, source, statement.line)
    state.context.scope.copied_stamps[internal_name] = state.context.logged_calls.count()
    var attributes = List<Model.AttributeModel>()
    note_the_attributes_read(value, attributes)
    state.context.scope.copied_attributes[internal_name] = attributes
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func note_the_attributes_read(value: SpiteCompiler.Value?, attributes: List<Model.AttributeModel>) {
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        attributes.append(value.attribute)
        note_the_attributes_read(value.object, attributes)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        note_the_attributes_read(value.converted, attributes)
    }
}

func is_a_bare_path(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return true
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return true
    }
    return false
}

func last_line_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration?): Integer {
    crash declaration
    crash declaration.body
    var last = declaration.body.statements.last()
    crash last
    return last.line
}

func note_a_maybe_boolean(condition: SpiteCompiler.Expression?, linked: SpiteCompiler.Expression?) {
    fallback is_a_bare_path(condition)
    state.context.scope.enter()
    if linked.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_facts(linked.left)
        narrow_all(state.facts_paths, state.facts_types)
    }
    var written_value = state.values.value_of(condition, null)
    state.context.scope.leave()
    var value = state.values.result_of_handle(written_value)
    var tested = value.value_type
    var site = PresenceSite("boolean", state.context, tested)
    site.value = value
    state.context.note_a_presence_site(site)
}

func folded_unheld_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement): SpiteCompiler.Value {
    var pending_before = state.context.pending.count()
    var unheld = state.values.condition_of(statement.condition)
    while state.context.pending.count() > pending_before {
        crash state.context.pending.remove_last()
    }
    return HighIntermediaryRepresentation.Values.Negation(unheld)
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func note_a_narrowed_copy(fact_path: String) {
    var source = state.context.scope.copied_sources[fact_path]
    fallback source
    var written_name = state.context.scope.copied_names[fact_path]
    var line = state.context.scope.copied_lines[fact_path]
    crash written_name
    crash line
    var site = CheckSite("copy", state.context)
    site.source = source
    site.written = written_name
    site.line = line
    site.copied_path = fact_path
    state.context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_tested_copy(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and condition.operator == 'not' {
        note_a_loop_copy(condition.operand)
    }
}

func note_a_loop_copy(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var fact_path = identifier_path(condition.name)
        note_a_narrowed_copy(fact_path)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_read_check(condition: SpiteCompiler.Expression?, keyword: String) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        var written = printer.text()
        var site = CheckSite("proven read", state.context)
        site.written = written
        site.check = state.context.scope.check_of(written)
        site.keyword = keyword
        var since = 0
        var innermost = state.context.loop_bases.last()
        if innermost {
            since = innermost
        }
        var called_since = state.context.scope.stamp_of(written) < state.context.logged_calls.count()
        var is_a_loop_proof = false
        if site.check {
            is_a_loop_proof = site.check.starts_with("the loop condition ")
        }
        site.is_narrowed_outside = state.context.scope.frame_of(written) < since or called_since and not is_a_loop_proof
        state.context.note_a_check_site(site)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func checking_text(keyword: String, condition: SpiteCompiler.Expression?, line: Integer): String {
    var tested = condition
    if tested.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        tested = tested.operand
    }
    var is_joined = false
    if tested.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        is_joined = tested.operator == 'and' or tested.operator == 'or'
    }
    if is_joined {
        return "the '{keyword}' on line {line}"
    }
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    return "'{keyword} {written}' on line {line}"
}

func notes_with(paths: List<String>, notes: List<String>, check: String): List<String> {
    var noted = List<String>()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var note = notes[index]
        if note and note != "" {
            noted.append(note)
        } else if path.contains("[") {
            noted.append("")
        } else {
            noted.append(check)
        }
        index = index + 1
    }
    return noted
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_condition(condition: SpiteCompiler.Expression?) {
    var tested = condition
    if tested.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        tested = tested.operand
    }
    fallback is_a_bare_path(tested)
    crash tested
    var printer = Printers.Spite.ExpressionPrinter(tested)
    var written = printer.text()
    var fact_path = path_of(tested, written)
    var since = 0
    var innermost = state.context.loop_bases.last()
    if innermost {
        since = innermost
    }
    fallback state.context.scope.frame_of(fact_path) >= since
    var narrowed_type = state.context.scope.narrowed_type_of(fact_path)
    fallback narrowed_type
    var is_a_boolean = state.context.is_a_truth_value(narrowed_type)
    fallback not narrowed_type.is_nullable and not is_a_boolean
    var check = state.context.scope.check_of(fact_path)
    fallback check
    var site = CheckSite("proven check", state.context)
    site.written = written
    site.check = check
    state.context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_repeated_check(condition: SpiteCompiler.Expression?, line: Integer) {
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var function = state.context.current_function
    var depth = state.context.scope.narrowed.count()
    var opening_line = 0
    var opening = state.context.block_statements.first()
    if opening {
        opening_line = opening.line
    }
    var statement_total = state.context.block_statements.count()
    var block = "{function.owner}.{function.name}|{depth}|{statement_total}|{opening_line}"
    var follows = state.context.block_index == state.last_check_at + 1 and block == state.last_check_block and written == state.last_check
    var earlier_line = state.last_check_line
    state.last_check = written
    state.last_check_at = state.context.block_index
    state.last_check_line = line
    state.last_check_block = block
    fallback follows and not holds_a_call(condition)
    var site = CheckSite("repeated check", state.context)
    site.written = written
    site.check = earlier_line
    state.context.note_a_check_site(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_divisor(condition: SpiteCompiler.Expression?, line: Integer) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_proven_nonzero(condition, line)
    }
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_proven_nonzero(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, line: Integer) {
    var is_a_divisor_test = condition.operator == 'not_equal' or condition.operator == 'greater'
    var zero = condition.right
    var is_zero = false
    if zero.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_zero = zero.kind == 'integer_literal' and zero.text == "0"
    }
    var tested = condition.left
    var name = ""
    if tested.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = tested.name
    }
    fallback is_a_divisor_test and is_zero and not name.is_empty()
    var internal_name = state.context.scope.internal_name_of(name)
    fallback internal_name
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var nonzero = "~[{name}]"
    var positive = "~>[{name}]"
    var proof = proof_inside_the_loop(nonzero)
    if condition.operator == 'greater' {
        proof = proof_inside_the_loop(positive)
    }
    var integer = state.context.scalar_type("Integer")
    state.context.scope.narrow(nonzero, integer)
    state.context.scope.note_the_check(nonzero, "'{written}' on line {line}")
    if condition.operator == 'greater' {
        state.context.scope.narrow(positive, integer)
        state.context.scope.note_the_check(positive, "'{written}' on line {line}")
    }
    fallback proof
    var site = CheckSite("proven divisor", state.context)
    site.written = written
    site.check = proof
    state.context.note_a_check_site(site)
}

func proof_inside_the_loop(path: String): String? {
    var since = 0
    var innermost = state.context.loop_bases.last()
    if innermost {
        since = innermost
    }
    fallback state.context.scope.frame_of(path) >= since
    return state.context.scope.check_of(path)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_check_that_always_holds(
    condition: SpiteCompiler.Value,
    keyword: String,
    written: SpiteCompiler.Expression?,
) {
    var holds = false
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber {
        holds = condition.number != 0
    }
    var function = state.context.current_function
    var is_a_walk = function.is_walked()
    var is_generic = not state.context.current_class.bound_types.is_empty()
    fallback holds and not is_a_walk and not is_generic
    var path = state.context.path()
    var library = Mapping.LibraryFile()
    fallback not path.contains("/.spite/") and not library.holds(path)
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var written_text = printer.text()
    fallback holds_a_call(written) or written_text.contains("Build.") or not is_a_bare_path(written)
    var site = CheckSite("always holds", state.context)
    site.written = written_text
    site.keyword = keyword
    state.context.note_a_check_site(site)
}

# ../../PROOFS.md#a-condition-known-while-compiling-is-an-error
func note_a_decided_condition(
    condition: SpiteCompiler.Value,
    keyword: String,
    written: SpiteCompiler.Expression?,
    build_reads_before: Integer,
) {
    var decided = decided_number_of(condition)
    fallback decided
    var holds = decided.number != 0
    var is_a_check = keyword == "fallback" or keyword == "crash"
    fallback not is_a_check or not holds
    var function = state.context.current_function
    var is_a_walk = function.is_walked()
    var is_generic = not state.context.current_class.bound_types.is_empty()
    var reads_a_setting = state.context.folded_build_reads > build_reads_before
    fallback not is_a_walk and not is_generic and not reads_a_setting
    var path = state.context.path()
    fallback not path.contains("/.spite/")
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    var site = CheckSite("decided condition", state.context)
    site.written = printer.text()
    site.keyword = keyword
    site.holds = holds
    site.source = known_presence_of(written, holds)
    state.context.note_a_check_site(site)
}

func decided_number_of(condition: SpiteCompiler.Value): HighIntermediaryRepresentation.Values.WholeNumber? {
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return condition
    }
    fallback condition.class == HighIntermediaryRepresentation.Values.MachineOperation
    var left = condition.left
    var right = condition.right
    fallback left.class == HighIntermediaryRepresentation.Values.WholeNumber
    fallback right.class == HighIntermediaryRepresentation.Values.WholeNumber
    var compared = state.values.compared_numbers(condition.operator, left.number, right.number)
    if compared.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return compared
    }
    return null
}

func known_presence_of(written: SpiteCompiler.Expression, holds: Boolean): String? {
    var tested = written
    var names_a_present_value = holds
    if tested.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested.operator == 'not' {
        crash tested.operand
        tested = tested.operand
        names_a_present_value = not holds
    }
    fallback is_a_bare_path(tested)
    var printer = Printers.Spite.ExpressionPrinter(tested)
    var name = printer.text()
    if names_a_present_value {
        return "'{name}' is proven present here"
    }
    return "'{name}' is known to be null here"
}

func note_a_proven_check(condition: SpiteCompiler.Expression?) {
    fallback is_a_bare_path(condition)
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var fact_path = path_of(condition, written)
    var site = CheckSite("proven check", state.context)
    site.written = written
    site.check = state.context.scope.check_of(fact_path)
    state.context.note_a_check_site(site)
}

func note_the_checks(keyword: String, condition: SpiteCompiler.Expression?, line: Integer) {
    crash condition
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    var read_proof = "'{written}'"
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        read_proof = "an earlier check"
    }
    var index = 0
    while index < state.facts_paths.count() {
        var path = state.facts_paths[index]
        if path.contains("[") {
            state.context.scope.note_the_check(path, read_proof)
        } else {
            state.context.scope.note_the_check(path, "'{keyword} {written}' on line {line}")
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-fallback-answers-what-its-answer-type-builds-with-no-arguments
func note_a_terminal_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var site = GuardSite("terminal if", state.context)
    site.condition = statement.condition
    site.statement_line = statement.line
    if statement.else_branch {
        site.has_an_else = true
    }
    site.proves_something = state.facts_paths.count() > 0
    state.context.note_a_guard_site(site)
}

func note_a_counted_list(name: String, written: SpiteCompiler.Expression?) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_count_call(name, written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        note_a_literal_list(name, written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_lowered_count(name, written)
    }
}

func note_a_lowered_count(name: String, lowered: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var right = lowered.right
    var takes_a_literal = right.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    fallback lowered.operator == 'minus' and takes_a_literal
    var counted = lowered.left
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_count_call(name, counted)
    }
}

func note_a_literal_list(name: String, literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral) {
    var internal_name = state.context.scope.internal_name_of(name)
    crash internal_name
    var listed_type = state.context.scope.type_of(internal_name)
    crash listed_type
    fallback state.context.has_a_class(listed_type) and not listed_type.is_nullable
    var listing = state.context.class_of(listed_type)
    var element = listing.bound_types["$element_type"]
    fallback element
    fallback not element.is_nullable
    var index = 0
    while index < literal.entries.count() {
        state.context.scope.narrow("{name}[{index}]", element)
        index = index + 1
    }
}

func note_a_count_call(name: String, counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = counted.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        note_a_count_member(name, counted, callee)
    }
}

func note_a_count_member(
    name: String,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    crash callee.target
    state.context.counted_lists[name] = callee.target
}

func build_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    assign_to(statement, statement.target)
}

func assign_to(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, target: SpiteCompiler.Expression) {
    var known = KnownCalls(state.context, state.values)
    var filled = known.fill_of(statement)
    if filled {
        add(filled)
        return
    }
    switch target {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: assign_a_name(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: assign_a_member(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: assign_an_index(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: state.typing.refuse_not_assignable(state.context)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: state.typing.refuse_not_assignable(state.context)
    }
}

func assign_a_name(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var known = KnownCalls(state.context, state.values)
    known.forget_a_declaration(target.name)
    var internal_name = state.context.scope.internal_name_of(target.name)
    if internal_name {
        var declared_type = state.context.scope.types[internal_name]
        crash declared_type
        var value = state.values.fitted_value_of(statement.value, declared_type)
        var was_narrowed = state.context.scope.narrowed_type_of(internal_name)
        if was_narrowed and may_be_null(value) {
            note_an_undone_loop_proof(statement, internal_name)
        }
        if declared_type.is_nullable and is_present(value) {
            var present = declared_type.present()
            state.context.scope.keep_present(internal_name, target.name, present)
        } else {
            state.context.scope.forget(internal_name)
            state.context.scope.forget_mentions(target.name)
        }
        state.context.counted_lists.remove_at(internal_name)
        var windows = Windows(state.context, state.values)
        windows.forget_a_name(target.name)
        windows.forget_an_area_name(target.name)
        forget_an_index_local(internal_name)
        var appending = Appending(state.context, state.values)
        if appending.pieces_appended_to(internal_name, declared_type, value) {
            var appended = appending.statements_of(internal_name, declared_type, statement.line)
            appended.each(add)
            return
        }
        var made = HighIntermediaryRepresentation.Statements.Assign.Assign(internal_name, value)
        made.line = statement.line
        add(made)
        return
    }
    var attribute = state.context.current_class.attribute_named(target.name)
    var setter = state.context.current_class.function_named("set_{target.name}")
    if not attribute and setter and setter.parameters.count() == 1 {
        var own_object = state.values.this_value()
        state.context.scope.forget("this.{target.name}")
        set_through(statement, own_object, setter)
        return
    }
    if not attribute {
        state.typing.refuse_unknown_name(state.context, target.name)
    }
    crash attribute
    var own = state.values.this_value()
    state.context.scope.forget(target.name)
    assign_an_attribute(statement, own, attribute, "this.{target.name}")
}

func assign_a_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback not assigns_a_walked_value(statement, target)
    refuse_a_constant(target)
    var object = state.values.value_of(target.target, null)
    if object.value_type.kind == 'shape' and not object.value_type.is_nullable {
        assign_through_a_shape(statement, object, target.name)
        return
    }
    var owner = state.values.present_class_of(object)
    var attribute = owner.attribute_named(target.name)
    var is_outside = owner.key != state.context.current_class.key
    var file_path = state.context.path()
    var is_generated = file_path.contains("/.spite/")
    if owner.key == "Build" and attribute and not is_generated {
        state.typing.refuse_a_build_write(state.context, target.name)
    }
    var setter = owner.function_named("set_{target.name}")
    if not setter and is_outside {
        setter = state.values.member_template_of(owner, "set_{target.name}")
    }
    var writes_through_a_setter = is_outside or not attribute
    if writes_through_a_setter and setter {
        var set_printer = Printers.Spite.ExpressionPrinter(target)
        var set_path = set_printer.text()
        state.context.scope.forget(set_path)
        set_through(statement, object, setter)
        return
    }
    var getter = owner.function_named("get_{target.name}")
    if not attribute and getter {
        state.typing.refuse_read_only(state.context, owner.shown, target.name)
    }
    if not attribute {
        var shown = state.context.shown(object.value_type)
        state.typing.refuse_unknown_member(state.context, shown, target.name)
    }
    crash attribute
    var printer = Printers.Spite.ExpressionPrinter(target)
    var path = printer.text()
    assign_an_attribute(statement, object, attribute, path)
}

func refuse_a_constant(target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var class_path = state.values.class_path_of(target.target)
    var written = class_path.join(".")
    fallback state.values.scalars.is_a_scalar(written)
    state.typing.refuse_constant_assigned(state.context, "{written}.{target.name}")
}

func assign_through_a_shape(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: SpiteCompiler.Value,
    name: String,
) {
    var shape = state.context.program.shape_keyed(object.value_type.name)
    crash shape
    var member = shape.member_named(name)
    var shown = state.context.shown(object.value_type)
    if not member {
        state.typing.refuse_unknown_member(state.context, shown, name)
    }
    crash member
    if not member.is_an_attribute {
        state.typing.refuse_read_only(state.context, shown, name)
    }
    crash member.answer
    var value = state.values.fitted_value_of(statement.value, member.answer)
    var made = HighIntermediaryRepresentation.Statements.Assign.ThroughShape(object, shape, name, value)
    made.line = statement.line
    add(made)
}

func assigns_a_walked_value(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Boolean {
    var function = state.context.current_function
    fallback function.walked_object and target.name == "value"
    var described = target.target
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return assigned_through_the_walk(statement, described, function)
    }
    return false
}

func assigned_through_the_walk(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    described: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): Boolean {
    fallback described.name == function.bound_parameter
    var read = state.values.walked_value(function)
    if read.class == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

# ../../../spite_spec/specs/json.md#json-is-reflection-not-a-library
func held_for_the_table(object: SpiteCompiler.Value): SpiteCompiler.Value {
    if object.class == HighIntermediaryRepresentation.Values.LocalRead {
        return object
    }
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        return object
    }
    state.values.temporary_count = state.values.temporary_count + 1
    var name = state.context.scope.declare("keyed_{state.values.temporary_count}", object.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object.value_type, object)
    declared.line = state.context.line
    add(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(object.value_type, name)
}

# ../../OPTIMIZATIONS.md#a-buffer-grows-where-its-count-does
func held_for_the_room(object: SpiteCompiler.Value): SpiteCompiler.Value {
    var rooms = RoomForms(state.context, state.values)
    if rooms.again(object) {
        return object
    }
    state.values.temporary_count = state.values.temporary_count + 1
    var name = state.context.scope.declare("room_{state.values.temporary_count}", object.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object.value_type, object)
    declared.line = state.context.line
    add(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(object.value_type, name)
}

func counted_for_the_room(count: SpiteCompiler.Value): SpiteCompiler.Value {
    if count.class == HighIntermediaryRepresentation.Values.LocalRead {
        return count
    }
    if count.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return count
    }
    state.values.temporary_count = state.values.temporary_count + 1
    var name = state.context.scope.declare("counted_{state.values.temporary_count}", count.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, count.value_type, count)
    declared.line = state.context.line
    add(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(count.value_type, name)
}

func add_the_table(object: SpiteCompiler.Value, attribute: Model.AttributeModel) {
    var folded_keys = Folded.Keys(state.context, state.values)
    var filling = folded_keys.filled_table(object, attribute)
    filling.each(add)
}

func assign_an_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
    path: String,
) {
    var folded_keys = Folded.Keys(state.context, state.values)
    var fills_a_table = false
    if folded_keys.is_a_key_map(attribute.attribute_type) {
        fills_a_table = folded_keys.record(statement.value, attribute)
    }
    var value = state.values.fitted_value_of(statement.value, attribute.attribute_type)
    var target = object
    if fills_a_table {
        value = folded_keys.copied(value, attribute)
        target = held_for_the_table(object)
    }
    var was_narrowed = state.context.scope.narrowed_type_of(path)
    if was_narrowed and may_be_null(value) {
        note_an_undone_loop_check(statement, path)
    }
    state.context.scope.forget(path)
    forget_the_printed_path(path)
    var rooms = RoomForms(state.context, state.values)
    if rooms.holds_room(attribute) and not rooms.needs_no_room(value) {
        target = held_for_the_room(target)
        value = counted_for_the_room(value)
        var object_again = rooms.again(target)
        crash object_again
        var count_again = rooms.again(value)
        crash count_again
        var growing = rooms.room_for(object_again, attribute, count_again)
        growing.line = statement.line
        add(growing)
    }
    var made = HighIntermediaryRepresentation.Statements.Assign.Attribute(target, attribute, value)
    made.line = statement.line
    add(made)
    if fills_a_table {
        add_the_table(target, attribute)
    }
    fallback was_narrowed
    narrow_a_present_assignment(value, attribute, path)
}

func forget_the_printed_path(path: String) {
    fallback path.starts_with("this.")
    var length = path.length()
    var printed = path.slice(5, length)
    crash printed
    state.context.scope.forget(printed)
}

func may_be_null(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'nullable' {
        crash value.converted
        return value.converted.value_type.is_nullable
    }
    return value.value_type.is_nullable
}

# ../../PROOFS.md#assigning-undoes-a-proof
func note_an_undone_loop_check(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, path: String) {
    var site = CheckSite("undone in the loop", state.context)
    var base = state.context.loop_bases.last()
    if base {
        var frame = state.context.scope.frame_of(path)
        site.has_a_loop = true
        site.is_narrowed_outside = frame >= 0 and frame < base
    }
    site.is_read_in_the_loop = state.context.loop_reads.contains(path)
    crash statement.target
    var printer = Printers.Spite.ExpressionPrinter(statement.target)
    site.written = printer.text()
    state.context.note_a_loop_site(site)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func note_an_undone_loop_proof(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, path: String) {
    var base = state.context.loop_bases.last()
    fallback base
    var frame = state.context.scope.frame_of(path)
    fallback frame >= 0 and frame < base
    fallback state.context.loop_reads.contains(path)
    crash statement.target
    var printer = Printers.Spite.ExpressionPrinter(statement.target)
    state.context.undone_paths.append(path)
    state.context.undone_lines.append(statement.line)
    var written = printer.text()
    state.context.undone_texts.append(written)
    var depth = state.context.loop_bases.count()
    state.context.undone_depths.append(depth)
}

func note_what_the_loop_left_undone() {
    var depth = state.context.loop_bases.count()
    var index = state.context.undone_paths.count() - 1
    while index >= 0 {
        var undone_depth = state.context.undone_depths[index]
        crash undone_depth
        if undone_depth == depth {
            note_an_undone_path(index)
            state.context.undone_paths.remove_at(index)
            state.context.undone_lines.remove_at(index)
            state.context.undone_texts.remove_at(index)
            state.context.undone_depths.remove_at(index)
        }
        index = index - 1
    }
}

func note_an_undone_path(index: Integer) {
    var path = state.context.undone_paths[index]
    crash path
    var line = state.context.undone_lines[index]
    var written = state.context.undone_texts[index]
    crash line
    crash written
    var site = CheckSite("left undone", state.context)
    if state.context.scope.narrowed_type_of(path) {
        site.is_still_narrowed = true
    }
    site.has_a_loop = true
    site.written = written
    site.line = line
    state.context.note_a_loop_site(site)
}

func is_present(value: SpiteCompiler.Value): Boolean {
    if not value.value_type.is_nullable {
        return true
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        return not value.converted.value_type.is_nullable
    }
    return false
}

func narrow_a_present_assignment(value: SpiteCompiler.Value, attribute: Model.AttributeModel, path: String) {
    fallback attribute.attribute_type.is_nullable
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        crash value.converted
        if not value.converted.value_type.is_nullable {
            var present = attribute.attribute_type.present()
            state.context.scope.narrow(path, present)
        }
    }
}

func set_through(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: SpiteCompiler.Value,
    setter: Model.FunctionModel,
) {
    state.context.need(setter)
    var parameter = setter.parameters[0]
    crash parameter
    var value = state.values.fitted_value_of(statement.value, parameter.parameter_type)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(setter, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

func assign_a_bound_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Boolean {
    var function = state.context.current_function
    fallback function.bound_member_type
    if not function.bound_shape.is_empty() {
        return assign_through_the_shape(statement, target, function)
    }
    var read = state.values.bound_member_read(target)
    if read.class == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

func assign_through_the_shape(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    function: Model.FunctionModel,
): Boolean {
    var attributes = target.target
    if attributes.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        assign_a_shape_member(statement, attributes, function)
        return true
    }
    return false
}

func assign_a_shape_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    attributes: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
) {
    var object = state.values.value_of(attributes.target, null)
    var shape = state.context.program.shape_keyed(function.bound_shape)
    crash shape
    crash function.bound_member_type
    var value = state.values.fitted_value_of(statement.value, function.bound_member_type)
    var made = HighIntermediaryRepresentation.Statements.Assign.ThroughShape(
        object,
        shape,
        function.bound_member,
        value,
    )
    made.line = statement.line
    add(made)
}

func assign_the_bound_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
) {
    crash read.object
    var value = state.values.fitted_value_of(statement.value, read.attribute.attribute_type)
    var made = HighIntermediaryRepresentation.Statements.Assign.Attribute(read.object, read.attribute, value)
    made.line = statement.line
    add(made)
}

func assign_an_index(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    fallback not assign_a_bound_member(statement, target)
    var object = state.values.value_of(target.target, null)
    var folded_keys = Folded.Keys(state.context, state.values)
    folded_keys.check_a_change(object)
    var owner = state.values.present_class_of(object)
    var function = owner.function_named("set_at")
    if not function {
        var shown = state.context.shown(object.value_type)
        state.typing.refuse_not_indexed(state.context, shown, "assigning through an index on", "set_at(index, value)")
    }
    crash function
    state.context.need(function)
    var index_parameter = function.parameters[0]
    var value_parameter = function.parameters[1]
    crash index_parameter
    crash value_parameter
    var position = state.values.fitted_value_of(target.index, index_parameter.parameter_type)
    var value = state.values.fitted_value_of(statement.value, value_parameter.parameter_type)
    forget_the_stored_items(target, value)
    stop_a_refilled_argument(target, object, position, statement.line)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(position)
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(function, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func stop_a_refilled_argument(
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    object: SpiteCompiler.Value,
    position: SpiteCompiler.Value,
    line: Integer,
) {
    fallback object.class == HighIntermediaryRepresentation.Values.Call
    fallback object.function.name == "get_arguments" and object.function.owner == "Spite.Call"
    fallback position.class == HighIntermediaryRepresentation.Values.TextConstant
    var owner = state.values.present_class_of(object)
    var containing = owner.function_named("contains")
    crash containing
    state.context.need(containing)
    var asked = List<SpiteCompiler.Value>()
    asked.append(position)
    var arguments = HighIntermediaryRepresentation.Values.Call(object.function, object.receiver, object.arguments)
    var filled = HighIntermediaryRepresentation.Values.Call(containing, arguments, asked)
    crash target.target
    var call_name = "call"
    var written = target.target
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash written.target
        var printer = Printers.Spite.ExpressionPrinter(written.target)
        call_name = printer.text()
    }
    var message = "spite: '{call_name}.arguments[\"{position.text}\"]' is already set: a call fills each argument once, before '{call_name}.call()' runs it"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = line
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(filled, stopping, null)
    add(branch)
}

func hand_the_evaluation_to_its_rules(
    statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement,
    value: SpiteCompiler.Value,
) {
    var is_made = value.class == HighIntermediaryRepresentation.Values.MakeObject
    var is_foreign = value.class == HighIntermediaryRepresentation.Values.ForeignCall
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    rules.check_an_evaluation(state.context, statement.value, value.value_type, is_made or is_foreign)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func forget_the_stored_items(
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    value: SpiteCompiler.Value,
) {
    crash target.target
    var printer = Printers.Spite.ExpressionPrinter(target.target)
    var listed = printer.text()
    if may_be_null(value) {
        state.context.scope.forget_reads_of(listed)
        return
    }
    state.context.scope.forget_below_the_items(listed)
}

func build_evaluation(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    if statement.shows_the_locals {
        note_the_locals(statement.line)
    }
    var renewing = renewed_by_a_loop(state.context.block_statements, state.context.block_index)
    if renewing {
        forget_what_the_call_writes(statement.value)
        return
    }
    var value = state.values.value_of(statement.value, null)
    hand_the_evaluation_to_its_rules(statement, value)
    var rooms = RoomForms(state.context, state.values)
    var growing = rooms.room_before_a_write(value)
    if growing {
        growing.line = statement.line
        add(growing)
    }
    var made = HighIntermediaryRepresentation.Statements.Evaluate(value)
    made.line = statement.line
    add(made)
    forget_what_the_call_writes(statement.value)
    forget_what_a_receiver_call_shrinks(value)
}

# ../../../spite_spec/specs/repl.md#command-language
func note_the_locals(line: Integer) {
    var noting = BreakpointLocals(state.context)
    var texts = noting.statements_on(line)
    var path = state.context.path()
    var index = 0
    while index < texts.count() {
        var written = texts[index]
        var lexer = AbstractSyntaxTree.Lexer.Lexer(path, written, line)
        var made_tokens = lexer.tokens_of()
        var parser = AbstractSyntaxTree.Parser.Parser(path, "", made_tokens)
        var parsed = parser.statement()
        build(parsed)
        index = index + 1
    }
    state.context.line = line
}

func forget_what_the_call_writes(written: SpiteCompiler.Expression?) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        forget_after_a_call(written)
    }
}

func forget_after_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        forget_after_an_own_call(callee.name)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        forget_after_a_shrinking_call(callee)
    }
}

func forget_after_a_shrinking_call(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var shrunk = ShrunkLists()
    fallback shrunk.is_shrinking(callee.name)
    crash callee.target
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var listed = printer.text()
    state.context.scope.forget_reads_of(listed)
    var windows = Windows(state.context, state.values)
    windows.forget_a_list(listed)
    windows.forget_an_area_list(listed)
    var counts = state.context.counted_lists.keys()
    var index = 0
    while index < counts.count() {
        var count_name = counts[index]
        forget_a_count_of(count_name, listed)
        index = index + 1
    }
}

func forget_a_count_of(count_name: String, listed: String) {
    var counted = state.context.counted_lists[count_name]
    crash counted
    var printer = Printers.Spite.ExpressionPrinter(counted)
    if printer.text() == listed {
        state.context.counted_lists.remove_at(count_name)
    }
}

func forget_what_a_receiver_call_shrinks(value: SpiteCompiler.Value) {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        forget_after_a_receiver_call(value)
    }
}

func forget_after_a_receiver_call(call: HighIntermediaryRepresentation.Values.Call) {
    var receiver = call.receiver
    var is_reached = receiver.class == HighIntermediaryRepresentation.Values.Call
    is_reached = is_reached or receiver.class == HighIntermediaryRepresentation.Values.Conversion
    fallback is_reached
    var owner = state.context.program.class_named(call.function.owner)
    fallback owner
    var library = Mapping.LibraryFile()
    fallback not library.holds(owner.file.path)
    var shrunk = ShrunkLists()
    if shrunk.through_reads(owner, call.function) {
        state.context.scope.forget_every_read()
    }
}

func forget_after_an_own_call(called: String) {
    var function = state.context.current_class.function_named(called)
    fallback function
    fallback function.declaration
    var reader = WrittenAttributes()
    var names = reader.of(function.declaration)
    var index = 0
    while index < names.count() {
        var name = names[index]
        if not state.context.scope.internal_name_of(name) {
            state.context.scope.forget_mentions(name)
        }
        index = index + 1
    }
}

func build_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if not state.context.current_function.answer {
        if statement.value {
            state.typing.refuse_answer_from_nothing(state.context)
        }
        var nothing = HighIntermediaryRepresentation.Statements.Return(null)
        nothing.line = statement.line
        add(nothing)
        return
    }
    var answer: Model.Type = state.context.current_function.answer
    if not statement.value {
        var shown = state.context.shown(answer)
        state.typing.refuse_missing_answer(state.context, shown)
    }
    var value = state.values.fitted_value_of(statement.value, answer)
    var made = HighIntermediaryRepresentation.Statements.Return(value)
    made.line = statement.line
    add(made)
}

func build_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var written = statement.condition
    crash statement.condition
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    var written_condition = printer.text()
    note_a_proven_condition(written)
    statement.condition = state.values.with_its_links(statement.condition)
    note_a_maybe_boolean(written, statement.condition)
    var build_reads_before = state.context.folded_build_reads
    var condition = state.values.condition_of(statement.condition)
    note_a_check_of_a_proven_value(written, condition, "if")
    note_a_decided_condition(condition, "if", written, build_reads_before)
    flush_the_pending()
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber {
        build_a_decided_if(statement, condition.number != 0)
        return
    }
    log_a_value(condition, statement.line)
    read_facts(statement.condition)
    note_a_tested_copy(written)
    note_a_terminal_if(statement)
    var paths = state.facts_paths
    var types = state.facts_types
    var check = checking_text("if", written, statement.line)
    var then_branch = narrowed_block_of(statement.then_branch, paths, types, check)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if statement.else_branch {
        else_branch = block_of(statement.else_branch)
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, then_branch, else_branch)
    made.line = statement.line
    made.written_condition = written_condition
    add(made)
    if not statement.else_branch and always_leaves(then_branch) {
        state.facts_paths = List<String>()
        state.facts_types = List<Model.Type>()
        read_a_negated_fact(statement.condition)
        narrow_all(state.facts_paths, state.facts_types)
        note_the_leaving_if(written_condition, statement.line)
        var windows = Windows(state.context, state.values)
        windows.note_a_leaving_guard(statement.condition)
    }
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func note_a_check_of_a_proven_value(
    written: SpiteCompiler.Expression?,
    condition: SpiteCompiler.Value,
    keyword: String,
) {
    var function = state.context.current_function
    var is_a_walk = function.is_walked()
    var is_generic = not state.context.current_class.bound_types.is_empty()
    fallback not is_a_walk and not is_generic
    var tested_written = written
    var tested_condition = condition
    if tested_written.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression and tested_written.operator == 'not' {
        tested_written = tested_written.operand
        if tested_condition.class == HighIntermediaryRepresentation.Values.Negation {
            crash tested_condition.negated
            tested_condition = tested_condition.negated
        }
    }
    fallback is_a_bare_path(tested_written)
    fallback tested_condition.class == HighIntermediaryRepresentation.Values.PresenceTest
    crash tested_condition.tested
    var tested = tested_condition.tested
    var is_a_name = tested.class == HighIntermediaryRepresentation.Values.LocalRead
    is_a_name = is_a_name or tested.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback is_a_name and tested.value_type.is_nullable
    crash tested_written
    var printer = Printers.Spite.ExpressionPrinter(tested_written)
    var site = CheckSite("proven value", state.context)
    site.written = printer.text()
    site.keyword = keyword
    site.tested = tested
    state.context.note_a_check_site(site)
}

func note_a_check_of_a_plain_value(condition: SpiteCompiler.Expression?, keyword: String) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        note_a_check_of_a_plain_name(condition, keyword)
    }
}

func note_a_check_of_a_plain_name(
    condition: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    keyword: String,
) {
    var is_a_member = is_a_parameter(condition.name) or state.context.current_class.attribute_named(condition.name)
    var local_name = state.context.scope.internal_name_of(condition.name)
    if local_name and not is_a_member {
        note_a_check_of_a_plain_local(local_name, condition.name, keyword)
        return
    }
    var is_declared_plainly = is_a_parameter(condition.name) or state.context.current_class.attribute_named(condition.name)
    fallback is_declared_plainly
    var written_value = state.values.value_of(condition, null)
    var site = CheckSite("plain value", state.context)
    site.is_converted = written_value.class == HighIntermediaryRepresentation.Values.Conversion
    site.checked_type = written_value.value_type
    site.keyword = keyword
    site.written = condition.name
    state.context.note_a_check_site(site)
}

func note_a_plain_local(
    name: String,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    local_type: Model.Type,
) {
    fallback not local_type.is_nullable
    var function = state.context.current_function
    var is_a_walk = function.is_walked()
    var is_generic = not state.context.current_class.bound_types.is_empty()
    var written = statement.value
    var is_made = false
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        is_made = names_a_class(written.callee)
    }
    var is_the_same_everywhere = not is_a_walk and not is_generic
    fallback statement.declared_type or is_made or is_the_same_everywhere
    state.context.plain_locals.append(name)
}

func names_a_class(callee: SpiteCompiler.Expression?): Boolean {
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var first = callee.name.byte_at(0)
        return first >= 65 and first <= 90
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.is_a_class_name
    }
    return false
}

func note_a_check_of_a_plain_local(local_name: String, written: String, keyword: String) {
    fallback state.context.plain_locals.contains(local_name)
    var declared_type = state.context.scope.types[local_name]
    fallback declared_type
    var site = CheckSite("plain value", state.context)
    site.checked_type = declared_type
    site.keyword = keyword
    site.written = written
    state.context.note_a_check_site(site)
}

func is_a_parameter(name: String): Boolean {
    var index = 0
    while index < state.context.current_function.parameters.count() {
        var parameter = state.context.current_function.parameters[index]
        if parameter.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_leaving_if(written_condition: String, line: Integer) {
    var index = 0
    while index < state.facts_paths.count() {
        var path = state.facts_paths[index]
        state.context.scope.note_the_check(path, "the 'if {written_condition}' on line {line}, which leaves")
        index = index + 1
    }
}

func always_leaves(block: HighIntermediaryRepresentation.Statements.Block): Boolean {
    return state.endings.always_leaves(block)
}

func read_a_negated_fact(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_negated_unary(condition)
    }
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_negated_binary(condition)
    }
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_an_empty_question(condition)
    }
}

func read_a_negated_unary(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    fallback unary.operator == 'not'
    read_a_fact(unary.operand)
}

func read_a_negated_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'or' {
        read_a_negated_fact(binary.left)
        state.context.scope.enter()
        narrow_all(state.facts_paths, state.facts_types)
        read_a_negated_fact(binary.right)
        state.context.scope.leave()
        return
    }
    var left = binary.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_negated_count(binary, left)
        return
    }
    if binary.operator == 'greater' {
        read_a_bound_at_most(binary)
        return
    }
    fallback binary.operator == 'greater_or_equal'
    var counted = binary.right
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(binary, counted)
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func read_a_bound_at_most(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var sum = binary.left
    if sum.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression and binary.right {
        read_a_sum_at_most(sum, binary.right)
    }
}

func read_a_sum_at_most(
    sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: SpiteCompiler.Expression,
) {
    var name = added_name_of(sum)
    var reach = added_reach_of(sum)
    fallback not name.is_empty() and reach > 0
    crash sum.left
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(sum.left, 'less', counted)
    if reach > 1 {
        var lowered_text: String = reach - 1
        var lowered = AbstractSyntaxTree.Shapes.Expressions.LiteralExpression('integer_literal', lowered_text)
        var index = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(sum.left, 'plus', lowered)
        turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(index, 'less', counted)
    }
    read_a_binary_bound(turned)
}

func read_a_negated_count(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var opposite: AbstractSyntaxTree.Tokens.Token.Kind = 'equal_equal'
    switch binary.operator {
        'not_equal': opposite = 'equal_equal'
        'less': opposite = 'greater_or_equal'
        'less_or_equal': opposite = 'greater'
        'equal_equal': opposite = 'not_equal'
        'end_of_file': return
        'name': return
        'class_name': return
        'generic_name': return
        'integer_literal': return
        'decimal_literal': return
        'text_literal': return
        'symbol_literal': return
        'open_brace': return
        'close_brace': return
        'open_parenthesis': return
        'close_parenthesis': return
        'open_bracket': return
        'close_bracket': return
        'comma': return
        'dot': return
        'dots': return
        'colon': return
        'question': return
        'equals': return
        'plus': return
        'minus': return
        'star': return
        'slash': return
        'percent': return
        'greater': return
        'greater_or_equal': return
        'and': return
        'or': return
        'not': return
        'keyword_function': return
        'keyword_variable': return
        'keyword_enum': return
        'keyword_union': return
        'keyword_type': return
        'keyword_return': return
        'keyword_if': return
        'keyword_else': return
        'keyword_while': return
        'keyword_switch': return
        'keyword_fallback': return
        'keyword_crash': return
        'keyword_load': return
        'keyword_this': return
        'keyword_null': return
        'keyword_true': return
        'keyword_false': return
        'keyword_generic': return
        'keyword_singleton': return
    }
    crash binary.right
    var negated = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(counted, opposite, binary.right)
    read_a_count_fact(negated, counted)
}

func build_a_decided_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement, holds: Boolean) {
    state.context.note_a_folded_branch()
    if holds {
        var taken = block_of(statement.then_branch)
        add(taken)
        state.rest_is_folded_away = state.endings.always_leaves(taken)
        return
    }
    fallback statement.else_branch
    var other = block_of(statement.else_branch)
    add(other)
    state.rest_is_folded_away = state.endings.always_leaves(other)
}

func build_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    fallback not renewed_the_lists(statement)
    state.template_walks.check(state.context, statement)
    note_a_loop_copy(statement.condition)
    note_a_maybe_boolean(statement.condition, statement.condition)
    var base = state.context.scope.narrowed.count()
    state.context.loop_bases.append(base)
    var log_start = state.context.logged_calls.count()
    var reads_start = state.context.narrowed_reads.count()
    var written_condition = statement.condition
    var build_reads_before = state.context.folded_build_reads
    var condition = state.values.condition_of(statement.condition)
    note_a_check_of_a_proven_value(written_condition, condition, "while")
    note_a_decided_condition(condition, "while", written_condition, build_reads_before)
    var condition_work = state.context.pending
    state.context.pending = List<SpiteCompiler.Statement>()
    condition_work.each(log_the_calls_of)
    log_a_value(condition, statement.line)
    state.facts_paths = List<String>()
    state.facts_types = List<Model.Type>()
    state.facts_checks = List<String>()
    read_a_bound(statement.condition)
    read_a_present_path(statement.condition)
    var paths = state.facts_paths
    var types = state.facts_types
    var notes = state.facts_checks
    var check = checking_text("while", statement.condition, statement.line)
    var noted = notes_with(paths, notes, check)
    var body = loop_body_of(statement.body, paths, types, noted)
    extend_the_reads_over_the_loop(log_start, reads_start)
    crash state.context.loop_bases.remove_last()
    if state.context.loop_bases.is_empty() {
        state.context.loop_reads = List<String>()
    }
    if condition_work.is_empty() {
        var made = HighIntermediaryRepresentation.Statements.While(condition, body)
        made.line = statement.line
        add(made)
    } else {
        add_a_loop_whose_condition_works(condition_work, condition, body, statement.line)
    }
}

# ../../ARCHITECTURE.md#work-a-condition-needs-runs-where-the-condition-reaches-it
func add_a_loop_whose_condition_works(
    work: List<SpiteCompiler.Statement>,
    condition: SpiteCompiler.Value,
    body: HighIntermediaryRepresentation.Statements.Block,
    line: Integer,
) {
    var boolean = state.context.boolean()
    state.values.temporary_count = state.values.temporary_count + 1
    var going = state.context.scope.declare("going_{state.values.temporary_count}", boolean)
    var entering = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
    var started = HighIntermediaryRepresentation.Statements.Declare(going, boolean, entering)
    started.line = line
    add(started)
    var decided = HighIntermediaryRepresentation.Statements.Assign.Assign(going, condition)
    decided.line = line
    var tested = HighIntermediaryRepresentation.Values.LocalRead(boolean, going)
    var entered = HighIntermediaryRepresentation.Statements.If(tested, body, null)
    entered.line = line
    var round = HighIntermediaryRepresentation.Statements.Block()
    round.statements = work
    round.statements.append(decided)
    round.statements.append(entered)
    round.line = line
    var going_on = HighIntermediaryRepresentation.Values.LocalRead(boolean, going)
    var made = HighIntermediaryRepresentation.Statements.While(going_on, round)
    made.line = line
    add(made)
}

func called_alone(statement: SpiteCompiler.WrittenStatement): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var plain = value.arguments.is_empty() and value.generic_arguments.is_empty()
            if plain {
                return value
            }
        }
    }
    return null
}

# ../../OPTIMIZATIONS.md#a-list-of-lists-cleared-and-filled-with-new-lists-keeps-their-room
func renewed_by_a_loop(
    written: List<SpiteCompiler.WrittenStatement>,
    clear_index: Integer,
): AbstractSyntaxTree.Shapes.Statements.WhileStatement? {
    var clearing = written[clear_index]
    fallback clearing
    var list_name = cleared_list_of(clearing)
    fallback not list_name.is_empty()
    var next_index = clear_index + 1
    var declared = ""
    var between = written[next_index]
    if between and between.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        fallback not between.declared_type and is_a_fixed_bound(between.value)
        declared = between.name
        next_index = next_index + 1
    }
    var looping = written[next_index]
    if looping and looping.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        var refilled = refills_with_new_lists(looping, list_name, declared)
        if refilled {
            return looping
        }
    }
    return null
}

func cleared_list_of(statement: SpiteCompiler.WrittenStatement): String {
    var cleared = called_alone(statement)
    fallback cleared
    var callee = cleared.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "clear" {
        return name_of(callee.target)
    }
    return ""
}

func refills_with_new_lists(
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    list_name: String,
    declared: String,
): Boolean {
    var condition = loop.condition
    fallback loop.body
    fallback loop.body.statements.count() == 3
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var counter = name_of(condition.left)
        fallback condition.operator == 'less' and not counter.is_empty() and counter != list_name
        fallback is_a_fixed_bound(condition.right)
        fallback counter == declared or counts_whole_numbers(counter)
        return refills_in(loop.body, list_name, counter)
    }
    return false
}

func refills_in(body: AbstractSyntaxTree.Shapes.Statements.Block, list_name: String, counter: String): Boolean {
    var making = body.statements[0]
    var appending = body.statements[1]
    var stepping = body.statements[2]
    crash making
    crash appending
    crash stepping
    fallback steps_by_one(stepping, counter)
    if making.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        var made_name = making.name
        fallback not making.declared_type and made_name != list_name and made_name != counter
        fallback appends_the_made(appending, list_name, made_name)
        return makes_an_empty_item_of(making.value, list_name)
    }
    return false
}

func appends_the_made(statement: SpiteCompiler.WrittenStatement, list_name: String, made_name: String): Boolean {
    var appended = called_with_one(statement)
    fallback appended
    var callee = appended.callee
    var passed = appended.arguments.first()
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var on_the_list = callee.name == "append" and name_of(callee.target) == list_name
        return on_the_list and name_of(passed) == made_name
    }
    return false
}

func called_with_one(statement: SpiteCompiler.WrittenStatement): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var one = value.arguments.count() == 1 and value.generic_arguments.is_empty()
            if one {
                return value
            }
        }
    }
    return null
}

func makes_an_empty_item_of(made: SpiteCompiler.Expression?, list_name: String): Boolean {
    if made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        fallback made.arguments.is_empty() and not made.generic_arguments.is_empty()
        var item_type = renewed_item_type_of(list_name)
        fallback item_type
        var path = state.values.class_path_of(made.callee)
        fallback not path.is_empty()
        var made_type = state.context.resolver.types.class_type_in(
            path,
            made.generic_arguments,
            state.context.current_class,
            state.context.line,
        )
        return made_type.kind == 'object' and made_type.name == item_type.name
    }
    return false
}

func renewed_item_type_of(list_name: String): Model.Type? {
    var list_type = type_of_a_name(list_name)
    fallback list_type
    fallback list_type.kind == 'object' and not list_type.is_nullable and state.context.has_a_class(list_type)
    var list_class = state.context.class_of(list_type)
    var forms = HeldOnceForms(state.context, state.values)
    fallback forms.is_a_list(list_class)
    var item_type = list_class.bound_types["$element_type"]
    fallback item_type
    fallback item_type.kind == 'object' and not item_type.is_nullable and state.context.has_a_class(item_type)
    var item_class = state.context.class_of(item_type)
    if forms.is_a_list(item_class) {
        return item_type
    }
    return null
}

func renewed_the_lists(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement): Boolean {
    var clear_index = state.context.block_index - 1
    var before = state.context.block_statements[clear_index]
    if before and before.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        clear_index = clear_index - 1
    }
    fallback clear_index >= 0
    var renewed = renewed_by_a_loop(state.context.block_statements, clear_index)
    fallback renewed and renewed.line == statement.line
    var clearing = state.context.block_statements[clear_index]
    crash clearing
    var list_name = cleared_list_of(clearing)
    var condition = statement.condition
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        crash condition.right
        build_the_renewal(statement, condition, list_name, condition.right)
        return true
    }
    return false
}

func build_the_renewal(
    statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    list_name: String,
    bound: SpiteCompiler.Expression,
) {
    var counter = name_of(condition.left)
    var counted = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var wanted = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(bound, 'minus', counted)
    var renewing_arguments = List<SpiteCompiler.Expression>()
    renewing_arguments.append(wanted)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var renewed_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var renewing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(renewed_list, "clear")
    var renewing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(
        renewing_callee,
        no_generics,
        renewing_arguments,
    )
    var renewal = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(renewing)
    renewal.line = statement.line
    var finished_counter = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var finishing = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(finished_counter, bound)
    finishing.line = statement.line
    var inside = List<SpiteCompiler.WrittenStatement>()
    inside.append(renewal)
    inside.append(finishing)
    var then_block = AbstractSyntaxTree.Shapes.Statements.Block(inside)
    then_block.line = statement.line
    then_block.end_line = statement.line
    var cleared_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var clearing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(cleared_list, "clear")
    var no_arguments = List<SpiteCompiler.Expression>()
    var clearing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(clearing_callee, no_generics, no_arguments)
    var cleared = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(clearing)
    cleared.line = statement.line
    var otherwise = List<SpiteCompiler.WrittenStatement>()
    otherwise.append(cleared)
    var else_block = AbstractSyntaxTree.Shapes.Statements.Block(otherwise)
    else_block.line = statement.line
    else_block.end_line = statement.line
    var once = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, then_block, else_block)
    once.line = statement.line
    state.context.renews_the_lists = true
    build(once)
    state.context.renews_the_lists = false
}

func name_of(expression: SpiteCompiler.Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name
    }
    return ""
}

func counts_whole_numbers(counter: String): Boolean {
    var counter_type = type_of_a_name(counter)
    fallback counter_type
    return counter_type.kind == 'scalar' and counter_type.name == "Integer" and not counter_type.is_nullable
}

func is_a_fixed_bound(bound: SpiteCompiler.Expression?): Boolean {
    if bound.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return bound.kind == 'integer_literal'
    }
    return false
}

func steps_by_one(statement: SpiteCompiler.WrittenStatement, counter: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target_name = name_of(statement.target)
        return target_name == counter and adds_one_to(statement.value, counter)
    }
    return false
}

func adds_one_to(value: SpiteCompiler.Expression?, counter: String): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var added_to = name_of(value.left)
        return added_to == counter and value.operator == 'plus' and is_one(value.right)
    }
    return false
}

func is_one(step: SpiteCompiler.Expression?): Boolean {
    if step.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return step.kind == 'integer_literal' and step.text == "1"
    }
    return false
}

func type_of_a_name(name: String): Model.Type? {
    var internal_name = state.context.scope.internal_name_of(name)
    if internal_name {
        return state.context.scope.type_of(internal_name)
    }
    var attribute = state.context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func read_a_present_path(condition: SpiteCompiler.Expression?) {
    var is_a_path = condition.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback is_a_path
    read_a_fact(condition)
}

func read_a_bound(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_bound(condition)
    }
}

func read_a_binary_bound(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if condition.operator == 'and' {
        read_a_bound(condition.left)
        read_a_bound(condition.right)
        return
    }
    if condition.operator == 'less_or_equal' {
        read_a_bound_at_most(condition)
        return
    }
    var left = condition.left
    var counts = condition.operator == 'equal_equal' or condition.operator == 'greater_or_equal'
    counts = counts or condition.operator == 'greater' or condition.operator == 'not_equal'
    if counts and left.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count_fact(condition, left)
        return
    }
    var counted = condition.right
    fallback condition.operator == 'less'
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_windowed_counter(condition)
        read_a_counted_local(condition, counted)
    }
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_lowered_count(condition, counted)
    }
}

# ../../PROOFS.md#an-index-offset-by-a-base-is-proven-by-one-guard
func read_a_windowed_counter(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var windows = Windows(state.context, state.values)
    windows.read_a_counter(condition)
    var index = 0
    while index < windows.proven_paths.count() {
        var path = windows.proven_paths[index]
        var present = windows.proven_types[index]
        crash present
        state.facts_paths.append(path)
        state.facts_types.append(present)
        note_a_loop_check(condition)
        index = index + 1
    }
}

func read_a_lowered_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    lowered: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    fallback lowered.operator == 'minus'
    var counted = lowered.left
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
}

func read_a_counted_local(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var internal_name = state.context.scope.internal_name_of(counted.name)
    fallback internal_name
    var listed = state.context.counted_lists[internal_name]
    fallback listed
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var list_value = state.values.value_of(listed, null)
    fallback state.context.has_a_class(list_value.value_type) and not list_value.value_type.is_nullable
    var owner = state.context.class_of(list_value.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(listed)
    var list_text = printer.text()
    state.facts_paths.append("{list_text}[{index_name}]")
    state.facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        state.facts_paths.append("{list_text}[{index_name} + {offset}]")
        state.facts_types.append(present)
        offset = offset + 1
    }
}

func note_a_loop_check(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    while state.facts_checks.count() < state.facts_paths.count() - 1 {
        state.facts_checks.append("")
    }
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    state.facts_checks.append("the loop condition '{written}'")
}

func holds_maybes(listing: Model.ClassModel): Boolean {
    var item_type = listing.bound_types["$element_type"]
    if item_type {
        return item_type.is_nullable
    }
    return false
}

func read_a_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_list(condition, counted, callee)
    }
}

func read_a_counted_list(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var listed = state.values.value_of(callee.target, null)
    fallback state.context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = state.context.class_of(listed.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var element: Model.Type = reader.answer
    var present = element.present()
    state.facts_paths.append("{list_text}[{index_name}]")
    state.facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        state.facts_paths.append("{list_text}[{index_name} + {offset}]")
        state.facts_types.append(present)
        offset = offset + 1
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func whole_index_of(left: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    fallback not holds_a_call(left)
    var printer = Printers.Spite.ExpressionPrinter(left)
    return printer.text()
}

func added_name_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var left = sum.left
    fallback sum.operator == 'plus'
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return left.name
    }
    return ""
}

func added_reach_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    var right = sum.right
    if right.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(right)
    }
    return 0
}

func literal_reach_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    var number: Integer? = literal.text
    fallback literal.kind == 'integer_literal' and number
    return number
}

func build_inner_block(statement: AbstractSyntaxTree.Shapes.Statements.Block) {
    var made = block_of(statement)
    add(made)
}

func build_fallback(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement) {
    note_a_proven_check(statement.condition)
    note_a_proven_read_check(statement.condition, "fallback")
    note_a_check_of_a_plain_value(statement.condition, "fallback")
    note_a_repeated_check(statement.condition, statement.line)
    note_a_proven_divisor(statement.condition, statement.line)
    var parts = List<SpiteCompiler.Expression>()
    gather_the_parts(statement.condition, parts)
    var symbols = state.context.resolver.state.symbols
    var path = state.context.path()
    if parts.count() < 2 or symbols.is_library_path(path) {
        var whole_holds = build_a_guard(statement, true)
        fallback whole_holds
        return
    }
    build_each_part(statement, parts)
}

# ../../OPTIMIZATIONS.md#a-crashs-condition-lives-beside-the-executable
func gather_the_parts(condition: SpiteCompiler.Expression?, parts: List<SpiteCompiler.Expression>) {
    fallback condition
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression and condition.operator == 'and' {
        gather_the_parts(condition.left, parts)
        gather_the_parts(condition.right, parts)
        return
    }
    parts.append(condition)
}

func build_each_part(
    statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement,
    parts: List<SpiteCompiler.Expression>,
) {
    var build_reads_before = state.context.folded_build_reads
    var every_part_holds = true
    var index = 0
    while index < parts.count() and not state.rest_is_folded_away {
        var part = parts[index]
        var guard = AbstractSyntaxTree.Shapes.Statements.FallbackStatement(part)
        guard.line = statement.line
        guard.column = statement.column
        if part.line == statement.line {
            guard.column = part.column
        }
        var holds = build_a_guard(guard, false)
        every_part_holds = every_part_holds and holds
        index = index + 1
    }
    fallback every_part_holds and not state.rest_is_folded_away
    var boolean = state.context.boolean()
    var held = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
    note_a_check_that_always_holds(held, "fallback", statement.condition)
    note_a_decided_condition(held, "fallback", statement.condition, build_reads_before)
}

func build_a_guard(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement, is_whole: Boolean): Boolean {
    var written_condition = statement.condition
    statement.condition = state.values.with_its_links(statement.condition)
    var build_reads_before = state.context.folded_build_reads
    var condition = state.values.condition_of(statement.condition)
    if is_whole {
        note_a_check_that_always_holds(condition, "fallback", written_condition)
        note_a_check_of_a_proven_value(written_condition, condition, "fallback")
        note_a_decided_condition(condition, "fallback", written_condition, build_reads_before)
    }
    var decided = decided_number_of(condition)
    var holds = false
    if decided {
        holds = decided.number != 0
    }
    var failed = HighIntermediaryRepresentation.Statements.Block()
    var noting: SpiteCompiler.Statement? = null
    if not leaves_a_walk_copy(condition) {
        noting = noted_failure(statement)
    }
    if noting {
        failed.statements.append(noting)
    }
    var leaving = default_return(written_condition)
    failed.statements.append(leaving)
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber and condition.number == 0 {
        state.context.note_a_folded_branch()
        failed.line = statement.line
        add(failed)
        state.rest_is_folded_away = true
        return false
    }
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    add(made)
    var operands = operands_of(statement.condition)
    read_facts(statement.condition)
    if noting {
        var kind = "fallback-predicate"
        if not state.facts_paths.is_empty() {
            kind = "fallback-narrowing"
        }
        note_a_crash_site(
            state.last_site_identity,
            statement.line,
            statement.column,
            kind,
            statement.condition,
            operands,
        )
    }
    narrow_all(state.facts_paths, state.facts_types)
    note_the_checks("fallback", statement.condition, statement.line)
    var windows = Windows(state.context, state.values)
    windows.note_a_guard(statement.condition)
    return holds
}

# ../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func leaves_a_walk_copy(condition: SpiteCompiler.Value): Boolean {
    fallback state.context.current_function.is_a_walk_copy
    return is_decided_false(condition)
}

func operands_of(condition: SpiteCompiler.Expression?): String {
    var reports = Reports(state)
    var names = List<String>()
    state.name_places = List<String>()
    reports.gather_the_names(condition, names)
    var described = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
        var read = state.values.value_of(identifier, null)
        var shown = state.context.shown(read.value_type)
        var place = state.name_places[index]
        crash place
        described.append("{name}:{shown}{place}")
        index = index + 1
    }
    return described.join(" ")
}

func note_a_crash_site(
    identity: String,
    line: Integer,
    column: Integer,
    kind: String,
    condition: SpiteCompiler.Expression?,
    operands: String,
) {
    var source = ""
    if condition {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        source = printer.text()
    }
    var owner = state.context.current_function.owner
    var shown_owner = last_part_of(owner)
    var function_name = state.context.current_function.name
    var written_path = state.context.path()
    var path = written_path.replace("\\", "/")
    var site = "{identity}\t{path}\t{line}\t{column}\t{shown_owner}\t{function_name}\t{kind}\t{source}\t{operands}"
    state.context.crash_sites.append(site)
}

func noted_failure(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement): SpiteCompiler.Statement? {
    var symbols = state.context.resolver.state.symbols
    var path = state.context.path()
    fallback not symbols.is_library_path(path)
    var ring = assert_ring()
    fallback ring
    var failing = ring.function_named("failed")
    crash failing
    state.values.need(failing)
    var site = site_line(statement.condition, statement.line, "spite.fallback")
    var answered = answered_by_a_fallback()
    var site_text = state.values.described_text("{site}\treturned={answered}")
    var streams = 0
    var asked = state.context.build_flags["trace_fallbacks"]
    if asked == "true" {
        streams = 1
    }
    var boolean = state.context.boolean()
    var streaming = HighIntermediaryRepresentation.Values.WholeNumber(boolean, streams)
    var passed = List<SpiteCompiler.Value>()
    passed.append(site_text)
    passed.append(streaming)
    var fetched = ring_object(ring)
    var called = HighIntermediaryRepresentation.Values.Call(failing, fetched, passed)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(called)
    evaluated.line = statement.line
    return evaluated
}

func answered_by_a_fallback(): String {
    var answered = "nothing"
    if state.context.current_function.answer {
        answered = answered_by(state.context.current_function.answer)
    }
    return answered
}

func answered_by(answer: Model.Type): String {
    var shown = state.context.shown(answer)
    if not answer.is_nullable and is_a_collection(answer, shown) {
        return "empty"
    }
    return "null"
}

func assert_ring(): Model.ClassModel? {
    fallback state.context.resolver.state.symbols.program_asserts
    var found = state.context.resolver.state.symbols.find("Spite.Asserts", "")
    fallback found
    var ring = state.context.resolver.monomorphiser.class_model_named("Spite.Asserts")
    fallback ring
    state.context.need_defaults(ring.key)
    return ring
}

func ring_object(ring: Model.ClassModel): SpiteCompiler.Value {
    var ring_type = ring.type_of_an_instance()
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(ring_type, null, no_arguments)
}

func site_line(condition: SpiteCompiler.Expression?, line: Integer, kind: String): String {
    var function_name = state.context.current_function.name
    var identity = identity_of_a_site(condition, "")
    state.last_site_identity = identity
    var owner = state.context.current_function.owner
    var asked = state.context.build_flags["optimized"]
    if asked == "true" {
        return "{kind}\t{identity}"
    }
    var shown_owner = last_part_of(owner)
    return "{kind}\t{identity}\t{state.context.path()}:{line}\t{shown_owner}\t{function_name}"
}

func identity_of_a_site(condition: SpiteCompiler.Expression?, counted_as: String): String {
    var owner = state.context.current_function.owner
    var function_name = state.context.current_function.name
    var source = ""
    if condition {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        source = printer.text()
    }
    var place_key = "{owner}.{function_name}{counted_as}"
    var ordinal = 0
    var known = state.context.site_ordinals[place_key]
    if known {
        ordinal = known
    }
    state.context.site_ordinals[place_key] = ordinal + 1
    var hashed = "{owner}|{function_name}|{ordinal}|{source}"
    if not counted_as.is_empty() {
        hashed = "{counted_as}|{hashed}"
    }
    return site_identity(hashed)
}

func last_part_of(owner: String): String {
    var parts = owner.split(".")
    var last_index = parts.count() - 1
    var last = parts[last_index]
    crash last
    return last
}

func site_identity(written: String): String {
    var high = 0
    var low = 0
    var index = 0
    while index < written.length() {
        var code = written.byte_at(index)
        var mixed_high = high * 31 + code
        high = mixed_high % _high_sum_modulus
        var mixed_low = low * _low_sum_multiplier + code
        low = mixed_low % _low_sum_modulus
        index = index + 1
    }
    var high_digits = four_hexadecimal_digits(high)
    var low_digits = four_hexadecimal_digits(low)
    return "{high_digits}{low_digits}"
}

func four_hexadecimal_digits(number: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = number
    var place = 0
    while place < 4 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        crash character
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

func default_return(written_condition: SpiteCompiler.Expression?): SpiteCompiler.Statement {
    if not state.context.current_function.answer {
        return HighIntermediaryRepresentation.Statements.Return(null)
    }
    var answer: Model.Type = state.context.current_function.answer
    if answer.is_nullable {
        var nothing = HighIntermediaryRepresentation.Values.NullConstant(answer)
        return HighIntermediaryRepresentation.Statements.Return(nothing)
    }
    var full_name = state.context.shown(answer)
    var is_built_empty = is_built_with_no_arguments(answer)
    if is_a_collection(answer, full_name) or is_built_empty {
        var empty = state.values.default_of_a_type(answer)
        return HighIntermediaryRepresentation.Statements.Return(empty)
    }
    var site = GuardSite("default", state.context)
    site.condition = written_condition
    state.context.note_a_guard_site(site)
    return HighIntermediaryRepresentation.Statements.Return(null)
}

func is_built_with_no_arguments(answer: Model.Type): Boolean {
    if answer.kind == 'scalar' {
        return true
    }
    fallback answer.kind == 'object'
    if answer.name == "String" {
        return true
    }
    fallback state.context.has_a_class(answer)
    var model = state.context.class_of(answer)
    fallback not model.is_singleton
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        fallback not function.is_constructor or function.parameters.count() <= 0
        index = index + 1
    }
    return true
}

func is_a_collection(answer: Model.Type, shown: String): Boolean {
    fallback answer.kind == 'object'
    var collections = ["List<", "Dictionary<", "Vector<", "Items<"]
    var index = 0
    while index < collections.count() {
        var opening = collections[index]
        if shown.starts_with(opening) {
            return true
        }
        index = index + 1
    }
    return false
}

func build_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    var reports = Reports(state)
    var place = "spite: the program stopped at {state.context.path()}:{statement.line} in {state.context.current_function.owner}.{state.context.current_function.name}"
    state.shown_parts = List<ShownPart>()
    state.shown_texts = List<String>()
    state.reads_before = false
    if always_stops(statement.condition) {
        var always = identity_of_a_site(null, "|crash")
        var always_message = "{place}, site {always}"
        note_a_crash_site(always, statement.line, statement.column, "crash", null, "")
        var nothing_mentioned = List<String>()
        var stopping = reports.report_of(always_message, null, nothing_mentioned, statement.line)
        stopping.each(add)
        return
    }
    var constants = state.values.known_constants()
    if constants.holds_for_certain(statement.condition) {
        var always_true = state.values.boolean_constant(true)
        note_a_check_that_always_holds(always_true, "crash", statement.condition)
        return
    }
    note_a_proven_check(statement.condition)
    note_a_proven_read_check(statement.condition, "crash")
    note_a_check_of_a_plain_value(statement.condition, "crash")
    note_a_repeated_check(statement.condition, statement.line)
    note_a_proven_divisor(statement.condition, statement.line)
    var build_fields = Validators.HighIntermediaryRepresentation.FoldedCrash.Validator()
    var field_is_false = build_fields.is_a_false_build_field(state.context, statement.condition)
    var identity = identity_of_a_site(statement.condition, "|crash")
    var message = "{place}, site {identity}"
    var written = statement.condition
    crash written
    state.context.line = statement.line
    flush_the_pending()
    var first_held = state.built.count()
    var held_before = state.reported_count
    var rewritten = reports.held_for_the_report(written, 2, 0, true)
    var mentioned = List<String>()
    reports.gather_every_name(written, mentioned)
    statement.condition = state.values.with_its_links(statement.condition)
    var linked = statement.condition
    var unheld: SpiteCompiler.Value? = null
    if state.reported_count > held_before {
        unheld = folded_unheld_crash(statement)
        linked = state.values.with_its_links(rewritten)
    }
    var condition = state.values.condition_of(linked)
    note_a_check_that_always_holds(condition, "crash", written)
    note_a_check_of_a_proven_value(written, condition, "crash")
    flush_the_pending()
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements = reports.report_of(message, written, mentioned, statement.line)
    var operands = state.report_types.join(" ")
    note_a_crash_site(identity, statement.line, statement.column, "crash", written, operands)
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    var printer = Printers.Spite.ExpressionPrinter(statement.condition)
    made.crashes_unless = printer.text()
    made.decided_condition = unheld
    if field_is_false {
        var never_holds = state.values.boolean_constant(false)
        made.decided_condition = HighIntermediaryRepresentation.Values.Negation(never_holds)
    }
    add(made)
    if state.reported_count > held_before {
        reports.let_go_after_the_check(first_held, statement.line)
    }
    if always_halts(condition, unheld) {
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = statement.line
        add(stopped)
        state.rest_is_folded_away = true
        return
    }
    read_facts(statement.condition)
    narrow_all(state.facts_paths, state.facts_types)
    note_the_checks("crash", statement.condition, statement.line)
    var windows = Windows(state.context, state.values)
    windows.note_a_guard(statement.condition)
}

# ../../PROOFS.md#a-crash-that-folds-false-is-a-compile-error
func always_halts(condition: SpiteCompiler.Value, unheld: SpiteCompiler.Value?): Boolean {
    if unheld.class == HighIntermediaryRepresentation.Values.Negation {
        return is_decided_false(unheld.negated)
    }
    return is_decided_false(condition)
}

func is_decided_false(condition: SpiteCompiler.Value?): Boolean {
    fallback condition
    var decided = decided_number_of(condition)
    fallback decided
    return decided.number == 0
}

func always_stops(condition: SpiteCompiler.Expression?): Boolean {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return condition.kind == 'keyword_false'
    }
    return not condition
}

func build_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var subject = state.values.value_of(statement.value, null)
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var path = printer.text()
    if subject.value_type.is_nullable {
        note_a_loop_copy(statement.value)
    }
    check_the_case_kinds(statement, subject.value_type)
    var closed_values = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    closed_values.check_closed_values(state.context, subject.value_type, path, statement.line)
    if is_closed(subject.value_type) {
        check_the_cover(statement, subject.value_type, path)
    }
    check_the_rest_of_values(statement, subject.value_type, path)
    state.context.line = statement.line
    var narrowed_path = path_of(statement.value, path)
    var is_computed = statement.value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    if is_computed {
        subject = state.values.held_once(subject)
        flush_the_pending()
    }
    var chain = switch_chain(statement, subject, narrowed_path, 0)
    crash chain
    if subject.value_type.is_nullable {
        check_the_nullable_cover(statement, subject.value_type, path)
    }
    add(chain)
}

func switch_chain(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject: SpiteCompiler.Value,
    path: String,
    index: Integer,
): SpiteCompiler.Statement? {
    var switch_case = statement.cases[index]
    fallback switch_case
    var written = switch_case.value
    var paths = List<String>()
    var types = List<Model.Type>()
    var is_the_rest = false
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_the_rest = written.name == "_"
    }
    var is_a_union = subject.value_type.kind == 'union' and not subject.value_type.is_nullable
    if is_the_rest and is_a_union {
        var rest_type = rest_of_the_union(statement, subject.value_type, index)
        paths.append(path)
        types.append(rest_type)
        var rest_body = narrowed_block_of(switch_case.body, paths, types, "the 'switch' on line {statement.line}")
        name_the_case(rest_body, written, statement.line)
        return rest_body
    }
    if is_the_rest {
        var other_body = block_of(switch_case.body)
        name_the_case(other_body, written, statement.line)
        return other_body
    }
    state.context.line = statement.line
    if not subject.value_type.is_nullable {
        state.context.line = switch_case.line
    }
    var condition = case_condition(subject, written, path, paths, types)
    var body = narrowed_block_of(switch_case.body, paths, types, "the 'switch' on line {statement.line}")
    name_the_case(body, written, statement.line)
    var is_the_last = index == statement.cases.count() - 1
    var present = subject.value_type.present()
    var is_a_whole_boolean = is_a_boolean_type(subject.value_type) and statement.cases.count() == 2
    if is_the_last and (is_closed(present) or is_a_whole_boolean) {
        return body
    }
    var rest = switch_chain(statement, subject, path, index + 1)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if rest {
        var wrapped = HighIntermediaryRepresentation.Statements.Block()
        wrapped.statements.append(rest)
        else_branch = wrapped
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, body, else_branch)
    made.line = statement.line
    return made
}

func name_the_case(
    body: HighIntermediaryRepresentation.Statements.Block,
    written: SpiteCompiler.Expression?,
    line: Integer,
) {
    crash written
    var printer = Printers.Spite.ExpressionPrinter(written)
    body.case_written = printer.text()
    body.switch_line = line
}

func rest_of_the_union(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    union_type: Model.Type,
    rest_index: Integer,
): Model.Type {
    var covered = List<String>()
    var index = 0
    while index < rest_index {
        var switch_case = statement.cases[index]
        crash switch_case
        var class_path = state.values.class_path_of(switch_case.value)
        if not class_path.is_empty() {
            var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
            var member = state.context.resolver.types.class_type_in(
                class_path,
                no_arguments,
                state.context.current_class,
                state.context.line,
            )
            covered.append(member.name)
        }
        index = index + 1
    }
    var united = state.values.union_model_of(union_type)
    var left = List<Model.Type>()
    var left_names = List<String>()
    var member_index = 0
    while member_index < united.members.count() {
        var held = united.members[member_index]
        if not covered.contains(held.name) {
            left.append(held)
            var segments = held.name.split(".")
            var simple = segments.last()
            crash simple
            left_names.append(simple)
        }
        member_index = member_index + 1
    }
    if left.count() != 1 {
        return rest_union(united, left, left_names)
    }
    return left[0]
}

func rest_union(united: Model.UnionModel, left: List<Model.Type>, left_names: List<String>): Model.Type {
    var parts = united.key.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var joined = left_names.join("_or_")
    var simple = "{united.name}_of_{joined}"
    var known = owner.union_named(simple)
    if not known {
        var made = Model.UnionModel("{owner_key}.{simple}", simple)
        made.members = left
        owner.unions.append(made)
    }
    return Model.Type('union', "{owner_key}.{simple}")
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func is_a_boolean_type(value_type: Model.Type): Boolean {
    return state.context.is_a_truth_value(value_type)
}

func check_the_cover(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var written = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var printer = Printers.Spite.ExpressionPrinter(switch_case.value)
        var text = printer.text()
        var segments = text.split(".")
        var last = segments.count() - 1
        var simple = segments[last]
        crash simple
        written.append(simple)
        index = index + 1
    }
    var every = List<String>()
    var is_an_enum = subject_type.kind == 'enumeration'
    var subject = path
    if is_an_enum {
        var enumeration = state.values.enum_model_of(subject_type)
        var value_index = 0
        while value_index < enumeration.values.count() {
            var value = enumeration.values[value_index]
            every.append("'{value}'")
            value_index = value_index + 1
        }
    } else {
        var united = state.values.union_model_of(subject_type)
        subject = united.name
        var member_index = 0
        while member_index < united.members.count() {
            var member = united.members[member_index]
            var member_segments = member.name.split(".")
            var member_last = member_segments.count() - 1
            var member_name = member_segments[member_last]
            crash member_name
            every.append(member_name)
            member_index = member_index + 1
        }
    }
    var shown_whole = state.context.shown(subject_type)
    var shown_segments = shown_whole.split(".")
    var shown = shown_segments.last()
    crash shown
    if subject_type.kind == 'union' {
        subject = shown
    }
    var rest_line = rest_line_of(statement, is_an_enum)
    var site = SwitchSite(state.context.current_class, state.context.current_function, statement.line, rest_line)
    site.shown = shown
    site.subject = subject
    site.is_an_enum = is_an_enum
    site.every = every
    site.written = written
    state.context.switch_sites.append(site)
}

func check_the_nullable_cover(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var present = subject_type.present()
    var is_a_union = present.kind == 'union'
    var is_an_object = present.kind == 'object'
    fallback is_a_union or is_an_object
    var written = written_cases_of(statement)
    var every = List<String>()
    if is_a_union {
        var united = state.values.union_model_of(present)
        var member_index = 0
        while member_index < united.members.count() {
            var member = united.members[member_index]
            var member_segments = member.name.split(".")
            var member_name = member_segments.last()
            crash member_name
            every.append(member_name)
            member_index = member_index + 1
        }
    } else {
        var present_segments = present.name.split(".")
        var present_name = present_segments.last()
        crash present_name
        every.append(present_name)
    }
    every.append("Null")
    var shown_whole = state.context.shown(subject_type)
    var shown_segments = shown_whole.split(".")
    var shown = shown_segments.last()
    crash shown
    var rest_line = rest_line_of(statement, false)
    var site = SwitchSite(state.context.current_class, state.context.current_function, statement.line, rest_line)
    site.shown = shown
    site.subject = path
    site.is_nullable = true
    site.every = every
    site.written = written
    state.context.switch_sites.append(site)
}

func written_cases_of(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement): List<String> {
    var written = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var printer = Printers.Spite.ExpressionPrinter(switch_case.value)
        var text = printer.text()
        var segments = text.split(".")
        var simple = segments.last()
        crash simple
        written.append(simple)
        index = index + 1
    }
    return written
}

func rest_line_of(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, is_an_enum: Boolean): Integer {
    var last = statement.cases.count() - 1
    var place = last
    if not is_an_enum and last > 0 {
        place = last - 1
    }
    var switch_case = statement.cases[place]
    crash switch_case
    return switch_case.line
}

func check_the_case_kinds(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement, subject_type: Model.Type) {
    fallback not subject_type.is_nullable
    var is_an_enum = subject_type.kind == 'enumeration'
    var is_a_union = subject_type.kind == 'union'
    fallback is_an_enum or is_a_union
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        state.context.line = switch_case.line
        check_a_case_kind(switch_case.value, subject_type, is_an_enum)
        index = index + 1
    }
}

func check_a_case_kind(written: SpiteCompiler.Expression?, subject_type: Model.Type, is_an_enum: Boolean) {
    var shown = state.context.shown(subject_type)
    var class_path = state.values.class_path_of(written)
    var first_value = ""
    var first_member = ""
    if is_an_enum {
        first_value = first_value_of(subject_type)
    } else {
        first_member = first_member_of(subject_type)
    }
    var cases = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    cases.check_a_case_kind(state.context, written, class_path, shown, is_an_enum, first_value, first_member)
}

func first_value_of(subject_type: Model.Type): String {
    var enumeration = state.values.enum_model_of(subject_type)
    var first = enumeration.values[0]
    crash first
    return first
}

func first_member_of(subject_type: Model.Type): String {
    var united = state.values.union_model_of(subject_type)
    var member = united.members[0]
    crash member
    var member_segments = member.name.split(".")
    var member_name = member_segments.last()
    crash member_name
    return member_name
}

func reads_through_a_call(written: SpiteCompiler.Expression?): Boolean {
    if written {
        return path_reads_through_a_call(written)
    }
    return false
}

func path_reads_through_a_call(written: SpiteCompiler.Expression): Boolean {
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return reads_through_a_call(written.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_reads_through_a_call(written)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return false
    }
}

func index_reads_through_a_call(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    if holds_a_call(read.index) {
        return true
    }
    return reads_through_a_call(read.target)
}

func holds_a_call(written: SpiteCompiler.Expression?): Boolean {
    if written {
        return expression_holds_a_call(written)
    }
    return false
}

func expression_holds_a_call(written: SpiteCompiler.Expression): Boolean {
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return true
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return holds_a_call(written.target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return either_index_holds_a_call(written)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return holds_a_call(written.operand)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return either_side_holds_a_call(written)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return false
    }
}

func either_index_holds_a_call(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    if holds_a_call(read.target) {
        return true
    }
    return holds_a_call(read.index)
}

func either_side_holds_a_call(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    if holds_a_call(binary.left) {
        return true
    }
    return holds_a_call(binary.right)
}

func check_the_rest_of_values(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var is_a_whole_number = subject_type.kind == 'scalar' and state.values.is_a_whole_number(subject_type)
    var last = statement.cases.last()
    crash last
    var cases = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    cases.check_a_rest_case(state.context, subject_type, is_a_whole_number, last.value, path, statement.line)
}

func is_closed(subject_type: Model.Type): Boolean {
    fallback not subject_type.is_nullable
    return subject_type.kind == 'enumeration' or subject_type.kind == 'union'
}

func case_condition(
    subject: SpiteCompiler.Value,
    written: SpiteCompiler.Expression?,
    path: String,
    paths: List<String>,
    types: List<Model.Type>,
): SpiteCompiler.Value {
    var class_path = state.values.class_path_of(written)
    var is_nullable = subject.value_type.is_nullable
    if is_nullable and is_the_null_case(class_path) {
        var there = HighIntermediaryRepresentation.Values.PresenceTest(subject)
        return HighIntermediaryRepresentation.Values.Negation(there)
    }
    if not class_path.is_empty() {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member = state.context.resolver.types.class_type_in(
            class_path,
            no_arguments,
            state.context.current_class,
            state.context.line,
        )
        paths.append(path)
        types.append(member)
        var present = subject.value_type.present()
        if is_nullable and member.is_the_same_as(present) {
            return HighIntermediaryRepresentation.Values.PresenceTest(subject)
        }
        return HighIntermediaryRepresentation.Values.Class.Membership(subject, member)
    }
    var expected = subject.value_type
    var constant = state.values.value_of(written, expected)
    if state.values.is_machine_comparable(expected) {
        var boolean = state.context.boolean()
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', subject, constant)
    }
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(constant)
    return state.values.method_call(subject, "equals", arguments)
}

func is_the_null_case(class_path: List<String>): Boolean {
    fallback class_path.count() == 1
    var only = class_path[0]
    return only == "Null"
}

func read_facts(condition: SpiteCompiler.Expression?) {
    state.facts_paths = List<String>()
    state.facts_types = List<Model.Type>()
    read_a_fact(condition)
}

func read_a_fact(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_fact(condition)
        return
    }
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_not_empty(condition)
        return
    }
    var is_a_path = condition.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback is_a_path
    fallback not reads_through_a_call(condition)
    crash condition
    var written_value = state.values.value_of(condition, null)
    var value = state.values.result_of_handle(written_value)
    fallback value.value_type.is_nullable
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var path = printer.text()
    var present = value.value_type.present()
    var fact_path = path_of(condition, path)
    note_a_narrowed_copy(fact_path)
    state.facts_paths.append(fact_path)
    state.facts_types.append(present)
}

func read_a_binary_fact(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        read_a_fact(binary.left)
        state.context.scope.enter()
        narrow_all(state.facts_paths, state.facts_types)
        read_a_fact(binary.right)
        state.context.scope.leave()
        return
    }
    if binary.operator == 'less' {
        read_a_bound(binary)
        return
    }
    if binary.operator == 'less_or_equal' {
        read_a_bound_at_most(binary)
        return
    }
    var counted = binary.left
    var counts = binary.operator == 'equal_equal' or binary.operator == 'greater_or_equal' or binary.operator == 'greater'
    counts = counts or binary.operator == 'not_equal'
    if counts and counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count_fact(binary, counted)
        return
    }
    fallback binary.operator == 'equal_equal'
    var codegen_path = state.values.codegen_path_of(binary.left)
    fallback codegen_path.is_empty()
    var class_path = state.values.tested_class_path_of(binary.right)
    fallback not class_path.is_empty()
    var type_arguments = state.values.type_arguments_of(binary.right)
    var member = state.context.resolver.types.class_type_in(
        class_path,
        type_arguments,
        state.context.current_class,
        state.context.line,
    )
    var tested_written = class_tested_expression(binary.left)
    crash tested_written
    var printer = Printers.Spite.ExpressionPrinter(tested_written)
    var path = printer.text()
    var fact_path = path_of(tested_written, path)
    state.facts_paths.append(fact_path)
    state.facts_types.append(member)
}

# ../../../spite_spec/specs/values_and_types.md#unions-in-full
func class_tested_expression(written: SpiteCompiler.Expression?): SpiteCompiler.Expression? {
    var asked = state.values.class_asked_of(written)
    if asked and written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return written.target
    }
    return written
}

func read_a_not_empty(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    fallback unary.operator == 'not'
    var asked = unary.operand
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_an_empty_question(asked)
    }
}

func read_an_empty_question(asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = asked.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_an_empty_member(asked, callee)
    }
}

func read_an_empty_member(
    asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback asked.arguments.is_empty() and callee.name == "is_empty"
    var listed = state.values.value_of(callee.target, null)
    fallback state.context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = state.context.class_of(listed.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    state.facts_paths.append("{list_text}[0]")
    state.facts_types.append(present)
}

func read_a_count_fact(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_member(binary, counted, callee)
    }
}

func read_a_counted_member(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    var known = count_limit_of(binary.right)
    if known < 0 {
        read_a_turned_bound(binary, counted)
        return
    }
    if known > 64 {
        known = 64
    }
    if binary.operator == 'greater' {
        known = known + 1
    }
    if binary.operator == 'not_equal' {
        fallback known == 0
        known = 1
    }
    fallback known > 0
    var listed = state.values.value_of(callee.target, null)
    fallback state.context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = state.context.class_of(listed.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var index = 0
    while index < known {
        state.facts_paths.append("{list_text}[{index}]")
        state.facts_types.append(present)
        index = index + 1
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func count_limit_of(limit: SpiteCompiler.Expression?): Integer {
    if limit.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(limit)
    }
    return -1
}

func read_a_turned_bound(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    fallback binary.operator == 'greater'
    crash binary.right
    var turned = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(binary.right, 'less', counted)
    read_a_binary_bound(turned)
}

func path_of(written: SpiteCompiler.Expression?, printed: String): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return identifier_path(written.name)
    }
    return printed
}

func identifier_path(name: String): String {
    var internal_name = state.context.scope.internal_name_of(name)
    if internal_name {
        return internal_name
    }
    return "this.{name}"
}

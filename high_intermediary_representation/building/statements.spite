var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var built = List<HighIntermediaryRepresentation.Statements.Statement>()
var facts_paths = List<String>()
var facts_types = List<Model.Type>()

func Statements(starting_context: Context) {
    context = starting_context
    values = Values(starting_context)
}

func block_of(written: AbstractSyntaxTree.Shapes.Statements.Block?): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = built
    built = List<HighIntermediaryRepresentation.Statements.Statement>()
    context.scope.enter()
    written.statements.each(build)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    made.line = written.line
    built = outer
    return made
}

func narrowed_block_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    paths: List<String>,
    types: List<Model.Type>,
): HighIntermediaryRepresentation.Statements.Block {
    crash written
    var outer = built
    built = List<HighIntermediaryRepresentation.Statements.Statement>()
    context.scope.enter()
    narrow_all(paths, types)
    written.statements.each(build)
    context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = built
    made.line = written.line
    built = outer
    return made
}

func narrow_all(paths: List<String>, types: List<Model.Type>) {
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var narrowed_type = types[index]
        crash narrowed_type
        context.scope.narrow(path, narrowed_type)
        index = index + 1
    }
}

func add(statement: HighIntermediaryRepresentation.Statements.Statement) {
    context.pending.each(add_pending)
    context.pending = List<HighIntermediaryRepresentation.Statements.Statement>()
    built.append(statement)
}

func flush_the_pending() {
    context.pending.each(add_pending)
    context.pending = List<HighIntermediaryRepresentation.Statements.Statement>()
}

func add_pending(statement: HighIntermediaryRepresentation.Statements.Statement) {
    built.append(statement)
}

func build(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    context.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: build_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: build_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: build_evaluation(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: build_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: build_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: build_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: build_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.AssertStatement: build_assert(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: build_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: build_inner_block(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func build_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var declared: Model.Type? = null
    if statement.declared_type {
        declared = context.resolver.type_in(statement.declared_type, context.current_class, statement.line)
    }
    var value = values.value_of(statement.value, declared)
    var local_type = value.value_type
    if declared {
        value = values.fitted(value, declared)
        local_type = declared
    }
    var name = context.scope.declare(statement.name, local_type)
    var made = HighIntermediaryRepresentation.Statements.Declare(name, local_type, value)
    made.line = statement.line
    add(made)
    note_a_counted_list(name, statement.value)
    if value == HighIntermediaryRepresentation.Values.Conversion {
        if value.kind == 'proven' {
            context.proven_locals.append(name)
        }
    }
}

func note_a_counted_list(name: String, written: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if written == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_count_call(name, written)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        note_a_literal_list(name, written)
    }
}

func note_a_literal_list(name: String, literal: AbstractSyntaxTree.Shapes.Expressions.ListLiteral) {
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var listed_type = context.scope.type_of(internal_name)
    crash listed_type
    assert context.has_a_class(listed_type) and not listed_type.is_nullable
    var listing = context.class_of(listed_type)
    var element = listing.bound_types["$element_type"]
    assert element
    assert not element.is_nullable
    var index = 0
    while index < literal.entries.count() {
        context.scope.narrow("{name}[{index}]", element)
        index = index + 1
    }
}

func note_a_count_call(name: String, counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        note_a_count_member(name, counted, callee)
    }
}

func note_a_count_member(
    name: String,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert counted.arguments.is_empty() and callee.name == "count"
    crash callee.target
    context.counted_lists[name] = callee.target
}

func build_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    assign_to(statement, statement.target)
}

func assign_to(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.Expression,
) {
    switch target {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: assign_a_name(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: assign_a_member(statement, target)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: assign_an_index(statement, target)
        _: typing.refuse_not_assignable(context)
    }
}

func assign_a_name(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var internal_name = context.scope.internal_name_of(target.name)
    if internal_name {
        var declared_type = context.scope.types[internal_name]
        crash declared_type
        var value = values.fitted_value_of(statement.value, declared_type)
        context.scope.forget(internal_name)
        context.scope.forget_mentions(target.name)
        context.counted_lists.remove(internal_name)
        var made = HighIntermediaryRepresentation.Statements.Assign(internal_name, value)
        made.line = statement.line
        add(made)
        return
    }
    var attribute = context.current_class.attribute_named(target.name)
    if not attribute {
        typing.refuse_unknown_name(context, target.name)
    }
    crash attribute
    var own = values.this_value()
    assign_an_attribute(statement, own, attribute, "this.{target.name}")
}

func assign_a_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert not assigns_a_walked_value(statement, target)
    var object = values.value_of(target.target, null)
    var owner = values.present_class_of(object)
    var attribute = owner.attribute_named(target.name)
    var is_outside = owner.key != context.current_class.key
    var setter = owner.function_named("set_{target.name}")
    if not setter and is_outside {
        setter = values.member_template_of(owner, "set_{target.name}")
    }
    var writes_through_a_setter = is_outside or not attribute
    if writes_through_a_setter and setter {
        set_through(statement, object, setter)
        return
    }
    var getter = owner.function_named("get_{target.name}")
    if not attribute and getter {
        typing.refuse_read_only(context, owner.shown, target.name)
    }
    if not attribute {
        var shown = context.shown(object.value_type)
        typing.refuse_unknown_member(context, shown, target.name)
    }
    crash attribute
    var printer = Printers.Spite.ExpressionPrinter(target)
    var path = printer.text()
    assign_an_attribute(statement, object, attribute, path)
}

func assigns_a_walked_value(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Boolean {
    var function = context.current_function
    if not function.walked_object or target.name != "value" {
        return false
    }
    var described = target.target
    if described == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return assigned_through_the_walk(statement, described, function)
    }
    return false
}

func assigned_through_the_walk(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    described: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): Boolean {
    if described.name != function.bound_parameter {
        return false
    }
    var read = values.walked_value(function)
    if read == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

func assign_an_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: HighIntermediaryRepresentation.Values.Value,
    attribute: Model.AttributeModel,
    path: String,
) {
    var value = values.fitted_value_of(statement.value, attribute.attribute_type)
    context.scope.forget(path)
    var made = HighIntermediaryRepresentation.Statements.AssignAttribute(object, attribute, value)
    made.line = statement.line
    add(made)
}

func set_through(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    object: HighIntermediaryRepresentation.Values.Value,
    setter: Model.FunctionModel,
) {
    context.need(setter)
    var parameter = setter.parameters[0]
    crash parameter
    var value = values.fitted_value_of(statement.value, parameter.parameter_type)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(setter, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

func assign_a_bound_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Boolean {
    var function = context.current_function
    if not function.bound_member_type {
        return false
    }
    if not function.bound_shape.is_empty() {
        return assign_through_the_shape(statement, target, function)
    }
    var read = values.bound_member_read(target)
    if read == HighIntermediaryRepresentation.Values.AttributeRead {
        assign_the_bound_attribute(statement, read)
        return true
    }
    return false
}

func assign_through_the_shape(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    function: Model.FunctionModel,
): Boolean {
    var attributes = target.target
    if attributes == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        assign_a_shape_member(statement, attributes, function)
        return true
    }
    return false
}

func assign_a_shape_member(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    attributes: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
) {
    var object = values.value_of(attributes.target, null)
    var shape = context.program.shape_keyed(function.bound_shape)
    crash shape
    crash function.bound_member_type
    var value = values.fitted_value_of(statement.value, function.bound_member_type)
    var made = HighIntermediaryRepresentation.Statements.AssignThroughShape(object, shape, function.bound_member, value)
    made.line = statement.line
    add(made)
}

func assign_the_bound_attribute(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: HighIntermediaryRepresentation.Values.AttributeRead,
) {
    crash read.object
    var value = values.fitted_value_of(statement.value, read.attribute.attribute_type)
    var made = HighIntermediaryRepresentation.Statements.AssignAttribute(read.object, read.attribute, value)
    made.line = statement.line
    add(made)
}

func assign_an_index(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    assert not assign_a_bound_member(statement, target)
    var object = values.value_of(target.target, null)
    var owner = values.present_class_of(object)
    var function = owner.function_named("set_at")
    if not function {
        var shown = context.shown(object.value_type)
        typing.refuse_not_indexed(context, shown)
    }
    crash function
    context.need(function)
    var index_parameter = function.parameters[0]
    var value_parameter = function.parameters[1]
    crash index_parameter
    crash value_parameter
    var position = values.fitted_value_of(target.index, index_parameter.parameter_type)
    var value = values.fitted_value_of(statement.value, value_parameter.parameter_type)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(position)
    arguments.append(value)
    var call = HighIntermediaryRepresentation.Values.Call(function, object, arguments)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(call)
    made.line = statement.line
    add(made)
}

func build_evaluation(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    var value = values.value_of(statement.value, null)
    var made = HighIntermediaryRepresentation.Statements.Evaluate(value)
    made.line = statement.line
    add(made)
    forget_what_the_call_writes(statement.value)
}

func forget_what_the_call_writes(written: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if written == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        forget_after_a_call(written)
    }
}

func forget_after_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        forget_after_an_own_call(callee.name)
    }
}

func forget_after_an_own_call(called: String) {
    var function = context.current_class.function_named(called)
    assert function
    assert function.declaration
    var reader = WrittenAttributes()
    var names = reader.of(function.declaration)
    var index = 0
    while index < names.count() {
        var name = names[index]
        if not context.scope.internal_name_of(name) {
            context.scope.forget_mentions(name)
        }
        index = index + 1
    }
}

func build_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if not context.current_function.answer {
        if statement.value {
            typing.refuse_answer_from_nothing(context)
        }
        var nothing = HighIntermediaryRepresentation.Statements.Return(null)
        nothing.line = statement.line
        add(nothing)
        return
    }
    var answer: Model.Type = context.current_function.answer
    if not statement.value {
        var shown = context.shown(answer)
        typing.refuse_missing_answer(context, shown)
    }
    var value = values.fitted_value_of(statement.value, answer)
    var made = HighIntermediaryRepresentation.Statements.Return(value)
    made.line = statement.line
    add(made)
}

func build_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    statement.condition = values.with_its_links(statement.condition)
    var condition = values.condition_of(statement.condition)
    flush_the_pending()
    if condition == HighIntermediaryRepresentation.Values.WholeNumber {
        build_a_decided_if(statement, condition.number != 0)
        return
    }
    read_facts(statement.condition)
    var paths = facts_paths
    var types = facts_types
    var then_branch = narrowed_block_of(statement.then_branch, paths, types)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if statement.else_branch {
        else_branch = block_of(statement.else_branch)
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, then_branch, else_branch)
    made.line = statement.line
    add(made)
    if not statement.else_branch and always_leaves(then_branch) {
        facts_paths = List<String>()
        facts_types = List<Model.Type>()
        read_a_negated_fact(statement.condition)
        narrow_all(facts_paths, facts_types)
    }
}

func always_leaves(block: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var last = block.statements.last()
    if not last {
        return false
    }
    var returns = last == HighIntermediaryRepresentation.Statements.Return
    return returns or last == HighIntermediaryRepresentation.Statements.Stop
}

func read_a_negated_fact(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_negated_unary(condition)
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_negated_binary(condition)
    }
}

func read_a_negated_unary(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    assert unary.operator == 'not'
    read_a_fact(unary.operand)
}

func read_a_negated_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'or' {
        read_a_negated_fact(binary.left)
        read_a_negated_fact(binary.right)
        return
    }
    assert binary.operator == 'greater_or_equal'
    var counted = binary.right
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(binary, counted)
    }
}

func build_a_decided_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement, holds: Boolean) {
    if holds {
        var taken = block_of(statement.then_branch)
        add(taken)
        return
    }
    assert statement.else_branch
    var other = block_of(statement.else_branch)
    add(other)
}

func build_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var condition = values.condition_of(statement.condition)
    facts_paths = List<String>()
    facts_types = List<Model.Type>()
    read_a_bound(statement.condition)
    var paths = facts_paths
    var types = facts_types
    var body = narrowed_block_of(statement.body, paths, types)
    var made = HighIntermediaryRepresentation.Statements.While(condition, body)
    made.line = statement.line
    add(made)
}

func read_a_bound(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_bound(condition)
    }
}

func read_a_binary_bound(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if condition.operator == 'and' {
        read_a_bound(condition.left)
        read_a_bound(condition.right)
        return
    }
    var counted = condition.right
    assert condition.operator == 'less'
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
    if counted == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_counted_local(condition, counted)
    }
}

func read_a_counted_local(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var internal_name = context.scope.internal_name_of(counted.name)
    assert internal_name
    var listed = context.counted_lists[internal_name]
    assert listed
    var index_name = ""
    var left = condition.left
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    assert not index_name.is_empty()
    var list_value = values.value_of(listed, null)
    assert context.has_a_class(list_value.value_type) and not list_value.value_type.is_nullable
    var owner = context.class_of(list_value.value_type)
    var reader = owner.function_named("get_at")
    assert reader
    assert reader.answer
    assert not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(listed)
    var list_text = printer.text()
    facts_paths.append("{list_text}[{index_name}]")
    facts_types.append(present)
}

func holds_maybes(listing: Model.ClassModel): Boolean {
    var item_type = listing.bound_types["$element_type"]
    if item_type {
        return item_type.is_nullable
    }
    return false
}

func read_a_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_list(condition, counted, callee)
    }
}

func read_a_counted_list(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert counted.arguments.is_empty() and callee.name == "count"
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
    }
    assert not index_name.is_empty()
    var listed = values.value_of(callee.target, null)
    assert context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    var reader = owner.function_named("get_at")
    assert reader
    assert reader.answer
    assert not holds_maybes(owner)
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var element: Model.Type = reader.answer
    var present = element.present()
    facts_paths.append("{list_text}[{index_name}]")
    facts_types.append(present)
    var offset = 1
    while offset <= reach {
        facts_paths.append("{list_text}[{index_name} + {offset}]")
        facts_types.append(present)
        offset = offset + 1
    }
}

func added_name_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var left = sum.left
    if sum.operator != 'plus' {
        return ""
    }
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return left.name
    }
    return ""
}

func added_reach_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    var right = sum.right
    if right == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(right)
    }
    return 0
}

func literal_reach_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    var number = literal.text.to_integer()
    if literal.kind != 'integer_literal' or not number {
        return 0
    }
    return number
}

func build_inner_block(statement: AbstractSyntaxTree.Shapes.Statements.Block) {
    var made = block_of(statement)
    add(made)
}

func build_assert(statement: AbstractSyntaxTree.Shapes.Statements.AssertStatement) {
    statement.condition = values.with_its_links(statement.condition)
    var condition = values.condition_of(statement.condition)
    var failed = HighIntermediaryRepresentation.Statements.Block()
    var noting = noted_failure(statement)
    if noting {
        failed.statements.append(noting)
    }
    var leaving = default_return()
    failed.statements.append(leaving)
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    add(made)
    read_facts(statement.condition)
    narrow_all(facts_paths, facts_types)
}

func noted_failure(
    statement: AbstractSyntaxTree.Shapes.Statements.AssertStatement,
): HighIntermediaryRepresentation.Statements.Statement? {
    var symbols = context.resolver.symbols
    var path = context.path()
    assert not symbols.is_library_path(path)
    var ring = assert_ring()
    assert ring
    var failing = ring.function_named("failed")
    crash failing
    values.need(failing)
    var site = site_line(statement.condition, statement.line, "spite.assert")
    var answered = "nothing"
    if context.current_function.answer {
        answered = "null"
    }
    var site_text = values.described_text("{site}\tanswered={answered}")
    var streams = 0
    var asked = context.build_flags["trace_asserts"]
    if asked == "true" {
        streams = 1
    }
    var boolean = context.boolean()
    var streaming = HighIntermediaryRepresentation.Values.WholeNumber(boolean, streams)
    var passed = List<HighIntermediaryRepresentation.Values.Value>()
    passed.append(site_text)
    passed.append(streaming)
    var fetched = ring_object(ring)
    var called = HighIntermediaryRepresentation.Values.Call(failing, fetched, passed)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(called)
    evaluated.line = statement.line
    return evaluated
}

func assert_ring(): Model.ClassModel? {
    assert context.resolver.symbols.program_asserts
    var found = context.resolver.symbols.find("Spite.Internal.Asserts", "")
    assert found
    var ring = context.resolver.class_model_named("Spite.Internal.Asserts")
    assert ring
    context.need_defaults(ring.key)
    return ring
}

func ring_object(ring: Model.ClassModel): HighIntermediaryRepresentation.Values.Value {
    var ring_type = ring.type_of_an_instance()
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return HighIntermediaryRepresentation.Values.MakeObject(ring_type, null, no_arguments)
}

func site_line(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?, line: Integer, kind: String): String {
    var owner = context.current_function.owner
    var function_name = context.current_function.name
    var source = ""
    if condition {
        var printer = Printers.Spite.ExpressionPrinter(condition)
        source = printer.text()
    }
    var place_key = "{owner}.{function_name}"
    var ordinal = 0
    var known = context.site_ordinals[place_key]
    if known {
        ordinal = known
    }
    context.site_ordinals[place_key] = ordinal + 1
    var identity = site_identity("{owner}|{function_name}|{ordinal}|{source}")
    var asked = context.build_flags["optimized"]
    if asked == "true" {
        return "{kind}\t{identity}"
    }
    var shown_owner = last_part_of(owner)
    return "{kind}\t{identity}\t{context.path()}:{line}\t{shown_owner}\t{function_name}"
}

func last_part_of(owner: String): String {
    var parts = owner.split(".")
    var last_index = parts.count() - 1
    var last = parts[last_index]
    crash last
    return last
}

func site_identity(written: String): String {
    var high = 0
    var low = 0
    var index = 0
    while index < written.length() {
        var code = written.code_at(index)
        var mixed_high = high * 31 + code
        high = mixed_high % 65521
        var mixed_low = low * 131 + code
        low = mixed_low % 65519
        index = index + 1
    }
    var high_digits = four_hexadecimal_digits(high)
    var low_digits = four_hexadecimal_digits(low)
    return "{high_digits}{low_digits}"
}

func four_hexadecimal_digits(number: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = number
    var place = 0
    while place < 4 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

func default_return(): HighIntermediaryRepresentation.Statements.Statement {
    if not context.current_function.answer {
        return HighIntermediaryRepresentation.Statements.Return(null)
    }
    var answer: Model.Type = context.current_function.answer
    if answer.is_nullable {
        var nothing = HighIntermediaryRepresentation.Values.NullConstant(answer)
        return HighIntermediaryRepresentation.Statements.Return(nothing)
    }
    var shown = context.shown(answer)
    typing.refuse_default_answer(context, shown)
    return HighIntermediaryRepresentation.Statements.Return(null)
}

func build_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    var message = "spite: the program stopped at {context.path()}:{statement.line} in {context.current_function.owner}.{context.current_function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = statement.line
    stopped.then = crash_report()
    if always_stops(statement.condition) {
        add(stopped)
        return
    }
    show_the_values(stopped, statement.condition)
    statement.condition = values.with_its_links(statement.condition)
    var condition = values.condition_of(statement.condition)
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements.append(stopped)
    var negated = HighIntermediaryRepresentation.Values.Negation(condition)
    var made = HighIntermediaryRepresentation.Statements.If(negated, failed, null)
    made.line = statement.line
    add(made)
    read_facts(statement.condition)
    narrow_all(facts_paths, facts_types)
}

func crash_report(): HighIntermediaryRepresentation.Values.Value? {
    var ring = assert_ring()
    assert ring
    var reporting = ring.function_named("report")
    crash reporting
    values.need(reporting)
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var fetched = ring_object(ring)
    return HighIntermediaryRepresentation.Values.Call(reporting, fetched, no_arguments)
}

func show_the_values(
    stopped: HighIntermediaryRepresentation.Statements.Stop,
    condition: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var names = List<String>()
    gather_the_names(condition, names)
    var opening = " ("
    var index = 0
    while index < names.count() {
        var name = names[index]
        var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
        var read = values.value_of(identifier, null)
        if shows_as_a_number(read.value_type) {
            var before = stopped.message
            if not stopped.pieces.is_empty() {
                var last_index = stopped.pieces.count() - 1
                var last = stopped.pieces[last_index]
                crash last
                before = last
                stopped.pieces.remove_at(last_index)
            }
            stopped.pieces.append("{before}{opening}{name}=")
            stopped.pieces.append("")
            stopped.shown.append(read)
            opening = ", "
        }
        index = index + 1
    }
    assert not stopped.pieces.is_empty()
    var closing_index = stopped.pieces.count() - 1
    var closing = stopped.pieces[closing_index]
    crash closing
    stopped.pieces[closing_index] = "{closing})"
}

func shows_as_a_number(value_type: Model.Type): Boolean {
    if value_type.kind != 'scalar' or value_type.is_nullable {
        return false
    }
    var whole = ["Byte", "Tiny", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
    return whole.contains(value_type.name)
}

func gather_the_names(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, names: List<String>) {
    assert expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: note_a_shown_name(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: gather_both(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: gather_the_names(expression.operand, names)
        _: return
    }
}

func gather_both(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, names: List<String>) {
    gather_the_names(binary.left, names)
    gather_the_names(binary.right, names)
}

func note_a_shown_name(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression, names: List<String>) {
    var is_known = context.scope.internal_name_of(identifier.name)
    assert is_known and not names.contains(identifier.name)
    names.append(identifier.name)
}

func always_stops(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return condition.kind == 'keyword_false'
    }
    return not condition
}

func build_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var subject = values.value_of(statement.value, null)
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var path = printer.text()
    if is_closed(subject.value_type) {
        check_the_cover(statement, subject.value_type, path)
    }
    var chain = switch_chain(statement, subject, path, 0)
    crash chain
    add(chain)
}

func switch_chain(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject: HighIntermediaryRepresentation.Values.Value,
    path: String,
    index: Integer,
): HighIntermediaryRepresentation.Statements.Statement? {
    var switch_case = statement.cases[index]
    assert switch_case
    var written = switch_case.value
    var paths = List<String>()
    var types = List<Model.Type>()
    var is_the_rest = false
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_the_rest = written.name == "_"
    }
    if is_the_rest {
        return block_of(switch_case.body)
    }
    var condition = case_condition(subject, written, path, paths, types)
    var body = narrowed_block_of(switch_case.body, paths, types)
    var is_the_last = index == statement.cases.count() - 1
    if is_the_last and is_closed(subject.value_type) {
        return body
    }
    var rest = switch_chain(statement, subject, path, index + 1)
    var else_branch: HighIntermediaryRepresentation.Statements.Block? = null
    if rest {
        var wrapped = HighIntermediaryRepresentation.Statements.Block()
        wrapped.statements.append(rest)
        else_branch = wrapped
    }
    var made = HighIntermediaryRepresentation.Statements.If(condition, body, else_branch)
    made.line = statement.line
    return made
}

func check_the_cover(
    statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement,
    subject_type: Model.Type,
    path: String,
) {
    var written = List<String>()
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        var printer = Printers.Spite.ExpressionPrinter(switch_case.value)
        var text = printer.text()
        var segments = text.split(".")
        var last = segments.count() - 1
        var simple = segments[last]
        crash simple
        written.append(simple)
        index = index + 1
    }
    var every = List<String>()
    var is_an_enum = subject_type.kind == 'enumeration'
    var subject = path
    if is_an_enum {
        var enumeration = values.enum_model_of(subject_type)
        var value_index = 0
        while value_index < enumeration.values.count() {
            var value = enumeration.values[value_index]
            every.append("'{value}'")
            value_index = value_index + 1
        }
    } else {
        var united = values.union_model_of(subject_type)
        subject = united.name
        var member_index = 0
        while member_index < united.members.count() {
            var member = united.members[member_index]
            var member_segments = member.name.split(".")
            var member_last = member_segments.count() - 1
            var member_name = member_segments[member_last]
            crash member_name
            every.append(member_name)
            member_index = member_index + 1
        }
    }
    var cover = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()
    cover.check(context, subject, is_an_enum, every, written)
}

func is_closed(subject_type: Model.Type): Boolean {
    if subject_type.is_nullable {
        return false
    }
    return subject_type.kind == 'enumeration' or subject_type.kind == 'union'
}

func case_condition(
    subject: HighIntermediaryRepresentation.Values.Value,
    written: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    path: String,
    paths: List<String>,
    types: List<Model.Type>,
): HighIntermediaryRepresentation.Values.Value {
    var class_path = values.class_path_of(written)
    if not class_path.is_empty() {
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var member = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
        paths.append(path)
        types.append(member)
        return HighIntermediaryRepresentation.Values.ClassTest(subject, member)
    }
    var expected = subject.value_type
    var constant = values.value_of(written, expected)
    if values.is_machine_comparable(expected) {
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', subject, constant)
    }
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(constant)
    return values.method_call(subject, "equals", arguments)
}

func read_facts(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    facts_paths = List<String>()
    facts_types = List<Model.Type>()
    read_a_fact(condition)
}

func read_a_fact(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_fact(condition)
        return
    }
    if condition == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        read_a_not_empty(condition)
        return
    }
    var is_a_path = condition == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    assert is_a_path
    crash condition
    var written_value = values.value_of(condition, null)
    var value = values.result_of_handle(written_value)
    assert value.value_type.is_nullable
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var path = printer.text()
    var present = value.value_type.present()
    var fact_path = path_of(condition, path)
    facts_paths.append(fact_path)
    facts_types.append(present)
}

func read_a_binary_fact(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        read_a_fact(binary.left)
        context.scope.enter()
        narrow_all(facts_paths, facts_types)
        read_a_fact(binary.right)
        context.scope.leave()
        return
    }
    if binary.operator == 'less' {
        read_a_bound(binary)
        return
    }
    var counted = binary.left
    var counts = binary.operator == 'equal_equal' or binary.operator == 'greater_or_equal' or binary.operator == 'greater'
    counts = counts or binary.operator == 'not_equal'
    if counts {
        if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            read_a_count_fact(binary, counted)
            return
        }
    }
    assert binary.operator == 'equal_equal'
    var class_path = values.tested_class_path_of(binary.right)
    assert not class_path.is_empty()
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var member = context.resolver.class_type_in(class_path, no_arguments, context.current_class, context.line)
    crash binary.left
    var printer = Printers.Spite.ExpressionPrinter(binary.left)
    var path = printer.text()
    var fact_path = path_of(binary.left, path)
    facts_paths.append(fact_path)
    facts_types.append(member)
}

func read_a_not_empty(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression) {
    assert unary.operator == 'not'
    var asked = unary.operand
    if asked == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_an_empty_question(asked)
    }
}

func read_an_empty_question(asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = asked.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_an_empty_member(asked, callee)
    }
}

func read_an_empty_member(
    asked: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert asked.arguments.is_empty() and callee.name == "is_empty"
    var listed = values.value_of(callee.target, null)
    assert context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    var reader = owner.function_named("get_at")
    assert reader
    assert reader.answer
    assert not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    facts_paths.append("{list_text}[0]")
    facts_types.append(present)
}

func read_a_count_fact(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_member(binary, counted, callee)
    }
}

func read_a_counted_member(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert counted.arguments.is_empty() and callee.name == "count"
    var limit = binary.right
    var known = 0
    if limit == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        known = literal_reach_of(limit)
    }
    if binary.operator == 'greater' {
        known = known + 1
    }
    if binary.operator == 'not_equal' {
        assert known == 0
        known = 1
    }
    assert known > 0
    var listed = values.value_of(callee.target, null)
    assert context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = context.class_of(listed.value_type)
    var reader = owner.function_named("get_at")
    assert reader
    assert reader.answer
    assert not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var index = 0
    while index < known {
        facts_paths.append("{list_text}[{index}]")
        facts_types.append(present)
        index = index + 1
    }
}

func path_of(written: AbstractSyntaxTree.Shapes.Expressions.Expression?, printed: String): String {
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return identifier_path(written.name)
    }
    return printed
}

func identifier_path(name: String): String {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return internal_name
    }
    return "this.{name}"
}

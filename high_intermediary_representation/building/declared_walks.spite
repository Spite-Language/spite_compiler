union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func DeclaredWalks(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/reflection.md#what-a-class-declares
func unrolled(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Value? {
    fallback callee.name == "each" and call.arguments.count() == 1
    var argument = call.arguments[0]
    var listed = callee.target
    fallback argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return unrolled_by(listed, argument.name)
    }
    return null
}

func unrolled_by(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    walker_name: String,
): Value? {
    var walker = context.current_class.function_named(walker_name)
    fallback walker
    fallback walker.parameters.count() == 1 and walker.template_index < 0
    var parameter = walker.parameters[0]
    var taken = parameter.parameter_type
    fallback taken.kind == 'object' and not taken.is_nullable
    if listed.name == "members" {
        return walked_members(listed, walker, taken)
    }
    var kind = kind_listed_by(listed.name)
    fallback not kind.is_empty() and taken.name == kind
    var class_key = values.constant_class_of(listed.target)
    fallback class_key
    var model = context.program.class_named(class_key)
    fallback model
    var names = declared_names(model, listed.name)
    var reflection = Reflection(context, values)
    var own = values.this_value()
    values.need(walker)
    var index = 0
    while index < names.count() {
        var name = names[index]
        var described = reflection.declared_object(kind, "{model.key}.{name}")
        var arguments = List<Value>()
        arguments.append(described)
        var walk_call = HighIntermediaryRepresentation.Values.Call(walker, own, arguments)
        walked(walk_call)
        index = index + 1
    }
    return nothing()
}

func kind_listed_by(listing: String): String {
    if listing == "enums" {
        return "Spite.Enum"
    } else if listing == "unions" {
        return "Spite.Union"
    } else if listing == "types" {
        return "Spite.Type"
    } else {
        return ""
    }
}

func declared_names(model: Model.ClassModel, listing: String): List<String> {
    var names = List<String>()
    var index = 0
    if listing == "enums" {
        while index < model.enums.count() {
            var enumeration = model.enums[index]
            names.append(enumeration.name)
            index = index + 1
        }
    } else if listing == "unions" {
        while index < model.unions.count() {
            var united = model.unions[index]
            names.append(united.name)
            index = index + 1
        }
    } else {
        while index < model.shapes.count() {
            var shape = model.shapes[index]
            names.append(shape.name)
            index = index + 1
        }
    }
    return names
}

# ../../../spite_documentation/reflection.md#spiteunion-and-spitetype
func walked_members(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    walker: Model.FunctionModel,
    taken: Model.Type,
): Value? {
    fallback taken.name == "Spite.Class"
    var united = union_named_by(listed.target)
    fallback united
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        fallback member.kind == 'object' and not member.is_nullable
        fallback context.resolver.class_model_named(member.name)
        index = index + 1
    }
    var own = values.this_value()
    var no_arguments = List<Value>()
    var place = 0
    while place < united.members.count() {
        var walked_member = united.members[place]
        var made = values.class_walk_copy(walker, walked_member.name, place, context.current_class)
        values.need(made)
        var walk_call = HighIntermediaryRepresentation.Values.Call(made, own, no_arguments)
        walked(walk_call)
        place = place + 1
    }
    return nothing()
}

# ../../../spite_documentation/reflection.md#what-a-class-declares
func union_named_by(written: Expression?): Model.UnionModel? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return union_at(written)
    }
    return null
}

func union_at(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Model.UnionModel? {
    var listing = index.target
    fallback listing.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback listing.name == "unions"
    var key = values.key_name_of(index.index)
    fallback key
    var class_key = values.constant_class_of(listing.target)
    fallback class_key
    var model = context.program.class_named(class_key)
    fallback model
    return model.union_named(key)
}

func walked(walk_call: Value) {
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(walk_call)
    evaluated.line = context.line
    context.pending.append(evaluated)
}

func nothing(): Value {
    var nothing_type = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing_type)
}

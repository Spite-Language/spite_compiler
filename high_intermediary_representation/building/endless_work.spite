var key = ""
var path = ""
var line = 0
var owner = ""
var function_name = ""
var text = ""

# ../../PROOFS.md#a-loop-that-can-never-end-is-an-error
func EndlessWork(
    starting_key: String,
    starting_path: String,
    starting_line: Integer,
    starting_owner: String,
    starting_function_name: String,
    starting_text: String,
) {
    key = starting_key
    path = starting_path
    line = starting_line
    owner = starting_owner
    function_name = starting_function_name
    text = starting_text
}

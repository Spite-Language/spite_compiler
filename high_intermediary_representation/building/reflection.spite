var state = ReflectionState()
var described_names = DescribedNames()
var feature_flags = Features(state)
var writing = Writing(state)
var class_objects = ClassObjects(state)
var declarations = Declarations(state)

func Reflection(starting_context: Context, starting_values: Values) {
    state.context = starting_context
    state.values = starting_values
}

func fill(known: String): HighIntermediaryRepresentation.HighFunction {
    var class_prefix = "Spite.Class:"
    var namespace_prefix = "Spite.Namespace:"
    var enum_prefix = "Spite.Enum:"
    var union_prefix = "Spite.Union:"
    var type_prefix = "Spite.Type:"
    var known_length = known.length()
    if known.starts_with(enum_prefix) {
        var enum_length = enum_prefix.length()
        var described_enum = known.slice(enum_length, known_length)
        crash described_enum
        return fill_of_an_enum(described_enum)
    }
    if known.starts_with(union_prefix) {
        var union_length = union_prefix.length()
        var described_union = known.slice(union_length, known_length)
        crash described_union
        return fill_of_a_union(described_union)
    }
    if known.starts_with(type_prefix) {
        var type_length = type_prefix.length()
        var described_shape = known.slice(type_length, known_length)
        crash described_shape
        return fill_of_a_type(described_shape)
    }
    if known.starts_with(class_prefix) {
        var class_length = class_prefix.length()
        var described_class = known.slice(class_length, known_length)
        crash described_class
        return fill_of_a_class(described_class)
    }
    if known.starts_with(namespace_prefix) {
        var namespace_length = namespace_prefix.length()
        var described_namespace = known.slice(namespace_length, known_length)
        crash described_namespace
        return fill_of_a_namespace(described_namespace)
    }
    var functions_prefix = "Functions:"
    crash known.starts_with(functions_prefix)
    var functions_length = functions_prefix.length()
    var described = known.slice(functions_length, known_length)
    crash described
    return fill_of_a_function_list(described)
}

func fill_of_a_class(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    var outer_given = state.given
    state.statements = List<SpiteCompiler.Statement>()
    state.given = Dictionary<String, SpiteCompiler.Value>()
    var class_type = writing.reflection_type("Spite.Class")
    var class_model = state.context.class_of(class_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(class_type)
    var is_optional = described.ends_with("?")
    var base = described
    if is_optional {
        var described_length = described.length()
        var sliced_base = described.slice(0, described_length - 1)
        crash sliced_base
        base = sliced_base
        writing.give_flag("is_optional", true)
    }
    var model = state.context.program.class_named(base)
    var shown = base
    if model {
        shown = model.shown
    }
    if is_optional {
        shown = "{shown}?"
    }
    writing.give_text("name_with_namespaces", shown)
    var simple = described_names.without_namespaces(shown)
    var keeps_arguments = simple.starts_with("List<") or simple.starts_with("Dictionary<") or simple.starts_with("Vector<") or simple.starts_with("Items<")
    var opening = simple.index_of("<")
    if not keeps_arguments and opening and opening > 0 {
        var sliced_simple = simple.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    writing.give_text("name", simple)
    var namespace_name = described_names.namespace_of(described)
    var namespace = class_objects.namespace_object(namespace_name)
    state.given["namespace"] = namespace
    if model {
        var source_folder = described_names.folder_of(model.file.path)
        writing.give_text("source_folder", source_folder)
        fill_from_the_model(own, class_model, model)
        add_the_source_files(own, class_model, base)
    } else {
        fill_an_enum(base)
    }
    return filled_function(own, class_model, described, outer, outer_given)
}

# ../../../spite_spec/specs/reflection.md#reflection-objects
func filled_function(
    own: SpiteCompiler.Value,
    model: Model.ClassModel,
    described: String,
    outer: List<SpiteCompiler.Statement>,
    outer_given: Dictionary<String, SpiteCompiler.Value>,
): HighIntermediaryRepresentation.HighFunction {
    var constructor = state.values.constructor_of(model)
    crash constructor
    var arguments = writing.constructor_arguments(constructor)
    var constructing = HighIntermediaryRepresentation.Values.Call(constructor, own, arguments)
    var constructed = HighIntermediaryRepresentation.Statements.Evaluate(constructing)
    state.statements.insert(0, constructed)
    var function = Model.FunctionModel("_fill_{described}", model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = state.statements
    state.statements = outer
    state.given = outer_given
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func fill_from_the_model(own: SpiteCompiler.Value, class_model: Model.ClassModel, model: Model.ClassModel) {
    writing.give_flag("is_singleton", model.is_singleton)
    fill_the_state(model)
    var fixed_size = is_fixed_size(model)
    writing.give_flag("is_fixed_size", fixed_size)
    var element = model.bound_types["$element_type"]
    var is_a_list = model.function_named("_read_value")
    if element and is_a_list {
        writing.give_flag("is_list", true)
    }
    var dictionary_value = model.bound_types["$value_type"]
    if dictionary_value {
        writing.give_flag("is_dictionary", true)
    }
    add_the_generics(own, class_model, model)
    var is_the_entry = model.key == state.context.program.entry
    writing.give_flag("has_no_stand_in", is_the_entry)
    var is_stored_by_the_compiler = model.key == "String"
    if scalars.of(model.key) {
        is_stored_by_the_compiler = true
    }
    if not is_stored_by_the_compiler and not element {
        add_the_attributes(own, class_model, model)
    }
    if feature_flags.has_feature("e") {
        add_the_declarations(own, class_model, model)
    }
    fallback feature_flags.has_feature("f")
    if not is_the_entry {
        var listed = writing.read_attribute(own, class_model, "_functions")
        var makes_a_stand_in = declarations.belongs_to_the_program(model) and not model.is_singleton and not is_stored_by_the_compiler
        add_the_functions(listed, model, null, makes_a_stand_in, true)
    }
}

# ../../../spite_spec/specs/reflection.md#reflection-objects
func add_the_generics(own: SpiteCompiler.Value, class_model: Model.ClassModel, model: Model.ClassModel) {
    var listed = writing.read_attribute(own, class_model, "_generics")
    var names = model.bound_types.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = model.bound_types[name]
        crash bound
        var name_length = name.length()
        var key_name = name.slice(1, name_length)
        crash key_name
        var key = writing.text(key_name)
        var described = class_objects.described_class_of(bound)
        writing.placed(listed, key, described)
        index = index + 1
    }
}

func fill_an_enum(described: String) {
    var parts = described.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.context.program.class_named(owner_key)
    fallback owner
    var enumeration = owner.enum_named(simple)
    fallback enumeration
    writing.give_flag("is_enum", true)
}

# ../../../spite_documentation/reflection.md#what-a-class-declares
func add_the_declarations(own: SpiteCompiler.Value, class_model: Model.ClassModel, model: Model.ClassModel) {
    var enums = writing.read_attribute(own, class_model, "_enums")
    var enum_index = 0
    while enum_index < model.enums.count() {
        var enumeration = model.enums[enum_index]
        var described_enum = class_objects.enum_object("{model.key}.{enumeration.name}")
        var enum_key = writing.text(enumeration.name)
        writing.placed(enums, enum_key, described_enum)
        enum_index = enum_index + 1
    }
    var unions = writing.read_attribute(own, class_model, "_unions")
    var union_index = 0
    while union_index < model.unions.count() {
        var united = model.unions[union_index]
        var described_union = class_objects.declared_object("Spite.Union", "{model.key}.{united.name}")
        var union_key = writing.text(united.name)
        writing.placed(unions, union_key, described_union)
        union_index = union_index + 1
    }
    var types = writing.read_attribute(own, class_model, "_types")
    var type_index = 0
    while type_index < model.shapes.count() {
        var shape = model.shapes[type_index]
        var described_shape = class_objects.declared_object("Spite.Type", "{model.key}.{shape.name}")
        var type_key = writing.text(shape.name)
        writing.placed(types, type_key, described_shape)
        type_index = type_index + 1
    }
}

func fill_of_a_union(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    var outer_given = state.given
    state.statements = List<SpiteCompiler.Statement>()
    state.given = Dictionary<String, SpiteCompiler.Value>()
    var union_type = writing.reflection_type("Spite.Union")
    var union_model = state.context.class_of(union_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(union_type)
    var owner_key = described_names.namespace_of(described)
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var simple = described_names.last_name_of(described)
    var united = owner.union_named(simple)
    crash united
    give_owned(owner, simple)
    var listed = writing.read_attribute(own, union_model, "_members")
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var described_member = class_objects.class_object_of_type(member)
        if described_member {
            var shown = state.context.shown(member)
            var key = writing.text(shown)
            writing.placed(listed, key, described_member)
        }
        index = index + 1
    }
    return filled_function(own, union_model, described, outer, outer_given)
}

func give_owned(owner: Model.ClassModel, simple: String) {
    writing.give_text("name", simple)
    writing.give_text("name_with_namespaces", "{owner.shown}.{simple}")
    var owner_object = class_objects.class_object(owner.key)
    state.given["owner"] = owner_object
}

func fill_of_a_type(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    var outer_given = state.given
    state.statements = List<SpiteCompiler.Statement>()
    state.given = Dictionary<String, SpiteCompiler.Value>()
    var shape_type = writing.reflection_type("Spite.Type")
    var shape_model = state.context.class_of(shape_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(shape_type)
    var owner_key = described_names.namespace_of(described)
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var simple = described_names.last_name_of(described)
    give_owned(owner, simple)
    return filled_function(own, shape_model, described, outer, outer_given)
}

func fill_of_an_enum(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    var outer_given = state.given
    state.statements = List<SpiteCompiler.Statement>()
    state.given = Dictionary<String, SpiteCompiler.Value>()
    var enum_type = writing.reflection_type("Spite.Enum")
    var enum_model = state.context.class_of(enum_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(enum_type)
    var owner_key = described_names.namespace_of(described)
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var simple = described_names.last_name_of(described)
    var enumeration = owner.enum_named(simple)
    crash enumeration
    give_owned(owner, simple)
    var value_type = writing.reflection_type("Spite.EnumValue")
    writing.need_the_making(value_type)
    var listed = writing.read_attribute(own, enum_model, "_values")
    var integer = state.context.scalar_type("Integer")
    var index = 0
    while index < enumeration.values.count() {
        var value = enumeration.values[index]
        var number = enumeration.numbers[index]
        crash number
        var named = writing.text(value)
        var numbered = HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
        var placed_at = writing.whole(index)
        var more = List<SpiteCompiler.Value>()
        more.append(numbered)
        more.append(placed_at)
        var made = writing.made_from(value_type, named, more)
        var local = writing.kept(made, value_type)
        var key = writing.text(value)
        writing.placed(listed, key, local)
        index = index + 1
    }
    return filled_function(own, enum_model, described, outer, outer_given)
}

func add_the_source_files(own: SpiteCompiler.Value, class_model: Model.ClassModel, described: String) {
    fallback class_model.attribute_named("_source_files")
    var listed = writing.read_attribute(own, class_model, "_source_files")
    var file_type = Model.Type('object', "File")
    writing.need_the_making(file_type)
    var known = state.context.resolver.state.symbols.map.classes_by_namespace[described]
    fallback known
    var index = 0
    while index < known.count() {
        var class_file = known[index]
        var relative = described_names.written_path_of(class_file.path)
        var named = writing.text(relative)
        var no_more = List<SpiteCompiler.Value>()
        var made = writing.made_from(file_type, named, no_more)
        writing.appended(listed, made)
        index = index + 1
    }
}

func add_the_source_directories(
    own: SpiteCompiler.Value,
    namespace_model: Model.ClassModel,
    folder: Mapping.MappedFolder,
) {
    fallback namespace_model.attribute_named("_source_directories")
    var listed = writing.read_attribute(own, namespace_model, "_source_directories")
    var directory_type = Model.Type('object', "Directory")
    writing.need_the_making(directory_type)
    var index = 0
    while index < folder.paths.count() {
        var folder_path = folder.paths[index]
        var relative = described_names.written_path_of(folder_path)
        var named = writing.text(relative)
        var no_more = List<SpiteCompiler.Value>()
        var made = writing.made_from(directory_type, named, no_more)
        writing.appended(listed, made)
        index = index + 1
    }
}

func is_stateful(model: Model.ClassModel): Boolean {
    return not model.declared_attributes.is_empty()
}

# ../../PROOFS.md#whether-a-class-keeps-state
func fill_the_state(model: Model.ClassModel) {
    var binds_state = binds_a_singleton_with_state(model)
    var asked_of_the_program = not binds_state and feature_flags.has_feature("s") and declarations.belongs_to_the_program(model)
    if asked_of_the_program and every_writer_can_be_built(model) {
        var asked_fact = writes_its_object(model)
        state.given["is_stateful"] = asked_fact
        return
    }
    var stateful = binds_state or asked_of_the_program or is_stateful(model)
    writing.give_flag("is_stateful", stateful)
}

func binds_a_singleton_with_state(model: Model.ClassModel): Boolean {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type
        if held.kind == 'object' and state.context.has_a_class(held) {
            var bound = state.context.class_of(held)
            if bound.is_singleton and not bound.declared_attributes.is_empty() {
                return true
            }
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#whether-a-class-keeps-state
func every_writer_can_be_built(model: Model.ClassModel): Boolean {
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_written = not declared.is_constructor and declared.name != "drop" and not declared.is_synthetic
        fallback not is_written or declarations.can_be_built(declared)
        index = index + 1
    }
    return true
}

func writes_its_object(model: Model.ClassModel): HighIntermediaryRepresentation.Values.Function.Fact {
    var functions = List<Model.FunctionModel>()
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_written = not declared.is_constructor and declared.name != "drop" and not declared.is_synthetic
        var is_asked = is_written and declarations.can_be_built(declared)
        if is_asked {
            functions.append(declared)
            state.context.need(declared)
        }
        index = index + 1
    }
    var boolean = state.context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, "keeps_state", functions)
    made.slot = "this"
    state.context.facts_asked.append(made)
    return made
}

func is_fixed_size(model: Model.ClassModel): Boolean {
    if scalars.of(model.key) or model.key == "String" {
        return true
    }
    var described = Model.Type('object', model.key)
    return state.values.fits_a_vector(described)
}

func add_the_attributes(own: SpiteCompiler.Value, class_model: Model.ClassModel, model: Model.ClassModel) {
    fallback not declarations.holds_its_values_itself(model)
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    writing.need_the_making(declaration_type)
    var listed = writing.read_attribute(own, class_model, "_attributes")
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = declarations.attribute_declaration_of(attribute, index, model)
        var local = writing.kept(made, declaration_type)
        var key = writing.text(attribute.name)
        writing.placed(listed, key, local)
        index = index + 1
    }
}

func add_the_functions(
    listed: SpiteCompiler.Value,
    model: Model.ClassModel,
    receiver: SpiteCompiler.Value?,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var function_type = writing.reflection_type("Spite.Function")
    writing.need_the_making(function_type)
    var declaration_type = writing.reflection_type("Spite.FunctionDeclaration")
    writing.need_the_making(declaration_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    state.stand_in = receiver
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        if declarations.is_listed(declared) and receiver {
            add_a_function_object(listed, declared, model, makes_a_stand_in, with_accesses)
        } else if declarations.is_listed(declared) {
            add_a_declaration_object(listed, declared, model, makes_a_stand_in, with_accesses)
        }
        index = index + 1
    }
}

func add_a_declaration_object(
    listed: SpiteCompiler.Value,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var local = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    var key = writing.text(declared.name)
    writing.placed(listed, key, local)
}

func add_a_function_object(
    listed: SpiteCompiler.Value,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var local = function_object(declared, model, makes_a_stand_in, with_accesses)
    var key = writing.text(declared.name)
    writing.placed(listed, key, local)
}

func function_object_in_place(declared: Model.FunctionModel, receiver: SpiteCompiler.Value): SpiteCompiler.Value {
    var model = state.context.program.class_named(declared.owner)
    crash model
    var function_type = writing.reflection_type("Spite.Function")
    writing.need_the_making(function_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var describer = describer_of(declared, model, function_type)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(describer, receiver, no_arguments)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func describer_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_type: Model.Type,
): Model.FunctionModel {
    var name = "_described_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    made.answer = function_type
    model.declared_functions.append(made)
    var body = describing_body(declared, model)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.describers.append(function)
    state.context.described_functions.append(declared)
    return made
}

func describing_body(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    var own_type = model.type_of_an_instance()
    state.stand_in = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var local = function_object(declared, model, false, true)
    var answered = HighIntermediaryRepresentation.Statements.Return(local)
    state.statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = state.statements
    state.statements = outer
    return body
}

func redescribe(index: Integer) {
    var function = state.context.describers[index]
    var declared = state.context.described_functions[index]
    crash function
    crash declared
    var model = state.context.program.class_named(declared.owner)
    crash model
    function.body = describing_body(declared, model)
}

func function_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var declaration = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["declaration"] = declaration
    made_given["owner"] = writing.text("")
    if state.stand_in and feature_flags.has_feature("b") {
        var owner: SpiteCompiler.Value = state.stand_in
        made_given["owner"] = owner
    }
    var made = writing.made_by_name(function_type, made_given)
    var local = writing.kept(made, function_type)
    var called = call_value_of(declared, model, function_model, false)
    if called {
        writing.set_value(local, function_model, "_called", called)
    }
    if state.stand_in and feature_flags.has_feature("o") {
        var held = held_value_of(declared, function_model)
        writing.set_value(local, function_model, "_value", held)
    }
    return local
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func held_value_of(declared: Model.FunctionModel, function_model: Model.ClassModel): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var held_type = value_attribute.attribute_type.present()
    state.context.need(declared)
    return HighIntermediaryRepresentation.Values.Function.Value(held_type, declared, receiver)
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func declaration_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var declaration_type = writing.reflection_type("Spite.FunctionDeclaration")
    var declaration_model = state.context.class_of(declaration_type)
    writing.need_the_making(declaration_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["hole"] = writing.text("")
    made_given["index"] = writing.whole(0)
    made_given["returns"] = declarations.answer_of(declared)
    made_given["source_path"] = declarations.function_file_of(declared, model)
    if feature_flags.has_feature("o") {
        var shape = declarations.function_type_of(declared)
        var shown = state.context.shown(shape)
        made_given["signature"] = writing.text(shown)
    }
    var made = writing.made_by_name(declaration_type, made_given)
    var local = writing.kept(made, declaration_type)
    var has_facts = declarations.belongs_to_the_program(model) and declarations.can_be_built(declared)
    add_the_arguments(local, declaration_model, declared, argument_type, has_facts)
    add_the_returned_literal(local, declaration_model, declared)
    if has_facts {
        writing.set_flag(local, declaration_model, "_has_facts", true)
    }
    if has_facts and feature_flags.has_feature("w") {
        var waits = writing.fact("waits", declared, "")
        writing.set_value(local, declaration_model, "_is_resumable", waits)
    }
    if has_facts and with_accesses and feature_flags.has_feature("a") {
        add_the_reach(local, declaration_model, declared, model)
        writing.set_flag(local, declaration_model, "_has_reach", true)
    }
    if not state.stand_in and makes_a_stand_in and feature_flags.has_feature("o") {
        state.stand_in = made_stand_in(model)
    }
    if state.stand_in and feature_flags.has_feature("o") {
        var called_on = called_on_value_of(declared, model, declaration_model)
        writing.set_value(local, declaration_model, "_called_on", called_on)
    }
    return local
}

func called_on_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_on_attribute = function_model.attribute_named("_called_on")
    crash called_on_attribute
    var wanted = called_on_attribute.attribute_type.present()
    var parameter_type = wanted.parameters[0]
    crash parameter_type
    var arguments_type = wanted.parameters[1]
    crash arguments_type
    var wrapper = calling_on_wrapper(model, declared, parameter_type, arguments_type)
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func calling_on_wrapper(
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
): Model.FunctionModel {
    var name = "_call_{declared.name}_on"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    var parameter = Model.ParameterModel("instance", instance_type, false)
    made.parameters.append(parameter)
    var arguments_parameter = Model.ParameterModel("arguments", arguments_type, false)
    made.parameters.append(arguments_parameter)
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var passed = first_unpassed_parameter(declared)
    if passed.is_empty() {
        called_on_its_instance(body, model, declared, instance_type, arguments_type)
    } else {
        var message = "spite: call() cannot pass the argument '{passed}' of '{model.shown}.{declared.name}' when the call is known only at run time, since a value of its type is not told apart while the program runs: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var refused = HighIntermediaryRepresentation.Statements.Stop(message)
        body.statements.append(refused)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func first_unpassed_parameter(declared: Model.FunctionModel): String {
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var kind = parameter.parameter_type.kind
        var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
        var is_told_apart = is_held or kind == 'union' or kind == 'shape' or kind == 'function'
        if not is_told_apart {
            return parameter.name
        }
        index = index + 1
    }
    return ""
}

func called_on_its_instance(
    body: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
) {
    state.context.need(declared)
    var own_type = model.type_of_an_instance()
    var instance = HighIntermediaryRepresentation.Values.LocalRead(instance_type, "instance")
    var tested = HighIntermediaryRepresentation.Values.Class.Membership(instance, own_type)
    var narrowed = HighIntermediaryRepresentation.Values.Conversion(own_type, 'present', instance)
    var running = HighIntermediaryRepresentation.Statements.Block()
    var passed_arguments = List<SpiteCompiler.Value>()
    var shown = "{model.shown}.{declared.name}"
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var argument = passed_argument(running, parameter, arguments_type, shown)
        passed_arguments.append(argument)
        index = index + 1
    }
    stop_an_argument_too_many(running, declared, arguments_type, shown)
    var call = HighIntermediaryRepresentation.Values.Call(declared, narrowed, passed_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    running.statements.append(evaluated)
    var message = "spite: call() runs '{declared.name}', declared by '{model.shown}', on an instance of another class: a call runs a declaration on an instance of its own class"
    var refused = HighIntermediaryRepresentation.Statements.Stop(message)
    var refusing = HighIntermediaryRepresentation.Statements.Block()
    refusing.statements.append(refused)
    var branch = HighIntermediaryRepresentation.Statements.If(tested, running, refusing)
    body.statements.append(branch)
}

func passed_argument(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    state.context.need(reading)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name)
    keys.append(key)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var present = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var missing = HighIntermediaryRepresentation.Values.Negation(present)
    var unfilled = "spite: call() leaves the argument '{parameter.name}' of '{shown}' unfilled: set 'call.arguments[\"{parameter.name}\"]' before 'call()'"
    stop_when(running, missing, unfilled)
    var written = parameter.parameter_type
    var wanted = written.present()
    if wanted.kind == 'function' {
        return passed_function(running, parameter, arguments_type, shown)
    }
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read)
    if wanted.kind == 'shape' {
        fill_with_the_programs_classes(wanted)
    }
    var fits = class_test_of(held, wanted)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var wanted_shown = state.context.shown(wanted)
    if wanted.kind == 'union' or wanted.kind == 'shape' {
        var segments = wanted_shown.split(".")
        var last = segments.last()
        crash last
        wanted_shown = last
    }
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var article = typing.article_of(wanted_shown)
    var other = "spite: call() gives '{shown}' an argument '{parameter.name}' that is not {article} {wanted_shown}, the type it takes"
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again)
    var kind = wanted.kind
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if kind == 'scalar' or kind == 'enumeration' {
        conversion = 'unbox'
    }
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, conversion, again_held)
    if written.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed)
    }
    return passed
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func passed_function(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name)
    keys.append(key)
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read)
    var fits = HighIntermediaryRepresentation.Values.Class.Membership(held, function_type)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var other = "spite: call() gives '{shown}' an argument '{parameter.name}' that is not a Spite.Function: a function value is passed to a call known only at run time as the function bound to its object, 'object.functions[\"name\"]'"
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again)
    var bound = HighIntermediaryRepresentation.Values.Conversion(function_type, 'present', again_held)
    var bound_name = "passed_{parameter.name}"
    var declared_bound = HighIntermediaryRepresentation.Statements.Declare(bound_name, function_type, bound)
    running.statements.append(declared_bound)
    var bound_read = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var declaration_attribute = function_model.attribute_named("_declaration")
    crash declaration_attribute
    var declaration_read = HighIntermediaryRepresentation.Values.AttributeRead(bound_read, declaration_attribute)
    var declaration_type = declaration_attribute.attribute_type.present()
    var declaration = HighIntermediaryRepresentation.Values.Conversion(declaration_type, 'present', declaration_read)
    var declaration_model = state.context.class_of(declaration_type)
    var signature_attribute = declaration_model.attribute_named("_signature")
    crash signature_attribute
    var signature = HighIntermediaryRepresentation.Values.AttributeRead(declaration, signature_attribute)
    var wanted = parameter.parameter_type.present()
    var wanted_shown = state.context.shown(wanted)
    var text_model = state.context.class_of(signature.value_type)
    var equals = text_model.function_named("equals")
    crash equals
    state.context.need(equals)
    var compared = List<SpiteCompiler.Value>()
    var wanted_text = writing.text(wanted_shown)
    compared.append(wanted_text)
    var same = HighIntermediaryRepresentation.Values.Call(equals, signature, compared)
    var differs = HighIntermediaryRepresentation.Values.Negation(same)
    var shaped = "spite: call() gives '{shown}' an argument '{parameter.name}' whose function is not a {wanted_shown}, the type it takes"
    stop_when(running, differs, shaped)
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var again_bound = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var value_read = HighIntermediaryRepresentation.Values.AttributeRead(again_bound, value_attribute)
    var value_type = value_attribute.attribute_type.present()
    var value = HighIntermediaryRepresentation.Values.Conversion(value_type, 'present', value_read)
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, 'proven', value)
    if parameter.parameter_type.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(parameter.parameter_type, 'nullable', passed)
    }
    return passed
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func class_test_of(held: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value {
    if wanted.kind != 'union' {
        return HighIntermediaryRepresentation.Values.Class.Membership(held, wanted)
    }
    var united = state.values.union_model_of(wanted)
    var boolean = state.context.boolean()
    var tested: SpiteCompiler.Value? = null
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var member_test = class_test_of(held, member)
        if tested {
            tested = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', tested, member_test)
        } else {
            tested = member_test
        }
        index = index + 1
    }
    crash tested
    return tested
}

func fill_with_the_programs_classes(wanted: Model.Type) {
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var folder = described_names.folder_of(entry.file.path)
    class_objects.read_every_class_in(folder)
    var index = 0
    while index < state.context.program.order.count() {
        var model = state.context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = described_names.is_inside(model.file.path, folder) and bound.is_empty() and not model.is_singleton
        var given = model.type_of_an_instance()
        if is_the_programs and model.key != state.context.program.entry and state.values.has_the_shape_members(given, wanted) {
            state.values.filled_shape(given, wanted)
        }
        index = index + 1
    }
}

func stop_an_argument_too_many(
    running: HighIntermediaryRepresentation.Statements.Block,
    declared: Model.FunctionModel,
    arguments_type: Model.Type,
    shown: String,
) {
    var dictionary = state.context.class_of(arguments_type)
    var counting = dictionary.function_named("count")
    crash counting
    state.context.need(counting)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var no_arguments = List<SpiteCompiler.Value>()
    var counted = HighIntermediaryRepresentation.Values.Call(counting, arguments, no_arguments)
    var integer = state.context.scalar_type("Integer")
    var taken: Long = declared.parameters.count()
    var limit = HighIntermediaryRepresentation.Values.WholeNumber(integer, taken)
    var boolean = state.context.boolean()
    var too_many = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'greater', counted, limit)
    var names = List<String>()
    var taken = List<String>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        names.append("'{parameter.name}'")
        taken.append(parameter.name)
        index = index + 1
    }
    var listed = names.join(", ")
    if listed.is_empty() {
        listed = "no arguments"
    }
    var found = state.context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = state.context.resolver.monomorphiser.class_model_named("Spite.Fault")
    crash fault
    state.context.need_defaults(fault.key)
    var naming = fault.function_named("argument_not_taken")
    crash naming
    state.context.need(naming)
    var fault_type = fault.type_of_an_instance()
    var no_fields = List<SpiteCompiler.Value>()
    var made_fault = HighIntermediaryRepresentation.Values.MakeObject(fault_type, null, no_fields)
    var named_arguments = List<SpiteCompiler.Value>()
    var passed = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    named_arguments.append(passed)
    var taken_text = taken.join("\t")
    var taken_constant = HighIntermediaryRepresentation.Values.TextConstant(taken_text)
    named_arguments.append(taken_constant)
    var shown_constant = HighIntermediaryRepresentation.Values.TextConstant(shown)
    named_arguments.append(shown_constant)
    var listed_constant = HighIntermediaryRepresentation.Values.TextConstant(listed)
    named_arguments.append(listed_constant)
    var named = HighIntermediaryRepresentation.Values.Call(naming, made_fault, named_arguments)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(named)
    stopping.statements.append(evaluated)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("")
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(too_many, stopping, null)
    running.statements.append(branch)
}

func stop_when(
    running: HighIntermediaryRepresentation.Statements.Block,
    condition: SpiteCompiler.Value,
    message: String,
) {
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, stopping, null)
    running.statements.append(branch)
}

func call_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
    makes_a_stand_in: Boolean,
): SpiteCompiler.Value? {
    if not state.stand_in and makes_a_stand_in {
        state.stand_in = made_stand_in(model)
    }
    fallback state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_attribute = function_model.attribute_named("_called")
    crash called_attribute
    var wanted = called_attribute.attribute_type.present()
    var wrapper = declared
    if not declared.parameters.is_empty() {
        wrapper = stopping_wrapper(model, declared)
    } else if declared.answer {
        wrapper = discarding_wrapper(model, declared)
    } else {
        state.context.need(declared)
    }
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func made_stand_in(model: Model.ClassModel): SpiteCompiler.Value {
    var instance_type = model.type_of_an_instance()
    state.context.need_defaults(model.key)
    var no_arguments = List<SpiteCompiler.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(instance_type, null, no_arguments)
    return writing.kept(made, instance_type)
}

func stopping_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_cannot_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var message = "spite: call_function() cannot call '{declared.name}': it takes arguments, and call_function() passes none"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    body.statements.append(stopped)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func discarding_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    state.context.need(declared)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    var no_arguments = List<SpiteCompiler.Value>()
    var call = HighIntermediaryRepresentation.Values.Call(declared, own, no_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements.append(evaluated)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func add_the_reach(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
) {
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    writing.need_the_making(declaration_type)
    var reads = writing.read_attribute(function, function_model, "_reads")
    var writes = writing.read_attribute(function, function_model, "_writes")
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = declarations.attribute_declaration_of(attribute, index, model)
        var declaration = writing.kept(made, declaration_type)
        var slot = "a:{attribute.name}"
        var read_fact = writing.fact("reads", declared, slot)
        writing.appended_when(read_fact, reads, declaration)
        var written_fact = writing.fact("written", declared, slot)
        writing.appended_when(written_fact, writes, declaration)
        index = index + 1
    }
}

func add_the_arguments(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    argument_type: Model.Type,
    has_facts: Boolean,
) {
    var argument_model = state.context.class_of(argument_type)
    var listed = writing.read_attribute(function, function_model, "_arguments")
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made = declarations.argument_of(parameter, index, argument_type)
        var local = writing.kept(made, argument_type)
        if has_facts {
            writing.set_flag(local, argument_model, "_has_facts", true)
        }
        if has_facts and feature_flags.has_feature("m") {
            var mutated = writing.fact("writes", declared, "p:{parameter.name}")
            writing.set_value(local, argument_model, "_is_mutated", mutated)
        }
        writing.appended(listed, local)
        index = index + 1
    }
}

func fill_of_a_function_list(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    var model = state.context.program.class_named(described)
    crash model
    var made = model.function_named("_function_list")
    crash made
    var function_type = writing.reflection_type("Spite.Function")
    var list_type = state.context.resolver.monomorphiser.text_dictionary_type_of(function_type)
    var made_list = state.values.made_list(list_type)
    var listed = writing.kept(made_list, list_type)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    add_the_functions(listed, model, own, false, false)
    var answered = HighIntermediaryRepresentation.Statements.Return(listed)
    state.statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = state.statements
    state.statements = outer
    return HighIntermediaryRepresentation.HighFunction(made, body)
}

func function_list_of(model: Model.ClassModel): Model.FunctionModel {
    var known = model.function_named("_function_list")
    if known {
        return known
    }
    var function_type = writing.reflection_type("Spite.Function")
    var list_type = state.context.resolver.monomorphiser.text_dictionary_type_of(function_type)
    var made = Model.FunctionModel("_function_list", model.key)
    made.is_synthetic = true
    made.answer = list_type
    model.declared_functions.append(made)
    var known_list = "Functions:{model.key}"
    state.context.reflected.append(known_list)
    state.context.unfilled.append(known_list)
    return made
}

func add_the_returned_literal(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
) {
    fallback declared.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = declared.declaration
    fallback declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    fallback body.statements.count() == 1
    var only = body.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        add_a_literal_return(function, function_model, only)
    }
}

func add_a_literal_return(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    var value = returned.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        add_a_literal(function, function_model, value)
    }
}

func add_a_literal(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral,
) {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    var written = piece.value()
    writing.set_text(function, function_model, "_returned_literal", written)
}

func arguments_of(declared: Model.FunctionModel): SpiteCompiler.Value {
    state.statements = List<SpiteCompiler.Statement>()
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var list_type = state.context.resolver.monomorphiser.list_type_of(argument_type)
    var made_list = state.values.made_list(list_type)
    var listed = writing.kept_in_scope(made_list, list_type)
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made = declarations.argument_of(parameter, index, argument_type)
        var local = writing.kept_in_scope(made, argument_type)
        writing.appended(listed, local)
        index = index + 1
    }
    state.statements.each(state.context.pending.append)
    return listed
}

func no_attribute_list(): SpiteCompiler.Value {
    var attribute_type = writing.reflection_type("Spite.Attribute")
    writing.need_the_making(attribute_type)
    var dictionary_type = state.context.resolver.monomorphiser.text_dictionary_type_of(attribute_type)
    return state.values.new_list(dictionary_type)
}

func attributes_of_an_object(target: SpiteCompiler.Value, model: Model.ClassModel): SpiteCompiler.Value {
    state.statements = List<SpiteCompiler.Statement>()
    var attribute_type = writing.reflection_type("Spite.Attribute")
    writing.need_the_making(attribute_type)
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    writing.need_the_making(declaration_type)
    var dictionary_type = state.context.resolver.monomorphiser.text_dictionary_type_of(attribute_type)
    var made_dictionary = state.values.new_list(dictionary_type)
    var listed = writing.kept_in_scope(made_dictionary, dictionary_type)
    var object = writing.kept_in_scope(target, target.value_type)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            var declaration = declaration_of_a_field(model, attribute, index, declaration_type)
            var read = HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
            var made_given = Dictionary<String, SpiteCompiler.Value>()
            made_given["name"] = writing.text(attribute.name)
            made_given["index"] = writing.whole(index)
            made_given["class"] = class_objects.described_class_of(attribute.attribute_type)
            made_given["declaration"] = declaration
            made_given["owner"] = object
            made_given["value"] = read
            var made = writing.made_by_name(attribute_type, made_given)
            var local = writing.kept_in_scope(made, attribute_type)
            var key = writing.text(attribute.name)
            writing.placed(listed, key, local)
        }
        index = index + 1
    }
    state.statements.each(state.context.pending.append)
    return listed
}

# ../../../spite_documentation/reflection.md#spiteattribute
func declaration_of_a_field(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    index: Integer,
    declaration_type: Model.Type,
): SpiteCompiler.Value {
    var element = model.bound_types["$element_type"]
    var lists_declarations = not declarations.holds_its_values_itself(model) and not element and model.key != "String"
    if lists_declarations and not scalars.of(model.key) {
        var listed = state.values.member_declaration(model.key, "attributes", attribute.name)
        return writing.kept_in_scope(listed, declaration_type)
    }
    var made_declaration = declarations.attribute_declaration_of(attribute, index, model)
    return writing.kept_in_scope(made_declaration, declaration_type)
}

func no_attributes(): Model.FunctionModel {
    make_no_attributes()
    var attribute_type = writing.reflection_type("Spite.Attribute")
    var attribute_model = state.context.class_of(attribute_type)
    var made = attribute_model.function_named("_no_attributes")
    crash made
    return made
}

func make_no_attributes() {
    var attribute_type = writing.reflection_type("Spite.Attribute")
    var attribute_model = state.context.class_of(attribute_type)
    fallback not attribute_model.function_named("_no_attributes")
    var list_type = state.context.resolver.monomorphiser.text_dictionary_type_of(attribute_type)
    var made = Model.FunctionModel("_no_attributes", attribute_model.key)
    made.is_synthetic = true
    made.answer = list_type
    attribute_model.declared_functions.append(made)
    var empty = state.values.made_list(list_type)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var answered = HighIntermediaryRepresentation.Statements.Return(empty)
    body.statements.append(answered)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
}

func attribute_list_of(model: Model.ClassModel): Model.FunctionModel {
    make_attribute_list_of(model)
    var made = model.function_named("_attribute_list")
    crash made
    return made
}

func make_attribute_list_of(model: Model.ClassModel) {
    fallback not model.function_named("_attribute_list")
    var attribute_type = writing.reflection_type("Spite.Attribute")
    var list_type = state.context.resolver.monomorphiser.text_dictionary_type_of(attribute_type)
    var made = Model.FunctionModel("_attribute_list", model.key)
    made.is_synthetic = true
    made.answer = list_type
    model.declared_functions.append(made)
    var outer_pending = state.context.pending
    state.context.pending = List<SpiteCompiler.Statement>()
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var listed = attributes_of_an_object(own, model)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = state.context.pending
    var answered = HighIntermediaryRepresentation.Statements.Return(listed)
    body.statements.append(answered)
    state.context.pending = outer_pending
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
}

func fill_of_a_namespace(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = state.statements
    var outer_given = state.given
    state.statements = List<SpiteCompiler.Statement>()
    state.given = Dictionary<String, SpiteCompiler.Value>()
    var namespace_type = writing.reflection_type("Spite.Namespace")
    var namespace_model = state.context.class_of(namespace_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(namespace_type)
    var simple = described_names.last_name_of(described)
    writing.give_text("name", simple)
    writing.give_text("name_with_namespaces", described)
    var parent_name = described_names.namespace_of(described)
    var parent = class_objects.namespace_object(parent_name)
    state.given["parent"] = parent
    var folder = state.context.resolver.state.symbols.namespace_folder(described)
    if folder {
        add_the_contents(own, namespace_model, folder)
        add_the_source_directories(own, namespace_model, folder)
    }
    return filled_function(own, namespace_model, described, outer, outer_given)
}

func add_the_contents(own: SpiteCompiler.Value, namespace_model: Model.ClassModel, folder: Mapping.MappedFolder) {
    var classes = writing.read_attribute(own, namespace_model, "_classes")
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var model = state.context.program.class_named(file.namespace)
        if model {
            var described = class_objects.class_object(model.key)
            writing.appended(classes, described)
        }
        index = index + 1
    }
    var namespaces = writing.read_attribute(own, namespace_model, "_namespaces")
    var folder_index = 0
    while folder_index < folder.folders.count() {
        var inner = folder.folders[folder_index]
        var inner_object = class_objects.namespace_object(inner.namespace)
        writing.appended(namespaces, inner_object)
        folder_index = folder_index + 1
    }
}

func class_of_value(described: SpiteCompiler.Value): SpiteCompiler.Value {
    var described_type = described.value_type
    var present_value = Validators.HighIntermediaryRepresentation.PresentValue.Validator()
    present_value.check_a_present_value(state.context, described_type)
    if described_type.is_a_walked_name {
        return class_objects.class_object("String")
    }
    var is_one_class = described_type.kind == 'object' or described_type.kind == 'scalar'
    if is_one_class or described_type.kind == 'enumeration' {
        return class_objects.class_object(described_type.name)
    }
    var candidates = candidates_of(described_type)
    candidates.each(class_objects.make_a_class_object)
    var class_type = writing.reflection_type("Spite.Class")
    var made = HighIntermediaryRepresentation.Values.Class.OfValue(class_type, described, candidates)
    if described_type.kind == 'shape' {
        state.context.shape_classes.append(made)
    }
    return made
}

func add_the_late_fillers(asked: HighIntermediaryRepresentation.Values.Class.OfValue) {
    crash asked.described
    var now = candidates_of(asked.described.value_type)
    var index = 0
    while index < now.count() {
        var candidate = now[index]
        if not asked.candidates.contains(candidate) {
            asked.candidates.append(candidate)
            class_objects.make_a_class_object(candidate)
        }
        index = index + 1
    }
}

func candidates_of(described_type: Model.Type): List<String> {
    var found = List<String>()
    if described_type.kind == 'shape' {
        var fillers = state.context.program.fillers_of(described_type.name)
        var index = 0
        while index < fillers.count() {
            var filler = fillers[index]
            found.append(filler.name)
            index = index + 1
        }
        return found
    }
    var made = state.values.union_model_of(described_type)
    var member_index = 0
    while member_index < made.members.count() {
        var member = made.members[member_index]
        found.append(member.name)
        member_index = member_index + 1
    }
    return found
}

func every_class(): SpiteCompiler.Value {
    var argument = Model.Type('object', "Spite.Class")
    var list_type = state.context.resolver.monomorphiser.list_type_of(argument)
    var listed = state.values.new_list(list_type)
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var folder = described_names.folder_of(entry.file.path)
    class_objects.read_every_class_in(folder)
    var keys = List<String>()
    var index = 0
    while index < state.context.program.order.count() {
        var model = state.context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = described_names.is_inside(model.file.path, folder) and bound.is_empty()
        if is_the_programs {
            described_names.insert_in_order(keys, model.key)
        }
        index = index + 1
    }
    var key_index = 0
    while key_index < keys.count() {
        var key = keys[key_index]
        var described = class_objects.class_object(key)
        state.values.append_to(listed, described)
        key_index = key_index + 1
    }
    return listed
}

func made_anew(): Model.FunctionModel {
    var class_type = writing.reflection_type("Spite.Class")
    var class_model = state.context.class_of(class_type)
    var known = class_model.function_named("_made_anew")
    if known {
        return known
    }
    var anything = state.context.resolver.types.type_of_a_name("Anything")
    var made = Model.FunctionModel("_made_anew", class_model.key)
    made.is_synthetic = true
    made.answer = anything
    class_model.declared_functions.append(made)
    var body = making_body(class_type, anything)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.made_anew = function
    return made
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func remake_the_making() {
    fallback state.context.made_anew
    var described = described_class_count()
    fallback described != state.context.made_anew_classes
    var class_type = writing.reflection_type("Spite.Class")
    var anything = state.context.resolver.types.type_of_a_name("Anything")
    state.context.made_anew.body = making_body(class_type, anything)
}

func described_class_count(): Integer {
    var count = 0
    var index = 0
    while index < state.context.reflected.count() {
        var known = state.context.reflected[index]
        if known.starts_with("Spite.Class:") {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func making_body(class_type: Model.Type, anything: Model.Type): HighIntermediaryRepresentation.Statements.Block {
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var folder = described_names.folder_of(entry.file.path)
    class_objects.read_every_class_in(folder)
    var keys = List<String>()
    var index = 0
    while index < state.context.program.order.count() {
        var model = state.context.program.order[index]
        var bound = model.bound_types.keys()
        if described_names.is_inside(model.file.path, folder) and bound.is_empty() {
            described_names.insert_in_order(keys, model.key)
        }
        index = index + 1
    }
    var plain_names = [
        "Boolean"
        "Tiny"
        "Byte"
        "Short"
        "UnsignedShort"
        "Integer"
        "UnsignedInteger"
        "Long"
        "UnsignedLong"
        "Float"
        "Double"
        "String"
    ]
    var others = List<String>()
    var reflected_index = 0
    while reflected_index < state.context.reflected.count() {
        var reflected = state.context.reflected[reflected_index]
        var other = described_library_class(reflected, keys, plain_names)
        if other {
            described_names.insert_in_order(others, other)
        }
        reflected_index = reflected_index + 1
    }
    state.context.made_anew_classes = described_class_count()
    var body = HighIntermediaryRepresentation.Statements.Block()
    var own = HighIntermediaryRepresentation.Values.ThisRead(class_type)
    var key_index = 0
    while key_index < keys.count() {
        var key = keys[key_index]
        var branch = making_branch(own, key, anything)
        body.statements.append(branch)
        key_index = key_index + 1
    }
    var other_index = 0
    while other_index < others.count() {
        var other_key = others[other_index]
        var other_branch = making_branch(own, other_key, anything)
        body.statements.append(other_branch)
        other_index = other_index + 1
    }
    var plain_index = 0
    while plain_index < plain_names.count() {
        var plain_name = plain_names[plain_index]
        var plain_model = state.context.program.class_named(plain_name)
        if plain_model {
            var plain_branch = plain_making_branch(own, plain_model, anything)
            body.statements.append(plain_branch)
        }
        plain_index = plain_index + 1
    }
    var message = "spite: a class known only at run time makes an object only of a class that is not a singleton, a generic class, an enum or a union"
    var refused = HighIntermediaryRepresentation.Statements.Stop(message)
    body.statements.append(refused)
    return body
}

func described_library_class(reflected: String, keys: List<String>, plain_names: List<String>): String? {
    var prefix = "Spite.Class:"
    fallback reflected.starts_with(prefix)
    var prefix_length = prefix.length()
    var reflected_length = reflected.length()
    var key = reflected.slice(prefix_length, reflected_length)
    crash key
    fallback not keys.contains(key) and not plain_names.contains(key)
    var model = state.context.program.class_named(key)
    fallback model
    var bound = model.bound_types.keys()
    var is_a_template = state.context.resolver.monomorphiser.is_a_template(model.file)
    fallback not model.is_singleton and bound.is_empty() and not is_a_template
    return key
}

func making_branch(own: SpiteCompiler.Value, key: String, anything: Model.Type): SpiteCompiler.Statement {
    var described = class_objects.class_object(key)
    var compared = List<SpiteCompiler.Value>()
    compared.append(described)
    var is_this_class = state.values.method_call(own, "equals", compared)
    var model = state.context.program.class_named(key)
    crash model
    var making = HighIntermediaryRepresentation.Statements.Block()
    var constructor = state.values.constructor_of(model)
    var takes_nothing = true
    if constructor {
        takes_nothing = constructor.parameters.is_empty()
    }
    if key == state.context.program.entry {
        var entered = HighIntermediaryRepresentation.Statements.Stop(
            "spite: '{model.shown}' is the program's entry class, made once when the program starts, so a class known only at run time cannot make another",
        )
        making.statements.append(entered)
    } else if not takes_nothing {
        var refused = HighIntermediaryRepresentation.Statements.Stop(
            "spite: '{model.shown}' takes arguments to be made, so a class known only at run time cannot make one: call the class by its name with its arguments",
        )
        making.statements.append(refused)
    } else {
        var answered = made_of_a_class(model, constructor, anything)
        making.statements.append(answered)
    }
    return HighIntermediaryRepresentation.Statements.If(is_this_class, making, null)
}

func plain_making_branch(
    own: SpiteCompiler.Value,
    model: Model.ClassModel,
    anything: Model.Type,
): SpiteCompiler.Statement {
    var described = class_objects.class_object(model.key)
    var compared = List<SpiteCompiler.Value>()
    compared.append(described)
    var is_this_class = state.values.method_call(own, "equals", compared)
    var plain_type = Model.Type('scalar', model.key)
    if model.key == "String" {
        plain_type = Model.Type('object', "String")
    }
    var made = state.values.default_of_a_type(plain_type)
    crash made
    var fitted = state.values.fitted(made, anything)
    var answered = HighIntermediaryRepresentation.Statements.Return(fitted)
    var making = HighIntermediaryRepresentation.Statements.Block()
    making.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_this_class, making, null)
}

func made_of_a_class(
    model: Model.ClassModel,
    constructor: Model.FunctionModel?,
    anything: Model.Type,
): SpiteCompiler.Statement {
    state.context.need_defaults(model.key)
    if constructor {
        state.context.need(constructor)
    }
    var instance_type = model.type_of_an_instance()
    var no_arguments = List<SpiteCompiler.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(instance_type, constructor, no_arguments)
    var fitted = state.values.fitted(made, anything)
    return HighIntermediaryRepresentation.Statements.Return(fitted)
}

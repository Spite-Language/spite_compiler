union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var statements = List<Statement>()
var local_count = 0
var stand_in: Value? = null
var declares_in_scope = false

func Reflection(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func reflection_type(name: String): Model.Type {
    var path = name.split(".")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
}

func make_a_class_object(described: String) {
    var class_type = reflection_type("Spite.Class")
    var known = "Spite.Class:{described}"
    fallback not context.reflected.contains(known)
    context.reflected.append(known)
    need_the_making(class_type)
    context.unfilled.append(known)
}

func class_object(described: String): Value {
    make_a_class_object(described)
    var class_type = reflection_type("Spite.Class")
    return HighIntermediaryRepresentation.Values.Class.Object(class_type, described)
}

func namespace_object(described: String): Value {
    var namespace_type = reflection_type("Spite.Namespace")
    if described.is_empty() {
        var nullable = namespace_type.nullable()
        return HighIntermediaryRepresentation.Values.NullConstant(nullable)
    }
    var made = HighIntermediaryRepresentation.Values.Class.Object(namespace_type, described)
    var known = "Spite.Namespace:{described}"
    if context.reflected.contains(known) {
        return made
    }
    context.reflected.append(known)
    need_the_making(namespace_type)
    context.unfilled.append(known)
    return made
}

# ../../../spite_documentation/reflection.md#spiteenum
func enum_object(described: String): Value {
    return declared_object("Spite.Enum", described)
}

# ../../../spite_documentation/reflection.md#spiteunion-and-spitetype
func declared_object(kind: String, described: String): Value {
    var declared_type = reflection_type(kind)
    var made = HighIntermediaryRepresentation.Values.Class.Object(declared_type, described)
    var known = "{kind}:{described}"
    if context.reflected.contains(known) {
        return made
    }
    context.reflected.append(known)
    need_the_making(declared_type)
    context.unfilled.append(known)
    return made
}

func fill(known: String): HighIntermediaryRepresentation.HighFunction {
    var class_prefix = "Spite.Class:"
    var namespace_prefix = "Spite.Namespace:"
    var enum_prefix = "Spite.Enum:"
    var union_prefix = "Spite.Union:"
    var type_prefix = "Spite.Type:"
    var known_length = known.length()
    if known.starts_with(enum_prefix) {
        var enum_length = enum_prefix.length()
        var described_enum = known.slice(enum_length, known_length)
        crash described_enum
        return fill_of_an_enum(described_enum)
    }
    if known.starts_with(union_prefix) {
        var union_length = union_prefix.length()
        var described_union = known.slice(union_length, known_length)
        crash described_union
        return fill_of_a_union(described_union)
    }
    if known.starts_with(type_prefix) {
        var type_length = type_prefix.length()
        var described_shape = known.slice(type_length, known_length)
        crash described_shape
        return fill_of_a_type(described_shape)
    }
    if known.starts_with(class_prefix) {
        var class_length = class_prefix.length()
        var described_class = known.slice(class_length, known_length)
        crash described_class
        return fill_of_a_class(described_class)
    }
    if known.starts_with(namespace_prefix) {
        var namespace_length = namespace_prefix.length()
        var described_namespace = known.slice(namespace_length, known_length)
        crash described_namespace
        return fill_of_a_namespace(described_namespace)
    }
    var functions_prefix = "Functions:"
    crash known.starts_with(functions_prefix)
    var functions_length = functions_prefix.length()
    var described = known.slice(functions_length, known_length)
    crash described
    return fill_of_a_function_list(described)
}

func features(): String {
    var found = ""
    var lists = wants("Spite.Class.get_functions") or wants("Spite.Class.has_function") or wants("Spite.Class.argument_count")
    if lists or wants("Spite.Class.function_waits") {
        found = "{found}f"
    }
    var asks_waits = wants("Spite.Function.get_is_resumable") or wants("Spite.FunctionDeclaration.get_is_resumable")
    if asks_waits or wants("Spite.Class.function_waits") {
        found = "{found}w"
    }
    if wants("Spite.Argument.get_is_mutated") {
        found = "{found}m"
    }
    var asks_reach = wants("Spite.Function.get_reads") or wants("Spite.Function.get_writes")
    if asks_reach or wants("Spite.FunctionDeclaration.get_reads") or wants("Spite.FunctionDeclaration.get_writes") {
        found = "{found}a"
    }
    if wants("Spite.Class.get_is_stateful") {
        found = "{found}s"
    }
    if wants("Spite.Class.get_enums") or wants("Spite.Class.get_unions") or wants("Spite.Class.get_types") {
        found = "{found}e"
    }
    if wants("Spite.Function.get_owner") {
        found = "{found}b"
    }
    if wants("Spite.FunctionDeclaration._call_on") {
        found = "{found}o"
    }
    return found
}

func wants(key: String): Boolean {
    return context.queued.contains(key)
}

func has_feature(feature: String): Boolean {
    return context.fill_features.contains(feature)
}

func need_the_making(reflection: Model.Type) {
    var model = context.class_of(reflection)
    context.need_defaults(model.key)
    var constructor = values.constructor_of(model)
    crash constructor
    context.need(constructor)
    values.need_text_constants()
}

func fill_of_a_class(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var class_type = reflection_type("Spite.Class")
    var class_model = context.class_of(class_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(class_type)
    var is_optional = described.ends_with("?")
    var base = described
    if is_optional {
        var described_length = described.length()
        var sliced_base = described.slice(0, described_length - 1)
        crash sliced_base
        base = sliced_base
        set_flag(own, class_model, "_is_optional", true)
    }
    var model = context.program.class_named(base)
    var shown = base
    if model {
        shown = model.shown
    }
    if is_optional {
        shown = "{shown}?"
    }
    set_text(own, class_model, "_name_with_namespaces", shown)
    var simple = without_namespaces(shown)
    var keeps_arguments = simple.starts_with("List<") or simple.starts_with("Dictionary<") or simple.starts_with("Vector<") or simple.starts_with("Items<")
    var opening = simple.index_of("<")
    if not keeps_arguments and opening and opening > 0 {
        var sliced_simple = simple.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    set_text(own, class_model, "_name", simple)
    var namespace_name = namespace_of(described)
    var namespace = namespace_object(namespace_name)
    set_value(own, class_model, "_namespace", namespace)
    if model {
        fill_from_the_model(own, class_model, model)
        var source_folder = folder_of(model.file.path)
        set_text(own, class_model, "_source_folder", source_folder)
        add_the_source_files(own, class_model, base)
    } else {
        fill_an_enum(own, class_model, base)
    }
    var function = Model.FunctionModel("_fill_{described}", class_model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func fill_from_the_model(
    own: Value,
    class_model: Model.ClassModel,
    model: Model.ClassModel,
) {
    set_flag(own, class_model, "_is_singleton", model.is_singleton)
    fill_the_state(own, class_model, model)
    var fixed_size = is_fixed_size(model)
    set_flag(own, class_model, "_is_fixed_size", fixed_size)
    var element = model.bound_types["$element_type"]
    var is_a_list = model.function_named("_read_value")
    if element and is_a_list {
        set_flag(own, class_model, "_is_list", true)
        var element_class = class_object(element.name)
        set_value(own, class_model, "_element_type", element_class)
    }
    var dictionary_value = model.bound_types["$value_type"]
    if dictionary_value {
        set_flag(own, class_model, "_is_dictionary", true)
        var value_class = class_object(dictionary_value.name)
        set_value(own, class_model, "_element_type", value_class)
    }
    var scalars = Model.Scalars()
    var is_stored_by_the_compiler = model.key == "String"
    if scalars.of(model.key) {
        is_stored_by_the_compiler = true
    }
    if not is_stored_by_the_compiler and not element {
        add_the_attributes(own, class_model, model)
    }
    if has_feature("e") {
        add_the_declarations(own, class_model, model)
    }
    fallback has_feature("f")
    if model.key == context.program.entry {
        set_flag(own, class_model, "_has_no_stand_in", true)
    } else {
        var listed = read_attribute(own, class_model, "_functions")
        var makes_a_stand_in = belongs_to_the_program(model) and not model.is_singleton and not is_stored_by_the_compiler
        add_the_functions(listed, model, null, makes_a_stand_in, true)
    }
}

func fill_an_enum(own: Value, class_model: Model.ClassModel, described: String) {
    var parts = described.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    fallback owner
    var enumeration = owner.enum_named(simple)
    fallback enumeration
    set_flag(own, class_model, "_is_enum", true)
}

# ../../../spite_documentation/reflection.md#what-a-class-declares
func add_the_declarations(
    own: Value,
    class_model: Model.ClassModel,
    model: Model.ClassModel,
) {
    var enums = read_attribute(own, class_model, "_enums")
    var enum_index = 0
    while enum_index < model.enums.count() {
        var enumeration = model.enums[enum_index]
        var described_enum = enum_object("{model.key}.{enumeration.name}")
        var enum_key = text(enumeration.name)
        placed(enums, enum_key, described_enum)
        enum_index = enum_index + 1
    }
    var unions = read_attribute(own, class_model, "_unions")
    var union_index = 0
    while union_index < model.unions.count() {
        var united = model.unions[union_index]
        var described_union = declared_object("Spite.Union", "{model.key}.{united.name}")
        var union_key = text(united.name)
        placed(unions, union_key, described_union)
        union_index = union_index + 1
    }
    var types = read_attribute(own, class_model, "_types")
    var type_index = 0
    while type_index < model.shapes.count() {
        var shape = model.shapes[type_index]
        var described_shape = declared_object("Spite.Type", "{model.key}.{shape.name}")
        var type_key = text(shape.name)
        placed(types, type_key, described_shape)
        type_index = type_index + 1
    }
}

func fill_of_a_union(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var union_type = reflection_type("Spite.Union")
    var union_model = context.class_of(union_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(union_type)
    var owner_key = namespace_of(described)
    var owner = context.program.class_named(owner_key)
    crash owner
    var simple = last_name_of(described)
    var united = owner.union_named(simple)
    crash united
    set_text(own, union_model, "_name_with_namespaces", "{owner.shown}.{simple}")
    var owner_object = class_object(owner.key)
    set_value(own, union_model, "_owner", owner_object)
    var listed = read_attribute(own, union_model, "_members")
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var described_member = class_object_of_type(member)
        if described_member {
            var shown = context.shown(member)
            var key = text(shown)
            placed(listed, key, described_member)
        }
        index = index + 1
    }
    var function = Model.FunctionModel("_fill_{described}", union_model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func fill_of_a_type(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var shape_type = reflection_type("Spite.Type")
    var shape_model = context.class_of(shape_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(shape_type)
    var owner_key = namespace_of(described)
    var owner = context.program.class_named(owner_key)
    crash owner
    var simple = last_name_of(described)
    set_text(own, shape_model, "_name_with_namespaces", "{owner.shown}.{simple}")
    var owner_object = class_object(owner.key)
    set_value(own, shape_model, "_owner", owner_object)
    var function = Model.FunctionModel("_fill_{described}", shape_model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func fill_of_an_enum(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var enum_type = reflection_type("Spite.Enum")
    var enum_model = context.class_of(enum_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(enum_type)
    var owner_key = namespace_of(described)
    var owner = context.program.class_named(owner_key)
    crash owner
    var simple = last_name_of(described)
    var enumeration = owner.enum_named(simple)
    crash enumeration
    set_text(own, enum_model, "_name_with_namespaces", "{owner.shown}.{simple}")
    var owner_object = class_object(owner.key)
    set_value(own, enum_model, "_owner", owner_object)
    var value_type = reflection_type("Spite.EnumValue")
    need_the_making(value_type)
    var listed = read_attribute(own, enum_model, "_values")
    var integer = context.scalar_type("Integer")
    var index = 0
    while index < enumeration.values.count() {
        var value = enumeration.values[index]
        var number = enumeration.numbers[index]
        crash number
        var named = text(value)
        var numbered = HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
        var placed_at = whole(index)
        var more = List<Value>()
        more.append(numbered)
        more.append(placed_at)
        var made = made_from(value_type, named, more)
        var local = kept(made, value_type)
        var key = text(value)
        placed(listed, key, local)
        index = index + 1
    }
    var function = Model.FunctionModel("_fill_{described}", enum_model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func add_the_source_files(
    own: Value,
    class_model: Model.ClassModel,
    described: String,
) {
    fallback class_model.attribute_named("_source_files")
    var listed = read_attribute(own, class_model, "_source_files")
    var file_type = Model.Type('object', "File")
    need_the_making(file_type)
    var known = context.resolver.symbols.map.classes_by_namespace[described]
    fallback known
    var index = 0
    while index < known.count() {
        var class_file = known[index]
        var relative = written_path_of(class_file.path)
        var named = text(relative)
        var no_more = List<Value>()
        var made = made_from(file_type, named, no_more)
        appended(listed, made)
        index = index + 1
    }
}

func add_the_source_directories(
    own: Value,
    namespace_model: Model.ClassModel,
    folder: Mapping.MappedFolder,
) {
    fallback namespace_model.attribute_named("_source_directories")
    var listed = read_attribute(own, namespace_model, "_source_directories")
    var directory_type = Model.Type('object', "Directory")
    need_the_making(directory_type)
    var index = 0
    while index < folder.paths.count() {
        var folder_path = folder.paths[index]
        var relative = written_path_of(folder_path)
        var named = text(relative)
        var no_more = List<Value>()
        var made = made_from(directory_type, named, no_more)
        appended(listed, made)
        index = index + 1
    }
}

func written_path_of(path: String): String {
    return path.replace("\\", "/")
}

func is_stateful(model: Model.ClassModel): Boolean {
    return not model.declared_attributes.is_empty()
}

# ../../PROOFS.md#whether-a-class-keeps-state
func fill_the_state(
    own: Value,
    class_model: Model.ClassModel,
    model: Model.ClassModel,
) {
    var binds_state = binds_a_singleton_with_state(model)
    var asked_of_the_program = not binds_state and has_feature("s") and belongs_to_the_program(model)
    if asked_of_the_program and every_writer_can_be_built(model) {
        var writing = writes_its_object(model)
        set_value(own, class_model, "_is_stateful", writing)
        return
    }
    var stateful = binds_state or asked_of_the_program or is_stateful(model)
    set_flag(own, class_model, "_is_stateful", stateful)
}

func binds_a_singleton_with_state(model: Model.ClassModel): Boolean {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type
        if held.kind == 'object' and context.has_a_class(held) {
            var bound = context.class_of(held)
            if bound.is_singleton and not bound.declared_attributes.is_empty() {
                return true
            }
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#whether-a-class-keeps-state
func every_writer_can_be_built(model: Model.ClassModel): Boolean {
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_written = not declared.is_constructor and declared.name != "drop" and not declared.is_synthetic
        fallback not is_written or can_be_built(declared)
        index = index + 1
    }
    return true
}

func writes_its_object(model: Model.ClassModel): HighIntermediaryRepresentation.Values.Function.Fact {
    var functions = List<Model.FunctionModel>()
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_written = not declared.is_constructor and declared.name != "drop" and not declared.is_synthetic
        var is_asked = is_written and can_be_built(declared)
        if is_asked {
            functions.append(declared)
            context.need(declared)
        }
        index = index + 1
    }
    var boolean = context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, "keeps_state", functions)
    made.slot = "this"
    context.facts_asked.append(made)
    return made
}

func is_fixed_size(model: Model.ClassModel): Boolean {
    var scalars = Model.Scalars()
    if scalars.of(model.key) or model.key == "String" {
        return true
    }
    var described = Model.Type('object', model.key)
    return values.fits_a_vector(described)
}

func add_the_attributes(
    own: Value,
    class_model: Model.ClassModel,
    model: Model.ClassModel,
) {
    fallback not holds_its_values_itself(model)
    var declaration_type = reflection_type("Spite.AttributeDeclaration")
    var declaration_model = context.class_of(declaration_type)
    need_the_making(declaration_type)
    var listed = read_attribute(own, class_model, "_attributes")
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var index_value = whole(index)
        var name = text(attribute.name)
        var made = made_with(declaration_type, name, index_value)
        var local = kept(made, declaration_type)
        var described = class_object_of_type(attribute.attribute_type)
        if described {
            set_value(local, declaration_model, "_class", described)
        }
        var key = text(attribute.name)
        placed(listed, key, local)
        index = index + 1
    }
}

func add_the_functions(
    listed: Value,
    model: Model.ClassModel,
    receiver: Value?,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var function_type = reflection_type("Spite.Function")
    need_the_making(function_type)
    var declaration_type = reflection_type("Spite.FunctionDeclaration")
    need_the_making(declaration_type)
    var argument_type = reflection_type("Spite.Argument")
    need_the_making(argument_type)
    stand_in = receiver
    var index = 0
    while index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        if is_listed(declared) and receiver {
            add_a_function_object(listed, declared, model, makes_a_stand_in, with_accesses)
        } else if is_listed(declared) {
            add_a_declaration_object(listed, declared, model, makes_a_stand_in, with_accesses)
        }
        index = index + 1
    }
}

func add_a_declaration_object(
    listed: Value,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var local = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    var key = text(declared.name)
    placed(listed, key, local)
}

func is_listed(declared: Model.FunctionModel): Boolean {
    fallback not declared.is_constructor and not declared.is_a_member_template and not declared.is_a_walk_copy
    return not declared.name.starts_with("_")
}

func can_be_built(declared: Model.FunctionModel): Boolean {
    fallback not declared.is_a_member_template and declared.has_a_body()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var parameter_type = parameter.parameter_type
        fallback parameter_type.kind != 'object' or not parameter_type.name.starts_with("Spite.")
        index = index + 1
    }
    return true
}

func add_a_function_object(
    listed: Value,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
) {
    var local = function_object(declared, model, makes_a_stand_in, with_accesses)
    var key = text(declared.name)
    placed(listed, key, local)
}

func function_object_in_place(
    declared: Model.FunctionModel,
    receiver: Value,
): Value {
    var model = context.program.class_named(declared.owner)
    crash model
    var function_type = reflection_type("Spite.Function")
    need_the_making(function_type)
    var argument_type = reflection_type("Spite.Argument")
    need_the_making(argument_type)
    var describer = describer_of(declared, model, function_type)
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.Call(describer, receiver, no_arguments)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func describer_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_type: Model.Type,
): Model.FunctionModel {
    var name = "_described_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    made.answer = function_type
    model.declared_functions.append(made)
    var body = describing_body(declared, model)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    context.describers.append(function)
    context.described_functions.append(declared)
    return made
}

func describing_body(declared: Model.FunctionModel, model: Model.ClassModel): HighIntermediaryRepresentation.Statements.Block {
    var outer = statements
    statements = List<Statement>()
    var own_type = model.type_of_an_instance()
    stand_in = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var local = function_object(declared, model, false, true)
    var answered = HighIntermediaryRepresentation.Statements.Return(local)
    statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return body
}

func redescribe(index: Integer) {
    var function = context.describers[index]
    var declared = context.described_functions[index]
    crash function
    crash declared
    var model = context.program.class_named(declared.owner)
    crash model
    function.body = describing_body(declared, model)
}

func function_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): Value {
    var function_type = reflection_type("Spite.Function")
    var function_model = context.class_of(function_type)
    var name = text(declared.name)
    var no_more = List<Value>()
    var made = made_from(function_type, name, no_more)
    var local = kept(made, function_type)
    var declaration = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    set_value(local, function_model, "_declaration", declaration)
    if stand_in and has_feature("b") {
        var owner: Value = stand_in
        set_value(local, function_model, "_owner", owner)
    }
    var called = call_value_of(declared, model, function_model, false)
    if called {
        set_value(local, function_model, "_called", called)
    }
    return local
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func declaration_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): Value {
    var declaration_type = reflection_type("Spite.FunctionDeclaration")
    var declaration_model = context.class_of(declaration_type)
    need_the_making(declaration_type)
    var argument_type = reflection_type("Spite.Argument")
    var name = text(declared.name)
    var more = List<Value>()
    var no_hole = text("")
    more.append(no_hole)
    var first = whole(0)
    more.append(first)
    var made = made_from(declaration_type, name, more)
    var local = kept(made, declaration_type)
    var has_facts = belongs_to_the_program(model) and can_be_built(declared)
    add_the_arguments(local, declaration_model, declared, argument_type, has_facts)
    add_the_answer(local, declaration_model, declared)
    add_the_returned_literal(local, declaration_model, declared)
    if has_facts {
        set_flag(local, declaration_model, "_has_facts", true)
    }
    if has_facts and has_feature("w") {
        var waits = fact("waits", declared, "")
        set_value(local, declaration_model, "_is_resumable", waits)
    }
    if has_facts and with_accesses and has_feature("a") {
        add_the_reach(local, declaration_model, declared, model)
        set_flag(local, declaration_model, "_has_reach", true)
    }
    if not stand_in and makes_a_stand_in and has_feature("o") {
        stand_in = made_stand_in(model)
    }
    if stand_in and has_feature("o") {
        var called_on = called_on_value_of(declared, model, declaration_model)
        set_value(local, declaration_model, "_called_on", called_on)
    }
    return local
}

func called_on_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): Value {
    crash stand_in
    var receiver: Value = stand_in
    var called_on_attribute = function_model.attribute_named("_called_on")
    crash called_on_attribute
    var wanted = called_on_attribute.attribute_type.present()
    var parameter_type = wanted.parameters[0]
    crash parameter_type
    var arguments_type = wanted.parameters[1]
    crash arguments_type
    var wrapper = calling_on_wrapper(model, declared, parameter_type, arguments_type)
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func calling_on_wrapper(
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
): Model.FunctionModel {
    var name = "_call_{declared.name}_on"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    var parameter = Model.ParameterModel("instance", instance_type, false)
    made.parameters.append(parameter)
    var arguments_parameter = Model.ParameterModel("arguments", arguments_type, false)
    made.parameters.append(arguments_parameter)
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var passed = first_unpassed_parameter(declared)
    if passed.is_empty() {
        called_on_its_instance(body, model, declared, instance_type, arguments_type)
    } else {
        var message = "spite: call() cannot pass the argument '{passed}' of '{model.shown}.{declared.name}' when the call is known only at run time, since a value of its type is not told apart while the program runs: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var refused = HighIntermediaryRepresentation.Statements.Stop(message)
        body.statements.append(refused)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func first_unpassed_parameter(declared: Model.FunctionModel): String {
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var kind = parameter.parameter_type.kind
        var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
        var is_told_apart = is_held or kind == 'union' or kind == 'shape'
        if not is_told_apart {
            return parameter.name
        }
        index = index + 1
    }
    return ""
}

func called_on_its_instance(
    body: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
) {
    context.need(declared)
    var own_type = model.type_of_an_instance()
    var instance = HighIntermediaryRepresentation.Values.LocalRead(instance_type, "instance")
    var tested = HighIntermediaryRepresentation.Values.Class.Membership(instance, own_type)
    var narrowed = HighIntermediaryRepresentation.Values.Conversion(own_type, 'present', instance)
    var running = HighIntermediaryRepresentation.Statements.Block()
    var passed_arguments = List<Value>()
    var shown = "{model.shown}.{declared.name}"
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var argument = passed_argument(running, parameter, arguments_type, shown)
        passed_arguments.append(argument)
        index = index + 1
    }
    refuse_an_argument_too_many(running, declared, arguments_type, shown)
    var call = HighIntermediaryRepresentation.Values.Call(declared, narrowed, passed_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    running.statements.append(evaluated)
    var message = "spite: call() runs '{declared.name}', declared by '{model.shown}', on an instance of another class: a call runs a declaration on an instance of its own class"
    var refused = HighIntermediaryRepresentation.Statements.Stop(message)
    var refusing = HighIntermediaryRepresentation.Statements.Block()
    refusing.statements.append(refused)
    var branch = HighIntermediaryRepresentation.Statements.If(tested, running, refusing)
    body.statements.append(branch)
}

func passed_argument(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): Value {
    var dictionary = context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    context.need(reading)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<Value>()
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name)
    keys.append(key)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var present = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var missing = HighIntermediaryRepresentation.Values.Negation(present)
    var unfilled = "spite: call() leaves the argument '{parameter.name}' of '{shown}' unfilled: set 'call.arguments[\"{parameter.name}\"]' before 'call()'"
    stop_when(running, missing, unfilled)
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read)
    var written = parameter.parameter_type
    var wanted = written.present()
    if wanted.kind == 'shape' {
        fill_with_the_programs_classes(wanted)
    }
    var fits = class_test_of(held, wanted)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var wanted_shown = context.shown(wanted)
    if wanted.kind == 'union' or wanted.kind == 'shape' {
        var segments = wanted_shown.split(".")
        var last = segments.last()
        crash last
        wanted_shown = last
    }
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var article = typing.article_of(wanted_shown)
    var other = "spite: call() gives '{shown}' an argument '{parameter.name}' that is not {article} {wanted_shown}, the type it takes"
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again)
    var kind = wanted.kind
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if kind == 'scalar' or kind == 'enumeration' {
        conversion = 'unbox'
    }
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, conversion, again_held)
    if written.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed)
    }
    return passed
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func class_test_of(
    held: Value,
    wanted: Model.Type,
): Value {
    if wanted.kind != 'union' {
        return HighIntermediaryRepresentation.Values.Class.Membership(held, wanted)
    }
    var united = values.union_model_of(wanted)
    var boolean = context.boolean()
    var tested: Value? = null
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var member_test = class_test_of(held, member)
        if tested {
            tested = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', tested, member_test)
        } else {
            tested = member_test
        }
        index = index + 1
    }
    crash tested
    return tested
}

func fill_with_the_programs_classes(wanted: Model.Type) {
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var folder = folder_of(entry.file.path)
    read_every_class_in(folder)
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = is_inside(model.file.path, folder) and bound.is_empty() and not model.is_singleton
        var given = model.type_of_an_instance()
        if is_the_programs and model.key != context.program.entry and values.has_the_shape_members(given, wanted) {
            values.filled_shape(given, wanted)
        }
        index = index + 1
    }
}

func refuse_an_argument_too_many(
    running: HighIntermediaryRepresentation.Statements.Block,
    declared: Model.FunctionModel,
    arguments_type: Model.Type,
    shown: String,
) {
    var dictionary = context.class_of(arguments_type)
    var counting = dictionary.function_named("count")
    crash counting
    context.need(counting)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var no_arguments = List<Value>()
    var counted = HighIntermediaryRepresentation.Values.Call(counting, arguments, no_arguments)
    var integer = context.scalar_type("Integer")
    var taken: Long = declared.parameters.count()
    var limit = HighIntermediaryRepresentation.Values.WholeNumber(integer, taken)
    var boolean = context.boolean()
    var too_many = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'greater', counted, limit)
    var names = List<String>()
    var taken = List<String>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        names.append("'{parameter.name}'")
        taken.append(parameter.name)
        index = index + 1
    }
    var listed = names.join(", ")
    if listed.is_empty() {
        listed = "no arguments"
    }
    var found = context.resolver.symbols.find("Spite.Fault", "")
    fallback found
    var fault = context.resolver.class_model_named("Spite.Fault")
    crash fault
    context.need_defaults(fault.key)
    var naming = fault.function_named("argument_not_taken")
    crash naming
    context.need(naming)
    var fault_type = fault.type_of_an_instance()
    var no_fields = List<Value>()
    var made_fault = HighIntermediaryRepresentation.Values.MakeObject(fault_type, null, no_fields)
    var named_arguments = List<Value>()
    var passed = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    named_arguments.append(passed)
    var taken_text = taken.join("\t")
    var taken_constant = HighIntermediaryRepresentation.Values.TextConstant(taken_text)
    named_arguments.append(taken_constant)
    var shown_constant = HighIntermediaryRepresentation.Values.TextConstant(shown)
    named_arguments.append(shown_constant)
    var listed_constant = HighIntermediaryRepresentation.Values.TextConstant(listed)
    named_arguments.append(listed_constant)
    var named = HighIntermediaryRepresentation.Values.Call(naming, made_fault, named_arguments)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(named)
    stopping.statements.append(evaluated)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("")
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(too_many, stopping, null)
    running.statements.append(branch)
}

func stop_when(
    running: HighIntermediaryRepresentation.Statements.Block,
    condition: Value,
    message: String,
) {
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, stopping, null)
    running.statements.append(branch)
}

func fact(
    question: String,
    declared: Model.FunctionModel,
    slot: String,
): HighIntermediaryRepresentation.Values.Function.Fact {
    var functions = List<Model.FunctionModel>()
    functions.append(declared)
    var boolean = context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, question, functions)
    made.slot = slot
    context.facts_asked.append(made)
    context.need(declared)
    return made
}

func call_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
    makes_a_stand_in: Boolean,
): Value? {
    if not stand_in and makes_a_stand_in {
        stand_in = made_stand_in(model)
    }
    fallback stand_in
    var receiver: Value = stand_in
    var called_attribute = function_model.attribute_named("_called")
    crash called_attribute
    var wanted = called_attribute.attribute_type.present()
    var wrapper = declared
    if not declared.parameters.is_empty() {
        wrapper = stopping_wrapper(model, declared)
    } else if declared.answer {
        wrapper = discarding_wrapper(model, declared)
    } else {
        context.need(declared)
    }
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func made_stand_in(model: Model.ClassModel): Value {
    var instance_type = model.type_of_an_instance()
    context.need_defaults(model.key)
    var no_arguments = List<Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(instance_type, null, no_arguments)
    return kept(made, instance_type)
}

func stopping_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_cannot_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var message = "spite: call_function() cannot call '{declared.name}': it takes arguments, and call_function() passes none"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    body.statements.append(stopped)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func discarding_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    context.need(declared)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    var no_arguments = List<Value>()
    var call = HighIntermediaryRepresentation.Values.Call(declared, own, no_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements.append(evaluated)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func add_the_reach(
    function: Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
) {
    var declaration_type = reflection_type("Spite.AttributeDeclaration")
    var declaration_model = context.class_of(declaration_type)
    need_the_making(declaration_type)
    var reads = read_attribute(function, function_model, "_reads")
    var writes = read_attribute(function, function_model, "_writes")
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var attribute_name = text(attribute.name)
        var attribute_index = whole(index)
        var made = made_with(declaration_type, attribute_name, attribute_index)
        var declaration = kept(made, declaration_type)
        var attribute_class = class_object_of_type(attribute.attribute_type)
        if attribute_class {
            set_value(declaration, declaration_model, "_class", attribute_class)
        }
        var slot = "a:{attribute.name}"
        var read_fact = fact("reads", declared, slot)
        appended_when(read_fact, reads, declaration)
        var written_fact = fact("written", declared, slot)
        appended_when(written_fact, writes, declaration)
        index = index + 1
    }
}

func appended_when(condition: Value, listed: Value, item: Value) {
    var outer = statements
    statements = List<Statement>()
    appended(listed, item)
    var then = HighIntermediaryRepresentation.Statements.Block()
    then.statements = statements
    statements = outer
    var checked = HighIntermediaryRepresentation.Statements.If(condition, then, null)
    statements.append(checked)
}

func add_the_arguments(
    function: Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    argument_type: Model.Type,
    has_facts: Boolean,
) {
    var argument_model = context.class_of(argument_type)
    var listed = read_attribute(function, function_model, "_arguments")
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var name = text(parameter.name)
        var index_value = whole(index)
        var made = made_with(argument_type, name, index_value)
        var local = kept(made, argument_type)
        var described = class_object_of_type(parameter.parameter_type)
        if described {
            set_value(local, argument_model, "_class", described)
        }
        if has_facts {
            set_flag(local, argument_model, "_has_facts", true)
        }
        if has_facts and has_feature("m") {
            var mutated = fact("writes", declared, "p:{parameter.name}")
            set_value(local, argument_model, "_is_mutated", mutated)
        }
        appended(listed, local)
        index = index + 1
    }
}

func add_the_answer(
    function: Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
) {
    var described: Value? = class_object("Nothing")
    if declared.answer {
        var answer: Model.Type = declared.answer
        described = class_object_of_type(answer)
    }
    fallback described
    set_value(function, function_model, "_returns", described)
}

func belongs_to_the_program(model: Model.ClassModel): Boolean {
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var folder = folder_of(entry.file.path)
    fallback model.file.path.starts_with(folder)
    var path_length = model.file.path.length()
    var folder_length = folder.length()
    var rest = model.file.path.slice(folder_length, path_length)
    crash rest
    return not rest.contains("..")
}

func fill_of_a_function_list(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var model = context.program.class_named(described)
    crash model
    var made = model.function_named("_function_list")
    crash made
    var function_type = reflection_type("Spite.Function")
    var list_type = context.resolver.text_dictionary_type_of(function_type)
    var made_list = values.made_list(list_type)
    var listed = kept(made_list, list_type)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    add_the_functions(listed, model, own, false, false)
    var answered = HighIntermediaryRepresentation.Statements.Return(listed)
    statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(made, body)
}

func function_list_of(model: Model.ClassModel): Model.FunctionModel {
    var known = model.function_named("_function_list")
    if known {
        return known
    }
    var function_type = reflection_type("Spite.Function")
    var list_type = context.resolver.text_dictionary_type_of(function_type)
    var made = Model.FunctionModel("_function_list", model.key)
    made.is_synthetic = true
    made.answer = list_type
    model.declared_functions.append(made)
    var known_list = "Functions:{model.key}"
    context.reflected.append(known_list)
    context.unfilled.append(known_list)
    return made
}

func add_the_returned_literal(
    function: Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
) {
    fallback declared.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = declared.declaration
    fallback declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    fallback body.statements.count() == 1
    var only = body.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        add_a_literal_return(function, function_model, only)
    }
}

func add_a_literal_return(
    function: Value,
    function_model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    var value = returned.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        add_a_literal(function, function_model, value)
    }
}

func add_a_literal(
    function: Value,
    function_model: Model.ClassModel,
    literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral,
) {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    var written = values.unescaped(piece.text)
    set_text(function, function_model, "_returned_literal", written)
}

func arguments_of(declared: Model.FunctionModel): Value {
    statements = List<Statement>()
    var argument_type = reflection_type("Spite.Argument")
    var argument_model = context.class_of(argument_type)
    need_the_making(argument_type)
    var list_type = context.resolver.list_type_of(argument_type)
    var made_list = values.made_list(list_type)
    var listed = kept_in_scope(made_list, list_type)
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var name = text(parameter.name)
        var index_value = whole(index)
        var made = made_with(argument_type, name, index_value)
        var local = kept_in_scope(made, argument_type)
        var described = class_object_of_type(parameter.parameter_type)
        if described {
            set_value(local, argument_model, "_class", described)
        }
        appended(listed, local)
        index = index + 1
    }
    statements.each(context.pending.append)
    return listed
}

func holds_its_values_itself(model: Model.ClassModel): Boolean {
    var namespace = model.file.namespace
    var scalars = Model.Scalars()
    var is_a_collection = namespace == "List" or namespace == "Dictionary"
    return is_a_collection or namespace == "String" or scalars.is_a_scalar(namespace)
}

func no_attribute_list(): Value {
    var attribute_type = reflection_type("Spite.Attribute")
    need_the_making(attribute_type)
    var dictionary_type = context.resolver.text_dictionary_type_of(attribute_type)
    return values.new_list(dictionary_type)
}

func attributes_of_an_object(
    target: Value,
    model: Model.ClassModel,
): Value {
    statements = List<Statement>()
    var attribute_type = reflection_type("Spite.Attribute")
    var attribute_model = context.class_of(attribute_type)
    need_the_making(attribute_type)
    var declaration_type = reflection_type("Spite.AttributeDeclaration")
    var declaration_model = context.class_of(declaration_type)
    need_the_making(declaration_type)
    var dictionary_type = context.resolver.text_dictionary_type_of(attribute_type)
    var made_dictionary = values.new_list(dictionary_type)
    var listed = kept_in_scope(made_dictionary, dictionary_type)
    var object = kept_in_scope(target, target.value_type)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            var name = text(attribute.name)
            var index_value = whole(index)
            var made = made_with(attribute_type, name, index_value)
            var local = kept_in_scope(made, attribute_type)
            var declaration_name = text(attribute.name)
            var declaration_index = whole(index)
            var made_declaration = made_with(declaration_type, declaration_name, declaration_index)
            var declaration = kept_in_scope(made_declaration, declaration_type)
            var described = class_object_of_type(attribute.attribute_type)
            if described {
                set_value(local, attribute_model, "_class", described)
                set_value(declaration, declaration_model, "_class", described)
            }
            set_value(local, attribute_model, "_declaration", declaration)
            set_value(local, attribute_model, "_owner", object)
            var read = HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
            set_value(local, attribute_model, "_value", read)
            var key = text(attribute.name)
            placed(listed, key, local)
        }
        index = index + 1
    }
    statements.each(context.pending.append)
    return listed
}

func no_attributes(): Model.FunctionModel {
    make_no_attributes()
    var attribute_type = reflection_type("Spite.Attribute")
    var attribute_model = context.class_of(attribute_type)
    var made = attribute_model.function_named("_no_attributes")
    crash made
    return made
}

func make_no_attributes() {
    var attribute_type = reflection_type("Spite.Attribute")
    var attribute_model = context.class_of(attribute_type)
    fallback not attribute_model.function_named("_no_attributes")
    var list_type = context.resolver.text_dictionary_type_of(attribute_type)
    var made = Model.FunctionModel("_no_attributes", attribute_model.key)
    made.is_synthetic = true
    made.answer = list_type
    attribute_model.declared_functions.append(made)
    var empty = values.made_list(list_type)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var answered = HighIntermediaryRepresentation.Statements.Return(empty)
    body.statements.append(answered)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
}

func attribute_list_of(model: Model.ClassModel): Model.FunctionModel {
    make_attribute_list_of(model)
    var made = model.function_named("_attribute_list")
    crash made
    return made
}

func make_attribute_list_of(model: Model.ClassModel) {
    fallback not model.function_named("_attribute_list")
    var attribute_type = reflection_type("Spite.Attribute")
    var list_type = context.resolver.text_dictionary_type_of(attribute_type)
    var made = Model.FunctionModel("_attribute_list", model.key)
    made.is_synthetic = true
    made.answer = list_type
    model.declared_functions.append(made)
    var outer_pending = context.pending
    context.pending = List<Statement>()
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var listed = attributes_of_an_object(own, model)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = context.pending
    var answered = HighIntermediaryRepresentation.Statements.Return(listed)
    body.statements.append(answered)
    context.pending = outer_pending
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
}

func kept_in_scope(
    made: Value,
    made_type: Model.Type,
): Value {
    local_count = local_count + 1
    var name = context.scope.declare("reflected_{local_count}", made_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, made_type, made)
    declared.line = context.line
    statements.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(made_type, name)
}

func without_namespaces(shown: String): String {
    var kept_text = ""
    var word = ""
    var index = 0
    while index < shown.length() {
        var character = shown[index]
        crash character
        var code = shown.byte_at(index)
        var is_a_letter = code >= 97 and code <= 122 or code >= 65 and code <= 90 or code >= 48 and code <= 57 or code == 95
        if is_a_letter {
            word = "{word}{character}"
        } else if character == "." {
            word = ""
        } else {
            kept_text = "{kept_text}{word}{character}"
            word = ""
        }
        index = index + character.length()
    }
    return "{kept_text}{word}"
}

func class_object_of_type(of_type: Model.Type): Value? {
    var is_a_class = of_type.kind == 'object' or of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'union'
    fallback is_a_class
    if of_type.is_nullable {
        return class_object("{of_type.name}?")
    }
    return class_object(of_type.name)
}

func fill_of_a_namespace(described: String): HighIntermediaryRepresentation.HighFunction {
    var outer = statements
    statements = List<Statement>()
    var namespace_type = reflection_type("Spite.Namespace")
    var namespace_model = context.class_of(namespace_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(namespace_type)
    set_text(own, namespace_model, "_name_with_namespaces", described)
    var parent_name = namespace_of(described)
    var parent = namespace_object(parent_name)
    set_value(own, namespace_model, "_parent", parent)
    var folder = context.resolver.symbols.namespace_folder(described)
    if folder {
        add_the_contents(own, namespace_model, folder)
        add_the_source_directories(own, namespace_model, folder)
    }
    var function = Model.FunctionModel("_fill_{described}", namespace_model.key)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    return HighIntermediaryRepresentation.HighFunction(function, body)
}

func add_the_contents(
    own: Value,
    namespace_model: Model.ClassModel,
    folder: Mapping.MappedFolder,
) {
    var classes = read_attribute(own, namespace_model, "_classes")
    var index = 0
    while index < folder.files.count() {
        var file = folder.files[index]
        var model = context.program.class_named(file.namespace)
        if model {
            var described = class_object(model.key)
            appended(classes, described)
        }
        index = index + 1
    }
    var namespaces = read_attribute(own, namespace_model, "_namespaces")
    var folder_index = 0
    while folder_index < folder.folders.count() {
        var inner = folder.folders[folder_index]
        var inner_object = namespace_object(inner.namespace)
        appended(namespaces, inner_object)
        folder_index = folder_index + 1
    }
}

func every_namespace(): Value {
    var argument = Model.Type('object', "Spite.Namespace")
    var list_type = context.resolver.list_type_of(argument)
    var listed = values.new_list(list_type)
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var program_folder = folder_of(entry.file.path)
    var folders = context.resolver.symbols.namespace_folders()
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        var path_length = folder.path.length()
        var folder_length = program_folder.length()
        var rest = folder.path.slice(folder_length, path_length)
        crash rest
        var forward = rest.replace("\\", "/")
        var is_generated = forward.contains("/.spite/")
        var is_the_programs = folder.path.starts_with(program_folder) and not rest.contains("..") and not is_generated
        if is_the_programs {
            var described = namespace_object(folder.namespace)
            values.append_to(listed, described)
        }
        index = index + 1
    }
    return listed
}

func namespace_of(described: String): String {
    var parts = described.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    return parts.join(".")
}

func last_name_of(described: String): String {
    var parts = described.split(".")
    var last = parts.count() - 1
    var name = parts[last]
    crash name
    return name
}

func text(written: String): Value {
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func whole(number: Integer): Value {
    var integer = context.scalar_type("Integer")
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func made_with(
    made_type: Model.Type,
    name: Value,
    index: Value,
): Value {
    var more = List<Value>()
    more.append(index)
    return made_from(made_type, name, more)
}

func made_from(
    made_type: Model.Type,
    name: Value,
    more: List<Value>,
): Value {
    var model = context.class_of(made_type)
    var constructor = values.constructor_of(model)
    crash constructor
    var given = List<Value>()
    given.append(name)
    more.each(given.append)
    var arguments = List<Value>()
    var index = 0
    while index < given.count() {
        var argument = given[index]
        var parameter = constructor.parameters[index]
        crash parameter
        var fitted_argument = values.fitted(argument, parameter.parameter_type)
        arguments.append(fitted_argument)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func kept(
    made: Value,
    made_type: Model.Type,
): Value {
    local_count = local_count + 1
    var name = "reflected_{local_count}"
    if declares_in_scope {
        name = context.scope.declare("reflected", made_type)
    }
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, made_type, made)
    statements.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(made_type, name)
}

func read_attribute(
    own: Value,
    model: Model.ClassModel,
    name: String,
): Value {
    var attribute = model.attribute_named(name)
    crash attribute
    return HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
}

func appended(listed: Value, item: Value) {
    var arguments = List<Value>()
    arguments.append(item)
    var call = values.method_call(listed, "append", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    statements.append(evaluated)
}

func placed(listed: Value, key: Value, item: Value) {
    var arguments = List<Value>()
    arguments.append(key)
    arguments.append(item)
    var call = values.method_call(listed, "set_at", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    statements.append(evaluated)
}

func set_text(
    own: Value,
    model: Model.ClassModel,
    name: String,
    written: String,
) {
    var value = text(written)
    set_value(own, model, name, value)
}

func set_flag(own: Value, model: Model.ClassModel, name: String, flag: Boolean) {
    var boolean = context.boolean()
    var number = 0
    if flag {
        number = 1
    }
    var value = HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
    set_value(own, model, name, value)
}

func set_value(
    own: Value,
    model: Model.ClassModel,
    name: String,
    value: Value,
) {
    var attribute = model.attribute_named(name)
    crash attribute
    var fitted = values.fitted(value, attribute.attribute_type)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, fitted)
    statements.append(assigned)
}

func refuse_a_maybe_enum(described: Value) {
    var described_type = described.value_type
    fallback described_type.is_nullable
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var shown = context.shown(described_type)
    typing.refuse_maybe_null(context, shown)
}

func class_of_value(
    described: Value,
): Value {
    var described_type = described.value_type
    if described_type.is_nullable {
        var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
        var shown = context.shown(described_type)
        typing.refuse_maybe_null(context, shown)
    }
    if described_type.is_a_walked_name {
        return class_object("String")
    }
    var is_one_class = described_type.kind == 'object' or described_type.kind == 'scalar'
    if is_one_class or described_type.kind == 'enumeration' {
        return class_object(described_type.name)
    }
    var candidates = candidates_of(described_type)
    candidates.each(make_a_class_object)
    var class_type = reflection_type("Spite.Class")
    var made = HighIntermediaryRepresentation.Values.Class.OfValue(class_type, described, candidates)
    if described_type.kind == 'shape' {
        context.shape_classes.append(made)
    }
    return made
}

func add_the_late_fillers(asked: HighIntermediaryRepresentation.Values.Class.OfValue) {
    crash asked.described
    var now = candidates_of(asked.described.value_type)
    var index = 0
    while index < now.count() {
        var candidate = now[index]
        if not asked.candidates.contains(candidate) {
            asked.candidates.append(candidate)
            make_a_class_object(candidate)
        }
        index = index + 1
    }
}

func candidates_of(described_type: Model.Type): List<String> {
    var found = List<String>()
    if described_type.kind == 'shape' {
        var fillers = context.program.fillers_of(described_type.name)
        var index = 0
        while index < fillers.count() {
            var filler = fillers[index]
            found.append(filler.name)
            index = index + 1
        }
        return found
    }
    var made = values.union_model_of(described_type)
    var member_index = 0
    while member_index < made.members.count() {
        var member = made.members[member_index]
        found.append(member.name)
        member_index = member_index + 1
    }
    return found
}

func every_class(): Value {
    var argument = Model.Type('object', "Spite.Class")
    var list_type = context.resolver.list_type_of(argument)
    var listed = values.new_list(list_type)
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var folder = folder_of(entry.file.path)
    read_every_class_in(folder)
    var keys = List<String>()
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = is_inside(model.file.path, folder) and bound.is_empty()
        if is_the_programs {
            insert_in_order(keys, model.key)
        }
        index = index + 1
    }
    var key_index = 0
    while key_index < keys.count() {
        var key = keys[key_index]
        var described = class_object(key)
        values.append_to(listed, described)
        key_index = key_index + 1
    }
    return listed
}

func made_anew(): Model.FunctionModel {
    var class_type = reflection_type("Spite.Class")
    var class_model = context.class_of(class_type)
    var known = class_model.function_named("_made_anew")
    if known {
        return known
    }
    var anything = context.resolver.type_of_a_name("Anything")
    var made = Model.FunctionModel("_made_anew", class_model.key)
    made.is_synthetic = true
    made.answer = anything
    class_model.declared_functions.append(made)
    var body = making_body(class_type, anything)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    context.made_anew = function
    return made
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func remake_the_making() {
    fallback context.made_anew
    var described = described_class_count()
    fallback described != context.made_anew_classes
    var class_type = reflection_type("Spite.Class")
    var anything = context.resolver.type_of_a_name("Anything")
    context.made_anew.body = making_body(class_type, anything)
}

func described_class_count(): Integer {
    var count = 0
    var index = 0
    while index < context.reflected.count() {
        var known = context.reflected[index]
        if known.starts_with("Spite.Class:") {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func making_body(class_type: Model.Type, anything: Model.Type): HighIntermediaryRepresentation.Statements.Block {
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var folder = folder_of(entry.file.path)
    read_every_class_in(folder)
    var keys = List<String>()
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var bound = model.bound_types.keys()
        if is_inside(model.file.path, folder) and bound.is_empty() {
            insert_in_order(keys, model.key)
        }
        index = index + 1
    }
    var plain_names = ["Boolean", "Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong", "Float", "Double", "String"]
    var others = List<String>()
    var reflected_index = 0
    while reflected_index < context.reflected.count() {
        var reflected = context.reflected[reflected_index]
        var other = described_library_class(reflected, keys, plain_names)
        if other {
            insert_in_order(others, other)
        }
        reflected_index = reflected_index + 1
    }
    context.made_anew_classes = described_class_count()
    var body = HighIntermediaryRepresentation.Statements.Block()
    var own = HighIntermediaryRepresentation.Values.ThisRead(class_type)
    var key_index = 0
    while key_index < keys.count() {
        var key = keys[key_index]
        var branch = making_branch(own, key, anything)
        body.statements.append(branch)
        key_index = key_index + 1
    }
    var other_index = 0
    while other_index < others.count() {
        var other_key = others[other_index]
        var other_branch = making_branch(own, other_key, anything)
        body.statements.append(other_branch)
        other_index = other_index + 1
    }
    var plain_index = 0
    while plain_index < plain_names.count() {
        var plain_name = plain_names[plain_index]
        var plain_model = context.program.class_named(plain_name)
        if plain_model {
            var plain_branch = plain_making_branch(own, plain_model, anything)
            body.statements.append(plain_branch)
        }
        plain_index = plain_index + 1
    }
    var message = "spite: a class known only at run time makes an object only of a class that is not a singleton, a generic class, an enum or a union"
    var refused = HighIntermediaryRepresentation.Statements.Stop(message)
    body.statements.append(refused)
    return body
}

func described_library_class(reflected: String, keys: List<String>, plain_names: List<String>): String? {
    var prefix = "Spite.Class:"
    fallback reflected.starts_with(prefix)
    var prefix_length = prefix.length()
    var reflected_length = reflected.length()
    var key = reflected.slice(prefix_length, reflected_length)
    crash key
    fallback not keys.contains(key) and not plain_names.contains(key)
    var model = context.program.class_named(key)
    fallback model
    var bound = model.bound_types.keys()
    var is_a_template = context.resolver.is_a_template(model.file)
    fallback not model.is_singleton and bound.is_empty() and not is_a_template
    return key
}

func making_branch(
    own: Value,
    key: String,
    anything: Model.Type,
): Statement {
    var described = class_object(key)
    var compared = List<Value>()
    compared.append(described)
    var is_this_class = values.method_call(own, "equals", compared)
    var model = context.program.class_named(key)
    crash model
    var making = HighIntermediaryRepresentation.Statements.Block()
    var constructor = values.constructor_of(model)
    var takes_nothing = true
    if constructor {
        takes_nothing = constructor.parameters.is_empty()
    }
    if key == context.program.entry {
        var entered = HighIntermediaryRepresentation.Statements.Stop(
            "spite: '{model.shown}' is the program's entry class, made once when the program starts, so a class known only at run time cannot make another",
        )
        making.statements.append(entered)
    } else if not takes_nothing {
        var refused = HighIntermediaryRepresentation.Statements.Stop(
            "spite: '{model.shown}' takes arguments to be made, so a class known only at run time cannot make one: call the class by its name with its arguments",
        )
        making.statements.append(refused)
    } else {
        var answered = made_of_a_class(model, constructor, anything)
        making.statements.append(answered)
    }
    return HighIntermediaryRepresentation.Statements.If(is_this_class, making, null)
}

func plain_making_branch(
    own: Value,
    model: Model.ClassModel,
    anything: Model.Type,
): Statement {
    var described = class_object(model.key)
    var compared = List<Value>()
    compared.append(described)
    var is_this_class = values.method_call(own, "equals", compared)
    var plain_type = Model.Type('scalar', model.key)
    if model.key == "String" {
        plain_type = Model.Type('object', "String")
    }
    var made = values.default_of_a_type(plain_type)
    crash made
    var fitted = values.fitted(made, anything)
    var answered = HighIntermediaryRepresentation.Statements.Return(fitted)
    var making = HighIntermediaryRepresentation.Statements.Block()
    making.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_this_class, making, null)
}

func made_of_a_class(
    model: Model.ClassModel,
    constructor: Model.FunctionModel?,
    anything: Model.Type,
): Statement {
    context.need_defaults(model.key)
    if constructor {
        context.need(constructor)
    }
    var instance_type = model.type_of_an_instance()
    var no_arguments = List<Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(instance_type, constructor, no_arguments)
    var fitted = values.fitted(made, anything)
    return HighIntermediaryRepresentation.Statements.Return(fitted)
}

func is_inside(path: String, folder: String): Boolean {
    fallback path.starts_with(folder)
    var path_length = path.length()
    var folder_length = folder.length()
    var rest = path.slice(folder_length, path_length)
    crash rest
    var forward = rest.replace("\\", "/")
    return not rest.contains("..") and not forward.contains("/.spite/")
}

func read_every_class_in(folder: String) {
    var mapped = context.resolver.symbols.map.every_class()
    var index = 0
    while index < mapped.count() {
        var class_file = mapped[index]
        if is_inside(class_file.path, folder) {
            context.resolver.read_class_named(class_file.namespace)
        }
        index = index + 1
    }
}

func insert_in_order(keys: List<String>, key: String) {
    var place = 0
    while place < keys.count() and keys[place] < key {
        place = place + 1
    }
    keys.insert(place, key)
}

func folder_of(path: String): String {
    var forward = path.replace("\\", "/")
    var parts = forward.split("/")
    var last = parts.count() - 1
    parts.remove_at(last)
    return parts.join("/")
}

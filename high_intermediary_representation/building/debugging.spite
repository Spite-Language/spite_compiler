var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var statements = List<HighIntermediaryRepresentation.Statements.Statement>()

func Debugging(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func to_debug_of(model: Model.ClassModel): Model.FunctionModel {
    var made = Model.FunctionModel("to_debug", model.key)
    made.is_synthetic = true
    var text_type = context.text()
    made.answer = text_type
    model.declared_functions.append(made)
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    values.need_text_constants()
    var shown = List<Model.AttributeModel>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            shown.append(attribute)
        }
        index = index + 1
    }
    var simple = last_name_of(model.shown)
    if shown.is_empty() {
        var empty = text("{simple} \{}")
        var answered = HighIntermediaryRepresentation.Statements.Return(empty)
        statements.append(answered)
    } else {
        var opening = text("{simple} \{ ")
        var declared = HighIntermediaryRepresentation.Statements.Declare("debugged", text_type, opening)
        statements.append(declared)
        var shown_index = 0
        while shown_index < shown.count() {
            var attribute = shown[shown_index]
            var separator = "{attribute.name}: "
            if shown_index > 0 {
                separator = ", {attribute.name}: "
            }
            append_text(separator)
            append_an_attribute(model, attribute)
            shown_index = shown_index + 1
        }
        append_text(" }")
        var local = HighIntermediaryRepresentation.Values.LocalRead(text_type, "debugged")
        var finished = HighIntermediaryRepresentation.Statements.Return(local)
        statements.append(finished)
    }
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func last_name_of(shown: String): String {
    var parts = shown.split(".")
    var last = parts.count() - 1
    var name = parts[last]
    crash name
    return name
}

func text(written: String): HighIntermediaryRepresentation.Values.Value {
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func append_text(written: String) {
    var piece = text(written)
    append_value(piece)
}

func append_value(piece: HighIntermediaryRepresentation.Values.Value) {
    var text_type = context.text()
    var local = HighIntermediaryRepresentation.Values.LocalRead(text_type, "debugged")
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(piece)
    var joined = values.method_call(local, "sum", arguments)
    var assigned = HighIntermediaryRepresentation.Statements.Assign("debugged", joined)
    statements.append(assigned)
}

func append_an_attribute(model: Model.ClassModel, attribute: Model.AttributeModel) {
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var attribute_type = attribute.attribute_type
    if not attribute_type.is_nullable {
        var shown = debug_text_of(read)
        append_value(shown)
        return
    }
    var tested = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    var present_type = attribute_type.present()
    var present = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', read)
    var shown_present = debug_text_of(present)
    append_value(shown_present)
    var then_branch = HighIntermediaryRepresentation.Statements.Block()
    then_branch.statements = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    append_text("null")
    var else_branch = HighIntermediaryRepresentation.Statements.Block()
    else_branch.statements = statements
    statements = outer
    var branch = HighIntermediaryRepresentation.Statements.If(tested, then_branch, else_branch)
    statements.append(branch)
}

func debug_text_of(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    var value_type = value.value_type
    if value_type.kind == 'enumeration' {
        var name = values.enum_text(value)
        var quote = text("'")
        var arguments = List<HighIntermediaryRepresentation.Values.Value>()
        arguments.append(name)
        var opened = values.method_call(quote, "sum", arguments)
        var closing = List<HighIntermediaryRepresentation.Values.Value>()
        var closing_quote = text("'")
        closing.append(closing_quote)
        return values.method_call(opened, "sum", closing)
    }
    var is_debugged = value_type.kind == 'object' or value_type.kind == 'scalar'
    if not is_debugged {
        var reflection = Reflection(context, values)
        var described = reflection.class_of_value(value)
        var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
        return values.method_call(described, "to_string", no_arguments)
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return values.method_call(value, "to_debug", no_arguments)
}

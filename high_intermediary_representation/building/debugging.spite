var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var statements = List<HighIntermediaryRepresentation.Statements.Statement>()

func Debugging(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func to_debug_of(model: Model.ClassModel): Model.FunctionModel {
    var made = Model.FunctionModel("to_debug", model.key)
    made.is_synthetic = true
    var text_type = context.text()
    made.answer = text_type
    model.declared_functions.append(made)
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    values.need_text_constants()
    var shown = List<Model.AttributeModel>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            shown.append(attribute)
        }
        index = index + 1
    }
    var simple = last_name_of(model.shown)
    var own_type = model.type_of_an_instance()
    var cycles = cycle_guard()
    if cycles and own_type.kind == 'object' {
        guard_against_cycles(own_type, simple)
    }
    if shown.is_empty() {
        var empty = text("{simple} \{}")
        var answered = HighIntermediaryRepresentation.Statements.Return(empty)
        statements.append(answered)
    } else {
        var opening = text("{simple} \{ ")
        var declared = HighIntermediaryRepresentation.Statements.Declare("debugged", text_type, opening)
        statements.append(declared)
        var shown_index = 0
        while shown_index < shown.count() {
            var attribute = shown[shown_index]
            var separator = "{attribute.name}: "
            if shown_index > 0 {
                separator = ", {attribute.name}: "
            }
            append_text(separator)
            append_an_attribute(model, attribute)
            shown_index = shown_index + 1
        }
        append_text(" }")
        if cycles and own_type.kind == 'object' {
            leave_the_guard()
        }
        var local = HighIntermediaryRepresentation.Values.LocalRead(text_type, "debugged")
        var finished = HighIntermediaryRepresentation.Statements.Return(local)
        statements.append(finished)
    }
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func work_to_debug(work_model: Model.ClassModel) {
    var made = work_model.function_named("to_debug")
    crash made
    var asking = work_model.function_named("get_finished")
    crash asking
    var settling = work_model.function_named("_settled")
    crash settling
    crash settling.answer
    var result_type: Model.Type = settling.answer
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    values.need_text_constants()
    var text_type = context.text()
    var own_type = work_model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    var finished = HighIntermediaryRepresentation.Values.Call(asking, own, no_arguments)
    var running = HighIntermediaryRepresentation.Values.Negation(finished)
    var still_running = HighIntermediaryRepresentation.Statements.Block()
    var running_text = text("running")
    var answered_running = HighIntermediaryRepresentation.Statements.Return(running_text)
    still_running.statements.append(answered_running)
    var branch = HighIntermediaryRepresentation.Statements.If(running, still_running, null)
    statements.append(branch)
    var settled_own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var settled = HighIntermediaryRepresentation.Values.Call(settling, settled_own, no_arguments)
    var kept = HighIntermediaryRepresentation.Statements.Declare("settled", result_type, settled)
    statements.append(kept)
    var empty = text("")
    var declared = HighIntermediaryRepresentation.Statements.Declare("debugged", text_type, empty)
    statements.append(declared)
    var read = HighIntermediaryRepresentation.Values.LocalRead(result_type, "settled")
    append_debugged(read)
    var local = HighIntermediaryRepresentation.Values.LocalRead(text_type, "debugged")
    var answered = HighIntermediaryRepresentation.Statements.Return(local)
    statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = statements
    statements = outer
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
}

func cycle_guard(): Model.ClassModel? {
    var key = "Spite.Debugging"
    var known = context.program.class_named(key)
    if known {
        return known
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var made = Model.ClassModel(key, key, no_file)
    var entering = Model.FunctionModel("enters", key)
    entering.is_written_by_the_compiler = true
    var boolean = context.boolean()
    entering.answer = boolean
    var long_type = context.scalar_type("Long")
    var address = Model.ParameterModel("address", long_type, false)
    entering.parameters.append(address)
    made.declared_functions.append(entering)
    var leaving = Model.FunctionModel("leaves", key)
    leaving.is_written_by_the_compiler = true
    made.declared_functions.append(leaving)
    context.program.add(made)
    return made
}

func guard_object(guard: Model.ClassModel): HighIntermediaryRepresentation.Values.Value {
    var guard_type = guard.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.NullConstant(guard_type)
}

func guard_against_cycles(own_type: Model.Type, simple: String) {
    var guard = cycle_guard()
    crash guard
    var entering = guard.function_named("enters")
    crash entering
    var fetched = guard_object(guard)
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var long_type = context.scalar_type("Long")
    var address = HighIntermediaryRepresentation.Values.Conversion(long_type, 'address', own)
    var passed = List<HighIntermediaryRepresentation.Values.Value>()
    passed.append(address)
    var entered = HighIntermediaryRepresentation.Values.Call(entering, fetched, passed)
    var again = HighIntermediaryRepresentation.Values.Negation(entered)
    var cut = HighIntermediaryRepresentation.Statements.Block()
    var short = text("{simple} \{...}")
    var answered = HighIntermediaryRepresentation.Statements.Return(short)
    cut.statements.append(answered)
    var branch = HighIntermediaryRepresentation.Statements.If(again, cut, null)
    statements.append(branch)
}

func leave_the_guard() {
    var guard = cycle_guard()
    crash guard
    var leaving = guard.function_named("leaves")
    crash leaving
    var fetched = guard_object(guard)
    var none_passed = List<HighIntermediaryRepresentation.Values.Value>()
    var left = HighIntermediaryRepresentation.Values.Call(leaving, fetched, none_passed)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(left)
    statements.append(evaluated)
}

func last_name_of(shown: String): String {
    var parts = shown.split(".")
    var last = parts.count() - 1
    var name = parts[last]
    crash name
    return name
}

func text(written: String): HighIntermediaryRepresentation.Values.Value {
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = context.text()
    return made
}

func append_text(written: String) {
    var piece = text(written)
    append_value(piece)
}

func append_value(piece: HighIntermediaryRepresentation.Values.Value) {
    var text_type = context.text()
    var local = HighIntermediaryRepresentation.Values.LocalRead(text_type, "debugged")
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(piece)
    var joined = values.method_call(local, "sum", arguments)
    var assigned = HighIntermediaryRepresentation.Statements.Assign("debugged", joined)
    statements.append(assigned)
}

func append_an_attribute(model: Model.ClassModel, attribute: Model.AttributeModel) {
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    append_debugged(read)
}

func append_debugged(read: HighIntermediaryRepresentation.Values.Value) {
    var attribute_type = read.value_type
    if attribute_type.kind == 'handle' and not attribute_type.is_nullable {
        var running = values.work_call(read, "to_debug")
        append_value(running)
        return
    }
    if not attribute_type.is_nullable {
        var shown = debug_text_of(read)
        append_value(shown)
        return
    }
    var tested = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var outer = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    var present_type = attribute_type.present()
    var present = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', read)
    append_debugged(present)
    var then_branch = HighIntermediaryRepresentation.Statements.Block()
    then_branch.statements = statements
    statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    append_text("null")
    var else_branch = HighIntermediaryRepresentation.Statements.Block()
    else_branch.statements = statements
    statements = outer
    var branch = HighIntermediaryRepresentation.Statements.If(tested, then_branch, else_branch)
    statements.append(branch)
}

func debug_text_of(value: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    var value_type = value.value_type
    var is_a_symbol = value_type.is_symbol and not value_type.is_nullable
    if value_type.kind == 'enumeration' or is_a_symbol {
        var name = value
        if value_type.kind == 'enumeration' {
            name = values.enum_text(value)
        }
        var quote = text("'")
        var arguments = List<HighIntermediaryRepresentation.Values.Value>()
        arguments.append(name)
        var opened = values.method_call(quote, "sum", arguments)
        var closing = List<HighIntermediaryRepresentation.Values.Value>()
        var closing_quote = text("'")
        closing.append(closing_quote)
        return values.method_call(opened, "sum", closing)
    }
    if value_type.kind == 'function' {
        return text("Function \{}")
    }
    var is_debugged = value_type.kind == 'object' or value_type.kind == 'scalar'
    if not is_debugged {
        var reflection = Reflection(context, values)
        var described = reflection.class_of_value(value)
        var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
        return values.method_call(described, "to_string", no_arguments)
    }
    var no_arguments = List<HighIntermediaryRepresentation.Values.Value>()
    return values.method_call(value, "to_debug", no_arguments)
}

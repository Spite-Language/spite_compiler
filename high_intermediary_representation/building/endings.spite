func check(context: Context, body: HighIntermediaryRepresentation.Statements.Block, end_line: Integer) {
    fallback context.current_function.answer
    var answer: Model.Type = context.current_function.answer
    fallback not always_leaves(body)
    var shown = context.shown(answer)
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var article = typing.article_of(shown)
    var got = "{article} {shown}"
    if answer.is_nullable {
        got = "a null"
    }
    var steps = List<String>()
    note_the_path(body, steps)
    var name = context.current_function.name
    var text = "'{name}' answers {article} {shown}, but it reaches its end without a 'return', so a caller would get {got} nobody wrote: end it with 'return <value>', or with 'crash' if it cannot get there"
    if not steps.is_empty() {
        var path = steps.join(", then ")
        text = "'{name}' answers {article} {shown}, but {path} it reaches its end without a 'return', so a caller would get {got} nobody wrote: end that path with 'return <value>', or with 'crash' if it cannot happen"
    }
    if end_line > 0 {
        context.line = end_line
    }
    typing.stop(context, text)
}

func note_the_path(block: HighIntermediaryRepresentation.Statements.Block, steps: List<String>) {
    if block.case_written != "" {
        steps.append("in the case {block.case_written} of the 'switch' at line {block.switch_line}")
    }
    var last = block.statements.last()
    fallback last
    switch last {
        HighIntermediaryRepresentation.Statements.If: note_the_branch(last, steps)
        HighIntermediaryRepresentation.Statements.While: steps.append("when the 'while' at line {last.line} ends")
        HighIntermediaryRepresentation.Statements.Block: note_the_path(last, steps)
        _: return
    }
}

func note_the_branch(branch: HighIntermediaryRepresentation.Statements.If, steps: List<String>) {
    var then_leaves = always_leaves(branch.then_branch)
    var written = branch.written_condition
    if not branch.else_branch {
        note_a_branch_without_else(branch, steps)
        return
    }
    var else_branch: HighIntermediaryRepresentation.Statements.Block = branch.else_branch
    if not then_leaves {
        note_a_step(written, "true", branch.line, steps)
        note_the_path(branch.then_branch, steps)
        return
    }
    note_a_step(written, "false", branch.line, steps)
    note_the_path(else_branch, steps)
}

func note_a_branch_without_else(branch: HighIntermediaryRepresentation.Statements.If, steps: List<String>) {
    var written = branch.written_condition
    if written != "" {
        steps.append("when '{written}' is false (line {branch.line}, an 'if' with no 'else')")
        return
    }
    var then_leaves = always_leaves(branch.then_branch)
    if not then_leaves {
        note_the_path(branch.then_branch, steps)
    }
}

func note_a_step(written: String, answer: String, line: Integer, steps: List<String>) {
    if written != "" {
        steps.append("when '{written}' is {answer} (line {line})")
    }
}

func always_leaves(block: HighIntermediaryRepresentation.Statements.Block?): Boolean {
    fallback block
    var last = block.statements.last()
    fallback last
    switch last {
        HighIntermediaryRepresentation.Statements.Return: return true
        HighIntermediaryRepresentation.Statements.Stop: return true
        HighIntermediaryRepresentation.Statements.If: return both_branches_leave(last)
        HighIntermediaryRepresentation.Statements.While: return loops_for_ever(last)
        HighIntermediaryRepresentation.Statements.Block: return always_leaves(last)
        _: return false
    }
}

func both_branches_leave(branch: HighIntermediaryRepresentation.Statements.If): Boolean {
    var then_leaves = always_leaves(branch.then_branch)
    return then_leaves and always_leaves(branch.else_branch)
}

func loops_for_ever(loop: HighIntermediaryRepresentation.Statements.While): Boolean {
    var condition = loop.condition
    if condition.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return condition.number == 1
    }
    return false
}

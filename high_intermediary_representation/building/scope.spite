var names = List<Dictionary<String, String>>()
var types = Dictionary<String, Model.Type>()
var narrowed = List<Dictionary<String, Model.Type>>()
var checks = List<Dictionary<String, String>>()
var used_names = List<String>()
var copied_sources = Dictionary<String, String>()
var copied_names = Dictionary<String, String>()
var copied_lines = Dictionary<String, Integer>()

func enter() {
    var own_names = Dictionary<String, String>()
    names.append(own_names)
    var own_narrowed = Dictionary<String, Model.Type>()
    narrowed.append(own_narrowed)
    var own_checks = Dictionary<String, String>()
    checks.append(own_checks)
}

func leave() {
    names.remove_last()
    narrowed.remove_last()
    checks.remove_last()
}

func clear() {
    names = List<Dictionary<String, String>>()
    types = Dictionary<String, Model.Type>()
    narrowed = List<Dictionary<String, Model.Type>>()
    checks = List<Dictionary<String, String>>()
    used_names = List<String>()
    copied_sources = Dictionary<String, String>()
    copied_names = Dictionary<String, String>()
    copied_lines = Dictionary<String, Integer>()
    enter()
}

func declare(name: String, declared_type: Model.Type): String {
    var internal_name = name
    var count = 1
    while used_names.contains(internal_name) {
        count = count + 1
        internal_name = "{name}_{count}"
    }
    used_names.append(internal_name)
    types[internal_name] = declared_type
    var innermost = names.last()
    crash innermost
    innermost[name] = internal_name
    return internal_name
}

func internal_name_of(name: String): String? {
    var index = names.count() - 1
    while index >= 0 {
        var frame = names[index]
        crash frame
        var found = frame[name]
        if found {
            return found
        }
        index = index - 1
    }
    return null
}

func type_of(internal_name: String): Model.Type? {
    var narrowed_type = narrowed_type_of(internal_name)
    if narrowed_type {
        return narrowed_type
    }
    return types[internal_name]
}

func narrow(path: String, narrowed_type: Model.Type) {
    var innermost = narrowed.last()
    crash innermost
    innermost[path] = narrowed_type
    var innermost_checks = checks.last()
    crash innermost_checks
    innermost_checks.remove(path)
}

func note_the_check(path: String, check: String) {
    var innermost = checks.last()
    crash innermost
    innermost[path] = check
}

func check_of(path: String): String? {
    var index = narrowed.count() - 1
    while index >= 0 {
        var frame = narrowed[index]
        crash frame
        if frame[path] {
            var own_checks = checks[index]
            crash own_checks
            return own_checks[path]
        }
        index = index - 1
    }
    return null
}

func note_a_copy(internal_name: String, written_name: String, source: String, line: Integer) {
    copied_sources[internal_name] = source
    copied_names[internal_name] = written_name
    copied_lines[internal_name] = line
}

func forget(path: String) {
    var index = 0
    while index < narrowed.count() {
        var frame = narrowed[index]
        frame.remove(path)
        index = index + 1
    }
}

func keep_present(path: String, name: String, present: Model.Type) {
    var kept = List<Integer>()
    var index = 0
    while index < narrowed.count() {
        var frame = narrowed[index]
        var found = frame[path]
        if found {
            if found.is_the_same_as(present) {
                kept.append(index)
            }
        }
        index = index + 1
    }
    forget(path)
    forget_mentions(name)
    var kept_index = 0
    while kept_index < kept.count() {
        var frame_index = kept[kept_index]
        var frame = narrowed[frame_index]
        crash frame
        frame[path] = present
        kept_index = kept_index + 1
    }
    narrow(path, present)
}

func forget_mentions(name: String) {
    var index = 0
    while index < narrowed.count() {
        var frame = narrowed[index]
        var paths = frame.keys()
        var path_index = 0
        while path_index < paths.count() {
            var path = paths[path_index]
            if mentions(path, name) {
                frame.remove(path)
            }
            path_index = path_index + 1
        }
        index = index + 1
    }
}

func mentions(path: String, name: String): Boolean {
    var word = ""
    var index = 0
    while index < path.length() {
        var code = path.code_at(index)
        var is_a_letter = code >= 97 and code <= 122 or code >= 65 and code <= 90 or code >= 48 and code <= 57 or code == 95
        if is_a_letter {
            var letter = path.character_at(index)
            word = "{word}{letter}"
        } else {
            if word == name {
                return true
            }
            word = ""
        }
        index = index + 1
    }
    return word == name
}

func narrowed_type_of(path: String): Model.Type? {
    var index = narrowed.count() - 1
    while index >= 0 {
        var frame = narrowed[index]
        crash frame
        var found = frame[path]
        if found {
            return found
        }
        index = index - 1
    }
    return null
}

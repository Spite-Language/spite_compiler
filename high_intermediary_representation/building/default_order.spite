var waiting_owners = List<Model.ClassModel>()
var waiting_groups = List<List<HighIntermediaryRepresentation.Statements.Block>>()
var built = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var owner_key = ""
var found = List<String>()
var written = List<String>()
var followed = List<String>()
var is_following = false

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func note(owner: Model.ClassModel, built_groups: List<HighIntermediaryRepresentation.Statements.Block>) {
    waiting_owners.append(owner)
    waiting_groups.append(built_groups)
}

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func judge(program: HighIntermediaryRepresentation.HighProgram, context: Context, may_fix: Boolean) {
    fallback not waiting_owners.is_empty()
    built = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
    program.built_functions.each(note_a_built_function)
    var table = context.resolver.state.symbols
    var index = 0
    while index < waiting_owners.count() {
        var owner = waiting_owners[index]
        var groups = waiting_groups[index]
        crash owner and groups
        judge_a_class(table, owner, groups, may_fix)
        index = index + 1
    }
    waiting_owners = List<Model.ClassModel>()
    waiting_groups = List<List<HighIntermediaryRepresentation.Statements.Block>>()
    built = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
}

func note_a_built_function(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    built[key] = function
}

func judge_a_class(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    groups: List<HighIntermediaryRepresentation.Statements.Block>,
    may_fix: Boolean,
) {
    owner_key = owner.key
    var names = List<String>()
    var reads = List<List<String>>()
    var writes = List<List<String>>()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        names.append(attribute.name)
        var group = groups[index]
        crash group
        var group_reads = reads_of_a_group(group)
        reads.append(group_reads)
        writes.append(written)
        index = index + 1
    }
    var rule = Validators.HighIntermediaryRepresentation.DefaultOrder.Validator()
    var checked = 0
    while checked < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[checked]
        var rule_answer = rule.check(owner, attribute, names, reads, writes)
        rule_answer.tell()
        checked = checked + 1
    }
    fallback reads_ahead(names, reads)
    if not may_fix {
        var rule_answer = rule.check_no_read_below(owner, names, reads, writes)
        rule_answer.tell()
        return
    }
    var moves = DefaultMoves()
    moves.work_out(table, owner, names, reads, writes)
    var answer = rule.check_the_moves(owner, moves)
    answer.tell()
    var fixing = Fixes.AfterBuilding.EveryFix()
    fixing.fixed_the_default_order(table, owner, moves)
}

func reads_ahead(names: List<String>, reads: List<List<String>>): Boolean {
    var index = 0
    while index < reads.count() {
        var group_reads = reads[index]
        var later = 0
        while later < group_reads.count() {
            var name = group_reads[later]
            var position = names.index_of(name)
            if position and position > index {
                return true
            }
            later = later + 1
        }
        index = index + 1
    }
    return false
}

func reads_of_a_group(group: HighIntermediaryRepresentation.Statements.Block): List<String> {
    found = List<String>()
    written = List<String>()
    followed = List<String>()
    is_following = false
    read_a_block(group)
    return found
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_a_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: read_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: read(statement.value)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
    }
}

func read_a_write(assigned: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    crash assigned.object
    var is_on_this = assigned.object.class == HighIntermediaryRepresentation.Values.ThisRead
    if not is_on_this {
        read(assigned.object)
    }
    read(assigned.value)
    fallback is_on_this and is_following
    var name = assigned.attribute.name
    fallback not found.contains(name)
    found.append(name)
    written.append(name)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    read(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    read(loop.condition)
    read_a_block(loop.body)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(read_present)
    read(stop.then)
}

func read_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    read(first)
    read(second)
}

func read_present(value: SpiteCompiler.Value) {
    read(value)
}

func read(value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: read_an_attribute(value)
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        HighIntermediaryRepresentation.Values.ShapeCall: read_arguments(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.Function.ValueCall: read_arguments(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.ForeignCall: read_arguments(value.library, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: read_arguments(null, value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: read(value.converted)
        HighIntermediaryRepresentation.Values.Class.OfValue: read(value.described)
        HighIntermediaryRepresentation.Values.Class.Membership: read(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: read(value.text)
        HighIntermediaryRepresentation.Values.EnumText: read(value.number)
        HighIntermediaryRepresentation.Values.Function.Value: read_a_function_value(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.Negation: read(value.negated)
        HighIntermediaryRepresentation.Values.PresenceTest: read(value.tested)
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func read_an_attribute(read_value: HighIntermediaryRepresentation.Values.AttributeRead) {
    var object = read_value.object
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        var name = read_value.attribute.name
        if not found.contains(name) {
            found.append(name)
        }
        var written_at = written.index_of(name)
        if written_at {
            written.remove_at(written_at)
        }
        return
    }
    read(object)
}

func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    read_arguments(call.receiver, call.arguments)
    fallback call.receiver
    fallback call.receiver.class == HighIntermediaryRepresentation.Values.ThisRead
    follow(call.function)
}

func read_a_function_value(value: HighIntermediaryRepresentation.Values.Function.Value) {
    fallback value.receiver
    if value.receiver.class == HighIntermediaryRepresentation.Values.ThisRead {
        follow(value.function)
        return
    }
    read(value.receiver)
}

func read_arguments(receiver: SpiteCompiler.Value?, arguments: List<SpiteCompiler.Value>) {
    read(receiver)
    arguments.each(read_present)
}

func follow(function: Model.FunctionModel) {
    fallback function.owner == owner_key
    var key = function.key()
    fallback not followed.contains(key)
    followed.append(key)
    var called = built[key]
    fallback called
    var was_following = is_following
    is_following = true
    read_a_block(called.body)
    is_following = was_following
}

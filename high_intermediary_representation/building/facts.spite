var program = Model.ProgramModel()
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var excluded = List<String>()
var studied = List<String>()
var pending = List<String>()
var studied_callees = Dictionary<String, List<String>>()
var waits_callees = Dictionary<String, List<String>>()
var same_class_callees = Dictionary<String, List<String>>()
var waiting_keys = List<String>()
var written = List<String>()
var returned = List<String>()
var read = List<String>()
var changed = false
var starting = false
var current_key = ""
var current_owner = ""
var current_parameters = List<String>()
var current_path = ""
var current_line = 0
var write_paths = Dictionary<String, String>()
var write_lines = Dictionary<String, Integer>()
var aliases = Aliases()
var held_work = HighIntermediaryRepresentation.HeldWork(program)
var studied_everything = false
var held_locals = List<String>()
var moved_locals = List<String>()
var singleton_writes = Dictionary<String, List<String>>()
var blocking = ["Socket.accept_handle", "Socket.receive_into", "Socket.first_readable", "Console.read_line"]
var file_reads = ["File.read", "File.read_bytes", "File.read_bytes_at"]
var file_writes = ["File.write", "File.append", "File.write_bytes", "File.append_bytes"]

func Facts(
    starting_program: Model.ProgramModel,
    built: List<HighIntermediaryRepresentation.HighFunction>,
    starting_excluded: List<String>,
) {
    program = starting_program
    held_work = HighIntermediaryRepresentation.HeldWork(program)
    held_work.counts_only_a_concurrent = true
    excluded = starting_excluded
    var index = 0
    while index < built.count() {
        var high = built[index]
        var key = high.function.key()
        bodies[key] = high
        index = index + 1
    }
}

func waits(key: String): Boolean {
    var asked = List<String>()
    asked.append(key)
    study(asked)
    var seen = List<String>()
    return waits_through(key, seen)
}

func waits_through(key: String, seen: List<String>): Boolean {
    if waiting_keys.contains(key) {
        return true
    }
    if seen.contains(key) {
        return false
    }
    seen.append(key)
    if key.starts_with("$value") {
        study_everything()
    }
    var called = waits_callees[key]
    if not called {
        return false
    }
    var index = 0
    while index < called.count() {
        var callee = called[index]
        if waits_through(callee, seen) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#whether-a-class-keeps-state
func writes_a_singleton(function: Model.FunctionModel): Boolean {
    var asked = List<String>()
    var key = function.key()
    asked.append(key)
    study(asked)
    var found = singleton_writes[key]
    if not found {
        return false
    }
    return not found.is_empty()
}

func writes(function: Model.FunctionModel, slot: String): Boolean {
    var asked = List<String>()
    var key = function.key()
    asked.append(key)
    study(asked)
    return callee_writes(function, slot)
}

func accesses(key: String, slot: String, is_a_write: Boolean): Boolean {
    var asked = List<String>()
    asked.append(key)
    study(asked)
    var entries = read
    if is_a_write {
        entries = written
    }
    if not slot.starts_with("a:") {
        return entries.contains("{key}|{slot}")
    }
    var reached = List<String>()
    reach_in_the_class(key, reached)
    var index = 0
    while index < reached.count() {
        var reached_key = reached[index]
        if entries.contains("{reached_key}|{slot}") {
            return true
        }
        index = index + 1
    }
    return false
}

func reach_in_the_class(key: String, reached: List<String>) {
    assert not reached.contains(key)
    reached.append(key)
    var called = same_class_callees[key]
    assert called
    var index = 0
    while index < called.count() {
        var callee = called[index]
        reach_in_the_class(callee, reached)
        index = index + 1
    }
}

func study(asked: List<String>) {
    var before = studied.count()
    asked.each(add_pending)
    while not pending.is_empty() {
        var key = pending.remove_last()
        crash key
        if not studied.contains(key) {
            studied.append(key)
            read_function(key)
        }
    }
    assert studied.count() != before
    changed = true
    while changed {
        changed = false
        studied.each(read_function)
    }
}

# ../../PROOFS.md#whether-a-function-waits
func study_everything() {
    assert not studied_everything
    studied_everything = true
    var unread = List<String>()
    var known = bodies.keys()
    var index = 0
    while index < known.count() {
        var key = known[index]
        if not studied.contains(key) and not excluded.contains(key) {
            unread.append(key)
        }
        index = index + 1
    }
    if not unread.is_empty() {
        study(unread)
    }
}

func add_pending(key: String) {
    pending.append(key)
}

func read_function(key: String) {
    assert not excluded.contains(key)
    var high = bodies[key]
    assert high
    current_key = key
    current_owner = high.function.owner
    current_path = path_of(high.function)
    current_parameters = List<String>()
    aliases = Aliases()
    var index = 0
    while index < high.function.parameters.count() {
        var parameter = high.function.parameters[index]
        current_parameters.append(parameter.name)
        var own = List<String>()
        own.append("p:{parameter.name}")
        var passed_type = parameter.parameter_type
        if is_a_singleton(passed_type) {
            own = List<String>()
            own.append("s:{passed_type.name}")
        }
        aliases.set(parameter.name, own)
        index = index + 1
    }
    ensure_lists(key)
    held_locals = List<String>()
    moved_locals = List<String>()
    read_block(high.body)
    held_locals.each(let_go_at_the_end)
}

# ../../PROOFS.md#whether-a-function-waits
func let_go_at_the_end(name: String) {
    if not moved_locals.contains(name) {
        note_waiting()
    }
}

func note_a_move(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        moved_locals.append(value.name)
    }
}

func path_of(function: Model.FunctionModel): String {
    var path = ""
    var owner = program.class_named(function.owner)
    if owner {
        path = owner.file.path
    }
    if function.declaration {
        path = declared_path_or(function.declaration, path)
    }
    return path
}

func declared_path_or(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    otherwise: String,
): String {
    if declaration.path.is_empty() {
        return otherwise
    }
    return declaration.path
}

func place_of_a_write(function: Model.FunctionModel, slot: String): String {
    var key = function.key()
    var entry = "{key}|{slot}"
    var path = write_paths[entry]
    var line = write_lines[entry]
    if path and line and not path.is_empty() {
        return "{path}:{line}"
    }
    return ""
}

func source_of_a_write(function: Model.FunctionModel, slot: String): String {
    var key = function.key()
    var entry = "{key}|{slot}"
    var path = write_paths[entry]
    var line = write_lines[entry]
    crash path
    crash line
    var file = File(path)
    var text = file.read()
    crash text
    var lines = text.lines()
    var found = lines[line - 1]
    crash found
    return found.trim()
}

func ensure_lists(key: String) {
    if not studied_callees[key] {
        studied_callees[key] = List<String>()
    }
    if not waits_callees[key] {
        waits_callees[key] = List<String>()
    }
    if not same_class_callees[key] {
        same_class_callees[key] = List<String>()
    }
}

func callee_writes(function: Model.FunctionModel, slot: String): Boolean {
    var key = function.key()
    if excluded.contains(key) {
        return false
    }
    if bodies[key] {
        return written.contains("{key}|{slot}")
    }
    if function.has_a_body() {
        return true
    }
    return supplied_writes(function.name, slot)
}

func supplied_writes(name: String, slot: String): Boolean {
    if name.starts_with("_read") or name == "_item_size" {
        return false
    }
    if name.starts_with("_forget") or name.starts_with("_resize") {
        return slot == "this"
    }
    return true
}

func add_callee(key: String) {
    var called = studied_callees[current_key]
    crash called
    if not called.contains(key) {
        called.append(key)
    }
    if not studied.contains(key) and bodies[key] and not excluded.contains(key) {
        pending.append(key)
    }
    assert not starting
    var waited = waits_callees[current_key]
    crash waited
    if not waited.contains(key) {
        waited.append(key)
    }
}

func add_a_called_key(key: String, owner: String) {
    var is_the_compilers = owner.starts_with("Spite.Work_of_")
    if not is_the_compilers {
        add_callee(key)
        return
    }
    var outer = starting
    starting = true
    add_callee(key)
    starting = outer
}

func add_same_class_callee(key: String) {
    var called = same_class_callees[current_key]
    crash called
    if not called.contains(key) {
        called.append(key)
    }
}

func note_waiting() {
    assert not starting
    if not waiting_keys.contains(current_key) {
        waiting_keys.append(current_key)
    }
}

func mark(slots: List<String>) {
    var index = 0
    while index < slots.count() {
        var slot = slots[index]
        var entry = "{current_key}|{slot}"
        if not written.contains(entry) {
            written.append(entry)
            note_a_singleton_write(slot)
            write_paths[entry] = current_path
            write_lines[entry] = current_line
            changed = true
        }
        index = index + 1
    }
}

func note_a_singleton_write(slot: String) {
    assert slot.starts_with("s:")
    var listed = singleton_writes[current_key]
    if not listed {
        listed = List<String>()
        singleton_writes[current_key] = listed
    }
    crash listed
    if not listed.contains(slot) {
        listed.append(slot)
    }
}

func note_read(slot: String) {
    var entry = "{current_key}|{slot}"
    if not read.contains(entry) {
        read.append(entry)
    }
}

func read_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(read_statement)
}

func read_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    current_line = statement.line
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_naming(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_a_reassignment(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: look(statement.value)
        HighIntermediaryRepresentation.Statements.Return: read_a_return(statement.value)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Block: read_block(statement)
        _: return
    }
}

func read_a_return(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    note_a_move(value)
    look(value)
    var found = roots(value)
    var index = 0
    while index < found.count() {
        var slot = found[index]
        var entry = "{current_key}|{slot}"
        if not returned.contains(entry) {
            returned.append(entry)
            changed = true
        }
        index = index + 1
    }
}

func read_a_reassignment(name: String, value: HighIntermediaryRepresentation.Values.Value?) {
    crash value
    if held_work.holds(value.value_type) {
        note_waiting()
    }
    read_a_naming(name, value)
}

func read_a_naming(name: String, value: HighIntermediaryRepresentation.Values.Value?) {
    crash value
    if held_work.holds(value.value_type) and not held_locals.contains(name) {
        held_locals.append(name)
    }
    note_a_move(value)
    look(value)
    var found = roots(value)
    aliases.set(name, found)
}

func read_an_attribute_write(statement: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    if held_work.holds(statement.attribute.attribute_type) {
        note_waiting()
    }
    look(statement.object)
    note_a_move(statement.value)
    look(statement.value)
    var target = statement.object
    if target == HighIntermediaryRepresentation.Values.ThisRead {
        var own = List<String>()
        own.append("this")
        own.append("a:{statement.attribute.name}")
        mark(own)
    } else {
        var reached = roots(target)
        mark(reached)
    }
    var stored = roots(statement.value)
    mark(stored)
}

func read_a_shape_write(statement: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    look(statement.object)
    note_a_move(statement.value)
    look(statement.value)
    var reached = roots(statement.object)
    mark(reached)
    var stored = roots(statement.value)
    mark(stored)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    look(branch.condition)
    var before = aliases.copy()
    read_block(branch.then_branch)
    var after_then = aliases
    aliases = before
    if branch.else_branch {
        read_block(branch.else_branch)
    }
    aliases.merge(after_then)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    look(loop.condition)
    var before = aliases.copy()
    read_block(loop.body)
    aliases.merge(before)
    read_block(loop.body)
    aliases.merge(before)
}

func look(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.Call: look_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: look_a_conversion(value)
        HighIntermediaryRepresentation.Values.AttributeRead: look_an_attribute(value)
        HighIntermediaryRepresentation.Values.LocalRead: note_a_local(value.name)
        HighIntermediaryRepresentation.Values.Class.OfValue: look(value.described)
        HighIntermediaryRepresentation.Values.Class.Test: look(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: look(value.text)
        HighIntermediaryRepresentation.Values.EnumText: look(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: value.arguments.each(look_a_foreign_argument)
        HighIntermediaryRepresentation.Values.Function.Value: look_a_taken_function(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: look_a_value_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: look_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.MakeObject: look_a_making(value)
        HighIntermediaryRepresentation.Values.Negation: look(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: look_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: look(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: look_a_shape_call(value)
        _: return
    }
}

func look_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    look(first)
    look(second)
}

func look_present(value: HighIntermediaryRepresentation.Values.Value) {
    note_a_move(value)
    look(value)
}

func note_a_local(name: String) {
    if current_parameters.contains(name) {
        note_read("p:{name}")
    }
}

func look_an_attribute(attribute_read: HighIntermediaryRepresentation.Values.AttributeRead) {
    look(attribute_read.object)
    var object = attribute_read.object
    if object == HighIntermediaryRepresentation.Values.ThisRead {
        note_read("a:{attribute_read.attribute.name}")
    }
}

func look_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    crash conversion.converted
    if conversion.kind == 'join' {
        var joined_type = conversion.converted.value_type
        if joined_type.kind == 'handle' and joined_type.name == "Concurrent" {
            note_waiting()
        }
    }
    if conversion.kind == 'into_handle' {
        var outer = starting
        starting = true
        look(conversion.converted)
        starting = outer
        return
    }
    look(conversion.converted)
}

func look_a_foreign_argument(argument: HighIntermediaryRepresentation.Values.Value) {
    note_a_move(argument)
    look(argument)
    var reached = roots(argument)
    mark(reached)
}

func look_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    look(call.receiver)
    call.arguments.each(look_present)
    var key = call.function.key()
    note_a_cleared_holder(call)
    var touches_a_file = file_reads.contains(key) or file_writes.contains(key)
    if key == "Program.sleep" or blocking.contains(key) or touches_a_file {
        note_waiting()
    }
    add_a_called_key(key, call.function.owner)
    var receiver = call.receiver
    if receiver == HighIntermediaryRepresentation.Values.ThisRead and call.function.owner == current_owner {
        add_same_class_callee(key)
    }
    map_the_writes(call.function, call.receiver, call.arguments)
}

func note_a_cleared_holder(call: HighIntermediaryRepresentation.Values.Call) {
    assert call.function.name == "clear" and call.receiver
    if held_work.holds(call.receiver.value_type) {
        note_waiting()
    }
}

func map_the_writes(
    function: Model.FunctionModel,
    receiver: HighIntermediaryRepresentation.Values.Value?,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
) {
    if receiver and callee_writes(function, "this") {
        var reached = roots(receiver)
        mark(reached)
    }
    var index = 0
    while index < function.parameters.count() and index < arguments.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        if callee_writes(function, "p:{parameter.name}") {
            var passed = roots(argument)
            mark(passed)
        }
        index = index + 1
    }
    var key = function.key()
    var singletons = singleton_writes[key]
    if singletons and key != current_key {
        var written_there = singletons.copy()
        mark(written_there)
    }
}

func look_a_taken_function(taken: HighIntermediaryRepresentation.Values.Function.Value) {
    look(taken.receiver)
    var key = taken.function.key()
    var counted = taken.function.parameters.count()
    var through = "$value:{counted}"
    var listed = waits_callees[through]
    if not listed {
        listed = List<String>()
        waits_callees[through] = listed
    }
    crash listed
    if not listed.contains(key) {
        listed.append(key)
    }
    if not studied.contains(key) and bodies[key] and not excluded.contains(key) {
        pending.append(key)
    }
}

func look_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    look(call.called)
    call.arguments.each(look_present)
    var called = call.called
    if called == HighIntermediaryRepresentation.Values.Function.Value {
        look_a_known_value_call(called, call.arguments)
        return
    }
    var waited = waits_callees[current_key]
    crash waited
    var passed = call.arguments.count()
    var through = "$value:{passed}"
    if not starting and not waited.contains(through) {
        waited.append(through)
    }
    var reached = mentions(called)
    mark(reached)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = mentions(argument)
        mark(passed)
        index = index + 1
    }
}

func look_a_known_value_call(
    called: HighIntermediaryRepresentation.Values.Function.Value,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
) {
    var key = called.function.key()
    add_callee(key)
    var receiver = called.receiver
    if receiver == HighIntermediaryRepresentation.Values.ThisRead and called.function.owner == current_owner {
        add_same_class_callee(key)
    }
    map_the_writes(called.function, called.receiver, arguments)
}

func look_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    look(call.receiver)
    call.arguments.each(look_present)
    var fillers = program.fillers_of(call.shape.key)
    var dispatched = 0
    var filler_index = 0
    while filler_index < fillers.count() {
        var filler = fillers[filler_index]
        if dispatch_to(filler, call) {
            dispatched = dispatched + 1
        }
        filler_index = filler_index + 1
    }
    assert dispatched == 0 and not call.member.is_an_attribute
    var reached = roots(call.receiver)
    mark(reached)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var passed = roots(argument)
        mark(passed)
        index = index + 1
    }
}

func dispatch_to(filler: Model.Type, call: HighIntermediaryRepresentation.Values.ShapeCall): Boolean {
    if filler.is_symbol {
        return false
    }
    var model = program.class_named(filler.name)
    if not model {
        return false
    }
    var reached = model.function_named(call.member.name)
    if not reached and call.member.is_an_attribute {
        reached = model.function_named("get_{call.member.name}")
    }
    if not reached {
        return false
    }
    var key = reached.key()
    add_a_called_key(key, reached.owner)
    map_the_writes(reached, call.receiver, call.arguments)
    return true
}

func look_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    made.arguments.each(look_present)
    var class_key = made.value_type.name
    var defaults = "{class_key}._attribute_defaults"
    add_callee(defaults)
    assert made.constructor
    var constructor: Model.FunctionModel = made.constructor
    var key = constructor.key()
    add_callee(key)
    map_the_writes(constructor, null, made.arguments)
}

func is_immutable(of_type: Model.Type): Boolean {
    var plain = of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'nothing'
    return plain or of_type.kind == 'object' and of_type.name == "String"
}

func is_a_singleton(of_type: Model.Type): Boolean {
    if of_type.kind != 'object' {
        return false
    }
    var model = program.class_named(of_type.name)
    if not model {
        return false
    }
    return model.is_singleton
}

func roots(value: HighIntermediaryRepresentation.Values.Value?): List<String> {
    var found = List<String>()
    if not value {
        return found
    }
    if is_immutable(value.value_type) {
        return found
    }
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return aliases.slots_of(value.name)
        HighIntermediaryRepresentation.Values.ThisRead: return own_slot()
        HighIntermediaryRepresentation.Values.AttributeRead: return roots_of_an_attribute(value)
        HighIntermediaryRepresentation.Values.Conversion: return roots(value.converted)
        HighIntermediaryRepresentation.Values.Call: return roots_of_a_known_call(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return roots_of_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return roots_of_a_call(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: return roots_of_a_making(value)
        _: return found
    }
}

func is_gathered(parameter: Model.ParameterModel): Boolean {
    return parameter.is_variadic
}

func roots_of_a_known_call(call: HighIntermediaryRepresentation.Values.Call): List<String> {
    var function = call.function
    var receiver = call.receiver
    var arguments = call.arguments
    var key = function.key()
    var body = bodies[key]
    var gathers = function.parameters.any(is_gathered)
    if not body or excluded.contains(key) or gathers {
        return roots_of_a_call(receiver, arguments)
    }
    var found = List<String>()
    if returned.contains("{key}|this") {
        var from_the_receiver = roots(receiver)
        aliases.add_all(found, from_the_receiver)
    }
    var index = 0
    while index < function.parameters.count() and index < arguments.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        if returned.contains("{key}|p:{parameter.name}") {
            var passed = roots(argument)
            aliases.add_all(found, passed)
        }
        index = index + 1
    }
    return found
}

func roots_of_a_making(made: HighIntermediaryRepresentation.Values.MakeObject): List<String> {
    if is_a_singleton(made.value_type) {
        var found = List<String>()
        found.append("s:{made.value_type.name}")
        return found
    }
    return roots_of_a_call(null, made.arguments)
}

func own_slot(): List<String> {
    var found = List<String>()
    found.append("this")
    return found
}

func roots_of_an_attribute(attribute_read: HighIntermediaryRepresentation.Values.AttributeRead): List<String> {
    var found = List<String>()
    var held = attribute_read.attribute.attribute_type
    if is_a_singleton(held) {
        found.append("s:{held.name}")
        return found
    }
    var object = attribute_read.object
    if object == HighIntermediaryRepresentation.Values.ThisRead {
        found.append("this")
        found.append("a:{attribute_read.attribute.name}")
        return found
    }
    return roots(object)
}

func roots_of_a_call(
    receiver: HighIntermediaryRepresentation.Values.Value?,
    arguments: List<HighIntermediaryRepresentation.Values.Value>,
): List<String> {
    var found = roots(receiver)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var passed = roots(argument)
        aliases.add_all(found, passed)
        index = index + 1
    }
    return found
}

func mentions(value: HighIntermediaryRepresentation.Values.Value?): List<String> {
    var found = List<String>()
    if not value {
        return found
    }
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return aliases.slots_of(value.name)
        HighIntermediaryRepresentation.Values.ThisRead: return own_slot()
        HighIntermediaryRepresentation.Values.AttributeRead: return mentions_of_an_attribute(value)
        HighIntermediaryRepresentation.Values.Conversion: return mentions(value.converted)
        HighIntermediaryRepresentation.Values.Call: return roots_of_a_call(value.receiver, value.arguments)
        _: return found
    }
}

func mentions_of_an_attribute(attribute_read: HighIntermediaryRepresentation.Values.AttributeRead): List<String> {
    var object = attribute_read.object
    if object == HighIntermediaryRepresentation.Values.ThisRead {
        var found = List<String>()
        found.append("this")
        found.append("a:{attribute_read.attribute.name}")
        return found
    }
    return mentions(object)
}

var library = Mapping.LibraryFile()
var _lowercase_z_code: Integer = 122

func written_path_of(path: String): String {
    return path.replace("\\", "/")
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func simple_name_of(shown: String): String {
    var kept_text = ""
    var word = ""
    var depth = 0
    var index = 0
    while index < shown.length() {
        var character_rune = shown[index]
        crash character_rune
        var character = character_rune.to_string()
        var code = shown.byte_at(index)
        var is_a_letter = code >= 97 and code <= _lowercase_z_code or code >= 65 and code <= 90 or code >= 48 and code <= 57 or code == 95
        if is_a_letter {
            word = "{word}{character}"
        } else if character == "." {
            word = ""
            if depth == 0 {
                kept_text = ""
            }
        } else {
            if character == "<" {
                depth = depth + 1
            }
            if character == ">" {
                depth = depth - 1
            }
            kept_text = "{kept_text}{word}{character}"
            word = ""
        }
        index = index + character.length()
    }
    return "{kept_text}{word}"
}

func namespace_of(described: String): String {
    var parts = described.split(".")
    var last = parts.count() - 1
    parts.remove_at(last)
    return parts.join(".")
}

func last_name_of(described: String): String {
    var parts = described.split(".")
    var last = parts.count() - 1
    var name = parts[last]
    crash name
    return name
}

# ../../../spite_documentation/reflection.md#every-class-in-the-program
func is_the_programs(path: String, map: Mapping.FolderMap): Boolean {
    fallback not library.holds(path)
    var root = map.root_holding(path)
    fallback root
    var forward_path = path.replace("\\", "/")
    var root_length = root.path.length()
    var path_length = forward_path.length()
    var inside = forward_path.slice(root_length, path_length)
    crash inside
    return not inside.contains("/.spite/")
}

func insert_in_order(keys: List<String>, key: String) {
    var place = 0
    while place < keys.count() and keys[place] < key {
        place = place + 1
    }
    keys.insert(place, key)
}

func folder_of(path: String): String {
    var forward = path.replace("\\", "/")
    var parts = forward.split("/")
    var last = parts.count() - 1
    parts.remove_at(last)
    return parts.join("/")
}

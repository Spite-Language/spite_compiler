var state = ReflectionState()
var described_names = DescribedNames()
var writing = Writing(state)

func ClassObjects(starting_state: ReflectionState) {
    state = starting_state
    described_names = DescribedNames()
    writing = Writing(starting_state)
}

func make_a_class_object(described: String) {
    var class_type = writing.reflection_type("Spite.Class")
    var known = "Spite.Class:{described}"
    fallback not state.context.reflected.contains(known)
    state.context.reflected.append(known)
    writing.need_the_making(class_type)
    state.context.unfilled.append(known)
}

func class_object(described: String): SpiteCompiler.Value {
    make_a_class_object(described)
    var class_type = writing.reflection_type("Spite.Class")
    return HighIntermediaryRepresentation.Values.Class.Object(class_type, described)
}

func namespace_object(described: String): SpiteCompiler.Value {
    var namespace_type = writing.reflection_type("Spite.Namespace")
    if described.is_empty() {
        var nullable = namespace_type.nullable()
        return HighIntermediaryRepresentation.Values.NullConstant(nullable)
    }
    var made = HighIntermediaryRepresentation.Values.Class.Object(namespace_type, described)
    var known = "Spite.Namespace:{described}"
    if state.context.reflected.contains(known) {
        return made
    }
    state.context.reflected.append(known)
    writing.need_the_making(namespace_type)
    state.context.unfilled.append(known)
    return made
}

# ../../../spite_documentation/reflection.md#spiteenum
func enum_object(described: String): SpiteCompiler.Value {
    return declared_object("Spite.Enum", described)
}

# ../../../spite_documentation/reflection.md#spiteunion-and-spitetype
func declared_object(kind: String, described: String): SpiteCompiler.Value {
    var declared_type = writing.reflection_type(kind)
    var made = HighIntermediaryRepresentation.Values.Class.Object(declared_type, described)
    var known = "{kind}:{described}"
    if state.context.reflected.contains(known) {
        return made
    }
    state.context.reflected.append(known)
    writing.need_the_making(declared_type)
    state.context.unfilled.append(known)
    return made
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func described_class_of(of_type: Model.Type): SpiteCompiler.Value {
    var described = class_object_of_type(of_type)
    if described {
        return described
    }
    return class_object("Nothing")
}

func class_object_of_type(of_type: Model.Type): SpiteCompiler.Value? {
    var is_a_class = of_type.kind == 'object' or of_type.kind == 'scalar' or of_type.kind == 'enumeration' or of_type.kind == 'union'
    fallback is_a_class
    if of_type.is_nullable {
        return class_object("{of_type.name}?")
    }
    return class_object(of_type.name)
}

func every_namespace(): SpiteCompiler.Value {
    var collections = Collections(state.values.context, state.values)
    var argument = Model.Type('object', "Spite.Namespace")
    var list_type = state.context.resolver.monomorphiser.list_type_of(argument)
    var listed = collections.new_list(list_type)
    var names = namespaces_of_the_program()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var described = namespace_object(name)
        collections.append_to(listed, described)
        index = index + 1
    }
    return listed
}

func namespaces_of_the_program(): List<String> {
    var names = List<String>()
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var program_folder = described_names.folder_of(entry.file.path)
    var folders = state.context.resolver.state.symbols.namespace_folders()
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        var forward_path = folder.path.replace("\\", "/")
        var path_length = forward_path.length()
        var folder_length = program_folder.length()
        var rest = forward_path.slice(folder_length, path_length)
        crash rest
        var is_generated = rest.contains("/.spite/")
        var is_the_programs = forward_path.starts_with(program_folder) and not rest.contains("..") and not is_generated
        if is_the_programs {
            names.append(folder.namespace)
        }
        index = index + 1
    }
    return names
}

func read_every_class_in(folder: String) {
    var mapped = state.context.resolver.state.symbols.map.every_class()
    var index = 0
    while index < mapped.count() {
        var class_file = mapped[index]
        if described_names.is_inside(class_file.path, folder) {
            state.context.resolver.monomorphiser.read_class_named(class_file.namespace)
        }
        index = index + 1
    }
}

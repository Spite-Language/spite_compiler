var state = ReflectionState()

func Features(starting_state: ReflectionState) {
    state = starting_state
}

func features(): String {
    var found = ""
    var lists = wants("Spite.Class.get_functions") or wants("Spite.Class.has_function") or wants("Spite.Class.argument_count")
    if lists or wants("Spite.Class.function_waits") {
        found = "{found}f"
    }
    if wants("Spite.FunctionDeclaration.get_is_resumable") or wants("Spite.Class.function_waits") {
        found = "{found}w"
    }
    if wants("Spite.Argument.get_is_mutated") {
        found = "{found}m"
    }
    if wants("Spite.FunctionDeclaration.get_reads") or wants("Spite.FunctionDeclaration.get_writes") {
        found = "{found}a"
    }
    if wants("Spite.Class.get_is_stateful") {
        found = "{found}s"
    }
    if wants("Spite.Class.get_enums") or wants("Spite.Class.get_unions") or wants("Spite.Class.get_types") {
        found = "{found}e"
    }
    if wants("Spite.Function.get_owner") {
        found = "{found}b"
    }
    if wants("Spite.FunctionDeclaration._call_on") {
        found = "{found}o"
    }
    if wants("Spite.FunctionDeclaration.get_source_file") or wants("Spite.AttributeDeclaration.get_source_file") {
        found = "{found}p"
    }
    if wants("Spite.Class.get_source_files") {
        found = "{found}c"
    }
    if wants("Spite.Namespace.get_source_directories") {
        found = "{found}d"
    }
    return found
}

func wants(key: String): Boolean {
    return state.context.queued.contains(key)
}

func has_feature(feature: String): Boolean {
    return state.context.fill_features.contains(feature)
}

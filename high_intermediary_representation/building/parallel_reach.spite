var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var work_class = Model.ClassModel("", "", no_file)
var reached_functions = List<String>()
var reached_attributes = List<String>()
var reaching_functions = List<String>()
var written_attributes = List<String>()

func check(context: Context, work: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    var library = Validators.LibraryFile()
    var path = context.path()
    assert not library.holds(path)
    if work == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_own_work(context, work.name)
    }
    if work == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_held_work(context, work)
    }
}

func check_own_work(context: Context, name: String) {
    var function = context.current_class.function_named(name)
    assert function
    var written_text = "Parallel({name})"
    var threads = ThreadReach()
    threads.check(context, context.current_class, function, written_text)
    assert not context.current_class.is_singleton
    study(context.current_class, function)
    refuse_an_unshared_reach(context, written_text)
    var written = written_attributes.first()
    assert written
    typing.refuse_shared_value_write(context, written_text, written, context.current_class.shown)
}

func check_held_work(context: Context, work: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var holder = work.target
    if holder == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_work_of_a_name(context, holder.name, work.name)
    }
}

func check_work_of_a_name(context: Context, holder: String, name: String) {
    var held_type = type_of_a_name(context, holder)
    assert held_type
    assert held_type.kind == 'object' and not held_type.is_nullable and context.has_a_class(held_type)
    var model = context.class_of(held_type)
    var library = Validators.LibraryFile()
    assert not library.holds(model.file.path)
    var function = model.function_named(name)
    assert function
    var written_text = "Parallel({holder}.{name})"
    var threads = ThreadReach()
    threads.check(context, model, function, written_text)
    assert not model.is_singleton
    study(model, function)
    if is_handed_over(context, holder) {
        refuse_a_later_use(context, holder, written_text)
        return
    }
    refuse_an_unshared_reach(context, written_text)
}

func check_the_steps(context: Context, callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var reached = reaching_step_of(callee.target)
    assert not reached.is_empty()
    typing.refuse_parallel_each_after_a_step(context, callee.name, reached)
}

func reaching_step_of(step: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if step == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return reaching_call(step)
    }
    return ""
}

func reaching_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var stepped = call.callee
    if stepped == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return reached_by(stepped)
    }
    return ""
}

func reached_by(stepped: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if stepped.name.starts_with("filter_") {
        return reaching_step_of(stepped.target)
    }
    if stepped.name.starts_with("map_") {
        return stepped.name
    }
    return ""
}

func check_each(context: Context, owner: Model.ClassModel, called: String) {
    var library = Validators.LibraryFile()
    var path = context.path()
    assert not library.holds(path)
    var element = owner.bound_types["$element_type"]
    assert element
    var is_a_class = element.kind == 'object' and context.has_a_class(element)
    if not is_a_class {
        var shown = context.shown(element)
        typing.refuse_parallel_each_of_values(context, called, shown)
    }
    var model = context.class_of(element)
    assert not library.holds(model.file.path)
    var called_length = called.length()
    var member_name = called.slice(14, called_length)
    var function = model.function_named(member_name)
    assert function
    study(model, function)
    var index = 0
    while index < reached_attributes.count() {
        var name = reached_attributes[index]
        var attribute = model.attribute_named(name)
        crash attribute
        if is_shared(context, attribute.attribute_type) {
            var shown = context.shown(attribute.attribute_type)
            typing.refuse_parallel_each_reach(context, called, member_name, model.shown, name, shown)
        }
        index = index + 1
    }
}

func type_of_a_name(context: Context, name: String): Model.Type? {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return context.scope.type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func study(model: Model.ClassModel, function: Model.FunctionModel) {
    work_class = model
    reached_functions = List<String>()
    reached_attributes = List<String>()
    reaching_functions = List<String>()
    written_attributes = List<String>()
    read_function(function)
}

func read_function(function: Model.FunctionModel) {
    assert not reached_functions.contains(function.name)
    reached_functions.append(function.name)
    assert function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    assert declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var own_names = local_names_of(declaration, walk)
    note_the_writes(walk, own_names)
    note_the_reads(function.name, walk, own_names)
    follow_the_calls(walk, own_names)
}

func local_names_of(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    walk: AbstractSyntaxTree.Walk.Walk,
): List<String> {
    var names = declaration.parameters.map_names()
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found = walk.statements[statement_index]
        note_a_local_name(found.statement, names)
        statement_index = statement_index + 1
    }
    return names
}

func note_a_local_name(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, names: List<String>) {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        names.append(statement.name)
    }
}

func note_the_writes(walk: AbstractSyntaxTree.Walk.Walk, own_names: List<String>) {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        note_a_write(found.statement, own_names)
        index = index + 1
    }
}

func note_a_write(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, own_names: List<String>) {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target = statement.target
        if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            note_a_written_name(target.name, own_names)
        }
    }
}

func note_a_written_name(name: String, own_names: List<String>) {
    assert not own_names.contains(name) and not written_attributes.contains(name)
    var attribute = work_class.attribute_named(name)
    assert attribute
    assert holds_a_value(attribute.attribute_type)
    written_attributes.append(name)
}

func note_the_reads(function_name: String, walk: AbstractSyntaxTree.Walk.Walk, own_names: List<String>) {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        note_a_read(function_name, found.expression, own_names)
        index = index + 1
    }
}

func note_a_read(
    function_name: String,
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    own_names: List<String>,
) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        note_a_read_name(function_name, expression.name, own_names)
    }
}

func note_a_read_name(function_name: String, name: String, own_names: List<String>) {
    assert not own_names.contains(name) and not reached_attributes.contains(name)
    var attribute = work_class.attribute_named(name)
    assert attribute
    reached_attributes.append(name)
    reaching_functions.append(function_name)
}

func follow_the_calls(walk: AbstractSyntaxTree.Walk.Walk, own_names: List<String>) {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        follow_a_call(found.expression, own_names)
        index = index + 1
    }
}

func follow_a_call(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, own_names: List<String>) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var callee = expression.callee
        if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            follow_an_own_call(callee.name, own_names)
        }
    }
}

func follow_an_own_call(name: String, own_names: List<String>) {
    assert not own_names.contains(name) and not reached_functions.contains(name)
    var function = work_class.function_named(name)
    assert function
    read_function(function)
}

func holds_a_value(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'scalar' or kind == 'enumeration' {
        return true
    }
    return kind == 'object' and of_type.name == "String"
}

func is_shared(context: Context, of_type: Model.Type): Boolean {
    if holds_a_value(of_type) or of_type.kind == 'handle' {
        return false
    }
    if of_type.kind == 'object' and context.has_a_class(of_type) {
        var model = context.class_of(of_type)
        return not model.is_singleton
    }
    return of_type.kind != 'nothing'
}

func refuse_an_unshared_reach(context: Context, written_text: String) {
    var index = 0
    while index < reached_attributes.count() {
        var name = reached_attributes[index]
        var function_name = reaching_functions[index]
        crash function_name
        var attribute = work_class.attribute_named(name)
        crash attribute
        if is_shared(context, attribute.attribute_type) {
            var shown = context.shown(attribute.attribute_type)
            typing.refuse_parallel_reach(context, written_text, function_name, work_class.shown, name, shown)
        }
        index = index + 1
    }
}

func is_handed_over(context: Context, holder: String): Boolean {
    var written = context.block_statements
    var index = context.block_index
    var declared_at = declaration_of(written, index, holder)
    if declared_at < 0 {
        return false
    }
    var declaration = written[declared_at]
    if not is_made_by_a_constructor(declaration) {
        return false
    }
    var between = walk_of(written, declared_at + 1, index)
    return only_reaches_values(context, between, holder)
}

func declaration_of(
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    name: String,
): Integer {
    var at = index - 1
    while at >= 0 {
        var earlier = written[at]
        if declares(earlier, name) {
            return at
        }
        at = at - 1
    }
    return -1
}

func declares(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == name
    }
    return false
}

func is_made_by_a_constructor(statement: AbstractSyntaxTree.Shapes.Statements.Statement?): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return is_a_construction(statement.value)
    }
    return false
}

func is_a_construction(value: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var callee = value.callee
        if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            var initial = callee.name.slice(0, 1)
            return initial != initial.lower_case()
        }
    }
    return false
}

func walk_of(
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    starting_at: Integer,
    ending_at: Integer,
): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var at = starting_at
    var last = ending_at
    if last > written.count() {
        last = written.count()
    }
    while at < last {
        var statement = written[at]
        crash statement
        walk.read_statement(statement)
        at = at + 1
    }
    return walk
}

func only_reaches_values(context: Context, walk: AbstractSyntaxTree.Walk.Walk, holder: String): Boolean {
    var named = 0
    var reached = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if is_the_name(expression, holder) {
            named = named + 1
        }
        if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and is_the_name(expression.target, holder) {
            reached = reached + 1
            if reads_a_shared_attribute(context, expression.name) {
                return false
            }
        }
        index = index + 1
    }
    return named == reached
}

func reads_a_shared_attribute(context: Context, name: String): Boolean {
    var attribute = work_class.attribute_named(name)
    if attribute {
        return is_shared(context, attribute.attribute_type)
    }
    return false
}

func is_the_name(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func refuse_a_later_use(context: Context, holder: String, written_text: String) {
    var kept = kept_attribute(context)
    assert kept != ""
    var written = context.block_statements
    var after = context.block_index + 1
    while after < written.count() {
        var later = written[after]
        var walk = AbstractSyntaxTree.Walk.Walk(no_file)
        walk.read_statement(later)
        if names_it(walk, holder) {
            context.line = later_line_of(later)
            typing.refuse_handed_over_use(context, holder, written_text, kept, work_class.shown)
        }
        after = after + 1
    }
}

func kept_attribute(context: Context): String {
    var written = written_attributes.first()
    if written {
        return "writes its '{written}'"
    }
    var index = 0
    while index < reached_attributes.count() {
        var name = reached_attributes[index]
        var attribute = work_class.attribute_named(name)
        crash attribute
        if is_shared(context, attribute.attribute_type) {
            return "keeps its '{name}'"
        }
        index = index + 1
    }
    return ""
}

func names_it(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func later_line_of(statement: AbstractSyntaxTree.Shapes.Statements.Statement): Integer {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return statement.line
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return statement.line
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return statement.line
        _: return 0
    }
}

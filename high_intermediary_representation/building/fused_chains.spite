var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var fused_templates = [
    "filter_member"
    "count_member"
    "any_member"
    "all_member"
    "sum_member"
    "each_member"
    "map_members"
    "find_by_member"
]

func FusedChains(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func fused_step(
    receiver: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    name: String,
): Model.FunctionModel? {
    var library = Validators.LibraryFile()
    assert owner.file.namespace == "List" and library.holds(owner.file.path)
    var filters = filters_of(receiver)
    assert not filters.is_empty()
    var last = owner.function_named(name)
    if not last {
        last = values.member_template_of(owner, name)
    }
    assert last
    return fused_function(owner, filters, last)
}

func first_list_of(receiver: HighIntermediaryRepresentation.Values.Value): HighIntermediaryRepresentation.Values.Value {
    var first: HighIntermediaryRepresentation.Values.Value? = null
    if receiver == HighIntermediaryRepresentation.Values.Call {
        first = receiver.receiver
    }
    crash first
    return first
}

func filters_of(receiver: HighIntermediaryRepresentation.Values.Value): List<String> {
    var filters = List<String>()
    if receiver == HighIntermediaryRepresentation.Values.Call {
        var is_a_step = receiver.arguments.is_empty() and is_a_filter(receiver.function)
        if is_a_step and receiver.receiver {
            receiver.function.fused_filters.each(filters.append)
            var step = member_step(receiver.function)
            filters.append(step)
        }
    }
    return filters
}

func is_a_filter(function: Model.FunctionModel): Boolean {
    if not function.declaration {
        return false
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    return declaration.name == "filter_member" and not function.bound_member.is_empty()
}

func member_step(function: Model.FunctionModel): String {
    if function.bound_member_is_a_function {
        return "{function.bound_member}()"
    }
    return function.bound_member
}

func fused_function(owner: Model.ClassModel, filters: List<String>, last: Model.FunctionModel): Model.FunctionModel? {
    assert last.declaration and not last.bound_member.is_empty() and last.bound_member_type
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = last.declaration
    assert fused_templates.contains(declaration.name)
    var steps = filters.join("_")
    var plain_steps = steps.replace("()", "")
    var fused_name = "_fused_{plain_steps}_then_{last.name}"
    var known = owner.function_named(fused_name)
    if known {
        return known
    }
    var body = fused_body(declaration, filters)
    assert body
    var written = AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration(
        declaration.name,
        declaration.parameters,
        declaration.result,
        body,
    )
    written.line = declaration.line
    written.path = declaration.path
    var template = Model.FunctionModel(declaration.name, owner.key)
    template.declaration = written
    template.template_index = last.template_index
    template.is_a_member_template = true
    var member_type: Model.Type = last.bound_member_type
    var made = context.resolver.specialized(
        template,
        fused_name,
        last.bound_member,
        member_type,
        last.bound_member_is_a_function,
        owner,
    )
    made.bound_member_index = last.bound_member_index
    if declaration.name == "filter_member" {
        made.fused_filters = filters
    }
    owner.declared_functions.append(made)
    return made
}

func fused_body(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    filters: List<String>,
): AbstractSyntaxTree.Shapes.Statements.Block? {
    assert declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    var statements = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
    var fused_one = false
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        var fused = fused_loop(statement, filters)
        if fused and not fused_one {
            statements.append(fused)
            fused_one = true
        } else {
            statements.append(statement)
        }
        index = index + 1
    }
    assert fused_one
    var made = AbstractSyntaxTree.Shapes.Statements.Block(statements)
    made.line = body.line
    made.end_line = body.end_line
    return made
}

func fused_loop(
    statement: AbstractSyntaxTree.Shapes.Statements.Statement?,
    filters: List<String>,
): AbstractSyntaxTree.Shapes.Statements.Statement? {
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        return filtered_loop(statement, filters)
    }
    return null
}

func filtered_loop(
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    filters: List<String>,
): AbstractSyntaxTree.Shapes.Statements.Statement? {
    assert loop.body and loop.condition
    var loop_body: AbstractSyntaxTree.Shapes.Statements.Block = loop.body
    var count = loop_body.statements.count()
    assert count >= 3
    var reading = loop_body.statements[0]
    var stepping = loop_body.statements[count - 1]
    crash reading
    crash stepping
    assert reads_the_item(reading)
    var middle = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
    var index = 1
    while index < count - 1 {
        var inner = loop_body.statements[index]
        crash inner
        middle.append(inner)
        index = index + 1
    }
    var guarded = guarded_by(middle, filters, loop.line)
    var steps = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
    steps.append(reading)
    steps.append(guarded)
    steps.append(stepping)
    var stepped = AbstractSyntaxTree.Shapes.Statements.Block(steps)
    stepped.line = loop_body.line
    stepped.end_line = loop_body.end_line
    var made = AbstractSyntaxTree.Shapes.Statements.WhileStatement(loop.condition, stepped)
    made.line = loop.line
    return made
}

func reads_the_item(statement: AbstractSyntaxTree.Shapes.Statements.Statement): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == "item"
    }
    return false
}

func guarded_by(
    middle: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    filters: List<String>,
    line: Integer,
): AbstractSyntaxTree.Shapes.Statements.Statement {
    var inside = AbstractSyntaxTree.Shapes.Statements.Block(middle)
    inside.line = line
    var index = filters.count() - 1
    var guarded: AbstractSyntaxTree.Shapes.Statements.IfStatement? = null
    while index >= 0 {
        var filter = filters[index]
        crash filter
        var condition = member_read(filter)
        var made = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, inside, null)
        made.line = line
        guarded = made
        var wrapping = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
        wrapping.append(made)
        inside = AbstractSyntaxTree.Shapes.Statements.Block(wrapping)
        inside.line = line
        index = index - 1
    }
    crash guarded
    return guarded
}

func member_read(filter: String): AbstractSyntaxTree.Shapes.Expressions.Expression {
    var item = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression("item")
    if filter.ends_with("()") {
        var length = filter.length()
        var name = filter.slice(0, length - 2)
        var callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(item, name)
        var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var no_arguments = List<AbstractSyntaxTree.Shapes.Expressions.Expression>()
        return AbstractSyntaxTree.Shapes.Expressions.CallExpression(callee, no_generics, no_arguments)
    }
    return AbstractSyntaxTree.Shapes.Expressions.MemberExpression(item, filter)
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func FoldedDictionaries(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func folds(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Boolean {
    if statement.declared_type or is_interactive() {
        return false
    }
    var literal = statement.value
    if literal == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        return is_written_out(literal) and is_only_read_by_literal_keys(statement.name, literal)
    }
    return false
}

func is_interactive(): Boolean {
    var flags = context.build_flags
    var asked = flags.has("repl") or flags.has("repl_port") or flags.has("development")
    return asked or flags.has("hot_reload")
}

func is_written_out(literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral): Boolean {
    if literal.pairs.is_empty() {
        return false
    }
    var keys = List<String>()
    var key_kind = ""
    var value_kind = ""
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        var written_key = entry_key_of(pair)
        var this_key_kind = entry_kind_of(pair, true)
        var this_value_kind = entry_kind_of(pair, false)
        var is_new = written_key != "" and not keys.contains(written_key)
        var keeps_the_key_kind = key_kind == "" or key_kind == this_key_kind
        var keeps_the_value_kind = value_kind == "" or value_kind == this_value_kind
        var is_a_key = this_key_kind == "text" or this_key_kind == "integer_literal"
        if not is_new or not keeps_the_key_kind or not keeps_the_value_kind or not is_a_key or this_value_kind == "" {
            return false
        }
        keys.append(written_key)
        key_kind = this_key_kind
        value_kind = this_value_kind
        index = index + 1
    }
    return true
}

func entry_key_of(pair: AbstractSyntaxTree.Shapes.Expressions.Expression): String {
    if pair == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        return key_text_of(pair.key)
    }
    return ""
}

func entry_kind_of(pair: AbstractSyntaxTree.Shapes.Expressions.Expression, of_the_key: Boolean): String {
    if pair == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        return part_kind_of(pair, of_the_key)
    }
    return ""
}

func part_kind_of(pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral, of_the_key: Boolean): String {
    if of_the_key {
        return kind_of(pair.key)
    }
    return kind_of(pair.value)
}

func kind_of(written: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if written == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_kind_of(written)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return text_kind_of(written)
    }
    return ""
}

func literal_kind_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'integer_literal' {
        return "integer_literal"
    }
    if literal.kind == 'decimal_literal' {
        return "decimal_literal"
    }
    return ""
}

func text_kind_of(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    if literal.pieces.count() != 1 {
        return ""
    }
    var piece = literal.pieces[0]
    if piece.hole {
        return ""
    }
    return "text"
}

func key_text_of(written: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    var kind = kind_of(written)
    if kind == "" or kind == "decimal_literal" {
        return ""
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return number_key_of(written)
    }
    if written == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        var text = values.constant_text_of(written)
        return "text {text}"
    }
    return ""
}

func number_key_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    var number = literal.text.to_long()
    if number {
        return "number {number}"
    }
    return ""
}

func is_only_read_by_literal_keys(
    name: String,
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
): Boolean {
    if not context.current_function.declaration {
        return false
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(context.current_function.declaration)
    var first = literal.pairs.first()
    crash first
    var key_kind = entry_kind_of(first, true)
    var mentions = 0
    var reads = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        mentions = mentions + mention_of(found.expression, name)
        reads = reads + read_of(found.expression, name, key_kind)
        index = index + 1
    }
    var declared = 0
    index = 0
    while index < walk.statements.count() {
        var listed = walk.statements[index]
        if writes(listed.statement, name) {
            return false
        }
        declared = declared + declaration_of(listed.statement, name)
        index = index + 1
    }
    return declared == 1 and mentions == reads
}

func mention_of(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Integer {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if expression.name == name {
            return 1
        }
    }
    return 0
}

func read_of(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String, key_kind: String): Integer {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return index_read_of(expression, name, key_kind)
    }
    return 0
}

func index_read_of(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    name: String,
    key_kind: String,
): Integer {
    var is_named = mention_of(index.target, name) == 1
    if not is_named {
        return 0
    }
    var this_kind = kind_of(index.index)
    if this_kind == key_kind {
        return 1
    }
    return 0
}

func writes(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return writes_the_name(statement.target, name)
    }
    return false
}

func writes_the_name(target: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Boolean {
    if target == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return mention_of(target.target, name) == 1
    }
    return mention_of(target, name) == 1
}

func declaration_of(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, name: String): Integer {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        if statement.name == name {
            return 1
        }
    }
    return 0
}

func folded_read(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var target = index.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var literal = context.folded_dictionaries[target.name]
        if literal {
            return folded_read_of(literal, index)
        }
    }
    return null
}

func folded_read_of(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): HighIntermediaryRepresentation.Values.Value {
    var dictionary_type = values.dictionary_type_by_its_keys(literal)
    crash dictionary_type
    var dictionary_model = context.class_of(dictionary_type)
    var value_type = dictionary_model.bound_types["$value_type"]
    crash value_type
    var asked = key_text_of(index.index)
    var printer = Printers.Spite.ExpressionPrinter(index)
    var path = printer.text()
    var narrowed_type = context.scope.narrowed_type_of(path)
    var position = 0
    while position < literal.pairs.count() {
        var pair = literal.pairs[position]
        if pair == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var written = key_text_of(pair.key)
            if written == asked {
                return value_of_the_entry(pair, value_type, narrowed_type)
            }
        }
        position = position + 1
    }
    var nullable = value_type.nullable()
    return HighIntermediaryRepresentation.Values.NullConstant(nullable)
}

func value_of_the_entry(
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
    value_type: Model.Type,
    narrowed_type: Model.Type?,
): HighIntermediaryRepresentation.Values.Value {
    var value = values.fitted_value_of(pair.value, value_type)
    if narrowed_type {
        return value
    }
    var nullable = value_type.nullable()
    return values.fitted(value, nullable)
}

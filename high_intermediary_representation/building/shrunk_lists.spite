var shrinking = ["clear", "remove_at", "remove_first", "remove_last", "remove_swapping", "truncate", "swap"]
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file, false)
var seen = List<String>()
var found = false

func through_reads(starting_owner: Model.ClassModel, function: Model.FunctionModel): Boolean {
    owner = starting_owner
    seen = List<String>()
    found = false
    read_function(function)
    return found
}

func is_shrinking(name: String): Boolean {
    return shrinking.contains(name) or name.starts_with("remove_where")
}

func holds_items(class_key: String): Boolean {
    return class_key.starts_with("List_of_") or class_key.starts_with("Dictionary_of_")
}

func place_of(value: SpiteCompiler.Value?): SpiteCompiler.Value? {
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return place_of(value.converted)
    }
    return value
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func keys_watching(read: HighIntermediaryRepresentation.Values.Call): List<String> {
    var class_key = read.function.owner
    var place = place_of(read.receiver)
    if place.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return ["[-]{place.attribute.owner}.{place.attribute.name}", "[-]{class_key}"]
    }
    if place.class == HighIntermediaryRepresentation.Values.LocalRead {
        return ["[-]*{class_key}", "[-]local:{place.name}"]
    }
    return ["[-]*{class_key}"]
}

func read_function(function: Model.FunctionModel) {
    fallback not seen.contains(function.name)
    seen.append(function.name)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    read_block(declaration.body)
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    read_block(statement.then_branch)
    read_block(statement.else_branch)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_block(switch_case.body)
        index = index + 1
    }
}

func read_expression(expression: SpiteCompiler.Expression?) {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_call(expression)
    }
}

func read_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_an_own_call(callee.name)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_member_call(callee)
    }
}

func read_an_own_call(called: String) {
    var function = owner.function_named(called)
    fallback function
    read_function(function)
}

func read_a_member_call(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback is_shrinking(callee.name)
    var target = callee.target
    var is_reached = target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    is_reached = is_reached or target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    if is_reached {
        found = true
    }
}

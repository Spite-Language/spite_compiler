var member_reads = Dictionary<String, Integer>()
var name_reads = Dictionary<String, Integer>()
var built_reads = Dictionary<String, Boolean>()
var checked_paths = List<String>()
var found_path = ""
var found_line = 0
var found_owner = ""
var found_name = ""
var found_in_the_entry = false
var shape_members = List<String>()

func check(context: Context, built: List<HighIntermediaryRepresentation.HighFunction>) {
    assert not is_interactive(context)
    var walks = context.resolver.symbols.walks
    walks.each(count_the_reads)
    built.each(note_the_built_reads)
    var shapes = context.program.shapes.values()
    shapes.each(note_the_shape_members)
    var map = context.resolver.symbols.map
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        check_a_class(map, model, entry.file.path)
        index = index + 1
    }
    assert found_path != ""
    var failure = Validators.Failure()
    failure.stop_inside(
        found_path,
        found_line,
        found_owner,
        "",
        "the attribute '{found_name}' is never read: remove it",
    )
}

func note_the_shape_members(shape: Model.ShapeModel) {
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            shape_members.append(member.name)
        }
        index = index + 1
    }
}

func is_interactive(context: Context): Boolean {
    var flags = context.build_flags
    var asked = flags.has("repl") or flags.has("repl_port") or flags.has("development")
    return asked or flags.has("hot_reload")
}

func count_the_reads(walk: AbstractSyntaxTree.Walk.Walk) {
    var namespace = walk.file.namespace
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        count_a_read(namespace, found.expression, 1)
        index = index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found_statement = walk.statements[statement_index]
        uncount_a_target(namespace, found_statement.statement)
        statement_index = statement_index + 1
    }
}

func uncount_a_target(namespace: String, statement: AbstractSyntaxTree.Shapes.Statements.Statement?) {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        count_a_read(namespace, statement.target, -1)
    }
}

func count_a_read(namespace: String, expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, step: Integer) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        add_to(name_reads, "{namespace}|{expression.name}", step)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        add_to(member_reads, expression.name, step)
    }
}

func add_to(counts: Dictionary<String, Integer>, key: String, step: Integer) {
    var known = counts[key]
    if known {
        counts[key] = known + step
    } else {
        counts[key] = step
    }
}

func note_the_built_reads(function: HighIntermediaryRepresentation.HighFunction) {
    var printer = Printers.HighIntermediaryRepresentation.Printer(function)
    var text = printer.text()
    var lines = text.lines()
    lines.each(note_a_built_line)
}

func note_a_built_line(line: String) {
    var pieces = line.split(".")
    var index = 1
    while index < pieces.count() {
        var piece = pieces[index]
        var before = pieces[index - 1]
        crash before
        note_a_built_piece(piece, before, index == 1)
        index = index + 1
    }
}

func note_a_built_piece(piece: String, before: String, is_the_first: Boolean) {
    var name = leading_name(piece)
    assert name != ""
    var name_length = name.length()
    var piece_length = piece.length()
    var rest = piece.slice(name_length, piece_length)
    assert not rest.starts_with("(")
    var trimmed = before.trim()
    var is_a_write = rest.starts_with(" = ") and is_the_first and not trimmed.contains(" ")
    assert not is_a_write
    built_reads[name] = true
}

func leading_name(piece: String): String {
    var length = 0
    var piece_length = piece.length()
    var going = true
    while going and length < piece_length {
        var code = piece.code_at(length)
        going = is_a_name_code(code)
        if going {
            length = length + 1
        }
    }
    return piece.slice(0, length)
}

func is_a_name_code(code: Integer): Boolean {
    var is_a_letter = code >= 97 and code <= 122 or code >= 65 and code <= 90
    return is_a_letter or code >= 48 and code <= 57 or code == 95
}

func check_a_class(map: Mapping.FolderMap, model: Model.ClassModel, entry_path: String) {
    var path = model.file.path
    assert not checked_paths.contains(path)
    checked_paths.append(path)
    var library = Validators.LibraryFile()
    assert not library.holds(path)
    assert model.key != "Environment" and model.key != "Build"
    assert is_the_programs_own(map, path)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        check_an_attribute(model, attribute, entry_path)
        index = index + 1
    }
}

func is_the_programs_own(map: Mapping.FolderMap, path: String): Boolean {
    var program_root = map.roots.first()
    crash program_root
    if not map.inside(path, program_root.path) {
        return false
    }
    var index = 1
    while index < map.roots.count() {
        var root = map.roots[index]
        if map.inside(path, root.path) {
            return false
        }
        index = index + 1
    }
    return true
}

func check_an_attribute(model: Model.ClassModel, attribute: Model.AttributeModel, entry_path: String) {
    assert attribute.declaration
    var name = attribute.name
    assert not is_read(model.file.namespace, name) and not shape_members.contains(name)
    assert attribute.attribute_type.name != "ForeignCallback"
    var path = model.file.path
    var line = attribute.declaration.line
    var in_the_entry = path == entry_path
    assert is_earlier(path, line, in_the_entry)
    found_path = path
    found_line = line
    found_owner = plain_name(model.shown)
    found_name = name
    found_in_the_entry = in_the_entry
}

func is_read(namespace: String, name: String): Boolean {
    if built_reads[name] == true {
        return true
    }
    var members = member_reads[name]
    if members and members > 0 {
        return true
    }
    var names = name_reads["{namespace}|{name}"]
    if names {
        return names > 0
    }
    return false
}

func is_earlier(path: String, line: Integer, in_the_entry: Boolean): Boolean {
    if found_path == "" {
        return true
    }
    if in_the_entry != found_in_the_entry {
        return in_the_entry
    }
    if path != found_path {
        return path < found_path
    }
    return line < found_line
}

func plain_name(shown: String): String {
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

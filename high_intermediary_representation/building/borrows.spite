union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

union Type {
    AbstractSyntaxTree.Shapes.Types.NamedType
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var refusals = Validators.HighIntermediaryRepresentation.Borrows.Validator()
var library = Validators.LibraryFile()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var blocks = List<Borrow.Block>()
var held = List<BorrowedItem>()
var next_is_a_loop = false
var known_effects = Dictionary<String, List<String>>()
var following = List<String>()
var cut_short = 0
var known_lends = Dictionary<String, Borrow.Source>()
var lending_checked = List<String>()
var block_ended = false
var typing_depth = 0
var view = ScopeView()
var resizing_names = [
    "append"
    "prepend"
    "insert"
    "_reserve"
    "remove_at"
    "remove_first"
    "remove_last"
    "remove_swapping"
    "truncate"
    "swap"
    "clear"
    "_make_room"
]
var listing_names = ["append", "prepend", "insert", "set_at"]

func Borrows(starting_context: Context) {
    context = starting_context
}

func enter(written: List<Statement>) {
    if blocks.is_empty() {
        held = List<BorrowedItem>()
    }
    var block = Borrow.Block(written, next_is_a_loop)
    next_is_a_loop = false
    blocks.append(block)
}

func leave() {
    var depth = blocks.count() - 1
    var kept = List<BorrowedItem>()
    var index = 0
    while index < held.count() {
        var item = held[index]
        if item.depth < depth {
            kept.append(item)
        }
        index = index + 1
    }
    held = kept
    crash blocks.remove_last()
}

func function_key(): String {
    return "{context.current_class.key}.{context.current_function.name}"
}

func is_checked(): Boolean {
    var function = context.current_function
    fallback function.declaration
    fallback not function.is_synthetic and not function.is_a_walk_copy
    var path = context.path()
    return not library.holds(path)
}

func check(index: Integer) {
    var top = blocks.last()
    crash top
    top.index = index
    fallback is_checked()
    var statement = top.statements[index]
    crash statement
    var frame = Borrow.Frame(context.current_class, context.current_function)
    frame.is_the_built_function = true
    frame.line = statement.line
    check_the_resizes(frame, statement)
    check_the_lends(frame, statement)
    check_the_keeping(frame, statement)
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        note_a_declaration(frame, statement, index)
    }
}

func live_items(): List<BorrowedItem> {
    var key = function_key()
    var live = List<BorrowedItem>()
    var index = 0
    while index < held.count() {
        var item = held[index]
        if item.function_key == key {
            live.append(item)
        }
        index = index + 1
    }
    return live
}

func held_named(name: String): BorrowedItem? {
    var live = live_items()
    var index = live.count() - 1
    while index >= 0 {
        var item = live[index]
        crash item
        if item.name == name {
            return item
        }
        index = index - 1
    }
    return null
}

func held_of(expression: Expression?): BorrowedItem? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return held_named(expression.name)
    }
    return null
}

func first_source(item: BorrowedItem): Borrow.Source {
    var source = item.sources[0]
    crash source
    return source
}

func sources_text(item: BorrowedItem): String {
    var written = List<String>()
    var index = 0
    while index < item.sources.count() {
        var source = item.sources[index]
        var quoted = "'{source.written}'"
        if not written.contains(quoted) {
            written.append(quoted)
        }
        index = index + 1
    }
    var count = written.count()
    if count == 1 {
        var only = written[0]
        crash only
        return only
    }
    var last = written[count - 1]
    crash last
    var others = List<String>()
    var index = 0
    while index < count - 1 {
        var other = written[index]
        crash other
        others.append(other)
        index = index + 1
    }
    var joined = others.join(", ")
    return "{joined} and {last}"
}

func printed(expression: Expression?): String {
    fallback expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    return printer.text()
}

func own_parts_of(statement: Statement): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.IfStatement: walk.read_expression(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: walk.read_expression(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: walk.read_expression(statement.value)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: walk.read_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return walk
        AbstractSyntaxTree.Shapes.Statements.Block: return walk
    }
    return walk
}

func check_the_resizes(frame: Borrow.Frame, statement: Statement) {
    var live = live_items()
    fallback not live.is_empty()
    var walk = own_parts_of(statement)
    var index = 0
    while index < live.count() {
        var item = live[index]
        check_an_item_past(frame, statement, walk, item)
        index = index + 1
    }
}

func check_an_item_past(
    frame: Borrow.Frame,
    statement: Statement,
    walk: AbstractSyntaxTree.Walk.Walk,
    item: BorrowedItem,
) {
    var index = 0
    while index < item.sources.count() {
        var source = item.sources[index]
        var resizer = resizer_of(frame, statement, walk, source)
        if not resizer.is_empty() and is_read_after(item.name, item.depth) {
            context.line = statement.line
            refuse_a_read_past(item, source, resizer)
        }
        index = index + 1
    }
}

func refuse_a_read_past(item: BorrowedItem, source: Borrow.Source, resizer: String) {
    if item.is_row {
        refusals.refuse_a_row_read_past_a_resize(context, item.name, source, resizer)
    }
    refusals.refuse_a_read_past_a_resize(context, item.name, source, resizer)
}

func resizer_of(
    frame: Borrow.Frame,
    statement: Statement,
    walk: AbstractSyntaxTree.Walk.Walk,
    source: Borrow.Source,
): String {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var effects = effects_of_expression(frame, found.expression)
        if reaches(effects, source) {
            return resizer_text(found.expression)
        }
        index = index + 1
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var assigned = assignment_effects(frame, statement)
        if reaches(assigned, source) {
            return printed(statement.target)
        }
    }
    return ""
}

func resizer_text(expression: Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var callee = printed(expression.callee)
        return "{callee}()"
    }
    return printed(expression)
}

func is_read_after(name: String, depth: Integer): Boolean {
    var level = blocks.count() - 1
    while level >= depth and level >= 0 {
        var block = blocks[level]
        crash block
        var count = block.statements.count()
        if level > depth and block.is_a_loop and names_in(block.statements, 0, count, name) {
            return true
        }
        if names_in(block.statements, block.index + 1, count, name) {
            return true
        }
        level = level - 1
    }
    return false
}

func names_in(
    statements: List<Statement>,
    from: Integer,
    to: Integer,
    name: String,
): Boolean {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var index = from
    while index < to {
        var statement = statements[index]
        crash statement
        walk.read_statement(statement)
        index = index + 1
    }
    var found_index = 0
    while found_index < walk.expressions.count() {
        var found = walk.expressions[found_index]
        if is_the_name(found.expression, name) {
            return true
        }
        found_index = found_index + 1
    }
    return false
}

func is_the_name(expression: Expression?, name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func reaches(effects: List<String>, source: Borrow.Source): Boolean {
    var index = 0
    while index < effects.count() {
        var effect = effects[index]
        if matches(effect, source) {
            return true
        }
        index = index + 1
    }
    return false
}

func matches(effect: String, source: Borrow.Source): Boolean {
    if effect == "anything" {
        return true
    }
    var key = key_part(effect)
    var collection = collection_part(effect)
    if key == source.key {
        return true
    }
    var is_by_class = key == "anything" or key.starts_with("element:")
    var is_a_named_vector = source.key.starts_with("local:") or source.key.starts_with("param:")
    if is_a_named_vector and not key.starts_with("local:") {
        is_by_class = true
    }
    return is_by_class and not collection.is_empty() and collection == source.collection
}

func key_part(effect: String): String {
    var at = effect.index_of("|")
    if not at {
        return effect
    }
    var sliced = effect.slice(0, at)
    crash sliced
    return sliced
}

func collection_part(effect: String): String {
    var at = effect.index_of("|")
    fallback at
    var length = effect.length()
    var sliced = effect.slice(at + 1, length)
    crash sliced
    return sliced
}

func add_effects(found: List<String>, more: List<String>) {
    var index = 0
    while index < more.count() {
        var effect = more[index]
        if not found.contains(effect) {
            found.append(effect)
        }
        index = index + 1
    }
}

func anything(): List<String> {
    var found = List<String>()
    found.append("anything")
    return found
}

func effects_of_expression(
    frame: Borrow.Frame,
    expression: Expression?,
): List<String> {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return effects_of_call(frame, expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return effects_of_holes(frame, expression)
    }
    return List<String>()
}

func effects_of_holes(frame: Borrow.Frame, text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): List<String> {
    var found = List<String>()
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        if piece.hole {
            var shown = effects_of_a_member_on(frame, piece.hole, "to_string")
            add_effects(found, shown)
        }
        index = index + 1
    }
    return found
}

func effects_of_a_member_on(
    frame: Borrow.Frame,
    value: Expression?,
    name: String,
): List<String> {
    var no_arguments = List<Expression>()
    var value_type = type_of(frame, value)
    if not value_type {
        return effects_of_every(frame, name, no_arguments)
    }
    var present = value_type.present()
    if present.kind == 'shape' or present.kind == 'union' {
        return effects_of_every(frame, name, no_arguments)
    }
    var model = program_class_of(present)
    fallback model
    var function = model.function_named(name)
    fallback function
    return effects_through(frame, model, function, no_arguments)
}

func program_class_of(of_type: Model.Type): Model.ClassModel? {
    fallback of_type.kind == 'object'
    var model = context.program.class_named(of_type.name)
    fallback model
    fallback not library.holds(model.file.path)
    return model
}

func class_of_type(of_type: Model.Type): Model.ClassModel? {
    fallback of_type.kind == 'object'
    return context.program.class_named(of_type.name)
}

func effects_of_call(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): List<String> {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return effects_of_a_named_call(frame, call, callee)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return effects_of_a_member_call(frame, call, callee)
    }
    return List<String>()
}

func effects_of_a_named_call(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): List<String> {
    if callee.is_a_class_name {
        return effects_of_a_construction(frame, call)
    }
    var named_type = type_of_a_name(frame, callee.name)
    if named_type and named_type.kind == 'function' {
        return anything()
    }
    var function = frame.model.function_named(callee.name)
    if function {
        return effects_through(frame, frame.model, function, call.arguments)
    }
    return List<String>()
}

func effects_of_a_construction(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<String> {
    var made = constructed_type(frame, call)
    fallback made
    var model = program_class_of(made)
    fallback model
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.is_constructor {
            return effects_through(frame, model, function, call.arguments)
        }
        index = index + 1
    }
    return List<String>()
}

func effects_of_a_member_call(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): List<String> {
    if callee.is_a_class_name {
        return effects_of_a_construction(frame, call)
    }
    var receiver = type_of(frame, callee.target)
    if not receiver {
        return effects_of_every(frame, callee.name, call.arguments)
    }
    var present = receiver.present()
    if present.kind == 'function' {
        return anything()
    }
    if present.kind == 'shape' or present.kind == 'union' {
        return effects_of_every(frame, callee.name, call.arguments)
    }
    var model = class_of_type(present)
    fallback model
    var function = model.function_named(callee.name)
    if function and is_a_program_function(model, function) {
        return effects_through(frame, model, function, call.arguments)
    }
    if library.holds(model.file.path) {
        return effects_of_a_library_call(frame, call, callee, model)
    }
    var attribute = model.attribute_named(callee.name)
    if attribute and attribute.attribute_type.kind == 'function' {
        return anything()
    }
    return List<String>()
}

func is_a_program_function(model: Model.ClassModel, function: Model.FunctionModel): Boolean {
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var path = declaration.path
    if path.is_empty() {
        path = model.file.path
    }
    return not library.holds(path)
}

func is_resizing(name: String): Boolean {
    return resizing_names.contains(name) or name.starts_with("remove_where")
}

func is_removing(name: String): Boolean {
    var removing = ["remove_at", "remove_first", "remove_last", "remove_swapping", "truncate", "clear", "remove"]
    return removing.contains(name) or name.starts_with("remove_where")
}

func is_a_borrowing_collection(model: Model.ClassModel): Boolean {
    var namespace = model.file.namespace
    return namespace == "Vector" or namespace == "Items"
}

func effects_of_a_library_call(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    model: Model.ClassModel,
): List<String> {
    var found = List<String>()
    if is_a_borrowing_collection(model) and is_resizing(callee.name) {
        var key = key_of_collection(frame, callee.target)
        found.append("{key}|{model.key}")
    } else if is_removing(callee.name) {
        var seen = List<String>()
        add_the_collections_reached_through(found, model, seen)
    }
    var function = model.function_named(callee.name)
    if not function {
        return found
    }
    if listing_names.contains(callee.name) {
        return found
    }
    var handed = effects_of_the_handed_arguments(frame, call, function)
    add_effects(found, handed)
    return found
}

func effects_of_the_handed_arguments(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: Model.FunctionModel,
): List<String> {
    var found = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var parameter = parameter_at(function, index)
        if parameter {
            var handed = effects_of_a_handed_argument(frame, argument, parameter)
            add_effects(found, handed)
        }
        index = index + 1
    }
    return found
}

func parameter_at(function: Model.FunctionModel, index: Integer): Model.ParameterModel? {
    var count = function.parameters.count()
    fallback count != 0
    if index < count {
        return function.parameters[index]
    }
    var last = function.parameters[count - 1]
    crash last
    if last.is_variadic {
        return last
    }
    return null
}

func effects_of_a_handed_argument(
    frame: Borrow.Frame,
    argument: Expression,
    parameter: Model.ParameterModel,
): List<String> {
    var wanted = handed_type(parameter)
    fallback wanted
    var present = wanted.present()
    if present.kind == 'shape' {
        return effects_of_a_shape_argument(frame, argument, present)
    }
    if present.kind == 'function' {
        return effects_of_a_function_argument(frame, argument)
    }
    return List<String>()
}

func handed_type(parameter: Model.ParameterModel): Model.Type? {
    if parameter.is_variadic {
        return element_of(parameter.parameter_type)
    }
    return parameter.parameter_type
}

func element_of(collection: Model.Type): Model.Type? {
    var model = class_of_type(collection)
    fallback model
    return model.bound_types["$element_type"]
}

func effects_of_a_shape_argument(
    frame: Borrow.Frame,
    argument: Expression,
    shape_type: Model.Type,
): List<String> {
    var found = List<String>()
    var shape = context.program.shape_keyed(shape_type.name)
    if not shape {
        return found
    }
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if not member.is_an_attribute {
            var reached = effects_of_a_member_on(frame, argument, member.name)
            add_effects(found, reached)
        }
        index = index + 1
    }
    return found
}

func effects_of_a_function_argument(
    frame: Borrow.Frame,
    argument: Expression,
): List<String> {
    var no_arguments = List<Expression>()
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var function = frame.model.function_named(argument.name)
        if function {
            return effects_through(frame, frame.model, function, no_arguments)
        }
        return anything()
    }
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return effects_of_a_member_on(frame, argument.target, argument.name)
    }
    return anything()
}

func effects_of_every(
    frame: Borrow.Frame,
    name: String,
    arguments: List<Expression>,
): List<String> {
    var found = List<String>()
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var function = model.function_named(name)
        if function {
            add_the_program_effects(found, frame, model, function, arguments)
        }
        index = index + 1
    }
    return found
}

func add_the_program_effects(
    found: List<String>,
    frame: Borrow.Frame,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    arguments: List<Expression>,
) {
    fallback is_a_program_function(model, function)
    var reached = effects_through(frame, model, function, arguments)
    add_effects(found, reached)
}

func effects_through(
    frame: Borrow.Frame,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    arguments: List<Expression>,
): List<String> {
    var own = effects_of_function(model, function)
    var mapped = List<String>()
    var index = 0
    while index < own.count() {
        var effect = own[index]
        var placed = placed_effect(frame, effect, arguments)
        if not mapped.contains(placed) {
            mapped.append(placed)
        }
        index = index + 1
    }
    return mapped
}

func placed_effect(
    frame: Borrow.Frame,
    effect: String,
    arguments: List<Expression>,
): String {
    if not effect.starts_with("param:") {
        return effect
    }
    var key = key_part(effect)
    var collection = collection_part(effect)
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        if key == "param:{index}" {
            var placed = key_of_collection(frame, argument)
            return "{placed}|{collection}"
        }
        index = index + 1
    }
    return "anything|{collection}"
}

func effects_of_function(model: Model.ClassModel, function: Model.FunctionModel): List<String> {
    var key = "{model.key}.{function.name}"
    var known = known_effects[key]
    if known {
        return known
    }
    var found = List<String>()
    if following.contains(key) {
        cut_short = cut_short + 1
        return found
    }
    if not function.declaration {
        return found
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return found
    }
    following.append(key)
    var cut_before = cut_short
    var frame = Borrow.Frame(model, function)
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    note_the_locals(frame, walk)
    var index = 0
    while index < walk.expressions.count() {
        var expression = walk.expressions[index]
        frame.line = expression.line
        var reached = effects_of_expression(frame, expression.expression)
        add_the_kept_effects(found, reached)
        index = index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var statement = walk.statements[statement_index]
        add_the_assigned_effects(found, frame, statement.statement)
        statement_index = statement_index + 1
    }
    crash following.remove_last()
    if cut_short == cut_before or following.is_empty() {
        known_effects[key] = found
    }
    return found
}

func add_the_kept_effects(found: List<String>, reached: List<String>) {
    var index = 0
    while index < reached.count() {
        var effect = reached[index]
        if not effect.starts_with("local:") and not found.contains(effect) {
            found.append(effect)
        }
        index = index + 1
    }
}

func add_the_assigned_effects(
    found: List<String>,
    frame: Borrow.Frame,
    statement: Statement?,
) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var assigned = assignment_effects(frame, statement)
        add_the_kept_effects(found, assigned)
    }
}

func note_the_locals(frame: Borrow.Frame, walk: AbstractSyntaxTree.Walk.Walk) {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
            frame.locals[statement.name] = statement
        }
        index = index + 1
    }
}

func assignment_effects(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
): List<String> {
    var found = List<String>()
    var target = statement.target
    var assigned_type = type_of(frame, target)
    if not assigned_type {
        return found
    }
    var model = class_of_type(assigned_type)
    if not model {
        return found
    }
    if not is_a_borrowing_collection(model) {
        add_the_held_collections(found, model)
        return found
    }
    var key = key_of_collection(frame, target)
    found.append("{key}|{model.key}")
    return found
}

# ../../PROOFS.md#no-borrowed-read-past-a-resize
func add_the_held_collections(found: List<String>, model: Model.ClassModel) {
    var seen = List<String>()
    add_the_collections_held_by(found, model, seen)
}

func add_the_collections_held_by(found: List<String>, model: Model.ClassModel, seen: List<String>) {
    fallback not seen.contains(model.key) and not model.is_singleton
    seen.append(model.key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var attribute_type = attribute.attribute_type.present()
        var held = class_of_type(attribute_type)
        if held and is_a_borrowing_collection(held) {
            found.append("{model.key}.{attribute.name}|{held.key}")
        } else if held {
            add_the_collections_reached_through(found, held, seen)
        }
        index = index + 1
    }
}

func add_the_collections_reached_through(found: List<String>, held: Model.ClassModel, seen: List<String>) {
    if not library.holds(held.file.path) {
        add_the_collections_held_by(found, held, seen)
        return
    }
    var names = held.bound_types.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = held.bound_types[name]
        crash bound
        var bound_present = bound.present()
        var item = class_of_type(bound_present)
        if item and not library.holds(item.file.path) {
            add_the_collections_held_by(found, item, seen)
        }
        index = index + 1
    }
}

func is_a_local(frame: Borrow.Frame, name: String): Boolean {
    if parameter_index(frame, name) >= 0 {
        return true
    }
    if frame.is_the_built_function and view.internal_name_of(name) {
        return true
    }
    return frame.locals.contains(name)
}

func parameter_index(frame: Borrow.Frame, name: String): Integer {
    var index = 0
    while index < frame.function.parameters.count() {
        var parameter = frame.function.parameters[index]
        if parameter.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func key_of_collection(frame: Borrow.Frame, expression: Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return key_of_a_name(frame, expression.name)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return key_of_a_member(frame, expression)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        var element = type_of(frame, expression)
        if element {
            return "element:{element.name}"
        }
    }
    return "anything"
}

func key_of_a_name(frame: Borrow.Frame, name: String): String {
    var at = parameter_index(frame, name)
    if at >= 0 {
        return "param:{at}"
    }
    if is_a_local(frame, name) {
        return "local:{name}"
    }
    if frame.model.attribute_named(name) {
        return "{frame.model.key}.{name}"
    }
    return "anything"
}

func key_of_a_member(frame: Borrow.Frame, member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var owner = type_of(frame, member.target)
    if not owner {
        return "anything"
    }
    var present = owner.present()
    if present.kind != 'object' {
        return "anything"
    }
    return "{present.name}.{member.name}"
}

func type_of(frame: Borrow.Frame, expression: Expression?): Model.Type? {
    fallback typing_depth < 24
    typing_depth = typing_depth + 1
    var found = type_of_a_value(frame, expression)
    typing_depth = typing_depth - 1
    return found
}

func type_of_a_value(frame: Borrow.Frame, expression: Expression?): Model.Type? {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return type_of_an_identifier(frame, expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return type_of_a_member(frame, expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return type_of_an_index(frame, expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return type_of_a_call(frame, expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return context.text()
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return type_of_a_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return type_of(frame, expression.left)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return null
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return null
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return null
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return null
    }
    return null
}

func type_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Model.Type? {
    fallback literal.kind != 'keyword_null'
    return context.scalar_type("Integer")
}

func type_of_an_identifier(
    frame: Borrow.Frame,
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Model.Type? {
    fallback not identifier.is_a_class_name
    return type_of_a_name(frame, identifier.name)
}

func type_of_a_name(frame: Borrow.Frame, name: String): Model.Type? {
    if frame.is_the_built_function {
        var internal_name = view.internal_name_of(name)
        if internal_name {
            return view.type_of(internal_name)
        }
    }
    var at = parameter_index(frame, name)
    if at >= 0 {
        var parameter = frame.function.parameters[at]
        crash parameter
        return parameter.parameter_type
    }
    var local = frame.locals[name]
    if local {
        return type_of_a_local(frame, local)
    }
    var attribute = frame.model.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func type_of_a_local(frame: Borrow.Frame, local: AbstractSyntaxTree.Shapes.Statements.VariableStatement): Model.Type? {
    if local.declared_type {
        return type_of_a_written(frame, local.declared_type, local.line)
    }
    return type_of(frame, local.value)
}

func type_of_a_written(frame: Borrow.Frame, written: Type, line: Integer): Model.Type? {
    var first = written.path[0]
    crash first
    var initial = first.slice(0, 1)
    crash initial
    var is_plain = initial == "$" or initial != initial.lower_case()
    fallback is_plain and are_plain_arguments(written.arguments)
    return context.resolver.type_in(written, frame.model, line)
}

func are_plain_arguments(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): Boolean {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        fallback not argument.text.contains("attribute.") and not argument.text.contains("argument.")
        index = index + 1
    }
    return true
}

func type_of_a_member(frame: Borrow.Frame, member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Model.Type? {
    var owner = type_of(frame, member.target)
    fallback owner
    var present = owner.present()
    if present.kind == 'shape' {
        return shape_member_type(present, member.name)
    }
    var model = class_of_type(present)
    fallback model
    var attribute = model.attribute_named(member.name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func shape_member_type(shape_type: Model.Type, name: String): Model.Type? {
    var shape = context.program.shape_keyed(shape_type.name)
    fallback shape
    var member = shape.member_named(name)
    fallback member
    fallback member.is_an_attribute
    return member.answer
}

func type_of_an_index(frame: Borrow.Frame, index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Model.Type? {
    var collection = type_of(frame, index.target)
    fallback collection
    var present = collection.present()
    return element_of(present)
}

func type_of_a_call(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return type_of_a_named_call(frame, call, callee)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return type_of_a_member_call(frame, call, callee)
    }
    return null
}

func type_of_a_named_call(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): Model.Type? {
    if callee.is_a_class_name {
        return constructed_type(frame, call)
    }
    var function = frame.model.function_named(callee.name)
    if function {
        return function.answer
    }
    return null
}

func type_of_a_member_call(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Model.Type? {
    if callee.is_a_class_name {
        return constructed_type(frame, call)
    }
    var owner = type_of(frame, callee.target)
    fallback owner
    var present = owner.present()
    var model = class_of_type(present)
    fallback model
    var function = model.function_named(callee.name)
    if function {
        return function.answer
    }
    return null
}

func constructed_type(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.Type? {
    var inference = NameResolution.Inference()
    var path = inference.class_path_of(call.callee)
    fallback not path.is_empty() and are_plain_arguments(call.generic_arguments)
    if call.generic_arguments.is_empty() {
        var written = path.join(".")
        var found = context.resolver.symbols.find(written, frame.model.file.namespace)
        fallback found
        var plain = context.program.class_named(found.namespace)
        fallback plain
        return plain.type_of_an_instance()
    }
    var made = context.resolver.class_type_in(path, call.generic_arguments, frame.model, frame.line)
    fallback made.kind == 'object'
    return made
}

func fits_a_vector(element: Model.Type): Boolean {
    var values = Values(context)
    return values.fits_a_vector(element)
}

func lends_its_items(collection: Model.ClassModel, element: Model.Type): Boolean {
    if collection.file.namespace == "Items" {
        return fits_a_vector(element)
    }
    var is_an_object = element.kind == 'object' and element.name != "String"
    return is_an_object and context.has_a_class(element)
}

func source_of_collection(
    frame: Borrow.Frame,
    target: Expression?,
): Borrow.Source? {
    var collection_type = type_of(frame, target)
    fallback collection_type
    var present = collection_type.present()
    var model = class_of_type(present)
    fallback model
    fallback is_a_borrowing_collection(model) and library.holds(model.file.path)
    var element = model.bound_types["$element_type"]
    fallback element
    var element_present = element.present()
    fallback lends_its_items(model, element_present)
    var written = printed(target)
    var key = key_of_collection(frame, target)
    var source = Borrow.Source(written, key, model.key)
    source.element = context.shown(element_present)
    source.is_items = model.file.namespace == "Items"
    source.is_lent = held_by_a_singleton(frame, target)
    return source
}

func held_by_a_singleton(frame: Borrow.Frame, target: Expression?): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var holder_type = type_of(frame, target.target)
        fallback holder_type
        var holder = class_of_type(holder_type)
        fallback holder
        return holder.is_singleton
    }
    return false
}

func borrowed_read(frame: Borrow.Frame, expression: Expression?): Borrow.Source? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return source_of_collection(frame, expression.target)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return borrowed_by_a_call(frame, expression)
    }
    return null
}

func borrowed_by_a_call(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Borrow.Source? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and (callee.name == "get_at" or callee.name.starts_with("find_by_")) {
        return source_of_collection(frame, callee.target)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and (callee.name == "get_at" or callee.name.starts_with("find_by_")) {
        return own_item_source(frame)
    }
    return lent_source(frame, call)
}

func own_item_source(frame: Borrow.Frame): Borrow.Source? {
    var model = frame.model
    fallback is_a_borrowing_collection(model) and library.holds(model.file.path)
    var element = model.bound_types["$element_type"]
    fallback element
    var element_present = element.present()
    fallback lends_its_items(model, element_present)
    var source = Borrow.Source("this", "this", model.key)
    source.element = context.shown(element_present)
    source.is_items = model.file.namespace == "Items"
    return source
}

func collection_read_by(
    expression: Expression?,
): Expression? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return expression.target
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return collection_read_by_a_call(expression)
    }
    return null
}

func collection_read_by_a_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Expression? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and (callee.name == "get_at" or callee.name.starts_with("find_by_")) {
        return callee.target
    }
    return null
}

func called_function_of(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Model.FunctionModel? {
    var model = called_class_of(frame, call)
    fallback model
    var callee = call.callee
    var name = ""
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        name = callee.name
    }
    var function = model.function_named(name)
    fallback function
    fallback is_a_program_function(model, function)
    return function
}

func called_class_of(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Model.ClassModel? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback not callee.is_a_class_name and not is_a_local(frame, callee.name)
        return frame.model
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback not callee.is_a_class_name
        return called_member_class_of(frame, callee)
    }
    return null
}

# ../../PROOFS.md#an-item-lent-to-a-call
func lent_class_of(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Model.ClassModel? {
    if is_a_construction(call) {
        var made = constructed_type(frame, call)
        fallback made
        return class_of_type(made)
    }
    return called_class_of(frame, call)
}

func is_a_construction(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.is_a_class_name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.is_a_class_name
    }
    return false
}

func lent_function_of(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): Model.FunctionModel? {
    var model = lent_class_of(frame, call)
    fallback model
    var name = called_name_of(call)
    var function = model.function_named(name)
    fallback function
    fallback is_a_program_function(model, function)
    return function
}

func called_member_class_of(
    frame: Borrow.Frame,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Model.ClassModel? {
    var owner = type_of(frame, callee.target)
    fallback owner
    var present = owner.present()
    return class_of_type(present)
}

func lent_source(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Borrow.Source? {
    var model = called_class_of(frame, call)
    fallback model
    var function = called_function_of(frame, call)
    fallback function
    return lends(model, function)
}

func lends(model: Model.ClassModel, function: Model.FunctionModel): Borrow.Source? {
    var key = "{model.key}.{function.name}"
    if lending_checked.contains(key) {
        return known_lends[key]
    }
    lending_checked.append(key)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var returns = List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>()
    collect_returns(model, declaration.body, returns)
    var index = 0
    while index < returns.count() {
        var returned = returns[index]
        var source = storage_read(model, returned.value)
        if source {
            known_lends[key] = source
            refuse_another_lent_return(model, function, returns, source)
            return source
        }
        index = index + 1
    }
    return null
}

func refuse_another_lent_return(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
    source: Borrow.Source,
) {
    var index = 0
    while index < returns.count() {
        var returned = returns[index]
        var is_stored = storage_read(model, returned.value)
        if not is_stored and not is_a_null(returned.value) {
            var other = printed(returned.value)
            enter_the_lent_function(model, function, returned.line)
            refusals.refuse_another_lent_return(context, function.name, source, other)
        }
        index = index + 1
    }
}

func is_a_null(value: Expression?): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return value.kind == 'keyword_null'
    }
    return false
}

func collect_returns(
    model: Model.ClassModel,
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
) {
    block_ended = false
    fallback block
    var index = 0
    while index < block.statements.count() and not block_ended {
        var statement = block.statements[index]
        collect_from_a_statement(model, statement, returns)
        index = index + 1
    }
}

func collect_from_a_statement(
    model: Model.ClassModel,
    statement: Statement,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: collect_a_return(statement, returns)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: collect_from_an_if(model, statement, returns)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: collect_from_a_loop(model, statement.body, returns)
        AbstractSyntaxTree.Shapes.Statements.Block: collect_from_a_loop(model, statement, returns)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func collect_a_return(
    statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
) {
    returns.append(statement)
    block_ended = true
}

func collect_from_a_loop(
    model: Model.ClassModel,
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
) {
    collect_returns(model, block, returns)
    block_ended = false
}

func collect_from_an_if(
    model: Model.ClassModel,
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    returns: List<AbstractSyntaxTree.Shapes.Statements.ReturnStatement>,
) {
    var decided = folded(model, statement.condition)
    if decided == 1 {
        collect_returns(model, statement.then_branch, returns)
        return
    }
    if decided == 0 {
        collect_returns(model, statement.else_branch, returns)
        return
    }
    collect_returns(model, statement.then_branch, returns)
    var then_ended = block_ended
    collect_returns(model, statement.else_branch, returns)
    block_ended = then_ended and block_ended
}

func folded(model: Model.ClassModel, condition: Expression?): Integer {
    if not condition {
        return -1
    }
    switch condition {
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return folded_negation(model, condition)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return folded_binary(model, condition)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return folded_question(model, condition)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return -1
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return -1
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return -1
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return -1
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return -1
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return -1
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return -1
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return -1
    }
    return -1
}

func folded_negation(
    model: Model.ClassModel,
    negation: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
): Integer {
    if negation.operator != 'not' {
        return -1
    }
    var inner = folded(model, negation.operand)
    if inner < 0 {
        return -1
    }
    return 1 - inner
}

func folded_binary(model: Model.ClassModel, binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    if binary.operator == 'and' or binary.operator == 'or' {
        return folded_logic(model, binary)
    }
    if binary.operator == 'equal_equal' {
        return folded_comparison(model, binary.left, binary.right)
    }
    if binary.operator == 'not_equal' {
        var compared = folded_comparison(model, binary.left, binary.right)
        if compared < 0 {
            return -1
        }
        return 1 - compared
    }
    return -1
}

func folded_logic(model: Model.ClassModel, binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    var left = folded(model, binary.left)
    var right = folded(model, binary.right)
    if binary.operator == 'and' {
        fallback left != 0 and right != 0
        if left == 1 and right == 1 {
            return 1
        }
        return -1
    }
    if left == 1 or right == 1 {
        return 1
    }
    fallback left != 0 or right != 0
    return -1
}

func folded_comparison(
    model: Model.ClassModel,
    left: Expression?,
    right: Expression?,
): Integer {
    var bound = bound_class_of(model, left)
    if not bound {
        return -1
    }
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and right.is_a_class_name {
        return same_class(bound, right.name)
    }
    return -1
}

func same_class(bound: Model.Type, name: String): Integer {
    if bound.name == name or bound.name.ends_with(".{name}") {
        return 1
    }
    return 0
}

func bound_class_of(
    model: Model.ClassModel,
    expression: Expression?,
): Model.Type? {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name.starts_with("$") {
        return model.bound_types[expression.name]
    }
    return null
}

func folded_question(model: Model.ClassModel, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Integer {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "fits_vector" {
        return folded_fit(model, callee.target)
    }
    return -1
}

func folded_fit(model: Model.ClassModel, asked: Expression?): Integer {
    var bound = bound_class_of(model, asked)
    if not bound {
        return -1
    }
    var is_plain = bound.kind == 'scalar' or bound.kind == 'enumeration'
    if is_plain or fits_a_vector(bound) {
        return 1
    }
    return 0
}

func storage_read(model: Model.ClassModel, value: Expression?): Borrow.Source? {
    var collection: Expression? = null
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        collection = value.target
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        collection = collection_read_by_a_call(value)
    }
    if collection.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return storage_of(model, collection.name)
    }
    if collection.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return storage_through(model, collection)
    }
    return null
}

func storage_through(
    model: Model.ClassModel,
    collection: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Borrow.Source? {
    var holder = collection.target
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var attribute = model.attribute_named(holder.name)
        if attribute {
            var holding = attribute.attribute_type
            var held_model = class_of_type(holding)
            if held_model {
                return storage_of(held_model, collection.name)
            }
        }
    }
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return storage_made_in_place(model, holder, collection.name)
    }
    return null
}

func storage_made_in_place(
    model: Model.ClassModel,
    made: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): Borrow.Source? {
    var callee = made.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback callee.is_a_class_name
        fallback context.resolver.symbols.is_a_singleton(callee.name, model.file.namespace)
        var written = printed(made)
        var source = Borrow.Source("{written}.{name}", "{callee.name}.{name}", callee.name)
        source.is_lent = true
        return source
    }
    return null
}

func storage_of(holder: Model.ClassModel, name: String): Borrow.Source? {
    fallback holder.is_singleton
    var attribute = holder.attribute_named(name)
    fallback attribute
    var model = class_of_type(attribute.attribute_type)
    fallback model
    fallback is_a_borrowing_collection(model)
    var element = model.bound_types["$element_type"]
    fallback element
    var element_present = element.present()
    fallback lends_its_items(model, element_present)
    var source = Borrow.Source("{holder.shown}().{name}", "{holder.key}.{name}", model.key)
    source.element = context.shown(element_present)
    source.is_items = model.file.namespace == "Items"
    source.is_lent = true
    return source
}

func check_the_lends(frame: Borrow.Frame, statement: Statement) {
    var walk = own_parts_of(statement)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            check_a_lending_call(frame, statement, expression)
        }
        index = index + 1
    }
}

func check_a_lending_call(
    frame: Borrow.Frame,
    statement: Statement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        check_a_lent_argument(frame, statement, call, argument, index)
        index = index + 1
    }
}

func check_a_lent_argument(
    frame: Borrow.Frame,
    statement: Statement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    argument: Expression,
    position: Integer,
) {
    var sources = List<Borrow.Source>()
    var item = held_of(argument)
    if item {
        fallback not item.is_row
        sources = item.sources
    } else {
        var read = borrowed_read(frame, argument)
        if read {
            sources.append(read)
        }
    }
    fallback not sources.is_empty()
    context.line = statement.line
    fallback is_a_followed_lend(frame, call, position)
    var function = lent_function_of(frame, call)
    fallback function
    var effects = effects_of_call(frame, call)
    var callee = printed(call.callee)
    var name = printed(argument)
    var index = 0
    while index < sources.count() {
        var source = sources[index]
        if reaches(effects, source) {
            context.line = statement.line
            refusals.refuse_a_resizing_lend(context, name, source, function.name, "{callee}()")
        }
        index = index + 1
    }
    var model = lent_class_of(frame, call)
    crash model
    var no_row = BorrowedItem("", 0, "")
    check_the_lent_body(model, function, position, statement.line, no_row)
}

# ../../PROOFS.md#an-item-lent-to-a-call
func is_a_followed_lend(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    position: Integer,
): Boolean {
    var model = lent_class_of(frame, call)
    fallback model
    var called_name = called_name_of(call)
    var function = model.function_named(called_name)
    fallback function
    var parameter = parameter_at(function, position)
    fallback parameter
    fallback not parameter.is_variadic and parameter.parameter_type.kind != 'union'
    var is_a_listing = listing_names.contains(called_name) and is_a_list_model(model)
    return is_a_program_function(model, function) or is_a_listing
}

func is_a_list_model(model: Model.ClassModel): Boolean {
    return model.file.namespace == "List" and library.holds(model.file.path)
}

func called_name_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.name
    }
    return ""
}

func check_the_lent_body(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    position: Integer,
    call_line: Integer,
    row: BorrowedItem,
) {
    fallback function.declaration
    var parameter = parameter_at(function, position)
    fallback parameter
    fallback not parameter.is_variadic
    var lent = LentParameter(parameter.name, function.name, call_line, context.current_function.name)
    lent.row = row
    lent.parameter_type = parameter.parameter_type
    lent.model = model
    lent.function = function
    context.lent_bodies.append(lent)
}

func enter_the_lent_function(model: Model.ClassModel, function: Model.FunctionModel, line: Integer) {
    context.current_class = model
    context.current_function = function
    context.line = line
}

func check_the_keeping(frame: Borrow.Frame, statement: Statement) {
    context.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: check_an_assignment(frame, statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: check_a_named_value(frame, statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: check_a_return(frame, statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.IfStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: context.line = statement.line
        AbstractSyntaxTree.Shapes.Statements.Block: context.line = statement.line
    }
    check_the_listing(frame, statement)
}

func check_an_assignment(frame: Borrow.Frame, statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = statement.target
    var assigned = held_of(target)
    if assigned {
        refuse_an_assigned(assigned)
    }
    check_a_function_value(statement.value)
    var item = held_of(statement.value)
    if item {
        check_a_kept_item(frame, target, item)
        return
    }
    fallback not is_a_local_target(frame, target)
    var read = borrowed_read(frame, statement.value)
    fallback read
    var name = printed(statement.value)
    check_a_kept_read(frame, target, name, read)
}

func refuse_an_assigned(item: BorrowedItem) {
    var sources = sources_text(item)
    if item.is_row {
        refusals.refuse_an_assigned_row(context, item.name, sources)
    }
    var source = first_source(item)
    refusals.refuse_an_assigned_item(context, item.name, source)
}

func is_a_local_target(frame: Borrow.Frame, target: Expression?): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return is_a_local(frame, target.name)
    }
    return false
}

func check_a_kept_item(
    frame: Borrow.Frame,
    target: Expression?,
    item: BorrowedItem,
) {
    var sources = sources_text(item)
    var source = first_source(item)
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if is_a_local(frame, target.name) {
            refuse_a_second_name(item, target.name)
        }
        fallback frame.model.attribute_named(target.name)
        refuse_a_kept(item, sources, source, target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refuse_a_kept(item, sources, source, target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        fallback is_a_list(frame, target.target)
        refuse_a_listed(item)
    }
}

func refuse_a_kept(item: BorrowedItem, sources: String, source: Borrow.Source, attribute: String) {
    if item.is_row {
        refusals.refuse_a_kept_row(context, item.name, sources, attribute)
    }
    refusals.refuse_a_kept_item(context, item.name, source, attribute)
}

func refuse_a_listed(item: BorrowedItem) {
    if item.is_row {
        var sources = sources_text(item)
        refusals.refuse_a_listed_row(context, item.name, sources)
    }
    var source = first_source(item)
    refusals.refuse_a_listed_item(context, item.name, source)
}

func refuse_a_second_name(item: BorrowedItem, alias: String) {
    if item.is_row {
        var sources = sources_text(item)
        refusals.refuse_a_second_row_name(context, item.name, sources, alias)
    }
    var source = first_source(item)
    refusals.refuse_a_second_name(context, item.name, source, alias)
}

func check_a_kept_read(
    frame: Borrow.Frame,
    target: Expression?,
    name: String,
    read: Borrow.Source,
) {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback frame.model.attribute_named(target.name)
        refusals.refuse_a_kept_item(context, name, read, target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refusals.refuse_a_kept_item(context, name, read, target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        fallback is_a_list(frame, target.target)
        refusals.refuse_a_listed_item(context, name, read)
    }
}

func is_a_list(frame: Borrow.Frame, listed: Expression?): Boolean {
    var listed_type = type_of(frame, listed)
    fallback listed_type
    var present = listed_type.present()
    var model = class_of_type(present)
    fallback model
    return model.file.namespace == "List" and library.holds(model.file.path)
}

func check_a_named_value(frame: Borrow.Frame, statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    refuse_a_lending_function_value(frame, statement.value)
    check_a_function_value(statement.value)
    var item = held_of(statement.value)
    fallback item
    refuse_a_second_name(item, statement.name)
}

func refuse_a_lending_function_value(frame: Borrow.Frame, value: Expression?) {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refuse_a_lending_member(frame, value)
    }
}

func refuse_a_lending_member(frame: Borrow.Frame, member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback not member.is_a_class_name
    var owner = type_of(frame, member.target)
    fallback owner
    var present = owner.present()
    var model = class_of_type(present)
    fallback model
    var function = model.function_named(member.name)
    fallback function
    fallback is_a_program_function(model, function)
    var source = lends(model, function)
    fallback source
    refusals.refuse_a_lending_function_value(context, function.name, source)
}

func check_a_function_value(value: Expression?) {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_bound_member(value)
    }
}

func check_a_bound_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var item = held_of(member.target)
    fallback item
    fallback not item.is_row
    var source = first_source(item)
    var internal_name = view.internal_name_of(item.name)
    fallback internal_name
    var local_type = view.type_of(internal_name)
    fallback local_type
    var present = local_type.present()
    var model = class_of_type(present)
    fallback model
    fallback model.function_named(member.name)
    refusals.refuse_a_function_value(context, item.name, member.name, source)
}

func check_a_return(frame: Borrow.Frame, statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var item = held_of(statement.value)
    if item {
        refuse_a_returned(item)
    }
    var read = borrowed_read(frame, statement.value)
    fallback read
    fallback not storage_read(frame.model, statement.value)
    var name = printed(statement.value)
    refusals.refuse_a_returned_item(context, name, read)
}

# ../../PROOFS.md#an-item-lent-to-the-caller
func refuse_a_returned(item: BorrowedItem) {
    if item.is_row {
        refuse_a_returned_row(item)
        return
    }
    var source = first_source(item)
    refusals.refuse_a_returned_item(context, item.name, source)
}

func refuse_a_returned_row(item: BorrowedItem) {
    fallback not item.sources.all(is_singleton_storage)
    var sources = sources_text(item)
    refusals.refuse_a_returned_row(context, item.name, sources)
}

func is_singleton_storage(source: Borrow.Source): Boolean {
    return source.is_lent
}

func check_the_listing(frame: Borrow.Frame, statement: Statement) {
    var walk = own_parts_of(statement)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            check_a_listing_call(frame, expression)
        }
        index = index + 1
    }
}

func check_a_listing_call(frame: Borrow.Frame, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_listing_member(frame, call, callee)
    }
}

func check_a_listing_member(
    frame: Borrow.Frame,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback listing_names.contains(callee.name) and is_a_list(frame, callee.target)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        check_a_listed_argument(frame, argument)
        index = index + 1
    }
}

func check_a_listed_argument(frame: Borrow.Frame, argument: Expression) {
    var item = held_of(argument)
    if item {
        refuse_a_listed(item)
    }
    var read = borrowed_read(frame, argument)
    fallback read
    var name = printed(argument)
    refusals.refuse_a_listed_item(context, name, read)
}

func note_a_declaration(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    index: Integer,
) {
    forget_the_name(statement.name)
    fallback statement.value
    var source = borrowed_read(frame, statement.value)
    if source {
        check_an_unkept_collection(statement)
        refuse_a_reused_name(statement, index, source)
        var item = made_item(statement.name)
        item.sources.append(source)
        held.append(item)
        return
    }
    note_a_row(frame, statement, statement.value, index)
}

func note_a_row(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    value: Expression?,
    index: Integer,
) {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        note_a_row_literal(frame, statement, value, index)
        return
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and value.kind == 'keyword_null' and statement.declared_type {
        note_a_walked_row(frame, statement, index)
    }
}

func refuse_a_reused_name(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    index: Integer,
    source: Borrow.Source,
) {
    var top = blocks.last()
    crash top
    var earlier = 0
    var reused = false
    while earlier < index and earlier < top.statements.count() {
        var before = top.statements[earlier]
        if before.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
            reused = reused or before.name == statement.name
        }
        earlier = earlier + 1
    }
    fallback reused
    refusals.refuse_a_reused_name(context, statement.name, source)
}

func forget_the_name(name: String) {
    var key = function_key()
    var kept = List<BorrowedItem>()
    var index = 0
    while index < held.count() {
        var item = held[index]
        if item.name != name or item.function_key != key {
            kept.append(item)
        }
        index = index + 1
    }
    held = kept
}

func made_item(name: String): BorrowedItem {
    var depth = blocks.count() - 1
    var key = function_key()
    return BorrowedItem(name, depth, key)
}

func check_an_unkept_collection(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var collection = collection_read_by(statement.value)
    if collection.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var written = printed(collection)
        refusals.refuse_an_unkept_collection(context, statement.name, written)
    }
}

func note_a_row_literal(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    index: Integer,
) {
    var row = made_item(statement.name)
    row.is_row = true
    var pair_index = 0
    while pair_index < literal.pairs.count() {
        var pair = literal.pairs[pair_index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            add_a_row_source(frame, row, pair.value)
        }
        pair_index = pair_index + 1
    }
    fallback not row.sources.is_empty()
    refuse_a_kept_value_in_a_row(frame, statement, literal)
    held.append(row)
    check_the_row_calls(frame, row, index + 1)
}

func refuse_a_kept_value_in_a_row(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
) {
    var pair_index = 0
    while pair_index < literal.pairs.count() {
        var pair = literal.pairs[pair_index]
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            refuse_a_kept_entry(frame, statement, pair)
        }
        pair_index = pair_index + 1
    }
}

func refuse_a_kept_entry(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    pair: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral,
) {
    fallback not held_of(pair.value)
    fallback not borrowed_read(frame, pair.value)
    var entry_type = type_of(frame, pair.value)
    fallback entry_type
    var present = entry_type.present()
    fallback present.kind == 'object' or present.kind == 'union' or present.kind == 'shape'
    var shown = context.shown(present)
    var key = printed(pair.key)
    refusals.refuse_a_kept_value_in_a_row(context, statement.name, key, shown)
}

func add_a_row_source(frame: Borrow.Frame, row: BorrowedItem, value: Expression?) {
    var item = held_of(value)
    if item {
        add_the_sources(row, item.sources)
        return
    }
    var read = borrowed_read(frame, value)
    fallback read
    row.sources.append(read)
}

func add_the_sources(row: BorrowedItem, sources: List<Borrow.Source>) {
    var index = 0
    while index < sources.count() {
        var source = sources[index]
        row.sources.append(source)
        index = index + 1
    }
}

func check_the_row_calls(frame: Borrow.Frame, row: BorrowedItem, from: Integer) {
    var top = blocks.last()
    crash top
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var index = from
    while index < top.statements.count() {
        var statement = top.statements[index]
        walk.read_statement(statement)
        index = index + 1
    }
    note_the_locals(frame, walk)
    var found_index = 0
    while found_index < walk.expressions.count() {
        var found = walk.expressions[found_index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            frame.line = found.line
            check_a_row_call(frame, row, expression, found.line)
        }
        found_index = found_index + 1
    }
}

func check_a_row_call(
    frame: Borrow.Frame,
    row: BorrowedItem,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    line: Integer,
) {
    fallback passes_the_row(call, row.name)
    refuse_a_row_passed_to_a_value(frame, row, call, line)
    var effects = effects_of_call(frame, call)
    var callee = printed(call.callee)
    var index = 0
    while index < row.sources.count() {
        var source = row.sources[index]
        if reaches(effects, source) {
            context.line = line
            refusals.refuse_a_resizing_row_call(context, row.name, source, "{callee}()")
        }
        index = index + 1
    }
    var model = called_class_of(frame, call)
    fallback model
    var function = called_function_of(frame, call)
    fallback function
    var position = row_position(call, row.name)
    check_the_lent_body(model, function, position, line, row)
}

func row_position(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Integer {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if is_the_name(argument, name) {
            return index
        }
        index = index + 1
    }
    return 0
}

func refuse_a_row_passed_to_a_value(
    frame: Borrow.Frame,
    row: BorrowedItem,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    line: Integer,
) {
    var callee = call.callee
    var is_a_value_call = false
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        is_a_value_call = is_a_local(frame, callee.name)
    }
    fallback is_a_value_call
    context.line = line
    var sources = sources_text(row)
    refusals.refuse_a_row_passed_to_a_value(context, row.name, sources)
}

func passes_the_row(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if is_the_name(argument, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func note_a_walked_row(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    index: Integer,
) {
    var top = blocks.last()
    crash top
    fallback index + 1 < top.statements.count()
    var next = top.statements[index + 1]
    if next.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var walk_call = next.value
        if walk_call.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            note_a_walk(frame, statement, walk_call, index)
        }
    }
}

func note_a_walk(
    frame: Borrow.Frame,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    walk_call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    index: Integer,
) {
    var plural = printed(walk_call.callee)
    var is_a_name = not plural.contains(".") and not plural.contains("(") and not plural.contains("<")
    fallback is_a_name and plural.ends_with("s") and not walk_call.arguments.is_empty()
    var first = walk_call.arguments[0]
    fallback is_the_name(first, statement.name)
    var plural_length = plural.length()
    var singular = plural.slice(0, plural_length - 1)
    crash singular
    var template = context.current_class.function_named(singular)
    fallback template
    fallback template.is_a_member_template and template.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = template.declaration
    fallback declaration.parameters.count() == walk_call.arguments.count() + 1 and declaration.body
    var symbol = declaration.parameters[template.template_index]
    crash symbol
    crash statement.declared_type
    var row_type = context.resolver.type_in(statement.declared_type, context.current_class, statement.line)
    fallback row_type.kind == 'shape'
    var shape = context.program.shape_keyed(row_type.name)
    fallback shape
    var template_frame = Borrow.Frame(context.current_class, template)
    template_frame.line = statement.line
    var row = made_item(statement.name)
    row.is_row = true
    var member_index = 0
    while member_index < shape.members.count() {
        var member = shape.members[member_index]
        add_a_walked_source(template_frame, row, declaration.body, symbol.name, member)
        member_index = member_index + 1
    }
    fallback not row.sources.is_empty()
    held.append(row)
    check_the_row_calls(frame, row, index + 2)
}

func add_a_walked_source(
    template_frame: Borrow.Frame,
    row: BorrowedItem,
    body: AbstractSyntaxTree.Shapes.Statements.Block?,
    symbol: String,
    member: Model.FunctionModel,
) {
    fallback member.is_an_attribute and member.answer
    var member_type: Model.Type = member.answer
    var fill = filled_value(body, symbol, member_type)
    fallback fill
    if fill.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        var source = walked_collection(template_frame, fill.target, symbol, member.name, member_type)
        if source {
            row.sources.append(source)
        }
    }
}

func filled_value(
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    symbol: String,
    member_type: Model.Type,
): Expression? {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        var found = filled_by(statement, symbol, member_type)
        if found {
            return found
        }
        index = index + 1
    }
    return null
}

func filled_by(
    statement: Statement?,
    symbol: String,
    member_type: Model.Type,
): Expression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement and is_an_attributes_read(statement.target, symbol) {
        return statement.value
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        return filled_by_a_choice(statement, symbol, member_type)
    }
    return null
}

func filled_by_a_choice(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    symbol: String,
    member_type: Model.Type,
): Expression? {
    var decided = folded_for_an_attribute(statement.condition, symbol, member_type)
    if decided == 1 {
        return filled_value(statement.then_branch, symbol, member_type)
    }
    if decided == 0 {
        return filled_value(statement.else_branch, symbol, member_type)
    }
    return null
}

func folded_for_an_attribute(
    condition: Expression?,
    symbol: String,
    member_type: Model.Type,
): Integer {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return folded_attribute_comparison(condition, symbol, member_type)
    }
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return folded_attribute_fit(condition, symbol, member_type)
    }
    return -1
}

func folded_attribute_comparison(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    symbol: String,
    member_type: Model.Type,
): Integer {
    var is_a_comparison = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    if not is_a_comparison or not is_the_class_of(binary.left, symbol) {
        return -1
    }
    var right = binary.right
    var compared = -1
    if right.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        compared = same_class(member_type, right.name)
    }
    if compared < 0 or binary.operator == 'equal_equal' {
        return compared
    }
    return 1 - compared
}

func folded_attribute_fit(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    symbol: String,
    member_type: Model.Type,
): Integer {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "fits_vector" and is_the_class_of(callee.target, symbol) {
        return fit_of(member_type)
    }
    return -1
}

func fit_of(member_type: Model.Type): Integer {
    if fits_a_vector(member_type) {
        return 1
    }
    return 0
}

func is_the_class_of(expression: Expression?, symbol: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return expression.name == "class" and is_the_name(expression.target, symbol)
    }
    return false
}

func is_an_attributes_read(expression: Expression?, symbol: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return is_the_name(expression.index, symbol) and is_named_attributes(expression.target)
    }
    return false
}

func is_named_attributes(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return expression.name == "attributes"
    }
    return false
}

func walked_collection(
    template_frame: Borrow.Frame,
    collection: Expression?,
    symbol: String,
    member_name: String,
    member_type: Model.Type,
): Borrow.Source? {
    if collection.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        fallback is_an_attributes_read(collection, symbol)
        var attributes = collection.target
        if attributes.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
            return walked_path(template_frame, attributes.target, member_name)
        }
    }
    if collection.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_singleton(collection, member_type)
    }
    return null
}

func walked_path(
    template_frame: Borrow.Frame,
    holder: Expression?,
    member_name: String,
): Borrow.Source? {
    var holder_type = type_of(template_frame, holder)
    fallback holder_type
    var present = holder_type.present()
    var model = class_of_type(present)
    fallback model
    var path = printed(holder)
    var key = "{model.key}.{member_name}"
    return walked_source_of(model, member_name, "{path}.{member_name}", key)
}

func walked_singleton(
    collection: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    member_type: Model.Type,
): Borrow.Source? {
    var made = collection.target
    if made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var callee = made.callee
        if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            return walked_instance(callee.name, collection.name, member_type)
        }
    }
    return null
}

func walked_instance(class_name: String, attribute_name: String, member_type: Model.Type): Borrow.Source? {
    var argument = context.shown(member_type)
    var wanted = "{class_name}<{argument}>"
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        if model.shown == wanted {
            var written = "{model.shown}().{attribute_name}"
            var key = "{model.key}.{attribute_name}"
            return walked_source_of(model, attribute_name, written, key)
        }
        index = index + 1
    }
    return null
}

func walked_source_of(holder: Model.ClassModel, name: String, written: String, key: String): Borrow.Source? {
    var attribute = holder.attribute_named(name)
    fallback attribute
    var model = class_of_type(attribute.attribute_type)
    fallback model
    fallback is_a_borrowing_collection(model)
    var element = model.bound_types["$element_type"]
    fallback element
    var element_present = element.present()
    fallback lends_its_items(model, element_present)
    var source = Borrow.Source(written, key, model.key)
    source.element = context.shown(element_present)
    source.is_items = model.file.namespace == "Items"
    source.is_lent = holder.is_singleton
    return source
}

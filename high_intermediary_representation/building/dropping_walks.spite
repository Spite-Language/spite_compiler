# ../../../spite_documentation/failure.md#an-answer-is-used

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)

func DroppingWalks(starting_context: Context) {
    context = starting_context
}

func check_a_walk(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    owner: Model.ClassModel,
    function: Model.FunctionModel,
) {
    var binding = function.binding_or_empty()
    fallback not binding.member.is_empty() and function.template_index() >= 0
    fallback binding.member_is_a_function
    fallback binding.member_type and function.declaration
    var answer = binding.member_type
    var dropped = Validators.HighIntermediaryRepresentation.DroppedAnswer.Validator()
    var dropped_answer = dropped.check_a_walk(context, call, owner, function, answer, this)
    context.tell(dropped_answer)
}

func drops_each_answer(owner: Model.ClassModel, function: Model.FunctionModel): Boolean {
    fallback function.declaration
    var index = function.template_index()
    var passed = List<String>()
    return drops_its_member(owner, function.declaration, index, passed)
}

func drops_its_member(
    owner: Model.ClassModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    index: Integer,
    passed: List<String>,
): Boolean {
    var parameter = declaration.parameters[index]
    fallback parameter and declaration.body
    return drops_in_block(owner, declaration.body, parameter.name, passed)
}

func drops_in_block(
    owner: Model.ClassModel,
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    member: String,
    passed: List<String>,
): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement and drops_in(owner, statement, member, passed) {
            return true
        }
        index = index + 1
    }
    return false
}

func drops_in(
    owner: Model.ClassModel,
    statement: SpiteCompiler.WrittenStatement,
    member: String,
    passed: List<String>,
): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        return drops_by_the_value(owner, statement.value, member, passed)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        return drops_in_block(owner, statement.body, member, passed)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        if drops_in_block(owner, statement.then_branch, member, passed) {
            return true
        }
        return drops_in_block(owner, statement.else_branch, member, passed)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.Block {
        return drops_in_block(owner, statement, member, passed)
    }
    return false
}

func drops_by_the_value(
    owner: Model.ClassModel,
    value: SpiteCompiler.Expression?,
    member: String,
    passed: List<String>,
): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and value.name == "value" {
        return reads_the_member(value.target, member)
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return drops_when_passed(owner, value, member, passed)
    }
    return false
}

func drops_when_passed(
    owner: Model.ClassModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    member: String,
    passed: List<String>,
): Boolean {
    if call.callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return drops_when_passed_to(owner, call.callee.name, call.arguments, member, passed)
    }
    return false
}

func drops_when_passed_to(
    owner: Model.ClassModel,
    called_name: String,
    arguments: List<SpiteCompiler.Expression>,
    member: String,
    passed: List<String>,
): Boolean {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_the_callee = template.name == called_name and template.is_a_member_template()
        var position = template.template_index()
        if is_the_callee and template.declaration and position < arguments.count() {
            var handed = arguments[position]
            var place = template.key()
            if names(handed, member) {
                fallback not passed.contains(place)
                return drops_in_the_template(owner, template.declaration, position, passed, place)
            }
        }
        index = index + 1
    }
    return false
}

# ../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func drops_in_the_template(
    owner: Model.ClassModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    index: Integer,
    passed: List<String>,
    place: String,
): Boolean {
    passed.append(place)
    var drops = drops_its_member(owner, declaration, index, passed)
    crash passed.remove_last()
    return drops
}

func reads_the_member(indexed: SpiteCompiler.Expression?, member: String): Boolean {
    if indexed.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return lists_the_attributes(indexed.target) and names(indexed.index, member)
    }
    return false
}

func lists_the_attributes(listed: SpiteCompiler.Expression?): Boolean {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return listed.name == "attributes"
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return listed.name == "attributes"
    }
    return false
}

func names(expression: SpiteCompiler.Expression?, member: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == member
    }
    return false
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

# ../../../spite_spec/specs/failure.md#an-answer-is-used
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var deepest_forward = 8

func DroppingWalks(starting_context: Context) {
    context = starting_context
}

func refuse(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    owner: Model.ClassModel,
    function: Model.FunctionModel,
) {
    fallback not function.bound_member.is_empty() and function.template_index >= 0
    fallback function.bound_member_is_a_function
    fallback function.bound_member_type and function.declaration
    fallback not function.bound_member_type.is_nothing()
    fallback drops_its_member(owner, function.declaration, function.template_index, 0)
    var printer = Printers.Spite.ExpressionPrinter(call)
    var written = printer.text()
    var dropped = Validators.HighIntermediaryRepresentation.DroppedAnswer.Validator()
    dropped.refuse_a_dropping_walk(
        context,
        written,
        function.bound_member,
        function.bound_member_type,
    )
}

func drops_its_member(
    owner: Model.ClassModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    index: Integer,
    depth: Integer,
): Boolean {
    var parameter = declaration.parameters[index]
    fallback parameter and declaration.body and depth <= deepest_forward
    return drops_in_block(owner, declaration.body, parameter.name, depth)
}

func drops_in_block(
    owner: Model.ClassModel,
    block: AbstractSyntaxTree.Shapes.Statements.Block?,
    member: String,
    depth: Integer,
): Boolean {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement and drops_in(owner, statement, member, depth) {
            return true
        }
        index = index + 1
    }
    return false
}

func drops_in(
    owner: Model.ClassModel,
    statement: Statement,
    member: String,
    depth: Integer,
): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        return drops_by_the_value(owner, statement.value, member, depth)
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        return drops_in_block(owner, statement.body, member, depth)
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        if drops_in_block(owner, statement.then_branch, member, depth) {
            return true
        }
        return drops_in_block(owner, statement.else_branch, member, depth)
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.Block {
        return drops_in_block(owner, statement, member, depth)
    }
    return false
}

func drops_by_the_value(
    owner: Model.ClassModel,
    value: Expression?,
    member: String,
    depth: Integer,
): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return names(value.index, member)
    }
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return drops_when_passed(owner, value, member, depth)
    }
    return false
}

func drops_when_passed(
    owner: Model.ClassModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    member: String,
    depth: Integer,
): Boolean {
    if call.callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return drops_when_passed_to(owner, call.callee.name, call.arguments, member, depth)
    }
    return false
}

func drops_when_passed_to(
    owner: Model.ClassModel,
    called_name: String,
    arguments: List<Expression>,
    member: String,
    depth: Integer,
): Boolean {
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_the_callee = template.name == called_name and template.is_a_member_template
        var position = template.template_index
        if is_the_callee and template.declaration and position < arguments.count() {
            var passed = arguments[position]
            if names(passed, member) {
                return drops_its_member(owner, template.declaration, position, depth + 1)
            }
        }
        index = index + 1
    }
    return false
}

func names(expression: Expression?, member: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == member
    }
    return false
}

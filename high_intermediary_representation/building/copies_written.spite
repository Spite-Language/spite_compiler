var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var described_names = DescribedNames()
var inference = NameResolution.Inference()
var sites_of_files = Dictionary<String, List<CopySite>>()
var sites = List<CopySite>()
var line = 0
var copies = List<String>()

func CopiesWritten(starting_context: Context) {
    context = starting_context
}

# ../../../spite_documentation/reflection.md#every-class-in-the-program
func made(): List<String> {
    copies = List<String>()
    var folder_map = context.resolver.state.symbols.map
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        if described_names.is_the_programs(model.file.path, folder_map) and not model.is_an_object_literal {
            make_the_copies_of(model)
        }
        index = index + 1
    }
    return copies
}

# ../../../spite_documentation/reflection.md#every-class-in-the-program
func copies_of_the_file(path: String): List<String> {
    var found = List<String>()
    var written = context.program_classes
    if not context.program_classes_listed {
        written = made()
    }
    var index = 0
    while index < written.count() {
        var key = written[index]
        var model = context.program.class_named(key)
        if model and model.file.path == path and not model.bound_types.is_empty() {
            found.append(key)
        }
        index = index + 1
    }
    return found
}

func make_the_copies_of(model: Model.ClassModel) {
    var found = sites_of(model.file)
    var index = 0
    while index < found.count() {
        var site = found[index]
        make_a_copy(model, site)
        index = index + 1
    }
}

func make_a_copy(model: Model.ClassModel, site: CopySite) {
    fallback names_a_template_of_the_program(model, site.named.path)
    fallback every_argument_is_known(model, site.named.arguments, false)
    var copy_type = context.resolver.types.class_type_in(site.named.path, site.named.arguments, model, site.line)
    fallback not copies.contains(copy_type.name)
    copies.append(copy_type.name)
}

func names_a_template_of_the_program(model: Model.ClassModel, path: List<String>): Boolean {
    var symbols = context.resolver.state.symbols
    var written = path.join(".")
    var found = symbols.find(written, model.file.namespace)
    fallback found
    fallback described_names.is_the_programs(found.path, symbols.map)
    var file = symbols.file_for(found.path)
    fallback file
    return context.resolver.monomorphiser.is_a_template(file)
}

# ../../../spite_documentation/reflection.md#every-class-in-the-program
func every_argument_is_known(
    model: Model.ClassModel,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    is_inside: Boolean,
): Boolean {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        fallback is_a_known_argument(model, argument, is_inside)
        index = index + 1
    }
    return true
}

func is_a_known_argument(
    model: Model.ClassModel,
    argument: AbstractSyntaxTree.Shapes.Types.GenericArgument,
    is_inside: Boolean,
): Boolean {
    var reference = argument.type_reference
    fallback argument.is_type and reference
    fallback reference.class == AbstractSyntaxTree.Shapes.Types.NamedType
    fallback reference.asked.is_empty()
    var first = reference.path[0]
    crash first
    if first.starts_with("$") {
        var is_whole = reference.path.count() == 1 and reference.arguments.is_empty()
        return is_whole and not is_inside and model.bound_types.contains(first)
    }
    fallback names_a_class(model, reference.path)
    return every_argument_is_known(model, reference.arguments, true)
}

func names_a_class(model: Model.ClassModel, path: List<String>): Boolean {
    var written = path.join(".")
    if context.resolver.state.symbols.find(written, model.file.namespace) {
        return true
    }
    if context.scalars.of(written) {
        return true
    }
    if context.resolver.types.declared_type_in(path, model) {
        return true
    }
    return false
}

func sites_of(file: AbstractSyntaxTree.Shapes.SourceFile): List<CopySite> {
    var known = sites_of_files[file.path]
    if known {
        return known
    }
    sites = List<CopySite>()
    var walk = AbstractSyntaxTree.Walk.Walk(file)
    file.declarations.each(take_a_declaration)
    walk.statements.each(take_a_statement)
    walk.expressions.each(take_an_expression)
    sites_of_files[file.path] = sites
    return sites
}

func take_a_declaration(declaration: SpiteCompiler.Declaration) {
    line = context.resolver.state.symbols.line_of(declaration)
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: declaration.members.each(take_a_member)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: take_a_type(declaration.declared_type)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: take_a_function(declaration)
    }
}

func take_a_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    member.parameters.each(take_a_parameter)
    take_a_type(member.result)
}

func take_a_function(function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    function.parameters.each(take_a_parameter)
    take_a_type(function.result)
}

func take_a_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    take_a_type(parameter.declared_type)
}

func take_a_type(written: SpiteCompiler.Type?) {
    fallback written
    switch written {
        AbstractSyntaxTree.Shapes.Types.NamedType: take_a_named_type(written)
    }
}

func take_a_named_type(named: AbstractSyntaxTree.Shapes.Types.NamedType) {
    named.arguments.each(take_an_argument)
    fallback not named.arguments.is_empty()
    var site = CopySite(named, line)
    sites.append(site)
}

func take_an_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    fallback argument.is_type
    take_a_type(argument.type_reference)
}

func take_a_statement(found: AbstractSyntaxTree.Walk.Found.Statement) {
    fallback found.statement
    fallback found.statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    line = found.statement.line
    take_a_type(found.statement.declared_type)
}

func take_an_expression(found: AbstractSyntaxTree.Walk.Found.Expression) {
    fallback found.expression
    line = found.line
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var callee_path = inference.class_path_of(found.expression.callee)
        take_a_written_class(callee_path, found.expression.generic_arguments)
    }
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var identifier_path = inference.class_path_of(found.expression)
        take_a_written_class(identifier_path, found.expression.generic_arguments)
    }
    if found.expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member_path = inference.class_path_of(found.expression)
        take_a_written_class(member_path, found.expression.generic_arguments)
    }
}

func take_a_written_class(path: List<String>, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>) {
    arguments.each(take_an_argument)
    fallback not path.is_empty() and not arguments.is_empty()
    var named = AbstractSyntaxTree.Shapes.Types.NamedType(path, arguments)
    var site = CopySite(named, line)
    sites.append(site)
}

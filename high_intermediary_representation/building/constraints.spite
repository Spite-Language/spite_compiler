var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var made = Model.ClassModel("", "", no_file)
var this_names = List<String>()
var attribute_names = List<String>()

func Constraints(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func check(starting_made: Model.ClassModel) {
    made = starting_made
    made.file.declarations.each(check_declaration)
    note_a_vector()
    check_the_dictionary_keys()
    check_the_written_form()
}

func note_a_vector() {
    fallback made.shown.starts_with("Vector<")
    var site = VectorSite(made, context.current_class, context.current_function, context.line)
    context.vector_sites.append(site)
}

func check_the_dictionary_keys() {
    fallback made.shown.starts_with("Dictionary<")
    var key = made.bound_types["$key_type"]
    fallback key
    var rule = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()
    rule.check_a_dictionary_key(context, key)
}

func check_the_written_form() {
    var format_classes = ["BinaryWriter", "BinaryReader", "JsonWriter", "JsonReader"]
    var plain = plain_class_name(made.shown)
    fallback format_classes.contains(plain)
    var written = made.bound_types["$value_type"]
    fallback written
    var is_binary = plain.starts_with("Binary")
    var shown = context.shown(written)
    var what = values.plain_name_of(shown)
    var seen = List<String>()
    var reason = unwritable_reason(written, what, is_binary, seen)
    var rule = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()
    rule.check_a_written_form(context, plain, what, reason)
}

func plain_class_name(shown: String): String {
    var opening = shown.index_of("<")
    if not opening {
        return shown
    }
    var sliced = shown.slice(0, opening)
    crash sliced
    return sliced
}

func unwritable_reason(written: Model.Type, path: String, is_binary: Boolean, seen: List<String>): String {
    var present = written.present()
    var shown = context.shown(present)
    fallback not seen.contains(shown)
    seen.append(shown)
    if present.kind == 'union' {
        var union_name = values.plain_name_of(shown)
        var not_said = said_by(is_binary)
        return "'{path}' is the union {union_name}, and {not_said} which member a value is"
    }
    if present.kind == 'shape' or present.kind == 'function' {
        var form = form_of(is_binary)
        return "'{path}' is a {shown}, which has no {form} form"
    }
    fallback present.kind == 'object' and present.name != "String" and context.has_a_class(present)
    var model = context.class_of(present)
    if shown.starts_with("Dictionary<") {
        return dictionary_reason(model, path, is_binary, seen)
    }
    var is_a_list = shown.starts_with("List<") or shown.starts_with("Vector<") or shown.starts_with("Items<")
    if is_a_list {
        return element_reason(model, path, is_binary, seen)
    }
    fallback not model.is_singleton and not shown.contains("<")
    return attributes_reason(model, is_binary, seen)
}

func said_by(is_binary: Boolean): String {
    if is_binary {
        return "the bytes do not say"
    }
    return "JSON does not say"
}

func form_of(is_binary: Boolean): String {
    if is_binary {
        return "binary"
    }
    return "JSON"
}

func element_reason(model: Model.ClassModel, path: String, is_binary: Boolean, seen: List<String>): String {
    var element = model.bound_types["$element_type"]
    fallback element
    return unwritable_reason(element, path, is_binary, seen)
}

func dictionary_reason(model: Model.ClassModel, path: String, is_binary: Boolean, seen: List<String>): String {
    var key = model.bound_types["$key_type"]
    var value = model.bound_types["$value_type"]
    crash key and value
    var is_an_object_key = key.kind == 'object' and key.name != "String"
    if is_an_object_key {
        var key_shown = context.shown(key)
        var key_name = values.plain_name_of(key_shown)
        var form = form_of(is_binary)
        return "its dictionary is keyed by '{key_name}' objects, each key one object's identity, which has no {form} form"
    }
    return unwritable_reason(value, path, is_binary, seen)
}

func attributes_reason(model: Model.ClassModel, is_binary: Boolean, seen: List<String>): String {
    var owner = values.plain_name_of(model.shown)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var is_private = attribute.name.starts_with("_")
        var reason = ""
        if not is_private {
            reason = unwritable_reason(attribute.attribute_type, "{owner}.{attribute.name}", is_binary, seen)
        }
        if not reason.is_empty() {
            return reason
        }
        index = index + 1
    }
    return ""
}

func fits_a_vector(element: Model.Type): Boolean {
    var is_an_object = element.kind == 'object' and not element.is_nullable and element.name != "String"
    fallback is_an_object and context.has_a_class(element)
    var held = context.class_of(element)
    fallback not held.function_named("drop")
    var index = 0
    while index < held.declared_attributes.count() {
        var attribute = held.declared_attributes[index]
        fallback is_kept_inline(attribute.attribute_type)
        index = index + 1
    }
    return not uses_this_as_a_value(held)
}

func is_kept_inline(held: Model.Type): Boolean {
    if held.kind == 'scalar' or held.kind == 'enumeration' {
        return true
    }
    fallback held.kind == 'object'
    if held.name == "String" {
        return true
    }
    fallback context.has_a_class(held)
    var model = context.class_of(held)
    return model.is_singleton
}

func uses_this_as_a_value(held: Model.ClassModel): Boolean {
    var escaping = function_using_this_as_a_value(held)
    return not escaping.is_empty()
}

func function_using_this_as_a_value(held: Model.ClassModel): String {
    this_names = List<String>()
    attribute_names = List<String>()
    held.declared_attributes.each(note_an_attribute_name)
    var walk = AbstractSyntaxTree.Walk.Walk(held.file)
    walk.statements.each(note_an_alias)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if escapes_by_a_statement(found.statement, found.function_name) {
            return found.function_name
        }
        index = index + 1
    }
    var expression_index = 0
    while expression_index < walk.expressions.count() {
        var found_expression = walk.expressions[expression_index]
        var function_name = found_expression.function_name
        if escapes_by_an_expression(found_expression.expression, function_name) {
            return function_name
        }
        expression_index = expression_index + 1
    }
    return ""
}

func note_an_attribute_name(attribute: Model.AttributeModel) {
    attribute_names.append(attribute.name)
}

func note_an_alias(found: AbstractSyntaxTree.Walk.Found.Statement) {
    note_a_statement_alias(found.statement, found.function_name)
}

func note_a_statement_alias(statement: SpiteCompiler.WrittenStatement?, function_name: String) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        note_a_named_this(statement.name, statement.value, function_name)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        note_an_assigned_this(statement.target, statement.value, function_name)
    }
}

func note_an_assigned_this(target: SpiteCompiler.Expression?, value: SpiteCompiler.Expression?, function_name: String) {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        note_a_named_this(target.name, value, function_name)
    }
}

func note_a_named_this(name: String, value: SpiteCompiler.Expression?, function_name: String) {
    var is_a_local = not attribute_names.contains(name)
    if is_a_local and is_this_in(value, function_name) {
        this_names.append("{function_name}|{name}")
    }
}

func is_this_in(expression: SpiteCompiler.Expression?, function_name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return this_names.contains("{function_name}|{expression.name}")
    }
    return is_this(expression)
}

func escapes_by_a_statement(statement: SpiteCompiler.WrittenStatement?, function_name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return is_this_in(statement.value, function_name)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return stores_this(statement, function_name)
    }
    return false
}

func stores_this(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, function_name: String): Boolean {
    var stored = is_this_in(statement.value, function_name)
    return stored and is_a_kept_place(statement.target)
}

func is_a_kept_place(target: SpiteCompiler.Expression?): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return attribute_names.contains(target.name)
    }
    return true
}

func escapes_by_an_expression(expression: SpiteCompiler.Expression?, function_name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return any_this_in(expression.arguments, function_name)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return any_this_in(expression.entries, function_name)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
        return is_this_in(expression.value, function_name)
    }
    return false
}

func any_this_in(expressions: List<SpiteCompiler.Expression>, function_name: String): Boolean {
    var index = 0
    while index < expressions.count() {
        var expression = expressions[index]
        if is_this_in(expression, function_name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_this(expression: SpiteCompiler.Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'keyword_this'
    }
    return false
}

func check_declaration(declaration: SpiteCompiler.Declaration) {
    if declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
        check_a_constraint(declaration)
    }
}

func check_a_constraint(declared: AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration) {
    fallback declared.bound
    var given = made.bound_types[declared.name]
    fallback given
    fallback not given.is_a_walked_name
    fallback given.kind != 'union' and given.kind != 'shape'
    var wanted = context.resolver.types.type_in(declared.bound, made, declared.line)
    fallback wanted.kind == 'shape' and wanted.name != "Anything"
    var wanted_parts = wanted.name.split(".")
    var shape_name = wanted_parts.last()
    crash shape_name
    var owner = owner_name()
    var rule = Validators.HighIntermediaryRepresentation.GenericConstraint.Validator()
    rule.check_a_nullable_fit(context, given, shape_name, owner, declared.name)
    var shape = context.program.shape_keyed(wanted.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        var filled = is_filled(given, member)
        rule.check_a_filled_member(context, filled, given, shape.name, owner, declared.name, member.name)
        check_the_member_types(given, member, shape)
        index = index + 1
    }
}

func owner_name(): String {
    var plain = plain_class_name(made.shown)
    var segments = plain.split(".")
    var owner = segments.last()
    crash owner
    return owner
}

# ../../PROOFS.md#a-value-fits-a-type
func check_the_member_types(given: Model.Type, member: Model.FunctionModel, shape: Model.ShapeModel) {
    fallback given.kind == 'object' and context.has_a_class(given)
    var filler = context.class_of(given)
    var shown = context.shown(given)
    if member.is_an_attribute {
        var attribute = filler.attribute_named(member.name)
        crash attribute
        values.refuse_a_mistyped_attribute(attribute, member, given, shape, shown)
        return
    }
    var function = filler.function_named(member.name)
    fallback function
    values.refuse_a_mistyped_function(function, member, filler, shape, shown)
}

func is_filled(given: Model.Type, member: Model.FunctionModel): Boolean {
    var is_generated = member.name == "to_debug" or member.name == "_attribute_list"
    if is_generated {
        return true
    }
    if given.kind == 'enumeration' {
        return member.name == "to_string"
    }
    fallback context.has_a_class(given)
    var filler = context.class_of(given)
    if member.is_an_attribute {
        var attribute = filler.attribute_named(member.name)
        if attribute {
            return true
        }
        return false
    }
    var function = filler.function_named(member.name)
    if function {
        return true
    }
    var template = values.member_template_of(filler, member.name)
    if template {
        return true
    }
    return false
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var made = Model.ClassModel("", "", no_file)

func Constraints(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func check(starting_made: Model.ClassModel) {
    made = starting_made
    made.file.declarations.each(check_declaration)
    check_the_vector_items()
    check_the_dictionary_keys()
}

func check_the_dictionary_keys() {
    assert made.shown.starts_with("Dictionary<")
    var key = made.bound_types["$key_type"]
    assert key
    assert key.kind == 'object' and not key.is_nullable and key.name != "String"
    assert context.has_a_class(key)
    var keyed = context.class_of(key)
    assert keyed.function_named("equals")
    var shown = context.shown(key)
    typing.refuse_equal_keys(context, shown)
}

func check_the_vector_items() {
    assert made.shown.starts_with("Vector<")
    var element = made.bound_types["$element_type"]
    assert element
    assert element.kind == 'object' and not element.is_nullable and element.name != "String"
    assert context.has_a_class(element)
    var held = context.class_of(element)
    var index = 0
    while index < held.declared_attributes.count() {
        var attribute = held.declared_attributes[index]
        if not is_held_inline(attribute.attribute_type) {
            refuse_a_vector_item(element, attribute)
        }
        index = index + 1
    }
}

func is_held_inline(held: Model.Type): Boolean {
    if held.kind == 'scalar' or held.kind == 'enumeration' {
        return true
    }
    return held.kind == 'object' and held.name == "String" and not held.is_nullable
}

func refuse_a_vector_item(element: Model.Type, attribute: Model.AttributeModel) {
    var shown = context.shown(element)
    var attribute_shown = context.shown(attribute.attribute_type)
    typing.refuse_vector_item(context, shown, attribute.name, attribute_shown)
}

func check_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
        check_a_constraint(declaration)
    }
}

func check_a_constraint(declared: AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration) {
    assert declared.bound
    var given = made.bound_types[declared.name]
    assert given
    assert not given.is_nullable and not given.is_symbol
    assert given.kind != 'union' and given.kind != 'shape'
    var wanted = context.resolver.type_in(declared.bound, made, declared.line)
    assert wanted.kind == 'shape' and wanted.name != "Anything"
    if wanted.name == "Number" {
        check_a_number(given, declared.name)
        return
    }
    var shape = context.program.shape_keyed(wanted.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if not is_filled(given, member) {
            refuse(given, shape.name, declared.name, member.name)
        }
        index = index + 1
    }
}

func check_a_number(given: Model.Type, generic_name: String) {
    assert given.kind != 'scalar' or given.name == "Boolean"
    refuse(given, "Number", generic_name, "sum")
}

func is_filled(given: Model.Type, member: Model.FunctionModel): Boolean {
    var is_generated = member.name == "to_debug" or member.name == "_attribute_list"
    if is_generated {
        return true
    }
    if given.kind == 'enumeration' {
        return member.name == "to_string"
    }
    if not context.has_a_class(given) {
        return false
    }
    var filler = context.class_of(given)
    if member.is_an_attribute {
        var attribute = filler.attribute_named(member.name)
        if attribute {
            return true
        }
        return false
    }
    var function = filler.function_named(member.name)
    if function {
        return true
    }
    var template = values.member_template_of(filler, member.name)
    if template {
        return true
    }
    return false
}

func refuse(given: Model.Type, shape_name: String, generic_name: String, member_name: String) {
    var shown = context.shown(given)
    var plain = typing.plain_class_name(made.shown)
    var segments = plain.split(".")
    var owner = segments.last()
    crash owner
    typing.refuse_constraint(context, shown, shape_name, owner, generic_name, member_name)
}

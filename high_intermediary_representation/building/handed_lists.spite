# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func note_a_list_given_to(context: Context, name: String, value: SpiteCompiler.Value?) {
    fallback value
    hand_on_a_list(context, value)
    fallback not is_a_made_list(value)
    context.note_a_shared_list(name, value.value_type)
}

func is_a_made_list(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return true
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name.starts_with("made_")
    }
    if value.class == HighIntermediaryRepresentation.Values.Call {
        return is_a_copy(value)
    }
    return false
}

func is_a_copy(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var shrunk = ShrunkLists()
    var copies = call.function.name == "copy" or call.function.name == "deep_copy"
    return copies and shrunk.holds_items(call.function.owner)
}

func hand_on_a_list(context: Context, value: SpiteCompiler.Value?) {
    fallback value
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        hand_on_a_list(context, value.converted)
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        context.note_a_shared_list(value.name, value.value_type)
    }
}

func hand_on_the_lists_of(context: Context, value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Call: hand_on_the_arguments(context, value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.ShapeCall: hand_on_the_arguments(context, value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.Function.ValueCall: hand_on_the_arguments(context, value.called, value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: hand_on_each(context, value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: hand_on_the_lists_of(context, value.converted)
        HighIntermediaryRepresentation.Values.MachineOperation: hand_on_both(context, value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: hand_on_the_lists_of(context, value.negated)
        HighIntermediaryRepresentation.Values.PresenceTest: hand_on_the_lists_of(context, value.tested)
        HighIntermediaryRepresentation.Values.ForeignCall: return
        HighIntermediaryRepresentation.Values.AttributeRead: hand_on_the_lists_of(context, value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: return
        HighIntermediaryRepresentation.Values.Class.Membership: return
        HighIntermediaryRepresentation.Values.EnumFromText: return
        HighIntermediaryRepresentation.Values.EnumText: return
        HighIntermediaryRepresentation.Values.Function.Value: return
        HighIntermediaryRepresentation.Values.NumberRoom: return
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func hand_on_both(context: Context, first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    hand_on_the_lists_of(context, first)
    hand_on_the_lists_of(context, second)
}

func hand_on_the_arguments(context: Context, receiver: SpiteCompiler.Value?, arguments: List<SpiteCompiler.Value>) {
    hand_on_the_lists_of(context, receiver)
    hand_on_each(context, arguments)
}

func hand_on_each(context: Context, arguments: List<SpiteCompiler.Value>) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        hand_on_a_list(context, argument)
        hand_on_the_lists_of(context, argument)
        index = index + 1
    }
}

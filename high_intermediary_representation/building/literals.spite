var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var _largest_integer: Long = 2147483647

func Literals(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func literal_value(
    literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    expected: Model.Type?,
): SpiteCompiler.Value {
    switch literal.kind {
        'integer_literal': return whole_number_value(literal.text, expected)
        'decimal_literal': return decimal_value(literal.text, expected)
        'keyword_true': return boolean_value(1)
        'keyword_false': return boolean_value(0)
        'keyword_null': return null_value(expected)
        'symbol_literal': return symbol_value(literal.text, expected)
        'keyword_this': return this_value()
        'end_of_file': return values.unbuilt()
        'name': return values.unbuilt()
        'class_name': return values.unbuilt()
        'generic_name': return values.unbuilt()
        'text_literal': return values.unbuilt()
        'open_brace': return values.unbuilt()
        'close_brace': return values.unbuilt()
        'open_parenthesis': return values.unbuilt()
        'close_parenthesis': return values.unbuilt()
        'open_bracket': return values.unbuilt()
        'close_bracket': return values.unbuilt()
        'comma': return values.unbuilt()
        'dot': return values.unbuilt()
        'dots': return values.unbuilt()
        'colon': return values.unbuilt()
        'question': return values.unbuilt()
        'equals': return values.unbuilt()
        'plus': return values.unbuilt()
        'minus': return values.unbuilt()
        'star': return values.unbuilt()
        'slash': return values.unbuilt()
        'percent': return values.unbuilt()
        'equal_equal': return values.unbuilt()
        'not_equal': return values.unbuilt()
        'less': return values.unbuilt()
        'greater': return values.unbuilt()
        'less_or_equal': return values.unbuilt()
        'greater_or_equal': return values.unbuilt()
        'and': return values.unbuilt()
        'or': return values.unbuilt()
        'not': return values.unbuilt()
        'keyword_function': return values.unbuilt()
        'keyword_variable': return values.unbuilt()
        'keyword_enum': return values.unbuilt()
        'keyword_union': return values.unbuilt()
        'keyword_type': return values.unbuilt()
        'keyword_return': return values.unbuilt()
        'keyword_if': return values.unbuilt()
        'keyword_else': return values.unbuilt()
        'keyword_while': return values.unbuilt()
        'keyword_switch': return values.unbuilt()
        'keyword_fallback': return values.unbuilt()
        'keyword_crash': return values.unbuilt()
        'keyword_load': return values.unbuilt()
        'keyword_generic': return values.unbuilt()
        'keyword_singleton': return values.unbuilt()
    }
}

func whole_number_value(written: String, expected: Model.Type?): SpiteCompiler.Value {
    var made = plain_whole_number_value(written, expected)
    if made.class == HighIntermediaryRepresentation.Values.WholeNumber {
        made.is_written = true
    }
    if made.class == HighIntermediaryRepresentation.Values.DecimalNumber {
        made.is_written = true
    }
    return made
}

func plain_whole_number_value(written: String, expected: Model.Type?): SpiteCompiler.Value {
    var number: Long? = written
    if not number and expected {
        var wanted_type = expected.present()
        var unsigned_bits = top_unsigned_bits(written, wanted_type)
        if unsigned_bits {
            return HighIntermediaryRepresentation.Values.WholeNumber(wanted_type, unsigned_bits)
        }
    }
    if not number {
        values.typing.refuse_a_literal_too_large(context, written)
    }
    crash number
    var number_type = context.scalar_type("Integer")
    if expected {
        var wanted = expected.present()
        if values.is_a_decimal_type(wanted) {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, written)
        }
        if context.is_a_number(wanted) {
            number_type = wanted
            refuse_a_literal_out_of_range(number, wanted)
        }
    }
    var largest_integer: Long = _largest_integer
    if number > largest_integer and number_type.name == "Integer" {
        number_type = context.scalar_type("Long")
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(number_type, number)
}

# ../../../spite_spec/specs/values_and_types.md#numeric-types
func top_unsigned_bits(written: String, wanted: Model.Type): Long? {
    fallback wanted.kind == 'scalar'
    var scalar = values.scalars.of(wanted.name)
    fallback scalar
    var widest = 8
    fallback not scalar.is_signed and not scalar.is_decimal and scalar.size == widest
    var unsigned: UnsignedLong? = written
    fallback unsigned
    return unsigned.bits_as_signed()
}

func refuse_a_literal_out_of_range(number: Long, number_type: Model.Type) {
    var scalar = values.scalars.of(number_type.name)
    fallback scalar
    values.typing.refuse_literal_range(context, number, scalar.name, scalar.size, scalar.is_signed)
}

func decimal_value(written: String, expected: Model.Type?): SpiteCompiler.Value {
    var decimal_type = context.scalar_type("Float")
    if expected and expected.name == "Double" {
        decimal_type = context.scalar_type("Double")
    }
    refuse_a_decimal_too_large(written, decimal_type.name)
    var made = HighIntermediaryRepresentation.Values.DecimalNumber(decimal_type, written)
    made.is_written = true
    return made
}

func refuse_a_decimal_too_large(written: String, type_name: String) {
    var parsed: Double? = written
    crash parsed
    var doubled = parsed + parsed
    var is_too_large = parsed > 1.0 and doubled == parsed
    var largest_written = "1.7976931348623157e+308"
    if type_name == "Float" {
        var largest_float: Double = 340282346638528859811704183484516925440.0
        is_too_large = parsed > largest_float
        largest_written = "3.4028235e+38"
    }
    fallback is_too_large
    values.typing.refuse_a_decimal_too_large(context, written, type_name, largest_written)
}

func boolean_value(number: Long): SpiteCompiler.Value {
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func null_value(expected: Model.Type?): SpiteCompiler.Value {
    if expected {
        if expected.is_nullable {
            return HighIntermediaryRepresentation.Values.NullConstant(expected)
        }
        var made = default_of_a_type(expected)
        if made {
            return made
        }
    }
    values.typing.refuse_null_without_a_type(context)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func default_of_a_type(wanted: Model.Type): SpiteCompiler.Value? {
    if wanted.kind == 'object' and wanted.name == "String" {
        return values.described_text("")
    }
    if wanted.kind == 'scalar' {
        var is_a_decimal = wanted.name == "Float" or wanted.name == "Double"
        if is_a_decimal {
            return HighIntermediaryRepresentation.Values.DecimalNumber(wanted, "0.0")
        }
        return HighIntermediaryRepresentation.Values.WholeNumber(wanted, 0)
    }
    if wanted.kind == 'shape' {
        return default_of_a_shape(wanted)
    }
    if wanted.kind == 'enumeration' {
        return first_enum_value(wanted)
    }
    fallback wanted.kind == 'object'
    var made = context.class_of(wanted)
    context.need_defaults(made.key)
    var constructor = values.constructor_of(made)
    var arguments = List<SpiteCompiler.Value>()
    if constructor {
        if not constructor.parameters.is_empty() {
            return HighIntermediaryRepresentation.Values.MakeObject(wanted, null, arguments)
        }
        context.need(constructor)
    }
    return HighIntermediaryRepresentation.Values.MakeObject(wanted, constructor, arguments)
}

func default_of_a_shape(wanted: Model.Type): SpiteCompiler.Value? {
    var shape = context.program.shape_keyed(wanted.name)
    fallback shape
    context.object_count = context.object_count + 1
    var key = "Object{context.object_count}"
    var model = Model.ClassModel(key, "Object", context.current_class.file)
    var defaults = List<SpiteCompiler.Value>()
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute {
            crash member.answer
            var field_type: Model.Type = member.answer
            var field = default_of_a_type(field_type)
            crash field
            var attribute = Model.AttributeModel(member.name, key, field_type)
            model.declared_attributes.append(attribute)
            defaults.append(field)
        }
        index = index + 1
    }
    key = values.stable_object_key(model)
    context.program.add(model)
    context.need_defaults(key)
    var object_type = Model.Type('object', key)
    var no_arguments = List<SpiteCompiler.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(object_type, null, no_arguments)
    values.temporary_count = values.temporary_count + 1
    var name = context.scope.declare("made_{values.temporary_count}", object_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, object_type, made)
    declared.line = context.line
    context.pending.append(declared)
    var local = HighIntermediaryRepresentation.Values.LocalRead(object_type, name)
    var field_index = 0
    while field_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[field_index]
        var value = defaults[field_index]
        crash value
        var assigned = HighIntermediaryRepresentation.Statements.Assign.Attribute(local, attribute, value)
        assigned.line = context.line
        context.pending.append(assigned)
        field_index = field_index + 1
    }
    return values.fitted(local, wanted)
}

func symbol_value(name: String, expected: Model.Type?): SpiteCompiler.Value {
    if expected {
        if expected.kind == 'enumeration' {
            return enum_value(name, expected)
        }
        values.typing.refuse_symbol_for_text(context, name, expected.name)
    }
    values.typing.refuse_symbol_without_an_enum(context, name)
    return values.unbuilt()
}

func enum_value(name: String, expected: Model.Type): SpiteCompiler.Value {
    var made = values.enum_model_of(expected)
    var place = made.values.index_of(name)
    if not place {
        values.typing.refuse_not_a_value(context, name, made.name, made.values)
    }
    crash place
    var number = made.numbers[place]
    crash number
    var present = expected.present()
    return HighIntermediaryRepresentation.Values.WholeNumber(present, number)
}

func first_enum_value(enum_type: Model.Type): SpiteCompiler.Value {
    var made = values.enum_model_of(enum_type)
    var first_name = made.values.first()
    crash first_name
    return enum_value(first_name, enum_type)
}

func this_value(): SpiteCompiler.Value {
    var key = context.current_class.key
    if values.scalars.of(key) {
        var number = context.scalar_type(key)
        return HighIntermediaryRepresentation.Values.ThisRead(number)
    }
    var own = context.current_class.type_of_an_instance()
    return HighIntermediaryRepresentation.Values.ThisRead(own)
}

func text_value(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): SpiteCompiler.Value {
    var joined: SpiteCompiler.Value? = null
    var index = 0
    while index < literal.pieces.count() {
        var piece = literal.pieces[index]
        if not piece.text.is_empty() or literal.pieces.count() == 1 {
            need_text_constants()
            var written = piece.value()
            var constant = HighIntermediaryRepresentation.Values.TextConstant(written)
            constant.is_written = literal.pieces.count() == 1 and not piece.hole
            joined = joined_with(joined, constant)
        }
        if piece.hole {
            var hole = hole_text_of(piece.hole)
            joined = joined_with(joined, hole)
        }
        index = index + 1
    }
    crash joined
    return joined
}

func need_text_constants() {
    var path = List<String>()
    path.append("String")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var string_type = context.resolver.types.class_type_in(path, no_arguments, context.current_class, context.line)
    var string_model = context.class_of(string_type)
    context.need_defaults(string_model.key)
    var append_code = string_model.function_named("append_code")
    crash append_code
    context.need(append_code)
    var rooms = RoomForms(context, values)
    var making_room = rooms.make_room_for_of(string_model)
    context.need(making_room)
}

func hole_text_of(hole: SpiteCompiler.Expression): SpiteCompiler.Value {
    var written_value = values.value_of(hole, null)
    var value = values.result_of_handle(written_value)
    var string_type = context.text()
    context.hole_is_text = value.value_type.is_the_same_as(string_type)
    if context.hole_is_text {
        return value
    }
    if value.value_type.kind == 'enumeration' and not value.value_type.is_nullable {
        return values.enum_text(value)
    }
    var no_arguments = List<SpiteCompiler.Value>()
    return values.method_call(value, "to_string", no_arguments)
}

func cast_text_of(value: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value? {
    var given = value.value_type
    var wants_text = wanted.kind == 'object' and wanted.name == "String"
    fallback wants_text and not given.is_nullable and given.name != "String"
    if given.kind == 'enumeration' {
        return values.enum_text(value)
    }
    var has_text = given.kind == 'scalar' or given.kind == 'object'
    fallback has_text
    var model = context.class_of(given)
    fallback model.function_named("to_string")
    var no_arguments = List<SpiteCompiler.Value>()
    return values.method_call(value, "to_string", no_arguments)
}

func joined_with(joined: SpiteCompiler.Value?, next: SpiteCompiler.Value): SpiteCompiler.Value {
    if not joined {
        return next
    }
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(next)
    var summed = values.method_call(joined, "sum", arguments)
    if summed.class == HighIntermediaryRepresentation.Values.Call {
        summed.is_a_join = true
        need_the_join_in_one_piece()
    }
    return summed
}

func need_the_join_in_one_piece() {
    var string_type = context.text()
    var string_model = context.class_of(string_type)
    var appending = string_model.function_named("_append_text")
    crash appending
    context.need(appending)
    var rooms = RoomForms(context, values)
    var making_room = rooms.make_room_for_of(string_model)
    context.need(making_room)
}

func symbol_text_of(written: SpiteCompiler.Expression?): String? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return symbol_literal_text(written)
    }
    return null
}

func symbol_literal_text(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String? {
    fallback literal.kind == 'symbol_literal'
    return literal.text
}

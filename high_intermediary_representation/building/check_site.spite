var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var kind = ""
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var written = ""
var keyword = ""
var check: String? = null
var source: String? = null
var checked_type = Model.Type('nothing', "")
var is_converted = false
var has_a_loop = false
var is_narrowed_outside = false
var is_read_in_the_loop = false
var is_still_narrowed = false
var tested: HighIntermediaryRepresentation.Values.Value? = null
var holds = false

func CheckSite(starting_kind: String, starting_context: Context) {
    kind = starting_kind
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
}

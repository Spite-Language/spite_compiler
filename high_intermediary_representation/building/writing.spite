var state = ReflectionState()

func Writing(starting_state: ReflectionState) {
    state = starting_state
}

func reflection_type(name: String): Model.Type {
    var path = name.split(".")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    return state.context.resolver.types.class_type_in(
        path,
        no_arguments,
        state.context.current_class,
        state.context.line,
    )
}

func need_the_making(reflection: Model.Type) {
    var literals = Literals(state.values.context, state.values)
    var model = state.context.class_of(reflection)
    state.context.need_defaults(model.key)
    var constructor = state.values.constructor_of(model)
    crash constructor
    state.context.need(constructor)
    literals.need_text_constants()
}

func constructor_arguments(constructor: Model.FunctionModel): List<SpiteCompiler.Value> {
    var fitting = Fitting(state.values.context, state.values)
    var arguments = List<SpiteCompiler.Value>()
    var prefix = "starting_"
    var prefix_length = prefix.length()
    var index = 0
    while index < constructor.parameters.count() {
        var parameter = constructor.parameters[index]
        var name_length = parameter.name.length()
        var field = parameter.name.slice(prefix_length, name_length)
        crash field
        var argument = given_or_default(field, parameter.parameter_type)
        var fitted_argument = fitting.fitted(argument, parameter.parameter_type)
        arguments.append(fitted_argument)
        index = index + 1
    }
    return arguments
}

func given_or_default(field: String, wanted: Model.Type): SpiteCompiler.Value {
    var found = state.given[field]
    if found {
        return found
    }
    if wanted.is_nullable {
        return HighIntermediaryRepresentation.Values.NullConstant(wanted)
    }
    if wanted.kind == 'object' and wanted.name == "String" {
        return text("")
    }
    if wanted.kind == 'object' {
        return no_collection_of(wanted)
    }
    crash wanted.kind == 'scalar' and wanted.name == "Boolean"
    return flag(false)
}

# ../../../spite_documentation/reflection.md#what-the-compiler-leaves-out
func no_collection_of(wanted: Model.Type): SpiteCompiler.Value {
    var collections = Collections(state.values.context, state.values)
    var model = state.context.class_of(wanted)
    crash model.file.namespace == "List" or model.file.namespace == "Dictionary"
    return collections.made_list(wanted)
}

func collection_of(model: Model.ClassModel, name: String): SpiteCompiler.Value {
    var collections = Collections(state.values.context, state.values)
    var attribute = model.attribute_named(name)
    crash attribute
    var collection_type = attribute.attribute_type
    var made = collections.made_list(collection_type)
    return kept(made, collection_type)
}

func given_collection(model: Model.ClassModel, field: String): SpiteCompiler.Value {
    var local = collection_of(model, "_{field}")
    state.given[field] = local
    return local
}

func made_by_name(made_type: Model.Type, starting_given: Dictionary<String, SpiteCompiler.Value>): SpiteCompiler.Value {
    var outer_given = state.given
    state.given = starting_given
    var model = state.context.class_of(made_type)
    var constructor = state.values.constructor_of(model)
    crash constructor
    var arguments = constructor_arguments(constructor)
    state.given = outer_given
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func give_text(field: String, written: String) {
    state.given[field] = text(written)
}

func give_flag(field: String, value: Boolean) {
    state.given[field] = flag(value)
}

func flag(value: Boolean): SpiteCompiler.Value {
    var boolean = state.context.boolean()
    var number = 0
    if value {
        number = 1
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, number)
}

func fact(
    question: String,
    declared: Model.FunctionModel,
    slot: String,
): HighIntermediaryRepresentation.Values.Function.Fact {
    var functions = List<Model.FunctionModel>()
    functions.append(declared)
    var boolean = state.context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Fact(boolean, question, functions)
    made.slot = slot
    state.context.facts_asked.append(made)
    state.context.need(declared)
    return made
}

func appended_when(condition: SpiteCompiler.Value, listed: SpiteCompiler.Value, item: SpiteCompiler.Value) {
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    appended(listed, item)
    var then = HighIntermediaryRepresentation.Statements.Block()
    then.statements = state.statements
    state.statements = outer
    var checked = HighIntermediaryRepresentation.Statements.If(condition, then, null)
    state.statements.append(checked)
}

func kept_in_scope(made: SpiteCompiler.Value, made_type: Model.Type): SpiteCompiler.Value {
    state.local_count = state.local_count + 1
    var name = state.context.scope.declare("reflected_{state.local_count}", made_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, made_type, made)
    declared.line = state.context.line
    state.statements.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(made_type, name)
}

func text(written: String): SpiteCompiler.Value {
    var made = HighIntermediaryRepresentation.Values.TextConstant(written)
    made.value_type = state.context.text()
    return made
}

func whole(number: Integer): SpiteCompiler.Value {
    var integer = state.context.scalar_type("Integer")
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, number)
}

func made_from(made_type: Model.Type, name: SpiteCompiler.Value, more: List<SpiteCompiler.Value>): SpiteCompiler.Value {
    var fitting = Fitting(state.values.context, state.values)
    var model = state.context.class_of(made_type)
    var constructor = state.values.constructor_of(model)
    crash constructor
    var passed = List<SpiteCompiler.Value>()
    passed.append(name)
    more.each(passed.append)
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < passed.count() {
        var argument = passed[index]
        var parameter = constructor.parameters[index]
        crash parameter
        var fitted_argument = fitting.fitted(argument, parameter.parameter_type)
        arguments.append(fitted_argument)
        index = index + 1
    }
    return HighIntermediaryRepresentation.Values.MakeObject(made_type, constructor, arguments)
}

func kept(made: SpiteCompiler.Value, made_type: Model.Type): SpiteCompiler.Value {
    state.local_count = state.local_count + 1
    var name = "reflected_{state.local_count}"
    if state.declares_in_scope {
        name = state.context.scope.declare("reflected", made_type)
    }
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, made_type, made)
    state.statements.append(declared)
    return HighIntermediaryRepresentation.Values.LocalRead(made_type, name)
}

func appended(listed: SpiteCompiler.Value, item: SpiteCompiler.Value) {
    var calls = Calls(state.values.context, state.values)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(item)
    var call = calls.method_call(listed, "append", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    state.statements.append(evaluated)
}

func placed(listed: SpiteCompiler.Value, key: SpiteCompiler.Value, item: SpiteCompiler.Value) {
    var calls = Calls(state.values.context, state.values)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(key)
    arguments.append(item)
    var call = calls.method_call(listed, "set_at", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    state.statements.append(evaluated)
}

func check_a_maybe_enum(described: SpiteCompiler.Value) {
    var described_type = described.value_type
    var present_value = Validators.HighIntermediaryRepresentation.PresentValue.Validator()
    present_value.check_a_present_value(state.context, described_type)
}

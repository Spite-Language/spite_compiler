# ../../../spite_documentation/failure.md#an-if-that-only-returns-what-a-fallback-returns-is-a-fallback

var is_noting = false
var total = Dictionary<String, Boolean>()
var partial = Dictionary<String, Boolean>()

func start() {
    total = Dictionary<String, Boolean>()
    partial = Dictionary<String, Boolean>()
    is_noting = true
}

func stop() {
    is_noting = false
}

func note(path: String, binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, is_total: Boolean) {
    var key = key_of(path, binary)
    if is_total {
        total[key] = true
    } else {
        partial[key] = true
    }
}

func holds_a_total_order(path: String, binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Boolean {
    var key = key_of(path, binary)
    return total.contains(key) and not partial.contains(key)
}

func key_of(path: String, binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    return "{path}:{binary.line}:{binary.column}"
}

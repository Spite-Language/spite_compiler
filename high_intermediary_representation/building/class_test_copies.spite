var state = StatementsState()

func ClassTestCopies(starting_state: StatementsState) {
    state = starting_state
}

# ../../../spite_documentation/control_flow.md#valueclass--class
func then_branch_of(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    paths: List<String>,
    types: List<Model.Type>,
    check: String,
): HighIntermediaryRepresentation.Statements.Block {
    var statements = Statements(state)
    var tests = class_tests_of_an_or(statement.condition)
    if tests.count() > 1 {
        return block_per_class(statement.then_branch, tests, 0, check)
    }
    return statements.narrowed_block_of(statement.then_branch, paths, types, check)
}

# ../../../spite_documentation/control_flow.md#valueclass--class
func class_tests_of_an_or(
    condition: SpiteCompiler.Expression?,
): List<AbstractSyntaxTree.Shapes.Expressions.BinaryExpression> {
    var statements = Statements(state)
    var tests = List<AbstractSyntaxTree.Shapes.Expressions.BinaryExpression>()
    fallback condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression and condition.operator == 'or'
    fallback holds_only_class_tests(condition)
    collect_the_class_tests(condition, tests)
    var tested_paths = List<String>()
    var index = 0
    while index < tests.count() {
        var test = tests[index]
        statements.read_facts(test)
        fallback state.facts_paths.count() == 1
        var tested_path = state.facts_paths[0]
        tested_paths.append(tested_path)
        index = index + 1
    }
    var first = tested_paths.first()
    fallback first
    index = 0
    while index < tested_paths.count() {
        fallback tested_paths[index] == first
        index = index + 1
    }
    return tests
}

func collect_the_class_tests(
    condition: SpiteCompiler.Expression?,
    tests: List<AbstractSyntaxTree.Shapes.Expressions.BinaryExpression>,
) {
    fallback condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    if condition.operator == 'or' {
        collect_the_class_tests(condition.left, tests)
        collect_the_class_tests(condition.right, tests)
        return
    }
    tests.append(condition)
}

func holds_only_class_tests(condition: SpiteCompiler.Expression?): Boolean {
    var operators = Operators(state.values.context, state.values)
    fallback condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    if condition.operator == 'or' {
        var left_holds = holds_only_class_tests(condition.left)
        var right_holds = holds_only_class_tests(condition.right)
        return left_holds and right_holds
    }
    return condition.operator == 'equal_equal' and operators.is_a_class_test(condition)
}

# ../../../spite_documentation/control_flow.md#valueclass--class
func block_per_class(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    tests: List<AbstractSyntaxTree.Shapes.Expressions.BinaryExpression>,
    index: Integer,
    check: String,
): HighIntermediaryRepresentation.Statements.Block {
    var operators = Operators(state.values.context, state.values)
    var statements = Statements(state)
    var test = tests[index]
    crash test
    statements.read_facts(test)
    var paths = state.facts_paths
    var types = state.facts_types
    var is_the_last = index == tests.count() - 1
    if is_the_last {
        return statements.narrowed_block_of(written, paths, types, check)
    }
    var condition = operators.condition_of(test)
    var printer = Printers.Spite.ExpressionPrinter(test)
    var written_condition = printer.text()
    state.context.scope.hold_the_narrowings()
    var then_start = state.context.logged_calls.count()
    var first = statements.narrowed_block_of(written, paths, types, check)
    state.context.scope.start_the_other_branch()
    state.context.enter_the_other_branch(then_start)
    var rest = block_per_class(written, tests, index + 1, check)
    state.context.leave_the_other_branch()
    var first_leaves = state.endings.always_leaves(first)
    var rest_leaves = state.endings.always_leaves(rest)
    state.context.scope.join_the_branches(first_leaves, rest_leaves)
    crash written
    var line = written.line
    var chosen = HighIntermediaryRepresentation.Statements.If(condition, first, rest, line, written_condition)
    var made = HighIntermediaryRepresentation.Statements.Block(line)
    made.statements.append(chosen)
    return made
}

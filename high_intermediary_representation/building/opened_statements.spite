var written: List<SpiteCompiler.WrittenStatement>
var outer_statements: List<SpiteCompiler.WrittenStatement>
var outer_index: Integer
var pushed: Boolean

func OpenedStatements(
    starting_written: List<SpiteCompiler.WrittenStatement>,
    starting_outer_statements: List<SpiteCompiler.WrittenStatement>,
    starting_outer_index: Integer,
    starting_pushed: Boolean,
) {
    written = starting_written
    outer_statements = starting_outer_statements
    outer_index = starting_outer_index
    pushed = starting_pushed
}

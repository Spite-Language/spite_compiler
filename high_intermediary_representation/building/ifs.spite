var state = StatementsState()

func Ifs(starting_state: StatementsState) {
    state = starting_state
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-built-in-a-loop
func build_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var statements = Statements(state)
    var links = List<ElseIfLink>()
    var next = statements.built_up_to_its_else_if(statement, links)
    while next {
        next = statements.built_up_to_its_else_if(next, links)
    }
    while not links.is_empty() {
        var link = links.remove_last()
        crash link
        close_an_else_if(link)
    }
}

func else_if_of(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    fallback statement.else_branch
    fallback statement.else_branch.is_an_else_if and statement.else_branch.statements.count() == 1
    var inner = statement.else_branch.statements[0]
    fallback inner.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    return inner
}

func opened_else_if(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    condition: SpiteCompiler.Value,
    written_condition: String,
    then_branch: HighIntermediaryRepresentation.Statements.Block,
    then_start: Integer,
): ElseIfLink {
    var statements = Statements(state)
    crash statement.else_branch
    open_the_other_branch(then_start)
    var block = statements.open_a_block(statement.else_branch.line)
    var opened = statements.open_the_statements(statement.else_branch.statements)
    state.context.block_index = 0
    if statements.is_the_programs_code() {
        statements.note_a_statement(statement.else_branch.statements, 0)
    }
    return ElseIfLink(statement, condition, written_condition, then_branch, block, opened)
}

func close_an_else_if(link: ElseIfLink) {
    var statements = Statements(state)
    state.context.block_statements = link.statements.written
    statements.close_the_statements(link.statements)
    var else_branch = statements.closed_block(link.block)
    close_the_other_branch(link.then_branch, else_branch)
    var made = HighIntermediaryRepresentation.Statements.If(
        link.condition,
        link.then_branch,
        else_branch,
        link.statement.line,
        link.written_condition,
    )
    statements.add(made)
}

# ../../PROOFS.md#assigning-undoes-a-proof
func other_branch_of(
    written: AbstractSyntaxTree.Shapes.Statements.Block?,
    then_start: Integer,
    then_branch: HighIntermediaryRepresentation.Statements.Block,
): HighIntermediaryRepresentation.Statements.Block {
    var statements = Statements(state)
    open_the_other_branch(then_start)
    var made = statements.block_of(written)
    close_the_other_branch(then_branch, made)
    return made
}

func open_the_other_branch(then_start: Integer) {
    state.context.scope.start_the_other_branch()
    state.context.enter_the_other_branch(then_start)
}

func close_the_other_branch(
    then_branch: HighIntermediaryRepresentation.Statements.Block,
    else_branch: HighIntermediaryRepresentation.Statements.Block,
) {
    state.context.leave_the_other_branch()
    var then_leaves = state.endings.always_leaves(then_branch)
    var else_leaves = state.endings.always_leaves(else_branch)
    state.context.scope.join_the_branches(then_leaves, else_leaves)
}

func build_a_decided_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement, holds: Boolean) {
    var statements = Statements(state)
    state.context.note_a_folded_branch()
    if holds {
        var taken = statements.block_of(statement.then_branch)
        statements.add(taken)
        state.rest_is_folded_away = state.endings.always_leaves(taken)
        return
    }
    fallback statement.else_branch
    var other = statements.block_of(statement.else_branch)
    statements.add(other)
    state.rest_is_folded_away = state.endings.always_leaves(other)
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func ThroughDeclarations(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/foreign_libraries.md#declaring-a-foreign-function
func declared_call(
    function: Model.FunctionModel,
    receiver: SpiteCompiler.Value,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    fallback function.declaration
    var handed = function.declaration.declared_foreign_call()
    fallback handed
    fallback call.arguments.count() == function.parameters.count()
    var callee = handed.callee
    fallback callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var holder = callee.target
    fallback holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var library = library_of(function, function.declaration, holder.name, receiver)
    fallback library
    var parameter_types = List<Model.Type>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        parameter_types.append(parameter.parameter_type)
        index = index + 1
    }
    context.need(function)
    var collections = Collections(context, values)
    return collections.foreign_call_with(
        library,
        callee.name,
        call.arguments,
        parameter_types,
        function.answer,
        call,
        false,
    )
}

func library_of(
    function: Model.FunctionModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    receiver: SpiteCompiler.Value,
): SpiteCompiler.Value? {
    var bound = declaration.library_bound_as(name)
    if bound {
        return values.value_of(bound, null)
    }
    var owner = context.program.class_named(function.owner)
    fallback owner
    var attribute = owner.attribute_named(name)
    fallback attribute
    fallback attribute.attribute_type.name == "DynamicLibrary"
    return HighIntermediaryRepresentation.Values.AttributeRead(receiver, attribute)
}

# ../../PROOFS.md#what-a-function-reads-and-writes

func slot_of(owner: String, name: String): String {
    return "o:{owner}.{name}"
}

func owner_of(slot: String): String {
    var dot = last_dot_of(slot)
    var owner = slot.slice(2, dot)
    crash owner
    return owner
}

func name_of(slot: String): String {
    var dot = last_dot_of(slot)
    var slot_length = slot.length()
    var name = slot.slice(dot + 1, slot_length)
    crash name
    return name
}

func last_dot_of(slot: String): Integer {
    var index = slot.length() - 1
    while index > 2 and slot.byte_at(index) != 46 {
        index = index - 1
    }
    return index
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var shapes = HighIntermediaryRepresentation.Building.Prompt.Source(context)
var written = List<String>()
var listed = ""
var text = ""
var value_lines = List<String>()

func BreakpointLocals(starting_context: Context) {
    context = starting_context
    shapes = HighIntermediaryRepresentation.Building.Prompt.Source(starting_context)
}

# ../../../spite_spec/specs/repl.md#command-language
func statements_on(line: Integer): List<String> {
    written = List<String>()
    listed = "spite_locals_on_line_{line}"
    text = "spite_local_text_on_line_{line}"
    written.append("var {text} = \"\"")
    note_self()
    var names = context.scope.visible_written_names()
    names.each(note_a_local)
    return written
}

func is_the_breakpoints_own(name: String): Boolean {
    var own = ["spite_breakpoint_on_line_", "spite_locals_on_line_", "spite_local_text_on_line_"]
    var index = 0
    while index < own.count() {
        var prefix = own[index]
        if name.starts_with(prefix) {
            return true
        }
        index = index + 1
    }
    return false
}

func note_a_local(name: String) {
    fallback not is_the_breakpoints_own(name)
    var internal_name = context.scope.internal_name_of(name)
    crash internal_name
    var held = context.scope.type_of(internal_name)
    crash held
    var shown = shapes.shown_of(held)
    var label = shapes.escaped("{name}: {shown} = ")
    written.append("{text} = \"{label}\"")
    note_the_value(name, held)
    written.append("{listed}.append({text})")
}

func note_self() {
    var model = context.current_class
    var described = model.type_of_an_instance()
    fallback shapes.kind_of(described) == "object"
    var shown = shapes.shown_of(described)
    var written_name = shapes.written_of(described)
    var plain = shapes.plain_short_of(written_name)
    var attributes = shapes.attributes_of(described)
    if attributes.is_empty() {
        var empty = shapes.escaped("self: {shown} = {plain} \{}")
        written.append("{text} = \"{empty}\"")
        written.append("{listed}.append({text})")
        return
    }
    var opening = shapes.escaped("self: {shown} = {plain} \{ ")
    written.append("{text} = \"{opening}\"")
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var separator = ""
        if index > 0 {
            separator = ", "
        }
        written.append("{text} = \"\{{text}}{separator}{attribute.name}: \"")
        var read = attribute.name
        var shadowing = context.scope.internal_name_of(attribute.name)
        if shadowing {
            read = "this.{attribute.name}"
        }
        note_the_value(read, attribute.attribute_type)
        index = index + 1
    }
    written.append("{text} = \"\{{text}} }\"")
    written.append("{listed}.append({text})")
}

# ../../../spite_spec/specs/repl.md#command-language
func note_the_value(expression: String, described: Model.Type) {
    value_lines = List<String>()
    value_lines_of(expression, described)
    var joined = value_lines.join("\n")
    written.append(joined)
}

func value_lines_of(expression: String, described: Model.Type) {
    if not described.is_nullable {
        note_a_present_value(expression, described)
        return
    }
    var present = described.present()
    if context.is_boolean(described) {
        value_lines.append("switch {expression} \{")
        value_lines.append("    Boolean: {text} = \"\{{text}}\{{expression}.to_string()}\"")
        value_lines.append("    Null: {text} = \"\{{text}}null\"")
        value_lines.append("}")
        return
    }
    value_lines.append("if {expression} \{")
    note_a_present_value(expression, present)
    value_lines.append("} else \{")
    value_lines.append("{text} = \"\{{text}}null\"")
    value_lines.append("}")
}

func note_a_present_value(expression: String, described: Model.Type) {
    var kind = shapes.kind_of(described)
    if kind == "union" {
        note_a_union_value(expression, described)
        return
    }
    var piece = piece_of(expression, described, kind)
    value_lines.append("{text} = \"\{{text}}{piece}\"")
}

func note_a_union_value(expression: String, described: Model.Type) {
    var members = shapes.members_of(described)
    var index = 0
    while index < members.count() {
        var member = members[index]
        var member_written = shapes.written_of(member)
        var opening = "if"
        if index > 0 {
            opening = "} else if"
        }
        value_lines.append("{opening} {expression} == {member_written} \{")
        note_a_present_value(expression, member)
        index = index + 1
    }
    value_lines.append("}")
}

func piece_of(expression: String, described: Model.Type, kind: String): String {
    if kind == "text" {
        return "\{{expression}}"
    }
    if kind == "scalar" or kind == "enum" {
        return "\{{expression}.to_string()}"
    }
    if kind == "list" or kind == "dictionary" {
        var collection_written = shapes.written_of(described)
        var collection_shown = shapes.short_of(collection_written)
        var quoted_collection = shapes.escaped(collection_shown)
        return "{quoted_collection}(\{{expression}.count()})"
    }
    if kind == "opaque" {
        var opaque_shown = context.shown(described)
        return shapes.escaped("{opaque_shown} \{...}")
    }
    var object_written = shapes.written_of(described)
    var object_plain = shapes.plain_short_of(object_written)
    return shapes.escaped("{object_plain} \{...}")
}

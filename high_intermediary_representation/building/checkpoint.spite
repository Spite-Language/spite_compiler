# ../../ARCHITECTURE.md#checking-the-functions-nobody-calls

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Context(no_program, no_resolver)
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var model = ModelCheckpoint(no_program)
var built_count = 0
var queued_count = 0
var made_class_count = 0
var synthetic_count = 0
var reflected_count = 0
var shape_link_count = 0
var work_text_count = 0
var crash_site_count = 0
var vector_site_count = 0
var switch_site_count = 0
var statement_site_count = 0
var guard_site_count = 0
var presence_site_count = 0
var check_site_count = 0
var loop_site_count = 0
var literal_site_count = 0
var recorded_site_count = 0
var narrowed_read_count = 0
var unfilled_count = 0
var filled_count = 0
var fill_count = 0
var fact_count = 0
var shape_class_count = 0
var describer_count = 0
var text_hole_count = 0
var other_hole_count = 0
var folded_key_read_count = 0
var folded_function_count = 0
var folded_key_assignment_count = 0
var run_time_key_map_count = 0
var live_key_map_count = 0
var unsettled_reader_count = 0
var object_count = 0
var in_flight_sites = 0
var makes_work = false
var folded_build_reads = 0
var renews_the_lists = false
var fill_features = ""
var key_maps_settled = false
var hole_is_text = false
var made_anew: HighIntermediaryRepresentation.HighFunction? = null
var made_anew_classes = 0
var object_ordinals = Dictionary<String, Integer>()
var site_ordinals = Dictionary<String, Integer>()
var reported_texts = Dictionary<String, String>()
var singleton_arguments = Dictionary<String, List<String>>()
var known_function_copies = Dictionary<String, Model.FunctionModel>()
var described_parameters = Dictionary<String, List<String>>()
var known_copies = Dictionary<String, Model.FunctionModel>()
var folded_keys = Dictionary<String, String>()
var folded_key_maps = Dictionary<String, String>()
var known_function_lists = Dictionary<String, String>()
var written_privates = Dictionary<String, List<String>>()
var current_class = Model.ClassModel("", "", no_file)
var current_function = Model.FunctionModel("", "")
var line = 0
var building_function_name = ""

func Checkpoint(starting_context: Context, starting_high: HighIntermediaryRepresentation.HighProgram) {
    context = starting_context
    high = starting_high
    model = ModelCheckpoint(context.program)
    built_count = high.built_functions.count()
    remember_the_lists()
    remember_the_values()
    remember_the_dictionaries()
}

func remember_the_lists() {
    queued_count = context.queued.count()
    made_class_count = context.made_classes.count()
    synthetic_count = context.synthetic_functions.count()
    reflected_count = context.reflected.count()
    shape_link_count = context.shape_links.count()
    work_text_count = context.work_texts.count()
    crash_site_count = context.crash_sites.count()
    vector_site_count = context.vector_sites.count()
    switch_site_count = context.switch_sites.count()
    statement_site_count = context.statement_sites.count()
    guard_site_count = context.guard_sites.count()
    presence_site_count = context.presence_sites.count()
    check_site_count = context.check_sites.count()
    loop_site_count = context.loop_sites.count()
    literal_site_count = context.literal_sites.count()
    recorded_site_count = context.recorded_sites.count()
    narrowed_read_count = context.narrowed_reads.count()
    unfilled_count = context.unfilled.count()
    filled_count = context.filled.count()
    fill_count = context.fills.count()
    fact_count = context.facts_asked.count()
    shape_class_count = context.shape_classes.count()
    describer_count = context.describers.count()
    text_hole_count = context.text_holes.count()
    other_hole_count = context.other_holes.count()
    folded_key_read_count = context.folded_key_reads.count()
    folded_function_count = context.folded_functions.count()
    folded_key_assignment_count = context.folded_key_assignments.count()
    run_time_key_map_count = context.run_time_key_maps.count()
    live_key_map_count = context.live_key_maps.count()
    unsettled_reader_count = context.unsettled_key_readers.count()
}

func remember_the_values() {
    object_count = context.object_count
    in_flight_sites = context.in_flight_sites
    makes_work = context.makes_work
    folded_build_reads = context.folded_build_reads
    renews_the_lists = context.renews_the_lists
    fill_features = context.fill_features
    key_maps_settled = context.key_maps_settled
    hole_is_text = context.hole_is_text
    made_anew = context.made_anew
    made_anew_classes = context.made_anew_classes
    current_class = context.current_class
    current_function = context.current_function
    line = context.line
    building_function_name = context.resolver.state.building_function_name
}

func remember_the_dictionaries() {
    object_ordinals = context.object_ordinals.copy()
    site_ordinals = context.site_ordinals.copy()
    reported_texts = context.reported_texts.copy()
    singleton_arguments = context.singleton_arguments.deep_copy()
    known_function_copies = context.known_function_copies.copy()
    described_parameters = context.described_parameters.deep_copy()
    known_copies = context.known_copies.copy()
    folded_keys = context.folded_keys.copy()
    folded_key_maps = context.folded_key_maps.copy()
    known_function_lists = context.known_function_lists.copy()
    written_privates = context.written_privates.deep_copy()
}

func put_back() {
    high.built_functions.truncate(built_count)
    context.waiting.clear()
    put_back_the_lists()
    put_back_the_values()
    put_back_the_dictionaries()
    model.put_back()
}

func put_back_the_lists() {
    context.queued.truncate(queued_count)
    context.made_classes.truncate(made_class_count)
    context.synthetic_functions.truncate(synthetic_count)
    context.reflected.truncate(reflected_count)
    context.shape_links.truncate(shape_link_count)
    context.work_texts.truncate(work_text_count)
    context.crash_sites.truncate(crash_site_count)
    context.vector_sites.truncate(vector_site_count)
    context.switch_sites.truncate(switch_site_count)
    context.statement_sites.truncate(statement_site_count)
    context.guard_sites.truncate(guard_site_count)
    context.presence_sites.truncate(presence_site_count)
    context.check_sites.truncate(check_site_count)
    context.loop_sites.truncate(loop_site_count)
    context.literal_sites.truncate(literal_site_count)
    context.recorded_sites.truncate(recorded_site_count)
    context.narrowed_reads.truncate(narrowed_read_count)
    context.unfilled.truncate(unfilled_count)
    context.filled.truncate(filled_count)
    context.filled_counts.truncate(filled_count)
    context.fills.truncate(fill_count)
    context.facts_asked.truncate(fact_count)
    context.shape_classes.truncate(shape_class_count)
    context.describers.truncate(describer_count)
    context.described_functions.truncate(describer_count)
    context.text_holes.truncate(text_hole_count)
    context.other_holes.truncate(other_hole_count)
    context.folded_key_reads.truncate(folded_key_read_count)
    context.folded_functions.truncate(folded_function_count)
    context.folded_key_assignments.truncate(folded_key_assignment_count)
    context.run_time_key_maps.truncate(run_time_key_map_count)
    context.live_key_maps.truncate(live_key_map_count)
    context.unsettled_key_readers.truncate(unsettled_reader_count)
}

func put_back_the_values() {
    context.object_count = object_count
    context.in_flight_sites = in_flight_sites
    context.makes_work = makes_work
    context.folded_build_reads = folded_build_reads
    context.renews_the_lists = renews_the_lists
    context.fill_features = fill_features
    context.key_maps_settled = key_maps_settled
    context.hole_is_text = hole_is_text
    context.made_anew = made_anew
    context.made_anew_classes = made_anew_classes
    context.current_class = current_class
    context.current_function = current_function
    context.line = line
    context.resolver.state.building_function_name = building_function_name
}

func put_back_the_dictionaries() {
    context.object_ordinals = object_ordinals
    context.site_ordinals = site_ordinals
    context.reported_texts = reported_texts
    context.singleton_arguments = singleton_arguments
    context.known_function_copies = known_function_copies
    context.described_parameters = described_parameters
    context.known_copies = known_copies
    context.folded_keys = folded_keys
    context.folded_key_maps = folded_key_maps
    context.known_function_lists = known_function_lists
    context.written_privates = written_privates
}

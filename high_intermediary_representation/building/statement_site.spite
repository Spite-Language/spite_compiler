var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var kind = ""
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var statements = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
var index = 0
var is_a_loop = false
var enclosing = List<EnclosingBlock>()
var view = ScopeView()

func StatementSite(
    starting_kind: String,
    starting_statements: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    starting_index: Integer,
) {
    kind = starting_kind
    statements = starting_statements
    index = starting_index
}

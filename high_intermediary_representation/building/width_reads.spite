# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read-of-a-width
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)

func WidthReads(starting_context: Context) {
    context = starting_context
}

func proven(
    made: HighIntermediaryRepresentation.Values.Value,
    owner: Model.ClassModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value {
    var reads_a_number = callee.name.starts_with("read_") and callee.name.ends_with("_at")
    if owner.key != "Buffer" or not reads_a_number or call.arguments.count() != 1 {
        return made
    }
    if not made.value_type.is_nullable {
        return made
    }
    var width = width_of(callee.name)
    var position = call.arguments[0]
    var last = last_byte_of(position, width)
    if last.is_empty() or not callee.target {
        return made
    }
    var target_printer = Printers.Spite.ExpressionPrinter(callee.target)
    var target_text = target_printer.text()
    var path = "{target_text}[{last}]"
    var narrowed_type = context.scope.narrowed_type_of(path)
    if not narrowed_type {
        return made
    }
    var present = made.value_type.present()
    var proven_read = HighIntermediaryRepresentation.Values.Conversion(present, 'proven', made)
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    proven_read.shown = call_printer.text()
    return proven_read
}

func width_of(name: String): Integer {
    if name.contains("short") {
        return 2
    }
    if name.contains("integer") or name.contains("float") {
        return 4
    }
    if name.contains("long") or name.contains("double") {
        return 8
    }
    return 1
}

func last_byte_of(position: AbstractSyntaxTree.Shapes.Expressions.Expression?, width: Integer): String {
    if position == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return offset_name(position.name, width - 1)
    }
    if position == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_last(position, width)
    }
    if position == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return sum_last(position, width)
    }
    return ""
}

func offset_name(name: String, offset: Integer): String {
    if offset == 0 {
        return name
    }
    return "{name} + {offset}"
}

func literal_last(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression, width: Integer): String {
    var number = literal.text.to_integer()
    if literal.kind != 'integer_literal' or not number {
        return ""
    }
    var last = number + width - 1
    return last.to_string()
}

func sum_last(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, width: Integer): String {
    if sum.operator != 'plus' {
        return ""
    }
    return offset_last(sum.left, sum.right, width)
}

func offset_last(
    left: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    right: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    width: Integer,
): String {
    if left == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and right == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_offset(left.name, right, width)
    }
    return ""
}

func literal_offset(name: String, literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression, width: Integer): String {
    var number = literal.text.to_integer()
    if literal.kind != 'integer_literal' or not number {
        return ""
    }
    var last = number + width - 1
    return offset_name(name, last)
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time

var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file, false)
var function = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var given: SpiteCompiler.Value
var line: Integer
var attribute_name: String

func ValueWriteSite(starting_context: Context, written: SpiteCompiler.Value, starting_attribute_name: String) {
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
    attribute_name = starting_attribute_name
    given = given_of(written)
}

func given_of(written: SpiteCompiler.Value): SpiteCompiler.Value {
    if written.class == HighIntermediaryRepresentation.Values.Conversion and is_a_move_into_anything(written.kind) {
        crash written.converted
        return given_of(written.converted)
    }
    return written
}

func is_a_move_into_anything(kind: HighIntermediaryRepresentation.Values.Conversion.Kind): Boolean {
    return kind == 'into_shape' or kind == 'nullable'
}

func gives_null(): Boolean {
    return given.class == HighIntermediaryRepresentation.Values.NullConstant
}

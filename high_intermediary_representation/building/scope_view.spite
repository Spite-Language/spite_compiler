# ../../PROOFS.md#what-the-builder-records-for-the-proofs
var internal_names = Dictionary<String, String>()
var types = Dictionary<String, Model.Type>()
var declared_types = Dictionary<String, Model.Type>()

func note(name: String, internal_name: String, held_type: Model.Type, declared_type: Model.Type) {
    internal_names[name] = internal_name
    types[internal_name] = held_type
    declared_types[internal_name] = declared_type
}

func internal_name_of(name: String): String? {
    return internal_names[name]
}

func type_of(internal_name: String): Model.Type? {
    return types[internal_name]
}

func declared_type_of(internal_name: String): Model.Type? {
    return declared_types[internal_name]
}

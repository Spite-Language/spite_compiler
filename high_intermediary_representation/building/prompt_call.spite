var name = ""
var function_name = ""
var parameter_names = List<String>()
var parameter_types = List<Model.Type>()
var answer: Model.Type? = null
var answers_the_keys = false

func PromptCall(starting_name: String) {
    name = starting_name
    function_name = starting_name
}

func takes(parameter_name: String, parameter_type: Model.Type) {
    parameter_names.append(parameter_name)
    parameter_types.append(parameter_type)
}

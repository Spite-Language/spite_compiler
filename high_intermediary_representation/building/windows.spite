# ../../PROOFS.md#an-index-offset-by-a-base-is-proven-by-one-guard
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var proven_paths = List<String>()
var proven_types = List<Model.Type>()

func Windows(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func note_a_guard(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_binary_guard(condition)
    }
}

func note_a_binary_guard(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        note_a_guard(binary.left)
        note_a_guard(binary.right)
        return
    }
    assert binary.operator == 'less_or_equal'
    note_a_window(binary.left, binary.right)
}

func note_a_leaving_guard(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if condition == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_binary_leaving_guard(condition)
    }
}

func note_a_binary_leaving_guard(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'or' {
        note_a_leaving_guard(binary.left)
        note_a_leaving_guard(binary.right)
        return
    }
    assert binary.operator == 'greater'
    note_a_window(binary.left, binary.right)
}

func note_a_window(
    sum: AbstractSyntaxTree.Shapes.Expressions.Expression?,
    counted: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    if sum == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        note_a_window_of_a_sum(sum, counted)
    }
}

func note_a_window_of_a_sum(
    sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    assert sum.operator == 'plus'
    var base = name_of(sum.left)
    var width = name_of(sum.right)
    assert not base.is_empty() and not width.is_empty()
    if counted == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        note_a_counted_window(base, width, counted)
    }
}

func note_a_counted_window(base: String, width: String, counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = counted.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        note_a_listed_window(base, width, counted, callee)
    }
}

func note_a_listed_window(
    base: String,
    width: String,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    assert counted.arguments.is_empty() and callee.name == "count"
    crash callee.target
    context.window_bases.append(base)
    context.window_widths.append(width)
    context.window_lists.append(callee.target)
}

func name_of(written: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if written == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name
    }
    return ""
}

func read_a_counter(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    proven_paths = List<String>()
    proven_types = List<Model.Type>()
    assert condition.operator == 'less'
    var counter = name_of(condition.left)
    var width = name_of(condition.right)
    assert not counter.is_empty() and not width.is_empty()
    var index = 0
    while index < context.window_widths.count() {
        var noted_width = context.window_widths[index]
        if noted_width == width {
            read_a_window(index, counter)
        }
        index = index + 1
    }
}

func read_a_window(index: Integer, counter: String) {
    var base = context.window_bases[index]
    var listed = context.window_lists[index]
    crash base
    crash listed
    var list_value = values.value_of(listed, null)
    assert context.has_a_class(list_value.value_type) and not list_value.value_type.is_nullable
    var owner = context.class_of(list_value.value_type)
    assert values.is_a_counted_collection(owner)
    var item_type = owner.bound_types["$element_type"]
    assert not item_type or not item_type.is_nullable
    var reader = owner.function_named("get_at")
    assert reader
    assert reader.answer
    var element: Model.Type = reader.answer
    var printer = Printers.Spite.ExpressionPrinter(listed)
    var list_text = printer.text()
    proven_paths.append("{list_text}[{base} + {counter}]")
    var present = element.present()
    proven_types.append(present)
}

func forget_a_name(name: String) {
    var index = context.window_widths.count() - 1
    while index >= 0 {
        var width = context.window_widths[index]
        var base = context.window_bases[index]
        crash width
        crash base
        if width == name or base == name {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_a_list(listed_text: String) {
    var index = context.window_lists.count() - 1
    while index >= 0 {
        var listed = context.window_lists[index]
        crash listed
        var printer = Printers.Spite.ExpressionPrinter(listed)
        if printer.text() == listed_text {
            forget_at(index)
        }
        index = index - 1
    }
}

func forget_at(index: Integer) {
    context.window_bases.remove_at(index)
    context.window_widths.remove_at(index)
    context.window_lists.remove_at(index)
}

var state = ReflectionState()
var described_names = DescribedNames()
var feature_flags = Features(state)
var writing = Writing(state)
var class_objects = ClassObjects(state)
var scalars = Model.Scalars()

func Declarations(starting_state: ReflectionState) {
    state = starting_state
    described_names = DescribedNames()
    feature_flags = Features(starting_state)
    writing = Writing(starting_state)
    class_objects = ClassObjects(starting_state)
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func function_file_of(declared: Model.FunctionModel, model: Model.ClassModel): SpiteCompiler.Value {
    var written_in = ""
    if declared.declaration {
        var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = declared.declaration
        written_in = declaration.path
    }
    return source_path_of(written_in, model)
}

# ../../../spite_documentation/reflection.md#spiteattribute
func attribute_file_of(attribute: Model.AttributeModel, model: Model.ClassModel): SpiteCompiler.Value {
    var written_in = ""
    if attribute.declaration {
        var declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration = attribute.declaration
        written_in = declaration.path
    }
    return source_path_of(written_in, model)
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func source_path_of(written_in: String, model: Model.ClassModel): SpiteCompiler.Value {
    if not feature_flags.has_feature("p") {
        return writing.text("")
    }
    var path = written_in
    if path.is_empty() {
        path = model.file.path
    }
    var relative = described_names.written_path_of(path)
    return writing.text(relative)
}

# ../../../spite_documentation/reflection.md#spiteattribute
func attribute_declaration_of(
    attribute: Model.AttributeModel,
    index: Integer,
    model: Model.ClassModel,
): SpiteCompiler.Value {
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(attribute.name)
    made_given["index"] = writing.whole(index)
    made_given["class"] = class_objects.described_class_of(attribute.attribute_type)
    made_given["source_path"] = attribute_file_of(attribute, model)
    return writing.made_by_name(declaration_type, made_given)
}

func is_listed(declared: Model.FunctionModel): Boolean {
    fallback not declared.is_a_constructor() and not declared.is_a_member_template() and not declared.is_a_walk_copy
    return not declared.name.starts_with("_")
}

func can_be_built(declared: Model.FunctionModel): Boolean {
    fallback not declared.is_a_member_template() and declared.has_a_body()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var parameter_type = parameter.parameter_type
        fallback parameter_type.kind != 'object' or not parameter_type.name.starts_with("Spite.")
        index = index + 1
    }
    return true
}

func function_type_of(declared: Model.FunctionModel): Model.Type {
    var parameter_types = declared.parameters.map_parameter_types()
    var signature = Model.Signature(parameter_types, declared.answer, false)
    var function_type = Model.Type('function', "Spite.Function")
    function_type.signature = signature
    return function_type
}

func argument_of(parameter: Model.ParameterModel, index: Integer, argument_type: Model.Type): SpiteCompiler.Value {
    var made_given = given_of_an_argument(parameter, index)
    return writing.made_by_name(argument_type, made_given)
}

func given_of_an_argument(parameter: Model.ParameterModel, index: Integer): Dictionary<String, SpiteCompiler.Value> {
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(parameter.name)
    made_given["index"] = writing.whole(index)
    made_given["class"] = class_objects.described_class_of(parameter.parameter_type)
    return made_given
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func answer_of(declared: Model.FunctionModel): SpiteCompiler.Value {
    if declared.answer {
        var answer: Model.Type = declared.answer
        return class_objects.described_class_of(answer)
    }
    return class_objects.class_object("Nothing")
}

func belongs_to_the_program(model: Model.ClassModel): Boolean {
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var folder = described_names.folder_of(entry.file.path)
    var forward_path = model.file.path.replace("\\", "/")
    fallback forward_path.starts_with(folder)
    var path_length = forward_path.length()
    var folder_length = folder.length()
    var rest = forward_path.slice(folder_length, path_length)
    crash rest
    return not rest.contains("..")
}

func holds_its_values_itself(model: Model.ClassModel): Boolean {
    var namespace = model.file.namespace
    var is_a_collection = namespace == "List" or namespace == "Dictionary"
    return is_a_collection or namespace == "String" or scalars.is_a_scalar(namespace)
}

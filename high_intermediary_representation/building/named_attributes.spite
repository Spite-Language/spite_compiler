var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func NamedAttributes(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func named_attribute_object(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): SpiteCompiler.Value? {
    var literals = Literals(context, values)
    var templates = Templates(context, values)
    var reflection = Reflection(context, values)
    var listed = index.target
    var instance = ""
    var item = literals.this_value()
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name == "attributes"
        var described_owner = templates.constant_attribute_owner_of(listed.target)
        fallback described_owner.is_empty()
        var name = attribute_name_of_an_index(index)
        if name.is_empty() and is_a_declaration_local(index.index) {
            return untied_declaration(index, listed)
        }
        fallback not name.is_empty()
        item = values.value_of(listed.target, null)
        var instance_printer = Printers.Spite.ExpressionPrinter(listed.target)
        instance = instance_printer.text()
        fallback not lists_its_own_attributes(item)
        var is_an_instance = item.value_type.kind == 'object' and not item.value_type.is_nullable
        if not is_an_instance or not context.has_a_class(item.value_type) {
            var listed_printer = Printers.Spite.ExpressionPrinter(listed)
            var listed_text = listed_printer.text()
            var listing_rule = Validators.HighIntermediaryRepresentation.InstanceAttributeNamed.Validator()
            var listing_answer = listing_rule.check_a_listing(context, listed_text)
            context.tell(listing_answer)
            return values.unbuilt()
        }
    } else if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback listed.name == "attributes" and not context.scope.internal_name_of("attributes")
        fallback item.value_type.kind == 'object'
    } else {
        return null
    }
    var name = attribute_name_of_an_index(index)
    fallback not name.is_empty()
    fallback item.value_type.kind == 'object' and not item.value_type.is_nullable
    fallback context.has_a_class(item.value_type)
    var model = values.present_class_of(item)
    var printer = Printers.Spite.ExpressionPrinter(index)
    var indexed = printer.text()
    note_the_declaring_class(index, model, instance)
    var named_rule = Validators.HighIntermediaryRepresentation.InstanceAttributeNamed.Validator()
    var named_answer = named_rule.check_a_name(context, model, name, indexed)
    context.tell(named_answer)
    var attribute = model.attribute_named(name)
    crash attribute
    var place = templates.attribute_index_of(model, name)
    return reflection.member_lists.attribute_of_an_object(item, model, attribute, place, attribute.attribute_type)
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func is_a_declaration_local(written: SpiteCompiler.Expression?): Boolean {
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var internal_name = context.scope.internal_name_of(written.name)
    fallback internal_name
    var local_type = context.scope.type_of(internal_name)
    fallback local_type
    return local_type.name == "Spite.AttributeDeclaration"
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func untied_declaration(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value {
    var item = values.value_of(listed.target, null)
    var instance_printer = Printers.Spite.ExpressionPrinter(listed.target)
    var instance = instance_printer.text()
    var declaration_printer = Printers.Spite.ExpressionPrinter(index.index)
    var declaration = declaration_printer.text()
    var instance_class = context.shown(item.value_type)
    var rule = Validators.HighIntermediaryRepresentation.DeclarationIndex.Validator()
    var rule_answer = rule.check_an_untied_declaration(context, instance_class, instance, declaration)
    context.tell(rule_answer)
    return values.unbuilt()
}

# ../../../spite_documentation/reflection.md#the-spite-classes
func lists_its_own_attributes(item: SpiteCompiler.Value): Boolean {
    fallback item.value_type.kind == 'object' and context.has_a_class(item.value_type)
    var model = values.present_class_of(item)
    if model.attribute_named("attributes") {
        return true
    }
    if model.function_named("get_attributes") {
        return true
    }
    return false
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func note_the_declaring_class(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    model: Model.ClassModel,
    instance: String,
) {
    var known = KnownCalls(context, values)
    var written = index.index
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var owner_key = known.attribute_owner_named_by(index.index)
    var declaration_class = ""
    var owner = context.program.class_named(owner_key)
    if owner {
        declaration_class = owner.shown
    }
    var declaration_printer = Printers.Spite.ExpressionPrinter(index.index)
    var declaration = declaration_printer.text()
    var rule = Validators.HighIntermediaryRepresentation.DeclarationIndex.Validator()
    var rule_answer = rule.check(context, model.shown, declaration_class, instance, declaration)
    context.tell(rule_answer)
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func attribute_name_of_an_index(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var known = KnownCalls(context, values)
    var written = index.index
    var literal = values.key_name_of(written)
    if literal {
        return literal
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and written.name == "name" {
        var walked_name = walked_member_named_by(written.target)
        if not walked_name.is_empty() {
            return walked_name
        }
        return known.attribute_name_named_by(written.target)
    }
    return known.attribute_name_named_by(written)
}

# ../../../spite_documentation/reflection.md#known-while-compiling
func walked_member_named_by(written: SpiteCompiler.Expression?): String {
    var function = context.current_function
    var binding = function.binding_or_empty()
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback written.name == function.bound_parameter() and not binding.member_is_a_function
    return binding.member
}

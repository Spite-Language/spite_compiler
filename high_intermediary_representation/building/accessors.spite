# ../../../spite_documentation/functions_and_operators.md#settergetter-interception

func writes_its_storage(setter: Model.FunctionModel, attribute: Model.AttributeModel): Boolean {
    if setter.parameters.count() != 1 or setter.is_synthetic {
        return true
    }
    return only_stores(setter, attribute)
}

func reads_its_storage(getter: Model.FunctionModel, attribute: Model.AttributeModel): Boolean {
    if not getter.parameters.is_empty() or not getter.answer or getter.is_synthetic {
        return true
    }
    return only_answers(getter, attribute)
}

# ../../../spite_documentation/functions_and_operators.md#settergetter-interception
func is_its_own_accessor(function: Model.FunctionModel, name: String): Boolean {
    var names = Model.AccessorNames()
    var setter_name = names.setter_of(name)
    var getter_name = names.getter_of(name)
    if function.name == setter_name {
        return function.parameters.count() == 1
    }
    fallback function.name == getter_name
    fallback function.answer
    return function.parameters.is_empty()
}

func only_stores(setter: Model.FunctionModel, attribute: Model.AttributeModel): Boolean {
    var parameter = setter.parameters[0]
    crash parameter
    fallback parameter.name != attribute.name
    fallback parameter.parameter_type.is_the_same_as(attribute.attribute_type)
    var only = only_statement_of(setter)
    fallback only
    if only.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        fallback names_the_storage(only.target, attribute.name, setter)
        return names_the(only.value, parameter.name)
    }
    return false
}

func only_answers(getter: Model.FunctionModel, attribute: Model.AttributeModel): Boolean {
    crash getter.answer
    fallback getter.answer.is_the_same_as(attribute.attribute_type)
    var only = only_statement_of(getter)
    fallback only
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return names_the_storage(only.value, attribute.name, getter)
    }
    return false
}

func only_statement_of(function: Model.FunctionModel): SpiteCompiler.WrittenStatement? {
    fallback function.declaration
    fallback function.declaration.body and function.declaration.body.statements.count() == 1
    return function.declaration.body.statements[0]
}

func names_the(written: SpiteCompiler.Expression?, name: String): Boolean {
    fallback written
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

# ../../../spite_documentation/functions_and_operators.md#settergetter-interception
func names_the_storage(written: SpiteCompiler.Expression?, name: String, function: Model.FunctionModel): Boolean {
    fallback written
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and written.name == "value" {
        return indexes_the_storage(written.target, name, function)
    }
    return false
}

func indexes_the_storage(written: SpiteCompiler.Expression?, name: String, function: Model.FunctionModel): Boolean {
    fallback written
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        fallback names_the(written.target, "attributes")
        return keys_the_attribute(written.index, name, function)
    }
    return false
}

func keys_the_attribute(written: SpiteCompiler.Expression?, name: String, function: Model.FunctionModel): Boolean {
    fallback written
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        fallback written.pieces.count() == 1
        var piece = written.pieces[0]
        fallback not piece.hole
        return piece.value() == name
    }
    var bound = function.bound_parameter()
    fallback not bound.is_empty()
    return names_the(written, bound)
}

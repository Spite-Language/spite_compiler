var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var made = Model.ClassModel("", "", no_file)
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0

func VectorSite(
    starting_made: Model.ClassModel,
    starting_owner: Model.ClassModel,
    starting_function: Model.FunctionModel,
    starting_line: Integer,
) {
    made = starting_made
    owner = starting_owner
    function = starting_function
    line = starting_line
}

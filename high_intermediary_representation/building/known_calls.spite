var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var rule = Validators.HighIntermediaryRepresentation.KnownCall.Validator()

func KnownCalls(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func made_by(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): SpiteCompiler.Statement? {
    var written = statement.value
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return made_from(statement, written)
    }
    return null
}

func made_from(
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
    written: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Statement? {
    var path = values.class_path_of(written.callee)
    var joined = path.join(".")
    fallback joined == "Spite.Call" and written.arguments.count() == 2
    var declared_written = written.arguments[0]
    var declared = declaration_named_by(declared_written)
    fallback declared
    var instance_written = written.arguments[1]
    var instance = values.value_of(instance_written, null)
    var instance_type = instance.value_type
    var rule_answer = rule.check_the_instance(context, instance_type, instance_written, declared)
    context.tell(rule_answer)
    var hidden = context.scope.declare("{statement.name}_instance", instance_type)
    context.known_calls[statement.name] = declared
    context.known_call_instances[statement.name] = hidden
    context.known_call_types[statement.name] = instance_type
    return HighIntermediaryRepresentation.Statements.Declare(hidden, instance_type, instance, statement.line, "")
}

func declaration_named_by(written: SpiteCompiler.Expression?): Model.FunctionModel? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return context.known_declarations[written.name]
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return declaration_listed_at(written)
    }
    return null
}

func declaration_listed_at(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Model.FunctionModel? {
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return declaration_in(listed, index.index)
    }
    return null
}

func declaration_in(
    listed: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    written: SpiteCompiler.Expression?,
): Model.FunctionModel? {
    var questions = Questions(values.context, values)
    fallback listed.name == "functions"
    var name = values.key_name_of(written)
    fallback name
    var described = questions.constant_class_of(listed.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model and model.key != context.program.entry
    var function = model.function_named(name)
    fallback function
    var reflection = Reflection(context, values)
    fallback reflection.declarations.is_listed(function)
    return function
}

func remember_a_declaration(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    context.declared_value = null
    remember_an_attribute_owner(statement)
    remember_a_named_attribute(statement)
    var declared = declaration_named_by(statement.value)
    fallback declared and not statement.declared_type
    context.known_declarations[statement.name] = declared
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func remember_an_attribute_owner(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var reads = Reads(context, values)
    var templates = Templates(context, values)
    fallback not statement.declared_type
    var name = templates.constant_attribute_name(statement.value)
    fallback not name.is_empty() and not reads.is_assigned_again(statement.name)
    var owner = templates.constant_attribute_owner(statement.value)
    fallback not owner.is_empty()
    context.known_attribute_owners[statement.name] = owner
    context.known_attribute_names[statement.name] = name
}

# ../../../spite_documentation/reflection.md#an-attribute-kept-in-a-var
func kept_value_of(
    name: String,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
): SpiteCompiler.Statement? {
    if context.kept_attribute_values[name] {
        context.kept_attribute_values.remove_at(name)
    }
    var declared = declared_value_of(statement)
    fallback declared
    var value_type = declared.value_type
    var hidden = context.scope.declare("{name}_attribute_value", value_type)
    context.kept_attribute_values[name] = hidden
    return HighIntermediaryRepresentation.Statements.Declare(hidden, value_type, declared, statement.line, "")
}

func declared_value_of(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): SpiteCompiler.Value? {
    var reads = Reads(context, values)
    var declared = context.declared_value
    context.declared_value = null
    fallback declared and not statement.declared_type
    var printer = Printers.Spite.ExpressionPrinter(statement.value)
    var written = printer.text()
    fallback written == context.declared_value_path
    fallback not reads.is_assigned_again(statement.name)
    return declared
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func remember_a_named_attribute(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var reads = Reads(context, values)
    fallback not statement.declared_type and not reads.is_assigned_again(statement.name)
    if lists_the_attributes(statement.value) and is_only_indexed(statement.name) {
        context.attribute_listings.append(statement.name)
        return
    }
    var names = attributes_named_by(statement.value)
    fallback not names.is_empty()
    var is_a_list = statement.value.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    fallback not is_a_list or is_only_indexed(statement.name)
    context.named_attribute_locals[statement.name] = names
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func attributes_named_by(written: SpiteCompiler.Expression?): List<String> {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return attributes_named_at(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return attributes_named_by_a_local(written.name)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return attributes_named_in(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and written.name == "name" {
        return attributes_named_by(written.target)
    }
    return List<String>()
}

func attributes_named_by_a_local(name: String): List<String> {
    var known = context.named_attribute_locals[name]
    if known {
        return known
    }
    return List<String>()
}

func attributes_named_at(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): List<String> {
    if not lists_the_attributes(index.target) {
        return attributes_named_by(index.target)
    }
    var name = values.key_name_of(index.index)
    if name {
        return [name]
    }
    return attributes_named_by(index.index)
}

func attributes_named_in(listed: AbstractSyntaxTree.Shapes.Expressions.ListLiteral): List<String> {
    var names = List<String>()
    var index = 0
    while index < listed.entries.count() {
        var entry = listed.entries[index]
        var named = attributes_named_by(entry)
        fallback not named.is_empty()
        named.each(names.append)
        index = index + 1
    }
    return names
}

func lists_the_attributes(listed: SpiteCompiler.Expression?): Boolean {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return listed.name == "attributes"
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return context.attribute_listings.contains(listed.name)
    }
    return false
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func is_only_indexed(name: String): Boolean {
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    fallback context.current_function.declaration
    walk.read_function(context.current_function.declaration)
    var named = 0
    var indexed = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if walk.is_the_name(found.expression, name) {
            named = named + 1
        }
        if is_an_index_into(found.expression, walk, name) {
            indexed = indexed + 1
        }
        index = index + 1
    }
    return named == indexed and not is_written_through(walk, name)
}

func is_written_through(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement and is_an_index_into(statement.target, walk, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_an_index_into(written: SpiteCompiler.Expression?, walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return walk.is_the_name(written.target, name)
    }
    return false
}

func forget_a_declaration(name: String) {
    if context.named_attribute_locals[name] {
        context.named_attribute_locals.remove_at(name)
    }
    var listing = context.attribute_listings.index_of(name)
    if listing {
        context.attribute_listings.remove_at(listing)
    }
    if context.known_attribute_owners[name] {
        context.known_attribute_owners.remove_at(name)
    }
    if context.known_attribute_names[name] {
        context.known_attribute_names.remove_at(name)
    }
    fallback context.known_declarations[name]
    context.known_declarations.remove_at(name)
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func attribute_owner_named_by(written: SpiteCompiler.Expression?): String {
    var templates = Templates(context, values)
    var literal_name = templates.constant_attribute_name(written)
    if not literal_name.is_empty() {
        return templates.constant_attribute_owner(written)
    }
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var known = context.known_attribute_owners[written.name]
    fallback known
    return known
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func attribute_name_named_by(written: SpiteCompiler.Expression?): String {
    var templates = Templates(context, values)
    var literal_name = templates.constant_attribute_name(written)
    if not literal_name.is_empty() {
        return literal_name
    }
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var known = context.known_attribute_names[written.name]
    fallback known
    return known
}

func fill_of(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement): SpiteCompiler.Statement? {
    var target = statement.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return fill_at(statement, target)
    }
    return null
}

func fill_at(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): SpiteCompiler.Statement? {
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return fill_through(statement, index, listed)
    }
    return null
}

func fill_through(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Statement? {
    fallback member.name == "arguments"
    var named = member.target
    if named.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return fill_named(statement, index, named.name)
    }
    return null
}

func fill_named(
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    call_name: String,
): SpiteCompiler.Statement? {
    var fitting = Fitting(values.context, values)
    var declared = context.known_calls[call_name]
    fallback declared
    var argument_name = values.key_name_of(index.index)
    var rule_answer = rule.check_an_argument_name(context, argument_name, call_name)
    context.tell(rule_answer)
    crash argument_name
    var parameter = parameter_named(declared, argument_name)
    rule_answer = rule.check_a_parameter(context, parameter, call_name, argument_name, declared.name)
    context.tell(rule_answer)
    crash parameter
    var key = "{call_name}.{argument_name}"
    var filled = context.known_call_arguments[key]
    rule_answer = rule.check_a_refill(context, filled, call_name, argument_name)
    context.tell(rule_answer)
    var value = fitting.fitted_value_of(statement.value, parameter.parameter_type)
    var hidden = context.scope.declare("{call_name}_{argument_name}", parameter.parameter_type)
    context.known_call_arguments[key] = hidden
    return HighIntermediaryRepresentation.Statements.Declare(
        hidden,
        parameter.parameter_type,
        value,
        statement.line,
        "",
    )
}

func parameter_named(declared: Model.FunctionModel, name: String): Model.ParameterModel? {
    return declared.parameters.find_by_name(name)
}

func ran_by(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "call"
    var named = callee.target
    if named.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return ran_named(call, named.name)
    }
    return null
}

func ran_named(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, call_name: String): SpiteCompiler.Value? {
    var declared = context.known_calls[call_name]
    fallback declared
    var hidden = context.known_call_instances[call_name]
    crash hidden
    var instance_type = context.known_call_types[call_name]
    crash instance_type
    var rule_answer = rule.check_a_run(context, call.arguments, call_name)
    context.tell(rule_answer)
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var key = "{call_name}.{parameter.name}"
        var filled = context.known_call_arguments[key]
        rule_answer = rule.check_a_filled_argument(context, filled, call_name, parameter.name, declared.name)
        context.tell(rule_answer)
        crash filled
        var read = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, filled)
        arguments.append(read)
        index = index + 1
    }
    var instance = HighIntermediaryRepresentation.Values.LocalRead(instance_type, hidden)
    context.need(declared)
    return HighIntermediaryRepresentation.Values.Call(declared, instance, arguments, "", "")
}

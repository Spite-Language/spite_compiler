# ../../PROOFS.md#narrowing-a-t
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var kind = ""
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var value: Value? = null
var value_type = Model.Type('nothing', "")
var wanted = Model.Type('nothing', "")
var name = ""

func PresenceSite(
    starting_kind: String,
    starting_context: Context,
    starting_value_type: Model.Type,
) {
    kind = starting_kind
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
    value_type = starting_value_type
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func Questions(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func bound_type_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "has_function" and call.arguments.count() == 1
    var target = callee.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return bound_has_function(target.name, call)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return member_class_has_function(target, call)
    }
    return null
}

func member_class_has_function(
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    var function = context.current_function
    var binding = function.binding_or_empty()
    fallback target.name == "class" and binding.member_type
    var described = target.target
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and described.name == function.bound_parameter() {
        return has_function_answer(binding.member_type, call)
    }
    return null
}

func bound_has_function(
    bound_name: String,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    fallback bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    fallback bound
    return has_function_answer(bound, call)
}

func has_function_answer(
    bound: Model.Type,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): SpiteCompiler.Value? {
    var asked = call.arguments[0]
    var function_name = ""
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        function_name = values.constant_text_of(asked)
    }
    fallback not function_name.is_empty()
    var answer = 0
    if context.has_a_class(bound) {
        var model = context.class_of(bound)
        if model.function_named(function_name) {
            answer = 1
        }
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, answer, false)
}

func folded_text_question(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var cased = folded_casing(receiver, name, written)
    if cased {
        return cased
    }
    var asks = name == "starts_with" or name == "ends_with"
    fallback asks and written.count() == 1
    var known = known_text_of(receiver)
    fallback known
    var argument = written[0]
    var piece: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        piece = values.plain_text_of(argument)
    }
    fallback piece
    var holds = known.ends_with(piece)
    if name == "starts_with" {
        holds = known.starts_with(piece)
    }
    return values.boolean_constant(holds)
}

# ../../../spite_documentation/standard_library.md#snake-camel-and-pascal-case
func folded_casing(
    receiver: SpiteCompiler.Value,
    name: String,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var casing = name == "snake_case" or name == "camel_case" or name == "pascal_case"
    fallback casing and written.is_empty()
    var known = known_text_of(receiver)
    fallback known
    var cased = known.pascal_case()
    if name == "snake_case" {
        cased = known.snake_case()
    } else if name == "camel_case" {
        cased = known.camel_case()
    }
    return values.described_text(cased)
}

func known_text_of(value: SpiteCompiler.Value): String? {
    if value.class == HighIntermediaryRepresentation.Values.TextConstant {
        return value.text
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return context.text_locals[value.name]
    }
    return null
}

func asks_a_question(template: Model.FunctionModel): Boolean {
    var asking = List<String>()
    asking.append("filter_")
    asking.append("count_")
    asking.append("any_")
    asking.append("all_")
    asking.append("remove_where_")
    var index = 0
    while index < asking.count() {
        var prefix = asking[index]
        if template.name.starts_with(prefix) {
            return true
        }
        index = index + 1
    }
    return false
}

func holds_a_function_value(name: String): Boolean {
    var held = context.current_class.attribute_named(name)
    fallback held
    return held.attribute_type.kind == 'function'
}

func value_call_of(invoked: SpiteCompiler.Value, written: List<SpiteCompiler.Expression>): SpiteCompiler.Value {
    var fitting = Fitting(context, values)
    var callee = invoked
    if invoked.value_type.is_nullable {
        values.note_a_maybe_null("held", invoked, "", invoked.value_type)
        callee = values.as_present(invoked)
    }
    var called_type = callee.value_type
    var signature = called_type.signature_or_empty()
    var shown_type = context.shown(called_type)
    var wanted_count = signature.parameters.count()
    var given_count = written.count()
    var argument_count = Validators.HighIntermediaryRepresentation.ArgumentCount.Validator()
    var argument_count_answer = argument_count.check(context, shown_type, wanted_count, given_count)
    context.tell(argument_count_answer)
    var arguments = List<SpiteCompiler.Value>()
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var wanted = signature.parameters[index]
        crash wanted
        var value = fitting.fitted_value_of(argument, wanted)
        arguments.append(value)
        index = index + 1
    }
    var value_type = Model.Type('nothing', "")
    if signature.answer {
        value_type = signature.answer
    }
    return HighIntermediaryRepresentation.Values.Function.ValueCall(callee, arguments, value_type)
}

func vector_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "fits_vector" and call.arguments.is_empty()
    var asked = known_class_asked(callee.target)
    fallback asked
    var is_plain = asked.kind == 'scalar' or asked.kind == 'enumeration'
    var fits = is_plain or values.fits_a_vector(asked)
    return values.boolean_constant(fits)
}

func any_attribute_fit_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "any_attribute_fits_vector"
    var asked = known_class_asked(callee.target)
    fallback asked
    var skipped = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var path = values.class_path_of(written)
        var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
        var skipped_type = context.resolver.types.class_type_in(path, no_arguments, context.current_class, context.line)
        skipped.append(skipped_type.name)
        index = index + 1
    }
    var holds = any_attribute_fits(asked, skipped)
    return values.boolean_constant(holds)
}

func any_attribute_fits(asked: Model.Type, skipped: List<String>): Boolean {
    if asked.kind == 'shape' and not asked.is_nullable {
        return any_member_fits(asked, skipped)
    }
    fallback context.has_a_class(asked) and not asked.is_nullable
    var model = context.class_of(asked)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type
        var counts = not skipped.contains(held.name) and values.fits_a_vector(held)
        if counts {
            return true
        }
        index = index + 1
    }
    return false
}

func any_member_fits(asked: Model.Type, skipped: List<String>): Boolean {
    var shape = context.program.shape_keyed(asked.name)
    crash shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute and member.answer {
            var counts = not skipped.contains(member.answer.name) and values.fits_a_vector(member.answer)
            if counts {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func known_class_asked(asked: SpiteCompiler.Expression?): Model.Type? {
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback asked.name.starts_with("$")
        return context.current_class.bound_types[asked.name]
    }
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_class_asked(asked)
    }
    return null
}

func walked_class_asked(asked: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Model.Type? {
    var function = context.current_function
    var binding = function.binding_or_empty()
    var described = asked.target
    var names_the_walked = false
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == "class" and described.name == function.bound_parameter()
    }
    fallback names_the_walked
    return binding.member_type
}

func pattern_argument_count(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var function = context.current_function
    var binding = function.binding_or_empty()
    var bound_pattern = binding.pattern_or_empty()
    fallback callee.name == "argument_count" and call.arguments.is_empty() and not function.bound_parameter().is_empty()
    var asked = callee.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter()
    }
    fallback names_the_walked
    var walked_argument_count = Validators.HighIntermediaryRepresentation.WalkedArgumentCount.Validator()
    var walked_argument_count_answer = walked_argument_count.check(context, function)
    context.tell(walked_argument_count_answer)
    var walked_class = context.program.class_named(bound_pattern.class_key)
    crash walked_class
    var bound = walked_class.function_named(bound_pattern.function)
    crash bound
    var integer = context.scalar_type("Integer")
    var counted = bound.parameters.count()
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted, false)
}

func reflection_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var question = callee.name
    var lists = question == "has_function" or question == "argument_count" or question == "function_waits"
    fallback lists or question == "function_writes_parameter"
    var described = constant_class_of(callee.target)
    fallback described
    var model = context.program.class_named(described)
    fallback model
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var asked = printer.text()
    var pattern = written_pattern_of(call)
    var rule = Validators.HighIntermediaryRepresentation.FunctionQuestion.Validator()
    var rule_answer = rule.check_a_written_pattern(context, pattern, asked, question)
    context.tell(rule_answer)
    crash pattern
    var bound_pattern = pattern_of_the_walk(pattern)
    var matching = values.matching_functions(model, bound_pattern)
    var has_one = not matching.is_empty()
    if question == "has_function" {
        return values.boolean_constant(has_one)
    } else if question == "argument_count" {
        return counted_arguments(matching, asked, pattern)
    } else if question == "function_waits" {
        return waits_question(matching)
    } else {
        return writes_question(call, asked, matching)
    }
}

func pattern_of_the_walk(pattern: String): String {
    var function = context.current_function
    var binding = function.binding_or_empty()
    var bound_pattern = binding.pattern_or_empty()
    if bound_pattern.function.is_empty() or bound_pattern.pattern.is_empty() {
        return pattern
    }
    var opened = pattern.replace("<", "")
    var unwrapped = opened.replace(">", "")
    if unwrapped == bound_pattern.pattern {
        return bound_pattern.function
    }
    return pattern
}

func written_pattern_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String? {
    fallback not call.arguments.is_empty()
    var written = call.arguments[0]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return values.plain_text_of(written)
    }
    return null
}

func folded_function_count(target: SpiteCompiler.Expression?): SpiteCompiler.Value? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return folded_filtered_count(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listed_count(target, "", "")
    }
    return null
}

func folded_filtered_count(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Value? {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_name_filter(call, callee)
    }
    return null
}

func folded_name_filter(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var is_a_suffix = callee.name == "filter_name_ends_with"
    var is_a_prefix = callee.name == "filter_name_starts_with"
    fallback is_a_suffix or is_a_prefix
    fallback call.arguments.count() == 1
    var argument = call.arguments[0]
    var text: String? = null
    if argument.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        text = values.plain_text_of(argument)
    }
    fallback text
    var listing = callee.target
    if listing.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return folded_listing_by_a_name(listing, text, is_a_suffix)
    }
    return null
}

func folded_listing_by_a_name(
    listing: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    text: String,
    is_a_suffix: Boolean,
): SpiteCompiler.Value? {
    if is_a_suffix {
        return folded_listed_count(listing, "", text)
    }
    return folded_listed_count(listing, text, "")
}

func folded_listed_count(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    prefix: String,
    suffix: String,
): SpiteCompiler.Value? {
    fallback member.name == "functions"
    var key = constant_class_of(member.target)
    fallback key
    var model = context.program.class_named(key)
    fallback model
    var reflection = Reflection(context, values)
    var count = 0
    var index = 0
    var has_a_stand_in = model.key != context.program.entry
    while has_a_stand_in and index < model.declared_functions.count() {
        var declared = model.declared_functions[index]
        var is_named = declared.name.starts_with(prefix) and declared.name.ends_with(suffix)
        if is_named and not declared.is_synthetic and reflection.declarations.is_listed(declared) {
            count = count + 1
        }
        index = index + 1
    }
    var integer = context.scalar_type("Integer")
    var number: Long = count
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, number, false)
}

func constant_class_of(target: SpiteCompiler.Expression?): String? {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return constant_class_named(target.name, target.generic_arguments)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return constant_class_of_a_member(target)
    }
    return null
}

func constant_class_named(name: String, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): String? {
    fallback not context.scope.internal_name_of(name)
    var function = context.current_function
    var binding = function.binding_or_empty()
    var walk_copy = function.walk_copy_or_empty()
    if walk_copy.binds_a_class and name == function.bound_parameter() {
        crash binding.member_type
        return binding.member_type.name
    }
    if name.starts_with("$") {
        return bound_class_named(name)
    }
    if name == "class" {
        fallback not context.current_class.attribute_named("class")
        return context.current_class.key
    }
    var path = List<String>()
    path.append(name)
    return class_key_of_path(path, arguments)
}

func bound_class_named(name: String): String? {
    var bound = context.current_class.bound_types[name]
    fallback bound
    fallback not bound.is_nullable
    fallback context.has_a_class(bound)
    return bound.name
}

func constant_class_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String? {
    var function = context.current_function
    var binding = function.binding_or_empty()
    var target = member.target
    var names_the_walked = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = target.name == function.bound_parameter() and not function.bound_parameter().is_empty()
    }
    if names_the_walked and member.name == "class" {
        fallback binding.member_type
        var walked: Model.Type = binding.member_type
        fallback context.has_a_class(walked) and not walked.is_nullable
        return walked.name
    }
    var path = values.class_path_of(member)
    return class_key_of_path(path, member.generic_arguments)
}

# ../../../spite_documentation/reflection.md#whether-a-class-satisfies-a-type
func satisfaction_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback callee.name == "satisfies_type" and call.arguments.count() == 1
    var found = constant_class_type_of(callee.target)
    fallback found
    var written = call.arguments[0]
    var wanted = written_type_of(written)
    var rule = Validators.HighIntermediaryRepresentation.SatisfiedType.Validator()
    var rule_answer = rule.check_a_written_type(context, wanted, callee, written)
    context.tell(rule_answer)
    crash wanted
    var fitting = Fitting(context, values)
    var holds = fitting.satisfies(found, wanted)
    return values.boolean_constant(holds)
}

func constant_class_type_of(target: SpiteCompiler.Expression?): Model.Type? {
    var walked = walked_class_type_of(target)
    if walked {
        return walked
    }
    var key = constant_class_of(target)
    fallback key
    if values.scalars.is_a_scalar(key) {
        return Model.Type('scalar', key)
    }
    return Model.Type('object', key)
}

func walked_class_type_of(target: SpiteCompiler.Expression?): Model.Type? {
    var function = context.current_function
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    var binding = function.binding_or_empty()
    var bound_pattern = binding.pattern_or_empty()
    fallback target.name == "class" and not function.bound_parameter().is_empty()
    fallback not bound_pattern.binds_a_function_declaration and binding.member_type
    var walked = target.target
    fallback walked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback walked.name == function.bound_parameter()
    var bound: Model.Type = binding.member_type
    return bound.present()
}

func written_type_of(written: SpiteCompiler.Expression): Model.Type? {
    var fitting = Fitting(context, values)
    var path = values.tested_class_path_of(written)
    fallback not path.is_empty()
    var arguments = values.type_arguments_of(written)
    var number = fitting.number_type()
    var whole = path.join(".")
    if whole == number.name and arguments.is_empty() {
        return number
    }
    return context.resolver.types.class_type_in(path, arguments, context.current_class, context.line)
}

func class_key_of_path(path: List<String>, arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): String? {
    fallback not path.is_empty()
    var written = path.join(".")
    fallback not context.resolver.state.symbols.namespace_folder(written)
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    fallback found or values.scalars.is_a_scalar(written)
    var described = context.resolver.types.class_type_in(path, arguments, context.current_class, context.line)
    var is_a_class = described.kind == 'object' or described.kind == 'scalar'
    fallback is_a_class and context.has_a_class(described)
    return described.name
}

func counted_arguments(matching: List<Model.FunctionModel>, asked: String, pattern: String): SpiteCompiler.Value {
    var integer = context.scalar_type("Integer")
    var rule = Validators.HighIntermediaryRepresentation.FunctionQuestion.Validator()
    var found = matching.first()
    var rule_answer = rule.check_a_counted_function(context, found, asked, pattern)
    context.tell(rule_answer)
    crash found
    var counted = found.parameters.count()
    rule_answer = rule.check_the_counts(context, matching, counted, asked, pattern)
    context.tell(rule_answer)
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, counted, false)
}

func waits_question(matching: List<Model.FunctionModel>): SpiteCompiler.Value {
    var listing = Reflection(context, values)
    var buildable = matching.filter(listing.declarations.can_be_built)
    if buildable.is_empty() {
        return values.boolean_constant(false)
    }
    return asked_fact("waits", buildable)
}

func writes_question(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    asked: String,
    matching: List<Model.FunctionModel>,
): SpiteCompiler.Value {
    var rule = Validators.HighIntermediaryRepresentation.FunctionQuestion.Validator()
    var place = parameter_place_of(call)
    var rule_answer = rule.check_a_parameter_place(context, place, asked)
    context.tell(rule_answer)
    if matching.is_empty() {
        return values.boolean_constant(false)
    }
    var listing = Reflection(context, values)
    var cannot_tell = false
    var index = 0
    while index < matching.count() {
        var function = matching[index]
        var owner_name = base_name_of(function.owner)
        rule_answer = rule.check_a_parameter(context, owner_name, function, place)
        context.tell(rule_answer)
        if not listing.declarations.can_be_built(function) {
            cannot_tell = true
        }
        index = index + 1
    }
    if cannot_tell {
        return values.boolean_constant(true)
    }
    var made = asked_fact("writes", matching)
    made.parameter_index = place
    return made
}

func parameter_place_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Integer {
    if call.arguments.count() != 2 {
        return -1
    }
    var written = call.arguments[1]
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return values.literal_place_of(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return walked_place_of(written)
    }
    return -1
}

func walked_place_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Integer {
    var function = context.current_function
    var binding = function.binding_or_empty()
    var asked = member.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter() and member.name == "index"
    }
    if not names_the_walked or binding.member.is_empty() {
        return -1
    }
    return binding.member_index
}

func asked_fact(
    question: String,
    functions: List<Model.FunctionModel>,
): HighIntermediaryRepresentation.Values.Function.Fact {
    var boolean = context.boolean()
    var is_asked_in_code = true
    var asking_key = context.current_function.key()
    var path = context.path()
    var line = context.line
    var owner_shown = base_name_of(context.current_class.shown)
    var function_name = context.current_function.name
    var made = HighIntermediaryRepresentation.Values.Function.Fact(
        boolean,
        question,
        functions,
        "",
        is_asked_in_code,
        asking_key,
        path,
        line,
        owner_shown,
        function_name,
    )
    context.facts_asked.append(made)
    functions.each(context.need)
    return made
}

func base_name_of(shown: String): String {
    var opening = shown.index_of("<")
    if opening and opening > 0 {
        var sliced = shown.slice(0, opening)
        crash sliced
        return sliced
    }
    return shown
}

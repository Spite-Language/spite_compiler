var name = ""
var function_name = ""
var call_line = 0
var caller = ""
var row = BorrowedItem("", 0, "")
var parameter_type = Model.Type('nothing', "")
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var model = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")

func LentParameter(
    starting_name: String,
    starting_function_name: String,
    starting_call_line: Integer,
    starting_caller: String,
) {
    name = starting_name
    function_name = starting_function_name
    call_line = starting_call_line
    caller = starting_caller
}

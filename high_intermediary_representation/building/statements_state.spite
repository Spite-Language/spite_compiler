var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var built = List<SpiteCompiler.Statement>()
var facts_paths = List<String>()
var facts_types = List<Model.Type>()
var facts_checks = List<String>()
var facts_before_a_call = List<String>()
var condition_start = 0
var endings = Endings()
var template_walk = Validators.HighIntermediaryRepresentation.TemplateWalk.Validator()
var rest_is_folded_away = false
var enclosing_blocks = List<EnclosingBlock>()
var at_function_root = false
var last_site_identity = ""
var shown_parts = List<ShownPart>()
var shown_texts = List<String>()
var name_places = List<String>()
var reads_before = false
var reported_count = 0
var report_name = ""
var report_types = List<String>()
var shown_count = 0
var missing_conjuncts = List<SpiteCompiler.Expression>()
var missing_links = List<SpiteCompiler.Expression>()
var last_check = ""
var last_check_at = -1
var last_check_line = 0
var last_check_block = ""

func start_from(starting_context: Context) {
    context = starting_context
    values = Values(starting_context)
}

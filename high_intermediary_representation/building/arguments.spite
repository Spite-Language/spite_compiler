var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func Arguments(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func fitted_arguments(
    function: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value> {
    var spread = spread_arguments(function, written)
    if spread {
        return spread
    }
    var shown = "{function.owner}.{function.name}"
    var owner = context.program.class_named(function.owner)
    var walks_the_function = false
    if owner {
        walks_the_function = context.resolver.state.symbols.is_library_path(owner.file.path)
    }
    return arguments_for(shown, function.parameters, written, walks_the_function)
}

func spread_arguments(
    function: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    fallback written.count() == 1
    var only = written[0]
    if only.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return spread_of(function, only)
    }
    return null
}

func spread_of(
    function: Model.FunctionModel,
    spreading: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<SpiteCompiler.Value>? {
    var callee = spreading.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return spread_by(function, callee.name, spreading.arguments)
    }
    return null
}

func spread_by(
    function: Model.FunctionModel,
    name: String,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    var owner = context.current_class
    fallback not owner.function_named(name)
    var index = 0
    while index < owner.declared_functions.count() {
        var template = owner.declared_functions[index]
        var is_singular = template.is_a_member_template and not values.template_takes_a_plural(template)
        if is_singular and values.walks_by_the_name(template, name) {
            return spread_over(function, owner, template, written)
        }
        index = index + 1
    }
    return null
}

func spread_over(
    function: Model.FunctionModel,
    owner: Model.ClassModel,
    template: Model.FunctionModel,
    written: List<SpiteCompiler.Expression>,
): List<SpiteCompiler.Value>? {
    var literals = Literals(context, values)
    var fitting = Fitting(context, values)
    var outer_spread = values.spread_into
    values.spread_into = function
    var plural_name = "{template.name}s"
    var member_owner = values.owner_of_a_template(template, owner, plural_name)
    if not member_owner or member_owner.kind != 'parameters' {
        values.spread_into = outer_spread
        return null
    }
    var arguments = List<SpiteCompiler.Value>()
    var word = values.walked_word(template)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var called_name = template.name.replace(word, parameter.name)
        var made = values.member_template_of(owner, called_name)
        crash made
        var own = literals.this_value()
        var answered = values.called(made, own, written)
        var fitted_answer = fitting.fitted(answered, parameter.parameter_type)
        arguments.append(fitted_answer)
        index = index + 1
    }
    values.spread_into = outer_spread
    return arguments
}

func arguments_for(
    shown: String,
    parameters: List<Model.ParameterModel>,
    written: List<SpiteCompiler.Expression>,
    walks_the_function: Boolean,
): List<SpiteCompiler.Value> {
    var fitting = Fitting(context, values)
    var collections = Collections(context, values)
    var arguments = List<SpiteCompiler.Value>()
    var last = parameters.last()
    var is_variadic = false
    if last {
        is_variadic = last.is_variadic
    }
    var fixed_count = parameters.count()
    if is_variadic {
        fixed_count = fixed_count - 1
    }
    var count_is_wrong = written.count() != parameters.count()
    if is_variadic {
        count_is_wrong = written.count() < fixed_count
    }
    if count_is_wrong {
        var given_count = written.count()
        var wanted_count = parameters.count()
        values.typing.refuse_argument_count(context, shown, wanted_count, given_count)
    }
    var index = 0
    while index < fixed_count {
        var argument = written[index]
        var parameter = parameters[index]
        crash parameter
        var given = values.value_of(argument, parameter.parameter_type)
        refuse_a_nullable_answer(shown, argument, given.value_type, parameter.parameter_type)
        if walks_the_function {
            refuse_a_passed_value(shown, argument, given.value_type, parameter.parameter_type)
            refuse_a_passed_function(shown, argument, given.value_type, parameter.parameter_type)
        }
        var value = fitting.fitted(given, parameter.parameter_type)
        var folded_keys = Folded.Keys(context, values)
        folded_keys.check_a_passed_map(value, shown)
        arguments.append(value)
        index = index + 1
    }
    if is_variadic {
        crash last
        var gathered = collections.gathered_list(last.parameter_type, written, fixed_count)
        arguments.append(gathered)
    }
    return arguments
}

func refuse_a_nullable_answer(
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback given.answer and wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback given_answer.is_nullable and not wanted_answer.is_nullable
    var present = given_answer.present()
    fallback present.is_the_same_as(wanted_answer)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    values.typing.refuse_a_nullable_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_function(
    shown: String,
    argument: SpiteCompiler.Expression?,
    given: Model.Type,
    wanted: Model.Type,
) {
    fallback given.kind == 'function' and wanted.kind == 'function' and argument
    fallback not values.same_signature(given, wanted)
    var parts = shown.split(".")
    var called_name = parts.last()
    crash called_name
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    if given.parameters.count() != wanted.parameters.count() {
        refuse_a_passed_count(called_name, argument_text, given, wanted)
    }
    var index = 0
    while index < given.parameters.count() {
        var given_parameter = given.parameters[index]
        var wanted_parameter = wanted.parameters[index]
        crash wanted_parameter
        if not given_parameter.is_the_same_as(wanted_parameter) {
            var given_shown = context.shown(given_parameter)
            var wanted_shown = context.shown(wanted_parameter)
            values.typing.refuse_a_passed_type(context, called_name, argument_text, wanted_shown, given_shown)
        }
        index = index + 1
    }
    if given.answer and wanted.answer {
        refuse_another_answer(called_name, argument_text, given, wanted)
    }
    fallback wanted.answer and not given.answer
    var wanted_answer: Model.Type = wanted.answer
    var answer_shown = context.shown(wanted_answer)
    values.typing.refuse_a_passed_nothing(context, called_name, argument_text, answer_shown)
}

# ../../PROOFS.md#a-member-template-fits
func refuse_a_passed_value(shown: String, argument: SpiteCompiler.Expression?, given: Model.Type, wanted: Model.Type) {
    fallback given.kind != 'function' and wanted.kind == 'function' and argument
    var parts = shown.split(".")
    var called_name = parts.last()
    fallback called_name == "each"
    var printer = Printers.Spite.ExpressionPrinter(argument)
    var argument_text = printer.text()
    values.typing.refuse_an_each_of_a_value(context, argument_text)
}

func refuse_another_answer(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    crash given.answer
    crash wanted.answer
    var given_answer: Model.Type = given.answer
    var wanted_answer: Model.Type = wanted.answer
    fallback not given_answer.is_the_same_as(wanted_answer)
    var given_shown = context.shown(given_answer)
    var wanted_shown = context.shown(wanted_answer)
    values.typing.refuse_another_answer(context, called_name, argument_text, given_shown, wanted_shown)
}

func refuse_a_passed_count(called_name: String, argument_text: String, given: Model.Type, wanted: Model.Type) {
    var takes = given.parameters.count()
    var gives = wanted.parameters.count()
    if gives == 1 {
        var only = wanted.parameters[0]
        crash only
        var only_shown = context.shown(only)
        values.typing.refuse_a_passed_single(context, called_name, argument_text, only_shown, takes)
    }
    values.typing.refuse_a_passed_count(context, called_name, argument_text, gives, takes)
}

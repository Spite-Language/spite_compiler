var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var host_key = "Spite._FunctionValuesCompared"
var _hash_spreading_prime: Long = 1099511628211
var own_kind = "own "

func FunctionComparers(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func same_function_and_owner(left: SpiteCompiler.Value, right: SpiteCompiler.Value): SpiteCompiler.Value {
    var fitting = Fitting(context, values)
    var compared_type = left.value_type.present()
    var fitted_right = fitting.fitted(right, compared_type)
    var comparer = comparer_of(compared_type, "compare")
    var host = host_class()
    var host_type = host.type_of_an_instance()
    var no_object = HighIntermediaryRepresentation.Values.NullConstant(host_type)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(left)
    arguments.append(fitted_right)
    return HighIntermediaryRepresentation.Values.Call(comparer, no_object, arguments, "", "")
}

# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func held_form_of(function: SpiteCompiler.Value): SpiteCompiler.Value {
    return called_with_one(function, "hold")
}

# ../../OPTIMIZATIONS.md#an-observer-finds-an-equal-subscriber-by-its-hash
func hash_of(function: SpiteCompiler.Value): SpiteCompiler.Value {
    return called_with_one(function, "hash")
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func own_held_form_of(function: SpiteCompiler.Value, owner: SpiteCompiler.Value): SpiteCompiler.Value {
    var compared_type = function.value_type.present()
    var made = comparer_of(compared_type, "{own_kind}{owner.value_type.name}")
    var host = host_class()
    var host_type = host.type_of_an_instance()
    var no_object = HighIntermediaryRepresentation.Values.NullConstant(host_type)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(function)
    arguments.append(owner)
    return HighIntermediaryRepresentation.Values.Call(made, no_object, arguments, "", "")
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func stored_by_its_own(value: SpiteCompiler.Value, holder: SpiteCompiler.Value): SpiteCompiler.Value? {
    var owner = fresh_read_of(holder)
    fallback owner
    if not value.value_type.is_nullable {
        fallback value.value_type.kind == 'function'
        return own_held_form_of(value, owner)
    }
    fallback value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'nullable'
    fallback value.converted and value.converted.value_type.kind == 'function'
    var held = own_held_form_of(value.converted, owner)
    return HighIntermediaryRepresentation.Values.Conversion(value.value_type, 'nullable', held, "")
}

func fresh_read_of(holder: SpiteCompiler.Value): SpiteCompiler.Value? {
    if holder.class == HighIntermediaryRepresentation.Values.ThisRead {
        return HighIntermediaryRepresentation.Values.ThisRead(holder.value_type)
    }
    fallback holder.class == HighIntermediaryRepresentation.Values.LocalRead
    return HighIntermediaryRepresentation.Values.LocalRead(holder.value_type, holder.name)
}

func called_with_one(function: SpiteCompiler.Value, kind: String): SpiteCompiler.Value {
    var compared_type = function.value_type.present()
    var made = comparer_of(compared_type, kind)
    var host = host_class()
    var host_type = host.type_of_an_instance()
    var no_object = HighIntermediaryRepresentation.Values.NullConstant(host_type)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(function)
    return HighIntermediaryRepresentation.Values.Call(made, no_object, arguments, "", "")
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func identical(left: SpiteCompiler.Value, right: SpiteCompiler.Value): SpiteCompiler.Value {
    var operators = Operators(context, values)
    var boolean = context.boolean()
    var held_left = operators.held_once(left)
    var held_right = operators.held_once(right)
    var same_function = same_part(held_left, held_right, "address")
    var same_owner = same_part(held_left, held_right, "owner")
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', same_function, same_owner, null)
}

func same_part(left: SpiteCompiler.Value, right: SpiteCompiler.Value, part: String): SpiteCompiler.Value {
    var boolean = context.boolean()
    var mine = word_of(left, part)
    var theirs = word_of(right, part)
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', mine, theirs, null)
}

func word_of(value: SpiteCompiler.Value, part: String): SpiteCompiler.Value {
    var long_type = context.scalar_type("Long")
    var word = Model.AttributeModel(part, "Spite.FunctionValue", long_type, null, false)
    return HighIntermediaryRepresentation.Values.AttributeRead(value, word)
}

func host_class(): Model.ClassModel {
    var known = context.program.class_named(host_key)
    if known {
        return known
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var made = Model.ClassModel(host_key, host_key, no_file, false)
    context.program.add(made)
    return made
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func comparer_of(compared_type: Model.Type, kind: String): Model.FunctionModel {
    var reflection = Reflection(context, values)
    var index = 0
    while index < context.function_comparers.count() {
        var known_type = context.function_comparer_types[index]
        var known = context.function_comparers[index]
        var known_kind = context.function_comparer_kinds[index]
        crash known_type
        var is_the_kind = known_kind == kind
        if is_the_kind and reflection.wrappers.same_signature(known_type, compared_type) {
            return known.function
        }
        index = index + 1
    }
    var host = host_class()
    var answer = answer_of(compared_type, kind)
    var is_synthetic = true
    var made = Model.FunctionModel(
        "{name_of(kind)}_{context.function_comparers.count()}",
        host.key,
        answer,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    var left = Model.ParameterModel("left", compared_type, false)
    made.parameters.append(left)
    if kind == "compare" {
        var right = Model.ParameterModel("right", compared_type, false)
        made.parameters.append(right)
    }
    if kind.starts_with(own_kind) {
        var owner_key = owner_key_of(kind)
        var owner_class = context.program.class_named(owner_key)
        crash owner_class
        var owner_type = owner_class.type_of_an_instance()
        var owner = Model.ParameterModel("owner", owner_type, false)
        made.parameters.append(owner)
    }
    host.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    context.function_comparers.append(function)
    context.function_comparer_types.append(compared_type)
    context.function_comparer_counts.append(-1)
    context.function_comparer_kinds.append(kind)
    var position = context.function_comparers.count() - 1
    recompare(position)
    return made
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func recompare(index: Integer) {
    var function = context.function_comparers[index]
    var compared_type = context.function_comparer_types[index]
    var counted = context.function_comparer_counts[index]
    crash function
    crash compared_type
    crash counted
    var kind = context.function_comparer_kinds[index]
    crash kind
    var candidates = candidates_of(compared_type)
    if kind.starts_with(own_kind) {
        var owner_key = owner_key_of(kind)
        candidates = own_candidates_of(candidates, owner_key)
    }
    fallback candidates.count() != counted
    context.function_comparer_counts[index] = candidates.count()
    if kind.starts_with(own_kind) {
        function.body = own_holding_body(compared_type, candidates)
    } else if kind == "hold" {
        function.body = holding_body(compared_type, candidates)
    } else if kind == "hash" {
        function.body = hashing_body(compared_type, candidates)
    } else {
        function.body = comparing_body(compared_type, candidates)
    }
}

func owner_key_of(kind: String): String {
    return kind.replace(own_kind, "")
}

func name_of(kind: String): String {
    if kind.starts_with(own_kind) {
        return "own_held_form"
    } else if kind == "hold" {
        return "held_form"
    } else if kind == "hash" {
        return "hash_of_function_and_owner"
    }
    return "same_function_and_owner"
}

func answer_of(compared_type: Model.Type, kind: String): Model.Type {
    if kind == "hold" or kind.starts_with(own_kind) {
        return compared_type
    } else if kind == "hash" {
        return context.scalar_type("Long")
    }
    return context.boolean()
}

# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func holding_body(
    compared_type: Model.Type,
    candidates: List<Integer>,
): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var index = 0
    while index < candidates.count() {
        var taken_index = candidates[index]
        crash taken_index
        var owner_type = context.taken_receivers[taken_index]
        crash owner_type
        if may_hold_its_owner_back(owner_type) {
            var held = held_when_it_is(compared_type, taken_index)
            body.statements.append(held)
        }
        index = index + 1
    }
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var answered = HighIntermediaryRepresentation.Statements.Return(left, 0)
    body.statements.append(answered)
    return body
}

# ../../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func held_when_it_is(compared_type: Model.Type, taken_index: Integer): HighIntermediaryRepresentation.Statements.If {
    var boolean = context.boolean()
    var candidate = context.taken_functions[taken_index]
    var owner_type = context.taken_receivers[taken_index]
    crash candidate
    crash owner_type
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var given_address = word_of(left, "address")
    var given_owner = word_of(left, "owner")
    context.need(candidate)
    var plain = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, given_owner)
    var plain_address = word_of(plain, "address")
    var is_plain = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        given_address,
        plain_address,
        null,
    )
    var owner = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type, null, false)
    var owner_read = HighIntermediaryRepresentation.Values.AttributeRead(left, owner)
    var held = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, owner_read)
    held.holds_its_receiver_back = true
    held.holds_its_owner_for_the_call = true
    held.skips_a_freed_owner = true
    hold_the_owner_back(owner_type)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var answered = HighIntermediaryRepresentation.Statements.Return(held, 0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_plain, then_branch, null, 0, "")
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func own_candidates_of(candidates: List<Integer>, owner_key: String): List<Integer> {
    var found = List<Integer>()
    var owner = context.program.class_named(owner_key)
    fallback owner and not is_copied(owner)
    var index = 0
    while index < candidates.count() {
        var taken_index = candidates[index]
        crash taken_index
        var owner_type = context.taken_receivers[taken_index]
        crash owner_type
        if owner_type.name == owner_key and may_hold_its_owner_back(owner_type) {
            found.append(taken_index)
        }
        index = index + 1
    }
    return found
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func is_copied(owner: Model.ClassModel): Boolean {
    var index = 0
    while index < owner.declared_functions.count() {
        var function = owner.declared_functions[index]
        var is_a_copy = function.name == "copy" or function.name == "deep_copy" or function.name == "_deep_copy_in"
        if is_a_copy and function.is_synthetic {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func own_holding_body(
    compared_type: Model.Type,
    candidates: List<Integer>,
): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var index = 0
    while index < candidates.count() {
        var taken_index = candidates[index]
        crash taken_index
        var held = own_held_when_it_is(compared_type, taken_index)
        body.statements.append(held)
        index = index + 1
    }
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var answered = HighIntermediaryRepresentation.Statements.Return(left, 0)
    body.statements.append(answered)
    return body
}

# ../../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func own_held_when_it_is(
    compared_type: Model.Type,
    taken_index: Integer,
): HighIntermediaryRepresentation.Statements.If {
    var boolean = context.boolean()
    var candidate = context.taken_functions[taken_index]
    var owner_type = context.taken_receivers[taken_index]
    crash candidate
    crash owner_type
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var given_address = word_of(left, "address")
    var given_owner = word_of(left, "owner")
    context.need(candidate)
    var plain = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, given_owner)
    var plain_address = word_of(plain, "address")
    var is_plain = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        given_address,
        plain_address,
        null,
    )
    var owner = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type, null, false)
    var owner_read = HighIntermediaryRepresentation.Values.AttributeRead(left, owner)
    var storing_owner = HighIntermediaryRepresentation.Values.LocalRead(owner_type, "owner")
    var is_its_own = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        owner_read,
        storing_owner,
        null,
    )
    var is_it = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', is_plain, is_its_own, null)
    var bound_again = HighIntermediaryRepresentation.Values.LocalRead(owner_type, "owner")
    var held = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, bound_again)
    held.holds_its_receiver_back = true
    held.holds_its_owner_for_the_call = true
    hold_the_owner_back(owner_type)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var answered = HighIntermediaryRepresentation.Statements.Return(held, 0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_it, then_branch, null, 0, "")
}

func hold_the_owner_back(owner_type: Model.Type) {
    var held_owners = context.program.owners_held_by_observers
    fallback not held_owners.contains(owner_type.name)
    held_owners.append(owner_type.name)
}

# ../../OPTIMIZATIONS.md#an-observer-finds-an-equal-subscriber-by-its-hash
func hashing_body(
    compared_type: Model.Type,
    candidates: List<Integer>,
): HighIntermediaryRepresentation.Statements.Block {
    var long_type = context.scalar_type("Long")
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var index = 0
    while index < candidates.count() {
        var taken_index = candidates[index]
        crash taken_index
        var hashed = hashed_when_it_is(compared_type, taken_index, index + 1)
        body.statements.append(hashed)
        index = index + 1
    }
    var nothing_known = HighIntermediaryRepresentation.Values.WholeNumber(long_type, 0, false)
    var answered = HighIntermediaryRepresentation.Statements.Return(nothing_known, 0)
    body.statements.append(answered)
    return body
}

# ../../OPTIMIZATIONS.md#an-observer-finds-an-equal-subscriber-by-its-hash
func hashed_when_it_is(
    compared_type: Model.Type,
    taken_index: Integer,
    number: Integer,
): HighIntermediaryRepresentation.Statements.If {
    var boolean = context.boolean()
    var long_type = context.scalar_type("Long")
    var candidate = context.taken_functions[taken_index]
    var owner_type = context.taken_receivers[taken_index]
    crash candidate
    crash owner_type
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var given_address = word_of(left, "address")
    var given_owner = word_of(left, "owner")
    context.need(candidate)
    var made = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, given_owner)
    var candidate_address = word_of(made, "address")
    var is_it: SpiteCompiler.Value = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        given_address,
        candidate_address,
        null,
    )
    if may_hold_its_owner_back(owner_type) {
        var held = same_held_entry(compared_type, candidate, given_owner, given_address, false)
        is_it = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', is_it, held, null)
        var subscribed = same_held_entry(compared_type, candidate, given_owner, given_address, true)
        is_it = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', is_it, subscribed, null)
    }
    var hash: SpiteCompiler.Value = HighIntermediaryRepresentation.Values.WholeNumber(long_type, number, false)
    var owner = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type, null, false)
    var owner_read = HighIntermediaryRepresentation.Values.AttributeRead(left, owner)
    var parts = hashed_parts_of(owner_type, owner_read)
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        hash = mixed(hash, part)
        index = index + 1
    }
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var answered = HighIntermediaryRepresentation.Statements.Return(hash, 0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_it, then_branch, null, 0, "")
}

# ../../OPTIMIZATIONS.md#an-observer-finds-an-equal-subscriber-by-its-hash
func hashed_parts_of(owner_type: Model.Type, owner: SpiteCompiler.Value): List<SpiteCompiler.Value> {
    var parts = List<SpiteCompiler.Value>()
    var equality = Equality(context, values)
    fallback equality.is_given_equals(owner_type)
    var model = context.class_of(owner_type)
    var held_items = equality.held_items_function(model)
    fallback held_items.is_empty()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var part = hashed_part(owner, attribute)
        if part and not attribute.is_a_key_slot {
            parts.append(part)
        }
        index = index + 1
    }
    return parts
}

# ../../OPTIMIZATIONS.md#an-observer-finds-an-equal-subscriber-by-its-hash
func hashed_part(owner: SpiteCompiler.Value, attribute: Model.AttributeModel): SpiteCompiler.Value? {
    var long_type = context.scalar_type("Long")
    var held = attribute.attribute_type
    fallback not held.is_nullable
    var read = HighIntermediaryRepresentation.Values.AttributeRead(owner, attribute)
    if held.kind == 'object' and held.name == "String" {
        var text = context.program.class_named("String")
        fallback text
        var length = text.attribute_named("_length")
        fallback length
        var counted = HighIntermediaryRepresentation.Values.AttributeRead(read, length)
        return HighIntermediaryRepresentation.Values.Conversion(long_type, 'widen', counted, "")
    }
    fallback held.kind == 'scalar'
    if held.name == "Long" {
        return read
    }
    fallback held.name == "Integer" or held.name == "Short" or held.name == "Byte"
    return HighIntermediaryRepresentation.Values.Conversion(long_type, 'widen', read, "")
}

func mixed(hash: SpiteCompiler.Value, part: SpiteCompiler.Value): SpiteCompiler.Value {
    var long_type = context.scalar_type("Long")
    var prime = HighIntermediaryRepresentation.Values.WholeNumber(long_type, _hash_spreading_prime, false)
    var spread = HighIntermediaryRepresentation.Values.MachineOperation(long_type, 'multiply', hash, prime, null)
    spread.is_proven_to_fit = true
    var summed = HighIntermediaryRepresentation.Values.MachineOperation(long_type, 'add', spread, part, null)
    summed.is_proven_to_fit = true
    return summed
}

func candidates_of(compared_type: Model.Type): List<Integer> {
    var reflection = Reflection(context, values)
    var found = List<Integer>()
    var index = 0
    while index < context.taken_functions.count() {
        var taken = context.taken_functions[index]
        var parameter_types = taken.parameters.map_parameter_types()
        var signature = Model.Signature(parameter_types, taken.answer, false)
        var taken_type = Model.Type('function', "Spite.Function")
        taken_type.signature = signature
        if reflection.wrappers.same_signature(taken_type, compared_type) {
            found.append(index)
        }
        index = index + 1
    }
    return found
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func comparing_body(
    compared_type: Model.Type,
    candidates: List<Integer>,
): HighIntermediaryRepresentation.Statements.Block {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var right = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "right")
    var same_function = same_part(left, right, "address")
    var other_function = HighIntermediaryRepresentation.Values.Negation(same_function)
    var unequal = answered_when(other_function, false)
    body.statements.append(unequal)
    var same_owner = same_part(left, right, "owner")
    var itself = answered_when(same_owner, true)
    body.statements.append(itself)
    var index = 0
    while index < candidates.count() {
        var taken_index = candidates[index]
        crash taken_index
        var compared = compared_when_it_is(compared_type, taken_index)
        body.statements.append(compared)
        index = index + 1
    }
    var message = "spite: a function value the compiler did not list was compared at run time"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message, 0)
    body.statements.append(stopped)
    var no = values.boolean_constant(false)
    var answered = HighIntermediaryRepresentation.Statements.Return(no, 0)
    body.statements.append(answered)
    return body
}

func answered_when(condition: SpiteCompiler.Value, answer: Boolean): HighIntermediaryRepresentation.Statements.If {
    var given = values.boolean_constant(answer)
    var answered = HighIntermediaryRepresentation.Statements.Return(given, 0)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(condition, then_branch, null, 0, "")
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func compared_when_it_is(
    compared_type: Model.Type,
    taken_index: Integer,
): HighIntermediaryRepresentation.Statements.If {
    var boolean = context.boolean()
    var candidate = context.taken_functions[taken_index]
    var owner_type = context.taken_receivers[taken_index]
    crash candidate
    crash owner_type
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var given_address = word_of(left, "address")
    var given_owner = word_of(left, "owner")
    context.need(candidate)
    var made = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, given_owner)
    var candidate_address = word_of(made, "address")
    var is_it: SpiteCompiler.Value = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        given_address,
        candidate_address,
        null,
    )
    if may_hold_its_owner_back(owner_type) {
        var held = same_held_entry(compared_type, candidate, given_owner, given_address, false)
        is_it = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', is_it, held, null)
        var subscribed = same_held_entry(compared_type, candidate, given_owner, given_address, true)
        is_it = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', is_it, subscribed, null)
    }
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    var owners_equal = owners_equal_as(compared_type, owner_type, then_branch)
    var answered = HighIntermediaryRepresentation.Statements.Return(owners_equal, 0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_it, then_branch, null, 0, "")
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func may_hold_its_owner_back(owner_type: Model.Type): Boolean {
    fallback owner_type.kind == 'object' and owner_type.name != "String"
    var owner = context.program.class_named(owner_type.name)
    fallback owner
    return not owner.is_singleton and owner.key != context.program.entry
}

# ../../../spite_documentation/functions_and_operators.md#comparing-function-values
func same_held_entry(
    compared_type: Model.Type,
    candidate: Model.FunctionModel,
    given_owner: SpiteCompiler.Value,
    given_address: SpiteCompiler.Value,
    skips: Boolean,
): SpiteCompiler.Value {
    var boolean = context.boolean()
    var made = HighIntermediaryRepresentation.Values.Function.Value(compared_type, candidate, given_owner)
    made.holds_its_receiver_back = true
    made.holds_its_owner_for_the_call = true
    made.skips_a_freed_owner = skips
    made.holds_back_only_a_held_owner = true
    var held_address = word_of(made, "address")
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', given_address, held_address, null)
}

func owners_equal_as(
    compared_type: Model.Type,
    owner_type: Model.Type,
    then_branch: HighIntermediaryRepresentation.Statements.Block,
): SpiteCompiler.Value {
    var operators = Operators(context, values)
    var owner = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type, null, false)
    var left = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "left")
    var right = HighIntermediaryRepresentation.Values.LocalRead(compared_type, "right")
    var mine = HighIntermediaryRepresentation.Values.AttributeRead(left, owner)
    var theirs = HighIntermediaryRepresentation.Values.AttributeRead(right, owner)
    var pending_start = context.pending.count()
    var owners_are_equal = operators.values_equal(mine, theirs)
    var moved = pending_start
    while moved < context.pending.count() {
        var waiting = context.pending[moved]
        then_branch.statements.append(waiting)
        moved = moved + 1
    }
    while context.pending.count() > pending_start {
        crash context.pending.remove_last()
    }
    return owners_are_equal
}

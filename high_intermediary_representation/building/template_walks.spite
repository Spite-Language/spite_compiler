var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var counter = ""
var listed = ""

func check(context: Context, statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var library = Validators.LibraryFile()
    var path = context.path()
    assert not library.holds(path)
    assert context.block_index > 0
    var before = context.block_statements[context.block_index - 1]
    crash before
    counter = ""
    if before == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        counter = started_counter(before)
    }
    assert not counter.is_empty()
    listed = walked_name(statement.condition)
    assert not listed.is_empty()
    crash statement.body
    var body = statement.body.statements
    assert body.count() == 2
    var step = body[1]
    assert steps_the_counter(step)
    var only = body[0]
    if only == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        check_the_call(context, statement.line, only.value)
    }
}

func started_counter(declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement): String {
    var text = printed(declared.value)
    var is_a_start = text == "0" and not declared.declared_type
    if is_a_start {
        return declared.name
    }
    return ""
}

func walked_name(condition: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    var text = printed(condition)
    var opening = "{counter} < "
    var closing = ".count()"
    var is_a_walk = text.starts_with(opening) and text.ends_with(closing)
    if not is_a_walk {
        return ""
    }
    var start = opening.length()
    var end = text.length() - closing.length()
    var name = text.slice(start, end)
    var is_plain = not name.contains(".") and not name.contains("(") and not name.contains("[")
    if is_plain {
        return name
    }
    return ""
}

func steps_the_counter(step: AbstractSyntaxTree.Shapes.Statements.Statement): Boolean {
    if step == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target = printed(step.target)
        var value = printed(step.value)
        return target == counter and value == "{counter} + 1"
    }
    return false
}

func check_the_call(context: Context, line: Integer, value: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_a_call(context, line, value)
    }
}

func check_a_call(context: Context, line: Integer, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var element = "{listed}[{counter}]"
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var receiver = printed(callee.target)
        var is_on_each = receiver == element and call.arguments.is_empty()
        if is_on_each {
            check_a_member_call(context, line, callee.name)
        }
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var argument = call.arguments[0]
        var argument_text = printed(argument)
        var is_with_each = call.arguments.count() == 1 and argument_text == element and not callee.is_a_class_name
        if is_with_each {
            check_a_function_call(context, line, callee.name)
        }
    }
}

func check_a_member_call(context: Context, line: Integer, name: String) {
    var collection = collection_of(context)
    assert collection
    var element_type = collection.bound_types["$element_type"]
    crash element_type
    var is_a_class = element_type.kind == 'object' and not element_type.is_nullable
    assert is_a_class and context.has_a_class(element_type)
    var element_class = context.class_of(element_type)
    var function = element_class.function_named(name)
    assert function
    assert function.parameters.is_empty()
    context.line = line
    typing.refuse_a_template_walk(context, listed, name)
}

func check_a_function_call(context: Context, line: Integer, name: String) {
    var collection = collection_of(context)
    assert collection
    assert collection.file.namespace == "List"
    var function = context.current_class.function_named(name)
    assert function
    assert function.parameters.count() == 1
    context.line = line
    typing.refuse_a_function_walk(context, listed, name)
}

func collection_of(context: Context): Model.ClassModel? {
    var listed_type = type_of_the_listed(context)
    assert listed_type
    var is_an_object = listed_type.kind == 'object' and not listed_type.is_nullable
    assert is_an_object and context.has_a_class(listed_type)
    var model = context.class_of(listed_type)
    var namespace = model.file.namespace
    var is_a_collection = namespace == "List" or namespace == "Vector" or namespace == "Items"
    assert is_a_collection
    return model
}

func type_of_the_listed(context: Context): Model.Type? {
    var internal_name = context.scope.internal_name_of(listed)
    if internal_name {
        return context.scope.type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(listed)
    assert attribute
    return attribute.attribute_type
}

func printed(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if not expression {
        return ""
    }
    var printer = Printers.Spite.ExpressionPrinter(expression)
    return printer.text()
}

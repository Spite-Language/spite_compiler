union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var counter = ""
var listed = ""
var element = ""
var after_text = ""
var walked_line = 0

func check(context: Context, statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var library = Validators.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    fallback not context.resolver.symbols.generated_texts[path]
    fallback context.block_index > 0
    var before = context.block_statements[context.block_index - 1]
    crash before
    counter = ""
    if before.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        counter = started_counter(before)
    }
    fallback not counter.is_empty()
    listed = walked_name(statement.condition)
    fallback not listed.is_empty()
    crash statement.body
    var body = statement.body.statements
    var count = body.count()
    fallback count == 2 or count == 3
    var step = body.last()
    crash step
    fallback steps_the_counter(step)
    var opening = body.first()
    crash opening
    element = "{listed}[{counter}]"
    var core = opening
    if count == 3 {
        element = element_name(opening)
        var middle = body[1]
        crash middle
        core = middle
    }
    fallback not element.is_empty()
    var core_text = printed_statement(core)
    var without_element = core_text.replace(element, "")
    fallback not mentions(without_element, counter)
    fallback not read_after_the_loop(context)
    after_text = statement_after(context)
    walked_line = statement.line
    check_the_core(context, core)
}

func element_name(opening: Statement): String {
    if opening.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        var value = printed(opening.value)
        var is_the_element = value == "{listed}[{counter}]" and not opening.declared_type
        if is_the_element {
            return opening.name
        }
    }
    return ""
}

func read_after_the_loop(context: Context): Boolean {
    var index = context.block_index + 1
    while index < context.block_statements.count() {
        var later = context.block_statements[index]
        var later_text = printed_statement(later)
        if mentions(later_text, counter) {
            return true
        }
        index = index + 1
    }
    return false
}

func statement_after(context: Context): String {
    var index = context.block_index + 1
    if index < context.block_statements.count() {
        var later = context.block_statements[index]
        return printed_statement(later)
    }
    return ""
}

func started_counter(declared: AbstractSyntaxTree.Shapes.Statements.VariableStatement): String {
    var text = printed(declared.value)
    var is_a_start = text == "0" and not declared.declared_type
    if is_a_start {
        return declared.name
    }
    return ""
}

func walked_name(condition: Expression?): String {
    var text = printed(condition)
    var opening = "{counter} < "
    var closing = ".count()"
    var is_a_walk = text.starts_with(opening) and text.ends_with(closing)
    fallback is_a_walk
    var start = opening.length()
    var end = text.length() - closing.length()
    var name = text.slice(start, end)
    crash name
    var is_plain = not name.contains(".") and not name.contains("(") and not name.contains("[")
    if is_plain {
        return name
    }
    return ""
}

func steps_the_counter(step: Statement): Boolean {
    if step.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target = printed(step.target)
        var value = printed(step.value)
        return target == counter and value == "{counter} + 1"
    }
    return false
}

func check_the_core(context: Context, core: Statement) {
    if core.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        check_the_call(context, core.value)
    }
    if core.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        check_a_sum(context, core)
    }
    if core.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        check_a_test(context, core)
    }
    if core.class == AbstractSyntaxTree.Shapes.Statements.FallbackStatement {
        var tested = printed(core.condition)
        check_a_negated_test(context, "not {tested}", "return false")
    }
}

func check_the_call(context: Context, value: Expression?) {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_a_call(context, value)
    }
}

func check_a_call(context: Context, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var receiver = printed(callee.target)
        var is_on_each = receiver == element and call.arguments.is_empty()
        if is_on_each {
            check_a_member_call(context, callee.name)
        }
        var is_an_append = callee.name == "append" and call.arguments.count() == 1
        if is_an_append {
            check_an_append(context, receiver, call.arguments[0])
        }
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var argument = call.arguments[0]
        var argument_text = printed(argument)
        var is_with_each = call.arguments.count() == 1 and argument_text == element and not callee.is_a_class_name
        if is_with_each {
            check_a_function_call(context, callee.name)
        }
    }
}

func check_a_member_call(context: Context, name: String) {
    var element_class = element_class_of(context)
    fallback element_class
    var function = element_class.function_named(name)
    fallback function
    fallback function.parameters.is_empty()
    context.line = walked_line
    typing.refuse_a_template_walk(context, listed, name)
}

func check_a_function_call(context: Context, name: String) {
    fallback is_a_list(context)
    var function = context.current_class.function_named(name)
    fallback function
    fallback function.parameters.count() == 1
    context.line = walked_line
    typing.refuse_a_function_walk(context, listed, name)
}

func check_an_append(context: Context, result: String, appended: Expression?) {
    fallback is_a_kept_list(context, result)
    var appended_text = printed(appended)
    if appended_text == element {
        fallback is_a_list(context)
        refuse(context, "copy it into '{result}'", "var {result} = {listed}.copy()")
        return
    }
    var member = member_read(context, appended_text)
    fallback not member.is_empty()
    var plural = member.pluralize()
    refuse(context, "collect each one's '{member}'", "var {result} = {listed}.map_{plural}()")
}

func check_a_sum(context: Context, assignment: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var total = printed(assignment.target)
    fallback is_a_started_total(context, total)
    var value = printed(assignment.value)
    var opening = "{total} + "
    fallback value.starts_with(opening)
    var length = value.length()
    var start = opening.length()
    var added = value.slice(start, length)
    crash added
    var member = member_read(context, added)
    if not member.is_empty() {
        refuse(context, "add up '{member}'", "var {total} = {listed}.sum_{member}()")
        return
    }
    var function = function_given_the_element(context, added)
    fallback not function.is_empty()
    fallback is_a_list(context)
    refuse(context, "add up what '{function}' answers for each", "var {total} = {listed}.sum({function})")
}

func check_a_test(context: Context, test: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    fallback not test.else_branch
    crash test.then_branch
    var inside = test.then_branch.statements
    fallback inside.count() == 1
    var only = inside.first()
    crash only
    var condition = printed(test.condition)
    var action = printed_statement(only)
    if condition.starts_with("not ") {
        check_a_negated_test(context, condition, action)
        return
    }
    var compared = compared_member(context, condition)
    if not compared.is_empty() {
        check_a_comparison(context, condition, compared, action)
        return
    }
    var member = tested_member(context, condition)
    if not member.is_empty() {
        check_a_member_test(context, member, action)
        return
    }
    var function = tested_function(context, condition)
    fallback not function.is_empty()
    fallback is_a_list(context)
    check_a_function_test(context, function, action)
}

func check_a_negated_test(context: Context, condition: String, action: String) {
    var length = condition.length()
    var tested = condition.slice(4, length)
    crash tested
    fallback action == "return false" and after_text == "return true"
    var member = tested_member(context, tested)
    if not member.is_empty() {
        refuse(context, "ask whether every one's '{member}' holds", "return {listed}.all_{member}()")
        return
    }
    var function = tested_function(context, tested)
    fallback not function.is_empty()
    fallback is_a_list(context)
    refuse(context, "ask whether '{function}' holds for every one", "return {listed}.all({function})")
}

func check_a_comparison(context: Context, condition: String, member: String, action: String) {
    fallback action == "return {element}" and after_text == "return null"
    var opening = "{element}.{member} == "
    var length = condition.length()
    var start = opening.length()
    var wanted = condition.slice(start, length)
    crash wanted
    fallback not mentions(wanted, counter) and not mentions(wanted, element)
    refuse(context, "find the first whose '{member}' is '{wanted}'", "return {listed}.find_by_{member}({wanted})")
}

func check_a_member_test(context: Context, member: String, action: String) {
    if action == "return true" and after_text == "return false" {
        refuse(context, "ask whether any one's '{member}' holds", "return {listed}.any_{member}()")
        return
    }
    var kept = kept_list_of(context, action)
    if not kept.is_empty() {
        fallback is_a_list(context)
        refuse(context, "keep the ones whose '{member}' holds", "var {kept} = {listed}.filter_{member}()")
        return
    }
    var mapped = mapped_list_of(context, action)
    if not mapped.is_empty() {
        var appended = mapped_member(context, mapped, action)
        fallback not appended.is_empty()
        var plural = appended.pluralize()
        refuse(
            context,
            "collect '{appended}' of the ones whose '{member}' holds",
            "var {mapped} = {listed}.filter_{member}().map_{plural}()",
        )
        return
    }
    var total = counted_total(context, action)
    fallback not total.is_empty()
    refuse(context, "count the ones whose '{member}' holds", "var {total} = {listed}.count_{member}()")
}

func check_a_function_test(context: Context, function: String, action: String) {
    if action == "return true" and after_text == "return false" {
        refuse(context, "ask whether '{function}' holds for any one", "return {listed}.any({function})")
        return
    }
    if action == "return {element}" and after_text == "return null" {
        refuse(context, "find the first one '{function}' holds for", "return {listed}.find({function})")
        return
    }
    var kept = kept_list_of(context, action)
    if not kept.is_empty() {
        refuse(context, "keep the ones '{function}' holds for", "var {kept} = {listed}.filter({function})")
        return
    }
    var total = counted_total(context, action)
    fallback not total.is_empty()
    refuse(context, "count the ones '{function}' holds for", "var {total} = {listed}.count({function})")
}

func kept_list_of(context: Context, action: String): String {
    var closing = ".append({element})"
    fallback action.ends_with(closing)
    var length = action.length() - closing.length()
    var result = action.slice(0, length)
    crash result
    if is_a_kept_list(context, result) {
        return result
    }
    return ""
}

func mapped_list_of(context: Context, action: String): String {
    var middle = ".append({element}."
    var found = action.index_of(middle)
    fallback found
    var result = action.slice(0, found)
    crash result
    if is_a_kept_list(context, result) and action.ends_with(")") {
        return result
    }
    return ""
}

func mapped_member(context: Context, result: String, action: String): String {
    var opening = "{result}.append("
    var start = opening.length()
    var end = action.length() - 1
    var appended = action.slice(start, end)
    crash appended
    return member_read(context, appended)
}

func counted_total(context: Context, action: String): String {
    var opening = " = "
    var found = action.index_of(opening)
    fallback found
    var total = action.slice(0, found)
    crash total
    var counted = action == "{total} = {total} + 1"
    if counted and is_a_started_total(context, total) {
        return total
    }
    return ""
}

func compared_member(context: Context, condition: String): String {
    var opening = "{element}."
    fallback condition.starts_with(opening)
    var length = condition.length()
    var start = opening.length()
    var rest = condition.slice(start, length)
    crash rest
    var found = rest.index_of(" == ")
    fallback found
    var member = rest.slice(0, found)
    crash member
    return member_read(context, "{element}.{member}")
}

func tested_member(context: Context, condition: String): String {
    var member = member_read(context, condition)
    fallback not member.is_empty()
    var member_type = member_type_of(context, member)
    crash member_type
    if context.is_boolean(member_type) {
        return member
    }
    return ""
}

func tested_function(context: Context, condition: String): String {
    var function = function_given_the_element(context, condition)
    fallback not function.is_empty()
    var model = context.current_class.function_named(function)
    crash model
    fallback model.answer
    if context.is_boolean(model.answer) {
        return function
    }
    return ""
}

func member_read(context: Context, text: String): String {
    var opening = "{element}."
    fallback text.starts_with(opening)
    var length = text.length()
    var start = opening.length()
    var written = text.slice(start, length)
    crash written
    var member = written
    if written.ends_with("()") {
        var end = written.length() - 2
        var sliced_member = written.slice(0, end)
        crash sliced_member
        member = sliced_member
    }
    var is_plain = not member.contains(".") and not member.contains("(") and not member.contains(" ") and not member.contains("[")
    fallback is_plain and not member.starts_with("_")
    var member_type = member_type_of(context, member)
    if member_type {
        return member
    }
    return ""
}

func member_type_of(context: Context, member: String): Model.Type? {
    var element_class = element_class_of(context)
    fallback element_class
    var attribute = element_class.attribute_named(member)
    if attribute {
        return attribute.attribute_type
    }
    var function = element_class.function_named(member)
    fallback function
    fallback function.parameters.is_empty()
    return function.answer
}

func function_given_the_element(context: Context, text: String): String {
    var closing = "({element})"
    fallback text.ends_with(closing)
    var end = text.length() - closing.length()
    var name = text.slice(0, end)
    crash name
    var is_plain = not name.contains(".") and not name.contains("(") and not name.contains(" ") and not name.is_empty()
    fallback is_plain
    var function = context.current_class.function_named(name)
    fallback function
    if function.parameters.count() == 1 {
        return name
    }
    return ""
}

func is_a_kept_list(context: Context, result: String): Boolean {
    var declared = declared_before(context, result)
    fallback declared
    var value = printed(declared.value)
    return value.starts_with("List<") and value.ends_with(">()")
}

func is_a_started_total(context: Context, total: String): Boolean {
    var declared = declared_before(context, total)
    fallback declared
    var value = printed(declared.value)
    return value == "0" and not declared.declared_type
}

func declared_before(context: Context, name: String): AbstractSyntaxTree.Shapes.Statements.VariableStatement? {
    var index = context.block_index - 2
    while index >= 0 {
        var earlier = context.block_statements[index]
        if earlier.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and earlier.name == name {
            return earlier
        }
        var earlier_text = printed_statement(earlier)
        fallback not mentions(earlier_text, name)
        index = index - 1
    }
    return null
}

func element_class_of(context: Context): Model.ClassModel? {
    var collection = collection_of(context)
    fallback collection
    var element_type = collection.bound_types["$element_type"]
    crash element_type
    var is_a_class = element_type.kind == 'object' and not element_type.is_nullable
    fallback is_a_class and context.has_a_class(element_type)
    return context.class_of(element_type)
}

func is_a_list(context: Context): Boolean {
    var collection = collection_of(context)
    fallback collection
    return collection.file.namespace == "List"
}

func collection_of(context: Context): Model.ClassModel? {
    var listed_type = type_of_the_listed(context)
    fallback listed_type
    var is_an_object = listed_type.kind == 'object' and not listed_type.is_nullable
    fallback is_an_object and context.has_a_class(listed_type)
    var model = context.class_of(listed_type)
    var namespace = model.file.namespace
    var is_a_collection = namespace == "List" or namespace == "Vector" or namespace == "Items"
    fallback is_a_collection
    return model
}

func type_of_the_listed(context: Context): Model.Type? {
    var internal_name = context.scope.internal_name_of(listed)
    if internal_name {
        return context.scope.type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(listed)
    fallback attribute
    return attribute.attribute_type
}

func refuse(context: Context, doing: String, written: String) {
    context.line = walked_line
    typing.refuse_a_walk(context, listed, doing, written)
}

func mentions(text: String, word: String): Boolean {
    var length = text.length()
    var word_length = word.length()
    var index = 0
    while index + word_length <= length {
        var end = index + word_length
        var piece = text.slice(index, end)
        crash piece
        if piece == word and is_a_word_edge(text, index - 1) and is_a_word_edge(text, end) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_word_edge(text: String, position: Integer): Boolean {
    if position < 0 or position >= text.length() {
        return true
    }
    var code = text.byte_at(position)
    var is_a_lower = code >= 97 and code <= 122
    var is_an_upper = code >= 65 and code <= 90
    var is_a_letter = is_a_lower or is_an_upper
    var is_a_digit = code >= 48 and code <= 57
    return not is_a_letter and not is_a_digit and code != 95
}

func printed(expression: Expression?): String {
    fallback expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    return printer.text()
}

func printed_statement(statement: Statement?): String {
    fallback statement
    var printer = Printers.Spite.StatementPrinter(statement)
    return printer.text()
}

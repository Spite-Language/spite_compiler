# ../../PROOFS.md#a-literal-that-converts-is-a-t

var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var no_function = Model.FunctionModel("", "")
var no_arguments = List<SpiteCompiler.Value>()
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var call = HighIntermediaryRepresentation.Values.Call(no_function, null, no_arguments)
var shown_literal = ""
var shown_conversion = ""
var written_decimal = ""
var does_not_convert = false

func LiteralSite(
    starting_context: Context,
    starting_call: HighIntermediaryRepresentation.Values.Call,
    starting_shown_literal: String,
    starting_shown_conversion: String,
) {
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
    call = starting_call
    shown_literal = starting_shown_literal
    shown_conversion = starting_shown_conversion
}

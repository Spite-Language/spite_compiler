union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func PassedForms(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func sum_for(listing: Model.ClassModel, measure_type: Model.Type): Model.FunctionModel? {
    fallback measure_type.kind == 'function'
    fallback measure_type.answer
    var total_type: Model.Type = measure_type.answer
    fallback total_type.kind == 'scalar' and not total_type.is_nullable
    var name = "_sum_of_{total_type.name}"
    var known = listing.function_named(name)
    if known {
        return known
    }
    var reader = listing.function_named("_read_value")
    fallback reader
    var length = listing.attribute_named("_length")
    fallback length
    var made = Model.FunctionModel(name, listing.key)
    made.is_synthetic = true
    made.answer = total_type
    var measured = Model.ParameterModel("measure", measure_type, false)
    made.parameters.append(measured)
    listing.declared_functions.append(made)
    values.need(reader)
    var integer = context.scalar_type("Integer")
    var boolean = context.boolean()
    var own_type = listing.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var zero = zero_of(total_type)
    var total_declared = HighIntermediaryRepresentation.Statements.Declare("total", total_type, zero)
    body.statements.append(total_declared)
    var start = HighIntermediaryRepresentation.Values.WholeNumber(integer, 0)
    var index_declared = HighIntermediaryRepresentation.Statements.Declare("index", integer, start)
    body.statements.append(index_declared)
    var index_read = HighIntermediaryRepresentation.Values.LocalRead(integer, "index")
    var length_read = HighIntermediaryRepresentation.Values.AttributeRead(own, length)
    var going_on = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'less', index_read, length_read)
    var loop_body = HighIntermediaryRepresentation.Statements.Block()
    var positions = List<Value>()
    positions.append(index_read)
    var item = HighIntermediaryRepresentation.Values.Call(reader, own, positions)
    var measure_read = HighIntermediaryRepresentation.Values.LocalRead(measure_type, "measure")
    var given = List<Value>()
    given.append(item)
    var measurement = HighIntermediaryRepresentation.Values.Function.ValueCall(measure_read, given)
    measurement.value_type = total_type
    var total_read = HighIntermediaryRepresentation.Values.LocalRead(total_type, "total")
    var added = HighIntermediaryRepresentation.Values.MachineOperation(total_type, 'add', total_read, measurement)
    added.shown = "total + measure(item)"
    var total_assigned = HighIntermediaryRepresentation.Statements.Assign.Assign("total", added)
    loop_body.statements.append(total_assigned)
    var one = HighIntermediaryRepresentation.Values.WholeNumber(integer, 1)
    var stepped = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'add', index_read, one)
    var index_assigned = HighIntermediaryRepresentation.Statements.Assign.Assign("index", stepped)
    loop_body.statements.append(index_assigned)
    var loop = HighIntermediaryRepresentation.Statements.While(going_on, loop_body)
    body.statements.append(loop)
    var answered = HighIntermediaryRepresentation.Statements.Return(total_read)
    body.statements.append(answered)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func class_form(listing: Model.ClassModel, form: String, member: Model.Type): Model.FunctionModel? {
    var simple = member.name.replace(".", "_")
    var name = "_{form}_class_{simple}"
    var known = listing.function_named(name)
    if known {
        return known
    }
    var reader = listing.function_named("_read_value")
    fallback reader
    var writer = listing.function_named("_write_value")
    fallback writer
    var shrinker = listing.function_named("_shrink_to")
    fallback shrinker
    var length = listing.attribute_named("_length")
    fallback length
    values.need(reader)
    values.need(writer)
    values.need(shrinker)
    var integer = context.scalar_type("Integer")
    var boolean = context.boolean()
    var made = Model.FunctionModel(name, listing.key)
    made.is_synthetic = true
    var answer = answer_of_a_form(form, member)
    if answer {
        made.answer = answer
    }
    listing.declared_functions.append(made)
    var own_type = listing.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var start = HighIntermediaryRepresentation.Values.WholeNumber(integer, 0)
    var index_declared = HighIntermediaryRepresentation.Statements.Declare("index", integer, start)
    body.statements.append(index_declared)
    var kept_declared = HighIntermediaryRepresentation.Statements.Declare("kept", integer, start)
    body.statements.append(kept_declared)
    var gathered: Value? = null
    if form == "filter" {
        crash answer
        var gathering = values.made_list(answer)
        var gathered_declared = HighIntermediaryRepresentation.Statements.Declare("gathered", answer, gathering)
        body.statements.append(gathered_declared)
        gathered = HighIntermediaryRepresentation.Values.LocalRead(answer, "gathered")
    }
    var index_read = HighIntermediaryRepresentation.Values.LocalRead(integer, "index")
    var kept_read = HighIntermediaryRepresentation.Values.LocalRead(integer, "kept")
    var length_read = HighIntermediaryRepresentation.Values.AttributeRead(own, length)
    var going_on = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'less', index_read, length_read)
    var loop_body = HighIntermediaryRepresentation.Statements.Block()
    var positions = List<Value>()
    positions.append(index_read)
    var item = HighIntermediaryRepresentation.Values.Call(reader, own, positions)
    var element_type = item.value_type
    var item_declared = HighIntermediaryRepresentation.Statements.Declare("item", element_type, item)
    loop_body.statements.append(item_declared)
    var item_read = HighIntermediaryRepresentation.Values.LocalRead(element_type, "item")
    var tested = HighIntermediaryRepresentation.Values.Class.Test(item_read, member)
    var matched = HighIntermediaryRepresentation.Statements.Block()
    var missed = HighIntermediaryRepresentation.Statements.Block()
    var one = HighIntermediaryRepresentation.Values.WholeNumber(integer, 1)
    var kept_more = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'add', kept_read, one)
    var counted = HighIntermediaryRepresentation.Statements.Assign.Assign("kept", kept_more)
    var yes = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
    var no = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 0)
    if form == "filter" {
        gather_a_match(matched, gathered, member, item_read)
    } else if form == "count" {
        matched.statements.append(counted)
    } else if form == "any" {
        return_from(matched, yes)
    } else if form == "all" {
        return_from(missed, no)
    } else {
        keep_a_miss(missed, writer, own, kept_read, item_read, counted)
    }
    var choice = HighIntermediaryRepresentation.Statements.If(tested, matched, missed)
    loop_body.statements.append(choice)
    var stepped = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'add', index_read, one)
    var index_assigned = HighIntermediaryRepresentation.Statements.Assign.Assign("index", stepped)
    loop_body.statements.append(index_assigned)
    var loop = HighIntermediaryRepresentation.Statements.While(going_on, loop_body)
    body.statements.append(loop)
    if form == "filter" {
        return_the_gathered(body, gathered)
    } else if form == "count" {
        return_from(body, kept_read)
    } else if form == "any" {
        return_from(body, no)
    } else if form == "all" {
        return_from(body, yes)
    } else {
        shrink_to_the_kept(body, shrinker, own, kept_read)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func gather_a_match(
    matched: HighIntermediaryRepresentation.Statements.Block,
    gathered: Value?,
    member: Model.Type,
    item_read: Value,
) {
    crash gathered
    var narrowed = HighIntermediaryRepresentation.Values.Conversion(member, 'present', item_read)
    var appended_arguments = List<Value>()
    appended_arguments.append(narrowed)
    var appended = values.method_call(gathered, "append", appended_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(appended)
    matched.statements.append(evaluated)
}

func keep_a_miss(
    missed: HighIntermediaryRepresentation.Statements.Block,
    writer: Model.FunctionModel,
    own: Value,
    kept_read: Value,
    item_read: Value,
    counted: Statement,
) {
    var keeping = List<Value>()
    keeping.append(kept_read)
    keeping.append(item_read)
    var written = HighIntermediaryRepresentation.Values.Call(writer, own, keeping)
    var write_evaluated = HighIntermediaryRepresentation.Statements.Evaluate(written)
    missed.statements.append(write_evaluated)
    missed.statements.append(counted)
}

func return_the_gathered(
    body: HighIntermediaryRepresentation.Statements.Block,
    gathered: Value?,
) {
    crash gathered
    return_from(body, gathered)
}

func return_from(
    body: HighIntermediaryRepresentation.Statements.Block,
    returned: Value,
) {
    var answered = HighIntermediaryRepresentation.Statements.Return(returned)
    body.statements.append(answered)
}

func shrink_to_the_kept(
    body: HighIntermediaryRepresentation.Statements.Block,
    shrinker: Model.FunctionModel,
    own: Value,
    kept_read: Value,
) {
    var shrinking = List<Value>()
    shrinking.append(kept_read)
    var shrunk = HighIntermediaryRepresentation.Values.Call(shrinker, own, shrinking)
    var shrink_evaluated = HighIntermediaryRepresentation.Statements.Evaluate(shrunk)
    body.statements.append(shrink_evaluated)
}

func answer_of_a_form(form: String, member: Model.Type): Model.Type? {
    if form == "filter" {
        return context.resolver.list_type_of(member)
    } else if form == "count" {
        return context.scalar_type("Integer")
    } else if form == "any" {
        return context.boolean()
    } else if form == "all" {
        return context.boolean()
    } else {
        return null
    }
}

func zero_of(total_type: Model.Type): Value {
    var is_a_decimal = total_type.name == "Float" or total_type.name == "Double"
    if is_a_decimal {
        return HighIntermediaryRepresentation.Values.DecimalNumber(total_type, "0.0")
    }
    return HighIntermediaryRepresentation.Values.WholeNumber(total_type, 0)
}

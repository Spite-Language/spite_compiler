# ../../PROOFS.md#a-getter-narrows-while-it-only-reads

func reads_a_getter(context: Context, written: SpiteCompiler.Expression?): Boolean {
    fallback written
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return names_an_own_getter(context, written.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return member_reads_a_getter(context, written)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return either_index_reads_a_getter(context, written)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return reads_a_getter(context, written.operand)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return either_side_reads_a_getter(context, written)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return false
    }
}

func names_an_own_getter(context: Context, name: String): Boolean {
    fallback not context.scope.internal_name_of(name)
    var owner = context.current_class
    fallback not owner.attribute_named(name)
    var getter = owner.function_named("get_{name}")
    fallback getter
    return getter.parameters.is_empty()
}

func member_reads_a_getter(context: Context, member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    if reads_a_getter(context, member.target) {
        return true
    }
    var target_type = written_type_of(context, member.target)
    fallback target_type
    fallback context.has_a_class(target_type)
    var owner = context.class_of(target_type)
    var getter = owner.function_named("get_{member.name}")
    fallback getter and getter.parameters.is_empty()
    var is_outside = owner.key != context.current_class.key
    return is_outside or not owner.attribute_named(member.name)
}

func either_index_reads_a_getter(
    context: Context,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
): Boolean {
    if reads_a_getter(context, read.target) {
        return true
    }
    return reads_a_getter(context, read.index)
}

func either_side_reads_a_getter(
    context: Context,
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): Boolean {
    if reads_a_getter(context, binary.left) {
        return true
    }
    return reads_a_getter(context, binary.right)
}

func written_type_of(context: Context, written: SpiteCompiler.Expression?): Model.Type? {
    fallback written
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return named_type_of(context, written.name)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return attribute_type_of(context, written)
    }
    return null
}

func attribute_type_of(context: Context, member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Model.Type? {
    var target_type = written_type_of(context, member.target)
    fallback target_type
    fallback context.has_a_class(target_type)
    var owner = context.class_of(target_type)
    var attribute = owner.attribute_named(member.name)
    fallback attribute
    return attribute.attribute_type
}

func named_type_of(context: Context, name: String): Model.Type? {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return context.scope.type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(name)
    fallback attribute
    return attribute.attribute_type
}

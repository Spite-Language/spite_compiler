var names = List<String>()
var slots = List<List<String>>()

func place_of(name: String): Integer {
    var index = 0
    while index < names.count() {
        var known = names[index]
        if known == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func set(name: String, found: List<String>) {
    var place = place_of(name)
    if place < 0 {
        names.append(name)
        slots.append(found)
    } else {
        slots[place] = found
    }
}

func slots_of(name: String): List<String> {
    var found = List<String>()
    var place = place_of(name)
    if place >= 0 {
        var known = slots[place]
        crash known
        add_all(found, known)
    }
    return found
}

func add_all(found: List<String>, added: List<String>) {
    var index = 0
    while index < added.count() {
        var slot = added[index]
        if not found.contains(slot) {
            found.append(slot)
        }
        index = index + 1
    }
}

func copy(): Aliases {
    var made = Aliases()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var held = slots_of(name)
        made.set(name, held)
        index = index + 1
    }
    return made
}

func merge(other: Aliases) {
    var index = 0
    while index < other.names.count() {
        var name = other.names[index]
        var added = other.slots_of(name)
        var held = slots_of(name)
        add_all(held, added)
        set(name, held)
        index = index + 1
    }
}

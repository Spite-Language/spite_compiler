var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Context(no_program, no_resolver)
var values = Values(context)
var constants = Constants(context, values)
var _deepest_copy = 8
var _read_names = [
    "count"
    "is_empty"
    "contains"
    "map_names"
    "each"
    "count_name_starts_with"
    "count_name_ends_with"
]

func KnownCopies(starting_context: Context, starting_values: Values, starting_constants: Constants) {
    context = starting_context
    values = starting_values
    constants = starting_constants
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func takes_a_known_item(walker: Model.FunctionModel, listed: Model.KnownValue): Boolean {
    var parameter = walker.parameters[0]
    fallback parameter and walker.declaration
    var first = listed.items[0]
    fallback first
    fallback not assigns_in(walker.declaration, parameter.name)
    return stays_as_it_was(walker.declaration, parameter.name, first, 0)
}

func walk_copy(walker: Model.FunctionModel, item: Model.KnownValue): Model.FunctionModel {
    var parameter = walker.parameters[0]
    crash parameter
    var knowns = Dictionary<String, Model.KnownValue>()
    knowns[parameter.name] = item
    var no_parameters = List<Model.ParameterModel>()
    return copy_knowing(walker, knowns, no_parameters, context.current_function.known_depth + 1)
}

func called_with_knowns(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value? {
    var literals = Literals(values.context, values)
    var caller = context.current_function
    fallback caller.is_a_walk_copy and caller.known_depth < _deepest_copy and not call.arguments.is_empty()
    fallback call.generic_arguments.is_empty()
    var called = context.current_class.function_named(name)
    fallback called and takes_knowns(called)
    fallback called.parameters.count() == call.arguments.count()
    var knowns = Dictionary<String, Model.KnownValue>()
    var kept_parameters = List<Model.ParameterModel>()
    var kept_arguments = List<SpiteCompiler.Expression>()
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var parameter = called.parameters[index]
        crash parameter
        var known = known_for(called, parameter, written)
        if known {
            knowns[parameter.name] = known
        } else {
            kept_parameters.append(parameter)
            kept_arguments.append(written)
        }
        index = index + 1
    }
    fallback not knowns.keys().is_empty()
    var made = copy_knowing(called, knowns, kept_parameters, caller.known_depth + 1)
    var own = literals.this_value()
    return values.called(made, own, kept_arguments)
}

func takes_knowns(function: Model.FunctionModel): Boolean {
    var is_plain = not function.is_constructor and not function.is_a_member_template and not function.is_synthetic
    var is_a_template = function.template_index >= 0 or function.reflected_answer_index >= 0
    fallback is_plain and not is_a_template and not function.is_written_by_the_compiler
    fallback not function.parameters.is_empty() and function.declaration
    var last = function.parameters.last()
    crash last
    return not last.is_variadic
}

func known_for(
    called: Model.FunctionModel,
    parameter: Model.ParameterModel,
    written: SpiteCompiler.Expression,
): Model.KnownValue? {
    var known = constants.known_of(written)
    fallback known and known.is_reflected and fits_the_parameter(known, parameter)
    crash called.declaration
    fallback not assigns_in(called.declaration, parameter.name)
    fallback stays_as_it_was(called.declaration, parameter.name, known, 0)
    return known
}

func fits_the_parameter(known: Model.KnownValue, parameter: Model.ParameterModel): Boolean {
    var taken = parameter.parameter_type
    fallback not taken.is_nullable
    switch known.kind {
        'text': return taken.name == "String"
        'number': return taken.name == "Integer"
        'truth': return taken.name == "Boolean"
        'class': return taken.name == "Spite.Class"
        'namespace': return taken.name == "Spite.Namespace"
        'list': return fits_the_list(known, taken)
        'function': return false
    }
}

func fits_the_list(known: Model.KnownValue, taken: Model.Type): Boolean {
    fallback known.text == "String" or known.text == "Spite.Class" or known.text == "Spite.Namespace"
    var list_type = constants.list_type_of(known)
    return list_type.name == taken.name
}

func assigns_in(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    var reads = Reads(values.context, values)
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if reads.assigns_the_name(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func copy_knowing(
    function: Model.FunctionModel,
    knowns: Dictionary<String, Model.KnownValue>,
    kept_parameters: List<Model.ParameterModel>,
    depth: Integer,
): Model.FunctionModel {
    var key = identity_of(function, knowns)
    var known = context.known_copies[key]
    if known {
        return known
    }
    var count = context.known_copies.keys().count()
    var made = Model.FunctionModel("{function.name}_known_{count}", function.owner)
    made.declaration = function.declaration
    made.parameters = kept_parameters
    made.answer = function.answer
    made.is_a_walk_copy = true
    made.known_arguments = knowns
    made.known_depth = depth
    context.current_class.declared_functions.append(made)
    context.known_copies[key] = made
    return made
}

func identity_of(function: Model.FunctionModel, knowns: Dictionary<String, Model.KnownValue>): String {
    var names = knowns.keys()
    var parts = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var known = knowns[name]
        crash known
        var shown = known.identity()
        parts.append("{name}={shown}")
        index = index + 1
    }
    var joined = parts.join("|")
    var key = function.key()
    return "{key}|{joined}"
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func stays_as_it_was(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    known: Model.KnownValue,
    depth: Integer,
): Boolean {
    if not known.has_no_value_to_hold() {
        return true
    }
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var mentions = 0
    var reads = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name == name {
            mentions = mentions + 1
        }
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            fallback not calls_the_name(expression, name)
            reads = reads + reads_in_a_call(expression, name, known, depth)
        }
        index = index + 1
    }
    return known.kind != 'list' or reads >= mentions
}

func calls_the_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name == name
    }
    return false
}

func reads_in_a_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
    known: Model.KnownValue,
    depth: Integer,
): Integer {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return read_as_a_receiver(callee, name)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return read_as_an_argument(call, callee.name, name, known, depth)
    }
    return 0
}

func read_as_a_receiver(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, name: String): Integer {
    var target = callee.target
    var names_it = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_it = target.name == name
    }
    if names_it and _read_names.contains(callee.name) {
        return 1
    }
    return 0
}

func read_as_an_argument(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    called_name: String,
    name: String,
    known: Model.KnownValue,
    depth: Integer,
): Integer {
    var called = context.current_class.function_named(called_name)
    fallback called and depth < _deepest_copy and called.parameters.count() == call.arguments.count()
    fallback called.declaration
    var reads = 0
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var parameter = called.parameters[index]
        crash parameter
        var names_it = false
        if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            names_it = written.name == name
        }
        if names_it and stays_as_it_was(called.declaration, parameter.name, known, depth + 1) {
            reads = reads + 1
        }
        index = index + 1
    }
    return reads
}

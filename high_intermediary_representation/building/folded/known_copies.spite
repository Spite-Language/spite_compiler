var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Context(no_program, no_resolver)
var values = Values(context)
var constants = Constants(context, values)
var described_names = DescribedNames()
var _read_names = [
    "count"
    "is_empty"
    "first"
    "last"
    "contains"
    "map_names"
    "each"
    "count_name_starts_with"
    "count_name_ends_with"
]

func KnownCopies(starting_context: Context, starting_values: Values, starting_constants: Constants) {
    context = starting_context
    values = starting_values
    constants = starting_constants
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func takes_a_known_item(walker: Model.FunctionModel, listed: Model.KnownValue): Boolean {
    var parameter = walker.parameters[0]
    fallback parameter and walker.declaration
    var first = listed.items[0]
    fallback first
    fallback not assigns_in(walker.declaration, parameter.name)
    if first.kind == 'class' {
        return true
    }
    return stays_as_it_was(walker.declaration, parameter.name, first)
}

func walk_copy(walker: Model.FunctionModel, item: Model.KnownValue): Model.FunctionModel {
    var parameter = walker.parameters[0]
    crash parameter
    var knowns = Dictionary<String, Model.KnownValue>()
    knowns[parameter.name] = item
    var no_parameters = List<Model.ParameterModel>()
    return copy_knowing(walker, context.current_class, knowns, no_parameters)
}

func called_with_knowns(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): SpiteCompiler.Value? {
    var literals = Literals(values.context, values)
    fallback call.generic_arguments.is_empty()
    var called = context.current_class.function_named(name)
    fallback called
    var own = literals.this_value()
    return called_on_with_knowns(called, context.current_class, own, call.arguments)
}

# ../../../../spite_documentation/reflection.md#known-while-compiling
func called_on_with_knowns(
    called: Model.FunctionModel,
    holder: Model.ClassModel,
    receiver: SpiteCompiler.Value,
    written: List<SpiteCompiler.Expression>,
): SpiteCompiler.Value? {
    var calls = Calls(values.context, values)
    var caller = context.current_function
    var is_in_a_copy = caller.is_a_walk_copy()
    fallback not written.is_empty()
    fallback takes_knowns(called) and called.parameters.count() == written.count()
    fallback is_in_a_copy or takes_a_described_place(called)
    var library = Mapping.LibraryFile()
    var is_its_own = is_in_a_copy and holder.key == context.current_class.key
    fallback is_its_own or not library.holds(holder.file.path)
    var knowns = Dictionary<String, Model.KnownValue>()
    var kept_parameters = List<Model.ParameterModel>()
    var kept_arguments = List<SpiteCompiler.Expression>()
    var class_place = -1
    var index = 0
    while index < written.count() {
        var argument = written[index]
        var parameter = called.parameters[index]
        crash parameter
        var known = known_for(called, parameter, argument, is_in_a_copy)
        if known {
            knowns[parameter.name] = known
            if known.kind == 'class' {
                class_place = index
            }
        } else {
            kept_parameters.append(parameter)
            kept_arguments.append(argument)
        }
        index = index + 1
    }
    var known_names = knowns.keys()
    fallback not known_names.is_empty()
    var made: Model.FunctionModel? = null
    if known_names.count() == 1 and class_place >= 0 {
        made = class_copy(called, holder, class_place, knowns)
    }
    if not made {
        fallback knowns_stay(called, knowns)
        made = copy_knowing(called, holder, knowns, kept_parameters)
    }
    crash made
    return calls.called(made, receiver, kept_arguments)
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func knowns_stay(called: Model.FunctionModel, knowns: Dictionary<String, Model.KnownValue>): Boolean {
    crash called.declaration
    var names = knowns.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var known = knowns[name]
        crash known
        fallback stays_as_it_was(called.declaration, name, known)
        index = index + 1
    }
    return true
}

# ../../../../spite_documentation/reflection.md#known-while-compiling
func takes_a_described_place(function: Model.FunctionModel): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var taken = parameter.parameter_type
        var describes = taken.name == "Spite.Class" or taken.name == "Spite.Namespace"
        if describes and taken.kind == 'object' and not taken.is_nullable {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../../spite_documentation/reflection.md#known-while-compiling
func class_copy(
    function: Model.FunctionModel,
    holder: Model.ClassModel,
    place: Integer,
    knowns: Dictionary<String, Model.KnownValue>,
): Model.FunctionModel? {
    var names = knowns.keys()
    var name = names[0]
    crash name
    var known = knowns[name]
    crash known
    var class_key = known.text
    fallback not values.scalars.is_a_scalar(class_key)
    var model = context.resolver.monomorphiser.class_model_named(class_key)
    fallback model
    var owner_name = class_key.replace(".", "_")
    var called_name = "{function.name}_over_{owner_name}"
    var made = holder.function_named(called_name)
    if made {
        return made
    }
    var member_type = Model.Type('object', model.key)
    var simple = described_names.simple_name_of(model.shown)
    var bound = Model.TemplateBinding(place, simple, member_type, false, 0, "", "", null, null)
    var binding_copy = Model.WalkCopy(null, "", true, null)
    var copied = context.resolver.reading.specialized(
        function.declaration,
        function.owner,
        bound,
        binding_copy,
        null,
        called_name,
        holder,
    )
    holder.declared_functions.append(copied)
    return copied
}

func takes_knowns(function: Model.FunctionModel): Boolean {
    var is_plain = not function.is_a_constructor() and not function.is_a_member_template() and not function.is_synthetic
    var is_a_template = function.template_index() >= 0 or function.reflects_its_answer()
    fallback is_plain and not is_a_template and not function.is_written_by_the_compiler
    fallback not function.parameters.is_empty() and function.declaration
    var last = function.parameters.last()
    crash last
    return not last.is_variadic
}

func known_for(
    called: Model.FunctionModel,
    parameter: Model.ParameterModel,
    written: SpiteCompiler.Expression,
    is_in_a_copy: Boolean,
): Model.KnownValue? {
    var known = constants.known_of(written)
    if not known {
        known = constants.known_described(written)
    }
    fallback known and known.is_reflected and fits_the_parameter(known, parameter)
    fallback is_in_a_copy or known.kind == 'class' or known.kind == 'namespace'
    crash called.declaration
    fallback not assigns_in(called.declaration, parameter.name)
    if known.kind == 'class' {
        return known
    }
    fallback stays_as_it_was(called.declaration, parameter.name, known)
    return known
}

func fits_the_parameter(known: Model.KnownValue, parameter: Model.ParameterModel): Boolean {
    var taken = parameter.parameter_type
    fallback not taken.is_nullable
    switch known.kind {
        'text': return taken.name == "String"
        'number': return taken.name == "Integer"
        'truth': return taken.name == "Boolean"
        'class': return taken.name == "Spite.Class"
        'namespace': return taken.name == "Spite.Namespace"
        'list': return fits_the_list(known, taken)
        'function': return false
        'attribute': return false
    }
}

func fits_the_list(known: Model.KnownValue, taken: Model.Type): Boolean {
    fallback known.text == "String" or known.text == "Spite.Class" or known.text == "Spite.Namespace"
    var list_type = constants.list_type_of(known)
    return list_type.name == taken.name
}

func assigns_in(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration, name: String): Boolean {
    var reads = Reads(values.context, values)
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if reads.assigns_the_name(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func copy_knowing(
    function: Model.FunctionModel,
    holder: Model.ClassModel,
    knowns: Dictionary<String, Model.KnownValue>,
    kept_parameters: List<Model.ParameterModel>,
): Model.FunctionModel {
    var key = identity_of(function, knowns)
    var known = context.known_copies[key]
    if known {
        return known
    }
    var count = context.known_copies.keys().count()
    var name = "{function.name}_known_{count}"
    var knowing = Model.WalkCopy(null, "", false, knowns)
    var made = Model.FunctionModel(
        name,
        function.owner,
        function.answer,
        function.declaration,
        null,
        null,
        knowing,
        null,
        false,
        false,
        false,
        false,
    )
    made.parameters = kept_parameters
    holder.declared_functions.append(made)
    context.known_copies[key] = made
    return made
}

func identity_of(function: Model.FunctionModel, knowns: Dictionary<String, Model.KnownValue>): String {
    var names = knowns.keys()
    var parts = List<String>()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var known = knowns[name]
        crash known
        var shown = known.identity()
        parts.append("{name}={shown}")
        index = index + 1
    }
    var joined = parts.join("|")
    var key = function.key()
    return "{key}|{joined}"
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func stays_as_it_was(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    known: Model.KnownValue,
): Boolean {
    var passed = List<String>()
    return stays_past(declaration, name, known, passed)
}

# ../../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func stays_past(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    known: Model.KnownValue,
    passed: List<String>,
): Boolean {
    if not known.has_no_value_to_hold() {
        return true
    }
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(declaration)
    var mentions = 0
    var reads = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and expression.name == name {
            mentions = mentions + 1
        }
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            fallback not calls_the_name(expression, name)
            reads = reads + reads_in_a_call(expression, name, known, passed)
        }
        index = index + 1
    }
    return known.kind != 'list' or reads >= mentions
}

func calls_the_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name == name
    }
    return false
}

func reads_in_a_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
    known: Model.KnownValue,
    passed: List<String>,
): Integer {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return read_as_a_receiver(call, callee, name, known)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return read_as_an_argument(call, callee.name, name, known, passed)
    }
    return 0
}

func read_as_a_receiver(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    known: Model.KnownValue,
): Integer {
    var target = callee.target
    var names_it = false
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_it = target.name == name
    }
    if names_it and _read_names.contains(callee.name) and is_folded_over(known, call) {
        return 1
    }
    return 0
}

# ../../../PROOFS.md#a-walk-over-known-classes-is-decided-while-compiling
func is_folded_over(known: Model.KnownValue, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    if not known.lists_functions() or call.arguments.is_empty() {
        return true
    }
    var argument = call.arguments[0]
    var given = constants.known_of(argument)
    fallback given
    return given.kind == 'text'
}

func read_as_an_argument(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    called_name: String,
    name: String,
    known: Model.KnownValue,
    passed: List<String>,
): Integer {
    fallback not known.lists_functions()
    var called = context.current_class.function_named(called_name)
    fallback called and called.parameters.count() == call.arguments.count()
    fallback called.declaration
    var called_key = called.key()
    var reads = 0
    var index = 0
    while index < call.arguments.count() {
        var written = call.arguments[index]
        var parameter = called.parameters[index]
        crash parameter
        var names_it = false
        if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            names_it = written.name == name
        }
        var place = "{called_key}.{parameter.name}"
        if names_it and not passed.contains(place) and stays_in(called.declaration, parameter.name, known, passed, place) {
            reads = reads + 1
        }
        index = index + 1
    }
    return reads
}

# ../../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func stays_in(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    name: String,
    known: Model.KnownValue,
    passed: List<String>,
    place: String,
): Boolean {
    passed.append(place)
    var stays = stays_past(declaration, name, known, passed)
    crash passed.remove_last()
    return stays
}

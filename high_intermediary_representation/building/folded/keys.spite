var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var rules = Validators.HighIntermediaryRepresentation.KeyMaps.Validator()

func Keys(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func is_a_key_map(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object' and context.has_a_class(of_type)
    var model = context.class_of(of_type)
    var key_type = model.bound_types["$key_type"]
    fallback key_type
    var is_keyed_by_attributes = key_type.name == "Spite.AttributeDeclaration"
    var hashes = model.function_named("_key_bits")
    if hashes {
        return is_keyed_by_attributes
    }
    return false
}

func place_of(attribute: Model.AttributeModel): String {
    return "{attribute.owner}.{attribute.name}"
}

# ../../../../spite_spec/specs/json.md#json-is-reflection-not-a-library
func record(written: SpiteCompiler.Expression?, attribute: Model.AttributeModel): Boolean {
    var place = place_of(attribute)
    var shown_place = shown_place_of(attribute)
    if not has_a_table(attribute) {
        record_without_a_table(written, place, shown_place)
        return false
    }
    if context.run_time_key_maps.contains(place) {
        return true
    }
    if is_folded(written) {
        record_a_folded_map(written, place, shown_place)
        return false
    }
    if context.folded_key_assignments.contains(place) {
        read_live(place, shown_place)
    }
    rules.check_a_late_map(context, place, shown_place)
    context.run_time_key_maps.append(place)
    return true
}

# ../../../../spite_spec/specs/json.md#json-is-reflection-not-a-library
func read_live(place: String, shown_place: String) {
    fallback not context.live_key_maps.contains(place)
    rules.check_a_late_map(context, place, shown_place)
    context.live_key_maps.append(place)
}

func reads_a_key_map(function: Model.FunctionModel): Boolean {
    fallback not function.bound_parameter.is_empty() and not function.binds_a_function_declaration
    var owner = context.program.class_named(function.owner)
    fallback owner
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        if is_a_key_map(attribute.attribute_type) {
            return true
        }
        index = index + 1
    }
    return false
}

func record_a_folded_map(written: SpiteCompiler.Expression?, place: String, shown_place: String) {
    if not context.folded_key_assignments.contains(place) {
        context.folded_key_assignments.append(place)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        record_the_literal(written, place, shown_place, true)
    }
}

func is_folded(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        return is_written_out(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return is_an_empty_map(written)
    }
    return false
}

func is_written_out(literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral): Boolean {
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        fallback is_a_written_out_pair(pair)
        index = index + 1
    }
    return true
}

func is_a_written_out_pair(pair: SpiteCompiler.Expression?): Boolean {
    if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral and names_an_attribute(pair.key) {
        return is_a_plain_text(pair.value)
    }
    return false
}

func names_an_attribute(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        var listed = written.target
        var symbol = values.key_name_of(written.index)
        if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and symbol {
            return listed.name == "attributes" and not symbol.is_empty()
        }
    }
    return false
}

func is_a_plain_text(written: SpiteCompiler.Expression?): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral and written.pieces.count() == 1 {
        var piece = written.pieces[0]
        return not piece.hole
    }
    return false
}

func record_without_a_table(written: SpiteCompiler.Expression?, place: String, shown_place: String) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral {
        record_the_literal(written, place, shown_place, false)
        return
    }
    rules.check_an_empty_map(context, written, shown_place)
}

func is_an_empty_map(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return callee.name == "Dictionary" and call.arguments.is_empty()
    }
    return false
}

func shown_place_of(attribute: Model.AttributeModel): String {
    var owner = context.program.class_named(attribute.owner)
    crash owner
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var plain = typing.plain_class_name(owner.shown)
    return "{plain}.{attribute.name}"
}

func record_the_literal(
    literal: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    place: String,
    shown_place: String,
    has_its_table: Boolean,
) {
    var names = List<String>()
    var keys = List<String>()
    var pieces = List<String>()
    var index = 0
    while index < literal.pairs.count() {
        var pair = literal.pairs[index]
        rules.check_an_entry(context, pair, shown_place)
        if pair.class == AbstractSyntaxTree.Shapes.Expressions.EntryLiteral {
            var name = keyed_attribute_of(pair.key, shown_place)
            var key = key_text_of(pair.value, shown_place)
            names.append(name)
            keys.append(key)
            pieces.append("{name}\t{key}")
        }
        index = index + 1
    }
    var canonical = pieces.join("\n")
    var known = context.folded_key_maps[place]
    if known {
        if known != canonical and has_its_table {
            read_live(place, shown_place)
        }
        rules.check_one_map(context, known, canonical, has_its_table, shown_place)
        return
    }
    rules.check_a_late_map(context, place, shown_place)
    context.folded_key_maps[place] = canonical
    var position = 0
    while position < names.count() {
        var name = names[position]
        var key = keys[position]
        crash key
        context.folded_keys["{place}|{name}"] = key
        position = position + 1
    }
}

func keyed_attribute_of(written: SpiteCompiler.Expression?, shown_place: String): String {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return attribute_named_by(written, shown_place)
    }
    rules.check_an_attribute_key(context, written, shown_place)
    return ""
}

func attribute_named_by(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, shown_place: String): String {
    var listed = index.target
    var name = ""
    var symbol = values.key_name_of(index.index)
    if symbol {
        name = symbol
    }
    rules.check_an_attributes_read(context, listed, name, shown_place)
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_the_attribute(listed.target, name)
    }
    return name
}

func check_the_attribute(described: SpiteCompiler.Expression?, name: String) {
    var path = values.tested_class_path_of(described)
    var written = path.join(".")
    var no_arguments = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var described_type = context.resolver.class_type_in(path, no_arguments, context.current_class, context.line)
    var model = context.class_of(described_type)
    var attribute = model.attribute_named(name)
    rules.check_a_keyed_attribute(context, attribute, written, name)
}

func key_text_of(written: SpiteCompiler.Expression?, shown_place: String): String {
    rules.check_a_key_text(context, written, shown_place)
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return values.constant_text_of(written)
    }
    return ""
}

# ../../../../spite_spec/specs/json.md#json-is-reflection-not-a-library
func has_a_table(attribute: Model.AttributeModel): Boolean {
    var described = described_type_of(attribute)
    if described {
        return true
    }
    return false
}

func described_type_of(attribute: Model.AttributeModel): Model.Type? {
    var owner = context.program.class_named(attribute.owner)
    crash owner
    var described = owner.bound_types["$value_type"]
    fallback described
    fallback described.kind == 'object' and not described.is_nullable and context.has_a_class(described)
    return described
}

func is_tabled(declared: Model.AttributeModel): Boolean {
    fallback not declared.name.starts_with("_")
    if context.has_a_class(declared.attribute_type) {
        var held = context.class_of(declared.attribute_type)
        return not held.is_singleton
    }
    return true
}

func make_every_table(model: Model.ClassModel) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if is_a_key_map(attribute.attribute_type) and has_a_table(attribute) {
            make_the_slots(attribute)
        }
        index = index + 1
    }
}

func make_the_slots(attribute: Model.AttributeModel) {
    var described = described_type_of(attribute)
    crash described
    var owner = context.program.class_named(attribute.owner)
    crash owner
    var model = context.class_of(described)
    var index = 0
    while index < model.declared_attributes.count() {
        var tabled = model.declared_attributes[index]
        var name = slot_name_of(attribute, tabled.name)
        if is_tabled(tabled) and not owner.attribute_named(name) {
            var text = context.text()
            var slot_type = text.nullable()
            var slot = Model.AttributeModel(name, owner.key, slot_type)
            slot.is_a_key_slot = true
            owner.declared_attributes.append(slot)
        }
        index = index + 1
    }
}

func slot_name_of(attribute: Model.AttributeModel, tabled: String): String {
    return "{attribute.name}.{tabled}"
}

func fresh_object(object: SpiteCompiler.Value): SpiteCompiler.Value {
    if object.class == HighIntermediaryRepresentation.Values.LocalRead {
        return HighIntermediaryRepresentation.Values.LocalRead(object.value_type, object.name)
    }
    return HighIntermediaryRepresentation.Values.ThisRead(object.value_type)
}

func copied(value: SpiteCompiler.Value, attribute: Model.AttributeModel): SpiteCompiler.Value {
    var dictionary = context.class_of(attribute.attribute_type)
    var copying = dictionary.function_named("copy")
    crash copying
    values.need(copying)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(copying, value, no_arguments)
}

func filled_table(object: SpiteCompiler.Value, attribute: Model.AttributeModel): List<SpiteCompiler.Statement> {
    make_the_slots(attribute)
    var made = List<SpiteCompiler.Statement>()
    var described = described_type_of(attribute)
    crash described
    var owner = context.program.class_named(attribute.owner)
    crash owner
    var model = context.class_of(described)
    var integer = context.scalar_type("Integer")
    values.temporary_count = values.temporary_count + 1
    var counted = context.scope.declare("tabled_keys_{values.temporary_count}", integer)
    var zero = HighIntermediaryRepresentation.Values.WholeNumber(integer, 0)
    var declared = HighIntermediaryRepresentation.Statements.Declare(counted, integer, zero)
    declared.line = context.line
    made.append(declared)
    var index = 0
    while index < model.declared_attributes.count() {
        var tabled = model.declared_attributes[index]
        var name = slot_name_of(attribute, tabled.name)
        var slot = owner.attribute_named(name)
        if is_tabled(tabled) and slot {
            fill_a_slot(made, object, attribute, slot, described, tabled.name)
            count_a_slot(made, object, slot, counted)
        }
        index = index + 1
    }
    var check = every_key_tabled(object, attribute, described, counted)
    made.append(check)
    return made
}

func fill_a_slot(
    made: List<SpiteCompiler.Statement>,
    object: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
    slot: Model.AttributeModel,
    described: Model.Type,
    tabled: String,
) {
    var key = keyed_read(object, attribute, described, tabled)
    var target = fresh_object(object)
    var filled = HighIntermediaryRepresentation.Statements.Assign.Attribute(target, slot, key)
    filled.line = context.line
    made.append(filled)
}

func count_a_slot(
    made: List<SpiteCompiler.Statement>,
    object: SpiteCompiler.Value,
    slot: Model.AttributeModel,
    counted: String,
) {
    var integer = context.scalar_type("Integer")
    var target = fresh_object(object)
    var slot_read = HighIntermediaryRepresentation.Values.AttributeRead(target, slot)
    var present = HighIntermediaryRepresentation.Values.PresenceTest(slot_read)
    var counter_read = HighIntermediaryRepresentation.Values.LocalRead(integer, counted)
    var one = HighIntermediaryRepresentation.Values.WholeNumber(integer, 1)
    var added = HighIntermediaryRepresentation.Values.MachineOperation(integer, 'add', counter_read, one)
    var counting = HighIntermediaryRepresentation.Statements.Assign.Assign(counted, added)
    counting.line = context.line
    var then = HighIntermediaryRepresentation.Statements.Block()
    then.statements.append(counting)
    var checked = HighIntermediaryRepresentation.Statements.If(present, then, null)
    checked.line = context.line
    made.append(checked)
}

func keyed_read(
    object: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
    described: Model.Type,
    tabled: String,
): SpiteCompiler.Value {
    var reflection = Reflection(context, values)
    var class_object = reflection.class_object(described.name)
    var class_model = values.present_class_of(class_object)
    var getter = class_model.function_named("get_attributes")
    crash getter
    var no_written = List<SpiteCompiler.Expression>()
    var listed = values.called(getter, class_object, no_written)
    var dictionary_model = values.present_class_of(listed)
    var finder = dictionary_model.function_named("get_at")
    crash finder
    values.need(finder)
    values.need_text_constants()
    var named = HighIntermediaryRepresentation.Values.TextConstant(tabled)
    named.value_type = context.text()
    var finder_arguments = List<SpiteCompiler.Value>()
    finder_arguments.append(named)
    var found = HighIntermediaryRepresentation.Values.Call(finder, listed, finder_arguments)
    var declaration_type = reflection.reflection_type("Spite.AttributeDeclaration")
    var declaration = HighIntermediaryRepresentation.Values.Conversion(declaration_type, 'proven', found)
    var dictionary = context.class_of(attribute.attribute_type)
    var getting = dictionary.function_named("get_at")
    crash getting
    values.need(getting)
    var target = fresh_object(object)
    var map_read = HighIntermediaryRepresentation.Values.AttributeRead(target, attribute)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(declaration)
    return HighIntermediaryRepresentation.Values.Call(getting, map_read, arguments)
}

func every_key_tabled(
    object: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
    described: Model.Type,
    counted: String,
): SpiteCompiler.Statement {
    var integer = context.scalar_type("Integer")
    var dictionary = context.class_of(attribute.attribute_type)
    var counter = dictionary.function_named("count")
    crash counter
    values.need(counter)
    var target = fresh_object(object)
    var map_read = HighIntermediaryRepresentation.Values.AttributeRead(target, attribute)
    var no_arguments = List<SpiteCompiler.Value>()
    var count = HighIntermediaryRepresentation.Values.Call(counter, map_read, no_arguments)
    var counter_read = HighIntermediaryRepresentation.Values.LocalRead(integer, counted)
    var boolean = context.boolean()
    var differs = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'not_equal', counter_read, count)
    var shown_place = shown_place_of(attribute)
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var described_model = context.class_of(described)
    var shown_class = typing.plain_class_name(described_model.shown)
    var function = context.current_function
    var file_path = context.path()
    var message = "spite: '{shown_place}' gives a key to an attribute that is not one of the public attributes of '{shown_class}' that hold a value, at {file_path}:{context.line} in {function.owner}.{function.name}"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    stopped.line = context.line
    var failed = HighIntermediaryRepresentation.Statements.Block()
    failed.statements.append(stopped)
    var checked = HighIntermediaryRepresentation.Statements.If(differs, failed, null)
    checked.line = context.line
    return checked
}

func table_read(attribute: Model.AttributeModel, function: Model.FunctionModel): SpiteCompiler.Value {
    var text = context.text()
    var nullable_text = text.nullable()
    var described = described_type_of(attribute)
    crash described
    var walked = walked_class_of(function)
    if not walked.is_empty() and walked != described.name {
        return HighIntermediaryRepresentation.Values.NullConstant(nullable_text)
    }
    make_the_slots(attribute)
    var owner = context.program.class_named(attribute.owner)
    crash owner
    var name = slot_name_of(attribute, function.bound_member)
    var slot = owner.attribute_named(name)
    if not slot {
        return HighIntermediaryRepresentation.Values.NullConstant(nullable_text)
    }
    var own = values.this_value()
    return HighIntermediaryRepresentation.Values.AttributeRead(own, slot)
}

func live_read(attribute: Model.AttributeModel, function: Model.FunctionModel): SpiteCompiler.Value {
    var text = context.text()
    var nullable_text = text.nullable()
    var described = described_type_of(attribute)
    crash described
    var walked = walked_class_of(function)
    if not walked.is_empty() and walked != described.name {
        return HighIntermediaryRepresentation.Values.NullConstant(nullable_text)
    }
    var own = values.this_value()
    return keyed_read(own, attribute, described, function.bound_member)
}

func walked_class_of(function: Model.FunctionModel): String {
    if function.walked_object {
        return function.walked_object.name
    }
    return function.walked_declarations_of
}

func attribute_key(written: SpiteCompiler.Expression?, key_type: Model.Type): SpiteCompiler.Value? {
    fallback key_type.name == "Spite.AttributeDeclaration" and not key_type.is_nullable
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return named_attribute_key(written, key_type)
    }
    return null
}

func named_attribute_key(
    index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    key_type: Model.Type,
): SpiteCompiler.Value? {
    var listed = index.target
    var symbol = values.key_name_of(index.index)
    fallback symbol
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and listed.name == "attributes" {
        check_the_attribute(listed.target, symbol)
        var found = values.value_of(index, null)
        return HighIntermediaryRepresentation.Values.Conversion(key_type, 'proven', found)
    }
    return null
}

func check_a_change(target: SpiteCompiler.Value) {
    fallback is_a_key_map(target.value_type)
    if target.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var shown_place = shown_place_of(target.attribute)
        var is_read_live = read_live_where_tabled(target.attribute, shown_place)
        rules.check_a_changed_map(context, is_read_live, shown_place)
    }
}

func read_live_where_tabled(attribute: Model.AttributeModel, shown_place: String): Boolean {
    fallback has_a_table(attribute)
    var place = place_of(attribute)
    read_live(place, shown_place)
    return true
}

func check_a_changing_call(receiver: SpiteCompiler.Value, name: String) {
    var changes = name == "set_at" or name == "remove_at" or name == "clear"
    fallback changes
    check_a_change(receiver)
}

func check_a_held_map(value: SpiteCompiler.Value) {
    fallback is_a_key_map(value.value_type)
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var shown_place = shown_place_of(value.attribute)
        var is_read_live = read_live_where_tabled(value.attribute, shown_place)
        rules.check_a_held_map(context, is_read_live, shown_place)
    }
}

func check_a_passed_map(value: SpiteCompiler.Value, called: String) {
    fallback is_a_key_map(value.value_type)
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var shown_place = shown_place_of(value.attribute)
        var is_read_live = read_live_where_tabled(value.attribute, shown_place)
        rules.check_a_passed_map(context, is_read_live, shown_place, called)
    }
}

func folded_read(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): SpiteCompiler.Value? {
    var function = context.current_function
    fallback not function.bound_parameter.is_empty() and not function.binds_a_function_declaration
    var asked = index.index
    var target = index.target
    var names_the_walked = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        names_the_walked = asked.name == function.bound_parameter
    }
    fallback names_the_walked
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return folded_attribute_read(target.name, function)
    }
    return null
}

func folded_attribute_read(name: String, function: Model.FunctionModel): SpiteCompiler.Value? {
    fallback not context.scope.internal_name_of(name)
    var attribute = context.current_class.attribute_named(name)
    fallback attribute
    fallback is_a_key_map(attribute.attribute_type)
    var place = place_of(attribute)
    if not context.folded_key_reads.contains(place) {
        context.folded_key_reads.append(place)
    }
    if context.live_key_maps.contains(place) {
        return live_read(attribute, function)
    }
    if context.run_time_key_maps.contains(place) {
        return table_read(attribute, function)
    }
    var key_type = context.text()
    var nullable_text = key_type.nullable()
    var key = context.folded_keys["{place}|{function.bound_member}"]
    if key {
        var constant = values.described_text(key)
        return HighIntermediaryRepresentation.Values.Conversion(nullable_text, 'nullable', constant)
    }
    return HighIntermediaryRepresentation.Values.NullConstant(nullable_text)
}

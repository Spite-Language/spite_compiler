var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var context = Context(no_program, no_resolver)
var values = Values(context)
var foreign = Validators.HighIntermediaryRepresentation.Foreign.Validator()

func ForeignCrossing(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func check_an_argument(value: SpiteCompiler.Value) {
    var crossing = value.value_type
    if crossing.kind == 'function' {
        var written = passed_name(value)
        var names = List<String>()
        var index = 0
        while index < crossing.parameters.count() {
            var position = index + 1
            names.append("argument {position}")
            index = index + 1
        }
        foreign.check_a_callback(context, crossing, written, names)
        return
    }
    foreign.check_a_crossing(context, crossing)
}

func passed_name(value: SpiteCompiler.Value): String {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.function.name
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name
    }
    return "the function"
}

func handover_place(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var literals = Literals(values.context, values)
    var count = call.arguments.count()
    foreign.check_two_arguments(context, count)
    var written_place = call.arguments[1]
    var place = literals.symbol_text_of(written_place)
    foreign.check_a_written_place(context, place)
    crash place
    var written_function = call.arguments[0]
    crash written_function
    var value = values.value_of(written_function, null)
    var is_named = value.class == HighIntermediaryRepresentation.Values.Function.Value
    foreign.check_a_named_function(context, is_named)
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        check_a_named_handover(value, written_function, place)
    }
    return place
}

func handover_arguments(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    constructor: Model.FunctionModel,
): List<SpiteCompiler.Value> {
    var arguments = List<SpiteCompiler.Value>()
    var written_function = call.arguments[0]
    crash written_function
    var function_value = values.value_of(written_function, null)
    arguments.append(function_value)
    var written_place = call.arguments[1]
    crash written_place
    var parameter = constructor.parameters[1]
    crash parameter
    var place = values.value_of(written_place, parameter.parameter_type)
    arguments.append(place)
    return arguments
}

func check_a_named_handover(
    value: HighIntermediaryRepresentation.Values.Function.Value,
    written_function: SpiteCompiler.Expression,
    place: String,
) {
    var printer = Printers.Spite.ExpressionPrinter(written_function)
    var function_text = printer.text()
    var written = "ForeignCallback({function_text}, '{place}')"
    var owner = context.program.class_named(value.function.owner)
    crash owner
    foreign.check_a_context(context, place, owner, function_text)
    var names = value.function.parameters.map_names()
    foreign.check_a_callback(context, value.value_type, written, names)
    if not owner.is_singleton {
        check_the_reach(owner, value.function, written)
    }
}

func check_the_reach(owner: Model.ClassModel, function: Model.FunctionModel, written: String) {
    var followed = List<String>()
    check_the_reach_of(owner, function, function, written, followed)
}

func check_the_reach_of(
    owner: Model.ClassModel,
    handed: Model.FunctionModel,
    reached: Model.FunctionModel,
    written: String,
    followed: List<String>,
) {
    fallback reached.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = reached.declaration
    fallback declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        check_a_reached_name(owner, handed, reached, found.expression, written, followed)
        index = index + 1
    }
}

func check_a_reached_name(
    owner: Model.ClassModel,
    handed: Model.FunctionModel,
    reached: Model.FunctionModel,
    expression: SpiteCompiler.Expression?,
    written: String,
    followed: List<String>,
) {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_reached_attribute(owner, handed, reached, expression.name, written)
        follow_a_called_function(owner, handed, expression.name, written, followed)
    }
}

func follow_a_called_function(
    owner: Model.ClassModel,
    handed: Model.FunctionModel,
    name: String,
    written: String,
    followed: List<String>,
) {
    fallback name != handed.name and not followed.contains(name)
    followed.append(name)
    var index = 0
    while index < owner.declared_functions.count() {
        var called = owner.declared_functions[index]
        if called.name == name {
            check_the_reach_of(owner, handed, called, written, followed)
        }
        index = index + 1
    }
}

func check_a_reached_attribute(
    owner: Model.ClassModel,
    handed: Model.FunctionModel,
    reached: Model.FunctionModel,
    name: String,
    written: String,
) {
    var attribute = owner.attribute_named(name)
    foreign.check_a_reached_attribute(context, written, handed.name, reached.name, owner, attribute)
}

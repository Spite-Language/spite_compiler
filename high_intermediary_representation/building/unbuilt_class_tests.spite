var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var rule = Validators.HighIntermediaryRepresentation.ClassTest.Validator()
var models = Dictionary<String, Model.ClassModel>()
var copies = Dictionary<String, List<Model.ClassModel>>()

func UnbuiltClassTests(starting_context: Context) {
    context = starting_context
    values = Values(starting_context)
}

# ../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func check() {
    note_the_models()
    var outer_class = context.current_class
    var outer_function = context.current_function
    var outer_line = context.line
    var table = context.resolver.state.symbols
    var trees = table.files.values()
    var library = Mapping.LibraryFile()
    var index = 0
    while index < trees.count() {
        var tree = trees[index]
        var is_the_programs = not library.holds(tree.path) and not library.is_written_by_the_compiler(tree.path)
        if is_the_programs {
            check_a_file(tree)
        }
        index = index + 1
    }
    context.current_class = outer_class
    context.current_function = outer_function
    context.line = outer_line
}

func note_the_models() {
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var path = model.file.path
        if not models.contains(path) or model.bound_types.is_empty() {
            models[path] = model
        }
        if not model.bound_types.is_empty() {
            note_a_copy(path, model)
        }
        index = index + 1
    }
}

func note_a_copy(path: String, model: Model.ClassModel) {
    var noted = copies[path]
    if noted {
        noted.append(model)
        return
    }
    var started = List<Model.ClassModel>()
    started.append(model)
    copies[path] = started
}

func check_a_file(tree: AbstractSyntaxTree.Shapes.SourceFile) {
    var model = model_of(tree)
    context.current_class = model
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            check_a_function(model, declaration)
        }
        index = index + 1
    }
}

func model_of(tree: AbstractSyntaxTree.Shapes.SourceFile): Model.ClassModel {
    var found = models[tree.path]
    if found {
        return found
    }
    return Model.ClassModel(tree.namespace, tree.namespace, tree, false)
}

func check_a_function(
    model: Model.ClassModel,
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    fallback declaration.body
    var function = Model.FunctionModel(
        declaration.name,
        model.key,
        null,
        declaration,
        null,
        null,
        null,
        null,
        false,
        false,
        false,
        false,
    )
    context.current_function = function
    check_a_block(declaration.body)
}

func check_a_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        check_a_statement(statement)
        index = index + 1
    }
}

func check_a_statement(statement: SpiteCompiler.WrittenStatement) {
    context.line = statement.line
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: statement.value = checked(statement.value)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: statement.value = checked(statement.value)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: statement.value = checked(statement.value)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: statement.condition = checked(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: check_a_loop(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: check_an_if(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: check_a_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: check_a_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: refuse_within(statement.value)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: refuse_within(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func check_a_loop(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    statement.condition = checked(statement.condition)
    check_a_block(statement.body)
}

func check_a_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    refuse_within(statement.value)
    var index = 0
    while index < statement.cases.count() {
        var written_case = statement.cases[index]
        check_a_block(written_case.body)
        index = index + 1
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func check_an_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var link = statement
    var keeps_going = true
    while keeps_going {
        context.line = link.line
        link.condition = checked(link.condition)
        check_a_block(link.then_branch)
        var next = next_link_of(link)
        keeps_going = false
        if next {
            link = next
            keeps_going = true
        } else {
            check_a_block(link.else_branch)
        }
    }
}

func next_link_of(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
): AbstractSyntaxTree.Shapes.Statements.IfStatement? {
    fallback statement.else_branch and statement.else_branch.is_an_else_if
    var inner = statement.else_branch.statements[0]
    crash inner.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    return inner
}

# ../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func checked(written: SpiteCompiler.Expression?): SpiteCompiler.Expression? {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return checked_a_binary(written)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        written.operand = checked(written.operand)
        return written
    }
    refuse_within(written)
    return written
}

func checked_a_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): SpiteCompiler.Expression {
    if binary.operator == 'and' or binary.operator == 'or' {
        binary.left = checked(binary.left)
        binary.right = checked(binary.right)
        return binary
    }
    var member = type_compared(binary)
    if not member {
        refuse_within(binary.left)
        refuse_within(binary.right)
        return binary
    }
    var answer = rule.check_an_unbuilt_class_test(context, binary, member, true)
    if answer.is_fixable() {
        var fixing = Fixes.AfterBuilding.EveryFix()
        return fixing.fixed_an_unbuilt_type_test(context, binary)
    }
    context.tell(answer)
    return binary
}

# ../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func refuse_within(written: SpiteCompiler.Expression?) {
    fallback written
    refuse_in(written)
}

func refuse_in(written: SpiteCompiler.Expression) {
    switch written {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: refuse_in_the_holes(written)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: refuse_within(written.target)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: refuse_in_a_call(written)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: refuse_in_an_index(written)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: refuse_in_a_binary(written)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: refuse_within(written.operand)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: refuse_in_each(written.entries)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: refuse_in_each(written.pairs)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: refuse_in_an_entry(written)
    }
}

func refuse_in_the_holes(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral) {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        refuse_within(piece.hole)
        index = index + 1
    }
}

func refuse_in_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    refuse_within(call.callee)
    refuse_in_each(call.arguments)
}

func refuse_in_an_index(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    refuse_within(read.target)
    refuse_within(read.index)
}

func refuse_in_an_entry(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral) {
    refuse_within(entry.key)
    refuse_within(entry.value)
}

func refuse_in_each(written: List<SpiteCompiler.Expression>) {
    written.each(refuse_in)
}

func refuse_in_a_binary(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var member = type_compared(binary)
    if member {
        var answer = rule.check_an_unbuilt_class_test(context, binary, member, false)
        context.tell(answer)
        return
    }
    refuse_within(binary.left)
    refuse_within(binary.right)
}

# ../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func type_compared(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Model.Type? {
    var compares = binary.operator == 'equal_equal' or binary.operator == 'not_equal'
    fallback compares and asks_a_class(binary.left)
    fallback not context.was_built(binary)
    var path = values.tested_class_path_of(binary.right)
    fallback not path.is_empty()
    var first = path[0]
    if first.starts_with("$") {
        fallback path.count() == 1
        return bound_somewhere(first)
    }
    var arguments = values.type_arguments_of(binary.right)
    fallback arguments.is_empty()
    var found = context.resolver.types.declared_type_in(path, context.current_class)
    fallback found
    fallback found.kind == 'shape' or found.kind == 'union'
    return found
}

func asks_a_class(left: SpiteCompiler.Expression?): Boolean {
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and left.name == "class" {
        return true
    }
    var operators = Operators(context, values)
    var codegen_path = operators.codegen_path_of(left)
    return not codegen_path.is_empty()
}

# ../../../spite_documentation/control_flow.md#a-comparison-no-copy-builds
func bound_somewhere(name: String): Model.Type? {
    var path = context.current_class.file.path
    var noted = copies[path]
    fallback noted
    var index = 0
    while index < noted.count() {
        var made = noted[index]
        var bound = made.bound_types[name]
        if bound and is_a_type(bound) {
            return bound
        }
        index = index + 1
    }
    return null
}

func is_a_type(bound: Model.Type): Boolean {
    return bound.kind == 'shape' or bound.kind == 'union'
}

# ../../../../spite_documentation/repl.md#typing-spite-into-a-running-program

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var typed = SessionFile()
var lines = List<String>()
var taken_names = List<String>()
var line_variables = List<String>()
var statement_words = ["var", "if", "while", "switch", "return", "crash", "fallback", "func", "load"]
var _equals_sign = 61
var _exclamation_mark = 33
var _less_than = 60
var _greater_than = 62
var _quote = 34
var _backslash = 92
var _opening_round = 40
var _closing_round = 41
var _opening_square = 91
var _closing_square = 93
var _opening_brace = 123
var _closing_brace = 125
var _lowercase_a = 97
var _lowercase_z = 122
var _uppercase_a = 65
var _uppercase_z = 90
var _digit_zero = 48
var _digit_nine = 57
var _underscore = 95
var function_word = "func "
var variable_word = "var "

func Session(starting_context: Context, starting_typed: SessionFile) {
    context = starting_context
    typed = starting_typed
}

# ../../../HOT_RELOAD.md#lines-typed-at-the-repl
func source(entry: Model.ClassModel): String {
    lines = List<String>()
    note_the_taken_names()
    var entry_shown = entry.shown
    lines.append("singleton")
    lines.append("")
    lines.append("var _held_program: {entry_shown}? = null")
    lines.append("var _loop = Spite.ReadEvaluatePrintLoop()")
    lines.append("")
    lines.append("func hold(running: {entry_shown}) \{")
    lines.append("    _held_program = running")
    lines.append("}")
    lines.append("")
    lines.append("func get_program(): {entry_shown} \{")
    lines.append("    crash _held_program")
    lines.append("    return _held_program")
    lines.append("}")
    entry.declared_attributes.each(forward_an_attribute)
    entry.declared_functions.each(forward_a_function)
    var index = 0
    while index < typed.variable_names.count() {
        var name = typed.variable_names[index]
        var shown = typed.variable_types[index]
        crash name and shown
        if not line_variables.contains(name) {
            keep_a_variable(name, shown)
        }
        index = index + 1
    }
    typed.session_functions.each(add_a_function)
    write_the_line()
    return lines.join("\n")
}

func note_the_taken_names() {
    taken_names = ["program", "hold", "run_line"]
    typed.variable_names.each(taken_names.append)
    var index = 0
    while index < typed.session_functions.count() {
        var text = typed.session_functions[index]
        var name = function_name_of(text)
        taken_names.append(name)
        index = index + 1
    }
    line_variables = List<String>()
    var depth = 0
    var line_index = 0
    while line_index < typed.line_lines.count() {
        var written = typed.line_lines[line_index]
        var trimmed = written.trim()
        if depth == 0 and trimmed.starts_with("var ") {
            var name = variable_name_of(trimmed)
            line_variables.append(name)
            taken_names.append(name)
        }
        depth = depth + brace_change_of(written)
        line_index = line_index + 1
    }
}

func function_name_of(text: String): String {
    var trimmed = text.trim()
    var opening = trimmed.index_of("(")
    var start = function_word.length()
    fallback opening and opening > start
    var name = trimmed.slice(start, opening)
    crash name
    return name.trim()
}

func variable_name_of(trimmed: String): String {
    var name = ""
    var index = variable_word.length()
    var goes_on = true
    while goes_on and index < trimmed.length() {
        var code = trimmed.byte_at(index)
        var is_lower = code >= _lowercase_a and code <= _lowercase_z
        var is_upper = code >= _uppercase_a and code <= _uppercase_z
        var is_a_digit = code >= _digit_zero and code <= _digit_nine
        goes_on = is_lower or is_upper or is_a_digit or code == _underscore
        if goes_on {
            var piece = trimmed.slice(index, index + 1)
            crash piece
            name = "{name}{piece}"
        }
        index = index + 1
    }
    return name
}

func brace_change_of(text: String): Integer {
    var change = 0
    var in_text = false
    var index = 0
    while index < text.length() {
        var code = text.byte_at(index)
        if in_text and code == _backslash {
            index = index + 1
        } else if code == _quote {
            in_text = not in_text
        } else if not in_text and code == _opening_brace {
            change = change + 1
        } else if not in_text and code == _closing_brace {
            change = change - 1
        }
        index = index + 1
    }
    return change
}

# ../../../../spite_documentation/repl.md#typing-spite-into-a-running-program
func is_writable(of_type: Model.Type): Boolean {
    var kind = of_type.kind
    if kind == 'scalar' or kind == 'enumeration' {
        return true
    }
    fallback kind == 'object'
    var model = context.program.class_named(of_type.name)
    fallback model
    return not model.is_an_object_literal
}

func forward_an_attribute(attribute: Model.AttributeModel) {
    var name = attribute.name
    fallback not name.starts_with("_") and not taken_names.contains(name)
    var entry = context.program.class_named(attribute.owner)
    crash entry
    var getter = entry.function_named("get_{name}")
    var setter = entry.function_named("set_{name}")
    fallback not getter and not setter
    fallback is_writable(attribute.attribute_type)
    var shown = context.shown(attribute.attribute_type)
    lines.append("")
    lines.append("func get_{name}(): {shown} \{")
    lines.append("    return program.{name}")
    lines.append("}")
    lines.append("")
    lines.append("func set_{name}(given: {shown}) \{")
    lines.append("    program.{name} = given")
    lines.append("}")
}

func forward_a_function(function: Model.FunctionModel) {
    var name = function.name
    fallback not name.starts_with("_") and not taken_names.contains(name) and name != "drop"
    var first = name.byte_at(0)
    fallback first >= _lowercase_a and first <= _lowercase_z
    fallback not function.is_synthetic and not function.is_written_by_the_compiler and not function.is_a_constructor()
    fallback function.has_a_body() and not function.is_walked()
    var answer = ""
    if function.answer {
        fallback is_writable(function.answer)
        var shown_answer = context.shown(function.answer)
        answer = ": {shown_answer}"
    }
    var taken = List<String>()
    var given = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        fallback not parameter.is_variadic and is_writable(parameter.parameter_type)
        var shown = context.shown(parameter.parameter_type)
        taken.append("{parameter.name}: {shown}")
        given.append(parameter.name)
        index = index + 1
    }
    var taken_text = taken.join(", ")
    var given_text = given.join(", ")
    lines.append("")
    lines.append("func {name}({taken_text}){answer} \{")
    if function.answer {
        lines.append("    return program.{name}({given_text})")
    } else {
        lines.append("    program.{name}({given_text})")
    }
    lines.append("}")
}

func keep_a_variable(name: String, shown: String) {
    var plain = shown
    var may_be_null = shown.ends_with("?")
    if may_be_null {
        var length = shown.length()
        var sliced = shown.slice(0, length - 1)
        crash sliced
        plain = sliced
    }
    lines.append("")
    lines.append("func get_{name}(): {shown} \{")
    lines.append("    var held = _loop.kept(\"{name}\")")
    if may_be_null {
        lines.append("    fallback held")
    } else {
        lines.append("    crash held")
    }
    lines.append("    if held.class == {plain} \{")
    lines.append("        return held")
    lines.append("    }")
    lines.append("    crash")
    lines.append("}")
    lines.append("")
    lines.append("func set_{name}(given: {shown}) \{")
    lines.append("    _loop.keep(\"{name}\", given)")
    lines.append("}")
}

func add_a_function(text: String) {
    lines.append("")
    lines.append(text)
}

func write_the_line() {
    lines.append("")
    lines.append("func run_line(): String? \{")
    var written = typed.line()
    var trimmed = written.trim()
    if not trimmed.is_empty() and is_an_expression(written) {
        lines.append("    var line_value = {trimmed}")
        lines.append("    return _loop.shown_value(line_value)")
        lines.append("}")
        return
    }
    var index = 0
    while index < typed.line_lines.count() {
        var each = typed.line_lines[index]
        lines.append("    {each}")
        index = index + 1
    }
    var kept_index = 0
    while kept_index < line_variables.count() {
        var name = line_variables[kept_index]
        lines.append("    _loop.keep(\"{name}\", {name})")
        kept_index = kept_index + 1
    }
    lines.append("    return null")
    lines.append("}")
}

# ../../../../spite_documentation/repl.md#typing-spite-into-a-running-program
func is_an_expression(written: String): Boolean {
    fallback not written.contains("\n")
    var trimmed = written.trim()
    var words = trimmed.split(" ")
    var first = words[0]
    crash first
    fallback not statement_words.contains(first)
    return not assigns(trimmed)
}

func assigns(text: String): Boolean {
    var depth = 0
    var in_text = false
    var index = 0
    while index < text.length() {
        var code = text.byte_at(index)
        if in_text and code == _backslash {
            index = index + 1
        } else if code == _quote {
            in_text = not in_text
        } else if not in_text {
            if code == _opening_round or code == _opening_square or code == _opening_brace {
                depth = depth + 1
            } else if code == _closing_round or code == _closing_square or code == _closing_brace {
                depth = depth - 1
            } else if code == _equals_sign and depth == 0 and is_a_lone_equals_sign(text, index) {
                return true
            }
        }
        index = index + 1
    }
    return false
}

func is_a_lone_equals_sign(text: String, at: Integer): Boolean {
    var before = 0
    if at > 0 {
        before = text.byte_at(at - 1)
    }
    var after = 0
    if at + 1 < text.length() {
        after = text.byte_at(at + 1)
    }
    var joins_before = before == _equals_sign or before == _exclamation_mark or before == _less_than or before == _greater_than
    return not joins_before and after != _equals_sign
}

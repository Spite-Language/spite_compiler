# ../../../../spite_documentation/repl.md#typing-spite-into-a-running-program

var variable_names = List<String>()
var variable_types = List<String>()
var session_functions = List<String>()
var loaded = List<String>()
var line_lines = List<String>()
var written_lines = List<String>()
var at = 0

# ../../../HOT_RELOAD.md#lines-typed-at-the-repl
func read(text: String) {
    written_lines = text.split("\n")
    at = 0
    while at < written_lines.count() {
        var written = written_lines[at]
        at = at + 1
        read_an_entry(written)
    }
}

func read_an_entry(written: String) {
    var parts = written.split("\t")
    var kind = parts[0]
    crash kind
    if kind == "var" and parts.count() == 3 {
        var name = parts[1]
        var shown = parts[2]
        variable_names.append(name)
        variable_types.append(shown)
    } else if kind == "func" and parts.count() == 2 {
        var held = held_lines(parts)
        session_functions.append(held)
    } else if kind == "line" and parts.count() == 2 {
        var held = held_lines(parts)
        line_lines = held.split("\n")
    } else if kind == "load" and parts.count() == 2 {
        var path = parts[1]
        loaded.append(path)
    }
}

func held_lines(parts: List<String>): String {
    var counted = parts[1]
    crash counted
    var count: Integer? = counted
    crash count
    var held = List<String>()
    var index = 0
    while index < count and at < written_lines.count() {
        var each = written_lines[at]
        held.append(each)
        at = at + 1
        index = index + 1
    }
    return held.join("\n")
}

func line(): String {
    return line_lines.join("\n")
}

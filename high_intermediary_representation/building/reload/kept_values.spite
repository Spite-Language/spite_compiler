var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var _uppercase_a = 65
var _uppercase_z = 90
var _lowercase_a = 97
var _lowercase_z = 122
var _digit_zero = 48
var _digit_nine = 57
var _underscore = 95

func KeptValues(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../HOT_RELOAD.md#lines-typed-at-the-repl
func kept_by(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    fallback context.current_class.key == "Spite.Session"
    var target = callee.target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression and target.name == "_loop"
    var named = call.arguments.first()
    fallback named
    var name = values.key_name_of(named)
    fallback name
    if callee.name == "keep" and call.arguments.count() == 2 {
        return kept_now(name, call)
    }
    if callee.name == "kept" and call.arguments.count() == 1 {
        return read_back(name)
    }
    return null
}

func kept_now(name: String, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Value {
    var written = call.arguments[1]
    crash written
    var given = values.value_of(written, null)
    var model = slot_of(name, given.value_type)
    var held = model.attribute_named("value")
    crash held
    var fitting = Fitting(context, values)
    var stored = fitting.fitted(given, held.attribute_type)
    var slot = slot_value(model)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Attribute(slot, held, stored, context.line)
    context.pending.append(assigned)
    var nothing = Model.Type('nothing', "")
    return HighIntermediaryRepresentation.Values.NullConstant(nothing)
}

func read_back(name: String): SpiteCompiler.Value {
    crash context.current_function.answer
    var answer: Model.Type = context.current_function.answer
    var model = slot_of(name, answer)
    var held = model.attribute_named("value")
    crash held
    var slot = slot_value(model)
    return HighIntermediaryRepresentation.Values.AttributeRead(slot, held)
}

func slot_value(model: Model.ClassModel): SpiteCompiler.Value {
    var no_arguments = List<SpiteCompiler.Value>()
    var slot_type = model.type_of_an_instance()
    var constructor = values.constructor_of(model)
    if constructor {
        context.need(constructor)
    }
    context.need_defaults(model.key)
    context.note_a_singleton_made(model.key, no_arguments)
    return HighIntermediaryRepresentation.Values.MakeObject(slot_type, constructor, no_arguments, "", false)
}

# ../../../HOT_RELOAD.md#lines-typed-at-the-repl
func slot_of(name: String, kept_type: Model.Type): Model.ClassModel {
    var present = kept_type.present()
    var shown = context.shown(present)
    var spelled = spelled_for_a_class(shown)
    var stem = "kept_{name}_as_{spelled}"
    var names = Mapping.Names()
    var class_name = names.class_name_of(stem)
    var namespace = "Spite.{class_name}"
    var known = context.resolver.monomorphiser.class_model_named(namespace)
    if known {
        return known
    }
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var segments = entry.file.path.replace("\\", "/").split("/")
    crash segments.remove_last()
    var folder = segments.join("/")
    var path = "{folder}/.spite/build/spite/{stem}.spite"
    var text = "singleton\n\nvar value: {shown}? = null\n"
    var file_path: Path? = path
    crash file_path
    var slot_file = File(file_path)
    var written = slot_file.write_string(text)
    crash written
    var symbols = context.resolver.state.symbols
    symbols.add_a_generated_class(namespace, path, text)
    var made = context.resolver.monomorphiser.class_model_named(namespace)
    crash made
    return made
}

func spelled_for_a_class(shown: String): String {
    var spelled = String()
    var index = 0
    while index < shown.length() {
        var code = shown.byte_at(index)
        var is_upper = code >= _uppercase_a and code <= _uppercase_z
        var is_lower = code >= _lowercase_a and code <= _lowercase_z
        var is_a_digit = code >= _digit_zero and code <= _digit_nine
        if is_upper {
            spelled.append_code(code + _lowercase_a - _uppercase_a)
        } else if is_lower or is_a_digit {
            spelled.append_code(code)
        } else {
            spelled.append_code(_underscore)
        }
        index = index + 1
    }
    return spelled
}

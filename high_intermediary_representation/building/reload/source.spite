# ../../../../spite_documentation/repl.md#how-it-works

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var program = Program()
var environment = Environment()
var lines = List<String>()
var watches = List<String>()

func Source(starting_context: Context) {
    context = starting_context
}

# ../../../HOT_RELOAD.md#the-parts
func point_source(): String {
    lines = List<String>()
    var folder = context.build_flags["program"]
    var program_folder = absolute_of(folder)
    var working_folder = literal_of(program_folder)
    var executable = program.executable_path()
    crash executable
    var compiler = literal_of(executable)
    var given = arguments_text()
    var arguments = literal_of(given)
    choose_the_watches()
    var watched = watches.join(", ")
    lines.append("var reloader = Spite.HotReload()")
    lines.append("var working_folder = \"{working_folder}\"")
    lines.append("var compiler = \"{compiler}\"")
    lines.append("var arguments = \"{arguments}\"")
    lines.append("var watched_folders = [{watched}]")
    lines.append("")
    lines.append("func start() \{")
    lines.append("    reloader.forget_the_left_files()")
    lines.append("    reloader.start(working_folder, compiler, arguments, watched_folders)")
    lines.append("}")
    lines.append("")
    lines.append("func check_point() \{")
    lines.append("    reloader.check_point()")
    lines.append("}")
    return lines.join("\n")
}

func choose_the_watches() {
    watches = List<String>()
    var given = context.build_flags["program"]
    var folder = absolute_of(given)
    add_the_folder(folder)
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        var path = model.file.path.replace("\\", "/")
        var is_program_code = not path.is_empty() and not context.resolver.state.symbols.is_library_path(path)
        if is_program_code and not path.starts_with("{folder}/") {
            var cut = path.length()
            var found = false
            while cut > 0 and not found {
                var before = path[cut - 1]
                found = before == "/"
                if not found {
                    cut = cut - 1
                }
            }
            if cut > 1 {
                var holder = path.slice(0, cut - 1)
                crash holder
                var absolute = absolute_of(holder)
                add_the_folder(absolute)
            }
        }
        index = index + 1
    }
}

func add_the_folder(folder: String) {
    var written = literal_of(folder)
    var shown = "\"{written}\""
    if not watches.contains(shown) {
        watches.append(shown)
    }
}

func absolute_of(given: String?): String {
    var directory = program.working_directory()
    crash directory
    var working = directory.replace("\\", "/")
    if not given {
        return working
    }
    var forward = given.replace("\\", "/")
    var is_absolute = forward.starts_with("/") or forward.index_of(":") == 1
    if is_absolute {
        return forward
    }
    if forward == "." {
        return working
    }
    return "{working}/{forward}"
}

func arguments_text(): String {
    var words = List<String>()
    var names = context.build_flags.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var value = context.build_flags[name]
        crash value
        if not is_left_out(name) {
            var flag = name.replace("_", "-")
            if value == "true" {
                words.append("--{flag}")
            } else {
                var forward = value.replace("\\", "/")
                words.append("--{flag}=\"{forward}\"")
            }
        }
        index = index + 1
    }
    words.append("--build")
    return words.join(" ")
}

func is_left_out(name: String): Boolean {
    return name == "program" or environment.is_left_out_of_a_reload(name)
}

func literal_of(text: String): String {
    var forward = text.replace("\\", "/")
    var quoted_marks = forward.replace("\"", "\\\"")
    return quoted_marks.replace("\{", "\\\{")
}

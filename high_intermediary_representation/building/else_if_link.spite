var statement: AbstractSyntaxTree.Shapes.Statements.IfStatement
var condition: SpiteCompiler.Value
var written_condition: String
var then_branch: HighIntermediaryRepresentation.Statements.Block
var block: OpenedBlock
var statements: OpenedStatements

func ElseIfLink(
    starting_statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    starting_condition: SpiteCompiler.Value,
    starting_written_condition: String,
    starting_then_branch: HighIntermediaryRepresentation.Statements.Block,
    starting_block: OpenedBlock,
    starting_statements: OpenedStatements,
) {
    statement = starting_statement
    condition = starting_condition
    written_condition = starting_written_condition
    then_branch = starting_then_branch
    block = starting_block
    statements = starting_statements
}

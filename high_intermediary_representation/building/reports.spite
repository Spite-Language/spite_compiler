var state = StatementsState()

func Reports(starting_state: StatementsState) {
    state = starting_state
}

# ../../OPTIMIZATIONS.md#a-reported-calls-answer-is-let-go-after-its-check
func let_go_after_the_check(first_held: Integer, line: Integer) {
    var check = HighIntermediaryRepresentation.Statements.Block()
    check.line = line
    var index = first_held
    while index < state.built.count() {
        check.statements.append(state.built[index])
        index = index + 1
    }
    state.built.truncate(first_held)
    state.built.append(check)
}

func crash_report(): SpiteCompiler.Value? {
    var crashes = Crashes(state)
    var ring = crashes.assert_ring()
    fallback ring
    var reporting = ring.function_named("report")
    crash reporting
    state.values.need(reporting)
    var no_arguments = List<SpiteCompiler.Value>()
    var fetched = crashes.ring_object(ring)
    return HighIntermediaryRepresentation.Values.Call(reporting, fetched, no_arguments)
}

func report_of(
    message: String,
    condition: SpiteCompiler.Expression?,
    mentioned: List<String>,
    line: Integer,
): List<SpiteCompiler.Statement> {
    var statements = Statements(state)
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.report_types = List<String>()
    state.shown_count = 0
    var fault = fault_class()
    if fault {
        state.context.scope.enter()
        write_the_report(message, condition, mentioned, line)
        state.context.scope.leave()
    } else {
        var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
        stopped.line = line
        statements.add(stopped)
    }
    var made = state.built
    state.built = outer
    return made
}

func write_the_report(message: String, condition: SpiteCompiler.Expression?, mentioned: List<String>, line: Integer) {
    var statements = Statements(state)
    var text = state.context.text()
    state.report_name = state.context.scope.declare("___report", text)
    var empty = state.values.described_text("")
    var declared = HighIntermediaryRepresentation.Statements.Declare(state.report_name, text, empty)
    declared.line = line
    statements.add(declared)
    var is_a_narrowing = false
    if condition {
        is_a_narrowing = reports_what_is_missing(condition)
    }
    if not is_a_narrowing {
        state.shown_parts.each(show_a_part)
        show_the_values_in_scope(mentioned)
    }
    var head = state.values.described_text(message)
    var body = HighIntermediaryRepresentation.Values.LocalRead(text, state.report_name)
    var crashed_arguments = List<SpiteCompiler.Value>()
    crashed_arguments.append(head)
    crashed_arguments.append(body)
    var crashed = fault_call("crashed", crashed_arguments)
    evaluate_at(crashed, line)
    if state.context.resolver.state.symbols.program_asserts {
        var ring_report = crash_report()
        crash ring_report
        evaluate_at(ring_report, line)
    }
    var no_arguments = List<SpiteCompiler.Value>()
    var walked = fault_call("frames", no_arguments)
    evaluate_at(walked, line)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("")
    stopped.line = line
    statements.add(stopped)
}

func evaluate_at(value: SpiteCompiler.Value, line: Integer) {
    var statements = Statements(state)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(value)
    evaluated.line = line
    statements.add(evaluated)
}

func fault_class(): Model.ClassModel? {
    var found = state.context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = state.context.resolver.monomorphiser.class_model_named("Spite.Fault")
    fallback fault
    state.context.need_defaults(fault.key)
    return fault
}

func fault_call(name: String, arguments: List<SpiteCompiler.Value>): SpiteCompiler.Value {
    var crashes = Crashes(state)
    var fault = fault_class()
    crash fault
    var function = fault.function_named(name)
    crash function
    state.values.need(function)
    var made = crashes.ring_object(fault)
    return HighIntermediaryRepresentation.Values.Call(function, made, arguments)
}

func held_for_the_report(
    expression: SpiteCompiler.Expression,
    mode: Integer,
    at_failure: Integer,
    is_whole: Boolean,
): SpiteCompiler.Expression {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return held_name(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return held_member(expression, mode)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return held_index(expression, mode)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return held_call(expression, mode, is_whole)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return held_binary(expression, mode, at_failure)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return held_unary(expression, mode, at_failure, is_whole)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return expression
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return expression
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return expression
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return expression
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return expression
    }
}

func held_name(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): SpiteCompiler.Expression {
    if is_a_value_name(identifier.name) {
        note_a_shown_part(identifier.name, identifier)
        var local = state.context.scope.internal_name_of(identifier.name)
        if not local {
            state.reads_before = true
        }
    }
    return identifier
}

func held_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    mode: Integer,
): SpiteCompiler.Expression {
    if mode >= 1 and is_a_value_path(member) {
        var printer = Printers.Spite.ExpressionPrinter(member)
        var printed = printer.text()
        note_a_shown_part(printed, member)
        state.reads_before = true
        return member
    }
    crash member.target
    var target = held_for_the_report(member.target, mode, -1, false)
    state.reads_before = true
    var made = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, member.name)
    made.is_a_class_name = member.is_a_class_name
    return made
}

func held_index(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, mode: Integer): SpiteCompiler.Expression {
    if mode >= 1 and is_a_value_path(read) {
        var printer = Printers.Spite.ExpressionPrinter(read)
        var printed = printer.text()
        note_a_shown_part(printed, read)
        state.reads_before = true
        return read
    }
    crash read.target
    crash read.index
    var target = held_for_the_report(read.target, mode, -1, false)
    var index = held_for_the_report(read.index, mode, -1, false)
    state.reads_before = true
    return AbstractSyntaxTree.Shapes.Expressions.IndexExpression(target, index)
}

func held_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    mode: Integer,
    is_whole: Boolean,
): SpiteCompiler.Expression {
    var before = state.reads_before
    var printer = Printers.Spite.ExpressionPrinter(call)
    var printed = printer.text()
    var placeholder = ShownPart(printed, null)
    placeholder.place = place_of(call)
    if not state.shown_texts.contains(printed) and not is_whole {
        state.shown_parts.append(placeholder)
        state.shown_texts.append(printed)
    }
    crash call.callee
    var held_callee = held_callee_of(call.callee, mode)
    var arguments = List<SpiteCompiler.Expression>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var held_argument = held_for_the_report(argument, mode, -1, false)
        arguments.append(held_argument)
        index = index + 1
    }
    var rebuilt = AbstractSyntaxTree.Shapes.Expressions.CallExpression(held_callee, call.generic_arguments, arguments)
    if mode >= 1 and is_a_read_call(call) {
        placeholder.value = rebuilt
        state.reads_before = true
        return rebuilt
    }
    if mode == 2 and not is_whole and not before {
        var held = held_answer_of(rebuilt)
        placeholder.value = held
        return held
    }
    state.reads_before = true
    return rebuilt
}

func held_callee_of(callee: SpiteCompiler.Expression, mode: Integer): SpiteCompiler.Expression {
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash callee.target
        var target = held_for_the_report(callee.target, mode, -1, false)
        var made = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(target, callee.name)
        made.is_a_class_name = callee.is_a_class_name
        return made
    }
    return callee
}

func held_answer_of(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): SpiteCompiler.Expression {
    var statements = Statements(state)
    var value = state.values.value_of(call, null)
    state.reported_count = state.reported_count + 1
    var hidden = "___reported_{state.reported_count}"
    var name = state.context.scope.declare(hidden, value.value_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(name, value.value_type, value)
    declared.line = state.context.line
    statements.add(declared)
    return AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(hidden)
}

func held_binary(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    mode: Integer,
    at_failure: Integer,
): SpiteCompiler.Expression {
    crash binary.left
    crash binary.right
    var is_logical = binary.operator == 'and' or binary.operator == 'or'
    var both_true = binary.operator == 'and' and at_failure == 1
    var both_false = binary.operator == 'or' and at_failure == 0
    var sides_known = both_true or both_false
    var side_failure = -1
    var right_mode = mode
    if sides_known {
        side_failure = at_failure
        right_mode = lower_of(mode, 1)
    } else if is_logical {
        right_mode = 0
    }
    var asked = state.values.class_tested_of_a_test(binary)
    if asked {
        var held = held_for_the_report(asked, mode, side_failure, false)
        var held_class = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(held, "class")
        return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(held_class, binary.operator, binary.right)
    }
    var left = held_for_the_report(binary.left, mode, side_failure, false)
    var right = held_for_the_report(binary.right, right_mode, side_failure, false)
    return AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(left, binary.operator, right)
}

func lower_of(first_mode: Integer, second_mode: Integer): Integer {
    if first_mode < second_mode {
        return first_mode
    }
    return second_mode
}

func held_unary(
    unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression,
    mode: Integer,
    at_failure: Integer,
    is_whole: Boolean,
): SpiteCompiler.Expression {
    crash unary.operand
    var failure = -1
    var is_a_not = unary.operator == 'not'
    if is_a_not and at_failure >= 0 {
        failure = 1 - at_failure
    }
    var operand = held_for_the_report(unary.operand, mode, failure, is_whole and is_a_not)
    return AbstractSyntaxTree.Shapes.Expressions.UnaryExpression(unary.operator, operand)
}

func place_of(written: SpiteCompiler.Expression): String {
    fallback written.line > 0
    return "@{written.line}:{written.column}"
}

func note_a_shown_part(text: String, value: SpiteCompiler.Expression) {
    fallback not state.shown_texts.contains(text)
    var part = ShownPart(text, value)
    part.place = place_of(value)
    state.shown_parts.append(part)
    state.shown_texts.append(text)
}

func is_a_value_name(name: String): Boolean {
    var local = state.context.scope.internal_name_of(name)
    if local {
        return true
    }
    var attribute = state.context.current_class.attribute_named(name)
    if attribute {
        return true
    }
    return false
}

func is_a_value_path(expression: SpiteCompiler.Expression?): Boolean {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return is_a_value_name(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return is_a_value_member(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return is_a_value_read(expression)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return false
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return false
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return false
    }
}

func is_a_value_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    fallback not member.is_a_class_name
    return is_a_value_path(member.target)
}

func is_a_value_read(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): Boolean {
    var statements = Statements(state)
    fallback not statements.holds_a_call(read.index)
    return is_a_value_path(read.target)
}

func is_a_read_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    crash call.callee
    return call.arguments.is_empty() and is_a_read_callee(call.callee)
}

func is_a_read_callee(callee: SpiteCompiler.Expression): Boolean {
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_a_read_of(callee)
    }
    return false
}

func is_a_read_of(callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    var crashes = Crashes(state)
    var reads = ["count", "length", "is_empty"]
    var target = callee.target
    var is_plain = target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_plain = is_plain or target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback reads.contains(callee.name) and is_plain and is_a_value_path(target)
    var read = state.values.value_of(target, null)
    var shown = state.context.shown(read.value_type)
    return crashes.is_a_collection(read.value_type, shown) or shown == "String"
}

func gather_every_name(expression: SpiteCompiler.Expression?, names: List<String>) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: names.append(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: gather_every_name(expression.target, names)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: gather_both_reads(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: gather_every_call_name(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: gather_both_sides(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: gather_every_name(expression.operand, names)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return
    }
}

func gather_both_reads(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, names: List<String>) {
    gather_every_name(read.target, names)
    gather_every_name(read.index, names)
}

func gather_both_sides(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, names: List<String>) {
    gather_every_name(binary.left, names)
    gather_every_name(binary.right, names)
}

func gather_every_call_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, names: List<String>) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        gather_every_name(callee.target, names)
    }
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        gather_every_name(argument, names)
        index = index + 1
    }
}

func show_a_part(part: ShownPart) {
    fallback part.value
    var value = state.values.value_of(part.value, null)
    var shown = state.context.shown(value.value_type)
    state.report_types.append("{part.text}:{shown}{part.place}")
    show_a_value(part.text, part.value, value, true)
}

func show_a_value(text: String, written: SpiteCompiler.Expression, value: SpiteCompiler.Value, objects_too: Boolean) {
    var statements = Statements(state)
    var present = value.value_type.present()
    var shows = can_be_shown(present, objects_too)
    var is_nullable = value.value_type.is_nullable
    if not is_nullable and shows {
        state.shown_count = state.shown_count + 1
        append_a_value(text, value)
    }
    if is_nullable and value.value_type.kind != 'handle' {
        state.shown_count = state.shown_count + 1
        statements.flush_the_pending()
        var then_branch = shown_when_present(text, written, present, shows)
        var else_branch = block_of_the_missing(written, text)
        var tested = HighIntermediaryRepresentation.Values.PresenceTest(value)
        var made = HighIntermediaryRepresentation.Statements.If(tested, then_branch, else_branch)
        made.line = state.context.line
        statements.add(made)
    }
}

func shown_when_present(
    text: String,
    written: SpiteCompiler.Expression,
    present: Model.Type,
    shows: Boolean,
): HighIntermediaryRepresentation.Statements.Block {
    var statements = Statements(state)
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    var printer = Printers.Spite.ExpressionPrinter(written)
    var printed = printer.text()
    var path = statements.path_of(written, printed)
    state.context.scope.narrow(path, present)
    if shows {
        var narrowed = state.values.value_of(written, null)
        append_a_value(text, narrowed)
    }
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    state.built = outer
    return made
}

func append_a_value(text: String, value: SpiteCompiler.Value) {
    var shown = text_of_a_shown(value)
    var named = state.values.described_text(", {text}=")
    var joined = state.values.joined_with(named, shown)
    append_to_the_report(joined)
}

func append_to_the_report(piece: SpiteCompiler.Value) {
    var statements = Statements(state)
    var text = state.context.text()
    var current = HighIntermediaryRepresentation.Values.LocalRead(text, state.report_name)
    var joined = state.values.joined_with(current, piece)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(state.report_name, joined)
    assigned.line = state.context.line
    statements.add(assigned)
}

func can_be_shown(present: Model.Type, objects_too: Boolean): Boolean {
    fallback not present.is_a_walked_name
    if present.kind == 'scalar' {
        return not present.name.contains("Address")
    }
    if present.kind == 'enumeration' {
        return true
    }
    fallback present.kind == 'object'
    var text = state.context.text()
    if present.is_the_same_as(text) {
        return true
    }
    fallback objects_too and state.context.has_a_class(present)
    var model = state.context.class_of(present)
    var shown = model.function_named("to_string")
    if shown {
        return shown.parameters.is_empty()
    }
    return false
}

func text_of_a_shown(value: SpiteCompiler.Value): SpiteCompiler.Value {
    var text = state.context.text()
    var no_arguments = List<SpiteCompiler.Value>()
    if value.value_type.is_the_same_as(text) {
        return cut_text(value)
    }
    if value.value_type.kind == 'enumeration' {
        return state.values.enum_text(value)
    }
    var written = state.values.method_call(value, "to_string", no_arguments)
    if value.value_type.kind == 'scalar' {
        return written
    }
    return cut_text(written)
}

func cut_text(value: SpiteCompiler.Value): SpiteCompiler.Value {
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(value)
    return fault_call("cut", arguments)
}

func block_of_the_missing(
    written: SpiteCompiler.Expression,
    printed: String,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    append_the_missing(written, printed)
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    state.built = outer
    return made
}

func append_the_missing(written: SpiteCompiler.Expression, printed: String) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        append_a_missing_item(written, printed)
    } else {
        var missing = state.values.described_text(", {printed} is null")
        append_to_the_report(missing)
    }
}

func index_type_of(target: SpiteCompiler.Value): Model.Type? {
    fallback state.context.has_a_class(target.value_type)
    var model = state.context.class_of(target.value_type)
    var reading = model.function_named("get_at")
    fallback reading
    var first = reading.parameters.first()
    fallback first
    return first.parameter_type
}

func append_a_missing_item(read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, printed: String) {
    crash read.target
    crash read.index
    var target = state.values.value_of(read.target, null)
    var shown_target = state.context.shown(target.value_type)
    var key_type = index_type_of(target)
    var index_value = state.values.value_of(read.index, key_type)
    var shows_the_index = can_be_shown(index_value.value_type, true) and not index_value.value_type.is_nullable
    var is_listed = shown_target.starts_with("List<") or shown_target.starts_with("Vector<") or shown_target.starts_with("Items<")
    if is_listed and shows_the_index {
        var no_arguments = List<SpiteCompiler.Value>()
        var counted = state.values.method_call(target, "count", no_arguments)
        var counted_text = text_of_a_shown(counted)
        var index_text = text_of_a_shown(index_value)
        var opening = state.values.described_text(", {printed} is missing: index ")
        var middle = state.values.described_text(", count ")
        var with_index = state.values.joined_with(opening, index_text)
        var with_middle = state.values.joined_with(with_index, middle)
        var whole = state.values.joined_with(with_middle, counted_text)
        append_to_the_report(whole)
    } else if shows_the_index {
        append_a_missing_key(printed, index_value)
    } else {
        var missing = state.values.described_text(", {printed} is missing")
        append_to_the_report(missing)
    }
}

func append_a_missing_key(printed: String, key: SpiteCompiler.Value) {
    var key_text = text_of_a_shown(key)
    var text = state.context.text()
    var quote = ""
    if key.value_type.is_the_same_as(text) {
        quote = "\""
    }
    var opening = state.values.described_text(", {printed} is missing: key {quote}")
    var closing = state.values.described_text(quote)
    var with_key = state.values.joined_with(opening, key_text)
    var whole = state.values.joined_with(with_key, closing)
    append_to_the_report(whole)
}

func reports_what_is_missing(condition: SpiteCompiler.Expression): Boolean {
    state.missing_conjuncts = List<SpiteCompiler.Expression>()
    gather_the_conjuncts(condition)
    var index = 0
    while index < state.missing_conjuncts.count() {
        var conjunct = state.missing_conjuncts[index]
        fallback is_a_narrowed_path(conjunct)
        index = index + 1
    }
    state.missing_links = List<SpiteCompiler.Expression>()
    state.missing_conjuncts.each(gather_the_links)
    report_the_links(0)
    return true
}

func is_a_narrowed_path(written: SpiteCompiler.Expression): Boolean {
    fallback is_a_value_path(written)
    var kept = state.context.pending
    state.context.pending = List<SpiteCompiler.Statement>()
    state.missing_links = List<SpiteCompiler.Expression>()
    gather_the_links(written)
    state.context.scope.enter()
    var found = false
    var index = 0
    while index < state.missing_links.count() {
        var link = state.missing_links[index]
        var value = state.values.value_of(link, null)
        if value.value_type.is_nullable {
            found = true
            narrow_a_link(link, value.value_type)
        }
        index = index + 1
    }
    state.context.scope.leave()
    state.context.pending = kept
    return found
}

func narrow_a_link(link: SpiteCompiler.Expression, link_type: Model.Type) {
    var statements = Statements(state)
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var path = statements.path_of(link, printed)
    var present = link_type.present()
    state.context.scope.narrow(path, present)
}

func gather_the_conjuncts(written: SpiteCompiler.Expression) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        gather_a_binary_conjunct(written)
    } else {
        state.missing_conjuncts.append(written)
    }
}

func gather_a_binary_conjunct(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    if binary.operator == 'and' {
        crash binary.left
        crash binary.right
        gather_the_conjuncts(binary.left)
        gather_the_conjuncts(binary.right)
    } else {
        state.missing_conjuncts.append(binary)
    }
}

func gather_the_links(written: SpiteCompiler.Expression) {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash written.target
        gather_the_links(written.target)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        crash written.target
        gather_the_links(written.target)
    }
    state.missing_links.append(written)
}

func report_the_links(index: Integer) {
    if index >= state.missing_links.count() {
        state.missing_conjuncts.each(show_a_present_conjunct)
    } else {
        var link = state.missing_links[index]
        crash link
        report_a_link(link, index)
    }
}

func report_a_link(link: SpiteCompiler.Expression, index: Integer) {
    var statements = Statements(state)
    var value = state.values.value_of(link, null)
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var shown = state.context.shown(value.value_type)
    var place = place_of(link)
    state.report_types.append("{printed}:{shown}{place}")
    if not value.value_type.is_nullable {
        report_the_links(index + 1)
    } else {
        statements.flush_the_pending()
        var present = value.value_type.present()
        var rest = narrowed_rest(link, present, index + 1)
        var missing = block_of_the_missing(link, printed)
        var tested = HighIntermediaryRepresentation.Values.PresenceTest(value)
        var made = HighIntermediaryRepresentation.Statements.If(tested, rest, missing)
        made.line = state.context.line
        statements.add(made)
    }
}

func narrowed_rest(
    link: SpiteCompiler.Expression,
    present: Model.Type,
    next_index: Integer,
): HighIntermediaryRepresentation.Statements.Block {
    var statements = Statements(state)
    var outer = state.built
    state.built = List<SpiteCompiler.Statement>()
    state.context.scope.enter()
    var printer = Printers.Spite.ExpressionPrinter(link)
    var printed = printer.text()
    var path = statements.path_of(link, printed)
    state.context.scope.narrow(path, present)
    report_the_links(next_index)
    state.context.scope.leave()
    var made = HighIntermediaryRepresentation.Statements.Block()
    made.statements = state.built
    state.built = outer
    return made
}

func show_a_present_conjunct(conjunct: SpiteCompiler.Expression) {
    var value = state.values.value_of(conjunct, null)
    var shows = can_be_shown(value.value_type, true)
    if shows and not value.value_type.is_nullable {
        var printer = Printers.Spite.ExpressionPrinter(conjunct)
        var printed = printer.text()
        append_a_value(printed, value)
    }
}

func show_the_values_in_scope(mentioned: List<String>) {
    var path = state.context.path()
    var forward = path.replace("\\", "/")
    if not forward.contains("/.spite/build/spite/") {
        show_the_scope(mentioned)
    }
}

func show_the_scope(mentioned: List<String>) {
    var names = state.context.scope.visible_written_names()
    var index = 0
    while index < names.count() {
        var name = names[index]
        if state.shown_count < 12 and not mentioned.contains(name) {
            show_a_named_value(name)
        }
        index = index + 1
    }
    var own = state.values.this_value()
    if own.value_type.kind == 'object' {
        show_the_attributes(mentioned, names)
    }
}

func show_the_attributes(mentioned: List<String>, names: List<String>) {
    var library = Mapping.LibraryFile()
    var path = state.context.path()
    var in_the_library = library.holds(path)
    var attributes = state.context.current_class.declared_attributes
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        var is_hidden = state.shown_count >= 12 or mentioned.contains(attribute.name) or names.contains(attribute.name)
        is_hidden = is_hidden or in_the_library and attribute.name.starts_with("_")
        var present = attribute.attribute_type.present()
        if not is_hidden and can_be_shown(present, false) {
            show_a_named_value(attribute.name)
        }
        attribute_index = attribute_index + 1
    }
}

func show_a_named_value(name: String) {
    var identifier = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(name)
    var internal_name = state.context.scope.internal_name_of(name)
    if internal_name {
        var local_type = state.context.scope.type_of(internal_name)
        crash local_type
        var present = local_type.present()
        fallback can_be_shown(present, false)
    }
    var value = state.values.value_of(identifier, null)
    show_a_value(name, identifier, value, false)
}

func gather_the_names(expression: SpiteCompiler.Expression?, names: List<String>) {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: note_a_shown_name(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: gather_both(expression, names)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: gather_the_names(expression.operand, names)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return
    }
}

func gather_both(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, names: List<String>) {
    gather_the_names(binary.left, names)
    gather_the_names(binary.right, names)
}

func note_a_shown_name(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression, names: List<String>) {
    var is_known = state.context.scope.internal_name_of(identifier.name)
    fallback is_known and not names.contains(identifier.name)
    names.append(identifier.name)
    var place = place_of(identifier)
    state.name_places.append(place)
}

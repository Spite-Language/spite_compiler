var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func Identity(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/functions_and_operators.md#the-same-instance
func identity_value(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): SpiteCompiler.Value {
    var left = values.value_of(binary.left, null)
    var right = values.value_of(binary.right, null)
    var left_held = held_classes_of(left.value_type)
    var right_held = held_classes_of(right.value_type)
    var rule = Validators.HighIntermediaryRepresentation.SameInstance.Validator()
    var answer = rule.check_the_operands(context, binary, left.value_type, right.value_type, left_held, right_held)
    context.tell(answer)
    var same = same_instance(left, right)
    if binary.operator == 'not_equal_equal' {
        return HighIntermediaryRepresentation.Values.Negation(same)
    }
    return same
}

# ../../../spite_documentation/functions_and_operators.md#the-same-instance
func same_instance(left: SpiteCompiler.Value, right: SpiteCompiler.Value): SpiteCompiler.Value {
    var boolean = context.boolean()
    var left_present = left.value_type.present()
    var right_present = right.value_type.present()
    if left_present.kind != 'function' or right_present.kind != 'function' {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', left, right, null)
    }
    var operators = Operators(context, values)
    var equality = Equality(context, values)
    var fitting = Fitting(context, values)
    var comparers = FunctionComparers(context, values)
    var held_left = operators.held_once(left)
    var held_right = operators.held_once(right)
    var present_left = equality.present_of(held_left)
    var present_right = equality.present_of(held_right)
    var fitted_right = fitting.fitted(present_right, present_left.value_type)
    var identical = comparers.identical(present_left, fitted_right)
    return equality.with_the_nulls(held_left, held_right, identical)
}

# ../../../spite_documentation/functions_and_operators.md#the-same-instance
func held_classes_of(held: Model.Type): List<Model.Type> {
    var found = List<Model.Type>()
    var present = held.present()
    add_the_held(present, found)
    return found
}

func add_the_held(held: Model.Type, found: List<Model.Type>) {
    if held.kind != 'union' {
        found.append(held)
        return
    }
    var fitting = Fitting(context, values)
    var united = fitting.union_model_of(held)
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var present = member.present()
        add_the_held(present, found)
        index = index + 1
    }
}

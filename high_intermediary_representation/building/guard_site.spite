var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var kind = ""
var owner = Model.ClassModel("", "", no_file, false)
var function = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var line = 0
var condition: SpiteCompiler.Expression? = null
var statement_line = 0
var has_an_else = false
var proves_something = false
var block = List<SpiteCompiler.WrittenStatement>()

func GuardSite(starting_kind: String, starting_context: Context) {
    kind = starting_kind
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
    block = starting_context.block_statements
}

# ../../PROOFS.md#a-guard-assert-answers-only-nothing
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var kind = ""
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var condition: AbstractSyntaxTree.Shapes.Expressions.Expression? = null
var statement_line = 0
var has_an_else = false
var proves_something = false

func GuardSite(starting_kind: String, starting_context: Context) {
    kind = starting_kind
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
}

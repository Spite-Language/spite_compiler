# ../../ARCHITECTURE.md#checking-the-functions-nobody-calls

var program = Model.ProgramModel()
var class_count = 0
var classes = Dictionary<String, Model.ClassModel>()
var shapes = Dictionary<String, Model.ShapeModel>()
var shape_keys = List<String>()
var shape_member_counts = List<Integer>()
var filled_shape_keys = List<String>()
var filler_counts = List<Integer>()
var function_counts = List<Integer>()
var attribute_counts = List<Integer>()
var enum_counts = List<Integer>()
var union_counts = List<Integer>()
var class_shape_counts = List<Integer>()

func ModelCheckpoint(starting_program: Model.ProgramModel) {
    program = starting_program
    class_count = program.order.count()
    classes = program.classes.copy()
    shapes = program.shapes.copy()
    shape_keys = program.shapes.keys()
    shape_keys.each(remember_the_members_of)
    filled_shape_keys = program.shape_fillers.keys()
    filled_shape_keys.each(remember_the_fillers_of)
    program.order.each(remember_a_class)
}

func remember_the_members_of(key: String) {
    var shape = program.shapes[key]
    crash shape
    var counted = shape.members.count()
    shape_member_counts.append(counted)
}

func remember_the_fillers_of(key: String) {
    var fillers = program.fillers_of(key)
    var counted = fillers.count()
    filler_counts.append(counted)
}

func remember_a_class(model: Model.ClassModel) {
    var functions = model.declared_functions.count()
    function_counts.append(functions)
    var attributes = model.declared_attributes.count()
    attribute_counts.append(attributes)
    var enum_count = model.enums.count()
    enum_counts.append(enum_count)
    var union_count = model.unions.count()
    union_counts.append(union_count)
    var shape_count = model.shapes.count()
    class_shape_counts.append(shape_count)
}

func put_back() {
    program.order.truncate(class_count)
    program.classes = classes
    program.shapes = shapes
    put_back_the_members()
    put_back_the_fillers()
    put_back_the_classes()
}

func put_back_the_members() {
    var index = 0
    while index < shape_keys.count() {
        var key = shape_keys[index]
        var shape = program.shapes[key]
        var kept = shape_member_counts[index]
        crash shape
        crash kept
        shape.members.truncate(kept)
        index = index + 1
    }
}

func put_back_the_fillers() {
    var now = program.shape_fillers.keys()
    var key_index = 0
    while key_index < now.count() {
        var key = now[key_index]
        if not filled_shape_keys.contains(key) {
            program.shape_fillers.remove_at(key)
        }
        key_index = key_index + 1
    }
    var index = 0
    while index < filled_shape_keys.count() {
        var key = filled_shape_keys[index]
        var fillers = program.fillers_of(key)
        var kept = filler_counts[index]
        crash kept
        fillers.truncate(kept)
        index = index + 1
    }
}

func put_back_the_classes() {
    var index = 0
    while index < class_count {
        var model = program.order[index]
        var functions = function_counts[index]
        var attributes = attribute_counts[index]
        var enum_count = enum_counts[index]
        var union_count = union_counts[index]
        var shape_count = class_shape_counts[index]
        crash model
        crash functions
        crash attributes
        crash enum_count
        crash union_count
        crash shape_count
        model.declared_functions.truncate(functions)
        model.declared_attributes.truncate(attributes)
        model.enums.truncate(enum_count)
        model.unions.truncate(union_count)
        model.shapes.truncate(shape_count)
        index = index + 1
    }
}

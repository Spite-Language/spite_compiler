var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func check(context: Context, written: List<AbstractSyntaxTree.Shapes.Statements.Statement>, index: Integer) {
    var statement = written[index]
    crash statement
    var library = Validators.LibraryFile()
    var path = context.path()
    assert not library.holds(path)
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        check_an_assignment(context, written, index, statement)
    }
}

func check_an_assignment(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
) {
    var target = statement.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_replaced_item(context, written, index, statement, target.name)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_member_write(context, written, index, statement, target)
    }
}

func declaration_of(
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    name: String,
): Integer {
    var at = index - 1
    while at >= 0 {
        var earlier = written[at]
        if declares(earlier, name) {
            return at
        }
        at = at - 1
    }
    return -1
}

func declares(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == name
    }
    return false
}

func walk_of(
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    starting_at: Integer,
    ending_at: Integer,
): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var at = starting_at
    var last = ending_at
    if last > written.count() {
        last = written.count()
    }
    while at < last {
        var statement = written[at]
        crash statement
        walk.read_statement(statement)
        at = at + 1
    }
    return walk
}

func names_it(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_the_name(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func check_a_replaced_item(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
) {
    var declared_at = declaration_of(written, index, name)
    assert declared_at >= 0
    var declaration = written[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_an_item_local(context, written, index, declared_at, statement, declaration)
    }
}

func check_an_item_local(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    declaration: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    var read = declaration.value
    if read == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        check_a_listed_item(context, written, index, declared_at, statement, read)
    }
}

func check_a_listed_item(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    assert is_a_list_or_a_dictionary(context, read.target)
    var target = statement.target
    var name = ""
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = target.name
    }
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    var between = walk_of(written, declared_at + 1, index)
    assert not assigns_it(between, name)
    crash read.target
    crash statement.value
    var item_printer = Printers.Spite.ExpressionPrinter(read)
    var item = item_printer.text()
    var list_printer = Printers.Spite.ExpressionPrinter(read.target)
    var list_text = list_printer.text()
    var value_printer = Printers.Spite.ExpressionPrinter(statement.value)
    var value_text = value_printer.text()
    context.line = statement.line
    typing.refuse_replaced_item(context, name, item, list_text, value_text)
}

func assigns_it(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_an_assignment_to(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_an_assignment_to(statement: AbstractSyntaxTree.Shapes.Statements.Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.target, name)
    }
    return false
}

func is_a_list_or_a_dictionary(context: Context, listed: AbstractSyntaxTree.Shapes.Expressions.Expression?): Boolean {
    if listed == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var listed_type = type_of_a_name(context, listed.name)
        if listed_type {
            var shown = context.shown(listed_type)
            return shown.starts_with("List<") or shown.starts_with("Dictionary<")
        }
    }
    return false
}

func type_of_a_name(context: Context, name: String): Model.Type? {
    var internal_name = context.scope.internal_name_of(name)
    if internal_name {
        return context.scope.types[internal_name]
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func check_a_member_write(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var holder = member.target
    if holder == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_held_write(context, written, index, statement, member, holder.name)
    }
}

func check_a_held_write(
    context: Context,
    written: List<AbstractSyntaxTree.Shapes.Statements.Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
) {
    var declared_at = declaration_of(written, index, name)
    assert declared_at >= 0
    var declaration = written[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        assert is_made_new(context, declaration.value, 0)
    }
    var internal_name = context.scope.internal_name_of(name)
    assert internal_name
    var held_type = context.scope.types[internal_name]
    assert held_type
    assert held_type.kind == 'object' and not held_type.is_nullable and context.has_a_class(held_type)
    var model = context.class_of(held_type)
    var library = Validators.LibraryFile()
    assert not library.holds(model.file.path)
    assert not model.function_named("drop")
    assert not model.function_named("set_{member.name}")
    var attribute = model.attribute_named(member.name)
    assert attribute
    assert attribute.attribute_type.kind != 'handle'
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    var between = walk_of(written, declared_at + 1, index)
    between.read_expression(statement.value)
    assert not lets_it_go(between, name)
    context.line = statement.line
    var article = typing.article_of(model.shown)
    typing.refuse_lost_write(context, name, member.name, article, model.shown)
}

func lets_it_go(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var named = 0
    var reached = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            named = named + 1
        }
        if reads_through(found.expression, name) {
            reached = reached + 1
        }
        if calls_through(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return named != reached
}

func reads_through(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_the_name(expression.target, name)
    }
    return false
}

func calls_through(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return reads_through(expression.callee, name)
    }
    return false
}

func is_made_new(context: Context, value: AbstractSyntaxTree.Shapes.Expressions.Expression?, depth: Integer): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return is_a_new_call(context, value, depth)
    }
    return false
}

func is_a_new_call(
    context: Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    depth: Integer,
): Boolean {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.name == "copy" or callee.name == "deep_copy"
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return is_a_new_own_call(context, callee.name, depth)
    }
    return false
}

func is_a_new_own_call(context: Context, called: String, depth: Integer): Boolean {
    var function = context.current_class.function_named(called)
    if not function {
        var initial = called.slice(0, 1)
        return initial != initial.lower_case()
    }
    if depth >= 4 {
        return false
    }
    if not function.declaration {
        return false
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return false
    }
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    return every_return_is_new(context, walk, depth)
}

func every_return_is_new(context: Context, walk: AbstractSyntaxTree.Walk.Walk, depth: Integer): Boolean {
    var returns = 0
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            returns = returns + 1
            if not is_made_new(context, statement.value, depth + 1) {
                return false
            }
        }
        index = index + 1
    }
    return returns > 0
}

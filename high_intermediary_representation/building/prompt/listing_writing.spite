var state = SourceState()

func ListingWriting(starting_state: SourceState) {
    state = starting_state
}

func enum_lines(): String {
    var found = List<String>()
    var index = 0
    while index < state.described_classes.count() {
        var model = state.described_classes[index]
        var enum_index = 0
        while enum_index < model.enums.count() {
            var enumeration = model.enums[enum_index]
            var quoted = List<String>()
            var value_index = 0
            while value_index < enumeration.values.count() {
                var value = enumeration.values[value_index]
                quoted.append("'{value}'")
                value_index = value_index + 1
            }
            var joined = quoted.join(", ")
            found.append("{model.shown}.{enumeration.name}: {joined}")
            enum_index = enum_index + 1
        }
        index = index + 1
    }
    return found.join("\n")
}

func write_the_class_list() {
    var emitting = Emitting(state)
    var binding_writing = BindingWriting(state)
    var naming = Naming()
    emitting.out(0, "func list_the_classes() \{")
    emitting.out(1, "var listed = List<String>()")
    var index = 0
    while index < state.singletons.count() {
        var singleton_class = state.singletons[index]
        var lists = binding_writing.argument_lists_of(singleton_class)
        var list_index = 0
        while list_index < lists.count() {
            var arguments = lists[list_index]
            var made = binding_writing.made_function_of(singleton_class, arguments)
            var called = binding_writing.called_of(singleton_class, arguments)
            var quoted = naming.escaped(called)
            emitting.out(1, "var held_{made} = {made}()")
            emitting.out(1, "if held_{made} \{")
            emitting.out(2, "listed.append(\"{quoted}\")")
            emitting.out(1, "} else \{")
            emitting.out(2, "listed.append(\"{quoted} not made yet\")")
            emitting.out(1, "}")
            list_index = list_index + 1
        }
        index = index + 1
    }
    var class_index = 0
    while class_index < state.listed_classes.count() {
        var listed = state.listed_classes[class_index]
        var quoted_class = naming.escaped(listed.shown)
        emitting.out(1, "listed.append(\"{quoted_class}\")")
        class_index = class_index + 1
    }
    emitting.out(1, "var joined = listed.join(\"\\n\")")
    emitting.out(1, "prompt.say(joined)")
    emitting.out(0, "}")
    emitting.blank()
}

func write_a_description(model: Model.ClassModel) {
    var type_kinds = Type.Kinds(state)
    var type_calls = Type.Calls(state)
    var naming = Naming()
    var emitting = Emitting(state)
    var described = List<String>()
    if model.is_singleton {
        described.append("{model.shown}, a singleton")
    } else {
        described.append(model.shown)
    }
    described.append("attributes:")
    var own_type = model.type_of_an_instance()
    var attributes = type_kinds.attributes_of(own_type)
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var shown = type_kinds.shown_of(attribute.attribute_type)
        described.append("{attribute.name}: {shown}")
        index = index + 1
    }
    if attributes.is_empty() {
        described.append("none")
    }
    described.append("functions:")
    var calls = type_calls.declared_calls_of(model)
    var call_index = 0
    while call_index < calls.count() {
        var call = calls[call_index]
        var signature = type_calls.signature_of(call)
        described.append(signature)
        call_index = call_index + 1
    }
    if calls.is_empty() {
        described.append("none")
    }
    var text = described.join("\n")
    var written = naming.escaped(text)
    var qualified = naming.escaped(model.shown)
    var short_name = naming.short_of(model.shown)
    var short = naming.escaped(short_name)
    emitting.out(1, "prompt.describes(\"{qualified}\", \"{short}\", \"{written}\")")
}

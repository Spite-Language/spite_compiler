var state = SourceState()

func Kinds(starting_state: SourceState) {
    state = starting_state
}

func kind_of(described: Model.Type): String {
    switch described.kind {
        'enumeration': return "enum"
        'union': return "union"
        'scalar': return scalar_kind_of(described)
        'object': return object_kind_of(described)
        'nothing': return "opaque"
        'function': return "opaque"
        'shape': return "opaque"
        'handle': return "opaque"
        'namespace': return "opaque"
        'parameters': return "opaque"
        'pattern': return "opaque"
    }
}

func scalar_kind_of(described: Model.Type): String {
    if described.is_a_walked_name {
        return "opaque"
    }
    return "scalar"
}

func object_kind_of(described: Model.Type): String {
    if described.name == "String" {
        return "text"
    }
    var model = state.context.program.class_named(described.name)
    if not model {
        return "opaque"
    }
    var is_a_list = model.shown.starts_with("List<") and model.bound_types.contains("$element_type")
    if is_a_list {
        return "list"
    }
    var is_a_dictionary = model.shown.starts_with("Dictionary<") and model.bound_types.contains("$value_type")
    if is_a_dictionary {
        return "dictionary"
    }
    if model.key.starts_with("Spite.") {
        return "library"
    }
    return "object"
}

func class_model_of(described: Model.Type): Model.ClassModel {
    var model = state.context.program.class_named(described.name)
    crash model
    return model
}

func written_of(described: Model.Type): String {
    var written = present_written_of(described)
    if described.is_nullable {
        return "{written}?"
    }
    return written
}

func present_written_of(described: Model.Type): String {
    switch described.kind {
        'enumeration': return nested_written_of(described)
        'union': return nested_written_of(described)
        'object': return object_written_of(described)
        'nothing': return described.name
        'scalar': return described.name
        'function': return described.name
        'shape': return described.name
        'handle': return described.name
        'namespace': return described.name
        'parameters': return described.name
        'pattern': return described.name
    }
}

func object_written_of(described: Model.Type): String {
    var model = state.context.program.class_named(described.name)
    if model {
        return model.shown
    }
    return described.name
}

func nested_written_of(described: Model.Type): String {
    var parts = described.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.context.program.class_named(owner_key)
    crash owner
    return "{owner.shown}.{simple}"
}

func shown_of(described: Model.Type): String {
    var naming = Naming()
    if kind_of(described) == "opaque" {
        return state.context.shown(described)
    }
    var written = written_of(described)
    return naming.short_of(written)
}

func is_writable(described: Model.Type): Boolean {
    fallback not described.is_nullable
    var kind = kind_of(described)
    if kind == "text" or kind == "enum" {
        return true
    }
    return kind == "scalar" and state.writable_scalars.contains(described.name)
}

func reader_of(described: Model.Type): String {
    var index = state.writable_scalars.index_of(described.name)
    crash index
    var reader = state.readers[index]
    crash reader
    return reader
}

func literal_kind_of(described: Model.Type): String {
    var kind = kind_of(described)
    if kind == "enum" {
        return "enum"
    }
    if kind == "text" {
        return "String"
    }
    return described.name
}

func element_of(described: Model.Type): Model.Type {
    var model = class_model_of(described)
    var element = model.bound_types["$element_type"]
    crash element
    return element
}

func key_of(described: Model.Type): Model.Type {
    var model = class_model_of(described)
    var key = model.bound_types["$key_type"]
    crash key
    return key
}

func held_of(described: Model.Type): Model.Type {
    var model = class_model_of(described)
    var held = model.bound_types["$value_type"]
    crash held
    return held
}

func members_of(described: Model.Type): List<Model.Type> {
    var parts = described.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var declared_union = owner.union_named(simple)
    crash declared_union
    return declared_union.members
}

func values_of(described: Model.Type): List<String> {
    var parts = described.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = state.context.program.class_named(owner_key)
    crash owner
    var enumeration = owner.enum_named(simple)
    crash enumeration
    return enumeration.values
}

func attributes_of(described: Model.Type): List<Model.AttributeModel> {
    var model = class_model_of(described)
    var shown = List<Model.AttributeModel>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            shown.append(attribute)
        }
        index = index + 1
    }
    return shown
}

var state = SourceState()

func Table(starting_state: SourceState) {
    state = starting_state
}

func number_of(described: Model.Type): Integer {
    note_a_type(described)
    var present = described.present()
    return known_number(present)
}

func note_a_type(described: Model.Type) {
    var present = described.present()
    fallback known_number(present) == 0
    state.types.append(present)
    reach(present)
}

func known_number(present: Model.Type): Integer {
    var index = 0
    while index < state.types.count() {
        var known = state.types[index]
        if known.kind == present.kind and known.name == present.name {
            return index + 1
        }
        index = index + 1
    }
    return 0
}

func reach(described: Model.Type) {
    var type_kinds = Kinds(state)
    var kind = type_kinds.kind_of(described)
    if kind == "object" {
        reach_an_object(described)
    } else if kind == "list" {
        reach_calls(described)
        var element = type_kinds.element_of(described)
        note_a_type(element)
    } else if kind == "dictionary" {
        var key = type_kinds.key_of(described)
        note_a_type(key)
        var held = type_kinds.held_of(described)
        note_a_type(held)
        reach_calls(described)
    } else if kind == "union" {
        var members = type_kinds.members_of(described)
        members.each(number_a_member)
    } else if kind == "text" {
        reach_calls(described)
    }
}

func number_a_member(member: Model.Type) {
    note_a_type(member)
}

func reach_an_object(described: Model.Type) {
    var type_kinds = Kinds(state)
    var attributes = type_kinds.attributes_of(described)
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        note_a_type(attribute.attribute_type)
        index = index + 1
    }
    reach_calls(described)
}

func reach_calls(described: Model.Type) {
    var type_calls = Calls(state)
    var calls = type_calls.calls_of(described)
    var index = 0
    while index < calls.count() {
        var call = calls[index]
        if type_calls.is_callable(call) {
            reach_a_call(call)
        }
        index = index + 1
    }
}

func reach_a_call(call: Call) {
    if call.answer {
        note_a_type(call.answer)
    }
    call.parameter_types.each(number_a_member)
}

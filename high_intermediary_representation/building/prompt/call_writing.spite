var state = SourceState()

func CallWriting(starting_state: SourceState) {
    state = starting_state
}

func write_calls(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var type_calls = Type.Calls(state)
    var emitting = Emitting(state)
    var written = type_kinds.written_of(described)
    var calls = type_calls.calls_of(described)
    var cases = List<String>()
    var statements = List<String>()
    var index = 0
    while index < calls.count() {
        var call = calls[index]
        if not cases.contains(call.name) {
            cases.append(call.name)
            statements.append("call_{number}_{index}(value, at)")
        }
        index = index + 1
    }
    if type_kinds.kind_of(described) == "object" {
        var attributes = type_kinds.attributes_of(described)
        var attribute_index = 0
        while attribute_index < attributes.count() {
            var attribute = attributes[attribute_index]
            if not cases.contains(attribute.name) {
                cases.append(attribute.name)
                statements.append("prompt.not_callable(at)")
            }
            attribute_index = attribute_index + 1
        }
    }
    emitting.out(0, "func call_{number}(value: {written}, at: Integer) \{")
    emitting.out(1, "var name = prompt.step_name(at)")
    emitting.write_switch(1, "name", cases, statements, "prompt.no_function(at)")
    emitting.out(0, "}")
    emitting.blank()
    var call_index = 0
    while call_index < calls.count() {
        var each = calls[call_index]
        write_a_call(number, described, call_index, each)
        call_index = call_index + 1
    }
}

func write_a_call(number: Integer, described: Model.Type, index: Integer, call: Call) {
    var type_kinds = Type.Kinds(state)
    var emitting = Emitting(state)
    var type_calls = Type.Calls(state)
    var naming = Naming()
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    emitting.out(0, "func call_{number}_{index}(value: {written}, at: Integer) \{")
    if not type_calls.is_callable(call) {
        emitting.out(1, "prompt.cannot_take(at)")
        emitting.out(0, "}")
        emitting.blank()
        return
    }
    var count = call.parameter_types.count()
    emitting.out(1, "fallback prompt.takes(at, {count})")
    var check_index = 0
    while check_index < count {
        var checked_name = call.parameter_names[check_index]
        var checked_type = call.parameter_types[check_index]
        crash checked_name
        var literal_kind = type_kinds.literal_kind_of(checked_type)
        var checked_shown = type_kinds.shown_of(checked_type)
        var quoted_checked = naming.escaped(checked_shown)
        emitting.out(
            1,
            "fallback prompt.argument_fits(at, {check_index}, \"{checked_name}\", \"{literal_kind}\", \"{quoted_checked}\")",
        )
        check_index = check_index + 1
    }
    var arguments = List<String>()
    var argument_index = 0
    while argument_index < count {
        var argument_type = call.parameter_types[argument_index]
        write_an_argument(argument_index, argument_type)
        arguments.append("argument_{argument_index}")
        argument_index = argument_index + 1
    }
    var passed = arguments.join(", ")
    if call.answers_the_keys {
        write_the_keys()
    } else if call.answer {
        emitting.out(1, "var answered = value.{call.function_name}({passed})")
        var walked = type_writing.walk_of(call.answer, "answered")
        emitting.out(1, walked)
    } else {
        emitting.out(1, "value.{call.function_name}({passed})")
        emitting.out(1, "prompt.answered_nothing(at)")
    }
    emitting.out(0, "}")
    emitting.blank()
}

func write_an_argument(index: Integer, argument_type: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var emitting = Emitting(state)
    var type_table = Type.Table(state)
    var kind = type_kinds.kind_of(argument_type)
    emitting.out(1, "var literal_{index} = prompt.argument_text(at, {index})")
    if kind == "text" {
        emitting.out(1, "var argument_{index} = prompt.text_of(literal_{index})")
        return
    }
    if kind == "enum" {
        var enum_number = type_table.number_of(argument_type)
        emitting.out(1, "var written_{index} = prompt.symbol_of(literal_{index})")
        emitting.out(1, "if not is_value_{enum_number}(written_{index}) \{")
        emitting.out(2, "prompt.cannot_take(at)")
        emitting.out(2, "return")
        emitting.out(1, "}")
        emitting.out(1, "var argument_{index} = value_{enum_number}(written_{index})")
        return
    }
    var reader = type_kinds.reader_of(argument_type)
    emitting.out(1, "var argument_{index} = prompt.{reader}(literal_{index})")
}

func write_the_keys() {
    var emitting = Emitting(state)
    emitting.out(1, "var keys = value.keys()")
    emitting.out(1, "if keys.is_empty() \{")
    emitting.out(2, "prompt.no_keys(at)")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "var key_lines = List<String>()")
    emitting.out(1, "var key_index = 0")
    emitting.out(1, "while key_index < keys.count() \{")
    emitting.out(2, "var each_key = keys[key_index]")
    emitting.out(2, "crash each_key")
    emitting.out(2, "var key_text = each_key.to_string()")
    emitting.out(2, "key_lines.append(key_text)")
    emitting.out(2, "key_index = key_index + 1")
    emitting.out(1, "}")
    emitting.out(1, "var joined = key_lines.join(\"\\n\")")
    emitting.out(1, "prompt.say(joined)")
}

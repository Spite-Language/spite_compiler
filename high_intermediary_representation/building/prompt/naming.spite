var _lowercase_z_code = 122

func escaped(text: String): String {
    var slashed = text.replace("\\", "\\\\")
    var quoted = slashed.replace("\"", "\\\"")
    var braced = quoted.replace("\{", "\\\{")
    return braced.replace("\n", "\\n")
}

func short_of(shown: String): String {
    var kept = ""
    var word = ""
    var index = 0
    while index < shown.length() {
        var character = shown[index]
        crash character
        var code = shown.byte_at(index)
        var is_lower = code >= 97 and code <= _lowercase_z_code
        var is_upper = code >= 65 and code <= 90
        var is_digit = code >= 48 and code <= 57
        var is_a_letter = is_lower or is_upper or is_digit or code == 95
        if is_a_letter {
            word = "{word}{character}"
        } else if character == "." {
            word = ""
        } else {
            kept = "{kept}{word}{character}"
            word = ""
        }
        index = index + character.length()
    }
    return "{kept}{word}"
}

func plain_short_of(shown: String): String {
    var short = short_of(shown)
    var opening = short.index_of("<")
    if opening {
        var sliced = short.slice(0, opening)
        crash sliced
        return sliced
    }
    return short
}

var state = SourceState()

func RunWriting(starting_state: SourceState) {
    state = starting_state
}

func write_run(entry: Model.ClassModel) {
    var emitting = Emitting(state)
    var listing_writing = ListingWriting(state)
    var naming = Naming()
    var hot_reload = state.context.build_flags["hot_reload"] == "true"
    emitting.out(0, "func prepare() \{")
    emitting.out(1, "if prepared \{")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "prepared = true")
    var enum_text = listing_writing.enum_lines()
    var enum_written = naming.escaped(enum_text)
    emitting.out(1, "prompt.enum_lines = \"{enum_written}\"")
    state.described_classes.each(listing_writing.write_a_description)
    emitting.out(0, "}")
    emitting.blank()
    emitting.out(0, "func run(program: {entry.shown}) \{")
    emitting.out(1, "prepare()")
    if hot_reload {
        emitting.out(1, "var breakpoint = Spite.Breakpoint()")
        emitting.out(1, "breakpoint.hold(stop_here)")
        emitting.out(1, "held_program = program")
    }
    emitting.out(1, "while prompt.reads() \{")
    emitting.out(2, "answer(program)")
    emitting.out(2, "prompt.deliver()")
    emitting.out(1, "}")
    if hot_reload {
        emitting.out(1, "breakpoint.let_go()")
        emitting.out(1, "held_program = null")
    }
    emitting.out(1, "prompt.finish()")
    emitting.out(0, "}")
    emitting.blank()
    if emitting.reads_remotely() {
        write_the_remote_loop(entry)
    }
    if hot_reload and emitting.reads_remotely() {
        write_the_turn_at_a_stop()
        emitting.out(1, "prompt.stop_at(site, locals)")
        emitting.out(1, "if prompt.says_it_stopped() \{")
        emitting.out(2, "prompt.say_the_stop()")
        emitting.out(2, "prompt.send_the_answer(true)")
        emitting.out(1, "}")
        emitting.out(1, "while prompt.stays_stopped() and not prompt.exits \{")
        emitting.out(2, "if _on_the_main_thread() \{")
        emitting.out(3, "reloader.check_point()")
        emitting.out(2, "}")
        emitting.out(2, "serve_waiting(program)")
        emitting.out(1, "}")
        emitting.out(1, "prompt.go_on()")
        emitting.out(1, "_release_the_stop()")
        emitting.out(1, "if prompt.exits \{")
        emitting.out(2, "prompt.end_the_program()")
        emitting.out(1, "}")
        emitting.out(0, "}")
        emitting.blank()
    } else if hot_reload {
        write_the_turn_at_a_stop()
        emitting.out(1, "prompt.stop_at(site, locals)")
        emitting.out(1, "prompt.tell_the_stop()")
        emitting.out(1, "var goes_on = true")
        emitting.out(1, "while prompt.stays_stopped() and goes_on \{")
        emitting.out(2, "if _on_the_main_thread() \{")
        emitting.out(3, "reloader.check_point()")
        emitting.out(2, "}")
        emitting.out(2, "goes_on = prompt.reads()")
        emitting.out(2, "if goes_on \{")
        emitting.out(3, "answer(program)")
        emitting.out(3, "prompt.deliver()")
        emitting.out(2, "}")
        emitting.out(1, "}")
        emitting.out(1, "prompt.go_on()")
        emitting.out(1, "_release_the_stop()")
        emitting.out(1, "if not goes_on \{")
        emitting.out(2, "prompt.end_the_program()")
        emitting.out(1, "}")
        emitting.out(0, "}")
        emitting.blank()
    }
    if hot_reload {
        emitting.out(0, "func stop_here(site: String, locals: List<String>) \{")
        emitting.out(1, "var program = held_program")
        emitting.out(1, "crash program")
        emitting.out(1, "pause_at(site, locals, program)")
        emitting.out(0, "}")
        emitting.blank()
    }
    emitting.out(0, "func answer(program: {entry.shown}) \{")
    if hot_reload {
        emitting.out(1, "if prompt.sets_breakpoints() \{")
        emitting.out(2, "var placed = reloader.answer_breakpoints(prompt.break_word, prompt.break_text)")
        emitting.out(2, "prompt.say_the_reload(placed, reloader.succeeded)")
        emitting.out(2, "return")
        emitting.out(1, "}")
        emitting.out(1, "if prompt.reloads() \{")
        emitting.out(2, "var told = reloader.answer_reload(prompt.reload_word)")
        emitting.out(2, "prompt.say_the_reload(told, reloader.succeeded)")
        emitting.out(2, "return")
        emitting.out(1, "}")
        emitting.out(1, "if prompt.runs_code() \{")
        emitting.out(2, "var compiled = reloader.run_code(prompt.code_word, prompt.code_text)")
        emitting.out(2, "if not reloader.succeeded \{")
        emitting.out(3, "prompt.complain(compiled)")
        emitting.out(3, "return")
        emitting.out(2, "}")
        emitting.out(2, "var code = Spite.PromptCode()")
        emitting.out(2, "var shown = code.answer(program)")
        emitting.out(2, "prompt.say_the_code(shown)")
        emitting.out(2, "return")
        emitting.out(1, "}")
    }
    emitting.out(1, "if prompt.lists_classes() \{")
    emitting.out(2, "list_the_classes()")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "if prompt.counts_memory() \{")
    emitting.out(2, "var running = Program()")
    emitting.out(2, "var live = running.live_allocations()")
    emitting.out(2, "var held = running.live_bytes()")
    emitting.out(2, "prompt.say_the_memory(live, held)")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "if prompt.fetches() \{")
    emitting.out(2, "prompt.start_fetching()")
    emitting.out(2, "walk_1(program, 0)")
    emitting.out(1, "}")
    if hot_reload {
        emitting.out(1, "if prompt.constructs() \{")
        emitting.out(2, "var made = reloader.run_code(prompt.code_word, prompt.code_text)")
        emitting.out(2, "if not reloader.succeeded \{")
        emitting.out(3, "prompt.complain(made)")
        emitting.out(3, "return")
        emitting.out(2, "}")
        emitting.out(2, "var making = Spite.PromptCode()")
        emitting.out(2, "var made_text = making.answer(program)")
        emitting.out(2, "crash made_text.is_empty()")
        emitting.out(2, "prompt.start_showing_the_target()")
        emitting.out(2, "walk_1(program, 0)")
        emitting.out(2, "return")
        emitting.out(1, "}")
    }
    emitting.out(1, "if prompt.walks() and prompt.fetching_went_well() \{")
    emitting.out(2, "prompt.start_walking()")
    emitting.out(2, "walk_1(program, 0)")
    emitting.out(1, "}")
    emitting.out(0, "}")
    emitting.blank()
}

# ../../../../spite_spec/specs/repl.md#command-language
func write_the_turn_at_a_stop() {
    var emitting = Emitting(state)
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    emitting.declare("_claim_the_stop", "func _claim_the_stop(): Boolean", "claim")
    emitting.declare("_release_the_stop", "func _release_the_stop()", "release")
    emitting.declare("_stop_held_here", "func _stop_held_here(): Boolean", "held_here")
    emitting.declare("_stop_held_elsewhere", "func _stop_held_elsewhere(): Boolean", "held_elsewhere")
    emitting.declare("_on_the_main_thread", "func _on_the_main_thread(): Boolean", "on_main")
    emitting.out(0, "func pause_at(site: String, locals: List<String>, program: {entry.shown}) \{")
    emitting.out(1, "if _stop_held_here() \{")
    emitting.out(2, "prompt.passes_a_second_stop(site)")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "var waiting = Program()")
    emitting.out(1, "var pause = Duration(1, 'milliseconds')")
    emitting.out(1, "while not _claim_the_stop() \{")
    emitting.out(2, "waiting.sleep(pause)")
    emitting.out(1, "}")
}

# ../../../../spite_spec/specs/repl.md#--repl-portport
func write_the_remote_loop(entry: Model.ClassModel) {
    var emitting = Emitting(state)
    emitting.out(0, "func listen() \{")
    emitting.out(1, "prepare()")
    emitting.out(1, "prompt.listen({state.port})")
    emitting.out(1, "_watch(prompt.watched_handle())")
    emitting.out(0, "}")
    emitting.blank()
    emitting.declare("_watch", "func _watch(handle: Long)", "watch")
    emitting.declare("_raise", "func _raise()", "raise")
    var hot_reload = state.context.build_flags["hot_reload"] == "true"
    emitting.out(0, "func check_point(program: {entry.shown}) \{")
    if hot_reload {
        emitting.out(1, "if _stop_held_elsewhere() \{")
        emitting.out(2, "return")
        emitting.out(1, "}")
    }
    if hot_reload {
        emitting.out(1, "var breakpoint = Spite.Breakpoint()")
        emitting.out(1, "breakpoint.hold(stop_here)")
        emitting.out(1, "held_program = program")
    }
    emitting.out(1, "if prompt.exits \{")
    emitting.out(2, "prompt.end_the_program()")
    emitting.out(1, "}")
    emitting.out(1, "var keeps_going = true")
    emitting.out(1, "while keeps_going \{")
    emitting.out(2, "var served = serve_one(program)")
    emitting.out(2, "keeps_going = served and not prompt.exits")
    emitting.out(1, "}")
    emitting.out(1, "_watch(prompt.watched_handle())")
    emitting.out(1, "if prompt.exits \{")
    emitting.out(2, "_raise()")
    emitting.out(1, "}")
    emitting.out(0, "}")
    emitting.blank()
    emitting.out(0, "func serve_one(program: {entry.shown}): Boolean \{")
    emitting.out(1, "var line = prompt.next_line(false)")
    emitting.out(1, "if line \{")
    emitting.out(2, "serve_line(line, program)")
    emitting.out(2, "return true")
    emitting.out(1, "}")
    emitting.out(1, "return false")
    emitting.out(0, "}")
    emitting.blank()
    emitting.out(0, "func serve(program: {entry.shown}) \{")
    emitting.out(1, "prepare()")
    if hot_reload {
        emitting.out(1, "var breakpoint = Spite.Breakpoint()")
        emitting.out(1, "breakpoint.hold(stop_here)")
        emitting.out(1, "held_program = program")
    }
    emitting.out(1, "while not prompt.exits \{")
    emitting.out(2, "serve_waiting(program)")
    emitting.out(1, "}")
    emitting.out(1, "prompt.end_the_program()")
    emitting.out(0, "}")
    emitting.blank()
    emitting.out(0, "func serve_waiting(program: {entry.shown}) \{")
    emitting.out(1, "var line = prompt.next_line(true)")
    emitting.out(1, "if line \{")
    emitting.out(2, "serve_line(line, program)")
    emitting.out(1, "}")
    emitting.out(0, "}")
    emitting.blank()
    emitting.out(0, "func serve_line(line: String, program: {entry.shown}) \{")
    emitting.out(1, "var goes_on = prompt.hears(line)")
    emitting.out(1, "if goes_on \{")
    emitting.out(2, "answer(program)")
    emitting.out(1, "}")
    emitting.out(1, "prompt.send_the_answer(goes_on)")
    emitting.out(0, "}")
    emitting.blank()
}

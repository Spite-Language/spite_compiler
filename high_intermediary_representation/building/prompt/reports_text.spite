var lines = List<String>()

func written(): String {
    add_not_made_yet()
    add_given_arguments()
    add_no_instance()
    add_waits_at_a_breakpoint()
    add_say_or()
    add_help()
    add_describe()
    add_bytes()
    add_copied_hex()
    add_hexadecimal_value()
    return lines.join("\n")
}

func add_not_made_yet() {
    lines.append("")
    lines.append("func not_made_yet(called: String) \{")
    lines.append(
        "    complain(\"\{called} has not been made yet: nothing in the program has asked for it, and the prompt never makes one\")",
    )
    lines.append("}")
}

func add_given_arguments() {
    lines.append("")
    lines.append("func given_arguments(at: Integer): String \{")
    lines.append("    return walking.arguments_text(at)")
    lines.append("}")
}

func add_no_instance() {
    lines.append("")
    lines.append("func no_instance(at: Integer, class_name: String, instances: String) \{")
    lines.append("    var given = walking.arguments_text(at)")
    lines.append(
        "    complain(\"the program holds no \{class_name}(\{given}): a singleton made with arguments has one instance for each argument list the program asks for, \{instances}\")",
    )
    lines.append("}")
}

func add_waits_at_a_breakpoint() {
    lines.append("")
    lines.append("func _waits_at_a_breakpoint(word: String): Boolean \{")
    lines.append("    return word == \"where\" or word == \"locals\" or word == \"continue\"")
    lines.append("}")
}

func add_say_or() {
    lines.append("")
    lines.append("func _say_or(text: String, otherwise: String) \{")
    lines.append("    if text.is_empty() \{")
    lines.append("        _said(otherwise)")
    lines.append("    } else \{")
    lines.append("        _said(text)")
    lines.append("    }")
    lines.append("}")
}

func add_help() {
    lines.append("")
    lines.append("func _help() \{")
    lines.append("    _said(\"a path shows a value: program, player.health, monsters[0].name, World().tick\")")
    lines.append("    _said(\"a call runs a function with literal arguments: monsters.count(), player.heal(5)\")")
    lines.append(
        "    _said(\"an assignment writes a literal, null or a path: turn = 7, nickname = null, follower = leader\")",
    )
    lines.append(
        "    _said(\"attributes [path], functions [path], describe <Class>, classes, enums, bytes <path>, bytes <address> <count>, memory, help, exit\")",
    )
    lines.append("}")
}

func add_describe() {
    lines.append("")
    lines.append("func _describe(name: String) \{")
    lines.append("    if name.is_empty() \{")
    lines.append("        complain(\"describe names a class, such as 'describe Monster': 'classes' lists them\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var found = -1")
    lines.append("    var shared = List<String>()")
    lines.append("    var index = 0")
    lines.append("    while index < described_names.count() \{")
    lines.append("        var qualified = described_names[index]")
    lines.append("        var short = described_short_names[index]")
    lines.append("        crash qualified")
    lines.append("        crash short")
    lines.append("        if qualified == name \{")
    lines.append("            found = index")
    lines.append("            shared = List<String>()")
    lines.append("            index = described_names.count()")
    lines.append("        } else \{")
    lines.append("            if short == name \{")
    lines.append("                found = index")
    lines.append("                shared.append(qualified)")
    lines.append("            }")
    lines.append("            index = index + 1")
    lines.append("        }")
    lines.append("    }")
    lines.append("    if found < 0 \{")
    lines.append("        complain(\"no class '\{name}' in the program: 'classes' lists them\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if shared.count() > 1 \{")
    lines.append("        var joined = shared.join(\", \")")
    lines.append("        complain(\"'\{name}' names more than one class: \{joined}; describe one by its whole name\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var description = descriptions[found]")
    lines.append("    crash description")
    lines.append("    _said(description)")
    lines.append("}")
}

func add_bytes() {
    lines.append("")
    lines.append("func _bytes(rest: String) \{")
    lines.append("    var words = rest.split(\" \")")
    lines.append("    var first_word = words[0]")
    lines.append("    crash first_word")
    lines.append("    var is_an_address = first_word.starts_with(\"0x\")")
    lines.append("    if not is_an_address \{")
    lines.append("        mode = \"bytes\"")
    lines.append("        _read_the_path(rest)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var count_text = \"\"")
    lines.append("    if words.count() == 2 \{")
    lines.append("        var second = words[1]")
    lines.append("        crash second")
    lines.append("        count_text = second")
    lines.append("    }")
    lines.append("    var wanted: Integer? = count_text")
    lines.append("    var word_length = first_word.length()")
    lines.append("    var hexadecimal = first_word.slice(2, word_length)")
    lines.append("    crash hexadecimal")
    lines.append("    var address = _hexadecimal_value(hexadecimal)")
    lines.append("    var is_a_range = words.count() == 2 and wanted and address")
    lines.append("    if not is_a_range \{")
    lines.append(
        "        complain(\"'bytes' reads a range as 'bytes 0x1f2a40 64': an address in hexadecimal and a count of bytes\")",
    )
    lines.append("        return")
    lines.append("    }")
    lines.append("    crash wanted")
    lines.append("    crash address")
    lines.append("    if wanted < 1 or wanted > 4096 \{")
    lines.append(
        "        complain(\"'bytes' reads from 1 to 4096 bytes at a time, and \{count_text} is not in that range\")",
    )
    lines.append("        return")
    lines.append("    }")
    lines.append("    var copied = _copied_hex(address, wanted)")
    lines.append("    if copied \{")
    lines.append(
        "        _said(\"\\\{\\\"address\\\":\\\"\{first_word}\\\",\\\"bytes\\\":\{wanted},\\\"hex\\\":\\\"\{copied}\\\"}\")",
    )
    lines.append("    } else \{")
    lines.append("        complain(\"unreadable: \{first_word} for \{wanted} bytes\")")
    lines.append("    }")
    lines.append("}")
}

func add_copied_hex() {
    lines.append("")
    lines.append("func _copied_hex(address: Long, wanted: Integer): String? \{")
    lines.append("    var room = Buffer(wanted)")
    lines.append("    var process = kernel.GetCurrentProcess_as_long()")
    lines.append("    var no_count: Long = 0")
    lines.append("    var copied = kernel.ReadProcessMemory(process, address, room, wanted, no_count)")
    lines.append("    fallback copied != 0")
    lines.append("    room.take_written(wanted)")
    lines.append("    var digits = \"0123456789abcdef\"")
    lines.append("    var hex = \"\"")
    lines.append("    var index = 0")
    lines.append("    while index < wanted \{")
    lines.append("        var byte = room[index]")
    lines.append("        crash byte")
    lines.append("        var high = digits[byte / 16]")
    lines.append("        var low = digits[byte % 16]")
    lines.append("        crash high and low")
    lines.append("        hex = \"\{hex}\{high}\{low}\"")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return hex")
    lines.append("}")
}

func add_hexadecimal_value() {
    lines.append("")
    lines.append("func _hexadecimal_value(digits: String): Long? \{")
    lines.append("    fallback not digits.is_empty() and digits.length() <= 15")
    lines.append("    var value: Long = 0")
    lines.append("    var index = 0")
    lines.append("    while index < digits.length() \{")
    lines.append("        var code = digits.byte_at(index)")
    lines.append("        var digit = -1")
    lines.append("        if code >= 48 and code <= 57 \{")
    lines.append("            digit = code - 48")
    lines.append("        } else if code >= 97 and code <= 102 \{")
    lines.append("            digit = code - 87")
    lines.append("        } else if code >= 65 and code <= 70 \{")
    lines.append("            digit = code - 55")
    lines.append("        }")
    lines.append("        fallback digit >= 0")
    lines.append("        value = value * 16 + digit")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return value")
    lines.append("}")
}

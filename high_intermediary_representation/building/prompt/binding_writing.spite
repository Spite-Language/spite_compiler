var state = SourceState()

func BindingWriting(starting_state: SourceState) {
    state = starting_state
}

func argument_lists_of(singleton_class: Model.ClassModel): List<String> {
    var known = state.context.singleton_arguments[singleton_class.key]
    if known {
        return known
    }
    var only_one = List<String>()
    only_one.append("")
    return only_one
}

func made_function_of(singleton_class: Model.ClassModel, arguments: String): String {
    var type_kinds = Type.Kinds(state)
    var emitting = Emitting(state)
    var name = "made_{state.intrinsics.count()}"
    var singleton_type = singleton_class.type_of_an_instance()
    var written = type_kinds.written_of(singleton_type)
    var slot_key = singleton_class.key
    if not arguments.is_empty() {
        slot_key = "{singleton_class.key}({arguments})"
    }
    emitting.declare(name, "func {name}(): {written}?", "made\t{singleton_class.key}\t{slot_key}")
    return name
}

func called_of(singleton_class: Model.ClassModel, arguments: String): String {
    var written = singleton_class.shown.replace(" ", "")
    return "{written}({arguments})"
}

func write_bind() {
    var type_table = Type.Table(state)
    var naming = Naming()
    var emitting = Emitting(state)
    var cases = List<String>()
    var statements = List<String>()
    var index = 0
    while index < state.singletons.count() {
        var singleton_class = state.singletons[index]
        var singleton_type = singleton_class.type_of_an_instance()
        var number = type_table.number_of(singleton_type)
        var written = singleton_class.shown.replace(" ", "")
        cases.append(written)
        statements.append("bind_{number}(at)")
        var short_name = naming.short_of(singleton_class.shown)
        var short = short_name.replace(" ", "")
        var sharing = singletons_named(short)
        if short != written and sharing.count() == 1 {
            cases.append(short)
            statements.append("bind_{number}(at)")
        }
        if short != written and sharing.count() > 1 and not cases.contains(short) {
            var joined = sharing.join(", ")
            var shared = naming.escaped(joined)
            cases.append(short)
            statements.append("prompt.shared_singleton(at, \"{shared}\")")
        }
        index = index + 1
    }
    var class_index = 0
    while class_index < state.listed_classes.count() {
        var listed = state.listed_classes[class_index]
        var listed_written = listed.shown.replace(" ", "")
        cases.append(listed_written)
        statements.append("prompt.not_a_singleton(at)")
        var listed_short_name = naming.short_of(listed.shown)
        var listed_short = listed_short_name.replace(" ", "")
        if listed_short != listed_written and not cases.contains(listed_short) {
            cases.append(listed_short)
            statements.append("prompt.not_a_singleton(at)")
        }
        class_index = class_index + 1
    }
    emitting.out(0, "func bind(at: Integer) \{")
    emitting.out(1, "var name = prompt.step_name(at)")
    emitting.write_switch(1, "name", cases, statements, "prompt.no_singleton(at)")
    emitting.out(0, "}")
    emitting.blank()
    state.singletons.each(write_a_binding)
}

func singletons_named(short: String): List<String> {
    var naming = Naming()
    var found = List<String>()
    var index = 0
    while index < state.singletons.count() {
        var singleton_class = state.singletons[index]
        var singleton_short_name = naming.short_of(singleton_class.shown)
        var singleton_short = singleton_short_name.replace(" ", "")
        if singleton_short == short {
            found.append("{singleton_class.shown}()")
        }
        index = index + 1
    }
    return found
}

# ../../../../spite_documentation/repl.md#the-wire-protocol
func write_a_binding(singleton_class: Model.ClassModel) {
    var type_table = Type.Table(state)
    var naming = Naming()
    var emitting = Emitting(state)
    var singleton_type = singleton_class.type_of_an_instance()
    var number = type_table.number_of(singleton_type)
    var written = singleton_class.shown.replace(" ", "")
    var quoted = naming.escaped(written)
    var lists = argument_lists_of(singleton_class)
    var takes_none = lists.count() == 1 and lists.contains("")
    emitting.out(0, "func bind_{number}(at: Integer) \{")
    if takes_none {
        emitting.out(1, "fallback prompt.bound_without_arguments(at, \"{quoted}\")")
    }
    emitting.out(1, "var given = prompt.given_arguments(at)")
    var instances = List<String>()
    var index = 0
    while index < lists.count() {
        var arguments = lists[index]
        var made = made_function_of(singleton_class, arguments)
        var called = called_of(singleton_class, arguments)
        instances.append(called)
        var quoted_arguments = naming.escaped(arguments)
        var named = called
        if arguments.is_empty() {
            named = written
        }
        var quoted_called = naming.escaped(named)
        emitting.out(1, "if given == \"{quoted_arguments}\" \{")
        emitting.out(2, "var bound_{index} = {made}()")
        emitting.out(2, "if bound_{index} \{")
        emitting.out(3, "walk_{number}(bound_{index}, at + 1)")
        emitting.out(3, "return")
        emitting.out(2, "}")
        emitting.out(2, "prompt.not_made_yet(\"{quoted_called}\")")
        emitting.out(2, "return")
        emitting.out(1, "}")
        index = index + 1
    }
    var joined = instances.join(", ")
    var quoted_instances = naming.escaped(joined)
    emitting.out(1, "prompt.no_instance(at, \"{quoted}\", \"{quoted_instances}\")")
    emitting.out(0, "}")
    emitting.blank()
}

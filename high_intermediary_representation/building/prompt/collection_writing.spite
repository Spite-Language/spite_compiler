var state = SourceState()

func CollectionWriting(starting_state: SourceState) {
    state = starting_state
}

func write_collection_step(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var emitting = Emitting(state)
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    emitting.out(0, "func step_{number}(value: {written}, at: Integer) \{")
    emitting.out(1, "var kind = prompt.step_kind(at)")
    var cases = List<String>()
    var statements = List<String>()
    cases.append("call")
    statements.append("call_{number}(value, at)")
    cases.append("index")
    statements.append("index_{number}(value, at)")
    var refused = type_writing.no_element_of(described)
    emitting.write_switch(1, "kind", cases, statements, refused)
    emitting.out(0, "}")
    emitting.blank()
}

func write_list_index(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var type_table = Type.Table(state)
    var emitting = Emitting(state)
    var object_writing = ObjectWriting(state)
    var naming = Naming()
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    var element = type_kinds.element_of(described)
    var element_number = type_table.number_of(element)
    emitting.out(0, "func index_{number}(value: {written}, at: Integer) \{")
    emitting.out(1, "var counted = value.count()")
    emitting.out(1, "var index = prompt.index_of_a_list(at, counted)")
    emitting.out(1, "fallback index")
    if object_writing.has_a_slot_of_its_own(element) {
        var model = type_kinds.class_model_of(described)
        emitting.declare("storage_{number}", "func storage_{number}(value: {written}): Long", "storage\t{model.key}")
        emitting.declare("item_size_{number}", "func item_size_{number}(): Integer", "item_size\t{model.key}")
        var element_shown = type_kinds.shown_of(element)
        var quoted_element = naming.escaped(element_shown)
        var element_piece = type_writing.piece_of(element, "element_item")
        emitting.out(1, "if prompt.bytes_end_here(at) \{")
        emitting.out(2, "var element_item = value.get_at(index)")
        if not element.is_nullable {
            emitting.out(2, "crash element_item")
        }
        emitting.out(2, "var storage = storage_{number}(value)")
        emitting.out(2, "var item_size = item_size_{number}()")
        emitting.out(2, "var reach = index * item_size")
        emitting.out(2, "var reach_long: Long = reach")
        emitting.out(2, "var place = storage + reach_long")
        emitting.out(2, "var piece = {element_piece}")
        emitting.out(2, "prompt.say_slot_bytes(\"{quoted_element}\", place, item_size, piece)")
        emitting.out(2, "return")
        emitting.out(1, "}")
    }
    emitting.out(1, "var item = value.get_at(index)")
    if element.is_nullable {
        emitting.out(1, "reach_{element_number}(item, at + 1)")
    } else {
        emitting.out(1, "crash item")
        emitting.out(1, "walk_{element_number}(item, at + 1)")
    }
    emitting.out(0, "}")
    emitting.blank()
}

func write_list_assignment(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var type_writing = Type.Writing(state)
    var emitting = Emitting(state)
    var assignment_writing = AssignmentWriting(state)
    var written = type_kinds.written_of(described)
    var element = type_kinds.element_of(described)
    var refused = type_writing.no_element_of(described)
    emitting.out(0, "func assign_{number}(value: {written}, at: Integer) \{")
    emitting.out(1, "var kind = prompt.step_kind(at)")
    emitting.out(1, "if kind != \"index\" \{")
    emitting.out(2, refused)
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "var counted = value.count()")
    emitting.out(1, "var index = prompt.index_of_a_list(at, counted)")
    emitting.out(1, "fallback index")
    emitting.out(1, "put_{number}(value, index)")
    emitting.out(0, "}")
    emitting.blank()
    assignment_writing.write_assignment(
        "put_{number}",
        written,
        element,
        "set_at(index)",
        true,
        ", index: Integer",
        ", index",
    )
}

func write_a_key(key: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var naming = Naming()
    var emitting = Emitting(state)
    var type_table = Type.Table(state)
    var kind = type_kinds.kind_of(key)
    var literal_kind = type_kinds.literal_kind_of(key)
    var shown = type_kinds.shown_of(key)
    var quoted_shown = naming.escaped(shown)
    emitting.out(1, "fallback prompt.key_fits(at, \"{literal_kind}\", \"{quoted_shown}\")")
    emitting.out(1, "var literal = prompt.key(at)")
    if kind == "text" {
        emitting.out(1, "var key = prompt.text_of(literal)")
    } else if kind == "enum" {
        var enum_number = type_table.number_of(key)
        emitting.out(1, "var written = prompt.symbol_of(literal)")
        emitting.out(1, "if not is_value_{enum_number}(written) \{")
        emitting.out(2, "prompt.no_key(at)")
        emitting.out(2, "return")
        emitting.out(1, "}")
        emitting.out(1, "var key = value_{enum_number}(written)")
    } else {
        var reader = type_kinds.reader_of(key)
        emitting.out(1, "var key = prompt.{reader}(literal)")
    }
}

func write_dictionary_index(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var type_table = Type.Table(state)
    var emitting = Emitting(state)
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    var key = type_kinds.key_of(described)
    var held = type_kinds.held_of(described)
    var held_number = type_table.number_of(held)
    emitting.out(0, "func index_{number}(value: {written}, at: Integer) \{")
    if not type_kinds.is_writable(key) {
        var refused = type_writing.no_element_of(described)
        emitting.out(1, refused)
        emitting.out(0, "}")
        emitting.blank()
        return
    }
    write_a_key(key)
    emitting.out(1, "if not value.contains(key) \{")
    emitting.out(2, "prompt.no_key(at)")
    emitting.out(2, "return")
    emitting.out(1, "}")
    emitting.out(1, "var item = value.get_at(key)")
    emitting.out(1, "reach_{held_number}(item, at + 1)")
    emitting.out(0, "}")
    emitting.blank()
}

func write_dictionary_assignment(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var type_writing = Type.Writing(state)
    var emitting = Emitting(state)
    var assignment_writing = AssignmentWriting(state)
    var written = type_kinds.written_of(described)
    var key = type_kinds.key_of(described)
    var held = type_kinds.held_of(described)
    var refused = type_writing.no_element_of(described)
    emitting.out(0, "func assign_{number}(value: {written}, at: Integer) \{")
    if not type_kinds.is_writable(key) {
        emitting.out(1, refused)
        emitting.out(0, "}")
        emitting.blank()
        return
    }
    emitting.out(1, "var kind = prompt.step_kind(at)")
    emitting.out(1, "if kind != \"index\" \{")
    emitting.out(2, refused)
    emitting.out(2, "return")
    emitting.out(1, "}")
    write_a_key(key)
    emitting.out(1, "put_{number}(value, key)")
    emitting.out(0, "}")
    emitting.blank()
    var key_written = type_kinds.written_of(key)
    assignment_writing.write_assignment(
        "put_{number}",
        written,
        held,
        "set_at(key)",
        true,
        ", key: {key_written}",
        ", key",
    )
}

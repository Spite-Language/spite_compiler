var state = SourceState()

func ObjectWriting(starting_state: SourceState) {
    state = starting_state
}

# ../../../../spite_documentation/repl.md#the-wire-protocol
func write_bytes(number: Integer, described: Model.Type, kind: String) {
    var type_kinds = Type.Kinds(state)
    var naming = Naming()
    var emitting = Emitting(state)
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    var shown = type_kinds.shown_of(described)
    var quoted_shown = naming.escaped(shown)
    var model = type_kinds.class_model_of(described)
    declare_the_address(number, written)
    emitting.declare("size_{number}", "func size_{number}(): Integer", "size\t{model.key}")
    emitting.out(0, "func bytes_{number}(value: {written}) \{")
    emitting.out(1, "var address = address_{number}(value)")
    emitting.out(1, "var size = size_{number}()")
    if kind == "list" {
        emitting.declare("storage_{number}", "func storage_{number}(value: {written}): Long", "storage\t{model.key}")
        emitting.declare("item_size_{number}", "func item_size_{number}(): Integer", "item_size\t{model.key}")
        emitting.out(1, "var storage = storage_{number}(value)")
        emitting.out(1, "var item_size = item_size_{number}()")
        emitting.out(1, "var held = value.count()")
        emitting.out(1, "prompt.say_list_bytes(\"{quoted_shown}\", address, size, storage, item_size, held)")
        emitting.out(0, "}")
        emitting.blank()
        return
    }
    emitting.out(1, "var fields = List<String>()")
    if kind == "object" {
        var attributes = type_kinds.attributes_of(described)
        var index = 0
        while index < attributes.count() {
            var attribute = attributes[index]
            var place = place_of(number, model, index, attribute)
            var piece = type_writing.piece_of(attribute.attribute_type, "value.{attribute.name}")
            var attribute_shown = type_kinds.shown_of(attribute.attribute_type)
            var quoted_attribute = naming.escaped(attribute_shown)
            emitting.out(1, "var piece_{index} = {piece}")
            emitting.out(1, "var offset_{index} = offset_{place}()")
            emitting.out(1, "var width_{index} = width_{place}()")
            emitting.out(
                1,
                "var field_{index} = prompt.field_json(\"{attribute.name}\", \"{quoted_attribute}\", offset_{index}, width_{index}, piece_{index})",
            )
            emitting.out(1, "fields.append(field_{index})")
            index = index + 1
        }
    }
    emitting.out(1, "prompt.say_object_bytes(\"{quoted_shown}\", address, size, fields)")
    emitting.out(0, "}")
    emitting.blank()
}

func place_of(number: Integer, model: Model.ClassModel, index: Integer, attribute: Model.AttributeModel): String {
    var emitting = Emitting(state)
    var place = "{number}_{index}"
    var offset_name = "offset_{place}"
    if not state.intrinsics.contains(offset_name) {
        emitting.declare(offset_name, "func {offset_name}(): Integer", "offset\t{model.key}\t{attribute.name}")
        emitting.declare("width_{place}", "func width_{place}(): Integer", "width\t{model.key}\t{attribute.name}")
    }
    return place
}

func has_a_slot_of_its_own(described: Model.Type): Boolean {
    var type_kinds = Type.Kinds(state)
    var kind = type_kinds.kind_of(described)
    return kind == "scalar" or kind == "text" or kind == "enum"
}

func write_a_slot(number: Integer, described: Model.Type, index: Integer, attribute: Model.AttributeModel) {
    var type_kinds = Type.Kinds(state)
    var naming = Naming()
    var type_writing = Type.Writing(state)
    var emitting = Emitting(state)
    var written = type_kinds.written_of(described)
    var model = type_kinds.class_model_of(described)
    var place = place_of(number, model, index, attribute)
    var attribute_shown = type_kinds.shown_of(attribute.attribute_type)
    var quoted_attribute = naming.escaped(attribute_shown)
    var piece = type_writing.piece_of(attribute.attribute_type, "value.{attribute.name}")
    declare_the_address(number, written)
    emitting.out(0, "func slot_{place}(value: {written}, at: Integer) \{")
    emitting.out(1, "if prompt.bytes_end_here(at) \{")
    emitting.out(2, "var offset = offset_{place}()")
    emitting.out(2, "if offset < 0 \{")
    emitting.out(3, "prompt.refuse_bytes(at)")
    emitting.out(3, "return")
    emitting.out(2, "}")
    emitting.out(2, "var address = address_{number}(value)")
    emitting.out(2, "var offset_long: Long = offset")
    emitting.out(2, "var place = address + offset_long")
    emitting.out(2, "var width = width_{place}()")
    emitting.out(2, "var piece = {piece}")
    emitting.out(2, "prompt.say_slot_bytes(\"{quoted_attribute}\", place, width, piece)")
    emitting.out(2, "return")
    emitting.out(1, "}")
    var walked = type_writing.walk_of(attribute.attribute_type, "value.{attribute.name}")
    emitting.out(1, walked)
    emitting.out(0, "}")
    emitting.blank()
}

func declare_the_address(number: Integer, written: String) {
    var emitting = Emitting(state)
    var name = "address_{number}"
    if not state.intrinsics.contains(name) {
        emitting.declare(name, "func {name}(value: {written}): Long", "address")
    }
}

func write_object_names(number: Integer, described: Model.Type) {
    var type_kinds = Type.Kinds(state)
    var emitting = Emitting(state)
    var type_writing = Type.Writing(state)
    var written = type_kinds.written_of(described)
    emitting.out(0, "func name_{number}(value: {written}, at: Integer) \{")
    emitting.out(1, "var name = prompt.step_name(at)")
    var cases = List<String>()
    var statements = List<String>()
    var attributes = type_kinds.attributes_of(described)
    var slots = List<Integer>()
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        cases.append(attribute.name)
        if has_a_slot_of_its_own(attribute.attribute_type) {
            var model = type_kinds.class_model_of(described)
            var place = place_of(number, model, index, attribute)
            statements.append("slot_{place}(value, at)")
            slots.append(index)
        } else {
            var walked = type_writing.walk_of(attribute.attribute_type, "value.{attribute.name}")
            statements.append(walked)
        }
        index = index + 1
    }
    var refused = type_writing.no_attribute_of(described)
    emitting.write_switch(1, "name", cases, statements, refused)
    emitting.out(0, "}")
    emitting.blank()
    var slot_index = 0
    while slot_index < slots.count() {
        var slot = slots[slot_index]
        crash slot
        var slotted = attributes[slot]
        crash slotted
        write_a_slot(number, described, slot, slotted)
        slot_index = slot_index + 1
    }
}

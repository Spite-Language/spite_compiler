var state = SourceState()

func Source(starting_context: Context) {
    state.context = starting_context
}

func source(own_key: String): String {
    var type_table = Type.Table(state)
    var emitting = Emitting(state)
    var run_writing = RunWriting(state)
    var binding_writing = BindingWriting(state)
    var listing_writing = ListingWriting(state)
    var type_writing = Type.Writing(state)
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var entry_type = entry.type_of_an_instance()
    type_table.note_a_type(entry_type)
    choose_the_classes(own_key)
    var index = 0
    while index < state.singletons.count() {
        var singleton_class = state.singletons[index]
        var singleton_type = singleton_class.type_of_an_instance()
        type_table.note_a_type(singleton_type)
        index = index + 1
    }
    var asked_port = state.context.build_flags["repl_port"]
    if asked_port {
        var read_port: Integer? = asked_port
        crash read_port
        state.port = read_port
    }
    emitting.out(0, "var prompt = Spite.Prompt()")
    emitting.out(0, "var prepared = false")
    var hot_reload = state.context.build_flags["hot_reload"] == "true"
    if hot_reload {
        emitting.out(0, "var reloader = Spite.HotReload()")
        emitting.out(0, "var held_program: {entry.shown}? = null")
    }
    emitting.blank()
    run_writing.write_run(entry)
    binding_writing.write_bind()
    listing_writing.write_the_class_list()
    var type_index = 0
    while type_index < state.types.count() {
        var each = state.types[type_index]
        type_writing.write_type(type_index + 1, each)
        type_index = type_index + 1
    }
    var declared_index = 0
    while declared_index < state.intrinsic_lines.count() {
        var declaration = state.intrinsic_lines[declared_index]
        emitting.blank()
        emitting.out(0, declaration)
        declared_index = declared_index + 1
    }
    return state.lines.join("\n")
}

func choose_the_classes(own_key: String) {
    var build = state.context.program.class_named("Build")
    if build {
        choose(build, true)
    }
    var index = 0
    while index < state.context.made_classes.count() {
        var key = state.context.made_classes[index]
        var model = state.context.program.class_named(key)
        if model and key != own_key {
            choose(model, true)
        }
        index = index + 1
    }
    var order_index = 0
    while order_index < state.context.program.order.count() {
        var ordered = state.context.program.order[order_index]
        if ordered.key != own_key {
            choose(ordered, false)
        }
        order_index = order_index + 1
    }
}

func choose(model: Model.ClassModel, allows_settings: Boolean) {
    var is_made_up = model.file.path.is_empty() or model.shown == "Object"
    fallback not state.chosen_keys.contains(model.key) and not is_made_up
    var is_settings = model.key == "Build" or model.key == "Environment"
    var from_the_library = state.context.resolver.state.symbols.is_library_path(model.file.path)
    var is_allowed = not from_the_library or is_settings and allows_settings
    fallback is_allowed
    state.chosen_keys.append(model.key)
    if model.is_singleton {
        state.singletons.append(model)
    } else {
        state.listed_classes.append(model)
    }
    if not from_the_library {
        state.described_classes.append(model)
    }
}

var hot_reload = false

func prompt_source(): String {
    var parts = List<String>()
    var variables = VariablesText(hot_reload)
    var variables_text = variables.written()
    parts.append(variables_text)
    var conversation = ConversationText(hot_reload)
    var conversation_text = conversation.written()
    parts.append(conversation_text)
    var commands = CommandsText(hot_reload)
    var commands_text = commands.written()
    parts.append(commands_text)
    var bytes = BytesText()
    var bytes_text = bytes.written()
    parts.append(bytes_text)
    var reports = ReportsText()
    var reports_text = reports.written()
    parts.append(reports_text)
    var expressions = ExpressionsText()
    var expressions_text = expressions.written()
    parts.append(expressions_text)
    var steps = StepsText()
    var steps_text = steps.written()
    parts.append(steps_text)
    var refusals = RefusalsText(hot_reload)
    var refusals_text = refusals.written()
    parts.append(refusals_text)
    if hot_reload {
        var reload = ReloadText()
        var reload_text = reload.written()
        parts.append(reload_text)
    }
    return parts.join("\n")
}

func path_source(): String {
    var path = PathText()
    return path.written()
}

# ../../../../spite_spec/specs/repl.md#command-language
func code_source(entry_shown: String, typed: String): String {
    var code_lines = List<String>()
    code_lines.append("singleton")
    code_lines.append("")
    var word = ""
    var code = ""
    var break_at = typed.index_of("\n")
    if break_at {
        var sliced_word = typed.slice(0, break_at)
        crash sliced_word
        word = sliced_word
        var typed_length = typed.length()
        var after = typed.slice(break_at + 1, typed_length)
        crash after
        code = after.trim()
    }
    var parameter = "_program"
    if code.contains("program") {
        parameter = "program"
    }
    code_lines.append("func answer({parameter}: {entry_shown}): String \{")
    if word == "eval" {
        code_lines.append("    var value = {code}")
        code_lines.append("    return \"\{value}\"")
    } else if word == "run" {
        code_lines.append("    {code}")
        code_lines.append("    return \"\"")
    } else {
        code_lines.append("    return \"\"")
    }
    code_lines.append("}")
    return code_lines.join("\n")
}

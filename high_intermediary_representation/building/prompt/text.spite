var lines = List<String>()
var hot_reload = false

func prompt_source(): String {
    lines = List<String>()
    add_the_prompt_part_1()
    add_the_prompt_part_2()
    add_the_prompt_part_3()
    add_the_prompt_part_4()
    add_the_prompt_part_5()
    add_the_prompt_part_6()
    add_the_prompt_part_7()
    add_the_prompt_part_8()
    add_the_prompt_part_9()
    add_the_prompt_part_10()
    if hot_reload {
        add_the_reload_functions()
    }
    return lines.join("\n")
}

func add_the_prompt_part_1() {
    lines.append("singleton")
    lines.append("")
    lines.append("var console = Console()")
    lines.append("var kernel = DynamicLibrary(\"kernel32.dll\", 'identity', \"\")")
    lines.append("var target = Spite.PromptPath()")
    lines.append("var source = Spite.PromptPath()")
    lines.append("var walking = Spite.PromptPath()")
    lines.append("var mode = \"\"")
    lines.append("var assigned = \"\"")
    lines.append("var assigned_kind = \"\"")
    lines.append("var fetched: Anything? = null")
    lines.append("var fetched_class = \"\"")
    lines.append("var fetched_null = false")
    lines.append("var fetch_failed = false")
    lines.append("var walks_now = false")
    lines.append("var lists_classes_now = false")
    lines.append("var counts_memory_now = false")
    lines.append("var enum_lines = \"\"")
    lines.append("var described_names = List<String>()")
    lines.append("var described_short_names = List<String>()")
    lines.append("var descriptions = List<String>()")
    lines.append("var said = List<String>()")
    lines.append("var answered_well = true")
    lines.append("var answered_class = \"\"")
    lines.append("var server: Socket? = null")
    lines.append("var client: Socket? = null")
    lines.append("var exits = false")
    if hot_reload {
        lines.append("var reload_word = \"\"")
        lines.append("var code_word = \"\"")
        lines.append("var code_text = \"\"")
        lines.append("var break_word = \"\"")
        lines.append("var break_text = \"\"")
        lines.append("var stopped_at = \"\"")
        lines.append("var stopped_locals = \"\"")
        lines.append("var continues = false")
        lines.append("var nested = false")
        lines.append("var answering = false")
        lines.append("var saved_fetched: Anything? = null")
        lines.append("var saved_mode = \"\"")
        lines.append("var saved_assigned = \"\"")
        lines.append("var saved_assigned_kind = \"\"")
        lines.append("var saved_target = Spite.PromptPath()")
        lines.append("var saved_source = Spite.PromptPath()")
        lines.append("var saved_walking = Spite.PromptPath()")
        lines.append("var saved_fetched_class = \"\"")
        lines.append("var saved_fetched_null = false")
        lines.append("var saved_fetch_failed = false")
        lines.append("var saved_walks_now = false")
        lines.append("var saved_lists_classes_now = false")
        lines.append("var saved_counts_memory_now = false")
        lines.append("var saved_said = List<String>()")
        lines.append("var saved_answered_well = true")
        lines.append("var saved_answered_class = \"\"")
        lines.append("var saved_reload_word = \"\"")
        lines.append("var saved_code_word = \"\"")
        lines.append("var saved_code_text = \"\"")
        lines.append("var saved_break_word = \"\"")
        lines.append("var saved_break_text = \"\"")
        lines.append("var saved_answering = false")
        lines.append("var constructs_now = false")
    }
    lines.append("")
    lines.append("func describes(qualified: String, short: String, description: String) \{")
    lines.append("    described_names.append(qualified)")
    lines.append("    described_short_names.append(short)")
    lines.append("    descriptions.append(description)")
    lines.append("}")
    lines.append("")
    lines.append("func reads(): Boolean \{")
    lines.append("    console.write(\"spite> \")")
    lines.append("    var line = console.read_line()")
    lines.append("    if not line \{")
    lines.append("        console.print(\"\")")
    lines.append("        return false")
    lines.append("    }")
    lines.append("    var goes_on = hears(line)")
    lines.append("    if not goes_on \{")
    lines.append("        console.print(\"\")")
    lines.append("    }")
    lines.append("    return goes_on")
    lines.append("}")
    lines.append("")
    lines.append("func hears(line: String): Boolean \{")
    lines.append("    walks_now = false")
    lines.append("    lists_classes_now = false")
    lines.append("    counts_memory_now = false")
    if hot_reload {
        lines.append("    reload_word = \"\"")
        lines.append("    code_word = \"\"")
        lines.append("    code_text = \"\"")
        lines.append("    break_word = \"\"")
        lines.append("    break_text = \"\"")
        lines.append("    answering = true")
        lines.append("    constructs_now = false")
    }
    lines.append("    fetched = null")
    lines.append("    fetched_class = \"\"")
    lines.append("    fetched_null = false")
    lines.append("    fetch_failed = false")
    lines.append("    said = List<String>()")
    lines.append("    answered_well = true")
    lines.append("    answered_class = \"\"")
    lines.append("    var command = line.trim()")
    lines.append("    if command == \"exit\" \{")
    lines.append("        return false")
    lines.append("    }")
    lines.append("    _answer(command)")
    lines.append("    return true")
    lines.append("}")
    lines.append("")
    lines.append("func deliver() \{")
    if hot_reload {
        lines.append("    answering = false")
    }
    lines.append("    if said.is_empty() \{")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var joined = said.join(\"\\n\")")
    lines.append("    console.print(joined)")
    lines.append("}")
    lines.append("")
    lines.append("func listen(port: Integer) \{")
    lines.append("    var made = Socket()")
    lines.append("    if not made.listen_locally(port) \{")
    lines.append("        console.error(\"error: the REPL could not listen on 127.0.0.1:\{port}\")")
    lines.append("        var running = Program()")
    lines.append("        running.exit(1)")
    lines.append("    }")
    lines.append("    server = made")
    lines.append("}")
    lines.append("")
    lines.append("func watched_handle(): Long \{")
    lines.append("    var no_handle: Long = 0")
    lines.append("    var connected = client")
    lines.append("    if connected \{")
    lines.append("        if connected.closed \{")
    lines.append("            return no_handle")
    lines.append("        }")
    lines.append("        return connected.handle")
    lines.append("    }")
    lines.append("    var listening = server")
    lines.append("    if listening and not exits \{")
    lines.append("        return listening.handle")
    lines.append("    }")
    lines.append("    return no_handle")
    lines.append("}")
    lines.append("")
    lines.append("func next_line(waits: Boolean): String? \{")
    lines.append("    if not client \{")
    lines.append("        _accept(waits)")
    lines.append("    }")
    lines.append("    var connected = client")
    lines.append("    assert connected")
    lines.append("    var line = _line_of(connected, waits)")
    lines.append("    if not line and connected.closed \{")
    lines.append("        client = null")
    lines.append("    }")
    lines.append("    return line")
    lines.append("}")
    lines.append("")
    lines.append("func _accept(waits: Boolean) \{")
    lines.append("    var listening = server")
    lines.append("    assert listening")
    lines.append("    if waits \{")
    lines.append("        client = listening.accept_client()")
    lines.append("    } else \{")
    lines.append("        client = listening.accept_client_now()")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _line_of(connected: Socket, waits: Boolean): String? \{")
    lines.append("    if waits \{")
    lines.append("        return connected.read_line()")
    lines.append("    }")
    lines.append("    return connected.read_line_now()")
    lines.append("}")
    lines.append("")
    lines.append("func send_the_answer(goes_on: Boolean) \{")
    if hot_reload {
        lines.append("    if continues and nested \{")
        lines.append("        return")
        lines.append("    }")
        lines.append("    answering = false")
    }
    lines.append("    var connected = client")
    lines.append("    assert connected")
    lines.append("    if goes_on \{")
    lines.append("        var answered = answer_json()")
}

func add_the_prompt_part_2() {
    lines.append("        connected.write_line(answered)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    connected.write_line(\"\\\{\\\"ok\\\":true,\\\"value\\\":\\\"\\\",\\\"type\\\":\\\"\\\"}\")")
    lines.append("    connected.close()")
    lines.append("    client = null")
    lines.append("    exits = true")
    lines.append("}")
    lines.append("")
    lines.append("func end_the_program() \{")
    lines.append("    var running = Program()")
    lines.append("    running.exit(0)")
    lines.append("}")
    lines.append("")
    lines.append("func answer_json(): String \{")
    lines.append("    var joined = said.join(\"\\n\")")
    lines.append("    var escaped = json_escaped(joined)")
    lines.append("    if answered_well \{")
    lines.append("        var class_escaped = json_escaped(answered_class)")
    lines.append("        return \"\\\{\\\"ok\\\":true,\\\"value\\\":\\\"\{escaped}\\\",\\\"type\\\":\\\"\{class_escaped}\\\"}\"")
    lines.append("    }")
    lines.append("    return \"\\\{\\\"ok\\\":false,\\\"error\\\":\\\"\{escaped}\\\"}\"")
    lines.append("}")
    lines.append("")
    lines.append("func json_escaped(text: String): String \{")
    lines.append("    var written = \"\"")
    lines.append("    var digits = \"0123456789abcdef\"")
    lines.append("    var index = 0")
    lines.append("    while index < text.length() \{")
    lines.append("        var code = text.byte_at(index)")
    lines.append("        var character = text[index]")
    lines.append("        crash character")
    lines.append("        if code == 34 \{")
    lines.append("            written = \"\{written}\\\\\\\"\"")
    lines.append("        } else if code == 92 \{")
    lines.append("            written = \"\{written}\\\\\\\\\"")
    lines.append("        } else if code == 10 \{")
    lines.append("            written = \"\{written}\\\\n\"")
    lines.append("        } else if code == 13 \{")
    lines.append("            written = \"\{written}\\\\r\"")
    lines.append("        } else if code == 9 \{")
    lines.append("            written = \"\{written}\\\\t\"")
    lines.append("        } else if code < 32 \{")
    lines.append("            var high = digits[code / 16]")
    lines.append("            var low = digits[code % 16]")
    lines.append("            crash high and low")
    lines.append("            written = \"\{written}\\\\u00\{high}\{low}\"")
    lines.append("        } else \{")
    lines.append("            written = \"\{written}\{character}\"")
    lines.append("        }")
    lines.append("        index = index + character.length()")
    lines.append("    }")
    lines.append("    return written")
    lines.append("}")
    lines.append("")
    lines.append("func _said(text: String) \{")
    lines.append("    said.append(text)")
    lines.append("}")
    lines.append("")
    lines.append("func complain(text: String) \{")
    lines.append("    said.append(text)")
    lines.append("    answered_well = false")
    lines.append("}")
    lines.append("")
    lines.append("func lists_classes(): Boolean \{")
    lines.append("    return lists_classes_now")
    lines.append("}")
    lines.append("")
    lines.append("func counts_memory(): Boolean \{")
    lines.append("    return counts_memory_now")
    lines.append("}")
    lines.append("")
    lines.append("func say_the_memory(live: Long, held: Long) \{")
    lines.append("    _said(\"\{live} live allocations holding \{held} bytes\")")
    lines.append("}")
    lines.append("")
    lines.append("func walks(): Boolean \{")
    lines.append("    return walks_now")
    lines.append("}")
    lines.append("")
    lines.append("func fetches(): Boolean \{")
    lines.append("    return walks_now and assigned_kind == \"path\"")
    lines.append("}")
    lines.append("")
    lines.append("func start_fetching() \{")
    lines.append("    walking = source")
    lines.append("    mode = \"fetch\"")
    lines.append("}")
    lines.append("")
    lines.append("func fetching_went_well(): Boolean \{")
    lines.append("    if assigned_kind != \"path\" \{")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    return fetched_null or fetched_class != \"\"")
    lines.append("}")
    lines.append("")
    lines.append("func start_walking() \{")
    lines.append("    walking = target")
    lines.append("    if not assigned_kind.is_empty() \{")
    lines.append("        mode = \"assign\"")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func finish() \{")
    lines.append("    fetched = null")
    lines.append("    walking = Spite.PromptPath()")
    lines.append("}")
    lines.append("")
    lines.append("func _answer(command: String) \{")
    lines.append("    mode = \"show\"")
    lines.append("    assigned = \"\"")
    lines.append("    assigned_kind = \"\"")
    lines.append("    assert not command.is_empty()")
    lines.append("    var words = command.split(\" \")")
    lines.append("    var first_word = words[0]")
    lines.append("    crash first_word")
    lines.append("    var rest = \"\"")
    lines.append("    var first_length = first_word.length()")
    lines.append("    var command_length = command.length()")
    lines.append("    if command_length > first_length \{")
    lines.append("        var after = command.slice(first_length, command_length)")
    lines.append("        rest = after.trim()")
    lines.append("    }")
    lines.append("    if first_word == \"help\" \{")
}

# ../../../../spite_spec/specs/repl.md#live-reload-in-detail
func add_the_reload_answer() {
    lines.append("    } else if _reloads(first_word) and rest.is_empty() \{")
    lines.append("        reload_word = first_word")
    lines.append("    } else if _reloads(first_word) \{")
    lines.append("        complain(\"'\{command}' renames attributes while the objects move to their new layout, and this compiler does not move objects yet: 'reload' takes the saved files as they are\")")
    lines.append("    } else if _runs_code(first_word, rest) \{")
    lines.append("        code_word = first_word")
    lines.append("        code_text = rest")
    lines.append("    } else if _sets_breakpoints(first_word, rest) \{")
    lines.append("        break_word = first_word")
    lines.append("        break_text = rest")
    lines.append("    } else if _waits_at_a_breakpoint(first_word) and rest.is_empty() \{")
    lines.append("        _at_a_breakpoint(first_word)")
}

func add_the_reload_functions() {
    lines.append("")
    lines.append("func _construct_into_the_target() \{")
    lines.append("    var written = target.written")
    lines.append("    var first = written.byte_at(0)")
    lines.append("    var starts_at_a_singleton = first >= 65 and first <= 90")
    lines.append("    if not starts_at_a_singleton and written != \"program\" and not written.starts_with(\"program.\") \{")
    lines.append("        written = \"program.\{written}\"")
    lines.append("    }")
    lines.append("    code_word = \"run\"")
    lines.append("    code_text = \"\{written} = \{assigned}\"")
    lines.append("    constructs_now = true")
    lines.append("}")
    lines.append("")
    lines.append("func constructs(): Boolean \{")
    lines.append("    return constructs_now")
    lines.append("}")
    lines.append("")
    lines.append("func start_showing_the_target() \{")
    lines.append("    constructs_now = false")
    lines.append("    mode = \"show\"")
    lines.append("    assigned = \"\"")
    lines.append("    assigned_kind = \"\"")
    lines.append("    walking = target")
    lines.append("}")
    lines.append("")
    lines.append("func reloads(): Boolean \{")
    lines.append("    return not reload_word.is_empty()")
    lines.append("}")
    lines.append("")
    lines.append("func sets_breakpoints(): Boolean \{")
    lines.append("    return not break_word.is_empty()")
    lines.append("}")
    lines.append("")
    lines.append("func is_stopped(): Boolean \{")
    lines.append("    return not stopped_at.is_empty()")
    lines.append("}")
    lines.append("")
    lines.append("func stays_stopped(): Boolean \{")
    lines.append("    return not continues")
    lines.append("}")
    lines.append("")
    lines.append("func passes_a_second_stop(site: String) \{")
    lines.append("    console.error(\"spite: the program passed the breakpoint at '\{site}' while it is stopped at '\{stopped_at}', so it did not stop there\")")
    lines.append("}")
    lines.append("")
    lines.append("func stop_at(site: String, locals: List<String>) \{")
    lines.append("    saved_mode = mode")
    lines.append("    saved_assigned = assigned")
    lines.append("    saved_assigned_kind = assigned_kind")
    lines.append("    saved_target = target")
    lines.append("    saved_source = source")
    lines.append("    saved_walking = walking")
    lines.append("    saved_fetched = fetched")
    lines.append("    saved_fetched_class = fetched_class")
    lines.append("    saved_fetched_null = fetched_null")
    lines.append("    saved_fetch_failed = fetch_failed")
    lines.append("    saved_walks_now = walks_now")
    lines.append("    saved_lists_classes_now = lists_classes_now")
    lines.append("    saved_counts_memory_now = counts_memory_now")
    lines.append("    saved_said = said")
    lines.append("    saved_answered_well = answered_well")
    lines.append("    saved_answered_class = answered_class")
    lines.append("    saved_reload_word = reload_word")
    lines.append("    saved_code_word = code_word")
    lines.append("    saved_code_text = code_text")
    lines.append("    saved_break_word = break_word")
    lines.append("    saved_break_text = break_text")
    lines.append("    saved_answering = answering")
    lines.append("    nested = answering")
    lines.append("    stopped_at = site")
    lines.append("    stopped_locals = locals.join(\"\\n\")")
    lines.append("    continues = false")
    lines.append("}")
    lines.append("")
    lines.append("func tell_the_stop() \{")
    lines.append("    console.print(\"stopped at \{stopped_at}\")")
    lines.append("}")
    lines.append("")
    lines.append("func says_it_stopped(): Boolean \{")
    lines.append("    return nested")
    lines.append("}")
    lines.append("")
    lines.append("func say_the_stop() \{")
    lines.append("    said = List<String>()")
    lines.append("    said.append(\"stopped at \{stopped_at}\")")
    lines.append("    answered_well = true")
    lines.append("    answered_class = \"\"")
    lines.append("}")
    lines.append("")
    lines.append("func go_on() \{")
    lines.append("    mode = saved_mode")
    lines.append("    assigned = saved_assigned")
    lines.append("    assigned_kind = saved_assigned_kind")
    lines.append("    target = saved_target")
    lines.append("    source = saved_source")
    lines.append("    walking = saved_walking")
    lines.append("    fetched = saved_fetched")
    lines.append("    fetched_class = saved_fetched_class")
    lines.append("    fetched_null = saved_fetched_null")
    lines.append("    fetch_failed = saved_fetch_failed")
    lines.append("    walks_now = saved_walks_now")
    lines.append("    lists_classes_now = saved_lists_classes_now")
    lines.append("    counts_memory_now = saved_counts_memory_now")
    lines.append("    said = saved_said")
    lines.append("    answered_well = saved_answered_well")
    lines.append("    answered_class = saved_answered_class")
    lines.append("    reload_word = saved_reload_word")
    lines.append("    code_word = saved_code_word")
    lines.append("    code_text = saved_code_text")
    lines.append("    break_word = saved_break_word")
    lines.append("    break_text = saved_break_text")
    lines.append("    answering = saved_answering")
    lines.append("    stopped_at = \"\"")
    lines.append("    stopped_locals = \"\"")
    lines.append("    continues = false")
    lines.append("    nested = false")
    lines.append("}")
    lines.append("")
    lines.append("func _at_a_breakpoint(word: String) \{")
    lines.append("    if stopped_at.is_empty() \{")
    lines.append("        complain(\"the program is not stopped at a breakpoint: 'break hero.spite:12' sets one\")")
    lines.append("    } else if word == \"where\" \{")
    lines.append("        _said(stopped_at)")
    lines.append("    } else if word == \"continue\" \{")
    lines.append("        continues = true")
    lines.append("        _said(\"continued from \{stopped_at}\")")
    lines.append("    } else \{")
    lines.append("        _said(stopped_locals)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func runs_code(): Boolean \{")
    lines.append("    return not code_word.is_empty()")
    lines.append("}")
    lines.append("")
    lines.append("func say_the_code(text: String) \{")
    lines.append("    if code_word == \"eval\" \{")
    lines.append("        _said(text)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func say_the_reload(text: String, succeeded: Boolean) \{")
    lines.append("    if succeeded \{")
    lines.append("        _said(text)")
    lines.append("    } else \{")
    lines.append("        complain(text)")
    lines.append("    }")
    lines.append("}")
}

func add_the_prompt_part_3() {
    lines.append("        _help()")
    lines.append("    } else if first_word == \"enums\" and rest.is_empty() \{")
    lines.append("        _say_or(enum_lines, \"the program declares no enum\")")
    lines.append("    } else if first_word == \"classes\" and rest.is_empty() \{")
    lines.append("        lists_classes_now = true")
    lines.append("    } else if first_word == \"describe\" \{")
    lines.append("        _describe(rest)")
    if hot_reload {
        add_the_reload_answer()
    } else {
        lines.append("    } else if _reloads(first_word) \{")
        lines.append("        complain(\"'\{first_word}' answers in a program built with --hot-reload, which swaps its code while it runs, and this one was not\")")
    }
    lines.append("    } else if _sets_breakpoints(first_word, rest) \{")
    lines.append("        complain(\"'\{command}' answers in a program built with --hot-reload and --repl-port: a breakpoint is compiled into the code the program runs, and the program waits there for the remote REPL\")")
    lines.append("    } else if _runs_code(first_word, rest) \{")
    lines.append("        complain(\"'\{command}' answers in a program built with --hot-reload and --repl-port: the code is compiled into the running program, which the remote REPL then calls\")")
    lines.append("    } else if _waits_at_a_breakpoint(first_word) and rest.is_empty() \{")
    lines.append("        complain(\"the program is not stopped at a breakpoint: 'break hero.spite:12' sets one\")")
    lines.append("    } else if first_word == \"memory\" and rest.is_empty() \{")
    lines.append("        counts_memory_now = true")
    lines.append("    } else if first_word == \"bytes\" \{")
    lines.append("        _bytes(rest)")
    lines.append("    } else if first_word == \"attributes\" \{")
    lines.append("        mode = \"attributes\"")
    lines.append("        _read_the_path(rest)")
    lines.append("    } else if first_word == \"functions\" \{")
    lines.append("        mode = \"functions\"")
    lines.append("        _read_the_path(rest)")
    lines.append("    } else \{")
    lines.append("        _read_an_expression(command)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _reloads(word: String): Boolean \{")
    lines.append("    return word == \"reload\" or word == \"last_reload\" or word == \"wait_reload\"")
    lines.append("}")
    lines.append("")
    lines.append("func _sets_breakpoints(word: String, rest: String): Boolean \{")
    lines.append("    if word == \"break\" \{")
    lines.append("        return not rest.is_empty()")
    lines.append("    }")
    lines.append("    if word == \"breaks\" \{")
    lines.append("        return rest.is_empty()")
    lines.append("    }")
    lines.append("    return word == \"clear\"")
    lines.append("}")
    lines.append("")
    lines.append("func _runs_code(word: String, rest: String): Boolean \{")
    lines.append("    var names_code = word == \"eval\" or word == \"run\"")
    lines.append("    return names_code and not rest.is_empty()")
    lines.append("}")
    lines.append("")
    lines.append("func hex_of(value: Long): String \{")
    lines.append("    var digits = \"0123456789abcdef\"")
    lines.append("    if value == 0 \{")
    lines.append("        return \"0x0\"")
    lines.append("    }")
    lines.append("    var written = \"\"")
    lines.append("    var left = value")
    lines.append("    while left > 0 \{")
    lines.append("        var digit = left % 16")
    lines.append("        var place = digit.to_integer()")
    lines.append("        var shown = digits[place]")
    lines.append("        crash shown")
    lines.append("        written = \"\{shown}\{written}\"")
    lines.append("        left = left / 16")
    lines.append("    }")
    lines.append("    return \"0x\{written}\"")
    lines.append("}")
    lines.append("")
    lines.append("func shown_hex(address: Long, size: Integer): String \{")
    lines.append("    var wanted = size")
    lines.append("    if wanted > 4096 \{")
    lines.append("        wanted = 4096")
    lines.append("    }")
    lines.append("    if wanted < 1 \{")
    lines.append("        return \"\\\"hex\\\":\\\"\\\"\"")
    lines.append("    }")
    lines.append("    var copied = _copied_hex(address, wanted)")
    lines.append("    if copied \{")
    lines.append("        return \"\\\"hex\\\":\\\"\{copied}\\\"\"")
    lines.append("    }")
    lines.append("    return \"\\\"unreadable\\\":true\"")
    lines.append("}")
    lines.append("")
    lines.append("func field_json(name: String, class_name: String, offset: Integer, width: Integer, value: String): String \{")
    lines.append("    var quoted_name = json_escaped(name)")
    lines.append("    var quoted_class = json_escaped(class_name)")
    lines.append("    var quoted_value = json_escaped(value)")
    lines.append("    var placed = \"\{offset}\"")
    lines.append("    if offset < 0 \{")
    lines.append("        placed = \"null\"")
    lines.append("    }")
    lines.append("    return \"\\\{\\\"name\\\":\\\"\{quoted_name}\\\",\\\"class\\\":\\\"\{quoted_class}\\\",\\\"offset\\\":\{placed},\\\"bytes\\\":\{width},\\\"value\\\":\\\"\{quoted_value}\\\"}\"")
    lines.append("}")
    lines.append("")
    lines.append("func say_object_bytes(class_name: String, address: Long, size: Integer, fields: List<String>) \{")
    lines.append("    var quoted_class = json_escaped(class_name)")
    lines.append("    var place = hex_of(address)")
    lines.append("    var hex = shown_hex(address, size)")
    lines.append("    var joined = fields.join(\",\")")
    lines.append("    _said(\"\\\{\\\"class\\\":\\\"\{quoted_class}\\\",\\\"address\\\":\\\"\{place}\\\",\\\"bytes\\\":\{size},\{hex},\\\"fields\\\":[\{joined}]}\")")
    lines.append("}")
    lines.append("")
    lines.append("func say_list_bytes(class_name: String, address: Long, size: Integer, storage: Long, item_size: Integer, held: Integer) \{")
    lines.append("    var quoted_class = json_escaped(class_name)")
    lines.append("    var place = hex_of(address)")
    lines.append("    var hex = shown_hex(address, size)")
    lines.append("    var stored = item_size * held")
    lines.append("    var storage_place = hex_of(storage)")
    lines.append("    var shown = stored")
    lines.append("    if shown > 4096 \{")
    lines.append("        shown = 4096")
    lines.append("    }")
    lines.append("    var storage_hex = \"\\\"hex\\\":\\\"\\\"\"")
    lines.append("    if storage != 0 \{")
    lines.append("        storage_hex = shown_hex(storage, shown)")
    lines.append("    }")
    lines.append("    _said(\"\\\{\\\"class\\\":\\\"\{quoted_class}\\\",\\\"address\\\":\\\"\{place}\\\",\\\"bytes\\\":\{size},\{hex},\\\"buffer\\\":\\\{\\\"address\\\":\\\"\{storage_place}\\\",\\\"bytes\\\":\{stored},\\\"shown\\\":\{shown},\{storage_hex}}}\")")
    lines.append("}")
    lines.append("")
    lines.append("func say_slot_bytes(class_name: String, address: Long, width: Integer, value: String) \{")
    lines.append("    var quoted_class = json_escaped(class_name)")
    lines.append("    var quoted_value = json_escaped(value)")
    lines.append("    var place = hex_of(address)")
}

func add_the_prompt_part_4() {
    lines.append("    var hex = shown_hex(address, width)")
    lines.append("    _said(\"\\\{\\\"class\\\":\\\"\{quoted_class}\\\",\\\"address\\\":\\\"\{place}\\\",\\\"bytes\\\":\{width},\{hex},\\\"value\\\":\\\"\{quoted_value}\\\"}\")")
    lines.append("}")
    lines.append("")
    lines.append("func shows_bytes(): Boolean \{")
    lines.append("    return mode == \"bytes\"")
    lines.append("}")
    lines.append("")
    lines.append("func bytes_end_here(at: Integer): Boolean \{")
    lines.append("    return mode == \"bytes\" and at == walking.count() - 1")
    lines.append("}")
    lines.append("")
    lines.append("func not_made_yet(called: String) \{")
    lines.append("    complain(\"\{called} has not been made yet: nothing in the program has asked for it, and the prompt never makes one\")")
    lines.append("}")
    lines.append("")
    lines.append("func given_arguments(at: Integer): String \{")
    lines.append("    return walking.arguments_text(at)")
    lines.append("}")
    lines.append("")
    lines.append("func no_instance(at: Integer, class_name: String, instances: String) \{")
    lines.append("    var given = walking.arguments_text(at)")
    lines.append("    complain(\"the program holds no \{class_name}(\{given}): a singleton made with arguments has one instance for each argument list the program asks for, \{instances}\")")
    lines.append("}")
    lines.append("")
    lines.append("func _waits_at_a_breakpoint(word: String): Boolean \{")
    lines.append("    return word == \"where\" or word == \"locals\" or word == \"continue\"")
    lines.append("}")
    lines.append("")
    lines.append("func _say_or(text: String, otherwise: String) \{")
    lines.append("    if text.is_empty() \{")
    lines.append("        _said(otherwise)")
    lines.append("    } else \{")
    lines.append("        _said(text)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _help() \{")
    lines.append("    _said(\"a path shows a value: program, player.health, monsters[0].name, World().tick\")")
    lines.append("    _said(\"a call runs a function with literal arguments: monsters.count(), player.heal(5)\")")
    lines.append("    _said(\"an assignment writes a literal, null or a path: turn = 7, nickname = null, follower = leader\")")
    lines.append("    _said(\"attributes [path], functions [path], describe <Class>, classes, enums, bytes <path>, bytes <address> <count>, memory, help, exit\")")
    lines.append("}")
    lines.append("")
    lines.append("func _describe(name: String) \{")
    lines.append("    if name.is_empty() \{")
    lines.append("        complain(\"describe names a class, such as 'describe Monster': 'classes' lists them\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var found = -1")
    lines.append("    var shared = List<String>()")
    lines.append("    var index = 0")
    lines.append("    while index < described_names.count() \{")
    lines.append("        var qualified = described_names[index]")
    lines.append("        var short = described_short_names[index]")
    lines.append("        crash qualified")
    lines.append("        crash short")
    lines.append("        if qualified == name \{")
    lines.append("            found = index")
    lines.append("            shared = List<String>()")
    lines.append("            index = described_names.count()")
    lines.append("        } else \{")
    lines.append("            if short == name \{")
    lines.append("                found = index")
    lines.append("                shared.append(qualified)")
    lines.append("            }")
    lines.append("            index = index + 1")
    lines.append("        }")
    lines.append("    }")
    lines.append("    if found < 0 \{")
    lines.append("        complain(\"no class '\{name}' in the program: 'classes' lists them\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if shared.count() > 1 \{")
    lines.append("        var joined = shared.join(\", \")")
    lines.append("        complain(\"'\{name}' names more than one class: \{joined}; describe one by its whole name\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var description = descriptions[found]")
    lines.append("    crash description")
    lines.append("    _said(description)")
    lines.append("}")
    lines.append("")
    lines.append("func _bytes(rest: String) \{")
    lines.append("    var words = rest.split(\" \")")
    lines.append("    var first_word = words[0]")
    lines.append("    crash first_word")
    lines.append("    var is_an_address = first_word.starts_with(\"0x\")")
    lines.append("    if not is_an_address \{")
    lines.append("        mode = \"bytes\"")
    lines.append("        _read_the_path(rest)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var count_text = \"\"")
    lines.append("    if words.count() == 2 \{")
    lines.append("        var second = words[1]")
    lines.append("        crash second")
    lines.append("        count_text = second")
    lines.append("    }")
    lines.append("    var wanted = count_text.to_integer()")
    lines.append("    var word_length = first_word.length()")
    lines.append("    var hexadecimal = first_word.slice(2, word_length)")
    lines.append("    var address = _hexadecimal_value(hexadecimal)")
    lines.append("    var is_a_range = words.count() == 2 and wanted and address")
    lines.append("    if not is_a_range \{")
    lines.append("        complain(\"'bytes' reads a range as 'bytes 0x1f2a40 64': an address in hexadecimal and a count of bytes\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    crash wanted")
    lines.append("    crash address")
    lines.append("    if wanted < 1 or wanted > 4096 \{")
    lines.append("        complain(\"'bytes' reads from 1 to 4096 bytes at a time, and \{count_text} is not in that range\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var copied = _copied_hex(address, wanted)")
    lines.append("    if copied \{")
    lines.append("        _said(\"\\\{\\\"address\\\":\\\"\{first_word}\\\",\\\"bytes\\\":\{wanted},\\\"hex\\\":\\\"\{copied}\\\"}\")")
    lines.append("    } else \{")
    lines.append("        complain(\"unreadable: \{first_word} for \{wanted} bytes\")")
    lines.append("    }")
}

func add_the_prompt_part_5() {
    lines.append("}")
    lines.append("")
    lines.append("func _copied_hex(address: Long, wanted: Integer): String? \{")
    lines.append("    var room = Buffer(wanted)")
    lines.append("    var process = kernel.GetCurrentProcess_as_long()")
    lines.append("    var no_count: Long = 0")
    lines.append("    var copied = kernel.ReadProcessMemory(process, address, room, wanted, no_count)")
    lines.append("    assert copied != 0")
    lines.append("    room.take_written(wanted)")
    lines.append("    var digits = \"0123456789abcdef\"")
    lines.append("    var hex = \"\"")
    lines.append("    var index = 0")
    lines.append("    while index < wanted \{")
    lines.append("        var byte = room[index]")
    lines.append("        crash byte")
    lines.append("        var high = digits[byte / 16]")
    lines.append("        var low = digits[byte % 16]")
    lines.append("        crash high and low")
    lines.append("        hex = \"\{hex}\{high}\{low}\"")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return hex")
    lines.append("}")
    lines.append("")
    lines.append("func _hexadecimal_value(digits: String): Long? \{")
    lines.append("    assert not digits.is_empty() and digits.length() <= 15")
    lines.append("    var value: Long = 0")
    lines.append("    var index = 0")
    lines.append("    while index < digits.length() \{")
    lines.append("        var code = digits.byte_at(index)")
    lines.append("        var digit = -1")
    lines.append("        if code >= 48 and code <= 57 \{")
    lines.append("            digit = code - 48")
    lines.append("        } else if code >= 97 and code <= 102 \{")
    lines.append("            digit = code - 87")
    lines.append("        } else if code >= 65 and code <= 70 \{")
    lines.append("            digit = code - 55")
    lines.append("        }")
    lines.append("        assert digit >= 0")
    lines.append("        value = value * 16 + digit")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return value")
    lines.append("}")
    lines.append("")
    lines.append("func _read_the_path(text: String) \{")
    lines.append("    target.read(text)")
    lines.append("    if not target.problem.is_empty() \{")
    lines.append("        complain(target.problem)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    walks_now = true")
    lines.append("}")
    lines.append("")
    lines.append("func _read_an_expression(command: String) \{")
    lines.append("    var equals = _assignment_place(command)")
    lines.append("    if equals < 0 \{")
    lines.append("        _read_the_path(command)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var left = command.slice(0, equals)")
    lines.append("    var command_length = command.length()")
    lines.append("    var right = command.slice(equals + 1, command_length)")
    lines.append("    var target_text = left.trim()")
    lines.append("    assigned = right.trim()")
    lines.append("    target.read(target_text)")
    lines.append("    if not target.problem.is_empty() \{")
    lines.append("        complain(target.problem)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var last = target.count() - 1")
    lines.append("    var assignable = last >= 0")
    lines.append("    if assignable \{")
    lines.append("        var last_kind = target.kind(last)")
    lines.append("        assignable = last_kind == \"name\" or last_kind == \"index\"")
    lines.append("    }")
    lines.append("    if not assignable \{")
    lines.append("        complain(\"'\{target_text}' is not an attribute or an element: the prompt assigns into one, as in 'player.health = 5' or 'names[0] = \\\"ann\\\"'\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if assigned.is_empty() \{")
    lines.append("        complain(\"'\{target_text} =' assigns nothing: write a literal, null or a path after '='\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    assigned_kind = _kind_of_the_literal(assigned)")
    lines.append("    if assigned_kind == \"path\" \{")
    lines.append("        source.read(assigned)")
    lines.append("        if not source.problem.is_empty() \{")
    lines.append("            complain(source.problem)")
    lines.append("            return")
    lines.append("        }")
    lines.append("    }")
    lines.append("    walks_now = true")
    lines.append("}")
    lines.append("")
    lines.append("func _assignment_place(command: String): Integer \{")
    lines.append("    var scanner = Spite.PromptPath()")
    lines.append("    var quote = 0")
    lines.append("    var depth = 0")
    lines.append("    var index = 0")
    lines.append("    while index < command.length() \{")
    lines.append("        var code = command.byte_at(index)")
    lines.append("        var step = scanner._step_at(code, quote)")
    lines.append("        var was_outside = quote == 0")
    lines.append("        quote = scanner._quote_after(code, quote)")
    lines.append("        if was_outside and quote == 0 \{")
    lines.append("            depth = scanner._depth_after(code, depth)")
    lines.append("        }")
    lines.append("        if was_outside and code == 61 and depth == 0 \{")
    lines.append("            return index")
    lines.append("        }")
    lines.append("        index = index + step")
    lines.append("    }")
    lines.append("    return -1")
    lines.append("}")
    lines.append("")
    lines.append("func _kind_of_the_literal(literal: String): String \{")
    lines.append("    if literal == \"null\" \{")
    lines.append("        return \"null\"")
    lines.append("    }")
    lines.append("    if is_whole(literal) or is_decimal(literal) or is_text(literal) or is_symbol(literal) or is_boolean(literal) \{")
}

func add_the_prompt_part_6() {
    lines.append("        return \"literal\"")
    lines.append("    }")
    lines.append("    return \"path\"")
    lines.append("}")
    lines.append("")
    lines.append("func is_whole(literal: String): Boolean \{")
    lines.append("    var length = literal.length()")
    lines.append("    var index = 0")
    lines.append("    if length > 1 and literal.byte_at(0) == 45 \{")
    lines.append("        index = 1")
    lines.append("    }")
    lines.append("    if index >= length \{")
    lines.append("        return false")
    lines.append("    }")
    lines.append("    while index < length \{")
    lines.append("        var code = literal.byte_at(index)")
    lines.append("        if code < 48 or code > 57 \{")
    lines.append("            return false")
    lines.append("        }")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return true")
    lines.append("}")
    lines.append("")
    lines.append("func is_decimal(literal: String): Boolean \{")
    lines.append("    var parts = literal.split(\".\")")
    lines.append("    if parts.count() != 2 \{")
    lines.append("        return false")
    lines.append("    }")
    lines.append("    var whole_part = parts[0]")
    lines.append("    var fraction = parts[1]")
    lines.append("    crash whole_part")
    lines.append("    crash fraction")
    lines.append("    var fraction_is_digits = is_whole(fraction) and not fraction.starts_with(\"-\")")
    lines.append("    return is_whole(whole_part) and fraction_is_digits")
    lines.append("}")
    lines.append("")
    lines.append("func is_text(literal: String): Boolean \{")
    lines.append("    var length = literal.length()")
    lines.append("    return length >= 2 and literal.starts_with(\"\\\"\") and literal.ends_with(\"\\\"\")")
    lines.append("}")
    lines.append("")
    lines.append("func is_symbol(literal: String): Boolean \{")
    lines.append("    var length = literal.length()")
    lines.append("    return length >= 2 and literal.starts_with(\"'\") and literal.ends_with(\"'\")")
    lines.append("}")
    lines.append("")
    lines.append("func is_boolean(literal: String): Boolean \{")
    lines.append("    return literal == \"true\" or literal == \"false\"")
    lines.append("}")
    lines.append("")
    lines.append("func text_of(literal: String): String \{")
    lines.append("    var read = \"\"")
    lines.append("    var length = literal.length()")
    lines.append("    var index = 1")
    lines.append("    while index < length - 1 \{")
    lines.append("        var character = literal[index]")
    lines.append("        crash character")
    lines.append("        var escapes = character == \"\\\\\" and index + 1 < length - 1")
    lines.append("        if escapes \{")
    lines.append("            var escaped = literal[index + 1]")
    lines.append("            crash escaped")
    lines.append("            var meant = _escaped(escaped)")
    lines.append("            read = \"\{read}\{meant}\"")
    lines.append("            index = index + 1 + escaped.length()")
    lines.append("        } else \{")
    lines.append("            read = \"\{read}\{character}\"")
    lines.append("            index = index + character.length()")
    lines.append("        }")
    lines.append("    }")
    lines.append("    return read")
    lines.append("}")
    lines.append("")
    lines.append("func _escaped(escaped: String): String \{")
    lines.append("    switch escaped \{")
    lines.append("        \"n\": return \"\\n\"")
    lines.append("        \"t\": return \"\\t\"")
    lines.append("        \"r\": return \"\\r\"")
    lines.append("        _: return escaped")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func has_a_hole(literal: String): Boolean \{")
    lines.append("    var length = literal.length()")
    lines.append("    var index = 1")
    lines.append("    while index < length - 1 \{")
    lines.append("        var code = literal.byte_at(index)")
    lines.append("        if code == 92 \{")
    lines.append("            index = index + 2")
    lines.append("        } else if code == 123 \{")
    lines.append("            return true")
    lines.append("        } else \{")
    lines.append("            index = index + 1")
    lines.append("        }")
    lines.append("    }")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func symbol_of(literal: String): String \{")
    lines.append("    var length = literal.length()")
    lines.append("    return literal.slice(1, length - 1)")
    lines.append("}")
    lines.append("")
    lines.append("func fits(literal: String, kind_name: String): Boolean \{")
    lines.append("    switch kind_name \{")
    lines.append("        \"Integer\": return is_whole(literal) and _reads_as_an_integer(literal)")
    lines.append("        \"Long\": return is_whole(literal) and _reads_as_a_long(literal)")
    lines.append("        \"Double\": return is_whole(literal) or is_decimal(literal)")
    lines.append("        \"Float\": return is_whole(literal) or is_decimal(literal)")
    lines.append("        \"Boolean\": return is_boolean(literal)")
    lines.append("        \"String\": return is_text(literal)")
    lines.append("        \"enum\": return is_symbol(literal)")
    lines.append("        _: return false")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _reads_as_an_integer(literal: String): Boolean \{")
    lines.append("    var read = literal.to_integer()")
    lines.append("    if read \{")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    return false")
}

func add_the_prompt_part_7() {
    lines.append("}")
    lines.append("")
    lines.append("func _reads_as_a_long(literal: String): Boolean \{")
    lines.append("    var read = literal.to_long()")
    lines.append("    if read \{")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func integer_of(literal: String): Integer \{")
    lines.append("    var read = literal.to_integer()")
    lines.append("    crash read")
    lines.append("    return read")
    lines.append("}")
    lines.append("")
    lines.append("func long_of(literal: String): Long \{")
    lines.append("    var read = literal.to_long()")
    lines.append("    crash read")
    lines.append("    return read")
    lines.append("}")
    lines.append("")
    lines.append("func double_of(literal: String): Double \{")
    lines.append("    var read = literal.to_double()")
    lines.append("    crash read")
    lines.append("    return read")
    lines.append("}")
    lines.append("")
    lines.append("func float_of(literal: String): Float \{")
    lines.append("    var read = literal.to_float()")
    lines.append("    crash read")
    lines.append("    return read")
    lines.append("}")
    lines.append("")
    lines.append("func boolean_of(literal: String): Boolean \{")
    lines.append("    return literal == \"true\"")
    lines.append("}")
    lines.append("")
    lines.append("func article_of(class_name: String): String \{")
    lines.append("    var first = class_name.byte_at(0)")
    lines.append("    var is_a_vowel = first == 65 or first == 69 or first == 73 or first == 79 or first == 85")
    lines.append("    if is_a_vowel \{")
    lines.append("        return \"an \{class_name}\"")
    lines.append("    }")
    lines.append("    return \"a \{class_name}\"")
    lines.append("}")
    lines.append("")
    lines.append("func ends(at: Integer): Boolean \{")
    lines.append("    return at >= walking.count()")
    lines.append("}")
    lines.append("")
    lines.append("func assigns(at: Integer): Boolean \{")
    lines.append("    return mode == \"assign\" and at == walking.count() - 1")
    lines.append("}")
    lines.append("")
    lines.append("func step_kind(at: Integer): String \{")
    lines.append("    return walking.kind(at)")
    lines.append("}")
    lines.append("")
    lines.append("func step_name(at: Integer): String \{")
    lines.append("    return walking.name(at)")
    lines.append("}")
    lines.append("")
    lines.append("func shows(): Boolean \{")
    lines.append("    return mode == \"show\"")
    lines.append("}")
    lines.append("")
    lines.append("func lists_attributes(): Boolean \{")
    lines.append("    return mode == \"attributes\"")
    lines.append("}")
    lines.append("")
    lines.append("func lists_functions(): Boolean \{")
    lines.append("    return mode == \"functions\"")
    lines.append("}")
    lines.append("")
    lines.append("func is_fetching(): Boolean \{")
    lines.append("    return mode == \"fetch\"")
    lines.append("}")
    lines.append("")
    lines.append("func say(text: String) \{")
    lines.append("    _said(text)")
    lines.append("}")
    lines.append("")
    lines.append("func say_a_value(text: String, class_name: String) \{")
    lines.append("    _said(text)")
    lines.append("    answered_class = class_name")
    lines.append("}")
    lines.append("")
    lines.append("func fetch(value: Anything, class_name: String) \{")
    lines.append("    fetched = value")
    lines.append("    fetched_class = class_name")
    lines.append("}")
    lines.append("")
    lines.append("func fetch_null() \{")
    lines.append("    fetched_null = true")
    lines.append("    fetched_class = \"null\"")
    lines.append("}")
    lines.append("")
    lines.append("func reached_null(at: Integer) \{")
    lines.append("    if ends(at) and shows() \{")
    lines.append("        _said(\"null\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if ends(at) and is_fetching() \{")
    lines.append("        fetch_null()")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var held = walking.label(at)")
    lines.append("    if ends(at) \{")
    lines.append("        complain(\"\{held} is null, and a null has no \{mode}\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var next = walking.name(at)")
    lines.append("    complain(\"\{held} is null, so '\{next}' cannot be read from it\")")
    lines.append("}")
    lines.append("")
    lines.append("func refuse_bytes(at: Integer) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var last = walking.count() - 1")
    lines.append("    var reached_by_a_call = false")
}

func add_the_prompt_part_8() {
    lines.append("    var index = 0")
    lines.append("    while index <= last \{")
    lines.append("        if walking.kind(index) == \"call\" \{")
    lines.append("            reached_by_a_call = true")
    lines.append("        }")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    if reached_by_a_call \{")
    lines.append("        complain(\"'bytes \{walking.written}' names a value a call answers, which has no slot of its own: ask 'bytes' of the attribute or the object that holds it\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    complain(\"'bytes \{walking.written}' names \{held}, an entry of a dictionary, which the prompt reads through its dictionary: 'bytes' of the dictionary shows the dictionary\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_attribute(at: Integer, class_name: String, known: String) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var asked = walking.name(at)")
    lines.append("    var asked_kind = walking.kind(at)")
    lines.append("    if asked_kind == \"index\" \{")
    lines.append("        var described = article_of(class_name)")
    lines.append("        complain(\"\{held} is \{described}, which holds no elements: only a list or a dictionary is indexed\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if known.is_empty() \{")
    lines.append("        var described_class = article_of(class_name)")
    lines.append("        complain(\"\{held} is \{described_class}, which has no attributes\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    complain(\"no attribute '\{asked}' in \{held}: \{known}\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_attributes(at: Integer, class_name: String) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{held} is \{described}, which has no attributes\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_functions(at: Integer, class_name: String) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{held} is \{described}, which has no function the prompt can call\")")
    lines.append("}")
    lines.append("")
    lines.append("func library_class(at: Integer, class_name: String) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{held} is \{described}, a class of the standard library, which the prompt does not walk into\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_function(at: Integer) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var asked = walking.name(at)")
    lines.append("    if asked.starts_with(\"_\") \{")
    lines.append("        complain(\"'\{asked}' is private to \{held}, and the prompt calls what code outside the class may call\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    if asked == \"drop\" \{")
    lines.append("        complain(\"'drop' runs when \{held} is released, and the prompt never runs it\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    complain(\"no function '\{asked}' in \{held}: 'functions' lists them\")")
    lines.append("}")
    lines.append("")
    lines.append("func not_callable(at: Integer) \{")
    lines.append("    var typed = walking.typed(at + 1)")
    lines.append("    var length = typed.length()")
    lines.append("    var shown = typed.slice(0, length - 2)")
    lines.append("    complain(\"\{shown} is not callable\")")
    lines.append("}")
    lines.append("")
    lines.append("func takes(at: Integer, wanted: Integer): Boolean \{")
    lines.append("    var given = walking.argument_count(at)")
    lines.append("    if given == wanted \{")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    var asked = walking.name(at)")
    lines.append("    complain(\"'\{asked}' takes \{wanted} argument(s), and this call passes \{given}\")")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func argument_fits(at: Integer, index: Integer, parameter: String, kind_name: String, class_name: String): Boolean \{")
    lines.append("    var literal = walking.argument(at, index)")
    lines.append("    if fits(literal, kind_name) \{")
    lines.append("        if is_text(literal) and has_a_hole(literal) \{")
    lines.append("            _refuse_a_hole(literal)")
    lines.append("            return false")
    lines.append("        }")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"type mismatch: \{parameter} is \{described}, and \{literal} is not one\")")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func argument_text(at: Integer, index: Integer): String \{")
    lines.append("    return walking.argument(at, index)")
    lines.append("}")
    lines.append("")
    lines.append("func cannot_take(at: Integer) \{")
    lines.append("    var asked = walking.name(at)")
    lines.append("    var given = walking.arguments_text(at)")
    lines.append("    complain(\"'\{asked}' cannot take (\{given}): the loop writes numbers, Boolean, text and an enum's own values\")")
    lines.append("}")
    lines.append("")
    lines.append("func ran_nothing(at: Integer) \{")
    lines.append("    var typed = walking.typed(at + 1)")
    lines.append("    complain(\"\{typed} ran, and it answers nothing, so nothing can follow it\")")
    lines.append("}")
    lines.append("")
    lines.append("func answered_nothing(at: Integer) \{")
    lines.append("    var shown = ends(at + 1) and shows()")
    lines.append("    if not shown \{")
    lines.append("        ran_nothing(at)")
    lines.append("        return")
    lines.append("    }")
    lines.append("    answered_class = \"Nothing\"")
    lines.append("}")
    lines.append("")
    lines.append("func index_of_a_list(at: Integer, held_count: Integer): Integer? \{")
    lines.append("    var literal = walking.name(at)")
}

func add_the_prompt_part_9() {
    lines.append("    var held = walking.label(at)")
    lines.append("    var is_an_index = is_whole(literal) and _reads_as_an_integer(literal)")
    lines.append("    if not is_an_index \{")
    lines.append("        complain(\"\{held} is indexed by a whole number, and \{literal} is not one\")")
    lines.append("        return null")
    lines.append("    }")
    lines.append("    var index = integer_of(literal)")
    lines.append("    if index < 0 or index >= held_count \{")
    lines.append("        complain(\"index \{index} is out of range: \{held} holds \{held_count}\")")
    lines.append("        return null")
    lines.append("    }")
    lines.append("    return index")
    lines.append("}")
    lines.append("")
    lines.append("func key_fits(at: Integer, kind_name: String, class_name: String): Boolean \{")
    lines.append("    var literal = walking.name(at)")
    lines.append("    if fits(literal, kind_name) \{")
    lines.append("        if is_text(literal) and has_a_hole(literal) \{")
    lines.append("            _refuse_a_hole(literal)")
    lines.append("            return false")
    lines.append("        }")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    var held = walking.label(at)")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{held} is keyed by \{described}, and \{literal} is not one\")")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func key(at: Integer): String \{")
    lines.append("    return walking.name(at)")
    lines.append("}")
    lines.append("")
    lines.append("func no_key(at: Integer) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    var literal = walking.name(at)")
    lines.append("    complain(\"\{held} holds no key \{literal}\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_keys(at: Integer) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    complain(\"\{held} holds no keys\")")
    lines.append("}")
    lines.append("")
    lines.append("func assigns_null(): Boolean \{")
    lines.append("    return assigned_kind == \"null\" or assigned_kind == \"path\" and fetched_null")
    lines.append("}")
    lines.append("")
    lines.append("func assigns_a_literal(): Boolean \{")
    lines.append("    return assigned_kind == \"literal\"")
    lines.append("}")
    lines.append("")
    lines.append("func literal_fits(kind_name: String, class_name: String): Boolean \{")
    lines.append("    if fits(assigned, kind_name) \{")
    lines.append("        if is_text(assigned) and has_a_hole(assigned) \{")
    lines.append("            _refuse_a_hole(assigned)")
    lines.append("            return false")
    lines.append("        }")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    mismatch(class_name)")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func mismatch(class_name: String) \{")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"type mismatch: \{target.written} is \{described}, and \{assigned} is not one\")")
    lines.append("}")
    lines.append("")
    lines.append("func never_null(class_name: String) \{")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{target.written} is \{described}, which is never null: only a T? holds null\")")
    lines.append("}")
    lines.append("")
    lines.append("func wrong_instance(class_name: String) \{")
    lines.append("    var found = article_of(fetched_class)")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{target.written} is \{described}, and \{source.written} is \{found}: the loop assigns an instance of the attribute's own class\")")
    lines.append("}")
    lines.append("")
    lines.append("func not_a_value(class_name: String) \{")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{assigned} is not \{described}, or \{target.written} cannot be assigned\")")
    lines.append("}")
    lines.append("")
    lines.append("func assigned_text(): String \{")
    lines.append("    return text_of(assigned)")
    lines.append("}")
    lines.append("")
    lines.append("func assigned_symbol(): String \{")
    lines.append("    return symbol_of(assigned)")
    lines.append("}")
    lines.append("")
    lines.append("func _refuse_a_hole(literal: String) \{")
    lines.append("    complain(\"\{literal} has a hole, and the prompt reads a text literal as it is written: \\\\\\\{ writes a brace, and 'eval' makes text from values\")")
    lines.append("}")
    lines.append("")
    lines.append("func bound_without_arguments(at: Integer, class_name: String): Boolean \{")
    lines.append("    var given = walking.argument_count(at)")
    lines.append("    if given == 0 \{")
    lines.append("        return true")
    lines.append("    }")
    lines.append("    complain(\"'\{class_name}' is a singleton made without arguments, so it takes none: \{class_name}()\")")
    lines.append("    return false")
    lines.append("}")
    lines.append("")
    lines.append("func not_a_singleton(at: Integer) \{")
    lines.append("    var asked = walking.name(at)")
    lines.append("    var makes_the_assigned = mode == \"fetch\" and at == 0 and walking.count() == 1")
    if hot_reload {
        lines.append("    if makes_the_assigned \{")
        lines.append("        _construct_into_the_target()")
        lines.append("        return")
        lines.append("    }")
    }
    lines.append("    if makes_the_assigned \{")
    lines.append("        complain(\"'\{target.written} = \{assigned}' makes an object, which answers in a program built with --hot-reload and --repl-port: the construction is compiled into the running program, which the remote REPL then calls\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    complain(\"'\{asked}' is a class, not a singleton: the prompt never makes an object, it reads the ones the program holds, and 'classes' lists the singletons\")")
    lines.append("}")
    lines.append("")
    lines.append("func no_singleton(at: Integer) \{")
    lines.append("    var asked = walking.name(at)")
    lines.append("    complain(\"no singleton '\{asked}' in the program: 'classes' lists them\")")
    lines.append("}")
}

func add_the_prompt_part_10() {
    lines.append("")
    lines.append("func shared_singleton(at: Integer, sharing: String) \{")
    lines.append("    var asked = walking.name(at)")
    lines.append("    complain(\"'\{asked}' names more than one singleton: \{sharing}; name one by its whole name\")")
    lines.append("}")
    lines.append("")
    lines.append("func opaque(at: Integer, class_name: String) \{")
    lines.append("    var held = walking.label(at)")
    lines.append("    if ends(at) and shows() \{")
    lines.append("        _said(\"\{class_name} \\\{...}\")")
    lines.append("        return")
    lines.append("    }")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{held} is \{described}, which the prompt cannot read into\")")
    lines.append("}")
    lines.append("")
    lines.append("func unwritable(class_name: String) \{")
    lines.append("    var described = article_of(class_name)")
    lines.append("    complain(\"\{target.written} is \{described}, and the loop writes Integer, Long, Double, Float, Boolean, text and an enum's own values\")")
    lines.append("}")
}

func add_the_path_part_1() {
    lines.append("var written = \"\"")
    lines.append("var kinds = List<String>()")
    lines.append("var names = List<String>()")
    lines.append("var labels = List<String>()")
    lines.append("var typed_texts = List<String>()")
    lines.append("var first_arguments = List<Integer>()")
    lines.append("var argument_counts = List<Integer>()")
    lines.append("var arguments = List<String>()")
    lines.append("var problem = \"\"")
    lines.append("")
    lines.append("func read(text: String) \{")
    lines.append("    written = text.trim()")
    lines.append("    kinds = List<String>()")
    lines.append("    names = List<String>()")
    lines.append("    labels = List<String>()")
    lines.append("    typed_texts = List<String>()")
    lines.append("    first_arguments = List<Integer>()")
    lines.append("    argument_counts = List<Integer>()")
    lines.append("    arguments = List<String>()")
    lines.append("    problem = \"\"")
    lines.append("    var length = written.length()")
    lines.append("    var at = 0")
    lines.append("    var expects_a_name = true")
    lines.append("    while at < length and problem.is_empty() \{")
    lines.append("        if expects_a_name \{")
    lines.append("            at = _read_a_name(at)")
    lines.append("            expects_a_name = false")
    lines.append("        } else \{")
    lines.append("            at = _read_after_a_step(at)")
    lines.append("            expects_a_name = at < 0")
    lines.append("            if at < 0 \{")
    lines.append("                at = 0 - at")
    lines.append("            }")
    lines.append("        }")
    lines.append("    }")
    lines.append("    if expects_a_name and length > 0 and problem.is_empty() \{")
    lines.append("        _refuse()")
    lines.append("    }")
    lines.append("    _leave_out_the_program()")
    lines.append("}")
    lines.append("")
    lines.append("func count(): Integer \{")
    lines.append("    return kinds.count()")
    lines.append("}")
    lines.append("")
    lines.append("func kind(at: Integer): String \{")
    lines.append("    var found = kinds[at]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func name(at: Integer): String \{")
    lines.append("    var found = names[at]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func label(at: Integer): String \{")
    lines.append("    if at == 0 \{")
    lines.append("        return \"program\"")
    lines.append("    }")
    lines.append("    var found = labels[at - 1]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func typed(at: Integer): String \{")
    lines.append("    if at == 0 \{")
    lines.append("        return \"program\"")
    lines.append("    }")
    lines.append("    var found = typed_texts[at - 1]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func argument_count(at: Integer): Integer \{")
    lines.append("    var found = argument_counts[at]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func argument(at: Integer, index: Integer): String \{")
    lines.append("    var first = first_arguments[at]")
    lines.append("    crash first")
    lines.append("    var found = arguments[first + index]")
    lines.append("    crash found")
    lines.append("    return found")
    lines.append("}")
    lines.append("")
    lines.append("func arguments_text(at: Integer): String \{")
    lines.append("    var pieces = List<String>()")
    lines.append("    var index = 0")
    lines.append("    while index < argument_count(at) \{")
    lines.append("        var piece = argument(at, index)")
    lines.append("        pieces.append(piece)")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("    return pieces.join(\", \")")
    lines.append("}")
    lines.append("")
    lines.append("func _refuse() \{")
    lines.append("    problem = \"'\{written}' is not a path the prompt reads: a path is names, [index] and calls with literal arguments, such as player.health or monsters[0].roar()\"")
    lines.append("}")
    lines.append("")
    lines.append("func _leave_out_the_program() \{")
    lines.append("    assert not kinds.is_empty() and problem.is_empty()")
    lines.append("    var first_kind = kind(0)")
    lines.append("    var first_name = name(0)")
    lines.append("    if first_kind == \"name\" and first_name == \"program\" \{")
    lines.append("        kinds.remove_at(0)")
    lines.append("        names.remove_at(0)")
    lines.append("        labels.remove_at(0)")
    lines.append("        typed_texts.remove_at(0)")
    lines.append("        first_arguments.remove_at(0)")
    lines.append("        argument_counts.remove_at(0)")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _read_a_name(start: Integer): Integer \{")
    lines.append("    var length = written.length()")
}

func add_the_path_part_2() {
    lines.append("    var code = written.byte_at(start)")
    lines.append("    var is_capital = code >= 65 and code <= 90")
    lines.append("    var end = _name_end(start)")
    lines.append("    if end == start \{")
    lines.append("        _refuse()")
    lines.append("        return length")
    lines.append("    }")
    lines.append("    if is_capital \{")
    lines.append("        return _read_a_class_name(start, end)")
    lines.append("    }")
    lines.append("    var read_name = written.slice(start, end)")
    lines.append("    if end < length and written.byte_at(end) == 40 \{")
    lines.append("        var closing = _closing_of(end, 40, 41)")
    lines.append("        if closing < 0 \{")
    lines.append("            _refuse()")
    lines.append("            return length")
    lines.append("        }")
    lines.append("        _add_call(\"call\", read_name, end + 1, closing)")
    lines.append("        return closing + 1")
    lines.append("    }")
    lines.append("    _add(\"name\", read_name, read_name)")
    lines.append("    return end")
    lines.append("}")
    lines.append("")
    lines.append("func _read_a_class_name(start: Integer, first_end: Integer): Integer \{")
    lines.append("    var length = written.length()")
    lines.append("    var end = first_end")
    lines.append("    var keeps_going = true")
    lines.append("    while keeps_going and end + 1 < length and written.byte_at(end) == 46 \{")
    lines.append("        var next = written.byte_at(end + 1)")
    lines.append("        if next >= 65 and next <= 90 \{")
    lines.append("            end = _name_end(end + 1)")
    lines.append("        } else \{")
    lines.append("            keeps_going = false")
    lines.append("        }")
    lines.append("    }")
    lines.append("    if end < length and written.byte_at(end) == 60 \{")
    lines.append("        var closing_angle = _closing_of(end, 60, 62)")
    lines.append("        if closing_angle < 0 \{")
    lines.append("            _refuse()")
    lines.append("            return length")
    lines.append("        }")
    lines.append("        end = closing_angle + 1")
    lines.append("    }")
    lines.append("    var class_name = written.slice(start, end)")
    lines.append("    var without_spaces = class_name.replace(\" \", \"\")")
    lines.append("    var opens_a_call = end < length and written.byte_at(end) == 40")
    lines.append("    if not opens_a_call or not kinds.is_empty() \{")
    lines.append("        _refuse()")
    lines.append("        return length")
    lines.append("    }")
    lines.append("    var closing = _closing_of(end, 40, 41)")
    lines.append("    if closing < 0 \{")
    lines.append("        _refuse()")
    lines.append("        return length")
    lines.append("    }")
    lines.append("    _add_call(\"singleton\", without_spaces, end + 1, closing)")
    lines.append("    return closing + 1")
    lines.append("}")
    lines.append("")
    lines.append("func _read_after_a_step(start: Integer): Integer \{")
    lines.append("    var length = written.length()")
    lines.append("    var code = written.byte_at(start)")
    lines.append("    if code == 46 \{")
    lines.append("        return 0 - (start + 1)")
    lines.append("    }")
    lines.append("    if code == 91 \{")
    lines.append("        var closing = _closing_of(start, 91, 93)")
    lines.append("        if closing < 0 \{")
    lines.append("            _refuse()")
    lines.append("            return length")
    lines.append("        }")
    lines.append("        var inside = written.slice(start + 1, closing)")
    lines.append("        var index_text = inside.trim()")
    lines.append("        var step_count = kinds.count()")
    lines.append("        var before = label(step_count)")
    lines.append("        var shown = \"\{before}[\{index_text}]\"")
    lines.append("        kinds.append(\"index\")")
    lines.append("        names.append(index_text)")
    lines.append("        labels.append(shown)")
    lines.append("        var typed_before = _typed_so_far()")
    lines.append("        typed_texts.append(\"\{typed_before}[\{index_text}]\")")
    lines.append("        var no_arguments = arguments.count()")
    lines.append("        first_arguments.append(no_arguments)")
    lines.append("        argument_counts.append(0)")
    lines.append("        return closing + 1")
    lines.append("    }")
    lines.append("    _refuse()")
    lines.append("    return length")
    lines.append("}")
    lines.append("")
    lines.append("func _typed_so_far(): String \{")
    lines.append("    if typed_texts.is_empty() \{")
    lines.append("        return \"\"")
    lines.append("    }")
    lines.append("    var last = typed_texts.last()")
    lines.append("    crash last")
    lines.append("    return last")
    lines.append("}")
    lines.append("")
    lines.append("func _add(added_kind: String, added_name: String, shown: String) \{")
    lines.append("    var typed_before = _typed_so_far()")
    lines.append("    var typed_now = shown")
    lines.append("    if not typed_before.is_empty() \{")
    lines.append("        typed_now = \"\{typed_before}.\{shown}\"")
    lines.append("    }")
    lines.append("    kinds.append(added_kind)")
    lines.append("    names.append(added_name)")
    lines.append("    labels.append(shown)")
    lines.append("    typed_texts.append(typed_now)")
    lines.append("    var first_argument = arguments.count()")
    lines.append("    first_arguments.append(first_argument)")
    lines.append("    argument_counts.append(0)")
    lines.append("}")
    lines.append("")
    lines.append("func _add_call(added_kind: String, added_name: String, start: Integer, end: Integer) \{")
    lines.append("    var shown = \"\{added_name}()\"")
    lines.append("    if added_kind == \"singleton\" \{")
    lines.append("        shown = added_name")
    lines.append("    }")
}

func add_the_path_part_3() {
    lines.append("    _add(added_kind, added_name, shown)")
    lines.append("    if added_kind == \"singleton\" \{")
    lines.append("        var last = typed_texts.count() - 1")
    lines.append("        typed_texts[last] = \"\{added_name}()\"")
    lines.append("    }")
    lines.append("    var inside = written.slice(start, end)")
    lines.append("    var trimmed = inside.trim()")
    lines.append("    assert not trimmed.is_empty()")
    lines.append("    var pieces = _split_arguments(trimmed)")
    lines.append("    var last_count = argument_counts.count() - 1")
    lines.append("    argument_counts[last_count] = pieces.count()")
    lines.append("    var index = 0")
    lines.append("    while index < pieces.count() \{")
    lines.append("        var piece = pieces[index]")
    lines.append("        crash piece")
    lines.append("        var argument_text = piece.trim()")
    lines.append("        if argument_text.is_empty() \{")
    lines.append("            _refuse()")
    lines.append("        }")
    lines.append("        arguments.append(argument_text)")
    lines.append("        index = index + 1")
    lines.append("    }")
    lines.append("}")
    lines.append("")
    lines.append("func _split_arguments(inside: String): List<String> \{")
    lines.append("    var pieces = List<String>()")
    lines.append("    var length = inside.length()")
    lines.append("    var piece_start = 0")
    lines.append("    var quote = 0")
    lines.append("    var depth = 0")
    lines.append("    var index = 0")
    lines.append("    while index < length \{")
    lines.append("        var code = inside.byte_at(index)")
    lines.append("        var step = _step_at(code, quote)")
    lines.append("        var was_outside = quote == 0")
    lines.append("        quote = _quote_after(code, quote)")
    lines.append("        if was_outside and quote == 0 \{")
    lines.append("            depth = _depth_after(code, depth)")
    lines.append("        }")
    lines.append("        var splits = was_outside and code == 44 and depth == 0")
    lines.append("        if splits \{")
    lines.append("            var piece = inside.slice(piece_start, index)")
    lines.append("            pieces.append(piece)")
    lines.append("            piece_start = index + 1")
    lines.append("        }")
    lines.append("        index = index + step")
    lines.append("    }")
    lines.append("    var rest = inside.slice(piece_start, length)")
    lines.append("    pieces.append(rest)")
    lines.append("    return pieces")
    lines.append("}")
    lines.append("")
    lines.append("func _step_at(code: Integer, quote: Integer): Integer \{")
    lines.append("    if quote != 0 and code == 92 \{")
    lines.append("        return 2")
    lines.append("    }")
    lines.append("    return 1")
    lines.append("}")
    lines.append("")
    lines.append("func _quote_after(code: Integer, quote: Integer): Integer \{")
    lines.append("    var opens = quote == 0 and (code == 34 or code == 39)")
    lines.append("    if opens \{")
    lines.append("        return code")
    lines.append("    }")
    lines.append("    if code == quote \{")
    lines.append("        return 0")
    lines.append("    }")
    lines.append("    return quote")
    lines.append("}")
    lines.append("")
    lines.append("func _depth_after(code: Integer, depth: Integer): Integer \{")
    lines.append("    if code == 40 or code == 91 or code == 60 \{")
    lines.append("        return depth + 1")
    lines.append("    }")
    lines.append("    if code == 41 or code == 93 or code == 62 \{")
    lines.append("        return depth - 1")
    lines.append("    }")
    lines.append("    return depth")
    lines.append("}")
    lines.append("")
    lines.append("func _name_end(start: Integer): Integer \{")
    lines.append("    var length = written.length()")
    lines.append("    var end = start")
    lines.append("    var keeps_going = end < length")
    lines.append("    while keeps_going \{")
    lines.append("        var code = written.byte_at(end)")
    lines.append("        keeps_going = _is_a_name_code(code)")
    lines.append("        if keeps_going \{")
    lines.append("            end = end + 1")
    lines.append("            keeps_going = end < length")
    lines.append("        }")
    lines.append("    }")
    lines.append("    return end")
    lines.append("}")
    lines.append("")
    lines.append("func _is_a_name_code(code: Integer): Boolean \{")
    lines.append("    var is_lower = code >= 97 and code <= 122")
    lines.append("    var is_upper = code >= 65 and code <= 90")
    lines.append("    var is_digit = code >= 48 and code <= 57")
    lines.append("    return is_lower or is_upper or is_digit or code == 95")
    lines.append("}")
    lines.append("")
    lines.append("func _closing_of(start: Integer, opening: Integer, closing: Integer): Integer \{")
    lines.append("    var length = written.length()")
    lines.append("    var depth = 0")
    lines.append("    var quote = 0")
    lines.append("    var index = start")
    lines.append("    while index < length \{")
    lines.append("        var code = written.byte_at(index)")
    lines.append("        var step = _step_at(code, quote)")
    lines.append("        var was_outside = quote == 0")
    lines.append("        quote = _quote_after(code, quote)")
    lines.append("        var counts = was_outside and quote == 0")
    lines.append("        if counts and code == opening \{")
    lines.append("            depth = depth + 1")
    lines.append("        }")
    lines.append("        if counts and code == closing \{")
    lines.append("            depth = depth - 1")
    lines.append("        }")
    lines.append("        if counts and code == closing and depth == 0 \{")
}

func add_the_path_part_4() {
    lines.append("            return index")
    lines.append("        }")
    lines.append("        index = index + step")
    lines.append("    }")
    lines.append("    return -1")
    lines.append("}")
}

func path_source(): String {
    lines = List<String>()
    add_the_path_part_1()
    add_the_path_part_2()
    add_the_path_part_3()
    add_the_path_part_4()
    return lines.join("\n")
}

# ../../../../spite_spec/specs/repl.md#command-language
func code_source(entry_shown: String, typed: String): String {
    var code_lines = List<String>()
    code_lines.append("singleton")
    code_lines.append("")
    var word = ""
    var code = ""
    var break_at = typed.index_of("\n")
    if break_at {
        word = typed.slice(0, break_at)
        var typed_length = typed.length()
        var after = typed.slice(break_at + 1, typed_length)
        code = after.trim()
    }
    var parameter = "_program"
    if code.contains("program") {
        parameter = "program"
    }
    code_lines.append("func answer({parameter}: {entry_shown}): String \{")
    if word == "eval" {
        code_lines.append("    var value = {code}")
        code_lines.append("    return \"\{value}\"")
    } else if word == "run" {
        code_lines.append("    {code}")
        code_lines.append("    return \"\"")
    } else {
        code_lines.append("    return \"\"")
    }
    code_lines.append("}")
    return code_lines.join("\n")
}

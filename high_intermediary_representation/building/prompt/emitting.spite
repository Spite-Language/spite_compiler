var state = SourceState()

func Emitting(starting_state: SourceState) {
    state = starting_state
}

func out(depth: Integer, text: String) {
    var indent = ""
    var level = 0
    while level < depth {
        indent = "{indent}    "
        level = level + 1
    }
    state.lines.append("{indent}{text}")
}

func blank() {
    state.lines.append("")
}

# ../../../../spite_documentation/repl.md#the-wire-protocol
func declare(name: String, declaration: String, meaning: String) {
    fallback not state.intrinsics.contains(name)
    state.intrinsics[name] = meaning
    state.intrinsic_lines.append(declaration)
}

func reads_remotely(): Boolean {
    return state.port > 0
}

func write_switch(depth: Integer, subject: String, cases: List<String>, statements: List<String>, otherwise: String) {
    var naming = Naming()
    if cases.count() < 2 {
        write_ifs(depth, subject, cases, statements, otherwise)
        return
    }
    out(depth, "switch {subject} \{")
    var index = 0
    while index < cases.count() {
        var matched = cases[index]
        var statement = statements[index]
        crash statement
        var written = naming.escaped(matched)
        out(depth + 1, "\"{written}\": {statement}")
        index = index + 1
    }
    out(depth + 1, "_: {otherwise}")
    out(depth, "}")
}

func write_ifs(depth: Integer, subject: String, cases: List<String>, statements: List<String>, otherwise: String) {
    var naming = Naming()
    var index = 0
    while index < cases.count() {
        var matched = cases[index]
        var statement = statements[index]
        crash statement
        var written = naming.escaped(matched)
        out(depth, "if {subject} == \"{written}\" \{")
        out(depth + 1, statement)
        if not statement.starts_with("return") {
            out(depth + 1, "return")
        }
        out(depth, "}")
        index = index + 1
    }
    out(depth, otherwise)
}

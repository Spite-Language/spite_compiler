var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func NamedStorage(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func read_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var reads = Reads(context, values)
    var object = object_of(member)
    fallback object
    var attribute = attribute_of(member, object)
    fallback attribute
    var read = HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
    var path = path_of(member, attribute)
    return reads.narrowed(read, path)
}

# ../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func object_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var literals = Literals(context, values)
    var index = index_of(member)
    fallback index
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback listed.name == "attributes" and not context.scope.internal_name_of("attributes")
        var own = literals.this_value()
        fallback own.value_type.kind == 'object'
        return own
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback listed.name == "attributes"
        var instance = listed.target
        fallback instance.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
        fallback context.scope.internal_name_of(instance.name)
        var item = values.value_of(instance, null)
        fallback item.value_type.kind == 'object' and not item.value_type.is_nullable
        return item
    }
    return null
}

func index_of(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): AbstractSyntaxTree.Shapes.Expressions.IndexExpression? {
    fallback member.name == "value"
    var indexed = member.target
    if indexed.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return indexed
    }
    return null
}

# ../../../spite_documentation/functions_and_operators.md#the-storage-behind-the-accessors
func attribute_of(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    object: SpiteCompiler.Value,
): Model.AttributeModel? {
    var index = index_of(member)
    fallback index
    fallback context.has_a_class(object.value_type)
    var name = values.known_key_name_of(index.index)
    fallback name
    var model = context.class_of(object.value_type)
    fallback not model.attribute_named("attributes") and not model.function_named("get_attributes")
    var is_outside = model.key != context.current_class.key
    fallback not is_outside or not name.starts_with("_")
    return model.attribute_named(name)
}

func path_of(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, attribute: Model.AttributeModel): String {
    var index = index_of(member)
    crash index
    var listed = index.target
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash listed.target
        var printer = Printers.Spite.ExpressionPrinter(listed.target)
        var instance = printer.text()
        return "{instance}.{attribute.name}"
    }
    return "this.{attribute.name}"
}

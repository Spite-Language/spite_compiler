var state = StatementsState()

func Loops(starting_state: StatementsState) {
    state = starting_state
}

func build_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var statements = Statements(state)
    fallback not renewed_the_lists(statement)
    state.template_walks.check(state.context, statement)
    statements.note_a_loop_copy(statement.condition)
    statements.note_a_maybe_boolean(statement.condition, statement.condition)
    var base = state.context.scope.narrowed.count()
    state.context.loop_bases.append(base)
    var log_start = state.context.logged_calls.count()
    var reads_start = state.context.narrowed_reads.count()
    var written_condition = statement.condition
    var build_reads_before = state.context.folded_build_reads
    var condition = state.values.condition_of(statement.condition)
    statements.note_a_check_of_a_proven_value(written_condition, condition, "while")
    statements.note_a_decided_condition(condition, "while", written_condition, build_reads_before)
    var condition_work = state.context.pending
    state.context.pending = List<SpiteCompiler.Statement>()
    var condition_start = state.context.logged_calls.count()
    condition_work.each(statements.log_the_calls_of)
    statements.log_a_value(condition, statement.line)
    state.facts_paths = List<String>()
    state.facts_types = List<Model.Type>()
    state.facts_checks = List<String>()
    state.facts_before_a_call = List<String>()
    read_a_bound(statement.condition)
    read_a_present_path(statement.condition)
    var paths = state.facts_paths
    var types = state.facts_types
    var notes = state.facts_checks
    var check = statements.checking_text("while", statement.condition, statement.line)
    var noted = statements.notes_with(paths, notes, check)
    var body = statements.loop_body_of(statement.body, paths, types, noted)
    statements.extend_the_reads_over_the_loop(log_start, reads_start)
    crash state.context.loop_bases.remove_last()
    if state.context.loop_bases.is_empty() {
        state.context.loop_reads = List<String>()
    }
    if condition_work.is_empty() {
        var made = HighIntermediaryRepresentation.Statements.While(condition, body)
        made.line = statement.line
        statements.add(made)
    } else {
        add_a_loop_whose_condition_works(condition_work, condition, body, statement.line)
    }
}

# ../../ARCHITECTURE.md#work-a-condition-needs-runs-where-the-condition-reaches-it
func add_a_loop_whose_condition_works(
    work: List<SpiteCompiler.Statement>,
    condition: SpiteCompiler.Value,
    body: HighIntermediaryRepresentation.Statements.Block,
    line: Integer,
) {
    var statements = Statements(state)
    var boolean = state.context.boolean()
    state.values.temporary_count = state.values.temporary_count + 1
    var going = state.context.scope.declare("going_{state.values.temporary_count}", boolean)
    var entering = HighIntermediaryRepresentation.Values.WholeNumber(boolean, 1)
    var started = HighIntermediaryRepresentation.Statements.Declare(going, boolean, entering)
    started.line = line
    statements.add(started)
    var decided = HighIntermediaryRepresentation.Statements.Assign.Assign(going, condition)
    decided.line = line
    var tested = HighIntermediaryRepresentation.Values.LocalRead(boolean, going)
    var entered = HighIntermediaryRepresentation.Statements.If(tested, body, null)
    entered.line = line
    var round = HighIntermediaryRepresentation.Statements.Block()
    round.statements = work
    round.statements.append(decided)
    round.statements.append(entered)
    round.line = line
    var going_on = HighIntermediaryRepresentation.Values.LocalRead(boolean, going)
    var made = HighIntermediaryRepresentation.Statements.While(going_on, round)
    made.line = line
    statements.add(made)
}

func called_alone(statement: SpiteCompiler.WrittenStatement): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var plain = value.arguments.is_empty() and value.generic_arguments.is_empty()
            if plain {
                return value
            }
        }
    }
    return null
}

# ../../OPTIMIZATIONS.md#a-list-of-lists-cleared-and-filled-with-new-lists-keeps-their-room
func renewed_by_a_loop(
    written: List<SpiteCompiler.WrittenStatement>,
    clear_index: Integer,
): AbstractSyntaxTree.Shapes.Statements.WhileStatement? {
    var clearing = written[clear_index]
    fallback clearing
    var list_name = cleared_list_of(clearing)
    fallback not list_name.is_empty()
    var next_index = clear_index + 1
    var declared = ""
    var between = written[next_index]
    if between and between.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        fallback not between.declared_type and is_a_fixed_bound(between.value)
        declared = between.name
        next_index = next_index + 1
    }
    var looping = written[next_index]
    if looping and looping.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        var refilled = refills_with_new_lists(looping, list_name, declared)
        if refilled {
            return looping
        }
    }
    return null
}

func cleared_list_of(statement: SpiteCompiler.WrittenStatement): String {
    var cleared = called_alone(statement)
    fallback cleared
    var callee = cleared.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and callee.name == "clear" {
        return name_of(callee.target)
    }
    return ""
}

func refills_with_new_lists(
    loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    list_name: String,
    declared: String,
): Boolean {
    var condition = loop.condition
    fallback loop.body
    fallback loop.body.statements.count() == 3
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var counter = name_of(condition.left)
        fallback condition.operator == 'less' and not counter.is_empty() and counter != list_name
        fallback is_a_fixed_bound(condition.right)
        fallback counter == declared or counts_whole_numbers(counter)
        return refills_in(loop.body, list_name, counter)
    }
    return false
}

func refills_in(body: AbstractSyntaxTree.Shapes.Statements.Block, list_name: String, counter: String): Boolean {
    var making = body.statements[0]
    var appending = body.statements[1]
    var stepping = body.statements[2]
    crash making
    crash appending
    crash stepping
    fallback steps_by_one(stepping, counter)
    if making.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        var made_name = making.name
        fallback not making.declared_type and made_name != list_name and made_name != counter
        fallback appends_the_made(appending, list_name, made_name)
        return makes_an_empty_item_of(making.value, list_name)
    }
    return false
}

func appends_the_made(statement: SpiteCompiler.WrittenStatement, list_name: String, made_name: String): Boolean {
    var appended = called_with_one(statement)
    fallback appended
    var callee = appended.callee
    var passed = appended.arguments.first()
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var on_the_list = callee.name == "append" and name_of(callee.target) == list_name
        return on_the_list and name_of(passed) == made_name
    }
    return false
}

func called_with_one(statement: SpiteCompiler.WrittenStatement): AbstractSyntaxTree.Shapes.Expressions.CallExpression? {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        var value = statement.value
        if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            var one = value.arguments.count() == 1 and value.generic_arguments.is_empty()
            if one {
                return value
            }
        }
    }
    return null
}

func makes_an_empty_item_of(made: SpiteCompiler.Expression?, list_name: String): Boolean {
    if made.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        fallback made.arguments.is_empty() and not made.generic_arguments.is_empty()
        var item_type = renewed_item_type_of(list_name)
        fallback item_type
        var path = state.values.class_path_of(made.callee)
        fallback not path.is_empty()
        var made_type = state.context.resolver.types.class_type_in(
            path,
            made.generic_arguments,
            state.context.current_class,
            state.context.line,
        )
        return made_type.kind == 'object' and made_type.name == item_type.name
    }
    return false
}

func renewed_item_type_of(list_name: String): Model.Type? {
    var list_type = type_of_a_name(list_name)
    fallback list_type
    fallback list_type.kind == 'object' and not list_type.is_nullable and state.context.has_a_class(list_type)
    var list_class = state.context.class_of(list_type)
    var forms = HeldOnceForms(state.context, state.values)
    fallback forms.is_a_list(list_class)
    var item_type = list_class.bound_types["$element_type"]
    fallback item_type
    fallback item_type.kind == 'object' and not item_type.is_nullable and state.context.has_a_class(item_type)
    var item_class = state.context.class_of(item_type)
    if forms.is_a_list(item_class) {
        return item_type
    }
    return null
}

func renewed_the_lists(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement): Boolean {
    var clear_index = state.context.block_index - 1
    var before = state.context.block_statements[clear_index]
    if before and before.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        clear_index = clear_index - 1
    }
    fallback clear_index >= 0
    var renewed = renewed_by_a_loop(state.context.block_statements, clear_index)
    fallback renewed and renewed.line == statement.line
    var clearing = state.context.block_statements[clear_index]
    crash clearing
    var list_name = cleared_list_of(clearing)
    var condition = statement.condition
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        crash condition.right
        build_the_renewal(statement, condition, list_name, condition.right)
        return true
    }
    return false
}

func build_the_renewal(
    statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    list_name: String,
    bound: SpiteCompiler.Expression,
) {
    var statements = Statements(state)
    var counter = name_of(condition.left)
    var counted = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var wanted = AbstractSyntaxTree.Shapes.Expressions.BinaryExpression(bound, 'minus', counted)
    var renewing_arguments = List<SpiteCompiler.Expression>()
    renewing_arguments.append(wanted)
    var no_generics = List<AbstractSyntaxTree.Shapes.Types.GenericArgument>()
    var renewed_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var renewing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(renewed_list, "clear")
    var renewing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(
        renewing_callee,
        no_generics,
        renewing_arguments,
    )
    var renewal = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(renewing)
    renewal.line = statement.line
    var finished_counter = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(counter)
    var finishing = AbstractSyntaxTree.Shapes.Statements.AssignmentStatement(finished_counter, bound)
    finishing.line = statement.line
    var inside = List<SpiteCompiler.WrittenStatement>()
    inside.append(renewal)
    inside.append(finishing)
    var then_block = AbstractSyntaxTree.Shapes.Statements.Block(inside)
    then_block.line = statement.line
    then_block.end_line = statement.line
    var cleared_list = AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression(list_name)
    var clearing_callee = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(cleared_list, "clear")
    var no_arguments = List<SpiteCompiler.Expression>()
    var clearing = AbstractSyntaxTree.Shapes.Expressions.CallExpression(clearing_callee, no_generics, no_arguments)
    var cleared = AbstractSyntaxTree.Shapes.Statements.ExpressionStatement(clearing)
    cleared.line = statement.line
    var otherwise = List<SpiteCompiler.WrittenStatement>()
    otherwise.append(cleared)
    var else_block = AbstractSyntaxTree.Shapes.Statements.Block(otherwise)
    else_block.line = statement.line
    else_block.end_line = statement.line
    var once = AbstractSyntaxTree.Shapes.Statements.IfStatement(condition, then_block, else_block)
    once.line = statement.line
    state.context.renews_the_lists = true
    statements.build(once)
    state.context.renews_the_lists = false
}

func name_of(expression: SpiteCompiler.Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name
    }
    return ""
}

func counts_whole_numbers(counter: String): Boolean {
    var counter_type = type_of_a_name(counter)
    fallback counter_type
    return counter_type.kind == 'scalar' and counter_type.name == "Integer" and not counter_type.is_nullable
}

func is_a_fixed_bound(bound: SpiteCompiler.Expression?): Boolean {
    if bound.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return bound.kind == 'integer_literal'
    }
    return false
}

func steps_by_one(statement: SpiteCompiler.WrittenStatement, counter: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target_name = name_of(statement.target)
        return target_name == counter and adds_one_to(statement.value, counter)
    }
    return false
}

func adds_one_to(value: SpiteCompiler.Expression?, counter: String): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var added_to = name_of(value.left)
        return added_to == counter and value.operator == 'plus' and is_one(value.right)
    }
    return false
}

func is_one(step: SpiteCompiler.Expression?): Boolean {
    if step.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return step.kind == 'integer_literal' and step.text == "1"
    }
    return false
}

func type_of_a_name(name: String): Model.Type? {
    var internal_name = state.context.scope.internal_name_of(name)
    if internal_name {
        return state.context.scope.type_of(internal_name)
    }
    var attribute = state.context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func read_a_present_path(condition: SpiteCompiler.Expression?) {
    var statements = Statements(state)
    var is_a_path = condition.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    is_a_path = is_a_path or condition.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback is_a_path
    statements.read_a_fact(condition)
}

func read_a_bound(condition: SpiteCompiler.Expression?) {
    if condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_binary_bound(condition)
    }
}

func read_a_binary_bound(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var statements = Statements(state)
    if condition.operator == 'and' {
        read_a_bound(condition.left)
        read_a_bound(condition.right)
        return
    }
    if condition.operator == 'less_or_equal' {
        statements.read_a_bound_at_most(condition)
        return
    }
    var left = condition.left
    var counts = condition.operator == 'equal_equal' or condition.operator == 'greater_or_equal'
    counts = counts or condition.operator == 'greater' or condition.operator == 'not_equal'
    if counts and left.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        statements.read_a_count_fact(condition, left)
        return
    }
    var counted = condition.right
    fallback condition.operator == 'less'
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_windowed_counter(condition)
        read_a_counted_local(condition, counted)
    }
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        read_a_lowered_count(condition, counted)
    }
}

# ../../PROOFS.md#an-index-offset-by-a-base-is-proven-by-one-guard
func read_a_windowed_counter(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var windows = Windows(state.context, state.values)
    windows.read_a_counter(condition)
    var index = 0
    while index < windows.proven_paths.count() {
        var path = windows.proven_paths[index]
        var present = windows.proven_types[index]
        crash present
        state.facts_paths.append(path)
        state.facts_types.append(present)
        note_a_loop_check(condition)
        index = index + 1
    }
}

func read_a_lowered_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    lowered: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
) {
    fallback lowered.operator == 'minus'
    var counted = lowered.left
    if counted.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_count(condition, counted)
    }
}

func read_a_counted_local(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    var internal_name = state.context.scope.internal_name_of(counted.name)
    fallback internal_name
    var listed = state.context.counted_lists[internal_name]
    fallback listed
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var list_value = state.values.value_of(listed, null)
    fallback state.context.has_a_class(list_value.value_type) and not list_value.value_type.is_nullable
    var owner = state.context.class_of(list_value.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var element: Model.Type = reader.answer
    var present = element.present()
    var printer = Printers.Spite.ExpressionPrinter(listed)
    var list_text = printer.text()
    state.facts_paths.append("{list_text}[{index_name}]")
    state.facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        state.facts_paths.append("{list_text}[{index_name} + {offset}]")
        state.facts_types.append(present)
        offset = offset + 1
    }
}

func note_a_loop_check(condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    while state.facts_checks.count() < state.facts_paths.count() - 1 {
        state.facts_checks.append("")
    }
    var printer = Printers.Spite.ExpressionPrinter(condition)
    var written = printer.text()
    state.facts_checks.append("the loop condition '{written}'")
}

func holds_maybes(listing: Model.ClassModel): Boolean {
    var item_type = listing.bound_types["$element_type"]
    if item_type {
        return item_type.is_nullable
    }
    return false
}

func read_a_count(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = counted.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_counted_list(condition, counted, callee)
    }
}

func read_a_counted_list(
    condition: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    counted: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback counted.arguments.is_empty() and callee.name == "count"
    var index_name = ""
    var reach = 0
    var left = condition.left
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        index_name = left.name
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        index_name = added_name_of(left)
        reach = added_reach_of(left)
        if reach > 63 {
            reach = 63
        }
        if index_name.is_empty() or reach == 0 {
            index_name = whole_index_of(left)
            reach = 0
        }
    }
    if left.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var index_printer = Printers.Spite.ExpressionPrinter(left)
        index_name = index_printer.text()
    }
    fallback not index_name.is_empty()
    var listed = state.values.value_of(callee.target, null)
    fallback state.context.has_a_class(listed.value_type) and not listed.value_type.is_nullable
    var owner = state.context.class_of(listed.value_type)
    fallback state.values.is_a_counted_collection(owner)
    var reader = owner.function_named("get_at")
    fallback reader
    fallback reader.answer
    fallback not holds_maybes(owner)
    var printer = Printers.Spite.ExpressionPrinter(callee.target)
    var list_text = printer.text()
    var element: Model.Type = reader.answer
    var present = element.present()
    state.facts_paths.append("{list_text}[{index_name}]")
    state.facts_types.append(present)
    note_a_loop_check(condition)
    var offset = 1
    while offset <= reach {
        state.facts_paths.append("{list_text}[{index_name} + {offset}]")
        state.facts_types.append(present)
        offset = offset + 1
    }
}

# ../../PROOFS.md#a-proven-count-or-bound-proves-a-read
func whole_index_of(left: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var statements = Statements(state)
    fallback not statements.holds_a_call(left)
    var printer = Printers.Spite.ExpressionPrinter(left)
    return printer.text()
}

func added_name_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var left = sum.left
    fallback sum.operator == 'plus'
    if left.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return left.name
    }
    return ""
}

func added_reach_of(sum: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): Integer {
    var right = sum.right
    if right.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return literal_reach_of(right)
    }
    return 0
}

func literal_reach_of(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): Integer {
    var number: Integer? = literal.text
    fallback literal.kind == 'integer_literal' and number
    return number
}

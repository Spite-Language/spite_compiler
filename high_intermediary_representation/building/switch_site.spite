var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file, false)
var function = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var shown = ""
var subject = ""
var is_an_enum = false
var is_nullable = false
var is_a_boolean = false
var every = List<String>()
var written = List<String>()
var line: Integer
var rest_line: Integer

func SwitchSite(
    starting_owner: Model.ClassModel,
    starting_function: Model.FunctionModel,
    starting_line: Integer,
    starting_rest_line: Integer,
) {
    owner = starting_owner
    function = starting_function
    line = starting_line
    rest_line = starting_rest_line
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var statements = List<SpiteCompiler.Statement>()

func Equality(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func is_given_equals(compared: Model.Type): Boolean {
    fallback compared.kind == 'object' and compared.name != "String"
    fallback context.has_a_class(compared)
    var model = context.class_of(compared)
    fallback not model.is_singleton
    return not model.function_named("equals")
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func equals_of(model: Model.ClassModel): Model.FunctionModel {
    make_equals_of(model)
    var made = model.declared_functions.last()
    crash made
    return made
}

func make_equals_of(model: Model.ClassModel) {
    var boolean = context.boolean()
    var own_type = model.type_of_an_instance()
    var is_synthetic = true
    var made = Model.FunctionModel(
        "equals",
        model.key,
        boolean,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    var parameter = Model.ParameterModel("other", own_type, false)
    made.parameters.append(parameter)
    model.declared_functions.append(made)
    var outer = statements
    statements = List<SpiteCompiler.Statement>()
    make_the_body(model, made, own_type)
    statements = outer
}

func make_the_body(model: Model.ClassModel, made: Model.FunctionModel, own_type: Model.Type) {
    var boolean = context.boolean()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var other = HighIntermediaryRepresentation.Values.LocalRead(own_type, "other")
    var same = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', own, other, null)
    answer_true_when(same)
    var held_items = held_items_function(model)
    if not held_items.is_empty() {
        compare_the_items(own, other, held_items)
        finish_equals(made)
        return
    }
    var guarded = reaches_itself(model)
    var guard = guard_class()
    if guarded {
        enter_the_guard(guard, own_type)
    }
    var answer = values.boolean_constant(true)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if not attribute.is_a_key_slot {
            var equal = attribute_equal(own, other, attribute)
            answer = both(answer, equal)
        }
        index = index + 1
    }
    if guarded {
        var kept = HighIntermediaryRepresentation.Statements.Declare("answer", boolean, answer, 0, "")
        statements.append(kept)
        leave_the_guard(guard)
        answer = HighIntermediaryRepresentation.Values.LocalRead(boolean, "answer")
    }
    var answered = HighIntermediaryRepresentation.Statements.Return(answer, 0)
    statements.append(answered)
    finish_equals(made)
}

func finish_equals(made: Model.FunctionModel) {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    body.statements = statements
    statements = List<SpiteCompiler.Statement>()
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func held_items_function(model: Model.ClassModel): String {
    if model.function_named("_has_equal_items") {
        return "_has_equal_items"
    }
    if model.function_named("_has_equal_entries") {
        return "_has_equal_entries"
    }
    return ""
}

func compare_the_items(own: SpiteCompiler.Value, other: SpiteCompiler.Value, name: String) {
    var calls = Calls(context, values)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(other)
    var compared = calls.method_call(own, name, arguments)
    var answered = HighIntermediaryRepresentation.Statements.Return(compared, 0)
    statements.append(answered)
}

func both(answer: SpiteCompiler.Value, equal: SpiteCompiler.Value): SpiteCompiler.Value {
    var boolean = context.boolean()
    if answer.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return equal
    }
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', answer, equal, null)
}

func answer_true_when(condition: SpiteCompiler.Value) {
    var yes = values.boolean_constant(true)
    var answered = HighIntermediaryRepresentation.Statements.Return(yes, 0)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(answered)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, then_branch, null, 0, "")
    statements.append(branch)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func attribute_equal(
    own: SpiteCompiler.Value,
    other: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
): SpiteCompiler.Value {
    var operators = Operators(context, values)
    var boolean = context.boolean()
    var mine = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var theirs = HighIntermediaryRepresentation.Values.AttributeRead(other, attribute)
    var held = attribute.attribute_type
    if held.kind == 'function' and context.program.function_held_back(attribute) {
        return held_back_equal(mine, theirs)
    }
    if held.kind == 'handle' {
        return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', mine, theirs, null)
    }
    var pending_start = context.pending.count()
    var equal = operators.values_equal(mine, theirs)
    var moved = pending_start
    while moved < context.pending.count() {
        var waiting = context.pending[moved]
        statements.append(waiting)
        moved = moved + 1
    }
    while context.pending.count() > pending_start {
        crash context.pending.remove_last()
    }
    return equal
}

# ../../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func held_back_equal(mine: SpiteCompiler.Value, theirs: SpiteCompiler.Value): SpiteCompiler.Value {
    var boolean = context.boolean()
    if not mine.value_type.is_nullable {
        return values.boolean_constant(true)
    }
    var mine_there = HighIntermediaryRepresentation.Values.PresenceTest(mine)
    var theirs_there = HighIntermediaryRepresentation.Values.PresenceTest(theirs)
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', mine_there, theirs_there, null)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func reaches_itself(model: Model.ClassModel): Boolean {
    var seen = List<String>()
    var waiting = List<Model.Type>()
    add_the_attributes(model, waiting)
    while not waiting.is_empty() {
        var held = waiting.remove_first()
        crash held
        if held.kind == 'shape' or held.kind == 'function' {
            return true
        }
        if held.kind == 'union' {
            add_the_members(held, waiting)
        } else if held.kind == 'object' and held.name != "String" and context.has_a_class(held) {
            var reached = context.class_of(held)
            if reached.key == model.key {
                return true
            }
            if not seen.contains(reached.key) and not reached.is_singleton {
                seen.append(reached.key)
                add_the_attributes(reached, waiting)
            }
        }
    }
    return false
}

func add_the_attributes(model: Model.ClassModel, waiting: List<Model.Type>) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var held = attribute.attribute_type.present()
        waiting.append(held)
        index = index + 1
    }
    var bound = model.bound_types.values()
    var bound_index = 0
    while bound_index < bound.count() {
        var bound_type = bound[bound_index]
        var present = bound_type.present()
        waiting.append(present)
        bound_index = bound_index + 1
    }
}

func add_the_members(united: Model.Type, waiting: List<Model.Type>) {
    var fitting = Fitting(context, values)
    var members = fitting.union_model_of(united)
    var index = 0
    while index < members.members.count() {
        var member = members.members[index]
        var present = member.present()
        waiting.append(present)
        index = index + 1
    }
}

func guard_class(): Model.ClassModel {
    var debugging = Debugging(context, values)
    return debugging.guard_named("Spite._PairsBeingCompared", 2)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func enter_the_guard(guard: Model.ClassModel, own_type: Model.Type) {
    var entering = guard.function_named("enters")
    crash entering
    var guard_type = guard.type_of_an_instance()
    var fetched = HighIntermediaryRepresentation.Values.NullConstant(guard_type)
    var long_type = context.scalar_type("Long")
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var own_address = HighIntermediaryRepresentation.Values.Conversion(long_type, 'address', own, "")
    var other = HighIntermediaryRepresentation.Values.LocalRead(own_type, "other")
    var other_address = HighIntermediaryRepresentation.Values.Conversion(long_type, 'address', other, "")
    var passed = List<SpiteCompiler.Value>()
    passed.append(own_address)
    passed.append(other_address)
    var entered = HighIntermediaryRepresentation.Values.Call(entering, fetched, passed, "", "")
    var again = HighIntermediaryRepresentation.Values.Negation(entered)
    answer_true_when(again)
}

func leave_the_guard(guard: Model.ClassModel) {
    var leaving = guard.function_named("leaves")
    crash leaving
    var guard_type = guard.type_of_an_instance()
    var fetched = HighIntermediaryRepresentation.Values.NullConstant(guard_type)
    var none_passed = List<SpiteCompiler.Value>()
    var left = HighIntermediaryRepresentation.Values.Call(leaving, fetched, none_passed, "", "")
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(left, 0)
    statements.append(evaluated)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func compares_the_held_classes(left_type: Model.Type, right_type: Model.Type): Boolean {
    var left_present = left_type.present()
    var right_present = right_type.present()
    fallback is_open(left_present)
    if is_open(right_present) {
        return true
    }
    return is_compared_through(right_present)
}

func is_open(compared: Model.Type): Boolean {
    return compared.kind == 'shape' or compared.kind == 'union'
}

func is_compared_through(compared: Model.Type): Boolean {
    fallback compared.kind == 'object' and compared.name != "Spite.Class"
    return context.has_a_class(compared)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func held_equal(left: SpiteCompiler.Value, right: SpiteCompiler.Value): SpiteCompiler.Value {
    var left_present = left.value_type.present()
    var fitting = Fitting(context, values)
    var operators = Operators(context, values)
    var compared = right
    var right_present = right.value_type.present()
    if not is_open(right_present) {
        var wanted = left_present
        if right.value_type.is_nullable {
            wanted = left_present.nullable()
        }
        compared = fitting.fitted(right, wanted)
    }
    var shape = held_comparison_of(left_present)
    var member = shape.member_named("equals")
    crash member
    var compared_type = Model.Type('shape', shape.key)
    var held_left = operators.held_once(left)
    var held_right = operators.held_once(compared)
    var present_left = present_of(held_left)
    var present_right = present_of(held_right)
    var shaped_left = fitting.fitted(present_left, compared_type)
    var shaped_right = fitting.fitted(present_right, compared_type)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(shaped_right)
    var equal = HighIntermediaryRepresentation.Values.ShapeCall(shape, member, shaped_left, arguments)
    return with_the_nulls(held_left, held_right, equal)
}

func present_of(value: SpiteCompiler.Value): SpiteCompiler.Value {
    if not value.value_type.is_nullable {
        return value
    }
    var present_type = value.value_type.present()
    return HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', value, "")
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func with_the_nulls(
    left: SpiteCompiler.Value,
    right: SpiteCompiler.Value,
    equal: SpiteCompiler.Value,
): SpiteCompiler.Value {
    var boolean = context.boolean()
    var answer = equal
    if right.value_type.is_nullable {
        var right_is_there = HighIntermediaryRepresentation.Values.PresenceTest(right)
        answer = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', right_is_there, answer, null)
    }
    if left.value_type.is_nullable {
        var left_is_there = HighIntermediaryRepresentation.Values.PresenceTest(left)
        answer = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'and', left_is_there, answer, null)
    }
    if not left.value_type.is_nullable or not right.value_type.is_nullable {
        return answer
    }
    var left_there = HighIntermediaryRepresentation.Values.PresenceTest(left)
    var right_there = HighIntermediaryRepresentation.Values.PresenceTest(right)
    var either_there = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'or',
        left_there,
        right_there,
        null,
    )
    var both_missing = HighIntermediaryRepresentation.Values.Negation(either_there)
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', both_missing, answer, null)
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func held_comparison_of(open_type: Model.Type): Model.ShapeModel {
    var key = "held_equals|{open_type.name}"
    var known = context.program.shape_keyed(key)
    if known {
        return known
    }
    var shown = context.shown(open_type)
    var made = Model.ShapeModel(key, shown)
    made.compares_the_held_class = true
    var boolean = context.boolean()
    var comparing = Model.FunctionModel(
        "equals",
        key,
        boolean,
        null,
        null,
        null,
        null,
        null,
        false,
        false,
        false,
        false,
    )
    var own_type = Model.Type('shape', key)
    var parameter = Model.ParameterModel("other", own_type, false)
    comparing.parameters.append(parameter)
    made.members.append(comparing)
    context.program.shapes[key] = made
    return made
}

# ../../../spite_documentation/functions_and_operators.md#every-class-has-equals
func need_the_held_equals(given: Model.Type) {
    var compared = given
    if given.is_a_walked_name {
        compared = context.text()
    }
    fallback compared.kind == 'object' or compared.kind == 'scalar'
    fallback context.has_a_class(compared)
    var model = context.class_of(compared)
    fallback not model.is_singleton
    var written = model.function_named("equals")
    if written {
        context.need(written)
        return
    }
    var given = equals_of(model)
    context.need(given)
}

func is_machine_comparable(left_type: Model.Type): Boolean {
    var is_a_scalar = left_type.kind == 'scalar' and not left_type.is_nullable
    var is_an_enum = left_type.kind == 'enumeration' and not left_type.is_nullable
    return is_a_scalar or is_an_enum
}


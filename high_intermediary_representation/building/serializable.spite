var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var format = "JSON"
var is_reading = false
var visited = List<String>()

func Serializable(starting_context: Context) {
    context = starting_context
}

func check(serializer: String, made: Model.ClassModel) {
    var is_a_serializer = ["JsonWriter", "JsonReader", "BinaryWriter", "BinaryReader"]
    fallback is_a_serializer.contains(serializer)
    var serialized = made.bound_types["$value_type"]
    fallback serialized
    if serializer.starts_with("Binary") {
        format = "binary"
    }
    is_reading = serializer.ends_with("Reader")
    var problem = problem_of(serialized, "")
    fallback not problem.is_empty()
    var serialized_shown = context.shown(serialized)
    var written = plain_name(serialized_shown)
    var refusal = Validators.HighIntermediaryRepresentation.Serializer.Validator()
    refusal.refuse(context, serializer, written, problem)
}

func problem_of(serialized: Model.Type, path: String): String {
    var present = serialized.present()
    var named = "it"
    if not path.is_empty() {
        named = "'{path}'"
    }
    var present_shown = context.shown(present)
    var shown = plain_name(present_shown)
    switch present.kind {
        'union': return union_problem(named, shown)
        'shape': return "{named} is typed as the 'type' {shown}, which says what it has, not what it is, so there is no class to read it back into"
        'function': return "{named} is a function value, {shown}, which has no {format} form"
        'object': return object_problem(present, path)
        'nothing': return ""
        'scalar': return ""
        'enumeration': return ""
        'handle': return ""
        'namespace': return ""
        'parameters': return ""
        'pattern': return ""
    }
}

func object_problem(present: Model.Type, path: String): String {
    fallback context.has_a_class(present)
    return class_problem(present, path)
}

func union_problem(named: String, shown: String): String {
    if format == "JSON" {
        return "{named} is the union {shown}, and JSON does not say which member a value is"
    }
    return "{named} is the union {shown}, and the bytes do not say which member a value is"
}

func class_problem(present: Model.Type, path: String): String {
    var model = context.class_of(present)
    if model.key.starts_with("List_of_") {
        var element = model.bound_types["$element_type"]
        crash element
        return problem_of(element, path)
    }
    if model.key.starts_with("Dictionary_of_") {
        return dictionary_problem(model, path)
    }
    fallback model.key != "String" and not visited.contains(model.key)
    visited.append(model.key)
    if is_reading and not model.is_made_plainly() {
        return unmade_problem(model, path)
    }
    var library = Validators.LibraryFile()
    fallback not library.holds(model.file.path)
    return attribute_problem(model)
}

# ../../../spite_documentation/json.md#what-a-reader-makes
func unmade_problem(model: Model.ClassModel, path: String): String {
    var named = "it"
    if not path.is_empty() {
        named = "'{path}'"
    }
    var shown = plain_name(model.shown)
    var conversion = model.read_conversion()
    if format == "JSON" and conversion {
        var source = conversion.parameters[0]
        crash source
        return problem_of(source.parameter_type, path)
    }
    var made = "{named} is {shown}, whose constructor takes arguments, so the reader cannot make one to fill"
    if format == "JSON" {
        return "{made}, and {shown} has no conversion from what JSON holds: give {shown} a constructor without parameters, or a conversion like 'func {shown}(from: String): {shown}?'"
    }
    return "{made}: give {shown} a constructor without parameters"
}

func dictionary_problem(model: Model.ClassModel, path: String): String {
    var key = model.bound_types["$key_type"]
    var entry = model.bound_types["$value_type"]
    crash key
    crash entry
    var key_problem = key_problem_of(key, path)
    if not key_problem.is_empty() {
        return key_problem
    }
    return problem_of(entry, path)
}

func key_problem_of(key: Model.Type, path: String): String {
    var named = "its dictionary"
    if not path.is_empty() {
        named = "the dictionary '{path}'"
    }
    var key_shown = context.shown(key)
    var shown = plain_name(key_shown)
    var is_text = key.kind == 'object' and key.name == "String"
    if key.kind == 'object' and not is_text {
        return "{named} is keyed by '{shown}' objects, each key one object's identity, which has no {format} form"
    }
    var whole = ["Byte", "Tiny", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
    var is_whole = key.kind == 'scalar' and whole.contains(key.name)
    var textual = is_text or is_whole or key.kind == 'enumeration'
    if format == "JSON" and not textual {
        return "{named} is keyed by '{shown}', and a JSON key is text: key it by a String, a whole number or an enum value"
    }
    return ""
}

func attribute_problem(model: Model.ClassModel): String {
    var owner = plain_name(model.shown)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var problem = problem_of_an_attribute(owner, attribute)
        if not problem.is_empty() {
            return problem
        }
        index = index + 1
    }
    return ""
}

func problem_of_an_attribute(owner: String, attribute: Model.AttributeModel): String {
    fallback not attribute.name.starts_with("_") and not holds_a_singleton(attribute.attribute_type)
    return problem_of(attribute.attribute_type, "{owner}.{attribute.name}")
}

func holds_a_singleton(held: Model.Type): Boolean {
    fallback held.kind == 'object' and context.has_a_class(held)
    var model = context.class_of(held)
    return model.is_singleton
}

func plain_name(shown: String): String {
    var before_generics = shown.split("<")
    var first = before_generics.first()
    crash first
    var parts = first.split(".")
    var last = parts.last()
    crash last
    var start = first.length()
    var end = shown.length()
    var rest = shown.slice(start, end)
    crash rest
    return "{last}{rest}"
}

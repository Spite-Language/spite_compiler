var names = List<String>()
var reads = List<List<String>>()
var placed = List<String>()
var placers = List<String>()
var homes = List<String>()
var rewritable_homes = List<String>()
var placing = ""

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func work_out(
    table: Symbols.SymbolTable,
    owner: Model.ClassModel,
    given_names: List<String>,
    given_reads: List<List<String>>,
) {
    names = given_names
    reads = given_reads
    var position = 0
    while position < names.count() {
        var name = names[position]
        placing = name
        place(position)
        position = position + 1
    }
    var written_paths = owner.file.written_paths()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        var home = ""
        if attribute.declaration and declarations_named(table, written_paths, attribute.name) == 1 {
            home = attribute.declaration.path
        }
        homes.append(home)
        var may_rewrite = not home.is_empty() and table.may_fix_later(home)
        if may_rewrite and not rewritable_homes.contains(home) {
            rewritable_homes.append(home)
        }
        index = index + 1
    }
}

func place(position: Integer) {
    var name = names[position]
    crash name
    fallback not placed.contains(name)
    var needs = reads[position]
    crash needs
    var index = 0
    while index < needs.count() {
        var needed = needs[index]
        var needed_position = names.index_of(needed)
        if needed_position {
            place(needed_position)
        }
        index = index + 1
    }
    placed.append(name)
    placers.append(placing)
}

func declarations_named(table: Symbols.SymbolTable, written_paths: List<String>, name: String): Integer {
    var count = 0
    var index = 0
    while index < written_paths.count() {
        var path = written_paths[index]
        var tree = table.files[path]
        if tree {
            count = count + attributes_named(tree, name)
        }
        index = index + 1
    }
    return count
}

func attributes_named(tree: AbstractSyntaxTree.Shapes.SourceFile, name: String): Integer {
    var count = 0
    var index = 0
    while index < tree.declarations.count() {
        var held = tree.declarations[index]
        if held.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and held.name == name {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

# ../../../spite_documentation/classes_and_files.md#a-default-reads-only-what-is-above-it
func has_moved_up(name: String): Boolean {
    var at = placed.index_of(name)
    var written_at = names.index_of(name)
    crash at and written_at
    var later = at + 1
    while later < placed.count() {
        var after = placed[later]
        var after_written_at = names.index_of(after)
        crash after_written_at
        if after_written_at < written_at {
            return true
        }
        later = later + 1
    }
    return false
}

func directly_reads(reader: String, read: String): Boolean {
    var at = names.index_of(reader)
    crash at
    var read_names = reads[at]
    crash read_names
    return read_names.contains(read)
}

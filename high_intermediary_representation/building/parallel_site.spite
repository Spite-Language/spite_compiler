# ../../PROOFS.md#what-a-parallel-may-reach
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var owner = Model.ClassModel("", "", no_file)
var function = Model.FunctionModel("", "")
var line = 0
var block_statements = List<AbstractSyntaxTree.Shapes.Statements.Statement>()
var block_index = 0
var view = ScopeView()
var work: AbstractSyntaxTree.Shapes.Expressions.Expression? = null

func ParallelSite(starting_context: Context) {
    owner = starting_context.current_class
    function = starting_context.current_function
    line = starting_context.line
    block_statements = starting_context.block_statements
    block_index = starting_context.block_index
    view = starting_context.scope.view()
}

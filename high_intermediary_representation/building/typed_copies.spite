var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func TypedCopies(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func retyped_names(function: Model.FunctionModel): List<String> {
    fallback is_copied_per_type(function)
    var key = function.key()
    var known = context.retyped_parameters[key]
    if known {
        return known
    }
    var names = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var is_retyped = not parameter.is_variadic and is_open(parameter.parameter_type)
        if is_retyped and not keeps_its_type(function, parameter.name) {
            names.append(parameter.name)
        }
        index = index + 1
    }
    context.retyped_parameters[key] = names
    return names
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func keeps_its_type(function: Model.FunctionModel, name: String): Boolean {
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    crash function.declaration
    walk.read_function(function.declaration)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if takes_the_name(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func takes_the_name(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    var reads = Reads(context, values)
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return reads.is_the_name(statement.target, name)
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and not statement.declared_type {
        return reads.is_the_name(statement.value, name)
    }
    return false
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func is_copied_per_type(function: Model.FunctionModel): Boolean {
    var is_plain = not function.is_a_constructor() and not function.is_a_member_template() and not function.is_synthetic
    fallback is_plain and not function.is_written_by_the_compiler and not function.is_an_attribute
    fallback not function.is_walked() and not function.fused and not function.typed_copy
    fallback function.known_parameter_functions.is_empty() and function.has_a_body()
    fallback not function.reflects_its_answer() and not is_a_conversion(function)
    var owner = context.program.class_named(function.owner)
    fallback owner and owner.bound_types.is_empty()
    var library = Mapping.LibraryFile()
    return not library.holds(owner.file.path)
}

func is_a_conversion(function: Model.FunctionModel): Boolean {
    fallback function.declared
    return function.declared.is_a_conversion or function.declared.is_a_preset
}

# ../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func grows_on_the_way(function_key: String, size: Integer): Boolean {
    fallback context.current_function.typed_copy and context.current_function.typed_copy.passed.contains(function_key)
    var place = context.current_function.typed_copy.passed.index_of(function_key)
    crash place
    var before = context.current_function.typed_copy.passed_sizes[place]
    crash before
    return size > before
}

# ../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func size_of_the_parameters(parameters: List<Model.ParameterModel>): Integer {
    var size = 0
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        var counted = size_of(parameter.parameter_type)
        size = size + counted
        index = index + 1
    }
    return size
}

func size_of(taken: Model.Type): Integer {
    var size = 1
    if taken.kind == 'object' and context.has_a_class(taken) {
        var model = context.class_of(taken)
        var bound = model.bound_types.values()
        var index = 0
        while index < bound.count() {
            var inner = bound[index]
            var counted = size_of(inner)
            size = size + counted
            index = index + 1
        }
    }
    return size
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func is_open(taken: Model.Type): Boolean {
    if taken.kind == 'union' or taken.kind == 'shape' {
        return true
    }
    fallback taken.kind == 'object' and context.has_a_class(taken)
    var model = context.class_of(taken)
    var bound = model.bound_types.values()
    return bound.any(is_open)
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func copied_type(given: Model.Type, wanted: Model.Type): Model.Type? {
    fallback wanted.is_nullable or not given.is_nullable
    var present = given.present()
    var wanted_present = wanted.present()
    fallback present.kind == 'object' or present.kind == 'scalar'
    fallback not values.is_the_same_type(present, wanted_present)
    fallback fits_as_a_copy(present, wanted_present)
    if wanted.is_nullable {
        return present.nullable()
    }
    return present
}

func fits_as_a_copy(given: Model.Type, wanted: Model.Type): Boolean {
    var fitting = Fitting(context, values)
    if wanted.kind == 'union' {
        return values.is_a_member_of(given, wanted)
    }
    if wanted.kind == 'shape' {
        return fitting.has_the_shape_members(given, wanted)
    }
    return fills_the_generic(given, wanted)
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func fills_the_generic(given: Model.Type, wanted: Model.Type): Boolean {
    fallback given.kind == 'object' and wanted.kind == 'object'
    fallback context.has_a_class(given) and context.has_a_class(wanted)
    var given_model = context.class_of(given)
    var wanted_model = context.class_of(wanted)
    fallback given_model.file.path == wanted_model.file.path and not wanted_model.bound_types.is_empty()
    fallback given_model.bound_types.count() == wanted_model.bound_types.count()
    var names = wanted_model.bound_types.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var wanted_inside = wanted_model.bound_types[name]
        var given_inside = given_model.bound_types[name]
        fallback wanted_inside and given_inside
        fallback fits_inside(given_inside, wanted_inside)
        index = index + 1
    }
    return true
}

func fits_inside(given: Model.Type, wanted: Model.Type): Boolean {
    if values.is_the_same_type(given, wanted) {
        return true
    }
    fallback is_open(wanted)
    var copied = copied_type(given, wanted)
    if copied {
        return true
    }
    return false
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func copy_for(function: Model.FunctionModel, arguments: List<SpiteCompiler.Value>): Model.FunctionModel {
    var taken = List<Model.ParameterModel>()
    var named = List<String>()
    var shown = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        var kept = parameter
        if argument and not parameter.is_variadic and is_open(parameter.parameter_type) {
            var argument_type = argument.value_type
            if not argument_type.is_the_same_as(parameter.parameter_type) {
                kept = Model.ParameterModel(parameter.name, argument_type, false)
                var piece = named_piece(argument_type)
                named.append(piece)
            }
        }
        taken.append(kept)
        var shown_type = context.shown(kept.parameter_type)
        shown.append(shown_type)
        index = index + 1
    }
    if named.is_empty() {
        return function
    }
    var joined = named.join("_and_")
    var copy_name = "{function.name}_typed_{joined}"
    var copy_key = "{function.owner}.{copy_name}"
    var known = context.known_function_copies[copy_key]
    if known {
        return known
    }
    var original_key = function.key()
    var size = size_of_the_parameters(taken)
    if grows_on_the_way(original_key, size) {
        as_written(function, arguments)
        return function
    }
    context.need(function)
    context.copied_originals.append(function)
    var made = Model.FunctionModel(
        copy_name,
        function.owner,
        function.answer,
        function.declaration,
        null,
        null,
        null,
        null,
        false,
        false,
        false,
        false,
    )
    made.parameters = taken
    var shown_types = shown.join(", ")
    var rules = Validators.HighIntermediaryRepresentation.EveryRule()
    var caller_class = rules.plain_class_name(context.current_class.shown)
    var caller_function = rules.shown_function_name(context.current_function)
    var copy = Model.TypedCopy(function.name, "({shown_types})", "{caller_class}.{caller_function}", context.line)
    copy.declared_parameters = function.parameters
    if context.current_function.typed_copy {
        copy.passed = context.current_function.typed_copy.passed.copy()
        copy.passed_sizes = context.current_function.typed_copy.passed_sizes.copy()
    }
    copy.passed.append(original_key)
    copy.passed_sizes.append(size)
    made.typed_copy = copy
    context.known_function_copies[copy_key] = made
    return made
}

# ../../ARCHITECTURE.md#a-walk-stops-where-it-passed-before
func as_written(function: Model.FunctionModel, arguments: List<SpiteCompiler.Value>) {
    var fitting = Fitting(context, values)
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var argument = arguments[index]
        if argument and not parameter.is_variadic and is_open(parameter.parameter_type) {
            var fitted = fitting.fitted(argument, parameter.parameter_type)
            arguments[index] = fitted
        }
        index = index + 1
    }
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func as_declared(written: SpiteCompiler.Expression?, value: SpiteCompiler.Value): SpiteCompiler.Value {
    if not context.current_function.typed_copy {
        return value
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return as_declared_in(context.current_function.typed_copy, written.name, value)
    }
    return value
}

func as_declared_in(copy: Model.TypedCopy, name: String, value: SpiteCompiler.Value): SpiteCompiler.Value {
    var index = 0
    while index < copy.declared_parameters.count() {
        var parameter = copy.declared_parameters[index]
        var is_retyped = parameter.name == name and not value.value_type.is_the_same_as(parameter.parameter_type)
        if is_retyped {
            var fitting = Fitting(context, values)
            return fitting.fitted(value, parameter.parameter_type)
        }
        index = index + 1
    }
    return value
}

# ../../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func judge_a_member_assigned_through_its_type(
    written: SpiteCompiler.Expression?,
    owner: Model.ClassModel,
    name: String,
    attribute: Model.AttributeModel?,
) {
    fallback context.current_function.typed_copy
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    var declared = declared_type_in(context.current_function.typed_copy, written.name)
    fallback declared and declared.kind == 'shape'
    var shape = context.program.shape_keyed(declared.name)
    fallback shape
    var member = shape.member_named(name)
    fallback member and member.is_a_function_member
    var filler = owner.type_of_an_instance()
    var shown = context.shown(filler)
    var rule = Validators.HighIntermediaryRepresentation.ShapeFit.Validator()
    var rule_answer = rule.check_an_assigned_member(context, shown, shape.name, name, attribute)
    context.tell(rule_answer)
}

func declared_type_in(copy: Model.TypedCopy, name: String): Model.Type? {
    var index = 0
    while index < copy.declared_parameters.count() {
        var parameter = copy.declared_parameters[index]
        if parameter.name == name {
            return parameter.parameter_type
        }
        index = index + 1
    }
    return null
}

func named_piece(taken: Model.Type): String {
    var name = taken.name.replace(".", "_")
    if taken.is_nullable {
        return "{name}_or_null"
    }
    return name
}

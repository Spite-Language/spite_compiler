var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var high_half: Long = 3421674724
var low_half: Long = 2216829733
var writing = List<String>()

func Schema(starting_context: Context) {
    context = starting_context
}

func hash_of(described: Model.Type): Long {
    var walked = text_of(described)
    add_text(walked)
    var high = high_half
    if high >= 2147483648 {
        high = high - 4294967296
    }
    return high * 4294967296 + low_half
}

func text_of(described: Model.Type): String {
    if described.is_nullable {
        var present = described.present()
        var present_text = text_of(present)
        return "{present_text}?"
    }
    if described.kind == 'enumeration' {
        return enum_text_of(described)
    }
    if not context.has_a_class(described) or described.kind == 'scalar' {
        return context.shown(described)
    }
    var model = context.class_of(described)
    if model.key == "String" {
        return "String"
    }
    var element = model.bound_types["$element_type"]
    if element and model.key.starts_with("List_of_") {
        var element_text = text_of(element)
        return "List<{element_text}>"
    }
    var key = model.bound_types["$key_type"]
    var value = model.bound_types["$value_type"]
    var is_a_dictionary = model.key.starts_with("Dictionary_of_")
    if key and value and is_a_dictionary {
        var key_text = text_of(key)
        var value_text = text_of(value)
        return "Dictionary<{key_text}, {value_text}>"
    }
    if writing.contains(model.key) {
        return model.shown
    }
    writing.append(model.key)
    var members = List<String>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if is_carried(attribute) {
            var attribute_text = text_of(attribute.attribute_type)
            members.append("{attribute.name}:{attribute_text}")
        }
        index = index + 1
    }
    crash writing.remove_last()
    var joined = members.join(";")
    return "{model.shown}\{{joined}}"
}

func is_carried(attribute: Model.AttributeModel): Boolean {
    fallback not attribute.name.starts_with("_")
    var held = attribute.attribute_type
    if not context.has_a_class(held) {
        return true
    }
    var model = context.class_of(held)
    return not model.is_singleton
}

func enum_text_of(described: Model.Type): String {
    var parts = described.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = context.program.class_named(owner_key)
    crash owner
    var made = owner.enum_named(simple)
    crash made
    var listed = made.values.join(",")
    var shown = context.shown(described)
    return "{shown}({listed})"
}

func add_text(walked: String) {
    var index = 0
    while index < walked.length() {
        var code: Long = walked.byte_at(index)
        add_code(code)
        index = index + 1
    }
}

func add_code(code: Long) {
    if code < 128 {
        add_byte(code)
        return
    }
    if code < 2048 {
        var first_of_two = code.shifted_right(6)
        add_byte(first_of_two + 192)
        add_continuation(code)
        return
    }
    if code < 65536 {
        var first_of_three = code.shifted_right(12)
        add_byte(first_of_three + 224)
        var middle_of_three = code.shifted_right(6)
        add_continuation(middle_of_three)
        add_continuation(code)
        return
    }
    var first_of_four = code.shifted_right(18)
    add_byte(first_of_four + 240)
    var second_of_four = code.shifted_right(12)
    add_continuation(second_of_four)
    var third_of_four = code.shifted_right(6)
    add_continuation(third_of_four)
    add_continuation(code)
}

func add_continuation(bits: Long) {
    var low_bits = bits.bits_and(63)
    add_byte(low_bits + 128)
}

func add_byte(byte: Long) {
    low_half = low_half.bits_exclusive_or(byte)
    var low_product = low_half * 435
    var cross = high_half * 435 + low_half * 256
    var carry = low_product.shifted_right(32)
    low_half = low_product.bits_and(4294967295)
    var summed = cross + carry
    high_half = summed.bits_and(4294967295)
}

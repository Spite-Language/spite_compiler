# ../../../spite_documentation/values_and_types.md#a-comparison-is-done-in-the-wider-type

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var signed_whole_names = ["Short", "Integer", "Long"]

func ComparedTypes(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func compared_in(left_type: Model.Type, right_type: Model.Type): Model.Type {
    var left = left_type.present()
    var right = right_type.present()
    if not context.is_a_number(left) or not context.is_a_number(right) {
        return left_type
    }
    if fits_without_a_cut(right, left) {
        return left_type
    }
    if fits_without_a_cut(left, right) {
        return right
    }
    var holding_both = signed_holding(left, right)
    if holding_both {
        return holding_both
    }
    return left_type
}

func fits_without_a_cut(given: Model.Type, wanted: Model.Type): Boolean {
    var fitting = Fitting(context, values)
    if given.is_the_same_as(wanted) or fitting.is_wider(wanted, given) {
        return true
    }
    return values.is_a_whole_number(given) and values.is_a_decimal_type(wanted)
}

func signed_holding(left: Model.Type, right: Model.Type): Model.Type? {
    fallback values.are_whole_numbers(left, right)
    var left_scalar = values.scalars.of(left.name)
    var right_scalar = values.scalars.of(right.name)
    crash left_scalar
    crash right_scalar
    fallback left_scalar.is_signed != right_scalar.is_signed
    var unsigned = left_scalar
    if left_scalar.is_signed {
        unsigned = right_scalar
    }
    var index = 0
    while index < signed_whole_names.count() {
        var name = signed_whole_names[index]
        var scalar = values.scalars.of(name)
        crash scalar
        if scalar.size > unsigned.size {
            return context.scalar_type(name)
        }
        index = index + 1
    }
    return null
}

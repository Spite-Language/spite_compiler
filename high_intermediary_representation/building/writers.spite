var state = ReflectionState()
var writing = Writing(state)
var wrappers = Wrappers(state)
var numbers = [
    "Tiny"
    "Byte"
    "Short"
    "UnsignedShort"
    "Integer"
    "UnsignedInteger"
    "Long"
    "UnsignedLong"
    "Float"
    "Double"
]

func Writers(starting_state: ReflectionState) {
    state = starting_state
    writing = Writing(starting_state)
    wrappers = Wrappers(starting_state)
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func writer_value(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    object: SpiteCompiler.Value,
): SpiteCompiler.Value {
    var attribute_type = writing.reflection_type("Spite.Attribute")
    var attribute_model = state.context.class_of(attribute_type)
    var writer_attribute = attribute_model.attribute_named("_writer")
    crash writer_attribute
    var wanted = writer_attribute.attribute_type.present()
    var writer = writer_of(model, attribute, wanted)
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, writer, object)
}

func writer_of(model: Model.ClassModel, attribute: Model.AttributeModel, wanted: Model.Type): Model.FunctionModel {
    var name = "_write_{attribute.name}_at_run_time"
    var known = model.function_named(name)
    if known {
        return known
    }
    var signature = wanted.signature_or_empty()
    var given_type = signature.parameters[0]
    crash given_type
    crash signature.answer
    var answer_type: Model.Type = signature.answer
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        model.key,
        answer_type,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    var parameter = Model.ParameterModel("value", given_type, false)
    made.parameters.append(parameter)
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var nothing = HighIntermediaryRepresentation.Values.NullConstant(answer_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(nothing, 0)
    body.statements.append(answered)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.attribute_writers.append(function)
    state.context.written_attributes.append(attribute)
    return made
}

# ../../../spite_documentation/reflection.md#known-only-at-run-time
func fill_the_bodies() {
    var features = Features(state)
    fallback features.has_feature("v")
    while state.context.attribute_writers_filled < state.context.attribute_writers.count() {
        var index = state.context.attribute_writers_filled
        var function = state.context.attribute_writers[index]
        crash function
        var attribute = state.context.written_attributes[index]
        crash attribute
        var model = state.context.program.class_named(function.function.owner)
        crash model
        var parameter = function.function.parameters[0]
        crash parameter
        crash function.function.answer
        function.body = writing_body(model, attribute, parameter.parameter_type, function.function.answer)
        state.context.attribute_writers_filled = index + 1
    }
}

func writing_body(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
    answer_type: Model.Type,
): HighIntermediaryRepresentation.Statements.Block {
    var folded_keys = Folded.Keys(state.values.context, state.values)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var written = attribute.attribute_type
    var shown = "{model.shown}.{attribute.name}"
    if not is_told_apart(written) or folded_keys.is_a_key_map(written) {
        var unwritable = "spite: set_value() cannot write '{shown}' when its attribute is known only at run time, since a value of its type is not told apart while the program runs: write it from an attribute named in the code, '{model.shown}.attributes[\"{attribute.name}\"]'"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(unwritable, 0)
        body.statements.append(stopped)
        var nothing = HighIntermediaryRepresentation.Values.NullConstant(answer_type)
        var unanswered = HighIntermediaryRepresentation.Statements.Return(nothing, 0)
        body.statements.append(unanswered)
        return body
    }
    write_a_null(body, model, attribute, given_type, answer_type)
    if written.present().kind == 'function' {
        write_a_function(body, model, attribute, given_type)
    } else {
        write_a_fit(body, model, attribute, given_type)
        write_the_casts(body, model, attribute, given_type, answer_type)
    }
    var wanted_shown = state.context.shown(written)
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(wanted_shown)
    var misfit = "spite: set_value() gives '{shown}' a value that is not {article} {wanted_shown} and that no conversion of {wanted_shown} takes, so it cannot be cast the way an assignment would cast it"
    var refused = HighIntermediaryRepresentation.Statements.Stop(misfit, 0)
    body.statements.append(refused)
    var nothing_written = HighIntermediaryRepresentation.Values.NullConstant(answer_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(nothing_written, 0)
    body.statements.append(answered)
    return body
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func is_told_apart(written: Model.Type): Boolean {
    var kind = written.kind
    var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
    return is_held or kind == 'union' or kind == 'shape' or kind == 'function'
}

func given(given_type: Model.Type): SpiteCompiler.Value {
    return HighIntermediaryRepresentation.Values.LocalRead(given_type, "value")
}

func held(given_type: Model.Type): SpiteCompiler.Value {
    var present_type = given_type.present()
    var read = given(given_type)
    return HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', read, "")
}

func write_a_null(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
    answer_type: Model.Type,
) {
    var read = given(given_type)
    var present = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var absent = HighIntermediaryRepresentation.Values.Negation(present)
    var writing_null = HighIntermediaryRepresentation.Statements.Block(0)
    var written = attribute.attribute_type
    if written.is_nullable {
        var nothing = HighIntermediaryRepresentation.Values.NullConstant(written)
        assign(writing_null, model, attribute, nothing)
        var no_answer = HighIntermediaryRepresentation.Values.NullConstant(answer_type)
        var answered = HighIntermediaryRepresentation.Statements.Return(no_answer, 0)
        writing_null.statements.append(answered)
    } else {
        var shown = "{model.shown}.{attribute.name}"
        var refused = "spite: set_value() gives '{shown}' null, and it is not nullable"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(refused, 0)
        writing_null.statements.append(stopped)
    }
    var branch = HighIntermediaryRepresentation.Statements.If(absent, writing_null, null, 0, "")
    running.statements.append(branch)
}

func write_a_fit(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
) {
    var written = attribute.attribute_type
    var wanted = written.present()
    if wanted.kind == 'shape' {
        wrappers.fill_with_the_programs_classes(wanted)
    }
    var tested = held(given_type)
    var fits = wrappers.class_test_of(tested, wanted)
    var writing_it = HighIntermediaryRepresentation.Statements.Block(0)
    var kind = wanted.kind
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if kind == 'scalar' or kind == 'enumeration' {
        conversion = 'unbox'
    }
    var again = held(given_type)
    var passed: SpiteCompiler.Value = HighIntermediaryRepresentation.Values.Conversion(wanted, conversion, again, "")
    if written.is_nullable {
        passed = HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed, "")
    }
    assign(writing_it, model, attribute, passed)
    var as_given = given(given_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(as_given, 0)
    writing_it.statements.append(answered)
    var branch = HighIntermediaryRepresentation.Statements.If(fits, writing_it, null, 0, "")
    running.statements.append(branch)
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func write_a_function(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
) {
    var function_type = writing.reflection_type("Spite.Function")
    var tested = held(given_type)
    var fits = HighIntermediaryRepresentation.Values.Class.Membership(tested, function_type)
    var writing_it = HighIntermediaryRepresentation.Statements.Block(0)
    var again = held(given_type)
    var bound = HighIntermediaryRepresentation.Values.Conversion(function_type, 'present', again, "")
    var bound_name = "written_function"
    var declared_bound = HighIntermediaryRepresentation.Statements.Declare(bound_name, function_type, bound, 0, "")
    writing_it.statements.append(declared_bound)
    var written = attribute.attribute_type
    var held_type = written.present()
    var wanted_shown = state.context.shown(held_type)
    var shaped = "spite: set_value() gives '{model.shown}.{attribute.name}' a function that is not a {wanted_shown}, the type it holds"
    var passed = wrappers.function_held_by(writing_it, bound_name, written, shaped)
    assign(writing_it, model, attribute, passed)
    var as_given = given(given_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(as_given, 0)
    writing_it.statements.append(answered)
    var branch = HighIntermediaryRepresentation.Statements.If(fits, writing_it, null, 0, "")
    running.statements.append(branch)
}

# ../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func write_the_casts(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
    answer_type: Model.Type,
) {
    var wanted = attribute.attribute_type.present()
    var sources = cast_sources_of(wanted)
    var index = 0
    while index < sources.count() {
        var source = sources[index]
        write_a_cast(running, model, attribute, given_type, answer_type, source)
        index = index + 1
    }
}

func write_a_cast(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    given_type: Model.Type,
    answer_type: Model.Type,
    source: Model.Type,
) {
    var fitting = Fitting(state.values.context, state.values)
    var tested = held(given_type)
    var is_it = HighIntermediaryRepresentation.Values.Class.Membership(tested, source)
    var casting = HighIntermediaryRepresentation.Statements.Block(0)
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if source.kind == 'scalar' {
        conversion = 'unbox'
    }
    var again = held(given_type)
    var unboxed = HighIntermediaryRepresentation.Values.Conversion(source, conversion, again, "")
    var written = attribute.attribute_type
    var wanted = written.present()
    var cast = wrappers.fitted_into(casting, fitting, unboxed, wanted)
    if written.is_nullable {
        cast = HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', cast, "")
    }
    assign(casting, model, attribute, cast)
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var read_back = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var boxed = wrappers.fitted_into(casting, fitting, read_back, answer_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(boxed, 0)
    casting.statements.append(answered)
    var branch = HighIntermediaryRepresentation.Statements.If(is_it, casting, null, 0, "")
    running.statements.append(branch)
}

# ../../../spite_documentation/values_and_types.md#numeric-types-and-the-casting-rule
func cast_sources_of(wanted: Model.Type): List<Model.Type> {
    var fitting = Fitting(state.values.context, state.values)
    var sources = List<Model.Type>()
    var is_text = wanted.kind == 'object' and wanted.name == "String"
    var is_a_number = wanted.kind == 'scalar' and is_a_number_name(wanted.name)
    var names = List<String>()
    if is_a_number or is_text {
        numbers.each(names.append)
    }
    if is_text {
        names.append("Boolean")
    }
    if wanted.kind == 'enumeration' {
        var whole = ["Tiny", "Byte", "Short", "UnsignedShort", "Integer", "UnsignedInteger", "Long", "UnsignedLong"]
        whole.each(names.append)
    }
    var index = 0
    while index < names.count() {
        var name = names[index]
        if name != wanted.name {
            var number_type = state.context.scalar_type(name)
            sources.append(number_type)
        }
        index = index + 1
    }
    fallback wanted.kind == 'object' or wanted.kind == 'scalar'
    var target = state.context.class_of(wanted)
    var counted = 0
    while counted < target.declared_functions.count() {
        var function = target.declared_functions[counted]
        var source = conversion_source_of(function, wanted)
        if source and fitting.can_be_converted(source, wanted) and not holds_the_type(sources, source) {
            sources.append(source)
        }
        counted = counted + 1
    }
    return sources
}

func holds_the_type(sources: List<Model.Type>, source: Model.Type): Boolean {
    var index = 0
    while index < sources.count() {
        var known = sources[index]
        if known.is_the_same_as(source) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_a_number_name(name: String): Boolean {
    return numbers.contains(name)
}

# ../../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func conversion_source_of(function: Model.FunctionModel, wanted: Model.Type): Model.Type? {
    fallback function.declared and function.declared.is_a_conversion
    fallback function.answer and function.answer.name == wanted.name
    fallback function.parameters.count() == 1
    var only = function.parameters[0]
    var source = only.parameter_type
    var reads_text = source.kind == 'object' and source.name == "String"
    var may_fail = function.answer.is_nullable
    fallback not reads_text or not may_fail or wanted.kind != 'scalar'
    var is_held = source.kind == 'object' or source.kind == 'scalar'
    fallback is_held and not source.is_nullable
    return source
}

func assign(
    running: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    value: SpiteCompiler.Value,
) {
    var rooms = RoomForms(state.values.context, state.values)
    var own_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var assigned = value
    if rooms.holds_room(attribute) {
        var room_name = "room_of_{attribute.name}"
        var declared = HighIntermediaryRepresentation.Statements.Declare(room_name, value.value_type, value, 0, "")
        running.statements.append(declared)
        var counted = HighIntermediaryRepresentation.Values.LocalRead(value.value_type, room_name)
        var growing = rooms.room_for(own, attribute, counted)
        running.statements.append(growing)
        assigned = HighIntermediaryRepresentation.Values.LocalRead(value.value_type, room_name)
    }
    var again = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var made = HighIntermediaryRepresentation.Statements.Assign.Attribute(again, attribute, assigned, 0)
    running.statements.append(made)
}

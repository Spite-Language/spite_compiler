var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)

func AutomaticAccessors(starting_context: Context) {
    context = starting_context
}

# ../../../spite_documentation/functions_and_operators.md#every-attribute-has-a-setter-and-a-getter
func accessor_named(model: Model.ClassModel, name: String): Model.FunctionModel? {
    var names = Model.AccessorNames()
    var written = names.written_by(name)
    var read = names.read_by(name)
    fallback not written.is_empty() or not read.is_empty()
    fallback model.type_of_an_instance().kind == 'object' and model.key != "String"
    var key = "{model.key}.{name}"
    var made = context.automatic_accessors[key]
    if made {
        return made
    }
    if not written.is_empty() {
        var stored = model.attribute_named(written)
        fallback stored
        var setter = setter_of(model, stored, name)
        context.automatic_accessors[key] = setter
        return setter
    }
    var answered = model.attribute_named(read)
    fallback answered
    var getter = getter_of(model, answered, name)
    context.automatic_accessors[key] = getter
    return getter
}

func setter_of(model: Model.ClassModel, attribute: Model.AttributeModel, name: String): Model.FunctionModel {
    var own_type = model.type_of_an_instance()
    var made = made_function(model, name, null)
    var parameter = Model.ParameterModel("value", attribute.attribute_type, false)
    made.parameters.append(parameter)
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var given = HighIntermediaryRepresentation.Values.LocalRead(attribute.attribute_type, "value")
    var stored = HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, given, 0)
    add_the_body(made, stored)
    return made
}

func getter_of(model: Model.ClassModel, attribute: Model.AttributeModel, name: String): Model.FunctionModel {
    var own_type = model.type_of_an_instance()
    var made = made_function(model, name, attribute.attribute_type)
    var own = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var answered = HighIntermediaryRepresentation.Statements.Return(read, 0)
    add_the_body(made, answered)
    return made
}

func made_function(model: Model.ClassModel, name: String, answer: Model.Type?): Model.FunctionModel {
    var is_synthetic = true
    return Model.FunctionModel(name, model.key, answer, null, null, null, null, null, is_synthetic, false, false, false)
}

func add_the_body(made: Model.FunctionModel, only: SpiteCompiler.Statement) {
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    body.statements.append(only)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
}

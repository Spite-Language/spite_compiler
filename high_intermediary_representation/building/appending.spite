var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)
var pieces = List<SpiteCompiler.Value>()

func Appending(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func pieces_appended_to(internal_name: String, declared_type: Model.Type, value: SpiteCompiler.Value): Boolean {
    var is_text = declared_type.kind == 'object' and declared_type.name == "String"
    var is_plain = is_text and not declared_type.is_nullable and not declared_type.is_a_walked_name
    fallback is_plain
    pieces = List<SpiteCompiler.Value>()
    var joins_itself = gathered(internal_name, value)
    fallback joins_itself and not pieces.is_empty()
    var mentioned = false
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if mentions(piece, internal_name) {
            mentioned = true
        }
        index = index + 1
    }
    return not mentioned
}

func statements_of(internal_name: String, declared_type: Model.Type, line: Integer): List<SpiteCompiler.Statement> {
    var literals = Literals(values.context, values)
    var calls = Calls(values.context, values)
    var made = List<SpiteCompiler.Statement>()
    var held = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
    var text_model = context.class_of(declared_type)
    var forms = HeldOnceForms(context, values)
    var growing = forms.ready_to_grow_of(text_model)
    var no_arguments = List<SpiteCompiler.Value>()
    var ready = HighIntermediaryRepresentation.Values.Call(growing, held, no_arguments)
    var readied = HighIntermediaryRepresentation.Statements.Assign.Assign(internal_name, ready, line)
    made.append(readied)
    var joined: SpiteCompiler.Value? = null
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        var joined_so_far = literals.joined_with(joined, piece)
        joined = joined_so_far
        index = index + 1
    }
    crash joined
    var receiver = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(joined)
    var appended = calls.method_call(receiver, "_append_text", arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(appended, line)
    made.append(evaluated)
    return made
}

func gathered(internal_name: String, value: SpiteCompiler.Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return value.name == internal_name
        HighIntermediaryRepresentation.Values.Call: return gathered_a_join(internal_name, value)
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Conversion: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func gathered_a_join(internal_name: String, call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var key = call.function.key()
    fallback key == "String.sum" and call.arguments.count() == 1
    fallback call.receiver
    var reaches = gathered(internal_name, call.receiver)
    fallback reaches
    var piece = call.arguments[0]
    pieces.append(piece)
    return true
}

func mentions(value: SpiteCompiler.Value, internal_name: String): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return value.name == internal_name
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.Call: return a_call_mentions(value, internal_name)
        HighIntermediaryRepresentation.Values.Conversion: return maybe_mentions(value.converted, internal_name)
        HighIntermediaryRepresentation.Values.EnumText: return maybe_mentions(value.number, internal_name)
        HighIntermediaryRepresentation.Values.AttributeRead: return true
        HighIntermediaryRepresentation.Values.MakeObject: return true
        HighIntermediaryRepresentation.Values.MachineOperation: return true
        HighIntermediaryRepresentation.Values.Negation: return true
        HighIntermediaryRepresentation.Values.ForeignCall: return true
        HighIntermediaryRepresentation.Values.Class.Membership: return true
        HighIntermediaryRepresentation.Values.PresenceTest: return true
        HighIntermediaryRepresentation.Values.Function.Value: return true
        HighIntermediaryRepresentation.Values.Function.ValueCall: return true
        HighIntermediaryRepresentation.Values.NumberRoom: return true
        HighIntermediaryRepresentation.Values.ShapeCall: return true
        HighIntermediaryRepresentation.Values.EnumFromText: return true
        HighIntermediaryRepresentation.Values.Class.Object: return true
        HighIntermediaryRepresentation.Values.Class.OfValue: return true
        HighIntermediaryRepresentation.Values.Function.Fact: return true
    }
}

func maybe_mentions(value: SpiteCompiler.Value?, internal_name: String): Boolean {
    fallback value
    return mentions(value, internal_name)
}

func a_call_mentions(call: HighIntermediaryRepresentation.Values.Call, internal_name: String): Boolean {
    var found = maybe_mentions(call.receiver, internal_name)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if mentions(argument, internal_name) {
            found = true
        }
        index = index + 1
    }
    return found
}

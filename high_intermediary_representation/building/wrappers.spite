var state = ReflectionState()
var described_names = DescribedNames()
var feature_flags = Features(state)
var writing = Writing(state)
var class_objects = ClassObjects(state)
var declarations = Declarations(state)

func Wrappers(starting_state: ReflectionState) {
    state = starting_state
    described_names = DescribedNames()
    feature_flags = Features(starting_state)
    writing = Writing(starting_state)
    class_objects = ClassObjects(starting_state)
    declarations = Declarations(starting_state)
}

func function_object_in_place(declared: Model.FunctionModel, receiver: SpiteCompiler.Value): SpiteCompiler.Value {
    var model = state.context.program.class_named(declared.owner)
    crash model
    var function_type = writing.reflection_type("Spite.Function")
    writing.need_the_making(function_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var describer = describer_of(declared, model, function_type)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(describer, receiver, no_arguments, "", "")
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func function_object_of_a_value(value: SpiteCompiler.Value): SpiteCompiler.Value {
    var literals = Literals(state.values.context, state.values)
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    state.context.need_defaults(function_model.key)
    literals.need_text_constants()
    var given = value.value_type
    var held = writing.kept_in_scope(value, given)
    if not given.is_nullable {
        return made_function_object(held, function_type, function_model)
    }
    var boxed_type = function_type.nullable()
    var no_object = HighIntermediaryRepresentation.Values.NullConstant(boxed_type)
    state.local_count = state.local_count + 1
    var boxed_name = state.context.scope.declare("reflected_{state.local_count}", boxed_type)
    var declared = HighIntermediaryRepresentation.Statements.Declare(
        boxed_name,
        boxed_type,
        no_object,
        state.context.line,
        "",
    )
    state.statements.append(declared)
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    var present_type = given.present()
    var present = HighIntermediaryRepresentation.Values.Conversion(present_type, 'present', held, "")
    var made = made_function_object(present, function_type, function_model)
    var placed = HighIntermediaryRepresentation.Values.Conversion(boxed_type, 'nullable', made, "")
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(boxed_name, placed, state.context.line)
    state.statements.append(assigned)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(state.context.line)
    then_branch.statements = state.statements
    state.statements = outer
    var there = HighIntermediaryRepresentation.Values.PresenceTest(held)
    var checked = HighIntermediaryRepresentation.Statements.If(there, then_branch, null, state.context.line, "")
    state.statements.append(checked)
    return HighIntermediaryRepresentation.Values.LocalRead(boxed_type, boxed_name)
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func made_function_object(
    held: SpiteCompiler.Value,
    function_type: Model.Type,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    var no_arguments = List<SpiteCompiler.Value>()
    var fresh = HighIntermediaryRepresentation.Values.MakeObject(function_type, null, no_arguments, "", false)
    var made = writing.kept_in_scope(fresh, function_type)
    var finder = declaration_finder(held.value_type, function_type, function_model)
    var passed = List<SpiteCompiler.Value>()
    passed.append(held)
    return HighIntermediaryRepresentation.Values.Call(finder, made, passed, "", "")
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func declaration_finder(
    value_type: Model.Type,
    function_type: Model.Type,
    function_model: Model.ClassModel,
): Model.FunctionModel {
    var index = 0
    while index < state.context.value_finders.count() {
        var known_type = state.context.value_finder_types[index]
        var known = state.context.value_finders[index]
        crash known_type
        if same_signature(known_type, value_type) {
            return known.function
        }
        index = index + 1
    }
    var is_synthetic = true
    var made = Model.FunctionModel(
        "_declared_{state.context.value_finders_made}",
        function_model.key,
        function_type,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    state.context.value_finders_made = state.context.value_finders_made + 1
    var parameter = Model.ParameterModel("value", value_type, false)
    made.parameters.append(parameter)
    function_model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.value_finders.append(function)
    state.context.value_finder_types.append(value_type)
    state.context.value_finder_counts.append(-1)
    var position = state.context.value_finders.count() - 1
    refind(position)
    return made
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func refind(index: Integer) {
    var function = state.context.value_finders[index]
    var value_type = state.context.value_finder_types[index]
    var counted = state.context.value_finder_counts[index]
    crash function
    crash value_type
    crash counted
    var candidates = candidates_of(value_type)
    fallback candidates.count() != counted
    state.context.value_finder_counts[index] = candidates.count()
    function.body = finding_body(value_type, candidates)
}

func candidates_of(value_type: Model.Type): List<Model.FunctionModel> {
    var found = List<Model.FunctionModel>()
    var index = 0
    while index < state.context.taken_functions.count() {
        var taken = state.context.taken_functions[index]
        var parameter_types = taken.parameters.map_parameter_types()
        var signature = Model.Signature(parameter_types, taken.answer, false)
        var taken_type = Model.Type('function', "Spite.Function")
        taken_type.signature = signature
        if same_signature(taken_type, value_type) {
            found.append(taken)
        }
        index = index + 1
    }
    return found
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func finding_body(
    value_type: Model.Type,
    candidates: List<Model.FunctionModel>,
): HighIntermediaryRepresentation.Statements.Block {
    var function_type = writing.reflection_type("Spite.Function")
    writing.need_the_making(function_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var index = 0
    while index < candidates.count() {
        var candidate = candidates[index]
        var found = found_when_it_is(value_type, candidate, function_type)
        body.statements.append(found)
        index = index + 1
    }
    var message = "spite: a function value whose declaration the compiler did not list was read at run time"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message, 0)
    body.statements.append(stopped)
    var own = HighIntermediaryRepresentation.Values.ThisRead(function_type)
    var answered = HighIntermediaryRepresentation.Statements.Return(own, 0)
    body.statements.append(answered)
    return body
}

func found_when_it_is(
    value_type: Model.Type,
    candidate: Model.FunctionModel,
    function_type: Model.Type,
): HighIntermediaryRepresentation.Statements.If {
    var owner = state.context.program.class_named(candidate.owner)
    crash owner
    var owner_type = owner.type_of_an_instance()
    var address_type = state.context.scalar_type("Long")
    var address_member = Model.AttributeModel("address", "Spite.FunctionValue", address_type, null, false)
    var owner_member = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type, null, false)
    var given = HighIntermediaryRepresentation.Values.LocalRead(value_type, "value")
    var given_address = HighIntermediaryRepresentation.Values.AttributeRead(given, address_member)
    var owner_as_a_number = Model.AttributeModel("owner", "Spite.FunctionValue", address_type, null, false)
    var given_again = HighIntermediaryRepresentation.Values.LocalRead(value_type, "value")
    var compared_owner = HighIntermediaryRepresentation.Values.AttributeRead(given_again, owner_as_a_number)
    state.context.need(candidate)
    var compared = HighIntermediaryRepresentation.Values.Function.Value(value_type, candidate, compared_owner)
    var compared_address = HighIntermediaryRepresentation.Values.AttributeRead(compared, address_member)
    var boolean = state.context.boolean()
    var is_it = HighIntermediaryRepresentation.Values.MachineOperation(
        boolean,
        'equal',
        given_address,
        compared_address,
        null,
    )
    var given_once_more = HighIntermediaryRepresentation.Values.LocalRead(value_type, "value")
    var receiver = HighIntermediaryRepresentation.Values.AttributeRead(given_once_more, owner_member)
    var describer = describer_of(candidate, owner, function_type)
    var no_arguments = List<SpiteCompiler.Value>()
    var described = HighIntermediaryRepresentation.Values.Call(describer, receiver, no_arguments, "", "")
    var answered = HighIntermediaryRepresentation.Statements.Return(described, 0)
    var then_branch = HighIntermediaryRepresentation.Statements.Block(0)
    then_branch.statements.append(answered)
    return HighIntermediaryRepresentation.Statements.If(is_it, then_branch, null, 0, "")
}

func same_signature(known_type: Model.Type, value_type: Model.Type): Boolean {
    var known = known_type.signature_or_empty()
    var given = value_type.signature_or_empty()
    fallback known.parameters.count() == given.parameters.count()
    var index = 0
    while index < known.parameters.count() {
        var known_parameter = known.parameters[index]
        var given_parameter = given.parameters[index]
        crash given_parameter
        fallback known_parameter.is_the_same_as(given_parameter)
        index = index + 1
    }
    if known.answer and given.answer {
        var known_answer: Model.Type = known.answer
        var given_answer: Model.Type = given.answer
        return known_answer.is_the_same_as(given_answer)
    }
    return not known.answer and not given.answer
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func describer_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_type: Model.Type,
): Model.FunctionModel {
    var name = "_described_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        model.key,
        function_type,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    model.declared_functions.append(made)
    var body = describing_body(declared, model)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.describers.append(function)
    state.context.described_functions.append(declared)
    return made
}

func describing_body(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    var own_type = model.type_of_an_instance()
    state.stand_in = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var local = function_object(declared, model, false, true)
    var answered = HighIntermediaryRepresentation.Statements.Return(local, 0)
    state.statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    body.statements = state.statements
    state.statements = outer
    return body
}

func redescribe(index: Integer) {
    var function = state.context.describers[index]
    var declared = state.context.described_functions[index]
    crash function
    crash declared
    var model = state.context.program.class_named(declared.owner)
    crash model
    function.body = describing_body(declared, model)
}

func function_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var declaration = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["declaration"] = declaration
    made_given["owner"] = writing.text("")
    if feature_flags.has_feature("b") {
        crash state.stand_in
        var owner: SpiteCompiler.Value = state.stand_in
        made_given["owner"] = owner
    }
    made_given["called"] = call_value_of(declared, model, function_model)
    made_given["value"] = value_of_a_function(declared, model, function_model)
    var made = writing.made_by_name(function_type, made_given)
    return writing.kept(made, function_type)
}

# ../../../spite_documentation/reflection.md#what-the-compiler-leaves-out
func value_of_a_function(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    if feature_flags.has_feature("o") {
        return held_value_of(declared, function_model)
    }
    return call_value_of(declared, model, function_model)
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func held_value_of(declared: Model.FunctionModel, function_model: Model.ClassModel): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var held_type = value_attribute.attribute_type.present()
    state.context.need(declared)
    return HighIntermediaryRepresentation.Values.Function.Value(held_type, declared, receiver)
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func declaration_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var declaration_type = writing.reflection_type("Spite.FunctionDeclaration")
    var declaration_model = state.context.class_of(declaration_type)
    writing.need_the_making(declaration_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    var has_facts = declarations.belongs_to_the_program(model) and declarations.can_be_built(declared)
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["hole"] = writing.text("")
    made_given["index"] = writing.whole(0)
    made_given["returns"] = declarations.answer_of(declared)
    made_given["source_path"] = declarations.function_file_of(declared, model)
    if feature_flags.has_feature("o") {
        var shape = declarations.function_type_of(declared)
        var shown = state.context.shown(shape)
        made_given["signature"] = writing.text(shown)
    }
    made_given["arguments"] = arguments_of_a_declaration(declaration_model, declared, argument_type, has_facts)
    var literal = returned_literal_of(declared)
    if literal {
        made_given["returned_literal"] = writing.text(literal)
    }
    made_given["has_facts"] = writing.flag(has_facts)
    if has_facts and feature_flags.has_feature("w") {
        made_given["is_resumable"] = writing.fact("waits", declared, "")
    }
    if has_facts and with_accesses and feature_flags.has_feature("a") {
        add_the_reach(made_given, declaration_model, declared, model)
        made_given["has_reach"] = writing.flag(true)
    }
    if not state.stand_in and makes_a_stand_in and feature_flags.has_feature("o") {
        state.stand_in = made_stand_in(model)
    }
    if state.stand_in and feature_flags.has_feature("o") {
        made_given["called_on"] = called_on_value_of(declared, model, declaration_model)
    }
    var made = writing.made_by_name(declaration_type, made_given)
    return writing.kept(made, declaration_type)
}

func called_on_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_on_attribute = function_model.attribute_named("_called_on")
    crash called_on_attribute
    var wanted = called_on_attribute.attribute_type.present()
    var signature = wanted.signature_or_empty()
    var parameter_type = signature.parameters[0]
    crash parameter_type
    var arguments_type = signature.parameters[1]
    crash arguments_type
    crash signature.answer
    var answer_type: Model.Type = signature.answer
    var wrapper = calling_on_wrapper(model, declared, parameter_type, arguments_type, answer_type)
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func calling_on_wrapper(
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
    answer_type: Model.Type,
): Model.FunctionModel {
    var name = "_call_{declared.name}_on"
    var known = model.function_named(name)
    if known {
        return known
    }
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        model.key,
        answer_type,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    var parameter = Model.ParameterModel("instance", instance_type, false)
    made.parameters.append(parameter)
    var arguments_parameter = Model.ParameterModel("arguments", arguments_type, false)
    made.parameters.append(arguments_parameter)
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var passed = first_unpassed_parameter(declared)
    var typed = first_parameter_used_as_a_type(declared)
    if not typed.is_empty() {
        var as_a_type = "spite: call() cannot pass the argument '{typed}' of '{model.shown}.{declared.name}' when the call is known only at run time, since the function uses it as a type, which is known only while compiling: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var typed_stop = HighIntermediaryRepresentation.Statements.Stop(as_a_type, 0)
        body.statements.append(typed_stop)
    } else if passed.is_empty() and not answers_a_value(declared) {
        var unanswered = "spite: call() cannot hand back the answer of '{model.shown}.{declared.name}' when the call is known only at run time, since a value of its type is not told apart while the program runs: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var stopped = HighIntermediaryRepresentation.Statements.Stop(unanswered, 0)
        body.statements.append(stopped)
    } else if passed.is_empty() {
        called_on_its_instance(body, model, declared, instance_type, arguments_type, answer_type)
    } else {
        var message = "spite: call() cannot pass the argument '{passed}' of '{model.shown}.{declared.name}' when the call is known only at run time, since a value of its type is not told apart while the program runs: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var refused = HighIntermediaryRepresentation.Statements.Stop(message, 0)
        body.statements.append(refused)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func answers_a_value(declared: Model.FunctionModel): Boolean {
    if not declared.answer {
        return true
    }
    var answer: Model.Type = declared.answer
    var kind = answer.kind
    var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
    var is_told_apart = is_held or kind == 'union' or kind == 'shape' or kind == 'function'
    return is_told_apart or kind == 'nothing'
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func fitted_into(
    body: HighIntermediaryRepresentation.Statements.Block,
    fitting: Fitting,
    call: SpiteCompiler.Value,
    answer_type: Model.Type,
): SpiteCompiler.Value {
    var context = state.values.context
    var outer_pending = context.pending
    context.pending = List<SpiteCompiler.Statement>()
    var answered = fitting.fitted(call, answer_type)
    context.pending.each(body.statements.append)
    context.pending = outer_pending
    return answered
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func first_parameter_used_as_a_type(declared: Model.FunctionModel): String {
    fallback declared.declaration
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var reads = AbstractSyntaxTree.UnusedNames.Reads()
        if reads.reads_as_a_type(declared.declaration, parameter.name) {
            return parameter.name
        }
        index = index + 1
    }
    return ""
}

func first_unpassed_parameter(declared: Model.FunctionModel): String {
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var kind = parameter.parameter_type.kind
        var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
        var is_told_apart = is_held or kind == 'union' or kind == 'shape' or kind == 'function'
        if not is_told_apart {
            return parameter.name
        }
        index = index + 1
    }
    return ""
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func called_on_its_instance(
    body: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
    answer_type: Model.Type,
) {
    var fitting = Fitting(state.values.context, state.values)
    state.context.need(declared)
    var own_type = model.type_of_an_instance()
    var instance = HighIntermediaryRepresentation.Values.LocalRead(instance_type, "instance")
    var tested = HighIntermediaryRepresentation.Values.Class.Membership(instance, own_type)
    var narrowed = HighIntermediaryRepresentation.Values.Conversion(own_type, 'present', instance, "")
    var message = "spite: call() runs '{declared.name}', declared by '{model.shown}', on an instance of another class: a call runs a declaration on an instance of its own class"
    var other_class = HighIntermediaryRepresentation.Values.Negation(tested)
    stop_when(body, other_class, message)
    var passed_arguments = List<SpiteCompiler.Value>()
    var shown = "{model.shown}.{declared.name}"
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var argument = passed_argument(body, parameter, arguments_type, shown)
        passed_arguments.append(argument)
        index = index + 1
    }
    stop_an_argument_too_many(body, declared, arguments_type, shown)
    var call = HighIntermediaryRepresentation.Values.Call(declared, narrowed, passed_arguments, "", "")
    var answered: SpiteCompiler.Value = HighIntermediaryRepresentation.Values.NullConstant(answer_type)
    if declared.answer {
        answered = fitted_into(body, fitting, call, answer_type)
    } else {
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call, 0)
        body.statements.append(evaluated)
    }
    var returned = HighIntermediaryRepresentation.Statements.Return(answered, 0)
    body.statements.append(returned)
}

func passed_argument(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    state.context.need(reading)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var value_type = Model.Type('object', "String")
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name, value_type, false)
    keys.append(key)
    var containing = dictionary.function_named("contains")
    crash containing
    state.context.need(containing)
    var filled = HighIntermediaryRepresentation.Values.Call(containing, arguments, keys, "", "")
    var missing = HighIntermediaryRepresentation.Values.Negation(filled)
    var unfilled = "spite: call() leaves the argument '{parameter.name}' of '{shown}' unfilled: set 'call.arguments[\"{parameter.name}\"]' before 'call()'"
    stop_when(running, missing, unfilled)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys, "", "")
    var present = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var written = parameter.parameter_type
    if not written.is_nullable {
        var given_null = HighIntermediaryRepresentation.Values.Negation(present)
        var words = misfit_words(parameter, shown)
        stop_when(running, given_null, words)
        return checked_argument(running, parameter, arguments_type, shown)
    }
    var given_name = "given_{parameter.name}"
    var nothing = HighIntermediaryRepresentation.Values.NullConstant(written)
    var declared_given = HighIntermediaryRepresentation.Statements.Declare(given_name, written, nothing, 0, "")
    running.statements.append(declared_given)
    var filling = HighIntermediaryRepresentation.Statements.Block(0)
    var checked = checked_argument(filling, parameter, arguments_type, shown)
    var assigned = HighIntermediaryRepresentation.Statements.Assign.Assign(given_name, checked, 0)
    filling.statements.append(assigned)
    var branch = HighIntermediaryRepresentation.Statements.If(present, filling, null, 0, "")
    running.statements.append(branch)
    return HighIntermediaryRepresentation.Values.LocalRead(written, given_name)
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func misfit_words(parameter: Model.ParameterModel, shown: String): String {
    var wanted = parameter.parameter_type.present()
    if wanted.kind == 'function' {
        return function_misfit_words(parameter, shown)
    }
    var wanted_shown = state.context.shown(wanted)
    if wanted.kind == 'union' or wanted.kind == 'shape' {
        var segments = wanted_shown.split(".")
        var last = segments.last()
        crash last
        wanted_shown = last
    }
    var every_rule = Validators.HighIntermediaryRepresentation.EveryRule()
    var article = every_rule.article_of(wanted_shown)
    return "spite: call() gives '{shown}' an argument '{parameter.name}' that is not {article} {wanted_shown}, the type it takes"
}

func function_misfit_words(parameter: Model.ParameterModel, shown: String): String {
    return "spite: call() gives '{shown}' an argument '{parameter.name}' that is not a Spite.Function: a function value is passed to a call known only at run time as the function bound to its object, 'object.functions[\"name\"]'"
}

func checked_argument(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var written = parameter.parameter_type
    var wanted = written.present()
    if wanted.kind == 'function' {
        return passed_function(running, parameter, arguments_type, shown)
    }
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var value_type = Model.Type('object', "String")
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name, value_type, false)
    keys.append(key)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys, "", "")
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read, "")
    if wanted.kind == 'shape' {
        fill_with_the_programs_classes(wanted)
    }
    var fits = class_test_of(held, wanted)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var other = misfit_words(parameter, shown)
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys, "", "")
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again, "")
    var kind = wanted.kind
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if kind == 'scalar' or kind == 'enumeration' {
        conversion = 'unbox'
    }
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, conversion, again_held, "")
    if written.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed, "")
    }
    return passed
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func passed_function(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var key_value_type = Model.Type('object', "String")
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name, key_value_type, false)
    keys.append(key)
    var function_type = writing.reflection_type("Spite.Function")
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys, "", "")
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read, "")
    var fits = HighIntermediaryRepresentation.Values.Class.Membership(held, function_type)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var other = function_misfit_words(parameter, shown)
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys, "", "")
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again, "")
    var bound = HighIntermediaryRepresentation.Values.Conversion(function_type, 'present', again_held, "")
    var bound_name = "passed_{parameter.name}"
    var declared_bound = HighIntermediaryRepresentation.Statements.Declare(bound_name, function_type, bound, 0, "")
    running.statements.append(declared_bound)
    var wanted = parameter.parameter_type.present()
    var wanted_shown = state.context.shown(wanted)
    var shaped = "spite: call() gives '{shown}' an argument '{parameter.name}' whose function is not a {wanted_shown}, the type it takes"
    return function_held_by(running, bound_name, parameter.parameter_type, shaped)
}

# ../../../spite_documentation/reflection.md#a-function-value-is-a-spitefunction
func function_held_by(
    running: HighIntermediaryRepresentation.Statements.Block,
    bound_name: String,
    written: Model.Type,
    shaped: String,
): SpiteCompiler.Value {
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var bound_read = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var declaration_attribute = function_model.attribute_named("_declaration")
    crash declaration_attribute
    var declaration_read = HighIntermediaryRepresentation.Values.AttributeRead(bound_read, declaration_attribute)
    var declaration_type = declaration_attribute.attribute_type.present()
    var declaration = HighIntermediaryRepresentation.Values.Conversion(
        declaration_type,
        'present',
        declaration_read,
        "",
    )
    var declaration_model = state.context.class_of(declaration_type)
    var signature_attribute = declaration_model.attribute_named("_signature")
    crash signature_attribute
    var signature = HighIntermediaryRepresentation.Values.AttributeRead(declaration, signature_attribute)
    var wanted = written.present()
    var wanted_shown = state.context.shown(wanted)
    var text_model = state.context.class_of(signature.value_type)
    var equals = text_model.function_named("equals")
    crash equals
    state.context.need(equals)
    var compared = List<SpiteCompiler.Value>()
    var wanted_text = writing.text(wanted_shown)
    compared.append(wanted_text)
    var same = HighIntermediaryRepresentation.Values.Call(equals, signature, compared, "", "")
    var differs = HighIntermediaryRepresentation.Values.Negation(same)
    stop_when(running, differs, shaped)
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var again_bound = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var value_read = HighIntermediaryRepresentation.Values.AttributeRead(again_bound, value_attribute)
    var value_type = value_attribute.attribute_type.present()
    var value = HighIntermediaryRepresentation.Values.Conversion(value_type, 'present', value_read, "")
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, 'proven', value, "")
    if written.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed, "")
    }
    return passed
}

# ../../../spite_documentation/reflection.md#a-call-built-before-it-runs
func class_test_of(held: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value {
    var fitting = Fitting(state.values.context, state.values)
    if wanted.kind != 'union' {
        return HighIntermediaryRepresentation.Values.Class.Membership(held, wanted)
    }
    var united = fitting.union_model_of(wanted)
    var boolean = state.context.boolean()
    var tested: SpiteCompiler.Value? = null
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var member_test = class_test_of(held, member)
        if tested {
            tested = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', tested, member_test, null)
        } else {
            tested = member_test
        }
        index = index + 1
    }
    crash tested
    return tested
}

func fill_with_the_programs_classes(wanted: Model.Type) {
    var fitting = Fitting(state.values.context, state.values)
    class_objects.read_every_class_of_the_program()
    var folder_map = state.context.resolver.state.symbols.map
    var index = 0
    while index < state.context.program.order.count() {
        var model = state.context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = described_names.is_the_programs(model.file.path, folder_map) and bound.is_empty() and not model.is_singleton
        var given = model.type_of_an_instance()
        if is_the_programs and model.key != state.context.program.entry and fitting.has_the_shape_members(given, wanted) {
            fitting.filled_shape(given, wanted)
        }
        index = index + 1
    }
}

func stop_an_argument_too_many(
    running: HighIntermediaryRepresentation.Statements.Block,
    declared: Model.FunctionModel,
    arguments_type: Model.Type,
    shown: String,
) {
    var dictionary = state.context.class_of(arguments_type)
    var counting = dictionary.function_named("count")
    crash counting
    state.context.need(counting)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var no_arguments = List<SpiteCompiler.Value>()
    var counted = HighIntermediaryRepresentation.Values.Call(counting, arguments, no_arguments, "", "")
    var integer = state.context.scalar_type("Integer")
    var taken: Long = declared.parameters.count()
    var limit = HighIntermediaryRepresentation.Values.WholeNumber(integer, taken, false)
    var boolean = state.context.boolean()
    var too_many = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'greater', counted, limit, null)
    var names = List<String>()
    var taken = List<String>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        names.append("'{parameter.name}'")
        taken.append(parameter.name)
        index = index + 1
    }
    var listed = names.join(", ")
    if listed.is_empty() {
        listed = "no arguments"
    }
    var found = state.context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = state.context.resolver.monomorphiser.class_model_named("Spite.Fault")
    crash fault
    state.context.need_defaults(fault.key)
    var naming = fault.function_named("argument_not_taken")
    crash naming
    state.context.need(naming)
    var fault_type = fault.type_of_an_instance()
    var no_fields = List<SpiteCompiler.Value>()
    var made_fault = HighIntermediaryRepresentation.Values.MakeObject(fault_type, null, no_fields, "", false)
    var named_arguments = List<SpiteCompiler.Value>()
    var passed = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    named_arguments.append(passed)
    var taken_text = taken.join("\t")
    var value_type = Model.Type('object', "String")
    var taken_constant = HighIntermediaryRepresentation.Values.TextConstant(taken_text, value_type, false)
    named_arguments.append(taken_constant)
    var shown_constant_value_type = Model.Type('object', "String")
    var shown_constant = HighIntermediaryRepresentation.Values.TextConstant(shown, shown_constant_value_type, false)
    named_arguments.append(shown_constant)
    var listed_constant_value_type = Model.Type('object', "String")
    var listed_constant = HighIntermediaryRepresentation.Values.TextConstant(listed, listed_constant_value_type, false)
    named_arguments.append(listed_constant)
    var named = HighIntermediaryRepresentation.Values.Call(naming, made_fault, named_arguments, "", "")
    var stopping = HighIntermediaryRepresentation.Statements.Block(0)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(named, 0)
    stopping.statements.append(evaluated)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("", 0)
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(too_many, stopping, null, 0, "")
    running.statements.append(branch)
}

func stop_when(
    running: HighIntermediaryRepresentation.Statements.Block,
    condition: SpiteCompiler.Value,
    message: String,
) {
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message, 0)
    var stopping = HighIntermediaryRepresentation.Statements.Block(0)
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, stopping, null, 0, "")
    running.statements.append(branch)
}

func call_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_attribute = function_model.attribute_named("_called")
    crash called_attribute
    var wanted = called_attribute.attribute_type.present()
    var wrapper = declared
    if not declared.parameters.is_empty() {
        wrapper = stopping_wrapper(model, declared)
    } else if declared.answer {
        wrapper = discarding_wrapper(model, declared)
    } else {
        state.context.need(declared)
    }
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

# ../../../spite_documentation/reflection.md#what-the-compiler-leaves-out
func made_stand_in(model: Model.ClassModel): SpiteCompiler.Value {
    var instance_type = model.type_of_an_instance()
    var no_instance = instance_type.nullable()
    return HighIntermediaryRepresentation.Values.NullConstant(no_instance)
}

func stopping_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_cannot_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        model.key,
        null,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    var message = "spite: call_function() cannot call '{declared.name}': it takes arguments, and call_function() passes none"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message, 0)
    body.statements.append(stopped)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func discarding_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var is_synthetic = true
    var made = Model.FunctionModel(
        name,
        model.key,
        null,
        null,
        null,
        null,
        null,
        null,
        is_synthetic,
        false,
        false,
        false,
    )
    model.declared_functions.append(made)
    state.context.need(declared)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    var no_arguments = List<SpiteCompiler.Value>()
    var call = HighIntermediaryRepresentation.Values.Call(declared, own, no_arguments, "", "")
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call, 0)
    var body = HighIntermediaryRepresentation.Statements.Block(0)
    body.statements.append(evaluated)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func add_the_reach(
    made_given: Dictionary<String, SpiteCompiler.Value>,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
) {
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    writing.need_the_making(declaration_type)
    var reads = writing.collection_of(function_model, "_reads")
    var writes = writing.collection_of(function_model, "_writes")
    made_given["reads"] = reads
    made_given["writes"] = writes
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = declarations.attribute_declaration_of(attribute, index, model)
        var declaration = writing.kept(made, declaration_type)
        var slot = "a:{attribute.name}"
        var read_fact = writing.fact("reads", declared, slot)
        writing.appended_when(read_fact, reads, declaration)
        var written_fact = writing.fact("written", declared, slot)
        writing.appended_when(written_fact, writes, declaration)
        index = index + 1
    }
}

func arguments_of_a_declaration(
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    argument_type: Model.Type,
    has_facts: Boolean,
): SpiteCompiler.Value {
    var listed = writing.collection_of(function_model, "_arguments")
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made_given = declarations.given_of_an_argument(parameter, index)
        made_given["has_facts"] = writing.flag(has_facts)
        if has_facts and feature_flags.has_feature("m") {
            made_given["is_mutated"] = writing.fact("writes", declared, "p:{parameter.name}")
        }
        var made = writing.made_by_name(argument_type, made_given)
        var local = writing.kept(made, argument_type)
        writing.appended(listed, local)
        index = index + 1
    }
    return listed
}

func returned_literal_of(declared: Model.FunctionModel): String? {
    fallback declared.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = declared.declaration
    fallback declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    fallback body.statements.count() == 1
    var only = body.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return literal_of_a_return(only)
    }
    return null
}

func literal_of_a_return(returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement): String? {
    var value = returned.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return literal_of_a_text(value)
    }
    return null
}

func literal_of_a_text(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String? {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    return piece.value()
}

func arguments_of(declared: Model.FunctionModel): SpiteCompiler.Value {
    var collections = Collections(state.values.context, state.values)
    state.statements = List<SpiteCompiler.Statement>()
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var list_type = state.context.resolver.monomorphiser.list_type_of(argument_type)
    var made_list = collections.made_list(list_type)
    var listed = writing.kept_in_scope(made_list, list_type)
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made = declarations.argument_of(parameter, index, argument_type)
        var local = writing.kept_in_scope(made, argument_type)
        writing.appended(listed, local)
        index = index + 1
    }
    state.statements.each(state.context.pending.append)
    return listed
}

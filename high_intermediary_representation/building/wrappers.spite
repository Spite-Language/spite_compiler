var state = ReflectionState()
var described_names = DescribedNames()
var feature_flags = Features(state)
var writing = Writing(state)
var class_objects = ClassObjects(state)
var declarations = Declarations(state)

func Wrappers(starting_state: ReflectionState) {
    state = starting_state
    described_names = DescribedNames()
    feature_flags = Features(starting_state)
    writing = Writing(starting_state)
    class_objects = ClassObjects(starting_state)
    declarations = Declarations(starting_state)
}

func function_object_in_place(declared: Model.FunctionModel, receiver: SpiteCompiler.Value): SpiteCompiler.Value {
    var model = state.context.program.class_named(declared.owner)
    crash model
    var function_type = writing.reflection_type("Spite.Function")
    writing.need_the_making(function_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var describer = describer_of(declared, model, function_type)
    var no_arguments = List<SpiteCompiler.Value>()
    return HighIntermediaryRepresentation.Values.Call(describer, receiver, no_arguments)
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func describer_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_type: Model.Type,
): Model.FunctionModel {
    var name = "_described_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    made.answer = function_type
    model.declared_functions.append(made)
    var body = describing_body(declared, model)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    state.context.describers.append(function)
    state.context.described_functions.append(declared)
    return made
}

func describing_body(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
): HighIntermediaryRepresentation.Statements.Block {
    var outer = state.statements
    state.statements = List<SpiteCompiler.Statement>()
    var own_type = model.type_of_an_instance()
    state.stand_in = HighIntermediaryRepresentation.Values.ThisRead(own_type)
    var local = function_object(declared, model, false, true)
    var answered = HighIntermediaryRepresentation.Statements.Return(local)
    state.statements.append(answered)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements = state.statements
    state.statements = outer
    return body
}

func redescribe(index: Integer) {
    var function = state.context.describers[index]
    var declared = state.context.described_functions[index]
    crash function
    crash declared
    var model = state.context.program.class_named(declared.owner)
    crash model
    function.body = describing_body(declared, model)
}

func function_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var declaration = declaration_object(declared, model, makes_a_stand_in, with_accesses)
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["declaration"] = declaration
    made_given["owner"] = writing.text("")
    if state.stand_in and feature_flags.has_feature("b") {
        var owner: SpiteCompiler.Value = state.stand_in
        made_given["owner"] = owner
    }
    var made = writing.made_by_name(function_type, made_given)
    var local = writing.kept(made, function_type)
    var called = call_value_of(declared, model, function_model, false)
    if called {
        writing.set_value(local, function_model, "_called", called)
    }
    if state.stand_in and feature_flags.has_feature("o") {
        var held = held_value_of(declared, function_model)
        writing.set_value(local, function_model, "_value", held)
    }
    return local
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func held_value_of(declared: Model.FunctionModel, function_model: Model.ClassModel): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var held_type = value_attribute.attribute_type.present()
    state.context.need(declared)
    return HighIntermediaryRepresentation.Values.Function.Value(held_type, declared, receiver)
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func declaration_object(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    makes_a_stand_in: Boolean,
    with_accesses: Boolean,
): SpiteCompiler.Value {
    var declaration_type = writing.reflection_type("Spite.FunctionDeclaration")
    var declaration_model = state.context.class_of(declaration_type)
    writing.need_the_making(declaration_type)
    var argument_type = writing.reflection_type("Spite.Argument")
    var made_given = Dictionary<String, SpiteCompiler.Value>()
    made_given["name"] = writing.text(declared.name)
    made_given["hole"] = writing.text("")
    made_given["index"] = writing.whole(0)
    made_given["returns"] = declarations.answer_of(declared)
    made_given["source_path"] = declarations.function_file_of(declared, model)
    if feature_flags.has_feature("o") {
        var shape = declarations.function_type_of(declared)
        var shown = state.context.shown(shape)
        made_given["signature"] = writing.text(shown)
    }
    var made = writing.made_by_name(declaration_type, made_given)
    var local = writing.kept(made, declaration_type)
    var has_facts = declarations.belongs_to_the_program(model) and declarations.can_be_built(declared)
    add_the_arguments(local, declaration_model, declared, argument_type, has_facts)
    add_the_returned_literal(local, declaration_model, declared)
    if has_facts {
        writing.set_flag(local, declaration_model, "_has_facts", true)
    }
    if has_facts and feature_flags.has_feature("w") {
        var waits = writing.fact("waits", declared, "")
        writing.set_value(local, declaration_model, "_is_resumable", waits)
    }
    if has_facts and with_accesses and feature_flags.has_feature("a") {
        add_the_reach(local, declaration_model, declared, model)
        writing.set_flag(local, declaration_model, "_has_reach", true)
    }
    if not state.stand_in and makes_a_stand_in and feature_flags.has_feature("o") {
        state.stand_in = made_stand_in(model)
    }
    if state.stand_in and feature_flags.has_feature("o") {
        var called_on = called_on_value_of(declared, model, declaration_model)
        writing.set_value(local, declaration_model, "_called_on", called_on)
    }
    return local
}

func called_on_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
): SpiteCompiler.Value {
    crash state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_on_attribute = function_model.attribute_named("_called_on")
    crash called_on_attribute
    var wanted = called_on_attribute.attribute_type.present()
    var parameter_type = wanted.parameters[0]
    crash parameter_type
    var arguments_type = wanted.parameters[1]
    crash arguments_type
    var wrapper = calling_on_wrapper(model, declared, parameter_type, arguments_type)
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func calling_on_wrapper(
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
): Model.FunctionModel {
    var name = "_call_{declared.name}_on"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    var parameter = Model.ParameterModel("instance", instance_type, false)
    made.parameters.append(parameter)
    var arguments_parameter = Model.ParameterModel("arguments", arguments_type, false)
    made.parameters.append(arguments_parameter)
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var passed = first_unpassed_parameter(declared)
    if passed.is_empty() {
        called_on_its_instance(body, model, declared, instance_type, arguments_type)
    } else {
        var message = "spite: call() cannot pass the argument '{passed}' of '{model.shown}.{declared.name}' when the call is known only at run time, since a value of its type is not told apart while the program runs: build the call from a function named in the code, 'Spite.Call({model.shown}.functions[\"{declared.name}\"], instance)'"
        var refused = HighIntermediaryRepresentation.Statements.Stop(message)
        body.statements.append(refused)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func first_unpassed_parameter(declared: Model.FunctionModel): String {
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var kind = parameter.parameter_type.kind
        var is_held = kind == 'scalar' or kind == 'enumeration' or kind == 'object'
        var is_told_apart = is_held or kind == 'union' or kind == 'shape' or kind == 'function'
        if not is_told_apart {
            return parameter.name
        }
        index = index + 1
    }
    return ""
}

func called_on_its_instance(
    body: HighIntermediaryRepresentation.Statements.Block,
    model: Model.ClassModel,
    declared: Model.FunctionModel,
    instance_type: Model.Type,
    arguments_type: Model.Type,
) {
    state.context.need(declared)
    var own_type = model.type_of_an_instance()
    var instance = HighIntermediaryRepresentation.Values.LocalRead(instance_type, "instance")
    var tested = HighIntermediaryRepresentation.Values.Class.Membership(instance, own_type)
    var narrowed = HighIntermediaryRepresentation.Values.Conversion(own_type, 'present', instance)
    var running = HighIntermediaryRepresentation.Statements.Block()
    var passed_arguments = List<SpiteCompiler.Value>()
    var shown = "{model.shown}.{declared.name}"
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var argument = passed_argument(running, parameter, arguments_type, shown)
        passed_arguments.append(argument)
        index = index + 1
    }
    stop_an_argument_too_many(running, declared, arguments_type, shown)
    var call = HighIntermediaryRepresentation.Values.Call(declared, narrowed, passed_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    running.statements.append(evaluated)
    var message = "spite: call() runs '{declared.name}', declared by '{model.shown}', on an instance of another class: a call runs a declaration on an instance of its own class"
    var refused = HighIntermediaryRepresentation.Statements.Stop(message)
    var refusing = HighIntermediaryRepresentation.Statements.Block()
    refusing.statements.append(refused)
    var branch = HighIntermediaryRepresentation.Statements.If(tested, running, refusing)
    body.statements.append(branch)
}

func passed_argument(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    state.context.need(reading)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name)
    keys.append(key)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var present = HighIntermediaryRepresentation.Values.PresenceTest(read)
    var missing = HighIntermediaryRepresentation.Values.Negation(present)
    var unfilled = "spite: call() leaves the argument '{parameter.name}' of '{shown}' unfilled: set 'call.arguments[\"{parameter.name}\"]' before 'call()'"
    stop_when(running, missing, unfilled)
    var written = parameter.parameter_type
    var wanted = written.present()
    if wanted.kind == 'function' {
        return passed_function(running, parameter, arguments_type, shown)
    }
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read)
    if wanted.kind == 'shape' {
        fill_with_the_programs_classes(wanted)
    }
    var fits = class_test_of(held, wanted)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var wanted_shown = state.context.shown(wanted)
    if wanted.kind == 'union' or wanted.kind == 'shape' {
        var segments = wanted_shown.split(".")
        var last = segments.last()
        crash last
        wanted_shown = last
    }
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    var article = typing.article_of(wanted_shown)
    var other = "spite: call() gives '{shown}' an argument '{parameter.name}' that is not {article} {wanted_shown}, the type it takes"
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again)
    var kind = wanted.kind
    var conversion: HighIntermediaryRepresentation.Values.Conversion.Kind = 'present'
    if kind == 'scalar' or kind == 'enumeration' {
        conversion = 'unbox'
    }
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, conversion, again_held)
    if written.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(written, 'nullable', passed)
    }
    return passed
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func passed_function(
    running: HighIntermediaryRepresentation.Statements.Block,
    parameter: Model.ParameterModel,
    arguments_type: Model.Type,
    shown: String,
): SpiteCompiler.Value {
    var dictionary = state.context.class_of(arguments_type)
    var reading = dictionary.function_named("get_at")
    crash reading
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var keys = List<SpiteCompiler.Value>()
    var key = HighIntermediaryRepresentation.Values.TextConstant(parameter.name)
    keys.append(key)
    var function_type = writing.reflection_type("Spite.Function")
    var function_model = state.context.class_of(function_type)
    var read = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var held_type = read.value_type.present()
    var held = HighIntermediaryRepresentation.Values.Conversion(held_type, 'present', read)
    var fits = HighIntermediaryRepresentation.Values.Class.Membership(held, function_type)
    var misfit = HighIntermediaryRepresentation.Values.Negation(fits)
    var other = "spite: call() gives '{shown}' an argument '{parameter.name}' that is not a Spite.Function: a function value is passed to a call known only at run time as the function bound to its object, 'object.functions[\"name\"]'"
    stop_when(running, misfit, other)
    var again = HighIntermediaryRepresentation.Values.Call(reading, arguments, keys)
    var again_type = again.value_type.present()
    var again_held = HighIntermediaryRepresentation.Values.Conversion(again_type, 'present', again)
    var bound = HighIntermediaryRepresentation.Values.Conversion(function_type, 'present', again_held)
    var bound_name = "passed_{parameter.name}"
    var declared_bound = HighIntermediaryRepresentation.Statements.Declare(bound_name, function_type, bound)
    running.statements.append(declared_bound)
    var bound_read = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var declaration_attribute = function_model.attribute_named("_declaration")
    crash declaration_attribute
    var declaration_read = HighIntermediaryRepresentation.Values.AttributeRead(bound_read, declaration_attribute)
    var declaration_type = declaration_attribute.attribute_type.present()
    var declaration = HighIntermediaryRepresentation.Values.Conversion(declaration_type, 'present', declaration_read)
    var declaration_model = state.context.class_of(declaration_type)
    var signature_attribute = declaration_model.attribute_named("_signature")
    crash signature_attribute
    var signature = HighIntermediaryRepresentation.Values.AttributeRead(declaration, signature_attribute)
    var wanted = parameter.parameter_type.present()
    var wanted_shown = state.context.shown(wanted)
    var text_model = state.context.class_of(signature.value_type)
    var equals = text_model.function_named("equals")
    crash equals
    state.context.need(equals)
    var compared = List<SpiteCompiler.Value>()
    var wanted_text = writing.text(wanted_shown)
    compared.append(wanted_text)
    var same = HighIntermediaryRepresentation.Values.Call(equals, signature, compared)
    var differs = HighIntermediaryRepresentation.Values.Negation(same)
    var shaped = "spite: call() gives '{shown}' an argument '{parameter.name}' whose function is not a {wanted_shown}, the type it takes"
    stop_when(running, differs, shaped)
    var value_attribute = function_model.attribute_named("_value")
    crash value_attribute
    var again_bound = HighIntermediaryRepresentation.Values.LocalRead(function_type, bound_name)
    var value_read = HighIntermediaryRepresentation.Values.AttributeRead(again_bound, value_attribute)
    var value_type = value_attribute.attribute_type.present()
    var value = HighIntermediaryRepresentation.Values.Conversion(value_type, 'present', value_read)
    var passed = HighIntermediaryRepresentation.Values.Conversion(wanted, 'proven', value)
    if parameter.parameter_type.is_nullable {
        return HighIntermediaryRepresentation.Values.Conversion(parameter.parameter_type, 'nullable', passed)
    }
    return passed
}

# ../../../spite_spec/specs/metaprogramming.md#calls-built-before-they-run
func class_test_of(held: SpiteCompiler.Value, wanted: Model.Type): SpiteCompiler.Value {
    var fitting = Fitting(state.values.context, state.values)
    if wanted.kind != 'union' {
        return HighIntermediaryRepresentation.Values.Class.Membership(held, wanted)
    }
    var united = fitting.union_model_of(wanted)
    var boolean = state.context.boolean()
    var tested: SpiteCompiler.Value? = null
    var index = 0
    while index < united.members.count() {
        var member = united.members[index]
        var member_test = class_test_of(held, member)
        if tested {
            tested = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'or', tested, member_test)
        } else {
            tested = member_test
        }
        index = index + 1
    }
    crash tested
    return tested
}

func fill_with_the_programs_classes(wanted: Model.Type) {
    var fitting = Fitting(state.values.context, state.values)
    var entry = state.context.program.class_named(state.context.program.entry)
    crash entry
    var folder = described_names.folder_of(entry.file.path)
    class_objects.read_every_class_in(folder)
    var index = 0
    while index < state.context.program.order.count() {
        var model = state.context.program.order[index]
        var bound = model.bound_types.keys()
        var is_the_programs = described_names.is_inside(model.file.path, folder) and bound.is_empty() and not model.is_singleton
        var given = model.type_of_an_instance()
        if is_the_programs and model.key != state.context.program.entry and fitting.has_the_shape_members(given, wanted) {
            fitting.filled_shape(given, wanted)
        }
        index = index + 1
    }
}

func stop_an_argument_too_many(
    running: HighIntermediaryRepresentation.Statements.Block,
    declared: Model.FunctionModel,
    arguments_type: Model.Type,
    shown: String,
) {
    var dictionary = state.context.class_of(arguments_type)
    var counting = dictionary.function_named("count")
    crash counting
    state.context.need(counting)
    var arguments = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    var no_arguments = List<SpiteCompiler.Value>()
    var counted = HighIntermediaryRepresentation.Values.Call(counting, arguments, no_arguments)
    var integer = state.context.scalar_type("Integer")
    var taken: Long = declared.parameters.count()
    var limit = HighIntermediaryRepresentation.Values.WholeNumber(integer, taken)
    var boolean = state.context.boolean()
    var too_many = HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'greater', counted, limit)
    var names = List<String>()
    var taken = List<String>()
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        names.append("'{parameter.name}'")
        taken.append(parameter.name)
        index = index + 1
    }
    var listed = names.join(", ")
    if listed.is_empty() {
        listed = "no arguments"
    }
    var found = state.context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = state.context.resolver.monomorphiser.class_model_named("Spite.Fault")
    crash fault
    state.context.need_defaults(fault.key)
    var naming = fault.function_named("argument_not_taken")
    crash naming
    state.context.need(naming)
    var fault_type = fault.type_of_an_instance()
    var no_fields = List<SpiteCompiler.Value>()
    var made_fault = HighIntermediaryRepresentation.Values.MakeObject(fault_type, null, no_fields)
    var named_arguments = List<SpiteCompiler.Value>()
    var passed = HighIntermediaryRepresentation.Values.LocalRead(arguments_type, "arguments")
    named_arguments.append(passed)
    var taken_text = taken.join("\t")
    var taken_constant = HighIntermediaryRepresentation.Values.TextConstant(taken_text)
    named_arguments.append(taken_constant)
    var shown_constant = HighIntermediaryRepresentation.Values.TextConstant(shown)
    named_arguments.append(shown_constant)
    var listed_constant = HighIntermediaryRepresentation.Values.TextConstant(listed)
    named_arguments.append(listed_constant)
    var named = HighIntermediaryRepresentation.Values.Call(naming, made_fault, named_arguments)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(named)
    stopping.statements.append(evaluated)
    var stopped = HighIntermediaryRepresentation.Statements.Stop("")
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(too_many, stopping, null)
    running.statements.append(branch)
}

func stop_when(
    running: HighIntermediaryRepresentation.Statements.Block,
    condition: SpiteCompiler.Value,
    message: String,
) {
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    var stopping = HighIntermediaryRepresentation.Statements.Block()
    stopping.statements.append(stopped)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, stopping, null)
    running.statements.append(branch)
}

func call_value_of(
    declared: Model.FunctionModel,
    model: Model.ClassModel,
    function_model: Model.ClassModel,
    makes_a_stand_in: Boolean,
): SpiteCompiler.Value? {
    if not state.stand_in and makes_a_stand_in {
        state.stand_in = made_stand_in(model)
    }
    fallback state.stand_in
    var receiver: SpiteCompiler.Value = state.stand_in
    var called_attribute = function_model.attribute_named("_called")
    crash called_attribute
    var wanted = called_attribute.attribute_type.present()
    var wrapper = declared
    if not declared.parameters.is_empty() {
        wrapper = stopping_wrapper(model, declared)
    } else if declared.answer {
        wrapper = discarding_wrapper(model, declared)
    } else {
        state.context.need(declared)
    }
    return HighIntermediaryRepresentation.Values.Function.Value(wanted, wrapper, receiver)
}

func made_stand_in(model: Model.ClassModel): SpiteCompiler.Value {
    var instance_type = model.type_of_an_instance()
    state.context.need_defaults(model.key)
    var no_arguments = List<SpiteCompiler.Value>()
    var made = HighIntermediaryRepresentation.Values.MakeObject(instance_type, null, no_arguments)
    return writing.kept(made, instance_type)
}

func stopping_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_cannot_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var message = "spite: call_function() cannot call '{declared.name}': it takes arguments, and call_function() passes none"
    var stopped = HighIntermediaryRepresentation.Statements.Stop(message)
    body.statements.append(stopped)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func discarding_wrapper(model: Model.ClassModel, declared: Model.FunctionModel): Model.FunctionModel {
    var name = "_call_{declared.name}"
    var known = model.function_named(name)
    if known {
        return known
    }
    var made = Model.FunctionModel(name, model.key)
    made.is_synthetic = true
    model.declared_functions.append(made)
    state.context.need(declared)
    var instance_type = model.type_of_an_instance()
    var own = HighIntermediaryRepresentation.Values.ThisRead(instance_type)
    var no_arguments = List<SpiteCompiler.Value>()
    var call = HighIntermediaryRepresentation.Values.Call(declared, own, no_arguments)
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(call)
    var body = HighIntermediaryRepresentation.Statements.Block()
    body.statements.append(evaluated)
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    state.context.synthetic_functions.append(function)
    return made
}

func add_the_reach(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    model: Model.ClassModel,
) {
    var declaration_type = writing.reflection_type("Spite.AttributeDeclaration")
    writing.need_the_making(declaration_type)
    var reads = writing.read_attribute(function, function_model, "_reads")
    var writes = writing.read_attribute(function, function_model, "_writes")
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var made = declarations.attribute_declaration_of(attribute, index, model)
        var declaration = writing.kept(made, declaration_type)
        var slot = "a:{attribute.name}"
        var read_fact = writing.fact("reads", declared, slot)
        writing.appended_when(read_fact, reads, declaration)
        var written_fact = writing.fact("written", declared, slot)
        writing.appended_when(written_fact, writes, declaration)
        index = index + 1
    }
}

func add_the_arguments(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
    argument_type: Model.Type,
    has_facts: Boolean,
) {
    var argument_model = state.context.class_of(argument_type)
    var listed = writing.read_attribute(function, function_model, "_arguments")
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made = declarations.argument_of(parameter, index, argument_type)
        var local = writing.kept(made, argument_type)
        if has_facts {
            writing.set_flag(local, argument_model, "_has_facts", true)
        }
        if has_facts and feature_flags.has_feature("m") {
            var mutated = writing.fact("writes", declared, "p:{parameter.name}")
            writing.set_value(local, argument_model, "_is_mutated", mutated)
        }
        writing.appended(listed, local)
        index = index + 1
    }
}

func add_the_returned_literal(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    declared: Model.FunctionModel,
) {
    fallback declared.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = declared.declaration
    fallback declaration.body
    var body: AbstractSyntaxTree.Shapes.Statements.Block = declaration.body
    fallback body.statements.count() == 1
    var only = body.statements[0]
    if only.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        add_a_literal_return(function, function_model, only)
    }
}

func add_a_literal_return(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    var value = returned.value
    if value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        add_a_literal(function, function_model, value)
    }
}

func add_a_literal(
    function: SpiteCompiler.Value,
    function_model: Model.ClassModel,
    literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral,
) {
    fallback literal.pieces.count() == 1
    var piece = literal.pieces[0]
    fallback not piece.hole
    var written = piece.value()
    writing.set_text(function, function_model, "_returned_literal", written)
}

func arguments_of(declared: Model.FunctionModel): SpiteCompiler.Value {
    state.statements = List<SpiteCompiler.Statement>()
    var argument_type = writing.reflection_type("Spite.Argument")
    writing.need_the_making(argument_type)
    var list_type = state.context.resolver.monomorphiser.list_type_of(argument_type)
    var made_list = state.values.made_list(list_type)
    var listed = writing.kept_in_scope(made_list, list_type)
    var index = 0
    while index < declared.parameters.count() {
        var parameter = declared.parameters[index]
        var made = declarations.argument_of(parameter, index, argument_type)
        var local = writing.kept_in_scope(made, argument_type)
        writing.appended(listed, local)
        index = index + 1
    }
    state.statements.each(state.context.pending.append)
    return listed
}

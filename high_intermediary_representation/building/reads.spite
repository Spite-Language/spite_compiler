var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = Context(no_program, no_resolver)
var values = Values(context)

func Reads(starting_context: Context, starting_values: Values) {
    context = starting_context
    values = starting_values
}

func named_or_described(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    expected: Model.Type?,
): SpiteCompiler.Value {
    if expected and identifier.is_a_class_name and expected.kind == 'object' and expected.name == "Spite.Class" {
        return class_named_as_a_value(identifier)
    }
    return name_value(identifier)
}

func class_named_as_a_value(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): SpiteCompiler.Value {
    var path = List<String>()
    path.append(identifier.name)
    var described = context.resolver.types.class_type_in(
        path,
        identifier.generic_arguments,
        context.current_class,
        context.line,
    )
    var reflection = Reflection(context, values)
    if described.kind == 'nothing' {
        return reflection.class_objects.class_object("Nothing")
    }
    return reflection.class_objects.class_object(described.name)
}

func name_value(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): SpiteCompiler.Value {
    var literals = Literals(context, values)
    var internal_name = context.scope.internal_name_of(identifier.name)
    if internal_name {
        note_a_copy_read(internal_name)
        var local_type = context.scope.type_of(internal_name)
        crash local_type
        var declared_type = context.scope.types[internal_name]
        crash declared_type
        if declared_type.is_nullable and not local_type.is_nullable {
            note_a_loop_read(internal_name)
        }
        var narrows_a_handle = declared_type.kind == 'handle' and local_type.kind != 'handle'
        if narrows_a_handle {
            var handle_read = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            var joined_read = values.result_of_handle(handle_read)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'present', joined_read)
        }
        var is_boxed = declared_type.kind == 'shape' and values.is_held_in_a_box(local_type)
        if is_boxed {
            var boxed = HighIntermediaryRepresentation.Values.LocalRead(declared_type, internal_name)
            return HighIntermediaryRepresentation.Values.Conversion(local_type, 'unbox', boxed)
        }
        return HighIntermediaryRepresentation.Values.LocalRead(local_type, internal_name)
    }
    var attribute = context.current_class.attribute_named(identifier.name)
    if attribute {
        var own = literals.this_value()
        if own.value_type.kind == 'scalar' {
            return scalar_attribute(own, attribute)
        }
        if attribute.declaration and is_a_library_number(attribute) {
            return values.value_of(attribute.declaration.value, attribute.attribute_type)
        }
        var read = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
        return narrowed(read, "this.{identifier.name}")
    }
    var function = context.current_class.function_named(identifier.name)
    if function {
        var walks = KnownWalks(context, values)
        var walker = walks.run_time_walker(function)
        return function_value(walker)
    }
    var walking = context.current_function
    var names_the_walked = identifier.name == walking.bound_parameter and not walking.bound_parameter.is_empty()
    if names_the_walked {
        return walked_name_value(walking)
    }
    var reflection = Reflection(context, values)
    if identifier.name == "class" {
        return reflection.class_objects.class_object(context.current_class.key)
    }
    if identifier.name == "namespace" {
        var own_namespace = reflection.described_names.namespace_of(context.current_class.key)
        var found_namespace = reflection.class_objects.namespace_object(own_namespace)
        if found_namespace.value_type.is_nullable {
            return found_namespace
        }
        var maybe_type = found_namespace.value_type.nullable()
        var maybe = HighIntermediaryRepresentation.Values.Conversion(maybe_type, 'nullable', found_namespace)
        return narrowed(maybe, "this.namespace")
    }
    if identifier.name.starts_with("$") {
        var bound = context.current_class.bound_types[identifier.name]
        if not bound {
            values.typing.refuse_an_undeclared_generic(context, identifier.name)
        }
        crash bound
        return reflection.class_objects.class_object(bound.name)
    }
    var getter = context.current_class.function_named("get_{identifier.name}")
    if getter and getter.parameters.is_empty() and getter.answer {
        return own_getter_read(getter)
    }
    var folder = context.resolver.state.symbols.namespace_folder(identifier.name)
    if folder {
        return reflection.class_objects.namespace_object(folder.namespace)
    }
    var known = KnownCalls(context, values)
    known.refuse_a_value_read(identifier.name)
    values.typing.refuse_unknown_name(context, identifier.name)
    return values.unbuilt()
}

func own_getter_read(getter: Model.FunctionModel): SpiteCompiler.Value {
    var literals = Literals(context, values)
    var calls = Calls(context, values)
    var no_written = List<SpiteCompiler.Expression>()
    var own = literals.this_value()
    return calls.called(getter, own, no_written)
}

func walked_name_value(walking: Model.FunctionModel): SpiteCompiler.Value {
    var literals = Literals(context, values)
    if walking.binds_a_class {
        return bound_class_object(walking)
    }
    literals.need_text_constants()
    var made = HighIntermediaryRepresentation.Values.TextConstant(walking.bound_member)
    made.value_type = context.resolver.types.walked_name_type()
    return made
}

func function_value(function: Model.FunctionModel): SpiteCompiler.Value {
    var literals = Literals(context, values)
    context.need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    var last = function.parameters.last()
    if last {
        function_type.is_variadic = last.is_variadic
    }
    var own = literals.this_value()
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, function, own)
}

func bound_function_value(function: Model.FunctionModel, receiver: SpiteCompiler.Value): SpiteCompiler.Value {
    context.need(function)
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = function.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = function.answer
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, function, receiver)
}

# ../../../spite_spec/specs/values_and_types.md#named-numbers
func scalar_attribute(number: SpiteCompiler.Value, attribute: Model.AttributeModel): SpiteCompiler.Value {
    if attribute.declaration and is_a_named_number(attribute) {
        return values.value_of(attribute.declaration.value, attribute.attribute_type)
    }
    return number_room(number, attribute)
}

func is_a_library_number(attribute: Model.AttributeModel): Boolean {
    fallback not values.machinery_names.contains(attribute.name)
    var owner = context.program.class_named(attribute.owner)
    fallback owner
    var library = Mapping.LibraryFile()
    fallback library.holds(owner.file.path)
    return is_a_named_number(attribute)
}

func is_a_named_number(attribute: Model.AttributeModel): Boolean {
    fallback attribute.name.starts_with("_")
    fallback attribute.declaration
    fallback is_a_written_number(attribute.declaration.value)
    var written = context.written_privates_of(attribute.owner)
    return not written.contains(attribute.name)
}

func is_a_written_number(expression: SpiteCompiler.Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return expression.kind == 'integer_literal' or expression.kind == 'decimal_literal'
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return expression.operator == 'minus' and is_a_written_number(expression.operand)
    }
    return false
}

func number_room(number: SpiteCompiler.Value, attribute: Model.AttributeModel): SpiteCompiler.Value {
    var scalar = values.scalars.of(number.value_type.name)
    crash scalar
    var room_type = attribute.attribute_type
    var room_model = context.class_of(room_type)
    context.need_defaults(room_model.key)
    var constructor = values.constructor_of(room_model)
    crash constructor
    context.need(constructor)
    var integer = context.scalar_type("Integer")
    var size = HighIntermediaryRepresentation.Values.WholeNumber(integer, scalar.size)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(size)
    var made = HighIntermediaryRepresentation.Values.MakeObject(room_type, constructor, arguments)
    return HighIntermediaryRepresentation.Values.NumberRoom(made, number, scalar.size)
}

func narrowed(value: SpiteCompiler.Value, path: String): SpiteCompiler.Value {
    var narrowed_type = context.scope.narrowed_type_of(path)
    if narrowed_type and path == context.rechecked_path and value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        note_a_rechecked_read(value, path, narrowed_type)
        return value
    }
    if narrowed_type {
        note_a_loop_read(path)
        note_a_narrowed_read(value, path, narrowed_type)
        var is_boxed = value.value_type.kind == 'shape' and values.is_held_in_a_box(narrowed_type)
        if is_boxed {
            return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'unbox', value)
        }
        return HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'present', value)
    }
    return value
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func note_a_rechecked_read(value: SpiteCompiler.Value, path: String, narrowed_type: Model.Type) {
    var reads_before = context.narrowed_reads.count()
    note_a_narrowed_read(value, path, narrowed_type)
    fallback context.narrowed_reads.count() > reads_before
    var read = context.narrowed_reads.last()
    crash read
    read.is_a_new_check = true
    fallback context.rechecked_site
    context.rechecked_site.kept_read = read
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func note_a_narrowed_read(value: SpiteCompiler.Value, path: String, narrowed_type: Model.Type) {
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    var start = context.scope.stamp_of(path)
    var end = context.logged_calls.count()
    fallback start < end or not context.loop_bases.is_empty()
    var read = read_since_its_check(path, value.attribute, narrowed_type)
    read.object = value.object
    context.narrowed_reads.append(read)
}

# ../../PROOFS.md#a-getter-narrows-while-it-only-reads
func note_a_getter_read(value: SpiteCompiler.Value, path: String, narrowed_type: Model.Type) {
    fallback value.class == HighIntermediaryRepresentation.Values.Call
    var no_type = Model.Type('nothing', "")
    var no_attribute = Model.AttributeModel("", "", no_type)
    var read = read_since_its_check(path, no_attribute, narrowed_type)
    read.getter = value.function.key()
    read.getter_name = value.function.name
    read.object = value.receiver
    context.narrowed_reads.append(read)
}

func read_since_its_check(
    path: String,
    attribute: Model.AttributeModel,
    narrowed_type: Model.Type,
): HighIntermediaryRepresentation.NarrowedRead {
    var read = HighIntermediaryRepresentation.NarrowedRead(path, attribute)
    read.calls = context.logged_calls
    read.call_lines = context.logged_lines
    read.writes = context.logged_writes
    read.left_starts = context.left_starts
    read.left_ends = context.left_ends
    read.start = context.scope.stamp_of(path)
    read.proven_in_frame = context.scope.frame_of(path)
    read.end = context.logged_calls.count()
    read.loop_end = read.end
    read.loop_start = context.innermost_loop_start()
    read.narrowed_type = narrowed_type
    read.line = context.line
    read.path = context.path()
    read.owner = values.typing.plain_class_name(context.current_class.shown)
    read.function_name = values.typing.shown_function_name(context.current_function)
    return read
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func note_a_copy_read(internal_name: String) {
    note_a_copied_getter_read(internal_name)
    var attributes = context.scope.copied_attributes[internal_name]
    fallback attributes
    var start = context.scope.copied_stamps[internal_name]
    crash start
    var end = context.logged_calls.count()
    fallback start < end or not context.loop_bases.is_empty()
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var read = copy_read_of(internal_name, attribute)
        context.narrowed_reads.append(read)
        index = index + 1
    }
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func note_a_copied_getter_read(internal_name: String) {
    var getter = context.scope.copied_getters[internal_name]
    fallback getter and not getter.is_empty()
    var no_type = Model.Type('nothing', "")
    var no_attribute = Model.AttributeModel("", "", no_type)
    var read = copy_read_of(internal_name, no_attribute)
    read.getter = getter
    context.narrowed_reads.append(read)
}

func copy_read_of(internal_name: String, attribute: Model.AttributeModel): HighIntermediaryRepresentation.NarrowedRead {
    var start = context.scope.copied_stamps[internal_name]
    crash start
    var line = context.scope.copied_lines[internal_name]
    crash line
    var frame = context.scope.copied_frames[internal_name]
    crash frame
    var read = HighIntermediaryRepresentation.NarrowedRead(internal_name, attribute)
    read.calls = context.logged_calls
    read.call_lines = context.logged_lines
    read.writes = context.logged_writes
    read.left_starts = context.left_starts
    read.left_ends = context.left_ends
    read.start = start
    read.proven_in_frame = frame
    read.end = context.logged_calls.count()
    read.loop_end = read.end
    read.loop_start = context.innermost_loop_start()
    read.path = context.path()
    read.copy_line = line
    return read
}

func note_a_loop_read(path: String) {
    fallback not context.loop_bases.is_empty()
    fallback not context.loop_reads.contains(path)
    context.loop_reads.append(path)
}

func member_value(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value {
    var walked_lists = WalkedLists(context, values)
    var calls = Calls(context, values)
    var templates = Templates(context, values)
    var naming = Naming(context, values)
    var named_namespace = namespace_named(member)
    if named_namespace {
        return named_namespace
    }
    var dotted = dotted_class(member)
    if dotted {
        return dotted
    }
    var described_member = bound_parameter_member(member)
    if described_member {
        return described_member
    }
    walked_lists.refuse_a_list_over_a_type(member)
    var folded_flag = folded_class_flag(member)
    if folded_flag {
        return folded_flag
    }
    var generic_values = generic_enum_values(member)
    if generic_values {
        return generic_values
    }
    var reflected = reflected_member(member)
    if reflected {
        return reflected
    }
    var bound_singleton = bound_singleton_question(member)
    if bound_singleton {
        return bound_singleton
    }
    refuse_a_class_function_value(member)
    var through_its_declaration = asked_of_a_function_values_declaration(member)
    if through_its_declaration {
        return through_its_declaration
    }
    var written_target = values.value_of(member.target, null)
    if written_target.value_type.kind == 'handle' {
        return handle_member(written_target, member.name)
    }
    var target = written_target
    var folded_setting = folded_build_read(target, member.name)
    if folded_setting {
        return folded_setting
    }
    if target.value_type.kind == 'function' {
        return function_value_member(member, target)
    }
    var names_a_symbol = target.value_type.is_a_walked_name and not target.value_type.is_nullable
    if names_a_symbol and member.name == "name" {
        return target
    }
    if member.name == "class" and not values.has_its_own_class(target) {
        var reflection = Reflection(context, values)
        if target.value_type.kind == 'enumeration' {
            var operators = Operators(context, values)
            reflection.writing.check_a_maybe_enum(target)
            operators.run_what_a_fold_drops(target)
            return reflection.class_objects.enum_object(target.value_type.name)
        }
        return reflection.making.class_of_value(target)
    }
    if target.value_type.kind == 'shape' {
        var no_arguments = List<SpiteCompiler.Expression>()
        if member.name == "attributes" {
            listing_attributes(target.value_type)
            return calls.shape_call(target, "_attribute_list", no_arguments)
        }
        var shape_function = shape_function_value(target, member.name)
        if shape_function {
            return shape_function
        }
        values.refuse_a_private_member_of_a_type(target.value_type, member.name)
        return calls.shape_call(target, member.name, no_arguments)
    }
    if target.value_type.kind == 'union' {
        var read_name = union_member_name_of(target.value_type, member.name)
        var through = values.union_shape_of(target.value_type, read_name)
        var as_shape = Model.Type('shape', through.key)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', target)
        var none_written = List<SpiteCompiler.Expression>()
        values.refuse_a_private_member_of_a_type(shaped.value_type, read_name)
        return calls.shape_call(shaped, read_name, none_written)
    }
    if target.value_type.is_nullable {
        values.note_a_maybe_null("member", target, member.name, target.value_type)
        target = values.as_present(target)
    }
    var owner = values.present_class_of(target)
    values.refuse_a_private_name(owner, member.name)
    var attribute = owner.attribute_named(member.name)
    var getter = owner.function_named("get_{member.name}")
    var spelled_preset = naming.pascal_case_of(member.name)
    if owner.preset_named(spelled_preset) {
        values.typing.refuse_constant_on_value(context, owner.shown, spelled_preset)
    }
    var is_outside = owner.key != context.current_class.key
    if not getter and is_outside {
        getter = templates.member_template_of(owner, "get_{member.name}")
    }
    var reads_through_a_getter = is_outside or not attribute
    if reads_through_a_getter and getter {
        var no_arguments = List<SpiteCompiler.Expression>()
        var read = calls.called(getter, target, no_arguments)
        var getter_printer = Printers.Spite.ExpressionPrinter(member)
        var getter_path = getter_printer.text()
        var narrowed_type = context.scope.narrowed_type_of(getter_path)
        if narrowed_type {
            note_a_getter_read(read, getter_path, narrowed_type)
            var proven = HighIntermediaryRepresentation.Values.Conversion(narrowed_type, 'proven', read)
            proven.shown = getter_path
            return proven
        }
        return read
    }
    var lists_its_attributes = not attribute and member.name == "attributes"
    var is_stored_inline = target.value_type.kind == 'scalar' or target.value_type.name == "String"
    if lists_its_attributes and is_stored_inline and not target.value_type.is_nullable {
        var inline_reflection = Reflection(context, values)
        var operators = Operators(context, values)
        operators.run_what_a_fold_drops(target)
        return inline_reflection.member_lists.no_attribute_list()
    }
    if lists_its_attributes and target.value_type.kind == 'object' {
        var reflection = Reflection(context, values)
        return reflection.member_lists.attributes_of_an_object(target, owner)
    }
    var lists_its_functions = not attribute and member.name == "functions"
    if lists_its_functions and target.value_type.kind == 'object' {
        var listing = Reflection(context, values)
        var listed = listing.member_lists.function_list_of(owner)
        var no_values = List<SpiteCompiler.Value>()
        return HighIntermediaryRepresentation.Values.Call(listed, target, no_values)
    }
    var can_be_bound = target.value_type.kind == 'object' or target.value_type.kind == 'scalar'
    if not attribute and can_be_bound and not target.value_type.is_nullable {
        var named_function = owner.function_named(member.name)
        if named_function {
            return bound_function_value(named_function, target)
        }
    }
    if not attribute and owner.key == "DynamicLibrary" {
        var constants = ForeignConstants(context, values)
        return constants.constant_of(target, member.name)
    }
    if not attribute {
        var shown = context.shown(target.value_type)
        values.typing.refuse_unknown_member(context, shown, member.name)
    }
    crash attribute
    if target.value_type.kind == 'scalar' {
        return scalar_attribute(target, attribute)
    }
    var read = HighIntermediaryRepresentation.Values.AttributeRead(target, attribute)
    var printer = Printers.Spite.ExpressionPrinter(member)
    var path = printer.text()
    return narrowed(read, path)
}

func bound_parameter_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var function = context.current_function
    fallback not function.bound_parameter.is_empty()
    var target = member.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return described_by_the_parameter(target, member.name, function)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return described_through_the_declaration(target, member.name, function)
    }
    return null
}

# ../../../spite_spec/specs/reflection.md#a-class-and-an-instance
func described_through_the_declaration(
    declared: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    asked: String,
    function: Model.FunctionModel,
): SpiteCompiler.Value? {
    fallback declared.name == "declaration" and function.walked_object and not function.binds_a_function_declaration
    var target = declared.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        fallback asked != "value" and asked != "owner"
        if asked == "source_file" and target.name == function.bound_parameter {
            return read_through_the_declaration(function, asked)
        }
        return described_by_the_parameter(target, asked, function)
    }
    return null
}

func described_by_the_parameter(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    asked: String,
    function: Model.FunctionModel,
): SpiteCompiler.Value? {
    var naming = Naming(context, values)
    fallback target.name == function.bound_parameter
    if function.binds_a_function_declaration {
        return described_function_declaration(asked, function)
    }
    var integer = context.scalar_type("Integer")
    var camel = naming.camel_case_of(function.bound_member)
    var pascal = naming.pascal_case_of(function.bound_member)
    if asked == "name" {
        return values.described_text(function.bound_member)
    } else if asked == "camel_case_name" {
        return values.described_text(camel)
    } else if asked == "pascal_case_name" {
        return values.described_text(pascal)
    } else if asked == "index" {
        return HighIntermediaryRepresentation.Values.WholeNumber(integer, function.bound_member_index)
    } else if asked == "class" {
        return bound_class_object(function)
    } else if asked == "value" {
        return walked_value(function)
    } else if asked == "owner" and function.walked_object {
        return walked_object_read(function)
    } else if asked == "declaration" and function.walked_object {
        return walked_declaration(function)
    } else if asked == "source_file" and not function.walked_object {
        return read_through_the_declaration(function, asked)
    } else {
        return null
    }
}

# ../../../spite_spec/specs/reflection.md#a-class-and-an-instance
func walked_declaration(function: Model.FunctionModel): SpiteCompiler.Value? {
    fallback function.walked_object
    return member_declaration(function.walked_object.name, "attributes", function.bound_member)
}

func read_through_the_declaration(function: Model.FunctionModel, asked: String): SpiteCompiler.Value? {
    var calls = Calls(context, values)
    var class_key = function.walked_declarations_of
    if function.walked_object {
        class_key = function.walked_object.name
    }
    fallback not class_key.is_empty()
    var declaration = member_declaration(class_key, "attributes", function.bound_member)
    var no_arguments = List<SpiteCompiler.Value>()
    return calls.method_call(declaration, "get_{asked}", no_arguments)
}

# ../../../spite_spec/specs/reflection.md#reaching-a-class
func member_declaration(class_key: String, listing: String, name: String): SpiteCompiler.Value {
    var calls = Calls(context, values)
    var reflection = Reflection(context, values)
    var described = reflection.class_objects.class_object(class_key)
    var no_arguments = List<SpiteCompiler.Value>()
    var listed = calls.method_call(described, "get_{listing}", no_arguments)
    var named = values.described_text(name)
    var keys = List<SpiteCompiler.Value>()
    keys.append(named)
    var found = calls.method_call(listed, "get_at", keys)
    var present_type = found.value_type.present()
    var proven = HighIntermediaryRepresentation.Values.Conversion(present_type, 'proven', found)
    proven.shown = "{class_key}.{listing}[\"{name}\"]"
    return proven
}

func described_function_declaration(asked: String, function: Model.FunctionModel): SpiteCompiler.Value? {
    var integer = context.scalar_type("Integer")
    if asked == "name" {
        return values.described_text(function.bound_function)
    } else if asked == "hole" {
        return walked_name_value(function)
    } else if asked == "index" {
        return HighIntermediaryRepresentation.Values.WholeNumber(integer, function.bound_member_index)
    } else if is_read_through_a_declaration(asked) {
        return function_read_through_its_declaration(function, asked)
    } else {
        return null
    }
}

# ../../../spite_documentation/reflection.md#spitefunctiondeclaration
func is_read_through_a_declaration(asked: String): Boolean {
    var through = asked == "reads" or asked == "writes" or asked == "source_file" or asked == "returns"
    return through or asked == "is_resumable" or asked == "returned_literal"
}

func function_read_through_its_declaration(function: Model.FunctionModel, asked: String): SpiteCompiler.Value? {
    var calls = Calls(context, values)
    fallback not function.bound_class.is_empty() and not function.bound_function.starts_with("_")
    fallback function.bound_class != context.program.entry
    var declaration = member_declaration(function.bound_class, "functions", function.bound_function)
    var no_arguments = List<SpiteCompiler.Value>()
    return calls.method_call(declaration, "get_{asked}", no_arguments)
}

func walked_value(function: Model.FunctionModel): SpiteCompiler.Value? {
    var literals = Literals(context, values)
    if function.bound_member_type and not function.walked_object and function.bound_member_type.kind == 'enumeration' {
        return literals.enum_value(function.bound_member, function.bound_member_type)
    }
    if not function.walked_object and not function.walked_declarations_of.is_empty() {
        refuse_a_declaration_value(function)
    }
    fallback function.walked_object
    var object = walked_object_read(function)
    var model = context.class_of(function.walked_object)
    var attribute = model.attribute_named(function.bound_member)
    crash attribute
    return HighIntermediaryRepresentation.Values.AttributeRead(object, attribute)
}

func refuse_a_declaration_value(function: Model.FunctionModel) {
    var parts = function.walked_declarations_of.split(".")
    var last = parts.last()
    crash last
    var names = Mapping.Names()
    var instance = names.snake_case_of(last)
    values.typing.refuse_a_declaration_value(context, function.bound_parameter, instance)
}

func walked_object_read(function: Model.FunctionModel): SpiteCompiler.Value {
    crash function.walked_object
    var internal_name = context.scope.internal_name_of("_walked")
    crash internal_name
    return HighIntermediaryRepresentation.Values.LocalRead(function.walked_object, internal_name)
}

func bound_singleton_question(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var function = context.current_function
    fallback member.name == "is_singleton" and function.bound_member_type
    var asked = member.target
    var names_the_class = false
    if asked.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and asked.name == "class" {
        names_the_class = names_the_walked_attribute(asked.target, function)
    }
    fallback names_the_class
    var bound: Model.Type = function.bound_member_type
    var model = context.program.class_named(bound.name)
    if not model or bound.is_nullable {
        return values.boolean_constant(false)
    }
    return values.boolean_constant(model.is_singleton)
}

func names_the_walked_attribute(described: SpiteCompiler.Expression?, function: Model.FunctionModel): Boolean {
    if described.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and described.name == "declaration" {
        return names_the_walked_attribute(described.target, function)
    }
    if described.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return described.name == function.bound_parameter
    }
    return false
}

func bound_class_object(function: Model.FunctionModel): SpiteCompiler.Value {
    crash function.bound_member_type
    var reflection = Reflection(context, values)
    if function.bound_member_type.is_nullable {
        return reflection.class_objects.class_object("{function.bound_member_type.name}?")
    }
    return reflection.class_objects.class_object(function.bound_member_type.name)
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func folded_build_read(target: SpiteCompiler.Value, name: String): SpiteCompiler.Value? {
    var held = target.value_type
    fallback held.kind == 'object' and held.name == "Build" and not held.is_nullable
    var flags = context.build_flags
    var is_live = flags["hot_reload"] == "true" or flags["repl"] == "true" or flags["development"] == "true"
    fallback not is_live or is_a_library_option(name)
    context.folded_build_reads = context.folded_build_reads + 1
    return folded_setting_named(name)
}

# ../../../spite_spec/specs/programs.md#build-settings-build
func is_a_library_option(name: String): Boolean {
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback library.holds(path)
    var symbols = context.resolver.state.symbols
    var paths = symbols.files.keys()
    var index = 0
    while index < paths.count() {
        var source_path = paths[index]
        var source = symbols.files[source_path]
        crash source
        var is_the_library_build = source.namespace == "Build" and library.holds(source_path)
        if is_the_library_build and declares_a_field(source, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func declares_a_field(source: AbstractSyntaxTree.Shapes.SourceFile, name: String): Boolean {
    var index = 0
    while index < source.declarations.count() {
        var declaration = source.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration and declaration.name == name {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func folded_setting_named(name: String): SpiteCompiler.Value? {
    var settings = context.program.class_named("Build")
    fallback settings
    var field = settings.attribute_named(name)
    fallback field
    var field_type = field.attribute_type
    fallback field_type.kind == 'scalar' or field_type.kind == 'object' and field_type.name == "String"
    var given = context.build_value_given(name)
    if given {
        return build_value_of(given, field_type)
    }
    fallback field.declaration
    var written = field.declaration.value
    return build_default_of(written, field_type)
}

func build_value_of(given: String, field_type: Model.Type): SpiteCompiler.Value? {
    if field_type.name == "String" {
        return values.described_text(given)
    }
    if field_type.name == "Boolean" {
        var flag = 0
        if given == "true" {
            flag = 1
        }
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag)
    }
    var scalar = values.scalars.of(field_type.name)
    fallback scalar
    if scalar.is_decimal {
        return HighIntermediaryRepresentation.Values.DecimalNumber(field_type, given)
    }
    var number: Long? = given
    fallback number
    return HighIntermediaryRepresentation.Values.WholeNumber(field_type, number)
}

func build_default_of(written: SpiteCompiler.Expression?, field_type: Model.Type): SpiteCompiler.Value? {
    var fitting = Fitting(context, values)
    if written.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        fallback field_type.name == "String" and written.pieces.count() <= 1
        var piece = written.pieces.first()
        if not piece {
            return values.described_text("")
        }
        fallback not piece.hole
        return values.described_text(piece.text)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return build_literal_of(written, field_type)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return build_field_default_of(written.name, field_type)
    }
    fallback is_a_constant_default(written)
    return fitting.fitted_value_of(written, field_type)
}

func build_field_default_of(name: String, field_type: Model.Type): SpiteCompiler.Value? {
    var settings = context.program.class_named("Build")
    fallback settings and values.build_defaults_read < 16
    var other = settings.attribute_named(name)
    fallback other and other.attribute_type.name == field_type.name
    values.build_defaults_read = values.build_defaults_read + 1
    var folded = folded_setting_named(name)
    values.build_defaults_read = values.build_defaults_read - 1
    return folded
}

func build_literal_of(
    written: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
    field_type: Model.Type,
): SpiteCompiler.Value? {
    var fitting = Fitting(context, values)
    if written.kind == 'keyword_true' {
        return build_value_of("true", field_type)
    }
    if written.kind == 'keyword_false' {
        return build_value_of("false", field_type)
    }
    fallback written.kind == 'integer_literal' or written.kind == 'decimal_literal'
    return fitting.fitted_value_of(written, field_type)
}

# ../../OPTIMIZATIONS.md#build-settings-are-constants
func is_a_constant_default(written: SpiteCompiler.Expression?): Boolean {
    var operators = Operators(context, values)
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return written.kind == 'integer_literal' or written.kind == 'decimal_literal'
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        return written.operator == 'minus' and is_a_constant_default(written.operand)
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        var is_arithmetic = not operators.is_a_comparison(written.operator)
        return is_arithmetic and is_a_constant_default(written.left) and is_a_constant_default(written.right)
    }
    return false
}

func namespace_named(expression: SpiteCompiler.Expression?): SpiteCompiler.Value? {
    var path = values.class_path_of(expression)
    fallback not path.is_empty()
    var written = path.join(".")
    var folder = context.resolver.state.symbols.namespace_folder(written)
    fallback folder
    var reflection = Reflection(context, values)
    return reflection.class_objects.namespace_object(folder.namespace)
}

# ../../OPTIMIZATIONS.md#a-question-on-a-codegen-type-folds
func folded_class_flag(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var asks_a_flag = member.name == "is_fixed_size" or member.name == "is_singleton" or member.name == "is_made_plainly" or member.name == "is_number"
    var target = member.target
    var bound_name = ""
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        bound_name = target.name
    }
    fallback asks_a_flag and bound_name.starts_with("$")
    var bound = context.current_class.bound_types[bound_name]
    fallback bound
    if member.name == "is_number" {
        var is_number = is_a_number_class(bound)
        return flag_value(is_number)
    }
    fallback bound.kind == 'object' and not bound.is_nullable and context.has_a_class(bound)
    var model = context.class_of(bound)
    var holds = model.is_singleton
    if member.name == "is_fixed_size" {
        var reflection = Reflection(context, values)
        holds = reflection.fills.is_fixed_size(model)
    }
    if member.name == "is_made_plainly" {
        holds = model.is_made_plainly()
    }
    return flag_value(holds)
}

func flag_value(holds: Boolean): SpiteCompiler.Value {
    var flag = 0
    if holds {
        flag = 1
    }
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag)
}

# ../../../spite_documentation/values_and_types.md#a-number-library-declares-the-type-it-needs
func is_a_number_class(bound: Model.Type): Boolean {
    fallback bound.kind == 'scalar' and not bound.is_nullable
    var scalar = values.scalars.of(bound.name)
    fallback scalar
    return scalar.is_a_number
}

func generic_enum_values(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    fallback member.name == "values"
    var path = values.tested_class_path_of(member.target)
    fallback path.count() == 1
    var first = path[0]
    fallback first.starts_with("$")
    return enum_values_of(path)
}

func reflected_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var calls = Calls(context, values)
    var class_path = values.class_path_of(member.target)
    fallback not class_path.is_empty()
    var type_arguments = values.type_arguments_of(member.target)
    values.refuse_arguments_on_a_plain_name(class_path, type_arguments)
    var written = class_path.join(".")
    var reflection = Reflection(context, values)
    var names_a_list_of_every = member.name == "instances" and type_arguments.is_empty()
    if written == "Spite.Class" and names_a_list_of_every {
        return reflection.making.every_class()
    }
    if written == "Spite.Namespace" and names_a_list_of_every {
        return reflection.class_objects.every_namespace()
    }
    if member.name == "size" {
        var sized = shape_size_of(class_path, type_arguments)
        if sized {
            return sized
        }
    }
    if member.name == "values" {
        var listed_values = enum_values_of(class_path)
        if listed_values {
            return listed_values
        }
    }
    var described_path = values.class_path_of(member.target)
    var found = context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    if found or values.scalars.is_a_scalar(written) {
        refuse_a_preset_read(described_path, type_arguments, member.name)
    }
    var object = values.reflected_object_of(member.target)
    fallback object
    var reflection_model = context.class_of(object.value_type)
    var getter = reflection_model.function_named("get_{member.name}")
    if not getter and values.scalars.is_a_scalar(written) {
        var number = values.number_class_of(described_path)
        var constants = values.constants_of(number)
        values.typing.refuse_an_unknown_number_constant(context, written, member.name, constants)
    }
    fallback getter
    var no_written = List<SpiteCompiler.Expression>()
    var read = calls.called(getter, object, no_written)
    var printer = Printers.Spite.ExpressionPrinter(member)
    var path = printer.text()
    return narrowed(read, path)
}

func enum_values_of(path: List<String>): SpiteCompiler.Value? {
    var collections = Collections(context, values)
    var declared = values.declared_enum_of(path)
    fallback declared
    fallback declared.kind == 'enumeration'
    var enumeration = values.enum_model_of(declared)
    var list_type = context.resolver.monomorphiser.list_type_of(declared)
    var listed = collections.new_list(list_type)
    var index = 0
    while index < enumeration.numbers.count() {
        var number = enumeration.numbers[index]
        var value = HighIntermediaryRepresentation.Values.WholeNumber(declared, number)
        collections.append_to(listed, value)
        index = index + 1
    }
    return listed
}

func shape_size_of(
    path: List<String>,
    arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
): SpiteCompiler.Value? {
    var described = context.resolver.types.class_type_in(path, arguments, context.current_class, context.line)
    fallback described.kind == 'shape'
    var shape = context.program.shape_keyed(described.name)
    crash shape
    var offset = 0
    var widest = 1
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        crash member.answer
        if not member.is_an_attribute or member.answer.kind != 'scalar' {
            var written = path.join(".")
            values.typing.refuse_unsized_type(context, written)
        }
        var width = width_in_a_type(member.answer)
        if width > widest {
            widest = width
        }
        var past = offset % width
        if past > 0 {
            offset = offset + width - past
        }
        offset = offset + width
        index = index + 1
    }
    var tail = offset % widest
    if tail > 0 {
        offset = offset + widest - tail
    }
    var integer = context.scalar_type("Integer")
    return HighIntermediaryRepresentation.Values.WholeNumber(integer, offset)
}

func width_in_a_type(held: Model.Type): Integer {
    var scalar = values.scalars.of(held.name)
    if held.kind == 'scalar' and scalar {
        return scalar.size
    }
    return 8
}

func refuse_a_preset_read(
    path: List<String>,
    type_arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>,
    name: String,
) {
    var naming = Naming(context, values)
    var described = context.resolver.types.class_type_in(path, type_arguments, context.current_class, context.line)
    fallback described.kind == 'scalar' or described.kind == 'object'
    var model = context.class_of(described)
    var spelled = naming.pascal_case_of(name)
    fallback model.preset_named(spelled)
    var written = path.join(".")
    values.typing.refuse_a_called_constant(context, "{written}.{name}", "{written}.{spelled}()")
}

func refuse_a_class_function_value(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    var target = member.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        refuse_a_function_of_a_named_class(member, target)
    }
}

func refuse_a_function_of_a_named_class(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
) {
    fallback target.is_a_class_name
    fallback not context.scope.internal_name_of(target.name)
    var found = context.resolver.state.symbols.find(target.name, context.current_class.file.namespace)
    fallback found
    var class_path = List<String>()
    class_path.append(target.name)
    var described = context.resolver.types.class_type_in(
        class_path,
        target.generic_arguments,
        context.current_class,
        context.line,
    )
    fallback described.kind == 'object' and context.has_a_class(described)
    var model = context.class_of(described)
    var function = model.function_named(member.name)
    fallback function
    var names = Mapping.Names()
    var instance = names.snake_case_of(found.simple_name)
    var answer = values.answer_or_nothing(function)
    var template = "each_{member.name}()"
    if context.is_boolean(answer) {
        template = "filter_{member.name}()"
    }
    values.typing.refuse_a_class_function_value(context, target.name, member.name, instance, template)
}

func member_of(element_class: Model.ClassModel, written: String, is_plural: Boolean): String {
    var naming = Naming(context, values)
    if not is_plural {
        return values.member_named(element_class, written)
    }
    var inflected = naming.member_by_plural(element_class, written)
    if not inflected.is_empty() {
        return inflected
    }
    var length = written.length()
    if written.ends_with("ies") {
        var stem = written.slice(0, length - 3)
        crash stem
        var found = values.member_named(element_class, "{stem}y")
        if not found.is_empty() {
            return found
        }
    }
    if written.ends_with("s") {
        var without_s = written.slice(0, length - 1)
        crash without_s
        var found_without_s = values.member_named(element_class, without_s)
        if not found_without_s.is_empty() {
            return found_without_s
        }
    }
    if written.ends_with("es") {
        var without_es = written.slice(0, length - 2)
        crash without_es
        var found_without_es = values.member_named(element_class, without_es)
        if not found_without_es.is_empty() {
            return found_without_es
        }
    }
    return values.member_named(element_class, written)
}

func bound_member_read(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): SpiteCompiler.Value? {
    var function = context.current_function
    fallback function.bound_member_type
    var target = index.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return bound_attribute_read(index, target, function)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return own_bound_read(target, function)
    }
    return null
}

func own_bound_read(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    function: Model.FunctionModel,
): SpiteCompiler.Value? {
    var literals = Literals(context, values)
    fallback target.name == "attributes"
    var item = literals.this_value()
    return bound_member_of(item, function)
}

func bound_attribute_read(
    _index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    function: Model.FunctionModel,
): SpiteCompiler.Value? {
    fallback target.name == "attributes"
    var item = values.value_of(target.target, null)
    return bound_member_of(item, function)
}

func bound_member_of(item: SpiteCompiler.Value, function: Model.FunctionModel): SpiteCompiler.Value {
    var calls = Calls(context, values)
    var read = bound_member_value(item, function)
    if not function.chained_function.is_empty() {
        read = calls.chained_call(read, function)
    }
    if not function.compared_value {
        return read
    }
    var value = HighIntermediaryRepresentation.Values.WholeNumber(function.compared_value, function.compared_number)
    var boolean = context.boolean()
    return HighIntermediaryRepresentation.Values.MachineOperation(boolean, 'equal', read, value)
}

func bound_member_value(item: SpiteCompiler.Value, function: Model.FunctionModel): SpiteCompiler.Value {
    var calls = Calls(context, values)
    if item.value_type.kind == 'handle' {
        return handle_member(item, function.bound_member)
    }
    if item.value_type.kind == 'shape' {
        var no_written = List<SpiteCompiler.Expression>()
        return calls.shape_call(item, function.bound_member, no_written)
    }
    if item.value_type.kind == 'union' and not function.bound_shape.is_empty() {
        var as_shape = Model.Type('shape', function.bound_shape)
        var shaped = HighIntermediaryRepresentation.Values.Conversion(as_shape, 'proven', item)
        var none_written = List<SpiteCompiler.Expression>()
        return calls.shape_call(shaped, function.bound_member, none_written)
    }
    var owner = values.present_class_of(item)
    if function.bound_member_is_a_function {
        var called_function = owner.function_named(function.bound_member)
        crash called_function
        var no_arguments = List<SpiteCompiler.Expression>()
        return calls.called(called_function, item, no_arguments)
    }
    var attribute = owner.attribute_named(function.bound_member)
    crash attribute
    if item.value_type.kind == 'scalar' {
        return scalar_attribute(item, attribute)
    }
    return HighIntermediaryRepresentation.Values.AttributeRead(item, attribute)
}

func handle_member(handle: SpiteCompiler.Value, name: String): SpiteCompiler.Value {
    var calls = Calls(context, values)
    if name == "finished" {
        return calls.work_call(handle, "get_finished")
    }
    var result = values.result_of_handle(handle)
    var no_written = List<SpiteCompiler.Expression>()
    var owner = values.present_class_of(result)
    var attribute = owner.attribute_named(name)
    if attribute {
        return HighIntermediaryRepresentation.Values.AttributeRead(result, attribute)
    }
    var getter = owner.function_named("get_{name}")
    if not getter {
        var shown = context.shown(result.value_type)
        values.typing.refuse_unknown_member(context, shown, name)
    }
    crash getter
    return calls.called(getter, result, no_written)
}

func listing_attributes(shape_type: Model.Type) {
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    fallback not shape.member_named("_attribute_list")
    var reflection = Reflection(context, values)
    var attribute_type = reflection.writing.reflection_type("Spite.Attribute")
    var list_type = context.resolver.monomorphiser.text_dictionary_type_of(attribute_type)
    var member = Model.FunctionModel("_attribute_list", shape.key)
    member.answer = list_type
    shape.members.append(member)
    var fillers = context.program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        if context.has_a_class(filler) {
            var model = context.class_of(filler)
            reflection.member_lists.make_attribute_list_of(model)
        } else {
            reflection.member_lists.make_no_attributes()
        }
        index = index + 1
    }
}

func shape_function_value(target: SpiteCompiler.Value, name: String): SpiteCompiler.Value? {
    var shape = context.program.shape_keyed(target.value_type.name)
    crash shape
    var member = shape.member_named(name)
    fallback member
    fallback not member.is_an_attribute
    var owner = context.current_class
    var key = target.value_type.name.replace(".", "_")
    var synthetic_name = "_{name}_through_{key}"
    var made = owner.function_named(synthetic_name)
    if not made {
        made = through_the_shape(owner, synthetic_name, target.value_type, member)
    }
    crash made
    var function_type = Model.Type('function', "Spite.Function")
    var parameter_types = made.parameters.map_parameter_types()
    function_type.parameters = parameter_types
    function_type.answer = made.answer
    return HighIntermediaryRepresentation.Values.Function.Value(function_type, made, target)
}

func through_the_shape(
    owner: Model.ClassModel,
    synthetic_name: String,
    shape_type: Model.Type,
    member: Model.FunctionModel,
): Model.FunctionModel {
    var made = Model.FunctionModel(synthetic_name, owner.key)
    made.is_synthetic = true
    made.answer = member.answer
    made.parameters = member.parameters
    owner.declared_functions.append(made)
    var shape = context.program.shape_keyed(shape_type.name)
    crash shape
    var own = HighIntermediaryRepresentation.Values.ThisRead(shape_type)
    var passed = List<SpiteCompiler.Value>()
    var index = 0
    while index < member.parameters.count() {
        var parameter = member.parameters[index]
        var read = HighIntermediaryRepresentation.Values.LocalRead(parameter.parameter_type, parameter.name)
        passed.append(read)
        index = index + 1
    }
    var through = HighIntermediaryRepresentation.Values.ShapeCall(shape, member, own, passed)
    var body = HighIntermediaryRepresentation.Statements.Block()
    if member.answer {
        var answered = HighIntermediaryRepresentation.Statements.Return(through)
        body.statements.append(answered)
    } else {
        var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(through)
        body.statements.append(evaluated)
    }
    var function = HighIntermediaryRepresentation.HighFunction(made, body)
    context.synthetic_functions.append(function)
    return made
}

func dotted_class(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): SpiteCompiler.Value? {
    var path = values.class_path_of(member)
    fallback path.count() > 1
    var written = path.join(".")
    fallback not context.resolver.state.symbols.namespace_folder(written)
    fallback context.resolver.state.symbols.find(written, context.current_class.file.namespace)
    var described = context.resolver.types.class_type_in(
        path,
        member.generic_arguments,
        context.current_class,
        context.line,
    )
    fallback described.kind == 'object'
    var reflection = Reflection(context, values)
    return reflection.class_objects.class_object(described.name)
}

func asked_of_a_function_values_declaration(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): SpiteCompiler.Value? {
    var declared = member.target
    fallback declared.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and declared.name == "declaration"
    fallback member.name == "name" or member.name == "arguments" or member.name == "returns"
    var held = declared.target
    fallback held.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback known_local_function(held.name)
    var read = values.value_of(held, null)
    fallback read.value_type.kind == 'function'
    var asked = AbstractSyntaxTree.Shapes.Expressions.MemberExpression(held, member.name)
    return function_value_member(asked, read)
}

func function_value_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    target: SpiteCompiler.Value,
): SpiteCompiler.Value {
    var fitting = Fitting(context, values)
    var function_type = target.value_type
    var shown = context.shown(function_type)
    var is_described = member.name == "name" or member.name == "arguments" or member.name == "returns"
    var is_bound = member.name == "owner" or member.name == "declaration"
    if not is_described and not is_bound {
        values.typing.refuse_function_value_member(context, shown, member.name)
    }
    if member.name == "returns" {
        return returned_class_of(function_type)
    }
    var known = known_function_of(member.target, target)
    if not known {
        values.typing.refuse_an_unnamed_function_value(context, member.name)
    }
    crash known
    if member.name == "owner" {
        return owner_of_a_function_value(target, known)
    }
    if member.name == "name" {
        return values.described_text(known.name)
    }
    if member.name == "declaration" {
        return fitting.reflected_function(known)
    }
    var reflection = Reflection(context, values)
    return reflection.wrappers.arguments_of(known)
}

func owner_of_a_function_value(target: SpiteCompiler.Value, known: Model.FunctionModel): SpiteCompiler.Value {
    if target.class == HighIntermediaryRepresentation.Values.Function.Value {
        crash target.receiver
        return target.receiver
    }
    if known.is_synthetic {
        values.typing.refuse_an_unnamed_function_value(context, "owner")
    }
    var owner = context.program.class_named(known.owner)
    crash owner
    var owner_type = owner.type_of_an_instance()
    var receiver = Model.AttributeModel("owner", "Spite.FunctionValue", owner_type)
    return HighIntermediaryRepresentation.Values.AttributeRead(target, receiver)
}

func returned_class_of(function_type: Model.Type): SpiteCompiler.Value {
    var reflection = Reflection(context, values)
    if not function_type.answer {
        return reflection.class_objects.class_object("Nothing")
    }
    var answer: Model.Type = function_type.answer
    var described = reflection.class_objects.class_object_of_type(answer)
    crash described
    return described
}

func known_function_of(written: SpiteCompiler.Expression?, value: SpiteCompiler.Value): Model.FunctionModel? {
    if value.class == HighIntermediaryRepresentation.Values.Function.Value {
        return value.function
    }
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return known_local_function(written.name)
    }
    return null
}

func known_local_function(name: String): Model.FunctionModel? {
    var internal_name = context.scope.internal_name_of(name)
    fallback internal_name
    return context.function_locals[internal_name]
}

func is_assigned_again(name: String): Boolean {
    if not context.current_function.declaration {
        return true
    }
    var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_function(context.current_function.declaration)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if assigns_the_name(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func assigns_the_name(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.target, name)
    }
    return false
}

func is_the_name(written: SpiteCompiler.Expression?, name: String): Boolean {
    if written.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return written.name == name
    }
    return false
}

func union_member_name_of(union_type: Model.Type, name: String): String {
    var fitting = Fitting(context, values)
    var united = fitting.union_model_of(union_type)
    var held = united.members.first()
    if not held {
        return name
    }
    if not context.has_a_class(held) {
        return name
    }
    var model = context.class_of(held)
    if model.attribute_named(name) {
        return name
    }
    if model.function_named(name) {
        return name
    }
    if model.function_named("get_{name}") {
        return "get_{name}"
    }
    return name
}

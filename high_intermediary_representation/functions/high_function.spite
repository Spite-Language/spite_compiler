var name = ""
var parameters = List<String>()
var parameter_types = List<String>()
var result_type = ""
var body: HighIntermediaryRepresentation.Statements.Block? = null

func HighFunction(
    starting_name: String,
    starting_parameters: List<String>,
    starting_parameter_types: List<String>,
    starting_result_type: String,
    starting_body: HighIntermediaryRepresentation.Statements.Block?,
) {
    name = starting_name
    parameters = starting_parameters
    parameter_types = starting_parameter_types
    result_type = starting_result_type
    body = starting_body
}

func statement_count(): Integer {
    if body {
        return body.statements.count()
    } else {
        return 0
    }
}

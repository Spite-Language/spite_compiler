var classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
var entry = ""

func HighProgram(starting_classes: List<HighIntermediaryRepresentation.Classes.HighClass>, starting_entry: String) {
    classes = starting_classes
    entry = starting_entry
}

func class_named(wanted: String): HighIntermediaryRepresentation.Classes.HighClass? {
    return classes.find_by_name(wanted)
}

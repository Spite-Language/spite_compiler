# ../../OPTIMIZATIONS.md#a-making-that-runs-to-its-end-on-what-it-makes-is-quiet
# ../../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing

var model = Model.ProgramModel()
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var functions_not_quiet = List<String>()
var singletons_made = List<HighIntermediaryRepresentation.Values.MakeObject>()
var answered = Dictionary<String, List<HighIntermediaryRepresentation.Values.MakeObject>>()
var refused = Dictionary<String, Boolean>()
var locals = Dictionary<String, Value>()
var this_object: Object? = null
var answer: Value? = null
var run_answer = Value('unknown')
var has_returned = false
var has_failed = false
var steps = 0
var depth = 0
var _step_limit = 20000
var _depth_limit = 48
var _smallest_worked: Long = -1073741824
var _largest_worked: Long = 1073741823
var _largest_multiplied: Long = 32767

# ../../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing
func runs_to_its_end(
    made: HighIntermediaryRepresentation.Values.MakeObject,
): List<HighIntermediaryRepresentation.Values.MakeObject>? {
    var question = question_of(made)
    var known = answered[question]
    if known {
        return known
    }
    fallback not refused.contains(question)
    singletons_made = List<HighIntermediaryRepresentation.Values.MakeObject>()
    locals = Dictionary<String, Value>()
    this_object = null
    answer = null
    has_returned = false
    has_failed = false
    steps = 0
    depth = 0
    var result = value_of(made)
    if has_failed or result.kind != 'object' {
        remember_a_refusal(question)
        return null
    }
    if question != "" {
        answered[question] = singletons_made
    }
    return singletons_made
}

func forget_the_answers() {
    answered = Dictionary<String, List<HighIntermediaryRepresentation.Values.MakeObject>>()
    refused = Dictionary<String, Boolean>()
}

func remember_a_refusal(question: String) {
    fallback question != ""
    refused[question] = true
}

func question_of(made: HighIntermediaryRepresentation.Values.MakeObject): String {
    var defaults_key = defaults_of_a_making(made)
    var question = "{made.value_type.name} {defaults_key}"
    if made.constructor {
        var constructor_key = made.constructor.key()
        question = "{question} {constructor_key}"
    }
    if made.skips_the_defaults {
        question = "{question} skips"
    }
    var index = 0
    while index < made.arguments.count() {
        var argument = made.arguments[index]
        var shown = shown_argument(argument)
        fallback shown != ""
        question = "{question} {shown}"
        index = index + 1
    }
    return question
}

func shown_argument(argument: SpiteCompiler.Value): String {
    if argument.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return argument.number
    }
    if argument.class == HighIntermediaryRepresentation.Values.NullConstant {
        return "null"
    }
    var is_a_name = argument.class == HighIntermediaryRepresentation.Values.LocalRead
    is_a_name = is_a_name or argument.class == HighIntermediaryRepresentation.Values.ThisRead
    is_a_name = is_a_name or argument.class == HighIntermediaryRepresentation.Values.TextConstant
    is_a_name = is_a_name or argument.class == HighIntermediaryRepresentation.Values.DecimalNumber
    if is_a_name {
        return "unknown"
    }
    fallback argument.class == HighIntermediaryRepresentation.Values.AttributeRead
    var object = argument.object
    var is_named = object.class == HighIntermediaryRepresentation.Values.LocalRead
    fallback is_named or object.class == HighIntermediaryRepresentation.Values.ThisRead
    return "unknown"
}

# ../../OPTIMIZATIONS.md#defaults-the-constructor-replaces-are-never-made
func defaults_of_a_making(made: HighIntermediaryRepresentation.Values.MakeObject): String {
    if made.constructor {
        var constructor_key = made.constructor.key()
        var left = "{constructor_key}$defaults"
        if bodies.contains(left) {
            return left
        }
    }
    return "{made.value_type.name}._attribute_defaults"
}

func unknown(): Value {
    return Value('unknown')
}

func failed(): Value {
    has_failed = true
    return Value('unknown')
}

func fail() {
    has_failed = true
}

func number_of(number: Long): Value {
    var known = Value('number')
    known.number = number
    return known
}

func boolean_of(holds: Boolean): Value {
    if holds {
        return number_of(1)
    }
    return number_of(0)
}

func object_value(object: Object): Value {
    var known = Value('object')
    known.object = object
    return known
}

func value_of(value: SpiteCompiler.Value?): Value {
    if has_failed or not value {
        return unknown()
    }
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return number_of(value.number)
        HighIntermediaryRepresentation.Values.DecimalNumber: return unknown()
        HighIntermediaryRepresentation.Values.TextConstant: return unknown()
        HighIntermediaryRepresentation.Values.NullConstant: return Value('null')
        HighIntermediaryRepresentation.Values.LocalRead: return local_of(value.name)
        HighIntermediaryRepresentation.Values.ThisRead: return this_value()
        HighIntermediaryRepresentation.Values.AttributeRead: return read_of(value)
        HighIntermediaryRepresentation.Values.Conversion: return converted(value)
        HighIntermediaryRepresentation.Values.MakeObject: return made_of(value)
        HighIntermediaryRepresentation.Values.Call: return called(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return operated(value)
        HighIntermediaryRepresentation.Values.Negation: return negated(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return tested(value)
        HighIntermediaryRepresentation.Values.Function.Value: return function_value(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return failed()
        HighIntermediaryRepresentation.Values.Class.Membership: return failed()
        HighIntermediaryRepresentation.Values.Function.ValueCall: return failed()
        HighIntermediaryRepresentation.Values.NumberRoom: return failed()
        HighIntermediaryRepresentation.Values.ShapeCall: return failed()
        HighIntermediaryRepresentation.Values.EnumText: return failed()
        HighIntermediaryRepresentation.Values.EnumFromText: return failed()
        HighIntermediaryRepresentation.Values.Class.Object: return failed()
        HighIntermediaryRepresentation.Values.Class.OfValue: return failed()
        HighIntermediaryRepresentation.Values.Function.Fact: return failed()
    }
}

func values_of(values: List<SpiteCompiler.Value>): List<Value> {
    var held = List<Value>()
    var index = 0
    while index < values.count() {
        var value = values[index]
        var closed = value_of(value)
        held.append(closed)
        index = index + 1
    }
    return held
}

func local_of(name: String): Value {
    var known = locals[name]
    if known {
        return known
    }
    return unknown()
}

func this_value(): Value {
    if this_object {
        return object_value(this_object)
    }
    return unknown()
}

func read_of(read: HighIntermediaryRepresentation.Values.AttributeRead): Value {
    var object = value_of(read.object)
    if object.kind == 'null' {
        return failed()
    }
    if not object.object {
        return unknown()
    }
    if object.object.is_opaque {
        return unknown()
    }
    var known = object.object.held_values[read.attribute.name]
    if known {
        return known
    }
    return unknown()
}

# ../../PROOFS.md#a-quiet-value-changes-nothing-handed-in-and-never-halts
func converted(conversion: HighIntermediaryRepresentation.Values.Conversion): Value {
    var inner = value_of(conversion.converted)
    var kind = conversion.kind
    var carries = kind == 'nullable' or kind == 'into_union' or kind == 'into_shape' or kind == 'widen'
    if carries {
        return inner
    }
    var reads_the_value = kind == 'present' or kind == 'proven'
    if reads_the_value and inner.kind == 'null' {
        return failed()
    }
    if reads_the_value and inner.kind != 'unknown' {
        return inner
    }
    if conversion.never_halts() {
        return unknown()
    }
    return failed()
}

func made_of(made: HighIntermediaryRepresentation.Values.MakeObject): Value {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    if not made_model {
        return failed()
    }
    if made_model.is_singleton {
        return a_singleton_used(made)
    }
    var drops = made_model.function_named("drop")
    if drops or class_key == "ForeignCallback" {
        return failed()
    }
    var arguments = values_of(made.arguments)
    var object = Object(class_key)
    var no_arguments = List<Value>()
    if not made.skips_the_defaults {
        var defaults_key = defaults_of_a_making(made)
        run(defaults_key, object, no_arguments)
    }
    if made.constructor {
        var constructor_key = made.constructor.key()
        run(constructor_key, object, arguments)
    }
    return object_value(object)
}

func a_singleton_used(made: HighIntermediaryRepresentation.Values.MakeObject): Value {
    if not made.arguments.is_empty() {
        return failed()
    }
    var index = 0
    while index < singletons_made.count() {
        var known = singletons_made[index]
        if known.value_type.name == made.value_type.name {
            return unknown()
        }
        index = index + 1
    }
    singletons_made.append(made)
    return unknown()
}

func called(call: HighIntermediaryRepresentation.Values.Call): Value {
    if not call.receiver {
        return failed()
    }
    var receiver = value_of(call.receiver)
    var arguments = values_of(call.arguments)
    if has_failed {
        return unknown()
    }
    if not receiver.object {
        return failed()
    }
    if is_a_store_into_a_collection(call) {
        receiver.object.is_opaque = true
        return unknown()
    }
    if not call.function.has_a_body() or call.function.owner != receiver.object.class_key {
        return failed()
    }
    var key = call.function.key()
    run(key, receiver.object, arguments)
    return run_answer
}

# ../../OPTIMIZATIONS.md#a-making-that-runs-to-its-end-on-what-it-makes-is-quiet
func is_a_store_into_a_collection(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var owner = model.class_named(call.function.owner)
    fallback owner
    var name = call.function.name
    var is_a_list = owner.shown.starts_with("List<") and owner.bound_types.contains("$element_type")
    if is_a_list {
        return name == "append" or name == "append$set"
    }
    var is_a_dictionary = owner.shown.starts_with("Dictionary<") and owner.bound_types.contains("$key_type")
    fallback is_a_dictionary and name == "set_at"
    var key_type = owner.bound_types["$key_type"]
    fallback key_type
    return key_type.kind == 'scalar' or key_type.name == "String"
}

func function_value(value: HighIntermediaryRepresentation.Values.Function.Value): Value {
    var receiver = value_of(value.receiver)
    if receiver.kind == 'null' {
        return failed()
    }
    return unknown()
}

func negated(negation: HighIntermediaryRepresentation.Values.Negation): Value {
    var inner = value_of(negation.negated)
    if negation.value_type.name != "Boolean" {
        return failed()
    }
    if inner.kind != 'number' {
        return unknown()
    }
    return boolean_of(inner.number == 0)
}

func tested(test: HighIntermediaryRepresentation.Values.PresenceTest): Value {
    var inner = value_of(test.tested)
    if inner.kind == 'null' {
        return number_of(0)
    }
    if inner.kind == 'unknown' {
        return unknown()
    }
    return number_of(1)
}

func operated(operation: HighIntermediaryRepresentation.Values.MachineOperation): Value {
    var operator = operation.operator
    if operator == 'and' or operator == 'or' {
        return joined(operation)
    }
    var left = value_of(operation.left)
    var right = value_of(operation.right)
    if has_failed {
        return unknown()
    }
    var both_known = left.kind == 'number' and right.kind == 'number'
    if is_a_comparison(operation) {
        if both_known {
            return compared(operation, left.number, right.number)
        }
        return unknown()
    }
    if both_known {
        return worked_out(operation, left.number, right.number)
    }
    var divides = operator == 'divide' or operator == 'remainder'
    if operation.is_proven_to_fit and not divides {
        return unknown()
    }
    return failed()
}

func joined(operation: HighIntermediaryRepresentation.Values.MachineOperation): Value {
    var left = value_of(operation.left)
    if left.kind != 'number' {
        return failed()
    }
    var is_both = operation.operator == 'and'
    var decides = left.number != 0
    if is_both {
        decides = left.number == 0
    }
    if decides {
        return left
    }
    var right = value_of(operation.right)
    if right.kind != 'number' {
        return failed()
    }
    return right
}

func is_a_comparison(operation: HighIntermediaryRepresentation.Values.MachineOperation): Boolean {
    var operator = operation.operator
    var is_an_equality = operator == 'equal' or operator == 'not_equal'
    var is_an_order = operator == 'less' or operator == 'less_or_equal'
    var is_a_reverse_order = operator == 'greater' or operator == 'greater_or_equal'
    return is_an_equality or is_an_order or is_a_reverse_order
}

func compared(operation: HighIntermediaryRepresentation.Values.MachineOperation, left: Long, right: Long): Value {
    var holds = false
    switch operation.operator {
        'equal': holds = left == right
        'not_equal': holds = left != right
        'less': holds = left < right
        'less_or_equal': holds = left <= right
        'greater': holds = left > right
        'greater_or_equal': holds = left >= right
        'add': return failed()
        'subtract': return failed()
        'multiply': return failed()
        'divide': return failed()
        'remainder': return failed()
        'and': return failed()
        'or': return failed()
    }
    return boolean_of(holds)
}

# ../../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing
func worked_out(operation: HighIntermediaryRepresentation.Values.MachineOperation, left: Long, right: Long): Value {
    var type_name = operation.value_type.name
    var is_wide = type_name == "Integer" or type_name == "Long"
    var is_small = is_worked(left) and is_worked(right)
    if not is_wide or not is_small {
        return failed()
    }
    if right <= 0 or left < 0 {
        return worked_on_whole_numbers(operation, left, right)
    }
    switch operation.operator {
        'add': return number_of(left + right)
        'subtract': return number_of(left - right)
        'multiply': return multiplied(left, right)
        'divide': return number_of(left / right)
        'remainder': return number_of(left % right)
        'equal': return failed()
        'not_equal': return failed()
        'less': return failed()
        'less_or_equal': return failed()
        'greater': return failed()
        'greater_or_equal': return failed()
        'and': return failed()
        'or': return failed()
    }
}

func worked_on_whole_numbers(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    left: Long,
    right: Long,
): Value {
    switch operation.operator {
        'add': return number_of(left + right)
        'subtract': return number_of(left - right)
        'multiply': return multiplied(left, right)
        'divide': return failed()
        'remainder': return failed()
        'equal': return failed()
        'not_equal': return failed()
        'less': return failed()
        'less_or_equal': return failed()
        'greater': return failed()
        'greater_or_equal': return failed()
        'and': return failed()
        'or': return failed()
    }
}

func multiplied(left: Long, right: Long): Value {
    var small_left = left >= 0 - _largest_multiplied and left <= _largest_multiplied
    var small_right = right >= 0 - _largest_multiplied and right <= _largest_multiplied
    if small_left and small_right {
        return number_of(left * right)
    }
    return failed()
}

func is_worked(number: Long): Boolean {
    return number >= _smallest_worked and number <= _largest_worked
}

func run(key: String, receiver: Object, arguments: List<Value>) {
    run_answer = unknown()
    fallback not has_failed
    var function = bodies[key]
    if not function {
        fail()
        return
    }
    if functions_not_quiet.contains(key) or depth >= _depth_limit {
        fail()
        return
    }
    var outer_locals = locals
    var outer_this = this_object
    var outer_answer = answer
    locals = Dictionary<String, Value>()
    this_object = receiver
    answer = null
    has_returned = false
    depth = depth + 1
    var parameters = function.function.parameters
    var index = 0
    while index < parameters.count() and index < arguments.count() {
        var parameter = parameters[index]
        var argument = arguments[index]
        locals[parameter.name] = argument
        index = index + 1
    }
    run_block(function.body)
    var result = answer
    depth = depth - 1
    locals = outer_locals
    this_object = outer_this
    answer = outer_answer
    has_returned = false
    fallback result
    run_answer = result
}

func run_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() and not has_failed and not has_returned {
        var statement = block.statements[index]
        run_statement(statement)
        index = index + 1
    }
}

func run_statement(statement: SpiteCompiler.Statement) {
    steps = steps + 1
    if steps > _step_limit {
        fail()
        return
    }
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: choose(statement)
        HighIntermediaryRepresentation.Statements.While: run_a_loop(statement)
        HighIntermediaryRepresentation.Statements.Return: give_back(statement)
        HighIntermediaryRepresentation.Statements.Block: run_block(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: fail()
        HighIntermediaryRepresentation.Statements.Stop: fail()
    }
}

func declare(declared: HighIntermediaryRepresentation.Statements.Declare) {
    var held = value_of(declared.value)
    locals[declared.name] = held
}

func assign(assigned: HighIntermediaryRepresentation.Statements.Assign) {
    var held = value_of(assigned.value)
    locals[assigned.name] = held
}

func write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var object = value_of(written.object)
    var held = value_of(written.value)
    if not object.object {
        fail()
        return
    }
    object.object.held_values[written.attribute.name] = held
}

func evaluate(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    if evaluated.waited {
        fail()
        return
    }
    var held = value_of(evaluated.value)
    if held.kind == 'object' {
        fail()
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func choose(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link and not has_failed {
        var current = link
        link = null
        var condition = value_of(current.condition)
        if condition.kind != 'number' {
            fail()
            return
        }
        var next = current.else_if()
        if condition.number != 0 {
            run_block(current.then_branch)
        } else if next {
            link = next
        } else {
            run_block(current.else_branch)
        }
    }
}

func run_a_loop(loop: HighIntermediaryRepresentation.Statements.While) {
    while not has_failed and not has_returned {
        steps = steps + 1
        var condition = value_of(loop.condition)
        if condition.kind != 'number' or steps > _step_limit {
            fail()
            return
        }
        fallback condition.number != 0
        run_block(loop.body)
    }
}

func give_back(returned: HighIntermediaryRepresentation.Statements.Return) {
    var held = value_of(returned.value)
    answer = held
    has_returned = true
}

# ../../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing

var cells = Dictionary<Integer, Cell>()
var widest = 1
var numbers = LowIntermediaryRepresentation.Numbers()

func write(at: Integer, cell: Cell) {
    clear(at, cell.size)
    cells[at] = cell
    if cell.size > widest {
        widest = cell.size
    }
}

func clear(at: Integer, size: Integer) {
    var start = at - widest + 1
    while start < at + size {
        var held = cells[start]
        if held and start + held.size > at {
            cells.remove_at(start)
        }
        start = start + 1
    }
}

func cell_at(at: Integer, size: Integer): Cell? {
    var held = cells[at]
    fallback held and held.size == size
    return held
}

func start_holding(at: Integer): Integer? {
    var start = at
    while start > at - widest {
        var held = cells[start]
        if held {
            fallback start + held.size > at
            return start
        }
        start = start - 1
    }
    return null
}

func little_bytes(at: Integer, size: Integer): Long? {
    var exact = cell_at(at, size)
    if exact and exact.number_size == size and exact.value.kind == 'number' {
        return exact.value.number
    }
    var little: Long = 0
    var index = 0
    while index < size {
        var place = at + index
        var start = start_holding(place)
        fallback start
        var held = cells[start]
        fallback held and held.value.kind == 'number' and place - start < held.number_size
        var code = numbers.byte_of(held.value.number, place - start)
        var placed = code.shifted_left(8 * index)
        little = little.bits_or(placed)
        index = index + 1
    }
    return little
}

func resized(room: Integer) {
    var starts = cells.keys()
    var index = 0
    while index < starts.count() {
        var start = starts[index]
        var held = cells[start]
        if held and start + held.size > room {
            cells.remove_at(start)
        }
        index = index + 1
    }
}

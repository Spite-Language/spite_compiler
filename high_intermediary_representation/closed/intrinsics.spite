# ../../OPTIMIZATIONS.md#a-making-that-runs-to-its-end-on-what-it-makes-is-quiet
# ../../PROOFS.md#a-making-that-runs-to-its-end-on-what-it-makes-changes-nothing

var meanings = LowIntermediaryRepresentation.Lowering.Meanings()
var numbers = LowIntermediaryRepresentation.Numbers()
var _largest_position: Long = 1073741823

func answer(
    call: HighIntermediaryRepresentation.Values.Call,
    owner: Model.ClassModel?,
    receiver: Value,
    arguments: List<Value>,
): Value? {
    var name = call.function.name
    var operation = meanings.number_operation(call)
    if operation {
        return worked(call, operation, receiver, arguments)
    }
    if meanings.hands_on_the_receiver(name) {
        return as_answered(call, receiver)
    }
    if meanings.hands_on_the_argument(name) {
        var argument = arguments.first()
        fallback argument
        return as_answered(call, argument)
    }
    var loaded = meanings.load_of(call)
    if loaded {
        return read_at(call, loaded, receiver, arguments)
    }
    var stored = meanings.store_of(call)
    if stored {
        return written_at(stored, receiver, arguments)
    }
    if call.function.key() == "Buffer._resize_room" {
        return resized(receiver, arguments)
    }
    fallback owner
    var element = owner.bound_types["$element_type"]
    fallback element
    if name == "_item_size" {
        var size = meanings.item_size_of(element)
        return number_of(size)
    }
    if name == "_read_value" {
        return item_read(element, receiver, arguments)
    }
    if name == "_write_value" {
        return item_written(element, receiver, arguments)
    }
    fallback name == "_forget_value"
    return item_forgotten(element, receiver, arguments)
}

func number_of(number: Long): Value {
    var known = Value('number')
    known.number = number
    return known
}

func nothing(): Value {
    return Value('unknown')
}

func as_answered(call: HighIntermediaryRepresentation.Values.Call, value: Value): Value {
    if call.function.answer and meanings.is_a_decimal(call.function.answer) {
        return nothing()
    }
    if value.kind != 'number' {
        return nothing()
    }
    return value
}

func worked(
    call: HighIntermediaryRepresentation.Values.Call,
    operation: LowIntermediaryRepresentation.Instructions.Arithmetic,
    receiver: Value,
    arguments: List<Value>,
): Value {
    if receiver.kind != 'number' {
        return nothing()
    }
    var right: Long = -1
    var operand = meanings.right_operand(call.function.name)
    if operand == 'zero' {
        right = 0
    }
    if operand == 'argument' {
        var argument = arguments.first()
        if not argument or argument.kind != 'number' {
            return nothing()
        }
        right = argument.number
    }
    var result = numbers.unchecked(operation, receiver.number, right)
    if not result {
        return nothing()
    }
    var worked_out = number_of(result)
    return as_answered(call, worked_out)
}

func position_of(arguments: List<Value>): Integer? {
    var first = arguments.first()
    fallback first and first.kind == 'number'
    fallback first.number >= 0 and first.number <= _largest_position
    return first.number
}

func storage_of(receiver: Value): Bytes? {
    fallback receiver.object
    if not receiver.object.storage {
        receiver.object.storage = Bytes()
    }
    return receiver.object.storage
}

func read_at(
    call: HighIntermediaryRepresentation.Values.Call,
    loaded: LowIntermediaryRepresentation.Instructions.Load,
    receiver: Value,
    arguments: List<Value>,
): Value? {
    var storage = storage_of(receiver)
    var at = position_of(arguments)
    fallback storage and at
    var size = numbers.size_of_width(loaded.width)
    var little = storage.little_bytes(at, size)
    if not little {
        return nothing()
    }
    var read = numbers.loaded(loaded.width, loaded.is_signed, loaded.is_swapped, little)
    var known = number_of(read)
    return as_answered(call, known)
}

func is_writable(receiver: Value): Boolean {
    fallback receiver.object
    return not receiver.object.is_constant
}

func written_at(
    stored: LowIntermediaryRepresentation.Instructions.Store,
    receiver: Value,
    arguments: List<Value>,
): Value? {
    var storage = storage_of(receiver)
    var at = position_of(arguments)
    var value = arguments[1]
    fallback storage and at and value and is_writable(receiver)
    var size = numbers.size_of_width(stored.width)
    var held = Value('unknown')
    if value.kind == 'number' {
        var little = numbers.stored(stored.width, stored.is_swapped, value.number)
        held = number_of(little)
    }
    var cell = Cell(held, size, size)
    storage.write(at, cell)
    return nothing()
}

func resized(receiver: Value, arguments: List<Value>): Value? {
    var storage = storage_of(receiver)
    var room = position_of(arguments)
    fallback storage and room and is_writable(receiver)
    storage.resized(room)
    return nothing()
}

func items_of(receiver: Value): Value? {
    fallback receiver.object
    var buffer = receiver.object.held_values["_buffer"]
    fallback buffer and buffer.kind == 'object'
    return buffer
}

func item_read(element: Model.Type, receiver: Value, arguments: List<Value>): Value? {
    var buffer = items_of(receiver)
    var index = position_of(arguments)
    fallback buffer and index
    var storage = storage_of(buffer)
    fallback storage
    var size = meanings.item_size_of(element)
    var cell = storage.cell_at(index * size, size)
    if not cell {
        return nothing()
    }
    return cell.value
}

func item_written(element: Model.Type, receiver: Value, arguments: List<Value>): Value? {
    var buffer = items_of(receiver)
    var index = position_of(arguments)
    var value = arguments[1]
    fallback buffer and index and value and is_writable(receiver) and is_writable(buffer)
    var storage = storage_of(buffer)
    fallback storage
    var size = meanings.item_size_of(element)
    var number_size = 0
    if element.kind == 'scalar' and not element.is_nullable {
        number_size = size
    }
    var cell = Cell(value, size, number_size)
    storage.write(index * size, cell)
    return nothing()
}

func item_forgotten(element: Model.Type, receiver: Value, arguments: List<Value>): Value? {
    if not meanings.is_a_pointer(element) {
        return nothing()
    }
    var buffer = items_of(receiver)
    var index = position_of(arguments)
    fallback buffer and index and is_writable(receiver) and is_writable(buffer)
    var storage = storage_of(buffer)
    fallback storage
    var size = meanings.item_size_of(element)
    var gone = Value('null')
    var cell = Cell(gone, size, 0)
    storage.write(index * size, cell)
    return nothing()
}

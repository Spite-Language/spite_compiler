func HighProgram(starting_model: Model.ProgramModel) {
    model = starting_model
}

func will_be_lowered(): Boolean {
    crash context
    return context.build_flags["check"] != "true"
}

func is_an_ordinary_class(class_key: String): Boolean {
    var found = model.class_named(class_key)
    fallback found and not found.is_singleton
    fallback not entry or entry.owner != class_key
    fallback not prompt or prompt.owner != class_key
    return not class_key.starts_with("Spite.")
}

# ../OPTIMIZATIONS.md#a-call-that-only-changes-a-singleton-waits-for-the-join
func keep_a_deferred(function: Model.FunctionModel) {
    var key = function.key()
    var index = 0
    while index < deferred_functions.count() {
        var known = deferred_functions[index]
        fallback known.key() != key
        index = index + 1
    }
    deferred_functions.append(function)
}

# ../PROOFS.md#a-list-used-only-as-a-set
func keep_a_band_ending(block: Statements.Block) {
    band_ending_blocks.append(block)
}

func is_deferred(key: String): Boolean {
    var index = 0
    while index < deferred_functions.count() {
        var known = deferred_functions[index]
        if known.key() == key {
            return true
        }
        index = index + 1
    }
    return false
}

# ../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func observers_nothing_subscribes_to(): List<String> {
    var untold = UntoldObservers()
    return untold.of(built_functions, model)
}

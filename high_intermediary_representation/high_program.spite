var model = Model.ProgramModel()
var built_functions = List<HighFunction>()
var entry: Model.FunctionModel? = null
var prompt: Model.FunctionModel? = null
var makes_work = false
var in_flight_sites = 0
var frame_hold_paths = List<String>()
var frame_hold_lines = List<Integer>()
var frame_hold_texts = List<String>()
var absent_attributes = List<String>()
var shared_members = List<String>()
var quiet_singletons = List<String>()
var packs_layouts = false
var rebuilt_attributes = Dictionary<String, Model.FunctionModel>()
var folded_attributes = Dictionary<String, HighIntermediaryRepresentation.Values.Value>()
var narrowed_reads = List<NarrowedRead>()
var crash_sites = List<String>()
var setup_list_walks = List<SetupListWalk>()
var context: HighIntermediaryRepresentation.Building.Context? = null
var layout: Layout? = null
var assignments: Assignments? = null
var waits: Waits? = null
var trimmed_defaults = List<HighFunction>()
var trimmed_keys = List<String>()
var fresh_by_constructor = Dictionary<String, List<String>>()
var taken_parameters: HighIntermediaryRepresentation.Ownership.TakenParameters? = null
var embedding_live = List<String>()
var thread_counted_classes = List<String>()
var static_singletons = List<String>()
var counts_every_class_atomically = true

func HighProgram(starting_model: Model.ProgramModel) {
    model = starting_model
}

func will_be_lowered(): Boolean {
    crash context
    return context.build_flags["check"] != "true"
}

func is_an_ordinary_class(class_key: String): Boolean {
    var found = model.class_named(class_key)
    if not found or found.is_singleton {
        return false
    }
    if entry and entry.owner == class_key {
        return false
    }
    if prompt and prompt.owner == class_key {
        return false
    }
    return not class_key.starts_with("Spite.")
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var program = Model.ProgramModel()
var class_ids = Dictionary<String, Integer>()
var next_class_id = 1
var offsets = Dictionary<String, Integer>()
var presence_offsets = Dictionary<String, Integer>()
var sizes = Dictionary<String, Integer>()
var back_attributes = List<String>()
var back_held = List<String>()
var back_offsets = Dictionary<String, Integer>()
var header_size = 16
var slot_size = 8
var storage_offset = 16
var inline_room = 48
var plain_text_room = -1
var inline_strides = Dictionary<String, Integer>()
var columnar = List<String>()
var immortal_count: Long = 1152921504606846976
var scalars = Model.Scalars()
var packs = false
var absent = List<String>()
var used_bytes = Dictionary<String, List<Boolean>>()
var shared_offsets = Dictionary<String, Integer>()
var rebuilt = Dictionary<String, Model.FunctionModel>()
var folded = Dictionary<String, Value>()
var embedded = Dictionary<String, String>()
var lent = List<String>()
var protected_names = ["_buffer", "_length", "item_count", "handle", "address", "context", "_function", "_cell"]

func Layout(starting_program: Model.ProgramModel) {
    program = starting_program
    offsets["Spite.FunctionValue.owner"] = 24
    program.order.each(note_the_back_references)
    if program.reload_host {
        seed_the_class_ids(program.reload_host)
    }
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        if not class_ids.contains(model.key) {
            class_ids[model.key] = next_class_id
            next_class_id = next_class_id + 1
        }
        lay_out(model)
        index = index + 1
    }
}

# ../../spite_spec/specs/repl.md#live-reload-in-detail
func seed_the_class_ids(host: Model.ReloadHost) {
    var index = 0
    while index < host.class_keys.count() {
        var key = host.class_keys[index]
        var id = host.class_ids[key]
        crash id
        if program.class_named(key) {
            class_ids[key] = id
        }
        index = index + 1
    }
    var largest = host.largest_class_id()
    next_class_id = largest + 1
}

# ../HOT_RELOAD.md#the-manifest
func described(model: Model.ClassModel): String {
    var size = sizes[model.key]
    var shown_size = "-"
    if size {
        shown_size = size
    }
    var parts = List<String>()
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var key = "{model.key}.{attribute.name}"
        var offset = offsets[key]
        var shown_offset = "-"
        if offset {
            shown_offset = offset
        }
        var presence = presence_offsets[key]
        if presence {
            shown_offset = "{shown_offset}+{presence}"
        }
        var nullable_mark = ""
        if attribute.attribute_type.is_nullable {
            nullable_mark = "?"
        }
        parts.append("{attribute.name}:{attribute.attribute_type.name}{nullable_mark}@{shown_offset}")
        index = index + 1
    }
    var joined = parts.join("|")
    return "{shown_size};{joined}"
}

func lay_out_by_use(high: HighIntermediaryRepresentation.HighProgram) {
    packs = high.packs_layouts
    absent = high.absent_attributes
    rebuilt = high.rebuilt_attributes
    folded = high.folded_attributes
    offsets = Dictionary<String, Integer>()
    presence_offsets = Dictionary<String, Integer>()
    sizes = Dictionary<String, Integer>()
    back_offsets = Dictionary<String, Integer>()
    used_bytes = Dictionary<String, List<Boolean>>()
    shared_offsets = Dictionary<String, Integer>()
    offsets["Spite.FunctionValue.owner"] = 24
    high.shared_members.each(share_a_member)
    program.order.each(lay_out)
}

func lay_out(model: Model.ClassModel) {
    if model.key.starts_with("Spite.Work_of_") {
        sizes[model.key] = 40
        return
    }
    if packs and not keeps_its_declared_layout(model) {
        pack(model)
        return
    }
    var offset = header_size
    if model.key == "Buffer" {
        offset = offset + slot_size
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var key = "{model.key}.{attribute.name}"
        if not absent.contains(key) {
            offsets[key] = offset
            offset = offset + slot_size
        }
        if not absent.contains(key) and is_a_nullable_scalar(attribute.attribute_type) {
            presence_offsets[key] = offset
            offset = offset + slot_size
        }
        index = index + 1
    }
    if back_held.contains(model.key) {
        back_offsets[model.key] = offset
        offset = offset + slot_size
    }
    sizes[model.key] = offset
}

func keeps_its_declared_layout(model: Model.ClassModel): Boolean {
    var key = model.key
    var is_fixed = key == "Buffer" or key == "ForeignCallback" or key.starts_with("Spite.")
    return is_fixed or scalars.is_a_scalar(key)
}

func may_move(attribute: Model.AttributeModel): Boolean {
    return not protected_names.contains(attribute.name)
}

func pack(model: Model.ClassModel) {
    var bytes = bytes_of(model.key)
    var width = 8
    while width >= 1 {
        place_the_width(model, bytes, width)
        width = width / 2
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var key = "{model.key}.{attribute.name}"
        var is_placed = not absent.contains(key) and offsets.contains(key)
        if is_placed and is_a_nullable_scalar(attribute.attribute_type) {
            var presence = first_free(bytes, 1)
            take(bytes, presence, 1)
            presence_offsets[key] = presence
        }
        index = index + 1
    }
    if back_held.contains(model.key) {
        var back = first_free(bytes, slot_size)
        take(bytes, back, slot_size)
        back_offsets[model.key] = back
    }
    var end = bytes.count()
    while end > header_size and bytes[end - 1] != true {
        end = end - 1
    }
    var rounded = (end + slot_size - 1) / slot_size * slot_size
    sizes[model.key] = rounded
}

func place_the_width(model: Model.ClassModel, bytes: List<Boolean>, width: Integer) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var key = "{model.key}.{attribute.name}"
        var is_waiting = not absent.contains(key) and not offsets.contains(key)
        var attribute_width = width_in_bytes(attribute.attribute_type)
        if is_waiting and attribute_width == width {
            var offset = first_free(bytes, width)
            take(bytes, offset, width)
            offsets[key] = offset
        }
        index = index + 1
    }
}

func bytes_of(class_key: String): List<Boolean> {
    var known = used_bytes[class_key]
    if known {
        return known
    }
    var made = List<Boolean>()
    while made.count() < header_size {
        made.append(true)
    }
    used_bytes[class_key] = made
    return made
}

func first_free(bytes: List<Boolean>, width: Integer): Integer {
    var offset = header_size
    while not is_free(bytes, offset, width) {
        offset = offset + width
    }
    return offset
}

func is_free(bytes: List<Boolean>, offset: Integer, width: Integer): Boolean {
    var index = offset
    while index < offset + width {
        fallback index >= bytes.count() or bytes[index] != true
        index = index + 1
    }
    return true
}

func take(bytes: List<Boolean>, offset: Integer, width: Integer) {
    while bytes.count() < offset + width {
        bytes.append(false)
    }
    var index = offset
    while index < offset + width {
        bytes[index] = true
        index = index + 1
    }
}

func width_in_bytes(of_type: Model.Type): Integer {
    if of_type.kind != 'scalar' {
        return slot_size
    }
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.size
}

func share_a_member(shared: String) {
    var parts = shared.split("|")
    var member = parts.remove_last()
    crash member
    var shape_key = parts.join("|")
    var attributes = filling_attributes(shape_key, member)
    fallback not attributes.is_empty()
    var first = attributes.first()
    crash first
    var width = width_in_bytes(first.attribute_type)
    var offset = common_offset(attributes, width)
    fallback offset >= 0
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var key = "{attribute.owner}.{attribute.name}"
        if not offsets.contains(key) {
            var bytes = bytes_of(attribute.owner)
            take(bytes, offset, width)
            offsets[key] = offset
        }
        index = index + 1
    }
    shared_offsets[shared] = offset
}

func filling_attributes(shape_key: String, member: String): List<Model.AttributeModel> {
    var found = List<Model.AttributeModel>()
    var unmatched = List<Model.AttributeModel>()
    var fillers = program.fillers_of(shape_key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var attribute = shareable_attribute(filler, member)
        if not attribute {
            return unmatched
        }
        if not is_like_the_first(found, attribute) {
            return unmatched
        }
        found.append(attribute)
        index = index + 1
    }
    return found
}

func is_like_the_first(found: List<Model.AttributeModel>, attribute: Model.AttributeModel): Boolean {
    var first = found.first()
    if not first {
        return true
    }
    return first.attribute_type.is_the_same_as(attribute.attribute_type)
}

func shareable_attribute(filler: Model.Type, member: String): Model.AttributeModel? {
    var is_a_class = filler.kind == 'object' and not filler.is_symbol and not filler.is_nullable
    fallback is_a_class
    var model = program.class_named(filler.name)
    fallback model
    fallback not keeps_its_declared_layout(model)
    var attribute = model.attribute_named(member)
    fallback attribute
    var key = "{model.key}.{attribute.name}"
    var is_plain = not is_back(attribute) and not is_a_nullable_scalar(attribute.attribute_type)
    fallback not absent.contains(key) and is_plain and may_move(attribute)
    return attribute
}

func common_offset(attributes: List<Model.AttributeModel>, width: Integer): Integer {
    var placed = -1
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var found = offsets["{attribute.owner}.{attribute.name}"]
        if found {
            if placed >= 0 and placed != found {
                return -1
            }
            placed = found
        }
        index = index + 1
    }
    if placed >= 0 {
        if is_free_in_the_others(attributes, placed, width) {
            return placed
        }
        return -1
    }
    var offset = header_size
    while offset < 4096 {
        if is_free_in_the_others(attributes, offset, width) {
            return offset
        }
        offset = offset + width
    }
    return -1
}

func is_free_in_the_others(attributes: List<Model.AttributeModel>, offset: Integer, width: Integer): Boolean {
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        var key = "{attribute.owner}.{attribute.name}"
        var bytes = bytes_of(attribute.owner)
        fallback offsets.contains(key) or is_free(bytes, offset, width)
        index = index + 1
    }
    return true
}

func shared_offset_of(shape_key: String, member: String): Integer {
    var found = shared_offsets["{shape_key}|{member}"]
    if found {
        return found
    }
    return -1
}

func note_the_back_references(model: Model.ClassModel) {
    model.declared_attributes.each(note_a_back_reference)
}

func note_a_back_reference(attribute: Model.AttributeModel) {
    fallback program.holds_no_count(attribute)
    back_attributes.append("{attribute.owner}.{attribute.name}")
    var held = attribute.attribute_type.name
    fallback not back_held.contains(held)
    back_held.append(held)
}

func is_back(attribute: Model.AttributeModel): Boolean {
    return back_attributes.contains("{attribute.owner}.{attribute.name}")
}

func has_back_references(): Boolean {
    return not back_attributes.is_empty()
}

func is_back_held(class_key: String): Boolean {
    return back_held.contains(class_key)
}

func back_offset_of(class_key: String): Integer {
    var found = back_offsets[class_key]
    crash found
    return found
}

func back_slot_of(attribute: Model.AttributeModel): Integer {
    return back_offset_of(attribute.attribute_type.name)
}

func is_a_nullable_scalar(of_type: Model.Type): Boolean {
    var is_held_in_place = of_type.kind == 'scalar' or of_type.kind == 'enumeration'
    return is_held_in_place and of_type.is_nullable
}

func standing_in_for(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
): Value? {
    var key = "{read.attribute.owner}.{read.attribute.name}"
    var constant = folded[key]
    if constant {
        return constant
    }
    var rebuilder = rebuilt[key]
    fallback rebuilder
    var no_arguments = List<Value>()
    return HighIntermediaryRepresentation.Values.Call(rebuilder, read.object, no_arguments)
}

func rebuilder_of(attribute: Model.AttributeModel): Model.FunctionModel? {
    return rebuilt["{attribute.owner}.{attribute.name}"]
}

# ../OPTIMIZATIONS.md#an-object-only-its-holder-holds-lives-inside-it
func embed(found: Dictionary<String, String>) {
    var keys = found.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var held = found[key]
        crash held
        var parts = key.split(".")
        var last = parts.count() - 1
        var name = parts[last]
        crash name
        var whole = key.length()
        var named = name.length()
        var holder = key.slice(0, whole - named - 1)
        crash holder
        var room = size_of(held)
        var start = size_of(holder)
        offsets[key] = start
        sizes[holder] = start + room
        embedded[key] = held
        index = index + 1
    }
}

func is_lent(attribute: Model.AttributeModel): Boolean {
    return lent.contains("{attribute.owner}.{attribute.name}")
}

func is_embedded(attribute: Model.AttributeModel): Boolean {
    return embedded.contains("{attribute.owner}.{attribute.name}")
}

func has_slot_named(key: String): Boolean {
    return offsets.contains(key) and not absent.contains(key) and not rebuilt.contains(key) and not folded.contains(key)
}

func has_a_slot(attribute: Model.AttributeModel): Boolean {
    return not absent.contains("{attribute.owner}.{attribute.name}")
}

func offset_of(attribute: Model.AttributeModel): Integer {
    var key = "{attribute.owner}.{attribute.name}"
    var found = offsets[key]
    crash found
    return found
}

func presence_offset_of(attribute: Model.AttributeModel): Integer {
    var found = presence_offsets["{attribute.owner}.{attribute.name}"]
    crash found
    return found
}

func size_of(class_key: String): Integer {
    var found = sizes[class_key]
    crash found
    return found
}

# ../OPTIMIZATIONS.md#a-lists-objects-sit-inside-its-storage
func inline_stride_of(list_key: String): Integer {
    var stride = inline_strides[list_key]
    if stride {
        return stride
    }
    return 0
}

func made_size_of(class_key: String): Integer {
    var size = size_of(class_key)
    if class_key == "Buffer" {
        return size + inline_room
    }
    return size
}

func inline_offset(): Integer {
    return size_of("Buffer")
}

func holds_texts_whole(): Boolean {
    fallback not is_back_held("String") and not is_back_held("Buffer")
    var owner = program.class_named("String")
    var buffer_model = program.class_named("Buffer")
    fallback owner and buffer_model
    fallback not owner.function_named("drop") and not buffer_model.function_named("drop")
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        var is_kept = attribute.name == "_buffer" or attribute.name == "_length"
        fallback is_kept or not offsets.contains("String.{attribute.name}")
        index = index + 1
    }
    var has_both = offsets.contains("String._buffer") and offsets.contains("String._length")
    fallback has_both and offsets.contains("Buffer.item_count")
    var flag = text_flag_offset()
    var buffer_at = offsets["String._buffer"]
    crash buffer_at
    var apart = flag + 1 <= buffer_at or flag >= buffer_at + 8
    return apart and flag + 1 <= size_of("String")
}

func text_flag_offset(): Integer {
    var length_at = offsets["String._length"]
    crash length_at
    return length_at + 4
}

func embedded_flag_offset(): Integer {
    var count_at = offsets["Buffer.item_count"]
    crash count_at
    return count_at + 4
}

func orphan_flag_offset(): Integer {
    return embedded_flag_offset() + 1
}

func box_key_of(filler: Model.Type): String {
    if filler.is_symbol {
        return "Spite.SymbolBox"
    }
    return filler.name
}

func class_id_of(class_key: String): Integer {
    var found = class_ids[class_key]
    if found {
        return found
    }
    var made = next_class_id
    next_class_id = next_class_id + 1
    class_ids[class_key] = made
    return made
}

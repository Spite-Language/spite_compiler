# ../PROOFS.md#a-number-that-may-not-fit-is-narrowed

var function: HighFunction
var line: Integer
var conversion: Values.Conversion

func NarrowingSite(starting_function: HighFunction, starting_line: Integer, starting_conversion: Values.Conversion) {
    function = starting_function
    line = starting_line
    conversion = starting_conversion
}

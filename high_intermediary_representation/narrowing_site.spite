# ../PROOFS.md#a-number-that-may-not-fit-is-narrowed

var function: HighIntermediaryRepresentation.HighFunction
var line: Integer
var conversion: HighIntermediaryRepresentation.Values.Conversion

func NarrowingSite(
    starting_function: HighIntermediaryRepresentation.HighFunction,
    starting_line: Integer,
    starting_conversion: HighIntermediaryRepresentation.Values.Conversion,
) {
    function = starting_function
    line = starting_line
    conversion = starting_conversion
}

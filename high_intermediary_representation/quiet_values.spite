var model = Model.ProgramModel()
var bodies = Dictionary<String, HighFunction>()
var visiting = List<String>()
var quiet_calls = ["Buffer._resize_room"]
var answers = Dictionary<String, List<Values.MakeObject>>()
var refused = Dictionary<String, Boolean>()
var first_uses = List<Values.MakeObject>()
var for_dropped_defaults = false
var functions_not_quiet = List<String>()
var fresh_names = List<String>()
var this_is_fresh = false
var closed = Closed.Makings()

func QuietValues(high: HighProgram) {
    model = high.model
    high.built_functions.each(note_a_function)
    closed.model = model
    closed.bodies = bodies
    closed.functions_not_quiet = functions_not_quiet
}

func note_a_function(function: HighFunction) {
    var key = function.function.key()
    bodies[key] = function
}

# ../OPTIMIZATIONS.md#defaults-the-constructor-replaces-are-never-made
func note_the_defaults_left(constructor_key: String, left: HighFunction) {
    bodies["{constructor_key}$defaults"] = left
}

func mark_as_not_quiet(key: String) {
    functions_not_quiet.append(key)
}

func forget_the_answers() {
    answers = Dictionary<String, List<Values.MakeObject>>()
    refused = Dictionary<String, Boolean>()
    closed.forget_the_answers()
}

func is_quiet(value: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Boolean {
    if not value {
        return true
    }
    fallback not for_dropped_defaults or not holds_a_singleton(value)
    switch value {
        Values.WholeNumber: return true
        Values.DecimalNumber: return true
        Values.NullConstant: return true
        Values.TextConstant: return true
        Values.LocalRead: return true
        Values.ThisRead: return true
        Values.AttributeRead: return is_quiet(value.object, bound)
        Values.Conversion: return is_a_quiet_conversion(value, bound)
        Values.MakeObject: return is_a_quiet_making(value, bound)
        Values.Call: return is_a_quiet_call(value, bound)
        Values.MachineOperation: return false
        Values.Negation: return false
        Values.ForeignCall: return false
        Values.Class.Membership: return false
        Values.PresenceTest: return false
        Values.Function.Value: return false
        Values.Function.ValueCall: return false
        Values.NumberRoom: return false
        Values.ShapeCall: return false
        Values.EnumText: return false
        Values.EnumFromText: return false
        Values.Class.Object: return false
        Values.Class.OfValue: return false
        Values.Function.Fact: return false
    }
}

func holds_a_singleton(value: SpiteCompiler.Value): Boolean {
    var value_type = value.value_type
    var held = model.class_named(value_type.name)
    if held {
        return held.is_singleton
    }
    return false
}

func are_quiet(values: List<SpiteCompiler.Value>, bound: Dictionary<String, Long>): Boolean {
    var index = 0
    while index < values.count() {
        var value = values[index]
        fallback is_quiet(value, bound)
        index = index + 1
    }
    return true
}

# ../PROOFS.md#a-quiet-value-changes-nothing-handed-in-and-never-halts
func is_a_quiet_conversion(conversion: Values.Conversion, bound: Dictionary<String, Long>): Boolean {
    var kind = conversion.kind
    var carries = kind == 'present' or kind == 'nullable' or kind == 'into_union' or kind == 'into_shape'
    carries = carries or kind == 'widen' or kind == 'proven' or kind == 'to_decimal'
    fallback carries and conversion.never_halts()
    return is_quiet(conversion.converted, bound)
}

# ../PROOFS.md#a-quiet-value-changes-nothing-handed-in-and-never-halts
func is_fresh(value: SpiteCompiler.Value?): Boolean {
    fallback value
    if value.class == Values.ThisRead {
        return this_is_fresh
    }
    if value.class == Values.LocalRead {
        return fresh_names.contains(value.name)
    }
    if value.class == Values.MakeObject {
        return true
    }
    if value.class == Values.AttributeRead {
        return for_dropped_defaults and is_fresh(value.object)
    }
    if value.class == Values.Conversion {
        return is_a_fresh_conversion(value)
    }
    return false
}

func is_a_fresh_conversion(conversion: Values.Conversion): Boolean {
    var kind = conversion.kind
    var same_object = kind == 'present' or kind == 'nullable' or kind == 'into_union' or kind == 'widen'
    fallback same_object or kind == 'proven'
    return is_fresh(conversion.converted)
}

func is_a_quiet_making(made: Values.MakeObject, bound: Dictionary<String, Long>): Boolean {
    var uses_before = first_uses.count()
    if is_quiet_by_its_parts(made, bound) {
        return true
    }
    fallback for_dropped_defaults
    first_uses.truncate(uses_before)
    var singletons_used = closed.runs_to_its_end(made)
    fallback singletons_used
    note_first_uses(singletons_used)
    return true
}

func is_quiet_by_its_parts(made: Values.MakeObject, bound: Dictionary<String, Long>): Boolean {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    fallback made_model
    fallback not made_model.is_singleton and not made_model.function_named("drop") and class_key != "ForeignCallback"
    fallback are_quiet(made.arguments, bound)
    var no_arguments = List<SpiteCompiler.Value>()
    var no_bound = Dictionary<String, Long>()
    var defaults_key = closed.defaults_of_a_making(made)
    fallback is_a_quiet_function(defaults_key, no_arguments, no_bound)
    if not made.constructor {
        return true
    }
    var constructor_key = made.constructor.key()
    return is_a_quiet_function(constructor_key, made.arguments, bound)
}

func is_a_quiet_call(call: Values.Call, bound: Dictionary<String, Long>): Boolean {
    fallback is_quiet(call.receiver, bound) and are_quiet(call.arguments, bound)
    fallback is_fresh(call.receiver)
    var key = call.function.key()
    if not call.function.has_a_body() {
        return quiet_calls.contains(key)
    }
    return is_a_quiet_function(key, call.arguments, bound)
}

func is_a_quiet_function(key: String, arguments: List<SpiteCompiler.Value>, outer: Dictionary<String, Long>): Boolean {
    var function = bodies[key]
    fallback function and not visiting.contains(key) and not functions_not_quiet.contains(key)
    var bound = Dictionary<String, Long>()
    var fresh_here = List<String>()
    var question = key
    var index = 0
    while index < function.function.parameters.count() and index < arguments.count() {
        var parameter = function.function.parameters[index]
        var argument = arguments[index]
        var known = constant_of(argument, outer)
        if known {
            bound[parameter.name] = known
            question = "{question} {parameter.name}={known}"
        }
        if is_fresh(argument) {
            fresh_here.append(parameter.name)
            question = "{question} {parameter.name}=fresh"
        }
        index = index + 1
    }
    var answered = answers[question]
    if answered {
        note_first_uses(answered)
        return true
    }
    fallback not refused.contains(question)
    var outer_uses = first_uses
    first_uses = List<Values.MakeObject>()
    visiting.append(key)
    var outer_fresh = fresh_names
    var outer_this_is_fresh = this_is_fresh
    fresh_names = fresh_here
    this_is_fresh = true
    var quiet = is_a_quiet_block(function.body, bound)
    fresh_names = outer_fresh
    this_is_fresh = outer_this_is_fresh
    var last = visiting.count() - 1
    visiting.remove_at(last)
    var own_uses = first_uses
    first_uses = outer_uses
    if not quiet {
        refused[question] = true
        return false
    }
    answers[question] = own_uses
    note_first_uses(own_uses)
    return true
}

func note_first_uses(uses: List<Values.MakeObject>) {
    uses.each(note_a_first_use)
}

func note_a_first_use(made: Values.MakeObject) {
    var index = 0
    while index < first_uses.count() {
        var known = first_uses[index]
        fallback known.value_type.name != made.value_type.name
        index = index + 1
    }
    first_uses.append(made)
}

func notes_a_singleton_made(value: SpiteCompiler.Value?): Boolean {
    fallback for_dropped_defaults
    if value.class == Values.MakeObject {
        var made_model = model.class_named(value.value_type.name)
        fallback made_model
        fallback made_model.is_singleton and value.arguments.is_empty()
        note_a_first_use(value)
        return true
    }
    return false
}

# ../OPTIMIZATIONS.md#defaults-the-constructor-replaces-are-never-made
func first_uses_of_a_write(written: Statements.Assign.Attribute): List<Values.MakeObject>? {
    first_uses = List<Values.MakeObject>()
    var bound = Dictionary<String, Long>()
    this_is_fresh = true
    var quiet = is_a_quiet_write(written, bound)
    this_is_fresh = false
    if quiet {
        return first_uses
    }
    return null
}

func constant_of(value: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Long? {
    if value.class == Values.WholeNumber {
        return value.number
    }
    if value.class == Values.LocalRead {
        return bound[value.name]
    }
    return null
}

func is_a_quiet_block(block: Statements.Block?, bound: Dictionary<String, Long>): Boolean {
    if not block {
        return true
    }
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        fallback is_a_quiet_statement(statement, bound)
        index = index + 1
    }
    return true
}

func is_a_quiet_statement(statement: SpiteCompiler.Statement, bound: Dictionary<String, Long>): Boolean {
    switch statement {
        Statements.Declare: return is_a_quiet_declaration(statement, bound)
        Statements.Assign.Attribute: return is_a_quiet_write(statement, bound)
        Statements.Evaluate: return is_a_quiet_evaluation(statement, bound)
        Statements.If: return is_a_quiet_if(statement, bound)
        Statements.Block: return is_a_quiet_block(statement, bound)
        Statements.Assign: return false
        Statements.Assign.ThroughShape: return false
        Statements.While: return false
        Statements.Return: return false
        Statements.Stop: return false
    }
}

func is_a_quiet_declaration(declared: Statements.Declare, bound: Dictionary<String, Long>): Boolean {
    fallback is_quiet(declared.value, bound)
    if is_fresh(declared.value) {
        fresh_names.append(declared.name)
    }
    return true
}

func is_a_quiet_write(written: Statements.Assign.Attribute, bound: Dictionary<String, Long>): Boolean {
    if for_dropped_defaults {
        return is_a_quiet_write_of_a_new_object(written, bound)
    }
    fallback written.object.class == Values.ThisRead and this_is_fresh
    return is_quiet(written.value, bound)
}

func is_a_quiet_write_of_a_new_object(written: Statements.Assign.Attribute, bound: Dictionary<String, Long>): Boolean {
    fallback is_quiet(written.object, bound) and is_fresh(written.object)
    var on_this = written.object.class == Values.ThisRead
    if on_this and notes_a_singleton_made(written.value) {
        return true
    }
    return is_quiet(written.value, bound)
}

func is_a_quiet_evaluation(evaluated: Statements.Evaluate, bound: Dictionary<String, Long>): Boolean {
    fallback not evaluated.waited
    if notes_a_singleton_made(evaluated.value) {
        return true
    }
    return is_quiet(evaluated.value, bound)
}

# ../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func is_a_quiet_if(branch: Statements.If, bound: Dictionary<String, Long>): Boolean {
    var uses_before = List<Integer>()
    var quiet = true
    var link: Statements.If? = branch
    while link {
        var current = link
        link = null
        var folded = folded_condition(current.condition, bound)
        var next = current.else_if()
        if folded == 1 {
            quiet = is_a_quiet_block(current.then_branch, bound)
        } else if folded == 0 and next {
            link = next
        } else if folded == 0 {
            quiet = is_a_quiet_block(current.else_branch, bound)
        } else {
            var used = first_uses.count()
            uses_before.append(used)
            quiet = is_quiet(current.condition, bound) and is_a_quiet_block(current.then_branch, bound)
            link = undecided_link_after(next, quiet)
            quiet = quiet and (link or is_a_quiet_block(current.else_branch, bound))
        }
    }
    var index = uses_before.count() - 1
    while index >= 0 {
        var before = uses_before[index]
        crash before
        quiet = quiet and first_uses.count() == before
        index = index - 1
    }
    return quiet
}

func undecided_link_after(next: Statements.If?, quiet: Boolean): Statements.If? {
    fallback quiet
    return next
}

func folded_condition(condition: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Integer {
    if condition.class == Values.Negation {
        var inner = folded_condition(condition.negated, bound)
        if inner < 0 {
            return inner
        }
        return 1 - inner
    }
    if condition.class == Values.MachineOperation {
        return folded_comparison(condition, bound)
    }
    return -1
}

func folded_comparison(operation: Values.MachineOperation, bound: Dictionary<String, Long>): Integer {
    var left = constant_of(operation.left, bound)
    var right = constant_of(operation.right, bound)
    if not left or not right {
        return -1
    }
    var holds = false
    switch operation.operator {
        'equal': holds = left == right
        'not_equal': holds = left != right
        'less': holds = left < right
        'less_or_equal': holds = left <= right
        'greater': holds = left > right
        'greater_or_equal': holds = left >= right
        'add': return -1
        'subtract': return -1
        'multiply': return -1
        'divide': return -1
        'remainder': return -1
        'and': return -1
        'or': return -1
    }
    if holds {
        return 1
    }
    return 0
}

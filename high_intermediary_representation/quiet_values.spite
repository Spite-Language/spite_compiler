var model = Model.ProgramModel()
var bodies = Dictionary<String, HighFunction>()
var visiting = List<String>()
var quiet_calls = ["Buffer._resize_room"]
var answers = Dictionary<String, List<HighIntermediaryRepresentation.Values.MakeObject>>()
var refused = Dictionary<String, Boolean>()
var first_uses = List<HighIntermediaryRepresentation.Values.MakeObject>()
var for_dropped_defaults = false
var functions_not_quiet = List<String>()

func QuietValues(high: HighProgram) {
    model = high.model
    high.built_functions.each(note_a_function)
}

func note_a_function(function: HighFunction) {
    var key = function.function.key()
    bodies[key] = function
}

# ../OPTIMIZATIONS.md#defaults-the-constructor-replaces-are-never-made
func note_the_defaults_left(constructor_key: String, left: HighFunction) {
    bodies["{constructor_key}$defaults"] = left
}

func mark_as_not_quiet(key: String) {
    functions_not_quiet.append(key)
}

func forget_the_answers() {
    answers = Dictionary<String, List<HighIntermediaryRepresentation.Values.MakeObject>>()
    refused = Dictionary<String, Boolean>()
}

func is_quiet(value: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Boolean {
    if not value {
        return true
    }
    fallback not for_dropped_defaults or not holds_a_singleton(value)
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        HighIntermediaryRepresentation.Values.NullConstant: return true
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.ThisRead: return true
        HighIntermediaryRepresentation.Values.AttributeRead: return is_quiet(value.object, bound)
        HighIntermediaryRepresentation.Values.Conversion: return is_a_quiet_conversion(value, bound)
        HighIntermediaryRepresentation.Values.MakeObject: return is_a_quiet_making(value, bound)
        HighIntermediaryRepresentation.Values.Call: return is_a_quiet_call(value, bound)
        HighIntermediaryRepresentation.Values.MachineOperation: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func holds_a_singleton(value: SpiteCompiler.Value): Boolean {
    var value_type = value.value_type
    var held = model.class_named(value_type.name)
    if held {
        return held.is_singleton
    }
    return false
}

func are_quiet(values: List<SpiteCompiler.Value>, bound: Dictionary<String, Long>): Boolean {
    var index = 0
    while index < values.count() {
        var value = values[index]
        fallback is_quiet(value, bound)
        index = index + 1
    }
    return true
}

func is_a_quiet_conversion(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    bound: Dictionary<String, Long>,
): Boolean {
    var kind = conversion.kind
    var carries = kind == 'present' or kind == 'nullable' or kind == 'into_union' or kind == 'into_shape'
    carries = carries or kind == 'widen' or kind == 'proven' or kind == 'to_decimal'
    fallback carries
    return is_quiet(conversion.converted, bound)
}

func is_a_quiet_making(
    made: HighIntermediaryRepresentation.Values.MakeObject,
    bound: Dictionary<String, Long>,
): Boolean {
    var class_key = made.value_type.name
    var made_model = model.class_named(class_key)
    fallback made_model
    fallback not made_model.is_singleton and not made_model.function_named("drop") and class_key != "ForeignCallback"
    fallback are_quiet(made.arguments, bound)
    var no_arguments = List<SpiteCompiler.Value>()
    var no_bound = Dictionary<String, Long>()
    var defaults_key = defaults_of_a_making(made)
    fallback is_a_quiet_function(defaults_key, no_arguments, no_bound)
    if not made.constructor {
        return true
    }
    var constructor_key = made.constructor.key()
    return is_a_quiet_function(constructor_key, made.arguments, bound)
}

func defaults_of_a_making(made: HighIntermediaryRepresentation.Values.MakeObject): String {
    if made.constructor {
        var constructor_key = made.constructor.key()
        var left = "{constructor_key}$defaults"
        if bodies.contains(left) {
            return left
        }
    }
    return "{made.value_type.name}._attribute_defaults"
}

func is_a_quiet_call(call: HighIntermediaryRepresentation.Values.Call, bound: Dictionary<String, Long>): Boolean {
    fallback is_quiet(call.receiver, bound) and are_quiet(call.arguments, bound)
    if for_dropped_defaults and is_an_append_to_a_list(call) {
        return true
    }
    var key = call.function.key()
    if not call.function.has_a_body() {
        return quiet_calls.contains(key)
    }
    return is_a_quiet_function(key, call.arguments, bound)
}

func is_an_append_to_a_list(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    fallback call.function.name == "append"
    var owner = model.class_named(call.function.owner)
    fallback owner
    return owner.shown.starts_with("List<") and owner.bound_types.contains("$element_type")
}

func is_a_quiet_function(key: String, arguments: List<SpiteCompiler.Value>, outer: Dictionary<String, Long>): Boolean {
    var function = bodies[key]
    fallback function and not visiting.contains(key) and not functions_not_quiet.contains(key)
    var bound = Dictionary<String, Long>()
    var question = key
    var index = 0
    while index < function.function.parameters.count() and index < arguments.count() {
        var parameter = function.function.parameters[index]
        var argument = arguments[index]
        var known = constant_of(argument, outer)
        if known {
            bound[parameter.name] = known
            question = "{question} {parameter.name}={known}"
        }
        index = index + 1
    }
    var answered = answers[question]
    if answered {
        note_first_uses(answered)
        return true
    }
    fallback not refused.contains(question)
    var outer_uses = first_uses
    first_uses = List<HighIntermediaryRepresentation.Values.MakeObject>()
    visiting.append(key)
    var quiet = is_a_quiet_block(function.body, bound)
    var last = visiting.count() - 1
    visiting.remove_at(last)
    var own_uses = first_uses
    first_uses = outer_uses
    if not quiet {
        refused[question] = true
        return false
    }
    answers[question] = own_uses
    note_first_uses(own_uses)
    return true
}

func note_first_uses(uses: List<HighIntermediaryRepresentation.Values.MakeObject>) {
    uses.each(note_a_first_use)
}

func note_a_first_use(made: HighIntermediaryRepresentation.Values.MakeObject) {
    var index = 0
    while index < first_uses.count() {
        var known = first_uses[index]
        fallback known.value_type.name != made.value_type.name
        index = index + 1
    }
    first_uses.append(made)
}

func notes_a_singleton_made(value: SpiteCompiler.Value?): Boolean {
    fallback for_dropped_defaults
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        var made_model = model.class_named(value.value_type.name)
        fallback made_model
        fallback made_model.is_singleton and value.arguments.is_empty()
        note_a_first_use(value)
        return true
    }
    return false
}

# ../OPTIMIZATIONS.md#defaults-the-constructor-replaces-are-never-made
func first_uses_of_a_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
): List<HighIntermediaryRepresentation.Values.MakeObject>? {
    first_uses = List<HighIntermediaryRepresentation.Values.MakeObject>()
    var bound = Dictionary<String, Long>()
    if is_a_quiet_write(written, bound) {
        return first_uses
    }
    return null
}

func constant_of(value: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Long? {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value.number
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return bound[value.name]
    }
    return null
}

func is_a_quiet_block(
    block: HighIntermediaryRepresentation.Statements.Block?,
    bound: Dictionary<String, Long>,
): Boolean {
    if not block {
        return true
    }
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        fallback is_a_quiet_statement(statement, bound)
        index = index + 1
    }
    return true
}

func is_a_quiet_statement(statement: SpiteCompiler.Statement, bound: Dictionary<String, Long>): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return is_quiet(statement.value, bound)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return is_a_quiet_write(statement, bound)
        HighIntermediaryRepresentation.Statements.Evaluate: return is_a_quiet_evaluation(statement, bound)
        HighIntermediaryRepresentation.Statements.If: return is_a_quiet_if(statement, bound)
        HighIntermediaryRepresentation.Statements.Block: return is_a_quiet_block(statement, bound)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return false
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return false
        HighIntermediaryRepresentation.Statements.While: return false
        HighIntermediaryRepresentation.Statements.Return: return false
        HighIntermediaryRepresentation.Statements.Stop: return false
    }
}

func is_a_quiet_write(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    bound: Dictionary<String, Long>,
): Boolean {
    if for_dropped_defaults {
        return is_a_quiet_write_of_a_new_object(written, bound)
    }
    fallback written.object.class == HighIntermediaryRepresentation.Values.ThisRead
    return is_quiet(written.value, bound)
}

func is_a_quiet_write_of_a_new_object(
    written: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    bound: Dictionary<String, Long>,
): Boolean {
    fallback is_quiet(written.object, bound)
    var on_this = written.object.class == HighIntermediaryRepresentation.Values.ThisRead
    if on_this and notes_a_singleton_made(written.value) {
        return true
    }
    return is_quiet(written.value, bound)
}

func is_a_quiet_evaluation(
    evaluated: HighIntermediaryRepresentation.Statements.Evaluate,
    bound: Dictionary<String, Long>,
): Boolean {
    fallback not evaluated.waited
    if notes_a_singleton_made(evaluated.value) {
        return true
    }
    return is_quiet(evaluated.value, bound)
}

func is_a_quiet_if(branch: HighIntermediaryRepresentation.Statements.If, bound: Dictionary<String, Long>): Boolean {
    var folded = folded_condition(branch.condition, bound)
    if folded == 1 {
        return is_a_quiet_block(branch.then_branch, bound)
    }
    if folded == 0 {
        return is_a_quiet_block(branch.else_branch, bound)
    }
    var uses_before = first_uses.count()
    var quiet = is_quiet(branch.condition, bound) and is_a_quiet_block(branch.then_branch, bound)
    quiet = quiet and is_a_quiet_block(branch.else_branch, bound)
    return quiet and first_uses.count() == uses_before
}

func folded_condition(condition: SpiteCompiler.Value?, bound: Dictionary<String, Long>): Integer {
    if condition.class == HighIntermediaryRepresentation.Values.Negation {
        var inner = folded_condition(condition.negated, bound)
        if inner < 0 {
            return inner
        }
        return 1 - inner
    }
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return folded_comparison(condition, bound)
    }
    return -1
}

func folded_comparison(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    bound: Dictionary<String, Long>,
): Integer {
    var left = constant_of(operation.left, bound)
    var right = constant_of(operation.right, bound)
    if not left or not right {
        return -1
    }
    var holds = false
    switch operation.operator {
        'equal': holds = left == right
        'not_equal': holds = left != right
        'less': holds = left < right
        'less_or_equal': holds = left <= right
        'greater': holds = left > right
        'greater_or_equal': holds = left >= right
        'add': return -1
        'subtract': return -1
        'multiply': return -1
        'divide': return -1
        'remainder': return -1
        'and': return -1
        'or': return -1
    }
    if holds {
        return 1
    }
    return 0
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change

var shown = ""
var no_type = Model.Type('nothing', "")
var attribute = Model.AttributeModel("", "", no_type)
var calls = List<SpiteCompiler.Value>()
var call_lines = List<Integer>()
var start = 0
var end = 0
var loop_end = 0
var loop_start = 0
var line = 0
var path = ""
var owner = ""
var function_name = ""
var copy_line = 0
var is_a_new_check = false
var left_starts = List<Integer>()
var left_ends = List<Integer>()
var object: SpiteCompiler.Value? = null
var narrowed_type: Model.Type? = null
var writes: Dictionary<Integer, SpiteCompiler.Statement>? = null
var watched_lists = List<String>()
var getter = ""
var getter_name = ""

func NarrowedRead(starting_shown: String, starting_attribute: Model.AttributeModel) {
    shown = starting_shown
    attribute = starting_attribute
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func is_left_behind(index: Integer): Boolean {
    var stretch = 0
    while stretch < left_starts.count() {
        var first = left_starts[stretch]
        var last = left_ends[stretch]
        crash first
        crash last
        var holds_the_call = first <= index and index < last
        var holds_the_read = first <= end and end < last
        if holds_the_call and not holds_the_read {
            return true
        }
        var is_inside_the_loop = first > loop_start and index >= end
        if holds_the_call and is_inside_the_loop {
            return true
        }
        stretch = stretch + 1
    }
    return false
}

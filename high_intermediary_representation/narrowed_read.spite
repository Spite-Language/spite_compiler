# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change

var shown = ""
var no_type = Model.Type('nothing', "")
var attribute = Model.AttributeModel("", "", no_type, null, false)
var calls = List<SpiteCompiler.Value>()
var call_lines = List<Integer>()
var start = 0
var end = 0
var loop_end = 0
var loop_start = 0
var proven_in_frame = 0
var next_pass_start = 0
var line = 0
var path = ""
var owner = ""
var function_name = ""
var copy_line = 0
var is_a_new_check = false
var left_starts = List<Integer>()
var left_ends = List<Integer>()
var other_branch_starts = List<Integer>()
var other_branch_ends = List<Integer>()
var object: SpiteCompiler.Value? = null
var narrowed_type: Model.Type? = null
var writes: Dictionary<Integer, SpiteCompiler.Statement>? = null
var watched_lists = List<String>()
var own_list = ""
var list_type: Model.Type? = null
var shared_lists = List<String>()
var shared_types = List<Model.Type>()
var getter = ""
var getter_name = ""

func NarrowedRead(starting_shown: String, starting_attribute: Model.AttributeModel) {
    shown = starting_shown
    attribute = starting_attribute
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func is_left_behind(index: Integer): Boolean {
    var is_before_the_next_pass_proves_it = index >= end and index < next_pass_start
    if is_before_the_next_pass_proves_it {
        return true
    }
    var stretch = 0
    while stretch < left_starts.count() {
        var first = left_starts[stretch]
        var last = left_ends[stretch]
        crash first
        crash last
        var holds_the_call = first <= index and index < last
        var holds_the_read = first <= end and end < last
        if holds_the_call and not holds_the_read {
            return true
        }
        var is_inside_the_loop = first > loop_start and index >= end
        if holds_the_call and is_inside_the_loop {
            return true
        }
        stretch = stretch + 1
    }
    return is_on_another_branch(index)
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func is_on_another_branch(index: Integer): Boolean {
    fallback loop_end == end
    var branch = 0
    while branch < other_branch_starts.count() {
        var first = other_branch_starts[branch]
        var last = other_branch_ends[branch]
        crash first
        crash last
        if first <= index and index < last {
            return true
        }
        branch = branch + 1
    }
    return false
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func lists_to_watch(): List<String> {
    var watched = List<String>()
    var keeps_its_own = not own_list.is_empty() and not shared_lists.contains(own_list)
    var index = 0
    while index < watched_lists.count() {
        var key = watched_lists[index]
        if not keeps_its_own or not key.starts_with("[-]*") {
            watched.append(key)
        }
        index = index + 1
    }
    watch_the_shared_lists(watched)
    return watched
}

func watch_the_shared_lists(watched: List<String>) {
    fallback list_type
    var index = 0
    while index < shared_lists.count() {
        var name = shared_lists[index]
        var shared_type = shared_types[index]
        crash shared_type
        var shared_present = shared_type.present()
        if name != own_list and shared_present.is_the_same_as(list_type) {
            watched.append("[-]local:{name}")
        }
        index = index + 1
    }
}

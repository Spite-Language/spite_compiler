func program(): HighIntermediaryRepresentation.Programs.HighProgram {
    var total = HighIntermediaryRepresentation.Values.Name("total")
    var index = HighIntermediaryRepresentation.Values.Name("index")
    var zero = HighIntermediaryRepresentation.Values.WholeNumber("0")
    var one = HighIntermediaryRepresentation.Values.WholeNumber("1")
    var ten = HighIntermediaryRepresentation.Values.WholeNumber("10")
    var start = HighIntermediaryRepresentation.Values.Operation(zero, "*", one)
    var limit = HighIntermediaryRepresentation.Values.Operation(ten, "-", zero)
    var step = HighIntermediaryRepresentation.Values.Operation(limit, "*", zero)
    var keep_going = HighIntermediaryRepresentation.Values.Operation(index, "<", ten)
    var bump = HighIntermediaryRepresentation.Values.Operation(index, "+", one)
    var grown = HighIntermediaryRepresentation.Values.Operation(step, "+", bump)
    var first = HighIntermediaryRepresentation.Statements.Declare("total", start)
    var second = HighIntermediaryRepresentation.Statements.Declare("index", limit)
    var add = HighIntermediaryRepresentation.Statements.Assign("total", grown)
    var move = HighIntermediaryRepresentation.Statements.Assign("index", bump)
    var body_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    body_statements.append(add)
    body_statements.append(move)
    var body = HighIntermediaryRepresentation.Statements.Block(body_statements)
    var loop = HighIntermediaryRepresentation.Statements.While(keep_going, body)
    var answer = HighIntermediaryRepresentation.Statements.Return(total)
    var statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    statements.append(first)
    statements.append(second)
    statements.append(loop)
    statements.append(answer)
    var block = HighIntermediaryRepresentation.Statements.Block(statements)
    var no_parameters = List<String>()
    var no_types = List<String>()
    var entry_function = HighIntermediaryRepresentation.Functions.HighFunction(
        "Sample",
        no_parameters,
        no_types,
        "",
        block,
    )
    var functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
    var spare = unused_function()
    functions.append(entry_function)
    functions.append(spare)
    var entry_class = HighIntermediaryRepresentation.Classes.HighClass("Sample", functions)
    var classes = List<HighIntermediaryRepresentation.Classes.HighClass>()
    classes.append(entry_class)
    return HighIntermediaryRepresentation.Programs.HighProgram(classes, "Sample")
}

func unused_function(): HighIntermediaryRepresentation.Functions.HighFunction {
    var empty = List<HighIntermediaryRepresentation.Statements.Statement>()
    var block = HighIntermediaryRepresentation.Statements.Block(empty)
    var no_parameters = List<String>()
    var no_types = List<String>()
    return HighIntermediaryRepresentation.Functions.HighFunction("never_called", no_parameters, no_types, "", block)
}

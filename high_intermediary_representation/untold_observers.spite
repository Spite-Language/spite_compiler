# ../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told

var library = Mapping.LibraryFile()

# ../OPTIMIZATIONS.md#an-observer-nothing-subscribes-to-is-never-told
func of(built_functions: List<HighFunction>, model: Model.ProgramModel): List<String> {
    var subscribed = List<String>()
    var index = 0
    while index < built_functions.count() {
        var built = built_functions[index]
        if built.function.name == "subscribe" {
            subscribed.append(built.function.owner)
        }
        index = index + 1
    }
    var untold = List<String>()
    var class_index = 0
    while class_index < model.order.count() {
        var observer = model.order[class_index]
        var is_an_observer = observer.shown.starts_with("Observer<") and observer.bound_types.contains("$value")
        if is_an_observer and library.holds(observer.file.path) and not subscribed.contains(observer.key) {
            untold.append(observer.key)
        }
        class_index = class_index + 1
    }
    return untold
}

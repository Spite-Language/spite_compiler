var name = ""
var size = 0
var offset = 0
var default_value: HighIntermediaryRepresentation.Values.Value? = null

func HighAttribute(
    starting_name: String,
    starting_size: Integer,
    starting_offset: Integer,
    starting_default_value: HighIntermediaryRepresentation.Values.Value?,
) {
    name = starting_name
    size = starting_size
    offset = starting_offset
    default_value = starting_default_value
}

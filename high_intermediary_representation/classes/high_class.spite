var name = ""
var held_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
var held_attributes = List<HighIntermediaryRepresentation.Classes.HighAttribute>()
var block_size = 0
var room_size = 0

func HighClass(
    starting_name: String,
    starting_functions: List<HighIntermediaryRepresentation.Functions.HighFunction>,
    starting_attributes: List<HighIntermediaryRepresentation.Classes.HighAttribute>,
    starting_block_size: Integer,
    starting_room_size: Integer,
) {
    name = starting_name
    held_functions = starting_functions
    held_attributes = starting_attributes
    block_size = starting_block_size
    room_size = starting_room_size
}

func function_named(wanted: String): HighIntermediaryRepresentation.Functions.HighFunction? {
    return held_functions.find_by_name(wanted)
}

func held_attribute_named(wanted: String): HighIntermediaryRepresentation.Classes.HighAttribute? {
    return held_attributes.find_by_name(wanted)
}

var name = ""
var held_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()

func HighClass(starting_name: String, starting_functions: List<HighIntermediaryRepresentation.Functions.HighFunction>) {
    name = starting_name
    held_functions = starting_functions
}

func function_named(wanted: String): HighIntermediaryRepresentation.Functions.HighFunction? {
    return held_functions.find_by_name(wanted)
}

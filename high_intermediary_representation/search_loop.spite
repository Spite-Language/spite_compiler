# ../OPTIMIZATIONS.md#a-list-used-as-a-set-keeps-a-hash-index

var counter = ""
var held = ""
var list: SpiteCompiler.Value? = null
var sought: SpiteCompiler.Value? = null
var start: SpiteCompiler.Statement
var loop: SpiteCompiler.Statement

func SearchLoop(starting_start: SpiteCompiler.Statement, starting_loop: SpiteCompiler.Statement) {
    start = starting_start
    loop = starting_loop
}

func matches(): Boolean {
    fallback starts_at_zero(start)
    var walked = loop
    fallback walked.class == HighIntermediaryRepresentation.Statements.While
    fallback counts_up_to_the_list(walked.condition)
    var steps = walked.body.statements
    fallback steps.count() == 3
    var reading = steps[0]
    var testing = steps[1]
    var stepping = steps[2]
    fallback reads_the_item(reading) and answers_the_place(testing) and steps_once(stepping)
    return true
}

func starts_at_zero(statement: SpiteCompiler.Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return is_counted_from_zero(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return is_counted_from_zero(statement.name, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return false
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return false
        HighIntermediaryRepresentation.Statements.Evaluate: return false
        HighIntermediaryRepresentation.Statements.Return: return false
        HighIntermediaryRepresentation.Statements.If: return false
        HighIntermediaryRepresentation.Statements.While: return false
        HighIntermediaryRepresentation.Statements.Block: return false
        HighIntermediaryRepresentation.Statements.Stop: return false
    }
}

func is_counted_from_zero(name: String, value: SpiteCompiler.Value?): Boolean {
    fallback value and value.class == HighIntermediaryRepresentation.Values.WholeNumber
    fallback value.number == 0
    counter = name
    return true
}

func counts_up_to_the_list(condition: SpiteCompiler.Value?): Boolean {
    fallback condition and condition.class == HighIntermediaryRepresentation.Values.MachineOperation
    fallback condition.operator == 'less' and is_the_counter(condition.left)
    return counts_the_list(condition.right)
}

func counts_the_list(counted: SpiteCompiler.Value?): Boolean {
    fallback counted and counted.class == HighIntermediaryRepresentation.Values.Call
    fallback counted.function.name == "count" and counted.arguments.is_empty()
    fallback counted.function.owner.starts_with("List_of_")
    fallback counted.receiver and is_a_plain_list(counted.receiver)
    list = counted.receiver
    return true
}

func is_the_counter(value: SpiteCompiler.Value?): Boolean {
    fallback value and value.class == HighIntermediaryRepresentation.Values.LocalRead
    return value.name == counter
}

func is_a_plain_list(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name != counter
    }
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback value.object
    return value.object.class == HighIntermediaryRepresentation.Values.ThisRead
}

func reads_the_item(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Conversion
    fallback statement.value.kind == 'proven' and reads_at_the_counter(statement.value.converted)
    held = statement.name
    return held != counter
}

func reads_at_the_counter(read: SpiteCompiler.Value?): Boolean {
    fallback read and read.class == HighIntermediaryRepresentation.Values.Call
    fallback read.function.name == "get_at" and read.arguments.count() == 1
    var place = read.arguments[0]
    fallback is_the_counter(place)
    fallback read.receiver
    return is_the_list(read.receiver)
}

func is_the_list(value: SpiteCompiler.Value): Boolean {
    fallback list
    if list.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.class == HighIntermediaryRepresentation.Values.LocalRead and value.name == list.name
    }
    fallback list.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback value.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback value.object and value.object.class == HighIntermediaryRepresentation.Values.ThisRead
    var same_name = value.attribute.name == list.attribute.name
    return same_name and value.attribute.owner == list.attribute.owner
}

func answers_the_place(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.If
    if statement.else_branch {
        fallback statement.else_branch.statements.is_empty()
    }
    var taken = statement.then_branch.statements
    fallback taken.count() == 1
    var answering = taken[0]
    fallback answering.class == HighIntermediaryRepresentation.Statements.Return
    fallback is_the_counter(answering.value)
    return compares_the_item(statement.condition)
}

func compares_the_item(condition: SpiteCompiler.Value?): Boolean {
    fallback condition
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        fallback condition.operator == 'equal'
        return is_the_item_and_a_name(condition.left, condition.right)
    }
    fallback condition.class == HighIntermediaryRepresentation.Values.Call
    fallback condition.function.key() == "String.equals" and condition.arguments.count() == 1
    var other = condition.arguments[0]
    return is_the_item_and_a_name(condition.receiver, other)
}

func is_the_item_and_a_name(left: SpiteCompiler.Value?, right: SpiteCompiler.Value?): Boolean {
    if is_the_item(left) {
        return is_a_steady_name(right)
    }
    fallback is_the_item(right)
    return is_a_steady_name(left)
}

func is_the_item(value: SpiteCompiler.Value?): Boolean {
    fallback value and value.class == HighIntermediaryRepresentation.Values.LocalRead
    return value.name == held
}

func is_a_steady_name(value: SpiteCompiler.Value?): Boolean {
    fallback value and value.class == HighIntermediaryRepresentation.Values.LocalRead
    fallback value.name != held and value.name != counter
    sought = value
    return true
}

func steps_once(statement: SpiteCompiler.Statement): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign
    fallback statement.name == counter
    return adds_one(statement.value)
}

func adds_one(stepped: SpiteCompiler.Value?): Boolean {
    fallback stepped and stepped.class == HighIntermediaryRepresentation.Values.MachineOperation
    fallback stepped.operator == 'add' and is_the_counter(stepped.left)
    fallback stepped.right and stepped.right.class == HighIntermediaryRepresentation.Values.WholeNumber
    return stepped.right.number == 1
}

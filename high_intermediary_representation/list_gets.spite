var model = Model.ProgramModel()
var library = Validators.LibraryFile()

func ListGets(starting_model: Model.ProgramModel) {
    model = starting_model
}

func is_a_plain_get(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    if call.function.name != "get_at" or call.arguments.count() != 1 {
        return false
    }
    if not is_the_library_list(call.function, "list.spite") {
        return false
    }
    var owner = model.class_named(call.function.owner)
    if not owner {
        return false
    }
    var element = owner.bound_types["$element_type"]
    if not element {
        return false
    }
    if element.is_nullable {
        return false
    }
    return element.kind == 'scalar' or element.kind == 'object'
}

func is_the_library_list(function: Model.FunctionModel, file_name: String): Boolean {
    if not function.declaration {
        return false
    }
    var written = function.declaration.path.replace("\\", "/")
    if not library.holds(written) {
        return false
    }
    return written.ends_with("/common/{file_name}")
}

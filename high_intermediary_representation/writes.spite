# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func undoes(read: HighIntermediaryRepresentation.NarrowedRead, index: Integer): Boolean {
    crash read.writes
    var write = read.writes[index]
    fallback write
    if write.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        fallback not write.is_to_a_fresh_object
        if writes_the_way_there(write, read.object) {
            return true
        }
        var is_another_place = is_the_attribute(write.attribute, read) and not is_the_same_place(write.object, read.object)
        return is_another_place and may_break(write.value, read)
    }
    if write.class == HighIntermediaryRepresentation.Statements.Assign.ThroughShape {
        if names_the_way_there(write.member, read.object) {
            return true
        }
        return write.member == read.attribute.name and may_break(write.value, read)
    }
    return false
}

func writes_the_way_there(
    write: HighIntermediaryRepresentation.Statements.Assign.Attribute,
    way: SpiteCompiler.Value?,
): Boolean {
    fallback way
    if way.class == HighIntermediaryRepresentation.Values.Conversion {
        return writes_the_way_there(write, way.converted)
    }
    if way.class == HighIntermediaryRepresentation.Values.Call {
        return writes_the_way_there(write, way.receiver)
    }
    if way.class == HighIntermediaryRepresentation.Values.ShapeCall {
        return write.attribute.name == way.member.name or writes_the_way_there(write, way.receiver)
    }
    fallback way.class == HighIntermediaryRepresentation.Values.AttributeRead
    var same_attribute = write.attribute.owner == way.attribute.owner and write.attribute.name == way.attribute.name
    if same_attribute and not is_the_same_place(write.object, way.object) {
        return true
    }
    return writes_the_way_there(write, way.object)
}

func names_the_way_there(member: String, way: SpiteCompiler.Value?): Boolean {
    fallback way
    if way.class == HighIntermediaryRepresentation.Values.Conversion {
        return names_the_way_there(member, way.converted)
    }
    if way.class == HighIntermediaryRepresentation.Values.Call {
        return names_the_way_there(member, way.receiver)
    }
    if way.class == HighIntermediaryRepresentation.Values.ShapeCall {
        return way.member.name == member or names_the_way_there(member, way.receiver)
    }
    fallback way.class == HighIntermediaryRepresentation.Values.AttributeRead
    return way.attribute.name == member or names_the_way_there(member, way.object)
}

func attributes_of(
    read: HighIntermediaryRepresentation.NarrowedRead,
    model: Model.ProgramModel,
): List<Model.AttributeModel> {
    var found = List<Model.AttributeModel>()
    found.append(read.attribute)
    gather_the_way_there(read.object, model, found)
    return found
}

func gather_the_way_there(way: SpiteCompiler.Value?, model: Model.ProgramModel, found: List<Model.AttributeModel>) {
    fallback way
    if way.class == HighIntermediaryRepresentation.Values.Conversion {
        gather_the_way_there(way.converted, model, found)
    }
    if way.class == HighIntermediaryRepresentation.Values.Call {
        gather_the_way_there(way.receiver, model, found)
    }
    if way.class == HighIntermediaryRepresentation.Values.ShapeCall {
        gather_a_member(way, model, found)
    }
    if way.class == HighIntermediaryRepresentation.Values.AttributeRead {
        gather_an_attribute(way, model, found)
    }
}

func gather_an_attribute(
    read: HighIntermediaryRepresentation.Values.AttributeRead,
    model: Model.ProgramModel,
    found: List<Model.AttributeModel>,
) {
    found.append(read.attribute)
    gather_the_way_there(read.object, model, found)
}

func gather_a_member(
    call: HighIntermediaryRepresentation.Values.ShapeCall,
    model: Model.ProgramModel,
    found: List<Model.AttributeModel>,
) {
    var fillers = model.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var attribute = Model.AttributeModel(call.member.name, filler.name, call.value_type, null, false)
        found.append(attribute)
        index = index + 1
    }
    gather_the_way_there(call.receiver, model, found)
}

# ../PROOFS.md#a-getter-narrows-while-it-only-reads
func attribute_a_getter_reads(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    attributes: List<Model.AttributeModel>,
): Model.AttributeModel? {
    crash read.writes
    var write = read.writes[index]
    fallback write
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        if writes_the_attribute(write, attribute) {
            return attribute
        }
        attribute_index = attribute_index + 1
    }
    return null
}

func writes_the_attribute(write: SpiteCompiler.Statement, attribute: Model.AttributeModel): Boolean {
    if write.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        var is_the_same = write.attribute.owner == attribute.owner and write.attribute.name == attribute.name
        return is_the_same and not write.is_to_a_fresh_object
    }
    if write.class == HighIntermediaryRepresentation.Statements.Assign.ThroughShape {
        return write.member == attribute.name
    }
    return false
}

func written_name(read: HighIntermediaryRepresentation.NarrowedRead, index: Integer): String {
    crash read.writes
    var write = read.writes[index]
    crash write
    if write.class == HighIntermediaryRepresentation.Statements.Assign.Attribute {
        return write.attribute.name
    }
    if write.class == HighIntermediaryRepresentation.Statements.Assign.ThroughShape {
        return write.member
    }
    return read.attribute.name
}

func may_break(value: SpiteCompiler.Value?, read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    if not read.narrowed_type {
        return true
    }
    crash value
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.value_type.is_nullable {
        crash value.converted
        return breaks(value.converted.value_type, read.narrowed_type)
    }
    return breaks(value.value_type, read.narrowed_type)
}

func breaks(written: Model.Type, narrowed: Model.Type): Boolean {
    if written.is_nullable {
        return true
    }
    return narrowed.kind != 'union' and not written.is_the_same_as(narrowed)
}

func is_the_attribute(attribute: Model.AttributeModel, read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    return attribute.owner == read.attribute.owner and attribute.name == read.attribute.name
}

func is_the_same_place(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?): Boolean {
    fallback first and second
    if first.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_the_same_place(first.converted, second)
    }
    if second.class == HighIntermediaryRepresentation.Values.Conversion {
        return is_the_same_place(first, second.converted)
    }
    if first.class == HighIntermediaryRepresentation.Values.ThisRead {
        return second.class == HighIntermediaryRepresentation.Values.ThisRead
    }
    if first.class == HighIntermediaryRepresentation.Values.LocalRead and second.class == HighIntermediaryRepresentation.Values.LocalRead {
        return first.name == second.name
    }
    if first.class == HighIntermediaryRepresentation.Values.AttributeRead and second.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var same_attribute = first.attribute.owner == second.attribute.owner and first.attribute.name == second.attribute.name
        return same_attribute and is_the_same_place(first.object, second.object)
    }
    return false
}

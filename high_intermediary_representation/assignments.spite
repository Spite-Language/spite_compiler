var model = Model.ProgramModel()
var keys = List<String>()
var indices = Dictionary<String, Integer>()
var called = List<List<String>>()
var resolved = List<List<Integer>>()
var is_resolved = List<Boolean>()
var writers = Dictionary<String, List<Integer>>()
var reaches = Dictionary<String, List<Boolean>>()
var taken_as_values = List<String>()
var drops = List<String>()
var keeps_callbacks = false
var current_calls = List<String>()
var current_writes = List<String>()
var reassigned = List<String>()
var anything = "*"
var bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var skipping_ends = false
var waits_write = true
var skips_fresh_objects = false
var makes_a_fresh_object = false
var fresh_locals = List<String>()
var taken_by_signature = Dictionary<String, List<String>>()
var current_parameters = List<String>()
var parameter_calls = List<String>()
var calls_only_its_parameters = true
var waiting = [
    "Program.sleep"
    "Socket.accept_handle"
    "Socket.receive_into"
    "Socket.first_readable"
    "Console.read_line"
    "File.read_bytes"
    "File.read_bytes_at"
]

func Assignments(high: HighIntermediaryRepresentation.HighProgram) {
    read_the_program(high)
}

func read_the_program(high: HighIntermediaryRepresentation.HighProgram) {
    model = high.model
    keys = List<String>()
    indices = Dictionary<String, Integer>()
    called = List<List<String>>()
    resolved = List<List<Integer>>()
    is_resolved = List<Boolean>()
    writers = Dictionary<String, List<Integer>>()
    reaches = Dictionary<String, List<Boolean>>()
    taken_as_values = List<String>()
    drops = List<String>()
    keeps_callbacks = false
    bodies = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
    taken_by_signature = Dictionary<String, List<String>>()
    high.built_functions.each(read_a_function)
    add_a_node("$value", taken_as_values)
    add_the_signature_nodes()
    add_a_node("$drop", drops)
    var foreign = List<String>()
    if keeps_callbacks {
        foreign.append("$value")
    }
    add_a_node("$foreign", foreign)
    var no_calls = List<String>()
    var everything = List<String>()
    everything.append(anything)
    add_a_function("$unknown", no_calls, everything)
}

func add_a_node(key: String, calls: List<String>) {
    var nothing_written = List<String>()
    add_a_function(key, calls, nothing_written)
}

func add_a_function(key: String, calls: List<String>, written: List<String>) {
    var index = keys.count()
    keys.append(key)
    indices[key] = index
    called.append(calls)
    var no_targets = List<Integer>()
    resolved.append(no_targets)
    is_resolved.append(false)
    var written_index = 0
    while written_index < written.count() {
        var attribute_key = written[written_index]
        note_a_writer(attribute_key, index)
        written_index = written_index + 1
    }
}

func note_a_writer(attribute_key: String, index: Integer) {
    if not writers.contains(attribute_key) {
        var none_yet = List<Integer>()
        writers[attribute_key] = none_yet
    }
    var known = writers[attribute_key]
    crash known
    known.append(index)
}

func read_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    current_calls = List<String>()
    current_writes = List<String>()
    var makes_its_object = function.function.is_constructor or function.function.name == "_attribute_defaults"
    makes_a_fresh_object = skips_fresh_objects and makes_its_object
    fresh_locals = List<String>()
    current_parameters = List<String>()
    function.function.parameters.each(note_a_parameter)
    parameter_calls = List<String>()
    calls_only_its_parameters = true
    read_a_block(function.body)
    if not calls_only_its_parameters {
        parameter_calls.each(current_calls.append)
    }
    var key = function.function.key()
    bodies[key] = function
    if function.function.name == "drop" {
        drops.append(key)
    }
    add_a_function(key, current_calls, current_writes)
}

func attribute_key_of(attribute: Model.AttributeModel): String {
    return "{attribute.owner}.{attribute.name}"
}

func leaves_alone(
    statements: List<HighIntermediaryRepresentation.Statements.Statement>,
    from: Integer,
    watched: List<String>,
): Boolean {
    current_calls = List<String>()
    current_writes = List<String>()
    var index = from
    while index < statements.count() {
        var statement = statements[index]
        read_a_statement(statement)
        index = index + 1
    }
    current_calls.append("$drop")
    var watched_index = 0
    while watched_index < watched.count() {
        var attribute_key = watched[watched_index]
        if is_touched(attribute_key) {
            return false
        }
        watched_index = watched_index + 1
    }
    return true
}

func is_touched(attribute_key: String): Boolean {
    var parts = attribute_key.split(".")
    var last = parts.count() - 1
    var name = parts[last]
    crash name
    var by_name = "?.{name}"
    if current_writes.contains(attribute_key) or current_writes.contains(by_name) or current_writes.contains(anything) {
        return true
    }
    var index = 0
    while index < current_calls.count() {
        var key = current_calls[index]
        if reaches_a_writer(key, attribute_key, by_name) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_assign(called_keys: List<String>, attribute: Model.AttributeModel): Boolean {
    var attribute_key = attribute_key_of(attribute)
    var by_name = "?.{attribute.name}"
    if reaches_a_writer("$drop", attribute_key, by_name) {
        return true
    }
    var index = 0
    while index < called_keys.count() {
        var key = called_keys[index]
        if reaches_a_writer(key, attribute_key, by_name) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func read_for_narrowings(high: HighIntermediaryRepresentation.HighProgram) {
    waits_write = high.makes_work
    skips_fresh_objects = true
    read_the_program(high)
    makes_a_fresh_object = false
}

func value_may_assign(value: HighIntermediaryRepresentation.Values.Value, attribute: Model.AttributeModel): Boolean {
    current_calls = List<String>()
    current_writes = List<String>()
    read_a_value(value)
    if current_calls.is_empty() and current_writes.is_empty() {
        return false
    }
    current_calls.append("$drop")
    var attribute_key = attribute_key_of(attribute)
    return is_touched(attribute_key)
}

func writer_reached(attribute: Model.AttributeModel): String {
    var attribute_key = attribute_key_of(attribute)
    var by_name = "?.{attribute.name}"
    var index = 0
    while index < current_calls.count() {
        var key = current_calls[index]
        var found = writer_reached_from(key, attribute_key, by_name)
        if not found.is_empty() {
            return found
        }
        index = index + 1
    }
    return ""
}

func writer_reached_from(key: String, attribute_key: String, by_name: String): String {
    if not indices.contains(key) {
        return ""
    }
    var reached = reach_of(key)
    var written_keys = [attribute_key, by_name, anything]
    var key_index = 0
    while key_index < written_keys.count() {
        var written_key = written_keys[key_index]
        crash written_key
        var found = writers[written_key]
        if found {
            var writer = first_reached(reached, found)
            if writer >= 0 {
                var writer_key = keys[writer]
                crash writer_key
                return writer_key
            }
        }
        key_index = key_index + 1
    }
    return ""
}

func first_reached(reached: List<Boolean>, found: List<Integer>): Integer {
    var index = 0
    while index < found.count() {
        var writer = found[index]
        crash writer
        if reached[writer] == true {
            return writer
        }
        index = index + 1
    }
    return -1
}

func may_write_items(called_keys: List<String>, list_key: String): Boolean {
    var slots = "[]{list_key}"
    var grown = "[+]{list_key}"
    if reaches_a_writer("$drop", slots, grown) {
        return true
    }
    var index = 0
    while index < called_keys.count() {
        var key = called_keys[index]
        if reaches_a_writer(key, slots, grown) {
            return true
        }
        index = index + 1
    }
    return false
}

func reaches_a_writer(key: String, attribute_key: String, by_name: String): Boolean {
    if not indices.contains(key) {
        return false
    }
    var reached = reach_of(key)
    return any_written(reached, attribute_key) or any_written(reached, by_name) or any_written(reached, anything)
}

func any_written(reached: List<Boolean>, attribute_key: String): Boolean {
    var found = writers[attribute_key]
    if not found {
        return false
    }
    var index = 0
    while index < found.count() {
        var writer = found[index]
        if reached[writer] == true {
            return true
        }
        index = index + 1
    }
    return false
}

func reach_of(key: String): List<Boolean> {
    if not reaches.contains(key) {
        record_the_reach(key)
    }
    var known = reaches[key]
    crash known
    return known
}

func record_the_reach(key: String) {
    var reached = List<Boolean>()
    var filling = 0
    while filling < keys.count() {
        reached.append(false)
        filling = filling + 1
    }
    var start = indices[key]
    crash start
    var pending = List<Integer>()
    pending.append(start)
    while not pending.is_empty() {
        var last = pending.count() - 1
        var node = pending[last]
        crash node
        pending.remove_at(last)
        if reached[node] != true {
            reached[node] = true
            var targets = targets_of(node)
            targets.each(pending.append)
        }
    }
    reaches[key] = reached
}

func targets_of(node: Integer): List<Integer> {
    if is_resolved[node] != true {
        resolve(node)
    }
    var known = resolved[node]
    crash known
    return known
}

func resolve(node: Integer) {
    var targets = List<Integer>()
    var calls = called[node]
    crash calls
    var index = 0
    while index < calls.count() {
        var callee = calls[index]
        if indices.contains(callee) {
            var target = indices[callee]
            crash target
            targets.append(target)
        }
        index = index + 1
    }
    resolved[node] = targets
    is_resolved[node] = true
}

func names_assigned_in(block: HighIntermediaryRepresentation.Statements.Block): List<String> {
    reassigned = List<String>()
    gather_from_a_block(block)
    return reassigned
}

func gather_from_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(gather_from_a_statement)
}

func gather_from_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Assign: reassigned.append(statement.name)
        HighIntermediaryRepresentation.Statements.Declare: gather_a_hidden(statement)
        HighIntermediaryRepresentation.Statements.If: gather_from_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: gather_from_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: gather_from_a_block(statement)
        _: return
    }
}

func gather_a_hidden(declare: HighIntermediaryRepresentation.Statements.Declare) {
    if declare.hides != "" {
        reassigned.append(declare.hides)
    }
}

func gather_from_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    gather_from_a_block(branch.then_branch)
    gather_from_a_block(branch.else_branch)
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    assert not skipping_ends or not ends_the_program(block)
    block.statements.each(read_a_statement)
}

func ends_the_program(block: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var last = block.statements.last()
    if last and last == HighIntermediaryRepresentation.Statements.Stop {
        return not last.then
    }
    return false
}

func read_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.Return: read_a_return(statement)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
    }
}

func read_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    read_a_value(declared.value)
    var made = declared.value
    var is_made_here = made == HighIntermediaryRepresentation.Values.MakeObject
    if skips_fresh_objects and is_made_here {
        fresh_locals.append(declared.name)
    }
}

func note_a_parameter(parameter: Model.ParameterModel) {
    current_parameters.append(parameter.name)
}

func read_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    if current_parameters.contains(assigned.name) {
        calls_only_its_parameters = false
    }
    var place = fresh_locals.index_of(assigned.name)
    if place {
        fresh_locals.remove_at(place)
    }
    read_a_value(assigned.value)
}

func read_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    read_a_value(returned.value)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(read_a_present)
    read_a_value(stop.then)
}

func read_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    var attribute_key = attribute_key_of(written.attribute)
    var is_fresh = makes_a_fresh_object and written.object == HighIntermediaryRepresentation.Values.ThisRead
    var object = written.object
    if object == HighIntermediaryRepresentation.Values.LocalRead {
        is_fresh = is_fresh or fresh_locals.contains(object.name)
    }
    if not is_fresh {
        current_writes.append(attribute_key)
    }
    read_a_value(written.object)
    read_a_value(written.value)
}

func read_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    current_writes.append("?.{written.member}")
    var fillers = model.fillers_of(written.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        current_calls.append("{filler.name}.set_{written.member}")
        index = index + 1
    }
    read_a_value(written.object)
    read_a_value(written.value)
}

func read_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    read_a_value(evaluated.value)
    read_a_value(evaluated.waited)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    read_a_value(branch.condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    read_a_value(loop.condition)
    read_a_block(loop.body)
}

func read_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    read_a_value(value)
}

func read_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: read_a_conversion(value)
        HighIntermediaryRepresentation.Values.AttributeRead: read_a_value(value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: read_a_value(value.described)
        HighIntermediaryRepresentation.Values.Class.Test: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: read_a_value(value.text)
        HighIntermediaryRepresentation.Values.EnumText: read_a_value(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: read_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Function.Value: read_a_taken_function(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: read_a_function_value_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.MakeObject: read_a_making(value)
        HighIntermediaryRepresentation.Values.Negation: read_a_value(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: read_a_shape_call(value)
        _: return
    }
}

func read_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    read_a_value(first)
    read_a_value(second)
}

func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var key = call.function.key()
    if waits_write and waiting.contains(key) {
        current_writes.append(anything)
    }
    var name = call.function.name
    if name == "_write_value" and writes_past_the_end(call) {
        current_writes.append("[+]{call.function.owner}")
    } else if name == "_write_value" or name == "_forget_value" {
        current_writes.append("[]{call.function.owner}")
    }
    current_calls.append(key)
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
    if skips_fresh_objects {
        pass_the_values(call.arguments)
    }
}

# ../OPTIMIZATIONS.md#a-name-holding-an-item-or-an-attribute-is-not-counted
func writes_past_the_end(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var on_this = call.receiver == HighIntermediaryRepresentation.Values.ThisRead
    var at = call.arguments[0]
    if not on_this or not at {
        return false
    }
    if at == HighIntermediaryRepresentation.Values.AttributeRead {
        var of_this = at.object == HighIntermediaryRepresentation.Values.ThisRead
        return of_this and at.attribute.name == "_length" and at.attribute.owner == call.function.owner
    }
    return false
}

func read_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    if conversion.kind == 'join' {
        current_writes.append(anything)
    }
    read_a_value(conversion.converted)
}

func read_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    current_calls.append("$foreign")
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.value_type.kind == 'function' {
            current_calls.append("$value")
        }
        read_a_value(argument)
        index = index + 1
    }
    read_a_value(call.library)
}

func read_a_taken_function(taken: HighIntermediaryRepresentation.Values.Function.Value) {
    var key = taken.function.key()
    if not taken_as_values.contains(key) {
        taken_as_values.append(key)
    }
    var signature = signature_of(taken.value_type)
    if not taken_by_signature.contains(signature) {
        var none_yet = List<String>()
        taken_by_signature[signature] = none_yet
    }
    var same = taken_by_signature[signature]
    crash same
    if not same.contains(key) {
        same.append(key)
    }
    read_a_value(taken.receiver)
}

func read_a_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    current_calls.append("$value")
    crash call.called
    var signature = signature_of(call.called.value_type)
    if skips_fresh_objects {
        current_calls.remove_last()
        call_a_value(call.called, signature)
    }
    read_a_value(call.called)
    call.arguments.each(read_a_present)
    if skips_fresh_objects {
        pass_the_values(call.arguments)
    }
}

# ../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func call_a_value(called: HighIntermediaryRepresentation.Values.Value, signature: String) {
    var node = "$value"
    if taken_by_signature.contains(signature) {
        node = "$value:{signature}"
    }
    if called == HighIntermediaryRepresentation.Values.LocalRead and current_parameters.contains(called.name) {
        parameter_calls.append(node)
        return
    }
    calls_only_its_parameters = false
    current_calls.append(node)
}

func pass_the_values(arguments: List<HighIntermediaryRepresentation.Values.Value>) {
    assert skips_fresh_objects
    arguments.each(pass_a_value)
}

func pass_a_value(argument: HighIntermediaryRepresentation.Values.Value) {
    if argument == HighIntermediaryRepresentation.Values.Function.Value {
        var key = argument.function.key()
        current_calls.append(key)
    }
    if argument == HighIntermediaryRepresentation.Values.LocalRead {
        pass_a_parameter(argument)
    }
}

func pass_a_parameter(argument: HighIntermediaryRepresentation.Values.LocalRead) {
    if current_parameters.contains(argument.name) and argument.value_type.kind == 'function' {
        var signature = signature_of(argument.value_type)
        call_a_value(argument, signature)
    }
}

func add_the_signature_nodes() {
    var signatures = taken_by_signature.keys()
    var index = 0
    while index < signatures.count() {
        var signature = signatures[index]
        var same = taken_by_signature[signature]
        crash same
        add_a_node("$value:{signature}", same)
        index = index + 1
    }
}

func signature_of(function_type: Model.Type): String {
    var shown = List<String>()
    var index = 0
    while index < function_type.parameters.count() {
        var parameter = function_type.parameters[index]
        var parameter_shown = type_shown(parameter)
        shown.append(parameter_shown)
        index = index + 1
    }
    var answer = "nothing"
    if function_type.answer {
        answer = type_shown(function_type.answer)
    }
    var listed = shown.join(",")
    return "({listed})->{answer}"
}

func type_shown(shown_type: Model.Type): String {
    var mark = ""
    if shown_type.is_nullable {
        mark = "?"
    }
    return "{shown_type.kind}:{shown_type.name}{mark}"
}

func read_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    var class_key = made.value_type.name
    if class_key == "ForeignCallback" {
        keeps_callbacks = true
    }
    current_calls.append("{class_key}._attribute_defaults")
    if made.constructor {
        var constructor_key = made.constructor.key()
        current_calls.append(constructor_key)
    }
    made.arguments.each(read_a_present)
    if skips_fresh_objects {
        pass_the_values(made.arguments)
    }
}

func read_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    var fillers = model.fillers_of(call.shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        current_calls.append("{filler.name}.{call.member.name}")
        current_calls.append("{filler.name}.get_{call.member.name}")
        index = index + 1
    }
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
    if skips_fresh_objects {
        pass_the_values(call.arguments)
    }
}

# ../OPTIMIZATIONS.md#a-counted-loop-of-reads-shares-its-singletons-lock
func writes_none_of(key: String, class_keys: List<String>, names: List<String>): Boolean {
    var seen = List<String>()
    var pending = List<String>()
    pending.append(key)
    drops.each(pending.append)
    skipping_ends = true
    var clean = true
    while clean and not pending.is_empty() {
        var next = pending.remove_last()
        crash next
        if not seen.contains(next) {
            seen.append(next)
            clean = writes_none_in(next, class_keys, names, pending)
        }
    }
    skipping_ends = false
    return clean
}

func writes_none_in(key: String, class_keys: List<String>, names: List<String>, pending: List<String>): Boolean {
    if key == "$value" or key == "$foreign" or key == "$unknown" {
        return false
    }
    var found = bodies[key]
    if not found {
        return true
    }
    current_calls = List<String>()
    current_writes = List<String>()
    read_a_block(found.body)
    var index = 0
    while index < current_writes.count() {
        var written = current_writes[index]
        crash written
        if touches_one_of(written, class_keys, names) {
            return false
        }
        index = index + 1
    }
    current_calls.each(pending.append)
    return true
}

func touches_one_of(attribute_key: String, class_keys: List<String>, names: List<String>): Boolean {
    if attribute_key == anything {
        return true
    }
    var length = attribute_key.length()
    if attribute_key.starts_with("[]") {
        var listed = attribute_key.slice(2, length)
        return class_keys.contains(listed)
    }
    if attribute_key.starts_with("[+]") {
        var grown = attribute_key.slice(3, length)
        return class_keys.contains(grown)
    }
    if attribute_key.starts_with("?.") {
        var named = attribute_key.slice(2, length)
        return names.contains(named)
    }
    var parts = attribute_key.split(".")
    parts.remove_last()
    var owner = parts.join(".")
    return owner.is_empty() or class_keys.contains(owner)
}

var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var substitution = NameResolution.Substitution()
var type_builder = NameResolution.Types()
var built_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
var built_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
var built_values = List<HighIntermediaryRepresentation.Values.Value>()
var skipped = 0
var built_names = List<String>()
var built_types = List<String>()
var current_class = ""

func Builder(starting_file: AbstractSyntaxTree.Shapes.SourceFile, starting_substitution: NameResolution.Substitution) {
    file = starting_file
    substitution = starting_substitution
}

func build(class_name: String): HighIntermediaryRepresentation.Classes.HighClass {
    current_class = class_name
    built_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
    file.declarations.each(read_declaration)
    return HighIntermediaryRepresentation.Classes.HighClass(class_name, built_functions)
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        read_function(declaration)
        return
    }
    return
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if declaration.body {
        read_a_function(declaration, declaration.body)
    } else {
        return
    }
}

func read_a_function(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    body: AbstractSyntaxTree.Shapes.Statements.Block,
) {
    var block = lower_block(body)
    built_names = List<String>()
    declaration.parameters.each(read_parameter)
    built_types = List<String>()
    declaration.parameters.each(read_parameter_type)
    var names = built_names
    var types = built_types
    built_names = List<String>()
    built_types = List<String>()
    var result = ""
    if declaration.result {
        result = type_builder.written_of(declaration.result, substitution)
    }
    var function = HighIntermediaryRepresentation.Functions.HighFunction(declaration.name, names, types, result, block)
    built_functions.append(function)
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    built_names.append(parameter.name)
}

func read_parameter_type(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var written = ""
    if parameter.declared_type {
        written = type_builder.written_of(parameter.declared_type, substitution)
    }
    built_types.append(written)
}

func lower_block(block: AbstractSyntaxTree.Shapes.Statements.Block): HighIntermediaryRepresentation.Statements.Block {
    var outer = built_statements
    built_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    block.statements.each(lower_statement)
    var built = HighIntermediaryRepresentation.Statements.Block(built_statements)
    built_statements = outer
    return built
}

func lower_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        lower_variable(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        lower_assignment(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        lower_while(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        lower_return(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        lower_held(statement)
        return
    }
    skipped = skipped + 1
}

func lower_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var value = lower_value(statement.value)
    if value {
        var declared = HighIntermediaryRepresentation.Statements.Declare(statement.name, value)
        built_statements.append(declared)
    } else {
        skipped = skipped + 1
    }
}

func lower_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = statement.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        assign_to_name(target, statement.value)
    } else {
        skipped = skipped + 1
    }
}

func assign_to_name(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    value_expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var name = target
    var value = lower_value(value_expression)
    if value {
        var assigned = HighIntermediaryRepresentation.Statements.Assign(name.name, value)
        built_statements.append(assigned)
    } else {
        skipped = skipped + 1
    }
}

func lower_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var condition = lower_value(statement.condition)
    if condition {
        lower_loop_body(condition, statement)
    } else {
        skipped = skipped + 1
    }
}

func lower_loop_body(
    condition: HighIntermediaryRepresentation.Values.Value,
    statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
) {
    if statement.body {
        var block = lower_block(statement.body)
        var loop = HighIntermediaryRepresentation.Statements.While(condition, block)
        built_statements.append(loop)
    } else {
        skipped = skipped + 1
    }
}

func lower_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var value = lower_value(statement.value)
    var returned = HighIntermediaryRepresentation.Statements.Return(value)
    built_statements.append(returned)
}

func lower_held(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    var value = statement.value
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var call = value
        var arguments = lower_arguments(call.arguments)
        var name = call_name(call)
        var owner = call_owner(call)
        var made = HighIntermediaryRepresentation.Statements.Call(name, owner, arguments)
        built_statements.append(made)
    } else {
        skipped = skipped + 1
    }
}

func call_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = callee
        return name.name
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return member.name
    }
    return ""
}

func call_owner(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var identifier = callee
        return owner_of_an_identifier(identifier)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return owner_of_a_member(member)
    }
    return ""
}

func owner_of_an_identifier(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if identifier.is_a_class_name {
        return identifier.name
    } else {
        return current_class
    }
}

func owner_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if member.is_a_class_name {
        return member.name
    } else {
        return owner_of_the_receiver(member)
    }
}

func owner_of_the_receiver(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var receiver = target
        return owner_of_a_receiver(receiver)
    } else {
        return ""
    }
}

func owner_of_a_receiver(receiver: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if receiver.is_a_class_name {
        return receiver.name
    } else {
        return ""
    }
}

func lower_arguments(
    given: List<AbstractSyntaxTree.Shapes.Expressions.Expression>,
): List<HighIntermediaryRepresentation.Values.Value> {
    built_values = List<HighIntermediaryRepresentation.Values.Value>()
    given.each(lower_argument)
    var built = built_values
    built_values = List<HighIntermediaryRepresentation.Values.Value>()
    return built
}

func lower_argument(argument: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    var value = lower_value(argument)
    if value {
        built_values.append(value)
    } else {
        skipped = skipped + 1
    }
}

func lower_value(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    if expression {
        return lower_a_value(expression)
    } else {
        return null
    }
}

func lower_a_value(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
): HighIntermediaryRepresentation.Values.Value? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return lower_literal(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return lower_identifier(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return lower_binary(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return lower_call(expression)
    }
    return null
}

func lower_literal(
    expression: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
): HighIntermediaryRepresentation.Values.Value? {
    if expression.kind == 'integer_literal' {
        return HighIntermediaryRepresentation.Values.WholeNumber(expression.text)
    } else {
        return null
    }
}

func lower_identifier(
    expression: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value? {
    return HighIntermediaryRepresentation.Values.Name(expression.name)
}

func lower_binary(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var operator = symbol_of(expression.operator)
    if operator != "" {
        return lower_arithmetic(expression, operator)
    } else {
        return null
    }
}

func lower_arithmetic(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: String,
): HighIntermediaryRepresentation.Values.Value? {
    var left = lower_value(expression.left)
    if left {
        return lower_arithmetic_right(expression, operator, left)
    } else {
        return null
    }
}

func lower_arithmetic_right(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: String,
    left: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value? {
    var right = lower_value(expression.right)
    if right {
        return HighIntermediaryRepresentation.Values.Operation(left, operator, right)
    } else {
        return null
    }
}

func symbol_of(kind: AbstractSyntaxTree.Tokens.TokenKind): String {
    switch kind {
        'plus': return "+"
        'minus': return "-"
        'star': return "*"
        'slash': return "/"
        'percent': return "%"
        'equal_equal': return "=="
        'not_equal': return "!="
        'less': return "<"
        'greater': return ">"
        'less_or_equal': return "<="
        'greater_or_equal': return ">="
        _: return ""
    }
}

func lower_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var name = call_name(expression)
    if name != "" {
        return lower_the_call(expression, name)
    } else {
        return null
    }
}

func lower_the_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    var arguments = lower_arguments(expression.arguments)
    var owner = call_owner(expression)
    return HighIntermediaryRepresentation.Values.Answer(name, owner, arguments)
}

func skipped_count(): Integer {
    return skipped
}

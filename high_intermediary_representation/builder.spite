var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var statements_state = HighIntermediaryRepresentation.Building.StatementsState()
var statements = HighIntermediaryRepresentation.Building.Statements(statements_state)
var program = HighProgram(no_program)
var defaults_built = 0
var prompt_key = "ReadEvaluatePrintLoop"
var frames_started = false
var kept_classes = 0
var gathering = Diagnostics.Gathering()

func Builder(starting_program: Model.ProgramModel, resolver: NameResolution.Resolver) {
    context = HighIntermediaryRepresentation.Building.Context(starting_program, resolver)
    statements_state = HighIntermediaryRepresentation.Building.StatementsState()
    statements_state.start_from(context)
    statements = HighIntermediaryRepresentation.Building.Statements(statements_state)
    program = HighProgram(starting_program)
    context.built_so_far = program.built_functions
}

func build(): HighProgram {
    var entry_class = context.program.class_named(context.program.entry)
    crash entry_class
    context.need_defaults(entry_class.key)
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var constructor = values.constructor_of(entry_class)
    program.entry = constructor
    if constructor {
        context.need(constructor)
    }
    need_the_fault_report()
    need_the_settings_check()
    var keeps_going = true
    while keeps_going {
        build_the_waiting_functions()
        build_the_waiting_defaults()
        follow_the_shape_links()
        keep_the_unreached()
        settle_the_key_maps()
        var is_quiet = context.waiting.is_empty() and defaults_built >= context.made_classes.count()
        var found_something = gathering.has_found_something()
        if is_quiet and not found_something {
            fill_the_reflection()
            add_the_reloader()
            add_the_prompt()
            start_the_frame_calls()
        }
        var is_unfilled = not context.unfilled.is_empty() and not found_something
        var has_more = not context.waiting.is_empty() or is_unfilled
        keeps_going = has_more or defaults_built < context.made_classes.count()
    }
    check_the_unreached()
    gathering.tell_what_was_found()
    context.synthetic_functions.each(add_a_synthetic)
    context.fills.each(add_a_synthetic)
    program.makes_work = context.makes_work
    program.narrowed_reads = context.narrowed_reads
    program.in_flight_sites = context.in_flight_sites
    program.crash_sites = context.crash_sites
    program.context = context
    return program
}

# ../../spite_documentation/compiler.md#development-builds-and-tree-shaking
func keep_the_unreached() {
    var inspection = CommandLine.Inspection()
    fallback inspection.holds(context.build_flags)
    while kept_classes < context.made_classes.count() {
        var key = context.made_classes[kept_classes]
        keep_the_functions_of(key)
        kept_classes = kept_classes + 1
    }
}

# ../ARCHITECTURE.md#checking-the-functions-nobody-calls
func check_the_unreached() {
    var inspection = CommandLine.Inspection()
    fallback not inspection.holds(context.build_flags)
    var before = HighIntermediaryRepresentation.Building.Checkpoint(context, program)
    var checked_classes = 0
    var keeps_going = true
    while keeps_going {
        while checked_classes < context.program.order.count() {
            var model = context.program.order[checked_classes]
            keep_the_functions_of(model.key)
            checked_classes = checked_classes + 1
        }
        build_the_waiting_functions()
        build_the_waiting_defaults()
        follow_the_shape_links()
        settle_the_key_maps()
        var has_more = not context.waiting.is_empty() or defaults_built < context.made_classes.count()
        keeps_going = has_more or checked_classes < context.program.order.count()
    }
    before.put_back()
    defaults_built = context.made_classes.count()
}

func keep_the_functions_of(key: String) {
    var model = context.program.class_named(key)
    crash model
    var library = Mapping.LibraryFile()
    var is_the_programs = model.bound_types.is_empty() and not library.holds(model.file.path)
    fallback is_the_programs
    model.declared_functions.each(keep_a_function)
}

func keep_a_function(function: Model.FunctionModel) {
    var is_declared = not function.is_synthetic and not function.is_written_by_the_compiler
    var is_plain = not function.is_constructor and not function.is_an_attribute and not function.is_a_member_template
    var is_its_own = function.bound_member.is_empty() and not function.is_a_walk_copy
    var is_kept = is_declared and is_plain and is_its_own and function.bound_function.is_empty()
    fallback is_kept and function.has_a_body() and takes_only_values(function)
    context.need(function)
}

func takes_only_values(function: Model.FunctionModel): Boolean {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        fallback not parameter.is_variadic and is_a_value(parameter.parameter_type)
        fallback not is_a_walked_member(parameter.parameter_type)
        index = index + 1
    }
    if function.answer {
        return is_a_value(function.answer)
    }
    return true
}

# ../../spite_documentation/metaprogramming.md#walking-a-programs-structure
func is_a_walked_member(described: Model.Type): Boolean {
    var ranges = ["Spite.AttributeDeclaration", "Spite.Attribute", "Spite.FunctionDeclaration", "Spite.Argument", "Spite.Class"]
    return ranges.contains(described.name)
}

func is_a_value(described: Model.Type): Boolean {
    switch described.kind {
        'scalar': return true
        'object': return true
        'enumeration': return true
        'union': return true
        'nothing': return true
        'function': return false
        'shape': return false
        'handle': return false
        'namespace': return false
        'parameters': return false
        'pattern': return false
    }
}

# ../ARCHITECTURE.md#a-high-pass-that-rewrites-and-builds-functions
func continue_from(high: HighProgram) {
    crash high.context
    context = high.context
    statements_state = HighIntermediaryRepresentation.Building.StatementsState()
    statements_state.start_from(context)
    statements = HighIntermediaryRepresentation.Building.Statements(statements_state)
    program = high
    defaults_built = context.made_classes.count()
    frames_started = true
}

func build_the_needed(): List<HighFunction> {
    var first = program.built_functions.count()
    var synthetic_start = context.synthetic_functions.count()
    var keeps_going = true
    while keeps_going {
        build_the_waiting_functions()
        build_the_waiting_defaults()
        follow_the_shape_links()
        keeps_going = not context.waiting.is_empty() or defaults_built < context.made_classes.count()
    }
    crash context.unfilled.is_empty()
    var index = synthetic_start
    while index < context.synthetic_functions.count() {
        var synthetic = context.synthetic_functions[index]
        add_a_synthetic(synthetic)
        index = index + 1
    }
    program.makes_work = context.makes_work
    program.in_flight_sites = context.in_flight_sites
    var built = List<HighFunction>()
    var built_index = first
    while built_index < program.built_functions.count() {
        var made = program.built_functions[built_index]
        built.append(made)
        built_index = built_index + 1
    }
    return built
}

# ../../spite_documentation/repl.md#the-program-this-page-uses
func add_the_prompt() {
    var asked = context.build_flags["repl"]
    var runs_the_console = asked == "true"
    var asked_port = context.build_flags["repl_port"]
    var serves = false
    if asked_port {
        serves = true
    }
    var wants_a_prompt = runs_the_console or serves
    fallback wants_a_prompt and not program.prompt
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var unique = Validators.HighIntermediaryRepresentation.PromptName.Validator()
    unique.check(context.program, prompt_key)
    var writer = HighIntermediaryRepresentation.Building.Prompt.Source(context)
    var text = writer.source(prompt_key)
    program.prompt_intrinsics = writer.state.intrinsics
    var folder = folder_of(entry.file.path)
    add_the_prompt_classes(folder)
    var path = "{folder}/.spite/build/spite/read_evaluate_print_loop.spite"
    context.resolver.state.symbols.add_a_generated_class(prompt_key, path, text)
    var model = context.resolver.monomorphiser.class_model_named(prompt_key)
    crash model
    context.need_defaults(model.key)
    var settings = context.program.class_named("Build")
    if settings and not context.made_classes.contains(settings.key) {
        context.need_defaults(settings.key)
    }
    var running = model.function_named("run")
    crash running
    context.need(running)
    program.prompt = running
    program.prompt_runs_the_console = runs_the_console
    if serves {
        program.prompt_listen = needed_prompt_function(model, "listen")
        program.prompt_check_point = needed_prompt_function(model, "check_point")
        program.prompt_serve = needed_prompt_function(model, "serve")
    }
}

# ../../spite_documentation/repl.md#how-it-works
func add_the_reloader() {
    var asked = context.build_flags["hot_reload"]
    fallback asked == "true" and not program.reload_start
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var folder = folder_of(entry.file.path)
    var reload_folder = "{folder}/.spite/build/spite"
    var symbols = context.resolver.state.symbols
    if not symbols.library_folders.contains(reload_folder) {
        symbols.library_folders.append(reload_folder)
    }
    var writer = HighIntermediaryRepresentation.Building.Reload.Source(context)
    var point_text = writer.point_source()
    symbols.add_a_generated_class("Spite.ReloadPoint", "{reload_folder}/reload_point.spite", point_text)
    var model = context.resolver.monomorphiser.class_model_named("Spite.ReloadPoint")
    crash model
    context.need_defaults(model.key)
    var starting = model.function_named("start")
    crash starting
    context.need(starting)
    program.reload_start = starting
    var checking = model.function_named("check_point")
    crash checking
    context.need(checking)
    program.reload_check_point = checking
}

func needed_prompt_function(model: Model.ClassModel, name: String): Model.FunctionModel {
    var found = model.function_named(name)
    crash found
    context.need(found)
    return found
}

func add_the_prompt_classes(folder: String) {
    var symbols = context.resolver.state.symbols
    var prompt_folder = "{folder}/.spite/build/spite"
    symbols.library_folders.append(prompt_folder)
    var texts = HighIntermediaryRepresentation.Building.Prompt.Text()
    texts.hot_reload = context.build_flags["hot_reload"] == "true"
    var prompt_text = texts.prompt_source()
    symbols.add_a_generated_class("Spite.Prompt", "{prompt_folder}/prompt.spite", prompt_text)
    var path_text = texts.path_source()
    symbols.add_a_generated_class("Spite.PromptPath", "{prompt_folder}/prompt_path.spite", path_text)
    if texts.hot_reload {
        var entry = context.program.class_named(context.program.entry)
        crash entry
        var typed = typed_prompt_code()
        var code_text = texts.code_source(entry.shown, typed)
        make_the_folders(folder)
        var code_path = "{prompt_folder}/prompt_code.spite"
        var file_path: Path? = code_path
        crash file_path
        var code_file = File(file_path)
        var written = code_file.write_string(code_text)
        crash written
        symbols.add_a_generated_class("Spite.PromptCode", code_path, code_text)
        if symbols.is_machinery("Spite.Breakpoint") {
            symbols.add_the_machinery("Spite.Breakpoint")
        }
    }
}

func make_the_folders(folder: String) {
    var made = ["{folder}/.spite", "{folder}/.spite/build", "{folder}/.spite/build/spite"]
    made.each(make_a_folder)
}

func make_a_folder(path: String) {
    var folder_path: Path? = path
    crash folder_path
    var directory = Directory(folder_path)
    fallback not directory.exists()
    var made = directory.create()
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, made)
}

# ../../spite_documentation/repl.md#the-wire-protocol
func typed_prompt_code(): String {
    var executable = context.build_flags["executable_path"]
    var reloads = context.build_flags.contains("reload_at")
    fallback reloads and executable
    var stem = executable
    if executable.ends_with(".exe") {
        var length = executable.length()
        var sliced_stem = executable.slice(0, length - 4)
        crash sliced_stem
        stem = sliced_stem
    }
    var prompt_path: Path? = "{stem}.reload_prompt"
    crash prompt_path
    var file = File(prompt_path)
    var text = file.read_as_string()
    fallback text
    return text
}

func start_the_frame_calls() {
    fallback not frames_started
    frames_started = true
    var starts = HighIntermediaryRepresentation.Building.FrameStarts(context, program.built_functions)
    starts.start_the_calls()
    program.frame_hold_paths = starts.held_paths
    program.frame_hold_lines = starts.held_lines
    program.frame_hold_texts = starts.held
}

func folder_of(path: String): String {
    var segments = path.replace("\\", "/").split("/")
    crash segments.remove_last()
    return segments.join("/")
}

func fill_the_reflection() {
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var reflection = HighIntermediaryRepresentation.Building.Reflection(context, values)
    context.shape_classes.each(reflection.making.add_the_late_fillers)
    if context.made_anew and reflection.making.described_class_count() != context.made_anew_classes {
        reflection.making.remake_the_making()
    }
    var features = reflection.feature_flags.features()
    if features != context.fill_features {
        context.fill_features = features
        context.filled.each(refill)
        var described = 0
        while described < context.describers.count() {
            reflection.wrappers.redescribe(described)
            described = described + 1
        }
    }
    var index = 0
    while index < context.filled.count() {
        var known = context.filled[index]
        var counted = context.filled_counts[index]
        crash counted
        var now = functions_counted(known)
        if now != counted {
            refill(known)
        }
        index = index + 1
    }
    while not context.unfilled.is_empty() {
        var waiting_fill = context.unfilled.remove_first()
        crash waiting_fill
        fill_one(waiting_fill)
    }
}

func refill(known: String) {
    if not context.unfilled.contains(known) {
        context.unfilled.append(known)
    }
}

func functions_counted(known: String): Integer {
    var parts = known.split(":")
    var described = parts.last()
    crash described
    var base = described
    if base.ends_with("?") {
        var base_length = base.length()
        var sliced_base = base.slice(0, base_length - 1)
        crash sliced_base
        base = sliced_base
    }
    var model = context.program.class_named(base)
    if not model {
        return -1
    }
    if known.starts_with("Spite.Namespace:") {
        return -1
    }
    return model.declared_functions.count()
}

func fill_one(known: String) {
    var reflecting = context.resolver.monomorphiser.class_model_named("Spite.Class")
    crash reflecting
    var filling = Model.FunctionModel("_fill", reflecting.key)
    start(reflecting, filling)
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var reflection = HighIntermediaryRepresentation.Building.Reflection(context, values)
    var made = reflection.fills.fill(known)
    var counted = functions_counted(known)
    var index = 0
    while index < context.filled.count() {
        var filled = context.filled[index]
        if filled == known {
            context.fills[index] = made
            context.filled_counts[index] = counted
            return
        }
        index = index + 1
    }
    context.filled.append(known)
    context.filled_counts.append(counted)
    context.fills.append(made)
}

func need_the_fault_report() {
    var found = context.resolver.state.symbols.find("Spite.Fault", "")
    fallback found
    var fault = context.resolver.monomorphiser.class_model_named("Spite.Fault")
    fallback fault
    var report = fault.function_named("report")
    fallback report
    context.need(report)
}

# ../../spite_documentation/programs.md#run-time-settings-environment
func need_the_settings_check() {
    var environment = context.resolver.monomorphiser.class_model_named("Environment")
    fallback environment
    var program_class = context.resolver.monomorphiser.class_model_named("Program")
    fallback program_class
    fallback program_class.function_named("_arguments")
    var found = context.resolver.state.symbols.find("Spite.Settings", "")
    fallback found
    var settings = context.resolver.monomorphiser.class_model_named("Spite.Settings")
    fallback settings
    context.need_defaults(settings.key)
    var check = settings.function_named("check")
    fallback check
    context.need(check)
    program.settings_check = check
}

func add_a_synthetic(function: HighFunction) {
    program.built_functions.append(function)
}

func follow_the_shape_links() {
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var fitting = HighIntermediaryRepresentation.Building.Fitting(values.context, values)
    var index = 0
    while index < context.shape_links.count() {
        var link = context.shape_links[index]
        var ends = link.split(">")
        var given_name = ends[0]
        var wanted_name = ends[1]
        crash given_name
        crash wanted_name
        var given = Model.Type('shape', given_name)
        var wanted = Model.Type('shape', wanted_name)
        fitting.refill_a_shape(given, wanted)
        index = index + 1
    }
}

func build_the_waiting_functions() {
    while not context.waiting.is_empty() {
        var function = context.waiting.remove_first()
        crash function
        build_a_waiting_function(function)
    }
}

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func build_a_waiting_function(function: Model.FunctionModel) {
    var check = function.key()
    fallback not gathering.has_failed(check)
    gathering.start_a_check(check)
    if waits_for_the_key_maps(function) {
        context.unsettled_key_readers.append(function)
    } else if not function.is_synthetic and function.has_a_body() {
        build_function(function)
    }
    gathering.start_a_check("")
}

# ../../spite_documentation/json.md#how-it-is-written
func waits_for_the_key_maps(function: Model.FunctionModel): Boolean {
    fallback not context.key_maps_settled
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var folded_keys = HighIntermediaryRepresentation.Building.Folded.Keys(context, values)
    return folded_keys.reads_a_key_map(function)
}

func settle_the_key_maps() {
    fallback context.waiting.is_empty() and defaults_built >= context.made_classes.count()
    fallback not context.unsettled_key_readers.is_empty()
    context.key_maps_settled = true
    var index = 0
    while index < context.unsettled_key_readers.count() {
        var reader = context.unsettled_key_readers[index]
        context.waiting.append(reader)
        index = index + 1
    }
    context.unsettled_key_readers = List<Model.FunctionModel>()
}

func build_the_waiting_defaults() {
    while defaults_built < context.made_classes.count() {
        var class_key = context.made_classes[defaults_built]
        var check = "the defaults of {class_key}"
        if not gathering.has_failed(check) {
            gathering.start_a_check(check)
            build_defaults(class_key)
            gathering.start_a_check("")
        }
        defaults_built = defaults_built + 1
    }
}

func build_function(function: Model.FunctionModel) {
    var owner = context.program.class_named(function.owner)
    crash owner
    start(owner, function)
    function.parameters.each(declare_parameter)
    var known_names = function.known_parameter_functions.keys()
    var known_index = 0
    while known_index < known_names.count() {
        var known_name = known_names[known_index]
        var known = function.known_parameter_functions[known_name]
        crash known
        context.function_locals[known_name] = known
        known_index = known_index + 1
    }
    crash function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if function.bound_member_type {
        context.resolver.reading.bind_member(declaration, function.template_index, function.bound_member_type)
    }
    var body = statements.function_body_of(declaration.body)
    context.resolver.reading.unbind_member()
    if function.name == "_read_settings" and owner.key == "Environment" {
        read_the_settings(owner, body)
    }
    var end_line = 0
    if declaration.body {
        end_line = declaration.body.end_line
    }
    var missing_return = Validators.HighIntermediaryRepresentation.MissingReturn.Validator()
    missing_return.check(context, body, end_line)
    finish(function, body)
}

func read_the_settings(owner: Model.ClassModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var calls = HighIntermediaryRepresentation.Building.Calls(values.context, values)
    var reads = List<SpiteCompiler.Statement>()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            var read = setting_read(attribute, values)
            reads.append(read)
        }
        index = index + 1
    }
    var handed = owner.attribute_named("_flags")
    if handed {
        var own = literals.this_value()
        var no_arguments = List<SpiteCompiler.Value>()
        var flags = calls.method_call(own, "_given_flags", no_arguments)
        var handing = HighIntermediaryRepresentation.Statements.Assign.Attribute(own, handed, flags, 0)
        reads.append(handing)
    }
    var statement_index = 0
    while statement_index < body.statements.count() {
        var statement = body.statements[statement_index]
        reads.append(statement)
        statement_index = statement_index + 1
    }
    body.statements = reads
}

func setting_read(
    attribute: Model.AttributeModel,
    values: HighIntermediaryRepresentation.Building.Values,
): SpiteCompiler.Statement {
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var calls = HighIntermediaryRepresentation.Building.Calls(values.context, values)
    if attribute.attribute_type.kind == 'enumeration' {
        return enum_setting_read(attribute, values)
    }
    var reader = "text_setting"
    if attribute.attribute_type.name == "Boolean" {
        reader = "boolean_setting"
    }
    if attribute.attribute_type.name == "Integer" {
        reader = "integer_setting"
    }
    var own = literals.this_value()
    literals.need_text_constants()
    var value_type = context.text()
    var name = HighIntermediaryRepresentation.Values.TextConstant(attribute.name, value_type, false)
    var declared = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(name)
    arguments.append(declared)
    var read = calls.method_call(own, reader, arguments)
    return HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, read, 0)
}

# ../../spite_documentation/programs.md#run-time-settings-environment
func enum_setting_read(
    attribute: Model.AttributeModel,
    values: HighIntermediaryRepresentation.Building.Values,
): SpiteCompiler.Statement {
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var calls = HighIntermediaryRepresentation.Building.Calls(values.context, values)
    var fitting = HighIntermediaryRepresentation.Building.Fitting(values.context, values)
    var own = literals.this_value()
    var declared = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var declared_text = values.enum_text(declared)
    var enumeration = values.enum_model_of(attribute.attribute_type)
    var joined = enumeration.values.join(", ")
    var value_type = context.text()
    var name = HighIntermediaryRepresentation.Values.TextConstant(attribute.name, value_type, false)
    var names_value_type = context.text()
    var names = HighIntermediaryRepresentation.Values.TextConstant(joined, names_value_type, false)
    var arguments = List<SpiteCompiler.Value>()
    arguments.append(name)
    arguments.append(declared_text)
    arguments.append(names)
    var text = calls.method_call(own, "enum_setting", arguments)
    var read = fitting.text_read_into_an_enum(text, attribute.attribute_type)
    return HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, read, 0)
}

func start(owner: Model.ClassModel, function: Model.FunctionModel) {
    context.current_class = owner
    context.current_function = function
    context.resolver.state.building_function_name = function.name
    context.scope.clear()
    context.counted_lists = Dictionary<String, SpiteCompiler.Expression>()
    context.counted_starts = Dictionary<String, Integer>()
    context.window_bases = List<String>()
    context.window_widths = List<String>()
    context.window_lists = List<SpiteCompiler.Expression>()
    context.area_rows = List<String>()
    context.area_strides = List<String>()
    context.area_lists = List<SpiteCompiler.Expression>()
    context.area_counters = List<String>()
    context.proven_locals = List<String>()
    context.index_locals = List<String>()
    context.loop_bases = List<Integer>()
    context.loop_log_starts = List<Integer>()
    context.undone_paths = List<String>()
    context.undone_lines = List<Integer>()
    context.undone_texts = List<String>()
    context.undone_depths = List<Integer>()
    context.loop_reads = List<String>()
    context.logged_calls = List<SpiteCompiler.Value>()
    context.first_loop_site = context.loop_sites.count()
    context.logged_lines = List<Integer>()
    context.logged_writes = Dictionary<Integer, SpiteCompiler.Statement>()
    context.left_starts = List<Integer>()
    context.left_ends = List<Integer>()
    context.other_branch_starts = List<Integer>()
    context.other_branch_ends = List<Integer>()
    context.shared_lists = List<String>()
    context.shared_types = List<Model.Type>()
    context.pending = List<SpiteCompiler.Statement>()
    context.function_locals = Dictionary<String, Model.FunctionModel>()
    context.function_receivers = Dictionary<String, String>()
    context.plain_locals = List<String>()
    context.null_locals = List<String>()
    context.text_locals = Dictionary<String, String>()
    context.known_locals = Dictionary<String, Model.KnownValue>()
    context.known_declarations = Dictionary<String, Model.FunctionModel>()
    context.known_calls = Dictionary<String, Model.FunctionModel>()
    context.known_call_instances = Dictionary<String, String>()
    context.known_call_types = Dictionary<String, Model.Type>()
    context.known_call_arguments = Dictionary<String, String>()
}

func finish(function: Model.FunctionModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var made = HighFunction(function, body)
    made.is_from_the_source = true
    program.built_functions.append(made)
}

func declare_parameter(parameter: Model.ParameterModel) {
    var internal_name = context.scope.declare_written(parameter.name, parameter.parameter_type)
    context.note_a_shared_list(internal_name, parameter.parameter_type)
}

func build_defaults(class_key: String) {
    var owner = context.program.class_named(class_key)
    crash owner
    var function = Model.FunctionModel("_attribute_defaults", class_key)
    if owner.bound_types.count() > 0 {
        var walk = AbstractSyntaxTree.Walk.Walk(owner.file)
        var null_defaults = Validators.AbstractSyntaxTree.NullDefault.Validator()
        null_defaults.check_codegen(walk, owner.file.namespace)
    }
    start(owner, function)
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var folded_keys = HighIntermediaryRepresentation.Building.Folded.Keys(context, values)
    folded_keys.make_every_table(owner)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        var assigned = default_of(attribute)
        var pending_index = 0
        while pending_index < context.pending.count() {
            var pending = context.pending[pending_index]
            body.statements.append(pending)
            pending_index = pending_index + 1
        }
        context.pending = List<SpiteCompiler.Statement>()
        if assigned {
            body.statements.append(assigned)
        }
        index = index + 1
    }
    finish(function, body)
}

# ../../spite_documentation/json.md#how-it-is-written
func nothing_yet(attribute: Model.AttributeModel): SpiteCompiler.Statement {
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var own = literals.this_value()
    var nothing = HighIntermediaryRepresentation.Values.NullConstant(attribute.attribute_type)
    return HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, nothing, 0)
}

# ../../spite_documentation/metaprogramming.md
func is_left_to_the_constructor(attribute: Model.AttributeModel, written: SpiteCompiler.Expression?): Boolean {
    var is_null = false
    if written.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        is_null = written.kind == 'keyword_null'
    }
    fallback is_null
    var attribute_type = attribute.attribute_type
    fallback attribute_type.kind == 'shape' and not attribute_type.is_nullable
    var shape = context.program.shape_keyed(attribute_type.name)
    fallback shape
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if not member.is_an_attribute {
            return true
        }
        index = index + 1
    }
    return false
}

func owner_is_the_build(attribute: Model.AttributeModel): Boolean {
    var given = context.build_value_given(attribute.name)
    if given {
        return attribute.owner == "Build"
    }
    return false
}

func flag_value_of(
    attribute: Model.AttributeModel,
    declared: SpiteCompiler.Value,
    values: HighIntermediaryRepresentation.Building.Values,
): SpiteCompiler.Value {
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var given = context.build_value_given(attribute.name)
    crash given
    var attribute_type = attribute.attribute_type
    if attribute_type.name == "Boolean" {
        var flag = 0
        if given == "true" {
            flag = 1
        }
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag, false)
    }
    if attribute_type.name == "Integer" {
        var number: Long? = given
        crash number
        return HighIntermediaryRepresentation.Values.WholeNumber(attribute_type, number, false)
    }
    if attribute_type.name == "String" {
        literals.need_text_constants()
        return HighIntermediaryRepresentation.Values.TextConstant(given, attribute_type, false)
    }
    return declared
}

func default_of(attribute: Model.AttributeModel): SpiteCompiler.Statement? {
    if attribute.is_a_key_slot {
        return nothing_yet(attribute)
    }
    fallback attribute.declaration
    var line = attribute.declaration.line
    var written = attribute.declaration.value
    if is_left_to_the_constructor(attribute, written) {
        return nothing_yet(attribute)
    }
    context.line = line
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var fitting = HighIntermediaryRepresentation.Building.Fitting(values.context, values)
    var literals = HighIntermediaryRepresentation.Building.Literals(values.context, values)
    var value = fitting.fitted_value_of(written, attribute.attribute_type)
    if owner_is_the_build(attribute) {
        value = flag_value_of(attribute, value, values)
    }
    var own = literals.this_value()
    return HighIntermediaryRepresentation.Statements.Assign.Attribute(own, attribute, value, line)
}

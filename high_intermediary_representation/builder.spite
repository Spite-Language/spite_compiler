var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var statements = HighIntermediaryRepresentation.Building.Statements(context)
var program = HighProgram(no_program)
var defaults_built = 0
var endings = HighIntermediaryRepresentation.Building.Endings()

func Builder(starting_program: Model.ProgramModel, resolver: NameResolution.Resolver) {
    context = HighIntermediaryRepresentation.Building.Context(starting_program, resolver)
    statements = HighIntermediaryRepresentation.Building.Statements(context)
    program = HighProgram(starting_program)
}

func build(): HighProgram {
    var entry_class = context.program.class_named(context.program.entry)
    crash entry_class
    context.need_defaults(entry_class.key)
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var constructor = values.constructor_of(entry_class)
    program.entry = constructor
    if constructor {
        context.need(constructor)
    }
    while not context.waiting.is_empty() or defaults_built < context.made_classes.count() {
        build_the_waiting_functions()
        build_the_waiting_defaults()
    }
    context.synthetic_functions.each(add_a_synthetic)
    return program
}

func add_a_synthetic(function: HighFunction) {
    program.built_functions.append(function)
}

func build_the_waiting_functions() {
    while not context.waiting.is_empty() {
        var function = context.waiting.remove_first()
        crash function
        if not function.is_synthetic and function.has_a_body() {
            build_function(function)
        }
    }
}

func build_the_waiting_defaults() {
    while defaults_built < context.made_classes.count() {
        var class_key = context.made_classes[defaults_built]
        build_defaults(class_key)
        defaults_built = defaults_built + 1
    }
}

func build_function(function: Model.FunctionModel) {
    var owner = context.program.class_named(function.owner)
    crash owner
    start(owner, function)
    function.parameters.each(declare_parameter)
    crash function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if function.bound_member_type {
        context.resolver.bind_member(declaration, function.template_index, function.bound_member_type)
    }
    var body = statements.block_of(declaration.body)
    context.resolver.unbind_member()
    if function.is_constructor and owner.key == "Environment" {
        read_the_settings(owner, body)
    }
    endings.check(context, body)
    finish(function, body)
}

func read_the_settings(owner: Model.ClassModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var reads = List<HighIntermediaryRepresentation.Statements.Statement>()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        if not attribute.name.starts_with("_") {
            var read = setting_read(attribute, values)
            reads.append(read)
        }
        index = index + 1
    }
    var statement_index = 0
    while statement_index < body.statements.count() {
        var statement = body.statements[statement_index]
        reads.append(statement)
        statement_index = statement_index + 1
    }
    body.statements = reads
}

func setting_read(
    attribute: Model.AttributeModel,
    values: HighIntermediaryRepresentation.Building.Values,
): HighIntermediaryRepresentation.Statements.Statement {
    var reader = "text_setting"
    if attribute.attribute_type.name == "Boolean" {
        reader = "boolean_setting"
    }
    if attribute.attribute_type.name == "Integer" {
        reader = "integer_setting"
    }
    var own = values.this_value()
    values.need_text_constants()
    var name = HighIntermediaryRepresentation.Values.TextConstant(attribute.name)
    name.value_type = context.text()
    var declared = HighIntermediaryRepresentation.Values.AttributeRead(own, attribute)
    var arguments = List<HighIntermediaryRepresentation.Values.Value>()
    arguments.append(name)
    arguments.append(declared)
    var read = values.method_call(own, reader, arguments)
    return HighIntermediaryRepresentation.Statements.AssignAttribute(own, attribute, read)
}

func start(owner: Model.ClassModel, function: Model.FunctionModel) {
    context.current_class = owner
    context.current_function = function
    context.scope.clear()
    context.counted_lists = Dictionary<String, AbstractSyntaxTree.Shapes.Expressions.Expression>()
    context.proven_locals = List<String>()
    context.pending = List<HighIntermediaryRepresentation.Statements.Statement>()
}

func finish(function: Model.FunctionModel, body: HighIntermediaryRepresentation.Statements.Block) {
    var made = HighFunction(function, body)
    program.built_functions.append(made)
}

func declare_parameter(parameter: Model.ParameterModel) {
    context.scope.declare(parameter.name, parameter.parameter_type)
}

func build_defaults(class_key: String) {
    var owner = context.program.class_named(class_key)
    crash owner
    var function = Model.FunctionModel("_attribute_defaults", class_key)
    start(owner, function)
    var body = HighIntermediaryRepresentation.Statements.Block()
    var index = 0
    while index < owner.declared_attributes.count() {
        var attribute = owner.declared_attributes[index]
        var assigned = default_of(attribute)
        var pending_index = 0
        while pending_index < context.pending.count() {
            var pending = context.pending[pending_index]
            body.statements.append(pending)
            pending_index = pending_index + 1
        }
        context.pending = List<HighIntermediaryRepresentation.Statements.Statement>()
        if assigned {
            body.statements.append(assigned)
        }
        index = index + 1
    }
    finish(function, body)
}

func owner_is_the_build(attribute: Model.AttributeModel): Boolean {
    return attribute.owner == "Build" and context.build_flags.has(attribute.name)
}

func flag_value_of(
    attribute: Model.AttributeModel,
    declared: HighIntermediaryRepresentation.Values.Value,
    values: HighIntermediaryRepresentation.Building.Values,
): HighIntermediaryRepresentation.Values.Value {
    var given = context.build_flags[attribute.name]
    crash given
    var attribute_type = attribute.attribute_type
    if attribute_type.name == "Boolean" {
        var flag = 0
        if given == "true" {
            flag = 1
        }
        var boolean = context.boolean()
        return HighIntermediaryRepresentation.Values.WholeNumber(boolean, flag)
    }
    if attribute_type.name == "Integer" {
        var number = given.to_long()
        crash number
        return HighIntermediaryRepresentation.Values.WholeNumber(attribute_type, number)
    }
    if attribute_type.name == "String" {
        values.need_text_constants()
        var text = HighIntermediaryRepresentation.Values.TextConstant(given)
        text.value_type = attribute_type
        return text
    }
    return declared
}

func default_of(attribute: Model.AttributeModel): HighIntermediaryRepresentation.Statements.Statement? {
    assert attribute.declaration
    var line = attribute.declaration.line
    var written = attribute.declaration.value
    context.line = line
    var values = HighIntermediaryRepresentation.Building.Values(context)
    var value = values.fitted_value_of(written, attribute.attribute_type)
    if owner_is_the_build(attribute) {
        value = flag_value_of(attribute, value, values)
    }
    var own = values.this_value()
    var made = HighIntermediaryRepresentation.Statements.AssignAttribute(own, attribute, value)
    made.line = line
    return made
}

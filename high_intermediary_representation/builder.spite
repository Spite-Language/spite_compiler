var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var substitution = NameResolution.Substitution()
var type_builder = NameResolution.Types()
var class_name = NameResolution.ClassName()
var answers = NameResolution.Answers()
var built_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
var built_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
var built_values = List<HighIntermediaryRepresentation.Values.Value>()
var skipped = 0
var built_names = List<String>()
var built_types = List<String>()
var current_class = ""
var classes_of_names = Dictionary<String, String>()
var classes_of_attributes = Dictionary<String, String>()
var built_attributes = List<HighIntermediaryRepresentation.Classes.HighAttribute>()
var built_size = 0
var sizes = HighIntermediaryRepresentation.Sizes()
var builder_memory = HighIntermediaryRepresentation.Memory()
var room_name = ""

func Builder(
    starting_file: AbstractSyntaxTree.Shapes.SourceFile,
    starting_substitution: NameResolution.Substitution,
    starting_answers: NameResolution.Answers,
) {
    file = starting_file
    substitution = starting_substitution
    answers = starting_answers
}

func build(name: String): HighIntermediaryRepresentation.Classes.HighClass {
    current_class = name
    classes_of_attributes = Dictionary<String, String>()
    built_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
    built_attributes = List<HighIntermediaryRepresentation.Classes.HighAttribute>()
    room_name = ""
    built_size = the_room_of_the_class()
    file.declarations.each(read_declaration)
    var block_size = sizes.block_size_of(built_size)
    var room = the_room_of_the_class()
    return HighIntermediaryRepresentation.Classes.HighClass(name, built_functions, built_attributes, block_size, room)
}

func the_room_of_the_class(): Integer {
    var room = answers.size_of(current_class)
    if room > 0 {
        return room
    } else {
        return 0
    }
}

func read_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        read_function(declaration)
        return
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        read_attribute(declaration)
        return
    }
    return
}

func read_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var class = class_of_an_attribute(declaration)
    note_the_class_of_the_attribute(declaration.name, class)
    lay_out_the_attribute(declaration, class)
}

func lay_out_the_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration, class: String) {
    if class == "Buffer" {
        note_the_room(declaration)
        return
    }
    var size = size_of_a_type(class)
    var alignment = alignment_of_a_type(class)
    var offset = aligned_offset(built_size, alignment)
    var default_value = lower_value(declaration.value)
    var attribute = HighIntermediaryRepresentation.Classes.HighAttribute(declaration.name, size, offset, default_value)
    built_attributes.append(attribute)
    built_size = offset + size
}

func note_the_room(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    if room_name.is_empty() {
        room_name = declaration.name
    }
}

func size_of_a_type(type_name: String): Integer {
    var room = answers.size_of(type_name)
    if room > 0 {
        return room
    } else {
        return sizes.size_of(type_name)
    }
}

func alignment_of_a_type(type_name: String): Integer {
    var size = size_of_a_type(type_name)
    if size == 1 {
        return 1
    } else {
        return 4
    }
}

func aligned_offset(offset: Integer, alignment: Integer): Integer {
    var remainder = offset % alignment
    if remainder > 0 {
        return offset + alignment - remainder
    } else {
        return offset
    }
}

func class_of_an_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration): String {
    if declaration.declared_type {
        return class_of_a_type(declaration.declared_type)
    } else {
        return class_of_an_expression(declaration.value)
    }
}

func note_the_class_of_the_attribute(name: String, class: String) {
    if class.is_empty() {
        return
    } else {
        classes_of_attributes[name] = class
    }
}

func read_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if declaration.body {
        read_a_function(declaration, declaration.body)
    } else {
        read_a_primitive(declaration)
    }
}

func read_a_primitive(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if builder_memory.is_a_primitive(current_class, declaration.name) {
        read_a_memory_primitive(declaration)
    } else {
        return
    }
}

func read_a_memory_primitive(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if builder_memory.reads_a_byte(current_class, declaration.name) {
        write_the_read_of_a_byte(declaration)
    } else {
        write_the_write_of_a_byte(declaration)
    }
}

func write_the_read_of_a_byte(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var parameters = declaration.parameters
    assert parameters.count() != 0
    var names = List<String>()
    var types = List<String>()
    names.append("this")
    types.append(current_class)
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        names.append(parameter.name)
        var written = written_type_of(parameter)
        types.append(written)
        index = index + 1
    }
    var object = HighIntermediaryRepresentation.Values.Name("this")
    var at = HighIntermediaryRepresentation.Values.Name(parameters[0].name)
    var read = HighIntermediaryRepresentation.Values.BufferRead(object, at)
    var returned = HighIntermediaryRepresentation.Statements.Return(read)
    var statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    statements.append(returned)
    var block = HighIntermediaryRepresentation.Statements.Block(statements)
    var result = written_result_of(declaration)
    var function = HighIntermediaryRepresentation.Functions.HighFunction(declaration.name, names, types, result, block)
    built_functions.append(function)
}

func write_the_write_of_a_byte(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var parameters = declaration.parameters
    assert parameters.count() >= 2
    var names = List<String>()
    var types = List<String>()
    names.append("this")
    types.append(current_class)
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        names.append(parameter.name)
        var written = written_type_of(parameter)
        types.append(written)
        index = index + 1
    }
    var object = HighIntermediaryRepresentation.Values.Name("this")
    var at = HighIntermediaryRepresentation.Values.Name(parameters[0].name)
    var value = HighIntermediaryRepresentation.Values.Name(parameters[1].name)
    var write = HighIntermediaryRepresentation.Statements.BufferWrite(object, at, value)
    var statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    statements.append(write)
    var block = HighIntermediaryRepresentation.Statements.Block(statements)
    var function = HighIntermediaryRepresentation.Functions.HighFunction(declaration.name, names, types, "", block)
    built_functions.append(function)
}

func written_type_of(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter): String {
    if parameter.declared_type {
        return type_builder.written_of(parameter.declared_type, substitution)
    } else {
        return ""
    }
}

func written_result_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): String {
    if declaration.result {
        return type_builder.written_of(declaration.result, substitution)
    } else {
        return ""
    }
}

func read_a_function(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    body: AbstractSyntaxTree.Shapes.Statements.Block,
) {
    classes_of_names = Dictionary<String, String>()
    built_names = List<String>()
    built_types = List<String>()
    built_names.append("this")
    built_types.append(current_class)
    note_the_class_of("this", current_class)
    declaration.parameters.each(read_parameter)
    declaration.parameters.each(read_parameter_type)
    var names = built_names
    var types = built_types
    built_names = List<String>()
    built_types = List<String>()
    declaration.parameters.each(read_parameter_class)
    var block = lower_block(body)
    var result = ""
    if declaration.result {
        result = type_builder.written_of(declaration.result, substitution)
    }
    var function = HighIntermediaryRepresentation.Functions.HighFunction(declaration.name, names, types, result, block)
    built_functions.append(function)
}

func read_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    built_names.append(parameter.name)
}

func read_parameter_type(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    var written = ""
    if parameter.declared_type {
        written = type_builder.written_of(parameter.declared_type, substitution)
    }
    built_types.append(written)
}

func read_parameter_class(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    if parameter.declared_type {
        var class = class_of_a_type(parameter.declared_type)
        note_the_class_of(parameter.name, class)
    } else {
        return
    }
}

func lower_block(block: AbstractSyntaxTree.Shapes.Statements.Block): HighIntermediaryRepresentation.Statements.Block {
    var outer = built_statements
    built_statements = List<HighIntermediaryRepresentation.Statements.Statement>()
    block.statements.each(lower_statement)
    var built = HighIntermediaryRepresentation.Statements.Block(built_statements)
    built_statements = outer
    return built
}

func lower_statement(statement: AbstractSyntaxTree.Shapes.Statements.Statement) {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        lower_variable(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        lower_assignment(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        lower_while(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        lower_if(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        lower_return(statement)
        return
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ExpressionStatement {
        lower_held(statement)
        return
    }
    skipped = skipped + 1
}

func lower_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var value = lower_value(statement.value)
    if value {
        var declared = HighIntermediaryRepresentation.Statements.Declare(statement.name, value)
        built_statements.append(declared)
    } else {
        skipped = skipped + 1
    }
    var class = class_of_a_local(statement)
    note_the_class_of(statement.name, class)
}

func class_of_a_local(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement): String {
    if statement.declared_type {
        return class_of_a_type(statement.declared_type)
    } else {
        return class_of_an_expression(statement.value)
    }
}

func note_the_class_of(name: String, class: String) {
    if class.is_empty() {
        return
    } else {
        classes_of_names[name] = class
    }
}

func class_of_a_type(shape: AbstractSyntaxTree.Shapes.Types.Type): String {
    return class_name.of(shape, substitution)
}

func class_of_an_expression(expression: AbstractSyntaxTree.Shapes.Expressions.Expression?): String {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = expression
        return class_of_a_name(name.name)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        var literal = expression
        return class_of_a_literal(literal)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var call = expression
        return class_of_a_call(call)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = expression
        return class_of_an_attribute_name(member.name)
    }
    return ""
}

func class_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'keyword_true' or literal.kind == 'keyword_false' {
        return "Boolean"
    }
    switch literal.kind {
        'integer_literal': return "Integer"
        'decimal_literal': return "Float"
        'text_literal': return "String"
        _: return ""
    }
}

func class_of_a_name(name: String): String {
    var known = classes_of_names[name]
    if known {
        return known
    } else {
        return class_of_an_attribute_name(name)
    }
}

func class_of_an_attribute_name(name: String): String {
    var known = classes_of_attributes[name]
    if known {
        return known
    } else {
        return ""
    }
}

func class_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = callee
        return class_of_a_callee_name(name)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return class_of_a_callee_member(member)
    }
    return ""
}

func class_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if member.target {
        return class_of_an_expression(member.target)
    } else {
        return ""
    }
}

func class_of_a_callee_name(name: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if name.is_a_class_name {
        return name.name
    } else {
        return class_of_the_answer(current_class, name.name)
    }
}

func class_of_a_callee_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if member.is_a_class_name {
        return member.name
    } else {
        return class_of_the_answer_of_the_receiver(member)
    }
}

func class_of_the_answer_of_the_receiver(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var owner = owner_of_the_receiver(member)
    return class_of_the_answer(owner, member.name)
}

func class_of_the_answer(owner: String, name: String): String {
    return answers.answer_of(owner, name)
}

func lower_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = statement.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        assign_to_name(target, statement.value)
    } else if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        assign_to_an_attribute(target, statement.value)
    } else {
        skipped = skipped + 1
    }
}

func assign_to_name(
    target: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    value_expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var name = target
    if is_an_attribute_of_the_class(name.name) {
        assign_to_the_attribute_of_the_class(name.name, value_expression)
        return
    }
    assign_to_a_local(name.name, value_expression)
}

func assign_to_a_local(name: String, value_expression: AbstractSyntaxTree.Shapes.Expressions.Expression?) {
    var value = lower_value(value_expression)
    if value {
        var assigned = HighIntermediaryRepresentation.Statements.Assign(name, value)
        built_statements.append(assigned)
    } else {
        skipped = skipped + 1
    }
}

func assign_to_the_attribute_of_the_class(
    name: String,
    value_expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var value = lower_value(value_expression)
    if value {
        var object = HighIntermediaryRepresentation.Values.Name("this")
        var assigned = HighIntermediaryRepresentation.Statements.AssignAttribute(object, current_class, name, value)
        built_statements.append(assigned)
    } else {
        skipped = skipped + 1
    }
}

func assign_to_an_attribute(
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    value_expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
) {
    var member = target
    var object = lower_value(member.target)
    var value = lower_value(value_expression)
    if object and value {
        var class = class_of_an_expression(member.target)
        var assigned = HighIntermediaryRepresentation.Statements.AssignAttribute(object, class, member.name, value)
        built_statements.append(assigned)
    } else {
        skipped = skipped + 1
    }
}

func is_an_attribute_of_the_class(name: String): Boolean {
    return classes_of_attributes.has(name)
}

func lower_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var condition = lower_value(statement.condition)
    if condition {
        lower_loop_body(condition, statement)
    } else {
        skipped = skipped + 1
    }
}

func lower_loop_body(
    condition: HighIntermediaryRepresentation.Values.Value,
    statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement,
) {
    if statement.body {
        var block = lower_block(statement.body)
        var loop = HighIntermediaryRepresentation.Statements.While(condition, block)
        built_statements.append(loop)
    } else {
        skipped = skipped + 1
    }
}

func lower_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var condition = lower_value(statement.condition)
    if condition {
        lower_the_branches(statement, condition)
    } else {
        skipped = skipped + 1
    }
}

func lower_the_branches(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
    condition: HighIntermediaryRepresentation.Values.Value,
) {
    assert statement.then_branch
    var then_block = lower_block(statement.then_branch)
    var else_block = lower_the_else_branch(statement)
    var branch = HighIntermediaryRepresentation.Statements.If(condition, then_block, else_block)
    built_statements.append(branch)
}

func lower_the_else_branch(
    statement: AbstractSyntaxTree.Shapes.Statements.IfStatement,
): HighIntermediaryRepresentation.Statements.Block? {
    if statement.else_branch {
        var else_branch = statement.else_branch
        return lower_block(else_branch)
    } else {
        return null
    }
}

func lower_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var value = lower_value(statement.value)
    var returned = HighIntermediaryRepresentation.Statements.Return(value)
    built_statements.append(returned)
}

func lower_held(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    var value = statement.value
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var call = value
        if is_a_foreign_call(call) {
            lower_a_held_foreign_call(call)
            return
        }
        var arguments = lower_the_arguments(call)
        var name = call_name(call)
        var owner = call_owner(call)
        var made = HighIntermediaryRepresentation.Statements.Call(name, owner, arguments)
        built_statements.append(made)
    } else {
        skipped = skipped + 1
    }
}

func lower_a_held_foreign_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    var foreign = lower_a_foreign_call(call)
    if foreign {
        var made = HighIntermediaryRepresentation.Statements.ForeignCall(foreign)
        built_statements.append(made)
    } else {
        skipped = skipped + 1
    }
}

func call_name(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var name = callee
        return name.name
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return member.name
    }
    return ""
}

func call_owner(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var identifier = callee
        return owner_of_an_identifier(identifier)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return owner_of_a_member(member)
    }
    return ""
}

func owner_of_an_identifier(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if identifier.is_a_class_name {
        return identifier.name
    } else {
        return current_class
    }
}

func owner_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    if member.is_a_class_name {
        return member.name
    } else {
        return owner_of_the_receiver(member)
    }
}

func owner_of_the_receiver(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var receiver = target
        return owner_of_a_receiver(receiver)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        var call = target
        return class_of_a_call(call)
    } else {
        return ""
    }
}

func owner_of_a_receiver(receiver: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    if receiver.is_a_class_name {
        return receiver.name
    } else {
        return class_of_a_name(receiver.name)
    }
}

func lower_the_arguments(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<HighIntermediaryRepresentation.Values.Value> {
    var outer = built_values
    built_values = List<HighIntermediaryRepresentation.Values.Value>()
    var receiver = the_receiver_of(call)
    if receiver {
        built_values.append(receiver)
    }
    call.arguments.each(lower_argument)
    var built = built_values
    built_values = outer
    return built
}

func lower_the_written_arguments(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): List<HighIntermediaryRepresentation.Values.Value> {
    var outer = built_values
    built_values = List<HighIntermediaryRepresentation.Values.Value>()
    call.arguments.each(lower_argument)
    var built = built_values
    built_values = outer
    return built
}

func the_receiver_of(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var identifier = callee
        return the_receiver_of_an_identifier(identifier)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return the_receiver_of_a_member(member)
    }
    return null
}

func the_receiver_of_an_identifier(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value? {
    if not identifier.is_a_class_name {
        return HighIntermediaryRepresentation.Values.Name("this")
    } else {
        return null
    }
}

func the_receiver_of_a_member(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var target = member.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var identifier = target
        if not identifier.is_a_class_name {
            return the_receiver_of_a_name(identifier)
        } else {
            return null
        }
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return the_receiver_of_an_attribute(member)
    }
    return null
}

func the_receiver_of_a_name(
    identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value? {
    if identifier.name == room_name {
        return HighIntermediaryRepresentation.Values.Name("this")
    }
    var class = class_of_a_name(identifier.name)
    if is_a_value_class(class) {
        return the_address_of_a_name(identifier.name)
    }
    return lower_value(identifier)
}

func the_address_of_a_name(name: String): HighIntermediaryRepresentation.Values.Value {
    if is_an_attribute_of_the_class(name) {
        var object = HighIntermediaryRepresentation.Values.Name("this")
        var attribute = HighIntermediaryRepresentation.Values.Attribute(object, current_class, name)
        return HighIntermediaryRepresentation.Values.StorageAddress(attribute)
    }
    var value = HighIntermediaryRepresentation.Values.Name(name)
    return HighIntermediaryRepresentation.Values.StorageAddress(value)
}

func the_receiver_of_an_attribute(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var object = lower_value(member.target)
    if object {
        return the_address_or_the_value_of_an_attribute(member, object)
    } else {
        return null
    }
}

func the_address_or_the_value_of_an_attribute(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    object: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value {
    var class = class_of_a_member(member)
    var attribute = HighIntermediaryRepresentation.Values.Attribute(object, class, member.name)
    if is_a_value_class(class) {
        return HighIntermediaryRepresentation.Values.StorageAddress(attribute)
    } else {
        return attribute
    }
}

func is_a_value_class(class: String): Boolean {
    return answers.size_of(class) > 0
}

func lower_argument(argument: AbstractSyntaxTree.Shapes.Expressions.Expression) {
    var value = lower_value(argument)
    if value {
        built_values.append(value)
    } else {
        skipped = skipped + 1
    }
}

func lower_value(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression?,
): HighIntermediaryRepresentation.Values.Value? {
    if expression {
        return lower_a_value(expression)
    } else {
        return null
    }
}

func lower_a_value(
    expression: AbstractSyntaxTree.Shapes.Expressions.Expression,
): HighIntermediaryRepresentation.Values.Value? {
    if expression == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return lower_literal(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return lower_identifier(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        return lower_binary(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return lower_call(expression)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return lower_member(expression)
    }
    return null
}

func lower_literal(
    expression: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression,
): HighIntermediaryRepresentation.Values.Value? {
    switch expression.kind {
        'integer_literal': return HighIntermediaryRepresentation.Values.WholeNumber(expression.text)
        'keyword_true': return HighIntermediaryRepresentation.Values.WholeNumber("1")
        'keyword_false': return HighIntermediaryRepresentation.Values.WholeNumber("0")
        _: return null
    }
}

func lower_identifier(
    expression: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
): HighIntermediaryRepresentation.Values.Value? {
    if is_an_attribute_of_the_class(expression.name) {
        var object = HighIntermediaryRepresentation.Values.Name("this")
        return HighIntermediaryRepresentation.Values.Attribute(object, current_class, expression.name)
    } else {
        return HighIntermediaryRepresentation.Values.Name(expression.name)
    }
}

func lower_member(
    expression: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    if is_an_attribute_of_the_class(expression.name) {
        return lower_an_attribute_of_an_object(expression)
    } else {
        return null
    }
}

func lower_an_attribute_of_an_object(
    expression: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var object = lower_value(expression.target)
    if object {
        var class = class_of_a_member(expression)
        return HighIntermediaryRepresentation.Values.Attribute(object, class, expression.name)
    } else {
        return null
    }
}

func lower_binary(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var operator = symbol_of(expression.operator)
    if operator != "" {
        return lower_arithmetic(expression, operator)
    } else {
        return null
    }
}

func lower_arithmetic(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: String,
): HighIntermediaryRepresentation.Values.Value? {
    var left = lower_value(expression.left)
    if left {
        return lower_arithmetic_right(expression, operator, left)
    } else {
        return null
    }
}

func lower_arithmetic_right(
    expression: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
    operator: String,
    left: HighIntermediaryRepresentation.Values.Value,
): HighIntermediaryRepresentation.Values.Value? {
    var right = lower_value(expression.right)
    if right {
        return HighIntermediaryRepresentation.Values.Operation(left, operator, right)
    } else {
        return null
    }
}

func symbol_of(kind: AbstractSyntaxTree.Tokens.TokenKind): String {
    switch kind {
        'plus': return "+"
        'minus': return "-"
        'star': return "*"
        'slash': return "/"
        'percent': return "%"
        'equal_equal': return "=="
        'not_equal': return "!="
        'less': return "<"
        'greater': return ">"
        'less_or_equal': return "<="
        'greater_or_equal': return ">="
        _: return ""
    }
}

func lower_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var name = call_name(expression)
    if name != "" {
        return lower_the_call(expression, name)
    } else {
        return null
    }
}

func lower_the_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
): HighIntermediaryRepresentation.Values.Value? {
    if is_a_foreign_call(expression) {
        return lower_a_foreign_call(expression)
    }
    var arguments = lower_the_arguments(expression)
    var owner = call_owner(expression)
    return HighIntermediaryRepresentation.Values.Answer(name, owner, arguments)
}

func is_a_foreign_call(expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression): Boolean {
    var callee = expression.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return class_of_a_member(member) == "DynamicLibrary"
    }
    return false
}

func lower_a_foreign_call(
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var callee = expression.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var member = callee
        return lower_the_foreign_call_of(member, expression)
    } else {
        return null
    }
}

func lower_the_foreign_call_of(
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    expression: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
): HighIntermediaryRepresentation.Values.Value? {
    var receiver = lower_value(member.target)
    if receiver {
        var handle = HighIntermediaryRepresentation.Values.Attribute(receiver, "DynamicLibrary", "handle")
        var arguments = lower_the_written_arguments(expression)
        return HighIntermediaryRepresentation.Values.ForeignCall(member.name, handle, arguments)
    } else {
        return null
    }
}

func skipped_count(): Integer {
    return skipped
}

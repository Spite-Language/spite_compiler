# ../PROOFS.md#a-value-proven-present-is-a-t
var present_locals = Dictionary<String, Boolean>()
var present_attributes = Dictionary<String, Boolean>()
var present_answers = Dictionary<String, Boolean>()
var is_proven = false

func local_key(function: Model.FunctionModel, name: String): String {
    var function_key = function.key()
    return "{function_key}|{name}"
}

func attribute_key(attribute: Model.AttributeModel): String {
    return "{attribute.owner}.{attribute.name}"
}

func is_present(value: HighIntermediaryRepresentation.Values.Value, function: Model.FunctionModel): Boolean {
    if not value.value_type.is_nullable {
        return true
    }
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        var local = local_key(function, value.name)
        return present_locals.contains(local)
    }
    if value == HighIntermediaryRepresentation.Values.AttributeRead {
        var attribute = attribute_key(value.attribute)
        return present_attributes.contains(attribute)
    }
    if value == HighIntermediaryRepresentation.Values.Call {
        var answer = value.function.key()
        return present_answers.contains(answer)
    }
    if value == HighIntermediaryRepresentation.Values.Conversion {
        return is_a_present_conversion(value, function)
    }
    return false
}

func is_a_present_conversion(
    conversion: HighIntermediaryRepresentation.Values.Conversion,
    function: Model.FunctionModel,
): Boolean {
    var keeps_presence = conversion.kind == 'nullable' or conversion.kind == 'widen'
    if not keeps_presence or not conversion.converted {
        return false
    }
    return is_present(conversion.converted, function)
}

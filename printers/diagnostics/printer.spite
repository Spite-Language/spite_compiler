var report = Diagnostics.Report()
var lines = List<String>()
var standard = Mapping.StandardLibrary()

func Printer(starting_report: Diagnostics.Report) {
    report = starting_report
}

func text(): String {
    lines = List<String>()
    report.problems.each(print_problem)
    return lines.join("\n")
}

func print_problem(problem: Diagnostics.Problem) {
    if problem.is_a_count {
        lines.append(problem.text)
        return
    }
    if problem.is_note {
        lines.append("note: {problem.text}")
        return
    }
    var where = place_of(problem)
    var inside = inside_of(problem)
    if problem.is_fix {
        lines.append("{where}fixed: {problem.text}{inside}")
        return
    }
    lines.append("{where}error: {problem.text}{inside}")
}

# ../../../spite_documentation/compiler.md#a-library-file-is-named-the-same-on-every-machine
func place_of(problem: Diagnostics.Problem): String {
    fallback not problem.file_path.is_empty()
    var path = standard.shown(problem.file_path)
    if problem.line <= 0 {
        return "{path}: "
    }
    return "{path}:{problem.line}: "
}

func inside_of(problem: Diagnostics.Problem): String {
    fallback not problem.class_name.is_empty()
    if problem.is_among_the_attributes {
        return " (in {problem.class_name}.)"
    }
    if problem.function_name.is_empty() {
        return " (in {problem.class_name})"
    }
    return " (in {problem.class_name}.{problem.function_name})"
}

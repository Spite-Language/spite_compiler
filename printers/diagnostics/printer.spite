var report = Diagnostics.Report()
var lines = List<String>()

func Printer(starting_report: Diagnostics.Report) {
    report = starting_report
}

func text(): String {
    lines = List<String>()
    report.problems.each(print_problem)
    report.notes.each(print_note)
    return lines.join("\n")
}

func print_problem(problem: Diagnostics.Problem) {
    var where = place_of(problem)
    if where.is_empty() {
        lines.append("error: {problem.text}")
    } else {
        lines.append("{where}: error: {problem.text}")
    }
}

func print_note(note: String) {
    lines.append("note: {note}")
}

func place_of(problem: Diagnostics.Problem): String {
    if problem.file_path.is_empty() {
        return ""
    }
    if problem.line <= 0 {
        return problem.file_path
    }
    if problem.column <= 0 {
        return "{problem.file_path}:{problem.line}"
    }
    return "{problem.file_path}:{problem.line}:{problem.column}"
}

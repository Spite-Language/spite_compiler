var report = Diagnostics.Report()
var lines = List<String>()

func Printer(starting_report: Diagnostics.Report) {
    report = starting_report
}

func text(): String {
    lines = List<String>()
    report.problems.each(print_problem)
    return lines.join("\n")
}

func print_problem(problem: Diagnostics.Problem) {
    if problem.is_note {
        lines.append("note: {problem.text}")
        return
    }
    var where = place_of(problem)
    var inside = inside_of(problem)
    lines.append("{where}error: {problem.text}{inside}")
}

func place_of(problem: Diagnostics.Problem): String {
    if problem.file_path.is_empty() {
        return ""
    }
    if problem.line <= 0 {
        return "{problem.file_path}: "
    }
    return "{problem.file_path}:{problem.line}: "
}

func inside_of(problem: Diagnostics.Problem): String {
    if problem.class_name.is_empty() {
        return ""
    }
    if problem.function_name.is_empty() {
        return " (in {problem.class_name})"
    }
    return " (in {problem.class_name}.{problem.function_name})"
}

var title = ""
var paths = List<String>()
var lines = List<Integer>()
var texts = List<String>()

func Section(starting_title: String) {
    title = starting_title
}

func count(): Integer {
    return texts.count()
}

func add(path: String, line: Integer, text: String) {
    assert not holds(path, line, text)
    var place = 0
    while place < texts.count() and comes_before(place, path, line) {
        place = place + 1
    }
    paths.insert(place, path)
    lines.insert(place, line)
    texts.insert(place, text)
}

func holds(path: String, line: Integer, text: String): Boolean {
    var index = 0
    while index < texts.count() {
        var held_path = paths[index]
        var held_line = lines[index]
        var held_text = texts[index]
        if held_path == path and held_line == line and held_text == text {
            return true
        }
        index = index + 1
    }
    return false
}

func comes_before(place: Integer, path: String, line: Integer): Boolean {
    var held_path = paths[place]
    var held_line = lines[place]
    crash held_path
    crash held_line
    if held_path == path {
        return held_line <= line
    }
    return held_path < path
}

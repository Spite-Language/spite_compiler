# ../../HOT_RELOAD.md#the-manifest
var host = Model.ReloadHost()
var lines = List<String>()

func Printer(starting_host: Model.ReloadHost) {
    host = starting_host
}

func text(): String {
    lines = List<String>()
    lines.append("# spite reload host 1")
    lines.append("generation\t{host.generation}")
    lines.append("text\t{host.text_base}")
    lines.append("routines\t{host.routines}")
    host.function_keys.each(add_a_function)
    host.state_names.each(add_a_state)
    var import_names = host.imports.keys()
    import_names.each(add_an_import)
    var library_names = host.library_imports.keys()
    library_names.each(add_a_library_import)
    host.class_keys.each(add_a_class)
    host.enum_keys.each(add_an_enum)
    host.file_paths.each(add_a_file)
    lines.append("")
    return lines.join("\n")
}

func add_a_function(key: String) {
    var stub = host.stubs[key]
    var slot = host.slots[key]
    var digest = host.digests[key]
    var owner = host.owners[key]
    crash stub
    crash slot
    crash digest
    crash owner
    lines.append("function\t{key}\t{stub}\t{slot}\t{digest}\t{owner}")
}

func add_a_state(name: String) {
    var address = host.states[name]
    crash address
    lines.append("state\t{name}\t{address}")
}

func add_an_import(name: String) {
    var address = host.imports[name]
    crash address
    lines.append("import\t{name}\t{address}")
}

func add_a_library_import(name: String) {
    var address = host.library_imports[name]
    crash address
    lines.append("library\t{name}\t{address}")
}

func add_a_class(key: String) {
    var id = host.class_ids[key]
    var layout = host.layouts[key]
    crash id
    crash layout
    lines.append("class\t{key}\t{id}\t{layout}")
}

func add_an_enum(key: String) {
    var values = host.enums[key]
    crash values
    lines.append("enum\t{key}\t{values}")
}

func add_a_file(path: String) {
    var digest = host.file_digests[path]
    crash digest
    lines.append("file\t{path}\t{digest}")
}

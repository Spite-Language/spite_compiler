var no_functions = List<HighIntermediaryRepresentation.Functions.HighFunction>()
var no_attributes = List<HighIntermediaryRepresentation.Classes.HighAttribute>()
var printed = HighIntermediaryRepresentation.Classes.HighClass("", no_functions, no_attributes, 0, 0)
var lines = List<String>()
var indent = ""
var written_values = List<String>()

func Printer(starting_class: HighIntermediaryRepresentation.Classes.HighClass) {
    printed = starting_class
}

func text(): String {
    lines = List<String>()
    indent = ""
    lines.append("class {printed.name}: a block of {printed.block_size} bytes, {printed.room_size} of them its room")
    indent = "    "
    printed.held_attributes.each(print_attribute)
    printed.held_functions.each(print_function)
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_attribute(attribute: HighIntermediaryRepresentation.Classes.HighAttribute) {
    var start = "attribute {attribute.name}: {attribute.size} bytes at {attribute.offset}"
    if attribute.default_value {
        var made_with = value_text(attribute.default_value)
        add("{start}, made with {made_with}")
    } else {
        add(start)
    }
}

func print_function(function: HighIntermediaryRepresentation.Functions.HighFunction) {
    var parameters = parameters_text(function)
    var answers = answers_text(function)
    if function.body {
        add("function {function.name}({parameters}){answers}")
        print_block(function.body)
    } else {
        add("function {function.name}({parameters}){answers}, written by the compiler")
    }
}

func parameters_text(function: HighIntermediaryRepresentation.Functions.HighFunction): String {
    var written = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter_type = function.parameter_types[index]
        crash parameter_type
        written.append("{function.parameters[index]}: {parameter_type}")
        index = index + 1
    }
    return written.join(", ")
}

func answers_text(function: HighIntermediaryRepresentation.Functions.HighFunction): String {
    if function.result_type.is_empty() {
        return ""
    }
    return ": {function.result_type}"
}

func print_block(block: HighIntermediaryRepresentation.Statements.Block) {
    var outer = indent
    indent = "{indent}    "
    block.statements.each(print_statement)
    indent = outer
}

func print_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: print_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: print_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: print_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.If: print_if(statement)
        HighIntermediaryRepresentation.Statements.While: print_while(statement)
        HighIntermediaryRepresentation.Statements.Call: print_call(statement)
        HighIntermediaryRepresentation.Statements.ForeignCall: print_foreign_call(statement)
        HighIntermediaryRepresentation.Statements.BufferWrite: print_buffer_write(statement)
        HighIntermediaryRepresentation.Statements.Crash: print_crash(statement)
        HighIntermediaryRepresentation.Statements.Return: print_return(statement)
    }
}

func print_declare(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    var value = optional_value_text(declaration.value)
    add("var {declaration.name} = {value}")
}

func print_assign(assignment: HighIntermediaryRepresentation.Statements.Assign) {
    var value = optional_value_text(assignment.value)
    add("{assignment.name} = {value}")
}

func print_assign_attribute(assignment: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    var object = optional_value_text(assignment.object)
    var value = optional_value_text(assignment.value)
    add("{object}.{assignment.class_name}.{assignment.name} = {value}")
}

func print_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var condition = optional_value_text(branch.condition)
    add("if {condition}")
    if branch.then_branch {
        print_block(branch.then_branch)
    }
    assert branch.else_branch
    add("else")
    print_block(branch.else_branch)
}

func print_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var condition = optional_value_text(loop.condition)
    add("while {condition}")
    assert loop.body
    print_block(loop.body)
}

func print_call(call: HighIntermediaryRepresentation.Statements.Call) {
    var called = called_text(call.owner, call.callee, call.arguments)
    add(called)
}

func print_foreign_call(statement: HighIntermediaryRepresentation.Statements.ForeignCall) {
    var call = optional_value_text(statement.call)
    add(call)
}

func print_buffer_write(write: HighIntermediaryRepresentation.Statements.BufferWrite) {
    var object = optional_value_text(write.object)
    var offset = optional_value_text(write.offset)
    var value = optional_value_text(write.value)
    add("byte at {object} + {offset} = {value}")
}

func print_crash(stop: HighIntermediaryRepresentation.Statements.Crash) {
    var condition = optional_value_text(stop.condition)
    var message = stop.message.trim()
    add("stop unless {condition}: {message}")
}

func print_return(statement: HighIntermediaryRepresentation.Statements.Return) {
    if statement.value {
        var value = value_text(statement.value)
        add("return {value}")
    } else {
        add("return")
    }
}

func optional_value_text(value: HighIntermediaryRepresentation.Values.Value?): String {
    if value {
        return value_text(value)
    }
    return "(missing)"
}

func value_text(value: HighIntermediaryRepresentation.Values.Value): String {
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return value.text
        HighIntermediaryRepresentation.Values.Name: return value.name
        HighIntermediaryRepresentation.Values.Operation: return operation_text(value)
        HighIntermediaryRepresentation.Values.Answer: return called_text(value.owner, value.callee, value.arguments)
        HighIntermediaryRepresentation.Values.Attribute: return attribute_text(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return foreign_call_text(value)
        HighIntermediaryRepresentation.Values.BufferRead: return buffer_read_text(value)
        HighIntermediaryRepresentation.Values.StorageAddress: return storage_address_text(value)
    }
}

func operation_text(operation: HighIntermediaryRepresentation.Values.Operation): String {
    var left = optional_value_text(operation.left)
    var right = optional_value_text(operation.right)
    return "({left} {operation.operator} {right})"
}

func attribute_text(attribute: HighIntermediaryRepresentation.Values.Attribute): String {
    var object = optional_value_text(attribute.object)
    return "{object}.{attribute.class_name}.{attribute.name}"
}

func foreign_call_text(call: HighIntermediaryRepresentation.Values.ForeignCall): String {
    var receiver = optional_value_text(call.receiver)
    var arguments = values_text(call.arguments)
    return "foreign {call.name}({arguments}) from {receiver}"
}

func buffer_read_text(read: HighIntermediaryRepresentation.Values.BufferRead): String {
    var object = optional_value_text(read.object)
    var offset = optional_value_text(read.offset)
    return "byte at {object} + {offset}"
}

func storage_address_text(address: HighIntermediaryRepresentation.Values.StorageAddress): String {
    var value = optional_value_text(address.value)
    return "address of {value}"
}

func called_text(owner: String, callee: String, arguments: List<HighIntermediaryRepresentation.Values.Value>): String {
    var given = values_text(arguments)
    if owner.is_empty() {
        return "{callee}({given}), its class unknown"
    }
    return "{owner}.{callee}({given})"
}

func values_text(values: List<HighIntermediaryRepresentation.Values.Value>): String {
    var outer = written_values
    written_values = List<String>()
    values.each(write_value)
    var joined = written_values.join(", ")
    written_values = outer
    return joined
}

func write_value(value: HighIntermediaryRepresentation.Values.Value) {
    var written = value_text(value)
    written_values.append(written)
}

func add(line: String) {
    lines.append("{indent}{line}")
}

var no_model = Model.FunctionModel("", "")
var no_body = HighIntermediaryRepresentation.Statements.Block()
var printed = HighIntermediaryRepresentation.HighFunction(no_model, no_body)
var lines = List<String>()
var indent = ""
var written_values = List<String>()

func Printer(starting_function: HighIntermediaryRepresentation.HighFunction) {
    printed = starting_function
}

func text(): String {
    lines = List<String>()
    indent = ""
    var answer = ""
    if printed.function.answer {
        var shown = type_text(printed.function.answer)
        answer = ": {shown}"
    }
    var parameters = parameters_text()
    add("function {printed.function.key()}({parameters}){answer}")
    print_block(printed.body)
    var joined = lines.join("\n")
    return "{joined}\n"
}

func parameters_text(): String {
    var written = List<String>()
    var index = 0
    while index < printed.function.parameters.count() {
        var parameter = printed.function.parameters[index]
        var shown = type_text(parameter.parameter_type)
        written.append("{parameter.name}: {shown}")
        index = index + 1
    }
    return written.join(", ")
}

func type_text(of_type: Model.Type?): String {
    crash of_type
    if of_type.is_nullable {
        return "{of_type.name}?"
    }
    return of_type.name
}

func print_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    crash block
    var outer = indent
    indent = "{indent}    "
    block.statements.each(print_statement)
    indent = outer
}

func print_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: print_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: print_assign(statement)
        HighIntermediaryRepresentation.Statements.AssignAttribute: print_assign_attribute(statement)
        HighIntermediaryRepresentation.Statements.AssignThroughShape: print_assign_through_shape(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: print_evaluate(statement)
        HighIntermediaryRepresentation.Statements.If: print_if(statement)
        HighIntermediaryRepresentation.Statements.While: print_while(statement)
        HighIntermediaryRepresentation.Statements.Return: print_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: print_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: print_inner(statement)
    }
}

func print_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    var value = value_text(declare.value)
    var shown = type_text(declare.declared_type)
    add("var {declare.name}: {shown} = {value}")
}

func print_assign(assign: HighIntermediaryRepresentation.Statements.Assign) {
    var value = value_text(assign.value)
    add("{assign.name} = {value}")
}

func print_assign_attribute(assign: HighIntermediaryRepresentation.Statements.AssignAttribute) {
    var object = value_text(assign.object)
    var value = value_text(assign.value)
    add("{object}.{assign.attribute.name} = {value}")
}

func print_assign_through_shape(assign: HighIntermediaryRepresentation.Statements.AssignThroughShape) {
    var object = value_text(assign.object)
    var value = value_text(assign.value)
    add("{object}.{assign.member} = {value} through {assign.shape.key}")
}

func print_evaluate(evaluate: HighIntermediaryRepresentation.Statements.Evaluate) {
    var value = value_text(evaluate.value)
    add(value)
}

func print_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var condition = value_text(branch.condition)
    add("if {condition}")
    print_block(branch.then_branch)
    assert branch.else_branch
    add("else")
    print_block(branch.else_branch)
}

func print_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var condition = value_text(loop.condition)
    add("while {condition}")
    print_block(loop.body)
}

func print_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    if returned.value {
        var value = value_text(returned.value)
        add("return {value}")
    } else {
        add("return")
    }
}

func print_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    add("stop at line {stop.line}: {stop.message}")
}

func print_inner(block: HighIntermediaryRepresentation.Statements.Block) {
    add("block from line {block.line}")
    print_block(block)
}

func value_text(value: HighIntermediaryRepresentation.Values.Value?): String {
    crash value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return value.number.to_string()
        HighIntermediaryRepresentation.Values.DecimalNumber: return value.written
        HighIntermediaryRepresentation.Values.TextConstant: return "\"{value.text}\""
        HighIntermediaryRepresentation.Values.NullConstant: return "null"
        HighIntermediaryRepresentation.Values.LocalRead: return value.name
        HighIntermediaryRepresentation.Values.ThisRead: return "this"
        HighIntermediaryRepresentation.Values.AttributeRead: return attribute_text(value)
        HighIntermediaryRepresentation.Values.Call: return call_text(value)
        HighIntermediaryRepresentation.Values.MakeObject: return make_text(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return operation_text(value)
        HighIntermediaryRepresentation.Values.Negation: return negation_text(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return foreign_text(value)
        HighIntermediaryRepresentation.Values.ClassTest: return class_test_text(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return presence_text(value)
        HighIntermediaryRepresentation.Values.Conversion: return conversion_text(value)
        HighIntermediaryRepresentation.Values.FunctionValue: return function_value_text(value)
        HighIntermediaryRepresentation.Values.FunctionValueCall: return function_call_text(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return number_room_text(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return shape_call_text(value)
        HighIntermediaryRepresentation.Values.EnumText: return enum_text_text(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return "value of {value.enumeration.name} named by text"
        HighIntermediaryRepresentation.Values.ClassObject: return "{value.reflection_kind} of {value.described}"
        HighIntermediaryRepresentation.Values.ClassOfValue: return class_of_value_text(value)
    }
}

func attribute_text(read: HighIntermediaryRepresentation.Values.AttributeRead): String {
    var object = value_text(read.object)
    return "{object}.{read.attribute.name}"
}

func call_text(call: HighIntermediaryRepresentation.Values.Call): String {
    var receiver = value_text(call.receiver)
    var arguments = values_text(call.arguments)
    return "{call.function.key()}({receiver}; {arguments})"
}

func make_text(made: HighIntermediaryRepresentation.Values.MakeObject): String {
    var arguments = values_text(made.arguments)
    return "make {made.value_type.name}({arguments})"
}

func operation_text(operation: HighIntermediaryRepresentation.Values.MachineOperation): String {
    var left = value_text(operation.left)
    var right = value_text(operation.right)
    return "({left} {operation.operator} {right})"
}

func negation_text(negation: HighIntermediaryRepresentation.Values.Negation): String {
    var negated = value_text(negation.negated)
    return "not {negated}"
}

func foreign_text(call: HighIntermediaryRepresentation.Values.ForeignCall): String {
    var library = value_text(call.library)
    var arguments = values_text(call.arguments)
    return "foreign {library}.{call.function_name}({arguments})"
}

func class_test_text(test: HighIntermediaryRepresentation.Values.ClassTest): String {
    var tested = value_text(test.tested)
    return "{tested} is {test.member.name}"
}

func presence_text(test: HighIntermediaryRepresentation.Values.PresenceTest): String {
    var tested = value_text(test.tested)
    return "{tested} is present"
}

func conversion_text(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    var converted = value_text(conversion.converted)
    var shown = type_text(conversion.value_type)
    return "({converted} as {conversion.kind} {shown})"
}

func function_value_text(made: HighIntermediaryRepresentation.Values.FunctionValue): String {
    var receiver = value_text(made.receiver)
    return "function {made.function.key()} of {receiver}"
}

func function_call_text(call: HighIntermediaryRepresentation.Values.FunctionValueCall): String {
    var called = value_text(call.called)
    var arguments = values_text(call.arguments)
    return "{called}({arguments})"
}

func class_of_value_text(made: HighIntermediaryRepresentation.Values.ClassOfValue): String {
    var described = value_text(made.described)
    return "class of {described}"
}

func enum_text_text(named: HighIntermediaryRepresentation.Values.EnumText): String {
    var number = value_text(named.number)
    return "name in {named.enumeration.name} of {number}"
}

func shape_call_text(call: HighIntermediaryRepresentation.Values.ShapeCall): String {
    var receiver = value_text(call.receiver)
    var arguments = values_text(call.arguments)
    return "{call.shape.key}.{call.member.name}({receiver}; {arguments})"
}

func number_room_text(room: HighIntermediaryRepresentation.Values.NumberRoom): String {
    var made = value_text(room.made)
    var number = value_text(room.number)
    return "room of {number}, {room.width} bytes, in {made}"
}

func values_text(values: List<HighIntermediaryRepresentation.Values.Value>): String {
    var outer = written_values
    written_values = List<String>()
    values.each(write_value)
    var joined = written_values.join(", ")
    written_values = outer
    return joined
}

func write_value(value: HighIntermediaryRepresentation.Values.Value) {
    var written = value_text(value)
    written_values.append(written)
}

func add(line: String) {
    lines.append("{indent}{line}")
}

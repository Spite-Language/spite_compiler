generic $field_type

# ../../../spite_documentation/reflection.md#known-while-compiling
func text(value: $field_type, printer: Printer): String {
    if $field_type == Null {
        if not value {
            return "null"
        }
        var present = Field<$field_type.value_type>()
        return present.text(value, printer)
    } else if $field_type == SpiteCompiler.Value {
        return printer.value_fields_text(value)
    } else if $field_type == HighIntermediaryRepresentation.Statements.Block {
        return printer.block_fields_text(value)
    } else if $field_type == List {
        return list_text(value, printer)
    } else if $field_type == Model.Type {
        return printer.type_text(value)
    } else if $field_type == Model.FunctionModel {
        return value.key()
    } else if $field_type == Model.AttributeModel {
        return value.name
    } else if $field_type == Model.ShapeModel {
        return value.key
    } else if $field_type == Model.EnumModel {
        return value.key
    } else {
        return value
    }
}

func list_text(listed: $field_type, printer: Printer): String {
    if $field_type.element_type == SpiteCompiler.Value {
        return printer.value_list_fields_text(listed)
    } else if $field_type.element_type == SpiteCompiler.Statement {
        var count = listed.count()
        return "{count} statements"
    } else if $field_type.element_type == Model.FunctionModel {
        return printer.function_keys_text(listed)
    } else {
        var joined = listed.join(",")
        return "[{joined}]"
    }
}

var class_name = ""
var printed_functions = List<LowIntermediaryRepresentation.Functions.LowFunction>()
var lines = List<String>()
var written_registers = List<String>()

func Printer(
    starting_class_name: String,
    starting_functions: List<LowIntermediaryRepresentation.Functions.LowFunction>,
) {
    class_name = starting_class_name
    printed_functions = starting_functions
}

func text(): String {
    lines = List<String>()
    lines.append("class {class_name}")
    printed_functions.each(print_function)
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_function(function: LowIntermediaryRepresentation.Functions.LowFunction) {
    lines.append("    function {function.name}: {function.slots} slots, {function.instructions.count()} instructions")
    function.instructions.each(print_instruction)
}

func print_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    var written = instruction_text(instruction)
    lines.append("        {written}")
}

func instruction_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    switch instruction.kind {
        "number": return "r{instruction.first} = {instruction.text}"
        "read": return "r{instruction.second} = p{instruction.first}"
        "write": return "p{instruction.first} = r{instruction.second}"
        "operation": return operation_text(instruction)
        "jump": return "jump to {instruction.to}"
        "jump_if_false": return "jump to {instruction.to} when r{instruction.first} is false"
        "call": return call_text(instruction)
        "copy": return "r{instruction.second} = r{instruction.first}"
        "object_address": return "r{instruction.second} = &p{instruction.first}"
        "read_attribute": return "r{instruction.third} = p{instruction.first}[{instruction.second}]"
        "write_attribute": return "p{instruction.first}[{instruction.second}] = r{instruction.third}"
        "buffer_read": return "r{instruction.third} = byte at r{instruction.first} + r{instruction.second}"
        "buffer_write": return "byte at r{instruction.first} + r{instruction.second} = r{instruction.third}"
        "attribute_address": return "r{instruction.third} = &r{instruction.first}[{instruction.second}]"
        "place_address": return "r{instruction.second} = &p{instruction.first}"
        "foreign_call": return foreign_call_text(instruction)
        "return": return return_text(instruction)
        "crash": return "the program stops: {instruction.text}"
        _: return "an instruction this printer does not know: {instruction.kind}"
    }
}

func operation_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    return "r{instruction.third} = r{instruction.first} {instruction.text} r{instruction.second}"
}

func foreign_call_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    var given = registers_text(instruction.places)
    return "r{instruction.first} = {instruction.text}({given})"
}

func call_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    var given = registers_text(instruction.places)
    if instruction.owner.is_empty() {
        return "r{instruction.first} = {instruction.callee}({given})"
    }
    return "r{instruction.first} = {instruction.owner}.{instruction.callee}({given})"
}

func return_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    if instruction.first >= 0 {
        return "return r{instruction.first}"
    }
    return "return"
}

func registers_text(registers: List<Integer>): String {
    written_registers = List<String>()
    registers.each(write_register)
    return written_registers.join(", ")
}

func write_register(register: Integer) {
    written_registers.append("r{register}")
}

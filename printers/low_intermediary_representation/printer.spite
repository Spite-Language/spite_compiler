var printed = LowIntermediaryRepresentation.LowFunction("", 0)
var lines = List<String>()
var block_index = 0
var shown_fields = List<String>()

func Printer(starting_function: LowIntermediaryRepresentation.LowFunction) {
    printed = starting_function
}

func text(): String {
    lines = List<String>()
    lines.append("function {printed.key}: {printed.parameter_count} parameters, {printed.register_count} registers")
    block_index = 0
    printed.blocks.each(print_block)
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_block(block: LowIntermediaryRepresentation.LowBlock) {
    lines.append("  block {block_index}")
    block.joins.each(print_join)
    block.instructions.each(print_instruction)
    block_index = block_index + 1
}

func print_join(joining: LowIntermediaryRepresentation.Instructions.Join) {
    var pieces = List<String>()
    var index = 0
    while index < joining.sources.count() {
        var source = joining.sources[index]
        var from_block = joining.blocks[index]
        crash source
        crash from_block
        pieces.append("r{source} from block {from_block}")
        index = index + 1
    }
    var joined = pieces.join(", ")
    lines.append("    r{joining.target} = join of r{joining.original}: {joined}")
}

func print_instruction(instruction: SpiteCompiler.Instruction) {
    var written = instruction_text(instruction)
    var fields = fields_text(instruction)
    lines.append("    {written} | {fields}")
}

func fields_text(instruction: SpiteCompiler.Instruction): String {
    shown_fields = List<String>()
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Copy: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Arithmetic: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Check: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Compare: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Load: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Store: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Call: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.CallAt: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.DataAddress: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Allocate: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Retain: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Free: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Resize: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.CopyBytes: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Jump: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Branch: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Return: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.FrameAddress: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.FrameRoom: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.StartThread: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.JoinThread: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.ImportCall: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.CompareExchange: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Stop: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.Exit: instruction.attributes.each(note_field)
        LowIntermediaryRepresentation.Instructions.VectorLoop: instruction.attributes.each(note_loop_field)
        LowIntermediaryRepresentation.Instructions.Select: instruction.attributes.each(note_field)
    }
    return shown_fields.join(" ")
}

func note_field(field: Spite.Attribute) {
    if field.class == List {
        var listed = field.value.join(",")
        shown_fields.append("{field.name}=[{listed}]")
        return
    }
    shown_fields.append("{field.name}={field.value}")
}

func note_loop_field(field: Spite.Attribute) {
    if field.class == List {
        var count = field.value.count()
        shown_fields.append("{field.name}={count} items")
        return
    }
    shown_fields.append("{field.name}={field.value}")
}

func instruction_text(instruction: SpiteCompiler.Instruction): String {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return "r{instruction.target} = {instruction.number}"
        LowIntermediaryRepresentation.Instructions.Copy: return "r{instruction.target} = r{instruction.source}"
        LowIntermediaryRepresentation.Instructions.Arithmetic: return arithmetic_text(instruction)
        LowIntermediaryRepresentation.Instructions.Check: return check_text(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: return compare_text(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return "r{instruction.target} = r{instruction.left} {instruction.operator} r{instruction.right}, decimal, double {instruction.is_double}"
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return "r{instruction.target} = r{instruction.left} {instruction.comparison} r{instruction.right}, decimal, double {instruction.is_double}"
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return "r{instruction.target} = r{instruction.source} from decimal {instruction.from_decimal_size} to decimal {instruction.to_decimal_size}"
        LowIntermediaryRepresentation.Instructions.Load: return load_text(instruction)
        LowIntermediaryRepresentation.Instructions.Store: return store_text(instruction)
        LowIntermediaryRepresentation.Instructions.Call: return call_text(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: return call_at_text(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return "r{instruction.target} = address of '{instruction.name}' in r{instruction.library}"
        LowIntermediaryRepresentation.Instructions.DataAddress: return "r{instruction.target} = address of data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return "r{instruction.target} = address of {instruction.function}"
        LowIntermediaryRepresentation.Instructions.Allocate: return "r{instruction.target} = allocate r{instruction.size} bytes"
        LowIntermediaryRepresentation.Instructions.Retain: return "retain r{instruction.object}"
        LowIntermediaryRepresentation.Instructions.Free: return "free r{instruction.pointer}"
        LowIntermediaryRepresentation.Instructions.Resize: return "r{instruction.target} = resize r{instruction.pointer} to r{instruction.size} bytes"
        LowIntermediaryRepresentation.Instructions.CopyBytes: return "copy r{instruction.count} bytes from r{instruction.source} to r{instruction.destination}"
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return "r{instruction.target} = open the library named at r{instruction.name}"
        LowIntermediaryRepresentation.Instructions.Jump: return "jump to block {instruction.block}"
        LowIntermediaryRepresentation.Instructions.Branch: return branch_text(instruction)
        LowIntermediaryRepresentation.Instructions.Return: return return_text(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: return "stop with data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.Exit: return "exit with r{instruction.code}"
        LowIntermediaryRepresentation.Instructions.FrameAddress: return "r{instruction.target} = the frame"
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return "r{instruction.target} = this thread's number"
        LowIntermediaryRepresentation.Instructions.FrameRoom: return "r{instruction.target} = room for {instruction.size} bytes in the frame"
        LowIntermediaryRepresentation.Instructions.StartThread: return "r{instruction.target} = a thread running {instruction.entry}(r{instruction.block})"
        LowIntermediaryRepresentation.Instructions.JoinThread: return "join the thread r{instruction.thread}"
        LowIntermediaryRepresentation.Instructions.CompareExchange: return "r{instruction.target} = at r{instruction.address} + {instruction.offset} swap r{instruction.expected} for r{instruction.desired} atomically"
        LowIntermediaryRepresentation.Instructions.ImportCall: return import_call_text(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return "r{instruction.target} = at r{instruction.address} + {instruction.offset} add {instruction.amount} atomically"
        LowIntermediaryRepresentation.Instructions.VectorLoop: return vector_loop_text(instruction)
        LowIntermediaryRepresentation.Instructions.Select: return "r{instruction.target} = r{instruction.when_true} if r{instruction.condition} else r{instruction.when_false}"
    }
}

func vector_loop_text(looping: LowIntermediaryRepresentation.Instructions.VectorLoop): String {
    var bounds = registers_text(looping.limits)
    var sums = registers_text(looping.accumulators)
    var pieces = List<String>()
    pieces.append(
        "r{looping.counter} = vector loop of {looping.lanes} lanes while below {bounds}, summing {sums}, at most {looping.most_trips} passes",
    )
    var index = 0
    while index < looping.setup.count() {
        var step = looping.setup[index]
        var shown = step_text(step)
        pieces.append("setup {shown}")
        index = index + 1
    }
    index = 0
    while index < looping.body.count() {
        var step = looping.body[index]
        var shown = step_text(step)
        pieces.append(shown)
        index = index + 1
    }
    return pieces.join("\n      ")
}

func step_text(step: LowIntermediaryRepresentation.Vector.Step): String {
    var shown = "v{step.target} = {step.operation} {step.format} v{step.left} v{step.right}"
    switch step.operation {
        'load': return "{shown} from r{step.base} + {step.offset}, {step.width}"
        'store': return "{shown} to r{step.base} + {step.offset}, {step.width}"
        'broadcast': return "{shown} of r{step.source} ({step.number})"
        'decimal': return "{shown} {step.arithmetic}"
        'whole': return "{shown} {step.arithmetic} by {step.offset}"
        'compare': return "{shown} {step.comparison}"
        'decimal_compare': return "{shown} {step.comparison}"
        'zero': return "{shown} from {step.from_format}"
        'convert': return "{shown} from {step.from_format}"
        'widen': return "{shown} from {step.from_format}"
        'narrow': return "{shown} from {step.from_format}"
        'absolute': return "{shown} from {step.from_format}"
        'copy': return "{shown} from {step.from_format}"
    }
}

func import_call_text(calling: LowIntermediaryRepresentation.Instructions.ImportCall): String {
    var listed = registers_text(calling.arguments)
    if calling.library.is_empty() {
        return "r{calling.target} = the system's {calling.name}({listed})"
    }
    return "r{calling.target} = {calling.library}'s {calling.name}({listed})"
}

func arithmetic_text(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    return "r{arithmetic.target} = r{arithmetic.left} {arithmetic.operator} r{arithmetic.right}, {arithmetic.width} signed {arithmetic.is_signed}"
}

func check_text(check: LowIntermediaryRepresentation.Instructions.Check): String {
    return "check that it fits, at line {check.line}"
}

func compare_text(compare: LowIntermediaryRepresentation.Instructions.Compare): String {
    return "r{compare.target} = r{compare.left} {compare.comparison} r{compare.right}, signed {compare.is_signed}"
}

func load_text(loaded: LowIntermediaryRepresentation.Instructions.Load): String {
    var shown = "r{loaded.target} = {loaded.width} at r{loaded.address} + {loaded.offset}, signed {loaded.is_signed}"
    if loaded.is_invariant {
        shown = "{shown}, invariant"
    }
    if not loaded.region.is_empty() {
        shown = "{shown}, in {loaded.region}"
    }
    if loaded.is_swapped {
        return "{shown}, swapped"
    }
    return shown
}

func store_text(stored: LowIntermediaryRepresentation.Instructions.Store): String {
    var shown = "{stored.width} at r{stored.address} + {stored.offset} = r{stored.source}"
    if not stored.region.is_empty() {
        shown = "{shown}, in {stored.region}"
    }
    if stored.is_swapped {
        return "{shown}, swapped"
    }
    return shown
}

func call_text(call: LowIntermediaryRepresentation.Instructions.Call): String {
    var arguments = registers_text(call.arguments)
    return "r{call.target}, r{call.presence} = {call.function}({arguments})"
}

func call_at_text(call: LowIntermediaryRepresentation.Instructions.CallAt): String {
    var arguments = registers_text(call.arguments)
    return "r{call.target}, r{call.presence} = call r{call.address}({arguments}), answers 32 bits {call.answers_32_bits}"
}

func branch_text(branch: LowIntermediaryRepresentation.Instructions.Branch): String {
    return "if r{branch.condition} jump to block {branch.when_true}, else to block {branch.when_false}"
}

func return_text(returned: LowIntermediaryRepresentation.Instructions.Return): String {
    return "return r{returned.source}, r{returned.presence}"
}

func registers_text(registers: List<Integer>): String {
    var written = List<String>()
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        written.append("r{register}")
        index = index + 1
    }
    return written.join(", ")
}

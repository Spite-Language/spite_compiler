var printed = LowIntermediaryRepresentation.LowFunction("", 0)
var lines = List<String>()
var block_index = 0

func Printer(starting_function: LowIntermediaryRepresentation.LowFunction) {
    printed = starting_function
}

func text(): String {
    lines = List<String>()
    lines.append("function {printed.key}: {printed.parameter_count} parameters, {printed.register_count} registers")
    block_index = 0
    printed.blocks.each(print_block)
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_block(block: LowIntermediaryRepresentation.LowBlock) {
    lines.append("  block {block_index}")
    block.instructions.each(print_instruction)
    block_index = block_index + 1
}

func print_instruction(instruction: LowIntermediaryRepresentation.Instructions.Instruction) {
    var written = instruction_text(instruction)
    lines.append("    {written}")
}

func instruction_text(instruction: LowIntermediaryRepresentation.Instructions.Instruction): String {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return "r{instruction.target} = {instruction.number}"
        LowIntermediaryRepresentation.Instructions.Copy: return "r{instruction.target} = r{instruction.source}"
        LowIntermediaryRepresentation.Instructions.Arithmetic: return arithmetic_text(instruction)
        LowIntermediaryRepresentation.Instructions.Compare: return compare_text(instruction)
        LowIntermediaryRepresentation.Instructions.DecimalArithmetic: return "r{instruction.target} = r{instruction.left} {instruction.operator} r{instruction.right}, decimal, double {instruction.is_double}"
        LowIntermediaryRepresentation.Instructions.DecimalCompare: return "r{instruction.target} = r{instruction.left} {instruction.comparison} r{instruction.right}, decimal, double {instruction.is_double}"
        LowIntermediaryRepresentation.Instructions.DecimalConversion: return "r{instruction.target} = r{instruction.source} from decimal {instruction.from_decimal_size} to decimal {instruction.to_decimal_size}"
        LowIntermediaryRepresentation.Instructions.Load: return load_text(instruction)
        LowIntermediaryRepresentation.Instructions.Store: return store_text(instruction)
        LowIntermediaryRepresentation.Instructions.Call: return call_text(instruction)
        LowIntermediaryRepresentation.Instructions.CallAt: return call_at_text(instruction)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return "r{instruction.target} = address of '{instruction.name}' in r{instruction.library}"
        LowIntermediaryRepresentation.Instructions.DataAddress: return "r{instruction.target} = address of data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return "r{instruction.target} = address of {instruction.function}"
        LowIntermediaryRepresentation.Instructions.Allocate: return "r{instruction.target} = allocate r{instruction.size} bytes"
        LowIntermediaryRepresentation.Instructions.Retain: return "retain r{instruction.object}"
        LowIntermediaryRepresentation.Instructions.Free: return "free r{instruction.pointer}"
        LowIntermediaryRepresentation.Instructions.Resize: return "r{instruction.target} = resize r{instruction.pointer} to r{instruction.size} bytes"
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return "r{instruction.target} = open the library named at r{instruction.name}"
        LowIntermediaryRepresentation.Instructions.Jump: return "jump to block {instruction.block}"
        LowIntermediaryRepresentation.Instructions.Branch: return branch_text(instruction)
        LowIntermediaryRepresentation.Instructions.Return: return return_text(instruction)
        LowIntermediaryRepresentation.Instructions.Stop: return "stop with data {instruction.label}"
        LowIntermediaryRepresentation.Instructions.Exit: return "exit with r{instruction.code}"
        LowIntermediaryRepresentation.Instructions.FrameAddress: return "r{instruction.target} = the frame"
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return "r{instruction.target} = this thread's number"
        LowIntermediaryRepresentation.Instructions.StartThread: return "r{instruction.target} = a thread running {instruction.entry}(r{instruction.block})"
        LowIntermediaryRepresentation.Instructions.JoinThread: return "join the thread r{instruction.thread}"
        LowIntermediaryRepresentation.Instructions.CompareExchange: return "r{instruction.target} = at r{instruction.address} + {instruction.offset} swap r{instruction.expected} for r{instruction.desired} atomically"
        LowIntermediaryRepresentation.Instructions.ImportCall: return import_call_text(instruction)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return "r{instruction.target} = at r{instruction.address} + {instruction.offset} add {instruction.amount} atomically"
    }
}

func import_call_text(calling: LowIntermediaryRepresentation.Instructions.ImportCall): String {
    var listed = registers_text(calling.arguments)
    if calling.library.is_empty() {
        return "r{calling.target} = the system's {calling.name}({listed})"
    }
    return "r{calling.target} = {calling.library}'s {calling.name}({listed})"
}

func arithmetic_text(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): String {
    var checked = "unchecked"
    if arithmetic.is_checked {
        checked = "checked {arithmetic.width} signed {arithmetic.is_signed} at line {arithmetic.line}"
    }
    return "r{arithmetic.target} = r{arithmetic.left} {arithmetic.operator} r{arithmetic.right}, {checked}"
}

func compare_text(compare: LowIntermediaryRepresentation.Instructions.Compare): String {
    return "r{compare.target} = r{compare.left} {compare.comparison} r{compare.right}, signed {compare.is_signed}"
}

func load_text(loaded: LowIntermediaryRepresentation.Instructions.Load): String {
    var shown = "r{loaded.target} = {loaded.width} at r{loaded.address} + {loaded.offset}, signed {loaded.is_signed}"
    if loaded.is_swapped {
        return "{shown}, swapped"
    }
    return shown
}

func store_text(stored: LowIntermediaryRepresentation.Instructions.Store): String {
    var shown = "{stored.width} at r{stored.address} + {stored.offset} = r{stored.source}"
    if stored.is_swapped {
        return "{shown}, swapped"
    }
    return shown
}

func call_text(call: LowIntermediaryRepresentation.Instructions.Call): String {
    var arguments = registers_text(call.arguments)
    return "r{call.target}, r{call.presence} = {call.function}({arguments})"
}

func call_at_text(call: LowIntermediaryRepresentation.Instructions.CallAt): String {
    var arguments = registers_text(call.arguments)
    return "r{call.target}, r{call.presence} = call r{call.address}({arguments}), answers 32 bits {call.answers_32_bits}"
}

func branch_text(branch: LowIntermediaryRepresentation.Instructions.Branch): String {
    return "if r{branch.condition} jump to block {branch.when_true}, else to block {branch.when_false}"
}

func return_text(returned: LowIntermediaryRepresentation.Instructions.Return): String {
    return "return r{returned.source}, r{returned.presence}"
}

func registers_text(registers: List<Integer>): String {
    var written = List<String>()
    var index = 0
    while index < registers.count() {
        var register = registers[index]
        written.append("r{register}")
        index = index + 1
    }
    return written.join(", ")
}

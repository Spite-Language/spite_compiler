var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var model = Model.ClassModel("", "", no_file)
var program_model = Model.ProgramModel()
var lines = List<String>()
var name = ""
var shows_what_the_compiler_writes = false

func Printer(starting_model: Model.ClassModel, starting_program: Model.ProgramModel, starting_name: String) {
    model = starting_model
    program_model = starting_program
    name = starting_name
}

func text(): String {
    lines = List<String>()
    lines.append("type {name} \{")
    model.declared_attributes.each(print_attribute)
    model.declared_functions.each(print_function)
    lines.append("}")
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_attribute(attribute: Model.AttributeModel) {
    var shown = type_text(attribute.attribute_type)
    lines.append("    {attribute.name}: {shown}")
}

func print_function(function: Model.FunctionModel) {
    var is_hidden = function.is_written_by_the_compiler and not shows_what_the_compiler_writes
    var is_left_out = function.is_constructor or function.is_synthetic or is_hidden
    fallback not is_left_out and not function.is_an_attribute
    var written = List<String>()
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        var shown = type_text(parameter.parameter_type)
        var dots = ""
        if parameter.is_variadic {
            dots = "..."
        }
        written.append("{dots}{parameter.name}: {shown}")
        index = index + 1
    }
    var joined = written.join(", ")
    var answer = ""
    if function.answer {
        var answered = type_text(function.answer)
        answer = ": {answered}"
    }
    lines.append("    {function.name}({joined}){answer}")
}

func type_text(shown: Model.Type): String {
    var written = shown.name
    if shown.kind == 'function' {
        written = function_type_text(shown)
    }
    var known = program_model.class_named(shown.name)
    if known {
        written = known.shown
    }
    if shown.is_nullable {
        return "{written}?"
    }
    return written
}

func function_type_text(shown: Model.Type): String {
    var written = List<String>()
    var index = 0
    while index < shown.parameters.count() {
        var parameter = shown.parameters[index]
        var parameter_text = type_text(parameter)
        written.append(parameter_text)
        index = index + 1
    }
    var answer = "Nothing"
    if shown.answer {
        answer = type_text(shown.answer)
    }
    written.append(answer)
    var joined = written.join(", ")
    return "Spite.Function<{joined}>"
}

var source = ""
var fixes = List<Diagnostics.Fix>()

func Printer(starting_source: String, starting_fixes: List<Diagnostics.Fix>) {
    source = starting_source
    fixes = starting_fixes
}

func text(): String {
    var break_text = "\n"
    if source.contains("\r\n") {
        break_text = "\r\n"
    }
    var unbroken = source.replace("\r\n", "\n")
    var lines = unbroken.split("\n")
    var kept = List<String>()
    var line = 1
    while line <= lines.count() {
        var fix = fix_starting_at(line)
        if fix {
            var opening = lines[line - 1]
            crash opening
            var indent = indent_of(opening)
            if not fix.replacement.is_empty() {
                kept.append("{indent}{fix.replacement}")
            }
            line = fix.last_line + 1
        } else {
            var written = lines[line - 1]
            crash written
            kept.append(written)
            line = line + 1
        }
    }
    return kept.join(break_text)
}

func fix_starting_at(line: Integer): Diagnostics.Fix? {
    return fixes.find_by_first_line(line)
}

func indent_of(written: String): String {
    var trimmed = written.trim()
    var trimmed_width = trimmed.length()
    var width = written.length() - trimmed_width
    var indent = written.slice(0, width)
    crash indent
    return indent
}

var source = ""
var tokens = List<AbstractSyntaxTree.Tokens.Token>()
var comments = List<AbstractSyntaxTree.Shapes.Comment>()
var token_index = 0
var comment_index = 0
var openers = List<Integer>()
var line_kinds = List<String>()
var line_depths = List<Integer>()
var line_texts = List<String>()
var line_words = List<String>()
var generic_depth = 0

func Printer(
    starting_source: String,
    starting_tokens: List<AbstractSyntaxTree.Tokens.Token>,
    starting_comments: List<AbstractSyntaxTree.Shapes.Comment>,
) {
    source = starting_source
    tokens = starting_tokens
    comments = starting_comments
}

func text(): String {
    if tokens.count() <= 1 and comments.is_empty() {
        return source
    }
    token_index = 0
    comment_index = 0
    openers = List<Integer>()
    line_kinds = List<String>()
    line_depths = List<Integer>()
    line_texts = List<String>()
    line_words = List<String>()
    var pieces = source.split("\n")
    var line_count = pieces.count()
    var line = 1
    while line <= line_count {
        print_line(line)
        line = line + 1
    }
    var kept = kept_lines()
    var break_text = "\n"
    if source.contains("\r\n") {
        break_text = "\r\n"
    }
    var joined = kept.join(break_text)
    return "{joined}{break_text}"
}

func print_line(line: Integer) {
    var on_line = tokens_on(line)
    var comment = comment_on(line)
    var depth = openers.count()
    if on_line.is_empty() and not comment {
        add_line("blank", depth, "", "")
        return
    }
    var level = level_of(on_line)
    var written = ""
    var word = "#"
    if not on_line.is_empty() {
        written = spaced(on_line)
        var first = on_line[0]
        word = first.lexeme
        follow_the_brackets(on_line, level)
    }
    if comment {
        var comment_text = comment_text_of(comment)
        written = joined_with_space(written, comment_text)
    }
    var indent = indent_of(level)
    var kind = "code"
    if on_line.is_empty() {
        kind = "comment"
    }
    add_line(kind, depth, "{indent}{written}", word)
}

func add_line(kind: String, depth: Integer, written: String, word: String) {
    line_kinds.append(kind)
    line_depths.append(depth)
    line_texts.append(written)
    line_words.append(word)
}

func tokens_on(line: Integer): List<AbstractSyntaxTree.Tokens.Token> {
    var found = List<AbstractSyntaxTree.Tokens.Token>()
    var keep_going = token_index < tokens.count()
    while keep_going {
        var token = tokens[token_index]
        crash token
        var belongs = token.line == line and token.kind != 'end_of_file'
        if belongs {
            found.append(token)
            token_index = token_index + 1
        }
        keep_going = belongs and token_index < tokens.count()
    }
    return found
}

func comment_on(line: Integer): AbstractSyntaxTree.Shapes.Comment? {
    fallback comment_index < comments.count()
    var comment = comments[comment_index]
    fallback comment.line == line
    comment_index = comment_index + 1
    return comment
}

func comment_text_of(comment: AbstractSyntaxTree.Shapes.Comment): String {
    if comment.text.is_empty() {
        return "#"
    }
    return "# {comment.text}"
}

func joined_with_space(written: String, comment_text: String): String {
    if written.is_empty() {
        return comment_text
    }
    return "{written} {comment_text}"
}

func level_of(on_line: List<AbstractSyntaxTree.Tokens.Token>): Integer {
    fallback not openers.is_empty()
    var last = openers.count() - 1
    var opened_at = openers[last]
    crash opened_at
    if on_line.is_empty() {
        return opened_at + 1
    }
    var first = on_line[0]
    if is_a_closer(first) {
        return opened_at
    }
    return opened_at + 1
}

func follow_the_brackets(on_line: List<AbstractSyntaxTree.Tokens.Token>, level: Integer) {
    var index = 0
    while index < on_line.count() {
        var token = on_line[index]
        if is_an_opener(token) {
            openers.append(level)
        } else if is_a_closer(token) and not openers.is_empty() {
            crash openers.remove_last()
        }
        index = index + 1
    }
}

func is_an_opener(token: AbstractSyntaxTree.Tokens.Token): Boolean {
    return token.kind == 'open_brace' or token.kind == 'open_parenthesis' or token.kind == 'open_bracket'
}

func is_a_closer(token: AbstractSyntaxTree.Tokens.Token): Boolean {
    return token.kind == 'close_brace' or token.kind == 'close_parenthesis' or token.kind == 'close_bracket'
}

func indent_of(level: Integer): String {
    var indent = ""
    var index = 0
    while index < level {
        indent = "{indent}    "
        index = index + 1
    }
    return indent
}

func spaced(on_line: List<AbstractSyntaxTree.Tokens.Token>): String {
    var roles = roles_of(on_line)
    var first = on_line[0]
    crash first
    var written = written_of(first)
    var index = 1
    while index < on_line.count() {
        var previous = on_line[index - 1]
        var token = on_line[index]
        var previous_role = roles[index - 1]
        var role = roles[index]
        crash previous
        crash previous_role
        crash role
        var had_space = token.column > previous.column + written_length(previous)
        var gap = gap_between(previous_role, role, had_space)
        var token_text = written_of(token)
        written = "{written}{gap}{token_text}"
        index = index + 1
    }
    return written
}

func written_of(token: AbstractSyntaxTree.Tokens.Token): String {
    if token.kind == 'text_literal' {
        return "\"{token.lexeme}\""
    }
    if token.kind == 'symbol_literal' {
        return "'{token.lexeme}'"
    }
    return token.lexeme
}

func written_length(token: AbstractSyntaxTree.Tokens.Token): Integer {
    var written = written_of(token)
    return written.length()
}

func roles_of(on_line: List<AbstractSyntaxTree.Tokens.Token>): List<String> {
    var roles = List<String>()
    generic_depth = 0
    var index = 0
    while index < on_line.count() {
        var token = on_line[index]
        var previous_role = ""
        if index > 0 {
            var last = roles[index - 1]
            crash last
            previous_role = last
        }
        var role = role_of(token, previous_role)
        roles.append(role)
        index = index + 1
    }
    return roles
}

func role_of(token: AbstractSyntaxTree.Tokens.Token, previous_role: String): String {
    var plain = plain_role_of(token)
    if plain == "less" and previous_role == "class" {
        generic_depth = generic_depth + 1
        return "generic_open"
    }
    if plain == "greater" and generic_depth > 0 {
        generic_depth = generic_depth - 1
        return "generic_close"
    }
    if plain == "minus" and not ends_a_value(previous_role) {
        return "unary_minus"
    }
    return plain
}

func ends_a_value(role: String): Boolean {
    switch role {
        "name": return true
        "class": return true
        "literal": return true
        "close_parenthesis": return true
        "close_bracket": return true
        "question": return true
        _: return role == "generic_close"
    }
}

func plain_role_of(token: AbstractSyntaxTree.Tokens.Token): String {
    switch token.kind {
        'name': return "name"
        'generic_name': return "name"
        'keyword_this': return "name"
        'class_name': return "class"
        'integer_literal': return "literal"
        'decimal_literal': return "literal"
        'text_literal': return "literal"
        'symbol_literal': return "literal"
        'keyword_true': return "literal"
        'keyword_false': return "literal"
        'keyword_null': return "literal"
        'open_brace': return "open_brace"
        'close_brace': return "close_brace"
        'open_parenthesis': return "open_parenthesis"
        'close_parenthesis': return "close_parenthesis"
        'open_bracket': return "open_bracket"
        'close_bracket': return "close_bracket"
        'comma': return "comma"
        'dot': return "dot"
        'dots': return "dots"
        'colon': return "colon"
        'question': return "question"
        'minus': return "minus"
        'less': return "less"
        'greater': return "greater"
        'keyword_load': return "load"
        _: return operator_or_keyword(token)
    }
}

func operator_or_keyword(token: AbstractSyntaxTree.Tokens.Token): String {
    switch token.kind {
        'equals': return "binary"
        'equal_equal': return "binary"
        'not_equal': return "binary"
        'less_or_equal': return "binary"
        'greater_or_equal': return "binary"
        'plus': return "binary"
        'star': return "binary"
        'slash': return "binary"
        'percent': return "binary"
        'and': return "binary"
        'or': return "binary"
        _: return "keyword"
    }
}

func gap_between(previous: String, next: String, had_space: Boolean): String {
    fallback not never_after_a_space(next)
    fallback not never_before_a_space(previous)
    if previous == "comma" {
        return comma_gap(next)
    }
    if previous == "colon" {
        return " "
    }
    if next == "close_brace" or previous == "open_brace" {
        return kept_gap(had_space)
    }
    fallback next != "generic_open" and next != "generic_close"
    if previous == "generic_close" {
        return after_a_generic(next, had_space)
    }
    if is_spaced_around(previous) or is_spaced_around(next) {
        return " "
    }
    if next == "unary_minus" {
        return kept_gap(had_space)
    }
    if previous == "close_brace" or next == "open_brace" {
        return " "
    }
    if next == "open_parenthesis" or next == "open_bracket" {
        return before_an_opening(previous, had_space)
    }
    return kept_gap(had_space)
}

func never_after_a_space(next: String): Boolean {
    switch next {
        "comma": return true
        "colon": return true
        "question": return true
        "dot": return true
        "close_parenthesis": return true
        _: return next == "close_bracket"
    }
}

func never_before_a_space(previous: String): Boolean {
    switch previous {
        "open_parenthesis": return true
        "open_bracket": return true
        "dot": return true
        "dots": return true
        "generic_open": return true
        _: return previous == "unary_minus"
    }
}

func comma_gap(next: String): String {
    fallback next != "close_brace"
    return " "
}

func kept_gap(had_space: Boolean): String {
    if had_space {
        return " "
    }
    return ""
}

func after_a_generic(next: String, had_space: Boolean): String {
    fallback next != "open_parenthesis" and next != "open_bracket"
    return kept_gap(had_space)
}

func is_spaced_around(role: String): Boolean {
    switch role {
        "binary": return true
        "less": return true
        "greater": return true
        _: return role == "minus"
    }
}

func before_an_opening(previous: String, had_space: Boolean): String {
    switch previous {
        "name": return ""
        "class": return ""
        "close_parenthesis": return ""
        "close_bracket": return ""
        "question": return ""
        "load": return kept_gap(had_space)
        _: return " "
    }
}

func kept_lines(): List<String> {
    var kept = List<String>()
    var blank_waits = false
    var previous_word = ""
    var index = 0
    while index < line_kinds.count() {
        var kind = line_kinds[index]
        var depth = line_depths[index]
        var written = line_texts[index]
        var word = line_words[index]
        crash depth
        crash written
        crash word
        if kind == "blank" {
            if depth == 0 {
                blank_waits = true
            }
        } else if depth > 0 {
            kept.append(written)
            blank_waits = false
        } else {
            if not kept.is_empty() and wants_a_blank(previous_word, word, blank_waits) {
                kept.append("")
            }
            kept.append(written)
            previous_word = word
            blank_waits = false
        }
        index = index + 1
    }
    return kept
}

func wants_a_blank(previous_word: String, word: String, blank_waits: Boolean): Boolean {
    if word == "#" and previous_word != "#" {
        return true
    }
    if word == "#" or previous_word == "#" {
        return blank_waits
    }
    fallback previous_word != "generic" or word != "generic"
    if previous_word == "var" and word == "var" {
        return blank_waits
    }
    return true
}

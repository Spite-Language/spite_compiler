var source = ""
var starts = List<Integer>()
var ranks = List<Integer>()
var lines = List<String>()
var first_lines = List<Integer>()
var kept = List<String>()

func Printer(starting_source: String, starting_starts: List<Integer>, starting_ranks: List<Integer>) {
    source = starting_source
    starts = starting_starts
    ranks = starting_ranks
}

# ../../../spite_spec/specs/style.md#the-compiler-fixes-what-has-one-fix
func text(): String {
    var break_text = "\n"
    if source.contains("\r\n") {
        break_text = "\r\n"
    }
    var unbroken = source.replace("\r\n", "\n")
    lines = unbroken.split("\n")
    find_the_first_lines()
    kept = List<String>()
    var first = first_lines[0]
    crash first
    add_the_lines(0, first)
    var previous_rank = -1
    var rank = 0
    while rank <= 9 {
        var index = 0
        while index < starts.count() {
            var declared_rank = ranks[index]
            crash declared_rank
            if declared_rank == rank {
                add_a_declaration(index, previous_rank)
                previous_rank = rank
            }
            index = index + 1
        }
        rank = rank + 1
    }
    var joined = kept.join(break_text)
    return "{joined}{break_text}"
}

func find_the_first_lines() {
    first_lines = List<Integer>()
    var index = 0
    while index < starts.count() {
        var start = starts[index]
        crash start
        var first = start - 1
        while first > 0 and is_a_comment(first - 1) {
            first = first - 1
        }
        first_lines.append(first)
        index = index + 1
    }
}

func is_a_comment(at: Integer): Boolean {
    var written = lines[at]
    crash written
    return written.starts_with("#")
}

func add_a_declaration(index: Integer, previous_rank: Integer) {
    var first = first_lines[index]
    var rank = ranks[index]
    crash first
    crash rank
    var after = lines.count()
    if index + 1 < first_lines.count() {
        var next = first_lines[index + 1]
        crash next
        after = next
    }
    var opening = lines[first]
    crash opening
    var grouped = previous_rank == rank and (rank == 1 or rank == 5) and not opening.starts_with("#")
    if not kept.is_empty() and not grouped {
        kept.append("")
    }
    add_the_lines(first, after)
}

func add_the_lines(first: Integer, after: Integer) {
    var last = after
    while last > first and is_blank(last - 1) {
        last = last - 1
    }
    var index = first
    while index < last {
        var written = lines[index]
        crash written
        kept.append(written)
        index = index + 1
    }
}

func is_blank(at: Integer): Boolean {
    var written = lines[at]
    crash written
    return written.trim().is_empty()
}

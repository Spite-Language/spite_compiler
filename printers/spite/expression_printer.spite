union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

var printed: Expression? = null
var written_parts = List<String>()
var not_rank = 3
var minus_rank = 7
var postfix_rank = 8
var opposite_operators: Dictionary<AbstractSyntaxTree.Tokens.Token.Kind, String> = {
    'equal_equal': "!="
    'not_equal': "=="
    'less': ">="
    'greater': "<="
    'less_or_equal': ">"
    'greater_or_equal': "<"
}

func ExpressionPrinter(starting_expression: Expression?) {
    printed = starting_expression
}

func text(): String {
    crash printed
    return expression_text(printed, 0)
}

func opposite_text(): String {
    crash printed
    switch printed {
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return opposite_comparison_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return opposite_unary_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return negated_text(printed)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return negated_text(printed)
    }
}

func opposite_comparison_text(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    var flipped = opposite_operator_text(binary.operator)
    if flipped.is_empty() {
        return negated_text(binary)
    }
    var own = rank_of(binary.operator)
    var left = expression_text(binary.left, own)
    var right = expression_text(binary.right, own + 1)
    return "{left} {flipped} {right}"
}

func opposite_unary_text(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression): String {
    if unary.operator == 'not' {
        return expression_text(unary.operand, 0)
    }
    return negated_text(unary)
}

func negated_text(expression: Expression): String {
    var negated = expression_text(expression, not_rank)
    return "not {negated}"
}

func opposite_operator_text(operator: AbstractSyntaxTree.Tokens.Token.Kind): String {
    var opposite = opposite_operators[operator]
    fallback opposite
    return opposite
}

func expression_text(expression: Expression?, outer: Integer): String {
    crash expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return identifier_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return literal_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return text_literal_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return member_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return call_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return index_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return binary_text(expression, outer)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return unary_text(expression, outer)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return list_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return dictionary_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return entry_text(expression)
    }
}

func identifier_text(identifier: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression): String {
    var types = generic_text(identifier.generic_arguments)
    return "{identifier.name}{types}"
}

func literal_text(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'symbol_literal' {
        return "'{literal.text}'"
    }
    return literal.text
}

func text_literal_text(literal: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var outer = written_parts
    written_parts = List<String>()
    literal.pieces.each(write_piece)
    var joined = written_parts.join("")
    written_parts = outer
    return "\"{joined}\""
}

func write_piece(piece: AbstractSyntaxTree.Shapes.Expressions.TextPiece) {
    written_parts.append(piece.text)
    fallback piece.hole
    var hole = expression_text(piece.hole, 0)
    written_parts.append("\{{hole}}")
}

func member_text(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var target = expression_text(member.target, postfix_rank)
    return "{target}.{member.name}"
}

func call_text(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var callee = expression_text(call.callee, postfix_rank)
    var types = generic_text(call.generic_arguments)
    var arguments = joined_texts(call.arguments)
    return "{callee}{types}({arguments})"
}

func generic_text(arguments: List<AbstractSyntaxTree.Shapes.Types.GenericArgument>): String {
    fallback not arguments.is_empty()
    var outer = written_parts
    written_parts = List<String>()
    arguments.each(write_generic_argument)
    var joined = written_parts.join(", ")
    written_parts = outer
    return "<{joined}>"
}

func write_generic_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.type_reference {
        var types = Printers.Spite.TypePrinter(argument.type_reference)
        var written = types.text()
        written_parts.append(written)
    } else {
        written_parts.append(argument.text)
    }
}

func index_text(index: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    var target = expression_text(index.target, postfix_rank)
    var position = expression_text(index.index, 0)
    return "{target}[{position}]"
}

func binary_text(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression, outer: Integer): String {
    var own = rank_of(binary.operator)
    var left = expression_text(binary.left, own)
    var right = expression_text(binary.right, own + 1)
    var operator = operator_text(binary.operator)
    return grouped_if("{left} {operator} {right}", own, outer)
}

func unary_text(unary: AbstractSyntaxTree.Shapes.Expressions.UnaryExpression, outer: Integer): String {
    if unary.operator == 'not' {
        var negated = expression_text(unary.operand, not_rank)
        return grouped_if("not {negated}", not_rank, outer)
    }
    var operand = expression_text(unary.operand, minus_rank)
    return grouped_if("-{operand}", minus_rank, outer)
}

func grouped_if(written: String, own: Integer, outer: Integer): String {
    if own < outer {
        return "({written})"
    }
    return written
}

func list_text(list: AbstractSyntaxTree.Shapes.Expressions.ListLiteral): String {
    var entries = joined_texts(list.entries)
    return "[{entries}]"
}

func dictionary_text(dictionary: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral): String {
    var pairs = joined_texts(dictionary.pairs)
    return "\{{pairs}}"
}

func entry_text(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral): String {
    var key = expression_text(entry.key, 0)
    var value = expression_text(entry.value, 0)
    return "{key}: {value}"
}

func joined_texts(expressions: List<Expression>): String {
    var outer = written_parts
    written_parts = List<String>()
    expressions.each(write_expression)
    var joined = written_parts.join(", ")
    written_parts = outer
    return joined
}

func write_expression(expression: Expression) {
    var written = expression_text(expression, 0)
    written_parts.append(written)
}

func rank_of(operator: AbstractSyntaxTree.Tokens.Token.Kind): Integer {
    switch operator {
        'or': return 1
        'and': return 2
        'plus': return 5
        'minus': return 5
        'star': return 6
        'slash': return 6
        'percent': return 6
        'end_of_file': return 4
        'name': return 4
        'class_name': return 4
        'generic_name': return 4
        'integer_literal': return 4
        'decimal_literal': return 4
        'text_literal': return 4
        'symbol_literal': return 4
        'open_brace': return 4
        'close_brace': return 4
        'open_parenthesis': return 4
        'close_parenthesis': return 4
        'open_bracket': return 4
        'close_bracket': return 4
        'comma': return 4
        'dot': return 4
        'dots': return 4
        'colon': return 4
        'question': return 4
        'equals': return 4
        'equal_equal': return 4
        'not_equal': return 4
        'less': return 4
        'greater': return 4
        'less_or_equal': return 4
        'greater_or_equal': return 4
        'not': return 4
        'keyword_function': return 4
        'keyword_variable': return 4
        'keyword_enum': return 4
        'keyword_union': return 4
        'keyword_type': return 4
        'keyword_return': return 4
        'keyword_if': return 4
        'keyword_else': return 4
        'keyword_while': return 4
        'keyword_switch': return 4
        'keyword_fallback': return 4
        'keyword_crash': return 4
        'keyword_load': return 4
        'keyword_this': return 4
        'keyword_null': return 4
        'keyword_true': return 4
        'keyword_false': return 4
        'keyword_generic': return 4
        'keyword_singleton': return 4
    }
}

func operator_text(operator: AbstractSyntaxTree.Tokens.Token.Kind): String {
    switch operator {
        'or': return "or"
        'and': return "and"
        'plus': return "+"
        'minus': return "-"
        'star': return "*"
        'slash': return "/"
        'percent': return "%"
        'equal_equal': return "=="
        'not_equal': return "!="
        'less': return "<"
        'greater': return ">"
        'less_or_equal': return "<="
        'greater_or_equal': return ">="
        'end_of_file': return "?"
        'name': return "?"
        'class_name': return "?"
        'generic_name': return "?"
        'integer_literal': return "?"
        'decimal_literal': return "?"
        'text_literal': return "?"
        'symbol_literal': return "?"
        'open_brace': return "?"
        'close_brace': return "?"
        'open_parenthesis': return "?"
        'close_parenthesis': return "?"
        'open_bracket': return "?"
        'close_bracket': return "?"
        'comma': return "?"
        'dot': return "?"
        'dots': return "?"
        'colon': return "?"
        'question': return "?"
        'equals': return "?"
        'not': return "?"
        'keyword_function': return "?"
        'keyword_variable': return "?"
        'keyword_enum': return "?"
        'keyword_union': return "?"
        'keyword_type': return "?"
        'keyword_return': return "?"
        'keyword_if': return "?"
        'keyword_else': return "?"
        'keyword_while': return "?"
        'keyword_switch': return "?"
        'keyword_fallback': return "?"
        'keyword_crash': return "?"
        'keyword_load': return "?"
        'keyword_this': return "?"
        'keyword_null': return "?"
        'keyword_true': return "?"
        'keyword_false': return "?"
        'keyword_generic': return "?"
        'keyword_singleton': return "?"
    }
}

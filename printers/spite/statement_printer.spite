var lines = List<String>()
var indent = ""
var lays_out_a_file = false
var printed: SpiteCompiler.WrittenStatement?

func StatementPrinter(starting_statement: SpiteCompiler.WrittenStatement) {
    printed = starting_statement
}

func text(): String {
    crash printed
    lines = List<String>()
    indent = ""
    print_statement(printed)
    return lines.join("\n")
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func lines_inside(block: AbstractSyntaxTree.Shapes.Statements.Block): List<String> {
    lines = List<String>()
    indent = ""
    print_inside(block)
    return lines
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func lines_at(starting_indent: String): List<String> {
    crash printed
    lines = List<String>()
    indent = starting_indent
    print_statement(printed)
    return lines
}

func print_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: print_expression_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: print_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: print_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: print_return(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: print_if(statement, "if")
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: print_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: print_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: print_assert(statement)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: print_crash(statement)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: print_load(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: print_block(statement)
    }
}

func print_expression_statement(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    add_value("", statement.value, "")
}

func print_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    if statement.markup {
        var prefix = "var {statement.name} = "
        if statement.declared_type {
            var declared = Printers.Spite.TypePrinter(statement.declared_type)
            var shown_type = declared.text()
            prefix = "var {statement.name}: {shown_type} = "
        }
        add_markup(prefix, statement.markup)
        return
    }
    if statement.declared_type {
        var types = Printers.Spite.TypePrinter(statement.declared_type)
        var written_type = types.text()
        add_value("var {statement.name}: {written_type} = ", statement.value, "")
    } else {
        add_value("var {statement.name} = ", statement.value, "")
    }
}

func print_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    var target = expression_text(statement.target)
    add_value("{target} = ", statement.value, "")
}

func print_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    if statement.markup {
        add_markup("return ", statement.markup)
        return
    }
    if statement.value {
        add_value("return ", statement.value, "")
    } else {
        add("return")
    }
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func add_value(prefix: String, value: SpiteCompiler.Expression?, suffix: String) {
    var breaking = Printers.Spite.LineBreaking()
    breaking.indent = indent
    breaking.breaks_long_lines = lays_out_a_file
    breaking.add_value(prefix, value, suffix)
    breaking.lines.each(add_a_laid_out_line)
}

# ../../../spite_documentation/markup.md#how-it-is-written
func add_markup(prefix: String, element: AbstractSyntaxTree.Shapes.Markup.Element) {
    var printing = Printers.Spite.MarkupPrinter()
    printing.indent = indent
    printing.breaks_long_lines = lays_out_a_file
    printing.add_element(prefix, element)
    printing.lines.each(add_a_laid_out_line)
}

func add_a_laid_out_line(line: String) {
    lines.append(line)
}

func is_empty(block: AbstractSyntaxTree.Shapes.Statements.Block?): Boolean {
    crash block
    return lays_out_a_file and block.statements.is_empty()
}

func print_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement, opening: String) {
    var condition = expression_text(statement.condition)
    if not has_an_else(statement) and is_empty(statement.then_branch) {
        add("{opening} {condition} \{ }")
        return
    }
    add("{opening} {condition} \{")
    print_inside(statement.then_branch)
    if statement.else_branch {
        print_else(statement.else_branch)
    } else {
        add("}")
    }
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func has_an_else(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement): Boolean {
    fallback statement.else_branch
    return not statement.else_branch.statements.is_empty()
}

func print_else(else_branch: AbstractSyntaxTree.Shapes.Statements.Block) {
    if else_branch.statements.is_empty() {
        add("}")
        return
    }
    var first = else_branch.statements[0]
    var links = else_branch.statements.count() == 1 and first.class == AbstractSyntaxTree.Shapes.Statements.IfStatement
    if else_branch.is_an_else_if and links {
        print_else_if(else_branch)
        return
    }
    add("} else \{")
    print_inside(else_branch)
    add("}")
}

func print_else_if(else_branch: AbstractSyntaxTree.Shapes.Statements.Block) {
    var link = else_branch.statements[0]
    if link.class == AbstractSyntaxTree.Shapes.Statements.IfStatement {
        print_if(link, "} else if")
    }
}

func print_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    var condition = expression_text(statement.condition)
    if is_empty(statement.body) {
        add("while {condition} \{ }")
        return
    }
    add("while {condition} \{")
    print_inside(statement.body)
    add("}")
}

func print_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var value = expression_text(statement.value)
    add("switch {value} \{")
    var outer = indent
    indent = "{indent}    "
    statement.cases.each(print_case)
    indent = outer
    add("}")
}

func print_case(switch_case: AbstractSyntaxTree.Shapes.Statements.SwitchCase) {
    var value = expression_text(switch_case.value)
    crash switch_case.body
    var only = switch_case.body.statements[0]
    if switch_case.body.statements.count() == 1 and only {
        var one_line = StatementPrinter(only)
        one_line.lays_out_a_file = lays_out_a_file
        var written = one_line.lines_at(indent)
        var first = written[0]
        crash first
        var start = indent.length()
        var end = first.length()
        var opening = first.slice(start, end)
        crash opening
        add("{value}: {opening}")
        written.remove_at(0)
        written.each(add_a_laid_out_line)
        return
    }
    add("{value}: \{")
    print_inside(switch_case.body)
    add("}")
}

func print_assert(statement: AbstractSyntaxTree.Shapes.Statements.FallbackStatement) {
    var condition = expression_text(statement.condition)
    add("fallback {condition}")
}

func print_crash(statement: AbstractSyntaxTree.Shapes.Statements.CrashStatement) {
    var condition = expression_text(statement.condition)
    if lays_out_a_file and condition == "false" {
        add("crash")
        return
    }
    add("crash {condition}")
}

func print_load(statement: AbstractSyntaxTree.Shapes.Statements.LoadStatement) {
    var folder = expression_text(statement.folder)
    add("load {folder}")
}

func print_block(block: AbstractSyntaxTree.Shapes.Statements.Block) {
    if is_empty(block) {
        add("\{ }")
        return
    }
    add("\{")
    print_inside(block)
    add("}")
}

func print_inside(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    crash block
    var outer = indent
    indent = "{indent}    "
    block.statements.each(print_statement)
    indent = outer
}

func expression_text(expression: SpiteCompiler.Expression?): String {
    crash expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    printer.keeps_the_spelling = lays_out_a_file
    return printer.text()
}

func add(line: String) {
    lines.append("{indent}{line}")
}

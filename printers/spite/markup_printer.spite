var lines = List<String>()
var indent = ""
var breaks_long_lines = false
var widest = 120
var step = "    "

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func add_element(prefix: String, element: AbstractSyntaxTree.Shapes.Markup.Element) {
    var written = List<String>()
    var index = 0
    while index < element.written_attributes.count() {
        var attribute = element.written_attributes[index]
        var shown = attribute_text(attribute)
        written.append(shown)
        index = index + 1
    }
    var closer = ">"
    if element.children.is_empty() {
        closer = "/>"
    }
    var opening = "{prefix}<{element.tag}"
    var flat = opening
    if not written.is_empty() {
        var joined = written.join(" ")
        flat = "{opening} {joined}"
    }
    var inline = inline_text(element)
    if not inline.is_empty() and fits("{flat}>{inline}</{element.tag}>") {
        add("{flat}>{inline}</{element.tag}>")
        return
    }
    if written.is_empty() or fits("{flat}{closer}") {
        add("{flat}{closer}")
    } else {
        add(opening)
        deeper()
        written.each(add)
        shallower()
        add(closer)
    }
    fallback not element.children.is_empty()
    deeper()
    var filling = AbstractSyntaxTree.Markup.Children(element.children)
    var runs = filling.runs()
    runs.each(add_a_run)
    shallower()
    add("</{element.tag}>")
}

func attribute_text(attribute: AbstractSyntaxTree.Shapes.Markup.Attribute): String {
    if not attribute.value {
        return attribute.name
    }
    var shown = expression_text(attribute.value)
    if attribute.value.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral {
        return "{attribute.name}={shown}"
    }
    if attribute.value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and attribute.value.kind == 'symbol_literal' {
        return "{attribute.name}={shown}"
    }
    return "{attribute.name}=\{{shown}}"
}

# ../../../spite_documentation/markup.md#how-it-is-written
func inline_text(element: AbstractSyntaxTree.Shapes.Markup.Element): String {
    var filling = AbstractSyntaxTree.Markup.Children(element.children)
    var runs = filling.runs()
    fallback runs.count() == 1 and filling.holds_text()
    var only = runs[0]
    return run_text(only, filling)
}

# ../../../spite_documentation/markup.md#text-between-tags
func add_a_run(run: List<AbstractSyntaxTree.Shapes.Markup.Child>) {
    var first = run[0]
    crash first
    if first.element {
        add_element("", first.element)
        return
    }
    var filling = AbstractSyntaxTree.Markup.Children(run)
    if not filling.holds_text() {
        run.each(add_a_hole)
        return
    }
    var shown = run_text(run, filling)
    add(shown)
}

func run_text(run: List<AbstractSyntaxTree.Shapes.Markup.Child>, filling: AbstractSyntaxTree.Markup.Children): String {
    var pieces = List<String>()
    var index = 0
    while index < run.count() {
        var child = run[index]
        var piece = piece_of(child, filling)
        pieces.append(piece)
        index = index + 1
    }
    var joined = pieces.join("")
    return joined.trim()
}

func piece_of(child: AbstractSyntaxTree.Shapes.Markup.Child, filling: AbstractSyntaxTree.Markup.Children): String {
    if child.kind == 'text' {
        return filling.spaced(child.text)
    }
    var shown = expression_text(child.expression)
    return "\{{shown}}"
}

func add_a_hole(child: AbstractSyntaxTree.Shapes.Markup.Child) {
    var shown = expression_text(child.expression)
    add("\{{shown}}")
}

func expression_text(expression: SpiteCompiler.Expression?): String {
    crash expression
    var printer = Printers.Spite.ExpressionPrinter(expression)
    printer.keeps_the_spelling = breaks_long_lines
    return printer.text()
}

func add(line: String) {
    lines.append("{indent}{line}")
}

func deeper() {
    indent = "{indent}{step}"
}

func shallower() {
    var end = indent.length() - step.length()
    var shorter = indent.slice(0, end)
    crash shorter
    indent = shorter
}

func fits(line: String): Boolean {
    return not breaks_long_lines or indent.length() + line.length() <= widest
}

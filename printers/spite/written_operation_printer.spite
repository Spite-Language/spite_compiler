var printed: HighIntermediaryRepresentation.Values.WrittenOperation?

# ../../ARCHITECTURE.md#an-operation-is-written-out-only-when-asked
func WrittenOperationPrinter(starting_written: HighIntermediaryRepresentation.Values.WrittenOperation?) {
    printed = starting_written
}

func text(): String {
    fallback printed
    if not printed.expression {
        return printed.whole
    }
    var printer = ExpressionPrinter(printed.expression)
    var shown = printer.text()
    return "{printed.before}{shown}"
}

func left_text(): String {
    fallback printed
    var sides = sides_of(printed)
    if not sides {
        return printed.left
    }
    var printer = ExpressionPrinter(sides.left)
    return printer.text()
}

func right_text(): String {
    fallback printed
    var sides = sides_of(printed)
    if not sides {
        return printed.right
    }
    var printer = ExpressionPrinter(sides.right)
    return printer.text()
}

func sides_of(
    operation: HighIntermediaryRepresentation.Values.WrittenOperation,
): AbstractSyntaxTree.Shapes.Expressions.BinaryExpression? {
    fallback operation.shows_its_sides
    var written = operation.expression
    fallback written.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    return written
}

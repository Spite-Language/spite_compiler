var lines = List<String>()
var indent = ""
var breaks_long_lines = false
var widest = 120
var step = "    "

# ../../../spite_spec/specs/style.md#formatting
func add(line: String) {
    lines.append("{indent}{line}")
}

func add_blank_line() {
    lines.append("")
}

func deeper() {
    indent = "{indent}{step}"
}

func shallower() {
    var end = indent.length() - step.length()
    var shorter = indent.slice(0, end)
    crash shorter
    indent = shorter
}

func fits(line: String): Boolean {
    return not breaks_long_lines or indent.length() + line.length() <= widest
}

# ../../../spite_spec/specs/style.md#formatting
func add_value(prefix: String, value: SpiteCompiler.Expression?, suffix: String) {
    crash value
    var printer = Printers.Spite.ExpressionPrinter(value)
    printer.keeps_the_spelling = breaks_long_lines
    var flat = printer.text()
    var line = "{prefix}{flat}{suffix}"
    if fits(line) {
        add(line)
        return
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression and not value.arguments.is_empty() {
        add_a_broken_call(prefix, value, suffix)
        return
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.ListLiteral and not value.entries.is_empty() {
        add_a_broken_list(prefix, value, suffix)
        return
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral and not value.pairs.is_empty() {
        add_a_broken_dictionary(prefix, value, suffix)
        return
    }
    add(line)
}

func add_a_broken_call(prefix: String, call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, suffix: String) {
    var printer = Printers.Spite.ExpressionPrinter(call.callee)
    printer.keeps_the_spelling = breaks_long_lines
    var callee = printer.callee_text(call)
    add("{prefix}{callee}(")
    deeper()
    call.arguments.each(add_an_argument)
    shallower()
    add("){suffix}")
}

func add_an_argument(argument: SpiteCompiler.Expression) {
    add_value("", argument, ",")
}

func add_a_broken_list(prefix: String, list: AbstractSyntaxTree.Shapes.Expressions.ListLiteral, suffix: String) {
    add("{prefix}[")
    deeper()
    list.entries.each(add_an_entry)
    shallower()
    add("]{suffix}")
}

func add_an_entry(entry: SpiteCompiler.Expression) {
    add_value("", entry, "")
}

func add_a_broken_dictionary(
    prefix: String,
    dictionary: AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral,
    suffix: String,
) {
    add("{prefix}\{")
    deeper()
    dictionary.pairs.each(add_an_entry)
    shallower()
    add("}{suffix}")
}

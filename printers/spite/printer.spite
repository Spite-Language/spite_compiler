var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var lines = List<String>()

func Printer(starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    file = starting_file
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func text(): String {
    lines = List<String>()
    file.heading.each(add_a_comment)
    file.misplaced_comments.each(add_a_misplaced_comment)
    var has_a_heading = not file.heading.is_empty() or not file.misplaced_comments.is_empty()
    if has_a_heading and not file.declarations.is_empty() {
        lines.append("")
    }
    var order = declaration_order()
    var index = 0
    while index < order.count() {
        var place = order[index]
        var declaration = file.declarations[place]
        crash declaration
        if index > 0 {
            var before = order[index - 1]
            crash before
            if needs_a_blank_line(place, before) {
                lines.append("")
            }
        }
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            declaration.comments.each(add_a_comment)
        }
        var printer = Printers.Spite.DeclarationPrinter(declaration)
        printer.lays_out_a_file = true
        var written = printer.text()
        lines.append(written)
        index = index + 1
    }
    var joined = lines.join("\n")
    return "{joined}\n"
}

func add_a_comment(comment: String) {
    lines.append("# {comment}")
}

func add_a_misplaced_comment(comment: AbstractSyntaxTree.Shapes.Comment) {
    lines.append("# {comment.text}")
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func declaration_order(): List<Integer> {
    var order = List<Integer>()
    var class_name = file.class_name()
    var rank = 0
    var last_rank = 10
    while rank <= last_rank {
        var index = 0
        while index < file.declarations.count() {
            var declaration = file.declarations[index]
            var declared_rank = file.rank_of(declaration, class_name)
            if declared_rank == rank {
                order.append(index)
            }
            index = index + 1
        }
        rank = rank + 1
    }
    return order
}

func needs_a_blank_line(place: Integer, before_place: Integer): Boolean {
    var declaration = file.declarations[place]
    var before = file.declarations[before_place]
    crash declaration
    crash before
    var is_a_generic = declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    var follows_a_generic = before.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    fallback not is_a_generic or not follows_a_generic
    var follows_the_singleton = before.class == AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    var is_kept = file.blank_before.contains(place) and before_place == place - 1
    return is_kept or follows_the_singleton or follows_a_generic or stands_apart(declaration) or stands_apart(before)
}

func stands_apart(declaration: SpiteCompiler.Declaration): Boolean {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return true
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return true
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return true
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: return false
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: return true
    }
}

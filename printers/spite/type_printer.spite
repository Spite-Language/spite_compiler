var printed: AbstractSyntaxTree.Shapes.Types.Type? = null
var written_arguments = List<String>()

func TypePrinter(starting_type: AbstractSyntaxTree.Shapes.Types.Type) {
    printed = starting_type
}

func text(): String {
    crash printed
    switch printed {
        AbstractSyntaxTree.Shapes.Types.NamedType: return named_text(printed)
    }
}

func named_text(named: AbstractSyntaxTree.Shapes.Types.NamedType): String {
    var name = named.path.join(".")
    if not named.arguments.is_empty() {
        written_arguments = List<String>()
        named.arguments.each(write_argument)
        var joined = written_arguments.join(", ")
        name = "{name}<{joined}>"
    }
    if named.is_nullable {
        return "{name}?"
    }
    return name
}

func write_argument(argument: AbstractSyntaxTree.Shapes.Types.GenericArgument) {
    if argument.is_type and argument.type_reference {
        var inner = TypePrinter(argument.type_reference)
        var written = inner.text()
        written_arguments.append(written)
    } else {
        written_arguments.append(argument.text)
    }
}

var printed: SpiteCompiler.Declaration? = null
var lines = List<String>()
var lays_out_a_file = false
var widest = 120

func DeclarationPrinter(starting_declaration: SpiteCompiler.Declaration) {
    printed = starting_declaration
}

func text(): String {
    lines = List<String>()
    crash printed
    print_declaration(printed)
    return lines.join("\n")
}

func print_declaration(declaration: SpiteCompiler.Declaration) {
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: lines.append("singleton")
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: print_generic(declaration)
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: print_enum(declaration)
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: print_union(declaration)
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: print_type(declaration)
        AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration: print_attribute(declaration)
        AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration: print_function(declaration)
    }
}

func print_generic(declaration: AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration) {
    if declaration.bound {
        var bound = type_text(declaration.bound)
        lines.append("generic {declaration.name}: {bound}")
    } else {
        lines.append("generic {declaration.name}")
    }
}

func print_enum(declaration: AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration) {
    lines.append("enum {declaration.name} \{")
    declaration.values.each(print_enum_value)
    lines.append("}")
}

func print_enum_value(value: AbstractSyntaxTree.Shapes.Declarations.EnumValue) {
    if value.number {
        var printer = ExpressionPrinter(value.number)
        var number = printer.text()
        lines.append("    '{value.name}' = {number}")
    } else {
        lines.append("    '{value.name}'")
    }
}

func print_union(declaration: AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration) {
    lines.append("union {declaration.name} \{")
    declaration.member_names.each(print_member_name)
    lines.append("}")
}

func print_member_name(name: String) {
    lines.append("    {name}")
}

func print_type(declaration: AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration) {
    lines.append("type {declaration.name} \{")
    declaration.members.each(print_type_member)
    lines.append("}")
}

func print_type_member(member: AbstractSyntaxTree.Shapes.Types.TypeMember) {
    var parameters = parameters_text(member.parameters)
    var answer = ""
    if member.result {
        var result = type_text(member.result)
        answer = ": {result}"
    }
    if member.is_an_attribute {
        lines.append("    {member.name}{answer}")
        return
    }
    lines.append("    {member.name}({parameters}){answer}")
}

func print_attribute(declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration) {
    var head = "var {declaration.name}"
    if declaration.declared_type {
        var shown = type_text(declaration.declared_type)
        head = "var {declaration.name}: {shown}"
    }
    if not declaration.value {
        lines.append(head)
        return
    }
    var prefix = "{head} = "
    var breaking = Printers.Spite.LineBreaking()
    breaking.breaks_long_lines = lays_out_a_file
    breaking.add_value(prefix, declaration.value, "")
    breaking.lines.each(add_a_line)
}

func add_a_line(line: String) {
    lines.append(line)
}

func print_function(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var parameters = parameters_text(declaration.parameters)
    var answer = ""
    if declaration.result {
        var result = type_text(declaration.result)
        answer = ": {result}"
        if lays_out_a_file and result == "Nothing" {
            answer = ""
        }
    }
    if not declaration.body {
        lines.append("func {declaration.name}({parameters}){answer}")
        return
    }
    if not lays_out_a_file {
        lines.append("func {declaration.name}({parameters}){answer} \{")
        declaration.body.statements.each(print_statement)
        lines.append("}")
        return
    }
    var opening = "func {declaration.name}({parameters}){answer} \{"
    if declaration.body.statements.is_empty() {
        lines.append("{opening} }")
        return
    }
    if opening.length() > widest and not declaration.parameters.is_empty() {
        lines.append("func {declaration.name}(")
        add_the_parameters(declaration.parameters)
        lines.append("){answer} \{")
    } else {
        lines.append(opening)
    }
    var first = declaration.body.statements[0]
    var printer = StatementPrinter(first)
    printer.lays_out_a_file = true
    var inside = printer.lines_inside(declaration.body)
    inside.each(add_a_line)
    lines.append("}")
}

# ../../../spite_documentation/style.md#what-the-formatter-rewrites
func add_the_parameters(parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>) {
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        var alone = List<AbstractSyntaxTree.Shapes.Declarations.Parameter>()
        alone.append(parameter)
        var written = parameters_text(alone)
        lines.append("    {written},")
        index = index + 1
    }
}

func print_statement(statement: SpiteCompiler.WrittenStatement) {
    var printer = StatementPrinter(statement)
    var written = printer.text()
    var statement_lines = written.split("\n")
    statement_lines.each(print_indented)
}

func print_indented(line: String) {
    lines.append("    {line}")
}

func parameters_text(parameters: List<AbstractSyntaxTree.Shapes.Declarations.Parameter>): String {
    var written = List<String>()
    var index = 0
    while index < parameters.count() {
        var parameter = parameters[index]
        crash parameter.declared_type
        var shown = type_text(parameter.declared_type)
        var dots = ""
        if parameter.is_variadic {
            dots = "..."
        }
        if parameter.name.is_empty() {
            written.append(shown)
        } else {
            written.append("{dots}{parameter.name}: {shown}")
        }
        index = index + 1
    }
    return written.join(", ")
}

func type_text(written: SpiteCompiler.Type?): String {
    crash written
    var printer = TypePrinter(written)
    return printer.text()
}

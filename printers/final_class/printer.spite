var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var links = Dictionary<String, String>()
var paths = Outputs.RelativePaths("")
var place = ""
var lines = List<String>()
var last_rank = 7

func Printer(
    starting_file: AbstractSyntaxTree.Shapes.SourceFile,
    starting_links: Dictionary<String, String>,
    starting_paths: Outputs.RelativePaths,
    starting_place: String,
) {
    file = starting_file
    links = starting_links
    paths = starting_paths
    place = starting_place
}

# ../../../spite_spec/specs/classes_and_files.md#files-are-classes
func text(): String {
    lines = List<String>()
    var rank = 0
    while rank <= last_rank {
        print_the_rank(rank)
        rank = rank + 1
    }
    var joined = lines.join("\n")
    return "{joined}\n"
}

func print_the_rank(rank: Integer) {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if rank_of(declaration) == rank {
            print_declaration(declaration)
        }
        index = index + 1
    }
}

func rank_of(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration): Integer {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        return function_rank_of(declaration)
    }
    switch declaration {
        AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration: return 0
        AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration: return 1
        AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration: return 2
        AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration: return 3
        AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration: return 4
        _: return 5
    }
}

func function_rank_of(declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration): Integer {
    var first = declaration.name.byte_at(0)
    var is_a_constructor = first >= 65 and first <= 90
    if is_a_constructor {
        return 6
    }
    return last_rank
}

func print_declaration(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration) {
    var supplied_by = supplier_of(declaration)
    var is_a_function = declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
    if is_a_function and not lines.is_empty() {
        lines.append("")
    }
    if not supplied_by.is_empty() {
        var link = links[supplied_by]
        crash link
        lines.append("# {link}")
    }
    var printer = Printers.Spite.DeclarationPrinter(declaration)
    var written = printer.text()
    if is_a_function and written.contains("load \"") {
        written = loads_moved(written, supplied_by)
    }
    lines.append(written)
}

# ../../../spite_documentation/compiler.md#inspect-merged-classes
func loads_moved(written: String, supplied_by: String): String {
    var segments = supplied_by.replace("\\", "/").split("/")
    segments.remove_last()
    var supplier_folder = segments.join("/")
    var moved = List<String>()
    var printed_lines = written.split("\n")
    var index = 0
    while index < printed_lines.count() {
        var line = printed_lines[index]
        var kept = load_moved(line, supplier_folder)
        moved.append(kept)
        index = index + 1
    }
    return moved.join("\n")
}

func load_moved(line: String, supplier_folder: String): String {
    var trimmed = line.trim()
    var is_a_load = trimmed.starts_with("load \"") and trimmed.ends_with("\"")
    if not is_a_load {
        return line
    }
    var length = trimmed.length()
    var loaded = trimmed.slice(6, length - 1)
    crash loaded
    var is_relative = not loaded.contains(":") and not loaded.contains("\{") and not loaded.starts_with("/")
    if not is_relative {
        return line
    }
    var indent_length = line.index_of("load")
    crash indent_length
    var indent = line.slice(0, indent_length)
    crash indent
    var target = "{supplier_folder}/{loaded}"
    var linked = paths.link(place, target)
    return "{indent}load \"{linked}\""
}

func supplier_of(declaration: AbstractSyntaxTree.Shapes.Declarations.Declaration): String {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        return declaration.path
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        return declaration.path
    }
    return ""
}

var pattern = ""
var function = ""
var class_key = ""
var binds_a_function_declaration = false

func BoundPattern(
    starting_pattern: String,
    starting_function: String,
    starting_class_key: String,
    starting_binds_a_function_declaration: Boolean,
) {
    pattern = starting_pattern
    function = starting_function
    class_key = starting_class_key
    binds_a_function_declaration = starting_binds_a_function_declaration
}

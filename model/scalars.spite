func of(name: String): Scalar? {
    if name == "Boolean" {
        return Scalar(name, 1, false, false)
    } else if name == "Tiny" {
        return Scalar(name, 1, true, false)
    } else if name == "Byte" {
        return Scalar(name, 1, false, false)
    } else if name == "Short" {
        return Scalar(name, 2, true, false)
    } else if name == "UnsignedShort" {
        return Scalar(name, 2, false, false)
    } else if name == "Integer" {
        return Scalar(name, 4, true, false)
    } else if name == "UnsignedInteger" {
        return Scalar(name, 4, false, false)
    } else if name == "Long" {
        return Scalar(name, 8, true, false)
    } else if name == "UnsignedLong" {
        return Scalar(name, 8, false, false)
    } else if name == "Float" {
        return Scalar(name, 4, true, true)
    } else if name == "Double" {
        return Scalar(name, 8, true, true)
    } else {
        return null
    }
}

func is_a_scalar(name: String): Boolean {
    var found = of(name)
    if found {
        return true
    }
    return false
}

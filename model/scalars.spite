func of(name: String): Scalar? {
    switch name {
        "Boolean": return Scalar(name, 1, false, false)
        "Tiny": return Scalar(name, 1, true, false)
        "Byte": return Scalar(name, 1, false, false)
        "Short": return Scalar(name, 2, true, false)
        "UnsignedShort": return Scalar(name, 2, false, false)
        "Integer": return Scalar(name, 4, true, false)
        "UnsignedInteger": return Scalar(name, 4, false, false)
        "Long": return Scalar(name, 8, true, false)
        "UnsignedLong": return Scalar(name, 8, false, false)
        "Float": return Scalar(name, 4, true, true)
        "Double": return Scalar(name, 8, true, true)
        _: return null
    }
}

func is_a_scalar(name: String): Boolean {
    var found = of(name)
    if found {
        return true
    }
    return false
}

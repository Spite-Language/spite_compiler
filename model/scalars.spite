singleton

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var map = Mapping.FolderMap()
var library = Validators.LibraryFile()
var known = Dictionary<String, Scalar>()
var not_numbers = List<String>()
var declared_attributes = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
var parameter_name = ""
var smallest = ""
var largest = ""
var is_decimal = false
var has_arithmetic = false
var _bits_per_byte = 8
var _single_precision_whole_bits = 128
var _zero_code = 48

# ../../spite_spec/specs/values_and_types.md#a-number-states-its-range
func use_the_map(folders: Mapping.FolderMap) {
    map = folders
}

func of(name: String): Scalar? {
    var found = known[name]
    if found {
        return found
    }
    fallback not not_numbers.contains(name)
    var files = map.classes_by_namespace[name]
    fallback files
    read_the_class(name, files)
    return known[name]
}

func is_a_scalar(name: String): Boolean {
    var found = of(name)
    if found {
        return true
    }
    return false
}

func read_the_class(name: String, files: List<Mapping.ClassFile>) {
    var index = 0
    while index < files.count() {
        var class_file = files[index]
        if library.holds_the_class(class_file) {
            read_a_file(name, class_file)
        }
        index = index + 1
    }
    if not known.contains(name) {
        not_numbers.append(name)
    }
}

func read_a_file(name: String, class_file: Mapping.ClassFile) {
    var file = File(class_file.path)
    var text = file.read_as_string()
    fallback text and text.contains("func _set_this(")
    var parsing = AbstractSyntaxTree.AbstractSyntaxTree(class_file.path, class_file.namespace, text)
    var tree = parsing.run()
    declared_attributes = List<AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration>()
    has_arithmetic = false
    var index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
            declared_attributes.append(declaration)
        }
        index = index + 1
    }
    index = 0
    while index < tree.declarations.count() {
        var declaration = tree.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
            read_a_function(name, declaration)
        }
        index = index + 1
    }
    var found = known[name]
    fallback found
    found.is_a_number = has_arithmetic
}

func read_a_function(name: String, function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    if function.name == "sum" {
        has_arithmetic = true
    }
    if function.name == "_set_this" {
        read_the_range(name, function)
    }
}

func read_the_range(name: String, function: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var only = function.parameters[0]
    crash only
    crash function.body
    parameter_name = only.name
    smallest = ""
    largest = ""
    is_decimal = false
    function.body.statements.each(read_a_statement)
    crash not smallest.is_empty() and not largest.is_empty()
    var is_signed = smallest.starts_with("-")
    var size = size_of(is_signed)
    var scalar = Scalar(name, size, is_signed, is_decimal)
    known[name] = scalar
}

func read_a_statement(statement: Statement) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.CrashStatement {
        read_a_condition(statement.condition)
    }
}

func read_a_condition(condition: Expression?) {
    fallback condition.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    if condition.operator == 'and' {
        read_a_condition(condition.left)
        read_a_condition(condition.right)
        return
    }
    var reads_the_parameter = names_the_parameter(condition.left)
    fallback reads_the_parameter
    var bound = bound_of(condition.right)
    if condition.operator == 'greater_or_equal' {
        smallest = bound
    }
    if condition.operator == 'less_or_equal' {
        largest = bound
    }
}

func names_the_parameter(expression: Expression?): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == parameter_name
    }
    return false
}

func bound_of(expression: Expression?): String {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var attribute = attribute_named(expression.name)
        crash attribute
        return bound_of(attribute.value)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression {
        crash expression.operator == 'minus'
        var left = bound_of(expression.left)
        var right = bound_of(expression.right)
        crash right == "1" and left.starts_with("-")
        var magnitude = left.replace("-", "")
        var larger = increased(magnitude)
        return "-{larger}"
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.UnaryExpression {
        var magnitude = bound_of(expression.operand)
        return "-{magnitude}"
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        if expression.kind == 'decimal_literal' {
            is_decimal = true
        }
        return expression.text.replace("_", "")
    }
    return ""
}

func attribute_named(wanted: String): AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration? {
    return declared_attributes.find_by_name(wanted)
}

func size_of(is_signed: Boolean): Integer {
    var largest_whole = whole_part(largest)
    var bits = bits_of(largest_whole)
    if is_decimal {
        if bits <= _single_precision_whole_bits {
            return 4
        }
        return 8
    }
    if is_signed {
        var smallest_whole = whole_part(smallest)
        var magnitude = smallest_whole.replace("-", "")
        var magnitude_bits = bits_of(magnitude)
        if is_a_power_of_two(magnitude) {
            magnitude_bits = magnitude_bits - 1
        }
        if magnitude_bits > bits {
            bits = magnitude_bits
        }
        bits = bits + 1
    }
    var size = 1
    while size * _bits_per_byte < bits {
        size = size * 2
    }
    crash size <= 8
    return size
}

func whole_part(text: String): String {
    var parts = text.split(".")
    var whole = parts[0]
    crash whole
    return whole
}

func bits_of(digits: String): Integer {
    var rest = digits
    var bits = 0
    while not rest.is_empty() and rest != "0" {
        rest = halved(rest)
        bits = bits + 1
    }
    return bits
}

func is_a_power_of_two(digits: String): Boolean {
    var rest = digits
    while rest != "1" {
        fallback not rest.is_empty()
        var last_index = rest.length() - 1
        var last = rest.byte_at(last_index)
        var is_even = (last - _zero_code) % 2 == 0
        fallback is_even
        rest = halved(rest)
    }
    return true
}

func halved(digits: String): String {
    var result = ""
    var carry = 0
    var index = 0
    while index < digits.length() {
        var digit = digits.byte_at(index) - _zero_code
        var current = carry * 10 + digit
        var half = current / 2
        carry = current - half * 2
        if not result.is_empty() or half > 0 {
            result = "{result}{half}"
        }
        index = index + 1
    }
    return result
}

func increased(digits: String): String {
    var result = ""
    var carry = 1
    var index = digits.length() - 1
    while index >= 0 {
        var digit = digits.byte_at(index) - _zero_code + carry
        carry = 0
        if digit == 10 {
            digit = 0
            carry = 1
        }
        result = "{digit}{result}"
        index = index - 1
    }
    if carry == 1 {
        result = "1{result}"
    }
    return result
}

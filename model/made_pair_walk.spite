var followed = List<String>()
var reads_this = false
var leaves = false
var names: List<String>
var links: List<String>
var classes: List<ClassModel>

func MadePairWalk(pair_names: List<String>, pair_links: List<String>, pair_classes: List<ClassModel>) {
    names = pair_names
    links = pair_links
    classes = pair_classes
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_the_function(body: AbstractSyntaxTree.Shapes.Statements.Block?) {
    read_the_constructors()
    read_block(body)
}

func read_the_constructors() {
    classes.each(read_the_constructors_of)
}

func read_the_constructors_of(model: ClassModel) {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.is_a_constructor() {
            read_a_method(function)
        }
        index = index + 1
    }
}

func read_a_method(function: FunctionModel) {
    var key = function.key()
    fallback not followed.contains(key)
    followed.append(key)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var outer_names = names
    var outer_reads_this = reads_this
    names = List<String>()
    reads_this = true
    read_block(declaration.body)
    names = outer_names
    reads_this = outer_reads_this
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_a_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_an_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read(statement.value, false)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: read(statement.value, true)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: read(statement.condition, false)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: read(statement.condition, false)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func read_a_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    if statement.value and may_be_of_the_pair(statement.value) {
        names.append(statement.name)
        return
    }
    read(statement.value, true)
}

# ../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = statement
    while link {
        var current = link
        read(current.condition, false)
        read_block(current.then_branch)
        link = current.else_if()
        if not link {
            read_block(current.else_branch)
        }
    }
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    read(statement.condition, false)
    read_block(statement.body)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    read(statement.value, false)
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_block(switch_case.body)
        index = index + 1
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_an_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    var target = statement.target
    fallback not is_the_link(target, statement.value)
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_written_name(target.name)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        read_a_written_member(target)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        read(target.target, false)
        read(target.index, true)
    }
    read(statement.value, true)
}

func read_a_written_name(name: String) {
    if names.contains(name) {
        leaves = true
    }
    if reads_this and links.contains(name) {
        leaves = true
    }
}

func read_a_written_member(target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    if links.contains(target.name) {
        leaves = true
    }
    read(target.target, false)
}

func is_the_link(target: SpiteCompiler.Expression, value: SpiteCompiler.Expression?): Boolean {
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback links.contains(target.name)
    fallback target.target and value
    fallback target.target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    fallback value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    return names.contains(target.target.name) and names.contains(value.name) and target.target.name != value.name
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func may_be_of_the_pair(expression: SpiteCompiler.Expression): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        if names.contains(expression.name) {
            return true
        }
        return reads_this and links.contains(expression.name)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression {
        return reads_this and expression.kind == 'keyword_this'
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return links.contains(expression.name)
    }
    return false
}

func read(expression: SpiteCompiler.Expression?, is_used: Boolean) {
    fallback expression
    if may_be_of_the_pair(expression) {
        if is_used {
            leaves = true
        }
        return
    }
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: read_a_name(expression.name, is_used)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: read_a_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_a_member(expression, is_used)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: read_a_call(expression, is_used)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: read_an_item(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: read_both_sides(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: read(expression.operand, true)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: read_each(expression.entries)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: read_each(expression.pairs)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: read_an_entry(expression)
    }
}

func read_a_name(name: String, is_used: Boolean) {
    fallback reads_this and is_used
    if is_a_function_of_the_pair(name) {
        leaves = true
    }
}

func read_a_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral) {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        read(piece.hole, true)
        index = index + 1
    }
}

func read_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, is_used: Boolean) {
    crash member.target
    if not may_be_of_the_pair(member.target) {
        read(member.target, false)
        return
    }
    if is_used and not is_an_attribute_of_the_pair(member.name) {
        leaves = true
    }
}

func read_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, is_used: Boolean) {
    read_each(call.arguments)
    crash call.callee
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        crash callee.target
        if may_be_of_the_pair(callee.target) {
            read_a_call_on_the_pair(callee.name, is_used)
        } else {
            read(callee.target, false)
        }
        return
    }
    fallback reads_this
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        read_a_call_on_the_pair(callee.name, is_used)
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_a_call_on_the_pair(name: String, is_used: Boolean) {
    var is_found = false
    var index = 0
    while index < classes.count() {
        var model = classes[index]
        var function = model.function_named(name)
        if function {
            is_found = true
            if is_used and may_answer_an_object(function) {
                leaves = true
            }
            read_a_method(function)
        }
        index = index + 1
    }
    if not is_found {
        leaves = true
    }
}

func may_answer_an_object(function: FunctionModel): Boolean {
    fallback function.answer
    var is_a_plain_value = function.answer.kind == 'nothing' or function.answer.kind == 'scalar' or function.answer.kind == 'enumeration'
    var is_a_text = function.answer.kind == 'object' and function.answer.name == "String"
    return not is_a_plain_value and not is_a_text
}

func is_a_function_of_the_pair(name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var model = classes[index]
        if model.function_named(name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_an_attribute_of_the_pair(name: String): Boolean {
    var index = 0
    while index < classes.count() {
        var model = classes[index]
        if model.attribute_named(name) {
            return true
        }
        index = index + 1
    }
    return false
}

func read_an_item(item: AbstractSyntaxTree.Shapes.Expressions.IndexExpression) {
    read(item.target, false)
    read(item.index, true)
}

# ../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func read_both_sides(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression) {
    var links = [binary]
    var lowest = binary
    var next = read_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = read_left_link_of(lowest)
    }
    read(lowest.left, true)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        read(link.right, true)
        index = index - 1
    }
}

func read_left_link_of(
    binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression,
): AbstractSyntaxTree.Shapes.Expressions.BinaryExpression? {
    var left = binary.left
    fallback left.class == AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    return left
}

func read_an_entry(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral) {
    read(entry.key, true)
    read(entry.value, true)
}

func read_each(expressions: List<SpiteCompiler.Expression>) {
    var index = 0
    while index < expressions.count() {
        var expression = expressions[index]
        read(expression, true)
        index = index + 1
    }
}

var counts = Dictionary<String, Integer>()
var blocks = Dictionary<String, Integer>()
var block_count = 0

# ../PROOFS.md#a-pair-linked-through-one-attribute-is-cleared-when-it-goes
func read_the_body(body: AbstractSyntaxTree.Shapes.Statements.Block?) {
    read_block(body)
}

func is_declared_once(name: String): Boolean {
    var count = counts[name]
    fallback count
    return count == 1
}

func share_a_block(first: String, second: String): Boolean {
    var first_block = blocks[first]
    var second_block = blocks[second]
    fallback first_block and second_block
    return first_block == second_block
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block_count = block_count + 1
    var number = block_count
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        read_statement(statement, number)
        index = index + 1
    }
}

func read_statement(statement: SpiteCompiler.WrittenStatement, number: Integer) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: note_a_declaration(statement.name, number)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func note_a_declaration(name: String, number: Integer) {
    var count = counts[name]
    var total = 1
    if count {
        total = count + 1
    }
    counts[name] = total
    blocks[name] = number
}

# ../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = statement
    while link {
        var current = link
        read_block(current.then_branch)
        link = current.else_if()
        if link {
            block_count = block_count + 1
        } else {
            read_block(current.else_branch)
        }
    }
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_block(switch_case.body)
        index = index + 1
    }
}

var name = ""
var owner = ""
var parameters = List<ParameterModel>()
var answer: Type? = null
var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var declared: DeclaredFunction? = null
var is_an_attribute = false
var is_a_function_member = false
var is_a_member_template = false
var bound_member = ""
var bound_member_type: Type? = null
var bound_member_is_a_function = false
var template_index = -1
var bound_parameter = ""
var bound_member_index = 0
var bound_shape = ""
var bound_pattern = ""
var bound_function = ""
var bound_class = ""
var compared_value: Type? = null
var compared_number: Long = 0
var chained_function = ""
var fused: FusedStep? = null
var is_synthetic = false
var is_written_by_the_compiler = false
var placed_at_line = 0
var walked_object: Type? = null
var is_a_walk_copy = false
var walked_declarations_of = ""
var known_parameter_functions = Dictionary<String, FunctionModel>()
var inferred_owner: Type? = null
var narrowed_names = List<String>()
var binds_a_function_declaration = false
var binds_a_class = false
var known_reflections = Dictionary<String, String>()
var known_arguments: Dictionary<String, KnownValue>? = null
var known_depth = 0

func FunctionModel(starting_name: String, starting_owner: String) {
    name = starting_name
    owner = starting_owner
}

func is_a_constructor(): Boolean {
    fallback declared
    return declared.is_constructor
}

func reflects_its_answer(): Boolean {
    fallback declared
    return declared.reflected_answer_index >= 0
}

func key(): String {
    return "{owner}.{name}"
}

# ../PROOFS.md#a-condition-known-while-compiling-is-an-error
func is_walked(): Boolean {
    return is_a_walk_copy or not bound_parameter.is_empty() or not bound_member.is_empty()
}

func has_a_body(): Boolean {
    if is_synthetic {
        return true
    }
    fallback not is_written_by_the_compiler and declaration
    if declaration.body {
        return true
    }
    return false
}

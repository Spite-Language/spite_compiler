var parameters = List<ParameterModel>()
var known_parameter_functions = Dictionary<String, FunctionModel>()
var placed_at_line = 0
var inferred_owner: Type? = null
var narrowed_names = List<String>()
var name: String
var owner: String
var answer: Type?
var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration?
var declared: DeclaredFunction?
var binding: TemplateBinding?
var walk_copy: WalkCopy?
var fused: FusedStep?
var is_synthetic: Boolean
var is_written_by_the_compiler: Boolean
var is_an_attribute: Boolean
var is_a_function_member: Boolean

func FunctionModel(
    starting_name: String,
    starting_owner: String,
    starting_answer: Type?,
    starting_declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration?,
    starting_declared: DeclaredFunction?,
    starting_binding: TemplateBinding?,
    starting_walk_copy: WalkCopy?,
    starting_fused: FusedStep?,
    starting_is_synthetic: Boolean,
    starting_is_written_by_the_compiler: Boolean,
    starting_is_an_attribute: Boolean,
    starting_is_a_function_member: Boolean,
) {
    name = starting_name
    owner = starting_owner
    answer = starting_answer
    declaration = starting_declaration
    declared = starting_declared
    binding = starting_binding
    walk_copy = starting_walk_copy
    fused = starting_fused
    is_synthetic = starting_is_synthetic
    is_written_by_the_compiler = starting_is_written_by_the_compiler
    is_an_attribute = starting_is_an_attribute
    is_a_function_member = starting_is_a_function_member
}

func is_a_constructor(): Boolean {
    fallback declared
    return declared.is_constructor
}

func reflects_its_answer(): Boolean {
    fallback declared
    return declared.reflected_answer_index >= 0
}

func is_a_member_template(): Boolean {
    fallback declared
    return declared.template_index >= 0
}

func template_index(): Integer {
    if binding {
        return binding.template_index
    }
    if declared {
        return declared.template_index
    }
    return -1
}

func binding_or_empty(): TemplateBinding {
    if binding {
        return binding
    }
    return TemplateBinding(-1, "", null, false, 0, "", "", null, null)
}

func bound_parameter(): String {
    fallback binding and declaration
    var bound = declaration.parameters[binding.template_index]
    fallback bound
    return bound.name
}

func is_a_walk_copy(): Boolean {
    if walk_copy {
        return true
    }
    return false
}

func walk_copy_or_empty(): WalkCopy {
    if walk_copy {
        return walk_copy
    }
    return WalkCopy(null, "", false, null, 0)
}

func key(): String {
    return "{owner}.{name}"
}

# ../PROOFS.md#a-condition-known-while-compiling-is-an-error
func is_walked(): Boolean {
    if binding or walk_copy {
        return true
    }
    return false
}

func has_a_body(): Boolean {
    if is_synthetic {
        return true
    }
    fallback not is_written_by_the_compiler and declaration
    if declaration.body {
        return true
    }
    return false
}

var name = ""
var owner = ""
var parameters = List<ParameterModel>()
var answer: Type? = null
var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration? = null
var is_constructor = false
var is_an_attribute = false
var is_a_member_template = false
var bound_member = ""
var bound_member_type: Type? = null
var bound_member_is_a_function = false
var template_index = -1
var bound_parameter = ""
var bound_member_index = 0
var bound_shape = ""
var is_synthetic = false
var walked_object: Type? = null

func FunctionModel(starting_name: String, starting_owner: String) {
    name = starting_name
    owner = starting_owner
}

func key(): String {
    return "{owner}.{name}"
}

func has_a_body(): Boolean {
    if is_synthetic {
        return true
    }
    crash declaration
    if declaration.body {
        return true
    }
    return false
}

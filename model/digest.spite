# ../HOT_RELOAD.md#the-manifest
var first: Long = 0
var second: Long = 0

func add_byte(value: Integer) {
    var mixed_first = first * 257 + value + 1
    first = mixed_first % 4294967291
    var mixed_second = second * 263 + value + 7
    second = mixed_second % 4294967279
}

func add_text(text: String) {
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        add_byte(code % 256)
        index = index + 1
    }
    add_byte(0)
}

func add_bytes(bytes: Buffer, start: Integer, end: Integer) {
    var index = start
    while index < end {
        var read = bytes[index]
        crash read
        add_byte(read)
        index = index + 1
    }
}

func digest_text(): String {
    var first_digits = hexadecimal_of(first)
    var second_digits = hexadecimal_of(second)
    return "{first_digits}{second_digits}"
}

func hexadecimal_of(value: Long): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = value
    var place = 0
    while place < 8 {
        var digit = rest % 16
        var at = digit.to_integer()
        var character = digits.slice(at, at + 1)
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

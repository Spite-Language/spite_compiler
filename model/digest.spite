# ../HOT_RELOAD.md#the-manifest
var first: Long = 0
var second: Long = 0
var _first_multiplier: Long = 257
var _first_modulus: Long = 4294967291
var _second_multiplier: Long = 263
var _second_modulus: Long = 4294967279

func add_byte(value: Integer) {
    var mixed_first = first * _first_multiplier + value + 1
    first = mixed_first % _first_modulus
    var mixed_second = second * _second_multiplier + value + 7
    second = mixed_second % _second_modulus
}

func add_text(text: String) {
    var index = 0
    while index < text.length() {
        var code = text.byte_at(index)
        add_byte(code % 256)
        index = index + 1
    }
    add_byte(0)
}

func add_bytes(bytes: Buffer, start: Integer, end: Integer) {
    var index = start
    while index < end {
        var read = bytes[index]
        crash read
        add_byte(read)
        index = index + 1
    }
}

func digest_text(): String {
    var first_digits = hexadecimal_of(first)
    var second_digits = hexadecimal_of(second)
    return "{first_digits}{second_digits}"
}

func hexadecimal_of(value: Long): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = value
    var place = 0
    while place < 8 {
        var digit = rest % 16
        var at: Integer? = digit
        var character = digits.slice(at, at + 1)
        crash character
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

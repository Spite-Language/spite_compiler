enum Kind {
    'nothing'
    'scalar'
    'object'
    'enumeration'
    'union'
    'function'
    'shape'
    'handle'
    'namespace'
    'parameters'
    'pattern'
}

var is_nullable = false
var is_a_walked_name = false
var members = List<Type>()
var signature: Signature? = null
var carrier = ""
var written_name = ""
var kind: Kind
var name: String

func Type(starting_kind: Kind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var made = copy()
    made.is_nullable = true
    return made
}

func present(): Type {
    var made = copy()
    made.is_nullable = false
    return made
}

func is_the_same_as(other: Type): Boolean {
    return kind == other.kind and name == other.name and is_nullable == other.is_nullable
}

func signature_or_empty(): Signature {
    if signature {
        return signature
    }
    var no_parameters = List<Type>()
    return Signature(no_parameters, null, false)
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

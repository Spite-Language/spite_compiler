enum Kind {
    'nothing'
    'scalar'
    'object'
    'enumeration'
    'union'
    'function'
    'shape'
    'handle'
    'namespace'
    'parameters'
    'pattern'
}

var is_nullable = false
var is_a_walked_name = false
var members = List<Type>()
var signature: Signature? = null
var carrier = ""
var written_name = ""
var kind: Kind
var name: String

func Type(starting_kind: Kind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var made = copy()
    made.is_nullable = true
    return made
}

func present(): Type {
    var made = copy()
    made.is_nullable = false
    return made
}

# ../../spite_documentation/functions_and_operators.md#plain-values-where-a-type-is-wanted
func is_the_same_as(other: Type): Boolean {
    fallback kind == other.kind and is_nullable == other.is_nullable
    return name == other.name
}

# ../../spite_documentation/reflection.md#spiteattribute
func is_a_bound_attribute(): Boolean {
    fallback kind == 'object'
    return name.starts_with("Spite.Attribute_of_")
}

func signature_or_empty(): Signature {
    if signature {
        return signature
    }
    var no_parameters = List<Type>()
    return Signature(no_parameters, null, false)
}

# ../../spite_documentation/reflection.md#spitefunctiondeclaration
func is_the_declared_answer(): Boolean {
    var names = LanguageNames()
    return kind == 'union' and not is_nullable and name == names.declared_answer
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

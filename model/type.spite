var kind: Model.TypeKind = 'nothing'
var name = ""
var is_nullable = false
var members = List<Type>()
var parameters = List<Type>()
var answer: Type? = null

func Type(starting_kind: Model.TypeKind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var made = Type(kind, name)
    made.members = members
    made.parameters = parameters
    made.answer = answer
    made.is_nullable = true
    return made
}

func present(): Type {
    var made = Type(kind, name)
    made.members = members
    made.parameters = parameters
    made.answer = answer
    return made
}

func is_the_same_as(other: Type): Boolean {
    return kind == other.kind and name == other.name and is_nullable == other.is_nullable
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

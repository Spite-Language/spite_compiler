enum Kind {
    'nothing'
    'scalar'
    'object'
    'enumeration'
    'union'
    'function'
    'shape'
    'handle'
    'namespace'
    'parameters'
    'pattern'
}

var kind: Kind = 'nothing'
var name = ""
var is_nullable = false
var is_a_walked_name = false
var members = List<Type>()
var parameters = List<Type>()
var answer: Type? = null
var carrier = ""
var is_variadic = false
var written_name = ""

func Type(starting_kind: Kind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var original = this
    var made = original.copy()
    made.is_nullable = true
    return made
}

func present(): Type {
    var original = this
    var made = original.copy()
    made.is_nullable = false
    return made
}

func is_the_same_as(other: Type): Boolean {
    return kind == other.kind and name == other.name and is_nullable == other.is_nullable
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

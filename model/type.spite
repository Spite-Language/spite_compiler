enum Kind {
    'nothing'
    'scalar'
    'object'
    'enumeration'
    'union'
    'function'
    'shape'
    'handle'
    'namespace'
    'parameters'
    'pattern'
}

var kind: Kind = 'nothing'
var name = ""
var is_nullable = false
var is_symbol = false
var members = List<Type>()
var parameters = List<Type>()
var answer: Type? = null
var constant = ""
var carrier = ""
var is_variadic = false
var written_name = ""

func Type(starting_kind: Kind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var made = Type(kind, name)
    made.is_symbol = is_symbol
    made.members = members
    made.parameters = parameters
    made.answer = answer
    made.constant = constant
    made.carrier = carrier
    made.is_variadic = is_variadic
    made.written_name = written_name
    made.is_nullable = true
    return made
}

func present(): Type {
    var made = Type(kind, name)
    made.is_symbol = is_symbol
    made.members = members
    made.parameters = parameters
    made.answer = answer
    made.constant = constant
    made.carrier = carrier
    made.is_variadic = is_variadic
    made.written_name = written_name
    return made
}

func is_the_same_as(other: Type): Boolean {
    return kind == other.kind and name == other.name and is_nullable == other.is_nullable
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

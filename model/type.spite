enum Kind {
    'nothing'
    'scalar'
    'object'
    'enumeration'
    'union'
    'function'
    'shape'
    'handle'
    'namespace'
    'parameters'
    'pattern'
}

var is_nullable = false
var is_a_walked_name = false
var members = List<Type>()
var signature: Signature? = null
var carrier = ""
var written_name = ""
var kind: Kind
var name: String

func Type(starting_kind: Kind, starting_name: String) {
    kind = starting_kind
    name = starting_name
}

func nullable(): Type {
    var made = copy()
    made.is_nullable = true
    return made
}

func present(): Type {
    var made = copy()
    made.is_nullable = false
    return made
}

# ../../spite_documentation/functions_and_operators.md#anything-and-plain-values-where-a-type-is-wanted
func is_the_same_as(other: Type): Boolean {
    fallback kind == other.kind and is_nullable == other.is_nullable
    if name == other.name {
        return true
    }
    if holds_its_own_anything() or other.holds_its_own_anything() {
        var own = without_places()
        var others = other.without_places()
        return own == others
    }
    return is_anything() and other.is_anything()
}

# ../ARCHITECTURE.md#anything-is-filled-per-use
func without_places(): String {
    var pieces = name.split("@")
    var kept = List<String>()
    var is_a_place = false
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        if not is_a_place {
            kept.append(piece)
        }
        is_a_place = not is_a_place
        index = index + 1
    }
    return kept.join("")
}

# ../ARCHITECTURE.md#anything-is-filled-per-use
func holds_its_own_anything(): Boolean {
    return kind == 'object' and name.contains("@")
}

# ../../spite_documentation/functions_and_operators.md#anything-and-plain-values-where-a-type-is-wanted
func is_anything(): Boolean {
    fallback kind == 'shape'
    return name == "Anything" or name.starts_with("Anything@")
}

func signature_or_empty(): Signature {
    if signature {
        return signature
    }
    var no_parameters = List<Type>()
    return Signature(no_parameters, null, false)
}

func is_nothing(): Boolean {
    return kind == 'nothing'
}

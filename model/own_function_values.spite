var is_learned = false
var held_back = Dictionary<String, FunctionModel>()
var owners = List<String>()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var library = Mapping.LibraryFile()
var told_classes = ["List<", "Dictionary<", "Observer<"]
var handed_names = List<String>()
var stored_held = List<String>()
var listing_members = ["append", "insert", "count", "is_empty", "clear"]

# ../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func function_held_back(program: ProgramModel, attribute: AttributeModel): FunctionModel? {
    learn(program)
    return held_back["{attribute.owner}.{attribute.name}"]
}

# ../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func stores_its_own_held_back(program: ProgramModel, attribute: AttributeModel): Boolean {
    learn(program)
    return stored_held.contains("{attribute.owner}.{attribute.name}")
}

func owners_of(program: ProgramModel): List<String> {
    learn(program)
    return owners
}

# ../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func learn(program: ProgramModel) {
    fallback not is_learned
    is_learned = true
    var candidates = List<AttributeModel>()
    var stored = List<AttributeModel>()
    var functions = Dictionary<String, FunctionModel>()
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        if not model.is_singleton and model.bound_types.count() == 0 {
            add_the_candidates_of(model, candidates, functions)
            add_the_stored_candidates_of(program, model, stored, functions)
        }
        index = index + 1
    }
    fallback not candidates.is_empty() or not stored.is_empty()
    var walk = AbstractSyntaxTree.Walk(no_file)
    index = 0
    while index < program.order.count() {
        var model = program.order[index]
        var first = walk.expressions.count()
        walk_the_class(walk, model)
        note_the_handed_names(program, model, walk, first)
        index = index + 1
    }
    fallback lists_no_attributes_at_run_time(walk)
    index = 0
    while index < candidates.count() {
        var attribute = candidates[index]
        var key = "{attribute.owner}.{attribute.name}"
        var function = functions[key]
        crash function
        if only_called(walk, attribute.name, false, true) {
            held_back[key] = function
            add_an_owner(attribute.owner)
        }
        index = index + 1
    }
    index = 0
    while index < stored.count() {
        var attribute = stored[index]
        if is_kept_to_itself(walk, attribute) {
            stored_held.append("{attribute.owner}.{attribute.name}")
        }
        index = index + 1
    }
}

# ../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func is_kept_to_itself(walk: AbstractSyntaxTree.Walk, attribute: AttributeModel): Boolean {
    if attribute.attribute_type.kind == 'function' {
        return only_called(walk, attribute.name, true, true)
    }
    return only_listed(walk, attribute.name)
}

# ../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func add_the_stored_candidates_of(
    program: ProgramModel,
    model: ClassModel,
    stored: List<AttributeModel>,
    functions: Dictionary<String, FunctionModel>,
) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var key = "{model.key}.{attribute.name}"
        var held = attribute.attribute_type
        var is_a_holder = held.kind == 'function' or is_a_list_of_functions(program, held)
        var is_the_programs = not library.holds(model.file.path)
        if is_a_holder and is_the_programs and not functions.contains(key) {
            stored.append(attribute)
        }
        index = index + 1
    }
}

func is_a_list_of_functions(program: ProgramModel, held: Type): Boolean {
    fallback held.kind == 'object' and not held.is_nullable
    var list = program.class_named(held.name)
    fallback list and list.shown.starts_with("List<") and library.holds(list.file.path)
    var item = list.bound_types["$element_type"]
    fallback item
    return item.kind == 'function'
}

func add_the_candidates_of(
    model: ClassModel,
    candidates: List<AttributeModel>,
    functions: Dictionary<String, FunctionModel>,
) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var function = own_function_named_by_the_default(model, attribute)
        if function {
            candidates.append(attribute)
            functions["{model.key}.{attribute.name}"] = function
        }
        index = index + 1
    }
}

func walk_the_class(walk: AbstractSyntaxTree.Walk, model: ClassModel) {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.declaration {
            walk.read_function(function.declaration)
        }
        index = index + 1
    }
    index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.declaration {
            walk.read_attribute(attribute.declaration)
        }
        index = index + 1
    }
}

func own_function_named_by_the_default(model: ClassModel, attribute: AttributeModel): FunctionModel? {
    fallback attribute.attribute_type.kind == 'function'
    fallback attribute.declaration
    fallback attribute.declaration.value
    var name = ""
    if attribute.declaration.value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = attribute.declaration.value.name
    }
    if attribute.declaration.value.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        fallback is_this(attribute.declaration.value.target)
        name = attribute.declaration.value.name
    }
    var function = model.function_named(name)
    fallback function
    fallback not function.is_a_constructor()
    return function
}

func is_this(target: SpiteCompiler.Expression?): Boolean {
    fallback target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    return target.kind == 'keyword_this'
}

func add_an_owner(owner: String) {
    fallback not owners.contains(owner)
    owners.append(owner)
}

# ../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func lists_no_attributes_at_run_time(walk: AbstractSyntaxTree.Walk): Boolean {
    var listed = 0
    var indexed = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        crash found.expression
        var expression = found.expression
        if is_a_listing(expression) {
            listed = listed + 1
        }
        if is_indexed_by_a_declaration(expression) {
            indexed = indexed + 1
        }
        index = index + 1
    }
    return listed == indexed
}

func is_a_listing(expression: SpiteCompiler.Expression): Boolean {
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    return expression.name == "attributes"
}

func is_indexed_by_a_declaration(expression: SpiteCompiler.Expression): Boolean {
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    fallback expression.target and expression.index
    fallback expression.target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback expression.target.name == "attributes"
    return expression.index.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
}

# ../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func note_the_handed_names(program: ProgramModel, model: ClassModel, walk: AbstractSyntaxTree.Walk, first: Integer) {
    var index = first
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        crash found.expression
        if is_told(program, model, found.expression, found.function_name) {
            note_the_handed_arguments(found.expression)
        }
        index = index + 1
    }
}

# ../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func is_told(
    program: ProgramModel,
    model: ClassModel,
    expression: SpiteCompiler.Expression,
    function_name: String,
): Boolean {
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback expression.callee
    fallback expression.callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback expression.callee.name == "subscribe" or expression.callee.name == "unsubscribe"
    var receiver_type = type_of_a_held_name(model, expression.callee.target, function_name)
    fallback receiver_type and receiver_type.kind == 'object' and not receiver_type.is_nullable
    var receiver_class = program.class_named(receiver_type.name)
    fallback receiver_class and library.holds(receiver_class.file.path)
    return told_classes.any(receiver_class.shown.starts_with)
}

# ../PROOFS.md#a-function-subscribed-to-an-observer-holds-its-owner-back
func type_of_a_held_name(model: ClassModel, target: SpiteCompiler.Expression?, function_name: String): Type? {
    fallback target
    var name = ""
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = target.name
        var function = model.function_named(function_name)
        if function {
            var parameter = function.parameters.find_by_name(name)
            if parameter {
                return parameter.parameter_type
            }
        }
    } else if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and is_this(target.target) {
        name = target.name
    }
    var attribute = model.attribute_named(name)
    fallback attribute
    return attribute.attribute_type
}

func note_the_handed_arguments(call: SpiteCompiler.Expression) {
    fallback call.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            handed_names.append(argument.name)
        } else if argument.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
            note_a_handed_member(argument)
        }
        index = index + 1
    }
}

func note_a_handed_member(argument: AbstractSyntaxTree.Shapes.Expressions.MemberExpression) {
    fallback is_this(argument.target)
    handed_names.append(argument.name)
}

func handed_count(name: String): Integer {
    var count = 0
    var index = 0
    while index < handed_names.count() {
        if handed_names[index] == name {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

# ../PROOFS.md#a-function-value-bound-to-its-own-owner-holds-it-back
func only_called(
    walk: AbstractSyntaxTree.Walk,
    name: String,
    counts_stores: Boolean,
    counts_calls: Boolean,
): Boolean {
    var uses = 0
    var kept = handed_count(name)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        crash found.expression
        if is_the_name(found.expression, name) {
            uses = uses + 1
            if found.is_called and counts_calls {
                kept = kept + 1
            }
        }
        if counts_calls and calls_through(found.expression, name) {
            kept = kept + 1
        }
        index = index + 1
    }
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        crash found.statement
        if keeps_the_name(found.statement, name) {
            kept = kept + 1
        } else if counts_stores and stores_into_the_name(found.statement, name) {
            kept = kept + 1
        }
        index = index + 1
    }
    return uses == kept
}

func stores_into_the_name(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    return is_the_name(statement.target, name)
}

# ../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func only_listed(walk: AbstractSyntaxTree.Walk, name: String): Boolean {
    var uses = 0
    var kept = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        crash found.expression
        var expression = found.expression
        if is_the_name(expression, name) {
            uses = uses + 1
        }
        if found.is_called and is_a_listing_member(expression, name) {
            kept = kept + 1
        }
        if found.is_called and is_an_item_of(expression, name) {
            kept = kept + 1
        }
        index = index + 1
    }
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        crash found.statement
        if declares_an_item_only_handed(walk, found.statement, name) {
            kept = kept + 1
        }
        index = index + 1
    }
    return uses == kept
}

func is_a_listing_member(expression: SpiteCompiler.Expression, name: String): Boolean {
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback listing_members.contains(expression.name)
    return is_the_name(expression.target, name)
}

func is_an_item_of(expression: SpiteCompiler.Expression?, name: String): Boolean {
    fallback expression
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    return is_the_name(expression.target, name)
}

# ../PROOFS.md#a-function-value-its-owner-stores-in-itself-holds-it-back
func declares_an_item_only_handed(
    walk: AbstractSyntaxTree.Walk,
    statement: SpiteCompiler.WrittenStatement,
    name: String,
): Boolean {
    fallback statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement
    fallback is_an_item_of(statement.value, name)
    return only_called(walk, statement.name, false, false)
}

func is_the_name(expression: SpiteCompiler.Expression?, name: String): Boolean {
    fallback expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return expression.name == name
    }
    return false
}

func calls_through(expression: SpiteCompiler.Expression, name: String): Boolean {
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression
    fallback expression.callee
    fallback expression.callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    fallback expression.callee.name == "call_function"
    return is_the_name(expression.callee.target, name)
}

func keeps_the_name(statement: SpiteCompiler.WrittenStatement, name: String): Boolean {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: return clears_the_name(statement, name)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return is_the_name(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return is_the_name(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: return is_the_name(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: return is_the_name(statement.condition, name)
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: return false
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: return false
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: return false
        AbstractSyntaxTree.Shapes.Statements.Block: return false
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return false
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return false
    }
}

func clears_the_name(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement, name: String): Boolean {
    fallback is_the_name(statement.target, name)
    fallback statement.value
    fallback statement.value.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    return statement.value.kind == 'keyword_null'
}

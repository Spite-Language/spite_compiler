var written_name: String
var shown_types: String
var called_in: String
var called_at: Integer
var depth: Integer

# ../../spite_documentation/functions_and_operators.md#a-function-taking-a-union-or-a-type-is-copied-per-argument-type
func TypedCopy(
    starting_written_name: String,
    starting_shown_types: String,
    starting_called_in: String,
    starting_called_at: Integer,
    starting_depth: Integer,
) {
    written_name = starting_written_name
    shown_types = starting_shown_types
    called_in = starting_called_in
    called_at = starting_called_at
    depth = starting_depth
}

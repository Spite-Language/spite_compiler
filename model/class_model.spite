var key = ""
var shown = ""
var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var bound_types = Dictionary<String, Type>()
var declared_attributes = List<AttributeModel>()
var declared_functions = List<FunctionModel>()
var enums = List<EnumModel>()
var unions = List<UnionModel>()
var is_singleton = false
var room_size = 0

func ClassModel(starting_key: String, starting_shown: String, starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    key = starting_key
    shown = starting_shown
    file = starting_file
}

func attribute_named(wanted: String): AttributeModel? {
    return declared_attributes.find_by_name(wanted)
}

func function_named(wanted: String): FunctionModel? {
    return declared_functions.find_by_name(wanted)
}

func enum_named(wanted: String): EnumModel? {
    return enums.find_by_name(wanted)
}

func union_named(wanted: String): UnionModel? {
    return unions.find_by_name(wanted)
}

func type_of_an_instance(): Type {
    return Type('object', key)
}

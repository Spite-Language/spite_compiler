var key = ""
var shown = ""
var file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var bound_types = Dictionary<String, Type>()
var declared_attributes = List<AttributeModel>()
var declared_functions = List<FunctionModel>()
var enums = List<EnumModel>()
var unions = List<UnionModel>()
var shapes = List<ShapeModel>()
var is_singleton = false
var room_size = 0

func ClassModel(starting_key: String, starting_shown: String, starting_file: AbstractSyntaxTree.Shapes.SourceFile) {
    key = starting_key
    shown = starting_shown
    file = starting_file
}

func attribute_named(wanted: String): AttributeModel? {
    return declared_attributes.find_by_name(wanted)
}

func function_named(wanted: String): FunctionModel? {
    return declared_functions.find_by_name(wanted)
}

func enum_named(wanted: String): EnumModel? {
    return enums.find_by_name(wanted)
}

func union_named(wanted: String): UnionModel? {
    return unions.find_by_name(wanted)
}

func shape_named(wanted: String): ShapeModel? {
    return shapes.find_by_name(wanted)
}

func type_of_an_instance(): Type {
    return Type('object', key)
}

# ../../spite_documentation/classes_and_files.md#constructors-conversions-and-presets
func conversion_from(source: Type): FunctionModel? {
    return conversion_into(key, source)
}

# ../../spite_spec/specs/values_and_types.md#enums-in-full
func conversion_into(made_name: String, source: Type): FunctionModel? {
    var wanted_source = source.present()
    var index = 0
    while index < declared_functions.count() {
        var function = declared_functions[index]
        if function.is_a_conversion and makes(function, made_name) and converts_from(function, wanted_source) {
            return function
        }
        index = index + 1
    }
    return null
}

func makes(function: FunctionModel, made_name: String): Boolean {
    fallback function.answer
    return function.answer.name == made_name
}

func converts_from(function: FunctionModel, source: Type): Boolean {
    var only = function.parameters[0]
    fallback only
    return only.parameter_type.is_the_same_as(source)
}

# ../../spite_documentation/json.md#what-a-reader-makes
func is_made_plainly(): Boolean {
    var index = 0
    while index < declared_functions.count() {
        var function = declared_functions[index]
        if function.is_constructor {
            return function.parameters.is_empty()
        }
        index = index + 1
    }
    return true
}

func read_conversion(): FunctionModel? {
    var index = 0
    while index < declared_functions.count() {
        var function = declared_functions[index]
        if function.is_a_conversion {
            return function
        }
        index = index + 1
    }
    return null
}

func preset_named(wanted: String): FunctionModel? {
    var function = function_named(wanted)
    fallback function and function.is_a_preset
    return function
}

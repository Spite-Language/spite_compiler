var name = ""
var size = 0
var is_signed = false
var is_decimal = false
var is_a_number = true
var smallest = ""
var largest = ""

func Scalar(starting_name: String, starting_size: Integer, starting_is_signed: Boolean, starting_is_decimal: Boolean) {
    name = starting_name
    size = starting_size
    is_signed = starting_is_signed
    is_decimal = starting_is_decimal
}

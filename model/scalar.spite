var is_a_number = true
var name: String
var size: Integer
var is_signed: Boolean
var is_decimal: Boolean
var smallest: String
var largest: String

func Scalar(
    starting_name: String,
    starting_size: Integer,
    starting_is_signed: Boolean,
    starting_is_decimal: Boolean,
    starting_smallest: String,
    starting_largest: String,
) {
    name = starting_name
    size = starting_size
    is_signed = starting_is_signed
    is_decimal = starting_is_decimal
    smallest = starting_smallest
    largest = starting_largest
}

enum Kind {
    'text'
    'number'
    'truth'
    'list'
    'class'
    'namespace'
    'function'
}

var kind: Kind = 'text'
var text = ""
var number: Long = 0
var items = List<KnownValue>()
var is_reflected = false

func KnownValue(starting_kind: Kind, starting_text: String, starting_number: Long, starting_is_reflected: Boolean) {
    kind = starting_kind
    text = starting_text
    number = starting_number
    is_reflected = starting_is_reflected
}

func is_true(): Boolean {
    return kind == 'truth' and number != 0
}

func is_false(): Boolean {
    return kind == 'truth' and number == 0
}

func has_no_value_to_hold(): Boolean {
    return kind == 'list' or kind == 'class' or kind == 'namespace'
}

func lists_functions(): Boolean {
    return kind == 'list' and text == "Spite.FunctionDeclaration"
}

func identity(): String {
    var listed = List<String>()
    var index = 0
    while index < items.count() {
        var item = items[index]
        var shown = item.identity()
        listed.append(shown)
        index = index + 1
    }
    var joined = listed.join(",")
    return "{kind}:{text}:{number}:{joined}"
}

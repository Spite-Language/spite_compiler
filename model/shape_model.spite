var key = ""
var name = ""
var members = List<FunctionModel>()
var assigned_members = List<String>()

func ShapeModel(starting_key: String, starting_name: String) {
    key = starting_key
    name = starting_name
}

func member_named(wanted: String): FunctionModel? {
    return members.find_by_name(wanted)
}

func is_answered_by_null(): Boolean {
    if name == "Anything" {
        return true
    }
    return members.all(is_a_member_null_answers)
}

func is_a_member_null_answers(member: FunctionModel): Boolean {
    var names_it = member.name == "to_string" or member.name == "to_debug"
    return names_it and member.parameters.is_empty() and not member.is_an_attribute
}

var key = ""
var name = ""
var values = List<String>()
var numbers = List<Long>()

func EnumModel(starting_key: String, starting_name: String) {
    key = starting_key
    name = starting_name
}

# ../HOT_RELOAD.md#the-manifest
func described(): String {
    var described_values = List<String>()
    var index = 0
    while index < values.count() {
        var value = values[index]
        var number = numbers[index]
        crash value
        crash number
        described_values.append("{value}={number}")
        index = index + 1
    }
    return described_values.join(",")
}

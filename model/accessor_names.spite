# ../../spite_documentation/functions_and_operators.md#settergetter-interception

func setter_of(name: String): String {
    if name.starts_with("_") {
        var public = public_part(name)
        return "_set_{public}"
    }
    return "set_{name}"
}

func getter_of(name: String): String {
    if name.starts_with("_") {
        var public = public_part(name)
        return "_get_{public}"
    }
    return "get_{name}"
}

func written_by(function_name: String): String {
    return named_after(function_name, "set_")
}

func read_by(function_name: String): String {
    return named_after(function_name, "get_")
}

func named_after(function_name: String, prefix: String): String {
    var length = function_name.length()
    var private_prefix = "_{prefix}"
    if function_name.starts_with(private_prefix) {
        var private_start = private_prefix.length()
        var private_rest = function_name.slice(private_start, length)
        crash private_rest
        return "_{private_rest}"
    }
    fallback function_name.starts_with(prefix)
    var start = prefix.length()
    var rest = function_name.slice(start, length)
    crash rest
    return rest
}

func public_part(name: String): String {
    var length = name.length()
    var public = name.slice(1, length)
    crash public
    return public
}

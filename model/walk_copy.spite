var walked_object: Type? = null
var walked_declarations_of = ""
var binds_a_class = false
var known_arguments: Dictionary<String, KnownValue>? = null
var known_depth = 0
var known_reflections = Dictionary<String, String>()

func WalkCopy(
    starting_walked_object: Type?,
    starting_walked_declarations_of: String,
    starting_binds_a_class: Boolean,
    starting_known_arguments: Dictionary<String, KnownValue>?,
    starting_known_depth: Integer,
) {
    walked_object = starting_walked_object
    walked_declarations_of = starting_walked_declarations_of
    binds_a_class = starting_binds_a_class
    known_arguments = starting_known_arguments
    known_depth = starting_known_depth
}

# ../HOT_RELOAD.md#the-manifest
var generation = 0
var text_base: Long = 0
var routines = ""
var function_keys = List<String>()
var stubs = Dictionary<String, Long>()
var slots = Dictionary<String, Long>()
var digests = Dictionary<String, String>()
var owners = Dictionary<String, String>()
var state_names = List<String>()
var states = Dictionary<String, Long>()
var imports = Dictionary<String, Long>()
var library_imports = Dictionary<String, Long>()
var class_keys = List<String>()
var class_ids = Dictionary<String, Integer>()
var layouts = Dictionary<String, String>()
var enum_keys = List<String>()
var enums = Dictionary<String, String>()
var file_paths = List<String>()
var file_digests = Dictionary<String, String>()

func add_a_function(key: String, stub: Long, slot: Long, digest: String, owner: String) {
    if not function_keys.contains(key) {
        function_keys.append(key)
    }
    stubs[key] = stub
    slots[key] = slot
    digests[key] = digest
    owners[key] = owner
}

func add_a_state(name: String, address: Long) {
    if not state_names.contains(name) {
        state_names.append(name)
    }
    states[name] = address
}

func add_a_class(key: String, id: Integer, layout: String) {
    if not class_keys.contains(key) {
        class_keys.append(key)
    }
    class_ids[key] = id
    layouts[key] = layout
}

func add_an_enum(key: String, values: String) {
    if not enum_keys.contains(key) {
        enum_keys.append(key)
    }
    enums[key] = values
}

func add_a_file(path: String, digest: String) {
    if not file_paths.contains(path) {
        file_paths.append(path)
    }
    file_digests[path] = digest
}

func largest_class_id(): Integer {
    var largest = 0
    var index = 0
    while index < class_keys.count() {
        var key = class_keys[index]
        var id = class_ids[key]
        crash id
        if id > largest {
            largest = id
        }
        index = index + 1
    }
    return largest
}

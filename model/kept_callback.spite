var site: String
var owner: ClassModel
var attribute: String
var local: String
var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration

func KeptCallback(
    starting_site: String,
    starting_owner: ClassModel,
    starting_attribute: String,
    starting_local: String,
    starting_declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
) {
    site = starting_site
    owner = starting_owner
    attribute = starting_attribute
    local = starting_local
    declaration = starting_declaration
}

var name = ""
var owner = ""
var attribute_type = Type('nothing', "")
var declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration? = null
var foreign_names = List<String>()

func AttributeModel(starting_name: String, starting_owner: String, starting_type: Type) {
    name = starting_name
    owner = starting_owner
    attribute_type = starting_type
}

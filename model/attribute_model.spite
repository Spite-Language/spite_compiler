var attribute_type = Type('nothing', "")
var foreign_names = List<String>()
var name: String
var owner: String
var declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration?
var is_a_key_slot: Boolean

func AttributeModel(
    starting_name: String,
    starting_owner: String,
    starting_type: Type,
    starting_declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration?,
    starting_is_a_key_slot: Boolean,
) {
    name = starting_name
    owner = starting_owner
    attribute_type = starting_type
    declaration = starting_declaration
    is_a_key_slot = starting_is_a_key_slot
}

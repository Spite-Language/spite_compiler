var is_constructor = false
var is_a_conversion = false
var is_a_preset = false
var reflected_answer_index = -1

func DeclaredFunction(
    starting_is_constructor: Boolean,
    starting_is_a_conversion: Boolean,
    starting_is_a_preset: Boolean,
    starting_reflected_answer_index: Integer,
) {
    is_constructor = starting_is_constructor
    is_a_conversion = starting_is_a_conversion
    is_a_preset = starting_is_a_preset
    reflected_answer_index = starting_reflected_answer_index
}

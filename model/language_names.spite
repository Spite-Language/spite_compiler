# ../../spite_documentation/values_and_types.md#nothing
# ../../spite_documentation/reflection.md#spitefunctiondeclaration

var owner = "Spite.Spite"
var filled = "Anything"
var empty = "Nothing"
var null_class = "Null"
var declared_answer = "Spite.FunctionDeclaration.Returned"

func names_a_union(written: String): Boolean {
    return written == filled or written == empty
}

func is_the_null_class(described: Type): Boolean {
    return described.kind == 'object' and described.name == null_class
}

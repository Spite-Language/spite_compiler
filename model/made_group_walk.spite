var leaves = false
var found = ""
var group = Dictionary<String, String>()
var locals = List<String>()
var this_class = ""
var owner_class = ""
var function_key = ""
var is_the_root = true
var is_implicit = false
var followed = List<String>()
var made_classes = List<String>()
var walked = List<String>()
var walked_names = Dictionary<String, String>()
var sites = Dictionary<String, List<String>>()
var reaching = List<String>()
var classes: Dictionary<String, ClassModel>
var constructors: Dictionary<String, String>
var back_class: String
var back_name: String
var reference_name: String

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func MadeGroupWalk(
    known_classes: Dictionary<String, ClassModel>,
    unique_constructors: Dictionary<String, String>,
    starting_back_class: String,
    starting_back_name: String,
    starting_reference_name: String,
) {
    classes = known_classes
    constructors = unique_constructors
    back_class = starting_back_class
    back_name = starting_back_name
    reference_name = starting_reference_name
    note_the_classes_reaching()
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_the_root(function: FunctionModel) {
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    owner_class = function.owner
    function_key = function.key()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        locals.append(parameter.name)
        index = index + 1
    }
    read_block(declaration.body)
}

func note_the_classes_reaching() {
    reaching.append(back_class)
    var keys = classes.keys()
    var grew = true
    while grew {
        grew = false
        var index = 0
        while index < keys.count() {
            var key = keys[index]
            var model = classes[key]
            if model and not reaching.contains(key) and may_reach(model) {
                reaching.append(key)
                grew = true
            }
            index = index + 1
        }
    }
}

func may_reach(model: ClassModel): Boolean {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if may_hold(attribute.attribute_type) {
            return true
        }
        index = index + 1
    }
    var names = model.bound_types.keys()
    index = 0
    while index < names.count() {
        var name = names[index]
        var bound = model.bound_types[name]
        if bound and may_hold(bound) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func may_hold(held: Type): Boolean {
    var is_plain = held.kind == 'scalar' or held.kind == 'enumeration' or held.kind == 'nothing' or held.kind == 'handle'
    fallback not is_plain
    if held.kind != 'object' {
        return true
    }
    fallback held.name != "String"
    if classes.contains(held.name) {
        return reaching.contains(held.name)
    }
    return true
}

func value_of_a_type(held: Type): String {
    fallback may_hold(held)
    var model: ClassModel? = null
    if held.kind == 'object' {
        model = classes[held.name]
    }
    if not model {
        return "*"
    }
    fallback not model.is_singleton
    if model.bound_types.count() != 0 {
        return "*"
    }
    return held.name
}

func is_in_the_group(value: String): Boolean {
    return not value.is_empty() and value != "?"
}

func class_of(value: String): String {
    if not value.starts_with("=") {
        return value
    }
    var length = value.length()
    var sliced = value.slice(1, length)
    crash sliced
    return sliced
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_a_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_an_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read(statement.value)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_while(statement)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: read_a_return(statement)
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: read(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: read(statement.condition)
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func read(expression: SpiteCompiler.Expression?) {
    found = value_found(expression)
}

# ../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    var link: AbstractSyntaxTree.Shapes.Statements.IfStatement? = statement
    while link {
        var current = link
        read(current.condition)
        read_block(current.then_branch)
        link = current.else_if()
        if not link {
            read_block(current.else_branch)
        }
    }
}

func read_while(statement: AbstractSyntaxTree.Shapes.Statements.WhileStatement) {
    read(statement.condition)
    read_block(statement.body)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    read(statement.value)
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_block(switch_case.body)
        index = index + 1
    }
}

func read_a_return(statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement) {
    var value = value_of(statement.value)
    if is_in_the_group(value) {
        leaves = true
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_a_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    var value = value_of(statement.value)
    var name = statement.name
    if group.contains(name) or locals.contains(name) {
        leaves = true
        return
    }
    if is_the_root and name == reference_name {
        note_the_reference(name, value)
        return
    }
    if is_in_the_group(value) {
        group[name] = value
        return
    }
    locals.append(name)
}

func note_the_reference(name: String, value: String) {
    if not is_in_the_group(value) or value.starts_with("=") {
        leaves = true
        return
    }
    group[name] = "={value}"
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func read_an_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    var value = value_of(statement.value)
    var target = statement.target
    switch target {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: write_a_name(target.name, value)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: write_a_member(target, value)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: write_an_item(target, value)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: let_go_of(value)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: let_go_of(value)
    }
}

func let_go_of(value: String) {
    if is_in_the_group(value) {
        leaves = true
    }
}

func write_a_name(name: String, value: String) {
    var known = group[name]
    if known {
        write_a_name_in_the_group(name, known, value)
        return
    }
    if locals.contains(name) {
        let_go_of(value)
        return
    }
    if this_class.is_empty() {
        let_go_of(value)
        return
    }
    store_into(this_class, name, value)
}

func write_a_name_in_the_group(name: String, known: String, value: String) {
    if known.starts_with("=") {
        leaves = true
        return
    }
    fallback value != "?"
    if not is_in_the_group(value) {
        leaves = true
        return
    }
    group[name] = value
}

func write_a_member(target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, value: String) {
    var holder = value_of(target.target)
    if is_in_the_group(holder) {
        var holder_class = class_of(holder)
        store_into(holder_class, target.name, value)
        return
    }
    let_go_of(value)
    if target.name == back_name {
        leaves = true
    }
}

func write_an_item(target: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, value: String) {
    var holder = value_of(target.target)
    var index = value_of(target.index)
    let_go_of(holder)
    let_go_of(index)
    let_go_of(value)
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func store_into(class_key: String, name: String, value: String) {
    var model = classes[class_key]
    var attribute: AttributeModel? = null
    if model {
        attribute = model.attribute_named(name)
    }
    if not attribute {
        leaves = true
        return
    }
    if name == back_name {
        store_into_the_back(class_key, value)
        return
    }
    var is_kept = is_in_the_group(value) or value == "?"
    if may_hold(attribute.attribute_type) and not is_kept {
        leaves = true
    }
}

func store_into_the_back(class_key: String, value: String) {
    fallback value != "?"
    var is_the_link = class_key == back_class and value.starts_with("=") and not is_implicit
    if not is_the_link {
        leaves = true
    }
}

func value_of(expression: SpiteCompiler.Expression?): String {
    read(expression)
    return found
}

func value_found(expression: SpiteCompiler.Expression?): String {
    fallback expression
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return value_of_a_name(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return value_of_a_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return value_of_a_member(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return value_of_a_call(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return value_of_a_text(expression)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return value_of_an_item(expression)
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return value_of_both_sides(expression)
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return value_of_an_operand(expression.operand)
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return values_kept_out(expression.entries)
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return values_kept_out(expression.pairs)
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return value_of_an_entry(expression)
    }
}

func value_of_a_name(name: String): String {
    var known = group[name]
    if known {
        return known
    }
    fallback not locals.contains(name)
    fallback not this_class.is_empty()
    var model = classes[this_class]
    fallback model
    var attribute = model.attribute_named(name)
    if attribute {
        return value_of_a_type(attribute.attribute_type)
    }
    if model.function_named(name) {
        leaves = true
    }
    return ""
}

func value_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'keyword_null' {
        return "?"
    }
    fallback literal.kind == 'keyword_this'
    return this_class
}

func value_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    var holder = value_of(member.target)
    fallback is_in_the_group(holder)
    var class_key = class_of(holder)
    var model = classes[class_key]
    var attribute: AttributeModel? = null
    if model {
        attribute = model.attribute_named(member.name)
    }
    if not attribute {
        leaves = true
        return ""
    }
    return value_of_a_type(attribute.attribute_type)
}

func value_of_a_text(text: AbstractSyntaxTree.Shapes.Expressions.TextLiteral): String {
    var index = 0
    while index < text.pieces.count() {
        var piece = text.pieces[index]
        keep_out(piece.hole)
        index = index + 1
    }
    return ""
}

func value_of_an_item(item: AbstractSyntaxTree.Shapes.Expressions.IndexExpression): String {
    keep_out(item.target)
    keep_out(item.index)
    return ""
}

func value_of_both_sides(binary: AbstractSyntaxTree.Shapes.Expressions.BinaryExpression): String {
    keep_out(binary.left)
    keep_out(binary.right)
    return ""
}

func value_of_an_entry(entry: AbstractSyntaxTree.Shapes.Expressions.EntryLiteral): String {
    keep_out(entry.key)
    keep_out(entry.value)
    return ""
}

func value_of_an_operand(operand: SpiteCompiler.Expression?): String {
    keep_out(operand)
    return ""
}

func values_kept_out(expressions: List<SpiteCompiler.Expression>): String {
    expressions.each(keep_out_a_present)
    return ""
}

func keep_out_a_present(expression: SpiteCompiler.Expression) {
    keep_out(expression)
}

func keep_out(expression: SpiteCompiler.Expression?) {
    var value = value_of(expression)
    let_go_of(value)
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func value_of_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    var values = List<String>()
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        var value = value_of(argument)
        values.append(value)
        index = index + 1
    }
    crash call.callee
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return call_a_name(call, callee.name, values)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        call_a_member(call, callee, values)
        return ""
    }
    let_go_of_any(values)
    return ""
}

func let_go_of_any(values: List<String>) {
    values.each(let_go_of)
}

func has_one_in_the_group(values: List<String>): Boolean {
    return values.any(is_in_the_group)
}

func call_a_name(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    name: String,
    values: List<String>,
): String {
    if group.contains(name) or locals.contains(name) {
        let_go_of_any(values)
        return ""
    }
    var made = constructors[name]
    if made {
        return make(made, values)
    }
    var owner = classes[owner_class]
    var function: FunctionModel? = null
    if owner {
        function = owner.function_named(name)
    }
    if not function {
        let_go_of_any(values)
        return ""
    }
    if not this_class.is_empty() or has_one_in_the_group(values) {
        walk_a_call(call, function, this_class, values)
    }
    return ""
}

func call_a_member(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    values: List<String>,
) {
    var receiver = value_of(callee.target)
    if is_in_the_group(receiver) {
        var receiver_class = class_of(receiver)
        call_on_the_group(call, receiver_class, callee.name, values)
        return
    }
    fallback has_one_in_the_group(values)
    var owner = classes[owner_class]
    if not is_this(callee.target) or not owner {
        leaves = true
        return
    }
    var function = owner.function_named(callee.name)
    if not function {
        leaves = true
        return
    }
    walk_a_call(call, function, "", values)
}

func is_this(target: SpiteCompiler.Expression?): Boolean {
    fallback target
    fallback target.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    return target.kind == 'keyword_this'
}

func call_on_the_group(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    class_key: String,
    name: String,
    values: List<String>,
) {
    var model = classes[class_key]
    var function: FunctionModel? = null
    if model {
        function = model.function_named(name)
    }
    if not function {
        leaves = true
        return
    }
    if function.is_a_constructor() {
        leaves = true
        return
    }
    walk_a_call(call, function, class_key, values)
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func walk_a_call(
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    function: FunctionModel,
    receiver_class: String,
    values: List<String>,
) {
    var is_written = function.is_synthetic or function.is_written_by_the_compiler
    if is_written or function.is_a_member_template() or function.is_a_walk_copy() {
        leaves = true
        return
    }
    var key = function.key()
    var site = "{function_key}|{call.line}:{call.column}"
    note_a_site(key, site)
    walked_names[key] = function.name
    if not walked.contains(key) {
        walked.append(key)
    }
    walk_a_function(function, receiver_class, values, false)
}

func note_a_site(key: String, site: String) {
    var known = sites[key]
    if not known {
        var made = List<String>()
        sites[key] = made
        known = made
    }
    crash known
    fallback not known.contains(site)
    known.append(site)
}

func walk_a_function(function: FunctionModel, receiver_class: String, values: List<String>, implicit: Boolean) {
    if not function.declaration {
        leaves = true
        return
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var bound = values.join(",")
    var function_name = function.key()
    var key = "{function_name}|{receiver_class}|{bound}"
    fallback not followed.contains(key)
    followed.append(key)
    var outer_group = group
    var outer_locals = locals
    var outer_this = this_class
    var outer_owner = owner_class
    var outer_key = function_key
    var outer_root = is_the_root
    var outer_implicit = is_implicit
    group = Dictionary<String, String>()
    locals = List<String>()
    this_class = receiver_class
    owner_class = function.owner
    function_key = function.key()
    is_the_root = false
    is_implicit = implicit
    bind_the_parameters(declaration, values)
    read_block(declaration.body)
    group = outer_group
    locals = outer_locals
    this_class = outer_this
    owner_class = outer_owner
    function_key = outer_key
    is_the_root = outer_root
    is_implicit = outer_implicit
}

func bind_the_parameters(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    values: List<String>,
) {
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var value = ""
        if index < values.count() {
            value = values[index]
        }
        if parameter.is_variadic {
            let_go_of_any_from(values, index)
        }
        if is_in_the_group(value) and not parameter.is_variadic {
            group[parameter.name] = value
        } else {
            locals.append(parameter.name)
        }
        index = index + 1
    }
}

func let_go_of_any_from(values: List<String>, first: Integer) {
    var index = first
    while index < values.count() {
        var value = values[index]
        let_go_of(value)
        index = index + 1
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func make(class_key: String, values: List<String>): String {
    var model = classes[class_key]
    if not model {
        let_go_of_any(values)
        return ""
    }
    if model.is_singleton {
        let_go_of_any(values)
        return ""
    }
    var is_held = reaching.contains(class_key)
    var receiver = ""
    if is_held {
        receiver = class_key
        walk_the_making(model)
    }
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.is_a_constructor() {
            walk_a_function(function, receiver, values, true)
        }
        index = index + 1
    }
    fallback is_held
    return class_key
}

func walk_the_making(model: ClassModel) {
    fallback not made_classes.contains(model.key)
    made_classes.append(model.key)
    var outer_group = group
    var outer_locals = locals
    var outer_this = this_class
    var outer_owner = owner_class
    var outer_key = function_key
    var outer_root = is_the_root
    var outer_implicit = is_implicit
    group = Dictionary<String, String>()
    locals = List<String>()
    this_class = model.key
    owner_class = model.key
    function_key = "{model.key}.defaults"
    is_the_root = false
    is_implicit = true
    model.declared_attributes.each(read_a_default)
    group = outer_group
    locals = outer_locals
    this_class = outer_this
    owner_class = outer_owner
    function_key = outer_key
    is_the_root = outer_root
    is_implicit = outer_implicit
    var drop = model.function_named("drop")
    fallback drop
    var no_values = List<String>()
    walk_a_function(drop, model.key, no_values, true)
}

func read_a_default(attribute: AttributeModel) {
    fallback attribute.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration = attribute.declaration
    fallback declaration.value
    var value = value_of(declaration.value)
    store_into(this_class, attribute.name, value)
}

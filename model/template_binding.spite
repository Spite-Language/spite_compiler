var template_index = -1
var member: String
var member_type: Type?
var member_is_a_function: Boolean
var member_index: Integer
var shape: String
var chained_function: String
var pattern: BoundPattern?
var compared: ComparedValue?

func TemplateBinding(
    starting_template_index: Integer,
    starting_member: String,
    starting_member_type: Type?,
    starting_member_is_a_function: Boolean,
    starting_member_index: Integer,
    starting_shape: String,
    starting_chained_function: String,
    starting_pattern: BoundPattern?,
    starting_compared: ComparedValue?,
) {
    template_index = starting_template_index
    member = starting_member
    member_type = starting_member_type
    member_is_a_function = starting_member_is_a_function
    member_index = starting_member_index
    shape = starting_shape
    chained_function = starting_chained_function
    pattern = starting_pattern
    compared = starting_compared
}

func pattern_or_empty(): BoundPattern {
    if pattern {
        return pattern
    }
    return BoundPattern("", "", "", false)
}

var is_learned = false
var linked = List<String>()
var linked_by_the_made = List<String>()
var linked_side_by_side = List<String>()
var leaving_side_by_side = List<String>()
var stored_apart = List<String>()
var reading_body: AbstractSyntaxTree.Shapes.Statements.Block? = null
var forwarded = Dictionary<String, List<String>>()
var back_keys = List<String>()
var counted_keys = List<String>()
var stores = List<BackReferenceStore>()
var locals = List<String>()
var aliases = Dictionary<String, String>()
var made_count = 0
var summaries = Dictionary<String, List<BackReferenceStore>>()
var named_counts = Dictionary<String, Integer>()
var is_summarizing = false
var expands_while_summarizing = false
var appending = ["append", "insert", "prepend", "add", "set_at"]
var deepest_key = 4
var callers = Dictionary<String, List<String>>()
var changed_names = List<String>()
var summarized_functions = Dictionary<String, FunctionModel>()
var summarizing_name = ""
var reading_key = ""
var reading_class = ""
var classes_of_locals = Dictionary<String, String>()
var classes_of_the_made = Dictionary<String, String>()
var constructed_classes = Dictionary<String, String>()
var known_classes = Dictionary<String, ClassModel>()

func holds_no_count(program: ProgramModel, attribute: AttributeModel): Boolean {
    var key = "{attribute.owner}.{attribute.name}"
    if back_keys.contains(key) {
        return true
    }
    fallback not counted_keys.contains(key)
    learn(program)
    var answer = points_back(program, attribute)
    if answer {
        back_keys.append(key)
    } else {
        counted_keys.append(key)
    }
    return answer
}

func learn(program: ProgramModel) {
    fallback not is_learned
    is_learned = true
    known_classes = program.classes
    program.order.each(note_the_constructors)
    program.order.each(count_the_names)
    is_summarizing = true
    program.order.each(summarize_the_class)
    expands_while_summarizing = true
    var waiting = summarized_functions.keys()
    while not waiting.is_empty() {
        changed_names = List<String>()
        waiting.each(summarize_a_named_function)
        waiting = callers_of_the_changed()
    }
    is_summarizing = false
    program.order.each(read_the_class)
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func callers_of_the_changed(): List<String> {
    var waiting = List<String>()
    var index = 0
    while index < changed_names.count() {
        var changed = changed_names[index]
        var calling = callers[changed]
        if calling {
            add_the_new(waiting, calling)
        }
        index = index + 1
    }
    return waiting
}

func add_the_new(waiting: List<String>, calling: List<String>) {
    var index = 0
    while index < calling.count() {
        var name = calling[index]
        if not waiting.contains(name) {
            waiting.append(name)
        }
        index = index + 1
    }
}

func summarize_a_named_function(name: String) {
    var function = summarized_functions[name]
    fallback function
    summarize_a_function(function)
}

func note_a_caller(name: String) {
    fallback not summarizing_name.is_empty() and not expands_while_summarizing
    var calling = callers[name]
    if not calling {
        var made = List<String>()
        callers[name] = made
        calling = made
    }
    crash calling
    fallback not calling.contains(summarizing_name)
    calling.append(summarizing_name)
}

func count_the_names(model: ClassModel) {
    model.declared_functions.each(count_a_name)
}

func count_a_name(function: FunctionModel) {
    var known = named_counts[function.name]
    var count = 1
    if known {
        count = known + 1
    }
    named_counts[function.name] = count
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func summarize_the_class(model: ClassModel) {
    fallback model.bound_types.count() == 0
    model.declared_functions.each(summarize_a_function)
}

func summarize_a_function(function: FunctionModel) {
    fallback not function.is_a_constructor()
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    var summary_key = summary_key_of(function)
    summarized_functions[summary_key] = function
    summarizing_name = summary_key
    start_reading(function, declaration)
    summarizing_name = ""
    var names = List<String>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        names.append(parameter.name)
        index = index + 1
    }
    var summary = List<BackReferenceStore>()
    var store_index = 0
    while store_index < stores.count() {
        var store = stores[store_index]
        var holder = summarized_key(store.holder, names)
        var value = summarized_key(store.value, names)
        if holder and value and is_kept_in_a_summary(summary, holder, store.attribute, value) {
            var kept = BackReferenceStore(holder, store.attribute, value)
            summary.append(kept)
        }
        store_index = store_index + 1
    }
    var known_count = 0
    var known = summaries[summary_key]
    if known {
        known_count = known.count()
    }
    if summary.count() != known_count {
        changed_names.append(summary_key)
    }
    if not summary.is_empty() {
        summaries[summary_key] = summary
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func summary_key_of(function: FunctionModel): String {
    if named_counts[function.name] == 1 {
        return function.name
    }
    return function.key()
}

func called_key(name: String, receiver_key: String): String {
    if named_counts[name] == 1 {
        return name
    }
    var receiver_class = class_of_key(receiver_key)
    fallback not receiver_class.is_empty()
    return "{receiver_class}.{name}"
}

func class_of_key(key: String): String {
    var parts = key.split(".")
    var head = parts[0]
    crash head
    var found = class_of_a_head(head)
    var index = 1
    while index < parts.count() and not found.is_empty() {
        var part = parts[index]
        found = class_of_an_attribute(found, part)
        index = index + 1
    }
    return found
}

func class_of_a_head(head: String): String {
    if head == "this" {
        return reading_class
    }
    var known = classes_of_the_made[head]
    if head.starts_with("#") and known {
        return known
    }
    var local = classes_of_locals[head]
    fallback local
    return local
}

func class_of_an_attribute(class_key: String, name: String): String {
    var model = known_classes[class_key]
    fallback model
    var attribute = model.attribute_named(name)
    fallback attribute
    return class_of_a_type(attribute.attribute_type)
}

func class_of_a_type(held: Type): String {
    fallback held.kind == 'object' and known_classes.contains(held.name)
    return held.name
}

func note_the_class_of_a_parameter(parameter: ParameterModel) {
    var class_key = class_of_a_type(parameter.parameter_type)
    fallback not class_key.is_empty()
    classes_of_locals[parameter.name] = class_key
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func is_kept_in_a_summary(
    summary: List<BackReferenceStore>,
    holder: String,
    attribute: String,
    value: String,
): Boolean {
    var holder_parts = holder.split(".")
    var value_parts = value.split(".")
    fallback holder_parts.count() <= deepest_key and value_parts.count() <= deepest_key
    var index = 0
    while index < summary.count() {
        var known = summary[index]
        var is_the_same = known.holder == holder and known.attribute == attribute and known.value == value
        fallback not is_the_same
        index = index + 1
    }
    return true
}

func summarized_key(key: String, parameter_names: List<String>): String? {
    if key == "this" or key.starts_with("this.") or key.starts_with("#") {
        return key
    }
    var head = key
    var rest = ""
    var dot = key.index_of(".")
    if dot {
        var length = key.length()
        var sliced_head = key.slice(0, dot)
        crash sliced_head
        head = sliced_head
        var sliced_rest = key.slice(dot, length)
        crash sliced_rest
        rest = sliced_rest
    }
    var index = 0
    while index < parameter_names.count() {
        var name = parameter_names[index]
        if name == head {
            return "@{index}{rest}"
        }
        index = index + 1
    }
    return null
}

func expand_a_call(name: String, receiver_key: String, arguments: List<SpiteCompiler.Expression>) {
    var summary_key = called_key(name, receiver_key)
    fallback not summary_key.is_empty()
    if is_summarizing {
        note_a_caller(summary_key)
    }
    fallback expands_while_summarizing or not is_summarizing
    var summary = summaries[summary_key]
    fallback summary
    var argument_keys = List<String>()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var argument_key = key_of(argument)
        argument_keys.append(argument_key)
        index = index + 1
    }
    var store_index = 0
    while store_index < summary.count() {
        var store = summary[store_index]
        var holder = placed_key(store.holder, receiver_key, argument_keys)
        var value = placed_key(store.value, receiver_key, argument_keys)
        var is_another_reading = is_made_by_this_reading(store.holder) or is_made_by_this_reading(store.value)
        if holder and value and not is_another_reading {
            add_a_followed_store(holder, store.attribute, value)
        }
        store_index = store_index + 1
    }
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func is_made_by_this_reading(key: String): Boolean {
    return key.starts_with("#{reading_key}:")
}

func placed_key(key: String, receiver_key: String, argument_keys: List<String>): String? {
    if key.starts_with("#") {
        return key
    }
    var head = key
    var rest = ""
    var dot = key.index_of(".")
    if dot {
        var length = key.length()
        var sliced_head = key.slice(0, dot)
        crash sliced_head
        head = sliced_head
        var sliced_rest = key.slice(dot, length)
        crash sliced_rest
        rest = sliced_rest
    }
    var placed = ""
    if head == "this" {
        placed = receiver_key
    } else {
        var head_length = head.length()
        var digits = head.slice(1, head_length)
        crash digits
        var position: Integer? = digits
        crash position
        var argument_key = argument_keys[position]
        fallback argument_key
        placed = argument_key
    }
    fallback not placed.is_empty()
    return "{placed}{rest}"
}

func note_the_constructors(model: ClassModel) {
    fallback model.bound_types.count() == 0
    model.declared_functions.each(note_a_constructor)
}

func note_a_constructor(function: FunctionModel) {
    fallback function.is_a_constructor() and not forwarded.contains(function.name)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    start_reading(function, declaration)
    var kept = List<String>()
    var index = 0
    while index < declaration.parameters.count() {
        var parameter = declaration.parameters[index]
        var stored = attribute_given(parameter.name)
        kept.append(stored)
        index = index + 1
    }
    forwarded[function.name] = kept
    constructed_classes[function.name] = function.owner
}

func attribute_given(parameter_name: String): String {
    var index = 0
    while index < stores.count() {
        var store = stores[index]
        if store.holder == "this" and store.value == parameter_name {
            return store.attribute
        }
        index = index + 1
    }
    return ""
}

func read_the_class(model: ClassModel) {
    fallback model.bound_types.count() == 0
    model.declared_functions.each(read_a_function)
}

func read_a_function(function: FunctionModel) {
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    start_reading(function, declaration)
    reading_body = declaration.body
    stores.each(link_back)
    stores.each(note_a_store_apart)
}

func start_reading(function: FunctionModel, declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration) {
    var function_key = function.key()
    reading_key = function_key.replace(".", ":")
    reading_class = function.owner
    made_count = 0
    stores = List<BackReferenceStore>()
    locals = List<String>()
    aliases = Dictionary<String, String>()
    classes_of_locals = Dictionary<String, String>()
    declaration.parameters.each(note_a_parameter)
    function.parameters.each(note_the_class_of_a_parameter)
    read_block(declaration.body)
}

func note_a_parameter(parameter: AbstractSyntaxTree.Shapes.Declarations.Parameter) {
    locals.append(parameter.name)
}

func link_back(store: BackReferenceStore) {
    var index = 0
    while index < stores.count() {
        var other = stores[index]
        var closes = other.holder == store.value and other.value == store.holder
        if closes and store.attribute != other.attribute and store.holder != store.value {
            note_a_link(store, other)
        }
        index = index + 1
    }
}

func note_a_link(store: BackReferenceStore, other: BackReferenceStore) {
    var link = "{store.attribute}|{other.attribute}"
    if not linked.contains(link) {
        linked.append(link)
    }
    note_a_link_made_side_by_side(link, store, other)
    var is_made_here = store.holder.starts_with("#") and not store.value.starts_with("#")
    fallback is_made_here and not linked_by_the_made.contains(link)
    linked_by_the_made.append(link)
}

func read_block(block: AbstractSyntaxTree.Shapes.Statements.Block?) {
    fallback block
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.WrittenStatement) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: read_variable(statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: read_assignment(statement)
        AbstractSyntaxTree.Shapes.Statements.ExpressionStatement: read_expression_statement(statement)
        AbstractSyntaxTree.Shapes.Statements.IfStatement: read_if(statement)
        AbstractSyntaxTree.Shapes.Statements.WhileStatement: read_block(statement.body)
        AbstractSyntaxTree.Shapes.Statements.SwitchStatement: read_switch(statement)
        AbstractSyntaxTree.Shapes.Statements.Block: read_block(statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: return
        AbstractSyntaxTree.Shapes.Statements.FallbackStatement: return
        AbstractSyntaxTree.Shapes.Statements.CrashStatement: return
        AbstractSyntaxTree.Shapes.Statements.LoadStatement: return
    }
}

func read_if(statement: AbstractSyntaxTree.Shapes.Statements.IfStatement) {
    read_block(statement.then_branch)
    read_block(statement.else_branch)
}

func read_switch(statement: AbstractSyntaxTree.Shapes.Statements.SwitchStatement) {
    var index = 0
    while index < statement.cases.count() {
        var switch_case = statement.cases[index]
        read_block(switch_case.body)
        index = index + 1
    }
}

func read_variable(statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement) {
    locals.append(statement.name)
    fallback statement.value
    var key = key_of(statement.value)
    alias_a_local(statement.name, key)
}

func alias_a_local(name: String, key: String) {
    var aliased = name
    if key.starts_with("#") {
        aliased = key
    }
    aliases[name] = aliased
}

func read_assignment(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement) {
    crash statement.target
    crash statement.value
    var key = key_of(statement.value)
    assign_to(statement.target, key)
}

func assign_to(target: SpiteCompiler.Expression, key: String) {
    switch target {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: assign_a_name(target.name, key)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: store_into_a_member(target, key)
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: store_into_an_item(target, key)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return
    }
}

func assign_a_name(name: String, key: String) {
    if locals.contains(name) {
        alias_a_local(name, key)
    } else {
        store_into_a_name(name, key)
    }
}

func store_into_a_name(name: String, key: String) {
    fallback not locals.contains(name)
    add_a_store("this", name, key)
}

func store_into_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, key: String) {
    crash member.target
    var holder_key = key_of(member.target)
    add_a_store(holder_key, member.name, key)
}

func store_into_an_item(item: AbstractSyntaxTree.Shapes.Expressions.IndexExpression, key: String) {
    crash item.target
    store_into(item.target, key)
}

func store_into(collection: SpiteCompiler.Expression, key: String) {
    switch collection {
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: store_into_a_member(collection, key)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: store_into_a_name(collection.name, key)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return
    }
}

func add_a_store(holder: String, attribute: String, value: String) {
    fallback not holder.is_empty() and not attribute.is_empty() and not value.is_empty()
    var store = BackReferenceStore(holder, attribute, value)
    stores.append(store)
}

func add_a_followed_store(holder: String, attribute: String, value: String) {
    fallback not holder.is_empty() and not attribute.is_empty() and not value.is_empty()
    var store = BackReferenceStore(holder, attribute, value)
    store.is_followed = true
    stores.append(store)
}

func read_expression_statement(statement: AbstractSyntaxTree.Shapes.Statements.ExpressionStatement) {
    crash statement.value
    read_an_expression(statement.value)
}

func read_an_expression(value: SpiteCompiler.Expression) {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        read_a_call(value)
    } else {
        return
    }
}

func read_a_call(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression) {
    crash call.callee
    read_a_callee(call.callee, call.arguments)
}

func read_a_callee(callee: SpiteCompiler.Expression, arguments: List<SpiteCompiler.Expression>) {
    switch callee {
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: read_a_method_call(callee, arguments)
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: read_an_own_call(callee, arguments)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return
    }
}

func read_an_own_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression,
    arguments: List<SpiteCompiler.Expression>,
) {
    fallback not locals.contains(callee.name)
    expand_a_call(callee.name, "this", arguments)
}

func read_a_method_call(
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    arguments: List<SpiteCompiler.Expression>,
) {
    crash callee.target
    if not appending.contains(callee.name) {
        var receiver_key = key_of(callee.target)
        expand_a_call(callee.name, receiver_key, arguments)
        return
    }
    var item = arguments.last()
    fallback item
    var item_key = key_of(item)
    store_into(callee.target, item_key)
}

func key_of(expression: SpiteCompiler.Expression): String {
    switch expression {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return key_of_a_name(expression.name)
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return key_of_a_literal(expression)
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return key_of_a_member(expression)
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return made_by(expression)
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return ""
    }
}

func key_of_a_name(name: String): String {
    var aliased = aliases[name]
    if aliased {
        return aliased
    }
    if locals.contains(name) {
        return name
    }
    return "this.{name}"
}

func key_of_a_literal(literal: AbstractSyntaxTree.Shapes.Expressions.LiteralExpression): String {
    if literal.kind == 'keyword_this' {
        return "this"
    }
    return ""
}

func key_of_a_member(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): String {
    crash member.target
    var target_key = key_of(member.target)
    fallback not target_key.is_empty()
    return "{target_key}.{member.name}"
}

func made_by(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression): String {
    read_a_call(call)
    crash call.callee
    var name = called_name(call.callee)
    var kept = forwarded[name]
    var made = ""
    if kept {
        made_count = made_count + 1
        made = "#{reading_key}:{made_count}"
        forward_the_arguments(made, kept, call.arguments)
        note_the_class_made(made, name)
    }
    return made
}

func note_the_class_made(made: String, name: String) {
    fallback named_counts[name] == 1
    var made_class = constructed_classes[name]
    fallback made_class
    classes_of_the_made[made] = made_class
}

func called_name(callee: SpiteCompiler.Expression): String {
    switch callee {
        AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression: return callee.name
        AbstractSyntaxTree.Shapes.Expressions.MemberExpression: return callee.name
        AbstractSyntaxTree.Shapes.Expressions.LiteralExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.TextLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.CallExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.IndexExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.BinaryExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.UnaryExpression: return ""
        AbstractSyntaxTree.Shapes.Expressions.ListLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral: return ""
        AbstractSyntaxTree.Shapes.Expressions.EntryLiteral: return ""
    }
}

func forward_the_arguments(made: String, kept: List<String>, arguments: List<SpiteCompiler.Expression>) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        var stored = kept[index]
        if stored {
            forward_an_argument(made, stored, argument)
        }
        index = index + 1
    }
}

func forward_an_argument(made: String, stored: String, argument: SpiteCompiler.Expression) {
    var argument_key = key_of(argument)
    add_a_store(made, stored, argument_key)
}

func points_back(program: ProgramModel, attribute: AttributeModel): Boolean {
    var held = attribute.attribute_type
    var is_a_single_object = held.kind == 'object' and held.is_nullable and held.name != "String"
    var holder = program.class_named(attribute.owner)
    var target = program.class_named(held.name)
    if is_a_single_object and holder and target {
        return is_held_back(program, attribute, holder, target)
    }
    var is_a_choice = held.kind == 'union' or held.kind == 'shape'
    if is_a_choice and held.is_nullable and holder {
        return is_held_back_by_every_class(program, attribute, holder)
    }
    return false
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func is_held_back_by_every_class(program: ProgramModel, attribute: AttributeModel, holder: ClassModel): Boolean {
    var keys = classes_held_by(program, attribute)
    fallback not keys.is_empty()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var target = program.class_named(key)
        fallback target and target.key != "String"
        fallback is_held_back(program, attribute, holder, target)
        index = index + 1
    }
    return true
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func classes_held_by(program: ProgramModel, attribute: AttributeModel): List<String> {
    var held = attribute.attribute_type
    var keys = List<String>()
    if held.kind == 'union' {
        add_the_members(program, held, keys)
    }
    if held.kind == 'shape' {
        add_the_fitting_classes(program, held, keys)
    }
    return keys
}

func add_the_members(program: ProgramModel, held: Type, keys: List<String>) {
    var parts = held.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = program.class_named(owner_key)
    fallback owner
    var declared_union = owner.union_named(simple)
    fallback declared_union
    var index = 0
    while index < declared_union.members.count() {
        var member = declared_union.members[index]
        keys.append(member.name)
        index = index + 1
    }
}

func add_the_fitting_classes(program: ProgramModel, held: Type, keys: List<String>) {
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        if fits_the_shape(program, held, model.key) {
            keys.append(model.key)
        }
        index = index + 1
    }
}

func is_held_back(program: ProgramModel, attribute: AttributeModel, holder: ClassModel, target: ClassModel): Boolean {
    fallback not holder.is_singleton and not target.is_singleton
    fallback holder.bound_types.count() <= 0 and target.bound_types.count() <= 0
    var index = 0
    while index < target.declared_attributes.count() {
        var owning = target.declared_attributes[index]
        if is_owned_across(program, attribute, holder, owning) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_owned_across(
    program: ProgramModel,
    attribute: AttributeModel,
    holder: ClassModel,
    owning: AttributeModel,
): Boolean {
    var link = "{attribute.name}|{owning.name}"
    var is_itself = owning.owner == attribute.owner and owning.name == attribute.name
    fallback not is_itself and linked.contains(link)
    fallback holds_the_class(program, owning.attribute_type, holder.key)
    var owning_type = owning.attribute_type
    var may_point_back = owning_type.kind == 'object' and owning_type.is_nullable and owning_type.name == holder.key
    if not may_point_back {
        return true
    }
    var other_way = "{owning.name}|{attribute.name}"
    if linked_by_the_made.contains(link) or linked_by_the_made.contains(other_way) {
        return linked_by_the_made.contains(link) and not linked_by_the_made.contains(other_way)
    }
    return is_linked_side_by_side(link, other_way, attribute.name)
}

func holds_the_class(program: ProgramModel, held: Type, key: String): Boolean {
    fallback held.kind == 'object'
    if held.name == key {
        return true
    }
    var model = program.class_named(held.name)
    if model {
        return holds_as_an_item(program, model, key)
    }
    return false
}

func holds_as_an_item(program: ProgramModel, model: ClassModel, key: String): Boolean {
    var names = model.bound_types.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var bound = model.bound_types[name]
        crash bound
        if is_an_item_of_the_class(program, bound, key) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func is_an_item_of_the_class(program: ProgramModel, item: Type, key: String): Boolean {
    if item.kind == 'union' {
        return is_a_member_of_the_union(program, item, key)
    }
    if item.kind == 'shape' {
        return fits_the_shape(program, item, key)
    }
    return item.kind == 'object' and item.name == key
}

func is_a_member_of_the_union(program: ProgramModel, item: Type, key: String): Boolean {
    var parts = item.name.split(".")
    var last = parts.count() - 1
    var simple = parts[last]
    crash simple
    parts.remove_at(last)
    var owner_key = parts.join(".")
    var owner = program.class_named(owner_key)
    fallback owner
    var declared_union = owner.union_named(simple)
    fallback declared_union
    var index = 0
    while index < declared_union.members.count() {
        var member = declared_union.members[index]
        if member.kind == 'object' and member.name == key {
            return true
        }
        index = index + 1
    }
    return false
}

func fits_the_shape(program: ProgramModel, item: Type, key: String): Boolean {
    var shape = program.shape_keyed(item.name)
    fallback shape
    var model = program.class_named(key)
    fallback model
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        var is_an_attribute = model.attribute_named(member.name)
        var is_a_function = model.function_named(member.name)
        fallback is_an_attribute or is_a_function
        index = index + 1
    }
    return true
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func note_a_link_made_side_by_side(link: String, store: BackReferenceStore, other: BackReferenceStore) {
    fallback is_made_plainly_here(store.holder) and is_made_plainly_here(store.value)
    fallback made_place(store.holder) > made_place(store.value)
    if pair_stays_in_its_function(store, other) {
        add_once(linked_side_by_side, link)
    } else {
        add_once(leaving_side_by_side, link)
    }
}

func add_once(found: List<String>, link: String) {
    fallback not found.contains(link)
    found.append(link)
}

func is_made_plainly_here(key: String): Boolean {
    fallback is_made_by_this_reading(key)
    var dot = key.index_of(".")
    return not dot
}

func made_place(key: String): Integer {
    var parts = key.split(":")
    var digits = parts.last()
    crash digits
    var place: Integer? = digits
    crash place
    return place
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func pair_stays_in_its_function(store: BackReferenceStore, other: BackReferenceStore): Boolean {
    var holder_class = classes_of_the_made[store.holder]
    var value_class = classes_of_the_made[store.value]
    fallback holder_class and value_class
    var holder_model = known_classes[holder_class]
    var value_model = known_classes[value_class]
    fallback holder_model and value_model
    fallback not stores_the_pair_apart(store, other)
    var names = List<String>()
    add_the_names_holding(names, store.holder)
    add_the_names_holding(names, store.value)
    var links = [store.attribute, other.attribute]
    var classes = [holder_model, value_model]
    var walk = MadePairWalk(names, links, classes)
    walk.read_the_function(reading_body)
    return not walk.leaves
}

func stores_the_pair_apart(store: BackReferenceStore, other: BackReferenceStore): Boolean {
    var index = 0
    while index < stores.count() {
        var found = stores[index]
        var is_a_link = is_the_same_store(found, store) or is_the_same_store(found, other)
        var holds_the_pair = holds_a_made(found.value, store.holder) or holds_a_made(found.value, store.value)
        if holds_the_pair and not is_a_link {
            return true
        }
        index = index + 1
    }
    return false
}

func is_the_same_store(found: BackReferenceStore, store: BackReferenceStore): Boolean {
    return found.holder == store.holder and found.attribute == store.attribute and found.value == store.value
}

func holds_a_made(value: String, made: String): Boolean {
    return value == made or value.starts_with("{made}.")
}

func add_the_names_holding(names: List<String>, made: String) {
    var keys = aliases.keys()
    var index = 0
    while index < keys.count() {
        var name = keys[index]
        if aliases[name] == made {
            names.append(name)
        }
        index = index + 1
    }
}

func note_a_store_apart(store: BackReferenceStore) {
    fallback not store.is_followed
    var is_side_by_side = is_made_plainly_here(store.holder) and is_made_plainly_here(store.value)
    fallback not is_side_by_side or not closes_a_pair(store)
    add_once(stored_apart, store.attribute)
}

func closes_a_pair(store: BackReferenceStore): Boolean {
    var index = 0
    while index < stores.count() {
        var other = stores[index]
        var closes = other.holder == store.value and other.value == store.holder
        if closes and other.attribute != store.attribute {
            return true
        }
        index = index + 1
    }
    return false
}

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func is_linked_side_by_side(link: String, other_way: String, name: String): Boolean {
    fallback linked_side_by_side.contains(link) and not linked_side_by_side.contains(other_way)
    fallback not leaving_side_by_side.contains(link) and not leaving_side_by_side.contains(other_way)
    return not stored_apart.contains(name)
}

var callees = Dictionary<String, List<String>>()
var visited = Dictionary<String, Boolean>()
var finished = List<String>()
var cycle_of = Dictionary<String, Integer>()
var callers: Dictionary<String, List<String>>

# ../PROOFS.md#a-back-reference-is-picked-from-how-the-program-links-its-objects
func CallCycles(calling: Dictionary<String, List<String>>) {
    callers = calling
    var called_names = callers.keys()
    called_names.each(note_the_callees_of)
    var calling_names = callees.keys()
    calling_names.each(finish_from)
    called_names.each(finish_from)
    var cycle = 0
    var index = finished.count() - 1
    while index >= 0 {
        var name = finished[index]
        crash name
        if not cycle_of.contains(name) {
            cycle = cycle + 1
            gather_a_cycle(name, cycle)
        }
        index = index - 1
    }
}

func are_in_one_cycle(first: String, second: String): Boolean {
    var first_cycle = cycle_of[first]
    var second_cycle = cycle_of[second]
    fallback first_cycle and second_cycle
    return first_cycle == second_cycle
}

func note_the_callees_of(called: String) {
    var calling = callers[called]
    crash calling
    var index = 0
    while index < calling.count() {
        var caller = calling[index]
        add_a_callee(caller, called)
        index = index + 1
    }
}

func add_a_callee(caller: String, called: String) {
    var known = callees[caller]
    if known {
        known.append(called)
        return
    }
    var made = List<String>()
    made.append(called)
    callees[caller] = made
}

func finish_from(start: String) {
    fallback not visited.contains(start)
    visited[start] = true
    var path = List<String>()
    var positions = List<Integer>()
    path.append(start)
    positions.append(0)
    while not path.is_empty() {
        var last = path.count() - 1
        var name = path[last]
        var position = positions[last]
        crash name
        crash position
        var called = callees[name]
        if called and position < called.count() {
            positions[last] = position + 1
            var next = called[position]
            visit(next, path, positions)
        } else {
            finished.append(name)
            crash path.remove_last()
            crash positions.remove_last()
        }
    }
}

func visit(name: String, path: List<String>, positions: List<Integer>) {
    fallback not visited.contains(name)
    visited[name] = true
    path.append(name)
    positions.append(0)
}

func gather_a_cycle(start: String, cycle: Integer) {
    cycle_of[start] = cycle
    var waiting = List<String>()
    waiting.append(start)
    while not waiting.is_empty() {
        var name = waiting.remove_last()
        crash name
        var calling = callers[name]
        if calling {
            join_the_cycle(calling, cycle, waiting)
        }
    }
}

func join_the_cycle(calling: List<String>, cycle: Integer, waiting: List<String>) {
    var index = 0
    while index < calling.count() {
        var caller = calling[index]
        if not cycle_of.contains(caller) {
            cycle_of[caller] = cycle
            waiting.append(caller)
        }
        index = index + 1
    }
}

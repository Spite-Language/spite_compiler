var classes = Dictionary<String, ClassModel>()
var order = List<ClassModel>()
var entry = ""
var shapes = Dictionary<String, ShapeModel>()
var shape_fillers = Dictionary<String, List<Type>>()
var back_references = BackReferences()
var kept_callbacks = KeptCallbacks()
var own_function_values = OwnFunctionValues()
var reload_host: ReloadHost? = null
var owners_held_by_observers = List<String>()
var left_out_classes = List<String>()

func add(model: ClassModel) {
    classes[model.key] = model
    order.append(model)
}

func class_named(key: String): ClassModel? {
    return classes[key]
}

func shape_keyed(key: String): ShapeModel? {
    return shapes[key]
}

func union_keyed(key: String): UnionModel? {
    var parts = key.split(".")
    fallback parts.count() > 1
    var simple = parts.remove_last()
    crash simple
    var owner = classes[parts.join(".")]
    fallback owner
    return owner.union_named(simple)
}

func fillers_of(shape_key: String): List<Type> {
    var known = shape_fillers[shape_key]
    if known {
        return known
    }
    var made = List<Type>()
    shape_fillers[shape_key] = made
    return made
}

func holds_no_count(attribute: AttributeModel): Boolean {
    return back_references.holds_no_count(this, attribute)
}

func closing_slot_of(function_key: String, local: String): AttributeModel? {
    return back_references.closing_slot_of(this, function_key, local)
}

func classes_held_by(attribute: AttributeModel): List<String> {
    return back_references.classes_held_by(this, attribute)
}

func keeps_its_callback(site: String): Boolean {
    return kept_callbacks.keeps_its_callback(this, site)
}

func callback_owners(): List<String> {
    return kept_callbacks.owners_of(this)
}

func function_held_back(attribute: AttributeModel): FunctionModel? {
    return own_function_values.function_held_back(this, attribute)
}

func stores_its_own_held_back(attribute: AttributeModel): Boolean {
    return own_function_values.stores_its_own_held_back(this, attribute)
}

func is_set_only_while_made(attribute: AttributeModel): Boolean {
    return own_function_values.is_set_only_while_made(this, attribute)
}

func function_value_owners(): List<String> {
    return own_function_values.owners_of(this)
}

func has(key: String): Boolean {
    return classes.contains(key)
}

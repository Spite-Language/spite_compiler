var classes = Dictionary<String, ClassModel>()
var order = List<ClassModel>()
var entry = ""
var shapes = Dictionary<String, ShapeModel>()
var shape_fillers = Dictionary<String, List<Type>>()
var back_references = BackReferences()
var reload_host: ReloadHost? = null
var breakpoint_sites = Dictionary<String, String>()

func add(model: ClassModel) {
    classes[model.key] = model
    order.append(model)
}

func class_named(key: String): ClassModel? {
    return classes[key]
}

func shape_keyed(key: String): ShapeModel? {
    return shapes[key]
}

func fillers_of(shape_key: String): List<Type> {
    var known = shape_fillers[shape_key]
    if known {
        return known
    }
    var made = List<Type>()
    shape_fillers[shape_key] = made
    return made
}

func holds_no_count(attribute: AttributeModel): Boolean {
    return back_references.holds_no_count(this, attribute)
}

func has(key: String): Boolean {
    return classes.contains(key)
}

var classes = Dictionary<String, ClassModel>()
var order = List<ClassModel>()
var entry = ""

func add(model: ClassModel) {
    classes[model.key] = model
    order.append(model)
}

func class_named(key: String): ClassModel? {
    return classes[key]
}

func has(key: String): Boolean {
    return classes.has(key)
}

# ../../spite_documentation/failure.md#a-crash-names-the-same-file-on-every-machine

singleton

var standard_library = Mapping.StandardLibrary()
var root_folders = List<String>()
var root_names = List<String>()

func add_root(folder: String, name: String) {
    var forward = folder.replace("\\", "/")
    root_folders.append(forward)
    root_names.append(name)
}

# ../../spite_documentation/failure.md#a-crash-names-the-same-file-on-every-machine
func shown(path: String): String {
    if standard_library.holds(path) {
        return standard_library.shown(path)
    }
    var forward = path.replace("\\", "/")
    var holding_name = ""
    var longest = 0
    var index = 0
    while index < root_folders.count() {
        var folder = root_folders[index]
        var length = folder.length()
        var name = root_names[index]
        crash name
        if forward.starts_with("{folder}/") and length > longest {
            holding_name = name
            longest = length
        }
        index = index + 1
    }
    if holding_name.is_empty() {
        return forward
    }
    var start = longest + 1
    var end = forward.length()
    var inside = forward.slice(start, end)
    crash inside
    return "{holding_name}/{inside}"
}

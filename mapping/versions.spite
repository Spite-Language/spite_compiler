# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
var places = List<String>()
var packages = List<String>()
var commits = List<String>()
var copies = List<String>()
var wheres = List<String>()
var paths = List<String>()
var lines = List<Integer>()
var texts = List<String>()
var repositories = List<String>()
var written_commits = List<String>()
var version_keys = List<String>()
var prefixes = List<String>()
var holdings = Dictionary<String, List<String>>()
var is_settled = false
var needed = false
var marker = ".spite/git/"
var shortest_commit = 7
var longest_commit = 40

func record(
    place: String,
    package: String,
    commit: String,
    copy: String,
    path: String,
    line: Integer,
    text: String,
    repository: String,
    written_commit: String,
) {
    assert not is_settled
    paths.append(path)
    lines.append(line)
    texts.append(text)
    wheres.append("{path}:{line} ('load \"{text}\"')")
    places.append(place)
    packages.append(package)
    commits.append(commit)
    copies.append(copy)
    repositories.append(repository)
    written_commits.append(written_commit)
}

func settle() {
    is_settled = true
    var index = 0
    while index < places.count() {
        var key = key_of(index)
        version_keys.append(key)
        index = index + 1
    }
    index = 0
    while index < places.count() {
        var prefix = prefix_of(index)
        prefixes.append(prefix)
        if not prefix.is_empty() {
            needed = true
        }
        index = index + 1
    }
}

func are_needed(): Boolean {
    return needed
}

func pin_count(): Integer {
    return places.count()
}

func key_of(index: Integer): String {
    var place = places[index]
    var package = packages[index]
    crash place
    var read = List<String>()
    var other = 0
    while other < places.count() {
        var commit = commits[other]
        crash commit
        var is_the_package = places[other] == place and packages[other] == package
        if is_the_package and not read.contains(commit) {
            read.append(commit)
        }
        other = other + 1
    }
    var joined = read.join(",")
    return "{place}:{joined}"
}

func conflict_of(index: Integer): Integer {
    var place = places[index]
    var commit = commits[index]
    var key = version_keys[index]
    var other = 0
    while other < index {
        var same_commit = places[other] == place and commits[other] == commit
        if same_commit and version_keys[other] != key {
            return other
        }
        other = other + 1
    }
    return -1
}

func first_pin_of_version(index: Integer): Integer {
    var key = version_keys[index]
    crash key
    var first_commit = first_commit_of(key)
    var other = 0
    while other < places.count() {
        if version_keys[other] == key and commits[other] == first_commit {
            return other
        }
        other = other + 1
    }
    return index
}

func first_commit_of(key: String): String {
    var colon = key.index_of(":")
    crash colon
    var length = key.length()
    var listed = key.slice(colon + 1, length)
    crash listed
    var read = listed.split(",")
    var first = read.first()
    crash first
    return first
}

func is_versioned(place: String): Boolean {
    var seen = List<String>()
    var index = 0
    while index < places.count() {
        var key = version_keys[index]
        crash key
        if places[index] == place and not seen.contains(key) {
            seen.append(key)
        }
        index = index + 1
    }
    return seen.count() > 1
}

func prefix_of(index: Integer): String {
    var place = places[index]
    crash place
    if not is_versioned(place) {
        return ""
    }
    var key = version_keys[index]
    crash key
    var first_commit = first_commit_of(key)
    var digits = digits_needed(place)
    var spelled = first_commit.slice(0, digits)
    crash spelled
    var name = name_of(place)
    return "{name}_{spelled}"
}

func digits_needed(place: String): Integer {
    var firsts = List<String>()
    var index = 0
    while index < places.count() {
        var key = version_keys[index]
        crash key
        var first_commit = first_commit_of(key)
        if places[index] == place and not firsts.contains(first_commit) {
            firsts.append(first_commit)
        }
        index = index + 1
    }
    var digits = shortest_commit
    while digits < longest_commit and any_share(firsts, digits) {
        digits = digits + 1
    }
    return digits
}

func any_share(firsts: List<String>, digits: Integer): Boolean {
    var spelled = List<String>()
    var index = 0
    while index < firsts.count() {
        var first_commit = firsts[index]
        var start = first_commit.slice(0, digits)
        crash start
        if spelled.contains(start) {
            return true
        }
        spelled.append(start)
        index = index + 1
    }
    return false
}

func name_of(place: String): String {
    var segments = place.split("/")
    var last = segments.last()
    crash last
    var cut = last.length()
    var found = false
    while cut > 0 and not found {
        var before = last[cut - 1]
        found = before == "_"
        cut = cut - 1
    }
    if not found {
        return last
    }
    var name = last.slice(0, cut)
    crash name
    return name
}

func package_of(path: String): String {
    var forward = path.replace("\\", "/")
    var at = forward.index_of(marker)
    if not at {
        return ""
    }
    var length = forward.length()
    var marker_length = marker.length()
    var rest = forward.slice(at + marker_length, length)
    crash rest
    var segments = rest.split("/")
    var label = segments[0]
    var commit = segments[1]
    crash label
    crash commit
    return "{label}/{commit}"
}

func prefixes_pinned_by(package: String): List<String> {
    var pinned = List<String>()
    var index = 0
    while index < places.count() {
        var prefix = prefixes[index]
        crash prefix
        var is_the_package = packages[index] == package
        if is_the_package and not prefix.is_empty() and not pinned.contains(prefix) {
            pinned.append(prefix)
        }
        index = index + 1
    }
    return pinned
}

func every_prefix(): List<String> {
    var every = List<String>()
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        if not prefix.is_empty() and not every.contains(prefix) {
            every.append(prefix)
        }
        index = index + 1
    }
    return every
}

func prefix_of_folder(path: String): String {
    if not needed {
        return ""
    }
    var forward = path.replace("\\", "/")
    var index = 0
    while index < copies.count() {
        var copy = copies[index]
        var prefix = prefixes[index]
        crash prefix
        var inside = forward == copy or forward.starts_with("{copy}/")
        if inside and not prefix.is_empty() {
            return prefix
        }
        index = index + 1
    }
    return ""
}

func unversioned(namespace: String): String {
    if not needed {
        return namespace
    }
    var index = 0
    while index < prefixes.count() {
        var prefix = prefixes[index]
        var opening = "{prefix}."
        if not prefix.is_empty() and namespace.starts_with(opening) {
            var length = namespace.length()
            var opening_length = opening.length()
            var rest = namespace.slice(opening_length, length)
            crash rest
            return rest
        }
        index = index + 1
    }
    return namespace
}

func learn_the_classes(map: FolderMap) {
    assert needed
    var library = Validators.LibraryFile()
    var every = map.every_class()
    var index = 0
    while index < every.count() {
        var class_file = every[index]
        var prefix = prefix_of_folder(class_file.path)
        var owners = map.class_files_of(class_file.namespace)
        var is_the_librarys = owners.any(library.holds_the_class)
        if not prefix.is_empty() and not is_the_librarys {
            hold(prefix, class_file.namespace)
        }
        index = index + 1
    }
}

func hold(prefix: String, namespace: String) {
    var held = holdings[prefix]
    if not held {
        var first_held = List<String>()
        first_held.append(namespace)
        holdings[prefix] = first_held
        return
    }
    if not held.contains(namespace) {
        held.append(namespace)
    }
}

func prefixes_holding(namespace: String): List<String> {
    var holding = List<String>()
    var every = every_prefix()
    var index = 0
    while index < every.count() {
        var prefix = every[index]
        var held = holdings[prefix]
        if held and held.contains(namespace) {
            holding.append(prefix)
        }
        index = index + 1
    }
    return holding
}

func listing_of(prefixes_listed: List<String>): String {
    var entries = List<String>()
    var index = 0
    while index < prefixes_listed.count() {
        var prefix = prefixes_listed[index]
        var entry = entry_of(prefix)
        entries.append(entry)
        index = index + 1
    }
    return entries.join("; ")
}

func entry_of(prefix: String): String {
    var index = 0
    while index < prefixes.count() {
        if prefixes[index] == prefix {
            var first = first_pin_of_version(index)
            var repository = repositories[first]
            var commit = written_commits[first]
            var where = wheres[first]
            crash repository and commit and where
            return "{repository}@{commit}, pinned by {where}"
        }
        index = index + 1
    }
    return prefix
}

func path_of(index: Integer): String {
    var path = paths[index]
    crash path
    return path
}

func line_of(index: Integer): Integer {
    var line = lines[index]
    crash line
    return line
}

func text_of(index: Integer): String {
    var text = texts[index]
    crash text
    return text
}

func repository_of(index: Integer): String {
    var repository = repositories[index]
    crash repository
    return repository
}

func written_commit_of(index: Integer): String {
    var commit = written_commits[index]
    crash commit
    return commit
}

func where_of(index: Integer): String {
    var where = wheres[index]
    crash where
    return where
}

func spelled_first_commit_of(index: Integer): String {
    var first = first_pin_of_version(index)
    var commit = written_commits[first]
    crash commit
    return commit
}

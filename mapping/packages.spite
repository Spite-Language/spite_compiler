# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
var marker = ".spite/git/"

func package_of(path: String): String {
    var forward = path.replace("\\", "/")
    var at = forward.index_of(marker)
    fallback at
    var length = forward.length()
    var marker_length = marker.length()
    var rest = forward.slice(at + marker_length, length)
    crash rest
    var segments = rest.split("/")
    var label = segments[0]
    var commit = segments[1]
    crash label
    crash commit
    return "{label}/{commit}"
}

func is_pinned(path: String): Boolean {
    var package = package_of(path)
    return not package.is_empty()
}

func repository_of(path: String): String {
    var package = package_of(path)
    var segments = package.split("/")
    var label = segments.first()
    crash label
    return label
}

func same_repository(first: String, second: String): Boolean {
    fallback is_pinned(first) and is_pinned(second)
    var first_repository = repository_of(first)
    var second_repository = repository_of(second)
    return first_repository == second_repository
}

func other_commits_of_one_repository(first: String, second: String): Boolean {
    fallback same_repository(first, second)
    var first_package = package_of(first)
    var second_package = package_of(second)
    return first_package != second_package
}

func is_pinned_class(class_file: ClassFile): Boolean {
    return is_pinned(class_file.path)
}

func is_own_class(class_file: ClassFile): Boolean {
    var pinned = is_pinned(class_file.path)
    return not pinned
}

var roots = List<Mapping.MappedFolder>()
var folders_by_namespace = Dictionary<String, Mapping.MappedFolder>()
var classes_by_namespace = Dictionary<String, List<Mapping.ClassFile>>()
var names = Mapping.Names()

var unmapped_path = ""

func add_root(path: String, loaded_from: String, line: Integer) {
    var directory = Directory(path)
    var folder_name = directory.name
    var named = Validators.Mapping.FolderName.Validator()
    named.check(path, folder_name, loaded_from, line)
    var exists = Validators.Mapping.FolderExists.Validator()
    exists.check(path, loaded_from, line)
    var already = is_a_root(directory.path)
    assert not already
    take_out_of_its_own_tree(directory.path, loaded_from)
    var namespace = names.of_folder(folder_name)
    var one_folder = Validators.Mapping.OneFolderPerNamespace.Validator(this)
    one_folder.check_load(directory.path, namespace, loaded_from, line)
    var folder = Mapping.MappedFolder(namespace, namespace, directory.path)
    folders_by_namespace[namespace] = folder
    roots.append(folder)
    map_entries(folder)
}

func is_a_root(path: String): Boolean {
    var index = 0
    while index < roots.count() {
        var root = roots[index]
        if same_folder(root.path, path) {
            return true
        }
        index = index + 1
    }
    return false
}

func take_out_of_its_own_tree(path: String, loaded_from: String) {
    var index = 0
    while index < roots.count() {
        var root = roots[index]
        var owns_it = inside(path, root.path) and inside(loaded_from, root.path)
        if owns_it {
            unmap(path)
        }
        index = index + 1
    }
}

func unmap(path: String) {
    unmapped_path = path
    var namespaces = folders_by_namespace.keys()
    namespaces.each(unmap_folder_if_inside)
    var class_names = classes_by_namespace.keys()
    class_names.each(unmap_class_if_inside)
}

func unmap_folder_if_inside(namespace: String) {
    var folder = folders_by_namespace[namespace]
    crash folder
    var outer = folder.folders.filter(stays_mapped)
    folder.folders = outer
    if is_inside_the_unmapped(folder.path) {
        folders_by_namespace.remove(namespace)
    }
}

func stays_mapped(folder: Mapping.MappedFolder): Boolean {
    var leaves = is_inside_the_unmapped(folder.path)
    return not leaves
}

func unmap_class_if_inside(namespace: String) {
    var files = classes_by_namespace[namespace]
    crash files
    var first = files[0]
    crash first
    if is_inside_the_unmapped(first.path) {
        classes_by_namespace.remove(namespace)
    }
}

func is_inside_the_unmapped(path: String): Boolean {
    return same_folder(path, unmapped_path) or inside(path, unmapped_path)
}

func same_folder(first: String, second: String): Boolean {
    return resolved(first) == resolved(second)
}

func root_overlapping(path: String, loaded_from: String): Mapping.MappedFolder? {
    var index = 0
    while index < roots.count() {
        var root = roots[index]
        var owns_it = inside(path, root.path) and inside(loaded_from, root.path)
        var path_inside = inside(path, root.path) and not owns_it
        if path_inside or inside(root.path, path) {
            return root
        }
        index = index + 1
    }
    return null
}

func inside(path: String, folder: String): Boolean {
    var prefix = "{resolved(folder)}/"
    return resolved(path).starts_with(prefix)
}

func resolved(path: String): String {
    var parts = path.replace("\\", "/").split("/")
    var kept = List<String>()
    var index = 0
    while index < parts.count() {
        var part = parts[index]
        if part == ".." {
            if not kept.is_empty() {
                kept.remove_last()
            }
        } else if not part.is_empty() and part != "." {
            kept.append(part)
        }
        index = index + 1
    }
    return kept.join("/")
}

func map_entries(folder: Mapping.MappedFolder) {
    var directory = Directory(folder.path)
    var folder_names = directory.entries().filter_directories().map_names()
    var index = 0
    while index < folder_names.count() {
        var folder_name = folder_names[index]
        if not is_hidden(folder_name) {
            map_sub_folder(folder, folder_name)
        }
        index = index + 1
    }
    var file_names = directory.entries().filter_files().map_names()
    index = 0
    while index < file_names.count() {
        var file_name = file_names[index]
        if is_spite_file(file_name) {
            map_file(folder, file_name)
        }
        index = index + 1
    }
}

func map_sub_folder(folder: Mapping.MappedFolder, folder_name: String) {
    var path = "{folder.path}/{folder_name}"
    var named = Validators.Mapping.FolderName.Validator()
    named.check_snake_case(path, folder_name, 0)
    var namespace = names.of_folder(folder_name)
    var once = Validators.Mapping.FileOrFolder.Validator()
    once.check(folder, namespace)
    var joined_namespace = names.joined(folder.key_prefix, namespace)
    var sub_folder = Mapping.MappedFolder(joined_namespace, namespace, path)
    sub_folder.key_prefix = joined_namespace
    var existing = folders_by_namespace[joined_namespace]
    if existing {
        merge_into(existing, sub_folder)
        return
    }
    folders_by_namespace[joined_namespace] = sub_folder
    folder.folders.append(sub_folder)
    map_entries(sub_folder)
}

func holds_the_folder(existing: Mapping.MappedFolder, namespace: String): Boolean {
    var index = 0
    while index < existing.folders.count() {
        var held = existing.folders[index]
        if held.namespace == namespace {
            return true
        }
        index = index + 1
    }
    return false
}

func merge_into(existing: Mapping.MappedFolder, reopening: Mapping.MappedFolder) {
    existing.paths.append(reopening.path)
    map_entries(reopening)
    reopening.files.each(existing.files.append)
    var index = 0
    while index < reopening.folders.count() {
        var inner = reopening.folders[index]
        if not holds_the_folder(existing, inner.namespace) {
            existing.folders.append(inner)
        }
        index = index + 1
    }
}

func map_file(folder: Mapping.MappedFolder, file_name: String) {
    var path = "{folder.path}/{file_name}"
    var spite_extension_length = 6
    var name_length = file_name.length()
    var base_name = file_name.slice(0, name_length - spite_extension_length)
    var named = Validators.Mapping.FileName.Validator()
    named.check(path, base_name)
    var simple_name = names.class_name_of(base_name)
    var once = Validators.Mapping.FileOrFolder.Validator()
    once.check(folder, simple_name)
    var namespace = names.joined(folder.key_prefix, simple_name)
    var mapped = Mapping.ClassFile(namespace, simple_name, path)
    folder.files.append(mapped)
    add_to_the_class(namespace, mapped)
}

func add_to_the_class(namespace: String, mapped: Mapping.ClassFile) {
    var known = classes_by_namespace[namespace]
    if known {
        known.append(mapped)
    } else {
        var files = List<Mapping.ClassFile>()
        files.append(mapped)
        classes_by_namespace[namespace] = files
    }
}

func is_spite_file(file_name: String): Boolean {
    return file_name.ends_with(".spite")
}

func is_hidden(name: String): Boolean {
    return name.starts_with(".")
}

func has(namespace: String): Boolean {
    return classes_by_namespace.has(namespace)
}

func class_count(): Integer {
    return classes_by_namespace.count()
}

func class_named(namespace: String): Mapping.ClassFile? {
    var files = classes_by_namespace[namespace]
    if files {
        var last = files.count() - 1
        return files[last]
    } else {
        return null
    }
}

func class_files_of(namespace: String): List<Mapping.ClassFile> {
    var files = classes_by_namespace[namespace]
    if files {
        return files
    } else {
        return List<Mapping.ClassFile>()
    }
}

func folder_named(namespace: String): Mapping.MappedFolder? {
    return folders_by_namespace[namespace]
}

func root_namespaces(): List<String> {
    return roots.map_namespaces()
}

func every_class(): List<Mapping.ClassFile> {
    var all = List<Mapping.ClassFile>()
    var index = 0
    while index < roots.count() {
        collect_classes(roots[index], all)
        index = index + 1
    }
    return all
}

func collect_classes(folder: Mapping.MappedFolder, into: List<Mapping.ClassFile>) {
    var index = 0
    while index < folder.files.count() {
        into.append(folder.files[index])
        index = index + 1
    }
    index = 0
    while index < folder.folders.count() {
        collect_classes(folder.folders[index], into)
        index = index + 1
    }
}

var _lowercase_z_code = 122

func last_segment(path: String): String {
    var trimmed = path
    var keep_going = trimmed.length() > 1
    while keep_going {
        var trimmed_length = trimmed.length()
        var last_letter = trimmed.slice(trimmed_length - 1, trimmed_length)
        crash last_letter
        if last_letter == "/" or last_letter == "\\" {
            var sliced_trimmed = trimmed.slice(0, trimmed_length - 1)
            crash sliced_trimmed
            trimmed = sliced_trimmed
            keep_going = trimmed_length > 1
        } else {
            keep_going = false
        }
    }
    var segments = trimmed.replace("\\", "/").split("/")
    var last = segments.last()
    crash last
    return last
}

func of_folder(folder_name: String): String {
    return class_name_of(folder_name)
}

func class_name_of(written: String): String {
    var spelled = ""
    var starts_word = true
    var index = 0
    while index < written.length() {
        var letter = written[index]
        crash letter
        if letter == "_" {
            starts_word = true
        } else if starts_word {
            spelled = "{spelled}{letter.upper_case()}"
            starts_word = false
        } else {
            spelled = "{spelled}{letter}"
        }
        index = index + letter.length()
    }
    return spelled
}

func written_in_snake_case(name: String): Boolean {
    fallback not name.is_empty()
    var first = name.byte_at(0)
    fallback is_lower_letter(first)
    var index = 1
    while index < name.length() {
        var code = name.byte_at(index)
        var allowed = is_lower_letter(code) or is_digit(code) or code == 95
        fallback allowed
        index = index + 1
    }
    return not name.ends_with("_") and not name.contains("__")
}

func is_lower_letter(code: Integer): Boolean {
    return code >= 97 and code <= _lowercase_z_code
}

func is_digit(code: Integer): Boolean {
    return code >= 48 and code <= 57
}

func snake_case_of(name: String): String {
    var written = ""
    var index = 0
    while index < name.length() {
        var letter = name[index]
        crash letter
        var separates = letter == "-" or letter == " " or letter == "." or letter == "_"
        if separates {
            if not written.is_empty() and not written.ends_with("_") {
                written = "{written}_"
            }
        } else {
            var lower = letter.lower_case()
            if lower != letter and not written.is_empty() and not written.ends_with("_") {
                written = "{written}_"
            }
            written = "{written}{lower}"
        }
        index = index + letter.length()
    }
    return written
}

# ../../spite_documentation/packages.md
func suggested_snake_case(name: String): String {
    var written = snake_case_of(name)
    var digits = leading_digits_of(written)
    var digits_length = digits.length()
    var written_length = written.length()
    var rest = written.slice(digits_length, written_length)
    crash rest
    var words = without_outer_underscores(rest)
    if digits.is_empty() or words.is_empty() {
        return "{digits}{words}"
    }
    return "{words}_{digits}"
}

func leading_digits_of(written: String): String {
    var length = written.length()
    var index = 0
    var is_a_digit = length > 0
    while is_a_digit {
        var code = written.byte_at(index)
        if is_digit(code) {
            index = index + 1
            is_a_digit = index < length
        } else {
            is_a_digit = false
        }
    }
    var digits = written.slice(0, index)
    crash digits
    return digits
}

func without_outer_underscores(written: String): String {
    var trimmed = written
    while trimmed.starts_with("_") {
        var front_length = trimmed.length()
        var without_front = trimmed.slice(1, front_length)
        crash without_front
        trimmed = without_front
    }
    while trimmed.ends_with("_") {
        var back_length = trimmed.length()
        var without_back = trimmed.slice(0, back_length - 1)
        crash without_back
        trimmed = without_back
    }
    return trimmed
}

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func has_one_right_spelling(name: String): Boolean {
    fallback not has_two_capitals_in_a_row(name)
    var spelled = right_spelling_of(name)
    return written_in_snake_case(spelled)
}

func right_spelling_of(name: String): String {
    var spelled = snake_case_of(name)
    while spelled.ends_with("_") {
        var length = spelled.length()
        var trimmed = spelled.slice(0, length - 1)
        crash trimmed
        spelled = trimmed
    }
    return spelled
}

func has_two_capitals_in_a_row(name: String): Boolean {
    var index = 1
    while index < name.length() {
        var before = name.byte_at(index - 1)
        var code = name.byte_at(index)
        if is_upper_letter(before) and is_upper_letter(code) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_upper_letter(code: Integer): Boolean {
    return code >= 65 and code <= 90
}

func joined(namespace: String, name: String): String {
    if namespace.is_empty() {
        return name
    }
    return "{namespace}.{name}"
}

func last_segment(path: String): String {
    var trimmed = path
    var keep_going = trimmed.length() > 1
    while keep_going {
        var trimmed_length = trimmed.length()
        var last_letter = trimmed.slice(trimmed_length - 1, trimmed_length)
        crash last_letter
        if last_letter == "/" or last_letter == "\\" {
            var sliced_trimmed = trimmed.slice(0, trimmed_length - 1)
            crash sliced_trimmed
            trimmed = sliced_trimmed
            keep_going = trimmed_length > 1
        } else {
            keep_going = false
        }
    }
    var segments = trimmed.replace("\\", "/").split("/")
    var last = segments.last()
    crash last
    return last
}

func of_folder(folder_name: String): String {
    return class_name_of(folder_name)
}

func class_name_of(written: String): String {
    var spelled = ""
    var starts_word = true
    var index = 0
    while index < written.length() {
        var letter = written[index]
        crash letter
        if letter == "_" {
            starts_word = true
        } else if starts_word {
            spelled = "{spelled}{letter.upper_case()}"
            starts_word = false
        } else {
            spelled = "{spelled}{letter}"
        }
        index = index + letter.length()
    }
    return spelled
}

func written_in_snake_case(name: String): Boolean {
    fallback not name.is_empty()
    var first = name.byte_at(0)
    fallback is_lower_letter(first)
    var index = 1
    while index < name.length() {
        var code = name.byte_at(index)
        var allowed = is_lower_letter(code) or is_digit(code) or code == 95
        fallback allowed
        index = index + 1
    }
    return not name.ends_with("_") and not name.contains("__")
}

func is_lower_letter(code: Integer): Boolean {
    return code >= 97 and code <= 122
}

func is_digit(code: Integer): Boolean {
    return code >= 48 and code <= 57
}

func snake_case_of(name: String): String {
    var written = ""
    var index = 0
    while index < name.length() {
        var letter = name[index]
        crash letter
        var separates = letter == "-" or letter == " " or letter == "." or letter == "_"
        if separates {
            if not written.is_empty() and not written.ends_with("_") {
                written = "{written}_"
            }
        } else {
            var lower = letter.lower_case()
            if lower != letter and not written.is_empty() and not written.ends_with("_") {
                written = "{written}_"
            }
            written = "{written}{lower}"
        }
        index = index + letter.length()
    }
    return written
}

func joined(namespace: String, name: String): String {
    if namespace.is_empty() {
        return name
    }
    return "{namespace}.{name}"
}

var folders = [
    "/spite_standard_library/common/",
    "/spite_standard_library/windows/",
    "/spite_standard_library/linux/",
    "/spite_standard_library/mac/",
]

func holds_the_class(class_file: Mapping.ClassFile): Boolean {
    return holds(class_file.path)
}

# ../../spite_spec/specs/repl.md#command-language
func is_typed_code(path: String): Boolean {
    var written = path.replace("\\", "/")
    return written.ends_with("/.spite/build/spite/prompt_code.spite")
}

func holds(path: String): Boolean {
    var written = path.replace("\\", "/")
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if written.contains(folder) {
            return true
        }
        index = index + 1
    }
    return written.contains("/.spite/build/spite/")
}

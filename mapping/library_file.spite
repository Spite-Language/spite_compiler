var folders = [
    "/spite_standard_library/common/"
    "/spite_standard_library/windows/"
    "/spite_standard_library/linux/"
    "/spite_standard_library/mac/"
]
var platforms = ["/spite_standard_library/windows", "/spite_standard_library/linux", "/spite_standard_library/mac"]
var platform_folder = "windows"

func holds_the_class(class_file: Mapping.ClassFile): Boolean {
    return holds(class_file.path)
}

# ../../spite_documentation/repl.md#the-wire-protocol
func is_typed_code(path: String): Boolean {
    var written = path.replace("\\", "/")
    return written.ends_with("/.spite/build/spite/prompt_code.spite")
}

func holds(path: String): Boolean {
    var written = path.replace("\\", "/")
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if written.contains(folder) {
            return true
        }
        index = index + 1
    }
    return written.contains("/.spite/build/spite/")
}

# ../../spite_documentation/programs.md#how-a-program-is-loaded
func is_the_common_folder(resolved: String): Boolean {
    return "/{resolved}".ends_with("/spite_standard_library/common")
}

func is_a_platform_folder(resolved: String): Boolean {
    var written = "/{resolved}"
    var index = 0
    while index < platforms.count() {
        var platform = platforms[index]
        if written.ends_with(platform) {
            return true
        }
        index = index + 1
    }
    return false
}

func platform_beside(written: String): String {
    var forward = written.replace("\\", "/")
    while forward.ends_with("/") {
        var length = forward.length()
        var trimmed = forward.slice(0, length - 1)
        crash trimmed
        forward = trimmed
    }
    var segments = forward.split("/")
    crash segments.remove_last()
    segments.append(platform_folder)
    return segments.join("/")
}

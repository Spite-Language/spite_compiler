var standard_library = Mapping.StandardLibrary()
var folders = [
    "/spite_standard_library/common/"
    "/spite_standard_library/windows/"
    "/spite_standard_library/linux/"
    "/spite_standard_library/mac/"
]

func holds_the_class(class_file: Mapping.ClassFile): Boolean {
    return holds(class_file.path)
}

# ../../spite_documentation/repl.md#the-wire-protocol
func is_typed_code(path: String): Boolean {
    var written = path.replace("\\", "/")
    var is_the_prompt_code = written.ends_with("/.spite/build/spite/prompt_code.spite")
    return is_the_prompt_code or written.ends_with("/.spite/build/spite/session.spite") or is_typed_lines(path)
}

# ../../spite_documentation/repl.md#typing-spite-into-a-running-program
func is_typed_lines(path: String): Boolean {
    var written = path.replace("\\", "/")
    return written.ends_with("/.spite/build/spite/typed_lines.spite")
}

# ../../spite_documentation/repl.md#typing-spite-into-a-running-program
func is_written_by_the_compiler(path: String): Boolean {
    var written = path.replace("\\", "/")
    return written.contains("/.spite/") and not is_typed_lines(path)
}

func holds(path: String): Boolean {
    fallback not is_typed_lines(path)
    if standard_library.holds(path) or path.starts_with(standard_library.shown_root) {
        return true
    }
    var written = path.replace("\\", "/")
    var index = 0
    while index < folders.count() {
        var folder = folders[index]
        if written.contains(folder) {
            return true
        }
        index = index + 1
    }
    return written.contains("/.spite/build/spite/")
}

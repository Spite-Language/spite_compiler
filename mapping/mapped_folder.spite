var namespace = ""
var simple_name = ""
var key_prefix = ""
var path = ""
var folders = List<MappedFolder>()
var files = List<ClassFile>()
var paths = List<String>()

func MappedFolder(starting_namespace: String, starting_simple_name: String, starting_path: String) {
    namespace = starting_namespace
    simple_name = starting_simple_name
    path = starting_path
    paths.append(starting_path)
}

func file_named(wanted: String): ClassFile? {
    return files.find_by_simple_name(wanted)
}

func folder_named(wanted: String): MappedFolder? {
    return folders.find_by_simple_name(wanted)
}

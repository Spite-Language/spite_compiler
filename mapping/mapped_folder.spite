var namespace = ""
var key_prefix = ""
var path = ""
var folders = List<MappedFolder>()
var files = List<ClassFile>()

func MappedFolder(starting_namespace: String, starting_path: String) {
    namespace = starting_namespace
    path = starting_path
}

func file_named(simple_name: String): ClassFile? {
    return files.find_by_simple_name(simple_name)
}

func folder_named(simple_name: String): MappedFolder? {
    return folders.find_by_namespace(simple_name)
}

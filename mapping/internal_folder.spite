singleton

var program = Program()
var path = ""
var beside = ""
var above = ""

func InternalFolder() {
    var executable = program.executable_path()
    var folder = folder_of(executable)
    beside = "{folder}/internal"
    var parent = folder_of(folder)
    above = "{parent}/internal"
    var beside_folder = Directory(beside)
    var above_folder = Directory(above)
    if beside_folder.exists() {
        path = beside
    } else if above_folder.exists() {
        path = above
    }
}

func folder_of(written: String): String {
    var segments = written.replace("\\", "/").split("/")
    segments.remove_last()
    return segments.join("/")
}

func is_found(): Boolean {
    return not path.is_empty()
}

func holds(written: String): Boolean {
    var forward = written.replace("\\", "/")
    return is_found() and forward.starts_with("{path}/")
}

func is_the_folder(written: String): Boolean {
    var absolute = absolute_of(written)
    var wanted = absolute_of(path)
    return is_found() and absolute == wanted
}

func absolute_of(written: String): String {
    var forward = written.replace("\\", "/")
    var rooted = forward.starts_with("/") or forward.slice(1, 2) == ":"
    if not rooted {
        var working = program.working_directory()
        forward = "{working}/{forward}"
    }
    var paths = Mapping.FolderMap()
    var resolved = paths.resolved(forward)
    return resolved.lower_case()
}

var path: String
var written: String
var right: String
var is_folder: Boolean

# ../../spite_documentation/classes_and_files.md#a-misnamed-file-or-folder-is-renamed
func Misnamed(starting_path: String, starting_written: String, starting_right: String, starting_is_folder: Boolean) {
    path = starting_path
    written = starting_written
    right = starting_right
    is_folder = starting_is_folder
}

func written_entry(): String {
    if is_folder {
        return written
    }
    return "{written}.spite"
}

func right_entry(): String {
    if is_folder {
        return right
    }
    return "{right}.spite"
}

func renamed_path(): String {
    var forward = path.replace("\\", "/")
    var segments = forward.split("/")
    crash segments.remove_last()
    var parent = segments.join("/")
    var entry = right_entry()
    return "{parent}/{entry}"
}

# ../../spite_documentation/programs.md#the-standard-library-needs-no-load

singleton

var shown_root = "spite_standard_library://"
var folder = ""
var system = "windows"

func system_folder(): String {
    return "{folder}/{system}"
}

func holds(path: String): Boolean {
    fallback not folder.is_empty()
    var forward = path.replace("\\", "/")
    return forward.starts_with("{folder}/")
}

# ../../spite_documentation/compiler.md#a-library-file-is-named-the-same-on-every-machine
func shown(path: String): String {
    if not holds(path) {
        return path
    }
    var forward = path.replace("\\", "/")
    var length = forward.length()
    var start = folder.length() + 1
    var inside = forward.slice(start, length)
    crash inside
    return "{shown_root}{inside}"
}

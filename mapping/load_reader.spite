union Place {
    Path
    GitPath
}

# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func text_of(loaded: AbstractSyntaxTree.Shapes.Statements.LoadStatement): String? {
    var expression = loaded.folder
    fallback expression.class == AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    var piece = expression.pieces[0]
    crash piece
    return piece.text
}

func place_of(written: String): Place {
    if written.contains("@") {
        var pinned: GitPath? = written
        crash pinned
        return pinned
    }
    var path: Path? = written
    crash path
    return path
}

var console = Console()
var pins = Validators.Mapping.GitLoad.Validator()
var repository = ""
var commit = ""
var loading_folder = ""
var git_folder = ""
var full_commit = ""
var answered = ""
var repository_place = ""
var top_folder = ""
var copies = ".spite/git"

func PinnedCopy(starting_pins: Validators.Mapping.GitLoad.Validator, starting_loading_folder: String) {
    pins = starting_pins
    repository = starting_pins.repository
    commit = starting_pins.commit
    loading_folder = starting_loading_folder
}

func fetched(): String {
    var has_git = ran("", ["--version"])
    pins.refuse_without_git(has_git)
    if pins.is_local(repository) {
        repository_place = local_place()
    } else {
        repository_place = cloned_place()
    }
    var copy = "{repository_place}/{commit}"
    var listing = File("{copy}.files")
    if listing.exists() and is_checkable(listing) {
        check_the_copy(copy, listing)
        return copy
    }
    write_the_copy(copy)
    console.error("fetched {repository}@{commit} into {copy}")
    return copy
}

func local_place(): String {
    var folder = "{loading_folder}/{repository}"
    var directory = Directory(folder)
    var exists = directory.exists()
    pins.refuse_a_missing_repository(exists)
    var is_a_repository = ran(folder, ["rev-parse", "--show-prefix"])
    pins.refuse_a_folder_that_is_no_repository(is_a_repository)
    pins.refuse_a_folder_inside_a_repository(answered)
    var found_top = ran(folder, ["rev-parse", "--show-toplevel"])
    pins.refuse_a_folder_that_is_no_repository(found_top)
    var top_path = answered
    top_folder = top_path
    var found_folder = ran(folder, ["rev-parse", "--absolute-git-dir"])
    pins.refuse_a_folder_that_is_no_repository(found_folder)
    git_folder = answered
    resolve_the_commit()
    var keyed = top_path
    var has_a_drive = top_path.length() > 1 and top_path[1] == ":"
    if has_a_drive {
        keyed = top_path.lower_case()
    }
    var segments = top_path.split("/")
    var last = segments.last()
    crash last
    var label = label_of(last)
    var number = number_of(keyed)
    return "{copies}/{label}_{number}"
}

func cloned_place(): String {
    var url = repository
    if not pins.names_a_url(repository) {
        url = "https://{repository}"
    }
    var trimmed = url
    while trimmed.ends_with("/") {
        var length = trimmed.length()
        trimmed = trimmed.slice(0, length - 1)
    }
    var segments = trimmed.split("/")
    var last = segments.last()
    crash last
    var name = last
    if name.ends_with(".git") {
        var name_length = name.length()
        name = name.slice(0, name_length - 4)
    }
    var label = label_of(name)
    var number = number_of(url)
    var place = "{copies}/{label}_{number}"
    git_folder = "{place}/repository"
    var bare = Directory(git_folder)
    if not bare.exists() {
        make_the_folders(place)
        var cloned = ran_with_errors(["clone", "--bare", "--quiet", url, git_folder])
        pins.refuse_an_unclonable_url(cloned, url, answered)
    }
    var known = commit_of_the_pin()
    if not known {
        var heads = "+refs/heads/*:refs/heads/*"
        var tags = "+refs/tags/*:refs/tags/*"
        var updated = ran_with_errors(["--git-dir={git_folder}", "fetch", "--quiet", url, heads, tags])
        pins.refuse_an_unclonable_url(updated, url, answered)
    }
    resolve_the_commit()
    return place
}

func resolve_the_commit() {
    var known = commit_of_the_pin()
    pins.refuse_a_missing_commit(known)
    crash known
    pins.refuse_a_commit_named_otherwise(known)
    full_commit = known
}

func commit_of_the_pin(): String? {
    var asked = "{commit}^\{commit}"
    var found = ran("", ["--git-dir={git_folder}", "rev-parse", "--quiet", "--verify", asked])
    assert found
    return answered
}

func write_the_copy(copy: String) {
    make_the_folders(copy)
    var asking = Process("cmd", ["/c", "cd"])
    var asked = asking.run()
    pins.refuse_an_unwritten_copy(asked == 0, copy)
    var output = asking.read_output_as_string()
    crash output
    var working = output.trim()
    var windows_copy = copy.replace("/", "\\")
    var absolute_copy = "{working}\\{windows_copy}"
    var index_file = "{absolute_copy}.index"
    var reading = git("", ["--git-dir={git_folder}", "read-tree", full_commit])
    reading.environment_variables["GIT_INDEX_FILE"] = index_file
    var read_code = reading.run()
    pins.refuse_an_unwritten_copy(read_code == 0, copy)
    var writing = git("", ["--git-dir={git_folder}", "--work-tree={absolute_copy}", "checkout-index", "--all", "--force"])
    writing.environment_variables["GIT_INDEX_FILE"] = index_file
    var write_code = writing.run()
    pins.refuse_an_unwritten_copy(write_code == 0, copy)
    var listed = ran("", ["--git-dir={git_folder}", "ls-tree", "-r", "--name-only", full_commit])
    pins.refuse_an_unwritten_copy(listed, copy)
    var text = full_commit
    var names = answered.lines()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var line = listed_line(copy, name)
        if line {
            text = "{text}\n{line}"
        }
        index = index + 1
    }
    var files = File("{copy}.files")
    var saved = files.write_string("{text}\n")
    pins.refuse_an_unwritten_copy(saved, copy)
    var written_index = File(index_file)
    written_index.remove()
}

# ../../spite_spec/specs/packages.md#packages-namespaces-and-loading
func listed_line(copy: String, name: String): String? {
    var file = File("{copy}/{name}")
    var size = file.byte_count()
    assert size
    if name.ends_with(".spite") {
        var text = file.read_as_string()
        assert text
        var first = hash_of(text, 31, 1000000007)
        var second = hash_of(text, 131, 998244353)
        return "{name}\t{size}\t{first}\t{second}"
    }
    var modified = file.last_written()
    assert modified
    var nanoseconds = modified.since_1970.total('nanoseconds')
    return "{name}\t{size}\t{nanoseconds}"
}

func hash_of(text: String, base: Long, modulus: Long): Long {
    var hash: Long = 7
    var index = 0
    while index < text.length() {
        var code: Long = text.byte_at(index)
        hash = (hash * base + code) % modulus
        index = index + 1
    }
    return hash
}

func is_checkable(listing: File): Boolean {
    var listed = listing.read_as_string()
    crash listed
    var lines = listed.lines()
    if lines.count() < 2 {
        return true
    }
    var first = lines.first()
    var second = lines[1]
    crash first
    crash second
    return first.length() == 40 and second.contains("\t")
}

func check_the_copy(copy: String, listing: File) {
    var listed = listing.read_as_string()
    crash listed
    var lines = listed.lines()
    var kept = List<String>()
    var index = 1
    while index < lines.count() {
        var line = lines[index]
        if not line.is_empty() {
            check_a_listed_file(copy, line)
            var fields = line.split("\t")
            var name = fields.first()
            crash name
            kept.append(name)
        }
        index = index + 1
    }
    var folder = Directory(copy)
    check_for_added_files(copy, folder, "", kept)
}

func check_a_listed_file(copy: String, line: String) {
    var fields = line.split("\t")
    var name = fields.first()
    crash name
    var path = "{copy}/{name}"
    var file = File(path)
    var exists = file.exists()
    pins.refuse_a_changed_copy(exists, path, copy)
    var now = listed_line(copy, name)
    var is_the_same = now == line
    pins.refuse_a_changed_copy(is_the_same, path, copy)
}

func check_for_added_files(copy: String, folder: Directory, prefix: String, kept: List<String>) {
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        crash entry
        check_an_entry(copy, entry, prefix, kept)
        index = index + 1
    }
}

func check_an_entry(copy: String, entry: Directory.Entry, prefix: String, kept: List<String>) {
    switch entry {
        Directory: check_for_added_files(copy, entry, "{prefix}{entry.folder_name}/", kept)
        File: check_an_added_file(copy, "{prefix}{entry.file_name}", kept)
    }
}

func check_an_added_file(copy: String, name: String, kept: List<String>) {
    assert name.ends_with(".spite")
    var is_listed = kept.contains(name)
    pins.refuse_a_changed_copy(is_listed, "{copy}/{name}", copy)
}

func make_the_folders(path: String) {
    var segments = path.split("/")
    var made = ""
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if made.is_empty() {
            made = segment
        } else {
            made = "{made}/{segment}"
        }
        var folder = Directory(made)
        if not folder.exists() {
            folder.create()
        }
        index = index + 1
    }
}

func ran(folder: String, arguments: List<String>): Boolean {
    var process = git(folder, arguments)
    var code = process.run()
    var output = process.read_output_as_string()
    crash output
    answered = output.trim()
    return code == 0
}

func ran_with_errors(arguments: List<String>): Boolean {
    var process = git("", arguments)
    process.with_errors = true
    var code = process.run()
    var output = process.read_output_as_string()
    crash output
    answered = output.trim()
    return code == 0
}

func git(folder: String, arguments: List<String>): Process {
    var given = List<String>()
    if not folder.is_empty() {
        given.append("-C")
        given.append(folder)
    }
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        given.append(argument)
        index = index + 1
    }
    return Process("git", given)
}

func label_of(name: String): String {
    var label = String()
    var previous_is_lower = false
    var index = 0
    while index < name.length() {
        var code = name.byte_at(index)
        var is_upper = code >= 65 and code <= 90
        var is_lower = code >= 97 and code <= 122 or code >= 48 and code <= 57
        if is_upper and previous_is_lower {
            label.append_code(95)
        }
        if is_upper {
            label.append_code(code + 32)
        }
        if is_lower {
            label.append_code(code)
        }
        if not is_upper and not is_lower {
            label.append_code(95)
        }
        previous_is_lower = is_lower
        index = index + 1
    }
    return label
}

func number_of(text: String): Long {
    var number: Long = 7
    var index = 0
    while index < text.length() {
        var code: Long = text.byte_at(index)
        number = (number * 31 + code) % 1000000007
        index = index + 1
    }
    return number
}

# The build's outputs. Nothing here is source; all of it regenerates.
# The .spite folder holds the seed the bootstrap downloads and the compilers it builds.
.spite/

# Compiled programs, wherever they land.
*.exe
*.pdb
*.obj
*.o
*.lib
*.ilk

# What a build writes beside its executable.
*.crashes
*.reload_host
*.reload_files
*_reload_*.files

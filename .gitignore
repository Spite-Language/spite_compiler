# The build's outputs. Nothing here is source; all of it regenerates.
# The .spite folder holds the junction that gives this folder a snake_case name, and the
# compiler the old compiler builds, so it is never added: the junction points at this folder.
.spite/

# Compiled programs, wherever they land.
*.exe
*.pdb
*.obj
*.o
*.lib
*.ilk

# What a build writes beside its executable.
*.crashes
*.reload_host
*.reload_files
*_reload_*.files

#!/bin/bash
# Every commit starts with a gitmoji and names the model that wrote it, so a bad change has an owner.
# Enforced rather than documented: see AGENTS.md, "Commits".

message_file="$1"

# No em dashes, not the character and not two hyphens between spaces: see AGENTS.md, "No em dashes, anywhere".
# Only the message counts: git's own comment lines and anything below the scissors line are dropped first.
em_dash=$(printf '\342\200\224')
stand_in=' -''- '   # written in two pieces so this file does not contain what it refuses
message=$(sed -e '/^# -\{8,\} >8 -\{8,\}$/,$d' -e '/^#/d' "$message_file")
if printf '%s\n' "$message" | grep -q -F -e "$em_dash" -e "$stand_in"; then
    cat >&2 <<'ERROR'

  commit rejected: the message has an em dash

  Spite has no em dashes anywhere, commit messages included: not the
  character, and not two hyphens between spaces standing in for one.
  End the sentence, or use a colon, a comma or parentheses.

ERROR
    exit 1
fi

# The subject starts with a gitmoji, so its first character is not a letter or a digit.
subject=$(printf '%s\n' "$message" | head -1)
first=$(printf '%s' "$subject" | cut -c1)
if [ -z "$first" ] || printf '%s' "$first" | grep -q '[A-Za-z0-9]'; then
    cat >&2 <<'ERROR'

  commit rejected: the subject does not start with a gitmoji

  Every commit message starts with one, so the history reads at a glance:

      ✨ add the builder that lowers a class into the high representation
      🐛 the lowering gives a place and a register the same number
      📝 the to-do list is the work that is left, in the order it is done

ERROR
    exit 1
fi

if grep -qiE '^Co-authored-by: .+ <.+@.+>' "$message_file"; then
    exit 0
fi

cat >&2 <<'ERROR'

  commit rejected: no Co-authored-by trailer

  Every commit ends with the model that wrote it:

      Co-authored-by: MiniMax M3.1 Flash <noreply@minimax.io>

  Name the model you are actually running as, not just the company. A human
  committing by hand writes their own:

      Co-authored-by: Mortaro <christian.mortaro@gmail.com>

ERROR
exit 1

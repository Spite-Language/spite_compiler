# ../../spite_documentation/repl.md#typing-spite-into-a-running-program

singleton

var path = ""
var shown_lines = List<String>()

func hold(typed_path: String, typed_shown: List<String>) {
    path = typed_path.replace("\\", "/")
    shown_lines = typed_shown
}

func shown_at(file_path: String, line: Integer): String {
    fallback not path.is_empty() and line > 0
    var forward = file_path.replace("\\", "/")
    fallback forward == path
    var shown = shown_lines[line - 1]
    fallback shown
    return shown
}

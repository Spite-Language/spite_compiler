var problems = List<Problem>()
var note_texts = List<String>()

func add(problem: Problem) {
    problems.append(problem)
}

func add_all(found: List<Problem>) {
    found.each(add)
}

func note(text: String) {
    assert not note_texts.contains(text)
    note_texts.append(text)
    var problem = Problem("", 0, text)
    problem.is_note = true
    problems.append(problem)
}

func has_error(): Boolean {
    return problems.any(is_an_error)
}

func is_an_error(problem: Problem): Boolean {
    return not problem.is_note
}

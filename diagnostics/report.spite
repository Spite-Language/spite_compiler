var problems = List<Problem>()
var notes = List<String>()

func at(file_path: String, line: Integer, column: Integer, text: String) {
    var problem = Problem(file_path, line, column, text)
    problems.append(problem)
}

func once(text: String) {
    assert not notes.contains(text)
    notes.append(text)
}

func has_error(): Boolean {
    return not problems.is_empty()
}

func problem_count(): Integer {
    return problems.count()
}

func written(): String {
    var lines = List<String>()
    var index = 0
    while index < problems.count() {
        var line = problems[index].written()
        lines.append(line)
        index = index + 1
    }
    index = 0
    while index < notes.count() {
        lines.append("note: {notes[index]}")
        index = index + 1
    }
    return lines.join("\n")
}

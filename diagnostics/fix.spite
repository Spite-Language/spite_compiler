var problem = Problem("", 0, "")
var first_line = 0
var last_line = 0
var replacement = ""

func Fix(
    starting_problem: Problem,
    starting_first_line: Integer,
    starting_last_line: Integer,
    starting_replacement: String,
) {
    problem = starting_problem
    first_line = starting_first_line
    last_line = starting_last_line
    replacement = starting_replacement
}

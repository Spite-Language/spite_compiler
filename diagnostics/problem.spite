var file_path = ""
var line = 0
var column = 0
var text = ""

func Problem(starting_file_path: String, starting_line: Integer, starting_column: Integer, starting_text: String) {
    file_path = starting_file_path
    line = starting_line
    column = starting_column
    text = starting_text
}

func place(): String {
    if file_path.is_empty() {
        return ""
    }
    if line <= 0 {
        return file_path
    }
    if column <= 0 {
        return "{file_path}:{line}"
    }
    return "{file_path}:{line}:{column}"
}

func written(): String {
    var where = place()
    if where.is_empty() {
        return "error: {text}"
    }
    return "{where}: error: {text}"
}

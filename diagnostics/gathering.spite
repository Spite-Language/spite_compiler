singleton

var console = Console()
var program = Program()
var fixes = Fixes.Fixes()
var problems = List<Diagnostics.Problem>()
var told_places = List<String>()
var failed_checks = List<String>()
var running_check = ""
var goes_on = false
var reading_broke = false
var looked_at_everything = true
var program_folder = ""
var entry_path = ""
var map = Mapping.FolderMap()

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func start(starting_folder: String) {
    program_folder = starting_folder
    var rounds = Diagnostics.Rounds()
    rounds.read_what_earlier_rounds_found()
}

func add(problem: Diagnostics.Problem) {
    var place = "{problem.file_path}:{problem.line}"
    if problem.line <= 0 {
        place = "{problem.file_path}:{problem.text}"
    }
    fallback not told_places.contains(place)
    told_places.append(place)
    problems.append(problem)
}

func has_one_in_the_function_of(problem: Diagnostics.Problem): Boolean {
    var index = 0
    while index < problems.count() {
        var earlier = problems[index]
        var is_the_same_place = earlier.file_path == problem.file_path and earlier.class_name == problem.class_name
        if is_the_same_place and earlier.function_name == problem.function_name {
            return true
        }
        index = index + 1
    }
    return false
}

func add_a_gathered(problem: Diagnostics.Problem) {
    reading_broke = true
    add(problem)
}

func start_a_check(check: String) {
    running_check = check
}

func has_failed(check: String): Boolean {
    return failed_checks.contains(check)
}

func a_failed_check(check: String) {
    failed_checks.append(check)
    reading_broke = reading_broke or check.starts_with("reading ")
}

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func start_reading(path: String) {
    goes_on = false
    running_check = ""
    var must_be_read = path == entry_path or path.contains("/.spite/")
    if not must_be_read {
        running_check = reading_check_of(path)
    }
}

func reading_check_of(path: String): String {
    return "reading {path}"
}

func has_found_something(): Boolean {
    return not problems.is_empty()
}

func tell_if_reading_broke() {
    fallback reading_broke
    tell()
}

func tell_what_was_found() {
    fallback has_found_something()
    tell()
}

func tell() {
    goes_on = false
    running_check = ""
    fixes.run()
    var listing = Diagnostics.Listing(problems, program_folder, map, looked_at_everything)
    var report = listing.report()
    var printer = Printers.Diagnostics.Printer(report)
    var text = printer.text()
    console.error(text)
    var rounds = Diagnostics.Rounds()
    rounds.forget()
    program.exit(1)
}

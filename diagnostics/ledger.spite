var gathering = Diagnostics.Gathering()
var folder = ""
var path = ""
var written_lines = List<String>()
var fields_before_the_text = 6
var line_field = 1
var class_field = 2
var function_field = 3
var attributes_field = 4
var count_field = 5

func Ledger(program_folder: String) {
    folder = "{program_folder}/.spite"
    path = "{folder}/failed_checks.txt"
}

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func written(problems: List<Diagnostics.Problem>, checks: List<String>): Boolean {
    written_lines = List<String>()
    var counted_checks = checks.count()
    var counted_text = counted_checks.to_string()
    written_lines.append(counted_text)
    checks.each(write_a_line)
    problems.each(write_a_problem)
    var folder_path: Path? = folder
    crash folder_path
    var holder = Directory(folder_path)
    fallback holder.exists() or holder.create()
    var text = written_lines.join("\n")
    var file = the_file()
    return file.write_string(text)
}

func write_a_line(line: String) {
    written_lines.append(line)
}

func write_a_problem(problem: Diagnostics.Problem) {
    var text_lines = problem.text.split("\n")
    written_lines.append(problem.file_path)
    var line_text = problem.line.to_string()
    written_lines.append(line_text)
    written_lines.append(problem.class_name)
    written_lines.append(problem.function_name)
    var among_text = problem.is_among_the_attributes.to_string()
    written_lines.append(among_text)
    var counted_lines = text_lines.count()
    var lines_text = counted_lines.to_string()
    written_lines.append(lines_text)
    text_lines.each(write_a_line)
}

func read() {
    var file = the_file()
    var text = file.read_as_string()
    fallback text
    var lines = text.split("\n")
    var checks = number_at(lines, 0)
    var index = 1
    while index <= checks {
        var check = line_at(lines, index)
        gathering.a_failed_check(check)
        index = index + 1
    }
    while index + fields_before_the_text <= lines.count() {
        index = read_a_problem(lines, index)
    }
}

func read_a_problem(lines: List<String>, start: Integer): Integer {
    var line = number_at(lines, start + line_field)
    var counted_lines = number_at(lines, start + count_field)
    var first_text = start + fields_before_the_text
    var text_lines = List<String>()
    var index = first_text
    while index < first_text + counted_lines {
        var text_line = line_at(lines, index)
        text_lines.append(text_line)
        index = index + 1
    }
    var text = text_lines.join("\n")
    var file_path = line_at(lines, start)
    var problem = Diagnostics.Problem(file_path, line, text)
    problem.class_name = line_at(lines, start + class_field)
    problem.function_name = line_at(lines, start + function_field)
    var among = line_at(lines, start + attributes_field)
    problem.is_among_the_attributes = among == "true"
    gathering.add(problem)
    return index
}

func line_at(lines: List<String>, index: Integer): String {
    var found = lines[index]
    crash found
    return found
}

func number_at(lines: List<String>, index: Integer): Integer {
    var number_text = line_at(lines, index)
    var counted: Integer? = number_text
    crash counted
    return counted
}

func is_left_behind(): Boolean {
    var file = the_file()
    return file.exists()
}

func remove() {
    var file = the_file()
    fallback file.exists()
    fallback file.remove()
}

func the_file(): File {
    var file_path: Path? = path
    crash file_path
    return File(file_path)
}

var program = Program()
var environment = Environment()
var gathering = Diagnostics.Gathering()
var round_name = "SPITE_CHECK_ROUND"
var goes_on_answer = 75
var most_rounds = 64
var first_round = 1

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func go_on_past(check: String) {
    gathering.a_failed_check(check)
    var listing = Diagnostics.Listing(gathering.problems, gathering.program_folder, gathering.map, true)
    var has_enough = listing.is_the_program_list_full() or this_round() >= most_rounds
    if has_enough {
        gathering.looked_at_everything = false
        gathering.tell()
    }
    var ledger = Diagnostics.Ledger(gathering.program_folder)
    if not ledger.written(gathering.problems, gathering.failed_checks) {
        gathering.looked_at_everything = false
        gathering.tell()
    }
    if this_round() > first_round {
        program.exit(goes_on_answer)
    }
    run_the_rounds()
}

func this_round(): Integer {
    var written = program.environment(round_name)
    if not written {
        return first_round
    }
    var counted: Integer? = written
    crash counted
    return counted
}

func run_the_rounds() {
    gathering.start_a_check("")
    var answered = goes_on_answer
    var round = first_round
    while answered == goes_on_answer {
        round = round + 1
        answered = answer_of_a_round(round)
    }
    var ledger = Diagnostics.Ledger(gathering.program_folder)
    if answered != 0 and ledger.is_left_behind() {
        ledger.read()
        gathering.tell()
    }
    program.exit(answered)
}

func answer_of_a_round(round: Integer): Integer {
    var path = program.executable_path()
    crash path
    var windows_path = path.replace("/", "\\")
    var given = environment.given_flags()
    var compiling = Process(windows_path, given)
    compiling.environment_variables[round_name] = round.to_string()
    var answered = compiling.run_attached()
    var runnable = Validators.CommandLine.RunnableProgram.Validator()
    var runnable_answer = runnable.check(windows_path, answered)
    runnable_answer.tell()
    crash answered
    return answered
}

func read_what_earlier_rounds_found() {
    fallback this_round() > first_round
    var ledger = Diagnostics.Ledger(gathering.program_folder)
    ledger.read()
}

func forget() {
    var ledger = Diagnostics.Ledger(gathering.program_folder)
    ledger.remove()
}

var problems = List<Diagnostics.Problem>()
var program_folder = ""
var map = Mapping.FolderMap()
var looked_at_everything = true
var most_in_a_list = 25
var report_made = Diagnostics.Report()
var packages_shown = 0
var left_out_packages = List<String>()
var left_out_counts = List<Integer>()
var program = Program()

func Listing(
    starting_problems: List<Diagnostics.Problem>,
    starting_folder: String,
    starting_map: Mapping.FolderMap,
    starting_looked: Boolean,
) {
    problems = starting_problems
    program_folder = starting_folder
    map = starting_map
    looked_at_everything = starting_looked
}

# ../../spite_documentation/compiler.md#how-many-errors-are-listed
func report(): Diagnostics.Report {
    var in_the_program = problems.filter(is_in_the_program)
    var count = in_the_program.count()
    var index = 0
    while index < count and index < most_in_a_list {
        var problem = in_the_program[index]
        report_made.add(problem)
        index = index + 1
    }
    if count > most_in_a_list {
        var more = count - most_in_a_list
        add_a_count("and {more} more in the program")
    } else if not looked_at_everything {
        add_a_count("and possibly more in the program")
    }
    var in_packages = problems.filter(is_in_a_package)
    in_packages.each(add_a_package_problem)
    index = 0
    while index < left_out_packages.count() {
        var left_out = left_out_counts[index]
        crash left_out
        var package = left_out_packages[index]
        add_a_count("and {left_out} more in {package}")
        index = index + 1
    }
    return report_made
}

func is_the_program_list_full(): Boolean {
    var in_the_program = problems.filter(is_in_the_program)
    return in_the_program.count() >= most_in_a_list
}

func is_in_a_package(problem: Diagnostics.Problem): Boolean {
    return not is_in_the_program(problem)
}

func is_in_the_program(problem: Diagnostics.Problem): Boolean {
    var library = Mapping.LibraryFile()
    fallback not library.holds(problem.file_path)
    var root = map.roots.first()
    var folder = program_folder
    if root {
        folder = root.path
    }
    return problem.file_path.is_empty() or problem.file_path.starts_with(folder)
}

func add_a_package_problem(problem: Diagnostics.Problem) {
    if packages_shown < most_in_a_list {
        report_made.add(problem)
        packages_shown = packages_shown + 1
        return
    }
    var package = package_of(problem.file_path)
    var place = left_out_packages.index_of(package)
    if place {
        var earlier = left_out_counts[place]
        crash earlier
        left_out_counts[place] = earlier + 1
    } else {
        left_out_packages.append(package)
        left_out_counts.append(1)
    }
}

func add_a_count(text: String) {
    var counted = Diagnostics.Problem("", 0, text)
    counted.is_a_count = true
    report_made.add(counted)
}

func package_of(path: String): String {
    var library = Mapping.LibraryFile()
    if library.holds(path) {
        return "spite_standard_library"
    }
    var longest = ""
    var index = 1
    while index < map.roots.count() {
        var root = map.roots[index]
        if path.starts_with(root.path) and root.path.length() > longest.length() {
            longest = root.path
        }
        index = index + 1
    }
    return shown_folder(longest)
}

func shown_folder(folder: String): String {
    var working = program.working_directory()
    crash working
    var from = working.replace("\\", "/")
    if not folder.starts_with("{from}/") {
        return folder
    }
    var length = folder.length()
    var start = from.length() + 1
    var inside = folder.slice(start, length)
    crash inside
    return inside
}

var fixes = Fixes.Fixes()
var gathering = Diagnostics.Gathering()

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func stop(problem: Diagnostics.Problem) {
    var found = List<Diagnostics.Problem>()
    found.append(problem)
    stop_every(found)
}

# ../ARCHITECTURE.md#a-failure-stops-its-own-check
func stop_every(found: List<Diagnostics.Problem>) {
    var first = found.first()
    crash first
    if gathering.goes_on {
        found.each(gathering.add_a_gathered)
        return
    }
    fixes.run()
    if not gathering.has_one_in_the_function_of(first) {
        found.each(gathering.add)
    }
    if gathering.running_check.is_empty() {
        gathering.tell()
    }
    var rounds = Diagnostics.Rounds()
    rounds.go_on_past(gathering.running_check)
}

func stop_at(path: String, line: Integer, class_name: String, text: String) {
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    stop(problem)
}

func stop_inside(path: String, line: Integer, class_name: String, function_name: String, text: String) {
    var problem = Diagnostics.Problem(path, line, text)
    problem.class_name = class_name
    problem.function_name = function_name
    problem.is_among_the_attributes = function_name.is_empty()
    stop(problem)
}

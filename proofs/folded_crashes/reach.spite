var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var proof = Proof()
var positions = Dictionary<String, Integer>()
var seen = Dictionary<String, Boolean>()
var waiting = List<HighIntermediaryRepresentation.HighFunction>()
var _protected_names = ["drop", "_read_value", "_settled", "_attribute_defaults", "to_string", "to_debug"]

# ../../PROOFS.md#a-crash-that-folds-false-is-a-compile-error
func Reach(high: HighIntermediaryRepresentation.HighProgram, starting_proof: Proof) {
    program = high
    proof = starting_proof
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var key = function.function.key()
        positions[key] = index
        if starts_a_reach(function.function) {
            note_a_reached(function)
        }
        index = index + 1
    }
    while not waiting.is_empty() {
        var reached = waiting.remove_last()
        crash reached
        walk_a_block(reached.body)
    }
}

func reaches(function: HighIntermediaryRepresentation.HighFunction): Boolean {
    var key = function.function.key()
    return seen[key] == true
}

func starts_a_reach(function: Model.FunctionModel): Boolean {
    var is_the_entry = false
    if program.entry {
        is_the_entry = program.entry.key() == function.key()
    }
    if is_the_entry or function.is_synthetic or _protected_names.contains(function.name) {
        return true
    }
    fallback function.is_constructor
    var owner = program.model.class_named(function.owner)
    fallback owner
    return owner.is_singleton
}

func note_a_reached(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    fallback seen[key] != true
    seen[key] = true
    waiting.append(function)
}

func walk_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(walk_a_statement)
}

func walk_a_statement(statement: SpiteCompiler.Statement) {
    if statement.class == HighIntermediaryRepresentation.Statements.If {
        walk_an_if(statement)
    } else if statement.class == HighIntermediaryRepresentation.Statements.While {
        walk_a_value(statement.condition)
        walk_a_block(statement.body)
    } else if statement.class == HighIntermediaryRepresentation.Statements.Block {
        walk_a_block(statement)
    } else {
        note_what_it_reaches(statement)
    }
}

func walk_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    walk_a_value(branch.condition)
    var decided = proof.decided_of_a_branch(branch)
    if decided != 0 {
        walk_a_block(branch.then_branch)
    }
    if decided != 1 {
        walk_a_block(branch.else_branch)
    }
}

func walk_a_value(value: SpiteCompiler.Value?) {
    fallback value
    var evaluated = HighIntermediaryRepresentation.Statements.Evaluate(value, 0)
    note_what_it_reaches(evaluated)
}

func note_what_it_reaches(statement: SpiteCompiler.Statement) {
    var alone = HighIntermediaryRepresentation.Statements.Block(0)
    alone.statements.append(statement)
    var no_function = Model.FunctionModel("", "")
    var wrapped = HighIntermediaryRepresentation.HighFunction(no_function, alone)
    var references = HighOptimizationPasses.References()
    var keys = references.of(wrapped)
    keys.each(note_a_key)
}

func note_a_key(key: String) {
    if key.starts_with("shape ") {
        note_a_shape_call(key)
        return
    }
    var position = positions[key]
    fallback position
    var function = program.built_functions[position]
    crash function
    note_a_reached(function)
}

func note_a_shape_call(key: String) {
    var length = key.length()
    var name = key.slice(6, length)
    crash name
    var index = 0
    while index < program.built_functions.count() {
        var function = program.built_functions[index]
        if function.function.name == name {
            note_a_reached(function)
        }
        index = index + 1
    }
}

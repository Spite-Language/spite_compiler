union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
var reasons = List<String>()

# ../../PROOFS.md#a-crash-that-folds-false-is-a-compile-error
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    high.built_functions.each(check_a_function)
}

func check_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    var owner = context.program.class_named(function.function.owner)
    fallback owner
    context.current_class = owner
    context.current_function = function.function
    check_a_block(function.body)
}

func check_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(check_a_statement)
}

func check_a_statement(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: check_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: check_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: check_a_block(statement)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func check_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    reasons = List<String>()
    var decided = decided_of(branch.condition)
    if branch.decided_condition {
        decided = decided_of(branch.decided_condition)
    }
    if decided == 1 and not branch.crashes_unless.is_empty() {
        refuse(branch)
    }
    if decided != 0 {
        check_a_block(branch.then_branch)
    }
    if decided != 1 and branch.else_branch {
        check_a_block(branch.else_branch)
    }
}

func refuse(branch: HighIntermediaryRepresentation.Statements.If) {
    context.line = branch.line
    var said = reasons.join("; ")
    typing.refuse_folded_crash_because(context, branch.crashes_unless, said)
}

func decided_of(value: Value?): Integer {
    if value {
        return decided_value(value)
    }
    return -1
}

func decided_value(value: Value): Integer {
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return decided_number(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return decided_fact(value)
        HighIntermediaryRepresentation.Values.Negation: return decided_negation(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return decided_presence(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return decided_operation(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return -1
        HighIntermediaryRepresentation.Values.TextConstant: return -1
        HighIntermediaryRepresentation.Values.NullConstant: return -1
        HighIntermediaryRepresentation.Values.LocalRead: return -1
        HighIntermediaryRepresentation.Values.ThisRead: return -1
        HighIntermediaryRepresentation.Values.AttributeRead: return -1
        HighIntermediaryRepresentation.Values.Call: return -1
        HighIntermediaryRepresentation.Values.MakeObject: return -1
        HighIntermediaryRepresentation.Values.ForeignCall: return -1
        HighIntermediaryRepresentation.Values.Class.Test: return -1
        HighIntermediaryRepresentation.Values.Conversion: return -1
        HighIntermediaryRepresentation.Values.Function.Value: return -1
        HighIntermediaryRepresentation.Values.Function.ValueCall: return -1
        HighIntermediaryRepresentation.Values.NumberRoom: return -1
        HighIntermediaryRepresentation.Values.ShapeCall: return -1
        HighIntermediaryRepresentation.Values.EnumText: return -1
        HighIntermediaryRepresentation.Values.EnumFromText: return -1
        HighIntermediaryRepresentation.Values.Class.Object: return -1
        HighIntermediaryRepresentation.Values.Class.OfValue: return -1
    }
}

func decided_number(number: HighIntermediaryRepresentation.Values.WholeNumber): Integer {
    var is_a_boolean = number.value_type.kind == 'scalar' and number.value_type.name == "Boolean"
    if not is_a_boolean {
        return -1
    }
    fallback number.number != 0
    return 1
}

func decided_fact(fact: HighIntermediaryRepresentation.Values.Function.Fact): Integer {
    if not fact.is_answered {
        return -1
    }
    if not fact.found_place.is_empty() and not reasons.contains(fact.found_place) {
        reasons.append(fact.found_place)
    }
    if fact.answer {
        return 1
    }
    return 0
}

func decided_negation(negation: HighIntermediaryRepresentation.Values.Negation): Integer {
    var inner = decided_of(negation.negated)
    if inner < 0 {
        return -1
    }
    return 1 - inner
}

func decided_presence(test: HighIntermediaryRepresentation.Values.PresenceTest): Integer {
    var tested = test.tested
    fallback tested.class != HighIntermediaryRepresentation.Values.NullConstant
    if tested.class == HighIntermediaryRepresentation.Values.Call and not tested.missing_key.is_empty() {
        add_a_reason(tested.missing_key)
        return 0
    }
    return -1
}

func add_a_reason(reason: String) {
    fallback not reasons.contains(reason)
    reasons.append(reason)
}

func decided_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Integer {
    var left = decided_of(operation.left)
    var right = decided_of(operation.right)
    if operation.operator == 'and' {
        return decided_and(left, right)
    }
    if operation.operator == 'or' {
        return decided_or(left, right)
    }
    return -1
}

func decided_and(left: Integer, right: Integer): Integer {
    fallback left != 0 and right != 0
    if left == 1 and right == 1 {
        return 1
    }
    return -1
}

func decided_or(left: Integer, right: Integer): Integer {
    if left == 1 or right == 1 {
        return 1
    }
    fallback left != 0 or right != 0
    return -1
}

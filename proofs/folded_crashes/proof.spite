var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var reasons = List<String>()
var undecided_depth = 0
var may_have_left = false
var has_left = false
var found_functions = List<HighIntermediaryRepresentation.HighFunction>()
var found_lines = List<Integer>()
var found_texts = List<String>()

# ../../PROOFS.md#a-crash-that-folds-false-is-a-compile-error
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    high.built_functions.each(check_a_function)
    fallback not found_functions.is_empty()
    var reach = Reach(high, this)
    var index = 0
    while index < found_functions.count() {
        var function = found_functions[index]
        var is_reached = reach.reaches(function)
        check_a_found_crash(function, is_reached, index)
        index = index + 1
    }
}

func check_a_found_crash(function: HighIntermediaryRepresentation.HighFunction, is_reached: Boolean, index: Integer) {
    var line = found_lines[index]
    var text = found_texts[index]
    crash line
    crash text
    var owner = context.program.class_named(function.function.owner)
    crash owner
    context.current_class = owner
    context.current_function = function.function
    var rule = Validators.HighIntermediaryRepresentation.FoldedCrash.Validator()
    rule.check_a_found_crash(context, is_reached, line, text)
}

func check_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    var owner = context.program.class_named(function.function.owner)
    fallback owner
    context.current_class = owner
    context.current_function = function.function
    undecided_depth = 0
    may_have_left = false
    has_left = false
    check_a_block(function.body, function)
}

func check_a_block(
    block: HighIntermediaryRepresentation.Statements.Block?,
    function: HighIntermediaryRepresentation.HighFunction,
) {
    fallback block
    var index = 0
    while index < block.statements.count() and not has_left {
        var statement = block.statements[index]
        check_a_statement(statement, function)
        index = index + 1
    }
}

func check_a_statement(statement: SpiteCompiler.Statement, function: HighIntermediaryRepresentation.HighFunction) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: check_an_if(statement, function)
        HighIntermediaryRepresentation.Statements.While: check_a_loop(statement, function)
        HighIntermediaryRepresentation.Statements.Block: check_a_block(statement, function)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: note_a_way_out()
        HighIntermediaryRepresentation.Statements.Stop: note_a_way_out()
    }
}

func note_a_way_out() {
    if undecided_depth > 0 {
        may_have_left = true
    } else {
        has_left = true
    }
}

func check_a_loop(
    loop: HighIntermediaryRepresentation.Statements.While,
    function: HighIntermediaryRepresentation.HighFunction,
) {
    undecided_depth = undecided_depth + 1
    check_a_block(loop.body, function)
    undecided_depth = undecided_depth - 1
}

func check_an_if(
    branch: HighIntermediaryRepresentation.Statements.If,
    function: HighIntermediaryRepresentation.HighFunction,
) {
    reasons = List<String>()
    var decided = decided_of_a_branch(branch)
    if not branch.crashes_unless.is_empty() {
        check_a_crash(branch, decided, function)
        return
    }
    if decided == 1 {
        check_a_block(branch.then_branch, function)
        return
    }
    if decided == 0 {
        check_a_block(branch.else_branch, function)
        return
    }
    undecided_depth = undecided_depth + 1
    check_a_block(branch.then_branch, function)
    check_a_block(branch.else_branch, function)
    undecided_depth = undecided_depth - 1
}

func check_a_crash(
    branch: HighIntermediaryRepresentation.Statements.If,
    decided: Integer,
    function: HighIntermediaryRepresentation.HighFunction,
) {
    fallback decided == 1
    fallback undecided_depth == 0 and not may_have_left
    var said = reasons.join("; ")
    var rule = Validators.HighIntermediaryRepresentation.FoldedCrash.Validator()
    var text = rule.text_of(context, branch.crashes_unless, said)
    found_functions.append(function)
    found_lines.append(branch.line)
    found_texts.append(text)
    has_left = true
}

func decided_of_a_branch(branch: HighIntermediaryRepresentation.Statements.If): Integer {
    if branch.decided_condition {
        return decided_of(branch.decided_condition)
    }
    return decided_of(branch.condition)
}

func decided_of(value: SpiteCompiler.Value?): Integer {
    if value {
        return decided_value(value)
    }
    return -1
}

func decided_value(value: SpiteCompiler.Value): Integer {
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return decided_number(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return decided_fact(value)
        HighIntermediaryRepresentation.Values.Negation: return decided_negation(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return decided_presence(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return decided_operation(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return -1
        HighIntermediaryRepresentation.Values.TextConstant: return -1
        HighIntermediaryRepresentation.Values.NullConstant: return -1
        HighIntermediaryRepresentation.Values.LocalRead: return -1
        HighIntermediaryRepresentation.Values.ThisRead: return -1
        HighIntermediaryRepresentation.Values.AttributeRead: return -1
        HighIntermediaryRepresentation.Values.Call: return -1
        HighIntermediaryRepresentation.Values.MakeObject: return -1
        HighIntermediaryRepresentation.Values.ForeignCall: return -1
        HighIntermediaryRepresentation.Values.Class.Membership: return -1
        HighIntermediaryRepresentation.Values.Conversion: return -1
        HighIntermediaryRepresentation.Values.Function.Value: return -1
        HighIntermediaryRepresentation.Values.Function.ValueCall: return -1
        HighIntermediaryRepresentation.Values.NumberRoom: return -1
        HighIntermediaryRepresentation.Values.ShapeCall: return -1
        HighIntermediaryRepresentation.Values.EnumText: return -1
        HighIntermediaryRepresentation.Values.EnumFromText: return -1
        HighIntermediaryRepresentation.Values.Class.Object: return -1
        HighIntermediaryRepresentation.Values.Class.OfValue: return -1
    }
}

func decided_number(number: HighIntermediaryRepresentation.Values.WholeNumber): Integer {
    var is_a_boolean = number.value_type.kind == 'scalar' and number.value_type.name == "Boolean"
    if not is_a_boolean {
        return -1
    }
    fallback number.number != 0
    return 1
}

func decided_fact(fact: HighIntermediaryRepresentation.Values.Function.Fact): Integer {
    if not fact.is_answered {
        return -1
    }
    if not fact.found_place.is_empty() and not reasons.contains(fact.found_place) {
        reasons.append(fact.found_place)
    }
    if fact.answer {
        return 1
    }
    return 0
}

func decided_negation(negation: HighIntermediaryRepresentation.Values.Negation): Integer {
    var inner = decided_of(negation.negated)
    if inner < 0 {
        return -1
    }
    return 1 - inner
}

func decided_presence(test: HighIntermediaryRepresentation.Values.PresenceTest): Integer {
    var tested = test.tested
    fallback tested.class != HighIntermediaryRepresentation.Values.NullConstant
    if tested.class == HighIntermediaryRepresentation.Values.Call and not tested.missing_key.is_empty() {
        add_a_reason(tested.missing_key)
        return 0
    }
    return -1
}

func add_a_reason(reason: String) {
    fallback not reasons.contains(reason)
    reasons.append(reason)
}

func decided_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation): Integer {
    if operation.operator == 'and' {
        var left_of_and = decided_of(operation.left)
        var right_of_and = decided_of(operation.right)
        return decided_and(left_of_and, right_of_and)
    }
    if operation.operator == 'or' {
        var left_of_or = decided_of(operation.left)
        var right_of_or = decided_of(operation.right)
        return decided_or(left_of_or, right_of_or)
    }
    return decided_comparison(operation)
}

func decided_comparison(operation: HighIntermediaryRepresentation.Values.MachineOperation): Integer {
    var left = operation.left
    var right = operation.right
    if left.class == HighIntermediaryRepresentation.Values.WholeNumber and right.class == HighIntermediaryRepresentation.Values.WholeNumber {
        var values = HighIntermediaryRepresentation.Building.Values(context)
        var operators = HighIntermediaryRepresentation.Building.Operators(values.context, values)
        var compared = operators.compared_numbers(operation.operator, left.number, right.number)
        return decided_of(compared)
    }
    return -1
}

func decided_and(left: Integer, right: Integer): Integer {
    fallback left != 0 and right != 0
    if left == 1 and right == 1 {
        return 1
    }
    return -1
}

func decided_or(left: Integer, right: Integer): Integer {
    if left == 1 or right == 1 {
        return 1
    }
    fallback left != 0 or right != 0
    return -1
}

# ../../PROOFS.md#a-copy-nothing-changes-is-the-original
var no_program = Model.ProgramModel()
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var program = Model.ProgramModel()
var assignments = HighIntermediaryRepresentation.Assignments(no_high)
var library = Validators.LibraryFile()
var compared = List<String>()
var compares_unknown = false
var declared_after = List<String>()
var keeps_nothing = true
var shareable = List<String>()
var unshareable = List<String>()
var asking = List<String>()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    assert high.will_be_lowered() and not high.makes_work
    crash high.context
    crash high.waits
    crash high.assignments
    assert not is_interactive(high.context.build_flags)
    var waits = high.waits
    assert not waits.has_callbacks and waits.started.is_empty() and waits.started_in_parallel.is_empty()
    program = high.model
    assignments = high.assignments
    find_the_identity_questions(high)
    assert not compares_unknown
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        if not waits.resumable.contains(key) and not waits.waits_itself.contains(key) {
            look_in_a_block(built.body)
        }
        index = index + 1
    }
}

func is_interactive(flags: Dictionary<String, String>): Boolean {
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func look_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        look_inside(statement)
        judge(block.statements, index)
        index = index + 1
    }
}

func look_inside(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: look_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: look_in_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: look_in_a_block(statement)
        _: return
    }
}

func look_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    look_in_a_block(branch.then_branch)
    look_in_a_block(branch.else_branch)
}

func judge(statements: List<HighIntermediaryRepresentation.Statements.Statement>, at: Integer) {
    var statement = statements[at]
    assert statement == HighIntermediaryRepresentation.Statements.Declare and statement.hides == ""
    var called = statement.value
    assert called == HighIntermediaryRepresentation.Values.Call and called.arguments.is_empty()
    assert is_a_plain_copy(called.function)
    assert called.receiver and is_a_plain_read(called.receiver)
    var copied_type = called.value_type
    assert copied_type.kind == 'object' and not copied_type.is_nullable
    var original_type = called.receiver.value_type
    assert original_type.name == copied_type.name and not original_type.is_nullable
    assert statement.declared_type.name == copied_type.name
    asking = List<String>()
    assert is_shareable(copied_type.name)
    declared_after = List<String>()
    declared_after.append(statement.name)
    keeps_nothing = true
    var index = at + 1
    while index < statements.count() {
        var later = statements[index]
        follow_a_statement(later)
        index = index + 1
    }
    assert keeps_nothing and assignments.writes_nothing_from(statements, at + 1)
    statement.shares_the_original = true
}

func is_a_plain_copy(function: Model.FunctionModel): Boolean {
    if function.name != "copy" and function.name != "deep_copy" {
        return false
    }
    if function.is_synthetic {
        return true
    }
    if not function.declaration {
        return false
    }
    var path = function.declaration.path.replace("\\", "/")
    if not library.holds(path) {
        return false
    }
    return path.ends_with("/common/list.spite") or path.ends_with("/common/dictionary.spite")
}

func is_a_plain_read(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        return true
    }
    if value == HighIntermediaryRepresentation.Values.ThisRead {
        return true
    }
    if value == HighIntermediaryRepresentation.Values.AttributeRead {
        return is_a_plain_read(value.object)
    }
    return false
}

func is_shareable(class_key: String): Boolean {
    if shareable.contains(class_key) {
        return true
    }
    if unshareable.contains(class_key) or asking.contains(class_key) {
        return false
    }
    asking.append(class_key)
    var answer = class_is_shareable(class_key)
    asking.remove_last()
    if answer {
        shareable.append(class_key)
    } else {
        unshareable.append(class_key)
    }
    return answer
}

func class_is_shareable(class_key: String): Boolean {
    var model = program.class_named(class_key)
    if not model or model.is_singleton or compared.contains(class_key) {
        return false
    }
    if model.function_named("drop") {
        return false
    }
    var path = model.file.path.replace("\\", "/")
    var is_a_collection = path.ends_with("/common/list.spite") or path.ends_with("/common/dictionary.spite")
    var is_text = path.ends_with("/common/string.spite") or path.ends_with("/common/buffer.spite")
    if library.holds(path) and not is_a_collection and not is_text {
        return false
    }
    if is_a_collection {
        return bound_types_are_shareable(model)
    }
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if program.holds_no_count(attribute) or not type_is_shareable(attribute.attribute_type) {
            return false
        }
        index = index + 1
    }
    return true
}

func bound_types_are_shareable(model: Model.ClassModel): Boolean {
    var names = ["$element_type", "$key_type", "$value_type"]
    var index = 0
    while index < names.count() {
        var name = names[index]
        crash name
        var bound = model.bound_types[name]
        if bound and not type_is_shareable(bound) {
            return false
        }
        index = index + 1
    }
    return true
}

func type_is_shareable(held: Model.Type): Boolean {
    if held.kind == 'scalar' or held.kind == 'enumeration' {
        return true
    }
    if held.kind == 'object' {
        return is_shareable(held.name)
    }
    return false
}

func follow_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: follow_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: follow_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: follow_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.Return: follow_a_return(statement)
        HighIntermediaryRepresentation.Statements.If: follow_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: follow_a_while(statement)
        HighIntermediaryRepresentation.Statements.Stop: follow_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: follow_a_block(statement)
        _: keeps_nothing = false
    }
}

func follow_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(follow_a_statement)
}

func follow_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    declared_after.append(declared.name)
    follow_a_value(declared.value)
}

func follow_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    crash assigned.value
    if not declared_after.contains(assigned.name) and not is_plain(assigned.value.value_type) {
        keeps_nothing = false
    }
    follow_a_value(assigned.value)
}

func follow_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    follow_a_value(evaluated.value)
    follow_a_value(evaluated.waited)
}

func follow_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    assert returned.value
    if not is_plain(returned.value.value_type) {
        keeps_nothing = false
    }
    follow_a_value(returned.value)
}

func follow_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    follow_a_value(branch.condition)
    follow_a_block(branch.then_branch)
    follow_a_block(branch.else_branch)
}

func follow_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    follow_a_value(loop.condition)
    follow_a_block(loop.body)
}

func follow_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(follow_a_present)
    follow_a_value(stop.then)
}

func follow_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    follow_a_value(value)
}

func follow_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    follow_a_value(first)
    follow_a_value(second)
}

func is_plain(held: Model.Type): Boolean {
    return held.kind == 'scalar' or held.kind == 'enumeration' or held.kind == 'nothing'
}

func follow_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.Call: follow_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: follow_a_value(value.converted)
        HighIntermediaryRepresentation.Values.AttributeRead: follow_a_value(value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: follow_a_value(value.described)
        HighIntermediaryRepresentation.Values.Class.Test: follow_a_value(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: follow_a_value(value.text)
        HighIntermediaryRepresentation.Values.EnumText: follow_a_value(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: refuse_a_keeper()
        HighIntermediaryRepresentation.Values.Function.Value: refuse_a_keeper()
        HighIntermediaryRepresentation.Values.Function.ValueCall: refuse_a_keeper()
        HighIntermediaryRepresentation.Values.MachineOperation: follow_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(follow_a_present)
        HighIntermediaryRepresentation.Values.Negation: follow_a_value(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: follow_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: follow_a_value(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: follow_a_shape_call(value)
        _: return
    }
}

func refuse_a_keeper() {
    keeps_nothing = false
}

func follow_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    follow_a_value(call.receiver)
    call.arguments.each(follow_a_present)
}

func follow_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    follow_a_value(call.receiver)
    call.arguments.each(follow_a_present)
}

func find_the_identity_questions(high: HighIntermediaryRepresentation.HighProgram) {
    compared = List<String>()
    compares_unknown = false
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        ask_in_a_block(built.body)
        index = index + 1
    }
    var class_index = 0
    while class_index < program.order.count() {
        var model = program.order[class_index]
        var key_type = model.bound_types["$key_type"]
        if key_type {
            note_a_compared(key_type)
        }
        class_index = class_index + 1
    }
}

func note_a_compared(held: Model.Type) {
    if held.kind == 'object' {
        if not compared.contains(held.name) {
            compared.append(held.name)
        }
        return
    }
    if held.kind == 'union' or held.kind == 'shape' {
        compares_unknown = true
    }
}

func ask_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(ask_in_a_statement)
}

func ask_in_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: ask_in_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: ask_in_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: ask_in_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: ask_in_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: ask_in_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.Return: ask_in_a_return(statement)
        HighIntermediaryRepresentation.Statements.If: ask_in_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: ask_in_a_while(statement)
        HighIntermediaryRepresentation.Statements.Stop: ask_in_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: ask_in_a_block(statement)
    }
}

func ask_in_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    ask_in_a_value(declared.value)
}

func ask_in_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    ask_in_a_value(assigned.value)
}

func ask_in_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    ask_in_both(written.object, written.value)
}

func ask_in_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    ask_in_both(written.object, written.value)
}

func ask_in_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    ask_in_a_value(returned.value)
}

func ask_in_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    ask_in_a_value(branch.condition)
    ask_in_a_block(branch.then_branch)
    ask_in_a_block(branch.else_branch)
}

func ask_in_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    ask_in_a_value(loop.condition)
    ask_in_a_block(loop.body)
}

func ask_in_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(ask_in_a_present)
    ask_in_a_value(stop.then)
}

func ask_in_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    ask_in_a_value(value)
}

func ask_in_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    ask_in_a_value(first)
    ask_in_a_value(second)
}

func ask_in_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.Call: ask_in_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: ask_in_a_value(value.converted)
        HighIntermediaryRepresentation.Values.AttributeRead: ask_in_a_value(value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: ask_in_a_value(value.described)
        HighIntermediaryRepresentation.Values.Class.Test: ask_in_a_value(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: ask_in_a_value(value.text)
        HighIntermediaryRepresentation.Values.EnumText: ask_in_a_value(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: ask_in_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Function.Value: ask_in_a_value(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: ask_in_a_value_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: ask_in_an_operation(value)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(ask_in_a_present)
        HighIntermediaryRepresentation.Values.Negation: ask_in_a_value(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: ask_in_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: ask_in_a_value(value.tested)
        HighIntermediaryRepresentation.Values.ShapeCall: ask_in_a_shape_call(value)
        _: return
    }
}

func ask_in_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    crash operation.left
    crash operation.right
    var left = operation.left
    var right = operation.right
    var is_null_test = left == HighIntermediaryRepresentation.Values.NullConstant
    is_null_test = is_null_test or right == HighIntermediaryRepresentation.Values.NullConstant
    var is_identity = operation.operator == 'equal' or operation.operator == 'not_equal'
    if is_identity and not is_null_test {
        note_a_compared(left.value_type)
        note_a_compared(right.value_type)
    }
    ask_in_a_value(left)
    ask_in_a_value(right)
}

func ask_in_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    ask_in_a_value(call.receiver)
    call.arguments.each(ask_in_a_present)
}

func ask_in_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    call.arguments.each(ask_in_a_present)
    ask_in_a_value(call.library)
}

func ask_in_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    ask_in_a_value(call.called)
    call.arguments.each(ask_in_a_present)
}

func ask_in_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    ask_in_a_value(call.receiver)
    call.arguments.each(ask_in_a_present)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count

var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var program = Model.ProgramModel()
var candidates = List<Model.AttributeModel>()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.will_be_lowered()
    crash high.context
    fallback not is_interactive(high.context.build_flags)
    program = high.model
    candidates = List<Model.AttributeModel>()
    program.order.each(note_the_candidates_of)
    fallback not candidates.is_empty()
    fallback lists_no_attributes_at_run_time()
    var index = 0
    while index < candidates.count() {
        var back = candidates[index]
        var owning = list_owning(back)
        crash owning
        var flows = ChildFlows(back, owning)
        if flows.stay_with_their_owner(high) {
            program.back_references.hold_back_without_null(back)
        }
        index = index + 1
    }
}

func is_interactive(flags: Dictionary<String, String>): Boolean {
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func note_the_candidates_of(model: Model.ClassModel) {
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        var owning = list_owning(attribute)
        if owning {
            candidates.append(attribute)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func lists_no_attributes_at_run_time(): Boolean {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var values = program.own_function_values
    var index = 0
    while index < program.order.count() {
        var model = program.order[index]
        values.walk_the_class(walk, model)
        index = index + 1
    }
    return values.lists_no_attributes_at_run_time(walk)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func list_owning(attribute: Model.AttributeModel): Model.AttributeModel? {
    var held = attribute.attribute_type
    fallback held.kind == 'object' and not held.is_nullable and held.name != attribute.owner
    var holder = program.class_named(attribute.owner)
    var target = program.class_named(held.name)
    fallback holder and target and target.key != "String"
    fallback not holder.is_singleton and not target.is_singleton
    fallback holder.bound_types.count() == 0 and target.bound_types.count() == 0
    var found: Model.AttributeModel? = null
    var index = 0
    while index < target.declared_attributes.count() {
        var owning = target.declared_attributes[index]
        if is_a_list_of(owning.attribute_type, holder.key) {
            fallback not found
            found = owning
        }
        index = index + 1
    }
    return found
}

func is_a_list_of(held: Model.Type, key: String): Boolean {
    fallback held.kind == 'object' and not held.is_nullable
    var model = program.class_named(held.name)
    fallback model and model.shown.starts_with("List<")
    var item = model.bound_types["$element_type"]
    fallback item
    return item.kind == 'object' and not item.is_nullable and item.name == key
}

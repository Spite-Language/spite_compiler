# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count

var no_function = Model.FunctionModel("", "", null, null, null, null, null, null, false, false, false, false)
var item_answers = ["get_at", "first", "last", "remove_first", "remove_last", "find"]
var plain_list_calls = ["count", "is_empty", "clear", "remove_at", "swap", "reverse", "truncate"]
var searches = ["contains", "index_of"]
var walks = ["each", "any", "all", "count_where", "find", "remove_where"]
var built = Dictionary<String, Model.FunctionModel>()
var constructor_places = Dictionary<String, Integer>()
var back_stores = List<String>()
var function: Model.FunctionModel = no_function
var declared = Dictionary<String, Integer>()
var assigned = List<String>()
var top_names = List<String>()
var made_children = List<String>()
var other_writes = List<String>()
var steady_names = List<String>()
var fresh_children = List<String>()
var is_a_drop = false
var holds = true
var child_key: String
var owner_key: String
var list_key: String
var back: Model.AttributeModel
var owning: Model.AttributeModel

func ChildFlows(starting_back: Model.AttributeModel, starting_owning: Model.AttributeModel) {
    back = starting_back
    owning = starting_owning
    child_key = starting_back.owner
    owner_key = starting_owning.owner
    list_key = starting_owning.attribute_type.name
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func stay_with_their_owner(high: HighIntermediaryRepresentation.HighProgram): Boolean {
    note_the_built(high)
    var index = 0
    while index < high.built_functions.count() and holds {
        var found = high.built_functions[index]
        if found.function.owner != list_key {
            read_a_function(found)
        }
        index = index + 1
    }
    return holds
}

func refuse() {
    holds = false
}

func note_the_built(high: HighIntermediaryRepresentation.HighProgram) {
    var index = 0
    while index < high.built_functions.count() {
        var found = high.built_functions[index]
        var key = found.function.key()
        built[key] = found.function
        if found.function.owner == child_key and found.function.is_a_constructor() {
            note_the_back_place(found)
        }
        index = index + 1
    }
}

func is_built(called: Model.FunctionModel): Boolean {
    var key = called.key()
    return built.contains(key)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func note_the_back_place(found: HighIntermediaryRepresentation.HighFunction) {
    back_stores = List<String>()
    collect_the_back_stores(found.body)
    var name = back_stores.first()
    fallback name and not name.is_empty()
    var index = 0
    while index < back_stores.count() {
        fallback back_stores[index] == name
        index = index + 1
    }
    var place = parameter_place(found.function, name)
    fallback place >= 0
    var key = found.function.key()
    constructor_places[key] = place
}

func collect_the_back_stores(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(collect_a_back_store)
}

func collect_a_back_store(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Assign.Attribute: note_a_back_store(statement)
        HighIntermediaryRepresentation.Statements.If: collect_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: collect_the_back_stores(statement.body)
        HighIntermediaryRepresentation.Statements.Block: collect_the_back_stores(statement)
        HighIntermediaryRepresentation.Statements.Declare: return
        HighIntermediaryRepresentation.Statements.Assign.Assign: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func collect_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        collect_the_back_stores(current.then_branch)
        link = current.else_if()
        if not link {
            collect_the_back_stores(current.else_branch)
        }
    }
}

func note_a_back_store(store: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    fallback is_the_back(store.attribute)
    var name = ""
    if store.object and store.value and store.object.class == HighIntermediaryRepresentation.Values.ThisRead {
        name = name_of_a_local(store.value)
    }
    back_stores.append(name)
}

func name_of_a_local(value: SpiteCompiler.Value): String {
    fallback value.class == HighIntermediaryRepresentation.Values.LocalRead
    return value.name
}

func parameter_place(found: Model.FunctionModel, name: String): Integer {
    var index = 0
    while index < found.parameters.count() {
        var parameter = found.parameters[index]
        if parameter.name == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func read_a_function(found: HighIntermediaryRepresentation.HighFunction) {
    function = found.function
    var is_of_the_pair = function.owner == owner_key or function.owner == child_key
    is_a_drop = is_of_the_pair and function.name == "drop"
    note_the_names(found)
    read_block(found.body)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func note_the_names(found: HighIntermediaryRepresentation.HighFunction) {
    declared = Dictionary<String, Integer>()
    assigned = List<String>()
    top_names = List<String>()
    made_children = List<String>()
    other_writes = List<String>()
    steady_names = List<String>()
    fresh_children = List<String>()
    found.body.statements.each(note_a_top_name)
    note_the_writes_in(found.body)
    function.parameters.each(note_a_steady_parameter)
    top_names.each(note_a_steady_local)
    made_children.each(note_a_fresh_child)
}

func note_a_top_name(statement: SpiteCompiler.Statement) {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    top_names.append(statement.name)
}

func note_a_steady_parameter(parameter: Model.ParameterModel) {
    fallback not assigned.contains(parameter.name) and not declared.contains(parameter.name)
    steady_names.append(parameter.name)
}

func note_a_steady_local(name: String) {
    fallback declared[name] == 1 and not assigned.contains(name)
    steady_names.append(name)
}

func note_a_fresh_child(name: String) {
    fallback not other_writes.contains(name) and not fresh_children.contains(name)
    fresh_children.append(name)
}

func note_the_writes_in(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(note_the_writes_of)
}

func note_the_writes_of(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: note_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: note_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.If: note_the_writes_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: note_the_writes_in(statement.body)
        HighIntermediaryRepresentation.Statements.Block: note_the_writes_in(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func note_the_writes_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        note_the_writes_in(current.then_branch)
        link = current.else_if()
        if not link {
            note_the_writes_in(current.else_branch)
        }
    }
}

func note_a_declaration(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    var known = declared[declaration.name]
    var count = 1
    if known {
        count = known + 1
    }
    declared[declaration.name] = count
    note_a_write(declaration.name, declaration.value)
}

func note_an_assignment(assignment: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    assigned.append(assignment.name)
    note_a_write(assignment.name, assignment.value)
}

func note_a_write(name: String, value: SpiteCompiler.Value?) {
    if value and value.class == HighIntermediaryRepresentation.Values.MakeObject and carries_a_child(value) {
        made_children.append(name)
    } else {
        other_writes.append(name)
    }
}

func read_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block and holds
    block.statements.each(read_statement)
}

func read_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_kept(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_a_kept(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_a_store(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_a_shape_store(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: read_a_leaving(statement.value)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_block(statement)
    }
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_kept(value: SpiteCompiler.Value?) {
    fallback value
    if carries_the_list(value) {
        refuse()
    }
    read(value)
}

func read_a_leaving(value: SpiteCompiler.Value?) {
    fallback value
    if carries_anything(value) {
        refuse()
    }
    read(value)
}

func read_a_present_leaving(value: SpiteCompiler.Value) {
    read_a_leaving(value)
}

func read_an_evaluation(evaluation: HighIntermediaryRepresentation.Statements.Evaluate) {
    read(evaluation.value)
    read_a_leaving(evaluation.waited)
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        read(current.condition)
        read(current.decided_condition)
        read_block(current.then_branch)
        link = current.else_if()
        if not link {
            read_block(current.else_branch)
        } else if not holds {
            link = null
        }
    }
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    read(loop.condition)
    read_block(loop.body)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(read_a_present_leaving)
    read_a_leaving(stop.then)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_store(store: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    fallback store.object and store.value
    if is_the_own_list(store.attribute) {
        read_an_own_list_store(store.object, store.value)
        return
    }
    if is_the_back(store.attribute) {
        judge_a_back_store(store.object, store.value)
    } else if carries_anything(store.value) {
        refuse()
    }
    if carries_the_list(store.object) {
        refuse()
    }
    read_a_holder(store.object)
    read(store.value)
}

func judge_a_back_store(object: SpiteCompiler.Value, value: SpiteCompiler.Value) {
    var is_on_itself = object.class == HighIntermediaryRepresentation.Values.ThisRead
    var is_a_default = function.name == "_attribute_defaults" and value.class == HighIntermediaryRepresentation.Values.NullConstant
    var is_a_constructor = function.owner == child_key and function.is_a_constructor()
    var local = name_of_a_local(value)
    var is_set_by_its_constructor = is_a_constructor and steady_names.contains(local)
    if not is_on_itself {
        refuse()
    }
    if not is_a_default and not is_set_by_its_constructor {
        refuse()
    }
}

func read_an_own_list_store(object: SpiteCompiler.Value, value: SpiteCompiler.Value) {
    var is_on_itself = object.class == HighIntermediaryRepresentation.Values.ThisRead
    var is_fresh = value.class == HighIntermediaryRepresentation.Values.MakeObject and value.arguments.is_empty()
    var is_kept = is_on_itself and is_fresh and function.owner == owner_key and not is_a_drop
    if not is_kept {
        refuse()
    }
}

func read_a_holder(object: SpiteCompiler.Value) {
    fallback object.class != HighIntermediaryRepresentation.Values.ThisRead
    read(object)
}

func read_a_shape_store(store: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    read_a_leaving(store.object)
    read_a_leaving(store.value)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read(value: SpiteCompiler.Value?) {
    fallback value and holds
    if carries_anything(value) and not is_a_known_source(value) {
        refuse()
        return
    }
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: read_an_attribute(value)
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: read_a_making(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_in_a_chain(value)
        HighIntermediaryRepresentation.Values.Negation: read(value.negated)
        HighIntermediaryRepresentation.Values.ForeignCall: read_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Membership: read(value.tested)
        HighIntermediaryRepresentation.Values.PresenceTest: read(value.tested)
        HighIntermediaryRepresentation.Values.Conversion: read_a_conversion(value)
        HighIntermediaryRepresentation.Values.Function.Value: read_a_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: read_a_value_call(value)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both_left_alone(value.made, value.number)
        HighIntermediaryRepresentation.Values.ShapeCall: read_a_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: read_a_leaving(value.number)
        HighIntermediaryRepresentation.Values.EnumFromText: read_a_leaving(value.text)
        HighIntermediaryRepresentation.Values.Class.OfValue: read(value.described)
        HighIntermediaryRepresentation.Values.ThisRead: read_this()
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func read_present(value: SpiteCompiler.Value) {
    read(value)
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func read_in_a_chain(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    var links = [operation]
    var lowest = operation
    var next = read_left_link_of(lowest)
    while next {
        if carries_anything(next) and not is_a_known_source(next) {
            refuse()
            return
        }
        links.append(next)
        lowest = next
        next = read_left_link_of(lowest)
    }
    read(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        read(link.right)
        index = index - 1
    }
}

func read_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    return left
}

func read_both_left_alone(left: SpiteCompiler.Value?, right: SpiteCompiler.Value?) {
    read_a_leaving(left)
    read_a_leaving(right)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_this() {
    if is_a_drop {
        refuse()
    }
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func is_a_known_source(value: SpiteCompiler.Value): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.NullConstant {
        return true
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return carries_a_child(value)
    }
    if value.class == HighIntermediaryRepresentation.Values.ThisRead {
        return carries_a_child(value)
    }
    if value.class == HighIntermediaryRepresentation.Values.MakeObject {
        return carries_a_child(value)
    }
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        fallback value.object and is_the_own_list(value.attribute)
        return is_an_anchor(value.object)
    }
    if value.class == HighIntermediaryRepresentation.Values.Call {
        return value.function.owner == list_key and item_answers.contains(value.function.name)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        fallback value.converted and is_kept_as_it_is(value)
        var is_null = value.converted.class == HighIntermediaryRepresentation.Values.NullConstant
        return is_null or carries_anything(value.converted)
    }
    return false
}

func is_kept_as_it_is(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    var kind = conversion.kind
    return kind == 'present' or kind == 'nullable' or kind == 'proven'
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func is_an_anchor(object: SpiteCompiler.Value): Boolean {
    if object.class == HighIntermediaryRepresentation.Values.ThisRead {
        return function.owner == owner_key and not is_a_drop
    }
    if object.class == HighIntermediaryRepresentation.Values.LocalRead {
        return steady_names.contains(object.name)
    }
    if object.class == HighIntermediaryRepresentation.Values.Conversion {
        fallback object.converted and is_kept_as_it_is(object)
        return is_an_anchor(object.converted)
    }
    if object.class == HighIntermediaryRepresentation.Values.AttributeRead {
        fallback object.object and is_the_back(object.attribute)
        return is_a_steady_child(object.object)
    }
    return false
}

func is_a_steady_child(value: SpiteCompiler.Value): Boolean {
    fallback carries_a_child(value)
    if value.class == HighIntermediaryRepresentation.Values.ThisRead {
        return function.owner == child_key and not is_a_drop
    }
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return steady_names.contains(value.name)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        fallback value.converted and is_kept_as_it_is(value)
        return is_a_steady_child(value.converted)
    }
    return false
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_an_attribute(attribute_read: HighIntermediaryRepresentation.Values.AttributeRead) {
    fallback attribute_read.object
    var object = attribute_read.object
    if carries_the_list(object) {
        refuse()
    }
    var is_on_itself = object.class == HighIntermediaryRepresentation.Values.ThisRead
    if is_on_itself and is_a_drop {
        var is_kept_away = is_the_own_list(attribute_read.attribute) or is_the_back(attribute_read.attribute)
        if is_kept_away {
            refuse()
        }
        return
    }
    fallback not is_on_itself
    read(object)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var callee = call.function
    if callee.owner == list_key {
        read_a_list_call(call)
        return
    }
    var makes_a_child = callee.owner == child_key and callee.is_a_constructor()
    if makes_a_child {
        refuse()
    }
    if call.receiver {
        read_a_handed(call.receiver, callee)
    }
    read_the_arguments(call.arguments, callee)
}

func read_the_arguments(arguments: List<SpiteCompiler.Value>, callee: Model.FunctionModel) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        read_a_handed(argument, callee)
        index = index + 1
    }
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_handed(value: SpiteCompiler.Value, callee: Model.FunctionModel) {
    if carries_the_list(value) {
        refuse()
    }
    if carries_a_child(value) and not is_built(callee) {
        refuse()
    }
    read(value)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_list_call(call: HighIntermediaryRepresentation.Values.Call) {
    var name = call.function.name
    if name == "append" {
        read_an_append(call)
        return
    }
    var is_an_answer = item_answers.contains(name) or plain_list_calls.contains(name)
    var is_known = is_an_answer or searches.contains(name) or walks.contains(name)
    if not is_known or not call.receiver {
        refuse()
        return
    }
    read(call.receiver)
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if walks.contains(name) {
            judge_a_walking_function(argument)
        } else if carries_anything(argument) and not searches.contains(name) {
            refuse()
        }
        read(argument)
        index = index + 1
    }
}

func judge_a_walking_function(argument: SpiteCompiler.Value) {
    if not is_a_walking_function(argument) {
        refuse()
    }
}

func is_a_walking_function(argument: SpiteCompiler.Value): Boolean {
    fallback argument.class == HighIntermediaryRepresentation.Values.Function.Value
    var walking = argument.function
    var first = walking.parameters.first()
    fallback first and is_built(walking)
    return first.parameter_type.kind == 'object' and first.parameter_type.name == child_key
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_an_append(call: HighIntermediaryRepresentation.Values.Call) {
    var item = call.arguments.first()
    if not call.receiver or not item or call.arguments.count() != 1 {
        refuse()
        return
    }
    var is_its_own = function.owner == owner_key and not is_a_drop and is_its_own_list(call.receiver)
    if not is_its_own or not is_a_fresh_child(item) {
        refuse()
        return
    }
    read(call.receiver)
    read(item)
}

func is_its_own_list(receiver: SpiteCompiler.Value): Boolean {
    fallback receiver.class == HighIntermediaryRepresentation.Values.AttributeRead
    fallback receiver.object and is_the_own_list(receiver.attribute)
    return receiver.object.class == HighIntermediaryRepresentation.Values.ThisRead
}

func is_a_fresh_child(item: SpiteCompiler.Value): Boolean {
    if item.class == HighIntermediaryRepresentation.Values.MakeObject {
        return carries_a_child(item)
    }
    fallback item.class == HighIntermediaryRepresentation.Values.LocalRead
    return fresh_children.contains(item.name)
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    if carries_a_child(made) {
        judge_a_made_child(made)
    }
    if made.constructor {
        read_the_arguments(made.arguments, made.constructor)
    } else {
        made.arguments.each(read_a_present_leaving)
    }
}

func judge_a_made_child(made: HighIntermediaryRepresentation.Values.MakeObject) {
    var is_made_by_its_owner = function.owner == owner_key and not is_a_drop
    if not made.constructor or not is_made_by_its_owner {
        refuse()
        return
    }
    var key = made.constructor.key()
    var place = constructor_places[key]
    if not place {
        refuse()
        return
    }
    var handed = made.arguments[place]
    if not handed {
        refuse()
        return
    }
    if handed.class != HighIntermediaryRepresentation.Values.ThisRead {
        refuse()
    }
}

# ../../PROOFS.md#children-that-never-outlive-their-owner-point-back-without-a-count
func read_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    fallback conversion.converted
    var converted = conversion.converted
    var is_carried = carries_anything(converted)
    var is_carried_away = is_carried and not carries_anything(conversion)
    var is_changed = is_carried and not is_kept_as_it_is(conversion)
    if is_carried_away or is_changed {
        refuse()
    }
    read(converted)
}

func read_a_function_value(taken: HighIntermediaryRepresentation.Values.Function.Value) {
    read_a_leaving(taken.receiver)
}

func read_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    read(call.called)
    call.arguments.each(read_a_present_leaving)
}

func read_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    read(call.library)
    call.arguments.each(read_a_present_leaving)
}

func read_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    read_a_leaving(call.receiver)
    call.arguments.each(read_a_present_leaving)
}

func carries_a_child(value: SpiteCompiler.Value): Boolean {
    var held = value.value_type
    return held.kind == 'object' and held.name == child_key
}

func carries_the_list(value: SpiteCompiler.Value): Boolean {
    var held = value.value_type
    return held.kind == 'object' and held.name == list_key
}

func carries_anything(value: SpiteCompiler.Value): Boolean {
    return carries_a_child(value) or carries_the_list(value)
}

func is_the_back(attribute: Model.AttributeModel): Boolean {
    return attribute.owner == back.owner and attribute.name == back.name
}

func is_the_own_list(attribute: Model.AttributeModel): Boolean {
    return attribute.owner == owning.owner and attribute.name == owning.name
}

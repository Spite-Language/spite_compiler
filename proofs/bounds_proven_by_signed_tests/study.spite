union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

# ../../PROOFS.md#a-counted-loop-reads-its-items-unchecked
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var flow = LowOptimizationPasses.Flow()
var facts = LowIntermediaryRepresentation.ProvenTests()
var register_total = 0
var definitions = List<Integer>()
var copied_from = List<Integer>()
var constant_values = List<Long>()
var is_constant = List<Boolean>()
var never_negative = List<Boolean>()
var added_to = List<Integer>()
var added_by = List<Integer>()
var defined_in = List<Integer>()
var defined_at = List<Integer>()
var reading_block = 0
var reading_at = 0
var largest_function = 400
var deepest_chain = 8

func Study(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func tests_proven(): LowIntermediaryRepresentation.ProvenTests? {
    var block_count = function.blocks.count()
    fallback not function.is_resumable and block_count <= largest_function and block_count >= 2
    register_total = operands.most_register_of(function)
    flow.find_the_edges(function)
    read_the_definitions()
    find_the_never_negative()
    var block_index = 0
    while block_index < block_count {
        var block = function.blocks[block_index]
        decide_the_signs(block, block_index)
        decide_the_bound(block_index)
        block_index = block_index + 1
    }
    return facts
}

func read_the_definitions() {
    definitions.clear()
    copied_from.clear()
    constant_values.clear()
    is_constant.clear()
    never_negative.clear()
    added_to.clear()
    added_by.clear()
    defined_in.clear()
    defined_at.clear()
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        copied_from.append(-1)
        constant_values.append(0)
        is_constant.append(false)
        never_negative.append(index >= function.parameter_count)
        added_to.append(-1)
        added_by.append(-1)
        defined_in.append(-1)
        defined_at.append(-1)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        reading_block = block_index
        reading_at = 0
        block.instructions.each(read_a_definition)
        block_index = block_index + 1
    }
}

func read_a_definition(instruction: Instruction) {
    operands.read(instruction)
    var index = 0
    while index < operands.defines.count() {
        var defined = operands.defines[index]
        var count = definitions[defined]
        crash count
        definitions[defined] = count + 1
        if not keeps_the_sign(instruction) {
            never_negative[defined] = false
        }
        defined_in[defined] = reading_block
        defined_at[defined] = reading_at
        index = index + 1
    }
    reading_at = reading_at + 1
    if instruction.class == LowIntermediaryRepresentation.Instructions.Arithmetic and adds_without_wrapping(instruction) {
        added_to[instruction.target] = instruction.left
        added_by[instruction.target] = instruction.right
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        copied_from[instruction.target] = instruction.source
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Constant {
        constant_values[instruction.target] = instruction.number
        is_constant[instruction.target] = true
    }
}

func keeps_the_sign(instruction: Instruction): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: return instruction.number >= 0
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Arithmetic: return adds_without_wrapping(instruction)
        _: return false
    }
}

func adds_without_wrapping(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    return arithmetic.operator == 'add' and arithmetic.is_signed and not arithmetic.wraps
}

func find_the_never_negative() {
    var changed = true
    var round = 0
    while changed and round < 32 {
        changed = false
        var block_index = 0
        while block_index < function.blocks.count() {
            var block = function.blocks[block_index]
            var index = 0
            while index < block.instructions.count() {
                var instruction = block.instructions[index]
                if loses_the_sign(instruction) {
                    changed = true
                }
                index = index + 1
            }
            block_index = block_index + 1
        }
        round = round + 1
    }
    if changed {
        var cleared = 0
        while cleared < register_total {
            never_negative[cleared] = false
            cleared = cleared + 1
        }
    }
}

func loses_the_sign(instruction: Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy {
        var kept = is_never_negative(instruction.source)
        return lost_unless(instruction.target, kept)
    }
    if instruction.class == LowIntermediaryRepresentation.Instructions.Arithmetic {
        var both = is_never_negative(instruction.left) and is_never_negative(instruction.right)
        return lost_unless(instruction.target, both)
    }
    return false
}

func lost_unless(target: Integer, kept: Boolean): Boolean {
    fallback not kept and is_never_negative(target)
    never_negative[target] = false
    return true
}

func is_never_negative(register: Integer): Boolean {
    fallback register >= 0 and register < register_total
    return never_negative[register] == true
}

func is_the_constant(register: Integer, value: Long): Boolean {
    fallback register >= 0 and register < register_total and definitions[register] == 1
    return is_constant[register] == true and constant_values[register] == value
}

func same_value_of(register: Integer): Integer {
    var current = register
    var steps = 0
    while steps < deepest_chain {
        if current < function.parameter_count or definitions[current] != 1 {
            return current
        }
        var source = copied_from[current]
        crash source
        if source < 0 {
            return current
        }
        var written = definitions[source]
        crash written
        if written != 1 {
            return current
        }
        current = source
        steps = steps + 1
    }
    return current
}

func decide_the_signs(block: LowIntermediaryRepresentation.LowBlock, block_index: Integer) {
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.Compare {
            var decided = decided_by_the_sign(instruction)
            if decided >= 0 {
                var answer: Long = decided
                facts.decide(block_index, index, answer)
            }
        }
        index = index + 1
    }
}

func decided_by_the_sign(compare: LowIntermediaryRepresentation.Instructions.Compare): Integer {
    if not compare.is_signed or not is_never_negative(compare.left) or not is_the_constant(compare.right, 0) {
        return -1
    }
    if compare.comparison == 'greater_or_equal' {
        return 1
    }
    fallback compare.comparison != 'less'
    return -1
}

func decide_the_bound(block_index: Integer) {
    var block = function.blocks[block_index]
    crash block
    var count = block.instructions.count()
    fallback count >= 2
    var last = block.instructions[count - 1]
    crash last
    fallback last.class == LowIntermediaryRepresentation.Instructions.Branch
    var tested = last.condition
    var tested_index = count - 2
    var tested_instruction = block.instructions[tested_index]
    crash tested_instruction
    fallback tested_instruction.class == LowIntermediaryRepresentation.Instructions.Compare
    fallback tested_instruction.target == tested and definitions[tested] == 1
    fallback tested_instruction.comparison == 'less' and not tested_instruction.is_signed
    var proven = proven_by_a_signed_test(block_index, tested_index, tested_instruction.left, tested_instruction.right)
    fallback proven
    facts.proven_branches.append(block_index)
}

# ../../PROOFS.md#a-counted-loop-reads-its-items-unchecked
func proven_by_a_signed_test(block_index: Integer, before: Integer, left: Integer, right: Integer): Boolean {
    var same_left = same_value_of(left)
    var base = base_of(same_left)
    var offset = offset_of(same_left)
    var same_right = same_value_of(right)
    var chain = List<Integer>()
    var current = block_index
    var end = before
    var steps = 0
    while steps < deepest_chain {
        fallback not writes_either(current, end, base, same_right)
        chain.append(current)
        var coming = flow.predecessors_of(current)
        fallback coming.count() == 1
        var predecessor = coming[0]
        crash predecessor
        var earlier = function.blocks[predecessor]
        crash earlier
        var earlier_count = earlier.instructions.count()
        var ending = earlier.instructions.last()
        if ending.class == LowIntermediaryRepresentation.Instructions.Branch and not facts.is_proven(predecessor) {
            fallback offset <= 0 or is_made_in_the_chain(same_left, chain, block_index, before)
            var tested = TestedIndex(same_left, base, offset, same_right)
            return proven_at_the_branch(predecessor, ending, current, tested)
        }
        current = predecessor
        end = earlier_count
        steps = steps + 1
    }
    return false
}

func is_made_in_the_chain(register: Integer, chain: List<Integer>, block_index: Integer, before: Integer): Boolean {
    var made_in = defined_in[register]
    var made_at = defined_at[register]
    crash made_in
    crash made_at
    fallback chain.contains(made_in)
    return made_in != block_index or made_at < before
}

func is_a_step(register: Integer): Boolean {
    fallback register >= function.parameter_count and register < register_total and definitions[register] == 1
    var to = added_to[register]
    var by = added_by[register]
    crash to
    crash by
    fallback to >= 0 and by >= 0 and by < register_total and definitions[by] == 1
    var step = constant_values[by]
    crash step
    return is_constant[by] == true and step >= 0
}

func base_of(register: Integer): Integer {
    if not is_a_step(register) {
        return register
    }
    var left = added_to[register]
    crash left
    return same_value_of(left)
}

func offset_of(register: Integer): Long {
    fallback is_a_step(register)
    var by = added_by[register]
    crash by
    var step = constant_values[by]
    crash step
    return step
}

func proven_at_the_branch(
    predecessor: Integer,
    ending: LowIntermediaryRepresentation.Instructions.Branch,
    current: Integer,
    tested: TestedIndex,
): Boolean {
    fallback ending.when_true != ending.when_false
    var earlier = function.blocks[predecessor]
    crash earlier
    var count = earlier.instructions.count()
    fallback count >= 2
    var compared = earlier.instructions[count - 2]
    crash compared
    if compared.class == LowIntermediaryRepresentation.Instructions.Compare {
        var on_true = ending.when_true == current
        return proven_by_the_branch_test(predecessor, count - 2, compared, ending.condition, on_true, tested)
    }
    return false
}

func proven_by_the_branch_test(
    predecessor: Integer,
    at: Integer,
    compared: LowIntermediaryRepresentation.Instructions.Compare,
    condition: Integer,
    on_true: Boolean,
    tested: TestedIndex,
): Boolean {
    fallback not facts.is_decided(predecessor, at) and compared.target == condition
    if is_a_zero_test(compared) {
        return proven_through_a_zero_test(predecessor, compared, on_true, tested)
    }
    return proven_by_the_compare(predecessor, at, compared, on_true, tested)
}

# ../../PROOFS.md#a-counted-loop-reads-its-items-unchecked
func is_a_zero_test(compared: LowIntermediaryRepresentation.Instructions.Compare): Boolean {
    var equality = compared.comparison == 'equal' or compared.comparison == 'not_equal'
    return equality and is_the_constant(compared.right, 0) and compared.left != compared.right
}

func proven_through_a_zero_test(
    predecessor: Integer,
    zero_test: LowIntermediaryRepresentation.Instructions.Compare,
    on_true: Boolean,
    tested: TestedIndex,
): Boolean {
    var answer = zero_test.left
    fallback answer >= function.parameter_count and answer < register_total and definitions[answer] == 1
    var made_in = defined_in[answer]
    var made_at = defined_at[answer]
    crash made_in
    crash made_at
    fallback made_in == predecessor
    var earlier = function.blocks[predecessor]
    crash earlier
    var inner = earlier.instructions[made_at]
    crash inner
    var inner_true = on_true
    if zero_test.comparison == 'equal' {
        inner_true = not on_true
    }
    if inner.class == LowIntermediaryRepresentation.Instructions.Compare and not facts.is_decided(predecessor, made_at) {
        return inner.target == answer and proven_by_the_compare(predecessor, made_at, inner, inner_true, tested)
    }
    return false
}

func proven_by_the_compare(
    predecessor: Integer,
    at: Integer,
    compared: LowIntermediaryRepresentation.Instructions.Compare,
    on_true: Boolean,
    tested: TestedIndex,
): Boolean {
    var earlier = function.blocks[predecessor]
    crash earlier
    var count = earlier.instructions.count()
    fallback not writes_between(predecessor, at, count, tested.base, tested.count)
    var compared_left = same_value_of(compared.left)
    var compared_right = same_value_of(compared.right)
    var compared_base = base_of(compared_left)
    fallback compared_right == tested.count and compared_base == tested.base
    var compared_offset = offset_of(compared_left)
    fallback compared_offset >= tested.offset
    fallback compared_offset <= 0 or is_made_before(compared_left, predecessor, at, tested.base)
    fallback compared_offset <= tested.offset or is_never_negative(tested.index)
    return proves_below(compared, on_true, tested.index)
}

# ../../PROOFS.md#a-counted-loop-reads-its-items-unchecked
func is_made_before(register: Integer, predecessor: Integer, at: Integer, base: Integer): Boolean {
    var made_in = defined_in[register]
    var made_at = defined_at[register]
    crash made_in
    crash made_at
    fallback made_in == predecessor and made_at < at
    var next = made_at + 1
    return not writes_between(predecessor, next, at, base, base)
}

func proves_below(compared: LowIntermediaryRepresentation.Instructions.Compare, on_true: Boolean, index: Integer): Boolean {
    var is_below = compared.comparison == 'less' and on_true
    var is_not_at_least = compared.comparison == 'greater_or_equal' and not on_true
    var holds = is_below or is_not_at_least
    if compared.is_signed {
        return holds and is_never_negative(index)
    }
    return holds
}

func writes_between(block_index: Integer, start: Integer, end: Integer, first: Integer, second: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var index = start
    while index < end and index < block.instructions.count() {
        var instruction = block.instructions[index]
        operands.read(instruction)
        var written = operands.defines
        if written.contains(first) or written.contains(second) {
            return true
        }
        index = index + 1
    }
    return false
}

func writes_either(block_index: Integer, end: Integer, same_left: Integer, same_right: Integer): Boolean {
    var block = function.blocks[block_index]
    crash block
    var index = 0
    while index < end and index < block.instructions.count() {
        var instruction = block.instructions[index]
        operands.read(instruction)
        var written = operands.defines
        if written.contains(same_left) or written.contains(same_right) {
            return true
        }
        index = index + 1
    }
    return false
}

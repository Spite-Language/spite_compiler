# ../../PROOFS.md#what-a-parallel-may-reach
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.ParallelSite) {
    entered.enter(site.owner, site.function, site.line)
    context.block_statements = site.block_statements
    context.block_index = site.block_index
    var reach = WorkReach()
    reach.view = site.view
    if site.kind == "work" {
        reach.check_the_work(context, site.work)
    } else {
        check_each(reach, site)
    }
}

func check_each(reach: WorkReach, site: HighIntermediaryRepresentation.Building.ParallelSite) {
    crash site.callee
    reach.check_the_steps(context, site.callee)
    reach.check_each(context, site.each_owner, site.callee.name)
}

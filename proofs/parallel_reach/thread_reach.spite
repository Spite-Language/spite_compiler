union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var reached_keys = List<String>()
var reached_classes = List<Model.ClassModel>()
var reached_functions = List<Model.FunctionModel>()

func check(context: HighIntermediaryRepresentation.Building.Context, model: Model.ClassModel, function: Model.FunctionModel, written: String) {
    reach(context, model, function)
    refuse_endless_work(context, written)
    refuse_a_locked_wait(context, written)
    refuse_an_endless_locked_loop()
}

func reach(context: HighIntermediaryRepresentation.Building.Context, model: Model.ClassModel, function: Model.FunctionModel) {
    var library = Validators.LibraryFile()
    fallback not library.holds(model.file.path)
    var key = "{model.key}.{function.name}"
    fallback not reached_keys.contains(key)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    fallback declaration.body
    reached_keys.append(key)
    reached_classes.append(model)
    reached_functions.append(function)
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        follow(context, model, function, walk, found.expression)
        index = index + 1
    }
}

func follow(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    expression: Expression?,
) {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        follow_a_call(context, model, function, walk, expression)
    }
}

func follow_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        follow_a_named_call(context, model, callee.name)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        follow_a_member_call(context, model, function, walk, callee)
    }
}

func follow_a_named_call(context: HighIntermediaryRepresentation.Building.Context, model: Model.ClassModel, name: String) {
    var function = model.function_named(name)
    if function {
        follow_into(context, model, name)
        return
    }
    var made = context.program.class_named(name)
    fallback made
    var plain = plain_name(name)
    follow_into(context, made, plain)
}

func follow_a_member_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var target_class = class_of_an_expression(context, model, function, walk, callee.target, 0)
    fallback target_class
    follow_into(context, target_class, callee.name)
}

func follow_into(context: HighIntermediaryRepresentation.Building.Context, target_class: Model.ClassModel, name: String) {
    var library = Validators.LibraryFile()
    fallback not library.holds(target_class.file.path)
    var function = target_class.function_named(name)
    fallback function
    var key = "{target_class.key}.{function.name}"
    fallback not reached_keys.contains(key)
    reach(context, target_class, function)
}

func class_of_an_expression(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    expression: Expression?,
    depth: Integer,
): Model.ClassModel? {
    fallback depth <= 16
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_name(context, model, function, walk, expression.name)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return class_of_a_member(context, model, function, walk, expression, depth)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return class_of_an_answer(context, model, function, walk, expression, depth)
    }
    return null
}

func class_of_a_member(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    depth: Integer,
): Model.ClassModel? {
    var holder = class_of_an_expression(context, model, function, walk, member.target, depth + 1)
    fallback holder
    var attribute = holder.attribute_named(member.name)
    if attribute {
        return class_of_a_type(context, attribute.attribute_type)
    }
    return null
}

func class_of_an_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    depth: Integer,
): Model.ClassModel? {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return class_of_a_named_answer(context, model, callee.name)
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var holder = class_of_an_expression(context, model, function, walk, callee.target, depth + 1)
        if holder {
            return class_of_a_function_answer(context, holder, callee.name)
        }
    }
    return null
}

func class_of_a_named_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    name: String,
): Model.ClassModel? {
    var made = context.program.class_named(name)
    if made {
        return made
    }
    return class_of_a_function_answer(context, model, name)
}

func class_of_a_function_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    holder: Model.ClassModel,
    name: String,
): Model.ClassModel? {
    var called = holder.function_named(name)
    fallback called
    fallback called.answer
    return class_of_a_type(context, called.answer)
}

func class_of_a_name(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    name: String,
): Model.ClassModel? {
    if name == "this" {
        return model
    }
    var parameter_index = 0
    while parameter_index < function.parameters.count() {
        var parameter = function.parameters[parameter_index]
        if parameter.name == name {
            return class_of_a_type(context, parameter.parameter_type)
        }
        parameter_index = parameter_index + 1
    }
    var attribute = model.attribute_named(name)
    if attribute {
        return class_of_a_type(context, attribute.attribute_type)
    }
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var made = made_class_of(context, model, function, walk, found.statement, name)
        if made {
            return made
        }
        index = index + 1
    }
    return null
}

func made_class_of(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    statement: Statement?,
    name: String,
): Model.ClassModel? {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
        var value = statement.value
        if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
            return class_of_an_answer(context, model, function, walk, value, 1)
        }
    }
    return null
}

func class_of_a_type(context: HighIntermediaryRepresentation.Building.Context, of_type: Model.Type): Model.ClassModel? {
    if of_type.kind == 'object' and context.has_a_class(of_type) {
        return context.class_of(of_type)
    }
    return null
}

func refuse_endless_work(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    var index = 0
    while index < reached_functions.count() {
        var function = reached_functions[index]
        var model = reached_classes[index]
        crash model
        refuse_endless_work_in(context, model, function, written)
        index = index + 1
    }
}

# ../../PROOFS.md#a-loop-that-can-never-end-is-an-error
func refuse_endless_work_in(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    written: String,
) {
    var walk = walk_of_a_function(function)
    var line = endless_loop_line(walk)
    fallback line > 0
    var plain = plain_name(model.shown)
    var text = "'{written}' runs '{plain}.{function.name}' on the thread pool, and this loop never ends and never waits, so the work never finishes and keeps its thread for good: return from the loop once the work is done, or run the loop on the program's own thread"
    if only_prints(model, walk) {
        var failure = Validators.Failure()
        failure.stop_inside(model.file.path, line, plain, function.name, text)
    }
    var key = "{model.key}.{function.name}"
    var candidate = HighIntermediaryRepresentation.Building.EndlessWork(key, model.file.path, line, plain, function.name, text)
    context.endless_work.append(candidate)
}

func refuse_an_endless_locked_loop() {
    var index = 0
    while index < reached_classes.count() {
        var model = reached_classes[index]
        if model.is_singleton {
            refuse_a_locked_loop_in(model)
        }
        index = index + 1
    }
}

func refuse_a_locked_loop_in(model: Model.ClassModel) {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        refuse_a_locked_loop(model, function)
        index = index + 1
    }
}

func refuse_a_locked_loop(model: Model.ClassModel, function: Model.FunctionModel) {
    fallback function.declaration
    var walk = walk_of_a_function(function)
    var line = endless_loop_line(walk)
    fallback line > 0
    fallback touches_the_state(model, walk)
    var plain = plain_name(model.shown)
    var text = "'{plain}.{function.name}' holds {plain}'s lock for the whole call, since a Parallel reaches {plain}, and this loop never ends, so every other call on {plain} would wait forever: move the loop into a class that is not a singleton, and call {plain} from it"
    var failure = Validators.Failure()
    failure.stop_inside(model.file.path, line, plain, function.name, text)
}

func refuse_a_locked_wait(context: HighIntermediaryRepresentation.Building.Context, written: String) {
    var model = context.current_class
    fallback model.is_singleton
    var statements = context.block_statements
    var statement = statements[context.block_index]
    var handle = handle_name(statement)
    fallback handle != ""
    fallback not lets_the_handle_go(context, handle)
    var index = 0
    while index < reached_classes.count() {
        var reached = reached_classes[index]
        var function = reached_functions[index]
        crash function
        if reached.key == model.key {
            refuse_a_call_back(context, model, function, written)
        }
        index = index + 1
    }
}

func refuse_a_call_back(context: HighIntermediaryRepresentation.Building.Context, model: Model.ClassModel, function: Model.FunctionModel, written: String) {
    var walk = walk_of_a_function(function)
    fallback touches_the_state(model, walk)
    var plain = plain_name(model.shown)
    var waiting = context.current_function.name
    var written_length = written.length()
    var work = written.slice(9, written_length - 1)
    crash work
    var text = "'{plain}.{waiting}' waits for '{written}' while it holds {plain}'s lock, since a Parallel reaches {plain}, and what '{work}' runs calls '{plain}.{function.name}', which takes that lock: each would wait for the other forever. Wait for the Parallel outside {plain}'s functions, or do not call {plain} from its work"
    var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()
    typing.stop(context, text)
}

func handle_name(statement: Statement?): String {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name
    }
    return ""
}

func lets_the_handle_go(context: HighIntermediaryRepresentation.Building.Context, handle: String): Boolean {
    var statements = context.block_statements
    var after = context.block_index + 1
    var answers_a_handle = false
    if context.current_function.answer {
        answers_a_handle = context.current_function.answer.kind == 'handle'
    }
    while after < statements.count() {
        var later = statements[after]
        var walk = AbstractSyntaxTree.Walk.Walk(no_file)
        walk.read_statement(later)
        if passes_the_handle(walk, handle, answers_a_handle) {
            return true
        }
        after = after + 1
    }
    return false
}

func passes_the_handle(walk: AbstractSyntaxTree.Walk.Walk, handle: String, answers_a_handle: Boolean): Boolean {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if gives_the_handle(found.statement, handle, answers_a_handle) {
            return true
        }
        index = index + 1
    }
    var expression_index = 0
    while expression_index < walk.expressions.count() {
        var found_expression = walk.expressions[expression_index]
        if hands_it_on(found_expression.expression, handle) {
            return true
        }
        expression_index = expression_index + 1
    }
    return false
}

func gives_the_handle(
    statement: Statement?,
    handle: String,
    answers_a_handle: Boolean,
): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.value, handle)
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return answers_a_handle and is_the_name(statement.value, handle)
    }
    return false
}

func hands_it_on(expression: Expression?, handle: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return names_among(expression.arguments, handle)
    }
    if expression == AbstractSyntaxTree.Shapes.Expressions.ListLiteral {
        return names_among(expression.entries, handle)
    }
    return false
}

func names_among(expressions: List<Expression>, handle: String): Boolean {
    var index = 0
    while index < expressions.count() {
        var expression = expressions[index]
        if is_the_name(expression, handle) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_the_name(expression: Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func walk_of_a_function(function: Model.FunctionModel): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    crash function.declaration
    crash function.declaration.body
    walk.read_block(function.declaration.body)
    return walk
}

func endless_loop_line(walk: AbstractSyntaxTree.Walk.Walk): Integer {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var line = endless_line_of(found.statement)
        if line > 0 {
            return line
        }
        index = index + 1
    }
    return 0
}

func endless_line_of(statement: Statement?): Integer {
    if statement == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
        return endless_while_line(statement)
    }
    return 0
}

func endless_while_line(loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement): Integer {
    var condition = loop.condition
    if condition == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and condition.kind == 'keyword_true' and not can_leave(loop) {
        return loop.line
    }
    return 0
}

func can_leave(loop: AbstractSyntaxTree.Shapes.Statements.WhileStatement): Boolean {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(loop.body)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if leaves(found.statement) {
            return true
        }
        index = index + 1
    }
    return false
}

func leaves(statement: Statement?): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return true
    }
    if statement == AbstractSyntaxTree.Shapes.Statements.FallbackStatement {
        return true
    }
    return statement == AbstractSyntaxTree.Shapes.Statements.CrashStatement
}

func only_prints(model: Model.ClassModel, walk: AbstractSyntaxTree.Walk.Walk): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        fallback prints_or_is_plain(model, found.expression)
        index = index + 1
    }
    return true
}

func prints_or_is_plain(
    model: Model.ClassModel,
    expression: Expression?,
): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return calls_the_console(model, expression.callee)
    }
    return true
}

func calls_the_console(model: Model.ClassModel, callee: Expression?): Boolean {
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        var receiver = callee.target
        if receiver == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
            return is_the_console(model, receiver.name)
        }
    }
    return false
}

func is_the_console(model: Model.ClassModel, name: String): Boolean {
    var attribute = model.attribute_named(name)
    if attribute {
        return attribute.attribute_type.name == "Console"
    }
    return false
}

func touches_the_state(model: Model.ClassModel, walk: AbstractSyntaxTree.Walk.Walk): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if names_an_attribute(model, found.expression) {
            return true
        }
        index = index + 1
    }
    return false
}

func names_an_attribute(
    model: Model.ClassModel,
    expression: Expression?,
): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var attribute = model.attribute_named(expression.name)
        if attribute {
            return not is_a_singleton_attribute(attribute)
        }
    }
    return false
}

func is_a_singleton_attribute(attribute: Model.AttributeModel): Boolean {
    return attribute.attribute_type.name == "Console"
}

func plain_name(shown: String): String {
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

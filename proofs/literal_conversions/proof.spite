# ../../PROOFS.md#a-literal-that-converts-is-a-t

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var evaluator = Evaluator(context)
var numbers = Numbers()
var answers = Dictionary<String, Held>()
var evaluated_keys = Dictionary<String, Boolean>()
var is_the_whole_build = true

func prove(starting_context: HighIntermediaryRepresentation.Building.Context, starting_is_the_whole_build: Boolean) {
    context = starting_context
    is_the_whole_build = starting_is_the_whole_build
    fallback not context.literal_sites.is_empty()
    evaluator = Evaluator(context)
    context.literal_sites.each(prove_a_site)
}

func prove_a_site(site: HighIntermediaryRepresentation.Building.LiteralSite) {
    var call = site.call
    var called_key = call.function.key()
    var key = "{called_key}|{site.shown_literal}"
    if not evaluated_keys.contains(key) {
        evaluated_keys[key] = true
        var answer = evaluator.answer_of(call)
        if answer {
            answers[key] = answer
        }
    }
    var found = answers[key]
    if not found {
        call.is_a_present_literal = not is_the_whole_build
        return
    }
    site.does_not_convert = found.kind == 'absent'
    if not site.does_not_convert {
        call.is_a_present_literal = true
        note_a_plain_answer(site, found)
    }
}

func note_a_plain_answer(site: HighIntermediaryRepresentation.Building.LiteralSite, found: Held) {
    var present = site.call.value_type.present()
    var is_plain = present.kind == 'scalar' or present.kind == 'enumeration'
    fallback is_plain
    if found.kind == 'whole' {
        var number = HighIntermediaryRepresentation.Values.WholeNumber(present, found.whole)
        site.call.literal_answer = HighIntermediaryRepresentation.Values.Conversion(
            site.call.value_type,
            'nullable',
            number,
        )
    }
    fallback found.kind == 'decimal' and not site.written_decimal.is_empty()
    var same = numbers.read_a_decimal(site.written_decimal, present.name)
    fallback same and same.kind == 'decimal' and same.decimal == found.decimal
    var decimal = HighIntermediaryRepresentation.Values.DecimalNumber(present, site.written_decimal)
    site.call.literal_answer = HighIntermediaryRepresentation.Values.Conversion(
        site.call.value_type,
        'nullable',
        decimal,
    )
}

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.LiteralSite) {
    entered.enter(site.owner, site.function, site.line)
    var rule = Validators.HighIntermediaryRepresentation.LiteralConversion.Validator()
    rule.check_a_site(context, site)
}

# ../../PROOFS.md#a-literal-that-converts-is-a-t

var numbers = Numbers()
var _byte_mask: Long = 255
var _largest_position: Long = 2147483647

func answer_of(function: Model.FunctionModel, receiver: Held, arguments: List<Held>): Held? {
    var name = function.name
    if name.starts_with("_read_") and name.ends_with("_at") {
        return read_at(name, receiver, arguments)
    }
    if name.starts_with("_write_") and name.ends_with("_at") {
        return written_at(name, receiver, arguments)
    }
    if name == "_resize_room" {
        return resized_room(receiver, arguments)
    }
    if name == "_item_size" {
        return numbers.whole_held(8)
    }
    if name == "_read_value" or name == "_write_value" or name == "_forget_value" {
        return list_answer(name, receiver, arguments)
    }
    if name == "open_library" {
        return opened_library(arguments)
    }
    return number_answer(name, function.owner, receiver, arguments)
}

func first_of(arguments: List<Held>): Held? {
    fallback arguments.count() > 0
    return arguments[0]
}

func second_of(arguments: List<Held>): Held? {
    fallback arguments.count() > 1
    return arguments[1]
}

func position_of(arguments: List<Held>): Integer? {
    var first = first_of(arguments)
    fallback first and first.kind == 'whole'
    fallback first.whole >= 0 and first.whole <= _largest_position
    var position: Integer = first.whole
    return position
}

func type_of_access(name: String, prefix_size: Integer): String {
    var ending = name.length() - 3
    var inner = name.slice(prefix_size, ending)
    fallback inner
    if inner == "byte" {
        return "Byte"
    }
    if inner == "tiny" {
        return "Tiny"
    }
    if inner == "short" {
        return "Short"
    }
    if inner == "unsigned_short" {
        return "UnsignedShort"
    }
    if inner == "integer" {
        return "Integer"
    }
    if inner == "unsigned_integer" {
        return "UnsignedInteger"
    }
    if inner == "long" {
        return "Long"
    }
    if inner == "unsigned_long" {
        return "UnsignedLong"
    }
    if inner == "float" {
        return "Float"
    }
    if inner == "double" {
        return "Double"
    }
    return ""
}

func read_at(name: String, receiver: Held, arguments: List<Held>): Held? {
    var type_name = type_of_access(name, 6)
    var size = numbers.byte_count_of(type_name)
    var at = position_of(arguments)
    var object = numbers.object_in(receiver)
    fallback size > 0 and at and object
    fallback at + size <= object.bytes.count()
    var bits = bits_read(object, at, size)
    if numbers.is_decimal_type(type_name) {
        var read_decimal = numbers.decimal_of_bits(bits, type_name)
        return numbers.decimal_held(read_decimal)
    }
    var kept = bits_kept(bits, size, type_name)
    return numbers.whole_held(kept)
}

func bits_read(object: HeldObject, at: Integer, size: Integer): Long {
    var bits: Long = 0
    var index = size - 1
    while index >= 0 {
        var code = object.bytes[at + index]
        crash code
        var wide_code: Long = code
        bits = bits.shifted_left(8)
        bits = bits.bits_or(wide_code)
        index = index - 1
    }
    return bits
}

func bits_kept(bits: Long, size: Integer, type_name: String): Long {
    if size == 0 or size >= 8 {
        return bits
    }
    var shift = (8 - size) * 8
    var raised = bits.shifted_left(shift)
    if numbers.is_signed(type_name) {
        return raised.shifted_right(shift)
    }
    var unsigned = raised.bits_as_unsigned()
    var lowered = unsigned.shifted_right(shift)
    return lowered.bits_as_signed()
}

func written_at(name: String, receiver: Held, arguments: List<Held>): Held? {
    var type_name = type_of_access(name, 7)
    var size = numbers.byte_count_of(type_name)
    var at = position_of(arguments)
    var object = numbers.object_in(receiver)
    var value = second_of(arguments)
    fallback size > 0 and at and object and value
    fallback at + size <= object.bytes.count()
    fallback value.kind == 'whole' or value.kind == 'decimal'
    var bits = value.whole
    if value.kind == 'decimal' {
        bits = numbers.bits_of_a_decimal(value.decimal, type_name)
    }
    put_bits(object, at, size, bits)
    return Held('nothing')
}

func put_bits(object: HeldObject, at: Integer, size: Integer, bits: Long) {
    var left = bits
    var index = 0
    while index < size {
        var low_byte = left.bits_and(_byte_mask)
        var code: Integer = low_byte
        object.bytes[at + index] = code
        left = left.shifted_right(8)
        index = index + 1
    }
}

func resized_room(receiver: Held, arguments: List<Held>): Held? {
    var object = numbers.object_in(receiver)
    var size = position_of(arguments)
    fallback object and size
    while object.bytes.count() < size {
        object.bytes.append(0)
    }
    return Held('nothing')
}

func list_answer(name: String, receiver: Held, arguments: List<Held>): Held? {
    var object = numbers.object_in(receiver)
    var at = position_of(arguments)
    fallback object and at
    if name == "_forget_value" {
        return Held('nothing')
    }
    if name == "_read_value" {
        fallback at < object.items.count()
        return object.items[at]
    }
    var value = second_of(arguments)
    fallback value
    var nothing = Held('nothing')
    while object.items.count() <= at {
        object.items.append(nothing)
    }
    object.items[at] = value
    return nothing
}

func opened_library(arguments: List<Held>): Held? {
    var named = first_of(arguments)
    fallback named
    var object = numbers.object_in(named)
    fallback object
    var name = text_of(object)
    fallback name == "ucrtbase.dll"
    return numbers.whole_held(1)
}

func text_of(object: HeldObject): String {
    var made = String()
    var length = object.held_attributes["_length"]
    var buffer = object.held_attributes["_buffer"]
    fallback length and buffer
    var bytes_held = numbers.object_in(buffer)
    fallback bytes_held
    var index = 0
    while length.whole > index and index < bytes_held.bytes.count() {
        var code = bytes_held.bytes[index]
        crash code
        made.append_code(code)
        index = index + 1
    }
    return made
}

func number_answer(name: String, owner: String, receiver: Held, arguments: List<Held>): Held? {
    if receiver.kind == 'decimal' {
        return decimal_answer(name, owner, receiver.decimal)
    }
    fallback receiver.kind == 'whole'
    if name == "_bits_as_double" {
        var as_double = receiver.whole.bits_as_double()
        return numbers.decimal_held(as_double)
    }
    if name == "_bits_as_float" {
        var as_float = numbers.decimal_of_bits(receiver.whole, "Float")
        return numbers.decimal_held(as_float)
    }
    if name == "_bits_as_unsigned" or name == "_bits_as_signed" {
        return bits_read_as_the_other_sign(name, owner, receiver.whole)
    }
    var other = first_of(arguments)
    fallback other and other.kind == 'whole'
    if name == "_bits_and" {
        var both = receiver.whole.bits_and(other.whole)
        return numbers.whole_held(both)
    }
    if name == "_bits_or" {
        var either = receiver.whole.bits_or(other.whole)
        var kept_either = whole_kept_in(either, owner)
        return numbers.whole_held(kept_either)
    }
    return shifted_answer(name, owner, receiver.whole, other.whole)
}

func bits_read_as_the_other_sign(name: String, owner: String, whole: Long): Held? {
    var size = numbers.byte_count_of(owner)
    fallback size > 0
    var read_as = "Long"
    if name == "_bits_as_unsigned" {
        read_as = "UnsignedLong"
    }
    var kept = bits_kept(whole, size, read_as)
    return numbers.whole_held(kept)
}

func whole_kept_in(bits: Long, owner: String): Long {
    var size = numbers.byte_count_of(owner)
    return bits_kept(bits, size, owner)
}

func shifted_answer(name: String, owner: String, whole: Long, count: Long): Held? {
    var size = numbers.byte_count_of(owner)
    fallback size > 0 and count >= 0 and count < size * 8
    var places: Integer = count
    if name == "_shifted_left" {
        var raised = whole.shifted_left(places)
        var kept = bits_kept(raised, size, owner)
        return numbers.whole_held(kept)
    }
    fallback name == "_shifted_right"
    if numbers.is_signed(owner) or size < 8 {
        var lowered = whole.shifted_right(places)
        return numbers.whole_held(lowered)
    }
    var unsigned = whole.bits_as_unsigned()
    var unsigned_lowered = unsigned.shifted_right(places)
    var lowered_bits = unsigned_lowered.bits_as_signed()
    return numbers.whole_held(lowered_bits)
}

func decimal_answer(name: String, owner: String, number: Double): Held? {
    if name == "_bits" {
        var bits = numbers.bits_of_a_decimal(number, owner)
        return numbers.whole_held(bits)
    }
    if name == "_floor" {
        var floored = number.floor()
        return numbers.decimal_held(floored)
    }
    if name == "_ceiling" {
        var raised = number.ceiling()
        return numbers.decimal_held(raised)
    }
    fallback name == "_truncate"
    var truncated = number.truncate()
    return numbers.decimal_held(truncated)
}

# ../../PROOFS.md#a-literal-that-converts-is-a-t

var _largest_long: Long = 9223372036854775807
var _largest_unsigned_long: UnsignedLong = 18446744073709551615
var _largest_float: Double = 340282346638528859811704183484516925440.0
var _limit_of_a_whole: Double = 9223372036854775000.0
var _low_32_bits_mask: Long = 4294967295
var _smallest_integer: Long = -2147483648
var _largest_integer: Long = 2147483647
var _largest_unsigned_integer: Long = 4294967295
var _smallest_short: Long = -32768
var _largest_short: Long = 32767
var _largest_unsigned_short: Long = 65535
var _smallest_tiny: Long = -128
var _largest_tiny: Long = 127
var _largest_byte: Long = 255

func whole_held(number: Long): Held {
    var made = Held('whole')
    made.whole = number
    return made
}

func decimal_held(number: Double): Held {
    var made = Held('decimal')
    made.decimal = number
    return made
}

func truth_held(is_true: Boolean): Held {
    if is_true {
        return whole_held(1)
    }
    return whole_held(0)
}

func object_in(held: Held): HeldObject? {
    return held.object
}

func smallest_long(): Long {
    return 0 - _largest_long - 1
}

func is_a_comparison(operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator): Boolean {
    var ordered = operator == 'less' or operator == 'less_or_equal' or operator == 'greater'
    return ordered or operator == 'greater_or_equal' or operator == 'equal' or operator == 'not_equal'
}

func is_decimal_type(type_name: String): Boolean {
    return type_name == "Float" or type_name == "Double"
}

func is_unsigned_long(type_name: String): Boolean {
    return type_name == "UnsignedLong"
}

# ../../../spite_spec/specs/values_and_types.md#numeric-types
func fits(number: Long, type_name: String): Boolean {
    if type_name == "Long" {
        return true
    }
    if type_name == "UnsignedLong" {
        return number >= 0
    }
    if type_name == "Integer" {
        return number >= _smallest_integer and number <= _largest_integer
    }
    if type_name == "UnsignedInteger" {
        return number >= 0 and number <= _largest_unsigned_integer
    }
    if type_name == "Short" {
        return number >= _smallest_short and number <= _largest_short
    }
    if type_name == "UnsignedShort" {
        return number >= 0 and number <= _largest_unsigned_short
    }
    if type_name == "Tiny" {
        return number >= _smallest_tiny and number <= _largest_tiny
    }
    if type_name == "Byte" {
        return number >= 0 and number <= _largest_byte
    }
    return false
}

func is_true_of_order(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    is_less: Boolean,
    is_equal: Boolean,
): Boolean {
    switch operator {
        'less': return is_less
        'less_or_equal': return is_less or is_equal
        'greater': return not is_less and not is_equal
        'greater_or_equal': return not is_less
        'equal': return is_equal
        'not_equal': return not is_equal
        'add': return false
        'subtract': return false
        'multiply': return false
        'divide': return false
        'remainder': return false
        'and': return false
        'or': return false
    }
}

func long_sum(left: Long, right: Long): Long? {
    if right > 0 {
        fallback left <= _largest_long - right
    }
    if right < 0 {
        var lowest = smallest_long()
        fallback left >= lowest - right
    }
    return left + right
}

func long_difference(left: Long, right: Long): Long? {
    if right < 0 {
        fallback left <= _largest_long + right
    }
    if right > 0 {
        var lowest = smallest_long()
        fallback left >= lowest + right
    }
    return left - right
}

func long_product(left: Long, right: Long): Long? {
    if left == 0 or right == 0 {
        return 0
    }
    var lowest = smallest_long()
    if left == -1 {
        fallback right != lowest
        return 0 - right
    }
    if right == -1 {
        fallback left != lowest
        return 0 - left
    }
    if left > 0 and right > 0 {
        fallback left <= _largest_long / right
    }
    if left > 0 and right < 0 {
        fallback right >= lowest / left
    }
    if left < 0 and right > 0 {
        fallback left >= lowest / right
    }
    if left < 0 and right < 0 {
        fallback left >= _largest_long / right
    }
    return left * right
}

func long_quotient(left: Long, right: Long): Long? {
    var lowest = smallest_long()
    fallback right != 0
    fallback left != lowest or right != -1
    return left / right
}

func long_remainder(left: Long, right: Long): Long? {
    var lowest = smallest_long()
    fallback right != 0
    fallback left != lowest or right != -1
    return left % right
}

func long_answer(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Long,
    right: Long,
): Long? {
    switch operator {
        'add': return long_sum(left, right)
        'subtract': return long_difference(left, right)
        'multiply': return long_product(left, right)
        'divide': return long_quotient(left, right)
        'remainder': return long_remainder(left, right)
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func unsigned_sum(left: UnsignedLong, right: UnsignedLong): UnsignedLong? {
    fallback left <= _largest_unsigned_long - right
    return left + right
}

func unsigned_difference(left: UnsignedLong, right: UnsignedLong): UnsignedLong? {
    fallback left >= right
    return left - right
}

func unsigned_product(left: UnsignedLong, right: UnsignedLong): UnsignedLong? {
    if right != 0 {
        fallback left <= _largest_unsigned_long / right
    }
    return left * right
}

func unsigned_quotient(left: UnsignedLong, right: UnsignedLong): UnsignedLong? {
    fallback right != 0
    return left / right
}

func unsigned_remainder(left: UnsignedLong, right: UnsignedLong): UnsignedLong? {
    fallback right != 0
    return left % right
}

func unsigned_operated(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: UnsignedLong,
    right: UnsignedLong,
): UnsignedLong? {
    switch operator {
        'add': return unsigned_sum(left, right)
        'subtract': return unsigned_difference(left, right)
        'multiply': return unsigned_product(left, right)
        'divide': return unsigned_quotient(left, right)
        'remainder': return unsigned_remainder(left, right)
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func unsigned_answer(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left_bits: Long,
    right_bits: Long,
): Held? {
    var left = left_bits.bits_as_unsigned()
    var right = right_bits.bits_as_unsigned()
    var answer = unsigned_operated(operator, left, right)
    fallback answer
    var bits = answer.bits_as_signed()
    return whole_held(bits)
}

func whole_operated(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Long,
    right: Long,
    left_type: String,
    answer_type: String,
): Held? {
    if is_a_comparison(operator) {
        if is_unsigned_long(left_type) {
            var unsigned_left = left.bits_as_unsigned()
            var unsigned_right = right.bits_as_unsigned()
            var unsigned_is_true = is_true_of_order(
                operator,
                unsigned_left < unsigned_right,
                unsigned_left == unsigned_right,
            )
            return truth_held(unsigned_is_true)
        }
        var is_true = is_true_of_order(operator, left < right, left == right)
        return truth_held(is_true)
    }
    if is_unsigned_long(answer_type) {
        return unsigned_answer(operator, left, right)
    }
    var answer = long_answer(operator, left, right)
    fallback answer and fits(answer, answer_type)
    return whole_held(answer)
}

func decimal_quotient(left: Double, right: Double): Double? {
    fallback right != 0.0
    return left / right
}

func decimal_answer(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Double,
    right: Double,
): Double? {
    switch operator {
        'add': return left + right
        'subtract': return left - right
        'multiply': return left * right
        'divide': return decimal_quotient(left, right)
        'remainder': return null
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func float_quotient(left: Float, right: Float): Float? {
    fallback right != 0.0
    return left / right
}

func float_answer(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Float,
    right: Float,
): Float? {
    switch operator {
        'add': return left + right
        'subtract': return left - right
        'multiply': return left * right
        'divide': return float_quotient(left, right)
        'remainder': return null
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func decimal_operated(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: Double,
    right: Double,
    answer_type: String,
): Held? {
    if is_a_comparison(operator) {
        fallback not left.is_not_a_number() and not right.is_not_a_number()
        var is_true = is_true_of_order(operator, left < right, left == right)
        return truth_held(is_true)
    }
    if answer_type == "Float" {
        fallback fits_a_float(left) and fits_a_float(right)
        var left_float: Float = left
        var right_float: Float = right
        var narrow_answer = float_answer(operator, left_float, right_float)
        fallback narrow_answer
        var widened: Double = narrow_answer
        fallback not widened.is_not_a_number()
        return decimal_held(widened)
    }
    var answer = decimal_answer(operator, left, right)
    fallback answer and not answer.is_not_a_number()
    return decimal_held(answer)
}

func fits_a_float(number: Double): Boolean {
    var lowest_float = 0.0 - _largest_float
    return number <= _largest_float and number >= lowest_float
}

func whole_of_a_decimal(number: Double, type_name: String): Held? {
    fallback not number.is_not_a_number()
    var lowest = 0.0 - _limit_of_a_whole
    fallback number < _limit_of_a_whole and number > lowest
    var truncated = number.truncate()
    var whole: Long = truncated
    fallback fits(whole, type_name)
    return whole_held(whole)
}

func decimal_of_a_whole(number: Long, type_name: String): Held {
    if type_name == "Float" {
        var narrow: Float = number
        var widened: Double = narrow
        return decimal_held(widened)
    }
    var wide: Double = number
    return decimal_held(wide)
}

func decimal_as(number: Double, type_name: String): Held? {
    if type_name == "Double" {
        return decimal_held(number)
    }
    fallback type_name == "Float" and fits_a_float(number)
    var narrow: Float = number
    var widened: Double = narrow
    return decimal_held(widened)
}

func cast(held: Held, given_type: String, wanted_type: String): Held? {
    if held.kind == 'decimal' {
        if is_decimal_type(wanted_type) {
            return decimal_as(held.decimal, wanted_type)
        }
        return whole_of_a_decimal(held.decimal, wanted_type)
    }
    fallback held.kind == 'whole'
    fallback not is_unsigned_long(given_type) or held.whole >= 0
    if is_decimal_type(wanted_type) {
        return decimal_of_a_whole(held.whole, wanted_type)
    }
    fallback fits(held.whole, wanted_type)
    return held
}

func read_a_decimal(written: String, type_name: String): Held? {
    if type_name == "Float" {
        var narrow: Float? = written
        fallback narrow
        var widened: Double = narrow
        return decimal_held(widened)
    }
    var wide: Double? = written
    fallback wide
    return decimal_held(wide)
}

func bits_of_a_decimal(number: Double, type_name: String): Long {
    if type_name == "Float" {
        var narrow: Float = number
        return narrow.bits()
    }
    return number.bits()
}

func decimal_of_bits(bits: Long, type_name: String): Double {
    if type_name == "Float" {
        var masked = bits.bits_and(_low_32_bits_mask)
        var narrow_bits: UnsignedInteger = masked
        return narrow_bits.bits_as_float()
    }
    return bits.bits_as_double()
}

func byte_count_of(type_name: String): Integer {
    if type_name == "Long" or type_name == "UnsignedLong" or type_name == "Double" {
        return 8
    }
    if type_name == "Integer" or type_name == "UnsignedInteger" or type_name == "Float" {
        return 4
    }
    if type_name == "Short" or type_name == "UnsignedShort" {
        return 2
    }
    if type_name == "Tiny" or type_name == "Byte" {
        return 1
    }
    return 0
}

func is_signed(type_name: String): Boolean {
    return type_name == "Long" or type_name == "Integer" or type_name == "Short" or type_name == "Tiny"
}

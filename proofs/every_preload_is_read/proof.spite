# ../../PROOFS.md#unused-is-an-error
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var context = high.context
    var preloads = context.resolver.state.symbols.preloads
    fallback preloads.holds_a_volume()
    var made = List<String>()
    var known = context.singleton_arguments["Volume"]
    if known {
        made = known
    }
    var reads = Validators.HighIntermediaryRepresentation.PreloadedVolume.Validator()
    var reads_answer = reads.check_the_reads(preloads, made)
    reads_answer.tell()
}

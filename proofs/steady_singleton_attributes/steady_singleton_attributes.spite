# ../../PROOFS.md#a-singleton-attribute-that-never-changes-is-read-in-place
var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var nothing_locked = List<String>()
var forms = HighIntermediaryRepresentation.SingletonForms(high, nothing_locked)

func check(high_program: HighIntermediaryRepresentation.HighProgram) {
    high = high_program
    high.steady_singleton_attributes = List<String>()
    assert high.will_be_lowered()
    crash high.context
    assert not is_interactive(high.context.build_flags)
    crash high.layout
    forms = HighIntermediaryRepresentation.SingletonForms(high, nothing_locked)
    var classes = high.model.classes.values()
    classes.each(note_a_singleton)
}

func is_interactive(flags: Dictionary<String, String>): Boolean {
    var asked = flags.contains("repl") or flags.contains("repl_port") or flags.contains("development")
    return asked or flags.contains("hot_reload")
}

func note_a_singleton(model: Model.ClassModel) {
    assert model.is_singleton and not forms.written_through_shapes.contains(model.key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if never_changes(attribute) {
            high.steady_singleton_attributes.append("{attribute.owner}.{attribute.name}")
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-singleton-attribute-that-never-changes-is-read-in-place
func never_changes(attribute: Model.AttributeModel): Boolean {
    if forms.attributes_assigned_after_making.contains("{attribute.owner}.{attribute.name}") {
        return false
    }
    crash high.layout
    var layout = high.layout
    if layout.is_back(attribute) or layout.is_lent(attribute) or layout.is_embedded(attribute) {
        return false
    }
    var rebuilder = layout.rebuilder_of(attribute)
    if rebuilder {
        return false
    }
    var attribute_type = attribute.attribute_type
    if attribute_type.is_nullable {
        return false
    }
    if attribute_type.kind == 'scalar' or attribute_type.kind == 'enumeration' {
        return true
    }
    return attribute_type.kind == 'object' and attribute_type.name != "String"
}

# ../../PROOFS.md#a-stage-registers-its-passes-only-in-its-setup
var no_model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_model)
var registers = List<String>()
var allowed = Dictionary<String, List<String>>()
var setup_keys = List<String>()
var owner_key = ""
var no_function = Model.FunctionModel("", "")
var no_body = HighIntermediaryRepresentation.Statements.Block()
var caller = HighIntermediaryRepresentation.HighFunction(no_function, no_body)
var line = 0
var listed_name = ""

func check(starting: HighIntermediaryRepresentation.HighProgram) {
    high = starting
    high.built_functions.each(note_a_register)
    assert not registers.is_empty()
    high.built_functions.each(check_a_function)
}

func note_a_register(function: HighIntermediaryRepresentation.HighFunction) {
    assert function.function.name == "register" and function.function.parameters.count() == 1
    var parameter = function.function.parameters[0]
    owner_key = function.function.owner
    assert parameter.parameter_type.kind == 'shape' and appends_its_parameter(function, parameter.name)
    assert is_walked_by_run()
    var key = function.function.key()
    registers.append(key)
    setup_keys = List<String>()
    var index = 0
    while index < high.built_functions.count() {
        var listed = high.built_functions[index]
        if listed.function.owner == owner_key and listed.function.is_constructor {
            note_a_setup_function(listed)
        }
        index = index + 1
    }
    allowed[key] = setup_keys
}

func appends_its_parameter(function: HighIntermediaryRepresentation.HighFunction, name: String): Boolean {
    var index = 0
    while index < function.body.statements.count() {
        var statement = function.body.statements[index]
        if statement == HighIntermediaryRepresentation.Statements.Evaluate and appends(statement.value, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func appends(value: HighIntermediaryRepresentation.Values.Value?, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.function.name == "append" and value.arguments.count() == 1 {
        var argument = value.arguments[0]
        var holder = owner_of(value)
        listed_name = listed_name_of(value)
        return holder == owner_key and argument == HighIntermediaryRepresentation.Values.LocalRead and argument.name == name
    }
    return false
}

func listed_name_of(call: HighIntermediaryRepresentation.Values.Call): String {
    var receiver = call.receiver
    if receiver == HighIntermediaryRepresentation.Values.AttributeRead {
        return receiver.attribute.name
    }
    return ""
}

func is_walked_by_run(): Boolean {
    var index = 0
    while index < high.built_functions.count() {
        var listed = high.built_functions[index]
        var is_the_run = listed.function.owner == owner_key and listed.function.name == "run"
        if is_the_run and walks_the_list(listed.body) {
            return true
        }
        index = index + 1
    }
    return false
}

func walks_the_list(body: HighIntermediaryRepresentation.Statements.Block): Boolean {
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement == HighIntermediaryRepresentation.Statements.While and counts_the_list(statement.condition) {
            return true
        }
        index = index + 1
    }
    return false
}

func counts_the_list(condition: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if condition == HighIntermediaryRepresentation.Values.MachineOperation {
        return is_the_count(condition.right)
    }
    return false
}

func is_the_count(value: HighIntermediaryRepresentation.Values.Value?): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.function.name == "count" {
        var counted = listed_name_of(value)
        return counted == listed_name
    }
    return false
}

func owner_of(call: HighIntermediaryRepresentation.Values.Call): String {
    var receiver = call.receiver
    if receiver == HighIntermediaryRepresentation.Values.AttributeRead {
        return receiver.attribute.owner
    }
    return ""
}

func note_a_setup_function(function: HighIntermediaryRepresentation.HighFunction) {
    var key = function.function.key()
    assert not setup_keys.contains(key)
    setup_keys.append(key)
    var index = 0
    while index < function.body.statements.count() {
        var statement = function.body.statements[index]
        if statement == HighIntermediaryRepresentation.Statements.Evaluate {
            follow_an_own_call(statement.value)
        }
        index = index + 1
    }
}

func follow_an_own_call(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value == HighIntermediaryRepresentation.Values.Call and value.function.owner == owner_key
    assert value.receiver == HighIntermediaryRepresentation.Values.ThisRead and value.arguments.is_empty()
    var key = value.function.key()
    var index = 0
    while index < high.built_functions.count() {
        var listed = high.built_functions[index]
        if listed.function.key() == key {
            note_a_setup_function(listed)
        }
        index = index + 1
    }
}

func check_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    caller = function
    check_a_block(function.body)
}

func check_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        check_a_statement(statement)
        index = index + 1
    }
}

func check_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Evaluate: check_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: check_both_branches(statement)
        HighIntermediaryRepresentation.Statements.While: check_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: check_a_block(statement)
        _: return
    }
}

func check_both_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    check_a_block(branch.then_branch)
    check_a_block(branch.else_branch)
}

func check_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    line = evaluated.line
    check_a_call(evaluated.value)
}

func check_a_call(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value == HighIntermediaryRepresentation.Values.Call
    var key = value.function.key()
    assert registers.contains(key)
    var setup = allowed[key]
    crash setup
    var caller_key = caller.function.key()
    assert not setup.contains(caller_key)
    refuse(value.function)
}

func refuse(register: Model.FunctionModel) {
    var stage = high.model.class_named(register.owner)
    crash stage
    var path = stage.file.path
    if caller.function.declaration and not caller.function.declaration.path.is_empty() {
        path = caller.function.declaration.path
    }
    var shown = simple_name_of(register.owner)
    var failure = Validators.Failure()
    failure.stop_inside(
        path,
        line,
        caller.function.owner,
        caller.function.name,
        "'{shown}.register' is called outside the setup of '{shown}': its passes are registered only in '{shown}()' and the functions only it calls, so the compiler knows them and its 'run' is direct calls in order: move this call there",
    )
}

func simple_name_of(owner: String): String {
    var segments = owner.split(".")
    var last = segments.last()
    crash last
    return last
}

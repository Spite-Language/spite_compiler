union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../PROOFS.md#a-list-its-setup-fills-holds-what-the-setup-made
var no_model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_model)
var reads = Dictionary<String, Integer>()
var writes = Dictionary<String, Integer>()
var shaped_names = List<String>()
var calls = Dictionary<String, Integer>()
var valued = List<String>()
var walks = List<HighIntermediaryRepresentation.SetupListWalk>()
var studied = Dictionary<String, Boolean>()
var made_lists = Dictionary<String, List<Model.Type>>()
var chain_calls = Dictionary<String, Integer>()
var chain_keys = List<String>()
var counted_keys = List<String>()
var adder = ""
var is_followed = true

func check(starting: HighIntermediaryRepresentation.HighProgram) {
    high = starting
    crash high.context
    assert not is_interactive(high.context.build_flags)
    high.built_functions.each(count_a_function)
    high.built_functions.each(find_the_walks)
    walks.each(record_a_walk)
}

func is_interactive(flags: Dictionary<String, String>): Boolean {
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func count_a_function(function: HighIntermediaryRepresentation.HighFunction) {
    var is_defaults = function.function.name == "_attribute_defaults"
    count_a_block(function.body, is_defaults)
}

func count_a_block(block: HighIntermediaryRepresentation.Statements.Block?, is_defaults: Boolean) {
    assert block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        count_a_statement(statement, is_defaults)
        index = index + 1
    }
}

func count_a_statement(statement: Statement, is_defaults: Boolean) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: count_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: count_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: count_an_attribute_write(statement, is_defaults)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: count_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: count_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.If: count_an_if(statement, is_defaults)
        HighIntermediaryRepresentation.Statements.While: count_a_while(statement, is_defaults)
        HighIntermediaryRepresentation.Statements.Return: count_a_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: count_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: count_a_block(statement, is_defaults)
    }
}

func count_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute, is_defaults: Boolean) {
    count_both(written.object, written.value)
    assert not is_defaults
    var key = "{written.attribute.owner}.{written.attribute.name}"
    var before = writes[key]
    var counted = 1
    if before {
        counted = before + 1
    }
    writes[key] = counted
}

func count_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    count_both(written.object, written.value)
    shaped_names.append(written.member)
}

func count_an_if(branch: HighIntermediaryRepresentation.Statements.If, is_defaults: Boolean) {
    count_both(branch.condition, branch.decided_condition)
    count_a_block(branch.then_branch, is_defaults)
    count_a_block(branch.else_branch, is_defaults)
}

func count_a_while(loop: HighIntermediaryRepresentation.Statements.While, is_defaults: Boolean) {
    count_a_value(loop.condition)
    count_a_block(loop.body, is_defaults)
}

func count_a_stop(stopped: HighIntermediaryRepresentation.Statements.Stop) {
    stopped.shown.each(count_a_present_value)
    count_a_value(stopped.then)
}

func count_both(first: Value?, second: Value?) {
    count_a_value(first)
    count_a_value(second)
}

func count_a_present_value(value: Value) {
    count_a_value(value)
}

func count_a_value(value: Value?) {
    assert value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: count_an_attribute_read(value)
        HighIntermediaryRepresentation.Values.Call: count_a_call(value)
        HighIntermediaryRepresentation.Values.Conversion: count_a_conversion(value)
        HighIntermediaryRepresentation.Values.EnumFromText: count_an_enum_from_text(value)
        HighIntermediaryRepresentation.Values.EnumText: count_an_enum_text(value)
        HighIntermediaryRepresentation.Values.ForeignCall: count_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.MachineOperation: count_an_operation(value)
        HighIntermediaryRepresentation.Values.MakeObject: count_a_made_object(value)
        HighIntermediaryRepresentation.Values.Negation: count_a_negation(value)
        HighIntermediaryRepresentation.Values.NumberRoom: count_a_number_room(value)
        HighIntermediaryRepresentation.Values.PresenceTest: count_a_presence_test(value)
        HighIntermediaryRepresentation.Values.ShapeCall: count_a_shape_call(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: count_a_class_of_value(value)
        HighIntermediaryRepresentation.Values.Class.Test: count_a_class_test(value)
        HighIntermediaryRepresentation.Values.Function.Value: count_a_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: count_a_value_call(value)
        _: return
    }
}

func count_a_declaration(declared: HighIntermediaryRepresentation.Statements.Declare) {
    count_a_value(declared.value)
}

func count_an_assignment(assigned: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    count_a_value(assigned.value)
}

func count_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    count_a_value(returned.value)
}

func count_a_presence_test(test: HighIntermediaryRepresentation.Values.PresenceTest) {
    count_a_value(test.tested)
}

func count_a_class_test(test: HighIntermediaryRepresentation.Values.Class.Test) {
    count_a_value(test.tested)
}

func count_an_enum_from_text(read: HighIntermediaryRepresentation.Values.EnumFromText) {
    count_a_value(read.text)
}

func count_an_enum_text(read: HighIntermediaryRepresentation.Values.EnumText) {
    count_a_value(read.number)
}

func count_a_negation(negation: HighIntermediaryRepresentation.Values.Negation) {
    count_a_value(negation.negated)
}

func count_a_class_of_value(asked: HighIntermediaryRepresentation.Values.Class.OfValue) {
    count_a_value(asked.described)
}

func count_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    count_a_value(conversion.converted)
}

func count_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    count_both(operation.left, operation.right)
}

func count_a_number_room(room: HighIntermediaryRepresentation.Values.NumberRoom) {
    count_both(room.made, room.number)
}

func count_a_made_object(made: HighIntermediaryRepresentation.Values.MakeObject) {
    made.arguments.each(count_a_present_value)
}

func count_an_attribute_read(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    count_a_value(read.object)
    var key = "{read.attribute.owner}.{read.attribute.name}"
    var before = reads[key]
    var counted = 1
    if before {
        counted = before + 1
    }
    reads[key] = counted
    crash read.object
    if read.object.value_type.kind != 'object' {
        shaped_names.append(read.attribute.name)
    }
}

func count_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    count_a_value(call.receiver)
    call.arguments.each(count_a_present_value)
    var key = call.function.key()
    var before = calls[key]
    var counted = 1
    if before {
        counted = before + 1
    }
    calls[key] = counted
}

func count_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    count_a_value(call.library)
    call.arguments.each(count_a_present_value)
}

func count_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    count_a_value(call.receiver)
    call.arguments.each(count_a_present_value)
}

func count_a_function_value(made: HighIntermediaryRepresentation.Values.Function.Value) {
    count_a_value(made.receiver)
    var key = made.function.key()
    valued.append(key)
}

func count_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    count_a_value(call.called)
    call.arguments.each(count_a_present_value)
}

func find_the_walks(function: HighIntermediaryRepresentation.HighFunction) {
    find_in_a_block(function.body, function.function.owner)
}

func find_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?, owner: String) {
    assert block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        find_in_a_statement(block, index, statement, owner)
        index = index + 1
    }
}

func find_in_a_statement(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
    statement: Statement,
    owner: String,
) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: find_in_an_if(statement, owner)
        HighIntermediaryRepresentation.Statements.While: find_in_a_while(block, index, statement, owner)
        HighIntermediaryRepresentation.Statements.Block: find_in_a_block(statement, owner)
        _: return
    }
}

func find_in_an_if(branch: HighIntermediaryRepresentation.Statements.If, owner: String) {
    find_in_a_block(branch.then_branch, owner)
    find_in_a_block(branch.else_branch, owner)
}

func find_in_a_while(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
    loop: HighIntermediaryRepresentation.Statements.While,
    owner: String,
) {
    find_in_a_block(loop.body, owner)
    assert index > 0
    var walk = walk_of(block, index, loop, owner)
    assert walk
    walks.append(walk)
}

func walk_of(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
    loop: HighIntermediaryRepresentation.Statements.While,
    owner: String,
): HighIntermediaryRepresentation.SetupListWalk? {
    var counter = counter_of(loop.condition, owner)
    assert not counter.is_empty() and loop.body.statements.count() == 3
    var before = block.statements[index - 1]
    crash before
    assert starts_at_zero(before, counter)
    var listed = bound_list_of(loop.condition)
    crash listed
    var walk = HighIntermediaryRepresentation.SetupListWalk(block, index, listed)
    walk.index_name = counter
    var first = loop.body.statements[0]
    var middle = loop.body.statements[1]
    var last = loop.body.statements[2]
    assert takes_the_item(first, walk, owner) and steps_the_counter(last, counter)
    assert calls_through_the_item(middle, walk)
    return walk
}

func counter_of(condition: Value?, owner: String): String {
    if condition == HighIntermediaryRepresentation.Values.MachineOperation and condition.operator == 'less' and reads_a_list_of(condition.right, owner, "count") {
        return local_name_of(condition.left)
    }
    return ""
}

func local_name_of(value: Value?): String {
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name
    }
    return ""
}

func bound_list_of(condition: Value?): Model.AttributeModel? {
    assert condition == HighIntermediaryRepresentation.Values.MachineOperation
    return list_attribute_of(condition.right)
}

func reads_a_list_of(value: Value?, owner: String, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.function.name == name and value.function.owner.starts_with("List_of_") {
        return reads_an_own_attribute(value.receiver, owner)
    }
    return false
}

func reads_an_own_attribute(value: Value?, owner: String): Boolean {
    return value == HighIntermediaryRepresentation.Values.AttributeRead and value.attribute.owner == owner and value.object == HighIntermediaryRepresentation.Values.ThisRead
}

func list_attribute_of(value: Value?): Model.AttributeModel? {
    assert value == HighIntermediaryRepresentation.Values.Call
    return attribute_of(value.receiver)
}

func attribute_of(value: Value?): Model.AttributeModel? {
    assert value == HighIntermediaryRepresentation.Values.AttributeRead
    return value.attribute
}

func starts_at_zero(statement: Statement, name: String): Boolean {
    if statement == HighIntermediaryRepresentation.Statements.Declare and statement.name == name {
        return is_zero(statement.value)
    }
    if statement == HighIntermediaryRepresentation.Statements.Assign.Assign and statement.name == name {
        return is_zero(statement.value)
    }
    return false
}

func is_zero(value: Value?): Boolean {
    return value == HighIntermediaryRepresentation.Values.WholeNumber and value.number == 0
}

func is_one(value: Value?): Boolean {
    return value == HighIntermediaryRepresentation.Values.WholeNumber and value.number == 1
}

func takes_the_item(
    statement: Statement,
    walk: HighIntermediaryRepresentation.SetupListWalk,
    owner: String,
): Boolean {
    if statement == HighIntermediaryRepresentation.Statements.Declare {
        walk.item_name = statement.name
        return reads_the_item(statement.value, walk, owner)
    }
    return false
}

func reads_the_item(
    value: Value?,
    walk: HighIntermediaryRepresentation.SetupListWalk,
    owner: String,
): Boolean {
    if value == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'proven' and reads_a_list_of(value.converted, owner, "get_at") {
        return reads_the_same_list(value.converted, walk) and reads_the_counter(value.converted, walk.index_name)
    }
    return false
}

func reads_the_same_list(value: Value?, walk: HighIntermediaryRepresentation.SetupListWalk): Boolean {
    var listed = list_attribute_of(value)
    crash listed
    return listed.name == walk.attribute.name and listed.owner == walk.attribute.owner
}

func reads_the_counter(value: Value?, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.arguments.count() == 1 {
        var argument = value.arguments[0]
        return argument == HighIntermediaryRepresentation.Values.LocalRead and argument.name == name
    }
    return false
}

func steps_the_counter(statement: Statement, name: String): Boolean {
    return statement == HighIntermediaryRepresentation.Statements.Assign.Assign and statement.name == name and adds_one_to(statement.value, name)
}

func adds_one_to(value: Value?, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.MachineOperation and value.operator == 'add' {
        var read = local_name_of(value.left)
        return read == name and is_one(value.right)
    }
    return false
}

func calls_through_the_item(
    statement: Statement,
    walk: HighIntermediaryRepresentation.SetupListWalk,
): Boolean {
    return statement == HighIntermediaryRepresentation.Statements.Evaluate and not statement.waited and is_a_call_through(statement.value, walk)
}

func is_a_call_through(value: Value?, walk: HighIntermediaryRepresentation.SetupListWalk): Boolean {
    if value == HighIntermediaryRepresentation.Values.ShapeCall {
        return is_a_shape_call_through(value, walk)
    }
    return false
}

func is_a_shape_call_through(value: HighIntermediaryRepresentation.Values.ShapeCall, walk: HighIntermediaryRepresentation.SetupListWalk): Boolean {
    var receiver = local_name_of(value.receiver)
    var is_plain = receiver == walk.item_name
    var index = 0
    while index < value.arguments.count() {
        var argument = value.arguments[index]
        var name = local_name_of(argument)
        if name.is_empty() or name == walk.index_name or name == walk.item_name {
            is_plain = false
        }
        index = index + 1
    }
    return is_plain
}

func record_a_walk(walk: HighIntermediaryRepresentation.SetupListWalk) {
    var key = "{walk.attribute.owner}.{walk.attribute.name}"
    var made = made_by_the_setup(walk.attribute)
    assert made
    var loops = 0
    var index = 0
    while index < walks.count() {
        var other = walks[index]
        if other.attribute.owner == walk.attribute.owner and other.attribute.name == walk.attribute.name {
            loops = loops + 1
        }
        index = index + 1
    }
    var read_count = reads[key]
    crash read_count
    assert read_count == 1 + 2 * loops and not writes.contains(key) and not shaped_names.contains(walk.attribute.name)
    walk.made = made
    high.setup_list_walks.append(walk)
}

func made_by_the_setup(attribute: Model.AttributeModel): List<Model.Type>? {
    var key = "{attribute.owner}.{attribute.name}"
    if studied.contains(key) {
        return made_lists[key]
    }
    studied[key] = true
    var made = follow_the_setup(attribute)
    if made {
        made_lists[key] = made
    }
    return made
}

func follow_the_setup(attribute: Model.AttributeModel): List<Model.Type>? {
    adder = adder_of(attribute)
    assert not adder.is_empty()
    var setup = setup_of(attribute.owner)
    assert setup
    chain_calls = Dictionary<String, Integer>()
    chain_keys = List<String>()
    counted_keys = List<String>()
    is_followed = true
    var made = List<Model.Type>()
    follow_a_function(setup, made)
    assert is_followed and is_called_only_by_the_setup(setup)
    return made
}

func adder_of(attribute: Model.AttributeModel): String {
    var found = ""
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.owner == attribute.owner and adds_to(function, attribute) {
            found = function.function.key()
        }
        index = index + 1
    }
    return found
}

func adds_to(function: HighIntermediaryRepresentation.HighFunction, attribute: Model.AttributeModel): Boolean {
    if function.function.parameters.count() != 1 {
        return false
    }
    var parameter = function.function.parameters[0]
    var index = 0
    while index < function.body.statements.count() {
        var statement = function.body.statements[index]
        if appends_the_parameter(statement, attribute, parameter.name) {
            return true
        }
        index = index + 1
    }
    return false
}

func appends_the_parameter(
    statement: Statement,
    attribute: Model.AttributeModel,
    name: String,
): Boolean {
    return statement == HighIntermediaryRepresentation.Statements.Evaluate and is_an_append_of(statement.value, attribute, name)
}

func is_an_append_of(value: Value?, attribute: Model.AttributeModel, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.arguments.count() == 1 and reads_a_list_of(value, attribute.owner, "append") {
        var argument = value.arguments[0]
        var appended = local_name_of(argument)
        return appended == name and names_the_attribute(value, attribute)
    }
    return false
}

func names_the_attribute(value: Value?, attribute: Model.AttributeModel): Boolean {
    var listed = list_attribute_of(value)
    crash listed
    return listed.name == attribute.name
}

func setup_of(owner: String): HighIntermediaryRepresentation.HighFunction? {
    var found: HighIntermediaryRepresentation.HighFunction? = null
    var count = 0
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.owner == owner and function.function.is_constructor {
            found = function
            count = count + 1
        }
        index = index + 1
    }
    assert count == 1
    return found
}

func function_keyed(key: String): HighIntermediaryRepresentation.HighFunction? {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        if function.function.key() == key {
            return function
        }
        index = index + 1
    }
    return null
}

func follow_a_function(function: HighIntermediaryRepresentation.HighFunction, made: List<Model.Type>) {
    var key = function.function.key()
    if chain_keys.contains(key) or valued.contains(key) {
        is_followed = false
        return
    }
    chain_keys.append(key)
    var counts_its_calls = not counted_keys.contains(key)
    if counts_its_calls {
        counted_keys.append(key)
    }
    var locals = Dictionary<String, Model.Type>()
    var index = 0
    while index < function.body.statements.count() and is_followed {
        var statement = function.body.statements[index]
        follow_a_statement(function.function.owner, statement, locals, made, counts_its_calls)
        index = index + 1
    }
    crash chain_keys.remove_last()
}

func follow_a_statement(
    owner: String,
    statement: Statement,
    locals: Dictionary<String, Model.Type>,
    made: List<Model.Type>,
    counts_its_calls: Boolean,
) {
    if statement == HighIntermediaryRepresentation.Statements.Declare {
        note_a_made_local(statement, locals)
        return
    }
    if statement == HighIntermediaryRepresentation.Statements.Evaluate and not statement.waited {
        follow_a_call(owner, statement.value, locals, made, counts_its_calls)
        return
    }
    is_followed = false
}

func note_a_made_local(declared: HighIntermediaryRepresentation.Statements.Declare, locals: Dictionary<String, Model.Type>) {
    var made = class_made_by(declared.value)
    if not made {
        is_followed = false
        return
    }
    locals[declared.name] = made
}

func class_made_by(value: Value?): Model.Type? {
    assert value == HighIntermediaryRepresentation.Values.MakeObject and value.value_type.kind == 'object' and not value.value_type.is_nullable
    var model = high.model.class_named(value.value_type.name)
    assert model
    return value.value_type
}

func follow_a_call(
    owner: String,
    value: Value?,
    locals: Dictionary<String, Model.Type>,
    made: List<Model.Type>,
    counts_its_calls: Boolean,
) {
    if value == HighIntermediaryRepresentation.Values.Call {
        follow_an_own_call(owner, value, locals, made, counts_its_calls)
    } else {
        is_followed = false
    }
}

func follow_an_own_call(
    owner: String,
    call: HighIntermediaryRepresentation.Values.Call,
    locals: Dictionary<String, Model.Type>,
    made: List<Model.Type>,
    counts_its_calls: Boolean,
) {
    if call.function.owner != owner or call.receiver != HighIntermediaryRepresentation.Values.ThisRead {
        is_followed = false
        return
    }
    var key = call.function.key()
    if counts_its_calls {
        note_a_chain_call(key)
    }
    if key == adder {
        add_the_made(call, locals, made)
        return
    }
    var called = function_keyed(key)
    if not called or not call.arguments.is_empty() or called.function.is_constructor {
        is_followed = false
        return
    }
    follow_a_function(called, made)
}

func note_a_chain_call(key: String) {
    var before = chain_calls[key]
    var counted = 1
    if before {
        counted = before + 1
    }
    chain_calls[key] = counted
}

func add_the_made(
    call: HighIntermediaryRepresentation.Values.Call,
    locals: Dictionary<String, Model.Type>,
    made: List<Model.Type>,
) {
    var argument = call.arguments[0]
    crash argument
    var name = handed_name_of(argument)
    var known = locals[name]
    if not known {
        is_followed = false
        return
    }
    made.append(known)
}

func handed_name_of(value: Value): String {
    if value == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'into_shape' {
        return local_name_of(value.converted)
    }
    return local_name_of(value)
}

func is_called_only_by_the_setup(setup: HighIntermediaryRepresentation.HighFunction): Boolean {
    if valued.contains(adder) {
        return false
    }
    var is_only = true
    var keys = chain_calls.keys()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        var in_the_chain = chain_calls[key]
        var everywhere = calls[key]
        if in_the_chain != everywhere {
            is_only = false
        }
        index = index + 1
    }
    var setup_key = setup.function.key()
    return is_only and chain_calls.contains(adder) and not chain_calls.contains(setup_key)
}

# ../../PROOFS.md#a-test-a-dominating-test-already-made-is-answered
var function = LowIntermediaryRepresentation.LowFunction("", 0)
var operands = LowOptimizationPasses.Operands()
var flow = LowOptimizationPasses.Flow()
var definitions = List<Integer>()
var defining_blocks = List<Integer>()
var order = List<Integer>()
var order_of = List<Integer>()
var dominators = List<Integer>()
var fact_keys = List<String>()
var fact_values = List<Boolean>()
var largest_function = 2000

var facts = LowIntermediaryRepresentation.ProvenTests()
var answered = 0
var compare_index = -1

func Study(starting_function: LowIntermediaryRepresentation.LowFunction) {
    function = starting_function
}

func record_the_answers() {
    var count = function.blocks.count()
    fallback not function.is_resumable and count >= 3 and count <= largest_function
    flow.find_the_edges(function)
    count_the_definitions()
    number_in_order()
    find_the_dominators()
    fallback not dominators.is_empty()
    find_the_facts()
    var known = function.proven_tests
    if known {
        facts = known
    }
    var block_index = 0
    while block_index < count {
        decide_the_branch(block_index)
        block_index = block_index + 1
    }
    if answered > 0 {
        function.proven_tests = facts
    }
}

func count_the_definitions() {
    var register_total = operands.most_register_of(function)
    var index = 0
    while index < register_total {
        var implicit = 0
        if index < function.parameter_count {
            implicit = 1
        }
        definitions.append(implicit)
        defining_blocks.append(0)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var instruction_index = 0
        while instruction_index < block.instructions.count() {
            var instruction = block.instructions[instruction_index]
            operands.read(instruction)
            note_the_defines(block_index)
            instruction_index = instruction_index + 1
        }
        block_index = block_index + 1
    }
}

func note_the_defines(block_index: Integer) {
    var index = 0
    while index < operands.defines.count() {
        var defined = operands.defines[index]
        crash defined
        var count = definitions[defined]
        crash count
        definitions[defined] = count + 1
        defining_blocks[defined] = block_index
        index = index + 1
    }
}

func is_stable(register: Integer): Boolean {
    fallback register >= 0 and register < definitions.count()
    return definitions[register] == 1
}

func number_in_order() {
    var count = function.blocks.count()
    var visited = List<Boolean>()
    var index = 0
    while index < count {
        visited.append(false)
        order_of.append(-1)
        index = index + 1
    }
    var finished = List<Integer>()
    var waiting = List<Integer>()
    var next_child = List<Integer>()
    waiting.append(0)
    next_child.append(0)
    visited[0] = true
    while not waiting.is_empty() {
        var top = waiting.count() - 1
        var block = waiting[top]
        var child = next_child[top]
        crash block
        crash child
        var leaving = flow.successors[block]
        crash leaving
        if child < leaving.count() {
            next_child[top] = child + 1
            var successor = leaving[child]
            crash successor
            visit(successor, visited, waiting, next_child)
        } else {
            finished.append(block)
            crash waiting.remove_last()
            crash next_child.remove_last()
        }
    }
    index = finished.count() - 1
    while index >= 0 {
        var block = finished[index]
        crash block
        order_of[block] = order.count()
        order.append(block)
        index = index - 1
    }
}

func visit(successor: Integer, visited: List<Boolean>, waiting: List<Integer>, next_child: List<Integer>) {
    fallback visited[successor] != true
    visited[successor] = true
    waiting.append(successor)
    next_child.append(0)
}

func find_the_dominators() {
    var count = function.blocks.count()
    var index = 0
    while index < count {
        dominators.append(-1)
        index = index + 1
    }
    dominators[0] = 0
    var changed = true
    var round = 0
    while changed and round < 64 {
        changed = false
        var position = 1
        while position < order.count() {
            var block = order[position]
            crash block
            var found = meet_of_the_predecessors(block)
            if found >= 0 and dominators[block] != found {
                dominators[block] = found
                changed = true
            }
            position = position + 1
        }
        round = round + 1
    }
    if changed {
        dominators.clear()
    }
}

func meet_of_the_predecessors(block: Integer): Integer {
    var found = -1
    var coming = flow.predecessors_of(block)
    var index = 0
    while index < coming.count() {
        var predecessor = coming[index]
        crash predecessor
        var known = dominators[predecessor]
        crash known
        if known >= 0 and found < 0 {
            found = predecessor
        } else if known >= 0 {
            found = intersected(found, predecessor)
        }
        index = index + 1
    }
    return found
}

func intersected(first: Integer, second: Integer): Integer {
    var left = first
    var right = second
    while left != right {
        var left_order = order_of[left]
        var right_order = order_of[right]
        crash left_order
        crash right_order
        if left_order > right_order {
            var up = dominators[left]
            crash up
            left = up
        } else {
            var up = dominators[right]
            crash up
            right = up
        }
    }
    return left
}

func dominates(above: Integer, below: Integer): Boolean {
    var block = below
    while block != above {
        fallback block != 0
        var up = dominators[block]
        crash up
        crash up >= 0
        block = up
    }
    return true
}

func find_the_facts() {
    var count = function.blocks.count()
    var index = 0
    while index < count {
        fact_keys.append("")
        fact_values.append(false)
        index = index + 1
    }
    var block_index = 1
    while block_index < count {
        note_a_fact(block_index)
        block_index = block_index + 1
    }
}

func note_a_fact(block_index: Integer) {
    var coming = flow.predecessors_of(block_index)
    fallback coming.count() == 1 and dominators[block_index] != -1
    var only = coming[0]
    crash only
    fallback only != block_index
    var branch = branch_of(only)
    fallback branch
    var compare = compare_of(branch.condition, only)
    fallback compare
    var key = key_of(compare, only, false)
    fallback not key.is_empty()
    fact_keys[block_index] = key
    fact_values[block_index] = branch.when_true == block_index
}

func branch_of(block_index: Integer): LowIntermediaryRepresentation.Instructions.Branch? {
    var block = function.blocks[block_index]
    crash block
    var last = block.instructions.last()
    fallback last
    fallback last.class == LowIntermediaryRepresentation.Instructions.Branch
    fallback last.when_true != last.when_false
    return last
}

func decide_the_branch(block_index: Integer) {
    fallback dominators[block_index] != -1
    var branch = branch_of(block_index)
    fallback branch
    var compare = compare_of(branch.condition, block_index)
    fallback compare
    var at = compare_index
    var holder = block_index
    while holder != 0 {
        var fact = fact_keys[holder]
        crash fact
        var tested = dominators[holder]
        crash tested
        if not fact.is_empty() {
            var value = fact_values[holder] == true
            if fact == key_of(compare, tested, false) {
                answer(block_index, at, value)
                return
            }
            if fact == key_of(compare, tested, true) {
                answer(block_index, at, not value)
                return
            }
        }
        holder = tested
    }
}

func answer(block_index: Integer, at: Integer, value: Boolean) {
    fallback not facts.is_decided(block_index, at)
    var number: Long = 0
    if value {
        number = 1
    }
    facts.decide(block_index, at, number)
    answered = answered + 1
}

func compare_of(condition: Integer, branch_block: Integer): LowIntermediaryRepresentation.Instructions.Compare? {
    fallback is_stable(condition)
    var made_in = defining_blocks[condition]
    crash made_in
    fallback made_in == branch_block
    var block = function.blocks[branch_block]
    crash block
    var index = 0
    while index < block.instructions.count() {
        var instruction = block.instructions[index]
        if instruction.class == LowIntermediaryRepresentation.Instructions.Compare and instruction.target == condition {
            compare_index = index
            return instruction
        }
        index = index + 1
    }
    return null
}

func key_of(compare: LowIntermediaryRepresentation.Instructions.Compare, tested_block: Integer, inverted: Boolean): String {
    fallback settled_before(compare.left, tested_block) and settled_before(compare.right, tested_block)
    var comparison = compare.comparison
    if inverted {
        comparison = opposite_of(compare.comparison)
    }
    return "{comparison} {compare.is_signed} r{compare.left} r{compare.right}"
}

func opposite_of(comparison: LowIntermediaryRepresentation.Instructions.Compare.Comparison): LowIntermediaryRepresentation.Instructions.Compare.Comparison {
    switch comparison {
        'equal': return 'not_equal'
        'not_equal': return 'equal'
        'less': return 'greater_or_equal'
        'greater_or_equal': return 'less'
        'greater': return 'less_or_equal'
        'less_or_equal': return 'greater'
    }
}

func settled_before(register: Integer, tested_block: Integer): Boolean {
    fallback is_stable(register)
    if register < function.parameter_count {
        return true
    }
    var made_in = defining_blocks[register]
    crash made_in
    return dominates(made_in, tested_block)
}

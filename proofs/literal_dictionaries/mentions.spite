union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Membership
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../PROOFS.md#a-dictionary-only-read-by-literal-keys-is-never-made
var folding = Proofs.LiteralDictionaries.LiteralDictionaries()
var named = 0
var reads = 0
var missed = 0
var made_reads = 0
var declared = 0
var written = 0

func Mentions(starting_folding: Proofs.LiteralDictionaries.LiteralDictionaries) {
    folding = starting_folding
}

func count_in(body: HighIntermediaryRepresentation.Statements.Block) {
    count_names_in(body)
    var rewriting = HighOptimizationPasses.Rewriting(this)
    rewriting.rewrite_block(body)
}

func count_names_in(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(count_names_of)
}

func count_names_of(statement: Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: count_a_declaration(statement.name)
        HighIntermediaryRepresentation.Statements.Assign.Assign: count_a_write(statement.name)
        HighIntermediaryRepresentation.Statements.If: count_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: count_names_in(statement.body)
        HighIntermediaryRepresentation.Statements.Block: count_names_in(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

func count_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    count_names_in(branch.then_branch)
    count_names_in(branch.else_branch)
}

func count_a_declaration(name: String) {
    fallback name == folding.dictionary_name
    declared = declared + 1
}

func count_a_write(name: String) {
    fallback name == folding.dictionary_name or name == folding.made_name
    written = written + 1
}

func rewritten(value: Value): Value {
    count_a_mention(value)
    return value
}

func count_a_mention(value: Value) {
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: count_a_local(value.name)
        HighIntermediaryRepresentation.Values.Call: count_a_call(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.AttributeRead: return
        HighIntermediaryRepresentation.Values.MakeObject: return
        HighIntermediaryRepresentation.Values.MachineOperation: return
        HighIntermediaryRepresentation.Values.Negation: return
        HighIntermediaryRepresentation.Values.ForeignCall: return
        HighIntermediaryRepresentation.Values.Class.Membership: return
        HighIntermediaryRepresentation.Values.PresenceTest: return
        HighIntermediaryRepresentation.Values.Conversion: return
        HighIntermediaryRepresentation.Values.Function.Value: return
        HighIntermediaryRepresentation.Values.Function.ValueCall: return
        HighIntermediaryRepresentation.Values.NumberRoom: return
        HighIntermediaryRepresentation.Values.ShapeCall: return
        HighIntermediaryRepresentation.Values.EnumText: return
        HighIntermediaryRepresentation.Values.EnumFromText: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Class.OfValue: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func count_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    fallback folding.is_a_folded_read(call)
    count_a_read(call)
}

func count_a_local(name: String) {
    if name == folding.dictionary_name {
        named = named + 1
    }
    fallback name == folding.made_name
    made_reads = made_reads + 1
}

func count_a_read(call: HighIntermediaryRepresentation.Values.Call) {
    var position = folding.asked_position(call)
    if position >= 0 {
        reads = reads + 1
    } else {
        missed = missed + 1
    }
}

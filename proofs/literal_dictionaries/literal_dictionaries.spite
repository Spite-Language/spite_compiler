union Statement {
    HighIntermediaryRepresentation.Statements.Declare
    HighIntermediaryRepresentation.Statements.Assign.Assign
    HighIntermediaryRepresentation.Statements.Assign.Attribute
    HighIntermediaryRepresentation.Statements.Assign.ThroughShape
    HighIntermediaryRepresentation.Statements.Evaluate
    HighIntermediaryRepresentation.Statements.If
    HighIntermediaryRepresentation.Statements.While
    HighIntermediaryRepresentation.Statements.Return
    HighIntermediaryRepresentation.Statements.Stop
    HighIntermediaryRepresentation.Statements.Block
}

union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../PROOFS.md#a-dictionary-only-read-by-literal-keys-is-never-made
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var library = Validators.LibraryFile()
var no_function = Model.FunctionModel("", "")
var no_body = HighIntermediaryRepresentation.Statements.Block()
var current = HighIntermediaryRepresentation.HighFunction(no_function, no_body)
var made_name = ""
var dictionary_name = ""
var dictionary_key = ""
var keys = List<Value>()
var entries = List<Value>()
var setter = Model.FunctionModel("", "")
var constructor: Model.FunctionModel? = null
var missed = 0

func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    program = high
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        current = function
        find_in_block(function.body)
        index = index + 1
    }
}

func find_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        if is_written_out_at(block, index) {
            record()
        }
        var statement = block.statements[index]
        find_inside(statement)
        index = index + 1
    }
}

func find_inside(statement: Statement?) {
    switch statement {
        HighIntermediaryRepresentation.Statements.If: find_in_branches(statement)
        HighIntermediaryRepresentation.Statements.While: find_in_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: find_in_block(statement)
        _: return
    }
}

func find_in_branches(branch: HighIntermediaryRepresentation.Statements.If) {
    find_in_block(branch.then_branch)
    find_in_block(branch.else_branch)
}

func is_written_out_at(block: HighIntermediaryRepresentation.Statements.Block, index: Integer): Boolean {
    var made = block.statements[index]
    if made == HighIntermediaryRepresentation.Statements.Declare {
        return folds_from(block, index, made)
    }
    return false
}

func folds_from(
    block: HighIntermediaryRepresentation.Statements.Block,
    index: Integer,
    made: HighIntermediaryRepresentation.Statements.Declare,
): Boolean {
    var making = made.value
    if making == HighIntermediaryRepresentation.Values.MakeObject and is_a_dictionary(making.value_type) {
        made_name = made.name
        dictionary_key = making.value_type.name
        constructor = making.constructor
        return is_written_out(block, index)
    }
    return false
}

func record() {
    var function_key = current.function.key()
    var written = HighIntermediaryRepresentation.LiteralDictionary(function_key, made_name, dictionary_name)
    written.dictionary_key = dictionary_key
    written.keys = keys
    written.entries = entries
    written.setter = setter
    written.constructor = constructor
    written.missed = missed
    program.literal_dictionaries.append(written)
    fallback missed > 0
    var marking = HighOptimizationPasses.Rewriting(this)
    marking.rewrite_block(current.body)
}

func rewritten(value: Value): Value {
    if value == HighIntermediaryRepresentation.Values.Call and is_a_folded_read(value) {
        mark_a_missing_key(value)
    }
    return value
}

func mark_a_missing_key(call: HighIntermediaryRepresentation.Values.Call) {
    var position = asked_position(call)
    fallback position < 0
    var asked = call.arguments[0]
    crash asked
    var shown = key_shown(asked)
    call.missing_key = "the dictionary written out as '{dictionary_name}' holds no key {shown}"
}

func key_shown(key: Value): String {
    switch key {
        HighIntermediaryRepresentation.Values.TextConstant: return text_key_shown(key)
        HighIntermediaryRepresentation.Values.WholeNumber: return number_key_shown(key)
        _: return "written out"
    }
}

func text_key_shown(key: HighIntermediaryRepresentation.Values.TextConstant): String {
    return "'{key.text}'"
}

func number_key_shown(key: HighIntermediaryRepresentation.Values.WholeNumber): String {
    return key.number
}

func is_a_dictionary(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'object' and not of_type.is_nullable
    var model = context.program.class_named(of_type.name)
    fallback model
    return model.file.namespace == "Dictionary" and library.holds(model.file.path)
}

func is_written_out(block: HighIntermediaryRepresentation.Statements.Block, index: Integer): Boolean {
    keys = List<Value>()
    entries = List<Value>()
    var position = index + 1
    var stored = true
    while stored and position < block.statements.count() {
        var statement = block.statements[position]
        stored = stores_an_entry(statement)
        if stored {
            position = position + 1
        }
    }
    fallback not keys.is_empty() and position < block.statements.count()
    var naming = block.statements[position]
    return names_the_dictionary(naming) and is_only_read_by_its_keys()
}

func stores_an_entry(statement: Statement?): Boolean {
    if statement == HighIntermediaryRepresentation.Statements.Evaluate and not statement.waited {
        return stores_by_a_call(statement.value)
    }
    return false
}

func stores_by_a_call(value: Value?): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.function.name == "set_at" {
        return stores_constants(value)
    }
    return false
}

func stores_constants(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var receiver = call.receiver
    var is_the_made = receiver == HighIntermediaryRepresentation.Values.LocalRead and receiver.name == made_name
    fallback is_the_made and call.function.owner == dictionary_key and call.arguments.count() == 2
    var key = call.arguments[0]
    var entry = call.arguments[1]
    fallback is_a_key(key) and is_an_entry(entry) and not holds_the_key(key)
    keys.append(key)
    entries.append(entry)
    setter = call.function
    return true
}

func is_a_key(value: Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        _: return false
    }
}

func is_an_entry(value: Value): Boolean {
    switch value {
        HighIntermediaryRepresentation.Values.TextConstant: return true
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.DecimalNumber: return true
        _: return false
    }
}

func holds_the_key(key: Value): Boolean {
    var index = position_of(key)
    return index >= 0
}

func position_of(key: Value): Integer {
    var index = 0
    while index < keys.count() {
        var known = keys[index]
        if is_the_same_key(known, key) {
            return index
        }
        index = index + 1
    }
    return -1
}

func is_the_same_key(
    known: Value,
    asked: Value,
): Boolean {
    if known == HighIntermediaryRepresentation.Values.TextConstant {
        return is_the_same_text(known, asked)
    }
    if known == HighIntermediaryRepresentation.Values.WholeNumber {
        return is_the_same_number(known, asked)
    }
    return false
}

func is_the_same_text(
    known: HighIntermediaryRepresentation.Values.TextConstant,
    asked: Value,
): Boolean {
    if asked == HighIntermediaryRepresentation.Values.TextConstant {
        return known.text == asked.text
    }
    return false
}

func is_the_same_number(
    known: HighIntermediaryRepresentation.Values.WholeNumber,
    asked: Value,
): Boolean {
    if asked == HighIntermediaryRepresentation.Values.WholeNumber {
        return known.number == asked.number
    }
    return false
}

func names_the_dictionary(statement: Statement?): Boolean {
    if statement == HighIntermediaryRepresentation.Statements.Declare {
        return names_the_made(statement)
    }
    return false
}

func names_the_made(declared: HighIntermediaryRepresentation.Statements.Declare): Boolean {
    var value = declared.value
    if value == HighIntermediaryRepresentation.Values.LocalRead and value.name == made_name {
        dictionary_name = declared.name
        return true
    }
    return false
}

func is_only_read_by_its_keys(): Boolean {
    var mentions = Proofs.LiteralDictionaries.Mentions(this)
    mentions.count_in(current.body)
    missed = mentions.missed
    var made_reads = keys.count() + 1
    var only_reads = mentions.named == mentions.reads + mentions.missed
    return only_reads and mentions.made_reads == made_reads and mentions.declared == 1 and mentions.written == 0
}

func is_a_folded_read(value: Value): Boolean {
    if value == HighIntermediaryRepresentation.Values.Call and value.function.name == "get_at" {
        return reads_by_a_key(value)
    }
    return false
}

func reads_by_a_key(call: HighIntermediaryRepresentation.Values.Call): Boolean {
    var receiver = call.receiver
    var is_the_dictionary = receiver == HighIntermediaryRepresentation.Values.LocalRead
    is_the_dictionary = is_the_dictionary and is_named(receiver, dictionary_name)
    fallback is_the_dictionary and call.function.owner == dictionary_key and call.arguments.count() == 1
    return call.value_type.is_nullable
}

func is_named(value: Value?, name: String): Boolean {
    if value == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name == name
    }
    return false
}

func asked_position(call: HighIntermediaryRepresentation.Values.Call): Integer {
    var asked = call.arguments[0]
    crash asked
    return position_of(asked)
}

# ../../PROOFS.md#whether-a-class-fits-a-vector

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var values = HighIntermediaryRepresentation.Building.Values(context)
var constraints = HighIntermediaryRepresentation.Building.Constraints(context, values)
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var made = Model.ClassModel("", "", no_file, false)

func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    values = HighIntermediaryRepresentation.Building.Values(context)
    constraints = HighIntermediaryRepresentation.Building.Constraints(context, values)
    context.vector_sites.each(check_a_site)
}

func check_a_site(site: HighIntermediaryRepresentation.Building.VectorSite) {
    context.current_class = site.owner
    context.current_function = site.function
    context.line = site.line
    made = site.made
    var element = made.bound_types["$element_type"]
    fallback element
    fallback element.kind == 'object' and not element.is_nullable and element.name != "String"
    fallback context.has_a_class(element)
    var held = context.class_of(element)
    var rule = Validators.HighIntermediaryRepresentation.VectorFit.Validator()
    var rule_answer = rule.check_a_held_collection(context, element, held)
    context.tell(rule_answer)
    rule_answer = rule.check_a_dropped_item(context, element, held)
    context.tell(rule_answer)
    var escaping = constraints.function_using_this_as_a_value(held)
    rule_answer = rule.check_this_as_a_value(context, element, escaping)
    context.tell(rule_answer)
    var index = 0
    while index < held.declared_attributes.count() {
        var attribute = held.declared_attributes[index]
        rule_answer = rule.check_an_item(context, element, attribute, constraints)
        context.tell(rule_answer)
        index = index + 1
    }
}

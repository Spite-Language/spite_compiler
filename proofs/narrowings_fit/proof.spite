var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    high.narrowing_sites.each(check_a_site)
}

func check_a_site(site: HighIntermediaryRepresentation.NarrowingSite) {
    var owner = context.program.class_named(site.function.function.owner)
    fallback owner
    context.current_class = owner
    context.current_function = site.function.function
    var rule = Validators.HighIntermediaryRepresentation.NarrowingFit.Validator()
    var rule_answer = rule.check(context, site)
    context.tell(rule_answer)
}

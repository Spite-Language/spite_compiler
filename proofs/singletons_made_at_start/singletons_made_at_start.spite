union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

# ../../PROOFS.md#a-singleton-made-at-the-start-is-never-tested-again
var program = LowIntermediaryRepresentation.LoweredProgram()
var indexes = Dictionary<String, Integer>()
var before = List<String>()
var waiting = List<String>()
var flow = LowOptimizationPasses.Flow()
var tests = LowOptimizationPasses.SingletonTests()

func proved(low: LowIntermediaryRepresentation.LoweredProgram) {
    program = low
    find_the_made()
}

func find_the_made() {
    var index = 0
    while index < program.lowered_functions.count() {
        var found = program.lowered_functions[index]
        indexes[found.key] = index
        index = index + 1
    }
    fallback indexes.contains("_start")
    var starting = indexes["_start"]
    crash starting
    var start = program.lowered_functions[starting]
    crash start
    var defaults_key = defaults_called_by(start)
    fallback not defaults_key.is_empty()
    add_a_root("_fault_handler")
    var key_index = 0
    while key_index < program.lowered_functions.count() {
        var listed = program.lowered_functions[key_index]
        if listed.key.starts_with("_destroy_") {
            add_a_root(listed.key)
        }
        key_index = key_index + 1
    }
    follow_the_roots()
    var defaults_index = indexes[defaults_key]
    crash defaults_index
    var defaults = program.lowered_functions[defaults_index]
    crash defaults
    program.runs_before_the_entry = before
    program.made_at_start = made_by(defaults)
}

func defaults_called_by(start: LowIntermediaryRepresentation.LowFunction): String {
    var block_index = 0
    while block_index < start.blocks.count() {
        var block = start.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction == LowIntermediaryRepresentation.Instructions.Call {
                add_a_root(instruction.function)
                if instruction.function.ends_with("._attribute_defaults") {
                    return instruction.function
                }
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return ""
}

func add_a_root(key: String) {
    fallback not before.contains(key) and indexes.contains(key)
    before.append(key)
    waiting.append(key)
}

func follow_the_roots() {
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        var found = indexes[key]
        crash found
        var reached = program.lowered_functions[found]
        crash reached
        reached.blocks.each(follow_a_block)
    }
}

func follow_a_block(block: LowIntermediaryRepresentation.LowBlock) {
    block.instructions.each(follow_an_instruction)
}

func follow_an_instruction(instruction: Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Call: add_a_root(instruction.function)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: add_a_root(instruction.function)
        _: return
    }
}

func made_by(defaults: LowIntermediaryRepresentation.LowFunction): List<Integer> {
    var made = List<Integer>()
    flow.find_the_edges(defaults)
    var block_index = 0
    while block_index < defaults.blocks.count() {
        var block = defaults.blocks[block_index]
        var label = tests.tested_label(defaults, block)
        if label >= 0 and not reaches_a_return_around(defaults, block_index) {
            made.append(label)
        }
        block_index = block_index + 1
    }
    return made
}

func reaches_a_return_around(of_function: LowIntermediaryRepresentation.LowFunction, avoided: Integer): Boolean {
    fallback avoided != 0
    var seen = List<Boolean>()
    var index = 0
    while index < of_function.blocks.count() {
        seen.append(false)
        index = index + 1
    }
    var pending = List<Integer>()
    pending.append(0)
    seen[0] = true
    while not pending.is_empty() {
        var taken = pending.remove_last()
        crash taken
        var block = of_function.blocks[taken]
        crash block
        if returns(block) {
            return true
        }
        var leaving = flow.successors[taken]
        crash leaving
        var leaving_index = 0
        while leaving_index < leaving.count() {
            var next = leaving[leaving_index]
            if next != avoided and seen[next] != true {
                seen[next] = true
                pending.append(next)
            }
            leaving_index = leaving_index + 1
        }
    }
    return false
}

func returns(block: LowIntermediaryRepresentation.LowBlock): Boolean {
    return block.instructions.any(is_a_return)
}

func is_a_return(instruction: Instruction): Boolean {
    return instruction == LowIntermediaryRepresentation.Instructions.Return
}

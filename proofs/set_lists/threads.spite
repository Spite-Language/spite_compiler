# ../../PROOFS.md#a-list-used-only-as-a-set

var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var built_by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var at_once = Dictionary<String, Boolean>()
var waiting = List<String>()
var valued = List<String>()
var walked_key = ""
var reaching = false
var calls_a_value = false
var valued_known = false
var valued_reached = false

func study(high: HighIntermediaryRepresentation.HighProgram) {
    program = high
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var key = built.function.key()
        built_by_key[key] = built
        index = index + 1
    }
    index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        walked_key = built.function.key()
        reaching = false
        look_in_block(built.body)
        index = index + 1
    }
    fallback not at_once.is_empty()
    valued_known = true
    note_every_drop()
    if calls_a_value {
        reach_the_valued()
    }
    reaching = true
    reach_the_waiting()
}

func reach_the_valued() {
    fallback not valued_reached
    valued_reached = true
    valued.each(note)
}

func runs_at_once(key: String): Boolean {
    return at_once.contains(key)
}

func note(key: String) {
    fallback not at_once.contains(key)
    at_once[key] = true
    waiting.append(key)
}

func note_every_drop() {
    var index = 0
    while index < program.built_functions.count() {
        var built = program.built_functions[index]
        if built.function.name == "drop" {
            var key = built.function.key()
            note(key)
        }
        index = index + 1
    }
}

func reach_the_waiting() {
    while not waiting.is_empty() {
        var next = waiting.remove_last()
        crash next
        var built = built_by_key[next]
        if built {
            walked_key = next
            look_in_block(built.body)
        }
    }
}

# ../../PROOFS.md#a-list-used-only-as-a-set
func look_in_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    var was_reaching = reaching
    var region_end = -1
    var index = 0
    while index < block.statements.count() {
        if region_end >= 0 and index > region_end {
            reaching = was_reaching
            region_end = -1
        }
        var statement = block.statements[index]
        if starts_work(statement) {
            reaching = true
            var joined = join_place(block, index)
            if joined < 0 {
                note(walked_key)
                joined = block.statements.count()
            }
            if joined > region_end {
                region_end = joined
            }
        }
        look_in_statement(statement)
        index = index + 1
    }
    reaching = was_reaching
}

func look_in_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: look(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: look(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: look_at_both(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: look_at_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: look_at_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.Return: look(statement.value)
        HighIntermediaryRepresentation.Statements.If: look_in_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: look_in_a_while(statement)
        HighIntermediaryRepresentation.Statements.Block: look_in_block(statement)
        HighIntermediaryRepresentation.Statements.Stop: look_at_a_stop(statement)
    }
}

func look_at_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    look_at_both(written.object, written.value)
    fallback reaching
    reach_the_fillers(written.shape, written.member)
    reach_the_fillers(written.shape, "set_{written.member}")
}

func look_in_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    look(branch.condition)
    look_in_block(branch.then_branch)
    look_in_block(branch.else_branch)
}

func look_in_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    look(loop.condition)
    look_in_block(loop.body)
}

func look_at_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(look_at_a_value)
    look(stop.then)
}

func look_at_a_value(value: SpiteCompiler.Value) {
    look(value)
}

func look_at_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    look(first)
    look(second)
}

func look(value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Call: look_at_a_call(value)
        HighIntermediaryRepresentation.Values.ShapeCall: look_at_a_shape_call(value)
        HighIntermediaryRepresentation.Values.Function.Value: look_at_a_function_value(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: look_at_a_value_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: look_at_a_making(value)
        HighIntermediaryRepresentation.Values.ForeignCall: value.arguments.each(look_at_a_value)
        HighIntermediaryRepresentation.Values.Conversion: look(value.converted)
        HighIntermediaryRepresentation.Values.AttributeRead: look(value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: look(value.described)
        HighIntermediaryRepresentation.Values.Class.Membership: look(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: look(value.text)
        HighIntermediaryRepresentation.Values.EnumText: look(value.number)
        HighIntermediaryRepresentation.Values.MachineOperation: look_at_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: look(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: look_at_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: look(value.tested)
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func look_at_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    look(call.receiver)
    call.arguments.each(look_at_a_value)
    fallback reaching
    var key = call.function.key()
    note(key)
}

func look_at_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    look(call.receiver)
    call.arguments.each(look_at_a_value)
    fallback reaching
    reach_the_fillers(call.shape, call.member.name)
    reach_the_fillers(call.shape, "get_{call.member.name}")
}

func reach_the_fillers(shape: Model.ShapeModel, member: String) {
    var fillers = program.model.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        var model = program.model.class_named(filler.name)
        if model {
            reach_a_member(model, member)
        }
        index = index + 1
    }
}

func reach_a_member(model: Model.ClassModel, member: String) {
    var function = model.function_named(member)
    fallback function
    var key = function.key()
    note(key)
}

func look_at_a_function_value(made: HighIntermediaryRepresentation.Values.Function.Value) {
    look(made.receiver)
    var key = made.function.key()
    if not valued.contains(key) {
        valued.append(key)
    }
    if reaching {
        note(key)
    }
}

func look_at_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    look(call.called)
    call.arguments.each(look_at_a_value)
    fallback reaching
    calls_a_value = true
    fallback valued_known
    reach_the_valued()
}

func look_at_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    made.arguments.each(look_at_a_value)
    fallback reaching
    if made.constructor {
        var key = made.constructor.key()
        note(key)
    }
    var model = program.model.class_named(made.value_type.name)
    fallback model
    reach_a_member(model, "_attribute_defaults")
}

# ../../PROOFS.md#a-list-used-only-as-a-set
func starts_work(statement: SpiteCompiler.Statement): Boolean {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: return holds_a_start(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Assign: return holds_a_start(statement.value)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return holds_either(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return holds_either(statement.object, statement.value)
        HighIntermediaryRepresentation.Statements.Evaluate: return holds_either(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.Return: return holds_a_start(statement.value)
        HighIntermediaryRepresentation.Statements.If: return holds_a_start(statement.condition)
        HighIntermediaryRepresentation.Statements.While: return holds_a_start(statement.condition)
        HighIntermediaryRepresentation.Statements.Block: return false
        HighIntermediaryRepresentation.Statements.Stop: return stop_holds_a_start(statement)
    }
}

func stop_holds_a_start(stop: HighIntermediaryRepresentation.Statements.Stop): Boolean {
    return stop.shown.any(holds_a_start_in) or holds_a_start(stop.then)
}

func holds_either(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?): Boolean {
    return holds_a_start(first) or holds_a_start(second)
}

func holds_any(values: List<SpiteCompiler.Value>): Boolean {
    return values.any(holds_a_start_in)
}

func holds_a_start_in(value: SpiteCompiler.Value): Boolean {
    return holds_a_start(value)
}

func holds_a_start(value: SpiteCompiler.Value?): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.Conversion: return value.kind == 'into_handle' or holds_a_start(value.converted)
        HighIntermediaryRepresentation.Values.Call: return holds_a_start(value.receiver) or holds_any(value.arguments)
        HighIntermediaryRepresentation.Values.ShapeCall: return holds_a_start(value.receiver) or holds_any(value.arguments)
        HighIntermediaryRepresentation.Values.Function.Value: return holds_a_start(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return holds_a_start(value.called) or holds_any(value.arguments)
        HighIntermediaryRepresentation.Values.MakeObject: return holds_any(value.arguments)
        HighIntermediaryRepresentation.Values.ForeignCall: return holds_any(value.arguments)
        HighIntermediaryRepresentation.Values.AttributeRead: return holds_a_start(value.object)
        HighIntermediaryRepresentation.Values.Class.OfValue: return holds_a_start(value.described)
        HighIntermediaryRepresentation.Values.Class.Membership: return holds_a_start(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: return holds_a_start(value.text)
        HighIntermediaryRepresentation.Values.EnumText: return holds_a_start(value.number)
        HighIntermediaryRepresentation.Values.MachineOperation: return holds_either(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: return holds_a_start(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: return holds_either(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: return holds_a_start(value.tested)
        HighIntermediaryRepresentation.Values.LocalRead: return false
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func join_place(block: HighIntermediaryRepresentation.Statements.Block, start: Integer): Integer {
    var started = block.statements[start]
    if started.class == HighIntermediaryRepresentation.Statements.Declare {
        return join_place_of(block, start, started.name)
    }
    return -1
}

func join_place_of(block: HighIntermediaryRepresentation.Statements.Block, start: Integer, name: String): Integer {
    var index = start + 1
    while index < block.statements.count() {
        var statement = block.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Declare and joins(statement.value, name) {
            return index
        }
        index = index + 1
    }
    return -1
}

func joins(value: SpiteCompiler.Value?, name: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Conversion and value.kind == 'join' {
        return reads_the_name(value.converted, name)
    }
    return false
}

func reads_the_name(value: SpiteCompiler.Value?, name: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name == name
    }
    return false
}

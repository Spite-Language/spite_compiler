# ../../PROOFS.md#a-list-used-only-as-a-set

var parents = Dictionary<String, String>()
var elements = Dictionary<String, String>()
var tainted = Dictionary<String, Boolean>()
var written_otherwise = Dictionary<String, Boolean>()
var searched = Dictionary<String, Boolean>()
var fresh_count = 0

func root_of(place: String): String {
    var current = place
    while parents.contains(current) {
        var parent = parents[current]
        crash parent
        current = parent
    }
    if current != place {
        parents[place] = current
    }
    return current
}

func fresh(): String {
    fresh_count = fresh_count + 1
    return "made {fresh_count}"
}

func fresh_tainted(): String {
    var made = fresh()
    taint(made)
    return made
}

func join(first: String, second: String) {
    fallback not first.is_empty() and not second.is_empty()
    var first_root = root_of(first)
    var second_root = root_of(second)
    fallback first_root != second_root
    var is_tainted = tainted.contains(first_root) or tainted.contains(second_root)
    parents[second_root] = first_root
    carry(written_otherwise, second_root, first_root)
    carry(searched, second_root, first_root)
    join_the_elements(first_root, second_root)
    if is_tainted {
        tainted[first_root] = true
        taint_the_element_of(first_root)
    }
}

func carry(flags: Dictionary<String, Boolean>, from: String, to: String) {
    if flags.contains(from) {
        flags[to] = true
    }
}

func join_the_elements(first_root: String, second_root: String) {
    var second_element = elements[second_root]
    fallback second_element
    var first_element = elements[first_root]
    if first_element {
        join(first_element, second_element)
        return
    }
    elements[first_root] = second_element
}

func element_of(place: String): String {
    fallback not place.is_empty()
    var root = root_of(place)
    var known = elements[root]
    if known {
        return known
    }
    var made = fresh()
    elements[root] = made
    if tainted.contains(root) {
        taint(made)
    }
    return made
}

func known_element_of(place: String): String {
    fallback not place.is_empty()
    var root = root_of(place)
    var known = elements[root]
    fallback known
    return known
}

func taint(place: String) {
    fallback not place.is_empty()
    var root = root_of(place)
    fallback not tainted.contains(root)
    tainted[root] = true
    taint_the_element_of(root)
}

func taint_the_element_of(root: String) {
    var element = elements[root]
    fallback element
    taint(element)
}

func note_a_write(place: String) {
    fallback not place.is_empty()
    var root = root_of(place)
    written_otherwise[root] = true
}

func note_a_search(place: String) {
    fallback not place.is_empty()
    var root = root_of(place)
    searched[root] = true
}

func is_a_set(place: String): Boolean {
    fallback not place.is_empty()
    var root = root_of(place)
    fallback searched.contains(root)
    return not tainted.contains(root) and not written_otherwise.contains(root)
}

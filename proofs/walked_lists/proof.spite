# ../../PROOFS.md#a-list-its-callee-only-walks-is-never-made

var no_program = Model.ProgramModel()
var program = HighIntermediaryRepresentation.HighProgram(no_program)
var walkers = List<HighIntermediaryRepresentation.Values.Function.Value>()
var walks = List<Model.FunctionModel>()
var lines = List<Integer>()

func Proof(high: HighIntermediaryRepresentation.HighProgram) {
    program = high
}

func walkers_of(
    callee: HighIntermediaryRepresentation.HighFunction,
    position: Integer,
    element_type: Model.Type,
): List<HighIntermediaryRepresentation.Values.Function.Value> {
    walkers = List<HighIntermediaryRepresentation.Values.Function.Value>()
    walks = List<Model.FunctionModel>()
    lines = List<Integer>()
    fallback is_a_plain_method(callee.function) and position < callee.function.parameters.count()
    var parameter = callee.function.parameters[position]
    var statements = callee.body.statements
    fallback not statements.is_empty()
    var index = 0
    while index < statements.count() {
        var statement = statements[index]
        fallback is_a_walk(statement, parameter.name, element_type)
        index = index + 1
    }
    return walkers
}

func is_a_plain_method(function: Model.FunctionModel): Boolean {
    fallback not function.answer and not function.is_a_constructor() and not function.is_a_member_template()
    fallback not function.is_an_attribute and not function.is_a_function_member and not function.binding
    var owner = program.model.class_named(function.owner)
    fallback owner
    return not owner.is_singleton
}

func is_a_walk(statement: SpiteCompiler.Statement, list_name: String, element_type: Model.Type): Boolean {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Evaluate and not statement.waited
    fallback statement.value and statement.value.class == HighIntermediaryRepresentation.Values.Call
    fallback is_a_list_each(statement.value.function) and statement.value.arguments.count() == 1
    fallback statement.value.receiver and statement.value.receiver.class == HighIntermediaryRepresentation.Values.LocalRead and statement.value.receiver.name == list_name
    var walker = statement.value.arguments[0]
    fallback walker and walker.class == HighIntermediaryRepresentation.Values.Function.Value
    fallback walker.receiver and walker.receiver.class == HighIntermediaryRepresentation.Values.ThisRead
    fallback takes_one_item(walker.function, element_type)
    walkers.append(walker)
    walks.append(statement.value.function)
    lines.append(statement.line)
    return true
}

func is_a_list_each(function: Model.FunctionModel): Boolean {
    fallback function.name == "each"
    var owner = program.model.class_named(function.owner)
    fallback owner
    return owner.file.namespace == "List"
}

func takes_one_item(function: Model.FunctionModel, element_type: Model.Type): Boolean {
    fallback function.parameters.count() == 1 and not function.is_a_constructor()
    fallback not function.is_an_attribute and not function.is_a_function_member
    var taken = function.parameters[0]
    return not taken.is_variadic and taken.parameter_type.is_the_same_as(element_type)
}

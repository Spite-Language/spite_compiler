var key = ""
var writes = List<String>()
var loop_writes = List<String>()
var callees = List<String>()
var loop_callees = List<String>()
var calls_unknown = false

func WrittenFunction(starting_key: String) {
    key = starting_key
}

func calls_any(writers: List<String>): Boolean {
    return count_of(callees, writers) > 0
}

func writes_once_at_most(name: String, writers: List<String>): Boolean {
    fallback not loop_writes.contains(name) and count_of(loop_callees, writers) <= 0
    var count = count_of_name(name) + count_of(callees, writers)
    fallback count <= 0 or not calls_unknown
    return count <= 1
}

func count_of(keys: List<String>, writers: List<String>): Integer {
    var count = 0
    var index = 0
    while index < keys.count() {
        var called = keys[index]
        if writers.contains(called) {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

func count_of_name(name: String): Integer {
    var count = 0
    var index = 0
    while index < writes.count() {
        var written = writes[index]
        if written == name {
            count = count + 1
        }
        index = index + 1
    }
    return count
}

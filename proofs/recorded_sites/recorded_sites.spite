type SiteJudge {
    judge_what_is_recorded(HighIntermediaryRepresentation.Building.Context)
}

# ../../PROOFS.md#what-the-builder-records-for-the-proofs
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var present_values = Proofs.PresentValues.PresentValues()
var proven_checks = Proofs.ProvenChecks.ProvenChecks()
var loop_narrowings = Proofs.LoopNarrowings.LoopNarrowings()
var guard_asserts = Proofs.GuardAsserts.GuardAsserts()
var lost_writes = Proofs.LostWrites.LostWrites()
var parallel_reach = Proofs.ParallelReach.ParallelReach()
var is_the_whole_build = false

func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    is_the_whole_build = true
    judge_what_is_recorded(high.context)
}

func judge_what_is_recorded(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    context.site_judges = List<SiteJudge>()
    prove_what_is_present()
    present_values.start(context)
    proven_checks.start(context)
    proven_checks.judges_the_whole_build = is_the_whole_build
    loop_narrowings.start(context)
    guard_asserts.start(context)
    lost_writes.start(context)
    parallel_reach.start(context)
    context.recorded_sites.each(judge_a_site)
    present_values.finish()
    proven_checks.finish()
    loop_narrowings.finish()
    guard_asserts.finish()
    lost_writes.finish()
    parallel_reach.finish()
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func prove_what_is_present() {
    fallback not context.presence.is_proven
    var proven_present = Proofs.ProvenPresent.ProvenPresent()
    proven_present.prove(context)
}

func judge_a_site(recorded: HighIntermediaryRepresentation.Building.RecordedSite) {
    if recorded.kind == "statement" {
        judge_a_statement(recorded.index)
    }
    if recorded.kind == "presence" {
        judge_a_presence(recorded.index)
    }
    if recorded.kind == "check" {
        judge_a_check(recorded.index)
    }
    if recorded.kind == "loop" {
        judge_a_loop(recorded.index)
    }
    if recorded.kind == "guard" {
        judge_a_guard(recorded.index)
    }
    if recorded.kind == "parallel" {
        judge_a_parallel(recorded.index)
    }
}

func judge_a_statement(index: Integer) {
    var site = context.statement_sites[index]
    crash site
    lost_writes.check_a_site(site)
}

func judge_a_presence(index: Integer) {
    var site = context.presence_sites[index]
    crash site
    present_values.check_a_site(site)
}

func judge_a_check(index: Integer) {
    var site = context.check_sites[index]
    crash site
    proven_checks.check_a_site(site)
}

func judge_a_loop(index: Integer) {
    var site = context.loop_sites[index]
    crash site
    loop_narrowings.check_a_site(site)
}

func judge_a_guard(index: Integer) {
    var site = context.guard_sites[index]
    crash site
    guard_asserts.check_a_site(site)
}

func judge_a_parallel(index: Integer) {
    var site = context.parallel_sites[index]
    crash site
    parallel_reach.check_a_site(site)
}

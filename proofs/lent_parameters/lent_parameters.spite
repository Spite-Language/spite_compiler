union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.FallbackStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var borrows = HighIntermediaryRepresentation.Building.Borrows(context)
var refusals = Validators.HighIntermediaryRepresentation.Borrows.Validator()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var followed = List<String>()

# ../../PROOFS.md#an-item-lent-to-a-call
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    borrows = HighIntermediaryRepresentation.Building.Borrows(context)
    var index = 0
    while index < context.lent_bodies.count() {
        var lent = context.lent_bodies[index]
        check_a_lent_body(lent)
        index = index + 1
    }
}

func check_a_lent_body(lent: HighIntermediaryRepresentation.Building.LentParameter) {
    var model = lent.model
    var function = lent.function
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    fallback declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        crash found.statement
        check_a_lent_statement(model, function, lent, found.statement)
        index = index + 1
    }
    var expression_index = 0
    while expression_index < walk.expressions.count() {
        var found_expression = walk.expressions[expression_index]
        check_a_lent_expression(model, function, lent, walk, found_expression)
        expression_index = expression_index + 1
    }
}

func check_a_lent_statement(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: Statement,
) {
    switch statement {
        AbstractSyntaxTree.Shapes.Statements.VariableStatement: check_a_lent_alias(model, function, lent, statement)
        AbstractSyntaxTree.Shapes.Statements.AssignmentStatement: check_a_lent_assignment(model, function, lent, statement)
        AbstractSyntaxTree.Shapes.Statements.ReturnStatement: check_a_lent_return(model, function, lent, statement)
        _: return
    }
}

func check_a_lent_alias(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    fallback borrows.is_the_name(statement.value, lent.name)
    borrows.enter_the_lent_function(model, function, statement.line)
    if lent.row.is_row {
        var sources = borrows.sources_text(lent.row)
        refusals.refuse_a_second_row_name(context, lent.name, sources, statement.name)
    }
    refusals.refuse_a_lent_alias(context, lent, statement.name)
}

func check_a_lent_assignment(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
) {
    var target = statement.target
    if lent.row.is_row {
        check_a_row_attribute_assigned(model, function, lent, statement)
    }
    fallback borrows.is_the_name(statement.value, lent.name)
    var attribute = borrows.printed(target)
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        attribute = target.name
    }
    borrows.enter_the_lent_function(model, function, statement.line)
    if lent.row.is_row {
        var sources = borrows.sources_text(lent.row)
        refusals.refuse_a_kept_row(context, lent.name, sources, attribute)
    }
    refusals.refuse_a_lent_kept(context, lent, attribute)
}

func check_a_row_attribute_assigned(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
) {
    var target = statement.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        refuse_an_assigned_row_member(model, function, lent, statement, target)
    }
}

func refuse_an_assigned_row_member(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    target: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    fallback borrows.is_the_name(target.target, lent.name)
    borrows.enter_the_lent_function(model, function, statement.line)
    var sources = borrows.sources_text(lent.row)
    refusals.refuse_an_assigned_row_attribute(context, lent.name, sources, target.name)
}

func check_a_lent_return(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    statement: AbstractSyntaxTree.Shapes.Statements.ReturnStatement,
) {
    fallback borrows.is_the_name(statement.value, lent.name)
    borrows.enter_the_lent_function(model, function, statement.line)
    if lent.row.is_row {
        var sources = borrows.sources_text(lent.row)
        refusals.refuse_a_returned_row(context, lent.name, sources)
    }
    refusals.refuse_a_lent_return(context, lent)
}

func check_a_lent_expression(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    walk: AbstractSyntaxTree.Walk.Walk,
    found: AbstractSyntaxTree.Walk.Found.Expression,
) {
    var expression = found.expression
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_a_lent_listing(model, function, lent, expression, found.line)
        follow_a_passed_on_lend(model, function, lent, expression, found.line)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_lent_function_value(model, function, lent, walk, expression, found.line)
    }
}

func check_a_lent_listing(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    line: Integer,
) {
    var called_name = borrows.called_name_of(call)
    fallback borrows.listing_names.contains(called_name)
    fallback borrows.passes_the_row(call, lent.name)
    borrows.enter_the_lent_function(model, function, line)
    if lent.row.is_row {
        var sources = borrows.sources_text(lent.row)
        refusals.refuse_a_listed_row(context, lent.name, sources)
    }
    refusals.refuse_a_lent_listing(context, lent)
}

# ../../PROOFS.md#an-item-lent-to-a-call
func follow_a_passed_on_lend(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    line: Integer,
) {
    fallback not lent.row.is_row
    var called_name = borrows.called_name_of(call)
    fallback not borrows.listing_names.contains(called_name)
    var position = position_of_the_lent(call, lent.name)
    fallback position >= 0
    var frame = HighIntermediaryRepresentation.Building.Borrow.Frame(model, function)
    var callee_model = borrows.lent_class_of(frame, call)
    fallback callee_model
    var callee = callee_model.function_named(called_name)
    fallback callee
    var parameter = borrows.parameter_at(callee, position)
    crash parameter
    fallback not parameter.is_variadic and parameter.parameter_type.kind != 'union'
    fallback borrows.is_a_program_function(callee_model, callee)
    var key = "{callee_model.key}.{callee.name}#{position}"
    fallback not followed.contains(key)
    followed.append(key)
    var passed = HighIntermediaryRepresentation.Building.LentParameter(parameter.name, callee.name, line, function.name)
    passed.parameter_type = parameter.parameter_type
    passed.model = callee_model
    passed.function = callee
    context.lent_bodies.append(passed)
}

func position_of_the_lent(call: AbstractSyntaxTree.Shapes.Expressions.CallExpression, name: String): Integer {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if borrows.is_the_name(argument, name) {
            return index
        }
        index = index + 1
    }
    return -1
}

func check_a_lent_function_value(
    model: Model.ClassModel,
    function: Model.FunctionModel,
    lent: HighIntermediaryRepresentation.Building.LentParameter,
    walk: AbstractSyntaxTree.Walk.Walk,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    line: Integer,
) {
    fallback not lent.row.is_row
    fallback borrows.is_the_name(member.target, lent.name)
    fallback not is_called(walk, member)
    var held_model = borrows.class_of_type(lent.parameter_type)
    fallback held_model
    fallback held_model.function_named(member.name)
    borrows.enter_the_lent_function(model, function, line)
    refusals.refuse_a_lent_function_value(context, lent, member.name)
}

func is_called(
    walk: AbstractSyntaxTree.Walk.Walk,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        var expression = found.expression
        if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression and expression.callee == member {
            return true
        }
        index = index + 1
    }
    return false
}

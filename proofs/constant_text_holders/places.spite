# ../../PROOFS.md#a-text-that-only-ever-holds-constant-texts-is-compared-by-its-address

var parents = Dictionary<String, String>()
var elements = Dictionary<String, String>()
var keys = Dictionary<String, String>()
var tainted = List<String>()
var sources = List<String>()
var destinations = List<String>()
var settled = Dictionary<String, Boolean>()
var fresh_count = 0

func root_of(place: String): String {
    var current = place
    while parents.contains(current) {
        var parent = parents[current]
        crash parent
        current = parent
    }
    if current != place {
        parents[place] = current
    }
    return current
}

func fresh(): String {
    fresh_count = fresh_count + 1
    return "made {fresh_count}"
}

func join(first: String, second: String) {
    fallback not first.is_empty() and not second.is_empty()
    var first_root = root_of(first)
    var second_root = root_of(second)
    fallback first_root != second_root
    parents[second_root] = first_root
    join_the_parts(elements, first_root, second_root)
    join_the_parts(keys, first_root, second_root)
}

func join_the_parts(parts: Dictionary<String, String>, first_root: String, second_root: String) {
    var second_part = parts[second_root]
    fallback second_part
    var first_part = parts[first_root]
    if first_part {
        join(first_part, second_part)
        return
    }
    parts[first_root] = second_part
}

func flow(source: String, destination: String) {
    fallback not source.is_empty() and not destination.is_empty()
    sources.append(source)
    destinations.append(destination)
}

func element_of(place: String): String {
    return part_of(elements, place)
}

# ../../PROOFS.md#a-dictionary-whose-keys-only-ever-hold-constant-texts-hashes-their-addresses
func key_of(place: String): String {
    return part_of(keys, place)
}

func part_of(parts: Dictionary<String, String>, place: String): String {
    fallback not place.is_empty()
    var root = root_of(place)
    var known = parts[root]
    if known {
        return known
    }
    var made = fresh()
    parts[root] = made
    return made
}

func taint(place: String) {
    fallback not place.is_empty()
    tainted.append(place)
}

# ../../PROOFS.md#a-text-that-only-ever-holds-constant-texts-is-compared-by-its-address
func settle() {
    var reached = Dictionary<String, List<String>>()
    var index = 0
    while index < sources.count() {
        var source = sources[index]
        var destination = destinations[index]
        crash destination
        var from = root_of(source)
        var to = root_of(destination)
        add_a_reach(reached, from, to)
        index = index + 1
    }
    var waiting = List<String>()
    index = 0
    while index < tainted.count() {
        var place = tainted[index]
        var root = root_of(place)
        waiting.append(root)
        index = index + 1
    }
    while not waiting.is_empty() {
        var root = waiting.remove_last()
        crash root
        if not settled.contains(root) {
            settled[root] = true
            var element = elements[root]
            if element {
                var element_root = root_of(element)
                waiting.append(element_root)
            }
            var key = keys[root]
            if key {
                var key_root = root_of(key)
                waiting.append(key_root)
            }
            var onward = reached[root]
            if onward {
                add_each(waiting, onward)
            }
        }
    }
}

func add_each(waiting: List<String>, onward: List<String>) {
    var index = 0
    while index < onward.count() {
        var root = onward[index]
        waiting.append(root)
        index = index + 1
    }
}

func add_a_reach(reached: Dictionary<String, List<String>>, from: String, to: String) {
    fallback from != to
    var known = reached[from]
    if known {
        known.append(to)
        return
    }
    var made = List<String>()
    made.append(to)
    reached[from] = made
}

func holds_only_constants(place: String): Boolean {
    fallback not place.is_empty()
    var root = root_of(place)
    return not settled.contains(root)
}

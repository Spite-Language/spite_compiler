# ../../PROOFS.md#a-value-proven-present-is-a-t
var model = Model.ProgramModel()
var facts = HighIntermediaryRepresentation.PresenceFacts()
var candidates = List<String>()
var blocked = Dictionary<String, Boolean>()
var returned_keys = List<String>()
var returned_values = List<HighIntermediaryRepresentation.Values.Value>()
var returned_in = List<Model.FunctionModel>()
var function = Model.FunctionModel("", "")
var function_key = ""

func gather(
    built_functions: List<HighIntermediaryRepresentation.HighFunction>,
    starting_model: Model.ProgramModel,
    starting_facts: HighIntermediaryRepresentation.PresenceFacts,
) {
    model = starting_model
    facts = starting_facts
    built_functions.each(read_a_function)
}

func read_a_function(built: HighIntermediaryRepresentation.HighFunction) {
    function = built.function
    assert function.answer and function.answer.is_nullable and is_an_eligible_function(function)
    function_key = function.key()
    candidates.append(function_key)
    read_block(built.body)
}

func is_an_eligible_function(candidate: Model.FunctionModel): Boolean {
    if candidate.owner.starts_with("Spite.") {
        return false
    }
    var owner = model.class_named(candidate.owner)
    if not owner {
        return false
    }
    var library = Validators.LibraryFile()
    return not library.holds(owner.file.path)
}

func read_block(block: HighIntermediaryRepresentation.Statements.Block) {
    block.statements.each(read_statement)
}

func read_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Return: read_a_return(statement)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: read_block(statement)
        _: return
    }
}

func read_an_if(made: HighIntermediaryRepresentation.Statements.If) {
    read_block(made.then_branch)
    assert made.else_branch
    read_block(made.else_branch)
}

func read_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    if not returned.value {
        blocked[function_key] = true
        return
    }
    assert returned.value.value_type.is_nullable
    returned_keys.append(function_key)
    returned_values.append(returned.value)
    returned_in.append(function)
}

func proved(): Boolean {
    var failing = Dictionary<String, Boolean>()
    var index = 0
    while index < returned_keys.count() {
        var key = returned_keys[index]
        var value = returned_values[index]
        var returning_function = returned_in[index]
        crash value and returning_function
        if not is_present_here(key, value, returning_function) {
            failing[key] = true
        }
        index = index + 1
    }
    var learned = false
    index = 0
    while index < candidates.count() {
        var key = candidates[index]
        var could = not failing.contains(key) and not blocked.contains(key)
        if could and not facts.present_answers.contains(key) {
            facts.present_answers[key] = true
            learned = true
        }
        index = index + 1
    }
    return learned
}

func is_present_here(
    key: String,
    value: HighIntermediaryRepresentation.Values.Value,
    returning_function: Model.FunctionModel,
): Boolean {
    if facts.is_present(value, returning_function) {
        return true
    }
    if value == HighIntermediaryRepresentation.Values.Call {
        var called = value.function.key()
        return called == key
    }
    return false
}

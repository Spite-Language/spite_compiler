# ../../PROOFS.md#a-value-proven-present-is-a-t
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    prove(high.context)
}

func prove(context: HighIntermediaryRepresentation.Building.Context) {
    var facts = context.presence
    assert not facts.is_proven
    var assignments = Proofs.PresentAssignments.PresentAssignments()
    var answers = Proofs.PresentAnswers.PresentAnswers()
    var flags = context.build_flags
    var is_live = flags["hot_reload"] == "true" or flags["repl"] == "true"
    assignments.gather(context.built_so_far, context.program, facts, is_live)
    answers.gather(context.built_so_far, context.program, facts)
    var learned = true
    while learned {
        var by_assignments = assignments.proved()
        var by_answers = answers.proved()
        learned = by_assignments or by_answers
    }
    facts.is_proven = true
}

# ../../PROOFS.md#unused-is-an-error

var program = Model.ProgramModel()
var reached = List<String>()
var namespaces = List<String>()
var namespace = ""

func TemplateReach(starting_program: Model.ProgramModel) {
    program = starting_program
}

# ../../PROOFS.md#unused-is-an-error
func namespaces_reached_from(file: AbstractSyntaxTree.Shapes.SourceFile): List<String> {
    namespace = file.namespace
    namespaces.append(file.namespace)
    var printer = Printers.Spite.Printer(file)
    var text = printer.text()
    reach_the_classes_written_in(text)
    var copies = program.order
    var copy_index = 0
    while copy_index < copies.count() {
        var copy = copies[copy_index]
        if copy.file.path == file.path {
            reach_through(copy)
        }
        copy_index = copy_index + 1
    }
    var index = 0
    while index < reached.count() {
        var key = reached[index]
        var model = program.class_named(key)
        crash model
        reach_through(model)
        index = index + 1
    }
    return namespaces
}

func reach_through(model: Model.ClassModel) {
    var bound = model.bound_types.values()
    bound.each(reach_a_type)
    var attribute_index = 0
    while attribute_index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[attribute_index]
        reach_a_type(attribute.attribute_type)
        attribute_index = attribute_index + 1
    }
    model.declared_functions.each(reach_a_function)
}

func reach_a_function(function: Model.FunctionModel) {
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        reach_a_type(parameter.parameter_type)
        index = index + 1
    }
    fallback function.answer
    reach_a_type(function.answer)
}

func reach_a_type(described: Model.Type) {
    reach_the_classes_written_in(described.name)
    described.members.each(reach_a_type)
}

func reach_the_classes_written_in(text: String) {
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer.Lexer(text, first_line)
    var tokens = lexer.tokens_of()
    var written = ""
    var follows_a_dot = false
    var index = 0
    while index < tokens.count() {
        var token = tokens[index]
        if token.kind == 'class_name' {
            written = joined(written, follows_a_dot, token.text)
            reach_a_written_class(written)
        } else if token.kind != 'dot' {
            written = ""
        }
        follows_a_dot = token.kind == 'dot'
        index = index + 1
    }
}

func joined(written: String, follows_a_dot: Boolean, name: String): String {
    if written.is_empty() or not follows_a_dot {
        return name
    }
    return "{written}.{name}"
}

func reach_a_written_class(written: String) {
    reach_a_class(written)
    var around = namespace
    while not around.is_empty() {
        reach_a_class("{around}.{written}")
        around = enclosing(around)
    }
}

func reach_a_class(key: String) {
    var model = program.class_named(key)
    fallback model
    var library = Mapping.LibraryFile()
    fallback not library.holds(model.file.path)
    fallback not reached.contains(model.key)
    reached.append(model.key)
    if not namespaces.contains(model.file.namespace) {
        namespaces.append(model.file.namespace)
    }
}

func enclosing(name: String): String {
    var segments = name.split(".")
    crash segments.remove_last()
    return segments.join(".")
}

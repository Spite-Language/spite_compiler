var read_counts = Dictionary<String, Integer>()
var read_paths = Dictionary<String, List<String>>()
var typed_reads = Dictionary<String, List<String>>()
var compiled = List<String>()
var folded_functions = List<String>()
var folded = List<String>()
var checked_paths = List<String>()
var unread_attributes = List<Unread>()
var filled_members = List<String>()
var reading_path = ""
var reading_counts_names = false
var reading_the_library = false
var reading_a_template = false
var reached_namespaces = List<String>()
var folders = Mapping.FolderMap()
var program = Model.ProgramModel()
var table = Symbols.SymbolTable(folders)
var fixing = Fixes.AfterBuilding.EveryFix()

# ../../PROOFS.md#unused-is-an-error
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var context = high.context
    var built = high.built_functions
    fallback not is_interactive(context)
    program = context.program
    folders = context.resolver.state.symbols.map
    table = context.resolver.state.symbols
    folded_functions = context.folded_functions
    built.each(note_the_built_reads)
    high.checked_functions.each(note_the_built_reads)
    var walks = context.resolver.state.symbols.walks
    walks.each(count_the_reads)
    var shapes = context.program.shapes.values()
    shapes.each(note_the_shape_members)
    var map = context.resolver.state.symbols.map
    var entry = context.program.class_named(context.program.entry)
    crash entry
    var index = 0
    while index < context.program.order.count() {
        var model = context.program.order[index]
        check_a_class(map, model, entry.file.path)
        index = index + 1
    }
    unread_attributes.each(tell_an_unread)
}

func note_the_shape_members(shape: Model.ShapeModel) {
    var fillers = program.fillers_of(shape.key)
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        note_a_filler(shape, filler)
        index = index + 1
    }
}

func note_a_filler(shape: Model.ShapeModel, filler: Model.Type) {
    var model = program.class_named(filler.name)
    fallback model
    var namespace = model.file.namespace
    var index = 0
    while index < shape.members.count() {
        var member = shape.members[index]
        if member.is_an_attribute or member.is_a_function_member {
            filled_members.append("{namespace}|{member.name}")
        }
        index = index + 1
    }
}

func is_interactive(context: HighIntermediaryRepresentation.Building.Context): Boolean {
    var flags = context.build_flags
    var inspection = CommandLine.Inspection()
    return inspection.holds(flags)
}

func note_the_built_reads(function: HighIntermediaryRepresentation.HighFunction) {
    reading_path = path_of(function.function)
    note_what_is_compiled(function.function)
    walk_a_block(function.body)
}

func note_what_is_compiled(function: Model.FunctionModel) {
    var key = function.key()
    if folded_functions.contains(key) and function.declaration {
        folded.append("{function.declaration.path}|{function.declaration.name}")
    }
    fallback not folded_functions.contains(key)
    if function.name == "_attribute_defaults" {
        note_compiled_defaults(function.owner)
        return
    }
    fallback function.declaration
    compiled.append("{function.declaration.path}|{function.declaration.name}")
}

func note_compiled_defaults(owner: String) {
    var model = program.class_named(owner)
    fallback model
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        if attribute.declaration {
            compiled.append("{attribute.declaration.path}|")
        }
        index = index + 1
    }
}

func walk_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(walk_a_statement)
}

func walk_a_statement(statement: SpiteCompiler.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: walk_a_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign: walk_an_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: walk_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: walk_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: walk_both(statement.value, statement.waited)
        HighIntermediaryRepresentation.Statements.Return: walk_a_return(statement)
        HighIntermediaryRepresentation.Statements.If: walk_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: walk_a_while(statement)
        HighIntermediaryRepresentation.Statements.Block: walk_a_block(statement)
        HighIntermediaryRepresentation.Statements.Stop: walk_a_stop(statement)
    }
}

func walk_a_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    walk_a_value(declare.value)
}

func walk_an_assign(assign: HighIntermediaryRepresentation.Statements.Assign) {
    walk_a_value(assign.value)
}

func walk_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    walk_a_value(returned.value)
}

func walk_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    walk_both(written.object, written.value)
}

func walk_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    walk_both(written.object, written.value)
}

func walk_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(walk_a_present)
    walk_a_value(stop.then)
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func walk_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        walk_both(current.condition, current.decided_condition)
        walk_a_block(current.then_branch)
        link = current.else_if()
        if not link {
            walk_a_block(current.else_branch)
        }
    }
}

func walk_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    walk_a_value(loop.condition)
    walk_a_block(loop.body)
}

func walk_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    walk_a_value(first)
    walk_a_value(second)
}

func walk_a_present(value: SpiteCompiler.Value) {
    walk_a_value(value)
}

func walk_a_value(value: SpiteCompiler.Value?) {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: walk_an_attribute_read(value)
        HighIntermediaryRepresentation.Values.Call: walk_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.ShapeCall: walk_a_call(value.receiver, value.arguments)
        HighIntermediaryRepresentation.Values.Function.Value: walk_a_value(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: walk_a_call(value.called, value.arguments)
        HighIntermediaryRepresentation.Values.Conversion: walk_a_value(value.converted)
        HighIntermediaryRepresentation.Values.Class.OfValue: walk_a_value(value.described)
        HighIntermediaryRepresentation.Values.Class.Membership: walk_a_value(value.tested)
        HighIntermediaryRepresentation.Values.EnumFromText: walk_a_value(value.text)
        HighIntermediaryRepresentation.Values.EnumText: walk_a_value(value.number)
        HighIntermediaryRepresentation.Values.ForeignCall: walk_a_call(value.library, value.arguments)
        HighIntermediaryRepresentation.Values.MachineOperation: walk_a_value_in_a_chain(value)
        HighIntermediaryRepresentation.Values.MakeObject: value.arguments.each(walk_a_present)
        HighIntermediaryRepresentation.Values.Negation: walk_a_value(value.negated)
        HighIntermediaryRepresentation.Values.NumberRoom: walk_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.PresenceTest: walk_a_value(value.tested)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func walk_a_value_in_a_chain(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    var links = [operation]
    var lowest = operation
    var next = walk_a_value_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = walk_a_value_left_link_of(lowest)
    }
    walk_a_value(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        walk_a_value(link.right)
        index = index - 1
    }
}

func walk_a_value_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    return left
}

func walk_a_call(receiver: SpiteCompiler.Value?, arguments: List<SpiteCompiler.Value>) {
    walk_a_value(receiver)
    arguments.each(walk_a_present)
}

func walk_an_attribute_read(read: HighIntermediaryRepresentation.Values.AttributeRead) {
    note_a_typed_read(read.attribute)
    walk_a_value(read.object)
}

func note_a_typed_read(attribute: Model.AttributeModel) {
    var owner = program.class_named(attribute.owner)
    fallback owner
    var place = "{owner.file.namespace}|{attribute.name}"
    if not typed_reads[place] {
        typed_reads[place] = List<String>()
    }
    var known = typed_reads[place]
    crash known
    if not known.contains(reading_path) {
        known.append(reading_path)
    }
}

func count_the_reads(walk: AbstractSyntaxTree.Walk) {
    reading_path = walk.file.path
    var namespace = walk.file.namespace
    var library = Mapping.LibraryFile()
    var is_the_librarys = library.holds(reading_path)
    reading_the_library = is_the_librarys
    reading_a_template = not reading_the_library and is_a_template(walk.file)
    if reading_a_template {
        var reach = TemplateReach(program)
        reached_namespaces = reach.namespaces_reached_from(walk.file)
    }
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        note_how_names_count(found.function_name, is_the_librarys)
        count_a_read(namespace, found.expression, found.is_called, 1)
        index = index + 1
    }
    var statement_index = 0
    while statement_index < walk.statements.count() {
        var found_statement = walk.statements[statement_index]
        note_how_names_count(found_statement.function_name, is_the_librarys)
        uncount_a_target(namespace, found_statement.statement)
        statement_index = statement_index + 1
    }
}

# ../../PROOFS.md#unused-is-an-error
func note_how_names_count(function_name: String, is_the_librarys: Boolean) {
    var place = "{reading_path}|{function_name}"
    var is_compiled = compiled.contains(place)
    var is_unbuilt_library = is_the_librarys and not folded.contains(place)
    reading_counts_names = not is_compiled and not is_unbuilt_library
}

func is_a_template(file: AbstractSyntaxTree.Shapes.SourceFile): Boolean {
    var index = 0
    while index < file.declarations.count() {
        var declaration = file.declarations[index]
        if declaration.class == AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration {
            return true
        }
        index = index + 1
    }
    return false
}

func uncount_a_target(namespace: String, statement: SpiteCompiler.WrittenStatement?) {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        count_a_read(namespace, statement.target, false, -1)
    }
}

# ../../../spite_documentation/style.md#nothing-unused
func count_a_read(namespace: String, expression: SpiteCompiler.Expression?, is_called: Boolean, step: Integer) {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        note_a_path_read(namespace, expression.name, step)
    }
    fallback reading_counts_names
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and is_called {
        note_a_path_read("()", expression.name, step)
    }
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression and not is_called {
        note_a_member_read(expression, step)
    }
}

# ../../PROOFS.md#unused-is-an-error
func note_a_member_read(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression, step: Integer) {
    fallback not reading_the_library and not is_a_walked_value(member)
    if not reading_a_template {
        note_a_path_read("*", member.name, step)
        return
    }
    var index = 0
    while index < reached_namespaces.count() {
        var reached = reached_namespaces[index]
        note_a_path_read(reached, member.name, step)
        index = index + 1
    }
}

# ../../../spite_documentation/reflection.md#an-instance-indexed-by-a-declaration
func is_a_walked_value(member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression): Boolean {
    fallback member.name == "value"
    var indexed = member.target
    if indexed.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return lists_the_attributes(indexed.target)
    }
    return false
}

func lists_the_attributes(listed: SpiteCompiler.Expression?): Boolean {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return listed.name == "attributes"
    }
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return listed.name == "attributes"
    }
    return false
}

func note_a_path_read(owner: String, name: String, step: Integer) {
    var place = "{owner}|{name}"
    add_to(read_counts, "{reading_path}|{place}", step)
    if not read_paths[place] {
        read_paths[place] = List<String>()
    }
    var known = read_paths[place]
    crash known
    if not known.contains(reading_path) {
        known.append(reading_path)
    }
}

func add_to(counts: Dictionary<String, Integer>, key: String, step: Integer) {
    var known = counts[key]
    if known {
        counts[key] = known + step
    } else {
        counts[key] = step
    }
}

func path_of(function: Model.FunctionModel): String {
    var path = ""
    var owner = program.class_named(function.owner)
    if owner {
        path = owner.file.path
    }
    if function.declaration {
        path = declared_path_or(function.declaration, path)
    }
    return path
}

func declared_path_or(
    declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration,
    otherwise: String,
): String {
    if declaration.path.is_empty() {
        return otherwise
    }
    return declaration.path
}

func check_a_class(map: Mapping.FolderMap, model: Model.ClassModel, entry_path: String) {
    var path = model.file.path
    fallback not checked_paths.contains(path)
    checked_paths.append(path)
    fallback model.key != "Environment" and model.key != "Build"
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        check_a_written_attribute(map, model, attribute, entry_path)
        index = index + 1
    }
}

func check_a_written_attribute(
    map: Mapping.FolderMap,
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    entry_path: String,
) {
    fallback attribute.declaration
    var path = attribute.declaration.path
    if path.is_empty() {
        path = model.file.path
    }
    var library = Mapping.LibraryFile()
    fallback not library.holds(path)
    var loaded_folder = loaded_folder_of(map, path)
    fallback not loaded_folder.is_empty() or is_the_programs_own(map, path)
    check_an_attribute(model, attribute, path, entry_path, loaded_folder)
}

func loaded_folder_of(map: Mapping.FolderMap, path: String): String {
    var program_root = map.roots.first()
    crash program_root
    var index = 1
    while index < map.roots.count() {
        var root = map.roots[index]
        var is_inside_the_program = map.inside(root.path, program_root.path)
        if is_inside_the_program and map.inside(path, root.path) {
            return root.path
        }
        index = index + 1
    }
    return ""
}

func is_read(owner: String, attribute: Model.AttributeModel, folder: String): Boolean {
    var name = attribute.name
    var place = "{owner}|{name}"
    var typed = typed_reads[place]
    if typed and read_in(typed, folder) {
        return true
    }
    var any_place = "*|{name}"
    if attribute.attribute_type.kind == 'function' and counted_in("()|{name}", folder) {
        return true
    }
    return counted_in(place, folder) or counted_in(any_place, folder)
}

func read_in(paths: List<String>, folder: String): Boolean {
    if folder.is_empty() {
        return not paths.is_empty()
    }
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        if folders.inside(path, folder) {
            return true
        }
        index = index + 1
    }
    return false
}

func counted_in(place: String, folder: String): Boolean {
    var paths = read_paths[place]
    fallback paths
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var count = read_counts["{path}|{place}"]
        var is_inside = folder.is_empty() or folders.inside(path, folder)
        if count and count > 0 and is_inside {
            return true
        }
        index = index + 1
    }
    return false
}

func binds_a_singleton(attribute: Model.AttributeModel): Boolean {
    var held = attribute.attribute_type
    fallback held.kind == 'object'
    var model = program.class_named(held.name)
    if model {
        return model.is_singleton
    }
    return false
}

func is_the_programs_own(map: Mapping.FolderMap, path: String): Boolean {
    var program_root = map.roots.first()
    crash program_root
    fallback map.inside(path, program_root.path)
    var index = 1
    while index < map.roots.count() {
        var root = map.roots[index]
        fallback not map.inside(path, root.path)
        index = index + 1
    }
    return true
}

func check_an_attribute(
    model: Model.ClassModel,
    attribute: Model.AttributeModel,
    path: String,
    entry_path: String,
    loaded_folder: String,
) {
    fallback attribute.declaration
    var name = attribute.name
    var namespace = model.file.namespace
    var is_private = name.starts_with("_")
    if loaded_folder.is_empty() or is_private {
        var is_filled = filled_members.contains("{namespace}|{name}")
        fallback not is_read(namespace, attribute, "") and not is_filled
    } else {
        fallback binds_a_singleton(attribute) and not is_read(namespace, attribute, loaded_folder)
    }
    fallback attribute.attribute_type.name != "ForeignCallback"
    var owner = plain_name(model.shown)
    var rule = Validators.HighIntermediaryRepresentation.ReadAttribute.Validator()
    var answer = rule.check(table, attribute.declaration, path, owner)
    if answer.is_fixable() {
        fixing.fixed_an_attribute(table, attribute.declaration, path, owner)
    }
    var line = attribute.declaration.line
    var in_the_entry = path == entry_path
    var unread = Unread(path, line, in_the_entry, answer)
    var place = 0
    while place < unread_attributes.count() and not is_earlier(unread, unread_attributes[place]) {
        place = place + 1
    }
    unread_attributes.insert(place, unread)
}

func tell_an_unread(unread: Unread) {
    unread.answer.tell()
}

func is_earlier(unread: Unread, other: Unread): Boolean {
    if unread.in_the_entry != other.in_the_entry {
        return unread.in_the_entry
    }
    if unread.path != other.path {
        return unread.path < other.path
    }
    return unread.line < other.line
}

func plain_name(shown: String): String {
    var parts = shown.split(".")
    var last = parts.last()
    crash last
    return last
}

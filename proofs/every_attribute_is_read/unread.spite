var path = ""
var line = 0
var owner = ""
var name = ""
var in_the_entry = false

func Unread(
    starting_path: String,
    starting_line: Integer,
    starting_owner: String,
    starting_name: String,
    starting_in_the_entry: Boolean,
) {
    path = starting_path
    line = starting_line
    owner = starting_owner
    name = starting_name
    in_the_entry = starting_in_the_entry
}

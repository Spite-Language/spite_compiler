var path = ""
var line = 0
var in_the_entry = false
var answer = Validators.Answer()

func Unread(
    starting_path: String,
    starting_line: Integer,
    starting_in_the_entry: Boolean,
    starting_answer: Validators.Answer,
) {
    path = starting_path
    line = starting_line
    in_the_entry = starting_in_the_entry
    answer = starting_answer
}

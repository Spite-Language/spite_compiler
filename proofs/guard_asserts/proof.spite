# ../../PROOFS.md#a-fallback-answers-what-its-answer-type-builds-with-no-arguments

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var statements_state = HighIntermediaryRepresentation.Building.StatementsState()
var statements = HighIntermediaryRepresentation.Building.Statements(statements_state)
var crashes = HighIntermediaryRepresentation.Building.Crashes(statements_state)

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
    statements_state = HighIntermediaryRepresentation.Building.StatementsState()
    statements_state.start_from(context)
    statements = HighIntermediaryRepresentation.Building.Statements(statements_state)
    crashes = HighIntermediaryRepresentation.Building.Crashes(statements_state)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.GuardSite) {
    entered.enter(site.owner, site.function, site.line)
    if site.kind == "default" {
        check_a_default(site)
    } else {
        check_a_terminal_if(site)
    }
}

func check_a_default(site: HighIntermediaryRepresentation.Building.GuardSite) {
    fallback site.function.answer
    var answer: Model.Type = site.function.answer
    var full_name = context.shown(answer)
    var shown = plain_type_name(full_name)
    var condition_text = ""
    if site.condition {
        var printer = Printers.Spite.ExpressionPrinter(site.condition)
        condition_text = printer.text()
    }
    var rule = Validators.HighIntermediaryRepresentation.GuardAssert.Validator()
    rule.check_a_default(context, crashes, answer, shown, condition_text)
}

func check_a_terminal_if(site: HighIntermediaryRepresentation.Building.GuardSite) {
    fallback not site.has_an_else and site.proves_something
    fallback not site.function.answer and statements.is_a_bare_path(site.condition)
    var line_of_the_last = statements.last_line_of(site.function.declaration)
    fallback line_of_the_last == site.statement_line
    crash site.condition
    var printer = Printers.Spite.ExpressionPrinter(site.condition)
    var written = printer.text()
    var fixing = Fixes.AfterBuilding.EveryFix()
    fallback not fixing.fixed_a_terminal_if(context, site, written)
    var rule = Validators.HighIntermediaryRepresentation.GuardAssert.Validator()
    rule.check_a_terminal_if(context, written)
}

func plain_type_name(full_name: String): String {
    if full_name.contains("<") {
        return full_name
    }
    return last_part_of(full_name)
}

func last_part_of(owner: String): String {
    var parts = owner.split(".")
    var last = parts.last()
    crash last
    return last
}

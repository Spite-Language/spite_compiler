# ../../PROOFS.md#a-guard-assert-answers-only-nothing
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var statements = HighIntermediaryRepresentation.Building.Statements(context)
var values = HighIntermediaryRepresentation.Building.Values(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
    statements = HighIntermediaryRepresentation.Building.Statements(context)
    values = HighIntermediaryRepresentation.Building.Values(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.GuardSite) {
    entered.enter(site.owner, site.function, site.line)
    if site.kind == "default" {
        check_a_default(site)
    } else {
        check_a_terminal_if(site)
    }
}

func check_a_default(site: HighIntermediaryRepresentation.Building.GuardSite) {
    assert site.function.answer
    var answer: Model.Type = site.function.answer
    assert not answer.is_nullable
    var full_name = context.shown(answer)
    assert not statements.is_a_collection(answer, full_name)
    var shown = plain_type_name(full_name)
    var condition_text = ""
    var opposite = ""
    if site.condition {
        var printer = Printers.Spite.ExpressionPrinter(site.condition)
        condition_text = printer.text()
        opposite = printer.opposite_text()
    }
    var default_shown = default_value_shown(answer)
    var chosen = chosen_answer_text(answer)
    typing.refuse_default_answer(context, shown, default_shown, chosen, condition_text, opposite)
}

func check_a_terminal_if(site: HighIntermediaryRepresentation.Building.GuardSite) {
    assert not site.has_an_else and site.proves_something
    assert not site.function.answer and statements.is_a_bare_path(site.condition)
    var line_of_the_last = statements.last_line_of(site.function.declaration)
    assert line_of_the_last == site.statement_line
    var path = context.path()
    var library = Validators.LibraryFile()
    assert not library.holds(path)
    crash site.condition
    var printer = Printers.Spite.ExpressionPrinter(site.condition)
    var written = printer.text()
    typing.refuse_terminal_if(context, written)
}

func plain_type_name(full_name: String): String {
    if full_name.contains("<") {
        return full_name
    }
    return last_part_of(full_name)
}

func last_part_of(owner: String): String {
    var parts = owner.split(".")
    var last = parts.last()
    crash last
    return last
}

func default_value_shown(answer: Model.Type): String {
    if answer.kind == 'scalar' {
        return default_scalar_shown(answer.name)
    }
    if answer.kind == 'enumeration' {
        return first_enum_value_shown(answer)
    }
    if answer.kind == 'object' and answer.name == "String" {
        return "\"\""
    }
    return "an object with every attribute at its default"
}

func first_enum_value_shown(answer: Model.Type): String {
    var made = values.enum_model_of(answer)
    var first_value = made.values.first()
    crash first_value
    return "'{first_value}'"
}

func default_scalar_shown(name: String): String {
    if name == "Boolean" {
        return "false"
    }
    if name == "Float" or name == "Double" {
        return "0.0"
    }
    return "0"
}

func chosen_answer_text(answer: Model.Type): String {
    if answer.kind == 'scalar' {
        return chosen_scalar_text(answer.name)
    }
    if answer.kind == 'enumeration' {
        return first_enum_value_shown(answer)
    }
    if answer.kind == 'object' and answer.name == "String" {
        return "\"\""
    }
    if answer.kind == 'object' {
        return chosen_object_text(answer)
    }
    return ""
}

func chosen_scalar_text(name: String): String {
    if name == "Boolean" {
        return "false"
    }
    if name == "Float" or name == "Double" {
        return "-1.0"
    }
    if name.starts_with("Unsigned") or name == "Byte" or name.contains("Address") {
        return ""
    }
    return "-1"
}

func chosen_object_text(answer: Model.Type): String {
    if context.current_class.bound_types.count() > 0 {
        return ""
    }
    if not context.has_a_class(answer) {
        return ""
    }
    var model = context.class_of(answer)
    if model.is_singleton or model.bound_types.count() > 0 {
        return ""
    }
    if made_with_arguments(model) {
        return ""
    }
    var simple = last_part_of(model.shown)
    return "{simple}()"
}

func made_with_arguments(model: Model.ClassModel): Boolean {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if function.is_constructor and function.parameters.count() > 0 {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-switch-covers-every-case
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var cover = Validators.HighIntermediaryRepresentation.SwitchCover.Validator()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    context = high.context
    context.switch_sites.each(check_a_site)
}

func check_a_site(site: HighIntermediaryRepresentation.Building.SwitchSite) {
    context.current_class = site.owner
    context.current_function = site.function
    context.line = site.rest_line
    cover.check_the_rest(context, site.shown, site.is_an_enum, site.every, site.written)
    context.line = site.line
    if site.is_nullable {
        cover.check_the_nullable(context, site.subject, site.shown, site.every, site.written)
    } else {
        cover.check(context, site.subject, site.is_an_enum, site.every, site.written)
    }
}

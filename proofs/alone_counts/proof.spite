# ../../PROOFS.md#a-function-only-one-thread-runs-counts-plainly

func check(checked: HighIntermediaryRepresentation.HighProgram) {
    fallback checked.will_be_lowered()
    crash checked.waits
    fallback not checked.waits.has_callbacks
    fallback not is_interactive(checked)
    var walk = HighIntermediaryRepresentation.RunAtOnce()
    walk.study(checked)
    fallback not walk.leaves_work_running
    checked.counts_alone_outside_the_work = true
    var index = 0
    while index < checked.built_functions.count() {
        var built = checked.built_functions[index]
        var key = built.function.key()
        built.runs_alone = walk.runs_alone(key)
        index = index + 1
    }
}

func is_interactive(checked: HighIntermediaryRepresentation.HighProgram): Boolean {
    crash checked.context
    if checked.prompt or checked.prompt_listen or checked.prompt_serve or checked.prompt_check_point {
        return true
    }
    if checked.reload_start or checked.reload_check_point {
        return true
    }
    return checked.context.build_flags["hot_reload"] == "true"
}

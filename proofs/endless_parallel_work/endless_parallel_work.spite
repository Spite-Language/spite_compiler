# ../../PROOFS.md#a-loop-that-can-never-end-is-an-error
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var context = high.context
    assert not context.endless_work.is_empty()
    var waits = HighIntermediaryRepresentation.Waits(high)
    var index = 0
    while index < context.endless_work.count() {
        var candidate = context.endless_work[index]
        refuse_if_it_never_waits(waits, candidate)
        index = index + 1
    }
}

func refuse_if_it_never_waits(waits: HighIntermediaryRepresentation.Waits, candidate: HighIntermediaryRepresentation.Building.EndlessWork) {
    assert waits.callees.contains(candidate.key) and not waits.waits(candidate.key)
    var failure = Validators.Failure()
    failure.stop_inside(candidate.path, candidate.line, candidate.owner, candidate.function_name, candidate.text)
}

union Expression {
    AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression
    AbstractSyntaxTree.Shapes.Expressions.LiteralExpression
    AbstractSyntaxTree.Shapes.Expressions.TextLiteral
    AbstractSyntaxTree.Shapes.Expressions.MemberExpression
    AbstractSyntaxTree.Shapes.Expressions.CallExpression
    AbstractSyntaxTree.Shapes.Expressions.IndexExpression
    AbstractSyntaxTree.Shapes.Expressions.BinaryExpression
    AbstractSyntaxTree.Shapes.Expressions.UnaryExpression
    AbstractSyntaxTree.Shapes.Expressions.ListLiteral
    AbstractSyntaxTree.Shapes.Expressions.DictionaryLiteral
    AbstractSyntaxTree.Shapes.Expressions.EntryLiteral
}

union Statement {
    AbstractSyntaxTree.Shapes.Statements.ExpressionStatement
    AbstractSyntaxTree.Shapes.Statements.VariableStatement
    AbstractSyntaxTree.Shapes.Statements.AssignmentStatement
    AbstractSyntaxTree.Shapes.Statements.ReturnStatement
    AbstractSyntaxTree.Shapes.Statements.IfStatement
    AbstractSyntaxTree.Shapes.Statements.WhileStatement
    AbstractSyntaxTree.Shapes.Statements.SwitchStatement
    AbstractSyntaxTree.Shapes.Statements.AssertStatement
    AbstractSyntaxTree.Shapes.Statements.CrashStatement
    AbstractSyntaxTree.Shapes.Statements.LoadStatement
    AbstractSyntaxTree.Shapes.Statements.Block
}

# ../../PROOFS.md#a-write-to-an-object-only-this-function-holds-must-be-read
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var built_context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(built_context)
var view = HighIntermediaryRepresentation.Building.ScopeView()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    built_context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(built_context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.StatementSite) {
    assert site.kind == "statement"
    entered.enter(site.owner, site.function, site.line)
    view = site.view
    check_a_statement(built_context, site.statements, site.index, site.enclosing)
}

func check_a_statement(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var statement = written[index]
    crash statement
    var library = Validators.LibraryFile()
    var path = context.path()
    assert not library.holds(path)
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        check_an_assignment(context, written, index, statement, enclosing)
    }
}

func check_an_assignment(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var target = statement.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_replaced_item(context, written, index, statement, target.name, enclosing)
    }
    if target == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_member_write(context, written, index, statement, target, enclosing)
    }
}

func declaration_of(
    written: List<Statement>,
    index: Integer,
    name: String,
): Integer {
    var at = index - 1
    while at >= 0 {
        var earlier = written[at]
        if declares(earlier, name) {
            return at
        }
        at = at - 1
    }
    return -1
}

func declares(statement: Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == name
    }
    return false
}

func walk_of(
    written: List<Statement>,
    starting_at: Integer,
    ending_at: Integer,
): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var at = starting_at
    var last = ending_at
    if last > written.count() {
        last = written.count()
    }
    while at < last {
        var statement = written[at]
        crash statement
        walk.read_statement(statement)
        at = at + 1
    }
    return walk
}

func names_it(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_the_name(expression: Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func check_a_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var declared_at = declaration_of(written, index, name)
    if declared_at < 0 {
        check_an_enclosed_item(context, written, index, statement, name, enclosing)
    }
    assert declared_at >= 0
    var declaration = written[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_an_item_local(context, written, index, declared_at, statement, declaration)
    }
}

func check_an_enclosed_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var level = enclosing.count() - 1
    var searching = true
    while level >= 0 and searching {
        var outer = enclosing[level]
        crash outer
        var holder = outer.statements[outer.index]
        if holder == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
            searching = false
        }
        var declared_at = declaration_of(outer.statements, outer.index, name)
        if searching and declared_at >= 0 {
            check_an_outer_item(context, written, index, statement, enclosing, level, declared_at)
            searching = false
        }
        level = level - 1
    }
}

func check_an_outer_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
) {
    var outer = enclosing[level]
    crash outer
    var declaration = outer.statements[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_an_outer_item_local(context, written, index, statement, enclosing, level, declared_at, declaration)
    }
}

func check_an_outer_item_local(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
    declaration: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    var read = declaration.value
    if read == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        refuse_an_outer_replaced_item(context, written, index, statement, enclosing, level, declared_at, read)
    }
}

func refuse_an_outer_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    assert is_a_list_or_a_dictionary(context, read.target)
    var name = assigned_name(statement)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    assert not read_in_an_outer_block(enclosing, level, name)
    var outer = enclosing[level]
    crash outer
    var between = walk_of(outer.statements, declared_at + 1, outer.index)
    assert not assigns_it(between, name)
    var before = walk_of(written, 0, index)
    assert not assigns_it(before, name)
    refuse_the_replaced_item(context, statement, name, read)
}

func read_in_an_outer_block(enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>, level: Integer, name: String): Boolean {
    var current = level
    while current < enclosing.count() {
        var block = enclosing[current]
        var block_count = block.statements.count()
        var later = walk_of(block.statements, block.index + 1, block_count)
        if names_it(later, name) {
            return true
        }
        current = current + 1
    }
    return false
}

func assigned_name(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement): String {
    var target = statement.target
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return target.name
    }
    return ""
}

func refuse_the_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    crash read.target
    crash statement.value
    var item_printer = Printers.Spite.ExpressionPrinter(read)
    var item = item_printer.text()
    var list_printer = Printers.Spite.ExpressionPrinter(read.target)
    var list_text = list_printer.text()
    var value_printer = Printers.Spite.ExpressionPrinter(statement.value)
    var value_text = value_printer.text()
    context.line = statement.line
    typing.refuse_replaced_item(context, name, item, list_text, value_text)
}

func check_an_item_local(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    declaration: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    var read = declaration.value
    if read == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        check_a_listed_item(context, written, index, declared_at, statement, read)
    }
    if read == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_an_answered_item(context, written, index, declared_at, statement, read)
    }
}

func check_an_answered_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_member_answer(context, written, index, declared_at, statement, call, callee)
    }
}

func check_a_member_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var holder = callee.target
    var holder_name = ""
    if holder == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder_name = holder.name
    }
    assert not holder_name.is_empty()
    var holder_type = type_of_a_name(context, holder_name)
    assert holder_type
    var present = holder_type.present()
    assert present.kind == 'object' and context.has_a_class(present)
    var model = context.class_of(present)
    var found = AnsweredItem()
    answered_item_of(context, model, callee.name, found, 0)
    assert not found.attribute.is_empty()
    var name = assigned_name(statement)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    var between = walk_of(written, declared_at + 1, index)
    assert not assigns_it(between, name)
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    var answered_by = call_printer.text()
    var owner_parts = found.model.shown.split(".")
    var owner = owner_parts.last()
    crash owner
    var writer = writer_of(found.model, found.attribute)
    context.line = statement.line
    typing.refuse_a_replaced_answer(context, name, found.item, owner, answered_by, writer, found.attribute)
}

func answered_item_of(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function_name: String,
    found: AnsweredItem,
    depth: Integer,
) {
    assert depth < 4
    var library = Validators.LibraryFile()
    assert not library.holds(model.file.path)
    var function = model.function_named(function_name)
    assert function
    assert function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    assert declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var returned = the_one_returned(walk)
    assert returned
    if returned == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        answered_by_an_index(context, model, returned, found)
    }
    if returned == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        answered_by_a_call(context, model, returned, found, depth)
    }
}

func the_one_returned(walk: AbstractSyntaxTree.Walk.Walk): Expression? {
    var returned: Expression? = null
    var returned_text = ""
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            var text = returned_text_of(statement.value)
            if returned_text.is_empty() {
                returned_text = text
                returned = statement.value
            }
            assert text == returned_text and not text.is_empty()
        }
        index = index + 1
    }
    return returned
}

func returned_text_of(value: Expression?): String {
    if not value {
        return ""
    }
    var printer = Printers.Spite.ExpressionPrinter(value)
    return printer.text()
}

func answered_by_an_index(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    found: AnsweredItem,
) {
    var listed = returned.target
    var listed_name = ""
    if listed == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        listed_name = listed.name
    }
    var attribute = model.attribute_named(listed_name)
    assert attribute
    var shown = context.shown(attribute.attribute_type)
    assert shown.starts_with("List<") or shown.starts_with("Dictionary<")
    found.model = model
    found.attribute = listed_name
    found.item = returned_text_of(returned)
}

func answered_by_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    found: AnsweredItem,
    depth: Integer,
) {
    var callee = returned.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        answered_through_an_attribute(context, model, callee, found, depth)
    }
}

func answered_through_an_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    found: AnsweredItem,
    depth: Integer,
) {
    var holder = callee.target
    var holder_name = ""
    if holder == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder_name = holder.name
    }
    var attribute = model.attribute_named(holder_name)
    assert attribute
    var present = attribute.attribute_type.present()
    assert present.kind == 'object' and context.has_a_class(present)
    var held_model = context.class_of(present)
    answered_item_of(context, held_model, callee.name, found, depth + 1)
}

func writer_of(model: Model.ClassModel, attribute: String): String {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if writes_an_item_of(function, attribute) {
            return function.name
        }
        index = index + 1
    }
    return ""
}

func writes_an_item_of(function: Model.FunctionModel, attribute: String): Boolean {
    if not function.declaration {
        return false
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return false
    }
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if assigns_an_item_of(found.statement, attribute) {
            return true
        }
        index = index + 1
    }
    return false
}

func assigns_an_item_of(statement: Statement?, attribute: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_an_item_of(statement.target, attribute)
    }
    return false
}

func is_an_item_of(target: Expression?, attribute: String): Boolean {
    if target == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return is_the_name(target.target, attribute)
    }
    return false
}

func check_a_listed_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    assert is_a_list_or_a_dictionary(context, read.target)
    var target = statement.target
    var name = ""
    if target == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = target.name
    }
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    var between = walk_of(written, declared_at + 1, index)
    assert not assigns_it(between, name)
    crash read.target
    crash statement.value
    var item_printer = Printers.Spite.ExpressionPrinter(read)
    var item = item_printer.text()
    var list_printer = Printers.Spite.ExpressionPrinter(read.target)
    var list_text = list_printer.text()
    var value_printer = Printers.Spite.ExpressionPrinter(statement.value)
    var value_text = value_printer.text()
    context.line = statement.line
    typing.refuse_replaced_item(context, name, item, list_text, value_text)
}

func assigns_it(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if is_an_assignment_to(found.statement, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func is_an_assignment_to(statement: Statement?, name: String): Boolean {
    if statement == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.target, name)
    }
    return false
}

func is_a_list_or_a_dictionary(context: HighIntermediaryRepresentation.Building.Context, listed: Expression?): Boolean {
    if listed == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var listed_type = type_of_a_name(context, listed.name)
        if listed_type {
            var shown = context.shown(listed_type)
            return shown.starts_with("List<") or shown.starts_with("Dictionary<")
        }
    }
    return false
}

func type_of_a_name(context: HighIntermediaryRepresentation.Building.Context, name: String): Model.Type? {
    var internal_name = view.internal_name_of(name)
    if internal_name {
        return view.declared_type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func check_a_member_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var holder = member.target
    if holder == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_held_write(context, written, index, statement, member, holder.name, enclosing)
    }
}

func check_a_held_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var declared_at = declaration_of(written, index, name)
    if declared_at < 0 {
        check_an_enclosed_write(context, written, index, statement, member, name, enclosing)
    }
    assert declared_at >= 0
    var declaration = written[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        assert is_made_new(context, declaration.value, 0)
    }
    assert is_a_judged_attribute(context, member, name)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    var between = walk_of(written, declared_at + 1, index)
    between.read_expression(statement.value)
    assert not lets_it_go(between, name)
    refuse_the_lost_write(context, statement, member, name)
}

func is_a_judged_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
): Boolean {
    var internal_name = view.internal_name_of(name)
    if not internal_name {
        return false
    }
    var held_type = view.declared_type_of(internal_name)
    if not held_type {
        return false
    }
    var is_an_object = held_type.kind == 'object' and not held_type.is_nullable
    if not is_an_object or not context.has_a_class(held_type) {
        return false
    }
    var model = context.class_of(held_type)
    var library = Validators.LibraryFile()
    if library.holds(model.file.path) or model.function_named("drop") {
        return false
    }
    if model.function_named("set_{member.name}") {
        return false
    }
    var attribute = model.attribute_named(member.name)
    if not attribute {
        return false
    }
    return attribute.attribute_type.kind != 'handle'
}

func refuse_the_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
) {
    var internal_name = view.internal_name_of(name)
    crash internal_name
    var held_type = view.declared_type_of(internal_name)
    crash held_type
    var model = context.class_of(held_type)
    context.line = statement.line
    var article = typing.article_of(model.shown)
    typing.refuse_lost_write(context, name, member.name, article, model.shown)
}

func check_an_enclosed_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<Statement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var level = enclosing.count() - 1
    var found_at = -1
    var declared_at = -1
    var searching = true
    while level >= 0 and searching {
        var outer = enclosing[level]
        crash outer
        var holder = outer.statements[outer.index]
        if holder == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
            searching = false
        }
        var declared = declaration_of(outer.statements, outer.index, name)
        if searching and declared >= 0 {
            found_at = level
            declared_at = declared
            searching = false
        }
        level = level - 1
    }
    assert found_at >= 0
    var outer_block = enclosing[found_at]
    crash outer_block
    var declaration = outer_block.statements[declared_at]
    if declaration == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        assert is_made_new(context, declaration.value, 0)
    }
    assert is_a_judged_attribute(context, member, name)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    assert not names_it(after, name)
    assert not read_in_an_outer_block(enclosing, found_at, name)
    var between = walk_of(outer_block.statements, declared_at + 1, outer_block.index + 1)
    assert not lets_it_go(between, name)
    var inner = found_at + 1
    while inner < enclosing.count() {
        var block = enclosing[inner]
        var before_the_holder = walk_of(block.statements, 0, block.index + 1)
        assert not lets_it_go(before_the_holder, name)
        inner = inner + 1
    }
    var before_the_write = walk_of(written, 0, index)
    before_the_write.read_expression(statement.value)
    assert not lets_it_go(before_the_write, name)
    refuse_the_lost_write(context, statement, member, name)
}

func lets_it_go(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var named = 0
    var reached = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            named = named + 1
        }
        if reads_through(found.expression, name) {
            reached = reached + 1
        }
        if calls_through(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return named != reached
}

func reads_through(expression: Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_the_name(expression.target, name)
    }
    return false
}

func calls_through(expression: Expression?, name: String): Boolean {
    if expression == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return reads_through(expression.callee, name)
    }
    return false
}

func is_made_new(context: HighIntermediaryRepresentation.Building.Context, value: Expression?, depth: Integer): Boolean {
    if value == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return is_a_new_call(context, value, depth)
    }
    return false
}

func is_a_new_call(
    context: HighIntermediaryRepresentation.Building.Context,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    depth: Integer,
): Boolean {
    var callee = call.callee
    if callee == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return callee.name == "copy" or callee.name == "deep_copy"
    }
    if callee == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return is_a_new_own_call(context, callee.name, depth)
    }
    return false
}

func is_a_new_own_call(context: HighIntermediaryRepresentation.Building.Context, called: String, depth: Integer): Boolean {
    var function = context.current_class.function_named(called)
    if not function {
        var initial = called.slice(0, 1)
        crash initial
        return initial != initial.lower_case()
    }
    if depth >= 4 {
        return false
    }
    if not function.declaration {
        return false
    }
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    if not declaration.body {
        return false
    }
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    return every_return_is_new(context, walk, depth)
}

func every_return_is_new(context: HighIntermediaryRepresentation.Building.Context, walk: AbstractSyntaxTree.Walk.Walk, depth: Integer): Boolean {
    var returns = 0
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            returns = returns + 1
            if not is_made_new(context, statement.value, depth + 1) {
                return false
            }
        }
        index = index + 1
    }
    return returns > 0
}

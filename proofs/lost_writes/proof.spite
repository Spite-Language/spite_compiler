# ../../PROOFS.md#a-write-to-an-object-only-this-function-holds-must-be-read

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var built_context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(built_context)
var view = HighIntermediaryRepresentation.Building.ScopeView()
var no_file = AbstractSyntaxTree.Shapes.SourceFile("", "")

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    built_context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(built_context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.StatementSite) {
    fallback site.kind == "statement"
    entered.enter(site.owner, site.function, site.line)
    view = site.view
    check_a_statement(built_context, site.statements, site.index, site.enclosing)
}

func check_a_statement(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var statement = written[index]
    crash statement
    var library = Mapping.LibraryFile()
    var path = context.path()
    fallback not library.holds(path)
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        check_an_assignment(context, written, index, statement, enclosing)
    }
}

func check_an_assignment(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var target = statement.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_replaced_item(context, written, index, statement, target.name, enclosing)
    }
    if target.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_member_write(context, written, index, statement, target, enclosing)
    }
}

func declaration_of(written: List<SpiteCompiler.WrittenStatement>, index: Integer, name: String): Integer {
    var at = index - 1
    while at >= 0 {
        var earlier = written[at]
        if declares(earlier, name) {
            return at
        }
        at = at - 1
    }
    return -1
}

func declares(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        return statement.name == name
    }
    return false
}

func walk_of(
    written: List<SpiteCompiler.WrittenStatement>,
    starting_at: Integer,
    ending_at: Integer,
): AbstractSyntaxTree.Walk.Walk {
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    var at = starting_at
    var last = ending_at
    if last > written.count() {
        last = written.count()
    }
    while at < last {
        var statement = written[at]
        crash statement
        walk.read_statement(statement)
        at = at + 1
    }
    return walk
}

func is_the_name(expression: SpiteCompiler.Expression?, name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return expression.name == name
    }
    return false
}

func check_a_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var declared_at = declaration_of(written, index, name)
    if declared_at < 0 {
        check_an_enclosed_item(context, written, index, statement, name, enclosing)
    }
    fallback declared_at >= 0
    var declaration = written[declared_at]
    if declaration.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_an_item_local(context, written, index, declared_at, statement, declaration)
    }
}

func check_an_enclosed_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var level = declared_level(enclosing, name)
    fallback level >= 0
    fallback only_written_in_its_loops(enclosing, level, name)
    var outer = enclosing[level]
    crash outer
    var declared_at = declaration_of(outer.statements, outer.index, name)
    check_an_outer_item(context, written, index, statement, enclosing, level, declared_at)
}

func declared_level(enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>, name: String): Integer {
    var level = enclosing.count() - 1
    while level >= 0 {
        var outer = enclosing[level]
        crash outer
        var declared_at = declaration_of(outer.statements, outer.index, name)
        if declared_at >= 0 {
            return level
        }
        level = level - 1
    }
    return -1
}

func only_written_in_its_loops(
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    name: String,
): Boolean {
    var current = level
    while current < enclosing.count() {
        var block = enclosing[current]
        var holder = block.statements[block.index]
        if holder.class == AbstractSyntaxTree.Shapes.Statements.WhileStatement {
            var loop = walk_of(block.statements, block.index, block.index + 1)
            fallback only_written(loop, name)
        }
        current = current + 1
    }
    return true
}

func only_written(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var named = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            named = named + 1
        }
        index = index + 1
    }
    var writes = 0
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if writes_the_name(found.statement, name) {
            writes = writes + 1
        }
        index = index + 1
    }
    return named == writes
}

func writes_the_name(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        var target = statement.target
        return is_the_name(target, name) or reads_through(target, name)
    }
    return false
}

func check_an_outer_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
) {
    var outer = enclosing[level]
    crash outer
    var declaration = outer.statements[declared_at]
    if declaration.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        check_an_outer_item_local(context, written, index, statement, enclosing, level, declared_at, declaration)
    }
}

func check_an_outer_item_local(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
    declaration: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    var read = declaration.value
    if read.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        check_an_outer_replaced_item(context, written, index, statement, enclosing, level, declared_at, read)
    }
}

func check_an_outer_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    declared_at: Integer,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    fallback is_a_list_or_a_dictionary(context, read.target)
    var name = assigned_name(statement)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    fallback not after.names(name)
    fallback not read_in_an_outer_block(enclosing, level, name)
    var outer = enclosing[level]
    crash outer
    var between = walk_of(outer.statements, declared_at + 1, outer.index)
    fallback not between.assigns(name)
    var before = walk_of(written, 0, index)
    check_the_replaced_item(context, statement, name, read, before)
}

func read_in_an_outer_block(
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
    level: Integer,
    name: String,
): Boolean {
    var current = level
    while current < enclosing.count() {
        var block = enclosing[current]
        var block_count = block.statements.count()
        var later = walk_of(block.statements, block.index + 1, block_count)
        if later.names(name) {
            return true
        }
        current = current + 1
    }
    return false
}

func assigned_name(statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement): String {
    var target = statement.target
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return target.name
    }
    return ""
}

func check_the_replaced_item(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    name: String,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    before: AbstractSyntaxTree.Walk.Walk,
) {
    var rule = Validators.HighIntermediaryRepresentation.LostWrite.Validator()
    var rule_answer = rule.check_a_replaced_item(context, statement.line, name, read, statement.value, before)
    context.tell(rule_answer)
}

func check_an_item_local(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    declaration: AbstractSyntaxTree.Shapes.Statements.VariableStatement,
) {
    var read = declaration.value
    if read.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        check_a_listed_item(context, written, index, declared_at, statement, read)
    }
    if read.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        check_an_answered_item(context, written, index, declared_at, statement, read)
    }
}

func check_an_answered_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
) {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        check_a_member_answer(context, written, index, declared_at, statement, call, callee)
    }
}

func check_a_member_answer(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
) {
    var holder = callee.target
    var holder_name = ""
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder_name = holder.name
    }
    fallback not holder_name.is_empty()
    var holder_type = type_of_a_name(context, holder_name)
    fallback holder_type
    var present = holder_type.present()
    fallback present.kind == 'object' and context.has_a_class(present)
    var model = context.class_of(present)
    var found = AnsweredItem()
    answered_item_of(context, model, callee.name, found, 0)
    fallback not found.attribute.is_empty()
    var name = assigned_name(statement)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    var between = walk_of(written, declared_at + 1, index)
    var call_printer = Printers.Spite.ExpressionPrinter(call)
    var answered_by = call_printer.text()
    var owner_parts = found.model.shown.split(".")
    var owner = owner_parts.last()
    crash owner
    var writer = writer_of(found.model, found.attribute)
    var rule = Validators.HighIntermediaryRepresentation.LostWrite.Validator()
    var rule_answer = rule.check_a_replaced_answer(
        context,
        statement.line,
        name,
        found.item,
        owner,
        answered_by,
        writer,
        found.attribute,
        after,
        between,
    )
    context.tell(rule_answer)
}

func answered_item_of(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function_name: String,
    found: AnsweredItem,
    depth: Integer,
) {
    fallback depth < 4
    var library = Mapping.LibraryFile()
    fallback not library.holds(model.file.path)
    var function = model.function_named(function_name)
    fallback function
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    fallback declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var returned = the_one_returned(walk)
    fallback returned
    if returned.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        answered_by_an_index(context, model, returned, found)
    }
    if returned.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        answered_by_a_call(context, model, returned, found, depth)
    }
}

func the_one_returned(walk: AbstractSyntaxTree.Walk.Walk): SpiteCompiler.Expression? {
    var returned: SpiteCompiler.Expression? = null
    var returned_text = ""
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            var text = returned_text_of(statement.value)
            if returned_text.is_empty() {
                returned_text = text
                returned = statement.value
            }
            fallback text == returned_text and not text.is_empty()
        }
        index = index + 1
    }
    return returned
}

func returned_text_of(value: SpiteCompiler.Expression?): String {
    fallback value
    var printer = Printers.Spite.ExpressionPrinter(value)
    return printer.text()
}

func answered_by_an_index(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
    found: AnsweredItem,
) {
    var listed = returned.target
    var listed_name = ""
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        listed_name = listed.name
    }
    var attribute = model.attribute_named(listed_name)
    fallback attribute
    var shown = context.shown(attribute.attribute_type)
    fallback shown.starts_with("List<") or shown.starts_with("Dictionary<")
    found.model = model
    found.attribute = listed_name
    found.item = returned_text_of(returned)
}

func answered_by_a_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    returned: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    found: AnsweredItem,
    depth: Integer,
) {
    var callee = returned.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        answered_through_an_attribute(context, model, callee, found, depth)
    }
}

func answered_through_an_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    found: AnsweredItem,
    depth: Integer,
) {
    var holder = callee.target
    var holder_name = ""
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder_name = holder.name
    }
    var attribute = model.attribute_named(holder_name)
    fallback attribute
    var present = attribute.attribute_type.present()
    fallback present.kind == 'object' and context.has_a_class(present)
    var held_model = context.class_of(present)
    answered_item_of(context, held_model, callee.name, found, depth + 1)
}

func writer_of(model: Model.ClassModel, attribute: String): String {
    var index = 0
    while index < model.declared_functions.count() {
        var function = model.declared_functions[index]
        if writes_an_item_of(function, attribute) {
            return function.name
        }
        index = index + 1
    }
    return ""
}

func writes_an_item_of(function: Model.FunctionModel, attribute: String): Boolean {
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    fallback declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if assigns_an_item_of(found.statement, attribute) {
            return true
        }
        index = index + 1
    }
    return false
}

func assigns_an_item_of(statement: SpiteCompiler.WrittenStatement?, attribute: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_an_item_of(statement.target, attribute)
    }
    return false
}

func is_an_item_of(target: SpiteCompiler.Expression?, attribute: String): Boolean {
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IndexExpression {
        return is_the_name(target.target, attribute)
    }
    return false
}

func check_a_listed_item(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    declared_at: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    read: AbstractSyntaxTree.Shapes.Expressions.IndexExpression,
) {
    fallback is_a_list_or_a_dictionary(context, read.target)
    var target = statement.target
    var name = ""
    if target.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        name = target.name
    }
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    fallback not after.names(name)
    var between = walk_of(written, declared_at + 1, index)
    var rule = Validators.HighIntermediaryRepresentation.LostWrite.Validator()
    var rule_answer = rule.check_a_replaced_item(context, statement.line, name, read, statement.value, between)
    context.tell(rule_answer)
}

func is_a_list_or_a_dictionary(
    context: HighIntermediaryRepresentation.Building.Context,
    listed: SpiteCompiler.Expression?,
): Boolean {
    if listed.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        var listed_type = type_of_a_name(context, listed.name)
        if listed_type {
            var shown = context.shown(listed_type)
            return shown.starts_with("List<") or shown.starts_with("Dictionary<")
        }
    }
    return false
}

func type_of_a_name(context: HighIntermediaryRepresentation.Building.Context, name: String): Model.Type? {
    var internal_name = view.internal_name_of(name)
    if internal_name {
        return view.declared_type_of(internal_name)
    }
    var attribute = context.current_class.attribute_named(name)
    if attribute {
        return attribute.attribute_type
    }
    return null
}

func check_a_member_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var holder = member.target
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        check_a_held_write(context, written, index, statement, member, holder.name, enclosing)
    }
}

func check_a_held_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var declared_at = declaration_of(written, index, name)
    if declared_at < 0 {
        check_an_enclosed_write(context, written, index, statement, member, name, enclosing)
    }
    fallback declared_at >= 0
    var origin = origin_of(written, declared_at, index, name)
    fallback is_made_at(context, written, origin)
    fallback is_a_judged_attribute(context, member, name)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    fallback not after.names(name)
    var between = walk_of(written, origin + 1, index)
    between.read_expression(statement.value)
    check_the_lost_write(context, statement, member, name, between)
}

func origin_of(
    written: List<SpiteCompiler.WrittenStatement>,
    declared_at: Integer,
    ending_at: Integer,
    name: String,
): Integer {
    var at = ending_at - 1
    while at > declared_at {
        var earlier = written[at]
        if writes_the_whole_name(earlier, name) {
            return at
        }
        at = at - 1
    }
    return declared_at
}

func writes_the_whole_name(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        return is_the_name(statement.target, name)
    }
    return false
}

func is_made_at(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    origin: Integer,
): Boolean {
    var statement = written[origin]
    crash statement
    var value: SpiteCompiler.Expression? = null
    if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement {
        value = statement.value
    }
    if statement.class == AbstractSyntaxTree.Shapes.Statements.AssignmentStatement {
        value = statement.value
    }
    return is_made_new(context, context.current_class, value, 0)
}

func is_a_judged_attribute(
    context: HighIntermediaryRepresentation.Building.Context,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
): Boolean {
    var internal_name = view.internal_name_of(name)
    fallback internal_name
    var held_type = view.declared_type_of(internal_name)
    fallback held_type
    var is_an_object = held_type.kind == 'object' and not held_type.is_nullable
    fallback is_an_object and context.has_a_class(held_type)
    var model = context.class_of(held_type)
    var library = Mapping.LibraryFile()
    fallback not library.holds(model.file.path) and not model.function_named("drop")
    fallback not model.function_named("set_{member.name}")
    var attribute = model.attribute_named(member.name)
    fallback attribute
    return attribute.attribute_type.kind != 'handle'
}

func check_the_lost_write(
    context: HighIntermediaryRepresentation.Building.Context,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    before_the_write: AbstractSyntaxTree.Walk.Walk,
) {
    var internal_name = view.internal_name_of(name)
    crash internal_name
    var held_type = view.declared_type_of(internal_name)
    crash held_type
    var model = context.class_of(held_type)
    var rule = Validators.HighIntermediaryRepresentation.LostWrite.Validator()
    var rule_answer = rule.check_a_lost_write(
        context,
        statement.line,
        name,
        member.name,
        model.shown,
        before_the_write,
        this,
    )
    context.tell(rule_answer)
}

func check_an_enclosed_write(
    context: HighIntermediaryRepresentation.Building.Context,
    written: List<SpiteCompiler.WrittenStatement>,
    index: Integer,
    statement: AbstractSyntaxTree.Shapes.Statements.AssignmentStatement,
    member: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    name: String,
    enclosing: List<HighIntermediaryRepresentation.Building.EnclosingBlock>,
) {
    var found_at = declared_level(enclosing, name)
    fallback found_at >= 0
    fallback only_written_in_its_loops(enclosing, found_at, name)
    var outer_block = enclosing[found_at]
    crash outer_block
    var declared_at = declaration_of(outer_block.statements, outer_block.index, name)
    var origin = origin_of(outer_block.statements, declared_at, outer_block.index, name)
    fallback is_made_at(context, outer_block.statements, origin)
    fallback is_a_judged_attribute(context, member, name)
    var statement_count = written.count()
    var after = walk_of(written, index + 1, statement_count)
    fallback not after.names(name)
    fallback not read_in_an_outer_block(enclosing, found_at, name)
    var between = walk_of(outer_block.statements, origin + 1, outer_block.index + 1)
    fallback not lets_it_go(between, name)
    var inner = found_at + 1
    while inner < enclosing.count() {
        var block = enclosing[inner]
        var before_the_holder = walk_of(block.statements, 0, block.index + 1)
        fallback not lets_it_go(before_the_holder, name)
        inner = inner + 1
    }
    var before_the_write = walk_of(written, 0, index)
    before_the_write.read_expression(statement.value)
    check_the_lost_write(context, statement, member, name, before_the_write)
}

func lets_it_go(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var named = 0
    var reached = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            named = named + 1
        }
        if reads_through(found.expression, name) {
            reached = reached + 1
        }
        if calls_through(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return named != reached
}

func reads_through(expression: SpiteCompiler.Expression?, name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_the_name(expression.target, name)
    }
    return false
}

func calls_through(expression: SpiteCompiler.Expression?, name: String): Boolean {
    if expression.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return reads_through(expression.callee, name)
    }
    return false
}

func is_made_new(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    value: SpiteCompiler.Expression?,
    depth: Integer,
): Boolean {
    if value.class == AbstractSyntaxTree.Shapes.Expressions.CallExpression {
        return is_a_new_call(context, model, value, depth)
    }
    return false
}

func is_a_new_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    call: AbstractSyntaxTree.Shapes.Expressions.CallExpression,
    depth: Integer,
): Boolean {
    var callee = call.callee
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.MemberExpression {
        return is_a_new_member_call(context, model, callee, depth)
    }
    if callee.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return is_a_new_own_call(context, model, callee.name, depth)
    }
    return false
}

func is_a_new_member_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    callee: AbstractSyntaxTree.Shapes.Expressions.MemberExpression,
    depth: Integer,
): Boolean {
    if callee.name == "copy" or callee.name == "deep_copy" {
        return true
    }
    var held_model = class_held_by(context, model, callee.target, depth)
    fallback held_model
    var function = held_model.function_named(callee.name)
    fallback function
    return answers_new(context, held_model, function, depth)
}

func class_held_by(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    holder: SpiteCompiler.Expression?,
    depth: Integer,
): Model.ClassModel? {
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.LiteralExpression and holder.kind == 'keyword_this' {
        return model
    }
    var holder_name = ""
    if holder.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        holder_name = holder.name
    }
    fallback not holder_name.is_empty()
    var held_type = type_held_by(context, model, holder_name, depth)
    fallback held_type
    var present = held_type.present()
    fallback present.kind == 'object' and context.has_a_class(present)
    return context.class_of(present)
}

func type_held_by(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    name: String,
    depth: Integer,
): Model.Type? {
    if depth == 0 {
        return type_of_a_name(context, name)
    }
    var attribute = model.attribute_named(name)
    fallback attribute
    return attribute.attribute_type
}

func is_a_new_own_call(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    called: String,
    depth: Integer,
): Boolean {
    var function = model.function_named(called)
    if not function {
        var initial = called.slice(0, 1)
        crash initial
        return initial != initial.lower_case()
    }
    return answers_new(context, model, function, depth)
}

func answers_new(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    function: Model.FunctionModel,
    depth: Integer,
): Boolean {
    fallback depth < 4
    var library = Mapping.LibraryFile()
    fallback not library.holds(model.file.path)
    fallback function.declaration
    var declaration: AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration = function.declaration
    fallback declaration.body
    var walk = AbstractSyntaxTree.Walk.Walk(no_file)
    walk.read_block(declaration.body)
    return every_return_is_new(context, model, walk, depth)
}

func every_return_is_new(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    depth: Integer,
): Boolean {
    var returns = 0
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
            returns = returns + 1
            fallback returns_a_new_object(context, model, walk, statement.value, depth + 1)
        }
        index = index + 1
    }
    return returns > 0
}

func returns_a_new_object(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    value: SpiteCompiler.Expression?,
    depth: Integer,
): Boolean {
    if is_made_new(context, model, value, depth) {
        return true
    }
    if value.class == AbstractSyntaxTree.Shapes.Expressions.IdentifierExpression {
        return is_a_made_local(context, model, walk, value.name, depth)
    }
    return false
}

func is_a_made_local(
    context: HighIntermediaryRepresentation.Building.Context,
    model: Model.ClassModel,
    walk: AbstractSyntaxTree.Walk.Walk,
    name: String,
    depth: Integer,
): Boolean {
    var declared = declared_in(walk, name)
    fallback declared
    fallback is_made_new(context, model, declared.value, depth)
    return only_reached_or_returned(walk, name)
}

func declared_in(
    walk: AbstractSyntaxTree.Walk.Walk,
    name: String,
): AbstractSyntaxTree.Shapes.Statements.VariableStatement? {
    var index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        var statement = found.statement
        if statement.class == AbstractSyntaxTree.Shapes.Statements.VariableStatement and statement.name == name {
            return statement
        }
        index = index + 1
    }
    return null
}

func only_reached_or_returned(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    fallback not calls_through_in(walk, name)
    var named = 0
    var reached = 0
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if is_the_name(found.expression, name) {
            named = named + 1
        }
        if reads_through(found.expression, name) {
            reached = reached + 1
        }
        index = index + 1
    }
    var returned = 0
    index = 0
    while index < walk.statements.count() {
        var found = walk.statements[index]
        if returns_the_name(found.statement, name) {
            returned = returned + 1
        }
        index = index + 1
    }
    return named == reached + returned
}

func calls_through_in(walk: AbstractSyntaxTree.Walk.Walk, name: String): Boolean {
    var index = 0
    while index < walk.expressions.count() {
        var found = walk.expressions[index]
        if calls_through(found.expression, name) {
            return true
        }
        index = index + 1
    }
    return false
}

func returns_the_name(statement: SpiteCompiler.WrittenStatement?, name: String): Boolean {
    if statement.class == AbstractSyntaxTree.Shapes.Statements.ReturnStatement {
        return is_the_name(statement.value, name)
    }
    return false
}

# ../../PROOFS.md#objects-that-never-leave-their-function-live-in-the-frame
func proved(low: LowIntermediaryRepresentation.LoweredProgram) {
    var keeping = KeptParameters()
    keeping.read_the_program(low)
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        if low.is_selected(function.key) {
            var study = Study(function, low, keeping)
            function.placed_objects = study.placed()
        }
        index = index + 1
    }
}

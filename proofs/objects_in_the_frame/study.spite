# ../../PROOFS.md#objects-that-never-leave-their-function-live-in-the-frame

var function = LowIntermediaryRepresentation.LowFunction("", 0)
var program = LowIntermediaryRepresentation.LoweredProgram()
var keeping = Proofs.ObjectsInTheFrame.KeptParameters()
var operands = LowOptimizationPasses.Operands()
var flow = LowOptimizationPasses.Flow()
var facts = LowIntermediaryRepresentation.PlacedObjects()
var definition_counts = List<Integer>()
var allocated = List<Boolean>()
var escaped = List<Boolean>()
var passed = List<Boolean>()
var compared = List<Boolean>()
var returned = List<Boolean>()
var class_ids = List<Long>()
var texts = List<Boolean>()
var derived_from = List<Integer>()
var derivations = List<LowIntermediaryRepresentation.Instructions.Arithmetic>()
var freeing_calls = List<LowIntermediaryRepresentation.Instructions.Call>()
var largest_room = 4096
var largest_field_count = 32

func Study(
    starting_function: LowIntermediaryRepresentation.LowFunction,
    starting_program: LowIntermediaryRepresentation.LoweredProgram,
    starting_keeping: Proofs.ObjectsInTheFrame.KeptParameters,
) {
    function = starting_function
    program = starting_program
    keeping = starting_keeping
}

func placed(): LowIntermediaryRepresentation.PlacedObjects? {
    fallback not function.is_resumable and allocates_anything()
    facts.register_total = operands.most_register_of(function)
    fill_the_registers()
    read_the_definitions()
    join_the_copies()
    fill_the_roots()
    study_the_uses()
    settle_the_derivations()
    settle_the_freeing_calls()
    study_the_derived()
    var index = 0
    while index < function.parameter_count {
        mark_escaped(index)
        index = index + 1
    }
    choose_the_modes()
    fallback any_mode()
    return facts
}

func allocates_anything(): Boolean {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if instruction.class == LowIntermediaryRepresentation.Instructions.Allocate {
                return true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return false
}

func fill_the_registers() {
    var index = 0
    while index < facts.register_total {
        facts.parents.append(index)
        definition_counts.append(0)
        facts.constant_known.append(false)
        facts.constant_values.append(0)
        facts.shapes.append(0)
        index = index + 1
    }
}

func read_the_definitions() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            operands.read(instruction)
            operands.defines.each(count_a_definition)
            index = index + 1
        }
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(note_the_shape)
        block_index = block_index + 1
    }
}

func count_a_definition(register: Integer) {
    var count = definition_counts[register]
    crash count
    definition_counts[register] = count + 1
}

func defined_once(register: Integer): Boolean {
    fallback register >= function.parameter_count
    return definition_counts[register] == 1
}

func note_the_shape(instruction: SpiteCompiler.Instruction) {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Constant: note_a_constant(instruction)
        LowIntermediaryRepresentation.Instructions.Load: note_a_load_shape(instruction)
        LowIntermediaryRepresentation.Instructions.Arithmetic: note_an_arithmetic_shape(instruction)
        LowIntermediaryRepresentation.Instructions.Check: return
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: note_a_decimal_shape(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return
        LowIntermediaryRepresentation.Instructions.Compare: return
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return
        LowIntermediaryRepresentation.Instructions.Store: return
        LowIntermediaryRepresentation.Instructions.Call: return
        LowIntermediaryRepresentation.Instructions.CallAt: return
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return
        LowIntermediaryRepresentation.Instructions.DataAddress: return
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return
        LowIntermediaryRepresentation.Instructions.Allocate: return
        LowIntermediaryRepresentation.Instructions.Retain: return
        LowIntermediaryRepresentation.Instructions.Free: return
        LowIntermediaryRepresentation.Instructions.Resize: return
        LowIntermediaryRepresentation.Instructions.CopyBytes: return
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return
        LowIntermediaryRepresentation.Instructions.Jump: return
        LowIntermediaryRepresentation.Instructions.Branch: return
        LowIntermediaryRepresentation.Instructions.Return: return
        LowIntermediaryRepresentation.Instructions.FrameAddress: return
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return
        LowIntermediaryRepresentation.Instructions.FrameRoom: return
        LowIntermediaryRepresentation.Instructions.StartThread: return
        LowIntermediaryRepresentation.Instructions.JoinThread: return
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return
        LowIntermediaryRepresentation.Instructions.ImportCall: return
        LowIntermediaryRepresentation.Instructions.CompareExchange: return
        LowIntermediaryRepresentation.Instructions.Stop: return
        LowIntermediaryRepresentation.Instructions.Exit: return
        LowIntermediaryRepresentation.Instructions.VectorLoop: return
        LowIntermediaryRepresentation.Instructions.Select: return
    }
}

func note_a_constant(constant: LowIntermediaryRepresentation.Instructions.Constant) {
    fallback defined_once(constant.target)
    facts.constant_known[constant.target] = true
    facts.constant_values[constant.target] = constant.number
}

func note_a_load_shape(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    fallback defined_once(loaded.target) and not loaded.is_swapped
    var bytes = bytes_of(loaded.width)
    facts.shapes[loaded.target] = facts.shape_code(bytes, loaded.is_signed)
}

func note_an_arithmetic_shape(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic) {
    fallback defined_once(arithmetic.target)
    fallback arithmetic.operator != 'divide' and arithmetic.operator != 'remainder'
    var bytes = bytes_of(arithmetic.width)
    facts.shapes[arithmetic.target] = facts.shape_code(bytes, arithmetic.is_signed)
}

func note_a_decimal_shape(arithmetic: LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic) {
    fallback defined_once(arithmetic.target) and not arithmetic.is_double
    facts.shapes[arithmetic.target] = facts.shape_code(4, false)
}

func bytes_of(width: LowIntermediaryRepresentation.Instructions.Load.Width): Integer {
    switch width {
        'bits_8': return 1
        'bits_16': return 2
        'bits_32': return 4
        'bits_64': return 8
    }
}

func join(first: Integer, second: Integer) {
    var first_root = facts.root_of(first)
    var second_root = facts.root_of(second)
    if first_root != second_root {
        facts.parents[second_root] = first_root
    }
}

func join_the_copies() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(join_a_copy)
        block_index = block_index + 1
    }
}

func join_a_copy(instruction: SpiteCompiler.Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy and instruction.source >= 0 and instruction.target >= 0 {
        join(instruction.target, instruction.source)
    }
}

func fill_the_roots() {
    var index = 0
    while index < facts.register_total {
        allocated.append(false)
        escaped.append(false)
        passed.append(false)
        compared.append(false)
        returned.append(false)
        facts.allocation_sizes.append(-1)
        class_ids.append(-1)
        texts.append(false)
        derived_from.append(-1)
        facts.modes.append(0)
        facts.plain.append(false)
        facts.field_counts.append(0)
        facts.count_read.append(false)
        var children = List<Integer>()
        facts.free_children.append(children)
        index = index + 1
    }
}

func mark_escaped(register: Integer) {
    if register >= 0 and register < facts.register_total {
        var root = facts.root_of(register)
        escaped[root] = true
    }
}

func study_the_uses() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(study_an_instruction)
        block_index = block_index + 1
    }
}

func study_an_instruction(instruction: SpiteCompiler.Instruction) {
    operands.read(instruction)
    var is_made = instruction.class == LowIntermediaryRepresentation.Instructions.Allocate
    var is_copied = instruction.class == LowIntermediaryRepresentation.Instructions.Copy
    if not is_made and not is_copied {
        operands.defines.each(mark_escaped)
    }
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Allocate: study_an_allocation(instruction)
        LowIntermediaryRepresentation.Instructions.Copy: return
        LowIntermediaryRepresentation.Instructions.Load: study_a_load(instruction)
        LowIntermediaryRepresentation.Instructions.Store: study_a_store(instruction)
        LowIntermediaryRepresentation.Instructions.Retain: return
        LowIntermediaryRepresentation.Instructions.Call: study_a_call(instruction)
        LowIntermediaryRepresentation.Instructions.Return: study_a_return(instruction)
        LowIntermediaryRepresentation.Instructions.Constant: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Arithmetic: derivations.append(instruction)
        LowIntermediaryRepresentation.Instructions.Check: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Compare: study_a_compare(instruction)
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.CallAt: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.ForeignAddress: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.DataAddress: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.FunctionAddress: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Free: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Resize: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.CopyBytes: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.OpenLibrary: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Jump: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Branch: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.FrameAddress: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.FrameRoom: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.StartThread: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.JoinThread: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.AtomicAdd: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.ImportCall: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.CompareExchange: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Stop: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Exit: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.VectorLoop: operands.uses.each(mark_escaped)
        LowIntermediaryRepresentation.Instructions.Select: operands.uses.each(mark_escaped)
    }
}

func study_a_return(returning: LowIntermediaryRepresentation.Instructions.Return) {
    mark_escaped(returning.presence)
    if returning.is_a_suspension {
        mark_escaped(returning.source)
        return
    }
    if returning.source >= 0 {
        var root = facts.root_of(returning.source)
        returned[root] = true
    }
}

# ../../OPTIMIZATIONS.md#an-object-compared-for-sameness-lives-in-the-frame
func study_a_compare(comparing: LowIntermediaryRepresentation.Instructions.Compare) {
    var asks_sameness = comparing.comparison == 'equal' or comparing.comparison == 'not_equal'
    if not asks_sameness {
        operands.uses.each(mark_escaped)
        return
    }
    operands.uses.each(mark_compared)
}

func mark_compared(register: Integer) {
    if register >= 0 and register < facts.register_total {
        var root = facts.root_of(register)
        compared[root] = true
    }
}

func study_an_allocation(allocate: LowIntermediaryRepresentation.Instructions.Allocate) {
    var root = facts.root_of(allocate.target)
    allocated[root] = true
    if program.text_class_id >= 0 and allocate.class_id == program.text_class_id {
        texts[root] = true
        return
    }
    if facts.constant_known[allocate.size] != true {
        escaped[root] = true
        return
    }
    var value = facts.constant_values[allocate.size]
    crash value
    var size: Integer = value
    var earlier = facts.allocation_sizes[root]
    crash earlier
    if earlier >= 0 and earlier != size {
        escaped[root] = true
    }
    facts.allocation_sizes[root] = size
}

func study_a_load(loaded: LowIntermediaryRepresentation.Instructions.Load) {
    if loaded.is_swapped {
        mark_escaped(loaded.address)
        return
    }
    var root = facts.root_of(loaded.address)
    var bytes = bytes_of(loaded.width)
    var sign = 2
    if loaded.is_signed {
        sign = 1
    }
    note_a_field(root, loaded.offset, bytes, sign)
    if loaded.offset == 8 {
        facts.count_read[root] = true
    }
}

func study_a_store(stored: LowIntermediaryRepresentation.Instructions.Store) {
    mark_escaped(stored.source)
    if stored.is_swapped {
        mark_escaped(stored.address)
        return
    }
    var root = facts.root_of(stored.address)
    var bytes = bytes_of(stored.width)
    note_a_field(root, stored.offset, bytes, 0)
    if stored.offset == 0 {
        note_the_class(root, stored)
    }
}

func note_the_class(root: Integer, stored: LowIntermediaryRepresentation.Instructions.Store) {
    var known = class_ids[root]
    crash known
    if stored.width != 'bits_64' or facts.constant_known[stored.source] != true {
        class_ids[root] = -2
        return
    }
    var value = facts.constant_values[stored.source]
    crash value
    if known == -1 or known == value {
        class_ids[root] = value
        return
    }
    class_ids[root] = -2
}

func study_a_call(call: LowIntermediaryRepresentation.Instructions.Call) {
    fallback call.function != "_release" or call.arguments.count() != 1
    var frees = call.function == "_free_by_class" or call.function == "_free_String"
    if frees and call.arguments.count() == 1 {
        freeing_calls.append(call)
        return
    }
    study_the_arguments(call)
}

func study_the_arguments(call: LowIntermediaryRepresentation.Instructions.Call) {
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        if argument >= 0 {
            var root = facts.root_of(argument)
            if keeping.keeps_nothing_of(call.function, index) {
                passed[root] = true
                if keeping.reads_the_count_of(call.function, index) {
                    facts.count_read[root] = true
                }
            } else {
                escaped[root] = true
            }
        }
        index = index + 1
    }
}

func note_a_field(root: Integer, offset: Integer, bytes: Integer, sign: Integer) {
    var index = 0
    while index < facts.field_roots.count() {
        var owner = facts.field_roots[index]
        var start = facts.field_offsets[index]
        var width = facts.field_widths[index]
        crash start
        crash width
        if owner == root {
            if start == offset and width == bytes {
                widen_the_sign(index, sign)
                return
            }
            if offset < start + width and start < offset + bytes {
                escaped[root] = true
            }
        }
        index = index + 1
    }
    facts.field_roots.append(root)
    facts.field_offsets.append(offset)
    facts.field_widths.append(bytes)
    facts.field_signs.append(sign)
    var count = facts.field_counts[root]
    crash count
    facts.field_counts[root] = count + 1
}

func widen_the_sign(index: Integer, sign: Integer) {
    var known = facts.field_signs[index]
    crash known
    fallback sign != 0 and known != sign
    if known == 0 {
        facts.field_signs[index] = sign
        return
    }
    facts.field_signs[index] = 3
}

func choose_the_modes() {
    flow.find_the_edges(function)
    var root = 0
    while root < facts.register_total {
        if allocated[root] == true and escaped[root] == false and facts.root_of(root) == root {
            choose_a_mode(root)
        }
        root = root + 1
    }
}

func choose_a_mode(root: Integer) {
    if texts[root] == true {
        choose_a_room_for_a_text(root)
        return
    }
    fallback fields_fit(root)
    var class_id = class_ids[root]
    crash class_id
    fallback class_id >= 0
    var class_number: Integer = class_id
    var free_key = program.free_keys[class_number]
    fallback free_key
    if free_key == "_free_Buffer" {
        choose_a_room_for_bytes(root)
        return
    }
    var freeing = keeping.function_named(free_key)
    fallback freeing
    fallback read_the_free(root, freeing)
    var is_plain = facts.plain[root] == true
    var is_returned = returned[root] == true
    fallback is_plain or not is_returned
    var members = members_of(root)
    var shared = passed[root] != true and compared[root] != true and fits_in_registers(root)
    var one_at_a_time = flow.holds_one_at_a_time(function, members)
    if shared and one_at_a_time and (is_plain or facts.count_field_of(root) >= 0) {
        facts.modes[root] = 1
        return
    }
    if shared and is_plain and flow.copies_are_moves(function, members) {
        facts.modes[root] = 2
        return
    }
    var size = facts.allocation_sizes[root]
    crash size
    fallback is_plain and size <= largest_room and not is_returned
    if one_at_a_time or not flow.allocates_in_a_loop(function, members) {
        facts.modes[root] = 3
    }
}

# ../../OPTIMIZATIONS.md#a-buffer-that-never-leaves-its-function-lives-in-the-frame
func choose_a_room_for_bytes(root: Integer) {
    fallback program.buffer_inside_flag >= 0 and returned[root] != true
    var size = facts.allocation_sizes[root]
    crash size
    fallback size <= largest_room and not flagged_by_its_function(root)
    var members = members_of(root)
    if flow.holds_one_at_a_time(function, members) or not flow.allocates_in_a_loop(function, members) {
        facts.inside_flag = program.buffer_inside_flag
        facts.modes[root] = 4
    }
}

# ../../OPTIMIZATIONS.md#a-short-text-that-never-leaves-its-function-lives-in-the-frame
func choose_a_room_for_a_text(root: Integer) {
    var class_id = class_ids[root]
    crash class_id
    var text_class: Long = program.text_class_id
    fallback returned[root] != true and class_id == text_class
    fallback marks_its_place_bytewise(root) and keeping.keeps_no_text_buffer(program)
    var members = members_of(root)
    if flow.holds_one_at_a_time(function, members) or not flow.allocates_in_a_loop(function, members) {
        facts.text_flag = program.text_flag
        facts.short_text_block = program.short_text_block
        facts.modes[root] = 5
    }
}

# ../../OPTIMIZATIONS.md#a-short-text-that-never-leaves-its-function-lives-in-the-frame
func settle_the_derivations() {
    var changed = true
    while changed {
        changed = false
        var index = 0
        while index < derivations.count() {
            var instruction = derivations[index]
            if derive(instruction) {
                changed = true
            }
            index = index + 1
        }
        if derive_the_buffer_reads() {
            changed = true
        }
    }
    var settling = 0
    while settling < derivations.count() {
        var instruction = derivations[settling]
        if derived_text_of(instruction.target) < 0 {
            operands.read(instruction)
            operands.uses.each(mark_escaped)
        }
        settling = settling + 1
    }
}

func derive(instruction: LowIntermediaryRepresentation.Instructions.Arithmetic): Boolean {
    fallback instruction.operator == 'add'
    fallback defined_once(instruction.target) and text_of(instruction.target) < 0
    var left_text = text_of(instruction.left)
    var right_text = text_of(instruction.right)
    var text = left_text
    if right_text >= 0 {
        text = right_text
    }
    fallback text >= 0 and (left_text < 0 or right_text < 0)
    var target_root = facts.root_of(instruction.target)
    derived_from[target_root] = text
    return true
}

func derive_the_buffer_reads(): Boolean {
    var found = false
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            if derive_a_buffer_read(instruction) {
                found = true
            }
            index = index + 1
        }
        block_index = block_index + 1
    }
    return found
}

func derive_a_buffer_read(instruction: SpiteCompiler.Instruction): Boolean {
    fallback instruction.class == LowIntermediaryRepresentation.Instructions.Load
    fallback instruction.offset == program.text_buffer_slot and instruction.width == 'bits_64'
    fallback instruction.address >= 0 and instruction.address < facts.register_total
    var owner = facts.root_of(instruction.address)
    fallback texts[owner] == true and text_of(instruction.target) < 0
    if not defined_once(instruction.target) {
        escaped[owner] = true
        return false
    }
    var target_root = facts.root_of(instruction.target)
    derived_from[target_root] = owner
    return true
}

func text_of(register: Integer): Integer {
    fallback register >= 0 and register < facts.register_total
    var root = facts.root_of(register)
    if texts[root] == true {
        return root
    }
    var known = derived_from[root]
    crash known
    return known
}

func derived_text_of(register: Integer): Integer {
    fallback register >= 0 and register < facts.register_total
    var root = facts.root_of(register)
    var known = derived_from[root]
    crash known
    return known
}

func settle_the_freeing_calls() {
    var index = 0
    while index < freeing_calls.count() {
        var call = freeing_calls[index]
        var argument = call.arguments[0]
        crash argument
        var root = facts.root_of(argument)
        if texts[root] != true {
            study_the_arguments(call)
        }
        index = index + 1
    }
}

func study_the_derived() {
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(study_a_derived_use)
        block_index = block_index + 1
    }
}

func study_a_derived_use(instruction: SpiteCompiler.Instruction) {
    operands.read(instruction)
    var used_registers = operands.uses.copy()
    var index = 0
    while index < used_registers.count() {
        var used = used_registers[index]
        crash used
        var text = derived_text_of(used)
        if text >= 0 and not keeps_the_text_inside(instruction, used, text) {
            escaped[text] = true
        }
        index = index + 1
    }
}

func keeps_the_text_inside(instruction: SpiteCompiler.Instruction, used: Integer, text: Integer): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.Copy: return true
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.Store: return stores_inside(instruction, used, text)
        LowIntermediaryRepresentation.Instructions.Arithmetic: return derived_text_of(instruction.target) == text
        LowIntermediaryRepresentation.Instructions.Call: return reads_only(instruction, used)
        LowIntermediaryRepresentation.Instructions.Constant: return false
        LowIntermediaryRepresentation.Instructions.Check: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Compare: return false
        LowIntermediaryRepresentation.Instructions.Decimal.Conversion: return false
        LowIntermediaryRepresentation.Instructions.CallAt: return false
        LowIntermediaryRepresentation.Instructions.ForeignAddress: return false
        LowIntermediaryRepresentation.Instructions.DataAddress: return false
        LowIntermediaryRepresentation.Instructions.FunctionAddress: return false
        LowIntermediaryRepresentation.Instructions.Allocate: return false
        LowIntermediaryRepresentation.Instructions.Retain: return false
        LowIntermediaryRepresentation.Instructions.Free: return false
        LowIntermediaryRepresentation.Instructions.Resize: return false
        LowIntermediaryRepresentation.Instructions.OpenLibrary: return false
        LowIntermediaryRepresentation.Instructions.Jump: return false
        LowIntermediaryRepresentation.Instructions.Branch: return false
        LowIntermediaryRepresentation.Instructions.Return: return false
        LowIntermediaryRepresentation.Instructions.FrameAddress: return false
        LowIntermediaryRepresentation.Instructions.ThreadIdentity: return false
        LowIntermediaryRepresentation.Instructions.FrameRoom: return false
        LowIntermediaryRepresentation.Instructions.StartThread: return false
        LowIntermediaryRepresentation.Instructions.JoinThread: return false
        LowIntermediaryRepresentation.Instructions.AtomicAdd: return false
        LowIntermediaryRepresentation.Instructions.ImportCall: return false
        LowIntermediaryRepresentation.Instructions.CompareExchange: return false
        LowIntermediaryRepresentation.Instructions.Stop: return false
        LowIntermediaryRepresentation.Instructions.Exit: return false
        LowIntermediaryRepresentation.Instructions.VectorLoop: return false
        LowIntermediaryRepresentation.Instructions.Select: return false
    }
}

func stores_inside(stored: LowIntermediaryRepresentation.Instructions.Store, used: Integer, text: Integer): Boolean {
    if stored.source != used {
        return true
    }
    return text_of(stored.address) == text
}

func reads_only(call: LowIntermediaryRepresentation.Instructions.Call, used: Integer): Boolean {
    fallback call.function != "_release" and call.function != "_free_by_class"
    var index = 0
    while index < call.arguments.count() {
        var argument = call.arguments[index]
        fallback argument != used or keeping.keeps_nothing_of(call.function, index)
        index = index + 1
    }
    return true
}

func marks_its_place_bytewise(root: Integer): Boolean {
    var flag = program.text_flag
    var index = 0
    while index < facts.field_roots.count() {
        var owner = facts.field_roots[index]
        var start = facts.field_offsets[index]
        var width = facts.field_widths[index]
        crash start
        crash width
        var covers = owner == root and start <= flag and flag < start + width
        fallback not covers or start == flag and width == 1
        index = index + 1
    }
    return true
}

func flagged_by_its_function(root: Integer): Boolean {
    var index = 0
    while index < facts.field_roots.count() {
        var owner = facts.field_roots[index]
        var start = facts.field_offsets[index]
        var width = facts.field_widths[index]
        crash start
        crash width
        var flag = program.buffer_inside_flag
        if owner == root and start <= flag + 1 and flag < start + width {
            return true
        }
        index = index + 1
    }
    return false
}

func members_of(root: Integer): List<Boolean> {
    var members = List<Boolean>()
    var index = 0
    while index < facts.register_total {
        var joined = facts.root_of(index)
        members.append(joined == root)
        index = index + 1
    }
    return members
}

func fields_fit(root: Integer): Boolean {
    var size = facts.allocation_sizes[root]
    crash size
    var index = 0
    while index < facts.field_roots.count() {
        var owner = facts.field_roots[index]
        var start = facts.field_offsets[index]
        var width = facts.field_widths[index]
        crash start
        crash width
        fallback owner != root or start >= 0 and start + width <= size
        index = index + 1
    }
    return true
}

func fits_in_registers(root: Integer): Boolean {
    var count = facts.field_counts[root]
    crash count
    fallback count <= largest_field_count
    var index = 0
    while index < facts.field_roots.count() {
        var owner = facts.field_roots[index]
        var sign = facts.field_signs[index]
        fallback owner != root or sign != 3
        index = index + 1
    }
    return true
}

func read_the_free(root: Integer, freeing: LowIntermediaryRepresentation.LowFunction): Boolean {
    fallback freeing.parameter_count == 1
    var children = List<Integer>()
    var released = released_children(freeing, children)
    if not released {
        children = List<Integer>()
        released = inlined_children(freeing, children)
    }
    fallback released
    facts.free_children[root] = children
    facts.plain[root] = children.is_empty()
    fallback escaped[root] != true
    var child_index = 0
    while child_index < children.count() {
        var child = children[child_index]
        var field = facts.field_of(root, child)
        if field < 0 {
            note_a_field(root, child, 8, 0)
        }
        child_index = child_index + 1
    }
    return escaped[root] != true
}

func released_children(freeing: LowIntermediaryRepresentation.LowFunction, children: List<Integer>): Boolean {
    fallback freeing.blocks.count() == 1
    var block = freeing.blocks[0]
    var count = block.instructions.count()
    fallback count >= 2
    var index = 0
    while index + 2 < count {
        var loaded = block.instructions[index]
        var called = block.instructions[index + 1]
        var offset = released_offset(loaded, called)
        fallback offset >= 0
        children.append(offset)
        index = index + 2
    }
    fallback index + 2 == count
    var freed = block.instructions[index]
    var returned = block.instructions[index + 1]
    crash freed
    crash returned
    return frees_the_object(freed) and returns_nothing(returned)
}

func inlined_children(freeing: LowIntermediaryRepresentation.LowFunction, children: List<Integer>): Boolean {
    var reading = Proofs.ObjectsInTheFrame.InlinedFree(freeing)
    fallback reading.read()
    var index = 0
    while index < reading.offsets.count() {
        var offset = reading.offsets[index]
        children.append(offset)
        index = index + 1
    }
    return true
}

func released_offset(loaded: SpiteCompiler.Instruction, called: SpiteCompiler.Instruction): Integer {
    if loaded.class == LowIntermediaryRepresentation.Instructions.Load {
        if loaded.address != 0 or loaded.width != 'bits_64' or loaded.is_swapped {
            return -1
        }
        if called.class == LowIntermediaryRepresentation.Instructions.Call {
            var releases = called.function == "_release" and called.arguments.count() == 1
            if releases and called.arguments.contains(loaded.target) and loaded.offset >= 16 {
                return loaded.offset
            }
        }
    }
    return -1
}

func frees_the_object(instruction: SpiteCompiler.Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Free {
        return instruction.pointer == 0
    }
    return false
}

func returns_nothing(instruction: SpiteCompiler.Instruction): Boolean {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Return {
        return instruction.source < 0 and instruction.presence < 0
    }
    return false
}

func any_mode(): Boolean {
    var root = 0
    while root < facts.register_total {
        if facts.modes[root] != 0 {
            return true
        }
        root = root + 1
    }
    return false
}

union Instruction {
    LowIntermediaryRepresentation.Instructions.Constant
    LowIntermediaryRepresentation.Instructions.Copy
    LowIntermediaryRepresentation.Instructions.Arithmetic
    LowIntermediaryRepresentation.Instructions.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Arithmetic
    LowIntermediaryRepresentation.Instructions.Decimal.Compare
    LowIntermediaryRepresentation.Instructions.Decimal.Conversion
    LowIntermediaryRepresentation.Instructions.Load
    LowIntermediaryRepresentation.Instructions.Store
    LowIntermediaryRepresentation.Instructions.Call
    LowIntermediaryRepresentation.Instructions.CallAt
    LowIntermediaryRepresentation.Instructions.ForeignAddress
    LowIntermediaryRepresentation.Instructions.DataAddress
    LowIntermediaryRepresentation.Instructions.FunctionAddress
    LowIntermediaryRepresentation.Instructions.Allocate
    LowIntermediaryRepresentation.Instructions.Retain
    LowIntermediaryRepresentation.Instructions.Free
    LowIntermediaryRepresentation.Instructions.Resize
    LowIntermediaryRepresentation.Instructions.CopyBytes
    LowIntermediaryRepresentation.Instructions.OpenLibrary
    LowIntermediaryRepresentation.Instructions.Jump
    LowIntermediaryRepresentation.Instructions.Branch
    LowIntermediaryRepresentation.Instructions.Return
    LowIntermediaryRepresentation.Instructions.FrameAddress
    LowIntermediaryRepresentation.Instructions.ThreadIdentity
    LowIntermediaryRepresentation.Instructions.FrameRoom
    LowIntermediaryRepresentation.Instructions.StartThread
    LowIntermediaryRepresentation.Instructions.JoinThread
    LowIntermediaryRepresentation.Instructions.AtomicAdd
    LowIntermediaryRepresentation.Instructions.ImportCall
    LowIntermediaryRepresentation.Instructions.CompareExchange
    LowIntermediaryRepresentation.Instructions.Stop
    LowIntermediaryRepresentation.Instructions.Exit
    LowIntermediaryRepresentation.Instructions.VectorLoop
    LowIntermediaryRepresentation.Instructions.Select
}

var lowered_by_key = Dictionary<String, LowIntermediaryRepresentation.LowFunction>()
var answers = Dictionary<String, Integer>()
var operands = LowOptimizationPasses.Operands()
var parents = List<Integer>()
var derived = List<Boolean>()

func read_the_program(program: LowIntermediaryRepresentation.LoweredProgram) {
    program.lowered_functions.each(note_a_function)
}

func note_a_function(function: LowIntermediaryRepresentation.LowFunction) {
    lowered_by_key[function.key] = function
}

func function_named(key: String): LowIntermediaryRepresentation.LowFunction? {
    return lowered_by_key[key]
}

func keeps_nothing_of(key: String, index: Integer): Boolean {
    var asked = "{key}#{index}"
    var known = answers[asked]
    if known {
        return known == 1
    }
    answers[asked] = 2
    var found = lowered_by_key[key]
    var answer = false
    if found {
        answer = only_reads(found, index)
    }
    var kept = 2
    if answer {
        kept = 1
    }
    answers[asked] = kept
    return answer
}

func only_reads(function: LowIntermediaryRepresentation.LowFunction, parameter: Integer): Boolean {
    fallback not function.is_resumable and parameter < function.parameter_count
    join_the_copies(function)
    var root = root_of(parameter)
    find_the_derived(function, root)
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var index = 0
        while index < block.instructions.count() {
            var instruction = block.instructions[index]
            fallback keeps_none(instruction, root)
            index = index + 1
        }
        block_index = block_index + 1
    }
    return true
}

func keeps_none(instruction: Instruction, root: Integer): Boolean {
    switch instruction {
        LowIntermediaryRepresentation.Instructions.Copy: return not is_derived(instruction.source)
        LowIntermediaryRepresentation.Instructions.Compare: return true
        LowIntermediaryRepresentation.Instructions.Load: return true
        LowIntermediaryRepresentation.Instructions.CopyBytes: return true
        LowIntermediaryRepresentation.Instructions.Store: return keeps_none_by_storing(instruction, root)
        LowIntermediaryRepresentation.Instructions.Arithmetic: return derives_only(instruction, root)
        LowIntermediaryRepresentation.Instructions.Call: return passes_to_a_reader(instruction, root)
        _: return not uses_the_group(instruction, root) and not uses_a_derived(instruction)
    }
}

# ../../OPTIMIZATIONS.md#a-buffer-that-never-leaves-its-function-lives-in-the-frame
func keeps_none_by_storing(stored: LowIntermediaryRepresentation.Instructions.Store, root: Integer): Boolean {
    fallback not in_the_group(stored.source, root)
    if is_derived(stored.source) {
        return in_the_group(stored.address, root)
    }
    return true
}

func passes_to_a_reader(call: LowIntermediaryRepresentation.Instructions.Call, root: Integer): Boolean {
    var held_parents = parents
    var held_derived = derived
    var index = 0
    var answer = true
    while answer and index < call.arguments.count() {
        var argument = call.arguments[index]
        crash argument
        parents = held_parents
        derived = held_derived
        var is_ours = in_the_group(argument, root)
        if is_derived(argument) {
            answer = false
        } else if is_ours {
            answer = keeps_nothing_of(call.function, index)
        }
        index = index + 1
    }
    parents = held_parents
    derived = held_derived
    return answer
}

func derives_only(arithmetic: LowIntermediaryRepresentation.Instructions.Arithmetic, root: Integer): Boolean {
    if is_derived(arithmetic.target) {
        return true
    }
    return not uses_the_group(arithmetic, root) and not uses_a_derived(arithmetic)
}

func find_the_derived(function: LowIntermediaryRepresentation.LowFunction, root: Integer) {
    derived = List<Boolean>()
    var defined = List<Integer>()
    var index = 0
    while index < parents.count() {
        derived.append(false)
        defined.append(0)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var at = 0
        while at < block.instructions.count() {
            var instruction = block.instructions[at]
            operands.read(instruction)
            var defining = 0
            while defining < operands.defines.count() {
                var target = operands.defines[defining]
                crash target
                if target >= 0 and target < defined.count() {
                    var before = defined[target]
                    crash before
                    defined[target] = before + 1
                }
                defining = defining + 1
            }
            at = at + 1
        }
        block_index = block_index + 1
    }
    block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        var at = 0
        while at < block.instructions.count() {
            var instruction = block.instructions[at]
            note_a_derived(instruction, root, defined, function.parameter_count)
            at = at + 1
        }
        block_index = block_index + 1
    }
}

func note_a_derived(
    instruction: Instruction,
    root: Integer,
    defined: List<Integer>,
    parameter_count: Integer,
) {
    fallback instruction.class == LowIntermediaryRepresentation.Instructions.Arithmetic and instruction.operator == 'add'
    var target = instruction.target
    fallback target >= parameter_count and target < defined.count() and defined[target] == 1
    var left_joined = in_the_group(instruction.left, root)
    var right_joined = in_the_group(instruction.right, root)
    if left_joined != right_joined and not is_derived(instruction.left) and not is_derived(instruction.right) {
        derived[target] = true
    }
}

func is_derived(register: Integer): Boolean {
    fallback register >= 0 and register < derived.count()
    return derived[register] == true
}

func uses_a_derived(instruction: Instruction): Boolean {
    operands.read(instruction)
    var index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        if is_derived(used) {
            return true
        }
        index = index + 1
    }
    return false
}

func uses_the_group(instruction: Instruction, root: Integer): Boolean {
    operands.read(instruction)
    var index = 0
    while index < operands.uses.count() {
        var used = operands.uses[index]
        if in_the_group(used, root) {
            return true
        }
        index = index + 1
    }
    return false
}

func in_the_group(register: Integer, root: Integer): Boolean {
    fallback register >= 0 and register < parents.count()
    return root_of(register) == root
}

func join_the_copies(function: LowIntermediaryRepresentation.LowFunction) {
    parents = List<Integer>()
    var total = operands.most_register_of(function)
    var index = 0
    while index < total {
        parents.append(index)
        index = index + 1
    }
    var block_index = 0
    while block_index < function.blocks.count() {
        var block = function.blocks[block_index]
        block.instructions.each(join_a_copy)
        block_index = block_index + 1
    }
}

func join_a_copy(instruction: Instruction) {
    if instruction.class == LowIntermediaryRepresentation.Instructions.Copy and instruction.source >= 0 and instruction.target >= 0 {
        var first = root_of(instruction.target)
        var second = root_of(instruction.source)
        if first != second {
            parents[second] = first
        }
    }
}

func root_of(register: Integer): Integer {
    var current = register
    var parent = parents[current]
    crash parent
    while parent != current {
        current = parent
        var further = parents[current]
        crash further
        parent = further
    }
    return current
}

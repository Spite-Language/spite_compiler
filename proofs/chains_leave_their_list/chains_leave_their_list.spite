# ../../PROOFS.md#a-fused-chain-leaves-its-first-list
var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var assignments: HighIntermediaryRepresentation.Assignments? = null
var changing_member = ""

func ChainsLeaveTheirList(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
}

# ../../PROOFS.md#a-fused-chain-leaves-its-first-list
func leaves(steps: List<Model.FunctionModel>, list_key: String): Boolean {
    changing_member = ""
    var index = 0
    while index < steps.count() {
        var step = steps[index]
        var member_key = member_function_key(step)
        if not member_key.is_empty() and may_change(member_key, list_key) {
            changing_member = step.bound_member
            return false
        }
        index = index + 1
    }
    return true
}

func member_function_key(step: Model.FunctionModel): String {
    fallback not step.is_a_fused_step and step.bound_member_is_a_function
    var owner = high.model.class_named(step.owner)
    if not owner {
        return "$unknown"
    }
    var element_type = owner.bound_types["$element_type"]
    if not element_type {
        return "$unknown"
    }
    var element_class = high.model.class_named(element_type.name)
    if not element_class {
        return "$unknown"
    }
    var member = element_class.function_named(step.bound_member)
    if not member {
        return "$unknown"
    }
    return member.key()
}

func may_change(member_key: String, list_key: String): Boolean {
    if not assignments {
        assignments = HighIntermediaryRepresentation.Assignments(high)
    }
    crash assignments
    if assignments.reaches_a_writer(member_key, "[]{list_key}", "[+]{list_key}") {
        return true
    }
    var list_class = high.model.class_named(list_key)
    if not list_class {
        return true
    }
    var index = 0
    while index < list_class.declared_attributes.count() {
        var attribute = list_class.declared_attributes[index]
        var attribute_key = "{attribute.owner}.{attribute.name}"
        if assignments.reaches_a_writer(member_key, attribute_key, "?.{attribute.name}") {
            return true
        }
        index = index + 1
    }
    return false
}

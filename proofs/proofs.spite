# ../PROOFS.md

var proofs = List<SpiteCompiler.Proof>()
var running = false
var recorded_sites = RecordedSites.Proof()

func Proofs() {
    var proven_present = ProvenPresent.Proof()
    register(proven_present)
    recorded_sites = RecordedSites.Proof()
    register(recorded_sites)
    var rules_after_building = RulesAfterBuilding.Proof()
    register(rules_after_building)
    var switch_cover = SwitchCover.Proof()
    register(switch_cover)
    var vector_fit = VectorFit.Proof()
    register(vector_fit)
    var facts = CompileTimeFacts.Proof()
    register(facts)
    var literal_dictionaries = LiteralDictionaries.Proof()
    register(literal_dictionaries)
    var folded_crashes = FoldedCrashes.Proof()
    register(folded_crashes)
    var read_attributes = EveryAttributeIsRead.Proof()
    register(read_attributes)
    var read_preloads = EveryPreloadIsRead.Proof()
    register(read_preloads)
    var kept_narrowings = NarrowingsKeptAcrossCalls.Proof()
    register(kept_narrowings)
    var ranges = Ranges.Proof()
    register(ranges)
    var narrowings_fit = NarrowingsFit.Proof()
    register(narrowings_fit)
    var setup_lists = SetupLists.Proof()
    register(setup_lists)
    var lists_in_the_frame = ListsInTheFrame.Proof()
    register(lists_in_the_frame)
    var reload_changed_classes = ReloadChangedClasses.Proof()
    register(reload_changed_classes)
}

func register(proof: SpiteCompiler.Proof) {
    crash not running
    proofs.append(proof)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < proofs.count() {
        var proof = proofs[index]
        proof.check(high)
        index = index + 1
    }
    return high
}

# ../PROOFS.md
type Proof {
    check(HighIntermediaryRepresentation.HighProgram)
}

type LowProof {
    proved(LowIntermediaryRepresentation.LoweredProgram)
}

var proofs = List<Proof>()
var running = false
var recorded_sites = Proofs.RecordedSites.RecordedSites()

func Proofs() {
    recorded_sites = Proofs.RecordedSites.RecordedSites()
    register(recorded_sites)
    var rules_after_building = Proofs.RulesAfterBuilding.RulesAfterBuilding()
    register(rules_after_building)
    var switch_cover = Proofs.SwitchCover.SwitchCover()
    register(switch_cover)
    var vector_fit = Proofs.VectorFit.VectorFit()
    register(vector_fit)
    var lent_parameters = Proofs.LentParameters.LentParameters()
    register(lent_parameters)
    var facts = Proofs.CompileTimeFacts.CompileTimeFacts()
    register(facts)
    var literal_dictionaries = Proofs.LiteralDictionaries.LiteralDictionaries()
    register(literal_dictionaries)
    var folded_crashes = Proofs.FoldedCrashes.FoldedCrashes()
    register(folded_crashes)
    var read_attributes = Proofs.EveryAttributeIsRead.EveryAttributeIsRead()
    register(read_attributes)
    var kept_narrowings = Proofs.NarrowingsKeptAcrossCalls.NarrowingsKeptAcrossCalls()
    register(kept_narrowings)
    var registered_in_setup = Proofs.RegisteredInSetup.RegisteredInSetup()
    register(registered_in_setup)
    var ranges = Proofs.Ranges.Ranges()
    register(ranges)
    var setup_lists = Proofs.SetupLists.SetupLists()
    register(setup_lists)
    var lists_in_the_frame = Proofs.ListsInTheFrame.ListsInTheFrame()
    register(lists_in_the_frame)
}

func register(proof: Proof) {
    crash not running
    proofs.append(proof)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < proofs.count() {
        var proof = proofs[index]
        proof.check(high)
        index = index + 1
    }
    return high
}

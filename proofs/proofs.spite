# ../PROOFS.md

var proofs = List<SpiteCompiler.Proof>()
var running = false
var recorded_sites = Proofs.RecordedSites.Proof()

func Proofs() {
    var proven_present = Proofs.ProvenPresent.Proof()
    register(proven_present)
    recorded_sites = Proofs.RecordedSites.Proof()
    register(recorded_sites)
    var rules_after_building = Proofs.RulesAfterBuilding.Proof()
    register(rules_after_building)
    var switch_cover = Proofs.SwitchCover.Proof()
    register(switch_cover)
    var vector_fit = Proofs.VectorFit.Proof()
    register(vector_fit)
    var facts = Proofs.CompileTimeFacts.Proof()
    register(facts)
    var literal_dictionaries = Proofs.LiteralDictionaries.Proof()
    register(literal_dictionaries)
    var folded_crashes = Proofs.FoldedCrashes.Proof()
    register(folded_crashes)
    var read_attributes = Proofs.EveryAttributeIsRead.Proof()
    register(read_attributes)
    var kept_narrowings = Proofs.NarrowingsKeptAcrossCalls.Proof()
    register(kept_narrowings)
    var ranges = Proofs.Ranges.Proof()
    register(ranges)
    var setup_lists = Proofs.SetupLists.Proof()
    register(setup_lists)
    var lists_in_the_frame = Proofs.ListsInTheFrame.Proof()
    register(lists_in_the_frame)
    var reload_changed_classes = Proofs.ReloadChangedClasses.Proof()
    register(reload_changed_classes)
}

func register(proof: SpiteCompiler.Proof) {
    crash not running
    proofs.append(proof)
}

func run(high: HighIntermediaryRepresentation.HighProgram): HighIntermediaryRepresentation.HighProgram {
    running = true
    var index = 0
    while index < proofs.count() {
        var proof = proofs[index]
        proof.check(high)
        index = index + 1
    }
    return high
}

# ../../PROOFS.md#no-other-thread-counts-a-class
func check(high: HighIntermediaryRepresentation.HighProgram) {
    assert high.will_be_lowered()
    crash high.waits
    var waits = high.waits
    high.counts_every_class_atomically = true
    assert not waits.has_callbacks
    var reach = ThreadReach(high, waits.taken_as_values)
    add_the_roots(reach, waits.started_in_parallel)
    add_the_roots(reach, waits.started)
    reach.follow_every_root()
    assert not reach.reaches_every_class
    high.thread_counted_classes = reach.counted_classes
    high.counts_every_class_atomically = false
}

func add_the_roots(reach: ThreadReach, keys: List<String>) {
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        reach.add_a_root(key)
        index = index + 1
    }
}

# ../../PROOFS.md#no-other-thread-counts-a-class
var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var built_by_key = Dictionary<String, HighIntermediaryRepresentation.HighFunction>()
var taken_as_values = List<String>()
var waiting = List<String>()
var seen = List<String>()
var counted_classes = List<String>()
var counts_the_taken_owners = false
var reaches_every_class = false

func ThreadReach(starting_high: HighIntermediaryRepresentation.HighProgram, starting_taken: List<String>) {
    high = starting_high
    taken_as_values = starting_taken
    var index = 0
    while index < starting_high.built_functions.count() {
        var built = starting_high.built_functions[index]
        var key = built.function.key()
        built_by_key[key] = built
        index = index + 1
    }
}

func add_a_root(key: String) {
    waiting.append(key)
}

func follow_every_root() {
    while not waiting.is_empty() {
        var key = waiting.remove_last()
        crash key
        if not seen.contains(key) {
            seen.append(key)
            follow_a_function(key)
        }
    }
}

func follow_a_function(key: String) {
    var built = built_by_key[key]
    assert built
    var model = built.function
    count_a_class(model.owner)
    var index = 0
    while index < model.parameters.count() {
        var parameter = model.parameters[index]
        count_a_type(parameter.parameter_type)
        index = index + 1
    }
    if model.answer {
        count_a_type(model.answer)
    }
    read_a_block(built.body)
}

func count_a_type(of_type: Model.Type) {
    var kind = of_type.kind
    if kind == 'object' {
        count_a_class(of_type.name)
    }
    if kind == 'union' {
        count_the_members(of_type.name)
    }
    if kind == 'shape' {
        count_the_fillers(of_type.name)
    }
    if kind == 'function' {
        count_the_owners_of_taken_functions()
    }
    of_type.members.each(count_a_type)
    of_type.parameters.each(count_a_type)
    assert of_type.answer
    count_a_type(of_type.answer)
}

func count_a_class(class_key: String) {
    assert not counted_classes.contains(class_key)
    var model = high.model.class_named(class_key)
    assert model
    counted_classes.append(class_key)
    var index = 0
    while index < model.declared_attributes.count() {
        var attribute = model.declared_attributes[index]
        count_a_type(attribute.attribute_type)
        index = index + 1
    }
    var bound = model.bound_types.keys()
    var bound_index = 0
    while bound_index < bound.count() {
        var name = bound[bound_index]
        crash name
        var bound_type = model.bound_types[name]
        crash bound_type
        count_a_type(bound_type)
        bound_index = bound_index + 1
    }
}

func count_the_members(union_key: String) {
    var parts = union_key.split(".")
    var simple = parts.remove_last()
    crash simple
    var owner_key = parts.join(".")
    var owner = high.model.class_named(owner_key)
    var found: Model.UnionModel? = null
    if owner {
        found = owner.union_named(simple)
    }
    if not found {
        reaches_every_class = true
        return
    }
    found.members.each(count_a_type)
}

func count_the_fillers(shape_key: String) {
    var fillers = high.model.fillers_of(shape_key)
    if fillers.is_empty() {
        reaches_every_class = true
    }
    fillers.each(count_a_type)
}

func count_the_owners_of_taken_functions() {
    assert not counts_the_taken_owners
    counts_the_taken_owners = true
    var index = 0
    while index < taken_as_values.count() {
        var key = taken_as_values[index]
        var parts = key.split(".")
        var last = parts.count() - 1
        parts.remove_at(last)
        var owner_key = parts.join(".")
        count_a_class(owner_key)
        index = index + 1
    }
}

func read_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(read_a_statement)
}

func read_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: read_a_declare(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: read_an_assign(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: read_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: read_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: read_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: read_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: read_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: read_a_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: read_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: read_a_block(statement)
    }
}

func read_a_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    count_a_type(declare.declared_type)
    read_a_value(declare.value)
}

func read_an_assign(assign: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    read_a_value(assign.value)
}

func read_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    read_a_value(returned.value)
}

func read_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    count_a_type(written.attribute.attribute_type)
    read_a_value(written.object)
    read_a_value(written.value)
}

func read_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    count_the_fillers(written.shape.key)
    read_a_value(written.object)
    read_a_value(written.value)
}

func read_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    read_a_value(evaluated.value)
    read_a_value(evaluated.waited)
}

func read_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    read_a_value(branch.condition)
    read_a_value(branch.decided_condition)
    read_a_block(branch.then_branch)
    read_a_block(branch.else_branch)
}

func read_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    read_a_value(loop.condition)
    read_a_block(loop.body)
}

func read_a_stop(stop: HighIntermediaryRepresentation.Statements.Stop) {
    stop.shown.each(read_a_present)
    read_a_value(stop.then)
}

func read_a_present(value: HighIntermediaryRepresentation.Values.Value) {
    read_a_value(value)
}

func read_a_value(value: HighIntermediaryRepresentation.Values.Value?) {
    assert value
    count_a_type(value.value_type)
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: read_a_value(value.object)
        HighIntermediaryRepresentation.Values.Call: read_a_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: read_a_making(value)
        HighIntermediaryRepresentation.Values.MachineOperation: read_both(value.left, value.right)
        HighIntermediaryRepresentation.Values.Negation: read_a_value(value.negated)
        HighIntermediaryRepresentation.Values.ForeignCall: read_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Test: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.PresenceTest: read_a_value(value.tested)
        HighIntermediaryRepresentation.Values.Conversion: read_a_value(value.converted)
        HighIntermediaryRepresentation.Values.Function.Value: read_a_value(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: read_a_function_value_call(value)
        HighIntermediaryRepresentation.Values.NumberRoom: read_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.ShapeCall: read_a_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: read_a_value(value.number)
        HighIntermediaryRepresentation.Values.EnumFromText: read_a_value(value.text)
        HighIntermediaryRepresentation.Values.Class.OfValue: read_a_value(value.described)
        _: return
    }
}

func read_both(
    first: HighIntermediaryRepresentation.Values.Value?,
    second: HighIntermediaryRepresentation.Values.Value?,
) {
    read_a_value(first)
    read_a_value(second)
}

func read_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    var key = call.function.key()
    waiting.append(key)
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

func read_a_making(made: HighIntermediaryRepresentation.Values.MakeObject) {
    var class_key = made.value_type.name
    waiting.append("{class_key}._attribute_defaults")
    if made.constructor {
        var key = made.constructor.key()
        waiting.append(key)
    }
    made.arguments.each(read_a_present)
}

func read_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    read_a_value(call.library)
    call.arguments.each(read_a_present)
}

func read_a_function_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    var index = 0
    while index < taken_as_values.count() {
        var key = taken_as_values[index]
        waiting.append(key)
        index = index + 1
    }
    read_a_value(call.called)
    call.arguments.each(read_a_present)
}

func read_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    var fillers = high.model.fillers_of(call.shape.key)
    if fillers.is_empty() {
        reaches_every_class = true
    }
    var index = 0
    while index < fillers.count() {
        var filler = fillers[index]
        waiting.append("{filler.name}.{call.member.name}")
        count_a_type(filler)
        index = index + 1
    }
    read_a_value(call.receiver)
    call.arguments.each(read_a_present)
}

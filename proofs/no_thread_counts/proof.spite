# ../../PROOFS.md#no-other-thread-counts-a-class

var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var taken = List<String>()

func check(checked: HighIntermediaryRepresentation.HighProgram) {
    fallback checked.will_be_lowered()
    crash checked.waits
    high = checked
    var waits = checked.waits
    taken = waits.taken_as_values
    checked.counts_every_class_atomically = true
    fallback not waits.has_callbacks
    var reach = ThreadReach(checked, taken)
    add_the_roots(reach, waits.started_in_parallel)
    add_the_roots(reach, waits.started)
    reach.follow_every_root()
    add_the_bands(reach, waits.started_in_parallel)
    add_the_bands(reach, waits.started)
    fallback not reach.reaches_every_class
    checked.thread_counted_classes = reach.counted_classes
    checked.counts_every_class_atomically = false
}

func add_the_roots(reach: ThreadReach, keys: List<String>) {
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if not high.band_fresh_classes.contains(key) {
            reach.add_a_root(key)
        }
        index = index + 1
    }
}

func add_the_bands(reach: ThreadReach, keys: List<String>) {
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if high.band_fresh_classes.contains(key) {
            add_a_band(reach, key)
        }
        index = index + 1
    }
}

# ../../OPTIMIZATIONS.md#a-class-only-a-bands-passes-make-is-counted-plainly
func add_a_band(reach: ThreadReach, key: String) {
    var fresh = high.band_fresh_classes[key]
    var held_types = high.band_held_types[key]
    crash fresh
    crash held_types
    var held = ThreadReach(high, taken)
    held.count_the_held(held_types)
    var band = ThreadReach(high, taken)
    if not held.reaches_every_class {
        band.plain_classes = plain_of(fresh, held)
    }
    band.add_a_root(key)
    band.follow_every_root()
    reach.add_the_counted(band)
}

func plain_of(fresh: List<String>, held: ThreadReach): List<String> {
    var plain = List<String>()
    var index = 0
    while index < fresh.count() {
        var class_key = fresh[index]
        if not held.counted_classes.contains(class_key) {
            plain.append(class_key)
        }
        index = index + 1
    }
    return plain
}

# ../../PROOFS.md#local-and-variadic-lists-in-the-frame
var kept = Dictionary<String, Integer>()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        var finding = FoundLists(high.model)
        kept = finding.found(built)
        if not kept.is_empty() {
            record_in_a_block(built.body)
        }
        index = index + 1
    }
}

func record_in_a_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    assert block
    block.statements.each(record_in_a_statement)
}

func record_in_a_statement(statement: HighIntermediaryRepresentation.Statements.Statement) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: record_a_declare(statement)
        HighIntermediaryRepresentation.Statements.If: record_in_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: record_in_a_block(statement.body)
        HighIntermediaryRepresentation.Statements.Block: record_in_a_block(statement)
        _: return
    }
}

func record_in_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    record_in_a_block(branch.then_branch)
    record_in_a_block(branch.else_branch)
}

func record_a_declare(declare: HighIntermediaryRepresentation.Statements.Declare) {
    var count = kept[declare.name]
    assert count
    declare.frame_items = count
}

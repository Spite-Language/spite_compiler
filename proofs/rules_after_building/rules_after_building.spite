# ../../ARCHITECTURE.md#the-order
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var context = high.context
    var symbols = context.resolver.symbols
    symbols.check_after_building(context.text_holes, context.other_holes)
    symbols.check_the_reopened_attributes(context.resolver)
}

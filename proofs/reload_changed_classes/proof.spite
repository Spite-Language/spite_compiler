# ../../PROOFS.md#a-reload-compiles-only-the-changed-classes

var library = Mapping.LibraryFile()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.model.reload_host
    var seen = List<String>()
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        var paths = model.file.written_paths()
        var path_index = 0
        while path_index < paths.count() {
            var written = paths[path_index]
            judge_a_file_of(high, high.model.reload_host, model, written, seen)
            path_index = path_index + 1
        }
        index = index + 1
    }
    var file_index = 0
    while file_index < high.model.reload_host.file_paths.count() {
        var running_path = high.model.reload_host.file_paths[file_index]
        if not seen.contains(running_path) and not high.reload_changed_files.contains(running_path) {
            high.reload_changed_files.append(running_path)
        }
        file_index = file_index + 1
    }
    high.reload_is_unchanged = high.reload_changed_files.is_empty()
    check_the_loaded_files(high)
}

# ../../../spite_documentation/repl.md#loading-what-you-changed
func check_the_loaded_files(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var flags = high.context.build_flags
    var inspection = CommandLine.Inspection()
    fallback inspection.has_a_session(flags) and flags["hot_reload"] != "true"
    var folder = flags["program"]
    crash folder
    var changed = List<String>()
    var index = 0
    while index < high.reload_changed_files.count() {
        var path = high.reload_changed_files[index]
        if not library.is_typed_code(path) {
            changed.append(path)
        }
        index = index + 1
    }
    var rules = Validators.CommandLine.HotReload.Validator()
    var answer = rules.check_the_loaded_files(changed, high.session_loads, folder)
    answer.tell()
}

func judge_a_file_of(
    high: HighIntermediaryRepresentation.HighProgram,
    host: Model.ReloadHost,
    model: Model.ClassModel,
    written: String,
    seen: List<String>,
) {
    var path = written.replace("\\", "/")
    var is_typed_code = library.is_typed_code(path)
    var is_program_code = not path.is_empty() and not library.holds(path) or is_typed_code
    fallback is_program_code
    judge_the_file(high, host, path, seen)
    note_the_class(high, model, path)
}

func judge_the_file(
    high: HighIntermediaryRepresentation.HighProgram,
    host: Model.ReloadHost,
    path: String,
    seen: List<String>,
) {
    fallback not seen.contains(path)
    seen.append(path)
    var running = host.file_digests[path]
    var file_path: Path? = path
    crash file_path
    var file = File(file_path)
    var bytes = file.read_as_buffer()
    var now = "missing"
    if bytes {
        var digest = Model.Digest()
        var bytes_count = bytes.count()
        digest.add_bytes(bytes, 0, bytes_count)
        now = digest.digest_text()
    }
    var is_same = false
    if running {
        is_same = running == now
    }
    if not is_same {
        high.reload_changed_files.append(path)
    }
}

func note_the_class(high: HighIntermediaryRepresentation.HighProgram, model: Model.ClassModel, path: String) {
    var is_changed = high.reload_changed_files.contains(path)
    if is_changed and not high.reload_changed_classes.contains(model.shown) {
        high.reload_changed_classes.append(model.shown)
    }
}

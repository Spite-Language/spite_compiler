# ../../PROOFS.md#a-reload-compiles-only-the-changed-classes
var library = Validators.LibraryFile()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    assert high.model.reload_host
    var seen = List<String>()
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        var path = model.file.path.replace("\\", "/")
        var is_typed_code = library.is_typed_code(path)
        var is_program_code = not path.is_empty() and not library.holds(path) or is_typed_code
        if is_program_code {
            judge_the_file(high, high.model.reload_host, path, seen)
            note_the_class(high, model, path)
        }
        index = index + 1
    }
    var file_index = 0
    while file_index < high.model.reload_host.file_paths.count() {
        var running_path = high.model.reload_host.file_paths[file_index]
        crash running_path
        if not seen.contains(running_path) and not high.reload_changed_files.contains(running_path) {
            high.reload_changed_files.append(running_path)
        }
        file_index = file_index + 1
    }
    high.reload_is_unchanged = high.reload_changed_files.is_empty()
}

func judge_the_file(
    high: HighIntermediaryRepresentation.HighProgram,
    host: Model.ReloadHost,
    path: String,
    seen: List<String>,
) {
    assert not seen.contains(path)
    seen.append(path)
    var running = host.file_digests[path]
    var file = File(path)
    var bytes = file.read_bytes()
    var now = "missing"
    if bytes {
        var digest = Model.Digest()
        var bytes_count = bytes.count()
        digest.add_bytes(bytes, 0, bytes_count)
        now = digest.digest_text()
    }
    var is_same = false
    if running {
        is_same = running == now
    }
    if not is_same {
        high.reload_changed_files.append(path)
    }
}

func note_the_class(high: HighIntermediaryRepresentation.HighProgram, model: Model.ClassModel, path: String) {
    var is_changed = high.reload_changed_files.contains(path)
    if is_changed and not high.reload_changed_classes.contains(model.shown) {
        high.reload_changed_classes.append(model.shown)
    }
}

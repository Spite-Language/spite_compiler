# ../../PROOFS.md#a-reload-reaches-every-object-whose-attributes-it-changes

var rules = Validators.CommandLine.HotReload.Validator()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.model.reload_host
    crash high.layout
    var layout = high.layout
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        var running = high.model.reload_host.layouts[model.key]
        if running {
            var now = layout.described(model)
            rules.check_a_layout(model, running, now)
        }
        judge_the_enums(high.model.reload_host, model)
        index = index + 1
    }
    judge_the_literals(high)
}

func judge_the_literals(high: HighIntermediaryRepresentation.HighProgram) {
    fallback high.model.reload_host
    var running_keys = high.model.reload_host.class_ids.keys()
    var running = literal_counts(running_keys)
    var now_keys = List<String>()
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        now_keys.append(model.key)
        index = index + 1
    }
    var now = literal_counts(now_keys)
    var layouts = now.keys()
    index = 0
    while index < layouts.count() {
        var layout = layouts[index]
        var before = running[layout]
        var after = now[layout]
        rules.check_literal_counts(before, after)
        index = index + 1
    }
}

func literal_counts(keys: List<String>): Dictionary<String, Integer> {
    var counts = Dictionary<String, Integer>()
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if key.starts_with("Object_") {
            var parts = key.split("_")
            var layout = parts[1]
            crash layout
            var seen = counts[layout]
            var count = 1
            if seen {
                count = seen + 1
            }
            counts[layout] = count
        }
        index = index + 1
    }
    return counts
}

func judge_the_enums(host: Model.ReloadHost, model: Model.ClassModel) {
    var index = 0
    while index < model.enums.count() {
        var enumeration = model.enums[index]
        var key = "{model.key}.{enumeration.name}"
        var running = host.enums[key]
        if running {
            var now = enumeration.described()
            rules.check_enum_values(model, enumeration.name, running, now)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-reload-reaches-every-object-whose-attributes-it-changes
var refusing = Validators.HotReload.Validator()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    assert high.model.reload_host
    crash high.layout
    var layout = high.layout
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        var running = high.model.reload_host.layouts[model.key]
        if running {
            var now = layout.described(model)
            if running != now {
                refuse_a_moved_class(model, running, now)
            }
        }
        judge_the_enums(high.model.reload_host, model)
        index = index + 1
    }
}

func refuse_a_moved_class(model: Model.ClassModel, running: String, now: String) {
    var running_names = attribute_names(running)
    var new_names = attribute_names(now)
    var changes = List<String>()
    var index = 0
    while index < new_names.count() {
        var name = new_names[index]
        crash name
        if not running_names.contains(name) {
            changes.append("{name} is new")
        }
        index = index + 1
    }
    index = 0
    while index < running_names.count() {
        var name = running_names[index]
        crash name
        if not new_names.contains(name) {
            changes.append("{name} is gone")
        }
        index = index + 1
    }
    if changes.is_empty() {
        changes.append("its attributes moved to other places or took other types")
    }
    var joined = changes.join(", ")
    refusing.refuse(
        "the reload changes the attributes of {model.shown} ({joined}), and the objects the program holds keep the attributes they were made with: start the program again to take the new attributes",
    )
}

func attribute_names(described: String): List<String> {
    var names = List<String>()
    var parts = described.split(";")
    var attributes = parts[1]
    if not attributes or attributes.is_empty() {
        return names
    }
    var listed = attributes.split("|")
    var index = 0
    while index < listed.count() {
        var entry = listed[index]
        crash entry
        var colon = entry.index_of(":")
        if colon {
            var name = entry.slice(0, colon)
            names.append(name)
        }
        index = index + 1
    }
    return names
}

func judge_the_enums(host: Model.ReloadHost, model: Model.ClassModel) {
    var index = 0
    while index < model.enums.count() {
        var enumeration = model.enums[index]
        var key = "{model.key}.{enumeration.name}"
        var running = host.enums[key]
        if running {
            var now = enumeration.values.join(",")
            var keeps_the_numbers = now == running or now.starts_with("{running},")
            if not keeps_the_numbers {
                refusing.refuse(
                    "the reload changes the values of {model.shown}.{enumeration.name} other than adding new ones last, and every value the program holds keeps the number it was made with: start the program again, or add the new values after the others",
                )
            }
        }
        index = index + 1
    }
}

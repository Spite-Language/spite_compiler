# ../../PROOFS.md#narrowing-a-t
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.PresenceSite) {
    entered.enter(site.owner, site.function, site.line)
    fallback site.value_type.is_nullable
    fallback not is_proven_present(site)
    if site.kind == "boolean" {
        refuse_a_maybe_boolean(site)
    }
    if site.kind == "shape" {
        refuse_a_null_that_cannot_answer(site)
    }
    fallback site.kind != "boolean" and site.kind != "shape"
    var shown = context.shown(site.value_type)
    if site.kind == "fit" {
        refuse_an_unproven_fit(site)
    }
    if site.kind == "member" {
        refuse_an_unproven_read(site, "read from")
        typing.refuse_maybe_null_member(context, shown, site.name)
    }
    if site.kind == "call" {
        refuse_an_unproven_read(site, "called on")
    }
    if site.kind == "operand" {
        typing.refuse_maybe_null_operand(context, shown, site.name)
    }
    typing.refuse_maybe_null(context, shown)
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func is_proven_present(site: HighIntermediaryRepresentation.Building.PresenceSite): Boolean {
    var is_a_fit = site.kind == "fit" or site.kind == "shape"
    var is_a_use = is_a_fit or site.kind == "member" or site.kind == "call" or site.kind == "operand"
    is_a_use = is_a_use or site.kind == "boolean" or site.kind == "held"
    fallback is_a_use and site.value
    var facts = context.presence
    return facts.is_present(site.value, site.function)
}

func refuse_a_maybe_boolean(site: HighIntermediaryRepresentation.Building.PresenceSite) {
    var tested = site.value_type
    fallback tested.kind == 'scalar' and tested.name == "Boolean"
    typing.refuse_maybe_boolean(context)
}

func refuse_an_unproven_read(site: HighIntermediaryRepresentation.Building.PresenceSite, verb: String) {
    if site.value == HighIntermediaryRepresentation.Values.Call {
        refuse_an_unproven_call_read(site.value, site.name, verb)
    }
}

func refuse_an_unproven_call_read(read: HighIntermediaryRepresentation.Values.Call, name: String, verb: String) {
    fallback read.index_path != ""
    var shown = context.shown(read.value_type)
    typing.refuse_missing_read_member(context, read.index_path, shown, name, verb, read.index_hint)
}

func refuse_an_unproven_fit(site: HighIntermediaryRepresentation.Building.PresenceSite) {
    var wanted = site.wanted
    var present = wanted.present()
    var shown_wanted = context.shown(present)
    if wanted.kind == 'shape' {
        var shape = context.program.shape_keyed(wanted.name)
        crash shape
        shown_wanted = shape.name
    }
    var shown = context.shown(site.value_type)
    if site.value == HighIntermediaryRepresentation.Values.Call and site.value.index_path != "" {
        typing.refuse_missing_read_needed(context, site.value.index_path, shown, shown_wanted, site.value.index_hint)
    }
    typing.refuse_maybe_null_needed(context, shown, shown_wanted)
}

func refuse_a_null_that_cannot_answer(site: HighIntermediaryRepresentation.Building.PresenceSite) {
    var shape = context.program.shape_keyed(site.wanted.name)
    crash shape
    var index = 0
    var answered = true
    while index < shape.members.count() {
        var member = shape.members[index]
        if not is_answered_by_null(member) {
            answered = false
        }
        index = index + 1
    }
    fallback not answered and shape.name != "Anything"
    refuse_an_unproven_fit(site)
    var shown = context.shown(site.value_type)
    typing.refuse_maybe_null_needed(context, shown, shape.name)
}

func is_answered_by_null(member: Model.FunctionModel): Boolean {
    var names_it = member.name == "to_string" or member.name == "to_debug"
    return names_it and member.parameters.is_empty() and not member.is_an_attribute
}

# ../../PROOFS.md#narrowing-a-t
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.PresenceSite) {
    entered.enter(site.owner, site.function, site.line)
    fallback site.value_type.is_nullable
    fallback not is_proven_present(site)
    var rule = Validators.HighIntermediaryRepresentation.PresentValue.Validator()
    if site.kind == "boolean" {
        rule.check_a_maybe_boolean(context, site)
    }
    if site.kind == "shape" {
        rule.check_a_null_that_cannot_answer(context, site)
    }
    fallback site.kind != "boolean" and site.kind != "shape"
    var shown = context.shown(site.value_type)
    if site.kind == "fit" {
        rule.check_an_unproven_fit(context, site)
    }
    if site.kind == "member" {
        rule.check_an_unproven_read(context, site, "read from")
        rule.check_a_member(context, shown, site.name)
    }
    if site.kind == "call" {
        rule.check_an_unproven_read(context, site, "called on")
    }
    if site.kind == "operand" {
        rule.check_an_operand(context, shown, site.name)
    }
    rule.check_a_present_value(context, site.value_type)
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func is_proven_present(site: HighIntermediaryRepresentation.Building.PresenceSite): Boolean {
    var is_a_fit = site.kind == "fit" or site.kind == "shape"
    var is_a_use = is_a_fit or site.kind == "member" or site.kind == "call" or site.kind == "operand"
    is_a_use = is_a_use or site.kind == "boolean" or site.kind == "held"
    fallback is_a_use and site.value
    var facts = context.presence
    return facts.is_present(site.value, site.function)
}

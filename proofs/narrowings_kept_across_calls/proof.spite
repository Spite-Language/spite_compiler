# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change

var no_model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_model)
var assignments = HighIntermediaryRepresentation.Assignments(high)
var rule = Validators.HighIntermediaryRepresentation.KeptNarrowing.Validator()
var writes = HighIntermediaryRepresentation.Writes()

func check(starting: HighIntermediaryRepresentation.HighProgram) {
    high = starting
    fallback not high.narrowed_reads.is_empty()
    var no_program = HighIntermediaryRepresentation.HighProgram(no_model)
    assignments = HighIntermediaryRepresentation.Assignments(no_program)
    assignments.read_for_narrowings(high)
    high.narrowed_reads.each(check_a_read)
}

func check_a_read(read: HighIntermediaryRepresentation.NarrowedRead) {
    fallback read.copy_line == 0 and not read.is_a_new_check
    if not read.getter.is_empty() {
        check_a_getter_read(read)
        return
    }
    if not read.watched_lists.is_empty() {
        check_an_item_read(read)
        return
    }
    var attributes = writes.attributes_of(read, high.model)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        if not read.is_left_behind(index) {
            check_what_reaches(read, index, value, attributes)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-getter-narrows-while-it-only-reads
func check_a_getter_read(read: HighIntermediaryRepresentation.NarrowedRead) {
    if assignments.may_have_an_effect(read.getter) {
        rule.check_a_getter_with_an_effect(read)
        return
    }
    var attributes = assignments.attributes_read_by(read.getter)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        if not read.is_left_behind(index) {
            check_what_reaches_a_getter(read, index, value, attributes)
        }
        index = index + 1
    }
}

func check_what_reaches_a_getter(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    value: SpiteCompiler.Value,
    attributes: List<Model.AttributeModel>,
) {
    var call_line = read.call_lines[index]
    crash call_line
    var is_read_past_the_call = index < read.end
    var written = writes.attribute_a_getter_reads(read, index, attributes)
    if written {
        rule.check_a_getter_change(read, "this write", written.name, call_line, is_read_past_the_call)
    }
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        if assignments.value_may_assign(value, attribute) {
            var called = called_in(value)
            rule.check_a_getter_change(read, called, attribute.name, call_line, is_read_past_the_call)
        }
        attribute_index = attribute_index + 1
    }
}

func check_an_item_read(read: HighIntermediaryRepresentation.NarrowedRead) {
    var attributes = List<Model.AttributeModel>()
    if read.object {
        attributes = writes.attributes_of(read, high.model)
    }
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        if not read.is_left_behind(index) {
            check_what_reaches_a_list(read, index, value, attributes)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
func check_what_reaches_a_list(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    value: SpiteCompiler.Value,
    attributes: List<Model.AttributeModel>,
) {
    if assignments.value_may_shrink(value, read.watched_lists) {
        report_a_shrink(read, index)
    }
    var call_line = read.call_lines[index]
    crash call_line
    var is_read_past_the_call = index < read.end
    if read.writes and writes.renews_a_list(read, index) {
        rule.check_a_shrink(read, "a write through another object", call_line, is_read_past_the_call)
    }
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        if assignments.value_may_assign(value, attribute) {
            var called = called_in(value)
            rule.check_a_shrink(read, called, call_line, is_read_past_the_call)
        }
        attribute_index = attribute_index + 1
    }
}

func report_a_shrink(read: HighIntermediaryRepresentation.NarrowedRead, index: Integer) {
    var call_line = read.call_lines[index]
    crash call_line
    var called = assignments.shrink_shown(read.watched_lists)
    rule.check_a_shrink(read, called, call_line, index < read.end)
}

func check_what_reaches(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    value: SpiteCompiler.Value,
    attributes: List<Model.AttributeModel>,
) {
    if writes.undoes(read, index) {
        report_a_write(read, index)
    }
    var attribute_index = 0
    while attribute_index < attributes.count() {
        var attribute = attributes[attribute_index]
        if assignments.value_may_assign(value, attribute) {
            report(read, index, value, attribute)
        }
        attribute_index = attribute_index + 1
    }
}

func report_a_write(read: HighIntermediaryRepresentation.NarrowedRead, index: Integer) {
    var write_line = read.call_lines[index]
    crash write_line
    var written_name = writes.written_name(read, index)
    rule.check_a_write(read, written_name, write_line, index < read.end)
}

func report(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    value: SpiteCompiler.Value,
    attribute: Model.AttributeModel,
) {
    var call_line = read.call_lines[index]
    crash call_line
    var called = called_in(value)
    var writer = assignments.writer_reached(attribute)
    if not writer.is_empty() and not is_the_call(value, writer) {
        called = "{called}, which reaches '{writer}',"
    }
    var is_read_past_the_call = index < read.end
    rule.check(read, attribute.name, called, call_line, is_read_past_the_call)
}

func called_in(value: SpiteCompiler.Value): String {
    switch value {
        HighIntermediaryRepresentation.Values.Call: return "'{value.function.name}(...)'"
        HighIntermediaryRepresentation.Values.MakeObject: return "making a '{value.value_type.name}'"
        HighIntermediaryRepresentation.Values.Function.ValueCall: return "a call through a function value"
        HighIntermediaryRepresentation.Values.ShapeCall: return "'{value.member.name}(...)' through a type"
        HighIntermediaryRepresentation.Values.Conversion: return converted_call_in(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return "a call here"
        HighIntermediaryRepresentation.Values.DecimalNumber: return "a call here"
        HighIntermediaryRepresentation.Values.TextConstant: return "a call here"
        HighIntermediaryRepresentation.Values.NullConstant: return "a call here"
        HighIntermediaryRepresentation.Values.LocalRead: return "a call here"
        HighIntermediaryRepresentation.Values.ThisRead: return "a call here"
        HighIntermediaryRepresentation.Values.AttributeRead: return "a call here"
        HighIntermediaryRepresentation.Values.MachineOperation: return "a call here"
        HighIntermediaryRepresentation.Values.Negation: return "a call here"
        HighIntermediaryRepresentation.Values.ForeignCall: return "a call here"
        HighIntermediaryRepresentation.Values.Class.Membership: return "a call here"
        HighIntermediaryRepresentation.Values.PresenceTest: return "a call here"
        HighIntermediaryRepresentation.Values.Function.Value: return "a call here"
        HighIntermediaryRepresentation.Values.NumberRoom: return "a call here"
        HighIntermediaryRepresentation.Values.EnumText: return "a call here"
        HighIntermediaryRepresentation.Values.EnumFromText: return "a call here"
        HighIntermediaryRepresentation.Values.Class.Object: return "a call here"
        HighIntermediaryRepresentation.Values.Class.OfValue: return "a call here"
        HighIntermediaryRepresentation.Values.Function.Fact: return "a call here"
    }
}

func converted_call_in(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    crash conversion.converted
    return called_in(conversion.converted)
}

func is_the_call(value: SpiteCompiler.Value, writer: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        var key = value.function.key()
        return key == writer
    }
    return false
}

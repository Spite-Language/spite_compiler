union Value {
    HighIntermediaryRepresentation.Values.WholeNumber
    HighIntermediaryRepresentation.Values.DecimalNumber
    HighIntermediaryRepresentation.Values.TextConstant
    HighIntermediaryRepresentation.Values.NullConstant
    HighIntermediaryRepresentation.Values.LocalRead
    HighIntermediaryRepresentation.Values.ThisRead
    HighIntermediaryRepresentation.Values.AttributeRead
    HighIntermediaryRepresentation.Values.Call
    HighIntermediaryRepresentation.Values.MakeObject
    HighIntermediaryRepresentation.Values.MachineOperation
    HighIntermediaryRepresentation.Values.Negation
    HighIntermediaryRepresentation.Values.ForeignCall
    HighIntermediaryRepresentation.Values.Class.Test
    HighIntermediaryRepresentation.Values.PresenceTest
    HighIntermediaryRepresentation.Values.Conversion
    HighIntermediaryRepresentation.Values.Function.Value
    HighIntermediaryRepresentation.Values.Function.ValueCall
    HighIntermediaryRepresentation.Values.NumberRoom
    HighIntermediaryRepresentation.Values.ShapeCall
    HighIntermediaryRepresentation.Values.EnumText
    HighIntermediaryRepresentation.Values.EnumFromText
    HighIntermediaryRepresentation.Values.Class.Object
    HighIntermediaryRepresentation.Values.Class.OfValue
    HighIntermediaryRepresentation.Values.Function.Fact
}

# ../../PROOFS.md#a-call-keeps-a-proof-it-cannot-change
var no_model = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_model)
var assignments = HighIntermediaryRepresentation.Assignments(high)
var refusal = Validators.HighIntermediaryRepresentation.KeptNarrowing.Validator()

func check(starting: HighIntermediaryRepresentation.HighProgram) {
    high = starting
    fallback not high.narrowed_reads.is_empty()
    var no_program = HighIntermediaryRepresentation.HighProgram(no_model)
    assignments = HighIntermediaryRepresentation.Assignments(no_program)
    assignments.read_for_narrowings(high)
    high.narrowed_reads.each(check_a_read)
}

func check_a_read(read: HighIntermediaryRepresentation.NarrowedRead) {
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        if assignments.value_may_assign(value, read.attribute) {
            refuse(read, index, value)
        }
        index = index + 1
    }
}

func refuse(
    read: HighIntermediaryRepresentation.NarrowedRead,
    index: Integer,
    value: Value,
) {
    var call_line = read.call_lines[index]
    crash call_line
    var called = called_in(value)
    var writer = assignments.writer_reached(read.attribute)
    if not writer.is_empty() and not is_the_call(value, writer) {
        called = "{called}, which reaches '{writer}',"
    }
    if index < read.end {
        refusal.refuse_a_read_past_a_call(read, called, call_line)
    }
    refusal.refuse_a_call_in_the_loop(read, called, call_line)
}

func called_in(value: Value): String {
    switch value {
        HighIntermediaryRepresentation.Values.Call: return "'{value.function.name}(...)'"
        HighIntermediaryRepresentation.Values.MakeObject: return "making a '{value.value_type.name}'"
        HighIntermediaryRepresentation.Values.Function.ValueCall: return "a call through a function value"
        HighIntermediaryRepresentation.Values.ShapeCall: return "'{value.member.name}(...)' through a type"
        HighIntermediaryRepresentation.Values.Conversion: return converted_call_in(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return "a call here"
        HighIntermediaryRepresentation.Values.DecimalNumber: return "a call here"
        HighIntermediaryRepresentation.Values.TextConstant: return "a call here"
        HighIntermediaryRepresentation.Values.NullConstant: return "a call here"
        HighIntermediaryRepresentation.Values.LocalRead: return "a call here"
        HighIntermediaryRepresentation.Values.ThisRead: return "a call here"
        HighIntermediaryRepresentation.Values.AttributeRead: return "a call here"
        HighIntermediaryRepresentation.Values.MachineOperation: return "a call here"
        HighIntermediaryRepresentation.Values.Negation: return "a call here"
        HighIntermediaryRepresentation.Values.ForeignCall: return "a call here"
        HighIntermediaryRepresentation.Values.Class.Test: return "a call here"
        HighIntermediaryRepresentation.Values.PresenceTest: return "a call here"
        HighIntermediaryRepresentation.Values.Function.Value: return "a call here"
        HighIntermediaryRepresentation.Values.NumberRoom: return "a call here"
        HighIntermediaryRepresentation.Values.EnumText: return "a call here"
        HighIntermediaryRepresentation.Values.EnumFromText: return "a call here"
        HighIntermediaryRepresentation.Values.Class.Object: return "a call here"
        HighIntermediaryRepresentation.Values.Class.OfValue: return "a call here"
        HighIntermediaryRepresentation.Values.Function.Fact: return "a call here"
    }
}

func converted_call_in(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    crash conversion.converted
    return called_in(conversion.converted)
}

func is_the_call(value: Value, writer: String): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.Call {
        var key = value.function.key()
        return key == writer
    }
    return false
}

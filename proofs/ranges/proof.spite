# ../../PROOFS.md#a-range-proves-arithmetic-fits

var scalars = Model.Scalars()
var program = Model.ProgramModel()
var numbers_nothing_writes = Dictionary<String, SpiteCompiler.Value>()
var ranges = Dictionary<String, NumberRange>()
var declared = Dictionary<String, Model.Type>()
var is_reaching = true
var are_paths_narrowed = true
var proving: HighIntermediaryRepresentation.HighFunction? = null
var proving_line = 0
var narrowing_sites = List<HighIntermediaryRepresentation.NarrowingSite>()
var limit: Long = 4611686018427387904
var _largest_integer: Long = 2147483647
var _largest_long: Long = 9223372036854775807
var _largest_exact_decimal: Long = 9007199254740992
var assigned_names = AssignedNames()

func check(high: HighIntermediaryRepresentation.HighProgram) {
    narrowing_sites = high.narrowing_sites
    var uses = HighIntermediaryRepresentation.AttributeUses()
    uses.read_the_program(high)
    high.numbers_nothing_writes = uses.numbers_nothing_writes()
    var index = 0
    while index < high.built_functions.count() {
        var built = high.built_functions[index]
        if built.is_from_the_source {
            proving = built
            prove(built.function, built.body, high)
        }
        index = index + 1
    }
}

func prove(
    function: Model.FunctionModel,
    body: HighIntermediaryRepresentation.Statements.Block,
    high: HighIntermediaryRepresentation.HighProgram,
) {
    program = high.model
    numbers_nothing_writes = high.numbers_nothing_writes
    ranges = Dictionary<String, NumberRange>()
    declared = Dictionary<String, Model.Type>()
    is_reaching = true
    are_paths_narrowed = true
    var index = 0
    while index < function.parameters.count() {
        var parameter = function.parameters[index]
        declared[parameter.name] = parameter.parameter_type.present()
        index = index + 1
    }
    prove_block(body)
}

func prove_block(block: HighIntermediaryRepresentation.Statements.Block?) {
    fallback block
    block.statements.each(prove_statement)
}

func prove_statement(statement: SpiteCompiler.Statement) {
    proving_line = statement.line
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: prove_a_declaration(statement)
        HighIntermediaryRepresentation.Statements.Assign.Assign: prove_an_assignment(statement)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: prove_an_attribute_write(statement)
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: prove_a_shape_write(statement)
        HighIntermediaryRepresentation.Statements.Evaluate: prove_an_evaluation(statement)
        HighIntermediaryRepresentation.Statements.If: prove_an_if(statement)
        HighIntermediaryRepresentation.Statements.While: prove_a_while(statement)
        HighIntermediaryRepresentation.Statements.Return: prove_a_return(statement)
        HighIntermediaryRepresentation.Statements.Stop: prove_a_stop(statement)
        HighIntermediaryRepresentation.Statements.Block: prove_block(statement)
    }
}

func prove_an_evaluation(evaluated: HighIntermediaryRepresentation.Statements.Evaluate) {
    prove_both(evaluated.value, evaluated.waited)
    fallback evaluated.waited
    forget_the_paths("")
}

func prove_an_attribute_write(written: HighIntermediaryRepresentation.Statements.Assign.Attribute) {
    prove_both(written.object, written.value)
    forget_the_paths("")
}

func prove_a_shape_write(written: HighIntermediaryRepresentation.Statements.Assign.ThroughShape) {
    prove_both(written.object, written.value)
    forget_the_paths("")
}

func forget_the_name(name: String) {
    ranges.remove_at(name)
    ranges.remove_at("{name}|nonzero")
    ranges.remove_at("{name}|floor")
    ranges.remove_at("{name}|ceiling")
}

# ../../PROOFS.md#a-proven-divisor-is-not-checked
func forget_the_paths(root: String) {
    var keys = ranges.keys()
    var start = "@"
    if root != "" {
        start = "@{root}."
    }
    var index = 0
    while index < keys.count() {
        var key = keys[index]
        if key.starts_with(start) {
            ranges.remove_at(key)
        }
        index = index + 1
    }
}

# ../../PROOFS.md#a-proven-divisor-is-not-checked
func attribute_path_of(value: SpiteCompiler.Value?): String {
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var held = path_of(value.object)
        fallback held != ""
        return "{held}.{value.attribute.name}"
    }
    return ""
}

func path_of(value: SpiteCompiler.Value?): String {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return value.name
        HighIntermediaryRepresentation.Values.ThisRead: return "this"
        HighIntermediaryRepresentation.Values.AttributeRead: return attribute_path_of(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return ""
        HighIntermediaryRepresentation.Values.DecimalNumber: return ""
        HighIntermediaryRepresentation.Values.TextConstant: return ""
        HighIntermediaryRepresentation.Values.NullConstant: return ""
        HighIntermediaryRepresentation.Values.Call: return ""
        HighIntermediaryRepresentation.Values.MakeObject: return ""
        HighIntermediaryRepresentation.Values.MachineOperation: return ""
        HighIntermediaryRepresentation.Values.Negation: return ""
        HighIntermediaryRepresentation.Values.ForeignCall: return ""
        HighIntermediaryRepresentation.Values.Class.Membership: return ""
        HighIntermediaryRepresentation.Values.PresenceTest: return ""
        HighIntermediaryRepresentation.Values.Conversion: return ""
        HighIntermediaryRepresentation.Values.Function.Value: return ""
        HighIntermediaryRepresentation.Values.Function.ValueCall: return ""
        HighIntermediaryRepresentation.Values.NumberRoom: return ""
        HighIntermediaryRepresentation.Values.ShapeCall: return ""
        HighIntermediaryRepresentation.Values.EnumText: return ""
        HighIntermediaryRepresentation.Values.EnumFromText: return ""
        HighIntermediaryRepresentation.Values.Class.Object: return ""
        HighIntermediaryRepresentation.Values.Class.OfValue: return ""
        HighIntermediaryRepresentation.Values.Function.Fact: return ""
    }
}

func calls_something(value: SpiteCompiler.Value?): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return false
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.LocalRead: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return calls_something(value.object)
        HighIntermediaryRepresentation.Values.Negation: return calls_something(value.negated)
        HighIntermediaryRepresentation.Values.Conversion: return calls_something(value.converted)
        HighIntermediaryRepresentation.Values.PresenceTest: return calls_something(value.tested)
        HighIntermediaryRepresentation.Values.MachineOperation: return calls_something_in_a_chain(value)
        HighIntermediaryRepresentation.Values.Call: return true
        HighIntermediaryRepresentation.Values.MakeObject: return true
        HighIntermediaryRepresentation.Values.ForeignCall: return true
        HighIntermediaryRepresentation.Values.Class.Membership: return true
        HighIntermediaryRepresentation.Values.Function.Value: return true
        HighIntermediaryRepresentation.Values.Function.ValueCall: return true
        HighIntermediaryRepresentation.Values.NumberRoom: return true
        HighIntermediaryRepresentation.Values.ShapeCall: return true
        HighIntermediaryRepresentation.Values.EnumText: return true
        HighIntermediaryRepresentation.Values.EnumFromText: return true
        HighIntermediaryRepresentation.Values.Class.Object: return true
        HighIntermediaryRepresentation.Values.Class.OfValue: return true
        HighIntermediaryRepresentation.Values.Function.Fact: return true
    }
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func calls_something_in_a_chain(operation: HighIntermediaryRepresentation.Values.MachineOperation): Boolean {
    var links = [operation]
    var lowest = operation
    var next = calls_something_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = calls_something_left_link_of(lowest)
    }
    if calls_something(lowest.left) {
        return true
    }
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        if calls_something(link.right) {
            return true
        }
        index = index - 1
    }
    return false
}

func calls_something_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    return left
}

func prove_a_declaration(declaration: HighIntermediaryRepresentation.Statements.Declare) {
    prove_value(declaration.value)
    declared[declaration.name] = declaration.declared_type.present()
    set_the_range(declaration.name, declaration.value)
}

func prove_an_assignment(assignment: HighIntermediaryRepresentation.Statements.Assign.Assign) {
    prove_value(assignment.value)
    set_the_range(assignment.name, assignment.value)
}

func prove_a_return(returned: HighIntermediaryRepresentation.Statements.Return) {
    prove_value(returned.value)
    is_reaching = false
}

func prove_a_stop(stopped: HighIntermediaryRepresentation.Statements.Stop) {
    stopped.shown.each(prove_present)
    prove_value(stopped.then)
    is_reaching = false
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func set_the_range(name: String, value: SpiteCompiler.Value?) {
    var found = range_of(value)
    forget_the_name(name)
    forget_the_paths(name)
    var named_type = declared[name]
    fallback named_type and value
    fallback is_whole(named_type)
    fallback found
    var cut = cut_to(found, named_type)
    fallback cut
    ranges[name] = cut
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func prove_an_if(branch: HighIntermediaryRepresentation.Statements.If) {
    var then_ranges = List<Dictionary<String, NumberRange>>()
    var then_reaching = List<Boolean>()
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        link = null
        prove_value(current.condition)
        var entry = ranges.copy()
        var entry_reaching = is_reaching
        narrow(current.condition, true)
        prove_block(current.then_branch)
        then_ranges.append(ranges)
        then_reaching.append(is_reaching)
        ranges = entry.copy()
        is_reaching = entry_reaching
        link = proved_up_to_the_next_link(current)
    }
    var index = then_ranges.count() - 1
    while index >= 0 {
        var reached = then_reaching[index] == true
        join_a_branch(then_ranges[index], reached)
        index = index - 1
    }
}

func proved_up_to_the_next_link(
    branch: HighIntermediaryRepresentation.Statements.If,
): HighIntermediaryRepresentation.Statements.If? {
    if not branch.else_branch {
        narrow(branch.condition, false)
        return null
    }
    var next = branch.else_if()
    if next {
        proving_line = next.line
        return next
    }
    prove_block(branch.else_branch)
    return null
}

func join_a_branch(then_ranges: Dictionary<String, NumberRange>?, then_reaching: Boolean) {
    crash then_ranges
    fallback then_reaching
    if not is_reaching {
        ranges = then_ranges
        is_reaching = true
        return
    }
    ranges = joined(then_ranges, ranges)
}

func joined(
    first: Dictionary<String, NumberRange>,
    second: Dictionary<String, NumberRange>,
): Dictionary<String, NumberRange> {
    var made = Dictionary<String, NumberRange>()
    var names = first.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var from_first = first[name]
        var from_second = second[name]
        if from_first and from_second {
            var low = smaller(from_first.lowest, from_second.lowest)
            var high = larger(from_first.highest, from_second.highest)
            made[name] = NumberRange(low, high)
        }
        if from_first and not from_second {
            join_one_side(made, name, from_first, second)
        }
        index = index + 1
    }
    names = second.keys()
    index = 0
    while index < names.count() {
        var name = names[index]
        var from_first = first[name]
        var from_second = second[name]
        if from_second and not from_first {
            join_one_side(made, name, from_second, first)
        }
        index = index + 1
    }
    return made
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func join_one_side(
    made: Dictionary<String, NumberRange>,
    name: String,
    whole: NumberRange,
    other: Dictionary<String, NumberRange>,
) {
    var floor = other["{name}|floor"]
    if floor {
        var low = smaller(whole.lowest, floor.lowest)
        made["{name}|floor"] = NumberRange(low, low)
    }
    var ceiling = other["{name}|ceiling"]
    fallback ceiling
    var high = larger(whole.highest, ceiling.highest)
    made["{name}|ceiling"] = NumberRange(high, high)
}

func prove_a_while(loop: HighIntermediaryRepresentation.Statements.While) {
    var assigned = List<String>()
    assigned_names.assigned_in_block(loop.body, assigned)
    var passes = passes_of(loop, assigned)
    var entries = ranges.copy()
    var widened = Dictionary<String, NumberRange>()
    var index = 0
    while index < assigned.count() {
        var name = assigned[index]
        var counted = counter_range(loop, name)
        if counted {
            widened[name] = counted
        }
        index = index + 1
    }
    index = 0
    while index < assigned.count() {
        var name = assigned[index]
        forget_the_name(name)
        var kept = widened[name]
        if kept {
            ranges[name] = kept
        }
        index = index + 1
    }
    var inner_totals = Dictionary<String, NumberRange>()
    if passes {
        widen_the_totals(loop, assigned, passes, entries, inner_totals)
    }
    forget_the_paths("")
    var entry_reaching = is_reaching
    prove_value(loop.condition)
    var at_the_condition = ranges.copy()
    narrow(loop.condition, true)
    narrow_the_totals(inner_totals)
    prove_block(loop.body)
    ranges = at_the_condition
    is_reaching = entry_reaching
}

func passes_of(loop: HighIntermediaryRepresentation.Statements.While, assigned: List<String>): NumberRange? {
    var found: NumberRange? = null
    var index = 0
    while index < assigned.count() and not found {
        var name = assigned[index]
        found = passes_counted_by(loop, name)
        index = index + 1
    }
    return found
}

func passes_counted_by(loop: HighIntermediaryRepresentation.Statements.While, name: String): NumberRange? {
    var named_type = declared[name]
    fallback named_type
    fallback is_whole(named_type)
    var entry = ranges[name]
    fallback entry
    var step = single_step_of(loop.body, name)
    if step <= 0 {
        return passes_counted_down(loop, name, entry)
    }
    var bound = loop_bound_of(loop.condition, name, loop)
    fallback bound
    var widest: Long = 4294967296
    var low_size = magnitude(entry.lowest)
    var high_size = magnitude(bound.highest)
    fallback low_size < widest and high_size < widest
    var passes: Long = 0
    var reach: Long = bound.highest - entry.lowest
    if reach >= 0 {
        passes = reach / step + 1
    }
    return NumberRange(passes, passes)
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func passes_counted_down(
    loop: HighIntermediaryRepresentation.Statements.While,
    name: String,
    entry: NumberRange,
): NumberRange? {
    var written = assigned_names.assignments_of(loop.body, name)
    fallback written == 1
    var step = top_level_down_step(loop.body, name)
    fallback step > 0
    var floor = loop_floor_of(loop.condition, name, loop)
    fallback floor
    var widest: Long = 4294967296
    var high_size = magnitude(entry.highest)
    var low_size = magnitude(floor.lowest)
    fallback low_size < widest and high_size < widest
    var passes: Long = 0
    var reach: Long = entry.highest - floor.lowest
    if reach >= 0 {
        passes = reach / step + 1
    }
    return NumberRange(passes, passes)
}

func top_level_down_step(body: HighIntermediaryRepresentation.Statements.Block, name: String): Long {
    var step: Long = -1
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign {
            step = down_step_of_the_assignment(statement, name, step)
        }
        index = index + 1
    }
    return step
}

func down_step_of_the_assignment(
    assignment: HighIntermediaryRepresentation.Statements.Assign.Assign,
    name: String,
    step: Long,
): Long {
    var found = step
    if assignment.name == name {
        found = down_step_of(assignment.value, name)
    }
    return found
}

func single_step_of(body: HighIntermediaryRepresentation.Statements.Block, name: String): Long {
    var step: Long = -1
    var written = assigned_names.assignments_of(body, name)
    if written == 1 {
        step = top_level_step(body, name)
    }
    return step
}

func top_level_step(body: HighIntermediaryRepresentation.Statements.Block, name: String): Long {
    var step: Long = -1
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign {
            step = step_of_the_assignment(statement, name, step)
        }
        index = index + 1
    }
    return step
}

func step_of_the_assignment(
    assignment: HighIntermediaryRepresentation.Statements.Assign.Assign,
    name: String,
    step: Long,
): Long {
    var found = step
    if assignment.name == name {
        found = step_of(assignment.value, name)
    }
    return found
}

func widen_the_totals(
    loop: HighIntermediaryRepresentation.Statements.While,
    assigned: List<String>,
    passes: NumberRange,
    entries: Dictionary<String, NumberRange>,
    inner_totals: Dictionary<String, NumberRange>,
) {
    var zero: Long = 0
    var earlier: Long = passes.lowest - 1
    var passes_before = larger(earlier, zero)
    var index = 0
    while index < assigned.count() {
        var name = assigned[index]
        var widened = total_range(loop, name, passes.lowest, entries)
        var inner = total_range(loop, name, passes_before, entries)
        if widened and inner {
            ranges[name] = widened
            inner_totals[name] = inner
        }
        index = index + 1
    }
}

func narrow_the_totals(inner_totals: Dictionary<String, NumberRange>) {
    var names = inner_totals.keys()
    var index = 0
    while index < names.count() {
        var name = names[index]
        var inner = inner_totals[name]
        crash inner
        ranges[name] = inner
        index = index + 1
    }
}

func total_range(
    loop: HighIntermediaryRepresentation.Statements.While,
    name: String,
    passes: Long,
    entries: Dictionary<String, NumberRange>,
): NumberRange? {
    var counted = ranges[name]
    fallback not counted
    var named_type = declared[name]
    fallback named_type
    fallback is_whole(named_type)
    var entry = entries[name]
    fallback entry
    var written = assigned_names.assignments_of(loop.body, name)
    fallback written == 1
    var operation = top_level_total(loop.body, name)
    fallback operation
    var term = term_of(operation, name)
    fallback term
    var term_range = range_of(term)
    fallback term_range
    var widest_step: Long = 2147483648
    var widest_entry: Long = 2305843009213693952
    var step_low_size = magnitude(term_range.lowest)
    var step_high_size = magnitude(term_range.highest)
    var entry_low_size = magnitude(entry.lowest)
    var entry_high_size = magnitude(entry.highest)
    fallback passes <= widest_step and step_low_size <= widest_step and step_high_size <= widest_step
    fallback entry_low_size < widest_entry and entry_high_size < widest_entry
    var zero: Long = 0
    var low_step = smaller(term_range.lowest, zero)
    var high_step = larger(term_range.highest, zero)
    if operation.operator == 'subtract' {
        var most = larger(term_range.highest, zero)
        var least = smaller(term_range.lowest, zero)
        low_step = zero - most
        high_step = zero - least
    }
    var lowest: Long = entry.lowest + passes * low_step
    var highest: Long = entry.highest + passes * high_step
    var found = within_the_limit(lowest, highest)
    fallback found
    return cut_to(found, named_type)
}

func top_level_total(
    body: HighIntermediaryRepresentation.Statements.Block,
    name: String,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var found: HighIntermediaryRepresentation.Values.MachineOperation? = null
    var index = 0
    while index < body.statements.count() {
        var statement = body.statements[index]
        if statement.class == HighIntermediaryRepresentation.Statements.Assign.Assign {
            found = total_of_the_assignment(statement, name, found)
        }
        index = index + 1
    }
    return found
}

func total_of_the_assignment(
    assignment: HighIntermediaryRepresentation.Statements.Assign.Assign,
    name: String,
    found: HighIntermediaryRepresentation.Values.MachineOperation?,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var total = found
    var value = assignment.value
    var is_the_total = assignment.name == name and value.class == HighIntermediaryRepresentation.Values.MachineOperation
    if is_the_total {
        total = operation_of(value)
    }
    return total
}

func operation_of(value: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.MachineOperation? {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return value
    }
    return null
}

func term_of(operation: HighIntermediaryRepresentation.Values.MachineOperation, name: String): SpiteCompiler.Value? {
    var left_name = local_name_of(operation.left)
    var right_name = local_name_of(operation.right)
    var term: SpiteCompiler.Value? = null
    var adds = operation.operator == 'add'
    var takes_away = operation.operator == 'subtract'
    var adds_on_the_right = adds or takes_away
    if adds_on_the_right and left_name == name and is_a_term(operation.right, name) {
        term = operation.right
    } else if adds and right_name == name and is_a_term(operation.left, name) {
        term = operation.left
    }
    return term
}

func is_a_term(value: SpiteCompiler.Value?, name: String): Boolean {
    var read_name = local_name_of(value)
    return read_name != name
}

func counter_range(loop: HighIntermediaryRepresentation.Statements.While, name: String): NumberRange? {
    var named_type = declared[name]
    fallback named_type
    fallback is_whole(named_type)
    var entry = ranges[name]
    fallback entry
    var steps = CounterSteps()
    steps.name = name
    steps_in_block(loop.body, steps, false)
    fallback steps.is_a_counter and steps.total > 0
    if steps.is_down {
        return down_counter_range(loop, name, named_type, entry, steps)
    }
    var ceiling = type_highest(named_type)
    var has_a_ceiling = is_bounded(named_type)
    if not steps.is_nested {
        var bound = loop_bound_of(loop.condition, name, loop)
        if bound {
            var stepped: Long = bound.highest + steps.total
            ceiling = larger(entry.highest, stepped)
            has_a_ceiling = true
        }
    }
    fallback has_a_ceiling and ceiling < limit
    var counted = NumberRange(entry.lowest, ceiling)
    return cut_to(counted, named_type)
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func down_counter_range(
    loop: HighIntermediaryRepresentation.Statements.While,
    name: String,
    named_type: Model.Type,
    entry: NumberRange,
    steps: CounterSteps,
): NumberRange? {
    var floor = type_lowest(named_type)
    var has_a_floor = is_bounded(named_type)
    var zero: Long = 0
    var negative_limit: Long = zero - limit
    var is_steady = steps.total < limit and entry.lowest > negative_limit
    if not steps.is_nested and is_steady {
        var bound = loop_floor_of(loop.condition, name, loop)
        if bound {
            var stepped: Long = bound.lowest - steps.total
            floor = smaller(entry.lowest, stepped)
            has_a_floor = true
        }
    }
    fallback has_a_floor and floor > negative_limit
    var counted = NumberRange(floor, entry.highest)
    return cut_to(counted, named_type)
}

func loop_floor_of(
    condition: SpiteCompiler.Value?,
    name: String,
    loop: HighIntermediaryRepresentation.Statements.While,
): NumberRange? {
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return loop_floor_of_an_operation(condition, name, loop)
    }
    return null
}

func loop_floor_of_an_operation(
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    name: String,
    loop: HighIntermediaryRepresentation.Statements.While,
): NumberRange? {
    if condition.operator == 'and' {
        var on_the_left = loop_floor_of(condition.left, name, loop)
        if on_the_left {
            return on_the_left
        }
        return loop_floor_of(condition.right, name, loop)
    }
    var above = condition.operator == 'greater'
    var at_least = condition.operator == 'greater_or_equal'
    fallback above or at_least
    var read_name = local_name_of(condition.left)
    fallback read_name == name
    var bound = bound_range_of(condition.right, loop)
    fallback bound
    var lowest: Long = bound.lowest
    if above {
        lowest = lowest + 1
    }
    return NumberRange(lowest, lowest)
}

func steps_in_block(block: HighIntermediaryRepresentation.Statements.Block?, steps: CounterSteps, nested: Boolean) {
    fallback block
    var index = 0
    while index < block.statements.count() {
        var statement = block.statements[index]
        steps_in(statement, steps, nested)
        index = index + 1
    }
}

func steps_in(statement: SpiteCompiler.Statement, steps: CounterSteps, nested: Boolean) {
    switch statement {
        HighIntermediaryRepresentation.Statements.Declare: steps_in_a_declaration(statement, steps)
        HighIntermediaryRepresentation.Statements.Assign.Assign: steps_in_an_assignment(statement, steps, nested)
        HighIntermediaryRepresentation.Statements.If: steps_in_branches(statement, steps, nested)
        HighIntermediaryRepresentation.Statements.While: steps_in_block(statement.body, steps, true)
        HighIntermediaryRepresentation.Statements.Block: steps_in_block(statement, steps, nested)
        HighIntermediaryRepresentation.Statements.Assign.Attribute: return
        HighIntermediaryRepresentation.Statements.Assign.ThroughShape: return
        HighIntermediaryRepresentation.Statements.Evaluate: return
        HighIntermediaryRepresentation.Statements.Return: return
        HighIntermediaryRepresentation.Statements.Stop: return
    }
}

# ../../ARCHITECTURE.md#an-else-if-chain-is-walked-in-a-loop
func steps_in_branches(branch: HighIntermediaryRepresentation.Statements.If, steps: CounterSteps, nested: Boolean) {
    var link: HighIntermediaryRepresentation.Statements.If? = branch
    while link {
        var current = link
        steps_in_block(current.then_branch, steps, nested)
        link = current.else_if()
        if not link {
            steps_in_block(current.else_branch, steps, nested)
        }
    }
}

func steps_in_a_declaration(declaration: HighIntermediaryRepresentation.Statements.Declare, steps: CounterSteps) {
    if declaration.name == steps.name {
        steps.is_a_counter = false
    }
}

func steps_in_an_assignment(
    assignment: HighIntermediaryRepresentation.Statements.Assign.Assign,
    steps: CounterSteps,
    nested: Boolean,
) {
    fallback assignment.name == steps.name
    var step = step_of(assignment.value, steps.name)
    if step >= 0 {
        steps.is_up = true
    } else {
        step = down_step_of(assignment.value, steps.name)
        steps.is_down = true
    }
    if step < 0 or steps.is_up and steps.is_down {
        steps.is_a_counter = false
        return
    }
    steps.total = steps.total + step
    if nested {
        steps.is_nested = true
    }
}

func step_of(value: SpiteCompiler.Value?, name: String): Long {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return step_of_an_operation(value, name)
    }
    return -1
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func down_step_of(value: SpiteCompiler.Value?, name: String): Long {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return down_step_of_an_operation(value, name)
    }
    return -1
}

func down_step_of_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation, name: String): Long {
    if operation.operator != 'subtract' {
        return -1
    }
    return constant_beside(operation.left, operation.right, name)
}

func step_of_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation, name: String): Long {
    if operation.operator != 'add' {
        return -1
    }
    var right_step = constant_beside(operation.left, operation.right, name)
    if right_step >= 0 {
        return right_step
    }
    return constant_beside(operation.right, operation.left, name)
}

func constant_beside(read: SpiteCompiler.Value?, added: SpiteCompiler.Value?, name: String): Long {
    var read_name = local_name_of(read)
    if read_name != name {
        return -1
    }
    if added.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return step_size(added.number)
    }
    return -1
}

func step_size(number: Long): Long {
    if number < 0 or number >= limit {
        return -1
    }
    return number
}

func loop_bound_of(
    condition: SpiteCompiler.Value?,
    name: String,
    loop: HighIntermediaryRepresentation.Statements.While,
): NumberRange? {
    if condition.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return loop_bound_of_an_operation(condition, name, loop)
    }
    return null
}

func loop_bound_of_an_operation(
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    name: String,
    loop: HighIntermediaryRepresentation.Statements.While,
): NumberRange? {
    if condition.operator == 'and' {
        var on_the_left = loop_bound_of(condition.left, name, loop)
        if on_the_left {
            return on_the_left
        }
        return loop_bound_of(condition.right, name, loop)
    }
    var below = condition.operator == 'less'
    var at_most = condition.operator == 'less_or_equal'
    fallback below or at_most
    var read_name = local_name_of(condition.left)
    var shift: Long = 0
    if read_name != name {
        read_name = shifted_name_of(condition.left)
        shift = shift_of(condition.left)
    }
    fallback read_name == name
    var bound = bound_range_of(condition.right, loop)
    fallback bound
    var highest: Long = bound.highest - shift
    if below {
        highest = highest - 1
    }
    return NumberRange(highest, highest)
}

func bound_range_of(bound: SpiteCompiler.Value?, loop: HighIntermediaryRepresentation.Statements.While): NumberRange? {
    var assigned = List<String>()
    assigned_names.assigned_in_block(loop.body, assigned)
    var saved = ranges.copy()
    var index = 0
    while index < assigned.count() {
        var name = assigned[index]
        ranges.remove_at(name)
        index = index + 1
    }
    var found = range_of(bound)
    ranges = saved
    return found
}

func narrow(condition: SpiteCompiler.Value?, holds: Boolean) {
    fallback condition
    switch condition {
        HighIntermediaryRepresentation.Values.MachineOperation: narrow_an_operation(condition, holds)
        HighIntermediaryRepresentation.Values.Negation: narrow_a_negation(condition, holds)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.AttributeRead: return
        HighIntermediaryRepresentation.Values.Call: return
        HighIntermediaryRepresentation.Values.MakeObject: return
        HighIntermediaryRepresentation.Values.ForeignCall: return
        HighIntermediaryRepresentation.Values.Class.Membership: return
        HighIntermediaryRepresentation.Values.PresenceTest: return
        HighIntermediaryRepresentation.Values.Conversion: return
        HighIntermediaryRepresentation.Values.Function.Value: return
        HighIntermediaryRepresentation.Values.Function.ValueCall: return
        HighIntermediaryRepresentation.Values.NumberRoom: return
        HighIntermediaryRepresentation.Values.ShapeCall: return
        HighIntermediaryRepresentation.Values.EnumText: return
        HighIntermediaryRepresentation.Values.EnumFromText: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Class.OfValue: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

func narrow_a_negation(negation: HighIntermediaryRepresentation.Values.Negation, holds: Boolean) {
    narrow(negation.negated, not holds)
}

func narrow_an_operation(condition: HighIntermediaryRepresentation.Values.MachineOperation, holds: Boolean) {
    if condition.operator == 'and' {
        narrow_both_sides(condition, holds, true)
        return
    }
    if condition.operator == 'or' {
        narrow_both_sides(condition, holds, false)
        return
    }
    var comparison = condition.operator
    if not holds {
        comparison = turned_around(comparison)
    }
    var mirrored = mirrored_comparison(comparison)
    narrow_one_side(comparison, condition.left, condition.right, holds)
    narrow_one_side(mirrored, condition.right, condition.left, holds)
}

func narrow_both_sides(
    condition: HighIntermediaryRepresentation.Values.MachineOperation,
    holds: Boolean,
    each_side_holds: Boolean,
) {
    fallback holds == each_side_holds
    var were_paths_narrowed = are_paths_narrowed
    if calls_something(condition.right) {
        are_paths_narrowed = false
    }
    narrow(condition.left, each_side_holds)
    are_paths_narrowed = were_paths_narrowed
    narrow(condition.right, each_side_holds)
}

func turned_around(
    comparison: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): HighIntermediaryRepresentation.Values.MachineOperation.Operator {
    switch comparison {
        'less': return 'greater_or_equal'
        'less_or_equal': return 'greater'
        'greater': return 'less_or_equal'
        'greater_or_equal': return 'less'
        'equal': return 'not_equal'
        'add': crash
        'subtract': crash
        'multiply': crash
        'divide': crash
        'remainder': crash
        'not_equal': return 'equal'
        'and': crash
        'or': crash
    }
}

func mirrored_comparison(
    comparison: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
): HighIntermediaryRepresentation.Values.MachineOperation.Operator {
    switch comparison {
        'less': return 'greater'
        'less_or_equal': return 'greater_or_equal'
        'greater': return 'less'
        'greater_or_equal': return 'less_or_equal'
        'add': return comparison
        'subtract': return comparison
        'multiply': return comparison
        'divide': return comparison
        'remainder': return comparison
        'equal': return comparison
        'not_equal': return comparison
        'and': return comparison
        'or': return comparison
    }
}

func narrow_one_side(
    comparison: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    subject: SpiteCompiler.Value?,
    other: SpiteCompiler.Value?,
    holds: Boolean,
) {
    var path = attribute_path_of(subject)
    if path != "" {
        narrow_a_path(comparison, path, other)
        return
    }
    var decimal_name = decimal_name_of(subject)
    if decimal_name != "" {
        narrow_a_decimal(comparison, decimal_name, other, holds)
        return
    }
    var name = local_name_of(subject)
    var shift: Long = 0
    if name == "" {
        name = shifted_name_of(subject)
        shift = shift_of(subject)
    }
    fallback name != ""
    var named_type = declared[name]
    fallback named_type
    fallback is_whole(named_type)
    var bound = range_of(other)
    fallback bound
    if comparison == 'not_equal' and shift == 0 and bound.lowest == 0 and bound.highest == 0 {
        ranges["{name}|nonzero"] = bound
    }
    var current = ranges[name]
    var low = type_lowest(named_type)
    var high = type_highest(named_type)
    var floor = ranges["{name}|floor"]
    if floor {
        low = floor.lowest
    }
    var ceiling = ranges["{name}|ceiling"]
    if ceiling {
        high = ceiling.highest
    }
    if current {
        low = current.lowest
        high = current.highest
    }
    var bound_low: Long = bound.lowest - shift
    var bound_high: Long = bound.highest - shift
    switch comparison {
        'less': high = smaller(high, bound_high - 1)
        'less_or_equal': high = smaller(high, bound_high)
        'greater': low = larger(low, bound_low + 1)
        'greater_or_equal': low = larger(low, bound_low)
        'equal': low = larger(low, bound_low)
        'add': return
        'subtract': return
        'multiply': return
        'divide': return
        'remainder': return
        'not_equal': return
        'and': return
        'or': return
    }
    if comparison == 'equal' {
        high = smaller(high, bound_high)
    }
    fallback low <= high
    var narrowed = NumberRange(low, high)
    if not is_within_the_limit(narrowed) {
        keep_one_side(name, narrowed)
        return
    }
    var cut = cut_to(narrowed, named_type)
    fallback cut
    ranges[name] = cut
    ranges.remove_at("{name}|floor")
    ranges.remove_at("{name}|ceiling")
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func keep_one_side(name: String, narrowed: NumberRange) {
    var zero_point: Long = 0
    var negative_limit: Long = zero_point - limit
    if narrowed.lowest > negative_limit {
        ranges["{name}|floor"] = NumberRange(narrowed.lowest, narrowed.lowest)
    }
    if narrowed.highest < limit {
        ranges["{name}|ceiling"] = NumberRange(narrowed.highest, narrowed.highest)
    }
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func narrow_a_decimal(
    comparison: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    name: String,
    other: SpiteCompiler.Value?,
    holds: Boolean,
) {
    fallback holds
    var bound = decimal_range_of(other)
    fallback bound
    var zero_point: Long = 0
    var low: Long = zero_point - limit
    var high: Long = limit
    var floor = ranges["{name}|floor"]
    if floor {
        low = floor.lowest
    }
    var ceiling = ranges["{name}|ceiling"]
    if ceiling {
        high = ceiling.highest
    }
    var current = ranges[name]
    if current {
        low = current.lowest
        high = current.highest
    }
    switch comparison {
        'less': high = smaller(high, bound.highest)
        'less_or_equal': high = smaller(high, bound.highest)
        'greater': low = larger(low, bound.lowest)
        'greater_or_equal': low = larger(low, bound.lowest)
        'equal': low = larger(low, bound.lowest)
        'add': return
        'subtract': return
        'multiply': return
        'divide': return
        'remainder': return
        'not_equal': return
        'and': return
        'or': return
    }
    if comparison == 'equal' {
        high = smaller(high, bound.highest)
    }
    fallback low <= high
    var narrowed = NumberRange(low, high)
    if not is_within_the_limit(narrowed) {
        keep_one_side(name, narrowed)
        return
    }
    ranges[name] = narrowed
    ranges.remove_at("{name}|floor")
    ranges.remove_at("{name}|ceiling")
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func decimal_name_of(value: SpiteCompiler.Value?): String {
    fallback value and is_decimal(value.value_type)
    if value.class == HighIntermediaryRepresentation.Values.LocalRead {
        return value.name
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return decimal_name_through(value)
    }
    return ""
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func decimal_name_through(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    fallback conversion.kind == 'present' or conversion.kind == 'widen'
    fallback conversion.converted
    var inner_type = conversion.converted.value_type.present()
    fallback is_decimal(inner_type)
    if conversion.converted.class == HighIntermediaryRepresentation.Values.LocalRead {
        return conversion.converted.name
    }
    return ""
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func decimal_range_of(value: SpiteCompiler.Value?): NumberRange? {
    fallback value
    var name = decimal_name_of(value)
    if name != "" {
        return ranges[name]
    }
    var constant = decimal_constant_of(value)
    if constant {
        return floor_range(constant)
    }
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        return whole_as_a_decimal_range(value)
    }
    return null
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func decimal_constant_of(value: SpiteCompiler.Value?): Double? {
    fallback value
    if value.class == HighIntermediaryRepresentation.Values.DecimalNumber {
        return written_decimal(value)
    }
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var key = "{value.attribute.owner}.{value.attribute.name}"
        var number = numbers_nothing_writes[key]
        return decimal_constant_of(number)
    }
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return negated_decimal(value)
    }
    return null
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func negated_decimal(operation: HighIntermediaryRepresentation.Values.MachineOperation): Double? {
    fallback operation.operator == 'subtract' and is_decimal(operation.value_type)
    var zero = decimal_constant_of(operation.left)
    fallback zero and zero == 0.0
    var negated = decimal_constant_of(operation.right)
    fallback negated
    return 0.0 - negated
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func written_decimal(number: HighIntermediaryRepresentation.Values.DecimalNumber): Double? {
    if number.value_type.name == "Float" {
        var single: Float? = number.written
        fallback single
        return single
    }
    return number.written
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func whole_as_a_decimal_range(conversion: HighIntermediaryRepresentation.Values.Conversion): NumberRange? {
    fallback conversion.kind == 'to_decimal'
    var whole = range_of(conversion.converted)
    fallback whole
    var exact: Long = _largest_exact_decimal
    var zero_point: Long = 0
    var negative_exact: Long = zero_point - exact
    fallback whole.lowest >= negative_exact and whole.highest <= exact
    return whole
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func floor_range(number: Double): NumberRange? {
    var truncated: Long? = number
    fallback truncated
    var found = NumberRange(truncated, truncated)
    fallback is_within_the_limit(found)
    var back: Double = truncated
    if number < back {
        found = NumberRange(truncated - 1, truncated - 1)
    }
    return found
}

# ../../PROOFS.md#a-proven-divisor-is-not-checked
func narrow_a_path(
    comparison: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    path: String,
    other: SpiteCompiler.Value?,
) {
    fallback are_paths_narrowed
    var bound = range_of(other)
    fallback bound
    var is_not_zero = comparison == 'not_equal' and bound.lowest == 0 and bound.highest == 0
    var is_above_zero = comparison == 'greater' and bound.lowest >= 0
    var is_below_zero = comparison == 'less' and bound.highest <= 0
    var is_known_to_be_positive = comparison == 'greater' and bound.lowest >= -1
    if is_not_zero or is_above_zero or is_below_zero {
        ranges["@{path}|nonzero"] = NumberRange(0, 0)
    }
    if is_known_to_be_positive {
        ranges["@{path}|above"] = NumberRange(bound.lowest + 1, bound.lowest + 1)
    }
}

func local_name_of(value: SpiteCompiler.Value?): String {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.LocalRead: return whole_local_name(value)
        HighIntermediaryRepresentation.Values.Conversion: return converted_name_of(value)
        HighIntermediaryRepresentation.Values.WholeNumber: return ""
        HighIntermediaryRepresentation.Values.DecimalNumber: return ""
        HighIntermediaryRepresentation.Values.TextConstant: return ""
        HighIntermediaryRepresentation.Values.NullConstant: return ""
        HighIntermediaryRepresentation.Values.ThisRead: return ""
        HighIntermediaryRepresentation.Values.AttributeRead: return ""
        HighIntermediaryRepresentation.Values.Call: return ""
        HighIntermediaryRepresentation.Values.MakeObject: return ""
        HighIntermediaryRepresentation.Values.MachineOperation: return ""
        HighIntermediaryRepresentation.Values.Negation: return ""
        HighIntermediaryRepresentation.Values.ForeignCall: return ""
        HighIntermediaryRepresentation.Values.Class.Membership: return ""
        HighIntermediaryRepresentation.Values.PresenceTest: return ""
        HighIntermediaryRepresentation.Values.Function.Value: return ""
        HighIntermediaryRepresentation.Values.Function.ValueCall: return ""
        HighIntermediaryRepresentation.Values.NumberRoom: return ""
        HighIntermediaryRepresentation.Values.ShapeCall: return ""
        HighIntermediaryRepresentation.Values.EnumText: return ""
        HighIntermediaryRepresentation.Values.EnumFromText: return ""
        HighIntermediaryRepresentation.Values.Class.Object: return ""
        HighIntermediaryRepresentation.Values.Class.OfValue: return ""
        HighIntermediaryRepresentation.Values.Function.Fact: return ""
    }
}

func whole_local_name(read: HighIntermediaryRepresentation.Values.LocalRead): String {
    fallback is_whole(read.value_type)
    return read.name
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func converted_name_of(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    if conversion.kind == 'widen' {
        return local_name_of(conversion.converted)
    }
    fallback conversion.kind == 'present' and is_whole(conversion.value_type)
    return present_name_of(conversion)
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func present_name_of(conversion: HighIntermediaryRepresentation.Values.Conversion): String {
    var read = conversion.converted
    fallback read.class == HighIntermediaryRepresentation.Values.LocalRead
    return read.name
}

func shifted_name_of(value: SpiteCompiler.Value?): String {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return shifted_operation_name(value)
    }
    return ""
}

func shifted_operation_name(operation: HighIntermediaryRepresentation.Values.MachineOperation): String {
    var is_a_shift = operation.operator == 'add' or operation.operator == 'subtract'
    fallback is_a_shift and is_a_small_constant(operation.right)
    return local_name_of(operation.left)
}

func shift_of(value: SpiteCompiler.Value?): Long {
    if value.class == HighIntermediaryRepresentation.Values.MachineOperation {
        return operation_shift(value)
    }
    return 0
}

func operation_shift(operation: HighIntermediaryRepresentation.Values.MachineOperation): Long {
    var right = operation.right
    if right.class == HighIntermediaryRepresentation.Values.WholeNumber {
        if operation.operator == 'subtract' {
            var zero: Long = 0
            return zero - right.number
        }
        return right.number
    }
    return 0
}

func is_a_small_constant(value: SpiteCompiler.Value?): Boolean {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        var zero_point: Long = 0
        var negative_limit: Long = zero_point - limit
        return value.number < limit and value.number > negative_limit
    }
    return false
}

func prove_both(first: SpiteCompiler.Value?, second: SpiteCompiler.Value?) {
    prove_value(first)
    prove_value(second)
}

func prove_value(value: SpiteCompiler.Value?) {
    fallback value
    prove_present(value)
}

func prove_present(value: SpiteCompiler.Value) {
    switch value {
        HighIntermediaryRepresentation.Values.AttributeRead: prove_value(value.object)
        HighIntermediaryRepresentation.Values.Call: prove_a_call(value)
        HighIntermediaryRepresentation.Values.MakeObject: prove_a_construction(value)
        HighIntermediaryRepresentation.Values.MachineOperation: prove_an_operation(value)
        HighIntermediaryRepresentation.Values.Negation: prove_value(value.negated)
        HighIntermediaryRepresentation.Values.ForeignCall: prove_a_foreign_call(value)
        HighIntermediaryRepresentation.Values.Class.Membership: prove_value(value.tested)
        HighIntermediaryRepresentation.Values.PresenceTest: prove_value(value.tested)
        HighIntermediaryRepresentation.Values.Conversion: prove_a_conversion(value)
        HighIntermediaryRepresentation.Values.Function.Value: prove_value(value.receiver)
        HighIntermediaryRepresentation.Values.Function.ValueCall: prove_a_value_call(value)
        HighIntermediaryRepresentation.Values.NumberRoom: prove_both(value.made, value.number)
        HighIntermediaryRepresentation.Values.ShapeCall: prove_a_shape_call(value)
        HighIntermediaryRepresentation.Values.EnumText: prove_value(value.number)
        HighIntermediaryRepresentation.Values.EnumFromText: prove_value(value.text)
        HighIntermediaryRepresentation.Values.Class.OfValue: prove_value(value.described)
        HighIntermediaryRepresentation.Values.WholeNumber: return
        HighIntermediaryRepresentation.Values.DecimalNumber: return
        HighIntermediaryRepresentation.Values.TextConstant: return
        HighIntermediaryRepresentation.Values.NullConstant: return
        HighIntermediaryRepresentation.Values.LocalRead: return
        HighIntermediaryRepresentation.Values.ThisRead: return
        HighIntermediaryRepresentation.Values.Class.Object: return
        HighIntermediaryRepresentation.Values.Function.Fact: return
    }
}

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func prove_a_conversion(conversion: HighIntermediaryRepresentation.Values.Conversion) {
    prove_value(conversion.converted)
    var narrows = conversion.kind == 'narrow' or conversion.kind == 'to_whole' or conversion.kind == 'narrow_decimal'
    fallback narrows and proving
    var inner = range_of(conversion.converted)
    if inner and conversion.kind == 'narrow' {
        conversion.is_proven_to_fit = fits(inner, conversion.value_type)
    }
    if conversion.kind == 'narrow' and not conversion.is_proven_to_fit {
        conversion.is_proven_to_fit = is_a_constant_that_fits(conversion.converted, conversion.value_type)
    }
    if conversion.kind != 'narrow' {
        conversion.is_proven_to_fit = is_a_decimal_that_fits(conversion)
    }
    var site = HighIntermediaryRepresentation.NarrowingSite(proving, proving_line, conversion)
    narrowing_sites.append(site)
}

# ../../PROOFS.md#a-range-proves-a-decimal-fits
func is_a_decimal_that_fits(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    var floors = decimal_range_of(conversion.converted)
    fallback floors
    if conversion.kind == 'narrow_decimal' {
        return true
    }
    return fits(floors, conversion.value_type)
}

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func is_a_constant_that_fits(value: SpiteCompiler.Value?, wanted: Model.Type): Boolean {
    var number = constant_of(value)
    fallback number and value
    fallback value.value_type.name != "UnsignedLong"
    return number.number >= type_lowest(wanted) and number.number <= type_highest(wanted)
}

func constant_of(value: SpiteCompiler.Value?): HighIntermediaryRepresentation.Values.WholeNumber? {
    if value.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return value
    }
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        var key = "{value.attribute.owner}.{value.attribute.name}"
        var number = numbers_nothing_writes[key]
        if number.class == HighIntermediaryRepresentation.Values.WholeNumber {
            return number
        }
    }
    return null
}

func prove_a_call(call: HighIntermediaryRepresentation.Values.Call) {
    prove_value(call.receiver)
    call.arguments.each(prove_present)
    forget_the_paths("")
}

func prove_a_foreign_call(call: HighIntermediaryRepresentation.Values.ForeignCall) {
    prove_value(call.library)
    call.arguments.each(prove_present)
    forget_the_paths("")
}

func prove_a_value_call(call: HighIntermediaryRepresentation.Values.Function.ValueCall) {
    prove_value(call.called)
    call.arguments.each(prove_present)
    forget_the_paths("")
}

func prove_a_shape_call(call: HighIntermediaryRepresentation.Values.ShapeCall) {
    prove_value(call.receiver)
    call.arguments.each(prove_present)
    forget_the_paths("")
}

func prove_a_construction(made: HighIntermediaryRepresentation.Values.MakeObject) {
    made.arguments.each(prove_present)
    forget_the_paths("")
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func prove_an_operation(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    if operation.is_visited_by_ranges {
        prove_a_visit_again(operation)
        return
    }
    operation.is_visited_by_ranges = true
    var links = [operation]
    var lowest = operation
    var next = unvisited_left_link_of(lowest)
    while next {
        next.is_visited_by_ranges = true
        links.append(next)
        lowest = next
        next = unvisited_left_link_of(lowest)
    }
    prove_value(lowest.left)
    var left = range_of(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        prove_value(link.right)
        var right = range_of(link.right)
        prove_after_both(link, left, right)
        left = range_from_both(link, left, right)
        index = index - 1
    }
}

func unvisited_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    fallback not left.is_visited_by_ranges
    return left
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func prove_a_visit_again(operation: HighIntermediaryRepresentation.Values.MachineOperation) {
    var links = [operation]
    var copies = [copy_to_visit_again(operation)]
    var lowest = operation
    var next = visited_left_link_of(lowest)
    while next {
        var copied = copy_to_visit_again(next)
        copies.append(copied)
        links.append(next)
        lowest = next
        next = visited_left_link_of(lowest)
    }
    prove_value(lowest.left)
    var left = range_of(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        var again = copies[index]
        crash link
        crash again
        prove_value(link.right)
        var right = range_of(link.right)
        prove_after_both(again, left, right)
        keep_what_both_visits_prove(link, again)
        left = range_from_both(again, left, right)
        index = index - 1
    }
}

func copy_to_visit_again(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation {
    crash operation.left
    crash operation.right
    return HighIntermediaryRepresentation.Values.MachineOperation(
        operation.value_type,
        operation.operator,
        operation.left,
        operation.right,
        operation.written,
    )
}

func visited_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    fallback left.is_visited_by_ranges
    return left
}

func keep_what_both_visits_prove(
    kept: HighIntermediaryRepresentation.Values.MachineOperation,
    again: HighIntermediaryRepresentation.Values.MachineOperation,
) {
    kept.is_proven_to_fit = kept.is_proven_to_fit and again.is_proven_to_fit
    kept.is_divisor_proven = kept.is_divisor_proven and again.is_divisor_proven
    var same_number = kept.folded_number == again.folded_number
    kept.is_folded = kept.is_folded and again.is_folded and same_number
    kept.are_ranges_studied = kept.are_ranges_studied and again.are_ranges_studied
    kept.is_left_ranged = kept.is_left_ranged and again.is_left_ranged
    kept.left_lowest = smaller(kept.left_lowest, again.left_lowest)
    kept.left_highest = larger(kept.left_highest, again.left_highest)
    kept.is_right_ranged = kept.is_right_ranged and again.is_right_ranged
    kept.right_lowest = smaller(kept.right_lowest, again.right_lowest)
    kept.right_highest = larger(kept.right_highest, again.right_highest)
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func prove_after_both(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    left: NumberRange?,
    right: NumberRange?,
) {
    if operation.operator == 'divide' or operation.operator == 'remainder' {
        prove_the_divisor(operation, left, right)
        return
    }
    fallback is_checked_arithmetic(operation)
    operation.are_ranges_studied = true
    if left {
        operation.is_left_ranged = true
        operation.left_lowest = left.lowest
        operation.left_highest = left.highest
    }
    if right {
        operation.is_right_ranged = true
        operation.right_lowest = right.lowest
        operation.right_highest = right.highest
    }
    fallback left and right
    var answer = combined(operation.operator, left, right)
    fallback answer
    operation.is_proven_to_fit = fits(answer, operation.value_type)
    fallback operation.is_proven_to_fit and answer.holds_one_value()
    var both_plain = is_plain(operation.left) and is_plain(operation.right)
    fallback both_plain
    operation.is_folded = true
    operation.folded_number = answer.lowest
}

func prove_the_divisor(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    left: NumberRange?,
    right: NumberRange?,
) {
    fallback is_whole(operation.value_type)
    if right {
        operation.is_divisor_proven = right.lowest > 0 or right.highest < -1
    }
    fallback not operation.is_divisor_proven
    var path = attribute_path_of(operation.right)
    if path != "" {
        prove_a_path_divisor(operation, path, left)
        return
    }
    prove_a_divisor_not_zero(operation, left, right)
}

# ../../PROOFS.md#a-proven-divisor-is-not-checked
func prove_a_path_divisor(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    path: String,
    left: NumberRange?,
) {
    var nonzero = ranges["@{path}|nonzero"]
    fallback nonzero
    var above = ranges["@{path}|above"]
    var never_minus_one = false
    if above {
        never_minus_one = above.lowest > -1
    }
    var never_smallest = false
    if left {
        never_smallest = left.lowest > type_lowest(operation.value_type)
    }
    operation.is_divisor_proven = never_minus_one or never_smallest
}

# ../../PROOFS.md#a-proven-divisor-is-not-checked
func prove_a_divisor_not_zero(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    left: NumberRange?,
    right: NumberRange?,
) {
    var divisor = local_name_of(operation.right)
    fallback divisor != ""
    var nonzero = ranges["{divisor}|nonzero"]
    fallback nonzero
    var never_minus_one = false
    if right {
        never_minus_one = right.lowest > -1 or right.highest < -1
    }
    var never_smallest = false
    if left {
        never_smallest = left.lowest > type_lowest(operation.value_type)
    }
    operation.is_divisor_proven = never_minus_one or never_smallest
}

func is_plain(value: SpiteCompiler.Value?): Boolean {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return true
        HighIntermediaryRepresentation.Values.LocalRead: return true
        HighIntermediaryRepresentation.Values.Conversion: return is_a_plain_widening(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return value.is_proven_to_fit
        HighIntermediaryRepresentation.Values.DecimalNumber: return false
        HighIntermediaryRepresentation.Values.TextConstant: return false
        HighIntermediaryRepresentation.Values.NullConstant: return false
        HighIntermediaryRepresentation.Values.ThisRead: return false
        HighIntermediaryRepresentation.Values.AttributeRead: return false
        HighIntermediaryRepresentation.Values.Call: return false
        HighIntermediaryRepresentation.Values.MakeObject: return false
        HighIntermediaryRepresentation.Values.Negation: return false
        HighIntermediaryRepresentation.Values.ForeignCall: return false
        HighIntermediaryRepresentation.Values.Class.Membership: return false
        HighIntermediaryRepresentation.Values.PresenceTest: return false
        HighIntermediaryRepresentation.Values.Function.Value: return false
        HighIntermediaryRepresentation.Values.Function.ValueCall: return false
        HighIntermediaryRepresentation.Values.NumberRoom: return false
        HighIntermediaryRepresentation.Values.ShapeCall: return false
        HighIntermediaryRepresentation.Values.EnumText: return false
        HighIntermediaryRepresentation.Values.EnumFromText: return false
        HighIntermediaryRepresentation.Values.Class.Object: return false
        HighIntermediaryRepresentation.Values.Class.OfValue: return false
        HighIntermediaryRepresentation.Values.Function.Fact: return false
    }
}

func is_a_plain_widening(conversion: HighIntermediaryRepresentation.Values.Conversion): Boolean {
    fallback conversion.kind == 'widen'
    return is_plain(conversion.converted)
}

func is_checked_arithmetic(operation: HighIntermediaryRepresentation.Values.MachineOperation): Boolean {
    var operator = operation.operator
    var is_checked = operator == 'add' or operator == 'subtract' or operator == 'multiply'
    return is_checked and is_whole(operation.value_type)
}

func range_of(value: SpiteCompiler.Value?): NumberRange? {
    fallback value
    switch value {
        HighIntermediaryRepresentation.Values.WholeNumber: return constant_range(value)
        HighIntermediaryRepresentation.Values.LocalRead: return local_range(value)
        HighIntermediaryRepresentation.Values.Conversion: return converted_range(value)
        HighIntermediaryRepresentation.Values.MachineOperation: return operation_range(value)
        HighIntermediaryRepresentation.Values.Call: return call_range(value)
        HighIntermediaryRepresentation.Values.DecimalNumber: return any_value_of(value)
        HighIntermediaryRepresentation.Values.TextConstant: return any_value_of(value)
        HighIntermediaryRepresentation.Values.NullConstant: return any_value_of(value)
        HighIntermediaryRepresentation.Values.ThisRead: return any_value_of(value)
        HighIntermediaryRepresentation.Values.AttributeRead: return attribute_range(value)
        HighIntermediaryRepresentation.Values.MakeObject: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Negation: return any_value_of(value)
        HighIntermediaryRepresentation.Values.ForeignCall: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Class.Membership: return any_value_of(value)
        HighIntermediaryRepresentation.Values.PresenceTest: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Function.Value: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Function.ValueCall: return any_value_of(value)
        HighIntermediaryRepresentation.Values.NumberRoom: return any_value_of(value)
        HighIntermediaryRepresentation.Values.ShapeCall: return any_value_of(value)
        HighIntermediaryRepresentation.Values.EnumText: return any_value_of(value)
        HighIntermediaryRepresentation.Values.EnumFromText: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Class.Object: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Class.OfValue: return any_value_of(value)
        HighIntermediaryRepresentation.Values.Function.Fact: return any_value_of(value)
    }
}

func any_value_of(value: SpiteCompiler.Value?): NumberRange? {
    fallback value
    return type_range(value.value_type)
}

# ../../PROOFS.md#an-attribute-nothing-writes-is-read-as-its-default
func attribute_range(read: HighIntermediaryRepresentation.Values.AttributeRead): NumberRange? {
    var key = "{read.attribute.owner}.{read.attribute.name}"
    var number = numbers_nothing_writes[key]
    if number.class == HighIntermediaryRepresentation.Values.WholeNumber {
        return constant_range(number)
    }
    return any_value_of(read)
}

func constant_range(number: HighIntermediaryRepresentation.Values.WholeNumber): NumberRange? {
    fallback is_whole(number.value_type)
    var zero_point: Long = 0
    var negative_limit: Long = zero_point - limit
    fallback number.number < limit and number.number > negative_limit
    return NumberRange(number.number, number.number)
}

func local_range(read: HighIntermediaryRepresentation.Values.LocalRead): NumberRange? {
    fallback is_whole(read.value_type)
    var known = ranges[read.name]
    if known {
        return known
    }
    return type_range(read.value_type)
}

func converted_range(conversion: HighIntermediaryRepresentation.Values.Conversion): NumberRange? {
    fallback is_whole(conversion.value_type)
    if conversion.kind == 'present' {
        return present_range(conversion)
    }
    var is_kept = conversion.kind == 'widen' or conversion.kind == 'narrow'
    if not is_kept {
        return type_range(conversion.value_type)
    }
    var inner = range_of(conversion.converted)
    if not inner {
        return type_range(conversion.value_type)
    }
    var cut = cut_to(inner, conversion.value_type)
    if cut {
        return cut
    }
    return type_range(conversion.value_type)
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func present_range(conversion: HighIntermediaryRepresentation.Values.Conversion): NumberRange? {
    var name = present_name_of(conversion)
    var known = ranges[name]
    if name != "" and known {
        return known
    }
    return type_range(conversion.value_type)
}

# ../../ARCHITECTURE.md#an-operator-chain-is-walked-in-a-loop
func operation_range(operation: HighIntermediaryRepresentation.Values.MachineOperation): NumberRange? {
    var links = [operation]
    var lowest = operation
    var next = ranged_left_link_of(lowest)
    while next {
        links.append(next)
        lowest = next
        next = ranged_left_link_of(lowest)
    }
    var ranged = range_of(lowest.left)
    var index = links.count() - 1
    while index >= 0 {
        var link = links[index]
        crash link
        var right = range_of(link.right)
        ranged = range_from_both(link, ranged, right)
        index = index - 1
    }
    return ranged
}

func ranged_left_link_of(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
): HighIntermediaryRepresentation.Values.MachineOperation? {
    var left = operation.left
    fallback left.class == HighIntermediaryRepresentation.Values.MachineOperation
    return left
}

func range_from_both(
    operation: HighIntermediaryRepresentation.Values.MachineOperation,
    left: NumberRange?,
    right: NumberRange?,
): NumberRange? {
    fallback is_whole(operation.value_type)
    var answer: NumberRange? = null
    if left and right {
        answer = combined(operation.operator, left, right)
    }
    if not answer and left {
        answer = divided_by_anything(operation.operator, left)
    }
    if not answer and right and operation.operator == 'remainder' {
        answer = remainder_of_anything(right)
    }
    if answer {
        var cut = cut_to(answer, operation.value_type)
        if cut {
            return cut
        }
    }
    return type_range(operation.value_type)
}

func divided_by_anything(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: NumberRange,
): NumberRange? {
    var low_size = magnitude(left.lowest)
    var high_size = magnitude(left.highest)
    var size = larger(low_size, high_size)
    var zero: Long = 0
    if operator == 'divide' {
        return NumberRange(zero - size, size)
    }
    if operator == 'remainder' {
        var low = smaller(left.lowest, zero)
        var high = larger(left.highest, zero)
        return NumberRange(low, high)
    }
    return null
}

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func remainder_of_anything(right: NumberRange): NumberRange? {
    var low_size = magnitude(right.lowest)
    var high_size = magnitude(right.highest)
    var size = larger(low_size, high_size)
    fallback size > 0
    var zero: Long = 0
    var below = size - 1
    return NumberRange(zero - below, below)
}

func combined(
    operator: HighIntermediaryRepresentation.Values.MachineOperation.Operator,
    left: NumberRange,
    right: NumberRange,
): NumberRange? {
    switch operator {
        'add': return within_the_limit(left.lowest + right.lowest, left.highest + right.highest)
        'subtract': return within_the_limit(left.lowest - right.highest, left.highest - right.lowest)
        'multiply': return multiplied(left, right)
        'divide': return divided(left, right)
        'remainder': return remainder_of(left, right)
        'equal': return null
        'not_equal': return null
        'less': return null
        'less_or_equal': return null
        'greater': return null
        'greater_or_equal': return null
        'and': return null
        'or': return null
    }
}

func is_within_the_limit(found: NumberRange): Boolean {
    var zero_point: Long = 0
    var negative_limit: Long = zero_point - limit
    return found.lowest > negative_limit and found.highest < limit
}

func within_the_limit(low: Long, high: Long): NumberRange? {
    var zero_point: Long = 0
    var negative_limit: Long = zero_point - limit
    var is_within = low > negative_limit and high < limit
    fallback is_within
    return NumberRange(low, high)
}

func multiplied(left: NumberRange, right: NumberRange): NumberRange? {
    var products = List<Long>()
    var fit = product_into(left.lowest, right.lowest, products)
    fit = fit and product_into(left.lowest, right.highest, products)
    fit = fit and product_into(left.highest, right.lowest, products)
    fit = fit and product_into(left.highest, right.highest, products)
    fallback fit
    var zero: Long = 0
    var low: Long = limit
    var high: Long = zero - limit
    var index = 0
    while index < products.count() {
        var product = products[index]
        low = smaller(low, product)
        high = larger(high, product)
        index = index + 1
    }
    return within_the_limit(low, high)
}

func product_into(first: Long, second: Long, products: List<Long>): Boolean {
    if first == 0 or second == 0 {
        products.append(0)
        return true
    }
    var first_size = magnitude(first)
    var second_size = magnitude(second)
    var room: Long = limit / second_size
    fallback first_size < room
    products.append(first * second)
    return true
}

func divided(left: NumberRange, right: NumberRange): NumberRange? {
    if not right.holds_one_value() or right.lowest == 0 {
        return divided_by_anything('divide', left)
    }
    var first: Long = left.lowest / right.lowest
    var second: Long = left.highest / right.lowest
    var low = smaller(first, second)
    var high = larger(first, second)
    return NumberRange(low, high)
}

func remainder_of(left: NumberRange, right: NumberRange): NumberRange? {
    var low_size = magnitude(right.lowest)
    var high_size = magnitude(right.highest)
    var divisor_size = larger(low_size, high_size)
    if divisor_size == 0 {
        return divided_by_anything('remainder', left)
    }
    var zero: Long = 0
    var room: Long = divisor_size - 1
    var low = larger(left.lowest, zero - room)
    var high = smaller(left.highest, room)
    low = smaller(low, zero)
    high = larger(high, zero)
    if left.lowest >= 0 {
        low = zero
    }
    if left.highest <= 0 {
        high = zero
    }
    return NumberRange(low, high)
}

func call_range(call: HighIntermediaryRepresentation.Values.Call): NumberRange? {
    fallback is_whole(call.value_type)
    var owner = program.class_named(call.function.owner)
    if not owner {
        return type_range(call.value_type)
    }
    var library = Mapping.LibraryFile()
    if not library.holds(owner.file.path) {
        return type_range(call.value_type)
    }
    if is_a_count(call, owner) {
        var largest: Long = _largest_integer
        return NumberRange(0, largest)
    }
    var bounded = number_function_range(call)
    if bounded {
        var cut = cut_to(bounded, call.value_type)
        if cut {
            return cut
        }
    }
    return type_range(call.value_type)
}

func is_a_count(call: HighIntermediaryRepresentation.Values.Call, owner: Model.ClassModel): Boolean {
    fallback call.arguments.is_empty()
    var name = call.function.name
    if name == "length" {
        return owner.key == "String"
    }
    fallback name == "count"
    var shown = owner.shown
    var is_listed = shown.starts_with("List<") or shown.starts_with("Dictionary<")
    return is_listed or shown.starts_with("Vector<") or shown.starts_with("Items<")
}

# ../../PROOFS.md#a-number-that-may-not-fit-is-narrowed
func masked_range(call: HighIntermediaryRepresentation.Values.Call): NumberRange? {
    var mask = argument_range(call, 0)
    fallback mask
    fallback mask.lowest >= 0
    return NumberRange(0, mask.highest)
}

func number_function_range(call: HighIntermediaryRepresentation.Values.Call): NumberRange? {
    fallback scalars.is_a_scalar(call.function.owner)
    var name = call.function.name
    if name == "bits_and" {
        return masked_range(call)
    }
    if name == "shifted_right" or name == "_shifted_right" {
        return shifted_right_range(call)
    }
    var receiver = range_of(call.receiver)
    fallback receiver
    if name == "to_long" or name == "to_integer" {
        return receiver
    }
    if name == "absolute" {
        return absolute_of(receiver)
    }
    var first = argument_range(call, 0)
    fallback first
    if name == "minimum" {
        return smallest_of(receiver, first)
    } else if name == "maximum" {
        return largest_of(receiver, first)
    } else if name == "clamp" {
        return clamped(call, first)
    } else {
        return null
    }
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func shifted_right_range(call: HighIntermediaryRepresentation.Values.Call): NumberRange? {
    var count = argument_range(call, 0)
    fallback count
    var scalar = scalars.of(call.value_type.name)
    crash scalar
    var width: Long = scalar.size * 8
    var zero: Long = 0
    var fewest = larger(count.lowest, zero)
    var most = count.highest
    if call.function.name == "_shifted_right" {
        fallback count.lowest >= 0 and most < width
    }
    fallback fewest <= most
    var receiver = range_of(call.receiver)
    if receiver and receiver.lowest >= 0 {
        var low = halved(receiver.lowest, most)
        var high = halved(receiver.highest, fewest)
        return NumberRange(low, high)
    }
    fallback not scalar.is_signed
    var kept_bits = width - fewest
    return room_of(kept_bits)
}

func halved(number: Long, times: Long): Long {
    var answer = number
    var done: Long = 0
    while done < times and answer > 0 {
        answer = answer / 2
        done = done + 1
    }
    return answer
}

func room_of(bits: Long): NumberRange? {
    var room: Long = 1
    var done: Long = 0
    while done < bits {
        fallback room < limit
        room = room * 2
        done = done + 1
    }
    return within_the_limit(0, room - 1)
}

# ../../PROOFS.md#a-range-proves-arithmetic-fits
func absolute_of(found: NumberRange): NumberRange {
    var low_size = magnitude(found.lowest)
    var high_size = magnitude(found.highest)
    var high = larger(low_size, high_size)
    var zero: Long = 0
    var low = zero
    if found.lowest >= 0 {
        low = found.lowest
    }
    if found.highest <= 0 {
        low = high_size
    }
    return NumberRange(low, high)
}

func smallest_of(first: NumberRange, second: NumberRange): NumberRange {
    var low = smaller(first.lowest, second.lowest)
    var high = smaller(first.highest, second.highest)
    return NumberRange(low, high)
}

func largest_of(first: NumberRange, second: NumberRange): NumberRange {
    var low = larger(first.lowest, second.lowest)
    var high = larger(first.highest, second.highest)
    return NumberRange(low, high)
}

func clamped(call: HighIntermediaryRepresentation.Values.Call, low_bound: NumberRange): NumberRange? {
    var high_bound = argument_range(call, 1)
    fallback high_bound
    var low = smaller(low_bound.lowest, high_bound.lowest)
    return NumberRange(low, high_bound.highest)
}

func argument_range(call: HighIntermediaryRepresentation.Values.Call, index: Integer): NumberRange? {
    fallback index < call.arguments.count()
    var argument = call.arguments[index]
    return range_of(argument)
}

func fits(answer: NumberRange, of_type: Model.Type): Boolean {
    return answer.lowest >= type_lowest(of_type) and answer.highest <= type_highest(of_type)
}

func cut_to(found: NumberRange, of_type: Model.Type): NumberRange? {
    var type_low = type_lowest(of_type)
    var type_high = type_highest(of_type)
    var low = larger(found.lowest, type_low)
    var high = smaller(found.highest, type_high)
    fallback low <= high
    return NumberRange(low, high)
}

func is_whole(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar' and not of_type.is_nullable and of_type.name != "Boolean"
    var scalar = scalars.of(of_type.name)
    fallback scalar
    return not scalar.is_decimal
}

func is_decimal(of_type: Model.Type): Boolean {
    fallback of_type.kind == 'scalar' and not of_type.is_nullable
    var scalar = scalars.of(of_type.name)
    fallback scalar
    return scalar.is_decimal
}

func is_bounded(of_type: Model.Type): Boolean {
    var scalar = scalars.of(of_type.name)
    crash scalar
    return scalar.size <= 4
}

func type_range(of_type: Model.Type): NumberRange? {
    fallback is_whole(of_type) and is_bounded(of_type)
    var low = type_lowest(of_type)
    var high = type_highest(of_type)
    return NumberRange(low, high)
}

func type_lowest(of_type: Model.Type): Long {
    var scalar = scalars.of(of_type.name)
    crash scalar
    fallback scalar.is_signed
    var zero: Long = 0
    var widest: Long = _largest_long
    if scalar.size == 8 {
        return zero - widest
    }
    var half = half_of_the_span(scalar.size)
    return zero - half
}

func type_highest(of_type: Model.Type): Long {
    var scalar = scalars.of(of_type.name)
    crash scalar
    var widest: Long = _largest_long
    if scalar.size == 8 {
        return widest
    }
    var half = half_of_the_span(scalar.size)
    if scalar.is_signed {
        return half - 1
    }
    return half + half - 1
}

func half_of_the_span(size: Integer): Long {
    if size == 1 {
        return 128
    } else if size == 2 {
        return 32768
    } else {
        return 2147483648
    }
}

func magnitude(number: Long): Long {
    if number < 0 {
        var zero: Long = 0
        return zero - number
    }
    return number
}

func smaller(first: Long, second: Long): Long {
    if first < second {
        return first
    }
    return second
}

func larger(first: Long, second: Long): Long {
    if first > second {
        return first
    }
    return second
}

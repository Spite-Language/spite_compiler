# ../../PROOFS.md#whether-a-function-waits
# ../../PROOFS.md#whether-a-function-writes-a-parameter
# ../../PROOFS.md#whether-a-class-keeps-state
func check(high: HighIntermediaryRepresentation.HighProgram) {
    crash high.context
    var context = high.context
    fallback not context.facts_asked.is_empty()
    var no_exclusions = List<String>()
    var everything = HighIntermediaryRepresentation.Building.Facts(
        context.program,
        high.built_functions,
        no_exclusions,
    )
    var askers = List<String>()
    var index = 0
    while index < context.facts_asked.count() {
        var asked = context.facts_asked[index]
        var asks_in_code = asked.is_asked_in_code and asked.question == "waits"
        if asks_in_code and not askers.contains(asked.asking_key) {
            askers.append(asked.asking_key)
        }
        index = index + 1
    }
    var before = HighIntermediaryRepresentation.Building.Facts(context.program, high.built_functions, askers)
    var fact_index = 0
    while fact_index < context.facts_asked.count() {
        var fact = context.facts_asked[fact_index]
        answer_a_fact(fact, everything, before)
        fact_index = fact_index + 1
    }
}

func answer_a_fact(
    fact: HighIntermediaryRepresentation.Values.Function.Fact,
    everything: HighIntermediaryRepresentation.Building.Facts,
    before: HighIntermediaryRepresentation.Building.Facts,
) {
    var holds = false
    var index = 0
    while index < fact.asked_functions.count() {
        var function = fact.asked_functions[index]
        var found = answer_of(fact, function, everything)
        if fact.is_asked_in_code and fact.question == "waits" {
            var key = function.key()
            var earlier = before.waits(key)
            if earlier != found {
                refuse_a_paradox(fact, function, earlier, found)
            }
        }
        if found {
            holds = true
        }
        index = index + 1
    }
    fact.answered(holds)
}

func answer_of(
    fact: HighIntermediaryRepresentation.Values.Function.Fact,
    function: Model.FunctionModel,
    facts: HighIntermediaryRepresentation.Building.Facts,
): Boolean {
    var key = function.key()
    if fact.question == "waits" {
        return facts.waits(key)
    }
    if fact.question == "keeps_state" {
        return facts.writes(function, "this") or facts.writes_a_singleton(function)
    }
    var slot = fact.slot
    if fact.parameter_index >= 0 {
        var parameter = function.parameters[fact.parameter_index]
        crash parameter
        slot = "p:{parameter.name}"
    }
    if fact.question == "writes" {
        var writes = facts.writes(function, slot)
        if writes and fact.parameter_index >= 0 {
            fact.found_place = place_of_the_write(function, fact.parameter_index, slot, facts)
        }
        return writes
    }
    var is_a_write = fact.question == "written"
    return facts.accesses(key, slot, is_a_write)
}

func place_of_the_write(
    function: Model.FunctionModel,
    parameter_index: Integer,
    slot: String,
    facts: HighIntermediaryRepresentation.Building.Facts,
): String {
    var parameter = function.parameters[parameter_index]
    crash parameter
    var asked = simple_function_name(function)
    var said = "'{asked}' writes its parameter '{parameter.name}'"
    var place = facts.place_of_a_write(function, slot)
    if place.is_empty() {
        return said
    }
    var source = facts.source_of_a_write(function, slot)
    return "{said} at {place}: '{source}'"
}

func simple_function_name(function: Model.FunctionModel): String {
    var segments = function.owner.split(".")
    var last = segments.last()
    crash last
    var simple = last
    var opening = last.index_of("<")
    if opening and opening > 0 {
        var sliced_simple = last.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    return "{simple}.{function.name}"
}

func refuse_a_paradox(
    fact: HighIntermediaryRepresentation.Values.Function.Fact,
    function: Model.FunctionModel,
    earlier: Boolean,
    found: Boolean,
) {
    var segments = function.owner.split(".")
    var last = segments.last()
    crash last
    var simple = last
    var opening = last.index_of("<")
    if opening and opening > 0 {
        var sliced_simple = last.slice(0, opening)
        crash sliced_simple
        simple = sliced_simple
    }
    var asked = "{simple}.{function.name}"
    var failure = Validators.Failure()
    failure.stop_inside(
        fact.path,
        fact.line,
        fact.owner_shown,
        fact.function_name,
        "whether '{asked}' can wait was answered {earlier} here, before the functions that ask 'function_waits' were compiled, and it is {found} once they are: it reaches one of them, or a function value made in one, so its answer would decide itself, so ask from a function that '{asked}' does not reach",
    )
}

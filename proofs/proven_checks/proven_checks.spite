# ../../PROOFS.md#proving-what-is-proven-is-an-error
var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var typing = Validators.HighIntermediaryRepresentation.Typing.Validator()

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.CheckSite) {
    entered.enter(site.owner, site.function, site.line)
    if site.kind == "proven check" {
        refuse_a_proven_check(site)
    }
    if site.kind == "proven read" {
        refuse_a_proven_read_check(site)
    }
    if site.kind == "plain value" {
        refuse_a_check_of_a_plain_value(site)
    }
    if site.kind == "copy" {
        refuse_a_copy(site)
    }
}

func refuse_a_proven_check(site: HighIntermediaryRepresentation.Building.CheckSite) {
    assert site.check
    typing.refuse_proven_check(context, site.written, site.check)
}

func refuse_a_proven_read_check(site: HighIntermediaryRepresentation.Building.CheckSite) {
    assert site.check
    assert site.check.starts_with("the loop condition ")
    typing.refuse_proven_read(context, site.written, site.check, site.keyword)
}

func refuse_a_check_of_a_plain_value(site: HighIntermediaryRepresentation.Building.CheckSite) {
    var path = context.path()
    var is_generated = path.contains("/.spite/")
    assert not site.is_converted and not is_generated
    var checked_type = site.checked_type
    var is_plain = checked_type.kind == 'object' or checked_type.kind == 'union' or checked_type.kind == 'shape'
    assert is_plain and not checked_type.is_nullable
    var shown = context.shown(checked_type)
    typing.refuse_a_check_of_a_plain_value(context, shown, site.keyword)
}

func refuse_a_copy(site: HighIntermediaryRepresentation.Building.CheckSite) {
    crash site.source
    typing.refuse_copy_to_narrow(context, site.written, site.source)
}

var no_model = Model.ProgramModel()
var no_program = HighIntermediaryRepresentation.HighProgram(no_model)
var assignments = HighIntermediaryRepresentation.Assignments(no_program)
var has_read_the_program = false
var writes = HighIntermediaryRepresentation.Writes()
var high: HighIntermediaryRepresentation.HighProgram?

func KeptCopies(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func keeps_a_value(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    crash high
    var index = 0
    while index < high.narrowed_reads.count() {
        var read = high.narrowed_reads[index]
        if read.copy_line == site.line and read.shown == site.copied_path and may_change_under(read) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_change_under(read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    crash high
    if not has_read_the_program {
        assignments.read_for_narrowings(high)
        has_read_the_program = true
    }
    assignments.logged_function_key = read.function_key
    if not read.getter.is_empty() {
        return getter_may_change_under(read)
    }
    var attributes = writes.attributes_of(read, high.model)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        var reaches = not read.is_left_behind(index)
        var may_change = is_handed_what_holds_it(read, value) or writes.undoes(read, index)
        if reaches and (may_change or may_assign_one_of(value, attributes)) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-getter-narrows-while-it-only-reads
func getter_may_change_under(read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    if assignments.may_have_an_effect(read.getter) {
        return true
    }
    var attributes = assignments.attributes_read_by(read.getter)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        var written = writes.attribute_a_getter_reads(read, index, attributes)
        var reaches = not read.is_left_behind(index)
        var may_change = is_handed_what_holds_it(read, value) or may_assign_one_of(value, attributes)
        if reaches and (written or may_change) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_assign_one_of(value: SpiteCompiler.Value, attributes: List<Model.AttributeModel>): Boolean {
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        if assignments.value_may_assign(value, attribute) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-call-handed-what-holds-a-path-may-change-it
func is_handed_what_holds_it(read: HighIntermediaryRepresentation.NarrowedRead, called: SpiteCompiler.Value): Boolean {
    var holders = List<SpiteCompiler.Value>()
    note_the_holders(read.path_value, holders)
    fallback not holders.is_empty()
    var handed = List<SpiteCompiler.Value>()
    note_what_is_handed(called, handed)
    var index = 0
    while index < handed.count() {
        var given = handed[index]
        if is_one_of(given, holders) {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_holders(value: SpiteCompiler.Value?, holders: List<SpiteCompiler.Value>) {
    fallback value
    if value.class == HighIntermediaryRepresentation.Values.Conversion {
        note_the_holders(value.converted, holders)
        return
    }
    var holder = holder_of(value)
    fallback holder and holder.class != HighIntermediaryRepresentation.Values.ThisRead
    holders.append(holder)
    note_the_holders(holder, holders)
}

func holder_of(value: SpiteCompiler.Value): SpiteCompiler.Value? {
    if value.class == HighIntermediaryRepresentation.Values.AttributeRead {
        return value.object
    }
    if value.class == HighIntermediaryRepresentation.Values.Call {
        return value.receiver
    }
    return null
}

func note_what_is_handed(called: SpiteCompiler.Value?, handed: List<SpiteCompiler.Value>) {
    fallback called
    if called.class == HighIntermediaryRepresentation.Values.Conversion {
        note_what_is_handed(called.converted, handed)
        return
    }
    if called.class == HighIntermediaryRepresentation.Values.Call {
        note_a_receiver(called.receiver, handed)
        called.arguments.each(handed.append)
    }
    if called.class == HighIntermediaryRepresentation.Values.ShapeCall {
        note_a_receiver(called.receiver, handed)
        called.arguments.each(handed.append)
    }
    if called.class == HighIntermediaryRepresentation.Values.Function.ValueCall {
        note_a_receiver(called.called, handed)
        called.arguments.each(handed.append)
    }
    if called.class == HighIntermediaryRepresentation.Values.MakeObject {
        called.arguments.each(handed.append)
    }
    if called.class == HighIntermediaryRepresentation.Values.ForeignCall {
        called.arguments.each(handed.append)
    }
}

func note_a_receiver(receiver: SpiteCompiler.Value?, handed: List<SpiteCompiler.Value>) {
    fallback receiver
    handed.append(receiver)
}

func is_one_of(given: SpiteCompiler.Value, holders: List<SpiteCompiler.Value>): Boolean {
    if given.class == HighIntermediaryRepresentation.Values.Conversion {
        crash given.converted
        return is_one_of(given.converted, holders)
    }
    if given.class == HighIntermediaryRepresentation.Values.Function.Value {
        fallback given.receiver
        return is_one_of(given.receiver, holders)
    }
    var index = 0
    while index < holders.count() {
        var holder = holders[index]
        if writes.is_the_same_place(holder, given) {
            return true
        }
        index = index + 1
    }
    return false
}

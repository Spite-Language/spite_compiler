var high: HighIntermediaryRepresentation.HighProgram? = null
var no_model = Model.ProgramModel()
var no_program = HighIntermediaryRepresentation.HighProgram(no_model)
var assignments = HighIntermediaryRepresentation.Assignments(no_program)
var has_read_the_program = false
var writes = Proofs.NarrowingsKeptAcrossCalls.Writes()

func KeptCopies(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func keeps_a_value(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    crash high
    var index = 0
    while index < high.narrowed_reads.count() {
        var read = high.narrowed_reads[index]
        if read.copy_line == site.line and read.shown == site.copied_path and may_change_under(read) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_change_under(read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    crash high
    if not has_read_the_program {
        assignments.read_for_narrowings(high)
        has_read_the_program = true
    }
    if not read.getter.is_empty() {
        return getter_may_change_under(read)
    }
    var attributes = writes.attributes_of(read, high.model)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        var reaches = not read.is_left_behind(index)
        if reaches and (writes.undoes(read, index) or may_assign_one_of(value, attributes)) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#a-getter-narrows-while-it-only-reads
func getter_may_change_under(read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    if assignments.may_have_an_effect(read.getter) {
        return true
    }
    var attributes = assignments.attributes_read_by(read.getter)
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        var written = writes.attribute_a_getter_reads(read, index, attributes)
        var reaches = not read.is_left_behind(index)
        if reaches and (written or may_assign_one_of(value, attributes)) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_assign_one_of(value: SpiteCompiler.Value, attributes: List<Model.AttributeModel>): Boolean {
    var index = 0
    while index < attributes.count() {
        var attribute = attributes[index]
        if assignments.value_may_assign(value, attribute) {
            return true
        }
        index = index + 1
    }
    return false
}

var high: HighIntermediaryRepresentation.HighProgram? = null
var no_model = Model.ProgramModel()
var no_program = HighIntermediaryRepresentation.HighProgram(no_model)
var assignments = HighIntermediaryRepresentation.Assignments(no_program)
var has_read_the_program = false
var writes = Proofs.NarrowingsKeptAcrossCalls.Writes()

func KeptCopies(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
}

# ../../PROOFS.md#a-copy-made-to-narrow-is-an-error
func keeps_a_value(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    crash high
    var index = 0
    while index < high.narrowed_reads.count() {
        var read = high.narrowed_reads[index]
        if read.copy_line == site.line and read.shown == site.copied_path and may_change_under(read) {
            return true
        }
        index = index + 1
    }
    return false
}

func may_change_under(read: HighIntermediaryRepresentation.NarrowedRead): Boolean {
    crash high
    if not has_read_the_program {
        assignments.read_for_narrowings(high)
        has_read_the_program = true
    }
    var index = read.start
    while index < read.loop_end {
        var value = read.calls[index]
        crash value
        if writes.undoes(read, index) or assignments.value_may_assign(value, read.attribute) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error

var no_program = Model.ProgramModel()
var no_folders = Mapping.FolderMap()
var no_table = Symbols.SymbolTable(no_folders)
var no_resolver = NameResolution.Resolver(no_table)
var context = HighIntermediaryRepresentation.Building.Context(no_program, no_resolver)
var entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
var rule = Validators.HighIntermediaryRepresentation.ProvenCheck.Validator()
var fixing = Fixes.AfterBuilding.EveryFix()
var rules = Validators.HighIntermediaryRepresentation.EveryRule()
var judges_the_whole_build = false
var no_high = HighIntermediaryRepresentation.HighProgram(no_program)
var kept_copies = Proofs.ProvenChecks.KeptCopies(no_high)

func start(starting_context: HighIntermediaryRepresentation.Building.Context) {
    context = starting_context
    entered = HighIntermediaryRepresentation.Building.FunctionEntry(context)
}

func finish() {
    entered.leave()
}

func check_a_site(site: HighIntermediaryRepresentation.Building.CheckSite) {
    entered.enter(site.owner, site.function, site.line)
    fallback proves_the_check(site)
    var answer = rule.check(context, site)
    if answer.is_fixable() {
        fixing.fixed_a_check(context, site)
    }
    rules.tell(context, answer)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func proves_the_check(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    if site.kind == "proven check" {
        return proves_a_narrowed_check(site)
    }
    if site.kind == "proven read" {
        return proves_a_read_check(site)
    }
    if site.kind == "plain value" {
        return proves_a_check_of_a_plain_value(site)
    }
    if site.kind == "proven value" {
        return proves_a_check_of_a_proven_value(site)
    }
    if site.kind == "copy" {
        return proves_a_copy(site)
    }
    if site.kind == "repeated check" or site.kind == "proven divisor" {
        crash site.check
        return true
    }
    if site.kind == "always holds" or site.kind == "decided condition" {
        return true
    }
    if site.kind == "answered class test" {
        return not is_a_new_proof(site)
    }
    return false
}

func proves_a_narrowed_check(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    fallback site.check
    return not is_a_new_proof(site)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func is_a_new_proof(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    fallback site.kept_read
    if not judges_the_whole_build {
        return true
    }
    return kept_copies.may_change_under(site.kept_read)
}

# ../../PROOFS.md#proving-what-is-proven-is-an-error
func proves_a_read_check(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    fallback site.check
    return not site.is_narrowed_outside
}

func proves_a_check_of_a_plain_value(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    var path = context.path()
    var is_generated = path.contains("/.spite/")
    fallback not site.is_converted and not is_generated
    var checked_type = site.checked_type
    var is_plain = checked_type.kind == 'object' or checked_type.kind == 'union' or checked_type.kind == 'shape'
    return is_plain and not checked_type.is_nullable
}

# ../../PROOFS.md#a-value-proven-present-is-a-t
func proves_a_check_of_a_proven_value(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    var path = context.path()
    var is_generated = path.contains("/.spite/")
    var facts = context.presence
    fallback site.tested and not is_generated and judges_the_whole_build
    return facts.is_present(site.tested, site.function)
}

func proves_a_copy(site: HighIntermediaryRepresentation.Building.CheckSite): Boolean {
    crash site.source
    fallback judges_the_whole_build
    return not kept_copies.keeps_a_value(site)
}

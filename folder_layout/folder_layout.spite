# ../ARCHITECTURE.md#the-folders

func check() {
    var stages = [
        AbstractSyntaxTree
        CommandLine
        Fixes
        HighIntermediaryRepresentation
        HighOptimizationPasses
        LowIntermediaryRepresentation
        LowOptimizationPasses
        Mapping
        NameResolution
        Outputs
        Proofs
        Symbols
    ]
    stages.each(check_a_stage)
    Spite.Class.instances.each(check_a_folder)
}

func check_a_stage(stage: Spite.Class) {
    var has_the_entry = not stage.functions.is_empty()
    crash has_the_entry
}

func check_a_folder(folder: Spite.Class) {
    var names = folder.nested_classes.map_names()
    fallback not names.is_empty()
    var path = inside_the_compiler(folder.name_with_outer_classes)
    var depth = path.split(".").count()
    check_a_pass_folder(folder, path, names, depth)
    check_a_proof_folder(folder, path, names, depth)
    check_a_validator_folder(folder, path, names, depth)
    check_a_fix_folder(path, names, depth)
    check_a_printer_folder(path, names, depth)
}

func check_a_pass_folder(folder: Spite.Class, path: String, names: List<String>, depth: Integer) {
    var is_high = path.starts_with("HighOptimizationPasses.")
    var is_low = path.starts_with("LowOptimizationPasses.")
    fallback depth == 2 and (is_high or is_low)
    var has_a_pass = names.contains("Pass")
    crash has_a_pass
    var is_named_for_its_folder = not folder.functions.is_empty()
    var holds_its_entry = is_high or is_named_for_its_folder
    crash holds_its_entry
    var runs_as_its_pass = is_low or not is_named_for_its_folder
    crash runs_as_its_pass
}

func check_a_proof_folder(folder: Spite.Class, path: String, names: List<String>, depth: Integer) {
    fallback depth == 2 and path.starts_with("Proofs.")
    var has_a_proof = names.contains("Proof")
    crash has_a_proof
    var is_named_for_its_folder = not folder.functions.is_empty()
    crash not is_named_for_its_folder
}

func check_a_validator_folder(folder: Spite.Class, path: String, names: List<String>, depth: Integer) {
    fallback path.starts_with("Validators.")
    if depth == 2 {
        var has_every_rule = names.contains("EveryRule")
        crash has_every_rule
    }
    fallback depth == 3
    var has_a_validator = names.contains("Validator")
    crash has_a_validator
    folder.nested_classes.each(check_a_validator)
}

func check_a_validator(validator: Spite.Class) {
    var is_the_rule = validator.name == "Validator"
    crash is_the_rule
    var checks = validator.functions.count_name_starts_with("check")
    var refusals = validator.functions.count_name_starts_with("refuse")
    var has_a_check = checks > 0
    var has_a_refusal = refusals > 0
    crash has_a_check or has_a_refusal
}

func check_a_fix_folder(path: String, names: List<String>, depth: Integer) {
    fallback path.starts_with("Fixes.")
    if depth == 2 {
        var has_every_fix = names.contains("EveryFix")
        crash has_every_fix
    }
    fallback depth == 3
    var has_a_fix = names.contains("Fix")
    crash has_a_fix
}

func check_a_printer_folder(path: String, names: List<String>, depth: Integer) {
    fallback depth == 2 and path.starts_with("Printers.")
    var has_a_printer = names.contains("Printer")
    crash has_a_printer
}

func inside_the_compiler(name: String): String {
    var prefix = "SpiteCompiler."
    if not name.starts_with(prefix) {
        return name
    }
    var start = prefix.length()
    var end = name.length()
    var inside = name.slice(start, end)
    crash inside
    return inside
}

# ../ARCHITECTURE.md#the-folders

func check() {
    var stages = [
        AbstractSyntaxTree
        CommandLine
        Fixes
        HighIntermediaryRepresentation
        HighOptimizationPasses
        LowIntermediaryRepresentation
        LowOptimizationPasses
        Mapping
        NameResolution
        Outputs
        Proofs
        Symbols
    ]
    stages.each(check_a_stage)
    Spite.Namespace.instances.each(check_a_namespace)
}

func check_a_stage(stage: Spite.Namespace) {
    var names = stage.classes.map_names()
    var has_the_entry = names.contains(stage.name)
    crash has_the_entry
}

func check_a_namespace(namespace: Spite.Namespace) {
    var path = namespace.name_with_namespaces
    var names = namespace.classes.map_names()
    var depth = path.split(".").count()
    check_a_pass_folder(namespace, path, names, depth)
    check_a_proof_folder(namespace, path, names, depth)
    check_a_validator_folder(namespace, path, names, depth)
    check_a_fix_folder(path, names, depth)
    check_a_printer_folder(path, names, depth)
}

func check_a_pass_folder(namespace: Spite.Namespace, path: String, names: List<String>, depth: Integer) {
    var is_high = path.starts_with("HighOptimizationPasses.")
    var is_low = path.starts_with("LowOptimizationPasses.")
    fallback depth == 2 and (is_high or is_low)
    var has_a_pass = names.contains("Pass")
    crash has_a_pass
    fallback is_high
    var is_named_for_its_folder = names.contains(namespace.name)
    crash not is_named_for_its_folder
}

func check_a_proof_folder(namespace: Spite.Namespace, path: String, names: List<String>, depth: Integer) {
    fallback depth == 2 and path.starts_with("Proofs.")
    var has_a_proof = names.contains("Proof")
    crash has_a_proof
    var is_named_for_its_folder = names.contains(namespace.name)
    crash not is_named_for_its_folder
}

func check_a_validator_folder(namespace: Spite.Namespace, path: String, names: List<String>, depth: Integer) {
    fallback path.starts_with("Validators.")
    if depth == 2 and path != "Validators.HotReload" {
        var has_every_rule = names.contains("EveryRule")
        crash has_every_rule
    }
    fallback depth == 3
    var has_a_validator = names.contains("Validator")
    crash has_a_validator
    namespace.classes.each(check_a_validator)
}

func check_a_validator(validator: Spite.Class) {
    fallback validator.name == "Validator"
    var checks = validator.functions.count_name_starts_with("check")
    var refusals = validator.functions.count_name_starts_with("refuse")
    var has_a_check = checks > 0
    var has_a_refusal = refusals > 0
    crash has_a_check or has_a_refusal
}

func check_a_fix_folder(path: String, names: List<String>, depth: Integer) {
    fallback path.starts_with("Fixes.")
    if depth == 2 {
        var has_every_fix = names.contains("EveryFix")
        crash has_every_fix
    }
    fallback depth == 3
    var has_a_fix = names.contains("Fix")
    crash has_a_fix
}

func check_a_printer_folder(path: String, names: List<String>, depth: Integer) {
    fallback depth == 2 and path.starts_with("Printers.")
    var has_a_printer = names.contains("Printer")
    crash has_a_printer
}

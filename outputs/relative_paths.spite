var working_folder = ""

func RelativePaths(starting_working_folder: String) {
    working_folder = starting_working_folder
}

func link(from_folder: String, target: String): String {
    var from_segments = absolute_segments(from_folder)
    var target_segments = absolute_segments(target)
    var shared = 0
    var keep_going = true
    while keep_going {
        keep_going = is_shared_at(from_segments, target_segments, shared)
        if keep_going {
            shared = shared + 1
        }
    }
    var parts = List<String>()
    var climb = shared
    while climb < from_segments.count() {
        parts.append("..")
        climb = climb + 1
    }
    var rest = shared
    while rest < target_segments.count() {
        var segment = target_segments[rest]
        parts.append(segment)
        rest = rest + 1
    }
    return parts.join("/")
}

func is_shared_at(first: List<String>, second: List<String>, place: Integer): Boolean {
    if place >= first.count() or place >= second.count() {
        return false
    }
    var one = first[place]
    var other = second[place]
    var lower_one = one.lower_case()
    var lower_other = other.lower_case()
    return lower_one == lower_other
}

func absolute_segments(path: String): List<String> {
    var forward = path.replace("\\", "/")
    var whole = forward
    if not is_absolute(forward) {
        var working = working_folder.replace("\\", "/")
        whole = "{working}/{forward}"
    }
    var pieces = whole.split("/")
    var kept = List<String>()
    var index = 0
    while index < pieces.count() {
        var piece = pieces[index]
        keep_a_piece(kept, piece)
        index = index + 1
    }
    return kept
}

func keep_a_piece(kept: List<String>, piece: String) {
    assert not piece.is_empty() and piece != "."
    if piece == ".." and not kept.is_empty() {
        crash kept.remove_last()
        return
    }
    kept.append(piece)
}

func is_absolute(path: String): Boolean {
    return path.starts_with("/") or path.contains(":")
}

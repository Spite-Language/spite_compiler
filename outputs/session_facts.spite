# ../../spite_documentation/repl.md#typing-spite-into-a-running-program

var no_program = Model.ProgramModel()
var high = HighIntermediaryRepresentation.HighProgram(no_program)
var found = Dictionary<String, Model.Type>()

func SessionFacts(starting_high: HighIntermediaryRepresentation.HighProgram) {
    high = starting_high
}

# ../HOT_RELOAD.md#lines-typed-at-the-repl
func told(): List<String> {
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var is_the_line = function.function.owner == "Spite.Session" and function.function.name == "run_line"
        if is_the_line {
            function.body.statements.each(note_a_declaration)
        }
        index = index + 1
    }
    var lines = List<String>()
    var value = found["line_value"]
    if value {
        var shown_value = shown_of(value)
        lines.append("session value\t{shown_value}")
    }
    var name_index = 0
    while name_index < high.session_variables.count() {
        var name = high.session_variables[name_index]
        var declared = found[name]
        if declared and is_kept(declared) {
            var shown = shown_of(declared)
            lines.append("session var\t{name}\t{shown}")
        } else {
            lines.append("session var\t{name}")
        }
        name_index = name_index + 1
    }
    return lines
}

func note_a_declaration(statement: SpiteCompiler.Statement) {
    fallback statement.class == HighIntermediaryRepresentation.Statements.Declare
    var is_the_value = statement.name == "line_value"
    fallback is_the_value or high.session_variables.contains(statement.name)
    found[statement.name] = statement.declared_type
}

func is_kept(declared: Model.Type): Boolean {
    var kind = declared.kind
    if kind == 'scalar' or kind == 'enumeration' {
        return true
    }
    fallback kind == 'object'
    var model = high.model.class_named(declared.name)
    fallback model
    return not model.is_an_object_literal
}

func shown_of(declared: Model.Type): String {
    crash high.context
    return high.context.shown(declared)
}

var program = Program()
var command_line = CommandLine.CommandLine()
var no_folders = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(no_folders)

func Outputs(starting_command_line: CommandLine.CommandLine, starting_symbols: Symbols.SymbolTable) {
    command_line = starting_command_line
    symbols = starting_symbols
}

func run(
    high: HighIntermediaryRepresentation.HighProgram,
    low: LowIntermediaryRepresentation.LoweredProgram?,
    generator: Generators.WindowsX64.WindowsX64?,
) {
    if command_line.writes_high_ir {
        write_high_ir(high)
        write_the_generated()
    }
    var report_path = command_line.flags["optimization_report"]
    if report_path {
        write_the_optimization_report(high, report_path)
    }
    assert low and generator
    write_the_crash_map(high.crash_sites)
    if command_line.writes_low_ir {
        write_low_ir(low)
    }
    write_the_executable(generator)
}

func write_the_crash_map(sites: List<String>) {
    var sorted = List<String>()
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var place = sorted.count()
        while place > 0 and comes_after(sorted, place - 1, site) {
            place = place - 1
        }
        sorted.insert(place, site)
        index = index + 1
    }
    var body = sorted.join("\n")
    var build_hash = hash_of(body)
    var lines = List<String>()
    lines.append("# spite crashes 1 {build_hash}")
    sorted.each(lines.append)
    lines.append("")
    var text = lines.join("\n")
    write_text(text, "crashes")
}

func comes_after(sorted: List<String>, place: Integer, site: String): Boolean {
    var earlier = sorted[place]
    crash earlier
    return site < earlier
}

func hash_of(text: String): String {
    var high = 0
    var low = 0
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        var mixed_high = high * 31 + code
        high = mixed_high % 65521
        var mixed_low = low * 131 + code
        low = mixed_low % 65519
        index = index + 1
    }
    var high_digits = four_hexadecimal_digits(high)
    var low_digits = four_hexadecimal_digits(low)
    return "{high_digits}{low_digits}"
}

func four_hexadecimal_digits(number: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = number
    var place = 0
    while place < 4 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

func write_the_executable(generator: Generators.WindowsX64.WindowsX64) {
    var bytes = generator.run()
    var path = command_line.executable_path()
    var file = File(path)
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
    write_beside(path, generator.function_map, "functions")
}

func write_beside(executable: String, text: String, extension: String) {
    var stem = executable
    if executable.ends_with(".exe") {
        var length = executable.length()
        stem = executable.slice(0, length - 4)
    }
    var path = "{stem}.{extension}"
    var file = File(path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func write_high_ir(high: HighIntermediaryRepresentation.HighProgram) {
    var texts = List<String>()
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var printer = Printers.HighIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "high_ir.txt")
}

func write_the_generated() {
    var paths = symbols.generated_texts.keys()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var text = symbols.generated_texts[path]
        crash text
        var file = File(path)
        var bytes = text.to_bytes()
        var written = file.write_bytes(bytes)
        var writable = Validators.CommandLine.WritableFile.Validator()
        writable.check(path, written)
        index = index + 1
    }
}

func write_low_ir(low: LowIntermediaryRepresentation.LoweredProgram) {
    var texts = List<String>()
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var printer = Printers.LowIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "low_ir.txt")
}

func write_the_optimization_report(high: HighIntermediaryRepresentation.HighProgram, written_path: String) {
    var working_folder = program.working_directory()
    var printer = Printers.OptimizationReport.Printer(
        high,
        symbols,
        written_path,
        command_line.program_name,
        working_folder,
    )
    var text = printer.text()
    make_the_folders_of(written_path)
    var file = File(written_path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(written_path, written)
}

func make_the_folders_of(path: String) {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    var folder = ""
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if index == 0 {
            folder = segment
        } else {
            folder = "{folder}/{segment}"
        }
        var made = Directory(folder)
        var is_new = not folder.is_empty() and not folder.ends_with(":") and not made.exists()
        if is_new {
            made.create()
        }
        index = index + 1
    }
}

func write_text(text: String, extension: String) {
    var build = command_line.build_folder()
    var name = command_line.program_name
    var path = "{build}/{name}.{extension}"
    var file = File(path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

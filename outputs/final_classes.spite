union Declaration {
    AbstractSyntaxTree.Shapes.Declarations.SingletonDeclaration
    AbstractSyntaxTree.Shapes.Declarations.GenericDeclaration
    AbstractSyntaxTree.Shapes.Declarations.EnumDeclaration
    AbstractSyntaxTree.Shapes.Declarations.UnionDeclaration
    AbstractSyntaxTree.Shapes.Declarations.TypeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration
    AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration
}

var program = Program()
var no_folders = Mapping.FolderMap()
var symbols = Symbols.SymbolTable(no_folders)
var program_model = Model.ProgramModel()
var names = Mapping.Names()
var folder = ""
var paths = RelativePaths("")
var written_paths = List<String>()

func FinalClasses(
    starting_folder: String,
    starting_symbols: Symbols.SymbolTable,
    starting_model: Model.ProgramModel,
) {
    folder = starting_folder.replace("\\", "/")
    symbols = starting_symbols
    program_model = starting_model
}

func run() {
    var working_folder = program.working_directory()
    crash working_folder
    paths = RelativePaths(working_folder)
    make_the_folder(folder)
    var marker = "written by spite --final-classes: a comment here may link the .spite file that supplied a declaration\n"
    write_at("{folder}/.final-classes", marker)
    var index = 0
    while index < program_model.order.count() {
        var model = program_model.order[index]
        write_the_class(model)
        index = index + 1
    }
}

func write_the_class(model: Model.ClassModel) {
    var source_path = model.file.path
    fallback not symbols.generated_texts.contains(source_path)
    if source_path.is_empty() {
        write_a_made_class(model)
        return
    }
    if model.bound_types.is_empty() {
        var plain_path = path_of(model.key)
        write_a_file(model.file, plain_path)
    } else {
        write_the_template_of(model)
        write_an_instantiation(model)
    }
}

# ../../spite_documentation/compiler.md#inspect-merged-classes
func write_the_template_of(model: Model.ClassModel) {
    var cut = model.shown.index_of("<")
    fallback cut
    var template_key = model.shown.slice(0, cut)
    crash template_key
    var path = path_of(template_key)
    fallback not written_paths.contains(path)
    write_a_file(model.file, path)
}

func write_a_file(model_file: AbstractSyntaxTree.Shapes.SourceFile, path: String) {
    var place = folder_of(path)
    var links = Dictionary<String, String>()
    var index = 0
    while index < model_file.declarations.count() {
        var declaration = model_file.declarations[index]
        var supplied_by = supplier_of(declaration)
        if not supplied_by.is_empty() {
            links[supplied_by] = paths.link(place, supplied_by)
        }
        index = index + 1
    }
    var printer = Printers.FinalClass.Printer(model_file, links, paths, place)
    var text = printer.text()
    var formatted = formatted_text(path, text)
    write_at(path, formatted)
}

# ../../spite_documentation/compiler.md#inspect-merged-classes
func write_a_made_class(model: Model.ClassModel) {
    fallback model.shown != "Object" and not model.key.is_empty()
    var path = path_of(model.key)
    var segments = model.key.split(".")
    var name = segments.last()
    crash name
    var printer = Printers.InstantiatedClass.Printer(model, program_model, name)
    printer.shows_what_the_compiler_writes = true
    var text = printer.text()
    write_at(path, text)
}

func write_an_instantiation(model: Model.ClassModel) {
    var written_name = class_name_of(model.shown)
    var name = written_name
    var file_name = names.snake_case_of(name)
    var path = "{folder}/instantiated/{file_name}.spite"
    var number = 2
    while written_paths.contains(path) {
        name = "{written_name}{number}"
        file_name = names.snake_case_of(name)
        path = "{folder}/instantiated/{file_name}.spite"
        number = number + 1
    }
    var printer = Printers.InstantiatedClass.Printer(model, program_model, name)
    var text = printer.text()
    write_at(path, text)
}

func supplier_of(declaration: Declaration): String {
    if declaration == AbstractSyntaxTree.Shapes.Declarations.FunctionDeclaration {
        return declaration.path
    }
    if declaration == AbstractSyntaxTree.Shapes.Declarations.AttributeDeclaration {
        return declaration.path
    }
    return ""
}

func formatted_text(path: String, text: String): String {
    var first_line = 1
    var lexer = AbstractSyntaxTree.Lexer.Lexer(path, text, first_line)
    var tokens = lexer.tokens_of()
    var printer = Printers.FormattedSource.Printer(text, tokens, lexer.comments)
    return printer.text()
}

func path_of(key: String): String {
    var segments = key.split(".")
    var written = List<String>()
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        var snake = names.snake_case_of(segment)
        written.append(snake)
        index = index + 1
    }
    var joined = written.join("/")
    return "{folder}/{joined}.spite"
}

func class_name_of(shown: String): String {
    var name = String()
    var starts_a_word = true
    var index = 0
    while index < shown.length() {
        var code = shown.byte_at(index)
        var is_a_letter = is_a_letter_or_digit(code)
        if is_a_letter and starts_a_word {
            var upper = upper_case_of(code)
            name.append_code(upper)
        } else if is_a_letter {
            name.append_code(code)
        }
        starts_a_word = not is_a_letter
        index = index + 1
    }
    return name
}

func is_a_letter_or_digit(code: Integer): Boolean {
    var is_lower = code >= 97 and code <= 122
    var is_upper = code >= 65 and code <= 90
    var is_digit = code >= 48 and code <= 57
    return is_lower or is_upper or is_digit
}

func upper_case_of(code: Integer): Integer {
    if code >= 97 and code <= 122 {
        return code - 32
    }
    return code
}

func folder_of(path: String): String {
    var segments = path.split("/")
    crash segments.remove_last()
    return segments.join("/")
}

func write_at(path: String, text: String) {
    var place = folder_of(path)
    make_the_folder(place)
    written_paths.append(path)
    var file = File(path)
    var bytes = text.to_buffer()
    var written = file.write_buffer(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func make_the_folder(path: String) {
    var segments = path.split("/")
    var made = ""
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if index == 0 {
            made = segment
        } else {
            made = "{made}/{segment}"
        }
        make_one(made)
        index = index + 1
    }
}

func make_one(path: String) {
    fallback not path.is_empty() and not path.ends_with(":")
    var directory = Directory(path)
    fallback not directory.exists()
    var made = directory.create()
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, made)
}

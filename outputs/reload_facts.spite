# ../HOT_RELOAD.md#the-manifest
var library = Validators.LibraryFile()

func add_the_classes(host: Model.ReloadHost, high: HighIntermediaryRepresentation.HighProgram) {
    crash high.layout
    var layout = high.layout
    var index = 0
    while index < high.model.order.count() {
        var model = high.model.order[index]
        var id = layout.class_ids[model.key]
        if id {
            var text = layout.described(model)
            host.add_a_class(model.key, id, text)
        }
        add_the_enums(host, model)
        index = index + 1
    }
}

func add_the_enums(host: Model.ReloadHost, model: Model.ClassModel) {
    var index = 0
    while index < model.enums.count() {
        var enumeration = model.enums[index]
        var values = enumeration.values.join(",")
        host.add_an_enum("{model.key}.{enumeration.name}", values)
        index = index + 1
    }
}

func add_the_files(host: Model.ReloadHost, program_model: Model.ProgramModel) {
    var index = 0
    while index < program_model.order.count() {
        var model = program_model.order[index]
        var path = model.file.path.replace("\\", "/")
        var is_typed_code = library.is_typed_code(path)
        var is_program_code = not path.is_empty() and not library.holds(path) or is_typed_code
        if is_program_code {
            var plain = digest_of_file(path)
            var digest = plain
            var sites = program_model.breakpoint_sites[path]
            if sites {
                digest = "{plain} stops {sites}"
            }
            host.add_a_file(path, digest)
        }
        index = index + 1
    }
}

func digest_of_file(path: String): String {
    var file = File(path)
    var bytes = file.read_as_buffer()
    if not bytes {
        return "missing"
    }
    var digest = Model.Digest()
    var bytes_count = bytes.count()
    digest.add_bytes(bytes, 0, bytes_count)
    return digest.digest_text()
}

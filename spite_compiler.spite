func SpiteCompiler() {
    load "../spite_standard_library/windows"
    var command_line = CommandLine.CommandLine()
    command_line.run()
    var mapping = Mapping.Mapping(command_line.program_folder)
    var map = mapping.run()
    var symbol_stage = Symbols.Symbols(map, command_line.program_folder, command_line.flags)
    var symbols = symbol_stage.run()
    var resolution = NameResolution.NameResolution(
        symbols,
        command_line.folder,
        command_line.flags,
        command_line.written_flags,
        command_line.bare_flags,
    )
    var model = resolution.run()
    var building = HighIntermediaryRepresentation.HighIntermediaryRepresentation(
        model,
        resolution.resolver,
        command_line.flags,
    )
    var proofs = Proofs.Proofs()
    building.judge_the_sites_with(proofs.recorded_sites)
    var built = building.run()
    var proven = proofs.run(built)
    var high_passes = HighOptimizationPasses.HighOptimizationPasses()
    var high = high_passes.run(proven)
    var outputs = Outputs.Outputs(command_line, symbols)
    if command_line.only_checks {
        outputs.run(high, null, null)
    } else {
        var counts_memory = command_line.flags["debug_memory"] == "true"
        var lowering = LowIntermediaryRepresentation.LowIntermediaryRepresentation(high, counts_memory)
        var lowered = lowering.run()
        var low_passes = LowOptimizationPasses.LowOptimizationPasses()
        var low = low_passes.run(lowered)
        var generator = Generators.WindowsX64.WindowsX64(low)
        outputs.run(high, low, generator)
    }
}

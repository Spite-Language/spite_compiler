var program = Program()
var settings = CommandLine.Settings()
var program_folder = ""
var program_name = ""

func SpiteCompiler() {
    program_folder = resolved_folder(settings.folder)
    program_name = entry_name_of(program_folder)
    var only_checks = settings.flags["check"] == "true"
    if not only_checks {
        remove_the_last_build()
    }
    var map = Mapping.FolderMap()
    map.add_root(program_folder, "", 0)
    var symbols = Symbols.SymbolTable(map)
    symbols.build_flags = settings.flags
    var entry = symbols.entry_class(program_folder)
    symbols.read_class(entry)
    var entry_file = symbols.file_for(entry.path)
    crash entry_file
    var entry_constructor = Validators.AbstractSyntaxTree.EntryConstructor.Validator()
    entry_constructor.check(entry_file, entry.simple_name)
    symbols.read_the_program()
    var class_names = Validators.Mapping.ClassNames.Validator(map)
    class_names.check(entry)
    var resolver = NameResolution.Resolver(symbols)
    var model = resolver.resolve(entry)
    var circles = Validators.NameResolution.SingletonCircle.Validator()
    circles.check(model)
    var build = resolver.class_model_named("Build")
    var known = Validators.CommandLine.KnownFlag.Validator()
    known.check(settings.flags, settings.written_flags, build)
    var environment = model.class_named("Environment")
    var settings_rules = Validators.NameResolution.Settings.Validator()
    settings_rules.check(settings.folder, build, environment)
    var builder = HighIntermediaryRepresentation.Builder(model, resolver)
    builder.context.build_flags = settings.flags
    var high = builder.build()
    symbols.check_after_building()
    builder.check_the_attribute_reads(high)
    if settings.writes_high_ir {
        write_high_ir(high)
        write_the_generated(symbols)
    }
    var report_path = settings.flags["optimization_report"]
    if report_path {
        write_the_optimization_report(high, symbols, report_path)
    }
    if not only_checks {
        write_the_executable(high)
    }
}

func write_the_executable(high: HighIntermediaryRepresentation.HighProgram) {
    var lowering = LowIntermediaryRepresentation.Lowering.Lowering(high)
    var low = lowering.lowered()
    if settings.writes_low_ir {
        write_low_ir(low)
    }
    var emitter = Generators.WindowsX64.Emitter(low)
    var code = emitter.emitted()
    var writer = Generators.WindowsX64.PortableExecutable(emitter, code)
    var bytes = writer.written()
    var path = executable_path()
    var file = File(path)
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func remove_the_last_build() {
    var path = executable_path()
    var last = File(path)
    if last.exists() {
        last.remove()
    }
}

func write_high_ir(high: HighIntermediaryRepresentation.HighProgram) {
    var texts = List<String>()
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var printer = Printers.HighIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "high_ir.txt")
}

func write_the_generated(symbols: Symbols.SymbolTable) {
    var paths = symbols.generated_texts.keys()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var text = symbols.generated_texts[path]
        crash text
        var file = File(path)
        var bytes = text.to_bytes()
        var written = file.write_bytes(bytes)
        var writable = Validators.CommandLine.WritableFile.Validator()
        writable.check(path, written)
        index = index + 1
    }
}

func write_low_ir(low: LowIntermediaryRepresentation.LowProgram) {
    var texts = List<String>()
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var printer = Printers.LowIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "low_ir.txt")
}

func write_the_optimization_report(
    high: HighIntermediaryRepresentation.HighProgram,
    symbols: Symbols.SymbolTable,
    written_path: String,
) {
    var working_folder = program.working_directory()
    var printer = Printers.OptimizationReport.Printer(high, symbols, written_path, program_name, working_folder)
    var text = printer.text()
    make_the_folders_of(written_path)
    var file = File(written_path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(written_path, written)
}

func make_the_folders_of(path: String) {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    var folder = ""
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if index == 0 {
            folder = segment
        } else {
            folder = "{folder}/{segment}"
        }
        var made = Directory(folder)
        var is_new = not folder.is_empty() and not folder.ends_with(":") and not made.exists()
        if is_new {
            made.create()
        }
        index = index + 1
    }
}

func write_text(text: String, extension: String) {
    var build = build_folder()
    var path = "{build}/{program_name}.{extension}"
    var file = File(path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func executable_path(): String {
    var build = build_folder()
    return "{build}/{program_name}.exe"
}

func build_folder(): String {
    var hidden = Directory("{program_folder}/.spite")
    if not hidden.exists() {
        hidden.create()
    }
    var build = Directory("{program_folder}/.spite/build")
    if not build.exists() {
        build.create()
    }
    return "{program_folder}/.spite/build"
}

func entry_name_of(folder: String): String {
    var names = Mapping.Names()
    var segment = names.last_segment(folder)
    return names.snake_case_of(segment)
}

func resolved_folder(named: String): String {
    if named == "." {
        return program.working_directory()
    }
    return named
}

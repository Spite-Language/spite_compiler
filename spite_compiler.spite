var program = Program()
var settings = CommandLine.Settings()
var program_folder = ""
var program_name = ""

func SpiteCompiler() {
    load ".spite/library/windows"
    program_folder = resolved_folder(settings.folder)
    program_name = entry_name_of(program_folder)
    var only_checks = settings.flags["check"] == "true"
    if not only_checks {
        remove_the_last_build()
    }
    var map = Mapping.FolderMap()
    map.add_root(program_folder, "", 0)
    var symbols = Symbols.SymbolTable(map)
    symbols.build_flags = settings.flags
    var entry = symbols.entry_class(program_folder)
    symbols.read_class(entry)
    var entry_file = symbols.file_for(entry.path)
    crash entry_file
    var entry_constructor = Validators.AbstractSyntaxTree.EntryConstructor.Validator()
    entry_constructor.check(entry_file, entry.simple_name)
    symbols.read_the_program()
    var class_names = Validators.Mapping.ClassNames.Validator(map)
    class_names.check(entry, symbols)
    var resolver = NameResolution.Resolver(symbols)
    var model = resolver.resolve(entry)
    var circles = Validators.NameResolution.SingletonCircle.Validator()
    circles.check(model)
    var build = resolver.class_model_named("Build")
    var environment = model.class_named("Environment")
    var known = Validators.CommandLine.KnownFlag.Validator()
    known.check(settings.flags, settings.written_flags, settings.bare_flags, build, environment)
    var settings_rules = Validators.NameResolution.Settings.Validator()
    settings_rules.check(settings.folder, build, environment)
    var builder = HighIntermediaryRepresentation.Builder(model, resolver)
    builder.context.build_flags = settings.flags
    var high = builder.build()
    symbols.check_after_building()
    builder.check_the_attribute_reads(high)
    var kept_narrowings = Proofs.NarrowingsKeptAcrossCalls.Pass(high)
    kept_narrowings.check()
    builder.lay_out_the_attributes(high)
    if settings.writes_high_ir {
        write_high_ir(high)
        write_the_generated(symbols)
    }
    var report_path = settings.flags["optimization_report"]
    if report_path {
        write_the_optimization_report(high, symbols, report_path)
    }
    if not only_checks {
        write_the_crash_map(builder.context.crash_sites)
        write_the_executable(high)
    }
}

func write_the_crash_map(sites: List<String>) {
    var sorted = List<String>()
    var index = 0
    while index < sites.count() {
        var site = sites[index]
        var place = sorted.count()
        while place > 0 and comes_after(sorted, place - 1, site) {
            place = place - 1
        }
        sorted.insert(place, site)
        index = index + 1
    }
    var body = sorted.join("\n")
    var build_hash = hash_of(body)
    var lines = List<String>()
    lines.append("# spite crashes 1 {build_hash}")
    sorted.each(lines.append)
    lines.append("")
    var text = lines.join("\n")
    write_text(text, "crashes")
}

func comes_after(sorted: List<String>, place: Integer, site: String): Boolean {
    var earlier = sorted[place]
    crash earlier
    return site < earlier
}

func hash_of(text: String): String {
    var high = 0
    var low = 0
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        var mixed_high = high * 31 + code
        high = mixed_high % 65521
        var mixed_low = low * 131 + code
        low = mixed_low % 65519
        index = index + 1
    }
    var high_digits = four_hexadecimal_digits(high)
    var low_digits = four_hexadecimal_digits(low)
    return "{high_digits}{low_digits}"
}

func four_hexadecimal_digits(number: Integer): String {
    var digits = "0123456789abcdef"
    var shown = ""
    var rest = number
    var place = 0
    while place < 4 {
        var digit = rest % 16
        var character = digits.slice(digit, digit + 1)
        shown = "{character}{shown}"
        rest = rest / 16
        place = place + 1
    }
    return shown
}

func write_the_executable(high: HighIntermediaryRepresentation.HighProgram) {
    var lowering = LowIntermediaryRepresentation.Lowering.Lowering(high)
    lowering.counts_memory = settings.flags["debug_memory"] == "true"
    var low = lowering.lowered()
    var cooling = LowOptimizationPasses.ColdReports.Pass(low)
    cooling.transformed()
    var settling = LowOptimizationPasses.MadeSingletons.Pass(low)
    settling.transformed()
    fold_before_answering(low)
    var answering = LowOptimizationPasses.CompileTimeEvaluation.Pass(low)
    var answered = answering.transformed()
    var inlining = LowOptimizationPasses.Inlining.Pass(answered)
    var inlined = inlining.transformed()
    var evaluating = LowOptimizationPasses.CompileTimeEvaluation.Pass(inlined)
    var evaluated = evaluating.transformed()
    var specializing = LowOptimizationPasses.CompileTimeEvaluation.PartialEvaluation(evaluated)
    specializing.transformed()
    place_the_objects(evaluated)
    optimize_the_low(evaluated)
    inline_once_more(evaluated)
    release_in_place(evaluated)
    var vectorizing = LowOptimizationPasses.VectorLoops.Pass(evaluated)
    vectorizing.transformed()
    tidy_the_low(evaluated)
    if settings.writes_low_ir {
        write_low_ir(low)
    }
    var emitter = Generators.WindowsX64.Emitter(low)
    var code = emitter.emitted()
    var writer = Generators.WindowsX64.PortableExecutable(emitter, code)
    var bytes = writer.written()
    var path = executable_path()
    var file = File(path)
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
    var map = emitter.function_map()
    write_beside(path, map, "functions")
}

func write_beside(executable: String, text: String, extension: String) {
    var stem = executable
    if executable.ends_with(".exe") {
        var length = executable.length()
        stem = executable.slice(0, length - 4)
    }
    var path = "{stem}.{extension}"
    var file = File(path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func fold_before_answering(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var folding = LowOptimizationPasses.ConstantFolding.Pass(function)
        var folded = folding.transformed()
        var threading = LowOptimizationPasses.JumpThreading.Pass(folded)
        var threaded = threading.transformed()
        low.lowered_functions[index] = threaded
        index = index + 1
    }
}

# OPTIMIZATIONS.md#a-function-called-in-a-loop-is-inlined-into-it
func inline_once_more(low: LowIntermediaryRepresentation.LoweredProgram) {
    var directing = LowOptimizationPasses.DirectCalls.Pass(low)
    directing.transformed()
    var inlining = LowOptimizationPasses.Inlining.Pass(low)
    inlining.is_late = true
    inlining.transformed()
    var changed = inlining.changed_keys
    assert not changed.is_empty()
    var keeping = LowOptimizationPasses.ObjectPlacement.KeptParameters()
    keeping.read_the_program(low)
    var settling = LowOptimizationPasses.MadeSingletons.Pass(low)
    var frees = LowOptimizationPasses.UnreadObjects.PlainFrees()
    frees.read_the_program(low)
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        if changed.contains(function.key) {
            var known = known_headers(function, low)
            var placing = LowOptimizationPasses.ObjectPlacement.Pass(known, low, keeping)
            var placed = placing.transformed()
            low.lowered_functions[index] = optimized(placed, low, settling, frees)
        }
        index = index + 1
    }
}

func place_the_objects(low: LowIntermediaryRepresentation.LoweredProgram) {
    var keeping = LowOptimizationPasses.ObjectPlacement.KeptParameters()
    keeping.read_the_program(low)
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var known = known_headers(function, low)
        var placing = LowOptimizationPasses.ObjectPlacement.Pass(known, low, keeping)
        var placed = placing.transformed()
        low.lowered_functions[index] = placed
        index = index + 1
    }
}

# OPTIMIZATIONS.md#the-class-of-an-object-made-in-the-function-is-known
func known_headers(
    function: LowIntermediaryRepresentation.LowFunction,
    low: LowIntermediaryRepresentation.LoweredProgram,
): LowIntermediaryRepresentation.LowFunction {
    var heading = LowOptimizationPasses.KnownHeaders.Pass(function, low)
    var headed = heading.transformed()
    if not heading.changed {
        return headed
    }
    var folding = LowOptimizationPasses.ConstantFolding.Pass(headed)
    var folded = folding.transformed()
    var threading = LowOptimizationPasses.JumpThreading.Pass(folded)
    var threaded = threading.transformed()
    var clearing = LowOptimizationPasses.UnreachedBlocks.Pass(threaded)
    return clearing.transformed()
}

func optimize_the_low(low: LowIntermediaryRepresentation.LoweredProgram) {
    var settling = LowOptimizationPasses.MadeSingletons.Pass(low)
    var frees = LowOptimizationPasses.UnreadObjects.PlainFrees()
    frees.read_the_program(low)
    var index = 0
    while index < low.lowered_functions.count() {
        var listed = low.lowered_functions[index]
        low.lowered_functions[index] = optimized(listed, low, settling, frees)
        index = index + 1
    }
}

func optimized(
    listed: LowIntermediaryRepresentation.LowFunction,
    low: LowIntermediaryRepresentation.LoweredProgram,
    settling: LowOptimizationPasses.MadeSingletons.Pass,
    frees: LowOptimizationPasses.UnreadObjects.PlainFrees,
): LowIntermediaryRepresentation.LowFunction {
    var function = settling.settled(listed)
    var folding = LowOptimizationPasses.ConstantFolding.Pass(function)
    var folded = folding.transformed()
    var threading = LowOptimizationPasses.JumpThreading.Pass(folded)
    var threaded = threading.transformed()
    var propagating = LowOptimizationPasses.CopyPropagation.Pass(threaded)
    var propagated = propagating.transformed()
    var cleaning = LowOptimizationPasses.DeadCode.Pass(propagated)
    var cleaned_first = cleaning.transformed()
    var reading_through = LowOptimizationPasses.AvailableCopies.Pass(cleaned_first)
    var read_through = reading_through.transformed()
    var living = LowOptimizationPasses.LiveValues.Pass(read_through)
    var cleaned = living.transformed()
    var leaving = LowOptimizationPasses.UnreadObjects.Pass(cleaned, frees)
    var left = leaving.transformed()
    var pairing = LowOptimizationPasses.CountedPairs.Pass(left)
    var paired = pairing.transformed()
    var sharing = LowOptimizationPasses.CommonSubexpressions.Pass(paired)
    var shared = sharing.transformed()
    var repropagating = LowOptimizationPasses.CopyPropagation.Pass(shared)
    var repropagated = repropagating.transformed()
    var bounding = LowOptimizationPasses.ProvenBounds.Pass(repropagated)
    var bounded_first = bounding.transformed()
    var ranging = LowOptimizationPasses.CheckedRanges.Pass(bounded_first)
    var bounded = ranging.transformed()
    var refolding = LowOptimizationPasses.ConstantFolding.Pass(bounded)
    var refolded = refolding.transformed()
    var rethreading = LowOptimizationPasses.JumpThreading.Pass(refolded)
    var rethreaded = rethreading.transformed()
    var masking = LowOptimizationPasses.RemainderTests.Pass(rethreaded)
    var masked = masking.transformed()
    var hoisting = LowOptimizationPasses.LoopInvariants.Pass(masked)
    hoisting.uses_threads = low.uses_threads
    hoisting.locked_owners = low.locked_singletons
    hoisting.shared_owners = low.shared_classes
    if not low.counts_memory {
        hoisting.quiet_labels = low.quiet_singletons
    }
    var hoisted = hoisting.transformed()
    var resharing = LowOptimizationPasses.CommonSubexpressions.Pass(hoisted)
    var reshared = resharing.transformed()
    var copying = LowOptimizationPasses.CopyPropagation.Pass(reshared)
    var copied = copying.transformed()
    var trimming = LowOptimizationPasses.DeadCode.Pass(copied)
    var trimmed = trimming.transformed()
    var selecting = LowOptimizationPasses.Selections.Pass(trimmed)
    var selected = selecting.transformed()
    var coalescing = LowOptimizationPasses.CopyCoalescing.Pass(selected)
    var coalesced = coalescing.transformed()
    var sweeping = LowOptimizationPasses.DeadCode.Pass(coalesced)
    var swept_first = sweeping.transformed()
    var rereading = LowOptimizationPasses.AvailableCopies.Pass(swept_first)
    var reread = rereading.transformed()
    var reliving = LowOptimizationPasses.LiveValues.Pass(reread)
    return reliving.transformed()
}

# OPTIMIZATIONS.md#straight-runs-of-blocks-are-one-block
func tidy_the_low(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var shaping = LowOptimizationPasses.AvailableCopies.Pass(function)
        shaping.shapes_the_blocks = true
        var shaped = shaping.transformed()
        var living = LowOptimizationPasses.LiveValues.Pass(shaped)
        var lived = living.transformed()
        var coalescing = LowOptimizationPasses.CopyCoalescing.Pass(lived)
        var coalesced = coalescing.transformed()
        var reliving = LowOptimizationPasses.LiveValues.Pass(coalesced)
        low.lowered_functions[index] = reliving.transformed()
        index = index + 1
    }
}

func release_in_place(low: LowIntermediaryRepresentation.LoweredProgram) {
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var releasing = LowOptimizationPasses.ReleasedInPlace.Pass(function, low.uses_threads)
        low.lowered_functions[index] = releasing.transformed()
        index = index + 1
    }
}

func remove_the_last_build() {
    var path = executable_path()
    var last = File(path)
    if last.exists() {
        last.remove()
    }
}

func write_high_ir(high: HighIntermediaryRepresentation.HighProgram) {
    var texts = List<String>()
    var index = 0
    while index < high.built_functions.count() {
        var function = high.built_functions[index]
        var printer = Printers.HighIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "high_ir.txt")
}

func write_the_generated(symbols: Symbols.SymbolTable) {
    var paths = symbols.generated_texts.keys()
    var index = 0
    while index < paths.count() {
        var path = paths[index]
        var text = symbols.generated_texts[path]
        crash text
        var file = File(path)
        var bytes = text.to_bytes()
        var written = file.write_bytes(bytes)
        var writable = Validators.CommandLine.WritableFile.Validator()
        writable.check(path, written)
        index = index + 1
    }
}

func write_low_ir(low: LowIntermediaryRepresentation.LoweredProgram) {
    var texts = List<String>()
    var index = 0
    while index < low.lowered_functions.count() {
        var function = low.lowered_functions[index]
        var printer = Printers.LowIntermediaryRepresentation.Printer(function)
        var text = printer.text()
        texts.append(text)
        index = index + 1
    }
    var joined = texts.join("\n")
    write_text(joined, "low_ir.txt")
}

func write_the_optimization_report(
    high: HighIntermediaryRepresentation.HighProgram,
    symbols: Symbols.SymbolTable,
    written_path: String,
) {
    var working_folder = program.working_directory()
    var printer = Printers.OptimizationReport.Printer(high, symbols, written_path, program_name, working_folder)
    var text = printer.text()
    make_the_folders_of(written_path)
    var file = File(written_path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(written_path, written)
}

func make_the_folders_of(path: String) {
    var segments = path.replace("\\", "/").split("/")
    segments.remove_last()
    var folder = ""
    var index = 0
    while index < segments.count() {
        var segment = segments[index]
        if index == 0 {
            folder = segment
        } else {
            folder = "{folder}/{segment}"
        }
        var made = Directory(folder)
        var is_new = not folder.is_empty() and not folder.ends_with(":") and not made.exists()
        if is_new {
            made.create()
        }
        index = index + 1
    }
}

func write_text(text: String, extension: String) {
    var build = build_folder()
    var path = "{build}/{program_name}.{extension}"
    var file = File(path)
    var bytes = text.to_bytes()
    var written = file.write_bytes(bytes)
    var writable = Validators.CommandLine.WritableFile.Validator()
    writable.check(path, written)
}

func executable_path(): String {
    var given = settings.flags["executable_path"]
    if given {
        return given
    }
    var build = build_folder()
    return "{build}/{program_name}.exe"
}

func build_folder(): String {
    var hidden = Directory("{program_folder}/.spite")
    if not hidden.exists() {
        hidden.create()
    }
    var build = Directory("{program_folder}/.spite/build")
    if not build.exists() {
        build.create()
    }
    return "{program_folder}/.spite/build"
}

func entry_name_of(folder: String): String {
    var names = Mapping.Names()
    var segment = names.last_segment(folder)
    return names.snake_case_of(segment)
}

func resolved_folder(named: String): String {
    if named == "." {
        return program.working_directory()
    }
    return named
}
